-- The partition torsor (Serre note, Section 6, Lemma lem:lifts, with
-- J_i the support ideals J_(u_i) of Section 7).
-- Let u_1, .., u_m cover X and J_i = J_(u_i).  Put E = prod_i J_i, and let
-- q : E -> O be the sum map, q(t) = sum_i t_i (each t_i in O through the
-- inclusion of J_i).  It is natural and linear: the inclusions are, and
-- finite sums commute with addition, scalars and restriction.
-- K = ker q (zero-sum tuples) and T = q^-1(1) (sum-one tuples).
-- Lemma (local points).  For b <= u_j and t in O(b), the basis vector
--  e_j(t) with j-th coordinate t and all others 0 lies in E(b): t is in
--  J_j(b) since D_b(t) <= b <= u_j, and 0 is in every ideal.  Its sum is
--  t (SerrePartitionIndex.spike-sum).
-- Lemma (q locally surjective).  For y in O(a), the a /\ u_i cover a, and
--  e_i(y|a /\ u_i) maps to y|a /\ u_i.
-- Hence (SerreTorsorLifts, the sheaf of lifts of the global section 1)
--  T is a K-torsor, and if every K-torsor merely has a global section,
--  then merely there are f_i in J_i(1), i.e. D(f_i) <= u_i, with
--  sum_i f_i = 1; so does a single global section of T.  The basis
--  vector of 1 on u_j is a point of T over u_j.  For m = 0 the cover
--  gives 1_L = 0_L and the empty family covers every a; nothing is
--  special about that case.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module DL = DistLattice[l] ;
module SM = SerreModule[l] ;
module MM = SerreModuleMaps[l] ;
module MS = SerreModuleSheaf[l] ;
module SI = SerreSupportIdeal[l] ;
module Idx = SerrePartitionIndex[l] ;
module On (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged)
 (m : Nat) (us : Fin m -> L.L) (covers : Id L.L (DL.Joins[L].bigJ m us) L.top) {
 module O = DL.Order[L] ;
 module J = DL.Joins[L] ;
 module GO = RingedLattice[l].On[L].Of[X.sheaf] ;
 module LX = LocallyRinged[l].On[L].Laws[X.sheaf,X.inv] ;
 module IO = InvOpen[l].On[L].Of[X.sheaf] ;
 module Str = SerreModuleSheafStructure[l].On[L,X.sheaf,X.is-sheaf] ;
 module SO = MS.On[L,X.sheaf].Of[Str.presheaf] ;
 -- J_i = J_(u_i)
 ideals (i : Fin m) : MS.On[L,X.sheaf].ModuleSheaf = SI.On[L,X,us i].ideal ;
 module E = SerreModuleSheafProducts[l].On[L,X.sheaf,Fin m,ideals] ;
 module EO = MS.On[L,X.sheaf].Of[E.presheaf] ;
 module Sums (a : L.L) {
  module S = SerreModuleSums[l].Over[X.sheaf.ring a,Str.presheaf.module-at a] ;
  module Ix = Idx.Over[X.sheaf.ring a,Str.presheaf.module-at a] ;
 } ;
 -- the i-th coordinate of a tuple, as a section of O
 coordinate (a : L.L) (x : E.At[a].P.Carrier) (i : Fin m) : (X.sheaf.ring a).R =
  SI.On[L,X,us i].Inclusion.at SI.On[L,X,us i].inclusion a (x i) ;
 -- q(t) = sum_i t_i
 total (a : L.L) (x : E.At[a].P.Carrier) : (X.sheaf.ring a).R = Sums[a].S.sum m (coordinate a x) ;
 total-at (a : L.L) (x : E.At[a].P.Carrier) :
  Id (X.sheaf.ring a).R (total a x) (Sums[a].S.sum m (coordinate a x)) = refl (Sums[a].S.sum m (coordinate a x)) ;
 total-add (a : L.L) (x y : E.At[a].P.Carrier) :
  Id (X.sheaf.ring a).R (total a (E.At[a].P.product.madd x y)) ((X.sheaf.ring a).add (total a x) (total a y)) = calc (X.sheaf.ring a).R {
  total a (E.At[a].P.product.madd x y)
   =< Sums[a].S.sum-cong m (coordinate a (E.At[a].P.product.madd x y)) (\ i -> (X.sheaf.ring a).add (coordinate a x i) (coordinate a y i))
       (\ i -> SI.On[L,X,us i].Inclusion.at-add SI.On[L,X,us i].inclusion a (x i) (y i))
   > Sums[a].S.sum m (\ i -> (X.sheaf.ring a).add (coordinate a x i) (coordinate a y i))
   =< Sums[a].S.sum-add m (coordinate a x) (coordinate a y)
   > (X.sheaf.ring a).add (total a x) (total a y) } ;
 total-scale (a : L.L) (r : (X.sheaf.ring a).R) (x : E.At[a].P.Carrier) :
  Id (X.sheaf.ring a).R (total a (E.At[a].P.product.sm r x)) ((X.sheaf.ring a).mul r (total a x)) = calc (X.sheaf.ring a).R {
  total a (E.At[a].P.product.sm r x)
   =< Sums[a].S.sum-cong m (coordinate a (E.At[a].P.product.sm r x)) (\ i -> (X.sheaf.ring a).mul r (coordinate a x i))
       (\ i -> SI.On[L,X,us i].Inclusion.at-scale SI.On[L,X,us i].inclusion a r (x i))
   > Sums[a].S.sum m (\ i -> (X.sheaf.ring a).mul r (coordinate a x i))
   =< Sums[a].S.sum-scale r m (coordinate a x)
   > (X.sheaf.ring a).mul r (total a x) } ;
 total-restrict (b a : L.L) (k : O.Le b a) (x : E.At[a].P.Carrier) :
  Id (X.sheaf.ring b).R (total b (EO.restrict b a k x)) (GO.restrict b a k (total a x)) = calc (X.sheaf.ring b).R {
  total b (EO.restrict b a k x)
   =< Sums[b].S.sum-cong m (coordinate b (EO.restrict b a k x)) (\ i -> GO.restrict b a k (coordinate a x i))
       (\ i -> SI.On[L,X,us i].inclusion.natural b a k (x i))
   > Sums[b].S.sum m (\ i -> GO.restrict b a k (coordinate a x i))
   =< sym (SerreModuleSums[l].Map[X.sheaf.ring a,X.sheaf.ring b,X.sheaf.res b a k,
        Str.presheaf.module-at a,Str.presheaf.module-at b,Str.restriction b a k].sum-map m (coordinate a x))
   > GO.restrict b a k (total a x) } ;
 module Q = MS.On[L,X.sheaf].Transform[E.presheaf,Str.presheaf] ;
 sum-component (a : L.L) :
  MM.Between[X.sheaf.ring a,X.sheaf.ring a,RingHom[l].identity (X.sheaf.ring a),E.At[a].P.product,Str.presheaf.module-at a].Hom =
  new MM.Between[X.sheaf.ring a,X.sheaf.ring a,RingHom[l].identity (X.sheaf.ring a),E.At[a].P.product,Str.presheaf.module-at a].Hom[
   total a,total-add a,\ r x -> total-scale a r x] ;
 sum-map : Q.Hom = new Q.Hom[sum-component,\ b a k x -> total-restrict b a k x] ;
 sum-map-at (a : L.L) (x : E.At[a].P.Carrier) : Id (X.sheaf.ring a).R (Q.at sum-map a x) (total a x) = refl (total a x) ;
 -- the basis vector e_j(t) on b <= u_j
 module Basis (j : Fin m) (b : L.L) (below : O.Le b (us j)) (t : (X.sheaf.ring b).R) {
  module Ix = Sums[b].Ix ;
  value (i : Fin m) : (X.sheaf.ring b).R = Ix.spike m j (\ k -> t) i ;
  coordinate-member (i : Fin m) : (d : Idx.Dec (Id (Fin m) i j)) ->
   SI.On[L,X,us i].Member b (Ix.on (Id (Fin m) i j) d t) = split {
   inl e -> Pr.subst (Fin m) (\ k -> O.Le (LX.d b t) (us k)) j i (sym e)
    (O.le-trans (LX.d b t) b (us j) (IO.below (LX.d-open b t)) below) ;
   inr n -> SI.On[L,X,us i].At[b].member SI.On[L,X,us i].At[b].zero } ;
  vector : E.At[b].P.Carrier = \ i -> (value i,coordinate-member i (Idx.deq m i j)) ;
  vector-coordinate (i : Fin m) : Id (X.sheaf.ring b).R (coordinate b vector i) (value i) =
   SI.On[L,X,us i].inclusion-at b (vector i) ;
  vector-total : Id (X.sheaf.ring b).R (total b vector) t = calc (X.sheaf.ring b).R {
   total b vector
    =< Sums[b].S.sum-cong m (coordinate b vector) value vector-coordinate > Sums[b].S.sum m value
    =< Ix.spike-sum m j (\ k -> t) > t } ;
 } ;
 -- q is locally surjective, on the cover a /\ u_i
 covers-at (a : L.L) : O.Le a (J.bigJ m (\ i -> L.meet a (us i))) =
  J.meet-cover a m us (O.le-trans a L.top (J.bigJ m us) (O.le-top a) (O.le-of-eq L.top (J.bigJ m us) (sym covers))) ;
 local-lift (a : L.L) (y : (X.sheaf.ring a).R) : Q.LocalLift[sum-map,a,y] =
  new Q.LocalLift[sum-map,a,y,m,\ i -> L.meet a (us i),\ i -> O.meet-left a (us i),covers-at a,
   \ i -> Basis[i,L.meet a (us i),O.meet-right a (us i),GO.restrict (L.meet a (us i)) a (O.meet-left a (us i)) y].vector,
   \ i -> trans (Basis[i,L.meet a (us i),O.meet-right a (us i),GO.restrict (L.meet a (us i)) a (O.meet-left a (us i)) y].vector-total)
    (sym (Str.restrict-at (L.meet a (us i)) a (O.meet-left a (us i)) y))] ;
 surjective : Q.LocallySurjective sum-map = \ a y -> Tr.Trunc[Q.LocalLift[sum-map,a,y]].inc (local-lift a y) ;
 -- T = q^-1(1), a torsor under K = ker q
 module Lifts = SerreTorsorLifts[l].On[L,X.sheaf,E.product,Str.structure,sum-map,surjective,(X.sheaf.ring L.top).o] ;
 kernel : MS.On[L,X.sheaf].ModuleSheaf = Lifts.K.kernel ;
 torsor : Lifts.Torsors.Torsor = Lifts.torsor ;
 -- f_i in J_i(1) with sum_i f_i = 1
 Partition : U l = (f : (i : Fin m) -> (X.sheaf.ring L.top).R)
  * ((i : Fin m) -> SI.On[L,X,us i].Member L.top (f i))
  * Id (X.sheaf.ring L.top).R (Sums[L.top].S.sum m f) (X.sheaf.ring L.top).o ;
 from-lift (z : (x : E.At[L.top].P.Carrier) * Id (X.sheaf.ring L.top).R (Q.at sum-map L.top x) (X.sheaf.ring L.top).o) : Partition =
  (coordinate L.top z.1,\ i -> Pr.subst (X.sheaf.ring L.top).R (SI.On[L,X,us i].Member L.top) _ _
    (sym (SI.On[L,X,us i].inclusion-at L.top (z.1 i))) (SI.On[L,X,us i].At[L.top].member (z.1 i)),z.2) ;
 partition (vanishing : Lifts.Torsors.Acyclic1) : Tr.Trunc[Partition].carrier =
  Tr.Trunc[(x : E.At[L.top].P.Carrier) * Id (X.sheaf.ring L.top).R (Q.at sum-map L.top x) (X.sheaf.ring L.top).o].induction @l
   (\ z -> Tr.Trunc[Partition].carrier) (\ z -> Tr.Trunc[Partition].proposition)
   (\ z -> Tr.Trunc[Partition].inc (from-lift z)) (Lifts.global-lift vanishing) ;
 -- the basis vector of 1 on u_j is a point of T over u_j
 point (j : Fin m) : torsor.presheaf.obj (us j) =
  Lifts.point (us j) (Basis[j,us j,O.le-refl (us j),GO.restrict (us j) L.top (O.le-top (us j)) (X.sheaf.ring L.top).o].vector)
   (trans (Basis[j,us j,O.le-refl (us j),GO.restrict (us j) L.top (O.le-top (us j)) (X.sheaf.ring L.top).o].vector-total)
    (sym (Str.restrict-at (us j) L.top (O.le-top (us j)) (X.sheaf.ring L.top).o))) ;
 -- a global section of T is a partition
 partition-at (section : Tr.Trunc[torsor.presheaf.obj L.top].carrier) : Tr.Trunc[Partition].carrier =
  Tr.Trunc[torsor.presheaf.obj L.top].induction @l (\ z -> Tr.Trunc[Partition].carrier) (\ z -> Tr.Trunc[Partition].proposition)
   (\ z -> Tr.Trunc[Partition].inc (from-lift (Lifts.global-value z,Lifts.global-equation z))) section ;
 opaque sum-map ;
} ;
