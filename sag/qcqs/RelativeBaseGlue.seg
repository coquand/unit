-- Glue the base maps before the relative values (note §3, forward proof).
-- Projection of a compatible total family is compatible in h_k.
-- RepresentableSheaf gives iota and specified paths lambda_i iota=iota_i.
-- Rebase the i-th value backwards along this path.  Rebase-pair identifies
-- its pair with the original total value.  Transporting compatibility
-- along those pair equations and using RelativeCoverFibre gives native
-- relative compatibility on the fixed glued base.
level l ; open Ring[l] ; open Presentations[l] ;
module T = AffineTests[l] ;
module RH = RingHom[l] ;
module SF = TestFunctors[l] ;
module TS = TestSheaves[l] ;
module Over (K : T.Test) (F : RelativeFunctors[l].Over[K].SetFunctor)
 (c : TS.CoverData) (xs : TS.OnCover[RelativeTotal[l].Over[K,F].functor,c].C.Values)
 (compatible : TS.OnCover[RelativeTotal[l].Over[K,F].functor,c].C.Compatible xs) {
 module TF = RelativeTotal[l].Over[K,F] ;
 module TC = TS.OnCover[TF.functor,c].C ;
 module D = TS.OnCover[TF.functor,c].D ;
 module HC = TS.OnCover[SF.Representable[K].functor,c].C ;
 bases : HC.Values = \ i -> TF.At[D.basic i].base (xs i) ;
 bases-compatible : HC.Compatible bases = \ i j -> ap (TF.At[D.double i j].base) (compatible i j) ;
 base-amalgams : Localisation[l].isContr (HC.Amalgam bases) = RepresentableSheaf[l].is-sheaf K c bases bases-compatible ;
 iota : RH.Hom K.ring (TS.base c).ring = base-amalgams.1.1 ;
 base-matches (i : Fin (TS.count c)) : Id (RH.Hom K.ring (D.basic i).ring)
  (TF.RT.push (TS.base c) (D.basic i) (D.AB.inclusion (TS.generators c i)) iota) (TF.At[D.basic i].base (xs i)) = base-amalgams.1.2 i ;
 module CF = RelativeCoverFibre[l].Over[K,F,c,iota] ;
 values : CF.RC.Values = \ i -> TF.At[D.basic i].DP.rebase (base-matches i) (TF.At[D.basic i].value (xs i)) ;
 pair-equation (i : Fin (TS.count c)) : Id (TF.functor.obj (D.basic i)) (CF.pairs values i) (xs i) =
  TF.At[D.basic i].DP.rebase-pair (base-matches i) (TF.At[D.basic i].value (xs i)) ;
 total-compatible : TC.Compatible (CF.pairs values) = \ i j ->
  trans (ap (TF.functor.reindex (D.basic i) (D.double i j) (D.left i j)) (pair-equation i))
   (trans (compatible i j) (sym (ap (TF.functor.reindex (D.basic j) (D.double i j) (D.right i j)) (pair-equation j)))) ;
 relative-compatible : CF.RC.Compatible values = CF.fibre-compatible values total-compatible ;
} ;
