-- The sign convention and gluing step for Cech torsors (note, Section 5).
-- Local sections t_i define c_ij by t_i=t_j+c_ij. A correction satisfies
-- c_ij+b_i=b_j on the overlap, equivalently delta b=c for
-- delta b_ij=b_j-b_i. Thus t_i+b_i and t_j+b_j agree and glue.
-- The finite cover may include empty opens and may itself be empty.
-- This generic gluing step does not yet assert affine vanishing or
-- classify cocycles; those require the module-localisation prerequisites.
level l ; open Ring[l] ; open Presentations[l] ;
module DL = DistLattice[l] ;
module MS = SerreModuleSheaf[l] ;
module SS = SerreSetSheaf[l] ;
module On (L : DL.DLat) (G : RingedLattice[l].On[L].Presheaf)
 (M : MS.On[L,G].ModuleSheaf) (T : SerreTorsor[l].On[L,G].Over[M].Torsor)
 (n : Nat) (as : Fin n -> L.L) (covers : DL.Order[L].Le L.top (DL.Joins[L].bigJ n as))
 (ts : (i : Fin n) -> T.presheaf.obj (as i)) {
 module O = DL.Order[L] ;
 module MO = MS.On[L,G].Of[M.presheaf] ;
 module TO = SerreTorsor[l].On[L,G].Over[M].Of[T] ;
 module TC = SS.On[L].Of[T.presheaf].Cover[L.top,n,as,\ i -> O.le-top (as i),covers] ;
 module TS = SS.On[L].SheafProofs[T.presheaf,T.sheaf].Cover[L.top,n,as,\ i -> O.le-top (as i),covers] ;
 overlap (i j : Fin n) : L.L = L.meet (as i) (as j) ;
 left (i j : Fin n) : T.presheaf.obj (overlap i j) =
  T.presheaf.res (overlap i j) (as i) (O.meet-left (as i) (as j)) (ts i) ;
 right (i j : Fin n) : T.presheaf.obj (overlap i j) =
  T.presheaf.res (overlap i j) (as j) (O.meet-right (as i) (as j)) (ts j) ;
 cocycle (i j : Fin n) : (M.presheaf.module-at (overlap i j)).M =
  TO.diff (overlap i j) (right i j) (left i j) ;
 cocycle-equation (i j : Fin n) :
  Id (T.presheaf.obj (overlap i j)) (T.action (overlap i j) (right i j) (cocycle i j)) (left i j) =
  TO.diff-equation (overlap i j) (right i j) (left i j) ;
 module Below (w : L.L) (i j : Fin n) (wi : O.Le w (as i)) (wj : O.Le w (as j)) {
  meet-below : O.Le w (overlap i j) = O.meet-glb (as i) (as j) w wi wj ;
  left-res : Id (T.presheaf.obj w) (T.presheaf.res w (overlap i j) meet-below (left i j))
   (T.presheaf.res w (as i) wi (ts i)) =
   T.presheaf.res-comp w (overlap i j) (as i) meet-below (O.meet-left (as i) (as j)) wi (ts i) ;
  right-res : Id (T.presheaf.obj w) (T.presheaf.res w (overlap i j) meet-below (right i j))
   (T.presheaf.res w (as j) wj (ts j)) =
   T.presheaf.res-comp w (overlap i j) (as j) meet-below (O.meet-right (as i) (as j)) wj (ts j) ;
  cocycle-res : Id (M.presheaf.module-at w).M
   (MO.restrict w (overlap i j) meet-below (cocycle i j))
   (TO.diff w (T.presheaf.res w (as j) wj (ts j)) (T.presheaf.res w (as i) wi (ts i))) =
   trans (sym (TO.diff-res w (overlap i j) meet-below (right i j) (left i j)))
    (trans (ap (\ t -> TO.diff w t (T.presheaf.res w (overlap i j) meet-below (left i j))) right-res)
     (ap (TO.diff w (T.presheaf.res w (as j) wj (ts j))) left-res)) ;
 } ;
 cocycle-law (w : L.L) (i j k : Fin n) (wi : O.Le w (as i)) (wj : O.Le w (as j)) (wk : O.Le w (as k)) :
  Id (M.presheaf.module-at w).M
   ((M.presheaf.module-at w).madd
    (MO.restrict w (overlap i j) (Below[w,i,j,wi,wj].meet-below) (cocycle i j))
    (MO.restrict w (overlap j k) (Below[w,j,k,wj,wk].meet-below) (cocycle j k)))
   (MO.restrict w (overlap i k) (Below[w,i,k,wi,wk].meet-below) (cocycle i k)) =
  trans (cong2 (M.presheaf.module-at w).M (M.presheaf.module-at w).madd _ _ _ _
   Below[w,i,j,wi,wj].cocycle-res Below[w,j,k,wj,wk].cocycle-res)
   (trans ((M.presheaf.module-at w).maddC
    (TO.diff w (T.presheaf.res w (as j) wj (ts j)) (T.presheaf.res w (as i) wi (ts i)))
    (TO.diff w (T.presheaf.res w (as k) wk (ts k)) (T.presheaf.res w (as j) wj (ts j))))
    (trans (sym (TO.diff-compose w (T.presheaf.res w (as k) wk (ts k))
     (T.presheaf.res w (as j) wj (ts j)) (T.presheaf.res w (as i) wi (ts i))))
     (sym Below[w,i,k,wi,wk].cocycle-res))) ;
 module Correction (bs : (i : Fin n) -> (M.presheaf.module-at (as i)).M)
  (equation : (i j : Fin n) -> Id (M.presheaf.module-at (overlap i j)).M
   ((M.presheaf.module-at (overlap i j)).madd (cocycle i j)
    (MO.restrict (overlap i j) (as i) (O.meet-left (as i) (as j)) (bs i)))
   (MO.restrict (overlap i j) (as j) (O.meet-right (as i) (as j)) (bs j))) {
  corrected (i : Fin n) : T.presheaf.obj (as i) = T.action (as i) (ts i) (bs i) ;
  compatible : TC.Compatible corrected = \ i j ->
   trans (T.action-res (overlap i j) (as i) (O.meet-left (as i) (as j)) (ts i) (bs i))
    (trans (ap (\ t -> T.action (overlap i j) t
     (MO.restrict (overlap i j) (as i) (O.meet-left (as i) (as j)) (bs i))) (sym (cocycle-equation i j)))
     (trans (T.action-add (overlap i j) (right i j) (cocycle i j)
      (MO.restrict (overlap i j) (as i) (O.meet-left (as i) (as j)) (bs i)))
      (trans (ap (T.action (overlap i j) (right i j)) (equation i j))
       (sym (T.action-res (overlap i j) (as j) (O.meet-right (as i) (as j)) (ts j) (bs j)))))) ;
  glued : TC.Amalgam corrected = (TS.glue corrected compatible).1 ;
  global-section : T.presheaf.obj L.top = TC.amalgam glued ;
  global-restricts (i : Fin n) : Id (T.presheaf.obj (as i))
   (T.presheaf.res (as i) L.top (O.le-top (as i)) global-section) (corrected i) = TC.matches glued i ;
  opaque glued ; opaque global-section ;
 } ;
} ;
