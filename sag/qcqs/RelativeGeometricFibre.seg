-- Identify fibres of q:h_X->h_k with actual points over Spec k (§5).
-- Suppose s p=Spec(q(p)) on every affine probe.  The fibre equation
-- q(p)=iota gives a point over k by applying Spec and that equation.
-- Conversely s p=Spec iota gives q(p)=iota by injectivity of the affine
-- map equivalence.  These maps retain p, so inverse laws and naturality
-- are point extensionality.  No fibre carrier is identified by computation.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module T = AffineTests[l] ;
module RH = RingHom[l] ;
module SP = Spaces[l] ;
module SF = TestFunctors[l] ;
module Over (K : T.Test) (X : SP.Space) (s : SP.Hom X (T.space K))
 (q : SF.Transform[SF.Geometric[X].functor,SF.Representable[K].functor].Nat)
 (equation : (B : T.Test) (p : SP.Hom (T.space B) X) -> Id (SP.Hom (T.space B) (T.space K))
  (SP.compose (T.space B) X (T.space K) s p)
  T.Map[K,B,SF.Transform[SF.Geometric[X].functor,SF.Representable[K].functor].at q B p].morphism) {
 module F = RelativeFibres[l].Over[K,SF.Geometric[X].functor,q] ;
 module G = RelativeGeometric[l].Over[K,X,s] ;
 module E = RelativeEquivalences[l].Over[K] ;
 module BP = F.BP ;
 forward (A : BP.Algebra) (p : F.obj A) : G.P.Points A = (F.point p,
  trans (equation (BP.test A) (F.point p)) (ap (\ i -> T.Map[K,BP.test A,i].morphism) (F.member p))) ;
 back (A : BP.Algebra) (p : G.P.Points A) : F.obj A = (G.P.point p,
  trans (sym (T.MapsEquivalence[K,BP.test A].extract-map (F.N.at q (BP.test A) (G.P.point p))))
   (trans (ap T.MapsEquivalence[K,BP.test A].extract
     (trans (sym (equation (BP.test A) (G.P.point p))) (G.P.base p))) (T.MapsEquivalence[K,BP.test A].extract-map (BP.iota A)))) ;
 back-point (A : BP.Algebra) (p : G.P.Points A) : Id (SP.Hom (T.space (BP.test A)) X)
  (F.point {A} (back A p)) (G.P.point p) = refl (G.P.point p) ;
 opaque back ;
 right (A : BP.Algebra) (p : G.P.Points A) : Id (G.P.Points A) (forward A (back A p)) p =
  G.P.point-ext A (forward A (back A p)) p (back-point A p) ;
 left (A : BP.Algebra) (p : F.obj A) : Id (F.obj A) (back A (forward A p)) p =
  F.ext A (back A (forward A p)) p (back-point A (forward A p)) ;
 transformation : F.R.Transform[F.functor,G.functor].Nat = (forward,\ A B h p -> G.P.point-ext B _ _ (refl
  (SP.compose (T.space (BP.test B)) (T.space (BP.test A)) X (F.point p) T.Map[BP.test A,BP.test B,BP.ring-map h].morphism))) ;
 equivalence : E.NaturalEquivalence F.functor G.functor = (transformation,\ A -> Pr.qinv (F.obj A) (G.P.Points A) (forward A) (back A)
  (right A) (left A)) ;
 opaque equivalence ;
} ;
