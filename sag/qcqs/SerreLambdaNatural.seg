-- Naturality of lambda along a natural linear map q : M -> N.
-- For an open a and g in O(a), localise q_a : M(a) -> N(a) at g, giving
-- x/g^p |-> q_a(x)/g^p. Then
--   lambda^N_(a,g)(q_a(x)/g^p) = q_(D_a g)(lambda^M_(a,g)(x/g^p)).
-- Both sides clear g^p to q_(D)(x|D) = q_a(x)|D: the left by the fraction
-- formula of lambda^N and naturality of q; the right because q_D is
-- O(D)-linear, so commutes with g^p, and by the fraction formula of
-- lambda^M. g acts invertibly on N(D), so they agree
-- (SerreLambdaElementary.Agree).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module DL = DistLattice[l] ;
module RH = RingHom[l] ; module MM = SerreModuleMaps[l] ;
module MS = SerreModuleSheaf[l] ; module LC = SerreModuleLocalisation[l] ;
module On (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged)
 (M N : MS.On[L,X.sheaf].ModuleSheaf) (q : MS.On[L,X.sheaf].Transform[M.presheaf,N.presheaf].Hom) (a : L.L) {
 module H = MS.On[L,X.sheaf].Transform[M.presheaf,N.presheaf] ;
 module MO = MS.On[L,X.sheaf].Of[M.presheaf] ; module NO = MS.On[L,X.sheaf].Of[N.presheaf] ;
 module At (g : (X.sheaf.ring a).R) {
  module LM = SerreLambda[l].On[L,X,M,a].At[g] ;
  module LN = SerreLambda[l].On[L,X,N,a].At[g] ;
  open-g : L.L = LM.open-g ;
  R : CRing = X.sheaf.ring a ;
  module Q = SerreModuleLocalisationMaps[l].Along[R,R,RH.identity R,M.presheaf.module-at a,N.presheaf.module-at a,q.component a,g] ;
  localised (z : LM.Source) : LN.Source = Q.induced z ;
  localised-fraction (x : (M.presheaf.module-at a).M) (p : Nat) :
   Id LN.Source (localised (LM.fraction x p)) (LN.fraction (H.at q a x) p) = Q.fraction-map x p ;
  module TM = LC.At[R,LM.C.Scalars.restricted,g] ;
  module TN = LC.At[R,LN.C.Scalars.restricted,g] ;
  -- q at D_a g commutes with the action of g^p
  commutes (p : Nat) (y : (M.presheaf.module-at open-g).M) :
   Id (N.presheaf.module-at open-g).M (TN.power p (H.at q open-g y)) (H.at q open-g (TM.power p y)) =
   trans (TN.power-scalar p (H.at q open-g y))
    (trans (sym (H.at-scale q open-g (RingMaps[l].map LM.C.ring-map (AffinePowers[l].Over[R].power g p)) y))
     (ap (H.at q open-g) (sym (TM.power-scalar p y)))) ;
  value (x : (M.presheaf.module-at a).M) : (N.presheaf.module-at open-g).M = H.at q open-g (MO.restrict open-g a LM.below x) ;
  left-clears (x : (M.presheaf.module-at a).M) (p : Nat) :
   Id (N.presheaf.module-at open-g).M (TN.power p (LN.map (localised (LM.fraction x p)))) (value x) =
   calc (N.presheaf.module-at open-g).M {
    TN.power p (LN.map (localised (LM.fraction x p)))
     =< ap (\ z -> TN.power p (LN.map z)) (localised-fraction x p) > TN.power p (LN.map (LN.fraction (H.at q a x) p))
     =< LN.C.clears (H.at q a x) p > NO.restrict open-g a LN.below (H.at q a x)
     =< sym (q.natural open-g a LM.below x) > value x } ;
  right-clears (x : (M.presheaf.module-at a).M) (p : Nat) :
   Id (N.presheaf.module-at open-g).M (TN.power p (H.at q open-g (LM.map (LM.fraction x p)))) (value x) =
   trans (commutes p (LM.map (LM.fraction x p))) (ap (H.at q open-g) (LM.C.clears x p)) ;
  module Same = SerreLambdaElementary[l].Agree[R,M.presheaf.module-at a,LN.C.Scalars.restricted,g,LN.C.invertible,
   value,\ z -> LN.map (localised z),\ z -> H.at q open-g (LM.map z),left-clears,right-clears] ;
  square (z : LM.Source) :
   Id (N.presheaf.module-at open-g).M (LN.map (localised z)) (H.at q open-g (LM.map z)) = Same.same z ;
 } ;
} ;
