-- A subordinate partition of unity (Serre note, Section 8,
-- Proposition prop:principalcover).
-- Hypothesis: every torsor under a quasi-coherent module merely has a
-- global section (SerreTorsor.Acyclic1 for every quasi-coherent M).
-- Proposition.  For an actual finite affine cover u_1, .., u_m there
-- merely are f_i in A = O(1) with sum_i f_i = 1 and D(f_i) <= u_i; then
-- \/ D(f_i) = 1, each D(f_i) is affine, and \/ D_A(f_i) = 1 in Zar(A).
-- Proof.  Form the partition torsor T under K for J_i = J_(u_i)
-- (SerrePartition).  K is quasi-coherent (SerrePartitionQuasiCoherent);
-- the hypothesis for K gives merely f_i in J_i(1), sum f_i = 1
-- (SerrePartition.partition), i.e. D(f_i) <= u_i.  From one such family:
--  covering: 1 = D(1) = D(sum f_i) <= \/ D(f_i) (support laws for 0, +);
--  affine: D(f_i) = u_i /\ D(f_i) = D_(u_i)(f_i|u_i), a principal open of
--   the affine u_i, hence affine (SerreRingLocalisation.Principal);
--  Zariski: 1 = sum_i 1.f_i lies in the ideal (f_1, .., f_m), so the top
--   (1) of Zar(A) is below the class of (f_1, .., f_m), which is
--   \/ D_A(f_i) (ZariskiLattice.generated-at).
-- For m = 0 the same steps apply: the empty sum is 1 = 0 in A.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module DL = DistLattice[l] ;
module MS = SerreModuleSheaf[l] ;
module SI = SerreSupportIdeal[l] ;
module On (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged) {
 module O = DL.Order[L] ;
 module J = DL.Joins[L] ;
 module Q = Qcqs[l].Over[L,X] ;
 module GO = RingedLattice[l].On[L].Of[X.sheaf] ;
 module LX = LocallyRinged[l].On[L].Laws[X.sheaf,X.inv] ;
 module ZA = ZariskiLattice[l].Over[X.sheaf.ring L.top] ;
 -- the hypothesis of the Serre criterion
 Hypothesis : U l+ = (M : MS.On[L,X.sheaf].ModuleSheaf) ->
  SerreQuasiCoherent[l].On[L,X,M].IsQuasiCoherent -> SerreTorsor[l].On[L,X.sheaf].Over[M].Acyclic1 ;
 module Sums (a : L.L) {
  module RS = FiniteIdeal[l].Sums[X.sheaf.ring a] ;
  module MSum = SerreModuleSums[l].Over[X.sheaf.ring a,SerreModuleSheafStructure[l].On[L,X.sheaf,X.is-sheaf].presheaf.module-at a] ;
  -- the module sum of the regular module is the ring sum
  same : (n : Nat) (v : Fin n -> (X.sheaf.ring a).R) -> Id (X.sheaf.ring a).R (MSum.sum n v) (RS.sum n v) = split {
   zero -> \ v -> MSum.sum-empty v ;
   suc n | ih -> \ v -> trans (MSum.sum-step n v) (ap ((X.sheaf.ring a).add (v (inr tt))) (ih (\ i -> v (inl i)))) } ;
  -- D_a(sum_i v_i) <= \/ D_a(v_i)
  support-sum : (n : Nat) (v : Fin n -> (X.sheaf.ring a).R) ->
   O.Le (LX.d a (RS.sum n v)) (J.bigJ n (\ i -> LX.d a (v i))) = split {
   zero -> \ v -> O.le-of-eq _ _ (SI.Support[L,X].zero-support a) ;
   suc n | ih -> \ v ->
    O.le-trans (LX.d a (RS.sum (suc n) v)) (L.join (LX.d a (v (inr tt))) (LX.d a (RS.sum n (\ i -> v (inl i)))))
     (J.bigJ (suc n) (\ i -> LX.d a (v i)))
     (SI.Support[L,X].add-support a (v (inr tt)) (RS.sum n (\ i -> v (inl i))))
     (O.join-mono (LX.d a (v (inr tt))) (LX.d a (RS.sum n (\ i -> v (inl i))))
       (LX.d a (v (inr tt))) (J.bigJ n (\ i -> LX.d a (v (inl i))))
       (O.le-refl (LX.d a (v (inr tt)))) (ih (\ i -> v (inl i)))) } ;
 } ;
 -- the conclusion of Proposition prop:principalcover, for the cover u_i
 module Cover (cover : Q.AffineCover) {
  module P = SerrePartition[l].On[L,X,cover.count,cover.opens,cover.covers] ;
  module RS = Sums[L.top].RS ;
  record PrincipalCover {
   units : Fin cover.count -> (X.sheaf.ring L.top).R ;
   sum-one : Id (X.sheaf.ring L.top).R (RS.sum cover.count units) (X.sheaf.ring L.top).o ;
   below : (i : Fin cover.count) -> O.Le (LX.d L.top (units i)) (cover.opens i) ;
   covers : Id L.L (J.bigJ cover.count (\ i -> LX.d L.top (units i))) L.top ;
   affine : (i : Fin cover.count) -> Q.AffineOpen (LX.d L.top (units i)) ;
   zariski : Id ZA.lattice.L (ZA.J.bigJ cover.count (\ i -> ZA.D (units i))) ZA.lattice.top ;
  } ;
  -- from one family f_i in J_i(1) with sum 1
  module FromPartition (p : P.Partition) {
   units (i : Fin cover.count) : (X.sheaf.ring L.top).R = p.1 i ;
   sum-one : Id (X.sheaf.ring L.top).R (RS.sum cover.count units) (X.sheaf.ring L.top).o =
    trans (sym (Sums[L.top].same cover.count units)) p.2.2 ;
   below (i : Fin cover.count) : O.Le (LX.d L.top (units i)) (cover.opens i) = p.2.1 i ;
   -- 1 = D(1) = D(sum f_i) <= \/ D(f_i)
   top-below : O.Le L.top (J.bigJ cover.count (\ i -> LX.d L.top (units i))) =
    O.le-trans L.top (LX.d L.top (RS.sum cover.count units)) (J.bigJ cover.count (\ i -> LX.d L.top (units i)))
     (O.le-of-eq L.top (LX.d L.top (RS.sum cover.count units))
      (trans (sym (LX.one-law L.top)) (ap (LX.d L.top) (sym sum-one))))
     (Sums[L.top].support-sum cover.count units) ;
   covers : Id L.L (J.bigJ cover.count (\ i -> LX.d L.top (units i))) L.top =
    O.le-antisym (J.bigJ cover.count (\ i -> LX.d L.top (units i))) L.top
     (O.le-top (J.bigJ cover.count (\ i -> LX.d L.top (units i)))) top-below ;
   -- D(f_i) = u_i /\ D(f_i) = D_(u_i)(f_i|u_i)
   local (i : Fin cover.count) : (X.sheaf.ring (cover.opens i)).R =
    GO.restrict (cover.opens i) L.top (O.le-top (cover.opens i)) (units i) ;
   local-open (i : Fin cover.count) : Id L.L (LX.d (cover.opens i) (local i)) (LX.d L.top (units i)) =
    trans (SI.Support[L,X].restrict-support L.top (cover.opens i) (O.le-top (cover.opens i)) (units i))
     (trans (L.meetC (cover.opens i) (LX.d L.top (units i))) (below i)) ;
   affine (i : Fin cover.count) : Q.AffineOpen (LX.d L.top (units i)) =
    Pr.subst L.L Q.AffineOpen _ _ (local-open i) SerreRingLocalisation[l].Principal[L,X,cover.opens i,cover.affine i,local i].affine-open ;
   -- 1 is in the ideal (f_1, .., f_m): 1 = sum_i f_i 1
   module FL = FamilyLattice[l].Over[X.sheaf.ring L.top] ;
   module RO = Radical[l].Over[X.sheaf.ring L.top] ;
   family : RO.Fam = (cover.count,units) ;
   one-combination : Id (X.sheaf.ring L.top).R (RS.lin cover.count units (\ i -> (X.sheaf.ring L.top).o)) (X.sheaf.ring L.top).o =
    trans (RS.sum-cong cover.count (\ i -> (X.sheaf.ring L.top).mul (units i) (X.sheaf.ring L.top).o) units
     (\ i -> (X.sheaf.ring L.top).mulO (units i))) sum-one ;
   unit-below : RO.Le FL.unitF family = \ i -> FL.inc family (X.sheaf.ring L.top).o
    (zero,(\ k -> (X.sheaf.ring L.top).o,one-combination)) ;
   zariski : Id ZA.lattice.L (ZA.J.bigJ cover.count (\ i -> ZA.D (units i))) ZA.lattice.top =
    ZA.O.le-antisym (ZA.J.bigJ cover.count (\ i -> ZA.D (units i))) ZA.lattice.top
     (ZA.O.le-top (ZA.J.bigJ cover.count (\ i -> ZA.D (units i))))
     (ZA.O.le-trans ZA.lattice.top (ZA.cls family) (ZA.J.bigJ cover.count (\ i -> ZA.D (units i)))
      (ZA.order FL.unitF family unit-below)
      (ZA.O.le-of-eq (ZA.cls family) (ZA.J.bigJ cover.count (\ i -> ZA.D (units i))) (ZA.generated-at cover.count units))) ;
   result : PrincipalCover = new PrincipalCover[
    units := units, sum-one := sum-one, below := below, covers := covers, affine := affine, zariski := zariski] ;
  } ;
  -- one application of the hypothesis, to the quasi-coherent K
  principal-cover (hypothesis : Hypothesis) : Tr.Trunc[PrincipalCover].carrier =
   Tr.Trunc[P.Partition].induction @l (\ w -> Tr.Trunc[PrincipalCover].carrier) (\ w -> Tr.Trunc[PrincipalCover].proposition)
    (\ p -> Tr.Trunc[PrincipalCover].inc FromPartition[p].result)
    (P.partition (hypothesis P.kernel SerrePartitionQuasiCoherent[l].On[L,X,cover].quasi-coherent)) ;
  -- the same from one global section of the partition torsor
  principal-cover-at (section : Tr.Trunc[P.torsor.presheaf.obj L.top].carrier) : Tr.Trunc[PrincipalCover].carrier =
   Tr.Trunc[P.Partition].induction @l (\ w -> Tr.Trunc[PrincipalCover].carrier) (\ w -> Tr.Trunc[PrincipalCover].proposition)
    (\ p -> Tr.Trunc[PrincipalCover].inc FromPartition[p].result) (P.partition-at section) ;
 } ;
} ;
