-- The sections of the structure sheaf on an arbitrary open u of L_A
-- (DESIGN.md, step 3).  Over the family f_g : A -> R_g of Restriction:
--
--   O(u) = { s in Pi (g : A) (D g <= u), R_g  |
--            rho_{g,h}(s_g) = s_h whenever D h <= D g }.
--
-- The witness of D h <= D g is a proof of an equation in the set L_A, so
-- rho_{g,h} and the components s_g do not depend on it (rho-irr,
-- component-irr).  Compatibility is a proposition (each R_h is a set), so
-- two sections with the same components are equal (section-ext); every
-- equation between sections below is proved by its components.
--
-- Restriction to u <= v forgets components: (s|u)_g = s_g, by definition.
-- Then s|v = s and (s|v)|u = s|u by section-ext and component-irr.
-- The ring operations are taken componentwise; the components of a sum
-- are compatible since each rho_{g,h} is a ring map.  The ring laws hold
-- componentwise, and restriction is a ring map, by definition on
-- components, and so is the component s |-> s_g.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (A : CRing) (Loc : A.R -> CRing) (set : (g : A.R) -> Pr.isSet (Loc g).R)
 (f : (g : A.R) -> RH.Hom A (Loc g))
 (el : (g : A.R) -> Bridge[l].Over[A,g].LocH.Elementary (Loc g) (f g)) {
 open A ;
 open ZariskiLattice[l].Over[A] ;
 module Rs = Restriction[l].Over[A,Loc,set,f,el] ;

 rho (g h : R) (le : O.Le (D h) (D g)) : RH.Hom (Loc g) (Loc h) = Rs.Pair[g,h,le].rho ;
 rho-irr (g h : R) (le le' : O.Le (D h) (D g)) : Id (RH.Hom (Loc g) (Loc h)) (rho g h le) (rho g h le') =
  ap (\ k -> rho g h k) (O.le-prop (D h) (D g) le le') ;
 -- Restriction's rho-on, rho-id and rho-comp, on elements
 rho-on (g h : R) (le : O.Le (D h) (D g)) (a : R) : Id (Loc h).R (map (rho g h le) (map (f g) a)) (map (f h) a) =
  Rs.Pair[g,h,le].rho-on a ;
 rho-id-at (g : R) (le : O.Le (D g) (D g)) (x : (Loc g).R) : Id (Loc g).R (map (rho g g le) x) x =
  trans (ap (\ phi -> map phi x) (Rs.rho-id g le)) (map-identity x) ;
 rho-comp-at (g h k : R) (hg : O.Le (D h) (D g)) (kh : O.Le (D k) (D h)) (kg : O.Le (D k) (D g)) (x : (Loc g).R) :
  Id (Loc k).R (map (rho h k kh) (map (rho g h hg) x)) (map (rho g k kg) x) =
  trans (sym (map-compose (rho h k kh) (rho g h hg) x)) (ap (\ phi -> map phi x) (Rs.rho-comp g h k hg kh kg)) ;

 -- families over the g with D g <= u, and their compatibility
 Family (u : lattice.L) : U l = (g : R) -> O.Le (D g) u -> (Loc g).R ;
 Compatible (u : lattice.L) (s : Family u) : U l =
  (g h : R) (kg : O.Le (D g) u) (hg : O.Le (D h) (D g)) ->
   Id (Loc h).R (map (rho g h hg) (s g kg)) (s h (O.le-trans (D h) (D g) u hg kg)) ;
 Section (u : lattice.L) : U l = (s : Family u) * Compatible u s ;
 at {u : lattice.L} (s : Section u) (g : R) (k : O.Le (D g) u) : (Loc g).R = s.1 g k ;
 compat {u : lattice.L} (s : Section u) (g h : R) (kg : O.Le (D g) u) (hg : O.Le (D h) (D g)) :
  Id (Loc h).R (map (rho g h hg) (at s g kg)) (at s h (O.le-trans (D h) (D g) u hg kg)) = s.2 g h kg hg ;

 component-irr (u : lattice.L) (s : Section u) (g : R) (k k' : O.Le (D g) u) : Id (Loc g).R (at s g k) (at s g k') =
  ap (\ m -> at s g m) (O.le-prop (D g) u k k') ;
 compatible-prop (u : lattice.L) (s : Family u) : Pr.isProp (Compatible u s) =
  F.isProp-Pi R (\ g -> (h : R) (kg : O.Le (D g) u) (hg : O.Le (D h) (D g)) ->
    Id (Loc h).R (map (rho g h hg) (s g kg)) (s h (O.le-trans (D h) (D g) u hg kg))) (\ g ->
  F.isProp-Pi R (\ h -> (kg : O.Le (D g) u) (hg : O.Le (D h) (D g)) ->
    Id (Loc h).R (map (rho g h hg) (s g kg)) (s h (O.le-trans (D h) (D g) u hg kg))) (\ h ->
  F.isProp-Pi (O.Le (D g) u) (\ kg -> (hg : O.Le (D h) (D g)) ->
    Id (Loc h).R (map (rho g h hg) (s g kg)) (s h (O.le-trans (D h) (D g) u hg kg))) (\ kg ->
  F.isProp-Pi (O.Le (D h) (D g)) (\ hg ->
    Id (Loc h).R (map (rho g h hg) (s g kg)) (s h (O.le-trans (D h) (D g) u hg kg))) (\ hg ->
  set h _ _)))) ;
 family-ext (u : lattice.L) (s t : Family u) (e : (g : R) (k : O.Le (D g) u) -> Id (Loc g).R (s g k) (t g k)) :
  Id (Family u) s t =
  F.funext R (\ g -> O.Le (D g) u -> (Loc g).R) s t
   (\ g -> F.funext (O.Le (D g) u) (\ k -> (Loc g).R) (s g) (t g) (e g)) ;
 section-ext (u : lattice.L) (s t : Section u) (e : (g : R) (k : O.Le (D g) u) -> Id (Loc g).R (at s g k) (at t g k)) :
  Id (Section u) s t =
  Pr.Sigma-eq (Family u) (Compatible u) s.1 t.1 s.2 t.2 (family-ext u s.1 t.1 e) (compatible-prop u t.1) ;
 section-set (u : lattice.L) : Pr.isSet (Section u) =
  Pr.isSet-Sigma (Family u) (Compatible u)
   (F.isSet-Pi R (\ g -> O.Le (D g) u -> (Loc g).R)
     (\ g -> F.isSet-Pi (O.Le (D g) u) (\ k -> (Loc g).R) (\ k -> set g)))
   (\ s -> Pr.prop-to-set (Compatible u s) (compatible-prop u s)) ;

 -- restriction to u <= v forgets components
 restrict (u v : lattice.L) (uv : O.Le u v) (s : Section v) : Section u =
  (\ g k -> at s g (O.le-trans (D g) u v k uv),
   \ g h kg hg -> trans (compat s g h (O.le-trans (D g) u v kg uv) hg)
    (component-irr v s h (O.le-trans (D h) (D g) v hg (O.le-trans (D g) u v kg uv))
      (O.le-trans (D h) u v (O.le-trans (D h) (D g) u hg kg) uv))) ;
 restrict-at (u v : lattice.L) (uv : O.Le u v) (s : Section v) (g : R) (k : O.Le (D g) u) :
  Id (Loc g).R (at (restrict u v uv s) g k) (at s g (O.le-trans (D g) u v k uv)) =
  refl (at s g (O.le-trans (D g) u v k uv)) ;
 restrict-id (u : lattice.L) (uu : O.Le u u) (s : Section u) : Id (Section u) (restrict u u uu s) s =
  section-ext u (restrict u u uu s) s
   (\ g k -> trans (restrict-at u u uu s g k) (component-irr u s g (O.le-trans (D g) u u k uu) k)) ;
 restrict-comp (u v w : lattice.L) (uv : O.Le u v) (vw : O.Le v w) (uw : O.Le u w) (s : Section w) :
  Id (Section u) (restrict u v uv (restrict v w vw s)) (restrict u w uw s) =
  section-ext u (restrict u v uv (restrict v w vw s)) (restrict u w uw s)
   (\ g k -> component-irr w s g (O.le-trans (D g) v w (O.le-trans (D g) u v k uv) vw) (O.le-trans (D g) u w k uw)) ;

 -- the ring O(u), componentwise
 module Ops (u : lattice.L) {
  zeroS : Section u = (\ g k -> (Loc g).z, \ g h kg hg -> map-zero (rho g h hg)) ;
  oneS : Section u = (\ g k -> (Loc g).o, \ g h kg hg -> map-one (rho g h hg)) ;
  addS (s t : Section u) : Section u =
   (\ g k -> (Loc g).add (at s g k) (at t g k),
    \ g h kg hg -> trans (map-add (rho g h hg) (at s g kg) (at t g kg))
     (cong2 (Loc h).R (Loc h).add _ _ _ _ (compat s g h kg hg) (compat t g h kg hg))) ;
  mulS (s t : Section u) : Section u =
   (\ g k -> (Loc g).mul (at s g k) (at t g k),
    \ g h kg hg -> trans (map-mul (rho g h hg) (at s g kg) (at t g kg))
     (cong2 (Loc h).R (Loc h).mul _ _ _ _ (compat s g h kg hg) (compat t g h kg hg))) ;
  negS (s : Section u) : Section u =
   (\ g k -> (Loc g).neg (at s g k),
    \ g h kg hg -> trans (map-neg (rho g h hg) (at s g kg)) (ap (Loc h).neg (compat s g h kg hg))) ;
  -- the components of sums and products, by definition
  add-at (s t : Section u) (g : R) (k : O.Le (D g) u) :
   Id (Loc g).R (at (addS s t) g k) ((Loc g).add (at s g k) (at t g k)) = refl ((Loc g).add (at s g k) (at t g k)) ;
  mul-at (s t : Section u) (g : R) (k : O.Le (D g) u) :
   Id (Loc g).R (at (mulS s t) g k) ((Loc g).mul (at s g k) (at t g k)) = refl ((Loc g).mul (at s g k) (at t g k)) ;
  ext (s t : Section u) (e : (g : R) (k : O.Le (D g) u) -> Id (Loc g).R (at s g k) (at t g k)) : Id (Section u) s t =
   section-ext u s t e ;
  ring : CRing = mkCRing (Section u) zeroS oneS addS mulS negS
   (\ s t w -> ext (addS s (addS t w)) (addS (addS s t) w) (\ g k -> (Loc g).addA (at s g k) (at t g k) (at w g k)))
   (\ s t -> ext (addS s t) (addS t s) (\ g k -> (Loc g).addC (at s g k) (at t g k)))
   (\ s -> ext (addS s zeroS) s (\ g k -> (Loc g).addZ (at s g k)))
   (\ s -> ext (addS s (negS s)) zeroS (\ g k -> (Loc g).addN (at s g k)))
   (\ s t w -> ext (mulS s (mulS t w)) (mulS (mulS s t) w) (\ g k -> (Loc g).mulA (at s g k) (at t g k) (at w g k)))
   (\ s t -> ext (mulS s t) (mulS t s) (\ g k -> (Loc g).mulC (at s g k) (at t g k)))
   (\ s -> ext (mulS s oneS) s (\ g k -> (Loc g).mulO (at s g k)))
   (\ s t w -> ext (mulS s (addS t w)) (addS (mulS s t) (mulS s w)) (\ g k -> (Loc g).dist (at s g k) (at t g k) (at w g k))) ;
 } ;
 ring (u : lattice.L) : CRing = Ops[u].ring ;
 ring-set (u : lattice.L) : Pr.isSet (ring u).R = section-set u ;

 -- the component at g is a ring map pi_g : O(u) -> R_g
 component (u : lattice.L) (g : R) (k : O.Le (D g) u) : RH.Hom (ring u) (Loc g) =
  (\ s -> at s g k,refl (Loc g).o,\ s t -> Ops[u].add-at s t g k,\ s t -> Ops[u].mul-at s t g k) ;
 component-map (u : lattice.L) (g : R) (k : O.Le (D g) u) (s : Section u) :
  Id (Loc g).R (map (component u g k) s) (at s g k) = refl (at s g k) ;

 -- restriction is a ring map (the components agree by definition)
 restrict-one (u v : lattice.L) (uv : O.Le u v) : Id (Section u) (restrict u v uv Ops[v].oneS) Ops[u].oneS =
  section-ext u (restrict u v uv Ops[v].oneS) Ops[u].oneS (\ g k -> refl (Loc g).o) ;
 restrict-add (u v : lattice.L) (uv : O.Le u v) (s t : Section v) :
  Id (Section u) (restrict u v uv (Ops[v].addS s t)) (Ops[u].addS (restrict u v uv s) (restrict u v uv t)) =
  section-ext u (restrict u v uv (Ops[v].addS s t)) (Ops[u].addS (restrict u v uv s) (restrict u v uv t))
   (\ g k -> calc (Loc g).R {
    at (restrict u v uv (Ops[v].addS s t)) g k
     =< restrict-at u v uv (Ops[v].addS s t) g k > at (Ops[v].addS s t) g (O.le-trans (D g) u v k uv)
     =< Ops[v].add-at s t g (O.le-trans (D g) u v k uv)
      > (Loc g).add (at s g (O.le-trans (D g) u v k uv)) (at t g (O.le-trans (D g) u v k uv))
     =< sym (cong2 (Loc g).R (Loc g).add _ _ _ _ (restrict-at u v uv s g k) (restrict-at u v uv t g k))
      > (Loc g).add (at (restrict u v uv s) g k) (at (restrict u v uv t) g k)
     =< sym (Ops[u].add-at (restrict u v uv s) (restrict u v uv t) g k)
      > at (Ops[u].addS (restrict u v uv s) (restrict u v uv t)) g k }) ;
 restrict-mul (u v : lattice.L) (uv : O.Le u v) (s t : Section v) :
  Id (Section u) (restrict u v uv (Ops[v].mulS s t)) (Ops[u].mulS (restrict u v uv s) (restrict u v uv t)) =
  section-ext u (restrict u v uv (Ops[v].mulS s t)) (Ops[u].mulS (restrict u v uv s) (restrict u v uv t))
   (\ g k -> calc (Loc g).R {
    at (restrict u v uv (Ops[v].mulS s t)) g k
     =< restrict-at u v uv (Ops[v].mulS s t) g k > at (Ops[v].mulS s t) g (O.le-trans (D g) u v k uv)
     =< Ops[v].mul-at s t g (O.le-trans (D g) u v k uv)
      > (Loc g).mul (at s g (O.le-trans (D g) u v k uv)) (at t g (O.le-trans (D g) u v k uv))
     =< sym (cong2 (Loc g).R (Loc g).mul _ _ _ _ (restrict-at u v uv s g k) (restrict-at u v uv t g k))
      > (Loc g).mul (at (restrict u v uv s) g k) (at (restrict u v uv t) g k)
     =< sym (Ops[u].mul-at (restrict u v uv s) (restrict u v uv t) g k)
      > at (Ops[u].mulS (restrict u v uv s) (restrict u v uv t)) g k }) ;
 restriction (u v : lattice.L) (uv : O.Le u v) : RH.Hom (ring v) (ring u) =
  (restrict u v uv,restrict-one u v uv,restrict-add u v uv,restrict-mul u v uv) ;
} ;
