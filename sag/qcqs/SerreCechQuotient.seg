-- Small additive quotients used for the Cech quotient (note, Section 5).
-- For a linear map d:B->C, identify x and y when merely y=x+d(b).
-- Zero, negatives and addition of witnesses prove that this is an
-- equivalence relation. The effective small quotient therefore identifies
-- precisely these pairs. Its zero class consists exactly of the image
-- of d, merely. This construction is generic; instantiating d with the
-- coboundary on cocycles is a separate step.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module SM = SerreModule[l] ;
module MM = SerreModuleMaps[l] ;
module Tr = Truncation[l] ;
module Over (A : CRing) (B C : SM.Over[A].Module)
 (d : MM.Between[A,A,RingHom[l].identity A,B,C].Hom) {
 module D = MM.Between[A,A,RingHom[l].identity A,B,C] ;
 module Laws = SM.Over[A].Laws[C] ;
 Witness (x y : C.M) : U l = (b : B.M) * Id C.M y (C.madd x (D.map d b)) ;
 Related (x y : C.M) : U l = Tr.Trunc[Witness x y].carrier ;
 related-prop (x y : C.M) : Pr.isProp (Related x y) = Tr.Trunc[Witness x y].proposition ;
 reflexive (x : C.M) : Related x x = Tr.Trunc[Witness x x].inc
  (B.mz,sym (trans (ap (C.madd x) (D.map-zero d)) (C.maddZ x))) ;
 inverse-witness (x y : C.M) (w : Witness x y) : Witness y x =
  (B.mneg w.1,sym (trans (ap (\ z -> C.madd z (D.map d (B.mneg w.1))) w.2)
   (trans (ap (C.madd (C.madd x (D.map d w.1))) (D.map-neg d w.1))
    (trans (sym (C.maddA x (D.map d w.1) (C.mneg (D.map d w.1))))
     (trans (ap (C.madd x) (C.maddN (D.map d w.1))) (C.maddZ x)))))) ;
 symmetric (x y : C.M) (r : Related x y) : Related y x =
  Tr.Trunc[Witness x y].induction @l (\ z -> Related y x) (\ z -> related-prop y x)
   (\ w -> Tr.Trunc[Witness y x].inc (inverse-witness x y w)) r ;
 compose-witness (x y z : C.M) (v : Witness x y) (w : Witness y z) : Witness x z =
  (B.madd v.1 w.1,trans w.2
   (trans (ap (\ u -> C.madd u (D.map d w.1)) v.2)
    (trans (sym (C.maddA x (D.map d v.1) (D.map d w.1)))
     (ap (C.madd x) (sym (D.map-add d v.1 w.1)))))) ;
 transitive (x y z : C.M) (v : Related x y) (w : Related y z) : Related x z =
  Tr.Trunc[Witness x y].induction @l (\ t -> Related x z) (\ t -> related-prop x z)
   (\ u -> Tr.Trunc[Witness y z].induction @l (\ t -> Related x z) (\ t -> related-prop x z)
    (\ u2 -> Tr.Trunc[Witness x z].inc (compose-witness x y z u u2)) w) v ;
 module Q = Quotient[l].Quot[C.M,Related,related-prop,reflexive,symmetric,transitive] ;
 Class : U l = Q.Q ;
 set : Pr.isSet Class = Q.set ;
 class (x : C.M) : Class = Q.inc x ;
 zero : Class = class C.mz ;
 class-equal (x y : C.M) (r : Related x y) : Id Class (class x) (class y) = Q.relates x y r ;
 class-effective (x y : C.M) (p : Id Class (class x) (class y)) : Related x y = Q.effective x y p ;
 Image (y : C.M) : U l = Tr.Trunc[(b : B.M) * Id C.M y (D.map d b)].carrier ;
 image-zero (y : C.M) (h : Image y) : Id Class (class y) zero =
  Tr.Trunc[(b : B.M) * Id C.M y (D.map d b)].induction @l
   (\ w -> Id Class (class y) zero) (\ w -> set (class y) zero)
   (\ w -> sym (class-equal C.mz y (Tr.Trunc[Witness C.mz y].inc
    (w.1,trans w.2 (sym (Laws.zero-left (D.map d w.1))))))) h ;
 zero-image (y : C.M) (p : Id Class (class y) zero) : Image y =
  Tr.Trunc[Witness C.mz y].induction @l (\ w -> Image y)
   (\ w -> Tr.Trunc[(b : B.M) * Id C.M y (D.map d b)].proposition)
   (\ w -> Tr.Trunc[(b : B.M) * Id C.M y (D.map d b)].inc
    (w.1,trans w.2 (Laws.zero-left (D.map d w.1)))) (class-effective C.mz y (sym p)) ;
 opaque inverse-witness ; opaque compose-witness ;
} ;
