-- Reindexing a precategory along an equivalence of object types (port of
-- ~/DOMAIN/UNIT/CategorySIPReindex.seg, objects and arrows in U l).
-- For f : A -> B and a structure s on B, pullback f s is the structure on
-- A with hom x y = s.hom (f x) (f y) and the operations of s at f.  If f
-- is an equivalence, the precategory (A, pullback f s) equals (B, s): by
-- equivalence induction (UnivalenceLemmas.eqind) it suffices to take
-- f = id, where both sides are the same record (split on s).
level l ; open Base ; open Prelude[l] ;
module K = Category[l,l] ;
module S = FibreCategorySIP[l] ;
module UA = Axioms[l].UnivalenceLemmas[univ @l] ;

pullback (A B : U l) (f : A -> B) (s : S.Structure[B]) : S.Structure[A] =
 new S.Structure[A,
  hom := \ x y -> s.hom (f x) (f y),
  hom-set := \ x y -> s.hom-set (f x) (f y),
  idn := \ x -> s.idn (f x),
  comp := \ x y z g h -> s.comp (f x) (f y) (f z) g h,
  unit-l := \ x y h -> s.unit-l (f x) (f y) h,
  unit-r := \ x y h -> s.unit-r (f x) (f y) h,
  assoc := \ w x y z f0 g h -> s.assoc (f w) (f x) (f y) (f z) f0 g h] ;

module Reindex (A : U l) {
 Motive (B : U l) (e : Equiv A B) : U l+ =
  (s : S.Structure[B]) -> Id K.Precategory (S.to-pre A (pullback A B e.1 s)) (S.to-pre B s) ;
 base : Motive A (idEquiv A) =
  split { Structure h hs i c ul ur a -> refl (new K.Precategory[A,h,hs,i,c,ul,ur,a]) } ;
 equality (B : U l) (e : Equiv A B) (s : S.Structure[B]) :
  Id K.Precategory (S.to-pre A (pullback A B e.1 s)) (S.to-pre B s) =
  UA.eqind A Motive base B e s ;
} ;
