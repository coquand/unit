-- Totalising a relative affine representable gives its ordinary one.
-- A total point is (iota,h, h alpha=iota), with the commuting equation
-- given pointwise.  For fixed h the last two entries form a proposition:
-- the structure map is forced by h alpha and commuting is a proposition.
-- Reorder the total point to (h,lift); equality of h then identifies the
-- total points.  The inverse to forgetting is the canonical algebra map.
-- The two inverse laws give the equivalence; naturality is composition
-- of underlying ring maps.  This is equation (affine) in §4 of the note.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module T = AffineTests[l] ;
module RH = RingHom[l] ;
module SF = TestFunctors[l] ;
module TE = TestEquivalences[l] ;
module Over (K : T.Test) (A : RelativeTests[l].Over[K].BP.Algebra) {
 module R = RelativeFunctors[l].Over[K] ;
 module RT = R.RT ;
 module BP = R.BP ;
 module TR = RelativeTotal[l].Over[K,R.Representable[A].functor] ;
 module H = SF.Representable[BP.test A] ;
 module At (B : T.Test) {
  forget (p : TR.functor.obj B) : H.functor.obj B = BP.ring-map {A} {BP.algebra B (TR.At[B].base p)} (TR.At[B].value p) ;
  Lifts (h : H.functor.obj B) : U l = (i : RH.Hom K.ring B.ring) * RT.Commutes A (BP.algebra B i) h ;
  forced (h : H.functor.obj B) (a : Lifts h) : Id (RH.Hom K.ring B.ring) (RT.push (BP.test A) B h (BP.iota A)) a.1 =
   RH.Properties[K.ring,B.ring,B.carrier-set].ext _ _ a.2 ;
  lifts-prop (h : H.functor.obj B) : Pr.isProp (Lifts h) = \ a b ->
   Pr.Sigma-eq (RH.Hom K.ring B.ring) (\ i -> RT.Commutes A (BP.algebra B i) h) a.1 b.1 a.2 b.2
    (trans (sym (forced h a)) (forced h b)) (RT.commutes-prop A (BP.algebra B b.1) h) ;
  Data : U l = (h : H.functor.obj B) * Lifts h ;
  arrange (p : TR.functor.obj B) : Data = (forget p,(TR.At[B].base p,(TR.At[B].value p).2)) ;
  total (p : Data) : TR.functor.obj B = (p.2.1,(p.1,p.2.2)) ;
  ext (p q : TR.functor.obj B) (e : Id (H.functor.obj B) (forget p) (forget q)) : Id (TR.functor.obj B) p q =
   ap total (Pr.Sigma-eq (H.functor.obj B) Lifts (forget p) (forget q) (arrange p).2 (arrange q).2 e (lifts-prop (forget q))) ;
  inverse (h : H.functor.obj B) : TR.functor.obj B =
   (RT.push (BP.test A) B h (BP.iota A),RT.canonical (BP.test A) B h (BP.iota A)) ;
  right (h : H.functor.obj B) : Id (H.functor.obj B) (forget (inverse h)) h = refl h ;
  left (p : TR.functor.obj B) : Id (TR.functor.obj B) (inverse (forget p)) p = ext (inverse (forget p)) p (refl (forget p)) ;
 } ;
 transformation : SF.Transform[TR.functor,H.functor].Nat = (\ B -> At[B].forget,\ B C h p -> refl (RH.compose (BP.test A).ring B.ring C.ring h (At[B].forget p))) ;
 equivalence : TE.NaturalEquivalence TR.functor H.functor = (transformation,\ B ->
  Pr.qinv (TR.functor.obj B) (H.functor.obj B) At[B].forget At[B].inverse At[B].right At[B].left) ;
} ;
