-- A local basis is the equivalence given by multiplying one vector.
-- Extend a linear functional to fractions by the module universal
-- property. Linear maps out of a localisation can be compared on the
-- original numerators, using the same uniqueness principle.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module SM = SerreModule[l] ;
module RM = RingMaps[l] ; module Bil = SerreBilinear[l] ;
module PU = SerreModuleLocalisationUniversal[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module S = SM.Over[A] ; module L = Bil.Over[A] ;
 module AF = Affine[l].Over[A] ; R : S.Module = S.regular setA ;
 module Z = ZariskiLattice[l].Over[A] ; module O = Z.O ;
 module Rad = Radical[l].Over[A] ;
 module RS = FiniteIdeal[l].Sums[A] ;
 Cover (n : Nat) (fs : Fin n -> A.R) : U l = O.Le Z.lattice.top (Z.J.bigJ n (\ i -> Z.D (fs i))) ;
 cover (n : Nat) (fs : Fin n -> A.R) (coeffs : Rad.InIdeal (n,fs) A.o) : Cover n fs =
  O.le-trans Z.lattice.top (Z.cls (n,fs)) (Z.J.bigJ n (\ i -> Z.D (fs i)))
   (Z.order FamilyLattice[l].Over[A].unitF (n,fs) (\ i -> Tr.Trunc[Rad.RadData (n,fs) A.o].inc (zero,coeffs)))
   (O.le-of-eq (Z.cls (n,fs)) _ (Z.generated-at n fs)) ;
 module At (M : S.Module) (f : A.R) {
  B : CRing = AF.Loc f ;
  module LS = SerreModuleLocalisationScalarsRing[l].At[A,setA,M,f] ;
  module N = LS.Native ;
  module F = N.L ;
  module A0 = L.Hom[M,R] ;
  Rf : SM.Over[B].Module = SM.Over[B].regular (AF.set f) ;
  module LR = Bil.Over[B] ;
  module RR = SerreModuleRingLocalisationBridge[l].Over[A,setA,f,B,AF.set f,AF.inclusion f,AF.elementary f] ;
  h : A.R -> B.R = RM.map (AF.inclusion f) ;
  module Coord (x : LS.localised.M) {
   mul (a : B.R) : LS.localised.M = LS.localised.sm a x ;
   linear : LR.Linear[Rf,LS.localised].H.Hom = new LR.Linear[Rf,LS.localised].H.Hom[
    mul,\ a b -> LS.localised.smE a b x,\ a b -> sym (LS.localised.smA a b x)] ;
   Basis : U l = Pr.isEquiv B.R LS.localised.M mul ;
  } ;
  Frame : U l = (x : LS.localised.M) * Coord[x].Basis ;
  module Functional (b : A0.H.Hom) {
   compose : L.Linear[M,RR.Scalars.restricted].H.Hom = new L.Linear[M,RR.Scalars.restricted].H.Hom[
    \ x -> h (b.fn x),
    \ x y -> trans (ap h (b.additive x y)) (RM.map-add (AF.inclusion f) (b.fn x) (b.fn y)),
    \ a x -> trans (ap h (b.scalar a x)) (RM.map-mul (AF.inclusion f) a (b.fn x))] ;
   module E = PU.Extend[A,M,RR.Scalars.restricted,f,compose,RR.invertible] ;
   eval (x : F.Carrier) : B.R = E.To.map E.lift x ;
   at-original (x : M.M) : Id B.R (eval (F.fraction x zero)) (h (b.fn x)) =
    trans (E.extends x) (refl (h (b.fn x))) ;
   additive (x y : F.Carrier) : Id B.R (eval (N.localised.madd x y)) (B.add (eval x) (eval y)) = E.lift.additive x y ;
   scalar (a : A.R) (x : F.Carrier) : Id B.R (eval (N.localised.sm a x)) (B.mul (h a) (eval x)) = E.lift.scalar a x ;
   module Same = SerreModuleBasicRestrictionsScalar[l].Over[A,setA,M].At[f,f,O.le-refl (Z.D f)] ;
   module Br = Bridge[l].Over[A,f] ;
   module D = SerreModuleLocalisationMaps[l].Along[A,A,RingHom[l].identity A,N.localised,RR.Scalars.restricted,E.lift,f] ;
   at-scalar-fraction (a : B.R) (rep : Br.LocH.Fraction B (AF.inclusion f) a) (x : F.Carrier) :
    Id B.R (eval (LS.localised.sm a x)) (B.mul a (eval x)) =
    E.InverseAction.power-injective (Br.index (Br.LocH.den-in rep)) _ _ (calc B.R {
     E.T.power (Br.index (Br.LocH.den-in rep)) (eval (LS.localised.sm a x))
     =< sym (D.power-map (Br.index (Br.LocH.den-in rep)) (LS.localised.sm a x)) >
      eval (D.S.power (Br.index (Br.LocH.den-in rep)) (LS.localised.sm a x))
     =< ap eval (Same.denominator-power a rep (LS.localised.sm a x)) >
      eval (N.localised.sm (Br.LocH.den rep) (LS.localised.sm a x))
     =< ap eval (Same.source-clears a rep x) > eval (N.localised.sm (Br.LocH.num rep) x)
     =< scalar (Br.LocH.num rep) x > B.mul (h (Br.LocH.num rep)) (eval x)
     =< ap (\ c -> B.mul c (eval x)) (sym (Br.LocH.eqn rep)) >
      B.mul (B.mul (h (Br.LocH.den rep)) a) (eval x)
     =< sym (B.mulA (h (Br.LocH.den rep)) a (eval x)) >
      B.mul (h (Br.LocH.den rep)) (B.mul a (eval x))
     =< sym (trans (E.T.power-scalar (Br.index (Br.LocH.den-in rep)) (B.mul a (eval x)))
      (ap (\ c -> B.mul (h c) (B.mul a (eval x))) (Br.index-eq (Br.LocH.den-in rep)))) >
      E.T.power (Br.index (Br.LocH.den-in rep)) (B.mul a (eval x)) }) ;
   local-scalar (a : B.R) (x : F.Carrier) : Id B.R (eval (LS.localised.sm a x)) (B.mul a (eval x)) =
    Tr.Trunc[Br.LocH.Fraction B (AF.inclusion f) a].induction @l
     (\ r -> Id B.R (eval (LS.localised.sm a x)) (B.mul a (eval x))) (\ r -> AF.set f _ _)
     (\ rep -> at-scalar-fraction a rep x) (Br.LocH.fractions (AF.elementary f) a) ;
   linear : LR.Linear[LS.localised,Rf].H.Hom = new LR.Linear[LS.localised,Rf].H.Hom[eval,additive,local-scalar] ;
  } ;
  module With (frame : Frame) {
   module C = Coord[frame.1] ;
   read (z : F.Carrier) : B.R = frame.2.sec z ;
   expansion (z : F.Carrier) : Id F.Carrier (C.mul (read z)) z = frame.2.sec-eq z ;
   module Formula (b : A0.H.Hom) {
    module E = Functional[b] ;
    local-value (z : F.Carrier) : Id B.R (E.eval z) (B.mul (read z) (E.eval frame.1)) =
     trans (ap E.eval (sym (expansion z))) (E.local-scalar (read z) frame.1) ;
    swap-scalars (x y : F.Carrier) :
     Id B.R (B.mul (E.eval x) (read y)) (B.mul (E.eval y) (read x)) = calc B.R {
     B.mul (E.eval x) (read y)
      =< ap (\ a -> B.mul a (read y)) (local-value x) > B.mul (B.mul (read x) (E.eval frame.1)) (read y)
      =< sym (B.mulA (read x) (E.eval frame.1) (read y)) > B.mul (read x) (B.mul (E.eval frame.1) (read y))
      =< ap (B.mul (read x)) (B.mulC (E.eval frame.1) (read y)) > B.mul (read x) (B.mul (read y) (E.eval frame.1))
      =< RL[B].mul-swap (read x) (read y) (E.eval frame.1) > B.mul (read y) (B.mul (read x) (E.eval frame.1))
      =< ap (B.mul (read y)) (B.mulC (read x) (E.eval frame.1)) > B.mul (read y) (B.mul (E.eval frame.1) (read x))
      =< B.mulA (read y) (E.eval frame.1) (read x) > B.mul (B.mul (read y) (E.eval frame.1)) (read x)
      =< ap (\ a -> B.mul a (read x)) (sym (local-value y)) > B.mul (E.eval y) (read x) } ;
    local-exchange (x y : F.Carrier) :
     Id F.Carrier (LS.localised.sm (E.eval x) y) (LS.localised.sm (E.eval y) x) = calc F.Carrier {
     LS.localised.sm (E.eval x) y
      =< ap (LS.localised.sm (E.eval x)) (sym (expansion y)) > LS.localised.sm (E.eval x) (C.mul (read y))
      =< LS.localised.smA (E.eval x) (read y) frame.1 > C.mul (B.mul (E.eval x) (read y))
      =< ap C.mul (swap-scalars x y) > C.mul (B.mul (E.eval y) (read x))
      =< sym (LS.localised.smA (E.eval y) (read x) frame.1) > LS.localised.sm (E.eval y) (C.mul (read x))
      =< ap (LS.localised.sm (E.eval y)) (expansion x) > LS.localised.sm (E.eval y) x } ;
    restrict-exchange (x y : M.M) :
     Id F.Carrier (F.fraction (M.sm (b.fn x) y) zero) (F.fraction (M.sm (b.fn y) x) zero) = calc F.Carrier {
     F.fraction (M.sm (b.fn x) y) zero
      =< sym (N.Action.scale-at (b.fn x) y zero) > N.localised.sm (b.fn x) (F.fraction y zero)
      =< sym (LS.ER.original-action (b.fn x) (F.fraction y zero)) > LS.localised.sm (h (b.fn x)) (F.fraction y zero)
      =< ap (\ a -> LS.localised.sm a (F.fraction y zero)) (sym (E.at-original x)) >
       LS.localised.sm (E.eval (F.fraction x zero)) (F.fraction y zero)
      =< local-exchange (F.fraction x zero) (F.fraction y zero) >
       LS.localised.sm (E.eval (F.fraction y zero)) (F.fraction x zero)
      =< ap (\ a -> LS.localised.sm a (F.fraction x zero)) (E.at-original y) >
       LS.localised.sm (h (b.fn y)) (F.fraction x zero)
      =< LS.ER.original-action (b.fn y) (F.fraction x zero) > N.localised.sm (b.fn y) (F.fraction x zero)
      =< N.Action.scale-at (b.fn y) x zero > F.fraction (M.sm (b.fn y) x) zero } ;
   } ;
  } ;
  -- On a localised module every original power of f acts invertibly.
  module Powers = AffinePowers[l].Over[A] ;
  module Clear = SerreModuleClearFractions[l].At[A,M,f] ;
  module Inv = PU.Inverse[A,N.localised,f,N.Action.invertible] ;
  from-numerators (u v : LR.Linear[LS.localised,LS.localised].H.Hom)
   (on : (x : M.M) -> Id F.Carrier (u.fn (F.fraction x zero)) (v.fn (F.fraction x zero))) :
   (z : F.Carrier) -> Id F.Carrier (u.fn z) (v.fn z) =
   F.induction @l (\ z -> Id F.Carrier (u.fn z) (v.fn z)) (\ z -> F.carrier-set _ _)
    (\ x p -> Inv.power-injective p _ _ (calc F.Carrier {
     Inv.T.power p (u.fn (F.fraction x p))
     =< Inv.T.power-scalar p (u.fn (F.fraction x p)) > N.localised.sm (Powers.power f p) (u.fn (F.fraction x p))
     =< sym (LS.ER.original-action (Powers.power f p) (u.fn (F.fraction x p))) >
      LS.localised.sm (h (Powers.power f p)) (u.fn (F.fraction x p))
     =< sym (u.scalar (h (Powers.power f p)) (F.fraction x p)) >
      u.fn (LS.localised.sm (h (Powers.power f p)) (F.fraction x p))
     =< ap u.fn (trans (LS.ER.original-action (Powers.power f p) (F.fraction x p)) (Clear.clears x p)) >
      u.fn (F.fraction x zero)
     =< on x > v.fn (F.fraction x zero)
     =< sym (ap v.fn (trans (LS.ER.original-action (Powers.power f p) (F.fraction x p)) (Clear.clears x p))) >
      v.fn (LS.localised.sm (h (Powers.power f p)) (F.fraction x p))
     =< v.scalar (h (Powers.power f p)) (F.fraction x p) > LS.localised.sm (h (Powers.power f p)) (v.fn (F.fraction x p))
     =< LS.ER.original-action (Powers.power f p) (v.fn (F.fraction x p)) >
      N.localised.sm (Powers.power f p) (v.fn (F.fraction x p))
     =< sym (Inv.T.power-scalar p (v.fn (F.fraction x p))) > Inv.T.power p (v.fn (F.fraction x p)) })) ;
 } ;
 record Description (M : S.Module) {
  size : Nat ;
  opens : Fin size -> A.R ;
  covers : Cover size opens ;
  frames (i : Fin size) : At[M,opens i].Frame ;
 } ;
 LocallyFree (M : S.Module) : U l = Tr.Trunc[Description[M]].carrier ;
 module OnCover (M : S.Module) (d : Description[M]) {
  module Sep = SerreModuleGluingData[l].Over[A,setA,M].Cover[d.size,d.opens,d.covers] ;
  exchange (b : L.Linear[M,R].H.Hom) (x y : M.M) :
   Id M.M (M.sm (b.fn x) y) (M.sm (b.fn y) x) =
   Sep.Separate[M.sm (b.fn x) y,M.sm (b.fn y) x,
    \ i -> At[M,d.opens i].With[d.frames i].Formula[b].restrict-exchange x y].equal ;
 } ;
 exchange (M : S.Module) (local : LocallyFree M) (b : L.Linear[M,R].H.Hom) (x y : M.M) :
  Id M.M (M.sm (b.fn x) y) (M.sm (b.fn y) x) =
  Tr.Trunc[Description[M]].induction @l (\ d -> Id M.M (M.sm (b.fn x) y) (M.sm (b.fn y) x))
   (\ d -> M.setM _ _) (\ d -> OnCover[M,d].exchange b x y) local ;

} ;
