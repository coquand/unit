-- Explicit inverse functor for WeakCategoryEquivalence.
-- Take K(y) from the unique representation fibre and let e_y:HKy~=y
-- be its path-isomorphism.  Lift alpha e_y along e_z by fullness;
-- lift-eq says e_z H(K alpha)=alpha e_y.  Unique lifts prove the unit
-- and composition laws (paste the two defining squares).
-- These same squares give the natural counit HK~=1.  Reflect e_(Hx)
-- through full faithfulness to give the unit KH~=1; apply faithfulness
-- to the counit square to prove its naturality.  Thus both displayed
-- families consist of isomorphisms and satisfy the naturality equations.
level l ; open Base ; open Prelude[l] ;
module C = Category[l,l] ;
module F = Functor[l,l,l,l] ;
-- A categorical equivalence consists of a quasi-inverse functor and
-- natural isomorphisms for its two composites.  Naturality is written
-- on the underlying arrows of the displayed categorical isomorphisms.
record Equivalence (X Y : C.Category) (H : F.Functor[X.pre,Y.pre]) {
 inverse : F.Functor[Y.pre,X.pre] ;
 counit (y : Y.pre.ob) : Y.pre.Iso (H.obj (inverse.obj y)) y ;
 counit-natural (y z : Y.pre.ob) (a : Y.pre.hom y z) :
  Id (Y.pre.hom (H.obj (inverse.obj y)) z)
   (Y.pre.comp (H.obj (inverse.obj y)) (H.obj (inverse.obj z)) z (counit z).1 (H.map (inverse.obj y) (inverse.obj z) (inverse.map y z a)))
   (Y.pre.comp (H.obj (inverse.obj y)) y z a (counit y).1) ;
 unit (x : X.pre.ob) : X.pre.Iso (inverse.obj (H.obj x)) x ;
 unit-natural (x y : X.pre.ob) (a : X.pre.hom x y) :
  Id (X.pre.hom (inverse.obj (H.obj x)) y)
   (X.pre.comp (inverse.obj (H.obj x)) x y a (unit x).1)
   (X.pre.comp (inverse.obj (H.obj x)) (inverse.obj (H.obj y)) y (unit y).1 (inverse.map (H.obj x) (H.obj y) (H.map x y a))) ;
} ;
module Over (X Y : C.Category) (H : F.Functor[X.pre,Y.pre])
 (ff : F.FullyFaithful X.pre Y.pre H) (es : F.EssSurj X.pre Y.pre H) {
 module W = WeakCategoryEquivalence[l].Over[X,Y,H,ff,es] ;
 module AX = W.AX ;
 module AY = W.AY ;
 module R = W.R ;
 on-objects (y : Y.pre.ob) : X.pre.ob = (W.point y).1 ;
 counit (y : Y.pre.ob) : Y.pre.Iso (H.obj (on-objects y)) y =
  Y.pre.idtoiso (H.obj (on-objects y)) y (W.point y).2 ;
 on-arrows (y z : Y.pre.ob) (a : Y.pre.hom y z) : X.pre.hom (on-objects y) (on-objects z) =
  R.lift (counit z) (AY.cmp a (AY.arr (counit y))) ;
 counit-natural (y z : Y.pre.ob) (a : Y.pre.hom y z) :
  Id (Y.pre.hom (H.obj (on-objects y)) z)
   (AY.cmp (AY.arr (counit z)) (H.map (on-objects y) (on-objects z) (on-arrows y z a)))
   (AY.cmp a (AY.arr (counit y))) = R.lift-eq (counit z) (AY.cmp a (AY.arr (counit y))) ;
 identity (y : Y.pre.ob) : Id (X.pre.hom (on-objects y) (on-objects y))
  (on-arrows y y (Y.pre.idn y)) (X.pre.idn (on-objects y)) =
  R.unique (counit y) (counit-natural y y (Y.pre.idn y))
   (trans _ _ _ _ (AY.left (AY.arr (counit y)) (H.map-idn (on-objects y)))
    (trans _ _ _ _ (AY.unit-r (AY.arr (counit y))) (sym _ _ _ (AY.unit-l (AY.arr (counit y)))))) ;
 composition (x y z : Y.pre.ob) (b : Y.pre.hom y z) (a : Y.pre.hom x y) :
  Id (X.pre.hom (on-objects x) (on-objects z)) (on-arrows x z (AY.cmp b a))
   (AX.cmp (on-arrows y z b) (on-arrows x y a)) =
  R.unique (counit z) (counit-natural x z (AY.cmp b a))
   (trans _ _ _ _ (R.paste (counit-natural y z b) (counit-natural x y a)) (AY.assoc b a (AY.arr (counit x)))) ;
 inverse-functor : F.Functor[Y.pre,X.pre] = new F.Functor[Y.pre,X.pre,on-objects,on-arrows,identity,composition] ;
 unit (x : X.pre.ob) : X.pre.Iso (on-objects (H.obj x)) x = R.reflect-iso (counit (H.obj x)) ;
 unit-image (x : X.pre.ob) : Id (Y.pre.hom (H.obj (on-objects (H.obj x))) (H.obj x))
  (H.map (on-objects (H.obj x)) x (AX.arr (unit x))) (AY.arr (counit (H.obj x))) = R.pre-eq (AY.arr (counit (H.obj x))) ;
 unit-natural (x y : X.pre.ob) (a : X.pre.hom x y) :
  Id (X.pre.hom (on-objects (H.obj x)) y)
   (AX.cmp a (AX.arr (unit x)))
   (AX.cmp (AX.arr (unit y)) (on-arrows (H.obj x) (H.obj y) (H.map x y a))) =
  R.faithful
   (trans _ _ _ _ (H.map-comp (on-objects (H.obj x)) x y a (AX.arr (unit x)))
    (trans _ _ _ _ (AY.left (H.map x y a) (unit-image x))
     (trans _ _ _ _ (sym _ _ _ (counit-natural (H.obj x) (H.obj y) (H.map x y a)))
      (trans _ _ _ _ (AY.right (sym _ _ _ (unit-image y)) (H.map (on-objects (H.obj x)) (on-objects (H.obj y))
        (on-arrows (H.obj x) (H.obj y) (H.map x y a))))
       (sym _ _ _ (H.map-comp (on-objects (H.obj x)) (on-objects (H.obj y)) y (AX.arr (unit y))
        (on-arrows (H.obj x) (H.obj y) (H.map x y a)))))))) ;
 equivalence : Equivalence[X,Y,H] = new Equivalence[X,Y,H,inverse-functor,counit,counit-natural,unit,unit-natural] ;
} ;
