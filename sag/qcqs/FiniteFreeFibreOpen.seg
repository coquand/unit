-- The whole-fibre locus of a compact open is characterised by its
-- principal-localisation tests. This makes it independent of a choice
-- of generators and lets us form it by eliminating a mere presentation.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module BigFE = Axioms[l+].FunExtLemmas[fe @l+] ;
module Tr = Truncation[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module T = AffineTests[l] ;
module DL = DistLattice[l] ;
module ZF = ZariskiFunctor[l] ;
module CF = AffineCoverFamily[l] ;
module TD = ZariskiTopDetection[l] ;
module L = MonicAlgebra ;
module Over (K : T.Test) (S : Algebras[l].Over[K.ring,K.carrier-set].Algebra)
 (n : Nat) (basis : L.TraceBasis[l].Over[K.ring,K.carrier-set,S].Basis[n])
 (chosen : Fin n) (unit-coordinate : Id K.ring.R (basis.coordinate S.ring.o chosen) K.ring.o) {
 module Fibre = FiniteFreeFibreLocus[l].Over[K,S,n,basis,chosen,unit-coordinate] ;
 module C = Fibre.C ;
 module BP = C.BP ;
 module Context = CF.Context[K] ;
 module At (a : BP.Algebra) {
  module X = C.Cover.At[a] ;
  A : T.Test = X.A ; B : T.Test = X.B ;
  module ZA = T.At[A].Z ; module ZB = T.At[B].Z ;
  module UA = ZariskiUnitIdeal[l].Over[A] ; module UB = ZariskiUnitIdeal[l].Over[B] ;
  module RB = Radical[l].Over[B.ring] ;
  module In = ZariskiUnitIdeal[l].Change[A,B,X.inclusion] ;
  module DA = TD.Over[A] ; module DB = TD.Over[B] ;
  module Reflect (m : Nat) (xs : Fin m -> A.ring.R) {
   module AUnit = UA.At[m,xs] ;
   module BUnit = UB.At[m,\ i -> map X.inclusion (xs i)] ;
   term (v : BUnit.Witness) (i : Fin m) : Id A.ring.R
    (B.ring.mul (map X.inclusion (xs i)) (v.1 i) chosen) (A.ring.mul (xs i) (v.1 i chosen)) =
    ap (\ w -> w chosen) (X.X.scalar-action (xs i) (v.1 i)) ;
   project (v : BUnit.Witness) : AUnit.Witness = (\ i -> v.1 i chosen,
    trans (sym (UA.S.sum-cong m (\ i -> B.ring.mul (map X.inclusion (xs i)) (v.1 i) chosen)
     (\ i -> A.ring.mul (xs i) (v.1 i chosen)) (term v)))
     (trans (sym (ap (\ w -> w chosen) (X.sum-coordinates m (\ i -> B.ring.mul (map X.inclusion (xs i)) (v.1 i)))))
      (trans (ap (\ w -> w chosen) v.2) X.coordinate-one))) ;
   result (e : Id ZB.lattice.L (ZF.functor.reindex A B X.inclusion AUnit.cover) ZB.lattice.top) :
    Id ZA.lattice.L AUnit.cover ZA.lattice.top = AUnit.to-top
    (Tr.Trunc[BUnit.Witness].induction @l (\ v -> AUnit.UnitIdeal) (\ v -> Tr.Trunc[AUnit.Witness].proposition)
     (\ v -> Tr.Trunc[AUnit.Witness].inc (project v))
     (BUnit.from-top (trans (sym (In.map-cover m xs)) e))) ;
  } ;
  reflect-top (u : ZA.lattice.L) (e : DA.Whole B X.inclusion u) : Id ZA.lattice.L u ZA.lattice.top =
   Tr.Trunc[ZA.Presentation u].induction @l (\ t -> Id ZA.lattice.L u ZA.lattice.top) (\ t -> ZA.lattice.setL u ZA.lattice.top)
    (\ p -> trans (ZA.presents p) (Reflect[UA.R.size p.1,UA.R.gen p.1].result
     (trans (ap (ZF.functor.reindex A B X.inclusion) (sym (ZA.presents p))) e))) (ZA.presented u) ;
  module Probe (d : BP.Algebra) (h : BP.Hom a d) {
   module H = C.Change[a,d,h] ;
   Source (u : ZA.lattice.L) : U l = DA.Whole H.C H.h u ;
   Target (v : ZB.lattice.L) : U l = DB.Whole H.Y.B H.hom v ;
   Character (v : ZB.lattice.L) (u : ZA.lattice.L) : U l = (Source u -> Target v) * (Target v -> Source u) ;
   character-prop (v : ZB.lattice.L) (u : ZA.lattice.L) : Pr.isProp (Character v u) =
    Pr.isProp-Sigma (Source u -> Target v) (\ _ -> Target v -> Source u)
     (FE.isProp-Pi (Source u) (\ _ -> Target v) (\ _ -> T.At[H.Y.B].Z.lattice.setL _ _))
     (\ _ -> FE.isProp-Pi (Target v) (\ _ -> Source u) (\ _ -> T.At[H.C].Z.lattice.setL _ _)) ;
  } ;
  Characterises (v : ZB.lattice.L) (u : ZA.lattice.L) : U l+ = (d : BP.Algebra) (h : BP.Hom a d) -> Probe[d,h].Character v u ;
  characterises-prop (v : ZB.lattice.L) (u : ZA.lattice.L) : Hi.isProp (Characterises v u) =
   BigFE.isProp-Pi BP.Algebra (\ d -> (h : BP.Hom a d) -> Probe[d,h].Character v u)
    (\ d -> BigFE.isProp-Pi (BP.Hom a d) (\ h -> Probe[d,h].Character v u) (\ h -> Probe[d,h].character-prop v u)) ;
  Locus (v : ZB.lattice.L) : U l+ = (u : ZA.lattice.L) * Characterises v u ;
  unique (v : ZB.lattice.L) (u u' : Locus v) : Id ZA.lattice.L u.1 u'.1 =
   DA.equal u.1 u'.1
    (\ D h e -> let { d : BP.Algebra = Context.along a D h ; k : BP.Hom a d = Context.arrow a D h ; } in (u'.2 d k).2 ((u.2 d k).1 e))
    (\ D h e -> let { d : BP.Algebra = Context.along a D h ; k : BP.Hom a d = Context.arrow a D h ; } in (u.2 d k).2 ((u'.2 d k).1 e)) ;
  locus-prop (v : ZB.lattice.L) : Hi.isProp (Locus v) = \ u u' -> Hi.Sigma-eq ZA.lattice.L (Characterises v)
   u.1 u'.1 u.2 u'.2 (unique v u u') (characterises-prop v u'.1) ;
  module Presented (v : ZB.lattice.L) (p : ZB.Presentation v) {
   m : Nat = RB.size p.1 ;
   us : Fin m -> B.ring.R = RB.gen p.1 ;
   module Alg = Fibre.At[a,m,us] ;
   module Change (d : BP.Algebra) (h : BP.Hom a d) {
    module H = Fibre.Change[a,d,h,m,us] ;
    module P = Probe[d,h] ;
    base-eq : Id T.At[H.Q.B].Z.lattice.L (ZF.functor.reindex B H.Q.B H.H.hom v) H.Q.IB.cover =
     trans (ap (ZF.functor.reindex B H.Q.B H.H.hom) (ZB.presents p))
      (ZariskiUnitIdeal[l].Change[B,H.Q.B,H.H.hom].map-cover m us) ;
    result : P.Character v Alg.independent =
     (\ e -> trans base-eq (H.Q.forward (trans (sym H.natural) e)),
      \ e -> trans H.natural (H.Q.backward (trans (sym base-eq) e))) ;
   } ;
   locus : Locus v = (Alg.independent,\ d h -> Change[d,h].result) ;
  } ;
  forall-open (v : ZB.lattice.L) : Locus v = Tr.Trunc[ZB.Presentation v].induction @(l+)
   (\ t -> Locus v) (\ t -> locus-prop v) (\ p -> Presented[v,p].locus) (ZB.presented v) ;
 } ;
 module Pullback (a : BP.Algebra) (u : At[a].ZA.lattice.L) {
  module Origin = At[a] ;
  module X = Origin.X ;
  A : T.Test = Origin.A ; B : T.Test = Origin.B ;
  module ZA = Origin.ZA ; module ZB = Origin.ZB ;
  pull : ZB.lattice.L = ZF.functor.reindex A B X.inclusion u ;
  module Test (d : BP.Algebra) (h : BP.Hom a d) {
   module P = Origin.Probe[d,h] ;
   module H = P.H ;
   module Y = At[d] ;
   pull-test : Id Y.ZB.lattice.L (ZF.functor.reindex B Y.B H.hom pull)
    (ZF.functor.reindex Y.A Y.B Y.X.inclusion (ZF.functor.reindex A Y.A H.h u)) =
    trans (sym (ZF.functor.composition A B Y.B X.inclusion H.hom u))
     (trans (ap (\ f -> ZF.functor.reindex A Y.B f u) H.square)
      (ZF.functor.composition A Y.A Y.B H.h Y.X.inclusion u)) ;
   character : P.Character pull u =
    (\ e -> trans pull-test (trans (ap (ZF.functor.reindex Y.A Y.B Y.X.inclusion) e)
     (DL.hmap-top ZF.OnMap[Y.A,Y.B,Y.X.inclusion].lattice-map)),
     \ e -> Y.reflect-top _ (trans (sym pull-test) e)) ;
  } ;
  result : Id ZA.lattice.L (Origin.forall-open pull).1 u = Origin.unique pull (Origin.forall-open pull) (u,\ d h -> Test[d,h].character) ;
 } ;
 module Change (a d : BP.Algebra) (h : BP.Hom a d) (v : At[a].ZB.lattice.L) {
  module X = At[a] ; module Y = At[d] ; module H = C.Change[a,d,h] ;
  image : Y.ZB.lattice.L = ZF.functor.reindex X.B Y.B H.hom v ;
  open-before : X.ZA.lattice.L = (X.forall-open v).1 ;
  open-after : Y.ZA.lattice.L = ZF.functor.reindex X.A Y.A H.h open-before ;
  module Test (e : BP.Algebra) (k : BP.Hom d e) {
   arrow : BP.Hom a e = BP.compose-hom a d e k h ;
   module Direct = C.Change[a,e,arrow] ;
   module Next = C.Change[d,e,k] ;
   module Target = Y.Probe[e,k] ;
   map-eq : Id (RH.Hom X.B.ring Next.Y.B.ring) Direct.hom (CF.Comp X.B Y.B Next.Y.B Next.hom H.hom) =
    RH.Properties[X.B.ring,Next.Y.B.ring,Next.Y.B.carrier-set].ext _ _
     (\ w -> Next.Y.X.V.ext _ _ (\ i -> refl (k.1.1 (h.1.1 (w i))))) ;
   on-base : Id T.At[Next.C].Z.lattice.L (ZF.functor.reindex X.A Next.C Direct.h open-before)
    (ZF.functor.reindex Y.A Next.C Next.h open-after) =
    ZF.functor.composition X.A Y.A Next.C H.h Next.h open-before ;
   on-cover : Id T.At[Next.Y.B].Z.lattice.L (ZF.functor.reindex X.B Next.Y.B Direct.hom v)
    (ZF.functor.reindex Y.B Next.Y.B Next.hom image) =
    trans (ap (\ f -> ZF.functor.reindex X.B Next.Y.B f v) map-eq)
     (ZF.functor.composition X.B Y.B Next.Y.B H.hom Next.hom v) ;
   character : Target.Character image open-after =
    (\ p -> trans (sym on-cover) (((X.forall-open v).2 e arrow).1 (trans on-base p)),
     \ p -> trans (sym on-base) (((X.forall-open v).2 e arrow).2 (trans on-cover p))) ;
  } ;
  natural : Id Y.ZA.lattice.L open-after (Y.forall-open image).1 =
   Y.unique image (open-after,\ e k -> Test[e,k].character) (Y.forall-open image) ;
 } ;
} ;
