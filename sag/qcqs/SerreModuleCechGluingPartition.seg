-- The partition step in degree-one gluing (Serre note, Section 3).
-- Once a_ki satisfy a_kj|fi-a_ki|fj=f_k^r c_ij exactly, choose a
-- powered partition of one and put b_i=sum_k lambda_k a_ki. Linear
-- restriction and finite sums turn b_j-b_i into that partition acting
-- on c_ij. All coefficient choices remain in mere boundary existence.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module Sums (A : CRing) (Md : SM.Over[A].Module) {
 module S = SerreModuleSums[l].Over[A,Md] ;
 module ML = SM.Over[A].Laws[Md] ;
 module Group = SerreCechAlgebra[l].Over[A,Md] ;
 sum-sub : (n : Nat) (xs ys : Fin n -> Md.M) ->
  Id Md.M (ML.sub (S.sum n xs) (S.sum n ys)) (S.sum n (\ i -> ML.sub (xs i) (ys i))) = split {
  zero -> \ xs ys ->
   trans (cong2 Md.M ML.sub _ _ _ _ (S.sum-empty xs) (S.sum-empty ys))
    (trans (ML.sub-self Md.mz) (sym (S.sum-empty (\ i -> ML.sub (xs i) (ys i))))) ;
  suc n | ih -> \ xs ys ->
   trans (cong2 Md.M ML.sub _ _ _ _ (S.sum-step n xs) (S.sum-step n ys))
    (trans (Group.sub-add (xs (inr tt)) (S.sum n (\ i -> xs (inl i)))
     (ys (inr tt)) (S.sum n (\ i -> ys (inl i))))
     (trans (ap (Md.madd (ML.sub (xs (inr tt)) (ys (inr tt))))
      (ih (\ i -> xs (inl i)) (\ i -> ys (inl i))))
      (sym (S.sum-step n (\ i -> ML.sub (xs i) (ys i)))))) } ;
} ;
module Over (A : CRing) (setA : Pr.isSet A.R) (Md : SM.Over[A].Module) {
 module Data = SerreModuleCechGluingData[l].Over[A,setA,Md] ;
 module P = AffinePowers[l].Over[A] ;
 module Cover (n : Nat) (fs : Fin n -> A.R)
  (covers : Data.O.Le Data.Z.lattice.top (Data.Z.J.bigJ n (\ i -> Data.Z.D (fs i)))) {
  module D = Data.Cover[n,fs,covers] ; module C = D.C ;
  module Powers = SerreUnitIdealPowers[l].Over[A].Family[n,fs,covers] ;
  module Exact (c : D.Cochain) (r : Nat)
   (as : (k i : Fin n) -> C.Index[i].P.L.Carrier)
   (exact : (k i j : Fin n) -> Id C.Pair[i,j].P.L.Carrier
    (C.Pair[i,j].P.Laws.sub (C.Pair[i,j].Rho.map (as k j)) (C.Pair[i,j].L.map (as k i)))
    (C.Pair[i,j].P.Native.localised.sm (P.power (fs k) r) (c i j))) {
   module Partition (coeffs : Radical[l].Over[A].InIdeal (n,Powers.powers r) A.o) {
    coefficient (k : Fin n) : A.R = coeffs.1 k ;
    weights (k : Fin n) : A.R = A.mul (Powers.powers r k) (coefficient k) ;
    one : Id A.R (FiniteIdeal[l].Sums[A].sum n weights) A.o = coeffs.2 ;
    module Index (i : Fin n) { module S = SerreModuleSums[l].Over[A,C.Index[i].P.Native.localised] ; } ;
    section (i : Fin n) : C.Index[i].P.L.Carrier =
     Index[i].S.sum n (\ k -> C.Index[i].P.Native.localised.sm (coefficient k) (as k i)) ;
    module Pair (i j : Fin n) {
     module Q = C.Pair[i,j] ; module N = Q.P.Native ; module ML = Q.P.Laws ;
     module S = SerreModuleSums[l].Over[A,N.localised] ;
     module DifferenceSums = Sums[A,N.localised] ;
     module Left = SerreModuleSums[l].Map[A,A,RingHom[l].identity A,C.Index[i].P.Native.localised,N.localised,Q.L.native] ;
     module Right = SerreModuleSums[l].Map[A,A,RingHom[l].identity A,C.Index[j].P.Native.localised,N.localised,Q.Rho.native] ;
     left-term (k : Fin n) : N.L.Carrier = Q.L.map (C.Index[i].P.Native.localised.sm (coefficient k) (as k i)) ;
     right-term (k : Fin n) : N.L.Carrier = Q.Rho.map (C.Index[j].P.Native.localised.sm (coefficient k) (as k j)) ;
     term (k : Fin n) : Id N.L.Carrier (ML.sub (right-term k) (left-term k)) (N.localised.sm (weights k) (c i j)) =
      trans (cong2 N.L.Carrier ML.sub _ _ _ _
       (Q.Rho.map-scale (coefficient k) (as k j)) (Q.L.map-scale (coefficient k) (as k i)))
       (trans (sym (ML.sm-sub (coefficient k) (Q.Rho.map (as k j)) (Q.L.map (as k i))))
        (trans (ap (N.localised.sm (coefficient k)) (exact k i j))
         (trans (N.localised.smA (coefficient k) (P.power (fs k) r) (c i j))
          (ap (\ a -> N.localised.sm a (c i j))
           (trans (A.mulC (coefficient k) (P.power (fs k) r))
            (ap (\ a -> A.mul a (coefficient k)) (sym (Powers.powers-at r k)))))))) ;
     boundary : Id N.L.Carrier (ML.sub (Q.Rho.map (section j)) (Q.L.map (section i))) (c i j) =
      trans (cong2 N.L.Carrier ML.sub _ _ _ _
       (Right.sum-map n (\ k -> C.Index[j].P.Native.localised.sm (coefficient k) (as k j)))
       (Left.sum-map n (\ k -> C.Index[i].P.Native.localised.sm (coefficient k) (as k i))))
       (trans (DifferenceSums.sum-sub n right-term left-term)
        (trans (S.sum-cong n (\ k -> ML.sub (right-term k) (left-term k))
         (\ k -> N.localised.sm (weights k) (c i j)) term)
         (S.partition n weights one (c i j)))) ;
    } ;
    boundary : D.Boundary c section = \ i j -> Pair[i,j].boundary ;
   } ;
   boundary : D.IsBoundary c =
    Tr.Trunc[Radical[l].Over[A].InIdeal (n,Powers.powers r) A.o].induction @l
     (\ w -> D.IsBoundary c)
     (\ w -> Tr.Trunc[(bs : C.Families) * D.Boundary c bs].proposition)
     (\ w -> Tr.Trunc[(bs : C.Families) * D.Boundary c bs].inc
      (Partition[w].section,Partition[w].boundary)) (Powers.coefficients r) ;
  } ;
 } ;
} ;
