-- Module, hence abelian group, structure on the specified H1 quotient.
-- The cokernel of the lifted coboundary on the cocycle module and the
-- already specified H1 quotient have equivalent relations: cocycle
-- extensionality identifies equality with equality of underlying cochains.
-- Descend the identity on cocycles in both directions. Quotient induction
-- proves the inverse laws. Transfer the checked generic cokernel module
-- across this equivalence; H1 remains the previously defined carrier.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module DL = DistLattice[l] ;
module MS = SerreModuleSheaf[l] ; module Tr = Truncation[l] ;
module On (L : DL.DLat) (G : RingedLattice[l].On[L].Presheaf)
 (M : MS.On[L,G].ModuleSheaf) (n : Nat) (as : Fin n -> L.L) {
 module CG = SerreCechGroupCocycles[l].On[L,G,M,n,as] ;
 module Z = CG.Z ; module C = CG.C ;
 module K = SerreModuleCokernel[l].Over[G.ring L.top,C.C0.product,CG.cocycle-module,CG.coboundary] ;
 forward-witness (c d : Z.Cocycle) (w : K.CQ.Witness c d) : Z.Translation.Witness (Z.value c) (Z.value d) =
  (w.1,trans (ap Z.value w.2)
   (trans (CG.add-value c (CG.Maps.map CG.coboundary w.1))
    (ap (C.C1.product.madd (Z.value c))
     (trans (CG.coboundary-value w.1) (sym (C.coboundary-at w.1)))))) ;
 forward-related (c d : Z.Cocycle) (r : K.CQ.Related c d) : Z.Related c d =
  Tr.Trunc[K.CQ.Witness c d].induction @l (\ w -> Z.Related c d) (\ w -> Z.related-prop c d)
   (\ w -> Tr.Trunc[Z.Translation.Witness (Z.value c) (Z.value d)].inc (forward-witness c d w)) r ;
 backward-witness (c d : Z.Cocycle) (w : Z.Translation.Witness (Z.value c) (Z.value d)) : K.CQ.Witness c d =
  (w.1,Z.ext d (CG.add c (CG.Maps.map CG.coboundary w.1))
   (trans w.2
    (trans (ap (C.C1.product.madd (Z.value c))
     (trans (C.coboundary-at w.1) (sym (CG.coboundary-value w.1))))
     (sym (CG.add-value c (CG.Maps.map CG.coboundary w.1)))))) ;
 backward-related (c d : Z.Cocycle) (r : Z.Related c d) : K.CQ.Related c d =
  Tr.Trunc[Z.Translation.Witness (Z.value c) (Z.value d)].induction @l
   (\ w -> K.CQ.Related c d) (\ w -> K.CQ.related-prop c d)
   (\ w -> Tr.Trunc[K.CQ.Witness c d].inc (backward-witness c d w)) r ;
 module Forward = K.CQ.Q.Descend[Z.H1,Z.h1-set,Z.class,\ c d r -> Z.Q.relates c d (forward-related c d r)] ;
 module Backward = Z.Q.Descend[K.CQ.Class,K.CQ.set,K.CQ.class,\ c d r -> K.CQ.class-equal c d (backward-related c d r)] ;
 forward (x : K.CQ.Class) : Z.H1 = Forward.map x ;
 backward (x : Z.H1) : K.CQ.Class = Backward.map x ;
 forward-class (c : Z.Cocycle) : Id Z.H1 (forward (K.CQ.class c)) (Z.class c) = Forward.beta c ;
 backward-class (c : Z.Cocycle) : Id K.CQ.Class (backward (Z.class c)) (K.CQ.class c) = Backward.beta c ;
 back-forward (x : K.CQ.Class) : Id K.CQ.Class (backward (forward x)) x =
  K.CQ.Q.induction @l (\ x -> Id K.CQ.Class (backward (forward x)) x) (\ x -> K.CQ.set _ _)
   (\ c -> trans (ap backward (forward-class c)) (backward-class c)) x ;
 forward-back (x : Z.H1) : Id Z.H1 (forward (backward x)) x =
  Z.Q.induction @l (\ x -> Id Z.H1 (forward (backward x)) x) (\ x -> Z.h1-set _ _)
   (\ c -> trans (ap forward (backward-class c)) (forward-class c)) x ;
 equivalence : Pr.Equiv K.CQ.Class Z.H1 = (forward,Pr.qinv K.CQ.Class Z.H1 forward backward forward-back back-forward) ;
 module Transfer = SerreCechGroupTransfer[l].Over[G.ring L.top,K.cokernel,Z.H1,Z.h1-set,equivalence] ;
 h1-module : SerreModule[l].Over[G.ring L.top].Module = Transfer.transferred ;
 zero-eq : Id Z.H1 h1-module.mz Z.zero = forward-class Z.zero-cocycle ;
 add-class (c d : Z.Cocycle) : Id Z.H1
  (h1-module.madd (Z.class c) (Z.class d)) (Z.class (CG.add c d)) =
  trans (cong2 Z.H1 h1-module.madd _ _ _ _ (sym (forward-class c)) (sym (forward-class d)))
   (trans (Transfer.forward-add (K.CQ.class c) (K.CQ.class d))
    (trans (ap forward (K.add-class c d)) (forward-class (CG.add c d)))) ;
 scale-class (r : (G.ring L.top).R) (c : Z.Cocycle) : Id Z.H1
  (h1-module.sm r (Z.class c)) (Z.class (CG.scale r c)) =
  trans (ap (h1-module.sm r) (sym (forward-class c)))
   (trans (Transfer.forward-scale r (K.CQ.class c))
    (trans (ap forward (K.scale-class r c)) (forward-class (CG.scale r c)))) ;
 opaque forward ; opaque backward ; opaque equivalence ;
} ;
