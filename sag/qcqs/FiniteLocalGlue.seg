-- The compatible-tuple ringed lattice is locally ringed.
-- For a tuple s on v, define D(s) coordinatewise by D_i(s_i).
-- Locality of the two overlap maps, compatibility of s, and the law
-- D(s|w)=w /\ D(s) show that this tuple is compatible.  The last meet
-- simplifies because the second image of D_j(s_j) lies below the common
-- overlap open.  Thus D(s) is an open below v.
-- It is the invertibility open: restrictions are componentwise and a
-- compatible tuple is a unit exactly when all its components are units
-- (FiniteRingGlue).  The zero and sum support laws are coordinatewise.
-- Finally each projection on opens and sections defines a local map
-- X_i -> glued.  Naturality is the defining equation for restriction;
-- locality is the defining equation for the i-th component of D(s).
-- This result constructs the locally ringed lattice for any finite
-- diagram of local maps.  Chart isomorphisms require the separate
-- open-transition and cocycle hypotheses, not used here.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;
module SP = Spaces[l] ;
module Over (n : Nat) (X : Fin n -> SP.Space) (Y : Fin n -> Fin n -> SP.Space)
 (f : (i j : Fin n) -> SP.Hom (Y i j) (X i))
 (g : (i j : Fin n) -> SP.Hom (Y i j) (X j)) {
 module G = FiniteRingedGlue[l].Over[n,X,Y,f,g] ;
 module LRG = LocallyRinged[l].On[G.FL.lattice] ;
 module IG = InvOpen[l].On[G.FL.lattice].Of[G.presheaf] ;
 module Component (i : Fin n) {
  module I = InvOpen[l].On[(X i).lattice].Of[(X i).structure.sheaf] ;
  module L = LocallyRinged[l].On[(X i).lattice].Laws[(X i).structure.sheaf,(X i).structure.inv] ;
 } ;
 module Pair (i j : Fin n) {
  module I = InvOpen[l].On[(Y i j).lattice].Of[(Y i j).structure.sheaf] ;
  module L = LocallyRinged[l].On[(Y i j).lattice].Laws[(Y i j).structure.sheaf,(Y i j).structure.inv] ;
  module P = SP.Between[Y i j,X i].MP.Of[G.Pair[i,j].phi,(X i).structure.inv,(Y i j).structure.inv] ;
  module Q = SP.Between[Y i j,X j].MP.Of[G.Pair[i,j].psi,(X j).structure.inv,(Y i j).structure.inv] ;
 } ;
 module Inv (v : G.FL.Opens) (s : (G.ring v).R) {
  ds (i : Fin n) : (X i).lattice.L = Component[i].L.d (G.FL.coordinate v i) (G.coordinate v s i) ;
  below (i : Fin n) : G.Component[i].O.Le (ds i) (G.FL.coordinate v i) =
   Component[i].I.below (Component[i].L.d-open (G.FL.coordinate v i) (G.coordinate v s i)) ;
  module Match (i j : Fin n) {
   b : ((Y i j).structure.sheaf.ring (DL.hmap G.Pair[i,j].psi.lat (G.FL.coordinate v j))).R =
    map (G.Pair[i,j].psi.sharp (G.FL.coordinate v j)) (G.coordinate v s j) ;
   below-second : G.Pair[i,j].O.Le (DL.hmap G.Pair[i,j].psi.lat (ds j)) (G.mid v i j) =
    G.Pair[i,j].O.le-trans _ _ _ (G.Pair[i,j].Q.monotone _ _ (below j))
     (G.Pair[i,j].O.le-of-eq _ _ (sym (G.FL.match v i j))) ;
   equation : Id (Y i j).lattice.L (DL.hmap G.Pair[i,j].phi.lat (ds i)) (DL.hmap G.Pair[i,j].psi.lat (ds j)) =
    calc (Y i j).lattice.L {
     DL.hmap G.Pair[i,j].phi.lat (ds i)
      =< Pair[i,j].P.local-eq (SP.is-local (f i j)) (G.FL.coordinate v i) (G.coordinate v s i)
      > Pair[i,j].L.d (G.mid v i j) (map (G.Pair[i,j].phi.sharp (G.FL.coordinate v i)) (G.coordinate v s i))
      =< ap (Pair[i,j].L.d (G.mid v i j)) (G.agree v s i j)
      > Pair[i,j].L.d (G.mid v i j)
         (G.Pair[i,j].GO.restrict (G.mid v i j) (DL.hmap G.Pair[i,j].psi.lat (G.FL.coordinate v j)) (G.mid-second v i j) b)
      =< Pair[i,j].I.Restrict[DL.hmap G.Pair[i,j].psi.lat (G.FL.coordinate v j),G.mid v i j,G.mid-second v i j,b,
          Pair[i,j].L.d (DL.hmap G.Pair[i,j].psi.lat (G.FL.coordinate v j)) b,
          Pair[i,j].L.d-open (DL.hmap G.Pair[i,j].psi.lat (G.FL.coordinate v j)) b].restrict-eq
          (Pair[i,j].L.d (G.mid v i j) (G.Pair[i,j].GO.restrict (G.mid v i j)
           (DL.hmap G.Pair[i,j].psi.lat (G.FL.coordinate v j)) (G.mid-second v i j) b))
          (Pair[i,j].L.d-open (G.mid v i j) (G.Pair[i,j].GO.restrict (G.mid v i j)
           (DL.hmap G.Pair[i,j].psi.lat (G.FL.coordinate v j)) (G.mid-second v i j) b))
      > (Y i j).lattice.meet (G.mid v i j) (Pair[i,j].L.d (DL.hmap G.Pair[i,j].psi.lat (G.FL.coordinate v j)) b)
      =< ap ((Y i j).lattice.meet (G.mid v i j))
          (sym (Pair[i,j].Q.local-eq (SP.is-local (g i j)) (G.FL.coordinate v j) (G.coordinate v s j)))
      > (Y i j).lattice.meet (G.mid v i j) (DL.hmap G.Pair[i,j].psi.lat (ds j))
      =< (Y i j).lattice.meetC (G.mid v i j) (DL.hmap G.Pair[i,j].psi.lat (ds j))
      > (Y i j).lattice.meet (DL.hmap G.Pair[i,j].psi.lat (ds j)) (G.mid v i j)
      =< below-second
      > DL.hmap G.Pair[i,j].psi.lat (ds j) } ;
  } ;
  extent : G.FL.Opens = (ds,\ i j -> Match[i,j].equation) ;
  forward : IG.Forward v s extent = \ w k h -> G.At[w].FR.Units[map (G.res w v k) s,\ i ->
   Pr.subst ((X i).structure.sheaf.ring (G.FL.coordinate w i)).R (Component[i].I.Unit (G.FL.coordinate w i)) _ _
    (sym (G.Res[w,v,k].at s i))
    (Component[i].I.to-unit (Component[i].L.d-open (G.FL.coordinate v i) (G.coordinate v s i))
     (G.FL.coordinate w i) (G.Res[w,v,k].ki i) (G.FL.le-coordinate w extent h i))].unit ;
  backward : IG.Backward v s extent = \ w k unit -> G.FL.le-tuple w extent (\ i ->
   Component[i].I.from-unit (Component[i].L.d-open (G.FL.coordinate v i) (G.coordinate v s i))
    (G.FL.coordinate w i) (G.Res[w,v,k].ki i)
    (Pr.subst ((X i).structure.sheaf.ring (G.FL.coordinate w i)).R (Component[i].I.Unit (G.FL.coordinate w i)) _ _
     (G.Res[w,v,k].at s i) (G.At[w].FR.unit-component (map (G.res w v k) s) unit i))) ;
  inv-open : IG.InvOpen v s = (extent,G.FL.le-tuple extent v below,forward,backward) ;
 } ;
 inv : IG.InvMap = \ v s -> Inv[v,s].inv-open ;
 module LG = LRG.Laws[G.presheaf,inv] ;
 d-at (v : G.FL.Opens) (s : (G.ring v).R) (i : Fin n) :
  Id (X i).lattice.L (G.FL.coordinate (LG.d v s) i) (Component[i].L.d (G.FL.coordinate v i) (G.coordinate v s i)) =
  refl (Component[i].L.d (G.FL.coordinate v i) (G.coordinate v s i)) ;
 opaque inv ;
 zero-law : LG.ZeroLaw = \ v -> G.FL.ext (LG.d v (G.ring v).z) G.FL.bottom (\ i ->
  trans (d-at v (G.ring v).z i) ((X i).structure.is-support.2.1 (G.FL.coordinate v i))) ;
 module Sum (v : G.FL.Opens) (s t : (G.ring v).R) (i : Fin n) {
  bound : G.Component[i].O.Le
   (G.FL.coordinate (LG.d v ((G.ring v).add s t)) i)
   (G.FL.coordinate (G.FL.join (LG.d v s) (LG.d v t)) i) =
   G.Component[i].O.le-trans _ _ _
    (G.Component[i].O.le-of-eq _ _ (d-at v ((G.ring v).add s t) i))
    (G.Component[i].O.le-trans _ _ _
     ((X i).structure.is-support.2.2.2 (G.FL.coordinate v i) (G.coordinate v s i) (G.coordinate v t i))
     (G.Component[i].O.le-of-eq _ _
      (sym (cong2 (X i).lattice.L (X i).lattice.join _ _ _ _ (d-at v s i) (d-at v t i))))) ;
 } ;
 add-law : LG.AddLaw = \ v s t -> G.FL.le-tuple (LG.d v ((G.ring v).add s t)) (G.FL.join (LG.d v s) (LG.d v t))
  (\ i -> Sum[v,s,t,i].bound) ;
 glued : LRG.LocallyRinged = new LRG.LocallyRinged[G.presheaf,G.is-sheaf,inv,LG.support zero-law add-law] ;
 space : SP.Space = new SP.Space[G.FL.lattice,glued] ;
 module Projection (i : Fin n) {
  module MP = SP.Between[X i,space].MP ;
  natural (u v : G.FL.Opens) (k : G.FL.O.Le u v) (s : (G.ring v).R) :
   Id ((X i).structure.sheaf.ring (DL.hmap (G.FL.projection i) u)).R
    (map ((X i).structure.sheaf.res (DL.hmap (G.FL.projection i) u) (DL.hmap (G.FL.projection i) v)
     (DL.JoinMaps[G.FL.lattice,(X i).lattice,G.FL.projection i].monotone u v k)) (map (G.At[v].FR.projection i) s))
    (map (G.At[u].FR.projection i) (map (G.res u v k) s)) =
   trans (G.Component[i].GO.res-irr _ _
    (DL.JoinMaps[G.FL.lattice,(X i).lattice,G.FL.projection i].monotone u v k) (G.Res[u,v,k].ki i) (G.coordinate v s i))
    (sym (G.Res[u,v,k].at s i)) ;
  ringed : MP.Ringed = new MP.Ringed[G.FL.projection i,\ v -> G.At[v].FR.projection i,natural] ;
  module Local = MP.Of[ringed,inv,(X i).structure.inv] ;
  local : Local.IsLocal = \ v s -> G.Component[i].O.le-of-eq _ _ (sym (d-at v s i)) ;
  morphism : SP.Hom (X i) space = (ringed,local) ;
 } ;
 -- The two maps from an overlap into the glued space agree.  On opens
 -- this is the defining matching equation; on sections it is agree,
 -- with the second image restricted to the equal first image.
 module OverlapAgreement (i j : Fin n) {
  module P = SP.Composite[Y i j,X i,space,Projection[i].morphism,f i j] ;
  module Q = SP.Composite[Y i j,X j,space,Projection[j].morphism,g i j] ;
  module E = SP.Between[Y i j,space].EQ ;
  lattice-eq (v : G.FL.Opens) : Id (Y i j).lattice.L
   (DL.hmap Q.C.composite.lat v) (DL.hmap P.C.composite.lat v) = sym (G.FL.match v i j) ;
  le (v : G.FL.Opens) : G.Pair[i,j].O.Le (DL.hmap P.C.composite.lat v) (DL.hmap Q.C.composite.lat v) = G.mid-second v i j ;
  section-eq (v : G.FL.Opens) (s : (G.ring v).R) :
   Id ((Y i j).structure.sheaf.ring (DL.hmap P.C.composite.lat v)).R
    (G.Pair[i,j].GO.restrict (DL.hmap P.C.composite.lat v) (DL.hmap Q.C.composite.lat v) (le v) (map (Q.C.composite.sharp v) s))
    (map (P.C.composite.sharp v) s) =
   trans (ap (G.Pair[i,j].GO.restrict (G.mid v i j) (DL.hmap G.Pair[i,j].psi.lat (G.FL.coordinate v j)) (le v)) (Q.C.sharp-map v s))
    (trans (sym (G.agree v s i j)) (sym (P.C.sharp-map v s))) ;
  equation : Id (SP.Hom (Y i j) space) P.composite Q.composite =
   sym (SP.ext (Y i j) space Q.composite P.composite
    (E.ext Q.C.composite P.C.composite lattice-eq le section-eq)) ;
 } ;
} ;
