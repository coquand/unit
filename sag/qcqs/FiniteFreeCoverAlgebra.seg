-- A chosen coordinate taking 1 to 1 splits the scalar inclusion.
-- Maps out of the coordinate algebra are determined by scalars and
-- basis vectors, since every element is their linear combination.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module T = AffineTests[l] ;
module L = MonicAlgebra ;
module Over (K : T.Test) (S : Algebras[l].Over[K.ring,K.carrier-set].Algebra)
 (n : Nat) (basis : L.TraceBasis[l].Over[K.ring,K.carrier-set,S].Basis[n])
 (chosen : Fin n) (unit-coordinate : Id K.ring.R (basis.coordinate S.ring.o chosen) K.ring.o) {
 module KA = Algebras[l].Over[K.ring,K.carrier-set] ;
 module BP = BasePoints[l].Over[K] ;
 module At (context : BP.Algebra) {
  A : T.Test = context.1 ;
  Aalg : KA.Algebra = KA.mkAlgebra A.ring A.carrier-set context.2 ;
  module X = L.FiniteBasisScalarExtension[l].Over[K.ring,K.carrier-set,S,Aalg,n,basis] ;
  B : T.Test = new T.Test[X.ring,X.V.set] ;
  inclusion : RH.Hom A.ring B.ring = X.scalar-hom ;
  coordinate-one : Id A.ring.R (B.ring.o chosen) A.ring.o =
   trans (ap context.2.1 unit-coordinate) (map-one context.2) ;
  coordinate-scalar (a : A.ring.R) : Id A.ring.R (inclusion.1 a chosen) a =
   trans (ap (A.ring.mul a) coordinate-one) (A.ring.mulO a) ;
  injective (a b : A.ring.R) (e : Id B.ring.R (inclusion.1 a) (inclusion.1 b)) : Id A.ring.R a b =
   trans (sym (coordinate-scalar a)) (trans (ap (\ v -> v chosen) e) (coordinate-scalar b)) ;
  module AA = Algebras[l].Over[A.ring,A.carrier-set] ;
  Balg : AA.Algebra = AA.mkAlgebra B.ring B.carrier-set inclusion ;
  module BA = L.TraceBasis[l].Over[A.ring,A.carrier-set,Balg] ;
  sum-coordinates : (m : Nat) (vs : Fin m -> B.ring.R) ->
   Id B.ring.R (BA.SS.sum m vs) (X.V.sum m vs) = split {
   zero -> \ vs -> refl B.ring.z ;
   suc m | ih -> \ vs -> ap (B.ring.add (vs (inr tt))) (ih (\ i -> vs (inl i))) } ;
  base-basis : BA.Basis[n] = new BA.Basis[n,X.V.unit,\ v -> v,
   \ v w i -> refl (A.ring.add (v i) (w i)),
   \ a v i -> ap (\ u -> u i) (X.scalar-action a v),
   \ v -> trans (sum-coordinates n (\ j -> X.product (inclusion.1 (v j)) (X.V.unit j)))
    (trans (X.V.sum-cong n (\ j -> X.product (inclusion.1 (v j)) (X.V.unit j))
     (\ j -> X.V.scale (v j) (X.V.unit j)) (\ j -> X.scalar-action (v j) (X.V.unit j))) (X.V.expansion v)),
   \ j i -> refl (X.V.unit j i)] ;
  module Maps (D : T.Test) (f g : RH.Hom B.ring D.ring)
   (scalars : (a : A.ring.R) -> Id D.ring.R (f.1 (inclusion.1 a)) (g.1 (inclusion.1 a)))
   (vectors : (i : Fin n) -> Id D.ring.R (f.1 (X.V.unit i)) (g.1 (X.V.unit i))) {
   module DF = L.DeterminantLemma[l].Map[B.ring,D.ring,B.carrier-set,D.carrier-set,f] ;
   module DG = L.DeterminantLemma[l].Map[B.ring,D.ring,B.carrier-set,D.carrier-set,g] ;
   term (v : B.ring.R) (i : Fin n) : B.ring.R = B.ring.mul (inclusion.1 (v i)) (X.V.unit i) ;
   on-term (v : B.ring.R) (i : Fin n) : Id D.ring.R (f.1 (term v i)) (g.1 (term v i)) =
    trans (map-mul f (inclusion.1 (v i)) (X.V.unit i))
     (trans (cong2 D.ring.R D.ring.mul _ _ _ _ (scalars (v i)) (vectors i))
      (sym (map-mul g (inclusion.1 (v i)) (X.V.unit i)))) ;
   on-element (v : B.ring.R) : Id D.ring.R (f.1 v) (g.1 v) = calc D.ring.R {
    f.1 v =< ap f.1 (sym (base-basis.reconstruction v)) > f.1 (BA.SS.sum n (term v))
     =< DF.sum-map n (term v) > FiniteIdeal[l].Sums[D.ring].sum n (\ i -> f.1 (term v i))
     =< FiniteIdeal[l].Sums[D.ring].sum-cong n _ _ (on-term v) > FiniteIdeal[l].Sums[D.ring].sum n (\ i -> g.1 (term v i))
     =< sym (DG.sum-map n (term v)) > g.1 (BA.SS.sum n (term v))
     =< ap g.1 (base-basis.reconstruction v) > g.1 v } ;
   equal : Id (RH.Hom B.ring D.ring) f g = RH.Properties[B.ring,D.ring,D.carrier-set].ext f g on-element ;
  } ;
 } ;
} ;
