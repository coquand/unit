-- Independence of the affine cover (Serre note, Corollary 5.7).
-- Let M be quasi-coherent and U, V finite affine covers of X. Then
-- H1(U, M) and H1(V, M) are canonically isomorphic groups; the
-- isomorphism sends the U-class of any torsor to its V-class, in
-- particular [c] to the V-class of T_c.
-- Proof. Let Y = U ++ V (FiniteLatticeFamilies.append). U and V refine Y,
-- with the index maps left and right and equal members. Every torsor has
-- sections on every affine open (SerreLambdaQuasiCoherent), so on the
-- members of Y; hence restriction H1(Y) -> H1(U) and H1(Y) -> H1(V) are
-- additive bijections (SerreCechRefinement.Onto). The comparison is the
-- second after the inverse of the first; it is additive, its inverse is
-- the comparison from V to U, and both restrictions send the Y-class of a
-- torsor to its U- and V-classes.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module DL = DistLattice[l] ;
module MS = SerreModuleSheaf[l] ;
-- the two index maps into a concatenation
module Concat (L : DL.DLat) (n : Nat) (as : Fin n -> L.L) {
 module FF = FiniteLatticeFamilies[l].Over[L] ;
 size (m : Nat) (bs : Fin m -> L.L) : Nat = FF.size (FF.append (n,as) m bs) ;
 entry (m : Nat) (bs : Fin m -> L.L) : Fin (size m bs) -> L.L = FF.entry (FF.append (n,as) m bs) ;
 left : (m : Nat) (bs : Fin m -> L.L) -> Fin n -> Fin (size m bs) = split {
  zero -> \ bs i -> i ;
  suc m | r -> \ bs i -> inl (r (\ j -> bs (inl j)) i) } ;
 left-eq : (m : Nat) (bs : Fin m -> L.L) (i : Fin n) -> Id L.L (entry m bs (left m bs i)) (as i) = split {
  zero -> \ bs i -> refl (as i) ;
  suc m | r -> \ bs i -> r (\ j -> bs (inl j)) i } ;
 right : (m : Nat) (bs : Fin m -> L.L) -> Fin m -> Fin (size m bs) = split {
  zero -> \ bs -> AffineFinite[l].empty-section (\ j -> Fin (size zero bs)) ;
  suc m | r -> \ bs -> split { inl j -> inl (r (\ j2 -> bs (inl j2)) j) ; inr t -> inr tt } } ;
 right-eq : (m : Nat) (bs : Fin m -> L.L) (j : Fin m) -> Id L.L (entry m bs (right m bs j)) (bs j) = split {
  zero -> \ bs -> AffineFinite[l].empty-section (\ j -> Id L.L (entry zero bs (right zero bs j)) (bs j)) ;
  suc m | r -> \ bs -> split { inl j -> r (\ j2 -> bs (inl j2)) j ; inr t -> ap (\ s -> bs (inr s)) (AffineFinite[l].top-eq tt t) } } ;
} ;
module On (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged) (M : MS.On[L,X.sheaf].ModuleSheaf)
 (qc : SerreQuasiCoherent[l].On[L,X,M].IsQuasiCoherent) {
 module Q = Qcqs[l].Over[L,X] ;
 module O = DL.Order[L] ; module J = DL.Joins[L] ;
 module Torsors = SerreTorsor[l].On[L,X.sheaf].Over[M] ;
 module Local = SerreLambdaQuasiCoherent[l].On[L,X,M].Of[qc] ;
 module Covers (cu cv : Q.AffineCover) {
  n : Nat = cu.count ; as : Fin n -> L.L = cu.opens ;
  m : Nat = cv.count ; bs : Fin m -> L.L = cv.opens ;
  module C = Concat[L,n,as] ; module FF = C.FF ;
  covers-u : O.Le L.top (J.bigJ n as) = O.le-of-eq _ _ (sym cu.covers) ;
  covers-v : O.Le L.top (J.bigJ m bs) = O.le-of-eq _ _ (sym cv.covers) ;
  k : Nat = C.size m bs ;
  ys : Fin k -> L.L = C.entry m bs ;
  covers-y : O.Le L.top (J.bigJ k ys) =
   O.le-trans L.top (J.bigJ n as) (J.bigJ k ys) covers-u
    (O.le-trans (J.bigJ n as) (L.join (J.bigJ n as) (J.bigJ m bs)) (J.bigJ k ys)
     (O.join-left (J.bigJ n as) (J.bigJ m bs)) (O.le-of-eq _ _ (sym (FF.append-join (n,as) m bs)))) ;
  affine-y : (j : Fin k) -> Q.AffineOpen (ys j) = FF.all (n,as) Q.AffineOpen cu.affine m bs cv.affine ;
  -- every torsor has sections on the members of Y
  covered (T : Torsors.Torsor) : Tr.Trunc[(j : Fin k) -> T.presheaf.obj (ys j)].carrier =
   AffineFinite[l].choice k (\ j -> T.presheaf.obj (ys j)) (\ j -> Local.section (ys j) (affine-y j) T) ;
  module RU = SerreCechRefinement[l].On[L,X.sheaf,M,k,ys,covers-y,n,as,covers-u,C.left m bs,
   \ i -> O.le-of-eq _ _ (sym (C.left-eq m bs i))] ;
  module RV = SerreCechRefinement[l].On[L,X.sheaf,M,k,ys,covers-y,m,bs,covers-v,C.right m bs,
   \ j -> O.le-of-eq _ _ (sym (C.right-eq m bs j))] ;
  module OU = RU.Onto[covered] ; module OV = RV.Onto[covered] ;
  module HU = RU.GW ; module HV = RV.GW ; module HY = RU.GU ;
  -- the comparison and its inverse
  comparison (h : RU.ZW.H1) : RV.ZW.H1 = RV.phi (OU.psi h) ;
  inverse (h : RV.ZW.H1) : RU.ZW.H1 = RU.phi (OV.psi h) ;
  inverse-comparison (h : RU.ZW.H1) : Id RU.ZW.H1 (inverse (comparison h)) h =
   trans (ap RU.phi (OV.psi-phi (OU.psi h))) (OU.phi-psi h) ;
  comparison-inverse (h : RV.ZW.H1) : Id RV.ZW.H1 (comparison (inverse h)) h =
   trans (ap RV.phi (OU.psi-phi (OV.psi h))) (OV.phi-psi h) ;
  equivalence : Pr.Equiv RU.ZW.H1 RV.ZW.H1 =
   (comparison,Pr.qinv RU.ZW.H1 RV.ZW.H1 comparison inverse comparison-inverse inverse-comparison) ;
  -- additivity: psi is additive since phi is an additive bijection
  psi-add (h g : RU.ZW.H1) : Id RU.ZU.H1 (OU.psi (HU.h1-module.madd h g)) (HY.h1-module.madd (OU.psi h) (OU.psi g)) =
   calc RU.ZU.H1 {
    OU.psi (HU.h1-module.madd h g)
     =< ap OU.psi (sym (cong2 RU.ZW.H1 HU.h1-module.madd _ _ _ _ (OU.phi-psi h) (OU.phi-psi g)))
      > OU.psi (HU.h1-module.madd (RU.phi (OU.psi h)) (RU.phi (OU.psi g)))
     =< ap OU.psi (sym (RU.phi-add (OU.psi h) (OU.psi g))) > OU.psi (RU.phi (HY.h1-module.madd (OU.psi h) (OU.psi g)))
     =< OU.psi-phi (HY.h1-module.madd (OU.psi h) (OU.psi g)) > HY.h1-module.madd (OU.psi h) (OU.psi g) } ;
  comparison-add (h g : RU.ZW.H1) :
   Id RV.ZW.H1 (comparison (HU.h1-module.madd h g)) (HV.h1-module.madd (comparison h) (comparison g)) =
   trans (ap RV.phi (psi-add h g)) (RV.phi-add (OU.psi h) (OU.psi g)) ;
  -- the U-class of a torsor goes to its V-class
  comparison-torsor (T : Torsors.Torsor) (cu-cov : RU.WC.TorsorClass[T].Covered) (cv-cov : RV.WC.TorsorClass[T].Covered) :
   Id RV.ZW.H1 (comparison (RU.WC.TorsorClass[T].class cu-cov)) (RV.WC.TorsorClass[T].class cv-cov) =
   calc RV.ZW.H1 {
    comparison (RU.WC.TorsorClass[T].class cu-cov)
     =< ap (\ x -> RV.phi (OU.psi x)) (sym (RU.phi-torsor T (covered T) cu-cov))
      > RV.phi (OU.psi (RU.phi (RU.UC.TorsorClass[T].class (covered T))))
     =< ap RV.phi (OU.psi-phi (RU.UC.TorsorClass[T].class (covered T))) > RV.phi (RU.UC.TorsorClass[T].class (covered T))
     =< RV.phi-torsor T (covered T) cv-cov > RV.WC.TorsorClass[T].class cv-cov } ;
 } ;
} ;
