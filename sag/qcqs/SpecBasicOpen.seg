-- (Spec A)|_{D(g)} = Spec(A_g) as locally ringed lattices (DESIGN.md,
-- Next 5, prerequisite).  A is a set, g in A, Spec A and Spec(A_g) are taken
-- with the rings of fractions (Affine), beta = f_g : A -> A_g, and X|e is the
-- slice of X = Spec A below e = D g (Slice), with inclusion cut.
--
-- The two maps (geometric notation, then the ringed convention).
--  j : Spec(A_g) -> X|e.  Spec beta : L_A -> L_(A_g) (SpecHom) sends D g to
--   D_top(beta g|top) = top, as beta g is a unit (SpecMap.pi-D,
--   InvOpen.whole); so it factors as Spec beta = j . cut, with j local
--   (SliceUniversal).
--  k : X|e -> Spec(A_g).  Gamma(X|e) = O(D g), and k is the map of
--   phi = extend : A_g -> O(D g) (BasicOpen; SpecUniversal for X|e).
-- Lemma (cut).  The global component of cut is a |-> (a|top)|D g =
--  phi(beta a) (res-comp, Global.extend-global).
-- Lemma (j after cut).  The global component of j . cut = Spec beta is
--  a |-> (beta a)|top (SpecHom).
-- Theorem.  j is an isomorphism, with inverse k.
--  Spec(A_g) -> X|e -> Spec(A_g) (j . k in geometric notation) has global
--  component Gamma(j) . phi (SpecHom.Precompose), a ring map out of A_g; on
--  beta a it is Gamma(j)((a|top)|D g) = (global component of j . cut)(a) =
--  (beta a)|top (the two lemmas), so it is x |-> x|top
--  (Localisation.Agree).  Both it and the identity are local with global
--  component x |-> x|top, so they are equal (SpecUniversal.unique).
--  X|e -> Spec(A_g) -> X|e: after cut it is k . (j . cut) (Compose.Assoc),
--  with global component Gamma(k)((beta a)|top) = phi(beta a) =
--  (global component of cut)(a), as for the identity after cut; so both
--  composites with cut are equal (SpecUniversal.unique), and so are the maps
--  (SliceUniversal.cancel).
--  Both composites are identities, so j and k are isomorphisms
--  (Compose.Inverse), and X|e is affine (AffineCriterion).
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (g : A.R) {
 module SA = Affine[l].Over[A] ;
 module ZA = ZariskiLattice[l].Over[A] ;
 module SG = Affine[l].Over[SA.Loc g] ;
 module ZG = ZariskiLattice[l].Over[SA.Loc g] ;
 module Sl = Slice[l].Over[ZA.lattice,SA.spec,ZA.D g] ;
 module BO = BasicOpen[l].Over[A,SA.Loc,SA.set,SA.inclusion,SA.elementary] ;
 module Gb = Global[l].Over[A,setA,SA.Loc,SA.set,SA.inclusion,SA.elementary] ;
 module GX = RingedLattice[l].On[ZA.lattice].Of[SA.spec.sheaf] ;
 module GG = RingedLattice[l].On[ZG.lattice].Of[SG.spec.sheaf] ;

 -- Spec beta, and j
 module J = SpecHom[l].Over[A,setA,SA.Loc,SA.set,SA.inclusion,SA.elementary,
  SA.Loc g,SA.set g,SG.Loc,SG.set,SG.inclusion,SG.elementary,SA.inclusion g] ;
 module JM = J.Into.Of[J.phi] ;
 beta-unit : RL[SA.Loc g].unit (map (SA.inclusion g) g) =
  Bridge[l].Over[A,g].At[SA.Loc g,SA.set g,SA.inclusion g,SA.elementary g,g].unit-of (suc zero,A.o,refl (A.mul g A.o)) ;
 phi-unit : RL[SG.spec.sheaf.ring ZG.lattice.top].unit (map J.phi g) =
  AffineRing[l].unit-map (SA.Loc g) (SG.spec.sheaf.ring ZG.lattice.top) J.GA.global (map (SA.inclusion g) g) beta-unit ;
 top-e : Id ZG.lattice.L (DL.hmap J.morphism.lat (ZA.D g)) ZG.lattice.top =
  trans (JM.SM.pi-D g)
   (JM.SM.LX.IO.unique (JM.SM.LX.d-open ZG.lattice.top (map J.phi g)) (JM.SM.LX.IO.whole ZG.lattice.top (map J.phi g) phi-unit)) ;
 module SU = SliceUniversal[l].Over[ZA.lattice,SA.spec,ZA.D g,ZG.lattice,SG.spec.sheaf] ;
 module JB = SU.Back[J.morphism,top-e] ;
 j-local : SU.MS.Of[JB.factor,Sl.inv,SG.spec.inv].IsLocal = JB.local SG.spec.inv J.local ;

 -- k
 module K = SpecUniversal[l].Over[SA.Loc g,SA.set g,SG.Loc,SG.set,SG.inclusion,SG.elementary,Sl.lattice,Sl.restricted] ;
 -- phi = extend, typed at Gamma(X|e)
 phi : RH.Hom (SA.Loc g) (Sl.restricted.sheaf.ring Sl.lattice.top) = BO.At[g].extension ;
 module KM = K.Of[phi] ;

 -- (cut) the global component of cut is phi . beta
 module UA = SpecUniversal[l].Over[A,setA,SA.Loc,SA.set,SA.inclusion,SA.elementary,Sl.lattice,Sl.restricted] ;
 cut-component (a : A.R) :
  Id (Sl.restricted.sheaf.ring Sl.lattice.top).R (map (UA.component Sl.inclusion) a) (map phi (map (SA.inclusion g) a)) =
  calc (Sl.restricted.sheaf.ring Sl.lattice.top).R {
   map (UA.component Sl.inclusion) a
    =< UA.component-map Sl.inclusion a
     > UA.GO.restrict Sl.lattice.top (DL.hmap Sl.inclusion.lat ZA.lattice.top) (UA.psi-top Sl.inclusion)
        (map (Sl.inclusion.sharp ZA.lattice.top) (map Gb.global a))
    =< Sl.res-inc Sl.lattice.top (DL.hmap Sl.inclusion.lat ZA.lattice.top) (UA.psi-top Sl.inclusion)
        (map (Sl.inclusion.sharp ZA.lattice.top) (map Gb.global a))
     > GX.restrict (Sl.inc Sl.lattice.top) (Sl.inc (DL.hmap Sl.inclusion.lat ZA.lattice.top))
        (Sl.le-inc Sl.lattice.top (DL.hmap Sl.inclusion.lat ZA.lattice.top) (UA.psi-top Sl.inclusion))
        (GX.restrict (ZA.lattice.meet ZA.lattice.top (ZA.D g)) ZA.lattice.top (ZA.O.meet-left ZA.lattice.top (ZA.D g)) (map Gb.global a))
    =< SA.spec.sheaf.res-comp (Sl.inc Sl.lattice.top) (Sl.inc (DL.hmap Sl.inclusion.lat ZA.lattice.top)) ZA.lattice.top
        (Sl.le-inc Sl.lattice.top (DL.hmap Sl.inclusion.lat ZA.lattice.top) (UA.psi-top Sl.inclusion))
        (ZA.O.meet-left ZA.lattice.top (ZA.D g)) (ZA.O.le-top (Sl.inc Sl.lattice.top)) (map Gb.global a)
     > GX.restrict (Sl.inc Sl.lattice.top) ZA.lattice.top (ZA.O.le-top (Sl.inc Sl.lattice.top)) (map Gb.global a)
    =< refl (Gb.S.restrict (ZA.D g) ZA.lattice.top (ZA.O.le-top (ZA.D g)) (map Gb.global a))
     > Gb.S.restrict (ZA.D g) ZA.lattice.top (ZA.O.le-top (ZA.D g)) (map Gb.global a)
    =< sym (Gb.extend-global g a) > BO.At[g].extend (map (SA.inclusion g) a)
    =< sym (BO.At[g].extension-map (map (SA.inclusion g) a)) > map phi (map (SA.inclusion g) a) } ;

 -- (j after cut) the global component of j . cut is a |-> (beta a)|top
 module PC = SpecHom[l].Precompose[A,setA,SA.Loc,SA.set,SA.inclusion,SA.elementary,Sl.lattice,Sl.restricted,
  ZG.lattice,SG.spec,JB.factor,Sl.inclusion] ;
 j-cut-component (a : A.R) :
  Id (SG.spec.sheaf.ring ZG.lattice.top).R (map (J.Into.component PC.C.composite) a) (map J.GA.global (map (SA.inclusion g) a)) =
  calc (SG.spec.sheaf.ring ZG.lattice.top).R {
   map (J.Into.component PC.C.composite) a =< ap (\ p -> map (J.Into.component p) a) JB.factor-cut
     > map (J.Into.component J.morphism) a
    =< JM.component-of a > map J.phi a
    =< J.phi-map a > map J.GA.global (map (SA.inclusion g) a) } ;
 j-cut-local : J.Into.Mp.Of[PC.C.composite,J.Into.SI.inv-map,SG.spec.inv].IsLocal =
  PC.C.Local[UA.SI.inv-map,Sl.inv,SG.spec.inv,Sl.inclusion-local,j-local].local ;

 -- Spec(A_g) -> X|e -> Spec(A_g) is the identity
 module PA = SpecHom[l].Precompose[SA.Loc g,SA.set g,SG.Loc,SG.set,SG.inclusion,SG.elementary,Sl.lattice,Sl.restricted,
  ZG.lattice,SG.spec,JB.factor,KM.morphism] ;
 module LG = Bridge[l].Over[A,g].LocH ;
 -- Gamma(j) . phi is x |-> x|top, by its values on beta a
 gamma-phi : Id (RH.Hom (SA.Loc g) (SG.spec.sheaf.ring ZG.lattice.top))
  (RH.compose (SA.Loc g) (Sl.restricted.sheaf.ring Sl.lattice.top) (SG.spec.sheaf.ring ZG.lattice.top) PA.gamma phi) J.GA.global =
  LG.Agree[SA.Loc g,SA.inclusion g,LG.is-loc (SA.Loc g) (SA.inclusion g) (SA.elementary g),
   SG.spec.sheaf.ring ZG.lattice.top,SG.spec.sheaf.ring-set ZG.lattice.top,
   RH.compose (SA.Loc g) (Sl.restricted.sheaf.ring Sl.lattice.top) (SG.spec.sheaf.ring ZG.lattice.top) PA.gamma phi,J.GA.global,
   \ a -> calc (SG.spec.sheaf.ring ZG.lattice.top).R {
    map (RH.compose (SA.Loc g) (Sl.restricted.sheaf.ring Sl.lattice.top) (SG.spec.sheaf.ring ZG.lattice.top) PA.gamma phi)
      (map (SA.inclusion g) a)
     =< map-compose PA.gamma phi (map (SA.inclusion g) a)
      > map PA.gamma (map phi (map (SA.inclusion g) a))
     =< ap (map PA.gamma) (sym (cut-component a)) > map PC.gamma (map (UA.component Sl.inclusion) a)
     =< sym (PC.component a) > map (J.Into.component PC.C.composite) a
     =< j-cut-component a > map J.GA.global (map (SA.inclusion g) a) }].equal ;
 module IdG = Compose[l].Identity[ZG.lattice,SG.spec.sheaf] ;
 jk-component (x : (SA.Loc g).R) :
  Id (SG.spec.sheaf.ring ZG.lattice.top).R (map (PA.UA2.component PA.C.composite) x) (map (PA.UA2.component IdG.identity) x) =
  calc (SG.spec.sheaf.ring ZG.lattice.top).R {
   map (PA.UA2.component PA.C.composite) x =< PA.component x > map PA.gamma (map (K.component KM.morphism) x)
    =< ap (map PA.gamma) (KM.component-of x) > map PA.gamma (map phi x)
    =< ap (\ h -> map h x) gamma-phi > map J.GA.global x
    =< sym (IdG.fixes ZG.lattice.top (PA.UA2.psi-top IdG.identity) (map J.GA.global x))
     > GG.restrict ZG.lattice.top (DL.hmap IdG.identity.lat ZG.lattice.top) (PA.UA2.psi-top IdG.identity)
        (map (IdG.identity.sharp ZG.lattice.top) (map PA.UA2.Gb.global x))
    =< sym (PA.UA2.component-map IdG.identity x) > map (PA.UA2.component IdG.identity) x } ;
 jk : Id PA.UA2.Mp.Ringed PA.C.composite IdG.identity =
  PA.UA2.unique PA.C.composite IdG.identity
   (PA.C.Local[K.SI.inv-map,Sl.inv,SG.spec.inv,KM.local,j-local].local) (IdG.local SG.spec.inv) jk-component ;

 -- X|e -> Spec(A_g) -> X|e is the identity
 module SS = SliceUniversal[l].Over[ZA.lattice,SA.spec,ZA.D g,Sl.lattice,Sl.sheaf] ;
 module IdS = Compose[l].Identity[Sl.lattice,Sl.sheaf] ;
 module PB = SpecHom[l].Precompose[A,setA,SA.Loc,SA.set,SA.inclusion,SA.elementary,ZG.lattice,SG.spec,Sl.lattice,Sl.restricted,
  KM.morphism,PC.C.composite] ;
 module PI = SpecHom[l].Precompose[A,setA,SA.Loc,SA.set,SA.inclusion,SA.elementary,Sl.lattice,Sl.restricted,Sl.lattice,Sl.restricted,
  IdS.identity,Sl.inclusion] ;
 kj-cut-component (a : A.R) :
  Id (Sl.restricted.sheaf.ring Sl.lattice.top).R (map (UA.component PB.C.composite) a) (map (UA.component PI.C.composite) a) =
  calc (Sl.restricted.sheaf.ring Sl.lattice.top).R {
   map (UA.component PB.C.composite) a =< PB.component a > map PB.gamma (map (J.Into.component PC.C.composite) a)
    =< ap (map PB.gamma) (j-cut-component a) > map PB.gamma (map J.GA.global (map (SA.inclusion g) a))
    =< sym (K.component-map KM.morphism (map (SA.inclusion g) a)) > map (K.component KM.morphism) (map (SA.inclusion g) a)
    =< KM.component-of (map (SA.inclusion g) a) > map phi (map (SA.inclusion g) a)
    =< sym (cut-component a) > map (UA.component Sl.inclusion) a
    =< sym (IdS.fixes Sl.topS (PI.top-le) (map (UA.component Sl.inclusion) a))
     > map PI.gamma (map (UA.component Sl.inclusion) a)
    =< sym (PI.component a) > map (UA.component PI.C.composite) a } ;
 kj-cut : Id UA.Mp.Ringed PB.C.composite PI.C.composite =
  UA.unique PB.C.composite PI.C.composite
   (PB.C.Local[UA.SI.inv-map,SG.spec.inv,Sl.inv,j-cut-local,KM.local].local)
   (PI.C.Local[UA.SI.inv-map,Sl.inv,Sl.inv,Sl.inclusion-local,IdS.local Sl.inv].local) kj-cut-component ;
 module As = Compose[l].Assoc[ZA.lattice,Sl.lattice,ZG.lattice,Sl.lattice,SA.spec.sheaf,Sl.sheaf,SG.spec.sheaf,Sl.sheaf,
  Sl.inclusion,JB.factor,KM.morphism] ;
 kj : Id SS.MS.Ringed As.RP.composite IdS.identity =
  SS.cancel As.RP.composite IdS.identity (calc SS.MX.Ringed {
   As.Right.composite =< sym As.assoc > As.Left.composite
    =< kj-cut > PI.C.composite }) ;

 -- j and k are isomorphisms, and X|e is affine
 module IS = Iso[l].Maps[Sl.lattice,Sl.lattice,Sl.sheaf,Sl.sheaf] ;
 module IG = Iso[l].Maps[ZG.lattice,ZG.lattice,SG.spec.sheaf,SG.spec.sheaf] ;
 kj-iso : IS.IsIso As.RP.composite = Pr.subst SS.MS.Ringed (\ p -> IS.IsIso p) IdS.identity As.RP.composite (sym kj) IdS.iso ;
 jk-iso : IG.IsIso PA.C.composite = Pr.subst PA.UA2.Mp.Ringed (\ p -> IG.IsIso p) IdG.identity PA.C.composite (sym jk) IdG.iso ;
 j-iso : Iso[l].Maps[Sl.lattice,ZG.lattice,Sl.sheaf,SG.spec.sheaf].IsIso JB.factor =
  Compose[l].Inverse[Sl.lattice,ZG.lattice,Sl.sheaf,SG.spec.sheaf,JB.factor,KM.morphism,kj-iso,jk-iso].iso ;
 k-iso : Iso[l].Maps[ZG.lattice,Sl.lattice,SG.spec.sheaf,Sl.sheaf].IsIso KM.morphism =
  Compose[l].Inverse[ZG.lattice,Sl.lattice,SG.spec.sheaf,Sl.sheaf,KM.morphism,JB.factor,jk-iso,kj-iso].iso ;
 affine : AffineCriterion[l].Over[Sl.lattice,Sl.restricted].IsAffine =
  AffineCriterion[l].Over[Sl.lattice,Sl.restricted].Criterion[SA.Loc g,SA.set g,SG.Loc,SG.set,SG.inclusion,SG.elementary,
   KM.morphism,k-iso].affine ;
} ;
