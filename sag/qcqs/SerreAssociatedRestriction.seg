-- Associated module restriction on the canonical localisation chart.
-- Compare associated M_g on Spec(A_g) with the direct image of associated
-- M restricted to D(g), along the actual SpecBasicOpen inverse chart.
-- On D(incl a), evaluate, use the checked semilinear localisation
-- comparison to M_(g*a), and extend back to module sections on the chart
-- image. Evaluation at g*a proves linearity and both inverse equations;
-- the chart's scalar map is used through its named evaluated equation.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module RH = RingHom[l] ; module RM = RingMaps[l] ; module DL = DistLattice[l] ;
module MS = SerreModuleSheaf[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (Md : SM.Over[A].Module) (g : A.R) {
 module Local = SerreAssociatedRestrictionBasis[l].Over[A,setA,Md,g] ;
 module Cht = Local.Cht ; module Geometry = Local.Geometry ; module Rings = Local.Rings ;
 module Original = Local.Original ; module N = Original.S ;
 module Source = Local.Source ; module M = Source.S ;
 module ZA = Local.ZA ; module O = Local.O ; module ZB = Cht.ZG ; module OB = ZB.O ;
 module SliceModule = SerreModuleSheafRestriction[l].On[ZA.lattice,Cht.SA.spec,ZA.D g,Original.associated] ;
 module Push = SerreModuleSheafDirectImage[l].Over[ZB.lattice,Cht.Sl.lattice,Cht.SG.spec.sheaf,Cht.Sl.sheaf,
  Cht.KM.morphism,SliceModule.restricted] ;
 module Modules = MS.On[ZB.lattice,Cht.SG.spec.sheaf] ;
 module SO = Modules.Of[Source.associated.presheaf] ; module TO = Modules.Of[Push.presheaf] ;
 basic (a : A.R) : ZB.lattice.L = ZB.D (Geometry.coefficient a) ;
 module At (a : A.R) {
  module C = Local.At[a] ; module RR = C.RR ; module SB = Local.SB.At[RR.b] ;
  module RB = Local.SB.RingBasic.At[RR.b] ;
  module AB = Local.AB.At[C.ga] ;
  underlying : ZA.lattice.L = RR.underlying ;
  upper : O.Le underlying (ZA.D C.ga) = O.le-of-eq _ _ (Geometry.k-basic-underlying a) ;
  module TargetModule = Push.At[basic a].Scalars ;
  evaluate (s : (Push.presheaf.module-at (basic a)).M) : Local.R.Local[C.ga].Native.L.Carrier = N.at s C.ga RR.below ;
  returning (x : Local.R.Local[C.ga].Native.L.Carrier) : (Push.presheaf.module-at (basic a)).M =
   N.restrict underlying (ZA.D C.ga) upper (AB.extend x) ;
  evaluate-returning (x : Local.R.Local[C.ga].Native.L.Carrier) : Id Local.R.Local[C.ga].Native.L.Carrier (evaluate (returning x)) x =
   trans (N.restrict-at underlying (ZA.D C.ga) upper (AB.extend x) C.ga RR.below)
    (trans (N.component-irr (ZA.D C.ga) (AB.extend x) C.ga
     (O.le-trans (ZA.D C.ga) underlying (ZA.D C.ga) RR.below upper) AB.gg) (AB.eval-extend x)) ;
  returning-evaluate (s : (Push.presheaf.module-at (basic a)).M) : Id (N.Section underlying) (returning (evaluate s)) s =
   N.section-ext underlying _ _ (\ h k ->
    trans (N.restrict-at underlying (ZA.D C.ga) upper (AB.extend (evaluate s)) h k)
     (trans (AB.extend-at (evaluate s) h (O.le-trans (ZA.D h) underlying (ZA.D C.ga) k upper))
      (trans (N.compat s C.ga h RR.below (O.le-trans (ZA.D h) underlying (ZA.D C.ga) k upper))
       (N.component-irr underlying s h
        (O.le-trans (ZA.D h) (ZA.D C.ga) underlying (O.le-trans (ZA.D h) underlying (ZA.D C.ga) k upper) RR.below) k)))) ;
  evaluate-equivalence : Pr.isEquiv (Push.presheaf.module-at (basic a)).M Local.R.Local[C.ga].Native.L.Carrier evaluate =
   Pr.qinv _ _ evaluate returning evaluate-returning returning-evaluate ;
  evaluate-add (s t : (Push.presheaf.module-at (basic a)).M) :
   Id Local.R.Local[C.ga].Native.L.Carrier (evaluate ((Push.presheaf.module-at (basic a)).madd s t))
    (C.TargetModule.localised.madd (evaluate s) (evaluate t)) = N.Ops[underlying].add-at s t C.ga RR.below ;
  scalar-component (r : (Cht.SG.spec.sheaf.ring (basic a)).R) :
   Id (Local.AF.Loc C.ga).R
    (Original.AM.G.S.at (RM.map (Cht.KM.morphism.sharp (basic a)) r) C.ga RR.below)
    (RM.map RR.local-map (RM.map RB.evaluation r)) =
   trans (sym (Original.AM.G.S.component-map underlying C.ga RR.below (RM.map (Cht.KM.morphism.sharp (basic a)) r)))
    (RR.sharp-evaluated r) ;
  evaluate-scale (r : (Cht.SG.spec.sheaf.ring (basic a)).R) (s : (Push.presheaf.module-at (basic a)).M) :
   Id Local.R.Local[C.ga].Native.L.Carrier (evaluate ((Push.presheaf.module-at (basic a)).sm r s))
    (C.TargetModule.localised.sm (RM.map RR.local-map (RM.map RB.evaluation r)) (evaluate s)) =
   trans (ap evaluate (TargetModule.scalar-at r s))
    (trans (N.Ops[underlying].scale-at (RM.map (Cht.KM.morphism.sharp (basic a)) r) s C.ga RR.below)
     (ap (\ b -> C.TargetModule.localised.sm b (evaluate s)) (scalar-component r))) ;
  source-eval (s : (Source.associated.presheaf.module-at (basic a)).M) : C.Native.I.SourcePower.Carrier = SB.Maps.map SB.evaluation s ;
  forward (s : (Source.associated.presheaf.module-at (basic a)).M) : (Push.presheaf.module-at (basic a)).M =
   returning (C.map (source-eval s)) ;
  evaluate-forward (s : (Source.associated.presheaf.module-at (basic a)).M) :
   Id Local.R.Local[C.ga].Native.L.Carrier (evaluate (forward s)) (C.map (source-eval s)) = evaluate-returning (C.map (source-eval s)) ;
  additive (s t : (Source.associated.presheaf.module-at (basic a)).M) :
   Id (Push.presheaf.module-at (basic a)).M
    (forward ((Source.associated.presheaf.module-at (basic a)).madd s t))
    ((Push.presheaf.module-at (basic a)).madd (forward s) (forward t)) =
   Iso[l].injective _ _ evaluate evaluate-equivalence _ _
    (trans (evaluate-forward ((Source.associated.presheaf.module-at (basic a)).madd s t))
     (trans (ap C.map (SB.Maps.map-add SB.evaluation s t))
      (trans (C.Maps.map-add C.linear (source-eval s) (source-eval t))
       (trans (cong2 Local.R.Local[C.ga].Native.L.Carrier C.TargetModule.localised.madd _ _ _ _
        (sym (evaluate-forward s)) (sym (evaluate-forward t))) (sym (evaluate-add (forward s) (forward t))))))) ;
  scalar (r : (Cht.SG.spec.sheaf.ring (basic a)).R) (s : (Source.associated.presheaf.module-at (basic a)).M) :
   Id (Push.presheaf.module-at (basic a)).M
    (forward ((Source.associated.presheaf.module-at (basic a)).sm r s))
    ((Push.presheaf.module-at (basic a)).sm r (forward s)) =
   Iso[l].injective _ _ evaluate evaluate-equivalence _ _
    (trans (evaluate-forward ((Source.associated.presheaf.module-at (basic a)).sm r s))
     (trans (ap C.map (SB.Maps.map-scale SB.evaluation r s))
      (trans (C.Maps.map-scale C.linear (RM.map RB.evaluation r) (source-eval s))
       (trans (ap (C.TargetModule.localised.sm (RM.map RR.local-map (RM.map RB.evaluation r))) (sym (evaluate-forward s)))
        (sym (evaluate-scale r (forward s))))))) ;
  module Maps = MM.Between[Cht.SG.spec.sheaf.ring (basic a),Cht.SG.spec.sheaf.ring (basic a),
   RH.identity (Cht.SG.spec.sheaf.ring (basic a)),Source.associated.presheaf.module-at (basic a),Push.presheaf.module-at (basic a)] ;
  component : Maps.Hom = new Maps.Hom[forward,additive,scalar] ;
  component-at (s : (Source.associated.presheaf.module-at (basic a)).M) :
   Id (Push.presheaf.module-at (basic a)).M (Maps.map component s) (forward s) = refl (forward s) ;
  equivalence : Pr.isEquiv (Source.associated.presheaf.module-at (basic a)).M (Push.presheaf.module-at (basic a)).M (Maps.map component) =
   Iso[l].equiv-homotopy _ _ forward (Maps.map component) (\ s -> sym (component-at s))
    (Iso[l].equiv-compose _ _ _ returning (\ s -> C.map (source-eval s))
     (Pr.qinv _ _ returning evaluate returning-evaluate evaluate-returning)
     (Iso[l].equiv-compose _ _ _ C.map source-eval C.equivalence SB.equivalence)) ;
  opaque component ;
 } ;
} ;
