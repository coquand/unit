-- Full faithfulness recovers an isomorphism from a natural equivalence
-- between geometric functors of qcqs spaces.  Recover f from e and g
-- from its inverse.  Their equations on all affine points identify the
-- two composites with identity: associate, substitute both point equations,
-- and apply the component inverse laws of e.  Faithfulness gives the
-- equations of geometric maps.  The composites are therefore isomorphisms,
-- and Compose.Inverse gives that f is an isomorphism.
-- This is used on qcqs compact-open overlaps; neither is assumed affine.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Hi = Prelude[l+] ;
module Sp = Spaces[l] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module TE = TestEquivalences[l] ;
module FP = FunctorPoints[l] ;
module Over (X Y : Sp.Space) (qx : Qcqs[l].Over[X.lattice,X.structure].IsQcqs)
 (qy : Qcqs[l].Over[Y.lattice,Y.structure].IsQcqs)
 (e : TE.NaturalEquivalence SF.Geometric[X].functor SF.Geometric[Y].functor) {
 module XY = SF.GeometricMaps[X,Y] ;
 module YX = SF.GeometricMaps[Y,X] ;
 module E = TE.Inverse[SF.Geometric[X].functor,SF.Geometric[Y].functor,e] ;
 module UX = PointsUniversal[l].Over[X,Y,qx] ;
 module UY = PointsUniversal[l].Over[Y,X,qy] ;
 forward : Sp.Hom X Y = UX.recover (XY.to-points (TE.forward e)) ;
 backward : Sp.Hom Y X = UY.recover (YX.to-points E.inverse) ;
 forward-on (B : T.Test) (p : Sp.Hom (T.space B) X) : Id (Sp.Hom (T.space B) Y)
  (Sp.compose (T.space B) X Y forward p) (SF.Transform[SF.Geometric[X].functor,SF.Geometric[Y].functor].at (TE.forward e) B p) =
  Hi.ap UX.N.Nat (Sp.Hom (T.space B) Y) (\ a -> UX.N.at a B p)
   (UX.N.induced forward) (XY.to-points (TE.forward e)) (UX.induced-recover (XY.to-points (TE.forward e))) ;
 backward-on (B : T.Test) (p : Sp.Hom (T.space B) Y) : Id (Sp.Hom (T.space B) X)
  (Sp.compose (T.space B) Y X backward p) (E.inverse-map B p) =
  Hi.ap UY.N.Nat (Sp.Hom (T.space B) X) (\ a -> UY.N.at a B p)
   (UY.N.induced backward) (YX.to-points E.inverse) (UY.induced-recover (YX.to-points E.inverse)) ;
 opaque forward ; opaque backward ;
 module XX = FP.Maps[X,X] ;
 module YY = FP.Maps[Y,Y] ;
 module At (B : T.Test) {
  left (p : Sp.Hom (T.space B) X) : Id (Sp.Hom (T.space B) X)
   (Sp.compose (T.space B) X X (Sp.compose X Y X backward forward) p)
   (Sp.compose (T.space B) X X Sp.Identity[X].identity p) =
   trans (sym Sp.Associativity[T.space B,X,Y,X,backward,forward,p].assoc)
    (trans (ap (Sp.compose (T.space B) Y X backward) (forward-on B p))
     (trans (backward-on B (SF.Transform[SF.Geometric[X].functor,SF.Geometric[Y].functor].at (TE.forward e) B p))
      (trans (E.left-at B p) (sym Sp.Laws[T.space B,X,p].left)))) ;
  right (p : Sp.Hom (T.space B) Y) : Id (Sp.Hom (T.space B) Y)
   (Sp.compose (T.space B) Y Y (Sp.compose Y X Y forward backward) p)
   (Sp.compose (T.space B) Y Y Sp.Identity[Y].identity p) =
   trans (sym Sp.Associativity[T.space B,Y,X,Y,forward,backward,p].assoc)
    (trans (ap (Sp.compose (T.space B) X Y forward) (backward-on B p))
     (trans (forward-on B (E.inverse-map B p)) (trans (E.right-at B p) (sym Sp.Laws[T.space B,Y,p].left)))) ;
 } ;
 inverse-left : Id (Sp.Hom X X) (Sp.compose X Y X backward forward) Sp.Identity[X].identity =
  ProbeSeparation[l].Over[X,X].Natural[qx].faithful (Sp.compose X Y X backward forward) Sp.Identity[X].identity
   (XX.ext (XX.induced (Sp.compose X Y X backward forward)) (XX.induced Sp.Identity[X].identity) (\ B p -> At[B].left p)) ;
 inverse-right : Id (Sp.Hom Y Y) (Sp.compose Y X Y forward backward) Sp.Identity[Y].identity =
  ProbeSeparation[l].Over[Y,Y].Natural[qy].faithful (Sp.compose Y X Y forward backward) Sp.Identity[Y].identity
   (YY.ext (YY.induced (Sp.compose Y X Y forward backward)) (YY.induced Sp.Identity[Y].identity) (\ B p -> At[B].right p)) ;
 left-iso : Sp.IsIso X X (Sp.compose X Y X backward forward) =
  Pr.subst (Sp.Hom X X) (Sp.IsIso X X) _ _ (sym inverse-left) Compose[l].Identity[X.lattice,X.structure.sheaf].iso ;
 right-iso : Sp.IsIso Y Y (Sp.compose Y X Y forward backward) =
  Pr.subst (Sp.Hom Y Y) (Sp.IsIso Y Y) _ _ (sym inverse-right) Compose[l].Identity[Y.lattice,Y.structure.sheaf].iso ;
 iso : Sp.IsIso X Y forward = Compose[l].Inverse[Y.lattice,X.lattice,Y.structure.sheaf,X.structure.sheaf,
  Sp.underlying forward,Sp.underlying backward,right-iso,left-iso].iso ;
} ;
