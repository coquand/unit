-- An equivalence over h_k restricts to an equivalence of fibre functors.
-- Send (z,m) to (e(z), triangle(z) m).  For y, take e^-1(y): the
-- inverse triangle and e(e^-1 y)=y give its base equation.  The two
-- inverse laws and naturality hold on underlying points, hence on fibre
-- points because their base equations are propositions (note §5).
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module TE = TestEquivalences[l] ;
module Over (K : T.Test) (G H : SF.SetFunctor)
 (q : SF.Transform[G,SF.Representable[K].functor].Nat) (r : SF.Transform[H,SF.Representable[K].functor].Nat)
 (e : TE.NaturalEquivalence G H)
 (triangle : (B : T.Test) (z : G.obj B) -> Id (RingHom[l].Hom K.ring B.ring)
  (SF.Transform[H,SF.Representable[K].functor].at r B (SF.Transform[G,H].at (TE.forward e) B z)) (SF.Transform[G,SF.Representable[K].functor].at q B z)) {
 module F = RelativeFibres[l].Over[K,G,q] ;
 module J = RelativeFibres[l].Over[K,H,r] ;
 module R = F.R ;
 module BP = R.BP ;
 module E = RelativeEquivalences[l].Over[K] ;
 module I = TE.Inverse[G,H,e] ;
 forward (A : BP.Algebra) (p : F.obj A) : J.obj A =
  (SF.Transform[G,H].at (TE.forward e) (BP.test A) (F.point p),trans (triangle (BP.test A) (F.point p)) (F.member p)) ;
 back (A : BP.Algebra) (p : J.obj A) : F.obj A =
  (I.inverse-map (BP.test A) (J.point p),
   trans (sym (triangle (BP.test A) (I.inverse-map (BP.test A) (J.point p))))
    (trans (ap (SF.Transform[H,SF.Representable[K].functor].at r (BP.test A)) (I.right-at (BP.test A) (J.point p))) (J.member p))) ;
 right (A : BP.Algebra) (p : J.obj A) : Id (J.obj A) (forward A (back A p)) p = J.ext A _ _ (I.right-at (BP.test A) (J.point p)) ;
 left (A : BP.Algebra) (p : F.obj A) : Id (F.obj A) (back A (forward A p)) p = F.ext A _ _ (I.left-at (BP.test A) (F.point p)) ;
 transformation : R.Transform[F.functor,J.functor].Nat = (forward,\ A B h p -> J.ext B _ _
  (SF.Transform[G,H].natural (TE.forward e) (BP.test A) (BP.test B) (BP.ring-map h) (F.point p))) ;
 equivalence : E.NaturalEquivalence F.functor J.functor = (transformation,\ A -> Pr.qinv (F.obj A) (J.obj A) (forward A) (back A) (right A) (left A)) ;
 opaque equivalence ;
} ;
