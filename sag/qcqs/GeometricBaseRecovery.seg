-- Recover the structure map from a natural projection h_X->h_k (§5).
-- Compose q with the affine comparison h_k~=h_(Spec k), and recover s
-- by absolute full faithfulness.  Evaluating its inverse equation on
-- affine probes, followed by AffineFunctor.map-at, gives s p=Spec(q p).
-- The recovered map is opaque after that characterising equation.
level l ; open Ring[l] ;
module Hi = Prelude[l+] ;
module T = AffineTests[l] ;
module SP = Spaces[l] ;
module SF = TestFunctors[l] ;
module TE = TestEquivalences[l] ;
module Over (K : T.Test) (X : SP.Space) (qcqs : Qcqs[l].Over[X.lattice,X.structure].IsQcqs)
 (q : SF.Transform[SF.Geometric[X].functor,SF.Representable[K].functor].Nat) {
 module A = AffineFunctor[l].Spectrum[K] ;
 module C = SF.Composite[SF.Geometric[X].functor,A.H.functor,A.G.functor,TE.forward A.equivalence,q] ;
 module UP = PointsUniversal[l].Over[X,T.space K,qcqs] ;
 s : SP.Hom X (T.space K) = UP.recover (SF.GeometricMaps[X,T.space K].to-points C.composite) ;
 equation (B : T.Test) (p : SP.Hom (T.space B) X) : Id (SP.Hom (T.space B) (T.space K))
  (SP.compose (T.space B) X (T.space K) s p)
  T.Map[K,B,SF.Transform[SF.Geometric[X].functor,SF.Representable[K].functor].at q B p].morphism =
  trans (Hi.ap UP.N.Nat (SP.Hom (T.space B) (T.space K)) (\ a -> UP.N.at a B p) _ _
    (UP.induced-recover (SF.GeometricMaps[X,T.space K].to-points C.composite)))
   (A.map-at B (SF.Transform[SF.Geometric[X].functor,SF.Representable[K].functor].at q B p)) ;
 opaque s ;
} ;
