-- Restrict an ordinary test functor to algebra tests by forgetting iota.
-- Identities and composites of algebra maps have the corresponding
-- underlying ring maps, so the absolute functor laws apply directly.
level l ; open Ring[l] ;
module T = AffineTests[l] ;
module Over (K : T.Test) (G : TestFunctors[l].SetFunctor) {
 module R = RelativeFunctors[l].Over[K] ;
 module BP = R.BP ;
 functor : R.SetFunctor = new R.SetFunctor[\ A -> G.obj (BP.test A),\ A -> G.set (BP.test A),
  \ A B h -> G.reindex (BP.test A) (BP.test B) (BP.ring-map h),
  \ A x -> G.identity (BP.test A) x,
  \ A B C f g x -> G.composition (BP.test A) (BP.test B) (BP.test C) (BP.ring-map f) (BP.ring-map g) x] ;
} ;
