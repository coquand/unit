-- Transfer realisations along a natural equivalence and a membership iff.
-- Let e:F=G be a natural equivalence, U an open of F, V an open of G,
-- and assume x belongs to U iff e(x) belongs to V.  Restrict e to the
-- realisations by pairing its value with the forward membership proof.
-- Its naturality is point-ext and e's naturality.  For (y,m) in |V|,
-- take e^-1(y); transport m along e(e^-1(y))=y, then reflect membership.
-- The two inverse laws are the two pointwise inverse laws of e, followed
-- by point-ext.  No equality of the open or functor records is required.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module SF = TestFunctors[l] ;
module TE = TestEquivalences[l] ;
module CO = CompactOpens[l] ;
module T = AffineTests[l] ;
module Over (F G : SF.SetFunctor) (u : CO.Over[F].Open) (v : CO.Over[G].Open) (e : TE.NaturalEquivalence F G) {
 module RU = OpenRealisation[l].Over[F,u] ;
 module RV = OpenRealisation[l].Over[G,v] ;
 module N = SF.Transform[F,G] ;
 module E = TE.Inverse[F,G,e] ;
 module Given
  (to-member : (B : T.Test) (x : F.obj B) -> RU.Member B x -> RV.Member B (N.at (TE.forward e) B x))
  (from-member : (B : T.Test) (x : F.obj B) -> RV.Member B (N.at (TE.forward e) B x) -> RU.Member B x) {
  module Into = SF.Composite[RU.functor,F,G,TE.forward e,RU.inclusion] ;
  module L = RV.Lift[RU.functor,Into.composite,\ B p -> to-member B (RU.point {B} p) (RU.member {B} p)] ;
  module At (B : T.Test) {
   reflected (p : RV.obj B) : RU.Member B (E.inverse-map B (RV.point {B} p)) =
    from-member B (E.inverse-map B (RV.point {B} p))
     (Pr.subst (G.obj B) (RV.Member B) _ _ (sym (E.right-at B (RV.point {B} p))) (RV.member {B} p)) ;
   back (p : RV.obj B) : RU.obj B = (E.inverse-map B (RV.point {B} p),reflected p) ;
   forward-back (p : RV.obj B) : Id (RV.obj B) (SF.Transform[RU.functor,RV.functor].at L.lift B (back p)) p =
    RV.point-ext B (SF.Transform[RU.functor,RV.functor].at L.lift B (back p)) p (E.right-at B (RV.point {B} p)) ;
   back-forward (p : RU.obj B) : Id (RU.obj B) (back (SF.Transform[RU.functor,RV.functor].at L.lift B p)) p =
    RU.point-ext B (back (SF.Transform[RU.functor,RV.functor].at L.lift B p)) p (E.left-at B (RU.point {B} p)) ;
  } ;
  equivalence : TE.NaturalEquivalence RU.functor RV.functor = (L.lift,\ B ->
   Pr.qinv (RU.obj B) (RV.obj B) (SF.Transform[RU.functor,RV.functor].at L.lift B) At[B].back At[B].forward-back At[B].back-forward) ;
  forward-point (B : T.Test) (p : RU.obj B) : Id (G.obj B)
   (RV.point {B} (SF.Transform[RU.functor,RV.functor].at (TE.forward equivalence) B p))
   (N.at (TE.forward e) B (RU.point {B} p)) = refl (N.at (TE.forward e) B (RU.point {B} p)) ;
  opaque equivalence ;
 } ;
} ;
