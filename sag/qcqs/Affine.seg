-- Spec A for any commutative ring A (DESIGN.md, step 4, Next 2): the
-- localisation family of SpecLocal taken to be the rings of fractions
-- R_g = A[1/g] (MonoidLocalization at the powers of g), which have the
-- elementary form (LocalisationFractions).  Every file before this one is
-- parametric in the family; this is the one place where it is fixed.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ;
module Over (A : CRing) {
 module At (g : A.R) {
  module Br = Bridge[l].Over[A,g] ;
  module Fr = LocalisationFractions[l].Over[A,Br.Powers,Br.powers-one,Br.powers-mul] ;
 } ;
 Loc (g : A.R) : CRing = At[g].Fr.B.ring ;
 set (g : A.R) : Pr.isSet (Loc g).R = At[g].Fr.B.set ;
 inclusion (g : A.R) : RH.Hom A (Loc g) = At[g].Fr.B.inclusion ;
 elementary (g : A.R) : Bridge[l].Over[A,g].LocH.Elementary (Loc g) (inclusion g) = At[g].Fr.elementary-fractions ;
 spec : LocallyRinged[l].On[ZariskiLattice[l].Over[A].lattice].LocallyRinged =
  SpecLocal[l].Over[A,Loc,set,inclusion,elementary].spec ;
} ;
