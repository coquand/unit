-- The univalent categories of geometric and functorial qcqs schemes.
-- Restrict GeometricCategory and FunctorCategory to their respective
-- propositional qcqs conditions using FullSubcategory.  The object map
-- X -> h_X is GeometricAtlas.  The arrow map is the existing induced
-- transformation.  Its unit and composition laws are geometric unit
-- and associativity equations on every affine probe.
-- PointsUniversal gives full faithfulness.  EssentialImage gives mere
-- essential surjectivity: invert its representing equivalence and use
-- FunctorCategory.ToIso.  WeakCategoryEquivalence then gives an actual
-- equivalence of object types, eliminating truncation only into fibres
-- already proved propositions.  The construction assumes no choice.
level l ; open Ring[l] ;
module Hi = Prelude[l+] ;
module Tr = Truncation[l+] ;
module SP = Spaces[l] ;
module SF = TestFunctors[l] ;
module TE = TestEquivalences[l] ;
module FP = FunctorPoints[l] ;
module QF = FunctorialQcqs[l] ;
module F = Functor[l+,l+,l+,l+] ;
geometric-property (X : SP.Space) : U l+ = Qcqs[l].Over[X.lattice,X.structure].IsQcqs ;
geometric-prop (X : SP.Space) : Hi.isProp (geometric-property X) =
 Truncation[l].Trunc[Qcqs[l].Over[X.lattice,X.structure].AffineCover].proposition ;
module Geometric = FullSubcategory[l+,l].Over[GeometricCategory[l].category,geometric-property,geometric-prop] ;
module Functorial = FullSubcategory[l+,l+].Over[FunctorCategory[l].category,\ F -> QF.Over[F].IsQcqs,\ F -> QF.Over[F].qcqs-prop] ;
on-objects (X : Geometric.precategory.ob) : Functorial.precategory.ob =
 (SF.Geometric[X.1].functor,GeometricAtlas[l].Over[X.1].qcqs X.2) ;
on-arrows (X Y : Geometric.precategory.ob) (f : SP.Hom X.1 Y.1) :
 SF.Transform[SF.Geometric[X.1].functor,SF.Geometric[Y.1].functor].Nat = SF.GeometricMaps[X.1,Y.1].from-points (FP.Maps[X.1,Y.1].induced f) ;
functor : F.Functor[Geometric.precategory,Functorial.precategory] = new F.Functor[Geometric.precategory,Functorial.precategory,on-objects,on-arrows,
 \ X -> SF.Transform[SF.Geometric[X.1].functor,SF.Geometric[X.1].functor].ext _ _ (\ B p -> SP.Laws[AffineTests[l].space B,X.1,p].left),
 \ X Y Z g f -> SF.Transform[SF.Geometric[X.1].functor,SF.Geometric[Z.1].functor].ext _ _
  (\ B p -> sym SP.Associativity[AffineTests[l].space B,X.1,Y.1,Z.1,g,f,p].assoc)] ;
fully-faithful : F.FullyFaithful Geometric.precategory Functorial.precategory functor =
 \ X Y -> PointsUniversal[l].Over[X.1,Y.1,X.2].equivalence ;
module At (F : Functorial.precategory.ob) {
 module EI = EssentialImage[l].Over[F.1] ;
 Preimage : U l+ = (X : Geometric.precategory.ob) * Functorial.precategory.Iso (on-objects X) F ;
 actual (r : EI.Representation) : Preimage = ((r.1,r.2.1),FunctorCategory[l].ToIso[SF.Geometric[r.1].functor,F.1,
  TE.Inverse[F.1,SF.Geometric[r.1].functor,r.2.2].inverse-equiv].categorical) ;
 merely : Tr.Trunc[Preimage].carrier = Tr.Trunc[EI.Representation].induction @(l+)
  (\ t -> Tr.Trunc[Preimage].carrier) (\ t -> Tr.Trunc[Preimage].proposition)
  (\ r -> Tr.Trunc[Preimage].inc (actual r)) (EI.reconstruct F.2) ;
} ;
essentially-surjective : F.EssSurj Geometric.precategory Functorial.precategory functor = \ F -> At[F].merely ;
module Comparison = WeakCategoryEquivalence[l+].Over[Geometric.category,Functorial.category,functor,fully-faithful,essentially-surjective] ;
object-equivalence : Hi.isEquiv Geometric.precategory.ob Functorial.precategory.ob on-objects = Comparison.object-equivalence ;

module Inverse = CategoryQuasiInverse[l+].Over[Geometric.category,Functorial.category,functor,fully-faithful,essentially-surjective] ;
equivalence : CategoryQuasiInverse[l+].Equivalence[Geometric.category,Functorial.category,functor] = Inverse.equivalence ;
