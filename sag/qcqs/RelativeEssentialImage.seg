-- Relative essential image by totalisation (note §5).
-- Totalise the intrinsic relative qcqs condition and apply the absolute
-- reconstruction.  For an actual representation e:T(F)~=h_X, use its
-- inverse followed by projection to get q:h_X->h_k.  Recover s:X->Spec k
-- and its affine-point equation by GeometricBaseRecovery.
-- Recover F as fibres of its total projection, transfer fibres along e,
-- and identify the last fibres with geometric points over s.  The triangle
-- over h_k is projection of e^-1(e z)=z.  Compose the three native natural
-- equivalences.  Eliminate the mere absolute representation ONLY into
-- mere relative representability.  Conversely actual representations are
-- relative qcqs by RelativeGeometricQcqs and RelativeQcqsTransfer.
level l ; open Ring[l] ;
module Hi = Prelude[l+] ;
module Tr = Truncation[l+] ;
module T = AffineTests[l] ;
module SP = Spaces[l] ;
module SF = TestFunctors[l] ;
module TE = TestEquivalences[l] ;
module Over (K : T.Test) (F : RelativeFunctors[l].Over[K].SetFunctor) {
 module RQ = RelativeQcqs[l].Over[K] ;
 module E = RelativeEquivalences[l].Over[K] ;
 module TF = RelativeTotal[l].Over[K,F] ;
 module EI = EssentialImage[l].Over[TF.functor] ;
 Representation : U l+ = (X : SP.Space) * (Qcqs[l].Over[X.lattice,X.structure].IsQcqs *
  ((s : SP.Hom X (T.space K)) * E.NaturalEquivalence F RelativeGeometric[l].Over[K,X,s].functor)) ;
 space (r : Representation) : SP.Space = r.1 ;
 geometric-qcqs (r : Representation) : Qcqs[l].Over[(space r).lattice,(space r).structure].IsQcqs = r.2.1 ;
 structure-map (r : Representation) : SP.Hom (space r) (T.space K) = r.2.2.1 ;
 comparison (r : Representation) : E.NaturalEquivalence F RelativeGeometric[l].Over[K,space r,structure-map r].functor = r.2.2.2 ;
 IsRepresentable : U l+ = Tr.Trunc[Representation].carrier ;
 proposition : Hi.isProp IsRepresentable = Tr.Trunc[Representation].proposition ;
 module Actual (r : EI.Representation) {
  module G = SF.Geometric[r.1] ;
  module I = TE.Inverse[TF.functor,G.functor,r.2.2] ;
  projection : SF.Transform[G.functor,SF.Representable[K].functor].Nat = SF.Composite[G.functor,TF.functor,SF.Representable[K].functor,TF.projection,I.inverse].composite ;
  module RecoveredBase = GeometricBaseRecovery[l].Over[K,r.1,r.2.1,projection] ;
  module First = RelativeFibreRecovery[l].Over[K,F] ;
  triangle (B : T.Test) (z : TF.functor.obj B) : Id TF.At[B].Indices
   (SF.Transform[G.functor,SF.Representable[K].functor].at projection B (SF.Transform[TF.functor,G.functor].at (TE.forward r.2.2) B z))
   (SF.Transform[TF.functor,SF.Representable[K].functor].at TF.projection B z) = ap (TF.At[B].base) (I.left-at B z) ;
  module Second = RelativeFibreEquivalence[l].Over[K,TF.functor,G.functor,TF.projection,projection,r.2.2,triangle] ;
  module Third = RelativeGeometricFibre[l].Over[K,r.1,RecoveredBase.s,projection,\ B p -> RecoveredBase.equation B p] ;
  module Through = E.Composite[F,First.S.functor,Second.J.functor,First.equivalence,Second.equivalence] ;
  equivalence : E.NaturalEquivalence F Third.G.functor = E.Composite[F,Second.J.functor,Third.G.functor,Through.equivalence,Third.equivalence].equivalence ;
  representation : Representation = (r.1,r.2.1,RecoveredBase.s,equivalence) ;
 } ;
 reconstruct (q : RQ.At[F].IsQcqs) : IsRepresentable = Tr.Trunc[EI.Representation].induction @(l+)
  (\ t -> IsRepresentable) (\ t -> proposition) (\ r -> Tr.Trunc[Representation].inc Actual[r].representation)
  (EI.reconstruct (RelativeTotalQcqs[l].Over[K].At[F].qcqs q)) ;
 represented (r : Representation) : RQ.At[F].IsQcqs = RelativeQcqsTransfer[l].Over[K,F,RelativeGeometric[l].Over[K,r.1,r.2.2.1].functor,r.2.2.2,
  RelativeGeometricQcqs[l].Over[K,r.1,r.2.2.1,r.2.1].qcqs].qcqs ;
 recognise (r : IsRepresentable) : RQ.At[F].IsQcqs = Tr.Trunc[Representation].induction @(l+)
  (\ t -> RQ.At[F].IsQcqs) (\ t -> RQ.At[F].proposition) represented r ;
 equivalence : Hi.Equiv RQ.At[F].IsQcqs IsRepresentable = (reconstruct,Hi.qinv _ _ reconstruct recognise
  (\ r -> proposition (reconstruct (recognise r)) r) (\ q -> RQ.At[F].proposition (recognise (reconstruct q)) q)) ;
} ;
