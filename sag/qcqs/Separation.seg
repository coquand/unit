-- Separation, the first half of the basic sheaf lemma (DESIGN.md, step 3).
-- Let D g = D h_1 \/ .. \/ D h_n with D h_i <= D g, and rho_i = rho_{g,h_i}.
--
-- Theorem.  If x in R_g has rho_i(x) = 0 for every i, then x = 0.
--  Write f_g(s) x = f_g(y) with s a power of g.  Then
--   f_{h_i}(y) = rho_i(f_g(y)) = rho_i(f_g(s)) rho_i(x) = 0,
--  so merely t_i y = 0 with t_i a power of h_i; by finite choice, for all i
--  at once.  Since D h_i <= D t_i, D g <= D t_1 \/ .. \/ D t_n = D(t), so
--  g^p = t_1 c_1 + .. + t_n c_n for some p, c (Nullstellensatz), and
--  y g^p = sum t_i (y c_i) = 0.  As f_g(g^p) is a unit, f_g(y) = 0; as
--  f_g(s) is a unit, x = 0.
-- Corollary.  The rho_i are jointly injective (apply it to x - x').  In
-- particular rho_{h,k} is injective when D h = D k (the one-element cover).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module Over (A : CRing) (Loc : A.R -> CRing) (set : (g : A.R) -> Pr.isSet (Loc g).R)
 (f : (g : A.R) -> RH.Hom A (Loc g))
 (el : (g : A.R) -> Bridge[l].Over[A,g].LocH.Elementary (Loc g) (f g)) {
 open A ; open RL[A] ;
 open Radical[l].Over[A] ; open FamilyLattice[l].Over[A] ;
 open ZariskiLattice[l].Over[A] ;
 module Sm = FiniteIdeal[l].Sums[A] ;
 module Sp = Sup.Of[D,support] ;
 module S = Sections[l].Over[A,Loc,set,f,el] ;

 -- the image of a fraction f_h(s) x = f_h(y) under rho_{h,k}: f_k(y) = f_k(s) rho(x)
 image-num (h k : R) (le : O.Le (D k) (D h)) (x : (Loc h).R) (p : Bridge[l].Over[A,h].LocH.Fraction (Loc h) (f h) x) :
  Id (Loc k).R (map (f k) (Bridge[l].Over[A,h].LocH.num p))
   ((Loc k).mul (map (f k) (Bridge[l].Over[A,h].LocH.den p)) (map (S.rho h k le) x)) = calc (Loc k).R {
  map (f k) (Bridge[l].Over[A,h].LocH.num p)
   =< sym (S.rho-on h k le (Bridge[l].Over[A,h].LocH.num p)) > map (S.rho h k le) (map (f h) (Bridge[l].Over[A,h].LocH.num p))
   =< ap (map (S.rho h k le)) (sym (Bridge[l].Over[A,h].LocH.eqn p))
    > map (S.rho h k le) ((Loc h).mul (map (f h) (Bridge[l].Over[A,h].LocH.den p)) x)
   =< map-mul (S.rho h k le) (map (f h) (Bridge[l].Over[A,h].LocH.den p)) x
    > (Loc k).mul (map (S.rho h k le) (map (f h) (Bridge[l].Over[A,h].LocH.den p))) (map (S.rho h k le) x)
   =< ap (\ t -> (Loc k).mul t (map (S.rho h k le) x)) (S.rho-on h k le (Bridge[l].Over[A,h].LocH.den p))
    > (Loc k).mul (map (f k) (Bridge[l].Over[A,h].LocH.den p)) (map (S.rho h k le) x) } ;

 module Cover (g : R) (n : Nat) (hs : Fin n -> R) (below : (i : Fin n) -> O.Le (D (hs i)) (D g))
  (covers : O.Le (D g) (J.bigJ n (\ i -> D (hs i)))) {
  module BG = Bridge[l].Over[A,g] ;
  rho-i (i : Fin n) : RH.Hom (Loc g) (Loc (hs i)) = S.rho g (hs i) (below i) ;

  -- f_{h_i}(y) = 0
  image-zero (x : (Loc g).R) (p : BG.LocH.Fraction (Loc g) (f g) x) (i : Fin n)
   (zi : Id (Loc (hs i)).R (map (rho-i i) x) (Loc (hs i)).z) :
   Id (Loc (hs i)).R (map (f (hs i)) (BG.LocH.num p)) (Loc (hs i)).z =
   trans (image-num g (hs i) (below i) x p)
    (trans (ap ((Loc (hs i)).mul (map (f (hs i)) (BG.LocH.den p))) zi) (RL[Loc (hs i)].mul-zero (map (f (hs i)) (BG.LocH.den p)))) ;

  -- killers t_i of y, one for each i
  Killers (y : R) : U l = (i : Fin n) -> Bridge[l].Over[A,hs i].LocH.Killer y ;
  killers (x : (Loc g).R) (p : BG.LocH.Fraction (Loc g) (f g) x)
   (zero : (i : Fin n) -> Id (Loc (hs i)).R (map (rho-i i) x) (Loc (hs i)).z) :
   Tr.Trunc[Killers (BG.LocH.num p)].carrier =
   AffineFinite[l].choice n (\ i -> Bridge[l].Over[A,hs i].LocH.Killer (BG.LocH.num p))
    (\ i -> Bridge[l].Over[A,hs i].LocH.kernel (el (hs i)) (BG.LocH.num p) (image-zero x p i (zero i))) ;
  kills {y : R} (c : Killers y) : Fin n -> R = \ i -> Bridge[l].Over[A,hs i].LocH.kill (c i) ;

  -- D g <= D(t)
  le-kill {y : R} (c : Killers y) (i : Fin n) : O.Le (D (hs i)) (D (kills c i)) =
   Pr.subst R (\ t -> O.Le (D (hs i)) (D t)) (power (hs i) (Bridge[l].Over[A,hs i].index (Bridge[l].Over[A,hs i].LocH.kill-in (c i))))
    (kills c i) (Bridge[l].Over[A,hs i].index-eq (Bridge[l].Over[A,hs i].LocH.kill-in (c i)))
    (Sp.power-above (hs i) (Bridge[l].Over[A,hs i].index (Bridge[l].Over[A,hs i].LocH.kill-in (c i)))) ;
  -- if D h_i <= D t_i for all i, then D g <= D(t), and g is in the radical of (t)
  refines (t : Fin n -> R) (le : (i : Fin n) -> O.Le (D (hs i)) (D (t i))) : O.Le (D g) (cls (n,t)) =
   O.le-trans (D g) (J.bigJ n (\ i -> D (hs i))) (cls (n,t)) covers
    (Pr.subst lattice.L (\ w -> O.Le (J.bigJ n (\ i -> D (hs i))) w) (J.bigJ n (\ i -> D (t i))) (cls (n,t))
      (sym (generated (n,t)))
      (J.least n (\ i -> D (hs i)) (J.bigJ n (\ i -> D (t i)))
        (\ i -> O.le-trans (D (hs i)) (D (t i)) (J.bigJ n (\ i -> D (t i))) (le i) (J.below n (\ i -> D (t i)) i)))) ;
  radical-of (t : Fin n -> R) (le : (i : Fin n) -> O.Le (D (hs i)) (D (t i))) : InRad (n,t) g =
   reflect (single g) (n,t) (refines t le) (inr tt) ;
  radical {y : R} (c : Killers y) : InRad (n,kills c) g = radical-of (kills c) (le-kill c) ;

  -- y g^p = sum t_i (y c_i) = 0
  annihilated {y : R} (c : Killers y) (r : RadData (n,kills c) g) : Id R (mul y (power g (rad-power r))) z = calc R {
   mul y (power g (rad-power r)) =< ap (mul y) (sym (rad-equation r)) > mul y (Sm.lin n (kills c) (rad-coefficients r))
    =< sym (Sm.lin-scale n (kills c) (rad-coefficients r) y) > Sm.lin n (kills c) (\ i -> mul y ((rad-coefficients r) i))
    =< Sm.sum-cong n (\ i -> mul (kills c i) (mul y ((rad-coefficients r) i))) (\ i -> z)
        (\ i -> trans (mulA (kills c i) y ((rad-coefficients r) i))
          (trans (ap (\ t -> mul t ((rad-coefficients r) i)) (Bridge[l].Over[A,hs i].LocH.kill-eq (c i))) (zero-mul ((rad-coefficients r) i))))
     > Sm.sum n (\ i -> z)
    =< Sm.sum-zero n > z } ;
  -- f_g(y) = 0, then x = 0
  image-y-zero (y : R) (k : Nat) (e : Id R (mul y (power g k)) z) : Id (Loc g).R (map (f g) y) (Loc g).z =
   RL[Loc g].unit-reg (map (f g) (power g k)) (map (f g) y) (BG.LocH.inverts (el g) (power g k) (k,refl (power g k)))
    (calc (Loc g).R {
     (Loc g).mul (map (f g) (power g k)) (map (f g) y) =< sym (map-mul (f g) (power g k) y) > map (f g) (mul (power g k) y)
      =< ap (map (f g)) (trans (mulC (power g k) y) e) > map (f g) z
      =< map-zero (f g) > (Loc g).z }) ;
  x-zero (x : (Loc g).R) (p : BG.LocH.Fraction (Loc g) (f g) x)
   (fy : Id (Loc g).R (map (f g) (BG.LocH.num p)) (Loc g).z) : Id (Loc g).R x (Loc g).z =
   RL[Loc g].unit-reg (map (f g) (BG.LocH.den p)) x (BG.LocH.inverts (el g) (BG.LocH.den p) (BG.LocH.den-in p))
    (trans (BG.LocH.eqn p) fy) ;

  separated (x : (Loc g).R) (zero : (i : Fin n) -> Id (Loc (hs i)).R (map (rho-i i) x) (Loc (hs i)).z) :
   Id (Loc g).R x (Loc g).z =
   Tr.Trunc[BG.LocH.Fraction (Loc g) (f g) x].induction @l (\ t -> Id (Loc g).R x (Loc g).z) (\ t -> set g _ _)
    (\ p -> Tr.Trunc[Killers (BG.LocH.num p)].induction @l (\ t -> Id (Loc g).R x (Loc g).z) (\ t -> set g _ _)
      (\ c -> Tr.Trunc[RadData (n,kills c) g].induction @l (\ t -> Id (Loc g).R x (Loc g).z) (\ t -> set g _ _)
        (\ r -> x-zero x p (image-y-zero (BG.LocH.num p) (rad-power r) (annihilated c r)))
        (radical c))
      (killers x p zero))
    (BG.LocH.fractions (el g) x) ;
  -- the rho_i are jointly injective
  injective (x x' : (Loc g).R) (e : (i : Fin n) -> Id (Loc (hs i)).R (map (rho-i i) x) (map (rho-i i) x')) :
   Id (Loc g).R x x' =
   Regularity[l].Over[Loc g].difference x x' (separated ((Loc g).add x ((Loc g).neg x')) (\ i -> calc (Loc (hs i)).R {
    map (rho-i i) ((Loc g).add x ((Loc g).neg x'))
     =< map-add (rho-i i) x ((Loc g).neg x') > (Loc (hs i)).add (map (rho-i i) x) (map (rho-i i) ((Loc g).neg x'))
     =< ap ((Loc (hs i)).add (map (rho-i i) x)) (map-neg (rho-i i) x')
      > (Loc (hs i)).add (map (rho-i i) x) ((Loc (hs i)).neg (map (rho-i i) x'))
     =< ap (\ t -> (Loc (hs i)).add t ((Loc (hs i)).neg (map (rho-i i) x'))) (e i)
      > (Loc (hs i)).add (map (rho-i i) x') ((Loc (hs i)).neg (map (rho-i i) x'))
     =< (Loc (hs i)).addN (map (rho-i i) x') > (Loc (hs i)).z })) ;
 } ;

 -- D h = D k: rho_{h,k} is injective
 module Single (h k : R) (kh : O.Le (D k) (D h)) (hk : O.Le (D h) (D k)) {
  one-covers : O.Le (D h) (J.bigJ (suc zero) (\ i -> D k)) =
   O.le-trans (D h) (D k) (lattice.join (D k) lattice.bot) hk (O.join-left (D k) lattice.bot) ;
  module C = Cover[h,suc zero,\ i -> k,\ i -> kh,one-covers] ;
  injective (x x' : (Loc h).R) (e : Id (Loc k).R (map (S.rho h k kh) x) (map (S.rho h k kh) x')) : Id (Loc h).R x x' =
   C.injective x x' (\ i -> e) ;
 } ;
} ;
