-- The structures moved to QCoh(Spec A) along Mod(A) = QCoh(Spec A)
-- (SerreQCohEquivalence.equality), on arrows.
-- Arrows with their ends are points of Arr X = (x y : X.ob) * X.hom x y.
-- Transport of arrows along the identification is the functor
-- u |-> u~ = on-arrows u (FibreCategorySIPArrows.On.arrows for the Serre
-- equivalence): the arrow moved along it (SerreQCohObjects.moved), with
-- its moved ends, is (M~, N~, u~).  Hence (FibreCategoryTransportArrows
-- .Equivalent), for the EXISTING structures (same identification):
-- (a) the cokernel in qcoh-cokernels of u~ : M~ -> N~ (literally of
--     on-arrows u, at on-objects M, on-objects N) has object (coker u)~
--     and projection (coker projection)~;
-- (b) the tensor of qcoh-monoidal on arrows: u~ (x) v~ = (u (x) v)~ over
--     M~ (x) M'~ = (M (x) M')~, N~ (x) N'~ = (N (x) N')~ (naturality of
--     the object identification of SerreQCohObjects.tensor); the
--     associator of qcoh-monoidal at (M~, N~, P~) is the module
--     associator a~, and the unitors at M~ are l~, r~: the functor ~ is
--     strict monoidal up to the object identifications.
level l ; open Base ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module QE = SerreQCohEquivalence[l].Over[A,setA] ;
 module Ar = FibreCategorySIPArrows[l+] ;
 module TA = FibreCategoryTransportArrows[l+] ;
 module EQ = TA.Equivalent[QE.Modules.category,QE.QCoh.category,QE.fibre-equivalence] ;
 module QO = SerreQCohObjects[l].Over[A,setA] ;
 module TM = SerreTensorMonoidal[l].Over[A,setA] ;
 module MA = SerreModuleAbelian[l].Over[A,setA] ;
 module QM = SerreQCohMonoidal[l].Over[A,setA] ;
 module QA = SerreQCohAbelian[l].Over[A,setA] ;
 Arr : U l+ = Ar.Arr QE.QCoh.precategory ;
 -- u~ with its ends
 image (M N : QE.Mod) (u : QE.Modules.precategory.hom M N) : Arr = (QE.on-objects M,(QE.on-objects N,QE.on-arrows M N u)) ;
 -- arrows move as u |-> u~
 transport (M N : QE.Mod) (u : QE.Modules.precategory.hom M N) :
  Id Arr (Ar.arrC QE.Modules.category QE.QCoh.category QE.equality (M,(N,u))) (image M N u) =
  EQ.EA.arrows M N u ;
 arrows (M N : QE.Mod) (u : QE.Modules.precategory.hom M N) :
  Id Arr (QO.EQ.A.ob M,(QO.EQ.A.ob N,QO.moved M N u)) (image M N u) =
  EQ.arrows M N u ;
 -- (a) the cokernel of u~ is (coker u)~, with projection (coker projection)~
 module Coker (M N : QE.Mod) (u : QE.Modules.precategory.hom M N) {
  module CK = MA.Coker[M,N,u] ;
  projection : Id Arr (TA.Ops[QE.QCoh.category].Cok[QA.qcoh-cokernels].projection (image M N u))
   (image N CK.object CK.CK.projection) =
   EQ.Coker[(MA.zero,MA.cokernels)].projection M N u ;
  object : Id QE.QCoh.precategory.ob (QA.qcoh-cokernels.2 (QE.on-objects M) (QE.on-objects N) (QE.on-arrows M N u)).1
   (QE.on-objects CK.object) =
   EQ.Coker[(MA.zero,MA.cokernels)].object M N u ;
 } ;
 -- (b) the tensor on arrows, the associator and the unitors
 module MD = TA.Ops[QE.QCoh.category].Mon[QM.qcoh-monoidal] ;
 tmap (M N : QE.Mod) (u : QE.Modules.precategory.hom M N) (M' N' : QE.Mod) (v : QE.Modules.precategory.hom M' N') :
  Id Arr (MD.tmap (image M N u) (image M' N' v)) (image (TM.tensor M M') (TM.tensor N N') (TM.tmap M N M' N' u v)) =
  EQ.M[TM.monoidal].tmap M N u M' N' v ;
 associator (M N P : QE.Mod) :
  Id Arr (MD.associator (QE.on-objects M) (QE.on-objects N) (QE.on-objects P))
   (image (TM.tensor (TM.tensor M N) P) (TM.tensor M (TM.tensor N P)) (TM.associator M N P).1) =
  EQ.M[TM.monoidal].associator M N P ;
 left-unitor (M : QE.Mod) :
  Id Arr (MD.left-unitor QM.qcoh-monoidal.unit (QE.on-objects M) (QM.qcoh-monoidal.left-unitor (QE.on-objects M)))
   (image (TM.tensor TM.unit M) M (TM.left-unitor M).1) =
  EQ.M[TM.monoidal].left-unitor M ;
 right-unitor (M : QE.Mod) :
  Id Arr (MD.right-unitor QM.qcoh-monoidal.unit (QE.on-objects M) (QM.qcoh-monoidal.right-unitor (QE.on-objects M)))
   (image (TM.tensor M TM.unit) M (TM.monoidal.right-unitor M).1) =
  EQ.M[TM.monoidal].right-unitor M ;
} ;
