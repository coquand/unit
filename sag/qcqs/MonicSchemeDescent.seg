-- External descent along A -> A[t]/g for a positive-degree monic g.
-- Use the constant coordinate of the monic basis and transport the
-- coordinate-model descent theorem to the actual presented quotient.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module EQ = AffineCoverEqualiser[l] ;
module CF = AffineCoverFamily[l] ;
module L = MonicAlgebra ;
module Q = FunctorialQcqs[l] ;
module Over (A : T.Test) (constant : A.ring.R) (higher : List A.ring.R) {
 module M = L.MonicTraceBasis[l].Over[A.ring,A.carrier-set,cons constant higher] ;
 S : Algebras[l].Over[A.ring,A.carrier-set].Algebra = M.M.A ;
 last : Fin M.M.d = inr tt ;
 module Pos = M.M.B.Positive[len higher,refl (suc (len higher))] ;
 unit-coordinate : Id A.ring.R (M.basis.coordinate S.ring.o last) A.ring.o =
  trans (ap (\ a -> M.basis.coordinate a last) (sym (map-one S.iota))) (Pos.coords-constant A.ring.o last) ;
 module D = FiniteFreeSchemeDescent[l].Over[A,S,M.M.d,M.basis,last,unit-coordinate] ;
 base : D.BP.Algebra = (A,RH.identity A.ring) ;
 module C = D.At[base] ;
 B : T.Test = new T.Test[S.ring,S.set] ;
 overlap : T.Test = C.overlap ;
 inclusion : RH.Hom A.ring B.ring = S.iota ;
 model : RH.Hom B.ring C.X.B.ring = C.X.X.pure-hom ;
 from-base : D.C.KA.Hom C.X.Aalg S = (S.iota,\ a -> refl (S.iota.1 a)) ;
 module Eval = L.FiniteBasisEvaluation[l].Over[A.ring,A.carrier-set,S,C.X.Aalg,M.M.d,M.basis]
  .At[S,D.C.KA.identity S,from-base] ;
 to-quotient : RH.Hom C.X.B.ring B.ring = Eval.hom.1 ;
 quotient-model : Id (RH.Hom B.ring B.ring) (CF.Comp B C.X.B B to-quotient model) (RH.identity B.ring) =
  RH.Properties[B.ring,B.ring,B.carrier-set].ext _ _ Eval.value-pure ;
 scalar (a : A.ring.R) : Id C.X.B.ring.R (model.1 (inclusion.1 a)) (C.X.inclusion.1 a) = C.X.X.scalar-commutes a ;
 scalar-map : Id (RH.Hom A.ring C.X.B.ring) (CF.Comp A B C.X.B model inclusion) C.X.inclusion =
  RH.Properties[A.ring,C.X.B.ring,C.X.B.carrier-set].ext _ _ scalar ;
 module ModelInverse = C.X.Maps[C.X.B,CF.Comp C.X.B B C.X.B model to-quotient,RH.identity C.X.B.ring,
  (\ a -> trans (ap model.1 (Eval.value-scalar a)) (scalar a)),
  (\ i -> trans (ap (\ v -> model.1 (to-quotient.1 v)) (sym (C.X.X.pure-basis i)))
   (trans (ap model.1 (Eval.value-pure (M.basis.vector i))) (C.X.X.pure-basis i)))] ;
 model-quotient : Id (RH.Hom C.X.B.ring C.X.B.ring) (CF.Comp C.X.B B C.X.B model to-quotient) (RH.identity C.X.B.ring) = ModelInverse.equal ;
 left : RH.Hom B.ring overlap.ring = CF.Comp B C.X.B overlap C.diagram.left model ;
 right : RH.Hom B.ring overlap.ring = CF.Comp B C.X.B overlap C.diagram.right model ;
 commute : Id (RH.Hom A.ring overlap.ring) (CF.Comp A B overlap left inclusion) (CF.Comp A B overlap right inclusion) =
  RH.Properties[A.ring,overlap.ring,overlap.carrier-set].ext _ _ (\ a ->
   trans (ap C.diagram.left.1 (scalar a))
    (trans (ap (\ f -> f.1 a) C.diagram.commute) (ap C.diagram.right.1 (sym (scalar a))))) ;
 -- The displayed overlap is the coproduct of the two copies of B over A.
 module Cocone (T' : T.Test) (p q : RH.Hom B.ring T'.ring)
  (eq : Id (RH.Hom A.ring T'.ring) (CF.Comp A B T' p inclusion) (CF.Comp A B T' q inclusion)) {
  p-model : RH.Hom C.X.B.ring T'.ring = CF.Comp C.X.B B T' p to-quotient ;
  q-model : RH.Hom C.X.B.ring T'.ring = CF.Comp C.X.B B T' q to-quotient ;
  eq-model : Id (RH.Hom A.ring T'.ring) (CF.Comp A C.X.B T' p-model C.X.inclusion)
   (CF.Comp A C.X.B T' q-model C.X.inclusion) = RH.Properties[A.ring,T'.ring,T'.carrier-set].ext _ _ (\ a ->
   trans (ap p.1 (Eval.value-scalar a)) (trans (ap (\ f -> f.1 a) eq) (ap q.1 (sym (Eval.value-scalar a))))) ;
  module P = C.Cocone[T',p-model,q-model,eq-model] ;
  map-out : RH.Hom overlap.ring T'.ring = P.Factor.map-out ;
  on-left : Id (RH.Hom B.ring T'.ring) (CF.Comp B overlap T' map-out left) p =
   RH.Properties[B.ring,T'.ring,T'.carrier-set].ext _ _ (\ b ->
    trans (ap (\ f -> f.1 (model.1 b)) P.Factor.left) (ap (\ f -> p.1 (f.1 b)) quotient-model)) ;
  on-right : Id (RH.Hom B.ring T'.ring) (CF.Comp B overlap T' map-out right) q =
   RH.Properties[B.ring,T'.ring,T'.carrier-set].ext _ _ (\ b ->
    trans (ap (\ f -> f.1 (model.1 b)) P.Factor.right) (ap (\ f -> q.1 (f.1 b)) quotient-model)) ;
  unique (k : RH.Hom overlap.ring T'.ring)
   (p-eq : Id (RH.Hom B.ring T'.ring) (CF.Comp B overlap T' k left) p)
   (q-eq : Id (RH.Hom B.ring T'.ring) (CF.Comp B overlap T' k right) q) : Id (RH.Hom overlap.ring T'.ring) k map-out =
   P.unique k
    (RH.Properties[C.X.B.ring,T'.ring,T'.carrier-set].ext _ _ (\ v ->
     trans (ap (\ f -> k.1 (C.diagram.left.1 (f.1 v))) (sym model-quotient))
      (ap (\ f -> f.1 (to-quotient.1 v)) p-eq)))
    (RH.Properties[C.X.B.ring,T'.ring,T'.carrier-set].ext _ _ (\ v ->
     trans (ap (\ f -> k.1 (C.diagram.right.1 (f.1 v))) (sym model-quotient))
      (ap (\ f -> f.1 (to-quotient.1 v)) q-eq))) ;
 } ;
 module Scheme (F : SF.SetFunctor) (qcqs : Q.Over[F].IsQcqs) {
  module N = D.Scheme[F,qcqs,base] ;
  restrict : F.obj A -> F.obj B = F.reindex A B inclusion ;
  Compatible (y : F.obj B) : U l = Id (F.obj overlap) (F.reindex B overlap left y) (F.reindex B overlap right y) ;
  restrict-compatible (x : F.obj A) : Compatible (restrict x) =
   trans (sym (F.composition A B overlap inclusion left x))
    (trans (ap (\ f -> F.reindex A overlap f x) commute) (F.composition A B overlap inclusion right x)) ;
  Lifts (y : F.obj B) : U l = (x : F.obj A) * Id (F.obj B) (restrict x) y ;
  image : F.obj B -> F.obj C.X.B = F.reindex B C.X.B model ;
  back : F.obj C.X.B -> F.obj B = F.reindex C.X.B B to-quotient ;
  back-image (y : F.obj B) : Id (F.obj B) (back (image y)) y =
   trans (sym (F.composition B C.X.B B model to-quotient y))
    (trans (ap (\ h -> F.reindex B B h y) quotient-model) (F.identity B y)) ;
  compares (x : F.obj A) : Id (F.obj C.X.B) (N.E.restrict x) (image (restrict x)) =
   trans (ap (\ h -> F.reindex A C.X.B h x) (sym scalar-map)) (F.composition A B C.X.B inclusion model x) ;
  module On (y : F.obj B) (compatible : Compatible y) {
   compatible-image : N.E.Compatible (image y) =
    trans (sym (F.composition B C.X.B overlap model C.diagram.left y))
     (trans compatible (F.composition B C.X.B overlap model C.diagram.right y)) ;
   module Lift = N.On[image y,compatible-image] ;
   from-model (p : N.E.Lifts (image y)) : Lifts y = (p.1,
    trans (sym (back-image (restrict p.1)))
     (trans (ap back (trans (sym (compares p.1)) p.2)) (back-image y))) ;
   to-model (p : Lifts y) : N.E.Lifts (image y) = (p.1,trans (compares p.1) (ap image p.2)) ;
   centre : Lifts y = from-model Lift.descend.1 ;
   unique (p : Lifts y) : Id (Lifts y) centre p = Pr.Sigma-eq (F.obj A) (\ x -> Id (F.obj B) (restrict x) y)
    centre.1 p.1 centre.2 p.2 (ap (\ t -> t.1) (Lift.descend.2 (to-model p))) (F.set B (restrict p.1) y) ;
   descend : Localisation[l].isContr (Lifts y) = (centre,unique) ;
  } ;
 } ;
 module Geometric (X : Spaces[l].Space) (qcqs : Qcqs[l].Over[X.lattice,X.structure].IsQcqs) {
  module G = GeometricAtlas[l].Over[X] ;
  module Descent = Scheme[G.F.functor,G.qcqs qcqs] ;
  descend (y : G.F.functor.obj B) (e : Descent.Compatible y) : Localisation[l].isContr (Descent.Lifts y) = Descent.On[y,e].descend ;
 } ;
} ;
