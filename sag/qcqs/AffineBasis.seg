-- Compact opens of an affine locally ringed lattice have finite affine
-- covers, merely given (functor-of-points note, affine-refinement lemma).
-- For affine X the canonical lattice map Zar(Gamma X) -> M is bijective.
-- Lift u along it and take a merely given presentation by D(a_i).
-- The images of the D(a_i) cover u, since the lattice map preserves joins.
-- Each image is affine: the isomorphism X -> Spec Gamma X restricts to an
-- isomorphism on that basic open (SliceIso), the basic open is affine
-- (SpecBasicOpen), and affineness transfers across isomorphisms
-- (AffineTransport).  Eliminate the presentation only into mere existence.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module DL = DistLattice[l] ;
module Over (M : DL.DLat) (X : LocallyRinged[l].On[M].LocallyRinged) {
 module O = DL.Order[M] ;
 module J = DL.Joins[M] ;
 module Q = Qcqs[l].Over[M,X] ;
 Cover (u : M.L) : U l = sig {
  count : Nat ;
  opens : Fin count -> M.L ;
  below : (i : Fin count) -> O.Le (opens i) u ;
  covers : Id M.L (J.bigJ count opens) u ;
  affine : (i : Fin count) -> Q.AffineOpen (opens i)
 } ;
 Merely (u : M.L) : U l = Tr.Trunc[Cover u].carrier ;
 merely-prop (u : M.L) : Pr.isProp (Merely u) = Tr.Trunc[Cover u].proposition ;
 module FromAffine (affineX : AffineCriterion[l].Over[M,X].IsAffine) {
  module AX = AffineCriterion[l].Over[M,X] ;
  module Families = Radical[l].Over[X.sheaf.ring M.top] ;
  module P = DL.JoinMaps[AX.ZG.lattice,M,AX.canonical.lat] ;
  preimage (u : M.L) : AX.ZG.lattice.L = (AX.I.lat-equiv {AX.canonical} affineX).sec u ;
  preimage-eq (u : M.L) : Id M.L (DL.hmap AX.canonical.lat (preimage u)) u = (AX.I.lat-equiv {AX.canonical} affineX).sec-eq u ;
  module Basic (a : (X.sheaf.ring M.top).R) {
   module S = SliceIso[l].Over[AX.ZG.lattice,M,AX.GX.spec,X,AX.canonical,affineX,AX.ZG.D a] ;
   module B = SpecBasicOpen[l].Over[X.sheaf.ring M.top,X.sheaf.ring-set M.top,a] ;
   affine : Q.AffineOpen (DL.hmap AX.canonical.lat (AX.ZG.D a)) =
    AffineTransport[l].Over[S.SY.lattice,S.SX.lattice,S.SY.restricted,S.SX.restricted,S.S.morphism,S.restricted-iso,B.affine].affine ;
  } ;
  module Presented (u : M.L) (p : AX.ZG.Presentation (preimage u)) {
   opens (i : Fin (Families.size (AX.ZG.generators p))) : M.L =
    DL.hmap AX.canonical.lat (AX.ZG.D (Families.gen (AX.ZG.generators p) i)) ;
   below (i : Fin (Families.size (AX.ZG.generators p))) : O.Le (opens i) u =
    O.le-trans (opens i) (DL.hmap AX.canonical.lat (preimage u)) u
     (P.monotone (AX.ZG.D (Families.gen (AX.ZG.generators p) i)) (preimage u) (AX.ZG.gen-below p i))
     (O.le-of-eq (DL.hmap AX.canonical.lat (preimage u)) u (preimage-eq u)) ;
   covers : Id M.L (J.bigJ (Families.size (AX.ZG.generators p)) opens) u =
    trans (sym (P.preserves (Families.size (AX.ZG.generators p)) (\ i -> AX.ZG.D (Families.gen (AX.ZG.generators p) i))))
     (trans (ap (DL.hmap AX.canonical.lat) (sym (AX.ZG.presents p))) (preimage-eq u)) ;
   cover : Cover u = struct {
    count = Families.size (AX.ZG.generators p) ; opens = opens ; below = below ; covers = covers ;
    affine = \ i -> Basic[Families.gen (AX.ZG.generators p) i].affine } ;
  } ;
  refined (u : M.L) : Merely u =
   Tr.Trunc[AX.ZG.Presentation (preimage u)].induction @l (\ t -> Merely u) (\ t -> merely-prop u)
    (\ p -> Tr.Trunc[Cover u].inc Presented[u,p].cover) (AX.ZG.presented (preimage u)) ;
 } ;
} ;
