-- Compact opens of a qcqs space are detected by affine probes.
-- Assume p*(u)=p*(v) for every p:Spec A->X.  On an actual affine chart
-- e_i, take its canonical isomorphism c_i:X|e_i->Spec Gamma(X|e_i)
-- and inverse v_i.  The probe inclusion_i v_i sends the assumed equality
-- to equality of v_i*(cut_i u) and v_i*(cut_i v).  Its lattice map is
-- bijective, so cut_i u=cut_i v.  Taking underlying opens gives
-- u /\ e_i=v /\ e_i.  LatticeCover gives u=v.  Eliminate a merely
-- existing affine atlas into this equality, a proposition.  This proves
-- injectivity of the geometric compact-open classifier without resizing.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Hi = Prelude[l+] ;
module Tr = Truncation[l] ;
module DL = DistLattice[l] ;
module Sp = Spaces[l] ;
module T = AffineTests[l] ;
module Op = OpenMaps[l] ;
module Over (X : Sp.Space) {
 module Q = Qcqs[l].Over[X.lattice,X.structure] ;
 module Compare (u v : X.lattice.L)
  (on : (A : T.Test) (p : Sp.Hom (T.space A) X) -> Id (T.space A).lattice.L
   (DL.hmap (Sp.underlying p).lat u) (DL.hmap (Sp.underlying p).lat v)) {
  module FromCover (c : Q.AffineCover) {
   module Part (i : Fin c.count) {
    module Sl = Op.At[X,c.opens i].Sl ;
    module AS = AffineSource[l].FromAffine[Op.space X (c.opens i),X,c.affine i] ;
    module V = Sp.InvertMap[Op.space X (c.opens i),T.space AS.test,AS.canonical,AS.canonical-iso] ;
    module LI = Iso[l].Maps[Sl.lattice,(T.space AS.test).lattice,Sl.sheaf,(T.space AS.test).structure.sheaf] ;
    probe : Sp.Hom (T.space AS.test) X =
     Sp.compose (T.space AS.test) (Op.space X (c.opens i)) X (Op.inclusion X (c.opens i)) V.inverse ;
    equality : Id X.lattice.L (X.lattice.meet u (c.opens i)) (X.lattice.meet v (c.opens i)) =
     ap Sl.inc (Iso[l].injective Sl.Opens (T.space AS.test).lattice.L (DL.hmap (Sp.underlying V.inverse).lat)
      (LI.lat-equiv {Sp.underlying V.inverse} V.inverse-iso) (Sl.cut u) (Sl.cut v) (on AS.test probe)) ;
   } ;
   cover-le : DL.Order[X.lattice].Le X.lattice.top (DL.Joins[X.lattice].bigJ c.count c.opens) =
    DL.Order[X.lattice].le-of-eq _ _ (sym c.covers) ;
   equality : Id X.lattice.L u v = LatticeCover[l].Over[X.lattice,c.count,c.opens,cover-le].ext u v (\ i -> Part[i].equality) ;
  } ;
  equal (qcqs : Q.IsQcqs) : Id X.lattice.L u v =
   Tr.Trunc[Q.AffineCover].induction @l (\ c -> Id X.lattice.L u v) (\ c -> X.lattice.setL u v)
    (\ c -> FromCover[c].equality) qcqs ;
 } ;
} ;
