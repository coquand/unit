-- Interchanging two compact opens preserves their realised intersection
-- and its underlying point.  Use identity on F, with membership taken
-- both ways by commutativity of meet, then RealisationTransfer.
level l ; open Ring[l] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module TE = TestEquivalences[l] ;
module CO = CompactOpens[l] ;
module Over (F : SF.SetFunctor) (u v : CO.Over[F].Open) {
 module C = CO.Over[F] ;
 module R = RealisationTransfer[l].Over[F,F,C.meet u v,C.meet v u,TE.identity F].Given[
  \ B x m -> trans (T.At[B].Z.lattice.meetC (C.value v B x) (C.value u B x)) m,
  \ B x m -> trans (T.At[B].Z.lattice.meetC (C.value u B x) (C.value v B x)) m] ;
 trace (B : T.Test) (p : OpenRealisation[l].Over[F,C.meet u v].obj B) : Id (F.obj B)
  (OpenRealisation[l].Over[F,C.meet v u].point {B}
   (SF.Transform[OpenRealisation[l].Over[F,C.meet u v].functor,OpenRealisation[l].Over[F,C.meet v u].functor].at (TE.forward R.equivalence) B p))
  (OpenRealisation[l].Over[F,C.meet u v].point {B} p) = R.forward-point B p ;
} ;
