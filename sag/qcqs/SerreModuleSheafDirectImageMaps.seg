-- Direct image carries natural linear maps and equivalences to such maps.
-- On an open a, use the original component at pi(a). Restricting scalars
-- preserves its linearity, and naturality is the original naturality
-- square. Pointwise equivalences therefore remain equivalences.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module DL = DistLattice[l] ;
module MM = SerreModuleMaps[l] ; module MS = SerreModuleSheaf[l] ;
module DI = SerreModuleSheafDirectImage[l] ;
module Over (L K : DL.DLat) (F : RingedLattice[l].On[L].Presheaf)
 (G : RingedLattice[l].On[K].Presheaf) (pi : LocallyRinged[l].Maps[L,K,F,G].Ringed)
 (E N : MS.On[K,G].ModuleSheaf) {
 module Source = DI.Over[L,K,F,G,pi,E] ;
 module Target = DI.Over[L,K,F,G,pi,N] ;
 module Original = MS.On[K,G].Transform[E.presheaf,N.presheaf] ;
 module Maps = MS.On[L,F].Transform[Source.presheaf,Target.presheaf] ;
 module Of (q : Original.Hom) {
  component (a : L.L) : MM.Between[F.ring a,F.ring a,RingHom[l].identity (F.ring a),
   Source.At[a].Scalars.restricted,Target.At[a].Scalars.restricted].Hom =
   new MM.Between[F.ring a,F.ring a,RingHom[l].identity (F.ring a),
    Source.At[a].Scalars.restricted,Target.At[a].Scalars.restricted].Hom[
    Original.at q (Source.p a),Original.at-add q (Source.p a),
    \ r x -> trans (ap (Original.at q (Source.p a)) (Source.At[a].Scalars.scalar-at r x))
     (trans (Original.at-scale q (Source.p a) (RingMaps[l].map (pi.sharp a) r) x)
      (sym (Target.At[a].Scalars.scalar-at r (Original.at q (Source.p a) x))))] ;
  induced : Maps.Hom = new Maps.Hom[component,\ a b k x -> q.natural (Source.p a) (Source.p b) (Source.mono a b k) x] ;
  induced-at (a : L.L) (x : (E.presheaf.module-at (Source.p a)).M) :
   Id (N.presheaf.module-at (Source.p a)).M (Maps.at induced a x) (Original.at q (Source.p a) x) =
   refl (Original.at q (Source.p a) x) ;
  opaque induced ;
 } ;
 module Equivalence (e : SerreModuleSheafIso[l].On[K,G].Equivalence E.presheaf N.presheaf) {
  module OriginalIso = SerreModuleSheafIso[l].On[K,G] ;
  module Map = Of[OriginalIso.forward e] ;
  equivalence : SerreModuleSheafIso[l].On[L,F].Equivalence Source.presheaf Target.presheaf =
   (Map.induced,\ a -> Iso[l].equiv-homotopy
    (E.presheaf.module-at (Source.p a)).M (N.presheaf.module-at (Source.p a)).M
    (Original.at (OriginalIso.forward e) (Source.p a)) (Maps.at Map.induced a)
    (\ x -> sym (Map.induced-at a x)) (OriginalIso.equiv-at e (Source.p a))) ;
 } ;
} ;
