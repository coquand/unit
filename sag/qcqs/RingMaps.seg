-- The parts of a ring map phi : A -> B (RingHom.Hom), named once: its
-- underlying map and its three preservation laws.
level l ; open Ring[l] ;
module RH = RingHom[l] ;
map {A B : CRing} (phi : RH.Hom A B) : A.R -> B.R = phi.1 ;
map-one {A B : CRing} (phi : RH.Hom A B) : Id B.R (map phi A.o) B.o = phi.2.1 ;
map-add {A B : CRing} (phi : RH.Hom A B) (a b : A.R) :
 Id B.R (map phi (A.add a b)) (B.add (map phi a) (map phi b)) = phi.2.2.1 a b ;
map-mul {A B : CRing} (phi : RH.Hom A B) (a b : A.R) :
 Id B.R (map phi (A.mul a b)) (B.mul (map phi a) (map phi b)) = phi.2.2.2 a b ;
-- and the two consequences: phi(0) = 0, phi(-a) = -phi(a)
map-zero {A B : CRing} (phi : RH.Hom A B) : Id B.R (map phi A.z) B.z = RH.zero A B phi ;
map-neg {A B : CRing} (phi : RH.Hom A B) (a : A.R) : Id B.R (map phi (A.neg a)) (B.neg (map phi a)) =
 RH.negation A B phi a ;
-- the maps of the identity and of a composite, by definition
map-identity {A : CRing} (a : A.R) : Id A.R (map (RH.identity A) a) a = refl a ;
map-compose {A B C : CRing} (phi : RH.Hom B C) (psi : RH.Hom A B) (a : A.R) :
 Id C.R (map (RH.compose A B C phi psi) a) (map phi (map psi a)) = refl (map phi (map psi a)) ;
