-- Powers of a unit-ideal family (Serre note, Section 3).
-- D(f_i) lies below D(f_i^r), for every r, so a family covering top
-- continues to cover after taking powers.  The formal Nullstellensatz
-- puts 1 in the radical of these powers.  A power of 1 is 1 itself,
-- giving actual ideal coefficients, merely.  No positive-exponent or
-- nonempty-family hypothesis is needed for this stronger statement.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (A : CRing) {
 module P = AffinePowers[l].Over[A] ;
 module R = Radical[l].Over[A] ;
 module FL = FamilyLattice[l].Over[A] ;
 module Z = ZariskiLattice[l].Over[A] ;
 module S = FiniteIdeal[l].Sums[A] ;
 module SP = Z.Sup.Of[Z.D,Z.support] ;
 power-one : (r : Nat) -> Id A.R (P.power A.o r) A.o = split {
  zero -> refl A.o ;
  suc r | ih -> trans (ap (A.mul A.o) ih) (A.mulO A.o) } ;
 module Family (n : Nat) (fs : Fin n -> A.R)
  (covers : Z.O.Le Z.lattice.top (Z.J.bigJ n (\ i -> Z.D (fs i)))) {
  powers (r : Nat) : Fin n -> A.R = \ i -> P.power (fs i) r ;
  powers-at (r : Nat) (i : Fin n) : Id A.R (powers r i) (P.power (fs i) r) = refl (P.power (fs i) r) ;
  powered-cover (r : Nat) : Z.O.Le Z.lattice.top (Z.cls (n,powers r)) =
   Z.O.le-trans Z.lattice.top (Z.J.bigJ n (\ i -> Z.D (fs i))) (Z.cls (n,powers r)) covers
    (Z.O.le-trans (Z.J.bigJ n (\ i -> Z.D (fs i))) (Z.J.bigJ n (\ i -> Z.D (powers r i))) (Z.cls (n,powers r))
     (Z.J.least n (\ i -> Z.D (fs i)) (Z.J.bigJ n (\ i -> Z.D (powers r i)))
      (\ i -> Z.O.le-trans (Z.D (fs i)) (Z.D (powers r i)) (Z.J.bigJ n (\ j -> Z.D (powers r j)))
       (SP.power-above (fs i) r) (Z.J.below n (\ j -> Z.D (powers r j)) i)))
     (Z.O.le-of-eq (Z.J.bigJ n (\ i -> Z.D (powers r i))) (Z.cls (n,powers r)) (sym (Z.generated (n,powers r))))) ;
  radical-one (r : Nat) : R.InRad (n,powers r) A.o =
   Z.reflect (FL.single A.o) (n,powers r)
    (Z.O.le-trans (Z.D A.o) Z.lattice.top (Z.cls (n,powers r))
     (Z.O.le-of-eq (Z.D A.o) Z.lattice.top SP.at-one) (powered-cover r)) (inr tt) ;
  coefficients (r : Nat) : Tr.Trunc[R.InIdeal (n,powers r) A.o].carrier =
   Tr.Trunc[R.RadData (n,powers r) A.o].induction @l
    (\ t -> Tr.Trunc[R.InIdeal (n,powers r) A.o].carrier)
    (\ t -> Tr.Trunc[R.InIdeal (n,powers r) A.o].proposition)
    (\ d -> Tr.Trunc[R.InIdeal (n,powers r) A.o].inc
     (R.rad-coefficients d,trans (R.rad-equation d) (power-one (R.rad-power d))))
    (radical-one r) ;
  opaque powers ;
 } ;
} ;
