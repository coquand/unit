-- Geometric qcqs over k gives intrinsic native relative qcqs (§5).
-- Totalisation of its relative points is naturally h_X, by the existing
-- canonical-lift equivalence.  GeometricAtlas gives absolute qcqs for
-- h_X; transfer it across that equivalence and apply the already proved
-- converse totalisation theorem.  Both sheafhood and atlas are intrinsic
-- on the algebra tests in the resulting statement.
level l ; open Ring[l] ;
module T = AffineTests[l] ;
module SP = Spaces[l] ;
module SF = TestFunctors[l] ;
module Over (K : T.Test) (X : SP.Space) (s : SP.Hom X (T.space K)) (q : Qcqs[l].Over[X.lattice,X.structure].IsQcqs) {
 module G = RelativeGeometric[l].Over[K,X,s] ;
 qcqs : RelativeQcqs[l].Over[K].At[G.functor].IsQcqs = RelativeQcqsOfTotal[l].Over[K,G.functor].qcqs
  (FunctorialTransfer[l].Over[G.TF.functor,SF.Geometric[X].functor,G.equivalence].qcqs (GeometricAtlas[l].Over[X].qcqs q)) ;
} ;
