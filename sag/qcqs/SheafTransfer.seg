-- The Zariski sheaf property transfers across a natural equivalence F -> G.
-- Send a compatible F-family to G using its components; naturality makes
-- it compatible.  Glue in G and take the inverse image under the bijective
-- component at the base ring.  For matching, apply the injective forward
-- component, then naturality, the inverse equation and matching in G.
-- Two F-amalgams map to G-amalgams; G-uniqueness and injectivity identify
-- them.  Matching laws are propositions.  This includes empty covers.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module SF = TestFunctors[l] ;
module TE = TestEquivalences[l] ;
module TS = TestSheaves[l] ;
module Over (F G : SF.SetFunctor) (e : TE.NaturalEquivalence F G) (sheaf : TS.IsSheaf G) {
 module N = SF.Transform[F,G] ;
 module OnCover (c : TS.CoverData) {
  module D = TS.OnCover[F,c].D ;
  module CF = D.For[F] ;
  module CG = D.For[G] ;
  module Family (xs : CF.Values) (compatible : CF.Compatible xs) {
   ys : CG.Values = \ i -> N.at (TE.forward e) (D.basic i) (xs i) ;
   compatible-G : CG.Compatible ys = \ i j ->
    trans (sym (N.natural (TE.forward e) (D.basic i) (D.double i j) (D.left i j) (xs i)))
     (trans (ap (N.at (TE.forward e) (D.double i j)) (compatible i j))
      (N.natural (TE.forward e) (D.basic j) (D.double i j) (D.right i j) (xs j))) ;
   amalgams : Localisation[l].isContr (CG.Amalgam ys) = sheaf c ys compatible-G ;
   value : F.obj (TS.base c) = (TE.equiv-at e (TS.base c)).sec amalgams.1.1 ;
   matching (i : Fin (TS.count c)) : Id (F.obj (D.basic i)) (F.reindex (TS.base c) (D.basic i) (D.AB.inclusion (TS.generators c i)) value) (xs i) =
    Iso[l].injective (F.obj (D.basic i)) (G.obj (D.basic i)) (N.at (TE.forward e) (D.basic i)) (TE.equiv-at e (D.basic i))
     (F.reindex (TS.base c) (D.basic i) (D.AB.inclusion (TS.generators c i)) value) (xs i)
     (trans (N.natural (TE.forward e) (TS.base c) (D.basic i) (D.AB.inclusion (TS.generators c i)) value)
      (trans (ap (G.reindex (TS.base c) (D.basic i) (D.AB.inclusion (TS.generators c i))) ((TE.equiv-at e (TS.base c)).sec-eq amalgams.1.1))
       (amalgams.1.2 i))) ;
   amalgam : CF.Amalgam xs = (value,matching) ;
   candidate (p : CF.Amalgam xs) : CG.Amalgam ys = (N.at (TE.forward e) (TS.base c) p.1,\ i ->
    trans (sym (N.natural (TE.forward e) (TS.base c) (D.basic i) (D.AB.inclusion (TS.generators c i)) p.1))
     (ap (N.at (TE.forward e) (D.basic i)) (p.2 i))) ;
   unique (p : CF.Amalgam xs) : Id (CF.Amalgam xs) amalgam p =
    Pr.Sigma-eq (F.obj (TS.base c)) (CF.Matches xs) value p.1 matching p.2
     (Iso[l].injective (F.obj (TS.base c)) (G.obj (TS.base c)) (N.at (TE.forward e) (TS.base c)) (TE.equiv-at e (TS.base c)) value p.1
      (trans ((TE.equiv-at e (TS.base c)).sec-eq amalgams.1.1) (ap (\ a -> a.1) (amalgams.2 (candidate p))))) (CF.matches-prop xs p.1) ;
   gluing : Localisation[l].isContr (CF.Amalgam xs) = (amalgam,unique) ;
  } ;
 } ;
 is-sheaf : TS.IsSheaf F = \ c xs k -> OnCover[c].Family[xs,k].gluing ;
} ;
