-- The universal property of D : A -> L_A (DESIGN.md, step 2): for every
-- distributive lattice M and support d : A -> M there is a unique lattice
-- map h : L_A -> M with h(D x) = d x.
--
-- Proof.  For a family a put e(a) = d(a_n) \/ .. \/ d(a_1).
--  e is monotone: if a <= b, each a_i has a power a_i^k = sum v_j b_j, so
--  d(a_i) <= d(a_i^k) <= d(b_1) \/ .. \/ d(b_m) = e(b).  Hence e descends
--  to h : L_A -> M with h[a] = e(a).
--  h is a lattice map.  h(bottom) = e() = bot; h(top) = d 1 \/ bot = top;
--  e(a ++ b) = e(a) \/ e(b): <= since each generator of a ++ b is one of a
--  or of b, >= by monotonicity (a, b <= a ++ b); e(a * b) = e(a) /\ e(b):
--  <= by monotonicity (a * b <= a, b), >= since e(a) /\ e(b) is below the
--  join of the d(a_i) /\ d(b_j) = d(b_j a_i), generators of a * b.
--  h(D x) = d x \/ bot = d x.
--  Uniqueness: if k is a lattice map with k(D x) = d x, then
--  k[a] = k(D a_n \/ .. \/ D a_1) = d(a_n) \/ .. \/ d(a_1) = h[a].
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module DL = DistLattice[l] ;
module Over (A : CRing) (M : DL.DLat) (d : A.R -> M.L) (sd : DL.Supports[A,M].Support d) {
 open A ;
 open Radical[l].Over[A] ;
 open FamilyLattice[l].Over[A] ;
 open ZariskiLattice[l].Over[A] ;
 module MO = DL.Order[M] ;
 module MJ = DL.Joins[M] ;
 module Sd = DL.Supports[A,M].Of[d,sd] ;

 -- e(a), the join of the d(a_i)
 dsup (a : Fam) : M.L = MJ.bigJ (size a) (\ i -> d (gen a i)) ;
 dsup-gen (a : Fam) (i : Fin (size a)) : MO.Le (d (gen a i)) (dsup a) = MJ.below (size a) (\ j -> d (gen a j)) i ;

 -- monotonicity
 rad-below (b : Fam) (x : R) (h : RadData b x) : MO.Le (d x) (dsup b) =
  MO.le-trans (d x) (d (power x h.1)) (dsup b) (Sd.power-above x h.1)
   (Pr.subst R (\ t -> MO.Le (d t) (dsup b)) (S.lin (size b) (gen b) h.2.1) (power x h.1) h.2.2
     (Sd.lin-below (size b) (gen b) h.2.1)) ;
 in-rad-below (b : Fam) (x : R) (h : InRad b x) : MO.Le (d x) (dsup b) =
  Tr.Trunc[RadData b x].induction @l (\ t -> MO.Le (d x) (dsup b)) (\ t -> MO.le-prop (d x) (dsup b))
   (rad-below b x) h ;
 mono (a b : Fam) (h : Le a b) : MO.Le (dsup a) (dsup b) =
  MJ.least (size a) (\ i -> d (gen a i)) (dsup b) (\ i -> in-rad-below b (gen a i) (h i)) ;

 -- e on joins and meets of families
 dsup-cat (a b : Fam) : Id M.L (dsup (cat a b)) (M.join (dsup a) (dsup b)) =
  MO.le-antisym (dsup (cat a b)) (M.join (dsup a) (dsup b))
   (MJ.least (size (cat a b)) (\ i -> d (gen (cat a b) i)) (M.join (dsup a) (dsup b))
     (cat-all a b (\ y -> MO.Le (d y) (M.join (dsup a) (dsup b)))
       (\ i -> MO.le-trans (d (gen a i)) (dsup a) (M.join (dsup a) (dsup b)) (dsup-gen a i) (MO.join-left (dsup a) (dsup b)))
       (\ j -> MO.le-trans (d (gen b j)) (dsup b) (M.join (dsup a) (dsup b)) (dsup-gen b j) (MO.join-right (dsup a) (dsup b)))))
   (MO.join-lub (dsup a) (dsup b) (dsup (cat a b))
     (mono a (cat a b) (le-cat-left a b)) (mono b (cat a b) (le-cat-right a b))) ;
 dsup-prod (a b : Fam) : Id M.L (dsup (prod a b)) (M.meet (dsup a) (dsup b)) =
  MO.le-antisym (dsup (prod a b)) (M.meet (dsup a) (dsup b))
   (MO.meet-glb (dsup a) (dsup b) (dsup (prod a b))
     (mono (prod a b) a (le-prod-left a b)) (mono (prod a b) b (le-prod-right a b)))
   (MJ.meet-joins (size a) (\ i -> d (gen a i)) (size b) (\ j -> d (gen b j)) (dsup (prod a b))
     (\ i j -> Pr.subst M.L (\ t -> MO.Le t (dsup (prod a b)))
       (d (mul (gen b j) (gen a i))) (M.meet (d (gen a i)) (d (gen b j)))
       (trans (Sd.at-mul (gen b j) (gen a i)) (M.meetC (d (gen b j)) (d (gen a i))))
       (prod-has a b (\ y -> MO.Le (d y) (dsup (prod a b))) (dsup-gen (prod a b)) i j))) ;

 -- the factorisation h
 module H = Q.Descend[M.L,M.setL,dsup,
   \ a b k -> MO.le-antisym (dsup a) (dsup b) (mono a b k.1) (mono b a k.2)] ;
 factor-bot : Id M.L (H.map lattice.bot) M.bot = H.beta empty ;
 factor-top : Id M.L (H.map lattice.top) M.top = trans (H.beta unitF) (trans (M.joinB (d o)) Sd.at-one) ;
 factor-join : (x y : lattice.L) -> Id M.L (H.map (lattice.join x y)) (M.join (H.map x) (H.map y)) =
  forall2 (\ x y -> Id M.L (H.map (lattice.join x y)) (M.join (H.map x) (H.map y))) (\ x y -> M.setL _ _)
   (\ a b -> calc M.L {
     H.map (lattice.join (cls a) (cls b)) =< ap H.map (join-cls a b) > H.map (cls (cat a b))
      =< H.beta (cat a b) > dsup (cat a b)
      =< dsup-cat a b > M.join (dsup a) (dsup b)
      =< sym (cong2 M.L M.join _ _ _ _ (H.beta a) (H.beta b)) > M.join (H.map (cls a)) (H.map (cls b)) }) ;
 factor-meet : (x y : lattice.L) -> Id M.L (H.map (lattice.meet x y)) (M.meet (H.map x) (H.map y)) =
  forall2 (\ x y -> Id M.L (H.map (lattice.meet x y)) (M.meet (H.map x) (H.map y))) (\ x y -> M.setL _ _)
   (\ a b -> calc M.L {
     H.map (lattice.meet (cls a) (cls b)) =< ap H.map (meet-cls a b) > H.map (cls (prod a b))
      =< H.beta (prod a b) > dsup (prod a b)
      =< dsup-prod a b > M.meet (dsup a) (dsup b)
      =< sym (cong2 M.L M.meet _ _ _ _ (H.beta a) (H.beta b)) > M.meet (H.map (cls a)) (H.map (cls b)) }) ;
 factor : DL.Hom lattice M = (H.map,factor-bot,factor-top,factor-join,factor-meet) ;
 opaque H.map ;
 factor-cls (a : Fam) : Id M.L (DL.hmap factor (cls a)) (dsup a) = H.beta a ;
 factor-D (x : R) : Id M.L (DL.hmap factor (D x)) (d x) = trans (factor-cls (single x)) (M.joinB (d x)) ;

 -- uniqueness
 unique (k : DL.Hom lattice M) (e : (x : R) -> Id M.L (DL.hmap k (D x)) (d x)) :
  (y : lattice.L) -> Id M.L (DL.hmap k y) (DL.hmap factor y) =
  forall1 (\ y -> Id M.L (DL.hmap k y) (DL.hmap factor y)) (\ y -> M.setL _ _)
   (\ a -> calc M.L {
     DL.hmap k (cls a) =< ap (DL.hmap k) (generated a) > DL.hmap k (J.bigJ (size a) (\ i -> D (gen a i)))
      =< DL.JoinMaps[lattice,M,k].preserves (size a) (\ i -> D (gen a i))
       > MJ.bigJ (size a) (\ i -> DL.hmap k (D (gen a i)))
      =< ap (MJ.bigJ (size a)) (F.funext (Fin (size a)) (\ i -> M.L)
       (\ i -> DL.hmap k (D (gen a i))) (\ i -> d (gen a i)) (\ i -> e (gen a i))) > dsup a
      =< sym (factor-cls a) > DL.hmap factor (cls a) }) ;
} ;
