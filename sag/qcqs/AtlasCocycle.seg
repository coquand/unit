-- Cocycles on the identified triple domains (informal proof and review:
-- unit/doc/functorial-schemes.tex, restricted cocycle subsection).
-- Put q=t_jk(d_ji)=d_ki meet d_kj.  Restrict h_jk to X_k|q and
-- factor through Y_ij by OpenFactor.  The direct map is h_ik restricted
-- along q<=d_ki.  The factorisation triangles and transition traces
-- give the same F-point on every affine probe.  The final chart detects
-- equality, since the triple source is a compact open of an affine.
level l ; open Ring[l] ; open Presentations[l] ;
module DL = DistLattice[l] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module TE = TestEquivalences[l] ;
module CO = CompactOpens[l] ;
module SP = Spaces[l] ;
module Op = OpenMaps[l] ;
module Over (F : SF.SetFunctor) (n : Nat) (us : Fin n -> CO.Over[F].Open)
 (as : Fin n -> T.Test)
 (es : (i : Fin n) -> TE.NaturalEquivalence SF.Representable[as i].functor OpenRealisation[l].Over[F,us i].functor) {
 module D = AtlasData[l].Over[F,n,us,as,es] ;
 module Triple (i j k : Fin n) {
  module O = DL.Order[(D.X k).lattice] ;
  q : (D.X k).lattice.L = D.t j k (D.d j i) ;
  qj : O.Le q (D.d k j) = D.below j k (D.d j i) ;
  qi : O.Le q (D.d k i) = O.le-trans _ _ _
   (O.le-of-eq _ _ D.Domain[i,j,k].equation) (O.meet-left (D.d k i) (D.d k j)) ;
  Z : SP.Space = Op.space (D.X k) q ;
  module SQ = Op.At[D.X k,q].Sl ;
  module A = OpenFactor[l].Over[D.X k,D.X j,D.d k j,q,D.h j k,qj,D.d j i,O.le-refl q] ;
  module B = Op.Below[D.X k,q,D.d k i,qi] ;
  module P = SP.Composite[Z,Op.space (D.X j) (D.d j i),D.X i,D.h i j,A.factor] ;
  module Q = B.Pull[D.X i,D.h i k] ;
  module Probe (C : T.Test) (p : SP.Hom (T.space C) Z) {
   a : SP.Hom (T.space C) (Op.space (D.X j) (D.d j i)) =
    SP.compose (T.space C) Z (Op.space (D.X j) (D.d j i)) A.factor p ;
   b : SP.Hom (T.space C) (Op.space (D.X k) (D.d k i)) =
    SP.compose (T.space C) Z (Op.space (D.X k) (D.d k i)) B.embedding p ;
   c : SP.Hom (T.space C) (Op.space (D.X k) (D.d k j)) =
    SP.compose (T.space C) Z (Op.space (D.X k) (D.d k j)) A.B.embedding p ;
   first : Id (F.obj C) (D.point i C (SP.compose (T.space C) Z (D.X i) P.composite p))
    (D.point j C (SP.compose (T.space C) (Op.space (D.X j) (D.d j i)) (D.X j) (Op.inclusion (D.X j) (D.d j i)) a)) =
    trans (ap (D.point i C) (sym SP.Associativity[T.space C,Z,Op.space (D.X j) (D.d j i),D.X i,D.h i j,A.factor,p].assoc))
     (D.trace i j C a) ;
   middle : Id (SP.Hom (T.space C) (D.X j))
    (SP.compose (T.space C) (Op.space (D.X j) (D.d j i)) (D.X j) (Op.inclusion (D.X j) (D.d j i)) a)
    (SP.compose (T.space C) (Op.space (D.X k) (D.d k j)) (D.X j) (D.h j k) c) =
    trans SP.Associativity[T.space C,Z,Op.space (D.X j) (D.d j i),D.X j,Op.inclusion (D.X j) (D.d j i),A.factor,p].assoc
     (trans (ap (\ f -> SP.compose (T.space C) Z (D.X j) f p) A.triangle)
      (sym SP.Associativity[T.space C,Z,Op.space (D.X k) (D.d k j),D.X j,D.h j k,A.B.embedding,p].assoc)) ;
   first-to-base : Id (F.obj C) (D.point i C (SP.compose (T.space C) Z (D.X i) P.composite p))
    (D.point k C (SP.compose (T.space C) Z (D.X k) (Op.inclusion (D.X k) q) p)) =
    trans first (trans (ap (D.point j C) middle)
     (trans (D.trace j k C c) (ap (D.point k C)
      (trans SP.Associativity[T.space C,Z,Op.space (D.X k) (D.d k j),D.X k,Op.inclusion (D.X k) (D.d k j),A.B.embedding,p].assoc
       (ap (\ f -> SP.compose (T.space C) Z (D.X k) f p) A.B.triangle))))) ;
   second-to-base : Id (F.obj C) (D.point i C (SP.compose (T.space C) Z (D.X i) Q.C.composite p))
    (D.point k C (SP.compose (T.space C) Z (D.X k) (Op.inclusion (D.X k) q) p)) =
    trans (ap (D.point i C) (sym SP.Associativity[T.space C,Z,Op.space (D.X k) (D.d k i),D.X i,D.h i k,B.embedding,p].assoc))
     (trans (D.trace i k C b) (ap (D.point k C)
      (trans SP.Associativity[T.space C,Z,Op.space (D.X k) (D.d k i),D.X k,Op.inclusion (D.X k) (D.d k i),B.embedding,p].assoc
       (ap (\ f -> SP.compose (T.space C) Z (D.X k) f p) B.triangle)))) ;
  } ;
  qcqs : Qcqs[l].Over[Z.lattice,Z.structure].IsQcqs =
   SliceQcqs[l].Over[(D.X k).lattice,(D.X k).structure,q].qcqs (AffineQcqs[l].TestSpace[as k].qcqs) ;
  equation : Id (SP.Hom Z (D.X i)) P.composite Q.C.composite =
   D.Entry[i].C.Maps[Z,P.composite,Q.C.composite,\ C p ->
    trans Probe[C,p].first-to-base (sym Probe[C,p].second-to-base)].equal qcqs ;
 } ;
} ;
