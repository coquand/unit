-- Localisation descent through a finite sheaf equaliser (Serre §4).
-- Write a sheaf equaliser as an injective exact pair M -> P -> Q,
-- where P and Q will be the finite products on members and overlaps.
-- Suppose the analogous target injection N -> P' -> Q' has zero
-- composite and the comparisons P_f -> P', Q_f -> Q' are equivalences.
-- For a commuting comparison M_f -> N, injectivity follows from that of
-- M_f -> P_f and the member comparison. For y in N, pull its image in
-- P' back to P_f. Its image in Q_f is zero by the overlap comparison,
-- so localised exactness lifts it to M_f. Target injectivity identifies
-- the resulting image with y. Mere lifts determine the unique inverse.
-- This is a generic commuting-diagram theorem, not an assertion that
-- unconstructed chart or scalar-change comparisons exist.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module LE = SerreModuleLocalisationExact[l] ;
module Over (A : CRing) (M P Q N P2 Q2 : SM.Over[A].Module)
 (e : MM.Between[A,A,RingHom[l].identity A,M,P].Hom)
 (d : MM.Between[A,A,RingHom[l].identity A,P,Q].Hom)
 (i : MM.Between[A,A,RingHom[l].identity A,N,P2].Hom)
 (j : MM.Between[A,A,RingHom[l].identity A,P2,Q2].Hom) (f : A.R) {
 module E = MM.Between[A,A,RingHom[l].identity A,M,P] ;
 module I = MM.Between[A,A,RingHom[l].identity A,N,P2] ;
 module J = MM.Between[A,A,RingHom[l].identity A,P2,Q2] ;
 module Exact = LE.Pair[A,M,P,Q,e,d,f] ;
 module LocalE = Exact.DL ; module LocalD = Exact.QL ;
 module SourceInjective (injective : (x y : M.M) -> Id P.M (E.map e x) (E.map e y) -> Id M.M x y) {
  same-fractions (x y : M.M) (p : Nat)
   (same : Id LocalE.T.L.Carrier
    (LocalE.Maps.map LocalE.induced (LocalE.S.L.fraction x p))
    (LocalE.Maps.map LocalE.induced (LocalE.S.L.fraction y p))) :
   Id LocalE.S.L.Carrier (LocalE.S.L.fraction x p) (LocalE.S.L.fraction y p) =
   Tr.Trunc[LocalE.T.L.Witness (E.map e x,p) (E.map e y,p)].induction @l
    (\ w -> Id LocalE.S.L.Carrier (LocalE.S.L.fraction x p) (LocalE.S.L.fraction y p))
    (\ w -> LocalE.S.L.carrier-set _ _)
    (\ w -> LocalE.S.L.equal x y p p (Tr.Trunc[LocalE.S.L.Witness (x,p) (y,p)].inc
     (w.1,injective _ _
      (trans (LocalE.Map.power-map (plus w.1 p) x)
       (trans w.2 (sym (LocalE.Map.power-map (plus w.1 p) y)))))))
    (LocalE.T.L.detect (E.map e x) (E.map e y) p p
     (trans (sym (LocalE.induced-at x p)) (trans same (LocalE.induced-at y p)))) ;
  equation (x y : LocalE.S.L.Carrier) :
   Id LocalE.T.L.Carrier (LocalE.Maps.map LocalE.induced x) (LocalE.Maps.map LocalE.induced y) -> Id LocalE.S.L.Carrier x y =
   LocalE.S.L.pair-induction
    (\ x y -> Id LocalE.T.L.Carrier (LocalE.Maps.map LocalE.induced x) (LocalE.Maps.map LocalE.induced y) -> Id LocalE.S.L.Carrier x y)
    (\ x y -> FE.isProp-Pi (Id LocalE.T.L.Carrier (LocalE.Maps.map LocalE.induced x) (LocalE.Maps.map LocalE.induced y))
     (\ h -> Id LocalE.S.L.Carrier x y) (\ h -> LocalE.S.L.carrier-set _ _)) same-fractions x y ;
 } ;
 module Compare
  (lambda : MM.Between[A,A,RingHom[l].identity A,LocalE.S.localised,N].Hom)
  (alpha : MM.Between[A,A,RingHom[l].identity A,LocalE.T.localised,P2].Hom)
  (beta : MM.Between[A,A,RingHom[l].identity A,LocalD.T.localised,Q2].Hom) {
  module Lambda = MM.Between[A,A,RingHom[l].identity A,LocalE.S.localised,N] ;
  module Alpha = MM.Between[A,A,RingHom[l].identity A,LocalE.T.localised,P2] ;
  module Beta = MM.Between[A,A,RingHom[l].identity A,LocalD.T.localised,Q2] ;
  module Diagram
   (source-injective : (x y : M.M) -> Id P.M (E.map e x) (E.map e y) -> Id M.M x y)
   (source-exact : Exact.Exact)
   (target-injective : (x y : N.M) -> Id P2.M (I.map i x) (I.map i y) -> Id N.M x y)
   (target-zero : (y : N.M) -> Id Q2.M (J.map j (I.map i y)) Q2.mz)
   (alpha-equiv : Pr.isEquiv LocalE.T.L.Carrier P2.M (Alpha.map alpha))
   (beta-equiv : Pr.isEquiv LocalD.T.L.Carrier Q2.M (Beta.map beta))
   (left : (x : LocalE.S.L.Carrier) -> Id P2.M
    (Alpha.map alpha (LocalE.Maps.map LocalE.induced x)) (I.map i (Lambda.map lambda x)))
   (right : (x : LocalE.T.L.Carrier) -> Id Q2.M
    (Beta.map beta (LocalD.Maps.map LocalD.induced x)) (J.map j (Alpha.map alpha x))) {
   module Source = SourceInjective[source-injective] ;
   module Test = SerreModuleMapExact[l].Over[A,LocalE.S.localised,N,lambda] ;
   injective (x y : LocalE.S.L.Carrier) (h : Id N.M (Lambda.map lambda x) (Lambda.map lambda y)) : Id LocalE.S.L.Carrier x y =
    Source.equation x y (Iso[l].injective LocalE.T.L.Carrier P2.M (Alpha.map alpha) alpha-equiv _ _
     (trans (left x) (trans (ap (I.map i) h) (sym (left y))))) ;
   module At (y : N.M) {
    member : LocalE.T.L.Carrier = alpha-equiv.sec (I.map i y) ;
    member-equation : Id P2.M (Alpha.map alpha member) (I.map i y) = alpha-equiv.sec-eq (I.map i y) ;
    zero : Id LocalD.T.L.Carrier (LocalD.Maps.map LocalD.induced member) LocalD.T.Action.mz =
     Iso[l].injective LocalD.T.L.Carrier Q2.M (Beta.map beta) beta-equiv _ _
      (trans (right member)
       (trans (ap (J.map j) member-equation) (trans (target-zero y) (sym (Beta.map-zero beta))))) ;
    lifted : Tr.Trunc[Test.Fibre y].carrier =
     Tr.Trunc[(x : LocalE.S.L.Carrier) * Id LocalE.T.L.Carrier (LocalE.Maps.map LocalE.induced x) member].induction @l
      (\ t -> Tr.Trunc[Test.Fibre y].carrier) (\ t -> Tr.Trunc[Test.Fibre y].proposition)
      (\ w -> Tr.Trunc[Test.Fibre y].inc
       (w.1,target-injective _ _
        (trans (sym (left w.1)) (trans (ap (Alpha.map alpha) w.2) member-equation))))
      (Exact.exact source-exact member zero) ;
   } ;
   kernel-zero : Test.KernelZero = \ x h -> injective x LocalE.S.Action.mz
    (trans h (sym (Lambda.map-zero lambda))) ;
   module Inverse = Test.Equivalence[kernel-zero,\ y -> At[y].lifted] ;
   equivalence : Pr.isEquiv LocalE.S.L.Carrier N.M (Lambda.map lambda) = Inverse.equivalent ;
  } ;
 } ;
} ;
