-- Stacks Project, Lemma 15.119.2 (tag 0B8I), for any commutative set-ring.
-- Finite principal local freeness of rank one, equivalence of the
-- tensoring endofunctor, and existence of a tensor inverse are equivalent.
-- Any tensor inverse is canonically the linear dual by its pairing.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l+] ;
module SM = SerreModule[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module I = SerreInvertibleModule[l].Over[A,setA] ;
 module T = SerreTensorEndofunctor[l].Over[A,setA] ;
 module MC = T.MC ; module LF = I.LF ; module S = SM.Over[A] ;
 module At (M : S.Module) {
  module F = T.Tensoring[M] ; module E = I.Eval[M] ;
  LocallyFreeRankOne : U l = LF.LocallyFree M ;
  Invertible : U l+ = T.IsEquivalence F.functor ;
  HasTensorInverse : U l+ = I.HasTensorInverse M ;
  module GivenInverse (w : I.TensorInverseData M) {
   N : S.Module = w.1 ;
   module A0 = I.Given[M,N,w.2] ;
   module G = T.Tensoring[N] ;
   module MN = T.Contract[M,N,MC.FromEquiv[I.IM.At[M,N].T.tensor,T.R,w.2.1,w.2.2].iso] ;
   module NM = T.Contract[N,M,MC.FromEquiv[A0.Swap.MN.T.tensor,T.R,A0.inverse-op.1,A0.inverse-op.2].iso] ;
   quasi-inverse : T.QuasiInverse[F.functor] = new T.QuasiInverse[F.functor,
    G.functor,\ X -> MN.At[X].iso,\ X -> NM.At[X].iso,
    \ X Y f -> MN.Naturality[X,Y,f].natural,\ X Y f -> NM.Naturality[X,Y,f].natural] ;
   dual : T.C.Iso N A0.D.space = MC.FromEquiv[N,A0.D.space,A0.E.dual-map,A0.dual-equiv].iso ;
   dual-evaluation (y : N.M) (x : M.M) :
    Id A.R ((dual.1.fn y).fn x) (w.2.1.fn (I.IM.At[M,N].T.pure x y)) =
    refl (w.2.1.fn (I.IM.At[M,N].T.pure x y)) ;
  } ;
  evaluation-is-equivalence (h : LocallyFreeRankOne) : E.EvalEquiv = E.equiv h ;
  canonical-quasi-inverse (h : LocallyFreeRankOne) : T.QuasiInverse[F.functor] =
   GivenInverse[(E.D.space,E.E.Ev.lift,evaluation-is-equivalence h)].quasi-inverse ;
  locally-free-to-tensor-inverse (h : LocallyFreeRankOne) : HasTensorInverse = E.has-inverse h ;
  tensor-inverse-to-locally-free (h : HasTensorInverse) : LocallyFreeRankOne = I.from-inverse M h ;
  tensor-inverse-to-invertible (h : HasTensorInverse) : Invertible =
   Tr.Trunc[I.TensorInverseData M].induction @(l+) (\ w -> Invertible)
    (\ w -> Tr.Trunc[T.QuasiInverse[F.functor]].proposition)
    (\ w -> Tr.Trunc[T.QuasiInverse[F.functor]].inc GivenInverse[w].quasi-inverse) h ;
  module FromFunctor (q : T.QuasiInverse[F.functor]) {
   N : S.Module = q.inverse.obj T.R ;
   witness : I.TensorInverseData M = (N,(q.counit T.R).1,MC.underlying (F.obj N) T.R (q.counit T.R)) ;
  } ;
  invertible-to-tensor-inverse (h : Invertible) : HasTensorInverse =
   Tr.Trunc[T.QuasiInverse[F.functor]].induction @(l+) (\ q -> HasTensorInverse)
    (\ q -> Tr.Trunc[I.TensorInverseData M].proposition)
    (\ q -> Tr.Trunc[I.TensorInverseData M].inc FromFunctor[q].witness) h ;
  record EquivalentConditions {
   local-to-inverse : LocallyFreeRankOne -> HasTensorInverse ;
   inverse-to-local : HasTensorInverse -> LocallyFreeRankOne ;
   inverse-to-functor : HasTensorInverse -> Invertible ;
   functor-to-inverse : Invertible -> HasTensorInverse ;
  } ;
  theorem : EquivalentConditions = new EquivalentConditions[
   locally-free-to-tensor-inverse,tensor-inverse-to-locally-free,tensor-inverse-to-invertible,invertible-to-tensor-inverse] ;
 } ;
} ;
