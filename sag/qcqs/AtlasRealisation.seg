-- Reconstruct F from an actual finite affine atlas.
-- Invert the original chart equivalence and follow beta_i into the
-- realised geometric chart.  These are local natural equivalences.
-- Their forward maps preserve the original chart point and have the
-- geometric point equation beta_i.  The component inverse laws give
-- the same equations for their inverses.  AtlasCompatibility compares
-- the two chart lifts on each overlap, in both directions.
-- LocalFunctorIso glues the local equivalences.  Its sheaf hypotheses
-- are the assumed sheafhood of F and GeometricSheaf for the glued X.
-- The qcqs conclusion is the affine-input conclusion of finite gluing.
level l ; open Ring[l] ; open Presentations[l] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module TE = TestEquivalences[l] ;
module CO = CompactOpens[l] ;
module SP = Spaces[l] ;
module Over (F : SF.SetFunctor) (sheaf : TestSheaves[l].IsSheaf F)
 (n : Nat) (us : Fin n -> CO.Over[F].Open)
 (covers : (B : T.Test) (x : F.obj B) -> Id T.At[B].Z.lattice.L
  (T.At[B].Z.J.bigJ n (\ i -> CO.Over[F].value (us i) B x)) T.At[B].Z.lattice.top)
 (as : Fin n -> T.Test)
 (es : (i : Fin n) -> TE.NaturalEquivalence SF.Representable[as i].functor OpenRealisation[l].Over[F,us i].functor) {
 module C = AtlasCompatibility[l].Over[F,n,us,as,es] ;
 module R = C.R ;
 module D = R.D ;
 module Glue = LocalFunctorIso[l].Over[F,R.H.functor,sheaf,GeometricSheaf[l].is-sheaf R.X,n,us,R.vs,covers,R.covers] ;
 module Part (i : Fin n) {
  module UO = R.At[i].UO ;
  module VO = R.At[i].VO.R ;
  module I = TE.Inverse[SF.Geometric[D.X i].functor,UO.functor,D.Entry[i].C.chart-equivalence] ;
  equivalence : TE.NaturalEquivalence UO.functor VO.functor =
   TE.Composite[UO.functor,SF.Geometric[D.X i].functor,VO.functor,I.inverse-equiv,R.At[i].beta].equivalence ;
  lift (B : T.Test) (x : UO.obj B) : SP.Hom (T.space B) (D.X i) = I.inverse-map B x ;
  original (B : T.Test) (x : UO.obj B) : Id (F.obj B) (D.point i B (lift B x)) (UO.point {B} x) =
   ap (UO.point {B}) (I.right-at B x) ;
  geometric (B : T.Test) (x : UO.obj B) : Id (R.H.functor.obj B)
   (VO.point {B} (SF.Transform[UO.functor,VO.functor].at (TE.forward equivalence) B x)) (R.At[i].inclusion B (lift B x)) = R.At[i].beta-point B (lift B x) ;
  opaque equivalence ;
  module E = TE.Inverse[UO.functor,VO.functor,equivalence] ;
  back-lift (B : T.Test) (y : VO.obj B) : SP.Hom (T.space B) (D.X i) = lift B (E.inverse-map B y) ;
  back-original (B : T.Test) (y : VO.obj B) : Id (F.obj B)
   (D.point i B (back-lift B y)) (UO.point {B} (E.inverse-map B y)) = original B (E.inverse-map B y) ;
  back-geometric (B : T.Test) (y : VO.obj B) : Id (R.H.functor.obj B)
   (R.At[i].inclusion B (back-lift B y)) (VO.point {B} y) =
   trans (sym (geometric B (E.inverse-map B y))) (ap (VO.point {B}) (E.right-at B y)) ;
 } ;
 module Local = Glue.Given[\ i -> Part[i].equivalence] ;
 forward-compatible : Local.FF.Compatible = \ B x i j mi mj ->
  trans (Part[i].geometric B (x,mi))
   (trans C.Compare[i,j,B,Part[i].lift B (x,mi),Part[j].lift B (x,mj)].Forward[
     trans (Part[i].original B (x,mi)) (sym (Part[j].original B (x,mj)))].equal
    (sym (Part[j].geometric B (x,mj)))) ;
 backward-compatible : Local.BB.Compatible = \ B y i j mi mj ->
  trans (sym (Part[i].back-original B (y,mi)))
   (trans C.Compare[i,j,B,Part[i].back-lift B (y,mi),Part[j].back-lift B (y,mj)].Backward[
     trans (Part[i].back-geometric B (y,mi)) (sym (Part[j].back-geometric B (y,mj)))].equal
    (Part[j].back-original B (y,mj))) ;
 equivalence : TE.NaturalEquivalence F R.H.functor = Local.Compatible[forward-compatible,backward-compatible].equivalence ;
} ;
