-- Recovering the cocycle from the canonical points of T_c (Serre §5).
-- The point on chart i has coordinate c_ik. On a pair overlap, adding
-- c_ij to the point on chart j gives the point on chart i, coordinatewise
-- by c_ij+c_jk=c_ik. Unique differences therefore recover exactly c_ij.
-- Cocycle extensionality and the specified quotient map recover c and
-- its H1 class, without changing the H1 carrier.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module DL = DistLattice[l] ;
module MS = SerreModuleSheaf[l] ;
module On (L : DL.DLat) (G : RingedLattice[l].On[L].Presheaf)
 (M : MS.On[L,G].ModuleSheaf) (n : Nat) (as : Fin n -> L.L)
 (c : SerreCechCocycles[l].On[L,G,M,n,as].Cocycle)
 (covers : DL.Order[L].Le L.top (DL.Joins[L].bigJ n as)) {
 module Local = SerreCechTorsorLocal[l].On[L,G,M,n,as,c,covers] ;
 module T = Local.T ; module Action = Local.Action ;
 module O = Local.O ; module MO = Local.MO ; module Z = Local.Z ;
 module Recovered = SerreCechTriviality[l].On[L,G,M,Local.torsor,n,as,covers,Local.local-point] ;
 module AtPoint (i : Fin n) (a : L.L) (le : O.Le a (as i)) (k : Fin n) {
  d : L.L = L.meet a (as k) ;
  restriction : O.Le d (Z.C.overlap i k) = T.ChartPush[k].Push.mono a (as i) le ;
  point : T.Fibre.Section a = T.Fibre.restrict a (as i) le (Local.local-point i) ;
  equation : Id (M.presheaf.module-at d).M (T.Fibre.value a point k)
   (MO.restrict d (Z.C.overlap i k) restriction (Z.value c i k)) =
   trans (Action.restriction-coordinate a (as i) le (Local.local-point i) k)
    (ap (MO.restrict d (Z.C.overlap i k) restriction) (ap (\ z -> z k) (Local.local-point-value i))) ;
 } ;
 module Pair (i j : Fin n) {
  a : L.L = Z.C.overlap i j ;
  left : T.Fibre.Section a = T.Fibre.restrict a (as i) (O.meet-left (as i) (as j)) (Local.local-point i) ;
  right : T.Fibre.Section a = T.Fibre.restrict a (as j) (O.meet-right (as i) (as j)) (Local.local-point j) ;
  module Coordinate (k : Fin n) {
   d : L.L = L.meet a (as k) ;
   wi : O.Le d (as i) = O.le-trans d a (as i) (O.meet-left a (as k)) (O.meet-left (as i) (as j)) ;
   wj : O.Le d (as j) = O.le-trans d a (as j) (O.meet-left a (as k)) (O.meet-right (as i) (as j)) ;
   wk : O.Le d (as k) = O.meet-right a (as k) ;
   module B = Local.Below[d,i,j,k,wi,wj,wk] ;
   module I = AtPoint[i,a,O.meet-left (as i) (as j),k] ;
   module J = AtPoint[j,a,O.meet-right (as i) (as j),k] ;
   left-eq : Id (M.presheaf.module-at d).M (T.Fibre.value a left k)
    (MO.restrict d (Z.C.overlap i k) B.ik (Z.value c i k)) =
    trans I.equation (MO.res-irr d (Z.C.overlap i k) I.restriction B.ik (Z.value c i k)) ;
   right-eq : Id (M.presheaf.module-at d).M (T.Fibre.value a right k)
    (MO.restrict d (Z.C.overlap j k) B.jk (Z.value c j k)) =
    trans J.equation (MO.res-irr d (Z.C.overlap j k) J.restriction B.jk (Z.value c j k)) ;
   scalar-eq : Id (M.presheaf.module-at d).M (Action.diagonal a (Z.value c i j) k)
    (MO.restrict d (Z.C.overlap i j) B.ij (Z.value c i j)) =
    MO.res-irr d a (O.meet-left a (as k)) B.ij (Z.value c i j) ;
   equation : Id (M.presheaf.module-at d).M
    (T.Fibre.value a (Action.action a right (Z.value c i j)) k) (T.Fibre.value a left k) =
    trans (Action.action-coordinate a right (Z.value c i j) k)
     (trans (cong2 (M.presheaf.module-at d).M (M.presheaf.module-at d).madd _ _ _ _ right-eq scalar-eq)
      (trans ((M.presheaf.module-at d).maddC
       (MO.restrict d (Z.C.overlap j k) B.jk (Z.value c j k))
       (MO.restrict d (Z.C.overlap i j) B.ij (Z.value c i j)))
       (trans B.cocycle (sym left-eq)))) ;
  } ;
  action-equation : Id (T.Fibre.Section a) (Action.action a right (Z.value c i j)) left =
   T.Fibre.ext a (Action.action a right (Z.value c i j)) left (T.E.At[a].P.ext _ _ (\ k -> Coordinate[k].equation)) ;
  cocycle-equation : Id (M.presheaf.module-at a).M (Recovered.TC.cocycle i j) (Z.value c i j) =
   Recovered.TC.TO.diff-unique a right left (Z.value c i j) action-equation ;
 } ;
 cochain-equation : Id Z.C.C1.Carrier (Z.value Recovered.cocycle) (Z.value c) =
  trans Recovered.cocycle-value (Z.C.C1.ext _ _ (\ i -> Z.C.Row[i].Product.ext _ _ (\ j -> Pair[i,j].cocycle-equation))) ;
 cocycle-equation : Id Z.Cocycle Recovered.cocycle c = Z.ext Recovered.cocycle c cochain-equation ;
 class-equation : Id Z.H1 Recovered.class (Z.class c) =
  trans Recovered.class-at (ap Z.class cocycle-equation) ;
} ;
