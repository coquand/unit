-- The lambda-criterion (Serre note, Lemma 4.2), the direction used.
-- Let w be affine, B = O(w), and suppose lambda_(w,s) : M(w)_s -> M(D_w s)
-- is an equivalence for every s in B. Then M has an affine model at w:
-- the direct image of M|w along the canonical chart Spec B -> X|w is
-- equivalent to the associated sheaf of M(w).
-- Proof. Work on the basis D(s) of Spec B; the chart sends D(s) to
--  pi(D s) = D_w(s) (SpecMap.pi-D).
--  Components. On D(s): evaluate an associated section at s (an element
--   of M(w)_s, AssociatedBasicOpen), apply the extension of restriction
--   M(w) -> M(D_w s) (which is lambda_(w,s) by uniqueness), and restrict
--   to the equal open pi(D s). Each step is bijective. It is additive.
--   It is linear over O(D s): the sharp of the chart is phi_s after
--   evaluation (Extension.extend-basic), and a B-linear map out of M(w)_s
--   is semilinear over phi_s : B_s -> O(pi D s), because phi_s(b/1) = b|
--   (SerreLambdaLocalLinear.Semilinear).
--  Naturality for D(h) <= D(s): evaluation commutes with the native
--   restriction M(w)_s -> M(w)_h (AssociatedBasicOpen.natural); both
--   composites are B-linear maps out of M(w)_s into M(pi D h), on which s
--   acts invertibly, and both send x/1 to x|pi(D h); so they agree
--   (SerreLambdaLocalLinear.Clears and SerreLambdaElementary.Agree).
--  Extension. The basis-map theorem (SerreModuleSheafBasisMap) extends the
--   components to a natural linear map; it is an equivalence because its
--   components on the basic opens of a finite presentation are
--   (SerreModuleSheafLocalEquivalence). Its inverse is the model.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module DL = DistLattice[l] ;
module RH = RingHom[l] ; module RM = RingMaps[l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ; module MS = SerreModuleSheaf[l] ;
module On (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged)
 (M : MS.On[L,X.sheaf].ModuleSheaf) (w : L.L) (affine : Qcqs[l].Over[L,X].AffineOpen w)
 (local : (s : (X.sheaf.ring w).R) -> SerreLambda[l].On[L,X,M,w].At[s].IsEquivalence) {
 module QC = SerreQuasiCoherent[l].On[L,X,M].At[w] ;
 module S = QC.S ; module R = QC.Restricted ; module AC = QC.Canonical ; module Image = QC.Image ;
 module RO = R.RO ; module SO = S.OS ;
 B : CRing = S.sheaf.ring S.lattice.top ;
 N : SM.Over[B].Module = R.restricted.presheaf.module-at S.lattice.top ;
 module Assoc = SerreAssociatedSheaf[l].Over[B,S.sheaf.ring-set S.lattice.top,N] ;
 module CanonicalMap = AC.Can.Of[RH.identity B].SM ;
 module ZO = AC.ZG.O ;
 -- the chart open of D(s), and the A-action through restriction from w
 chart-open (s : B.R) : S.Opens = DL.hmap AC.canonical.lat (AC.ZG.D s) ;
 Target (s : B.R) : SM.Over[S.sheaf.ring (chart-open s)].Module = R.restricted.presheaf.module-at (chart-open s) ;
 down (s : B.R) (b : B.R) : (S.sheaf.ring (chart-open s)).R = S.SO.restrict (chart-open s) S.lattice.top (SO.le-top (chart-open s)) b ;
 module At (s : B.R) {
  module Lam = SerreLambda[l].On[L,X,M,w].At[s] ;
  module C = Lam.C ;
  same-open : Id S.Opens (chart-open s) C.open-f = CanonicalMap.pi-D s ;
  to-open : SO.Le (chart-open s) C.open-f = SO.le-of-eq _ _ same-open ;
  from-open : SO.Le C.open-f (chart-open s) = SO.le-of-eq _ _ (sym same-open) ;
  move (y : (R.restricted.presheaf.module-at C.open-f).M) : (Target s).M = RO.restrict (chart-open s) C.open-f to-open y ;
  back (y : (Target s).M) : (R.restricted.presheaf.module-at C.open-f).M = RO.restrict C.open-f (chart-open s) from-open y ;
  move-equiv : Pr.isEquiv (R.restricted.presheaf.module-at C.open-f).M (Target s).M move =
   Pr.qinv _ _ move back
    (\ y -> trans (R.restricted.presheaf.res-comp (chart-open s) C.open-f (chart-open s) to-open from-open (SO.le-refl (chart-open s)) y)
     (R.restricted.presheaf.res-id (chart-open s) (SO.le-refl (chart-open s)) y))
    (\ y -> trans (R.restricted.presheaf.res-comp C.open-f (chart-open s) C.open-f from-open to-open (SO.le-refl C.open-f) y)
     (R.restricted.presheaf.res-id C.open-f (SO.le-refl C.open-f) y)) ;
  module LL = SerreLambdaLocalLinear[l].Over[B,S.sheaf.ring-set S.lattice.top,N,s] ;
  -- the extension of restriction is lambda
  lift (z : LL.Native.L.Carrier) : (R.restricted.presheaf.module-at C.open-f).M = C.E.To.map C.E.lift z ;
  module Canonical = C.Other[C.E.lift,\ x -> trans (C.E.extends x) (C.original-at x)] ;
  lift-equiv : Pr.isEquiv LL.Native.L.Carrier (R.restricted.presheaf.module-at C.open-f).M lift =
   Iso[l].equiv-homotopy _ _ C.map lift (\ z -> sym (Canonical.unique z)) (local s) ;
  k (z : LL.Native.L.Carrier) : (Target s).M = move (lift z) ;
  k-scale (b : B.R) (z : LL.Native.L.Carrier) :
   Id (Target s).M (k (LL.Native.localised.sm b z)) ((Target s).sm (down s b) (k z)) =
   calc (Target s).M {
    k (LL.Native.localised.sm b z)
     =< ap move (C.E.To.map-scale C.E.lift b z) > move ((R.restricted.presheaf.module-at C.open-f).sm (RM.map C.ring-map b) (lift z))
     =< RO.res-scale (chart-open s) C.open-f to-open (RM.map C.ring-map b) (lift z)
      > (Target s).sm (S.SO.restrict (chart-open s) C.open-f to-open (RM.map C.ring-map b)) (k z)
     =< ap (\ c -> (Target s).sm c (k z))
         (S.sheaf.res-comp (chart-open s) C.open-f S.lattice.top to-open C.below (SO.le-top (chart-open s)) b)
      > (Target s).sm (down s b) (k z) } ;
  -- phi_s(b/1) = b restricted
  phi-original (b : B.R) : Id (S.sheaf.ring (chart-open s)).R
   (RM.map CanonicalMap.Basic[s].phi-g (RM.map (AC.GX.inclusion s) b)) (down s b) =
   trans (CanonicalMap.Basic[s].phi-g-on b)
    (RM.map-compose (S.sheaf.res (chart-open s) S.lattice.top CanonicalMap.Basic[s].le-top) (RH.identity B) b) ;
  module Semi = LL.Semilinear[S.sheaf.ring (chart-open s),Target s,CanonicalMap.Basic[s].phi-g,k,
   \ b z -> trans (k-scale b z) (ap (\ c -> (Target s).sm c (k z)) (sym (phi-original b)))] ;
  -- evaluation at s, and the component
  module Ev = Assoc.B.At[s] ;
  Source : U l = (Assoc.associated.presheaf.module-at (AC.ZG.D s)).M ;
  evaluate (x : Source) : LL.Native.L.Carrier = Ev.Maps.map Ev.evaluation x ;
  forward (x : Source) : (Image.presheaf.module-at (AC.ZG.D s)).M = k (evaluate x) ;
  forward-equiv : Pr.isEquiv Source (Target s).M forward =
   Iso[l].equiv-compose _ _ _ k evaluate
    (Iso[l].equiv-compose _ _ _ move lift move-equiv lift-equiv) Ev.equivalence ;
  additive (x y : Source) : Id (Target s).M
   (forward ((Assoc.associated.presheaf.module-at (AC.ZG.D s)).madd x y)) ((Target s).madd (forward x) (forward y)) =
   trans (ap k (Ev.Maps.map-add Ev.evaluation x y))
    (trans (ap move (C.E.To.map-add C.E.lift (evaluate x) (evaluate y)))
     (RO.res-add (chart-open s) C.open-f to-open (lift (evaluate x)) (lift (evaluate y)))) ;
  -- the chart's sharp is phi_s after evaluation
  sharp-phi (r : (AC.Can.Sh.structure.ring (AC.ZG.D s)).R) :
   Id (S.sheaf.ring (chart-open s)).R (RM.map (AC.canonical.sharp (AC.ZG.D s)) r)
    (RM.map CanonicalMap.Basic[s].phi-g (RM.map Assoc.B.RingBasic.At[s].evaluation r)) =
   trans (CanonicalMap.E.extension-map-at (AC.ZG.D s) r)
    (trans (CanonicalMap.E.extend-basic s r)
     (ap (RM.map CanonicalMap.Basic[s].phi-g) (sym (Assoc.B.RingBasic.At[s].evaluation-map r)))) ;
  scalar (r : (AC.Can.Sh.structure.ring (AC.ZG.D s)).R) (x : Source) :
   Id (Target s).M (forward ((Assoc.associated.presheaf.module-at (AC.ZG.D s)).sm r x))
    ((Image.presheaf.module-at (AC.ZG.D s)).sm r (forward x)) =
   calc (Target s).M {
    forward ((Assoc.associated.presheaf.module-at (AC.ZG.D s)).sm r x)
     =< ap k (Ev.Maps.map-scale Ev.evaluation r x)
      > k (LL.Sc.localised.sm (RM.map Assoc.B.RingBasic.At[s].evaluation r) (evaluate x))
     =< Semi.scale (RM.map Assoc.B.RingBasic.At[s].evaluation r) (evaluate x)
      > (Target s).sm (RM.map CanonicalMap.Basic[s].phi-g (RM.map Assoc.B.RingBasic.At[s].evaluation r)) (forward x)
     =< ap (\ c -> (Target s).sm c (forward x)) (sym (sharp-phi r))
      > (Image.presheaf.module-at (AC.ZG.D s)).sm r (forward x) } ;
  module Maps = MM.Between[AC.Can.Sh.structure.ring (AC.ZG.D s),AC.Can.Sh.structure.ring (AC.ZG.D s),
   RH.identity (AC.Can.Sh.structure.ring (AC.ZG.D s)),
   Assoc.associated.presheaf.module-at (AC.ZG.D s),Image.presheaf.module-at (AC.ZG.D s)] ;
  component : Maps.Hom = new Maps.Hom[forward,additive,scalar] ;
  component-at (x : Source) : Id (Target s).M (Maps.map component x) (forward x) = refl (forward x) ;
  equivalence : Pr.isEquiv Source (Target s).M (Maps.map component) =
   Iso[l].equiv-homotopy _ _ forward (Maps.map component) (\ x -> sym (component-at x)) forward-equiv ;
  opaque component ;
 } ;
 -- naturality for D(h) <= D(s)
 module Natural (h s : B.R) (le : ZO.Le (AC.ZG.D h) (AC.ZG.D s)) {
  module Ph = At[h] ; module Ps = At[s] ;
  mono : SO.Le (chart-open h) (chart-open s) = Image.mono (AC.ZG.D h) (AC.ZG.D s) le ;
  restrict (y : (Target s).M) : (Target h).M = RO.restrict (chart-open h) (chart-open s) mono y ;
  -- M(pi D h) as a B-module, on which s acts invertibly
  Q : SM.Over[B].Module = MM.RestrictScalars[B,S.sheaf.ring (chart-open h),
   S.sheaf.res (chart-open h) S.lattice.top (SO.le-top (chart-open h))].Of[Target h].restricted ;
  below-open : SO.Le (chart-open h) Ps.C.open-f = SO.le-trans _ _ _ mono Ps.to-open ;
  unit : RL[S.sheaf.ring (chart-open h)].unit (down h s) =
   Pr.subst (S.sheaf.ring (chart-open h)).R (\ e -> RL[S.sheaf.ring (chart-open h)].unit e)
    (S.SO.restrict (chart-open h) Ps.C.open-f below-open (RM.map Ps.C.ring-map s)) (down h s)
    (S.sheaf.res-comp (chart-open h) Ps.C.open-f S.lattice.top below-open Ps.C.below (SO.le-top (chart-open h)) s)
    (AffineRing[l].unit-map (S.sheaf.ring Ps.C.open-f) (S.sheaf.ring (chart-open h))
     (S.sheaf.res (chart-open h) Ps.C.open-f below-open) (RM.map Ps.C.ring-map s) Ps.C.unit) ;
  module Act = SerreModuleBasicRestrictions[l].UnitAction[S.sheaf.ring (chart-open h),Target h,down h s,unit] ;
  invertible : Pr.isEquiv Q.M Q.M (Q.sm s) = Act.equiv ;
  module NR = Assoc.AM.R.At[s,h,le] ;
  left (z : Ps.LL.Native.L.Carrier) : (Target h).M = Ph.k (NR.map z) ;
  right (z : Ps.LL.Native.L.Carrier) : (Target h).M = restrict (Ps.k z) ;
  left-scale (b : B.R) (z : Ps.LL.Native.L.Carrier) : Id (Target h).M (left (Ps.LL.Native.localised.sm b z)) (Q.sm b (left z)) =
   trans (ap Ph.k (NR.map-scale b z)) (Ph.k-scale b (NR.map z)) ;
  right-scale (b : B.R) (z : Ps.LL.Native.L.Carrier) : Id (Target h).M (right (Ps.LL.Native.localised.sm b z)) (Q.sm b (right z)) =
   trans (ap restrict (Ps.k-scale b z))
    (trans (RO.res-scale (chart-open h) (chart-open s) mono (down s b) (Ps.k z))
     (ap (\ c -> (Target h).sm c (right z))
      (S.sheaf.res-comp (chart-open h) (chart-open s) S.lattice.top mono (SO.le-top (chart-open s)) (SO.le-top (chart-open h)) b))) ;
  -- both send x/1 to x restricted to pi(D h)
  value (x : N.M) : (Target h).M = RO.restrict (chart-open h) S.lattice.top (SO.le-top (chart-open h)) x ;
  lift-original (t : B.R) (x : N.M) : Id (R.restricted.presheaf.module-at At[t].C.open-f).M
   (At[t].lift (At[t].LL.Native.L.fraction x zero)) (RO.restrict At[t].C.open-f S.lattice.top At[t].C.below x) =
   trans (At[t].C.E.extends x) (At[t].C.original-at x) ;
  move-original (t : B.R) (x : N.M) : Id (Target t).M (At[t].k (At[t].LL.Native.L.fraction x zero))
   (RO.restrict (chart-open t) S.lattice.top (SO.le-top (chart-open t)) x) =
   trans (ap At[t].move (lift-original t x))
    (R.restricted.presheaf.res-comp (chart-open t) At[t].C.open-f S.lattice.top At[t].to-open At[t].C.below (SO.le-top (chart-open t)) x) ;
  left-value (x : N.M) : Id (Target h).M (left (Ps.LL.Native.L.fraction x zero)) (value x) =
   trans (ap Ph.k (NR.on-original x)) (move-original h x) ;
  right-value (x : N.M) : Id (Target h).M (right (Ps.LL.Native.L.fraction x zero)) (value x) =
   trans (ap restrict (move-original s x))
    (R.restricted.presheaf.res-comp (chart-open h) (chart-open s) S.lattice.top mono (SO.le-top (chart-open s)) (SO.le-top (chart-open h)) x) ;
  module LeftClears = Ps.LL.Clears[Q,left,left-scale] ;
  module RightClears = Ps.LL.Clears[Q,right,right-scale] ;
  module Same = SerreLambdaElementary[l].Agree[B,N,Q,s,invertible,value,left,right,
   \ x p -> trans (LeftClears.clears x p) (left-value x),
   \ x p -> trans (RightClears.clears x p) (right-value x)] ;
  module EO = MS.On[AC.ZG.lattice,AC.Can.Sh.structure].Of[Assoc.associated.presheaf] ;
  module FO = MS.On[AC.ZG.lattice,AC.Can.Sh.structure].Of[Image.presheaf] ;
  evaluate-natural (x : Ps.Source) : Id Ph.LL.Native.L.Carrier
   (Ph.evaluate (EO.restrict (AC.ZG.D h) (AC.ZG.D s) le x)) (NR.map (Ps.evaluate x)) =
   trans (Ph.Ev.evaluation-at (EO.restrict (AC.ZG.D h) (AC.ZG.D s) le x))
    (trans (ap Ph.Ev.eval (Assoc.S.restriction-map (AC.ZG.D h) (AC.ZG.D s) le x))
     (trans (Assoc.B.natural s h le x)
     (trans (Assoc.AM.component-restriction s h le (Ps.Ev.eval x))
      (ap NR.map (sym (Ps.Ev.evaluation-at x)))))) ;
  equation (x : Ps.Source) :
   Id (Target h).M (FO.restrict (AC.ZG.D h) (AC.ZG.D s) le (Ps.Maps.map Ps.component x))
    (Ph.Maps.map Ph.component (EO.restrict (AC.ZG.D h) (AC.ZG.D s) le x)) =
   calc (Target h).M {
    FO.restrict (AC.ZG.D h) (AC.ZG.D s) le (Ps.Maps.map Ps.component x)
     =< ap restrict (Ps.component-at x) > right (Ps.evaluate x)
     =< sym (Same.same (Ps.evaluate x)) > left (Ps.evaluate x)
     =< ap Ph.k (sym (evaluate-natural x)) > Ph.forward (EO.restrict (AC.ZG.D h) (AC.ZG.D s) le x)
     =< sym (Ph.component-at (EO.restrict (AC.ZG.D h) (AC.ZG.D s) le x))
      > Ph.Maps.map Ph.component (EO.restrict (AC.ZG.D h) (AC.ZG.D s) le x) } ;
 } ;
 -- extension from the basis of basic opens, and the model
 module Basis = SerreModuleSheafBasisMap[l].On[AC.ZG.lattice,AC.Can.Sh.structure,Assoc.associated,Image.direct-image,B.R,AC.ZG.D] ;
 module Families = Radical[l].Over[B] ;
 module Presented (u : AC.ZG.lattice.L) (p : AC.ZG.Presentation u) {
  cover : Basis.BasisCover[u] = new Basis.BasisCover[u,Families.size (AC.ZG.generators p),
   \ i -> Families.gen (AC.ZG.generators p) i,\ i -> AC.ZG.gen-below p i,ZO.le-of-eq _ _ (AC.ZG.presents p)] ;
 } ;
 basis (u : AC.ZG.lattice.L) : Tr.Trunc[Basis.BasisCover[u]].carrier =
  Tr.Trunc[AC.ZG.Presentation u].induction @l (\ p -> Tr.Trunc[Basis.BasisCover[u]].carrier)
   (\ p -> Tr.Trunc[Basis.BasisCover[u]].proposition)
   (\ p -> Tr.Trunc[Basis.BasisCover[u]].inc Presented[u,p].cover) (AC.ZG.presented u) ;
 local-maps : Basis.BasisMaps = new Basis.BasisMaps[\ s -> At[s].component,\ h s le x -> Natural[h,s,le].equation x] ;
 module Extended = Basis.Over[basis,local-maps] ;
 module Transforms = MS.On[AC.ZG.lattice,AC.Can.Sh.structure].Transform[Assoc.associated.presheaf,Image.presheaf] ;
 morphism : Transforms.Hom = Extended.morphism ;
 basic-equivalence (s : B.R) : Pr.isEquiv At[s].Source (Target s).M (Transforms.at morphism (AC.ZG.D s)) =
  Iso[l].equiv-homotopy _ _ (At[s].Maps.map At[s].component) (Transforms.at morphism (AC.ZG.D s))
   (\ x -> sym (Extended.on-basis s x)) At[s].equivalence ;
 module Local = SerreModuleSheafLocalEquivalence[l].Over[AC.ZG.lattice,AC.Can.Sh.structure,Assoc.associated,Image.direct-image,morphism] ;
 module Covered (u : AC.ZG.lattice.L) (c : Basis.BasisCover[u]) {
  cover : Local.GoodCover[u] = new Local.GoodCover[u,c.count,\ i -> AC.ZG.D (c.generators i),
   c.below,c.covers,\ i -> basic-equivalence (c.generators i)] ;
 } ;
 covering (u : AC.ZG.lattice.L) : Tr.Trunc[Local.GoodCover[u]].carrier =
  Tr.Trunc[Basis.BasisCover[u]].induction @l (\ c -> Tr.Trunc[Local.GoodCover[u]].carrier)
   (\ c -> Tr.Trunc[Local.GoodCover[u]].proposition)
   (\ c -> Tr.Trunc[Local.GoodCover[u]].inc Covered[u,c].cover) (basis u) ;
 equivalence : QC.Maps.Equivalence Assoc.associated.presheaf Image.presheaf = Local.With[covering].equivalence ;
 module Inverse = QC.Maps.Inverse[Assoc.associated.presheaf,Image.presheaf,equivalence] ;
 model : QC.Model = new QC.Model[N,Inverse.equivalence] ;
 coefficients : Id (SM.Over[B].Module) model.coefficients (M.presheaf.module-at w) = refl N ;
 opaque morphism ;
} ;
