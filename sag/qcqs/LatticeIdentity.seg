-- Structure identity for bounded distributive lattices.
-- The four operations form a SipGeneric notion.  Sethood and its nine
-- equational laws are propositions.  Passing between this Sigma
-- presentation and DistLattice.DLat is a retraction, by record induction.
-- Contractibility of isomorphism total spaces gives lattice iso induction.
-- A bijective lattice map supplies this same structural isomorphism.
level l ; open Base ;
module Pr = Prelude[l] ;
module G = SipGeneric[l] ;
module IT = IdentityTools[l] ;
module DL = DistLattice[l] ;
Data : G.Notion = G.join G.point (G.join G.point (G.join G.binop G.binop)) ;
bot (X : U l) (d : Data.S X) : X = d.1 ;
top (X : U l) (d : Data.S X) : X = d.2.1 ;
join (X : U l) (d : Data.S X) : X -> X -> X = d.2.2.1 ;
meet (X : U l) (d : Data.S X) : X -> X -> X = d.2.2.2 ;
module Laws (X : U l) (d : Data.S X) {
 JoinAssociative : U l = (x y z : X) -> Id X (join X d x (join X d y z)) (join X d (join X d x y) z) ;
 JoinCommutative : U l = (x y : X) -> Id X (join X d x y) (join X d y x) ;
 JoinBottom : U l = (x : X) -> Id X (join X d x (bot X d)) (x) ;
 MeetAssociative : U l = (x y z : X) -> Id X (meet X d x (meet X d y z)) (meet X d (meet X d x y) z) ;
 MeetCommutative : U l = (x y : X) -> Id X (meet X d x y) (meet X d y x) ;
 MeetTop : U l = (x : X) -> Id X (meet X d x (top X d)) (x) ;
 MeetAbsorption : U l = (x y : X) -> Id X (meet X d x (join X d x y)) (x) ;
 JoinAbsorption : U l = (x y : X) -> Id X (join X d x (meet X d x y)) (x) ;
 Distributive : U l = (x y z : X) -> Id X (meet X d x (join X d y z)) (join X d (meet X d x y) (meet X d x z)) ;
 Rest : U l = JoinAssociative * JoinCommutative * JoinBottom * MeetAssociative * MeetCommutative * MeetTop * MeetAbsorption * JoinAbsorption * Distributive ;
 join-assoc (h : Rest) : JoinAssociative = h.1 ;
 join-comm (h : Rest) : JoinCommutative = h.2.1 ;
 join-bottom (h : Rest) : JoinBottom = h.2.2.1 ;
 meet-assoc (h : Rest) : MeetAssociative = h.2.2.2.1 ;
 meet-comm (h : Rest) : MeetCommutative = h.2.2.2.2.1 ;
 meet-top (h : Rest) : MeetTop = h.2.2.2.2.2.1 ;
 meet-absorption (h : Rest) : MeetAbsorption = h.2.2.2.2.2.2.1 ;
 join-absorption (h : Rest) : JoinAbsorption = h.2.2.2.2.2.2.2.1 ;
 distributive (h : Rest) : Distributive = h.2.2.2.2.2.2.2.2 ;
 module Prop (setX : Pr.isSet X) {
  p-join-assoc : Pr.isProp JoinAssociative = IT.FE.isProp-Pi X (\ x -> (y z : X) -> Id X (join X d x (join X d y z)) (join X d (join X d x y) z)) (\ x -> IT.FE.isProp-Pi X (\ y -> (z : X) -> Id X (join X d x (join X d y z)) (join X d (join X d x y) z)) (\ y -> IT.FE.isProp-Pi X (\ z -> Id X (join X d x (join X d y z)) (join X d (join X d x y) z)) (\ z -> setX (join X d x (join X d y z)) (join X d (join X d x y) z)))) ;
  p-join-comm : Pr.isProp JoinCommutative = IT.FE.isProp-Pi X (\ x -> (y : X) -> Id X (join X d x y) (join X d y x)) (\ x -> IT.FE.isProp-Pi X (\ y -> Id X (join X d x y) (join X d y x)) (\ y -> setX (join X d x y) (join X d y x))) ;
  p-join-bottom : Pr.isProp JoinBottom = IT.FE.isProp-Pi X (\ x -> Id X (join X d x (bot X d)) (x)) (\ x -> setX (join X d x (bot X d)) (x)) ;
  p-meet-assoc : Pr.isProp MeetAssociative = IT.FE.isProp-Pi X (\ x -> (y z : X) -> Id X (meet X d x (meet X d y z)) (meet X d (meet X d x y) z)) (\ x -> IT.FE.isProp-Pi X (\ y -> (z : X) -> Id X (meet X d x (meet X d y z)) (meet X d (meet X d x y) z)) (\ y -> IT.FE.isProp-Pi X (\ z -> Id X (meet X d x (meet X d y z)) (meet X d (meet X d x y) z)) (\ z -> setX (meet X d x (meet X d y z)) (meet X d (meet X d x y) z)))) ;
  p-meet-comm : Pr.isProp MeetCommutative = IT.FE.isProp-Pi X (\ x -> (y : X) -> Id X (meet X d x y) (meet X d y x)) (\ x -> IT.FE.isProp-Pi X (\ y -> Id X (meet X d x y) (meet X d y x)) (\ y -> setX (meet X d x y) (meet X d y x))) ;
  p-meet-top : Pr.isProp MeetTop = IT.FE.isProp-Pi X (\ x -> Id X (meet X d x (top X d)) (x)) (\ x -> setX (meet X d x (top X d)) (x)) ;
  p-meet-absorption : Pr.isProp MeetAbsorption = IT.FE.isProp-Pi X (\ x -> (y : X) -> Id X (meet X d x (join X d x y)) (x)) (\ x -> IT.FE.isProp-Pi X (\ y -> Id X (meet X d x (join X d x y)) (x)) (\ y -> setX (meet X d x (join X d x y)) (x))) ;
  p-join-absorption : Pr.isProp JoinAbsorption = IT.FE.isProp-Pi X (\ x -> (y : X) -> Id X (join X d x (meet X d x y)) (x)) (\ x -> IT.FE.isProp-Pi X (\ y -> Id X (join X d x (meet X d x y)) (x)) (\ y -> setX (join X d x (meet X d x y)) (x))) ;
  p-distributive : Pr.isProp Distributive = IT.FE.isProp-Pi X (\ x -> (y z : X) -> Id X (meet X d x (join X d y z)) (join X d (meet X d x y) (meet X d x z))) (\ x -> IT.FE.isProp-Pi X (\ y -> (z : X) -> Id X (meet X d x (join X d y z)) (join X d (meet X d x y) (meet X d x z))) (\ y -> IT.FE.isProp-Pi X (\ z -> Id X (meet X d x (join X d y z)) (join X d (meet X d x y) (meet X d x z))) (\ z -> setX (meet X d x (join X d y z)) (join X d (meet X d x y) (meet X d x z))))) ;
  rest : Pr.isProp Rest = IT.both JoinAssociative (JoinCommutative * JoinBottom * MeetAssociative * MeetCommutative * MeetTop * MeetAbsorption * JoinAbsorption * Distributive) p-join-assoc (IT.both JoinCommutative (JoinBottom * MeetAssociative * MeetCommutative * MeetTop * MeetAbsorption * JoinAbsorption * Distributive) p-join-comm (IT.both JoinBottom (MeetAssociative * MeetCommutative * MeetTop * MeetAbsorption * JoinAbsorption * Distributive) p-join-bottom (IT.both MeetAssociative (MeetCommutative * MeetTop * MeetAbsorption * JoinAbsorption * Distributive) p-meet-assoc (IT.both MeetCommutative (MeetTop * MeetAbsorption * JoinAbsorption * Distributive) p-meet-comm (IT.both MeetTop (MeetAbsorption * JoinAbsorption * Distributive) p-meet-top (IT.both MeetAbsorption (JoinAbsorption * Distributive) p-meet-absorption (IT.both JoinAbsorption (Distributive) p-join-absorption (p-distributive)))))))) ;
 } ;
} ;
Ax (X : U l) (d : Data.S X) : U l = (s : Pr.isSet X) * Laws[X,d].Rest ;
ax-prop (X : U l) (d : Data.S X) : Pr.isProp (Ax X d) =
 Pr.isProp-Sigma (Pr.isSet X) (\ s -> Laws[X,d].Rest) (IT.set-prop X) (\ s -> Laws[X,d].Prop[s].rest) ;
N : G.Notion = G.axioms Data Ax ax-prop ;
module S = G.Over[N] ;
fields (A : DL.DLat) : S.Str = (A.L,((A.bot,(A.top,(A.join,A.meet))), (A.setL,(A.joinA,(A.joinC,(A.joinB,(A.meetA,(A.meetC,(A.meetT,(A.absorb-meet,(A.absorb-join,A.dist))))))))))) ;
module From (t : S.Str) {
 module L = Laws[t.1,t.2.1] ;
 lattice : DL.DLat = new DL.DLat[t.1,t.2.2.1,bot t.1 t.2.1,top t.1 t.2.1,join t.1 t.2.1,meet t.1 t.2.1,L.join-assoc t.2.2.2,L.join-comm t.2.2.2,L.join-bottom t.2.2.2,L.meet-assoc t.2.2.2,L.meet-comm t.2.2.2,L.meet-top t.2.2.2,L.meet-absorption t.2.2.2,L.join-absorption t.2.2.2,L.distributive t.2.2.2] ;
} ;
LIso (A B : DL.DLat) : U l = S.Iso (fields A) (fields B) ;
id-iso (A : DL.DLat) : LIso A A = S.idIso (fields A) ;
Total (A : DL.DLat) : U l+ = (B : DL.DLat) * LIso A B ;
back (A : DL.DLat) : (B : DL.DLat) (e : LIso A B) -> Id (Total A) (From[fields B].lattice,e) (B,e) = split {
 DLat X sx z o jo me a b c d e f g h i -> \ phi -> refl (new DL.DLat[X,sx,z,o,jo,me,a,b,c,d,e,f,g,h,i],phi) } ;
total-contr (A : DL.DLat) : FunExtUA[l+].isContr (Total A) =
 SipGeneric[l+].ctr-retract (S.Total (fields A)) (Total A) (S.total-contr (fields A))
  (\ t -> (fields t.1,t.2)) (\ t -> (From[t.1].lattice,t.2)) (\ t -> back A t.1 t.2) ;
opaque total-contr ;
module Fd = G.Fundamental[DL.DLat,LIso,id-iso,total-contr] ;
hom (A B : DL.DLat) (e : LIso A B) : DL.Hom A B = (e.1.1,e.2.1,e.2.2.1,e.2.2.2.1,e.2.2.2.2) ;
of-hom (A B : DL.DLat) (h : DL.Hom A B) (eq : Pr.isEquiv A.L B.L (DL.hmap h)) : LIso A B =
 ((DL.hmap h,eq),(DL.hmap-bot h,(DL.hmap-top h,(DL.hmap-join h,DL.hmap-meet h)))) ;
hom-of (A B : DL.DLat) (h : DL.Hom A B) (eq : Pr.isEquiv A.L B.L (DL.hmap h)) :
 Id (DL.Hom A B) (hom A B (of-hom A B h eq)) h = DL.HomProperties[A,B].ext _ _ (\ x -> refl (DL.hmap h x)) ;
hom-id (A : DL.DLat) : Id (DL.Hom A A) (hom A A (id-iso A)) (DL.identity A) = DL.HomProperties[A,A].ext _ _ (\ x -> refl x) ;
