-- D(b)=top exactly when b is a unit, for a small test ring.
-- Use the localisation at powers of 1.  Its inclusion is bijective with
-- inverse Global.back (back-f and f-back).  Bridge says top <= D(b) iff
-- its image there is a unit.  A bijective ring map reflects units, and
-- every ring map preserves them.  Antisymmetry turns top <= D(b) into
-- D(b)=top.  No fraction or radical certificate is inspected by the client.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module T = AffineTests[l] ; open RingMaps[l] ;
module Over (B : T.Test) {
 module AB = T.At[B].A ;
 module Z = T.At[B].Z ;
 module G = T.At[B].G ;
 inclusion-equiv : Pr.isEquiv B.ring.R (AB.Loc B.ring.o).R (map (AB.inclusion B.ring.o)) =
  Pr.qinv B.ring.R (AB.Loc B.ring.o).R (map (AB.inclusion B.ring.o)) (map G.back) G.f-back G.back-f ;
 module At (b : B.ring.R) {
  module Br = Bridge[l].Over[B.ring,B.ring.o].At[AB.Loc B.ring.o,AB.set B.ring.o,AB.inclusion B.ring.o,AB.elementary B.ring.o,b] ;
  to-unit (e : Id Z.lattice.L (Z.D b) Z.lattice.top) : RL[B.ring].unit b =
   Iso[l].Units[B.ring,AB.Loc B.ring.o,AB.inclusion B.ring.o,inclusion-equiv].reflect b
    (Br.le-invertible (Z.O.le-of-eq Z.lattice.top (Z.D b) (sym e))) ;
  from-unit (u : RL[B.ring].unit b) : Id Z.lattice.L (Z.D b) Z.lattice.top =
   Z.O.le-antisym (Z.D b) Z.lattice.top (Z.O.le-top (Z.D b))
    (Br.invertible-le (AffineRing[l].unit-map B.ring (AB.Loc B.ring.o) (AB.inclusion B.ring.o) b u)) ;
 } ;
} ;
