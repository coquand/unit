-- The small Cech quotient on any finite family of opens (Serre, Section 5).
-- A cocycle has the equation c_ij+c_jk=c_ik on each triple overlap.
-- This is a proposition on cochains, so cocycles form a small set.
-- Coboundaries are cocycles by the telescoping theorem. Restrict the
-- generic image-translation relation to cocycles and take its effective
-- small quotient. Its zero class consists precisely of coboundaries,
-- merely. No affine or local-inhabitation hypothesis is used here.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module DL = DistLattice[l] ;
module MS = SerreModuleSheaf[l] ;
module Tr = Truncation[l] ;
module On (L : DL.DLat) (G : RingedLattice[l].On[L].Presheaf)
 (M : MS.On[L,G].ModuleSheaf) (n : Nat) (as : Fin n -> L.L) {
 module C = SerreCech[l].On[L,G,M,n,as] ;
 module O = DL.Order[L] ;
 module Triple (i j k : Fin n) {
  domain : L.L = L.meet (C.overlap i j) (as k) ;
  below-i : O.Le domain (as i) = O.le-trans domain (C.overlap i j) (as i)
   (O.meet-left (C.overlap i j) (as k)) (O.meet-left (as i) (as j)) ;
  below-j : O.Le domain (as j) = O.le-trans domain (C.overlap i j) (as j)
   (O.meet-left (C.overlap i j) (as k)) (O.meet-right (as i) (as j)) ;
  below-k : O.Le domain (as k) = O.meet-right (C.overlap i j) (as k) ;
  ij : O.Le domain (C.overlap i j) = C.Below[domain,i,j,below-i,below-j].meet-below ;
  jk : O.Le domain (C.overlap j k) = C.Below[domain,j,k,below-j,below-k].meet-below ;
  ik : O.Le domain (C.overlap i k) = C.Below[domain,i,k,below-i,below-k].meet-below ;
  Law (c : C.C1.Carrier) : U l = Id (M.presheaf.module-at domain).M
   ((M.presheaf.module-at domain).madd
    (C.MO.restrict domain (C.overlap i j) ij (c i j))
    (C.MO.restrict domain (C.overlap j k) jk (c j k)))
   (C.MO.restrict domain (C.overlap i k) ik (c i k)) ;
  law-prop (c : C.C1.Carrier) : Pr.isProp (Law c) = (M.presheaf.module-at domain).setM _ _ ;
 } ;
 CocycleLaw (c : C.C1.Carrier) : U l = (i j k : Fin n) -> Triple[i,j,k].Law c ;
 law-prop (c : C.C1.Carrier) : Pr.isProp (CocycleLaw c) =
  FE.isProp-Pi (Fin n) (\ i -> (j k : Fin n) -> Triple[i,j,k].Law c) (\ i ->
   FE.isProp-Pi (Fin n) (\ j -> (k : Fin n) -> Triple[i,j,k].Law c) (\ j ->
    FE.isProp-Pi (Fin n) (\ k -> Triple[i,j,k].Law c) (\ k -> Triple[i,j,k].law-prop c))) ;
 Cocycle : U l = (c : C.C1.Carrier) * CocycleLaw c ;
 value (c : Cocycle) : C.C1.Carrier = c.1 ;
 law (c : Cocycle) : CocycleLaw (value c) = c.2 ;
 set : Pr.isSet Cocycle = Pr.isSet-Sigma C.C1.Carrier CocycleLaw C.C1.product.setM
  (\ c -> Pr.prop-to-set (CocycleLaw c) (law-prop c)) ;
 ext (c d : Cocycle) (e : Id C.C1.Carrier (value c) (value d)) : Id Cocycle c d =
  Pr.Sigma-eq C.C1.Carrier CocycleLaw c.1 d.1 c.2 d.2 e (law-prop d.1) ;
 boundary-law (b : C.C0.Carrier) : CocycleLaw (C.delta b) = \ i j k ->
  C.delta-cocycle b Triple[i,j,k].domain i j k Triple[i,j,k].below-i Triple[i,j,k].below-j Triple[i,j,k].below-k ;
 boundary (b : C.C0.Carrier) : Cocycle = (C.delta b,boundary-law b) ;
 boundary-value (b : C.C0.Carrier) : Id C.C1.Carrier (value (boundary b)) (C.delta b) = refl (C.delta b) ;
 module Translation = SerreCechQuotient[l].Over[G.ring L.top,C.C0.product,C.C1.product,C.coboundary] ;
 Related (c d : Cocycle) : U l = Translation.Related (value c) (value d) ;
 related-prop (c d : Cocycle) : Pr.isProp (Related c d) = Translation.related-prop (value c) (value d) ;
 reflexive (c : Cocycle) : Related c c = Translation.reflexive (value c) ;
 symmetric (c d : Cocycle) (r : Related c d) : Related d c = Translation.symmetric (value c) (value d) r ;
 transitive (c d e : Cocycle) (r : Related c d) (s : Related d e) : Related c e =
  Translation.transitive (value c) (value d) (value e) r s ;
 module Q = Quotient[l].Quot[Cocycle,Related,related-prop,reflexive,symmetric,transitive] ;
 H1 : U l = Q.Q ;
 h1-set : Pr.isSet H1 = Q.set ;
 class (c : Cocycle) : H1 = Q.inc c ;
 zero-cocycle : Cocycle = boundary C.C0.product.mz ;
 zero : H1 = class zero-cocycle ;
 delta-zero : Id C.C1.Carrier (C.delta C.C0.product.mz) C.C1.product.mz =
  trans (sym (C.coboundary-at C.C0.product.mz)) (C.Maps.map-zero C.coboundary) ;
 zero-cocycle-value : Id C.C1.Carrier (value zero-cocycle) C.C1.product.mz =
  trans (boundary-value C.C0.product.mz) delta-zero ;
 IsBoundary (c : Cocycle) : U l = Tr.Trunc[(b : C.C0.Carrier) * Id C.C1.Carrier (value c) (C.delta b)].carrier ;
 zero-boundary (c : Cocycle) (p : Id H1 (class c) zero) : IsBoundary c =
  Tr.Trunc[Translation.Witness (value zero-cocycle) (value c)].induction @l
   (\ w -> IsBoundary c) (\ w -> Tr.Trunc[(b : C.C0.Carrier) * Id C.C1.Carrier (value c) (C.delta b)].proposition)
   (\ w -> Tr.Trunc[(b : C.C0.Carrier) * Id C.C1.Carrier (value c) (C.delta b)].inc
    (w.1,trans w.2
     (trans (cong2 C.C1.Carrier C.C1.product.madd _ _ _ _ delta-zero (C.coboundary-at w.1))
      (SerreModule[l].Over[G.ring L.top].Laws[C.C1.product].zero-left (C.delta w.1)))))
   (Q.effective zero-cocycle c (sym p)) ;
 boundary-zero (c : Cocycle) (b : IsBoundary c) : Id H1 (class c) zero =
  Tr.Trunc[(b : C.C0.Carrier) * Id C.C1.Carrier (value c) (C.delta b)].induction @l
   (\ w -> Id H1 (class c) zero) (\ w -> h1-set (class c) zero)
   (\ w -> sym (Q.relates zero-cocycle c
    (Tr.Trunc[Translation.Witness (value zero-cocycle) (value c)].inc
     (w.1,trans w.2
      (sym (trans (cong2 C.C1.Carrier C.C1.product.madd _ _ _ _ delta-zero (C.coboundary-at w.1))
       (SerreModule[l].Over[G.ring L.top].Laws[C.C1.product].zero-left (C.delta w.1)))))))) b ;
 opaque boundary ; opaque zero-cocycle ;
} ;
