-- Essential image of the absolute functor of points.
-- A representation of F consists of a small space X, its qcqs proof,
-- and F ~= h_X.  The assertion of representation is its truncation in
-- U(l+1).  From an actual functorial atlas, finite choice at l+1 gives
-- the affine witnesses merely.  For actual witnesses AtlasRealisation
-- constructs a qcqs space and the equivalence.  Insert that witness
-- into mere representability, then eliminate finite choice and finally
-- the mere atlas.  This produces no chosen global representing object.
-- Conversely, GeometricAtlas and FunctorialTransfer make every actual
-- representation functorially qcqs; eliminate the mere representation
-- into that property.  Both properties are propositions, hence the two
-- implications also give an equivalence of propositions.
-- The informal proof and its review precede these declarations in
-- unit/doc/functorial-schemes.tex.  Relative reconstruction and geometric
-- category univalence are separate statements.
level l ; open Ring[l] ; open Presentations[l] ;
module Hi = Prelude[l+] ;
module Tr = Truncation[l+] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module TE = TestEquivalences[l] ;
module SP = Spaces[l] ;
module QF = FunctorialQcqs[l] ;
module Over (F : SF.SetFunctor) {
 module Q = QF.Over[F] ;
 Representation : U l+ = (X : SP.Space) *
  (Qcqs[l].Over[X.lattice,X.structure].IsQcqs * TE.NaturalEquivalence F SF.Geometric[X].functor) ;
 IsRepresentable : U l+ = Tr.Trunc[Representation].carrier ;
 representable-prop : Hi.isProp IsRepresentable = Tr.Trunc[Representation].proposition ;
 module FromCover (sheaf : TestSheaves[l].IsSheaf F) (c : Q.AffineCover) {
  Witnesses : U l+ = (i : Fin c.count) -> QF.AffineWitness OpenRealisation[l].Over[F,c.opens i].functor ;
  module Actual (ws : Witnesses) {
   module R = AtlasRealisation[l].Over[F,sheaf,c.count,c.opens,c.covers,\ i -> (ws i).1,\ i -> (ws i).2] ;
   representation : Representation = (R.R.X,R.R.qcqs,R.equivalence) ;
  } ;
  representable : IsRepresentable = Tr.Trunc[Witnesses].induction @(l+)
   (\ t -> IsRepresentable) (\ t -> representable-prop)
   (\ ws -> Tr.Trunc[Representation].inc Actual[ws].representation)
   (FiniteLargeChoice[l].choice c.count (\ i -> QF.AffineWitness OpenRealisation[l].Over[F,c.opens i].functor) c.affine) ;
 } ;
 reconstruct (q : Q.IsQcqs) : IsRepresentable = Tr.Trunc[Q.AffineCover].induction @(l+)
  (\ t -> IsRepresentable) (\ t -> representable-prop) (\ c -> FromCover[q.1,c].representable) q.2 ;
 represented (r : Representation) : Q.IsQcqs =
  FunctorialTransfer[l].Over[F,SF.Geometric[r.1].functor,r.2.2].qcqs (GeometricAtlas[l].Over[r.1].qcqs r.2.1) ;
 recognise (r : IsRepresentable) : Q.IsQcqs = Tr.Trunc[Representation].induction @(l+)
  (\ t -> Q.IsQcqs) (\ t -> Q.qcqs-prop) represented r ;
 equivalence : Hi.Equiv Q.IsQcqs IsRepresentable =
  (reconstruct,Hi.qinv Q.IsQcqs IsRepresentable reconstruct recognise
   (\ r -> representable-prop (reconstruct (recognise r)) r) (\ q -> Q.qcqs-prop (recognise (reconstruct q)) q)) ;
} ;
