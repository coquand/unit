-- Zar(B/(t)) = [D(t), top], and the idempotents of B/(t) (DESIGN.md,
-- Next 4, milestone 2, plan from the review): both lattices represent the
-- supports of B sending t to bot.
--
-- (1) The interval.  b |-> r(D b) = D(t) \/ D(b) is a support of B into
--  [D t, top] (r is a lattice map, Interval) sending t to its bottom D(t).
--  For a support d : B -> N with d(t) = bot let h be the factor of d
--  (ZariskiUniversal); on the interval it is a lattice map (its bottom D(t)
--  goes to d(t) = bot), and h(r u) = h(D t) \/ h(u) = h(u), so h(r(D b)) = d b.
--  It is the only one: for k on the interval with k(r(D b)) = d b, k . r is
--  a lattice map on L_B extending d, so k . r = h = h . r, and k = h on the
--  interval (Interval.determined).
-- (2) The quotient q : B -> Q = B/(t) (PrincipalQuotient).  A support d of B
--  with d(t) = bot descends to Q: if x = y + t w then
--  d x <= d y \/ d(t w) <= d y \/ d t = d y, and symmetrically.  The
--  descended map is a support: the laws hold on representatives.
--  Conversely D_Q . q is a support of B sending t to D_Q(0) = bot.
-- (3) alpha : [D t, top] -> L_Q is (1) for D_Q . q; beta : L_Q -> [D t, top]
--  the factor (ZariskiUniversal over Q) of the descent of r . D.  Then
--  beta . alpha and the identity both satisfy (1) for r . D:
--  beta(alpha(r(D b))) = beta(D_Q(q b)) = r(D b).  And alpha . beta and the
--  identity both extend D_Q (ZariskiUniversal over Q): on q(b),
--  alpha(beta(D_Q(q b))) = alpha(r(D b)) = D_Q(q b).  So alpha, beta are
--  mutually inverse.
-- Corollary.  Idempotents of Q = idempotents of O_Q(top) (Global) =
--  complementary pairs of L_Q (Idempotents) = complementary pairs of
--  [D t, top] (alpha, beta) = pairs (u, v) of L_B with u \/ v = top and
--  u /\ v = D(t) (Interval).  Explicitly, an idempotent q(b) gives the pair
--  (D t \/ D b, D t \/ D(1 - b)): D_top(q(b)|top) = D_Q(q b) (Global),
--  1 - q(b)|top = q(1 - b)|top, and beta(D_Q(q b)) = r(D b).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;
module Over (B : CRing) (setB : Pr.isSet B.R) (t : B.R) {
 module ZB = ZariskiLattice[l].Over[B] ;
 module I = Interval[l].Up[ZB.lattice,ZB.D t] ;
 module PQ = PrincipalQuotient[l].Over[B,setB,t] ;
 module ZQ = ZariskiLattice[l].Over[PQ.ring] ;

 -- r . D is a support sending t to the bottom
 r-support : DL.Supports[B,I.lattice].Support (\ b -> DL.hmap I.r (ZB.D b)) =
  DL.SupportAfter[B,ZB.lattice,I.lattice,I.r,ZB.D,ZB.support].support ;
 r-kills : Id I.lattice.L (DL.hmap I.r (ZB.D t)) I.lattice.bot = I.el-ext (DL.hmap I.r (ZB.D t)) I.lattice.bot I.join-idem ;

 -- (1) the interval represents the supports sending t to bot
 module Represent (N : DL.DLat) (d : B.R -> N.L) (sd : DL.Supports[B,N].Support d) (kills : Id N.L (d t) N.bot) {
  module ZU = ZariskiUniversal[l].Over[B,N,d,sd] ;
  module NO = DL.Order[N] ;
  h-bottom : Id N.L (DL.hmap ZU.factor (I.incl I.lattice.bot)) N.bot = trans (ZU.factor-D t) kills ;
  factor : DL.Hom I.lattice N =
   (\ x -> DL.hmap ZU.factor (I.incl x),h-bottom,DL.hmap-top ZU.factor,
    \ x y -> DL.hmap-join ZU.factor (I.incl x) (I.incl y),\ x y -> DL.hmap-meet ZU.factor (I.incl x) (I.incl y)) ;
  -- h(r u) = h(u)
  on-r (u : ZB.lattice.L) : Id N.L (DL.hmap factor (DL.hmap I.r u)) (DL.hmap ZU.factor u) = calc N.L {
   DL.hmap factor (DL.hmap I.r u) =< refl (DL.hmap ZU.factor (ZB.lattice.join (ZB.D t) u)) > DL.hmap ZU.factor (ZB.lattice.join (ZB.D t) u)
    =< DL.hmap-join ZU.factor (ZB.D t) u > N.join (DL.hmap ZU.factor (ZB.D t)) (DL.hmap ZU.factor u)
    =< ap (\ x -> N.join x (DL.hmap ZU.factor u)) h-bottom > N.join N.bot (DL.hmap ZU.factor u)
    =< NO.bot-join (DL.hmap ZU.factor u) > DL.hmap ZU.factor u } ;
  factor-D (b : B.R) : Id N.L (DL.hmap factor (DL.hmap I.r (ZB.D b))) (d b) = trans (on-r (ZB.D b)) (ZU.factor-D b) ;
  unique (k : DL.Hom I.lattice N) (e : (b : B.R) -> Id N.L (DL.hmap k (DL.hmap I.r (ZB.D b))) (d b)) (x : I.lattice.L) :
   Id N.L (DL.hmap k x) (DL.hmap factor x) =
   I.determined N k factor (\ u -> trans (ZU.unique (DL.compose ZB.lattice I.lattice N k I.r) e u) (sym (on-r u))) x ;
 } ;

 -- (2) supports sending t to bot descend to Q
 module Descend (N : DL.DLat) (d : B.R -> N.L) (sd : DL.Supports[B,N].Support d) (kills : Id N.L (d t) N.bot) {
  module S = DL.Supports[B,N].Of[d,sd] ;
  module NO = DL.Order[N] ;
  -- x = y + t w gives d x <= d y
  below (x y : B.R) (w : PQ.C.Certificate x y) : NO.Le (d x) (d y) =
   NO.le-trans (d x) (N.join (d y) (d (B.mul t w.1))) (d y)
    (Pr.subst B.R (\ s -> NO.Le (d s) (N.join (d y) (d (B.mul t w.1)))) (B.add y (B.mul t w.1)) x (sym w.2)
     (S.at-add y (B.mul t w.1)))
    (NO.join-lub (d y) (d (B.mul t w.1)) (d y) (NO.le-refl (d y))
     (NO.le-trans (d (B.mul t w.1)) N.bot (d y)
      (Pr.subst N.L (\ s -> NO.Le (d (B.mul t w.1)) s) (d t) N.bot kills (S.scaled t w.1)) (NO.bot-le (d y)))) ;
  respects (x y : B.R) (h : PQ.Relation x y) : Id N.L (d x) (d y) =
   Tr.Trunc[PQ.C.Certificate x y].induction @l (\ w -> Id N.L (d x) (d y)) (\ w -> N.setL (d x) (d y))
    (\ w -> NO.le-antisym (d x) (d y) (below x y w) (below y x (PQ.C.symmetric x y w))) h ;
  module DQ = PQ.Q.Descend[N.L,N.setL,d,respects] ;
  mul-law (x y : B.R) : Id N.L (DQ.map (PQ.mulQ (PQ.include x) (PQ.include y))) (N.meet (DQ.map (PQ.include x)) (DQ.map (PQ.include y))) =
   calc N.L {
    DQ.map (PQ.mulQ (PQ.include x) (PQ.include y)) =< ap DQ.map (PQ.Mult.beta x y) > DQ.map (PQ.include (B.mul x y))
     =< DQ.beta (B.mul x y) > d (B.mul x y)
     =< S.at-mul x y > N.meet (d x) (d y)
     =< sym (cong2 N.L N.meet _ _ _ _ (DQ.beta x) (DQ.beta y)) > N.meet (DQ.map (PQ.include x)) (DQ.map (PQ.include y)) } ;
  add-law (x y : B.R) : NO.Le (DQ.map (PQ.addQ (PQ.include x) (PQ.include y))) (N.join (DQ.map (PQ.include x)) (DQ.map (PQ.include y))) =
   NO.le-trans (DQ.map (PQ.addQ (PQ.include x) (PQ.include y))) (d (B.add x y)) (N.join (DQ.map (PQ.include x)) (DQ.map (PQ.include y)))
    (NO.le-of-eq (DQ.map (PQ.addQ (PQ.include x) (PQ.include y))) (d (B.add x y))
     (trans (ap DQ.map (PQ.Add.beta x y)) (DQ.beta (B.add x y))))
    (NO.le-trans (d (B.add x y)) (N.join (d x) (d y)) (N.join (DQ.map (PQ.include x)) (DQ.map (PQ.include y)))
     (S.at-add x y)
     (NO.le-of-eq (N.join (d x) (d y)) (N.join (DQ.map (PQ.include x)) (DQ.map (PQ.include y)))
      (sym (cong2 N.L N.join _ _ _ _ (DQ.beta x) (DQ.beta y))))) ;
  support : DL.Supports[PQ.ring,N].Support DQ.map =
   (trans (DQ.beta B.o) S.at-one,trans (DQ.beta B.z) S.at-zero,
    PQ.forall2 (\ x y -> Id N.L (DQ.map (PQ.mulQ x y)) (N.meet (DQ.map x) (DQ.map y))) (\ x y -> N.setL _ _) mul-law,
    PQ.forall2 (\ x y -> NO.Le (DQ.map (PQ.addQ x y)) (N.join (DQ.map x) (DQ.map y))) (\ x y -> NO.le-prop _ _) add-law) ;
 } ;

 -- D_Q . q is a support sending t to bot
 q-support : DL.Supports[B,ZQ.lattice].Support (\ b -> ZQ.D (PQ.include b)) =
  DL.SupportMaps[B,PQ.ring,ZQ.lattice].Pull[PQ.inclusion,ZQ.D,ZQ.support].support ;
 q-kills : Id ZQ.lattice.L (ZQ.D (PQ.include t)) ZQ.lattice.bot =
  trans (ap ZQ.D PQ.kills) (DL.Supports[PQ.ring,ZQ.lattice].Of[ZQ.D,ZQ.support].at-zero) ;

 -- (3) alpha and beta
 module A = Represent[ZQ.lattice,\ b -> ZQ.D (PQ.include b),q-support,q-kills] ;
 module RD = Descend[I.lattice,\ b -> DL.hmap I.r (ZB.D b),r-support,r-kills] ;
 module RI = Represent[I.lattice,\ b -> DL.hmap I.r (ZB.D b),r-support,r-kills] ;
 module UQ = ZariskiUniversal[l].Over[PQ.ring,I.lattice,RD.DQ.map,RD.support] ;
 module UZ = ZariskiUniversal[l].Over[PQ.ring,ZQ.lattice,ZQ.D,ZQ.support] ;
 alpha : DL.Hom I.lattice ZQ.lattice = A.factor ;
 beta : DL.Hom ZQ.lattice I.lattice = UQ.factor ;
 -- alpha(r(D b)) = D_Q(q b), beta(D_Q(q b)) = r(D b)
 alpha-D (b : B.R) : Id ZQ.lattice.L (DL.hmap alpha (DL.hmap I.r (ZB.D b))) (ZQ.D (PQ.include b)) = A.factor-D b ;
 beta-D (b : B.R) : Id I.lattice.L (DL.hmap beta (ZQ.D (PQ.include b))) (DL.hmap I.r (ZB.D b)) =
  trans (UQ.factor-D (PQ.include b)) (RD.DQ.beta b) ;
 beta-alpha (x : I.lattice.L) : Id I.lattice.L (DL.hmap beta (DL.hmap alpha x)) x =
  trans (RI.unique (DL.compose I.lattice ZQ.lattice I.lattice beta alpha) (\ b -> calc I.lattice.L {
    DL.hmap beta (DL.hmap alpha (DL.hmap I.r (ZB.D b))) =< ap (DL.hmap beta) (alpha-D b) > DL.hmap beta (ZQ.D (PQ.include b))
     =< beta-D b > DL.hmap I.r (ZB.D b) }) x)
   (sym (RI.unique (DL.identity I.lattice) (\ b -> refl (DL.hmap I.r (ZB.D b))) x)) ;
 alpha-beta-D : (y : PQ.Carrier) -> Id ZQ.lattice.L (DL.hmap alpha (DL.hmap beta (ZQ.D y))) (ZQ.D y) =
  PQ.Q.induction @l (\ y -> Id ZQ.lattice.L (DL.hmap alpha (DL.hmap beta (ZQ.D y))) (ZQ.D y)) (\ y -> ZQ.lattice.setL _ _)
   (\ b -> calc ZQ.lattice.L {
     DL.hmap alpha (DL.hmap beta (ZQ.D (PQ.include b))) =< ap (DL.hmap alpha) (beta-D b) > DL.hmap alpha (DL.hmap I.r (ZB.D b))
      =< alpha-D b > ZQ.D (PQ.include b) }) ;
 alpha-beta (y : ZQ.lattice.L) : Id ZQ.lattice.L (DL.hmap alpha (DL.hmap beta y)) y =
  trans (UZ.unique (DL.compose ZQ.lattice I.lattice ZQ.lattice alpha beta) alpha-beta-D y)
   (sym (UZ.unique (DL.identity ZQ.lattice) (\ y2 -> refl (ZQ.D y2)) y)) ;

 -- the idempotents of Q
 module AQ = Affine[l].Over[PQ.ring] ;
 module GQ = Global[l].Over[PQ.ring,PQ.set,AQ.Loc,AQ.set,AQ.inclusion,AQ.elementary] ;
 module TQ = Idempotents[l].Transfer[PQ.ring,AQ.spec.sheaf.ring ZQ.lattice.top,PQ.set,AQ.spec.sheaf.ring-set ZQ.lattice.top,GQ.global,GQ.iso] ;
 module EQ = Idempotents[l].On[ZQ.lattice,AQ.spec] ;
 module CQ = DL.ComplementIso[ZQ.lattice,I.lattice,beta,alpha,alpha-beta,beta-alpha] ;
 -- e |-> the pair (D(e), D(1 - e)) of L_Q, read in [D t, top] and in L_B
 splitting-of (e : TQ.IA.Idem) : I.Splittings = I.to-splitting (CQ.H.image (EQ.forth (TQ.forth e))) ;
 splitting : Pr.isEquiv TQ.IA.Idem I.Splittings splitting-of =
  Iso[l].equiv-compose TQ.IA.Idem I.CU.Pairs I.Splittings I.to-splitting (\ e -> CQ.H.image (EQ.forth (TQ.forth e))) I.splittings
   (Iso[l].equiv-compose TQ.IA.Idem EQ.C.Pairs I.CU.Pairs CQ.H.image (\ e -> EQ.forth (TQ.forth e)) CQ.equivalence
    (Iso[l].equiv-compose TQ.IA.Idem TQ.IB.Idem EQ.C.Pairs EQ.forth TQ.forth EQ.equivalence TQ.equivalence)) ;
 -- the splitting of q(b) is (D t \/ D b, D t \/ D(1 - b))
 module Formula (b : B.R) (hb : Idempotents[l].Laws[PQ.ring].IsIdem (PQ.include b)) {
  module MG = Idempotents[l].Map[PQ.ring,AQ.spec.sheaf.ring ZQ.lattice.top,GQ.global] ;
  module MQ = Idempotents[l].Map[B,PQ.ring,PQ.inclusion] ;
  first : Id ZB.lattice.L (splitting-of (PQ.include b,hb)).1.1 (ZB.lattice.join (ZB.D t) (ZB.D b)) = calc ZB.lattice.L {
   (splitting-of (PQ.include b,hb)).1.1
    =< refl (I.incl (DL.hmap beta (EQ.LX.d ZQ.lattice.top (map GQ.global (PQ.include b)))))
    > I.incl (DL.hmap beta (EQ.LX.d ZQ.lattice.top (map GQ.global (PQ.include b))))
    =< ap (\ y -> I.incl (DL.hmap beta y)) (GQ.d-global (PQ.include b)) > I.incl (DL.hmap beta (ZQ.D (PQ.include b)))
    =< ap I.incl (beta-D b) > ZB.lattice.join (ZB.D t) (ZB.D b) } ;
  -- 1 - (q b)|top = (q (1 - b))|top
  comp-eq : Id (AQ.spec.sheaf.ring ZQ.lattice.top).R (EQ.LT.comp (map GQ.global (PQ.include b)))
   (map GQ.global (PQ.include (Idempotents[l].Laws[B].comp b))) = calc (AQ.spec.sheaf.ring ZQ.lattice.top).R {
   EQ.LT.comp (map GQ.global (PQ.include b)) =< sym (MG.comp-map (PQ.include b))
    > map GQ.global (Idempotents[l].Laws[PQ.ring].comp (PQ.include b))
    =< ap (map GQ.global) (sym (MQ.comp-map b)) > map GQ.global (PQ.include (Idempotents[l].Laws[B].comp b)) } ;
  second : Id ZB.lattice.L (splitting-of (PQ.include b,hb)).1.2
   (ZB.lattice.join (ZB.D t) (ZB.D (Idempotents[l].Laws[B].comp b))) = calc ZB.lattice.L {
   (splitting-of (PQ.include b,hb)).1.2
    =< refl (I.incl (DL.hmap beta (EQ.LX.d ZQ.lattice.top (EQ.LT.comp (map GQ.global (PQ.include b))))))
    > I.incl (DL.hmap beta (EQ.LX.d ZQ.lattice.top (EQ.LT.comp (map GQ.global (PQ.include b)))))
    =< ap (\ s -> I.incl (DL.hmap beta (EQ.LX.d ZQ.lattice.top s))) comp-eq
    > I.incl (DL.hmap beta (EQ.LX.d ZQ.lattice.top (map GQ.global (PQ.include (Idempotents[l].Laws[B].comp b)))))
    =< ap (\ y -> I.incl (DL.hmap beta y)) (GQ.d-global (PQ.include (Idempotents[l].Laws[B].comp b)))
    > I.incl (DL.hmap beta (ZQ.D (PQ.include (Idempotents[l].Laws[B].comp b))))
    =< ap I.incl (beta-D (Idempotents[l].Laws[B].comp b)) > ZB.lattice.join (ZB.D t) (ZB.D (Idempotents[l].Laws[B].comp b)) } ;
 } ;
} ;
