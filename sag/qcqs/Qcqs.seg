-- qcqs schemes (DESIGN.md, step 5).  For a locally ringed lattice X on M,
-- an open u is affine when the restriction X|u is (Slice, AffineCriterion).
-- An affine cover: finitely many opens u_1, .., u_n, each affine, with
-- u_1 \/ .. \/ u_n = top.  X is a qcqs scheme when an affine cover merely
-- exists.  The cover is not part of the structure, and overlaps are not
-- required to be affine.
-- Two opens.  If u \/ v = top and both are affine, then (v, u) is an affine
--  cover: its join is v \/ (u \/ bot) = u \/ v = top.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module DL = DistLattice[l] ;
module Over (M : DL.DLat) (X : LocallyRinged[l].On[M].LocallyRinged) {
 module J = DL.Joins[M] ;
 -- X|u is affine
 AffineOpen (u : M.L) : U l =
  AffineCriterion[l].Over[Slice[l].Over[M,X,u].lattice,Slice[l].Over[M,X,u].restricted].IsAffine ;
 AffineCover : U l = sig {
  count : Nat ;
  opens : Fin count -> M.L ;
  covers : Id M.L (J.bigJ count opens) M.top ;
  affine : (i : Fin count) -> AffineOpen (opens i)
 } ;
 IsQcqs : U l = Tr.Trunc[AffineCover].carrier ;

 -- a cover by two affine opens
 module Two (u v : M.L) (covers : Id M.L (M.join u v) M.top) (au : AffineOpen u) (av : AffineOpen v) {
  opens : Fin (suc (suc zero)) -> M.L = split { inl i -> u ; inr t -> v } ;
  affine : (i : Fin (suc (suc zero))) -> AffineOpen (opens i) = split { inl i -> au ; inr t -> av } ;
  -- the join of the family is v \/ (u \/ bot), by definition
  join-two : Id M.L (J.bigJ (suc (suc zero)) opens) (M.join v (M.join u M.bot)) = refl (M.join v (M.join u M.bot)) ;
  cover : AffineCover =
   struct { count = suc (suc zero) ; opens = opens ;
            covers = trans join-two (trans (ap (M.join v) (M.joinB u)) (trans (M.joinC v u) covers)) ;
            affine = affine } ;
  qcqs : IsQcqs = Tr.Trunc[AffineCover].inc cover ;
 } ;
} ;
