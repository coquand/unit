-- The universal property of Spec A (DESIGN.md, step 5; zeuner1 Thm 3.12):
-- local maps X -> Spec A correspond one-to-one with ring maps A -> O_X(top).
-- X is a locally ringed lattice on M, A a set, Spec A is O on L_A over the
-- family f_g : A -> R_g of Sections.  A map Spec A -> X of ringed lattices
-- (in LocallyRinged.Maps, from L_A to M) is the geometric morphism
-- X -> Spec A.
--
-- The global component of psi is the ring map
--  A -> O(top) -> O_X(psi top) -> O_X(top),   a |-> (psi#(a|top))|top,
-- along a |-> a|top (Global) and top <= psi top.
-- (1) For phi : A -> O_X(top), the map of phi (SpecMap) is local and its
--     global component is phi (SpecMap.global).
-- (2) A local psi is the map of its global component: SpecUnique with phi
--     the global component of psi, whose hypothesis holds by definition.
--     The lattice maps agree pointwise, and the ring maps agree after the
--     restriction along that equation.
-- With MapEquality these two laws make component an equivalence between
-- local maps and ring maps A -> O_X(top); in particular two local maps
-- with the same global component are equal (unique).
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (Loc : A.R -> CRing) (set : (g : A.R) -> Pr.isSet (Loc g).R)
 (f : (g : A.R) -> RH.Hom A (Loc g))
 (el : (g : A.R) -> Bridge[l].Over[A,g].LocH.Elementary (Loc g) (f g))
 (M : DL.DLat) (X : LocallyRinged[l].On[M].LocallyRinged) {
 open A ;
 open ZariskiLattice[l].Over[A] ;
 module S = Sections[l].Over[A,Loc,set,f,el] ;
 module Sh = Sheaf[l].Over[A,Loc,set,f,el] ;
 module SI = SpecInv[l].Over[A,Loc,set,f,el] ;
 module Gb = Global[l].Over[A,setA,Loc,set,f,el] ;
 module MO = DL.Order[M] ;
 module GO = RingedLattice[l].On[M].Of[X.sheaf] ;
 module Mp = LocallyRinged[l].Maps[lattice,M,Sh.structure,X.sheaf] ;

 -- the global component
 psi-top (psi : Mp.Ringed) : MO.Le M.top (DL.hmap psi.lat lattice.top) =
  MO.le-of-eq M.top (DL.hmap psi.lat lattice.top) (sym (DL.hmap-top psi.lat)) ;
 component (psi : Mp.Ringed) : RH.Hom A (X.sheaf.ring M.top) =
  RH.compose A (S.ring lattice.top) (X.sheaf.ring M.top)
   (RH.compose (S.ring lattice.top) (X.sheaf.ring (DL.hmap psi.lat lattice.top)) (X.sheaf.ring M.top)
     (X.sheaf.res M.top (DL.hmap psi.lat lattice.top) (psi-top psi)) (psi.sharp lattice.top))
   Gb.global ;
 component-map (psi : Mp.Ringed) (a : R) : Id (X.sheaf.ring M.top).R (map (component psi) a)
  (GO.restrict M.top (DL.hmap psi.lat lattice.top) (psi-top psi) (map (psi.sharp lattice.top) (map Gb.global a))) =
  refl (GO.restrict M.top (DL.hmap psi.lat lattice.top) (psi-top psi) (map (psi.sharp lattice.top) (map Gb.global a))) ;

 -- (1) from phi to a local map with global component phi
 module Of (phi : RH.Hom A (X.sheaf.ring M.top)) {
  module SM = SpecMap[l].Over[A,setA,Loc,set,f,el,M,X,phi] ;
  morphism : Mp.Ringed = SM.morphism ;
  local : Mp.Of[morphism,SI.inv-map,X.inv].IsLocal = SM.is-local ;
  component-of (a : R) : Id (X.sheaf.ring M.top).R (map (component morphism) a) (map phi a) =
   calc (X.sheaf.ring M.top).R {
    map (component morphism) a =< component-map morphism a
     > GO.restrict M.top (DL.hmap SM.pi lattice.top) (psi-top morphism) (map (SM.E.extension-map lattice.top) (map Gb.global a))
    =< GO.res-irr M.top (DL.hmap SM.pi lattice.top) (psi-top morphism) SM.top-le
        (map (SM.E.extension-map lattice.top) (map Gb.global a))
     > GO.restrict M.top (DL.hmap SM.pi lattice.top) SM.top-le (map (SM.E.extension-map lattice.top) (map Gb.global a))
    =< ap (GO.restrict M.top (DL.hmap SM.pi lattice.top) SM.top-le) (SM.E.extension-map-at lattice.top (map Gb.global a))
     > GO.restrict M.top (DL.hmap SM.pi lattice.top) SM.top-le (SM.E.extend lattice.top (map Gb.global a))
    =< SM.global a > map phi a } ;
 } ;

 -- (2) a local map is the map of its global component
 module Local (psi : Mp.Ringed) (loc : Mp.Of[psi,SI.inv-map,X.inv].IsLocal) {
  module SU = SpecUnique[l].Over[A,setA,Loc,set,f,el,M,X,component psi,psi,loc,component-map psi] ;
  lattice-eq (y : lattice.L) : Id M.L (DL.hmap psi.lat y) (DL.hmap Of[component psi].morphism.lat y) = SU.lat-eq y ;
  sharp-eq (u : lattice.L) (s : S.Section u) :
   Id (X.sheaf.ring (DL.hmap Of[component psi].morphism.lat u)).R
    (GO.restrict (DL.hmap Of[component psi].morphism.lat u) (DL.hmap psi.lat u) (SU.le-pi u) (map (psi.sharp u) s))
    (map (Of[component psi].morphism.sharp u) s) =
   SU.sharp-eq u s ;
 } ;

 -- (1) and (2) as an equivalence of sets (MapEquality)
 module EM = MapEquality[l].Maps[lattice,M,Sh.structure,X.sheaf] ;
 module EL = EM.Local[SI.inv-map,X.inv] ;
 morphism-component (psi : Mp.Ringed) (loc : Mp.Of[psi,SI.inv-map,X.inv].IsLocal) :
  Id Mp.Ringed (Of[component psi].morphism) psi =
  sym (EM.ext psi (Of[component psi].morphism) Local[psi,loc].lattice-eq Local[psi,loc].SU.le-pi Local[psi,loc].sharp-eq) ;
 local-map (phi : RH.Hom A (X.sheaf.ring M.top)) : EL.LocalMap = (Of[phi].morphism,Of[phi].local) ;
 equivalence : Pr.isEquiv EL.LocalMap (RH.Hom A (X.sheaf.ring M.top)) (\ a -> component a.1) =
  Pr.qinv EL.LocalMap (RH.Hom A (X.sheaf.ring M.top)) (\ a -> component a.1) local-map
   (\ phi -> RH.Properties[A,X.sheaf.ring M.top,X.sheaf.ring-set M.top].ext (component Of[phi].morphism) phi Of[phi].component-of)
   (\ a -> EL.local-ext (local-map (component a.1)) a (morphism-component a.1 a.2)) ;
 -- two local maps with the same global component are equal
 unique (psi psi2 : Mp.Ringed) (loc : Mp.Of[psi,SI.inv-map,X.inv].IsLocal) (loc2 : Mp.Of[psi2,SI.inv-map,X.inv].IsLocal)
  (e : (a : R) -> Id (X.sheaf.ring M.top).R (map (component psi) a) (map (component psi2) a)) : Id Mp.Ringed psi psi2 =
  calc Mp.Ringed {
   psi =< sym (morphism-component psi loc) > Of[component psi].morphism
    =< ap (\ phi -> Of[phi].morphism)
        (RH.Properties[A,X.sheaf.ring M.top,X.sheaf.ring-set M.top].ext (component psi) (component psi2) e)
     > Of[component psi2].morphism
    =< morphism-component psi2 loc2 > psi2 } ;
} ;
