-- An equivalence (F, G, u, v) of univalent categories gives
-- (1) an equivalence of object types: F with quasi-inverse G, the two
--     homotopies being isotoid of the isomorphisms v_y : y ~= F(G y) and
--     u_x : x ~= G(F x) (reversed);
-- (2) an equivalence C(x,y) ~= D(Fx,Fy) on every hom set.  The inverse is
--     g |-> u_y^-1 o G g o u_x.  For f : x -> y, naturality of u gives
--     u_y^-1 o G(F f) o u_x = u_y^-1 o u_y o f = f (inverse-forward).
--     For g : Fx -> Fy, put f = u_y^-1 o G g o u_x; then G(F f) o u_x =
--     u_y o f = G g o u_x by naturality, so G(F f) = G g (cancel the iso
--     u_x), and G is faithful (backward-faithful: v_y o F(G a) = a o v_x
--     by naturality of v, cancel v_y), so F f = g (forward-inverse).
-- Port of ~/DOMAIN/UNIT/CategoryEquivalenceTransport.seg (levels
-- generalised; object-equality and forward-faithful are not needed).
level l ; open Base ;
module K = Category[l,l] ;
module CE = FibreCategoryEquivalence[l] ;
module P = Prelude[l] ;
module H = Paths[l] ;

module On (C D : K.Category) (e : CE.Equivalence[C,D]) {
 module AC = Arrows[l,l].Arrows[C.pre] ;
 module AD = Arrows[l,l].Arrows[D.pre] ;
 object-equivalence : P.Equiv C.pre.ob D.pre.ob =
  (e.forward.obj,
   P.qinv C.pre.ob D.pre.ob e.forward.obj e.backward.obj
    (\ y -> P.sym D.pre.ob y (e.forward.obj (e.backward.obj y))
      (D.isotoid y (e.forward.obj (e.backward.obj y)) (e.unit-target y)))
    (\ x -> P.sym C.pre.ob x (e.backward.obj (e.forward.obj x))
      (C.isotoid x (e.backward.obj (e.forward.obj x)) (e.unit-source x)))) ;

 backward-faithful (x y : D.pre.ob) (f g : D.pre.hom x y)
  (p : Id (C.pre.hom (e.backward.obj x) (e.backward.obj y)) (e.backward.map x y f) (e.backward.map x y g)) :
  Id (D.pre.hom x y) f g =
  AD.cancel-l (e.unit-target y)
   (H.transH (H.symH (e.target-natural x y f))
    (H.transH (AD.right (H.apH (e.forward.map (e.backward.obj x) (e.backward.obj y)) p) (e.unit-target x).1)
     (e.target-natural x y g))) ;

 hom-inverse (x y : C.pre.ob) (g : D.pre.hom (e.forward.obj x) (e.forward.obj y)) : C.pre.hom x y =
  AC.cmp (e.unit-source y).2.1 (AC.cmp (e.backward.map (e.forward.obj x) (e.forward.obj y) g) (e.unit-source x).1) ;
 inverse-forward (x y : C.pre.ob) (f : C.pre.hom x y) :
  Id (C.pre.hom x y) (hom-inverse x y (e.forward.map x y f)) f =
  H.transH (AC.left (e.unit-source y).2.1 (e.source-natural x y f)) (AC.undo-l (e.unit-source y) f) ;
 forward-inverse (x y : C.pre.ob) (g : D.pre.hom (e.forward.obj x) (e.forward.obj y)) :
  Id (D.pre.hom (e.forward.obj x) (e.forward.obj y)) (e.forward.map x y (hom-inverse x y g)) g =
  backward-faithful (e.forward.obj x) (e.forward.obj y) (e.forward.map x y (hom-inverse x y g)) g
   (AC.cancel-r (e.unit-source x)
    (H.transH (e.source-natural x y (hom-inverse x y g))
     (AC.undo-l (AC.iso-inv (e.unit-source y))
      (AC.cmp (e.backward.map (e.forward.obj x) (e.forward.obj y) g) (e.unit-source x).1)))) ;
 hom-equivalence (x y : C.pre.ob) : P.Equiv (C.pre.hom x y) (D.pre.hom (e.forward.obj x) (e.forward.obj y)) =
  (e.forward.map x y,
   P.qinv (C.pre.hom x y) (D.pre.hom (e.forward.obj x) (e.forward.obj y))
    (e.forward.map x y) (hom-inverse x y) (forward-inverse x y) (inverse-forward x y)) ;
} ;
