-- Linearity over a power localisation is detected over the original ring.
-- Let B be an existing elementary localisation of A at f. For two actual
-- B-modules, an A-linear map between their restrictions of scalars is
-- already B-linear. Represent r in B by phi(s)*r=phi(a), with s a power
-- of f. Multiplying both sides of the proposed scalar equation by phi(s)
-- reduces it to A-linearity and the displayed fraction equation. Since
-- phi(s) is a unit, its module action cancels. Fraction choices are
-- eliminated only into equality in the target set. The promoted map has
-- exactly the original underlying function and additive equation.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module RH = RingHom[l] ; module RM = RingMaps[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (f : A.R)
 (B : CRing) (setB : Pr.isSet B.R) (phi : RH.Hom A B)
 (elementary : Bridge[l].Over[A,f].LocH.Elementary B phi) {
 module Br = Bridge[l].Over[A,f] ;
 module Restricted = MM.RestrictScalars[A,B,phi] ;
 module Between (X Y : SM.Over[B].Module)
  (q : MM.Between[A,A,RH.identity A,Restricted.Of[X].restricted,Restricted.Of[Y].restricted].Hom) {
  module Source = Restricted.Of[X] ; module Target = Restricted.Of[Y] ;
  module H = MM.Between[A,A,RH.identity A,Source.restricted,Target.restricted] ;
  module Maps = MM.Between[B,B,RH.identity B,X,Y] ;
  original-scalar (a : A.R) (x : X.M) :
   Id Y.M (H.map q (X.sm (RM.map phi a) x)) (Y.sm (RM.map phi a) (H.map q x)) =
   trans (ap (H.map q) (sym (Source.scalar-at a x)))
    (trans (H.map-scale q a x) (Target.scalar-at a (H.map q x))) ;
  module Fraction (r : B.R) (rep : Br.LocH.Fraction B phi r) {
   module Action = SerreModuleBasicRestrictions[l].UnitAction[B,Y,RM.map phi (Br.LocH.den rep),
    Br.LocH.inverts elementary (Br.LocH.den rep) (Br.LocH.den-in rep)] ;
   clears (M : SM.Over[B].Module) (x : M.M) :
    Id M.M (M.sm (RM.map phi (Br.LocH.den rep)) (M.sm r x)) (M.sm (RM.map phi (Br.LocH.num rep)) x) =
    trans (M.smA (RM.map phi (Br.LocH.den rep)) r x)
     (ap (\ b -> M.sm b x) (Br.LocH.eqn rep)) ;
   multiplied (x : X.M) : Id Y.M
    (Y.sm (RM.map phi (Br.LocH.den rep)) (H.map q (X.sm r x)))
    (Y.sm (RM.map phi (Br.LocH.den rep)) (Y.sm r (H.map q x))) =
    trans (sym (original-scalar (Br.LocH.den rep) (X.sm r x)))
     (trans (ap (H.map q) (clears X x))
      (trans (original-scalar (Br.LocH.num rep) x) (sym (clears Y (H.map q x))))) ;
   equation (x : X.M) : Id Y.M (H.map q (X.sm r x)) (Y.sm r (H.map q x)) =
    Iso[l].injective Y.M Y.M (Y.sm (RM.map phi (Br.LocH.den rep))) Action.equiv _ _ (multiplied x) ;
  } ;
  scalar (r : B.R) (x : X.M) : Id Y.M (H.map q (X.sm r x)) (Y.sm r (H.map q x)) =
   Tr.Trunc[Br.LocH.Fraction B phi r].induction @l
    (\ t -> Id Y.M (H.map q (X.sm r x)) (Y.sm r (H.map q x)))
    (\ t -> Y.setM _ _) (\ rep -> Fraction[r,rep].equation x) (Br.LocH.fractions elementary r) ;
  linear : Maps.Hom = new Maps.Hom[H.map q,H.map-add q,scalar] ;
  linear-at (x : X.M) : Id Y.M (Maps.map linear x) (H.map q x) = refl (H.map q x) ;
  opaque linear ;
 } ;
} ;
