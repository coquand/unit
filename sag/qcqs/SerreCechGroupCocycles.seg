-- Cech cocycles form a module over global functions.
-- Addition and negatives preserve the triple-overlap equation by
-- rearrangement and additivity of restriction. Scalar multiplication
-- preserves it because both restriction composites of a global scalar
-- agree. The linear coboundary therefore lifts to this cocycle module.
-- This is the source of the abelian group structure on the H1 quotient.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module DL = DistLattice[l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module MS = SerreModuleSheaf[l] ;
module On (L : DL.DLat) (G : RingedLattice[l].On[L].Presheaf)
 (M : MS.On[L,G].ModuleSheaf) (n : Nat) (as : Fin n -> L.L) {
 module Z = SerreCechCocycles[l].On[L,G,M,n,as] ;
 module C = Z.C ; module O = Z.O ;
 module GO = RingedLattice[l].On[L].Of[G] ;
 module Triple (i j k : Fin n) {
  module T = Z.Triple[i,j,k] ;
  module Laws = SM.Over[G.ring T.domain].Laws[M.presheaf.module-at T.domain] ;
  module Additive = SerreCechAlgebra[l].Over[G.ring T.domain,M.presheaf.module-at T.domain] ;
  add-law (c d : Z.Cocycle) : T.Law (C.C1.product.madd (Z.value c) (Z.value d)) =
   trans (cong2 (M.presheaf.module-at T.domain).M (M.presheaf.module-at T.domain).madd _ _ _ _
    (C.MO.res-add T.domain (C.overlap i j) T.ij (Z.value c i j) (Z.value d i j))
    (C.MO.res-add T.domain (C.overlap j k) T.jk (Z.value c j k) (Z.value d j k)))
    (trans (Laws.swap-four
     (C.MO.restrict T.domain (C.overlap i j) T.ij (Z.value c i j))
     (C.MO.restrict T.domain (C.overlap i j) T.ij (Z.value d i j))
     (C.MO.restrict T.domain (C.overlap j k) T.jk (Z.value c j k))
     (C.MO.restrict T.domain (C.overlap j k) T.jk (Z.value d j k)))
     (trans (cong2 (M.presheaf.module-at T.domain).M (M.presheaf.module-at T.domain).madd _ _ _ _
      (Z.law c i j k) (Z.law d i j k))
      (sym (C.MO.res-add T.domain (C.overlap i k) T.ik (Z.value c i k) (Z.value d i k))))) ;
  neg-law (c : Z.Cocycle) : T.Law (C.C1.product.mneg (Z.value c)) =
   trans (cong2 (M.presheaf.module-at T.domain).M (M.presheaf.module-at T.domain).madd _ _ _ _
    (C.MO.res-neg T.domain (C.overlap i j) T.ij (Z.value c i j))
    (C.MO.res-neg T.domain (C.overlap j k) T.jk (Z.value c j k)))
    (trans (sym (Additive.neg-add
     (C.MO.restrict T.domain (C.overlap i j) T.ij (Z.value c i j))
     (C.MO.restrict T.domain (C.overlap j k) T.jk (Z.value c j k))))
     (trans (ap (M.presheaf.module-at T.domain).mneg (Z.law c i j k))
      (sym (C.MO.res-neg T.domain (C.overlap i k) T.ik (Z.value c i k))))) ;
 } ;
 scalar-res (a b : L.L) (k : O.Le a b) (r : (G.ring L.top).R) (x : (M.presheaf.module-at b).M) :
  Id (M.presheaf.module-at a).M
   (C.MO.restrict a b k ((M.presheaf.module-at b).sm (GO.restrict b L.top (O.le-top b) r) x))
   ((M.presheaf.module-at a).sm (GO.restrict a L.top (O.le-top a) r) (C.MO.restrict a b k x)) =
  trans (C.MO.res-scale a b k (GO.restrict b L.top (O.le-top b) r) x)
   (ap (\ s -> (M.presheaf.module-at a).sm s (C.MO.restrict a b k x))
    (G.res-comp a b L.top k (O.le-top b) (O.le-top a) r)) ;
 scalar-law (r : (G.ring L.top).R) (c : Z.Cocycle) : Z.CocycleLaw (C.C1.product.sm r (Z.value c)) = \ i j k ->
  trans (cong2 (M.presheaf.module-at Z.Triple[i,j,k].domain).M (M.presheaf.module-at Z.Triple[i,j,k].domain).madd _ _ _ _
   (scalar-res Z.Triple[i,j,k].domain (C.overlap i j) Z.Triple[i,j,k].ij r (Z.value c i j))
   (scalar-res Z.Triple[i,j,k].domain (C.overlap j k) Z.Triple[i,j,k].jk r (Z.value c j k)))
   (trans (sym ((M.presheaf.module-at Z.Triple[i,j,k].domain).smD
    (GO.restrict Z.Triple[i,j,k].domain L.top (O.le-top Z.Triple[i,j,k].domain) r)
    (C.MO.restrict Z.Triple[i,j,k].domain (C.overlap i j) Z.Triple[i,j,k].ij (Z.value c i j))
    (C.MO.restrict Z.Triple[i,j,k].domain (C.overlap j k) Z.Triple[i,j,k].jk (Z.value c j k))))
    (trans (ap ((M.presheaf.module-at Z.Triple[i,j,k].domain).sm
     (GO.restrict Z.Triple[i,j,k].domain L.top (O.le-top Z.Triple[i,j,k].domain) r)) (Z.law c i j k))
     (sym (scalar-res Z.Triple[i,j,k].domain (C.overlap i k) Z.Triple[i,j,k].ik r (Z.value c i k))))) ;
 add (c d : Z.Cocycle) : Z.Cocycle = (C.C1.product.madd (Z.value c) (Z.value d),\ i j k -> Triple[i,j,k].add-law c d) ;
 negative (c : Z.Cocycle) : Z.Cocycle = (C.C1.product.mneg (Z.value c),\ i j k -> Triple[i,j,k].neg-law c) ;
 scale (r : (G.ring L.top).R) (c : Z.Cocycle) : Z.Cocycle = (C.C1.product.sm r (Z.value c),scalar-law r c) ;
 add-value (c d : Z.Cocycle) : Id C.C1.Carrier (Z.value (add c d)) (C.C1.product.madd (Z.value c) (Z.value d)) = refl (C.C1.product.madd (Z.value c) (Z.value d)) ;
 negative-value (c : Z.Cocycle) : Id C.C1.Carrier (Z.value (negative c)) (C.C1.product.mneg (Z.value c)) = refl (C.C1.product.mneg (Z.value c)) ;
 scale-value (r : (G.ring L.top).R) (c : Z.Cocycle) : Id C.C1.Carrier (Z.value (scale r c)) (C.C1.product.sm r (Z.value c)) = refl (C.C1.product.sm r (Z.value c)) ;
 cocycle-module : SM.Over[G.ring L.top].Module = new SM.Over[G.ring L.top].Module[
  Z.Cocycle,Z.set,Z.zero-cocycle,add,negative,
  \ c d e -> Z.ext _ _ (C.C1.product.maddA (Z.value c) (Z.value d) (Z.value e)),
  \ c d -> Z.ext _ _ (C.C1.product.maddC (Z.value c) (Z.value d)),
  \ c -> Z.ext _ _ (trans (ap (C.C1.product.madd (Z.value c)) Z.zero-cocycle-value) (C.C1.product.maddZ (Z.value c))),
  \ c -> Z.ext _ _ (trans (C.C1.product.maddN (Z.value c)) (sym Z.zero-cocycle-value)),scale,
  \ r s c -> Z.ext _ _ (C.C1.product.smA r s (Z.value c)),
  \ c -> Z.ext _ _ (C.C1.product.smO (Z.value c)),
  \ r c d -> Z.ext _ _ (C.C1.product.smD r (Z.value c) (Z.value d)),
  \ r s c -> Z.ext _ _ (C.C1.product.smE r s (Z.value c))] ;
 module Maps = MM.Between[G.ring L.top,G.ring L.top,RingHom[l].identity (G.ring L.top),C.C0.product,cocycle-module] ;
 coboundary : Maps.Hom = new Maps.Hom[
  Z.boundary,
  \ b c -> Z.ext _ _ (trans (Z.boundary-value (C.C0.product.madd b c))
   (trans (C.additive b c) (sym (cong2 C.C1.Carrier C.C1.product.madd _ _ _ _ (Z.boundary-value b) (Z.boundary-value c))))),
  \ r b -> Z.ext _ _ (trans (Z.boundary-value (C.C0.product.sm r b))
   (trans (C.scalar r b) (sym (ap (C.C1.product.sm r) (Z.boundary-value b)))))] ;
 coboundary-value (b : C.C0.Carrier) : Id C.C1.Carrier (Z.value (Maps.map coboundary b)) (C.delta b) = Z.boundary-value b ;
 opaque coboundary ;
} ;
