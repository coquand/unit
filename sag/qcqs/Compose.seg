-- Identity and composition of maps of ringed lattices (DESIGN.md, Next 1).
--
-- The identity of (L, F): the identity lattice map and identity ring maps;
--  it is local (D_u s <= D_u s) and an isomorphism.
-- The composite of pi : (L, F) -> (M, G) and rho : (M, G) -> (N, H): the
--  lattice map rho . pi and the ring maps rho#_(pi u) . pi#_u.  It commutes
--  with restriction: restricting rho#(pi# x) from rho(pi v) to rho(pi u) is
--  rho# of the restriction of pi# x from pi v to pi u (rho natural), which
--  is rho#(pi#(x|u)) (pi natural); the witness of rho(pi u) <= rho(pi v) is
--  irrelevant.
-- Lemma (local).  If pi and rho are local, so is rho . pi:
--  D_(rho pi u)(rho# pi# s) <= rho(D_(pi u)(pi# s)) <= rho(pi(D_u s)).
-- Lemma (iso).  If pi and rho are isomorphisms, so is rho . pi: composites
--  of equivalences.
-- Lemma (assoc).  (rho . pi) . sigma = rho . (pi . sigma): the lattice
--  maps agree pointwise and the ring maps are equal at every u, by
--  definition (MapEquality.ext, restriction along u <= u being the identity).
-- Lemma (inverse).  If rho . pi and pi . rho are isomorphisms, so is pi.
--  Lattice: two out of six for pi, rho, pi.  Ring maps at u: two out of six
--  for pi#_u : F(u) -> G(pi u), rho#_(pi u) : G(pi u) -> F(rho pi u) and
--  pi#_(rho pi u), whose composites are (rho . pi)#_u and
--  (pi . rho)#_(pi u).
-- The global component.  Gamma(rho) : F(top) -> G(top) is rho#_top followed
--  by restriction from rho top = top.  Lemma (functorial).  Gamma(rho . pi)
--  = Gamma(rho) . Gamma(pi):
--   (rho#(pi# x))|top = ((rho#(pi# x))|rho top)|top        (res-comp)
--                     = (rho#((pi# x)|top))|top            (rho natural).
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;

-- the identity
module Identity (L : DL.DLat) (F : RingedLattice[l].On[L].Presheaf) {
 module OL = DL.Order[L] ;
 module FO = RingedLattice[l].On[L].Of[F] ;
 module Mp = LocallyRinged[l].Maps[L,L,F,F] ;
 natural (u v : L.L) (k : OL.Le u v) (x : (F.ring v).R) :
  Id (F.ring u).R (FO.restrict u v (DL.JoinMaps[L,L,DL.identity L].monotone u v k) x) (FO.restrict u v k x) =
  FO.res-irr u v (DL.JoinMaps[L,L,DL.identity L].monotone u v k) k x ;
 identity : Mp.Ringed = new Mp.Ringed[DL.identity L,\ u -> RH.identity (F.ring u),natural] ;
 -- restricting a section of the identity to its own open
 fixes (u : L.L) (k : OL.Le u (DL.hmap identity.lat u)) (x : (F.ring u).R) :
  Id (F.ring u).R (FO.restrict u (DL.hmap identity.lat u) k (map (identity.sharp u) x)) x = F.res-id u k x ;
 local (DF : InvOpen[l].On[L].Of[F].InvMap) : Mp.Of[identity,DF,DF].IsLocal = \ u s ->
  OL.le-refl (LocallyRinged[l].On[L].Laws[F,DF].d u s) ;
 iso : Iso[l].Maps[L,L,F,F].IsIso identity =
  (Pr.qinv L.L L.L (\ x -> x) (\ x -> x) (\ x -> refl x) (\ x -> refl x),
   \ u -> Pr.qinv (F.ring u).R (F.ring u).R (\ x -> x) (\ x -> x) (\ x -> refl x) (\ x -> refl x)) ;
} ;

-- the global component of a map
module Gamma (L M : DL.DLat) (F : RingedLattice[l].On[L].Presheaf) (G : RingedLattice[l].On[M].Presheaf)
 (rho : LocallyRinged[l].Maps[L,M,F,G].Ringed) {
 module OM = DL.Order[M] ;
 top-le : OM.Le M.top (DL.hmap rho.lat L.top) = OM.le-of-eq M.top (DL.hmap rho.lat L.top) (sym (DL.hmap-top rho.lat)) ;
 gamma : RH.Hom (F.ring L.top) (G.ring M.top) =
  RH.compose (F.ring L.top) (G.ring (DL.hmap rho.lat L.top)) (G.ring M.top) (G.res M.top (DL.hmap rho.lat L.top) top-le)
   (rho.sharp L.top) ;
} ;

-- composites
module Maps (L M N : DL.DLat) (F : RingedLattice[l].On[L].Presheaf) (G : RingedLattice[l].On[M].Presheaf)
 (H : RingedLattice[l].On[N].Presheaf) {
 module OL = DL.Order[L] ;
 module ON = DL.Order[N] ;
 module HO = RingedLattice[l].On[N].Of[H] ;
 module P = LocallyRinged[l].Maps[L,M,F,G] ;
 module Q = LocallyRinged[l].Maps[M,N,G,H] ;
 module PQ = LocallyRinged[l].Maps[L,N,F,H] ;
 module Of (rho : Q.Ringed) (pi : P.Ringed) {
  module PL = DL.JoinMaps[L,M,pi.lat] ;
  module QL = DL.JoinMaps[M,N,rho.lat] ;
  lat : DL.Hom L N = DL.compose L M N rho.lat pi.lat ;
  -- typed at rho(pi u), the image of u by definition
  sharp (u : L.L) : RH.Hom (F.ring u) (H.ring (DL.hmap rho.lat (DL.hmap pi.lat u))) =
   RH.compose (F.ring u) (G.ring (DL.hmap pi.lat u)) (H.ring (DL.hmap rho.lat (DL.hmap pi.lat u)))
    (rho.sharp (DL.hmap pi.lat u)) (pi.sharp u) ;
  sharp-map (u : L.L) (x : (F.ring u).R) :
   Id (H.ring (DL.hmap rho.lat (DL.hmap pi.lat u))).R (map (sharp u) x) (map (rho.sharp (DL.hmap pi.lat u)) (map (pi.sharp u) x)) =
   refl (map (rho.sharp (DL.hmap pi.lat u)) (map (pi.sharp u) x)) ;
  natural (u v : L.L) (k : OL.Le u v) (x : (F.ring v).R) :
   Id (H.ring (DL.hmap rho.lat (DL.hmap pi.lat u))).R
    (HO.restrict (DL.hmap rho.lat (DL.hmap pi.lat u)) (DL.hmap rho.lat (DL.hmap pi.lat v)) (DL.JoinMaps[L,N,lat].monotone u v k)
      (map (sharp v) x))
    (map (sharp u) (map (F.res u v k) x)) = calc (H.ring (DL.hmap rho.lat (DL.hmap pi.lat u))).R {
   HO.restrict (DL.hmap rho.lat (DL.hmap pi.lat u)) (DL.hmap rho.lat (DL.hmap pi.lat v)) (DL.JoinMaps[L,N,lat].monotone u v k)
     (map (sharp v) x)
    =< HO.res-irr (DL.hmap rho.lat (DL.hmap pi.lat u)) (DL.hmap rho.lat (DL.hmap pi.lat v)) (DL.JoinMaps[L,N,lat].monotone u v k)
        (QL.monotone (DL.hmap pi.lat u) (DL.hmap pi.lat v) (PL.monotone u v k)) (map (sharp v) x)
     > HO.restrict (DL.hmap rho.lat (DL.hmap pi.lat u)) (DL.hmap rho.lat (DL.hmap pi.lat v))
        (QL.monotone (DL.hmap pi.lat u) (DL.hmap pi.lat v) (PL.monotone u v k)) (map (sharp v) x)
    =< ap (HO.restrict (DL.hmap rho.lat (DL.hmap pi.lat u)) (DL.hmap rho.lat (DL.hmap pi.lat v))
         (QL.monotone (DL.hmap pi.lat u) (DL.hmap pi.lat v) (PL.monotone u v k))) (sharp-map v x)
     > HO.restrict (DL.hmap rho.lat (DL.hmap pi.lat u)) (DL.hmap rho.lat (DL.hmap pi.lat v))
        (QL.monotone (DL.hmap pi.lat u) (DL.hmap pi.lat v) (PL.monotone u v k))
        (map (rho.sharp (DL.hmap pi.lat v)) (map (pi.sharp v) x))
    =< rho.natural (DL.hmap pi.lat u) (DL.hmap pi.lat v) (PL.monotone u v k) (map (pi.sharp v) x)
     > map (rho.sharp (DL.hmap pi.lat u)) (map (G.res (DL.hmap pi.lat u) (DL.hmap pi.lat v) (PL.monotone u v k)) (map (pi.sharp v) x))
    =< ap (map (rho.sharp (DL.hmap pi.lat u))) (pi.natural u v k x)
     > map (rho.sharp (DL.hmap pi.lat u)) (map (pi.sharp u) (map (F.res u v k) x))
    =< sym (sharp-map u (map (F.res u v k) x)) > map (sharp u) (map (F.res u v k) x) } ;
  composite : PQ.Ringed = new PQ.Ringed[lat,sharp,natural] ;
  -- a section of the composite, restricted, by definition
  restrict-composite (m : N.L) (u : L.L) (k : ON.Le m (DL.hmap lat u)) (k2 : ON.Le m (DL.hmap rho.lat (DL.hmap pi.lat u)))
   (x : (F.ring u).R) :
   Id (H.ring m).R (HO.restrict m (DL.hmap lat u) k (map (composite.sharp u) x))
    (HO.restrict m (DL.hmap rho.lat (DL.hmap pi.lat u)) k2 (map (rho.sharp (DL.hmap pi.lat u)) (map (pi.sharp u) x))) =
   HO.res-irr m (DL.hmap rho.lat (DL.hmap pi.lat u)) k k2 (map (rho.sharp (DL.hmap pi.lat u)) (map (pi.sharp u) x)) ;

  -- the global component of the composite
  module GP = Gamma[L,M,F,G,pi] ;
  module GR = Gamma[M,N,G,H,rho] ;
  module GC = Gamma[L,N,F,H,composite] ;
  mono : ON.Le (DL.hmap rho.lat M.top) (DL.hmap rho.lat (DL.hmap pi.lat L.top)) =
   QL.monotone M.top (DL.hmap pi.lat L.top) GP.top-le ;
  top-p : ON.Le N.top (DL.hmap rho.lat (DL.hmap pi.lat L.top)) =
   ON.le-trans N.top (DL.hmap rho.lat M.top) (DL.hmap rho.lat (DL.hmap pi.lat L.top)) GR.top-le mono ;
  gamma-composite (x : (F.ring L.top).R) : Id (H.ring N.top).R (map GC.gamma x) (map GR.gamma (map GP.gamma x)) =
   calc (H.ring N.top).R {
    map GC.gamma x
     =< restrict-composite N.top L.top GC.top-le top-p x
      > HO.restrict N.top (DL.hmap rho.lat (DL.hmap pi.lat L.top)) top-p (map (rho.sharp (DL.hmap pi.lat L.top)) (map (pi.sharp L.top) x))
     =< sym (H.res-comp N.top (DL.hmap rho.lat M.top) (DL.hmap rho.lat (DL.hmap pi.lat L.top)) GR.top-le mono top-p
          (map (rho.sharp (DL.hmap pi.lat L.top)) (map (pi.sharp L.top) x)))
      > HO.restrict N.top (DL.hmap rho.lat M.top) GR.top-le
         (HO.restrict (DL.hmap rho.lat M.top) (DL.hmap rho.lat (DL.hmap pi.lat L.top)) mono
           (map (rho.sharp (DL.hmap pi.lat L.top)) (map (pi.sharp L.top) x)))
     =< ap (HO.restrict N.top (DL.hmap rho.lat M.top) GR.top-le) (rho.natural M.top (DL.hmap pi.lat L.top) GP.top-le (map (pi.sharp L.top) x))
      > HO.restrict N.top (DL.hmap rho.lat M.top) GR.top-le
         (map (rho.sharp M.top) (map (G.res M.top (DL.hmap pi.lat L.top) GP.top-le) (map (pi.sharp L.top) x)))
     =< refl (map GR.gamma (map GP.gamma x)) > map GR.gamma (map GP.gamma x) } ;

  -- composites of local maps are local
  module Local (DF : InvOpen[l].On[L].Of[F].InvMap) (DG : InvOpen[l].On[M].Of[G].InvMap) (DH : InvOpen[l].On[N].Of[H].InvMap)
   (pi-local : P.Of[pi,DF,DG].IsLocal) (rho-local : Q.Of[rho,DG,DH].IsLocal) {
   module LF = LocallyRinged[l].On[L].Laws[F,DF] ;
   module LG = LocallyRinged[l].On[M].Laws[G,DG] ;
   module LH = LocallyRinged[l].On[N].Laws[H,DH] ;
   local : PQ.Of[composite,DF,DH].IsLocal = \ u s ->
    ON.le-trans (LH.d (DL.hmap rho.lat (DL.hmap pi.lat u)) (map (rho.sharp (DL.hmap pi.lat u)) (map (pi.sharp u) s)))
     (DL.hmap rho.lat (LG.d (DL.hmap pi.lat u) (map (pi.sharp u) s))) (DL.hmap lat (LF.d u s))
     (rho-local (DL.hmap pi.lat u) (map (pi.sharp u) s))
     (QL.monotone (LG.d (DL.hmap pi.lat u) (map (pi.sharp u) s)) (DL.hmap pi.lat (LF.d u s)) (pi-local u s)) ;
  } ;

  -- composites of isomorphisms are isomorphisms
  iso (pi-iso : Iso[l].Maps[L,M,F,G].IsIso pi) (rho-iso : Iso[l].Maps[M,N,G,H].IsIso rho) : Iso[l].Maps[L,N,F,H].IsIso composite =
   (Iso[l].equiv-compose L.L M.L N.L (DL.hmap rho.lat) (DL.hmap pi.lat) rho-iso.1 pi-iso.1,
    \ u -> Iso[l].equiv-compose (F.ring u).R (G.ring (DL.hmap pi.lat u)).R (H.ring (DL.hmap rho.lat (DL.hmap pi.lat u))).R
     (map (rho.sharp (DL.hmap pi.lat u))) (map (pi.sharp u)) (rho-iso.2 (DL.hmap pi.lat u)) (pi-iso.2 u)) ;
 } ;
} ;

-- pi is an isomorphism when both composites with rho are
module Inverse (L M : DL.DLat) (F : RingedLattice[l].On[L].Presheaf) (G : RingedLattice[l].On[M].Presheaf)
 (pi : LocallyRinged[l].Maps[L,M,F,G].Ringed) (rho : LocallyRinged[l].Maps[M,L,G,F].Ringed)
 (rp : Iso[l].Maps[L,L,F,F].IsIso (Maps[L,M,L,F,G,F].Of[rho,pi].composite))
 (pr : Iso[l].Maps[M,M,G,G].IsIso (Maps[M,L,M,G,F,G].Of[pi,rho].composite)) {
 p (u : L.L) : M.L = DL.hmap pi.lat u ;
 iso : Iso[l].Maps[L,M,F,G].IsIso pi =
  (Iso[l].TwoOfSix[L.L,M.L,L.L,M.L,DL.hmap pi.lat,DL.hmap rho.lat,DL.hmap pi.lat,rp.1,pr.1].first,
   \ u -> Iso[l].TwoOfSix[(F.ring u).R,(G.ring (p u)).R,(F.ring (DL.hmap rho.lat (p u))).R,(G.ring (p (DL.hmap rho.lat (p u)))).R,
     map (pi.sharp u),map (rho.sharp (p u)),map (pi.sharp (DL.hmap rho.lat (p u))),rp.2 u,pr.2 (p u)].first) ;
} ;

-- associativity
module Assoc (K L M N : DL.DLat) (E : RingedLattice[l].On[K].Presheaf) (F : RingedLattice[l].On[L].Presheaf)
 (G : RingedLattice[l].On[M].Presheaf) (H : RingedLattice[l].On[N].Presheaf)
 (sigma : LocallyRinged[l].Maps[K,L,E,F].Ringed) (pi : LocallyRinged[l].Maps[L,M,F,G].Ringed)
 (rho : LocallyRinged[l].Maps[M,N,G,H].Ringed) {
 module ON = DL.Order[N] ;
 module EM = MapEquality[l].Maps[K,N,E,H] ;
 module PS = Maps[K,L,M,E,F,G].Of[pi,sigma] ;
 module RP = Maps[L,M,N,F,G,H].Of[rho,pi] ;
 module Left = Maps[K,M,N,E,G,H].Of[rho,PS.composite] ;
 module Right = Maps[K,L,N,E,F,H].Of[RP.composite,sigma] ;
 assoc : Id EM.Mp.Ringed Left.composite Right.composite =
  EM.ext Left.composite Right.composite
   (\ u -> refl (DL.hmap rho.lat (DL.hmap pi.lat (DL.hmap sigma.lat u))))
   (\ u -> ON.le-refl (DL.hmap rho.lat (DL.hmap pi.lat (DL.hmap sigma.lat u))))
   (\ u x -> H.res-id (DL.hmap rho.lat (DL.hmap pi.lat (DL.hmap sigma.lat u)))
     (ON.le-refl (DL.hmap rho.lat (DL.hmap pi.lat (DL.hmap sigma.lat u))))
     (map (rho.sharp (DL.hmap pi.lat (DL.hmap sigma.lat u))) (map (pi.sharp (DL.hmap sigma.lat u)) (map (sigma.sharp u) x)))) ;
} ;
