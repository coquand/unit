-- The existing BasePoints algebra tests, with named equality interfaces.
-- Pointwise commuting equations are propositions and give an equality
-- of structure ring maps by extensionality.  Algebra maps with equal
-- underlying ring maps are equal.  A ring map has a canonical lift with
-- target structure h iota; a specified equality h iota=kappa gives its
-- lift to that target instead.  These are the tests of §1--2 of the note.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module T = AffineTests[l] ;
module RH = RingHom[l] ;
module RM = RingMaps[l] ;
module Over (K : T.Test) {
 module BP = BasePoints[l].Over[K] ;
 Commutes (A B : BP.Algebra) (h : RH.Hom (BP.test A).ring (BP.test B).ring) : U l =
  (r : K.ring.R) -> Id (BP.test B).ring.R (RM.map h (RM.map (BP.iota A) r)) (RM.map (BP.iota B) r) ;
 commutes-prop (A B : BP.Algebra) (h : RH.Hom (BP.test A).ring (BP.test B).ring) : Pr.isProp (Commutes A B h) =
  FE.isProp-Pi K.ring.R (\ r -> Id (BP.test B).ring.R (RM.map h (RM.map (BP.iota A) r)) (RM.map (BP.iota B) r))
   (\ r -> (BP.test B).carrier-set _ _) ;
 ext (A B : BP.Algebra) (f g : BP.Hom A B)
  (p : Id (RH.Hom (BP.test A).ring (BP.test B).ring) (BP.ring-map f) (BP.ring-map g)) : Id (BP.Hom A B) f g =
  Pr.Sigma-eq (RH.Hom (BP.test A).ring (BP.test B).ring) (Commutes A B) f.1 g.1 f.2 g.2 p (commutes-prop A B g.1) ;
 ext-at (A B : BP.Algebra) (f g : BP.Hom A B)
  (e : (a : (BP.test A).ring.R) -> Id (BP.test B).ring.R (RM.map (BP.ring-map f) a) (RM.map (BP.ring-map g) a)) : Id (BP.Hom A B) f g =
  ext A B f g (RH.Properties[(BP.test A).ring,(BP.test B).ring,(BP.test B).carrier-set].ext (BP.ring-map f) (BP.ring-map g) e) ;
 compose-at (A B C : BP.Algebra) (g : BP.Hom B C) (f : BP.Hom A B) (a : (BP.test A).ring.R) :
  Id (BP.test C).ring.R (RM.map (BP.ring-map (BP.compose-hom A B C g f)) a)
   (RM.map (BP.ring-map g) (RM.map (BP.ring-map f) a)) = refl (RM.map (BP.ring-map g) (RM.map (BP.ring-map f) a)) ;
 set (A B : BP.Algebra) : Pr.isSet (BP.Hom A B) = Pr.isSet-Sigma (RH.Hom (BP.test A).ring (BP.test B).ring) (Commutes A B)
  RH.Properties[(BP.test A).ring,(BP.test B).ring,(BP.test B).carrier-set].set
  (\ h -> Pr.prop-to-set (Commutes A B h) (commutes-prop A B h)) ;
 push (B C : T.Test) (h : RH.Hom B.ring C.ring) (i : RH.Hom K.ring B.ring) : RH.Hom K.ring C.ring = RH.compose K.ring B.ring C.ring h i ;
 push-at (B C : T.Test) (h : RH.Hom B.ring C.ring) (i : RH.Hom K.ring B.ring) (r : K.ring.R) :
  Id C.ring.R (RM.map (push B C h i) r) (RM.map h (RM.map i r)) = refl (RM.map h (RM.map i r)) ;
 canonical (B C : T.Test) (h : RH.Hom B.ring C.ring) (i : RH.Hom K.ring B.ring) : BP.Hom (BP.algebra B i) (BP.algebra C (push B C h i)) =
  (h,\ r -> refl (RM.map h (RM.map i r))) ;
 lift (B C : T.Test) (h : RH.Hom B.ring C.ring) (i : RH.Hom K.ring B.ring) (j : RH.Hom K.ring C.ring)
  (p : Id (RH.Hom K.ring C.ring) (push B C h i) j) : BP.Hom (BP.algebra B i) (BP.algebra C j) =
  (h,\ r -> ap (\ f -> RM.map f r) p) ;
 commuting-path (A B : BP.Algebra) (h : BP.Hom A B) :
  Id (RH.Hom K.ring (BP.test B).ring) (push (BP.test A) (BP.test B) (BP.ring-map h) (BP.iota A)) (BP.iota B) =
  RH.Properties[K.ring,(BP.test B).ring,(BP.test B).carrier-set].ext _ _ (BP.commutes h) ;
 opaque commuting-path ;
} ;
