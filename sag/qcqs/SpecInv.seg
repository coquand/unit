-- The invertibility support of Spec A (DESIGN.md, step 4, stage 2;
-- zeuner1 Example 3.9).  Over the family f_g : A -> R_g of Sections, with
-- O the structure sheaf (Sheaf.structure).
--
-- Lemma (Units).  s in O(D h) is a unit iff its value eval s in R_h is:
--  evaluation is a ring map, and an isomorphism (BasicOpen.At.iso), so the
--  section of an inverse of eval s is an inverse of s.
-- Lemma (Fraction).  Let x in R_g with f_g(s) x = f_g(a), s a power of g,
--  and D h <= D g.  Then rho(x) is a unit of R_h iff D h <= D(g a).
--  Apply rho: f_h(s) rho(x) = f_h(a), and f_h(s) is a unit (Restriction).
--  So rho(x) is a unit iff f_h(a) is, iff D h <= D a (Bridge), iff
--  D h <= D g /\ D a = D(g a).
-- Theorem (Basic).  For s in O(D g) and a fraction a/g^n of eval s, D(g a)
--  is the invertibility open of s.  By the basis criterion (InvOpen) with
--  the basic opens D b (every open is merely presented): for D b <= D g,
--  s|D b is a unit iff eval(s|D b) = rho(eval s) is (Units, naturality),
--  iff D b <= D(g a) (Fraction).  Since s merely has a fraction and
--  invertibility opens form a proposition, every s in O(D g) has one,
--  independent of the fraction (on-fraction).
-- Theorem (General).  Every s in O(u) has an invertibility open: merely
--  u = D a_1 \/ .. \/ D a_n, and the join of the invertibility opens of the
--  s|D a_j is one (InvOpen.Join).  So O has an invertibility map.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module Over (A : CRing) (Loc : A.R -> CRing) (set : (g : A.R) -> Pr.isSet (Loc g).R)
 (f : (g : A.R) -> RH.Hom A (Loc g))
 (el : (g : A.R) -> Bridge[l].Over[A,g].LocH.Elementary (Loc g) (f g)) {
 open A ; open Radical[l].Over[A] ;
 open ZariskiLattice[l].Over[A] ;
 module S = Sections[l].Over[A,Loc,set,f,el] ;
 module B = BasicOpen[l].Over[A,Loc,set,f,el] ;
 module Sh = Sheaf[l].Over[A,Loc,set,f,el] ;
 module Sp = Sup.Of[D,support] ;
 module IO = InvOpen[l].On[lattice].Of[Sh.structure] ;
 module IL = IO.Local[Sh.structure-sheaf] ;
 module Bs = IL.Basis[R,D] ;

 -- the units of O(D h) are those of R_h, through evaluation
 module Units (h : R) {
  module Bh = B.At[h] ;
  eval-injective (s t : S.Section (D h)) (e : Id (Loc h).R (Bh.eval s) (Bh.eval t)) : Id (S.Section (D h)) s t =
   trans (sym (Bh.extend-eval s)) (trans (ap Bh.extend e) (Bh.extend-eval t)) ;
  -- by definition, the unit section has value 1
  eval-one : Id (Loc h).R (Bh.eval S.Ops[D h].oneS) (Loc h).o = refl (Loc h).o ;
  to-loc (s : S.Section (D h)) (e : IO.Unit (D h) s) : RL[Loc h].unit (Bh.eval s) =
   AffineRing[l].unit-map (S.ring (D h)) (Loc h) Bh.evaluation s e ;
  from-loc (s : S.Section (D h)) (e : RL[Loc h].unit (Bh.eval s)) : IO.Unit (D h) s =
   (Bh.extend e.1,
    eval-injective (S.Ops[D h].mulS s (Bh.extend e.1)) S.Ops[D h].oneS (calc (Loc h).R {
     Bh.eval (S.Ops[D h].mulS s (Bh.extend e.1))
      =< S.Ops[D h].mul-at s (Bh.extend e.1) h Bh.gg > (Loc h).mul (Bh.eval s) (Bh.eval (Bh.extend e.1))
      =< ap ((Loc h).mul (Bh.eval s)) (Bh.eval-extend e.1) > (Loc h).mul (Bh.eval s) e.1
      =< e.2 > (Loc h).o
      =< sym eval-one > Bh.eval S.Ops[D h].oneS })) ;
 } ;

 -- D(g a) <= D g and D(g a) <= D a
 product-left (g a : R) : O.Le (D (mul g a)) (D g) =
  Pr.subst lattice.L (\ t -> O.Le t (D g)) _ _ (sym (Sp.at-mul g a)) (O.meet-left (D g) (D a)) ;
 product-right (g a : R) : O.Le (D (mul g a)) (D a) =
  Pr.subst lattice.L (\ t -> O.Le t (D a)) _ _ (sym (Sp.at-mul g a)) (O.meet-right (D g) (D a)) ;

 -- rho(x) is a unit of R_h iff D h <= D(g a), for a fraction a/s of x
 module Fraction (g : R) (x : (Loc g).R) (p : Bridge[l].Over[A,g].LocH.Fraction (Loc g) (f g) x)
  (h : R) (k : O.Le (D h) (D g)) {
  module LH = Bridge[l].Over[A,g].LocH ;
  module UH = AffineRing[l].Laws[Loc h,set h] ;
  module BA = Bridge[l].Over[A,h].At[Loc h,set h,f h,el h,LH.num p] ;
  y : (Loc h).R = map (S.rho g h k) x ;
  -- f_h(s) rho(x) = f_h(a)
  eqn-h : Id (Loc h).R ((Loc h).mul (map (f h) (LH.den p)) y) (map (f h) (LH.num p)) = calc (Loc h).R {
   (Loc h).mul (map (f h) (LH.den p)) y
    =< ap (\ t -> (Loc h).mul t y) (sym (S.rho-on g h k (LH.den p)))
     > (Loc h).mul (map (S.rho g h k) (map (f g) (LH.den p))) y
    =< sym (map-mul (S.rho g h k) (map (f g) (LH.den p)) x)
     > map (S.rho g h k) ((Loc g).mul (map (f g) (LH.den p)) x)
    =< ap (map (S.rho g h k)) (LH.eqn p) > map (S.rho g h k) (map (f g) (LH.num p))
    =< S.rho-on g h k (LH.num p) > map (f h) (LH.num p) } ;
  den-unit : RL[Loc h].unit (map (f h) (LH.den p)) = S.Rs.Pair[g,h,k].inverts (LH.den p) (LH.den-in p) ;
  num-unit (e : RL[Loc h].unit y) : RL[Loc h].unit (map (f h) (LH.num p)) =
   Pr.subst (Loc h).R (RL[Loc h].unit) _ _ eqn-h (UH.unit-product (map (f h) (LH.den p)) y den-unit e) ;
  unit-num (e : RL[Loc h].unit (map (f h) (LH.num p))) : RL[Loc h].unit y =
   UH.unit-right (map (f h) (LH.den p)) y (Pr.subst (Loc h).R (RL[Loc h].unit) _ _ (sym eqn-h) e) ;
  le-unit (e : RL[Loc h].unit y) : O.Le (D h) (D (mul g (LH.num p))) =
   Pr.subst lattice.L (\ t -> O.Le (D h) t) _ _ (sym (Sp.at-mul g (LH.num p)))
    (O.meet-glb (D g) (D (LH.num p)) (D h) k (BA.invertible-le (num-unit e))) ;
  unit-le (q : O.Le (D h) (D (mul g (LH.num p)))) : RL[Loc h].unit y =
   unit-num (BA.le-invertible (O.le-trans (D h) (D (mul g (LH.num p))) (D (LH.num p)) q (product-right g (LH.num p)))) ;
 } ;

 -- every open is merely a finite join of basic opens
 basis (w : lattice.L) : Tr.Trunc[Bs.Covered w].carrier =
  Tr.Trunc[Presentation w].induction @l (\ c -> Tr.Trunc[Bs.Covered w].carrier) (\ c -> Tr.Trunc[Bs.Covered w].proposition)
   (\ q -> Tr.Trunc[Bs.Covered w].inc (size (generators q),\ i -> gen (generators q) i,presents q)) (presented w) ;

 -- the invertibility open of s in O(D g) is D(g a), for a/g^n = eval s
 module Basic (g : R) (s : S.Section (D g)) {
  module LH = Bridge[l].Over[A,g].LocH ;
  x : (Loc g).R = B.At[g].eval s ;
  module At (p : LH.Fraction (Loc g) (f g) x) {
   v : lattice.L = D (mul g (LH.num p)) ;
   forward (b : R) (k : O.Le (D b) (D g)) (q : O.Le (D b) v) : IO.Unit (D b) (S.restrict (D b) (D g) k s) =
    Units[b].from-loc (S.restrict (D b) (D g) k s)
     (Pr.subst (Loc b).R (RL[Loc b].unit) (map (S.rho g b k) x) (B.At[b].eval (S.restrict (D b) (D g) k s))
       (sym (B.natural g b k s)) (Fraction[g,x,p,b,k].unit-le q)) ;
   backward (b : R) (k : O.Le (D b) (D g)) (e : IO.Unit (D b) (S.restrict (D b) (D g) k s)) : O.Le (D b) v =
    Fraction[g,x,p,b,k].le-unit
     (Pr.subst (Loc b).R (RL[Loc b].unit) (B.At[b].eval (S.restrict (D b) (D g) k s)) (map (S.rho g b k) x)
       (B.natural g b k s) (Units[b].to-loc (S.restrict (D b) (D g) k s) e)) ;
   is-open : IO.IsInvOpen (D g) s v =
    Bs.Criterion[basis,D g,s,v,product-left g (LH.num p),forward,backward].inv-open ;
  } ;
  inv-open : IO.InvOpen (D g) s =
   Tr.Trunc[LH.Fraction (Loc g) (f g) x].induction @l (\ c -> IO.InvOpen (D g) s) (\ c -> IO.inv-open-prop (D g) s)
    (\ p -> (At[p].v,At[p].is-open)) (LH.fractions (el g) x) ;
  -- independent of the fraction
  on-fraction (p : LH.Fraction (Loc g) (f g) x) : Id lattice.L (IO.open-of inv-open) (D (mul g (LH.num p))) =
   IO.unique (IO.is-inv-open inv-open) At[p].is-open ;
 } ;

 -- every section has an invertibility open
 module General (u : lattice.L) (s : S.Section u) {
  module At (q : Presentation u) {
   piece (i : Fin (size (generators q))) : S.Section (D (gen (generators q) i)) =
    S.restrict (D (gen (generators q) i)) u (gen-below q i) s ;
   opens (i : Fin (size (generators q))) : lattice.L = IO.open-of Basic[gen (generators q) i,piece i].inv-open ;
   is-open : IO.IsInvOpen u s (J.bigJ (size (generators q)) opens) =
    IL.Join[u,s,size (generators q),\ i -> D (gen (generators q) i),gen-below q,
     O.le-of-eq u _ (presents q),opens,\ i -> IO.is-inv-open Basic[gen (generators q) i,piece i].inv-open].inv-open ;
  } ;
  inv-open : IO.InvOpen u s =
   Tr.Trunc[Presentation u].induction @l (\ c -> IO.InvOpen u s) (\ c -> IO.inv-open-prop u s)
    (\ q -> (J.bigJ (size (generators q)) At[q].opens,At[q].is-open)) (presented u) ;
 } ;
 inv-map : IO.InvMap = \ u s -> General[u,s].inv-open ;
 -- later files use only that inv-map u s is an invertibility open
 opaque inv-map ;
} ;
