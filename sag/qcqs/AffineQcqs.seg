-- An affine locally ringed lattice is qcqs: its top open is affine by
-- TopOpen and AffineTransport, so the singleton cover by top is an affine
-- atlas.  In particular every affine test space is qcqs; its affineness
-- follows from AffineCriterion applied to its identity isomorphism.
level l ; open Ring[l] ; open Presentations[l] ;
module Tr = Truncation[l] ;
module Sp = Spaces[l] ;
module Op = OpenMaps[l] ;
module T = AffineTests[l] ;
module Over (X : Sp.Space) (affine : AffineCriterion[l].Over[X.lattice,X.structure].IsAffine) {
 module Q = Qcqs[l].Over[X.lattice,X.structure] ;
 module Top = TopOpen[l].Over[X] ;
 affine-top : Q.AffineOpen X.lattice.top =
  AffineTransport[l].Over[X.lattice,Top.Sl.lattice,X.structure,Top.Sl.restricted,Top.Sl.inclusion,Top.iso,affine].affine ;
 cover : Q.AffineCover = struct {
  count = suc zero ; opens = \ i -> X.lattice.top ; covers = X.lattice.joinB X.lattice.top ; affine = \ i -> affine-top } ;
 qcqs : Q.IsQcqs = Tr.Trunc[Q.AffineCover].inc cover ;
} ;
module TestSpace (A : T.Test) {
 module AX = AffineCriterion[l].Over[(T.space A).lattice,(T.space A).structure] ;
 module I = Compose[l].Identity[(T.space A).lattice,(T.space A).structure.sheaf] ;
 affine : AX.IsAffine = AX.Criterion[A.ring,A.carrier-set,T.At[A].A.Loc,T.At[A].A.set,T.At[A].A.inclusion,T.At[A].A.elementary,I.identity,I.iso].affine ;
 qcqs : Qcqs[l].Over[(T.space A).lattice,(T.space A).structure].IsQcqs = Over[T.space A,affine].qcqs ;
} ;
