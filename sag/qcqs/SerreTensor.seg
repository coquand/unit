-- The module freely generated by pairs, subject to the four bilinearity laws.
-- Representatives are lists of pure tensors. Quotient by the small proof
-- trees for the module and bilinearity equations and their congruence closure.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module SM = SerreModule[l] ; module B = SerreBilinear[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module Over (A : CRing) (M N : SM.Over[A].Module) {
 module S = SM.Over[A] ; module L = B.Over[A] ;
 Term : U l = List (M.M * N.M) ;
 single (x : M.M) (y : N.M) : Term = cons (x,y) nil ;
 plus : Term -> Term -> Term = split { nil -> \ q -> q ; cons xy p | ih -> \ q -> cons xy (ih q) } ;
 negative : Term -> Term = split { nil -> nil ; cons xy p | ih -> cons (M.mneg xy.1,xy.2) ih } ;
 scale (a : A.R) : Term -> Term = split { nil -> nil ; cons xy p | ih -> cons (M.sm a xy.1,xy.2) ih } ;
 data Rule : U l =
  assocR (p q r : Term) |
  commR (p q : Term) |
  zeroR (p : Term) |
  negativeR (p : Term) |
  scalar-assocR (a d : A.R) (p : Term) |
  scalar-unitR (p : Term) |
  scalar-distR (a : A.R) (p q : Term) |
  scalar-addR (a d : A.R) (p : Term) |
  left-addR (x x' : M.M) (y : N.M) |
  left-scaleR (a : A.R) (x : M.M) (y : N.M) |
  right-addR (x : M.M) (y y' : N.M) |
  right-scaleR (a : A.R) (x : M.M) (y : N.M) ;
 ends-rule : Rule -> Term * Term = split {
  assocR p q r -> (plus (plus p q) r,plus p (plus q r)) ;
  commR p q -> (plus p q,plus q p) ;
  zeroR p -> (plus p nil,p) ;
  negativeR p -> (plus p (negative p),nil) ;
  scalar-assocR a d p -> (scale a (scale d p),scale (A.mul a d) p) ;
  scalar-unitR p -> (scale A.o p,p) ;
  scalar-distR a p q -> (scale a (plus p q),plus (scale a p) (scale a q)) ;
  scalar-addR a d p -> (scale (A.add a d) p,plus (scale a p) (scale d p)) ;
  left-addR x x' y -> (single (M.madd x x') y,plus (single x y) (single x' y)) ;
  left-scaleR a x y -> (single (M.sm a x) y,scale a (single x y)) ;
  right-addR x y y' -> (single x (N.madd y y'),plus (single x y) (single x y')) ;
  right-scaleR a x y -> (single x (N.sm a y),scale a (single x y)) } ;
 data Tree : U l = lawD (r : Rule) | reflD (p : Term) | symD (d : Tree)
  | transD (d e : Tree) | plusD (d e : Tree) | negD (d : Tree) | scaleD (a : A.R) (d : Tree) ;
 ends : Tree -> Term * Term = split {
  lawD r -> ends-rule r ; reflD p -> (p,p) ; symD d | rd -> (rd.2,rd.1) ;
  transD d e | rd re -> (rd.1,re.2) ; plusD d e | rd re -> (plus rd.1 re.1,plus rd.2 re.2) ;
  negD d | rd -> (negative rd.1,negative rd.2) ; scaleD a d | rd -> (scale a rd.1,scale a rd.2) } ;
 Valid : Tree -> U l = split {
  lawD r -> Top ; reflD p -> Top ; symD d | rd -> rd ;
  transD d e | rd re -> rd * re * Id Term (ends d).2 (ends e).1 ;
  plusD d e | rd re -> rd * re ; negD d | rd -> rd ; scaleD a d | rd -> rd } ;
 Witness (p q : Term) : U l = (d : Tree) * Valid d * Id Term (ends d).1 p * Id Term (ends d).2 q ;
 Rel (p q : Term) : U l = Tr.Trunc[Witness p q].carrier ;
 prop (p q : Term) : Pr.isProp (Rel p q) = Tr.Trunc[Witness p q].proposition ;
 witness (d : Tree) (v : Valid d) : Rel (ends d).1 (ends d).2 =
  Tr.Trunc[Witness (ends d).1 (ends d).2].inc (d,v,refl (ends d).1,refl (ends d).2) ;
 record Unary (f : Term -> Term) {
  derivation : Tree -> Tree ;
  valid (d : Tree) : Valid d -> Valid (derivation d) ;
  first (d : Tree) : Id Term (ends (derivation d)).1 (f (ends d).1) ;
  second (d : Tree) : Id Term (ends (derivation d)).2 (f (ends d).2) ;
 } ;
 map-rel (f : Term -> Term) (op : Unary[f]) (p q : Term) (h : Rel p q) : Rel (f p) (f q) =
  Tr.Trunc[Witness p q].induction @l (\ t -> Rel (f p) (f q)) (\ t -> prop _ _)
   (\ w -> Tr.Trunc[Witness (f p) (f q)].inc
    (op.derivation w.1,op.valid w.1 w.2.1,
     trans (op.first w.1) (ap f w.2.2.1),trans (op.second w.1) (ap f w.2.2.2))) h ;
 rr (p : Term) : Rel p p = witness (reflD p) tt ;
 rs (p q : Term) (h : Rel p q) : Rel q p = Tr.Trunc[Witness p q].induction @l
  (\ t -> Rel q p) (\ t -> prop q p) (\ w -> Tr.Trunc[Witness q p].inc (symD w.1,w.2.1,w.2.2.2,w.2.2.1)) h ;
 rt (p q r : Term) (h : Rel p q) (k : Rel q r) : Rel p r = Tr.Trunc[Witness p q].induction @l
  (\ t -> Rel p r) (\ t -> prop p r)
  (\ w -> Tr.Trunc[Witness q r].induction @l (\ t -> Rel p r) (\ t -> prop p r)
   (\ v -> Tr.Trunc[Witness p r].inc
    (transD w.1 v.1,(w.2.1,v.2.1,trans w.2.2.2 (sym v.2.2.1)),w.2.2.1,v.2.2.2)) k) h ;
 module Q = Quotient[l].Quot[Term,Rel,prop,rr,rs,rt] ;
 law (r : Rule) : Id Q.Q (Q.inc (ends-rule r).1) (Q.inc (ends-rule r).2) =
  Q.relates _ _ (witness (lawD r) tt) ;
 module QuotientUnary (f : Term -> Term) (op : Unary[f]) {
  module D = Q.Descend[Q.Q,Q.set,\ p -> Q.inc (f p),\ p q h -> Q.relates _ _ (map-rel f op p q h)] ;
 } ;
 module Left (q : Term) {
  module Add = QuotientUnary[\ p -> plus p q,new Unary[(\ p -> plus p q),\ d -> plusD d (reflD q),
   \ d h -> (h,tt),\ d -> refl (plus (ends d).1 q),\ d -> refl (plus (ends d).2 q)]] ;
 } ;
 module Right (p : Term) {
  module Add = QuotientUnary[plus p,new Unary[(plus p),\ d -> plusD (reflD p) d,
   \ d h -> (tt,h),\ d -> refl (plus p (ends d).1),\ d -> refl (plus p (ends d).2)]] ;
 } ;
 add-respect (p r : Term) (h : Rel p r) : Id (Q.Q -> Q.Q) Right[p].Add.D.map Right[r].Add.D.map =
  FE.funext Q.Q (\ q -> Q.Q) Right[p].Add.D.map Right[r].Add.D.map (Q.induction @l
   (\ q -> Id Q.Q (Right[p].Add.D.map q) (Right[r].Add.D.map q)) (\ q -> Q.set _ _)
   (\ q -> trans (Right[p].Add.D.beta q)
    (trans (sym (Left[q].Add.D.beta p))
     (trans (ap Left[q].Add.D.map (Q.relates p r h))
      (trans (Left[q].Add.D.beta r) (sym (Right[r].Add.D.beta q))))))) ;
 module Sum = Q.Descend[Q.Q -> Q.Q,FE.isSet-Pi Q.Q (\ q -> Q.Q) (\ q -> Q.set),\ p -> Right[p].Add.D.map,add-respect] ;
 add (x y : Q.Q) : Q.Q = Sum.map x y ;
 add-at (p q : Term) : Id Q.Q (add (Q.inc p) (Q.inc q)) (Q.inc (plus p q)) =
  trans (ap (\ f -> f (Q.inc q)) (Sum.beta p)) (Right[p].Add.D.beta q) ;
 module Neg = QuotientUnary[negative,new Unary[negative,\ d -> negD d,\ d h -> h,
  \ d -> refl (negative (ends d).1),\ d -> refl (negative (ends d).2)]] ;
 module Scale (a : A.R) {
  module Op = QuotientUnary[scale a,new Unary[(scale a),\ d -> scaleD a d,\ d h -> h,
   \ d -> refl (scale a (ends d).1),\ d -> refl (scale a (ends d).2)]] ;
 } ;
 neg (x : Q.Q) : Q.Q = Neg.D.map x ;
 scalar (a : A.R) (x : Q.Q) : Q.Q = Scale[a].Op.D.map x ;
 neg-at (p : Term) : Id Q.Q (neg (Q.inc p)) (Q.inc (negative p)) = Neg.D.beta p ;
 scalar-at (a : A.R) (p : Term) : Id Q.Q (scalar a (Q.inc p)) (Q.inc (scale a p)) = Scale[a].Op.D.beta p ;
 ind (P : Q.Q -> U l) (propP : (x : Q.Q) -> Pr.isProp (P x)) :
  ((p : Term) -> P (Q.inc p)) -> (x : Q.Q) -> P x = Q.induction @l P propP ;
 ind2 (P : Q.Q -> Q.Q -> U l) (propP : (x y : Q.Q) -> Pr.isProp (P x y))
  (on : (p q : Term) -> P (Q.inc p) (Q.inc q)) (x y : Q.Q) : P x y =
  ind (\ x -> P x y) (\ x -> propP x y)
   (\ p -> ind (P (Q.inc p)) (propP (Q.inc p)) (on p) y) x ;
 ind3 (P : Q.Q -> Q.Q -> Q.Q -> U l) (propP : (x y z : Q.Q) -> Pr.isProp (P x y z))
  (on : (p q r : Term) -> P (Q.inc p) (Q.inc q) (Q.inc r)) (x y z : Q.Q) : P x y z =
  ind2 (\ x y -> P x y z) (\ x y -> propP x y z)
   (\ p q -> ind (P (Q.inc p) (Q.inc q)) (propP (Q.inc p) (Q.inc q)) (on p q) z) x y ;
 assoc : (x y z : Q.Q) -> Id Q.Q (add x (add y z)) (add (add x y) z) =
  ind3 (\ x y z -> Id Q.Q (add x (add y z)) (add (add x y) z)) (\ x y z -> Q.set _ _)
   (\ p q r -> trans (ap (add (Q.inc p)) (add-at q r))
    (trans (add-at p (plus q r)) (trans (sym (law (assocR p q r)))
     (trans (sym (add-at (plus p q) r)) (ap (\ x -> add x (Q.inc r)) (sym (add-at p q))))))) ;
 comm : (x y : Q.Q) -> Id Q.Q (add x y) (add y x) =
  ind2 (\ x y -> Id Q.Q (add x y) (add y x)) (\ x y -> Q.set _ _)
   (\ p q -> trans (add-at p q) (trans (law (commR p q)) (sym (add-at q p)))) ;
 zero-law : (x : Q.Q) -> Id Q.Q (add x (Q.inc nil)) x =
  ind (\ x -> Id Q.Q (add x (Q.inc nil)) x) (\ x -> Q.set _ _) (\ p -> trans (add-at p nil) (law (zeroR p))) ;
 neg-law : (x : Q.Q) -> Id Q.Q (add x (neg x)) (Q.inc nil) =
  ind (\ x -> Id Q.Q (add x (neg x)) (Q.inc nil)) (\ x -> Q.set _ _)
   (\ p -> trans (ap (add (Q.inc p)) (neg-at p)) (trans (add-at p (negative p)) (law (negativeR p)))) ;
 scalar-assoc (a d : A.R) : (x : Q.Q) -> Id Q.Q (scalar a (scalar d x)) (scalar (A.mul a d) x) =
  ind (\ x -> Id Q.Q (scalar a (scalar d x)) (scalar (A.mul a d) x)) (\ x -> Q.set _ _)
   (\ p -> trans (ap (scalar a) (scalar-at d p)) (trans (scalar-at a (scale d p))
    (trans (law (scalar-assocR a d p)) (sym (scalar-at (A.mul a d) p))))) ;
 scalar-unit : (x : Q.Q) -> Id Q.Q (scalar A.o x) x =
  ind (\ x -> Id Q.Q (scalar A.o x) x) (\ x -> Q.set _ _) (\ p -> trans (scalar-at A.o p) (law (scalar-unitR p))) ;
 scalar-dist (a : A.R) : (x y : Q.Q) -> Id Q.Q (scalar a (add x y)) (add (scalar a x) (scalar a y)) =
  ind2 (\ x y -> Id Q.Q (scalar a (add x y)) (add (scalar a x) (scalar a y))) (\ x y -> Q.set _ _)
   (\ p q -> trans (ap (scalar a) (add-at p q)) (trans (scalar-at a (plus p q))
    (trans (law (scalar-distR a p q)) (trans (sym (add-at (scale a p) (scale a q)))
     (cong2 Q.Q add _ _ _ _ (sym (scalar-at a p)) (sym (scalar-at a q))))))) ;
 scalar-add (a d : A.R) : (x : Q.Q) -> Id Q.Q (scalar (A.add a d) x) (add (scalar a x) (scalar d x)) =
  ind (\ x -> Id Q.Q (scalar (A.add a d) x) (add (scalar a x) (scalar d x))) (\ x -> Q.set _ _)
   (\ p -> trans (scalar-at (A.add a d) p) (trans (law (scalar-addR a d p))
    (trans (sym (add-at (scale a p) (scale d p)))
     (cong2 Q.Q add _ _ _ _ (sym (scalar-at a p)) (sym (scalar-at d p)))))) ;
 tensor : S.Module = new S.Module[Q.Q,Q.set,Q.inc nil,add,neg,assoc,comm,zero-law,neg-law,scalar,scalar-assoc,scalar-unit,scalar-dist,scalar-add] ;
 pure (x : M.M) (y : N.M) : tensor.M = Q.inc (single x y) ;
 module Pair = L.Maps[M,N,tensor] ;
 pairing : Pair.Pairing = new Pair.Pairing[pure,
  \ x x' y -> trans (law (left-addR x x' y)) (sym (add-at (single x y) (single x' y))),
  \ a x y -> trans (law (left-scaleR a x y)) (sym (scalar-at a (single x y))),
  \ x y y' -> trans (law (right-addR x y y')) (sym (add-at (single x y) (single x y'))),
  \ a x y -> trans (law (right-scaleR a x y)) (sym (scalar-at a (single x y)))] ;
 cons-at (xy : M.M * N.M) (p : Term) :
  Id tensor.M (Q.inc (cons xy p)) (tensor.madd (pure xy.1 xy.2) (Q.inc p)) = sym (add-at (single xy.1 xy.2) p) ;
} ;

