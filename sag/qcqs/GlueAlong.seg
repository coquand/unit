-- Gluing two locally ringed lattices along local maps into a third
-- (DESIGN.md, Next 5, step 2; built alongside Doubling, whose proofs it
-- follows component by component).
--
-- Let X1 on L1, X2 on L2 and Y on M be locally ringed, with local maps
-- phi1, phi2 written in the RINGED-LATTICE convention
-- (LocallyRinged.Maps[Li,M,Xi.sheaf,Y.sheaf]): lattice maps p1 : L1 -> M,
-- p2 : L2 -> M (inverse images) and ring maps phi_i# : Oi(u) -> O_Y(p_i u).
-- In GEOMETRIC notation they are maps Y -> X1 and Y -> X2 (Y the overlap,
-- embedded in both), and the glued object is X1 glued to X2 along Y.  For
-- the gluing along a transition (GlueTransition), Y = X|d, phi1 the
-- inclusion X|d -> X, phi2 the composite X|d --theta--> X|d --> X
-- (geometric order; Compose.Of[theta, inclusion] in the ringed one).
-- Opens.  The pairs (u, v) with p1 u = p2 v (LatticePullback); put
--  mid (u, v) = p1 u.
-- Sections.  O(u, v) = O1(u) x_Y(mid) O2(v), the pairs (s, t) with
--  phi1# s = (phi2# t)|mid (FibreProduct; the restriction is between the
--  equal opens mid = p1 u and p2 v).
-- Restriction.  For (u2, v2) <= (u, v), (s, t) |-> (s|u2, t|v2) (Lift):
--  phi1#(s|u2) = (phi1# s)|mid2 = ((phi2# t)|mid)|mid2 = ((phi2# t)|p2 v2)|mid2
--  = (phi2#(t|v2))|mid2, by naturality of phi1 and phi2.  Identity and
--  composition hold componentwise.
-- Sheaf.  As for the doubling: the first components of a compatible family
--  have an amalgam s, the second ones an amalgam t, and phi1# s =
--  (phi2# t)|mid by separation in Y on the cover p1 u_i of p1 u (p1
--  preserves finite joins): both restrict on p1 u_i to phi1# s_i =
--  (phi2# t_i)|mid_i.  Amalgams are unique componentwise.
-- Invertibility.  D(s, t) = (D s, D t).  It lies in the pullback:
--  p1(D s) = D(phi1# s) (phi1 local) = D((phi2# t)|mid) = mid /\ D(phi2# t)
--  (InvOpen.Restrict) = mid /\ p2(D t) (phi2 local) = p2(D t), since
--  p2(D t) <= p2 v = mid.  It is the invertibility open: (a, b) is a unit iff
--  a and b are (FibreProduct), and (w, w2) <= (D s, D t) iff w <= D s and
--  w2 <= D t.
-- Support.  D(0) = bot and D(s + t) <= D s \/ D t hold componentwise.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module DL = DistLattice[l] ;
module Over (L1 L2 M : DL.DLat) (X1 : LocallyRinged[l].On[L1].LocallyRinged) (X2 : LocallyRinged[l].On[L2].LocallyRinged)
 (Y : LocallyRinged[l].On[M].LocallyRinged)
 (phi1 : LocallyRinged[l].Maps[L1,M,X1.sheaf,Y.sheaf].Ringed) (phi2 : LocallyRinged[l].Maps[L2,M,X2.sheaf,Y.sheaf].Ringed)
 (local1 : LocallyRinged[l].Maps[L1,M,X1.sheaf,Y.sheaf].Of[phi1,X1.inv,Y.inv].IsLocal)
 (local2 : LocallyRinged[l].Maps[L2,M,X2.sheaf,Y.sheaf].Of[phi2,X2.inv,Y.inv].IsLocal) {
 module O1 = DL.Order[L1] ;
 module O2 = DL.Order[L2] ;
 module OM = DL.Order[M] ;
 module J1 = DL.Joins[L1] ;
 module J2 = DL.Joins[L2] ;
 module JM = DL.Joins[M] ;
 module M1 = LocallyRinged[l].Maps[L1,M,X1.sheaf,Y.sheaf].Of[phi1,X1.inv,Y.inv] ;
 module M2 = LocallyRinged[l].Maps[L2,M,X2.sheaf,Y.sheaf].Of[phi2,X2.inv,Y.inv] ;
 module PL1 = DL.JoinMaps[L1,M,phi1.lat] ;
 module PL2 = DL.JoinMaps[L2,M,phi2.lat] ;
 module PB = LatticePullback[l].Over[L1,L2,M,phi1.lat,phi2.lat] ;
 module OP = PB.OP ;
 module GO1 = RingedLattice[l].On[L1].Of[X1.sheaf] ;
 module GO2 = RingedLattice[l].On[L2].Of[X2.sheaf] ;
 module GY = RingedLattice[l].On[M].Of[Y.sheaf] ;
 module RG = RingedLattice[l].On[PB.lattice] ;
 module LRG = LocallyRinged[l].On[PB.lattice] ;

 -- where the two images meet
 mid (x : PB.Opens) : M.L = M1.p (PB.first x) ;
 mid-second (x : PB.Opens) : OM.Le (mid x) (M2.p (PB.second x)) = OM.le-of-eq (mid x) (M2.p (PB.second x)) (PB.match x) ;
 -- the second leg: phi2# followed by restriction to mid
 leg2 (x : PB.Opens) : RH.Hom (X2.sheaf.ring (PB.second x)) (Y.sheaf.ring (mid x)) =
  RH.compose (X2.sheaf.ring (PB.second x)) (Y.sheaf.ring (M2.p (PB.second x))) (Y.sheaf.ring (mid x))
   (Y.sheaf.res (mid x) (M2.p (PB.second x)) (mid-second x)) (phi2.sharp (PB.second x)) ;

 -- the sections over x: pairs agreeing on mid x
 module At (x : PB.Opens) {
  module P = FibreProduct[l].Over[X1.sheaf.ring (PB.first x),X2.sheaf.ring (PB.second x),Y.sheaf.ring (mid x),
   X1.sheaf.ring-set (PB.first x),X2.sheaf.ring-set (PB.second x),Y.sheaf.ring-set (mid x),
   phi1.sharp (PB.first x),leg2 x] ;
 } ;
 ring (x : PB.Opens) : CRing = At[x].P.ring ;
 ring-set (x : PB.Opens) : Pr.isSet (ring x).R = At[x].P.pair-set ;
 left (x : PB.Opens) (z : (ring x).R) : (X1.sheaf.ring (PB.first x)).R = At[x].P.left z ;
 right (x : PB.Opens) (z : (ring x).R) : (X2.sheaf.ring (PB.second x)).R = At[x].P.right z ;
 agree (x : PB.Opens) (z : (ring x).R) :
  Id (Y.sheaf.ring (mid x)).R (map (phi1.sharp (PB.first x)) (left x z))
   (GY.restrict (mid x) (M2.p (PB.second x)) (mid-second x) (map (phi2.sharp (PB.second x)) (right x z))) = At[x].P.agree z ;
 ext (x : PB.Opens) (z z2 : (ring x).R) (e1 : Id (X1.sheaf.ring (PB.first x)).R (left x z) (left x z2))
  (e2 : Id (X2.sheaf.ring (PB.second x)).R (right x z) (right x z2)) : Id (ring x).R z z2 = At[x].P.ext z z2 e1 e2 ;

 -- restriction
 module Res (y x : PB.Opens) (k : OP.Le y x) {
  k1 : O1.Le (PB.first y) (PB.first x) = PB.le-first y x k ;
  k2 : O2.Le (PB.second y) (PB.second x) = PB.le-second y x k ;
  m1 : OM.Le (mid y) (mid x) = PL1.monotone (PB.first y) (PB.first x) k1 ;
  m2 : OM.Le (M2.p (PB.second y)) (M2.p (PB.second x)) = PL2.monotone (PB.second y) (PB.second x) k2 ;
  -- mid y <= p2 (second x), through p2 (second y)
  c : OM.Le (mid y) (M2.p (PB.second x)) =
   OM.le-trans (mid y) (M2.p (PB.second y)) (M2.p (PB.second x)) (mid-second y) m2 ;
  first-part : RH.Hom (ring x) (X1.sheaf.ring (PB.first y)) =
   RH.compose (ring x) (X1.sheaf.ring (PB.first x)) (X1.sheaf.ring (PB.first y)) (X1.sheaf.res (PB.first y) (PB.first x) k1) At[x].P.proj-left ;
  second-part : RH.Hom (ring x) (X2.sheaf.ring (PB.second y)) =
   RH.compose (ring x) (X2.sheaf.ring (PB.second x)) (X2.sheaf.ring (PB.second y)) (X2.sheaf.res (PB.second y) (PB.second x) k2) At[x].P.proj-right ;
  agrees (z : (ring x).R) : At[y].P.Agree (map first-part z) (map second-part z) = calc (Y.sheaf.ring (mid y)).R {
   map (phi1.sharp (PB.first y)) (GO1.restrict (PB.first y) (PB.first x) k1 (left x z))
    =< sym (phi1.natural (PB.first y) (PB.first x) k1 (left x z))
    > GY.restrict (mid y) (mid x) m1 (map (phi1.sharp (PB.first x)) (left x z))
    =< ap (GY.restrict (mid y) (mid x) m1) (agree x z)
    > GY.restrict (mid y) (mid x) m1 (GY.restrict (mid x) (M2.p (PB.second x)) (mid-second x) (map (phi2.sharp (PB.second x)) (right x z)))
    =< Y.sheaf.res-comp (mid y) (mid x) (M2.p (PB.second x)) m1 (mid-second x) c (map (phi2.sharp (PB.second x)) (right x z))
    > GY.restrict (mid y) (M2.p (PB.second x)) c (map (phi2.sharp (PB.second x)) (right x z))
    =< sym (Y.sheaf.res-comp (mid y) (M2.p (PB.second y)) (M2.p (PB.second x)) (mid-second y) m2 c (map (phi2.sharp (PB.second x)) (right x z)))
    > GY.restrict (mid y) (M2.p (PB.second y)) (mid-second y)
       (GY.restrict (M2.p (PB.second y)) (M2.p (PB.second x)) m2 (map (phi2.sharp (PB.second x)) (right x z)))
    =< ap (GY.restrict (mid y) (M2.p (PB.second y)) (mid-second y)) (phi2.natural (PB.second y) (PB.second x) k2 (right x z))
    > GY.restrict (mid y) (M2.p (PB.second y)) (mid-second y)
       (map (phi2.sharp (PB.second y)) (GO2.restrict (PB.second y) (PB.second x) k2 (right x z))) } ;
  res : RH.Hom (ring x) (ring y) = At[y].P.Lift[ring x,first-part,second-part,agrees].lift ;
  -- its components, by definition
  left-res (z : (ring x).R) :
   Id (X1.sheaf.ring (PB.first y)).R (left y (map res z)) (GO1.restrict (PB.first y) (PB.first x) k1 (left x z)) =
   refl (GO1.restrict (PB.first y) (PB.first x) k1 (left x z)) ;
  right-res (z : (ring x).R) :
   Id (X2.sheaf.ring (PB.second y)).R (right y (map res z)) (GO2.restrict (PB.second y) (PB.second x) k2 (right x z)) =
   refl (GO2.restrict (PB.second y) (PB.second x) k2 (right x z)) ;
 } ;
 res (y x : PB.Opens) (k : OP.Le y x) : RH.Hom (ring x) (ring y) = Res[y,x,k].res ;
 res-id (x : PB.Opens) (k : OP.Le x x) (z : (ring x).R) : Id (ring x).R (map (res x x k) z) z =
  ext x (map (res x x k) z) z
   (trans (Res[x,x,k].left-res z) (X1.sheaf.res-id (PB.first x) (Res[x,x,k].k1) (left x z)))
   (trans (Res[x,x,k].right-res z) (X2.sheaf.res-id (PB.second x) (Res[x,x,k].k2) (right x z))) ;
 res-comp (x1 x2 x3 : PB.Opens) (a : OP.Le x1 x2) (b : OP.Le x2 x3) (c : OP.Le x1 x3) (z : (ring x3).R) :
  Id (ring x1).R (map (res x1 x2 a) (map (res x2 x3 b) z)) (map (res x1 x3 c) z) =
  ext x1 (map (res x1 x2 a) (map (res x2 x3 b) z)) (map (res x1 x3 c) z)
   (X1.sheaf.res-comp (PB.first x1) (PB.first x2) (PB.first x3) (Res[x1,x2,a].k1) (Res[x2,x3,b].k1) (Res[x1,x3,c].k1) (left x3 z))
   (X2.sheaf.res-comp (PB.second x1) (PB.second x2) (PB.second x3) (Res[x1,x2,a].k2) (Res[x2,x3,b].k2) (Res[x1,x3,c].k2) (right x3 z)) ;
 presheaf : RG.Presheaf = new RG.Presheaf[ring,ring-set,res,res-id,res-comp] ;
 module G2 = RG.Of[presheaf] ;

 -- the sheaf property
 module Glue (x : PB.Opens) (n : Nat) (ms : Fin n -> PB.Opens) (le : (i : Fin n) -> OP.Le (ms i) x)
  (covers : OP.Le x (PB.JP.bigJ n ms)) (xs : (i : Fin n) -> (ring (ms i)).R)
  (c : G2.Cover[x,n,ms,le,covers].Compatible xs) {
  module C2 = G2.Cover[x,n,ms,le,covers] ;
  -- the first components
  le1 (i : Fin n) : O1.Le (PB.first (ms i)) (PB.first x) = PB.le-first (ms i) x (le i) ;
  covers1 : O1.Le (PB.first x) (J1.bigJ n (\ i -> PB.first (ms i))) =
   O1.le-trans (PB.first x) (PB.first (PB.JP.bigJ n ms)) (J1.bigJ n (\ i -> PB.first (ms i)))
    (PB.le-first x (PB.JP.bigJ n ms) covers) (O1.le-of-eq _ _ (PB.join-first n ms)) ;
  s (i : Fin n) : (X1.sheaf.ring (PB.first (ms i))).R = left (ms i) (xs i) ;
  module S1 = RingedLattice[l].On[L1].Sheaf[X1.sheaf,X1.is-sheaf].Cover[PB.first x,n,\ i -> PB.first (ms i),le1,covers1] ;
  compatible1 : S1.C.Compatible s = \ i j ->
   trans (GO1.res-irr (L1.meet (PB.first (ms i)) (PB.first (ms j))) (PB.first (ms i))
     (O1.meet-left (PB.first (ms i)) (PB.first (ms j))) (Res[PB.lattice.meet (ms i) (ms j),ms i,OP.meet-left (ms i) (ms j)].k1) (s i))
    (trans (ap (left (PB.lattice.meet (ms i) (ms j))) (c i j))
     (GO1.res-irr (L1.meet (PB.first (ms i)) (PB.first (ms j))) (PB.first (ms j))
      (Res[PB.lattice.meet (ms i) (ms j),ms j,OP.meet-right (ms i) (ms j)].k1) (O1.meet-right (PB.first (ms i)) (PB.first (ms j))) (s j))) ;
  glued1 : S1.C.Amalgam s = (S1.glue s compatible1).1 ;
  -- the second components
  le2 (i : Fin n) : O2.Le (PB.second (ms i)) (PB.second x) = PB.le-second (ms i) x (le i) ;
  covers2 : O2.Le (PB.second x) (J2.bigJ n (\ i -> PB.second (ms i))) =
   O2.le-trans (PB.second x) (PB.second (PB.JP.bigJ n ms)) (J2.bigJ n (\ i -> PB.second (ms i)))
    (PB.le-second x (PB.JP.bigJ n ms) covers) (O2.le-of-eq _ _ (PB.join-second n ms)) ;
  t (i : Fin n) : (X2.sheaf.ring (PB.second (ms i))).R = right (ms i) (xs i) ;
  module S2 = RingedLattice[l].On[L2].Sheaf[X2.sheaf,X2.is-sheaf].Cover[PB.second x,n,\ i -> PB.second (ms i),le2,covers2] ;
  compatible2 : S2.C.Compatible t = \ i j ->
   trans (GO2.res-irr (L2.meet (PB.second (ms i)) (PB.second (ms j))) (PB.second (ms i))
     (O2.meet-left (PB.second (ms i)) (PB.second (ms j))) (Res[PB.lattice.meet (ms i) (ms j),ms i,OP.meet-left (ms i) (ms j)].k2) (t i))
    (trans (ap (right (PB.lattice.meet (ms i) (ms j))) (c i j))
     (GO2.res-irr (L2.meet (PB.second (ms i)) (PB.second (ms j))) (PB.second (ms j))
      (Res[PB.lattice.meet (ms i) (ms j),ms j,OP.meet-right (ms i) (ms j)].k2) (O2.meet-right (PB.second (ms i)) (PB.second (ms j))) (t j))) ;
  glued2 : S2.C.Amalgam t = (S2.glue t compatible2).1 ;
  -- the two amalgams agree on mid x, by separation on the mid (ms i)
  le-mid (i : Fin n) : OM.Le (mid (ms i)) (mid x) = PL1.monotone (PB.first (ms i)) (PB.first x) (le1 i) ;
  covers-mid : OM.Le (mid x) (JM.bigJ n (\ i -> mid (ms i))) =
   OM.le-trans (mid x) (M1.p (J1.bigJ n (\ i -> PB.first (ms i)))) (JM.bigJ n (\ i -> mid (ms i)))
    (PL1.monotone (PB.first x) (J1.bigJ n (\ i -> PB.first (ms i))) covers1)
    (OM.le-of-eq _ _ (PL1.preserves n (\ i -> PB.first (ms i)))) ;
  module SM = RingedLattice[l].On[M].Sheaf[Y.sheaf,Y.is-sheaf].Cover[mid x,n,\ i -> mid (ms i),le-mid,covers-mid] ;
  -- the two sides, named once
  a1 : (Y.sheaf.ring (mid x)).R = map (phi1.sharp (PB.first x)) (S1.C.amalgam glued1) ;
  b2 : (Y.sheaf.ring (M2.p (PB.second x))).R = map (phi2.sharp (PB.second x)) (S2.C.amalgam glued2) ;
  m2 (i : Fin n) : OM.Le (M2.p (PB.second (ms i))) (M2.p (PB.second x)) = PL2.monotone (PB.second (ms i)) (PB.second x) (le2 i) ;
  c2 (i : Fin n) : OM.Le (mid (ms i)) (M2.p (PB.second x)) =
   OM.le-trans (mid (ms i)) (M2.p (PB.second (ms i))) (M2.p (PB.second x)) (mid-second (ms i)) (m2 i) ;
  agree-at (i : Fin n) :
   Id (Y.sheaf.ring (mid (ms i))).R (SM.C.restrictions a1 i)
    (SM.C.restrictions (GY.restrict (mid x) (M2.p (PB.second x)) (mid-second x) b2) i) =
   calc (Y.sheaf.ring (mid (ms i))).R {
    GY.restrict (mid (ms i)) (mid x) (le-mid i) a1
     =< phi1.natural (PB.first (ms i)) (PB.first x) (le1 i) (S1.C.amalgam glued1)
     > map (phi1.sharp (PB.first (ms i))) (GO1.restrict (PB.first (ms i)) (PB.first x) (le1 i) (S1.C.amalgam glued1))
     =< ap (map (phi1.sharp (PB.first (ms i)))) (S1.C.matches glued1 i)
     > map (phi1.sharp (PB.first (ms i))) (s i)
     =< agree (ms i) (xs i)
     > GY.restrict (mid (ms i)) (M2.p (PB.second (ms i))) (mid-second (ms i)) (map (phi2.sharp (PB.second (ms i))) (t i))
     =< ap (\ w -> GY.restrict (mid (ms i)) (M2.p (PB.second (ms i))) (mid-second (ms i)) (map (phi2.sharp (PB.second (ms i))) w))
         (sym (S2.C.matches glued2 i))
     > GY.restrict (mid (ms i)) (M2.p (PB.second (ms i))) (mid-second (ms i))
        (map (phi2.sharp (PB.second (ms i))) (GO2.restrict (PB.second (ms i)) (PB.second x) (le2 i) (S2.C.amalgam glued2)))
     =< ap (GY.restrict (mid (ms i)) (M2.p (PB.second (ms i))) (mid-second (ms i)))
         (sym (phi2.natural (PB.second (ms i)) (PB.second x) (le2 i) (S2.C.amalgam glued2)))
     > GY.restrict (mid (ms i)) (M2.p (PB.second (ms i))) (mid-second (ms i))
        (GY.restrict (M2.p (PB.second (ms i))) (M2.p (PB.second x)) (m2 i) b2)
     =< Y.sheaf.res-comp (mid (ms i)) (M2.p (PB.second (ms i))) (M2.p (PB.second x)) (mid-second (ms i)) (m2 i) (c2 i) b2
     > GY.restrict (mid (ms i)) (M2.p (PB.second x)) (c2 i) b2
     =< sym (Y.sheaf.res-comp (mid (ms i)) (mid x) (M2.p (PB.second x)) (le-mid i) (mid-second x) (c2 i) b2)
     > GY.restrict (mid (ms i)) (mid x) (le-mid i) (GY.restrict (mid x) (M2.p (PB.second x)) (mid-second x) b2) } ;
  agrees : At[x].P.Agree (S1.C.amalgam glued1) (S2.C.amalgam glued2) =
   SM.separated a1 (GY.restrict (mid x) (M2.p (PB.second x)) (mid-second x) b2) agree-at ;
  glued : (ring x).R = At[x].P.pair (S1.C.amalgam glued1) (S2.C.amalgam glued2) agrees ;
  matches : C2.Matches xs glued = \ i ->
   ext (ms i) (C2.restrictions glued i) (xs i) (S1.C.matches glued1 i) (S2.C.matches glued2 i) ;
  -- matching is a proposition
  matches-prop (z : (ring x).R) : Pr.isProp (C2.Matches xs z) =
   F.isProp-Pi (Fin n) (\ i -> Id (ring (ms i)).R (C2.restrictions z i) (xs i)) (\ i ->
    ring-set (ms i) (C2.restrictions z i) (xs i)) ;
  -- every amalgam is (glued, matches)
  unique (a : C2.Amalgam xs) : Id (C2.Amalgam xs) (glued,matches) a =
   Pr.Sigma-eq (ring x).R (C2.Matches xs) glued (C2.amalgam a) matches (C2.matches a)
    (ext x glued (C2.amalgam a)
     (S1.separated (S1.C.amalgam glued1) (left x (C2.amalgam a)) (\ i ->
       trans (S1.C.matches glued1 i) (sym (ap (left (ms i)) (C2.matches a i)))))
     (S2.separated (S2.C.amalgam glued2) (right x (C2.amalgam a)) (\ i ->
       trans (S2.C.matches glued2 i) (sym (ap (right (ms i)) (C2.matches a i))))))
    (matches-prop (C2.amalgam a)) ;
  sheaf : Localisation[l].isContr (C2.Amalgam xs) = ((glued,matches),unique) ;
 } ;
 is-sheaf : G2.IsSheaf = \ x n ms le covers xs c -> Glue[x,n,ms,le,covers,xs,c].sheaf ;

 -- the invertibility map, componentwise
 module IX1 = InvOpen[l].On[L1].Of[X1.sheaf] ;
 module IX2 = InvOpen[l].On[L2].Of[X2.sheaf] ;
 module IY = InvOpen[l].On[M].Of[Y.sheaf] ;
 module LX1 = LocallyRinged[l].On[L1].Laws[X1.sheaf,X1.inv] ;
 module LX2 = LocallyRinged[l].On[L2].Laws[X2.sheaf,X2.inv] ;
 module LY = LocallyRinged[l].On[M].Laws[Y.sheaf,Y.inv] ;
 module I2 = InvOpen[l].On[PB.lattice].Of[presheaf] ;
 module Inv (x : PB.Opens) (z : (ring x).R) {
  v1 : L1.L = LX1.d (PB.first x) (left x z) ;
  v2 : L2.L = LX2.d (PB.second x) (right x z) ;
  b : (Y.sheaf.ring (M2.p (PB.second x))).R = map (phi2.sharp (PB.second x)) (right x z) ;
  -- p2 v2 <= p2 (second x) = mid x
  below2 : OM.Le (M2.p v2) (mid x) =
   OM.le-trans (M2.p v2) (M2.p (PB.second x)) (mid x)
    (PL2.monotone v2 (PB.second x) (IX2.below (LX2.d-open (PB.second x) (right x z))))
    (OM.le-of-eq (M2.p (PB.second x)) (mid x) (sym (PB.match x))) ;
  match : PB.Match v1 v2 = calc M.L {
   M1.p v1 =< M1.local-eq local1 (PB.first x) (left x z) > LY.d (mid x) (map (phi1.sharp (PB.first x)) (left x z))
    =< ap (LY.d (mid x)) (agree x z) > LY.d (mid x) (GY.restrict (mid x) (M2.p (PB.second x)) (mid-second x) b)
    =< IY.Restrict[M2.p (PB.second x),mid x,mid-second x,b,LY.d (M2.p (PB.second x)) b,LY.d-open (M2.p (PB.second x)) b].restrict-eq
        (LY.d (mid x) (GY.restrict (mid x) (M2.p (PB.second x)) (mid-second x) b))
        (LY.d-open (mid x) (GY.restrict (mid x) (M2.p (PB.second x)) (mid-second x) b))
    > M.meet (mid x) (LY.d (M2.p (PB.second x)) b)
    =< ap (M.meet (mid x)) (sym (M2.local-eq local2 (PB.second x) (right x z))) > M.meet (mid x) (M2.p v2)
    =< M.meetC (mid x) (M2.p v2) > M.meet (M2.p v2) (mid x)
    =< below2 > M2.p v2 } ;
  v : PB.Opens = PB.pair v1 v2 match ;
  -- the components of a restriction of z are restrictions of its components (Res.left-res)
  forward : I2.Forward x z v = \ y k h ->
   At[y].P.unit-pair (map (res y x k) z)
    (Pr.subst (X1.sheaf.ring (PB.first y)).R (IX1.Unit (PB.first y)) _ _ (sym (Res[y,x,k].left-res z))
     (IX1.to-unit (LX1.d-open (PB.first x) (left x z)) (PB.first y) (Res[y,x,k].k1) (PB.le-first y v h)))
    (Pr.subst (X2.sheaf.ring (PB.second y)).R (IX2.Unit (PB.second y)) _ _ (sym (Res[y,x,k].right-res z))
     (IX2.to-unit (LX2.d-open (PB.second x) (right x z)) (PB.second y) (Res[y,x,k].k2) (PB.le-second y v h))) ;
  backward : I2.Backward x z v = \ y k e ->
   PB.le-pair y v
    (IX1.from-unit (LX1.d-open (PB.first x) (left x z)) (PB.first y) (Res[y,x,k].k1)
     (Pr.subst (X1.sheaf.ring (PB.first y)).R (IX1.Unit (PB.first y)) _ _ (Res[y,x,k].left-res z)
      (At[y].P.unit-left (map (res y x k) z) e)))
    (IX2.from-unit (LX2.d-open (PB.second x) (right x z)) (PB.second y) (Res[y,x,k].k2)
     (Pr.subst (X2.sheaf.ring (PB.second y)).R (IX2.Unit (PB.second y)) _ _ (Res[y,x,k].right-res z)
      (At[y].P.unit-right (map (res y x k) z) e))) ;
  inv-open : I2.InvOpen x z =
   (v,PB.le-pair v x (IX1.below (LX1.d-open (PB.first x) (left x z))) (IX2.below (LX2.d-open (PB.second x) (right x z))),
    forward,backward) ;
 } ;
 inv : I2.InvMap = \ x z -> Inv[x,z].inv-open ;

 -- the support laws, componentwise
 module LG = LRG.Laws[presheaf,inv] ;
 -- the components of D(z), by definition
 d-first (x : PB.Opens) (z : (ring x).R) : Id L1.L (PB.first (LG.d x z)) (LX1.d (PB.first x) (left x z)) =
  refl (LX1.d (PB.first x) (left x z)) ;
 d-second (x : PB.Opens) (z : (ring x).R) : Id L2.L (PB.second (LG.d x z)) (LX2.d (PB.second x) (right x z)) =
  refl (LX2.d (PB.second x) (right x z)) ;
 zero-law : LG.ZeroLaw = \ x ->
  PB.ext (LG.d x (ring x).z) PB.botP
   (trans (d-first x (ring x).z) (X1.is-support.2.1 (PB.first x))) (trans (d-second x (ring x).z) (X2.is-support.2.1 (PB.second x))) ;
 add-law : LG.AddLaw = \ x z z2 ->
  PB.le-pair (LG.d x ((ring x).add z z2)) (PB.joinP (LG.d x z) (LG.d x z2))
   (X1.is-support.2.2.2 (PB.first x) (left x z) (left x z2)) (X2.is-support.2.2.2 (PB.second x) (right x z) (right x z2)) ;

 -- the glued locally ringed lattice
 glued : LRG.LocallyRinged = new LRG.LocallyRinged[presheaf,is-sheaf,inv,LG.support zero-law add-law] ;
} ;
