-- Finite choice for large witnesses indexed by the existing small Fin.
-- Induct on the number of indices.  For zero the empty section exists.
-- At a successor, eliminate the truncated old section and last witness
-- into the truncation of their joined section.  This is ordinary finite
-- choice, with no resizing or identification of Fin at different levels.
level l ; open Ring[l] ; open Presentations[l] ;
module Tr = Truncation[l+] ;
empty-section (B : Fin zero -> U l+) : (i : Fin zero) -> B i = split { } ;
section (n : Nat) (B : Fin (suc n) -> U l+)
 (old : (i : Fin n) -> B (inl i)) (last : B (inr tt)) : (i : Fin (suc n)) -> B i = split {
 inl i -> old i ;
 inr t -> idJ Top tt (\ u h -> B (inr u)) last t (AffineFinite[l].top-eq tt t) } ;
choice : (n : Nat) (B : Fin n -> U l+) ->
 ((i : Fin n) -> Tr.Trunc[B i].carrier) -> Tr.Trunc[(i : Fin n) -> B i].carrier = split {
 zero -> \ B h -> Tr.Trunc[(i : Fin zero) -> B i].inc (empty-section B) ;
 suc n | ih -> \ B h ->
  Tr.Trunc[(i : Fin n) -> B (inl i)].induction @(l+)
   (\ t -> Tr.Trunc[(i : Fin (suc n)) -> B i].carrier)
   (\ t -> Tr.Trunc[(i : Fin (suc n)) -> B i].proposition)
   (\ old -> Tr.Trunc[B (inr tt)].induction @(l+)
    (\ t -> Tr.Trunc[(i : Fin (suc n)) -> B i].carrier)
    (\ t -> Tr.Trunc[(i : Fin (suc n)) -> B i].proposition)
    (\ last -> Tr.Trunc[(i : Fin (suc n)) -> B i].inc (section n B old last)) (h (inr tt)))
   (ih (\ i -> B (inl i)) (\ i -> h (inl i))) } ;
