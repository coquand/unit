-- Structure identity for univalent categories, the generic part
-- (port of ~/DOMAIN/UNIT/CategorySIP.seg, objects and arrows in U l).
-- (1) Univalence of a precategory is a proposition: each idtoiso x y is
--     a map between sets (Id x y is a set, the object type of a category
--     being a 1-type; Iso x y is a set), and a bi-invertibility witness
--     between sets is a proposition (IdentityTools.Equivalence.equal).
--     So two categories with equal precategories are equal
--     (pre-path-to-category), through the Sigma presentation
--     (P : Precategory) * Univalent P, by record eta (split).
-- (2) A precategory is a type O with a Structure[O]; to-pre, from-pre are
--     inverse by record eta.  A Structure[O] is a hom family h with
--     Operations[O,h].  For fixed O and h, Operations are determined by
--     idn and comp: hom-set and the three laws form a proposition (sethood
--     is a proposition; the laws are Pi types of equations in sets).
--     fixed-hom-equal: a structure s equals the structure (s.hom, t)
--     whenever t has the same idn and comp.
level l ; open Base ; open Prelude[l] ;
module K = Category[l,l] ;
module R = Prelude[l+] ;
module H = Axioms[l].FunExtLemmas[fe @l] ;
module IT = IdentityTools[l] ;

-- (1) univalence is a proposition; categories with equal precategories
module Proofs (C : K.Category) {
 univalence-prop : isProp (K.Univalent C.pre) =
  H.isProp-Pi C.pre.ob
   (\ x -> (y : C.pre.ob) -> isEquiv (Id C.pre.ob x y) (C.pre.Iso x y) (C.pre.idtoiso x y))
   (\ x -> H.isProp-Pi C.pre.ob
     (\ y -> isEquiv (Id C.pre.ob x y) (C.pre.Iso x y) (C.pre.idtoiso x y))
     (\ y -> IT.Equivalence[Id C.pre.ob x y,C.pre.Iso x y,
       K.Objects[C].one-type x y,K.IsoSet[C.pre].set x y,C.pre.idtoiso x y].equal)) ;
} ;

-- the univalence predicate read in U l+, the universe of the Sigma type
UnivalentHigh (P : K.Precategory) : U l+ = K.Univalent P ;
CategoryRaw : U l+ = (P : K.Precategory) * UnivalentHigh P ;
category-raw (C : K.Category) : CategoryRaw = (C.pre,C.univalent) ;
category-from (w : CategoryRaw) : K.Category = new K.Category[w.1,w.2] ;
category-eta : (C : K.Category) -> Id K.Category (category-from (category-raw C)) C =
 split { Category P u -> refl (new K.Category[P,u]) } ;
pre-path-to-category (C D : K.Category) (p : Id K.Precategory C.pre D.pre) : Id K.Category C D =
 R.trans K.Category C (category-from (category-raw C)) D
  (R.sym K.Category (category-from (category-raw C)) C (category-eta C))
  (R.trans K.Category (category-from (category-raw C)) (category-from (category-raw D)) D
   (R.ap CategoryRaw K.Category category-from (category-raw C) (category-raw D)
    (R.Sigma-eq K.Precategory UnivalentHigh C.pre D.pre C.univalent D.univalent p
     (Proofs[D].univalence-prop)))
   (category-eta D)) ;

-- (2) precategories as structures on a type of objects
record Structure (O : U l) {
 hom : O -> O -> U l ;
 hom-set (x y : O) : isSet (hom x y) ;
 idn (x : O) : hom x x ;
 comp (x y z : O) : hom y z -> hom x y -> hom x z ;
 unit-l (x y : O) (f : hom x y) : Id (hom x y) (comp x y y (idn y) f) f ;
 unit-r (x y : O) (f : hom x y) : Id (hom x y) (comp x x y f (idn x)) f ;
 assoc (w x y z : O) (f : hom w x) (g : hom x y) (h : hom y z) :
  Id (hom w z) (comp w y z h (comp w x y g f)) (comp w x z (comp x y z h g) f) ;
} ;

to-pre (O : U l) (s : Structure[O]) : K.Precategory =
 new K.Precategory[ob := O,hom := s.hom,hom-set := s.hom-set,idn := s.idn,comp := s.comp,
  unit-l := s.unit-l,unit-r := s.unit-r,assoc := s.assoc] ;
from-pre (P : K.Precategory) : Structure[P.ob] =
 new Structure[P.ob,hom := P.hom,hom-set := P.hom-set,idn := P.idn,comp := P.comp,
  unit-l := P.unit-l,unit-r := P.unit-r,assoc := P.assoc] ;
pre-eta : (P : K.Precategory) -> Id K.Precategory (to-pre P.ob (from-pre P)) P =
 split { Precategory O h hs i c ul ur a -> refl (new K.Precategory[O,h,hs,i,c,ul,ur,a]) } ;

record Operations (O : U l) (h : O -> O -> U l) {
 hom-set (x y : O) : isSet (h x y) ;
 idn (x : O) : h x x ;
 comp (x y z : O) : h y z -> h x y -> h x z ;
 unit-l (x y : O) (f : h x y) : Id (h x y) (comp x y y (idn y) f) f ;
 unit-r (x y : O) (f : h x y) : Id (h x y) (comp x x y f (idn x)) f ;
 assoc (w x y z : O) (f : h w x) (g : h x y) (v : h y z) :
  Id (h w z) (comp w y z v (comp w x y g f)) (comp w x z (comp x y z v g) f) ;
} ;
StructureRaw (O : U l) : U l+ = (h : O -> O -> U l) * Operations[O,h] ;
structure-raw (O : U l) (s : Structure[O]) : StructureRaw O =
 (s.hom,new Operations[O,s.hom,s.hom-set,s.idn,s.comp,s.unit-l,s.unit-r,s.assoc]) ;
structure-from (O : U l) (w : StructureRaw O) : Structure[O] =
 new Structure[O,w.1,w.2.hom-set,w.2.idn,w.2.comp,w.2.unit-l,w.2.unit-r,w.2.assoc] ;
structure-raw-eta (O : U l) : (s : Structure[O]) -> Id (Structure[O]) (structure-from O (structure-raw O s)) s =
 split { Structure h hs i c ul ur a -> refl (new Structure[O,h,hs,i,c,ul,ur,a]) } ;

module Fixed (O : U l) (h : O -> O -> U l) {
 HomSet : U l = (x y : O) -> isSet (h x y) ;
 Idn : U l = (x : O) -> h x x ;
 Comp : U l = (x y z : O) -> h y z -> h x y -> h x z ;
 UnitL (i : Idn) (c : Comp) : U l = (x y : O) (f : h x y) -> Id (h x y) (c x y y (i y) f) f ;
 UnitR (i : Idn) (c : Comp) : U l = (x y : O) (f : h x y) -> Id (h x y) (c x x y f (i x)) f ;
 Assoc (c : Comp) : U l =
  (w x y z : O) (f : h w x) (g : h x y) (v : h y z) -> Id (h w z) (c w y z v (c w x y g f)) (c w x z (c x y z v g) f) ;
 Laws (i : Idn) (c : Comp) : U l = UnitL i c * (UnitR i c * Assoc c) ;
 Data : U l = Idn * Comp ;
 Fiber (d : Data) : U l = HomSet * Laws d.1 d.2 ;
 Raw : U l = (d : Data) * Fiber d ;
 raw (s : Operations[O,h]) : Raw = ((s.idn,s.comp),(s.hom-set,(s.unit-l,(s.unit-r,s.assoc)))) ;
 from (r : Raw) : Operations[O,h] = new Operations[O,h,r.2.1,r.1.1,r.1.2,r.2.2.1,r.2.2.2.1,r.2.2.2.2] ;
 eta : (s : Operations[O,h]) -> Id (Operations[O,h]) (from (raw s)) s =
  split { Operations hs i c ul ur a -> refl (new Operations[O,h,hs,i,c,ul,ur,a]) } ;
 homset-prop : isProp HomSet =
  H.isProp-Pi O (\ x -> (y : O) -> isSet (h x y))
   (\ x -> H.isProp-Pi O (\ y -> isSet (h x y)) (\ y -> IT.set-prop (h x y))) ;
 module UnitLProp (i : Idn) (c : Comp) (hs : HomSet) {
  X (x : O) : U l = (y : O) (f : h x y) -> Id (h x y) (c x y y (i y) f) f ;
  Y (x y : O) : U l = (f : h x y) -> Id (h x y) (c x y y (i y) f) f ;
  proposition : isProp (UnitL i c) =
   H.isProp-Pi O X (\ x -> H.isProp-Pi O (Y x) (\ y ->
    H.isProp-Pi (h x y) (\ f -> Id (h x y) (c x y y (i y) f) f) (\ f -> hs x y (c x y y (i y) f) f))) ;
 } ;
 module UnitRProp (i : Idn) (c : Comp) (hs : HomSet) {
  X (x : O) : U l = (y : O) (f : h x y) -> Id (h x y) (c x x y f (i x)) f ;
  Y (x y : O) : U l = (f : h x y) -> Id (h x y) (c x x y f (i x)) f ;
  proposition : isProp (UnitR i c) =
   H.isProp-Pi O X (\ x -> H.isProp-Pi O (Y x) (\ y ->
    H.isProp-Pi (h x y) (\ f -> Id (h x y) (c x x y f (i x)) f) (\ f -> hs x y (c x x y f (i x)) f))) ;
 } ;
 module AssocProp (c : Comp) (hs : HomSet) {
  Eq (w x y z : O) (f : h w x) (g : h x y) (v : h y z) : U l =
   Id (h w z) (c w y z v (c w x y g f)) (c w x z (c x y z v g) f) ;
  W (w : O) : U l = (x y z : O) (f : h w x) (g : h x y) (v : h y z) -> Eq w x y z f g v ;
  X (w x : O) : U l = (y z : O) (f : h w x) (g : h x y) (v : h y z) -> Eq w x y z f g v ;
  Y (w x y : O) : U l = (z : O) (f : h w x) (g : h x y) (v : h y z) -> Eq w x y z f g v ;
  Z (w x y z : O) : U l = (f : h w x) (g : h x y) (v : h y z) -> Eq w x y z f g v ;
  F (w x y z : O) (f : h w x) : U l = (g : h x y) (v : h y z) -> Eq w x y z f g v ;
  G (w x y z : O) (f : h w x) (g : h x y) : U l = (v : h y z) -> Eq w x y z f g v ;
  proposition : isProp (Assoc c) =
   H.isProp-Pi O W (\ w -> H.isProp-Pi O (X w) (\ x -> H.isProp-Pi O (Y w x) (\ y ->
    H.isProp-Pi O (Z w x y) (\ z -> H.isProp-Pi (h w x) (F w x y z) (\ f ->
     H.isProp-Pi (h x y) (G w x y z f) (\ g -> H.isProp-Pi (h y z) (Eq w x y z f g)
      (\ v -> hs w z (c w y z v (c w x y g f)) (c w x z (c x y z v g) f)))))))) ;
 } ;
 laws-prop (i : Idn) (c : Comp) (hs : HomSet) : isProp (Laws i c) =
  isProp-Sigma (UnitL i c) (\ _ -> UnitR i c * Assoc c) (UnitLProp[i,c,hs].proposition)
   (\ _ -> isProp-Sigma (UnitR i c) (\ _ -> Assoc c) (UnitRProp[i,c,hs].proposition) (\ _ -> AssocProp[c,hs].proposition)) ;
 fiber-prop (d : Data) : isProp (Fiber d) =
  isProp-Sigma HomSet (\ _ -> Laws d.1 d.2) homset-prop (\ hs -> laws-prop d.1 d.2 hs) ;
 data-eq (a b : Data) (pi : Id Idn a.1 b.1) (pc : Id Comp a.2 b.2) : Id Data a b =
  trans Data a (b.1,a.2) b (ap Idn Data (\ i -> (i,a.2)) a.1 b.1 pi) (ap Comp Data (\ c -> (b.1,c)) a.2 b.2 pc) ;
 equal (s t : Operations[O,h]) (pi : Id Idn s.idn t.idn) (pc : Id Comp s.comp t.comp) : Id (Operations[O,h]) s t =
  trans (Operations[O,h]) s (from (raw s)) t
   (sym (Operations[O,h]) (from (raw s)) s (eta s))
   (trans (Operations[O,h]) (from (raw s)) (from (raw t)) t
    (ap Raw (Operations[O,h]) from (raw s) (raw t)
     (Sigma-eq Data Fiber (raw s).1 (raw t).1 (raw s).2 (raw t).2 (data-eq (raw s).1 (raw t).1 pi pc) (fiber-prop (raw t).1)))
    (eta t)) ;
} ;

fixed-hom-equal (O : U l) (s : Structure[O]) (t : Operations[O,s.hom])
 (pi : Id (Fixed[O,s.hom].Idn) s.idn t.idn) (pc : Id (Fixed[O,s.hom].Comp) s.comp t.comp) :
 Id (Structure[O]) s (structure-from O (s.hom,t)) =
 R.trans (Structure[O]) s (structure-from O (structure-raw O s)) (structure-from O (s.hom,t))
  (R.sym (Structure[O]) (structure-from O (structure-raw O s)) s (structure-raw-eta O s))
  (R.ap (Operations[O,s.hom]) (Structure[O]) (\ o -> structure-from O (s.hom,o)) (structure-raw O s).2 t
   (Fixed[O,s.hom].equal (structure-raw O s).2 t pi pc)) ;
