-- Native relative qcqs is invariant under native natural equivalence.
-- Totalise the equivalence and the known qcqs condition, transfer the
-- absolute condition, and reflect it by RelativeQcqsOfTotal.  This uses
-- the proved intrinsic-total equivalence, not a definition of relative
-- qcqs in terms of totalisation.
level l ; open Ring[l] ;
module T = AffineTests[l] ;
module Over (K : T.Test) (F G : RelativeFunctors[l].Over[K].SetFunctor)
 (e : RelativeEquivalences[l].Over[K].NaturalEquivalence F G)
 (q : RelativeQcqs[l].Over[K].At[G].IsQcqs) {
 module M = RelativeTotalMaps[l].Over[K,F,G].Equivalence[e] ;
 qcqs : RelativeQcqs[l].Over[K].At[F].IsQcqs = RelativeQcqsOfTotal[l].Over[K,F].qcqs
  (FunctorialTransfer[l].Over[RelativeTotal[l].Over[K,F].functor,RelativeTotal[l].Over[K,G].functor,M.equivalence].qcqs
   (RelativeTotalQcqs[l].Over[K].At[G].qcqs q)) ;
} ;
