-- Gluing a locally ringed lattice to itself along an automorphism of an
-- open (DESIGN.md, Next 5, step 2), and its two charts.
--
-- Let X be locally ringed on L, d in L, and theta an automorphism of X|d
-- (Slice), local, in the ringed convention: theta* on the opens below d,
-- theta# : O(w) -> O(theta* w).  The glued object is GlueAlong with
-- Y = X|d, phi1 the inclusion X|d -> X (inverse image u |-> u /\ d,
-- restriction) and phi2 = the inclusion after theta, geometrically
-- X|d --theta--> X|d --> X (Compose.Of[theta, inclusion], ringed convention;
-- GlueAlong states the conventions).  So its opens are the pairs (u, v)
-- with u /\ d = theta*(v /\ d), and its sections over (u, v) the pairs
-- (s, t) with s|(u /\ d) = theta#(t|(v /\ d)) (restricted to the equal
-- open u /\ d).  With theta the identity this is the doubling.
-- The charts.  e1 = (top, d) and e2 = (d, top) are opens: top /\ d = d =
--  theta*(d) (theta* preserves top), and they cover.
-- First chart.  The projection X^theta|e1 -> X, (u, v) |-> u with ring maps
--  (s, t) |-> s, is an isomorphism.  Lattice: for x <= e1, v <= d, so
--  v = theta*^-1(u /\ d) is determined by u; conversely u gives the open
--  (u, theta*^-1(u /\ d)).  Rings: the second leg t |-> theta#(t|(v /\ d))
--  is bijective (v <= d makes the restrictions between equal opens, and
--  theta# is bijective), so the first projection of the fibre product is
--  (FibreProduct.LeftEquiv).  The chart X ~= X^theta|e1 is its inverse
--  (Iso.Invert), local as an isomorphism.
-- Second chart.  The same with (u, v) |-> v: for x <= e2, u <= d, so
--  u = theta*(v /\ d); the first leg s |-> s|(u /\ d) is bijective
--  (FibreProduct.RightEquiv).  Here theta need not be invertible.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;
module Over (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged) (d : L.L)
 (theta : LocallyRinged[l].Maps[Slice[l].Over[L,X,d].lattice,Slice[l].Over[L,X,d].lattice,
   Slice[l].Over[L,X,d].sheaf,Slice[l].Over[L,X,d].sheaf].Ringed)
 (theta-local : LocallyRinged[l].Maps[Slice[l].Over[L,X,d].lattice,Slice[l].Over[L,X,d].lattice,
   Slice[l].Over[L,X,d].sheaf,Slice[l].Over[L,X,d].sheaf].Of[theta,Slice[l].Over[L,X,d].inv,Slice[l].Over[L,X,d].inv].IsLocal)
 (theta-iso : Iso[l].Maps[Slice[l].Over[L,X,d].lattice,Slice[l].Over[L,X,d].lattice,
   Slice[l].Over[L,X,d].sheaf,Slice[l].Over[L,X,d].sheaf].IsIso theta) {
 module O = DL.Order[L] ;
 module Sl = Slice[l].Over[L,X,d] ;
 module GO = RingedLattice[l].On[L].Of[X.sheaf] ;
 -- phi2: the inclusion followed by theta
 module C = Compose[l].Maps[L,Sl.lattice,Sl.lattice,X.sheaf,Sl.sheaf,Sl.sheaf].Of[theta,Sl.inclusion] ;
 local2 : LocallyRinged[l].Maps[L,Sl.lattice,X.sheaf,Sl.sheaf].Of[C.composite,X.inv,Sl.inv].IsLocal =
  C.Local[X.inv,Sl.inv,Sl.inv,Sl.inclusion-local,theta-local].local ;
 module GA = GlueAlong[l].Over[L,L,Sl.lattice,X,X,Sl.restricted,Sl.inclusion,C.composite,Sl.inclusion-local,local2] ;
 module PB = GA.PB ;
 -- the glued locally ringed lattice
 glued : GA.LRG.LocallyRinged = GA.glued ;

 -- w /\ d = w below d
 cut-inc (w : Sl.Opens) : Id Sl.Opens (Sl.cut (Sl.inc w)) w = Sl.ext (Sl.cut (Sl.inc w)) w (Sl.below w) ;
 -- restriction from u to u /\ d is bijective for u <= d
 down-equiv (u : L.L) (k : O.Le u d) : Pr.isEquiv (X.sheaf.ring u).R (X.sheaf.ring (L.meet u d)).R (map (Sl.down u)) =
  Iso[l].EqualOpens[L,X.sheaf,L.meet u d,u,O.meet-left u d,O.meet-glb u d u (O.le-refl u) k].equiv ;

 -- the two charts
 cut-d : Id Sl.Opens (Sl.cut d) Sl.topS = Sl.ext (Sl.cut d) Sl.topS (O.meet-idem d) ;
 theta-top : Id Sl.Opens (DL.hmap theta.lat (Sl.cut d)) Sl.topS =
  trans (ap (DL.hmap theta.lat) cut-d) (DL.hmap-top theta.lat) ;
 e1 : PB.Opens = PB.pair L.top d (trans (DL.hmap-top Sl.cut-map) (sym theta-top)) ;
 e2 : PB.Opens = PB.pair d L.top (trans cut-d (sym (trans (ap (DL.hmap theta.lat) (DL.hmap-top Sl.cut-map)) (DL.hmap-top theta.lat)))) ;
 covers : Id PB.lattice.L (PB.lattice.join e1 e2) PB.lattice.top =
  PB.ext (PB.lattice.join e1 e2) PB.lattice.top
   (O.le-antisym (L.join L.top d) L.top (O.le-top (L.join L.top d)) (O.join-left L.top d))
   (O.le-antisym (L.join d L.top) L.top (O.le-top (L.join d L.top)) (O.join-right d L.top)) ;

 -- the first chart
 module First {
  module S1 = Slice[l].Over[PB.lattice,glued,e1] ;
  second-le (x : S1.Opens) : O.Le (PB.second (S1.inc x)) d = PB.le-second (S1.inc x) e1 (S1.below x) ;
  -- the projection X^theta|e1 -> X
  lat : DL.Hom S1.lattice L =
   (\ x -> PB.first (S1.inc x),refl L.bot,refl L.top,
    \ x y -> refl (L.join (PB.first (S1.inc x)) (PB.first (S1.inc y))),\ x y -> refl (L.meet (PB.first (S1.inc x)) (PB.first (S1.inc y)))) ;
  sharp (x : S1.Opens) : RH.Hom (S1.sheaf.ring x) (X.sheaf.ring (PB.first (S1.inc x))) = GA.At[S1.inc x].P.proj-left ;
  natural (x y : S1.Opens) (k : S1.OS.Le x y) (z : (S1.sheaf.ring y).R) :
   Id (X.sheaf.ring (PB.first (S1.inc x))).R
    (GO.restrict (PB.first (S1.inc x)) (PB.first (S1.inc y)) (DL.JoinMaps[S1.lattice,L,lat].monotone x y k) (map (sharp y) z))
    (map (sharp x) (map (S1.sheaf.res x y k) z)) =
   GO.res-irr (PB.first (S1.inc x)) (PB.first (S1.inc y)) (DL.JoinMaps[S1.lattice,L,lat].monotone x y k)
    (GA.Res[S1.inc x,S1.inc y,S1.le-inc x y k].k1) (GA.left (S1.inc y) z) ;
  proj : LocallyRinged[l].Maps[S1.lattice,L,S1.sheaf,X.sheaf].Ringed =
   new LocallyRinged[l].Maps[S1.lattice,L,S1.sheaf,X.sheaf].Ringed[lat,sharp,natural] ;
  -- its lattice map is bijective: v = theta*^-1(u /\ d)
  pre (u : L.L) : Sl.Opens = theta-iso.1.sec (Sl.cut u) ;
  back (u : L.L) : S1.Opens =
   (PB.pair u (Sl.inc (pre u)) (sym (trans (ap (DL.hmap theta.lat) (cut-inc (pre u))) (theta-iso.1.sec-eq (Sl.cut u)))),
    PB.le-pair (PB.pair u (Sl.inc (pre u)) (sym (trans (ap (DL.hmap theta.lat) (cut-inc (pre u))) (theta-iso.1.sec-eq (Sl.cut u)))))
     e1 (O.le-top u) (Sl.below (pre u))) ;
  second-back (x : S1.Opens) : Id L.L (Sl.inc (pre (PB.first (S1.inc x)))) (PB.second (S1.inc x)) = calc L.L {
   Sl.inc (theta-iso.1.sec (Sl.cut (PB.first (S1.inc x))))
    =< ap (\ w -> Sl.inc (theta-iso.1.sec w)) (PB.match (S1.inc x))
    > Sl.inc (theta-iso.1.sec (DL.hmap theta.lat (Sl.cut (PB.second (S1.inc x)))))
    =< ap Sl.inc (Pr.sec-ret Sl.Opens Sl.Opens (DL.hmap theta.lat) theta-iso.1 (Sl.cut (PB.second (S1.inc x))))
    > L.meet (PB.second (S1.inc x)) d
    =< second-le x > PB.second (S1.inc x) } ;
  back-first (x : S1.Opens) : Id S1.Opens (back (PB.first (S1.inc x))) x =
   S1.ext (back (PB.first (S1.inc x))) x
    (PB.ext (S1.inc (back (PB.first (S1.inc x)))) (S1.inc x) (refl (PB.first (S1.inc x))) (second-back x)) ;
  lat-equiv : Pr.isEquiv S1.Opens L.L (DL.hmap lat) =
   Pr.qinv S1.Opens L.L (DL.hmap lat) back (\ u -> refl u) back-first ;
  -- its ring maps are bijective: the second leg is
  leg2-equiv (y : PB.Opens) (k : O.Le (PB.second y) d) :
   Pr.isEquiv (X.sheaf.ring (PB.second y)).R (Sl.sheaf.ring (GA.mid y)).R (map (GA.leg2 y)) =
   Iso[l].equiv-compose (X.sheaf.ring (PB.second y)).R (Sl.sheaf.ring (GA.M2.p (PB.second y))).R (Sl.sheaf.ring (GA.mid y)).R
    (map (Sl.sheaf.res (GA.mid y) (GA.M2.p (PB.second y)) (GA.mid-second y))) (map (C.sharp (PB.second y)))
    (Iso[l].EqualOpens[Sl.lattice,Sl.sheaf,GA.mid y,GA.M2.p (PB.second y),GA.mid-second y,
      Sl.OS.le-of-eq (GA.M2.p (PB.second y)) (GA.mid y) (sym (PB.match y))].equiv)
    (Iso[l].equiv-compose (X.sheaf.ring (PB.second y)).R (X.sheaf.ring (L.meet (PB.second y) d)).R
      (Sl.sheaf.ring (DL.hmap theta.lat (Sl.cut (PB.second y)))).R
      (map (theta.sharp (Sl.cut (PB.second y)))) (map (Sl.down (PB.second y)))
      (theta-iso.2 (Sl.cut (PB.second y))) (down-equiv (PB.second y) k)) ;
  ring-equiv (x : S1.Opens) : Pr.isEquiv (S1.sheaf.ring x).R (X.sheaf.ring (PB.first (S1.inc x))).R (map (sharp x)) =
   GA.At[S1.inc x].P.LeftEquiv[leg2-equiv (S1.inc x) (second-le x)].equiv ;
  iso : Iso[l].Maps[S1.lattice,L,S1.sheaf,X.sheaf].IsIso proj = (lat-equiv,ring-equiv) ;
  -- the chart X ~= X^theta|e1
  module Inv = Iso[l].Invert[S1.lattice,L,S1.sheaf,X.sheaf,proj,iso] ;
  chart : LocallyRinged[l].Maps[L,S1.lattice,X.sheaf,S1.sheaf].Ringed = Inv.inverse ;
  chart-iso : Iso[l].Maps[L,S1.lattice,X.sheaf,S1.sheaf].IsIso chart = Inv.inverse-iso ;
  local : LocallyRinged[l].Maps[L,S1.lattice,X.sheaf,S1.sheaf].Of[chart,X.inv,S1.inv].IsLocal =
   Iso[l].Maps[L,S1.lattice,X.sheaf,S1.sheaf].Local[chart,chart-iso,X.inv,S1.inv].local ;
 } ;

 -- the second chart
 module Second {
  module S2 = Slice[l].Over[PB.lattice,glued,e2] ;
  first-le (x : S2.Opens) : O.Le (PB.first (S2.inc x)) d = PB.le-first (S2.inc x) e2 (S2.below x) ;
  -- the projection X^theta|e2 -> X
  lat : DL.Hom S2.lattice L =
   (\ x -> PB.second (S2.inc x),refl L.bot,refl L.top,
    \ x y -> refl (L.join (PB.second (S2.inc x)) (PB.second (S2.inc y))),\ x y -> refl (L.meet (PB.second (S2.inc x)) (PB.second (S2.inc y)))) ;
  sharp (x : S2.Opens) : RH.Hom (S2.sheaf.ring x) (X.sheaf.ring (PB.second (S2.inc x))) = GA.At[S2.inc x].P.proj-right ;
  natural (x y : S2.Opens) (k : S2.OS.Le x y) (z : (S2.sheaf.ring y).R) :
   Id (X.sheaf.ring (PB.second (S2.inc x))).R
    (GO.restrict (PB.second (S2.inc x)) (PB.second (S2.inc y)) (DL.JoinMaps[S2.lattice,L,lat].monotone x y k) (map (sharp y) z))
    (map (sharp x) (map (S2.sheaf.res x y k) z)) =
   GO.res-irr (PB.second (S2.inc x)) (PB.second (S2.inc y)) (DL.JoinMaps[S2.lattice,L,lat].monotone x y k)
    (GA.Res[S2.inc x,S2.inc y,S2.le-inc x y k].k2) (GA.right (S2.inc y) z) ;
  proj : LocallyRinged[l].Maps[S2.lattice,L,S2.sheaf,X.sheaf].Ringed =
   new LocallyRinged[l].Maps[S2.lattice,L,S2.sheaf,X.sheaf].Ringed[lat,sharp,natural] ;
  -- its lattice map is bijective: u = theta*(v /\ d)
  image (v : L.L) : Sl.Opens = DL.hmap theta.lat (Sl.cut v) ;
  back (v : L.L) : S2.Opens =
   (PB.pair (Sl.inc (image v)) v (cut-inc (image v)),
    PB.le-pair (PB.pair (Sl.inc (image v)) v (cut-inc (image v))) e2 (Sl.below (image v)) (O.le-top v)) ;
  first-back (x : S2.Opens) : Id L.L (Sl.inc (image (PB.second (S2.inc x)))) (PB.first (S2.inc x)) = calc L.L {
   Sl.inc (image (PB.second (S2.inc x))) =< ap Sl.inc (sym (PB.match (S2.inc x))) > L.meet (PB.first (S2.inc x)) d
    =< first-le x > PB.first (S2.inc x) } ;
  back-second (x : S2.Opens) : Id S2.Opens (back (PB.second (S2.inc x))) x =
   S2.ext (back (PB.second (S2.inc x))) x
    (PB.ext (S2.inc (back (PB.second (S2.inc x)))) (S2.inc x) (first-back x) (refl (PB.second (S2.inc x)))) ;
  lat-equiv : Pr.isEquiv S2.Opens L.L (DL.hmap lat) =
   Pr.qinv S2.Opens L.L (DL.hmap lat) back (\ v -> refl v) back-second ;
  -- its ring maps are bijective: the first leg is a restriction between equal opens
  ring-equiv (x : S2.Opens) : Pr.isEquiv (S2.sheaf.ring x).R (X.sheaf.ring (PB.second (S2.inc x))).R (map (sharp x)) =
   GA.At[S2.inc x].P.RightEquiv[down-equiv (PB.first (S2.inc x)) (first-le x)].equiv ;
  iso : Iso[l].Maps[S2.lattice,L,S2.sheaf,X.sheaf].IsIso proj = (lat-equiv,ring-equiv) ;
  -- the chart X ~= X^theta|e2
  module Inv = Iso[l].Invert[S2.lattice,L,S2.sheaf,X.sheaf,proj,iso] ;
  chart : LocallyRinged[l].Maps[L,S2.lattice,X.sheaf,S2.sheaf].Ringed = Inv.inverse ;
  chart-iso : Iso[l].Maps[L,S2.lattice,X.sheaf,S2.sheaf].IsIso chart = Inv.inverse-iso ;
  local : LocallyRinged[l].Maps[L,S2.lattice,X.sheaf,S2.sheaf].Of[chart,X.inv,S2.inv].IsLocal =
   Iso[l].Maps[L,S2.lattice,X.sheaf,S2.sheaf].Local[chart,chart-iso,X.inv,S2.inv].local ;
 } ;
} ;
