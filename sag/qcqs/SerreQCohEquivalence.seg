-- Serre's equivalence Mod(A) = QCoh(Spec A), as an identification of
-- univalent categories (PLAN-QCOH-UA.md, step 6).
--
-- Objects. Mod(A) is the univalent category SerreModuleUnivalent; it is
-- moved to Category[l+,l+] as the full subcategory on the trivial
-- property (as QcqsCategories does for spaces). QCoh(Spec A) is
-- SerreQCohCategory on Spec A = Affine.spec over the Zariski lattice.
-- The functor sends M to (M~, M~ quasi-coherent) (SerreAssociatedSheaf,
-- SerreTildeQuasiCoherent) and u to the associated natural map
-- (SerreAssociatedMap).
-- Functor laws. A natural map is determined by its section maps
-- (Arrow.ext). For the identity: id~ acts as the identity on sections
-- (SerreAssociatedMapLaws.Identity), after identifying the identity of
-- Mod(A) with the one used there (equal underlying functions). For the
-- composite: (g f)~ = g~ f~ on sections (SerreAssociatedMapLaws.Composite),
-- and composition of natural maps is pointwise by definition.
-- Fully faithful: SerreTildeFaithful. Essentially surjective, even split:
-- for F quasi-coherent, Gamma(F)~ ~= F (SerreTildeEssential) as a natural
-- linear equivalence, hence a categorical iso (SerreModuleSheafCategory
-- .to-iso). WeakCategoryEquivalence gives an equivalence of object types,
-- CategoryQuasiInverse an equivalence of categories, and the structure
-- identity principle for univalent categories (FibreCategorySIPTheorem)
-- the identification Mod(A) = QCoh(Spec A).
level l ; open Base ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ; module Tr = Truncation[l+] ;
module SM = SerreModule[l] ;
module K = Category[l+,l+] ;
module F = Functor[l+,l+,l+,l+] ;
Trivial (X : U l+) : U l+ = Top ;
-- an equivalence between small types is one at the next level (same data)
raise (X Y : U l) (f : X -> Y) (e : Pr.isEquiv X Y f) : Hi.isEquiv X Y f =
 new Hi.IsEquiv[X,Y,f,sec := e.sec,sec-eq := e.sec-eq,ret := e.ret,ret-eq := e.ret-eq] ;
trivial-prop (X : U l+) : Hi.isProp (Trivial X) = split { tt -> split { tt -> refl tt } } ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module AF = Affine[l].Over[A] ; module Z = ZariskiLattice[l].Over[A] ;
 module MU = SerreModuleUnivalent[l].Over[A] ;
 module MC = SerreModuleCategory[l].Over[A] ;
 module Bl = SerreBilinear[l].Over[A] ;
 module Modules = FullSubcategory[l+,l].Over[MU.category,\ M -> Trivial (MU.category.pre.ob),\ M -> trivial-prop (MU.category.pre.ob)] ;
 module QCoh = SerreQCohCategory[l].On[Z.lattice,AF.spec] ;
 module Sh = QCoh.Sheaves ;
 Mod : U l+ = Modules.precategory.ob ;
 -- the associated sheaf, and its quasi-coherence
 tilde (M : SM.Over[A].Module) : Sh.precategory.ob = SerreAssociatedSheaf[l].Over[A,setA,M].associated ;
 on-objects (M : Mod) : QCoh.precategory.ob = (tilde M.1,SerreTildeQuasiCoherent[l].Over[A,setA,M.1].qcoh) ;
 on-arrows (M N : Mod) (u : Modules.precategory.hom M N) : QCoh.precategory.hom (on-objects M) (on-objects N) =
  SerreTildeFaithful[l].Over[A,setA,M.1,N.1].forward u ;
 -- the identity: id~ is the identity on sections
 module IdLaw (M : Mod) {
  module I = SerreAssociatedMapLaws[l].Identity[A,setA,M.1] ;
  same : Id (MC.Hom M.1 M.1) (Modules.precategory.idn M) I.identity =
   Bl.Hom[M.1,M.1].ext _ _ (\ x -> sym (I.identity-at x)) ;
  at (v : Z.lattice.L) (s : ((tilde M.1).presheaf.module-at v).M) :
   Id ((tilde M.1).presheaf.module-at v).M (Sh.at (tilde M.1) (tilde M.1) (on-arrows M M (Modules.precategory.idn M)) v s)
    (Sh.at (tilde M.1) (tilde M.1) (Sh.idn (tilde M.1)) v s) =
   trans (ap (\ u -> Sh.at (tilde M.1) (tilde M.1) (on-arrows M M u) v s) same)
    (trans (I.morphism-at v s) (sym (Sh.idn-at (tilde M.1) v s))) ;
  law : Id (QCoh.precategory.hom (on-objects M) (on-objects M)) (on-arrows M M (Modules.precategory.idn M)) (QCoh.precategory.idn (on-objects M)) =
   Sh.Arrow[(tilde M.1).presheaf,(tilde M.1).presheaf].ext _ _ at ;
 } ;
 -- the composite: (g f)~ = g~ f~ on sections
 module CompLaw (M N P : Mod) (g : Modules.precategory.hom N P) (f : Modules.precategory.hom M N) {
  module C = SerreAssociatedMapLaws[l].Composite[A,setA,M.1,N.1,P.1,f,g] ;
  same : Id (MC.Hom M.1 P.1) (Modules.precategory.comp M N P g f) C.composite =
   Bl.Hom[M.1,P.1].ext _ _ (\ x -> sym (C.composite-at x)) ;
  at (v : Z.lattice.L) (s : ((tilde M.1).presheaf.module-at v).M) :
   Id ((tilde P.1).presheaf.module-at v).M (Sh.at (tilde M.1) (tilde P.1) (on-arrows M P (Modules.precategory.comp M N P g f)) v s)
    (Sh.at (tilde M.1) (tilde P.1) (QCoh.precategory.comp (on-objects M) (on-objects N) (on-objects P) (on-arrows N P g) (on-arrows M N f)) v s) =
   trans (ap (\ u -> Sh.at (tilde M.1) (tilde P.1) (on-arrows M P u) v s) same) (sym (C.morphism-at v s)) ;
  law : Id (QCoh.precategory.hom (on-objects M) (on-objects P)) (on-arrows M P (Modules.precategory.comp M N P g f))
   (QCoh.precategory.comp (on-objects M) (on-objects N) (on-objects P) (on-arrows N P g) (on-arrows M N f)) =
   Sh.Arrow[(tilde M.1).presheaf,(tilde P.1).presheaf].ext _ _ at ;
 } ;
 functor : F.Functor[Modules.precategory,QCoh.precategory] = new F.Functor[Modules.precategory,QCoh.precategory,on-objects,on-arrows,
  \ M -> IdLaw[M].law,\ M N P g f -> CompLaw[M,N,P,g,f].law] ;
 fully-faithful : F.FullyFaithful Modules.precategory QCoh.precategory functor =
  \ M N -> raise SerreTildeFaithful[l].Over[A,setA,M.1,N.1].Lin.Hom SerreTildeFaithful[l].Over[A,setA,M.1,N.1].Transforms.Hom
   SerreTildeFaithful[l].Over[A,setA,M.1,N.1].forward SerreTildeFaithful[l].Over[A,setA,M.1,N.1].fully-faithful ;
 -- split essential surjectivity: Gamma(F)~ ~= F
 module At (E : QCoh.precategory.ob) {
  module Es = SerreTildeEssential[l].Over[A,setA,E.1,E.2] ;
  Preimage : U l+ = (M : Mod) * QCoh.precategory.Iso (on-objects M) E ;
  preimage : Preimage = ((Es.Gamma,tt),Sh.to-iso (tilde Es.Gamma) E.1 Es.equivalence) ;
 } ;
 split-surjective : F.SplitEssSurj Modules.precategory QCoh.precategory functor = \ E -> At[E].preimage ;
 essentially-surjective : F.EssSurj Modules.precategory QCoh.precategory functor =
  \ E -> Tr.Trunc[At[E].Preimage].inc At[E].preimage ;
 -- the equivalence, and the identification
 module Comparison = WeakCategoryEquivalence[l+].Over[Modules.category,QCoh.category,functor,fully-faithful,essentially-surjective] ;
 object-equivalence : Hi.isEquiv Mod QCoh.precategory.ob on-objects = Comparison.object-equivalence ;
 module Inverse = CategoryQuasiInverse[l+].Over[Modules.category,QCoh.category,functor,fully-faithful,essentially-surjective] ;
 equivalence : CategoryQuasiInverse[l+].Equivalence[Modules.category,QCoh.category,functor] = Inverse.equivalence ;
 fibre-equivalence : FibreCategoryEquivalence[l+].Equivalence[Modules.category,QCoh.category] =
  FibreCategoryAdapter[l+].Over[Modules.category,QCoh.category,functor,equivalence].equivalence ;
 equality : Id K.Category Modules.category QCoh.category =
  FibreCategorySIPTheorem[l+].On[Modules.category,QCoh.category,fibre-equivalence].equality ;
} ;
