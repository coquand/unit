-- The affine line with doubled origin (DESIGN.md, step 4, Next 2;
-- DOUBLE-ORIGIN.md): Spec k[X] doubled along the punctured line D(X).
-- Its opens are the pairs (u, v) of opens of k[X] with u /\ D(X) =
-- v /\ D(X); its sections over (u, v) are the pairs of sections agreeing on
-- the punctured part.  k is any commutative ring (the zero ring included).
-- Its two charts, the opens below (top, D(X)) and below (D(X), top), are
-- each Spec k[X] (Chart: iota, to, natural, inv-to and iota2, to2, ..).
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) {
 module P = PolynomialRing[l].Extension[k,setk] ;
 module Z = ZariskiLattice[l].Over[P.ring] ;
 -- the punctured line
 punctured : Z.lattice.L = Z.D P.variable ;
 line : LocallyRinged[l].On[Z.lattice].LocallyRinged = Affine[l].Over[P.ring].spec ;
 module Dbl = Doubling[l].Over[Z.lattice,line,punctured] ;
 doubled-line : Dbl.LR2.LocallyRinged = Dbl.doubled ;
 module Charts = Chart[l].Over[Z.lattice,line,punctured] ;
} ;
