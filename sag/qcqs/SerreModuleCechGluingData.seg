-- The actual degree-one principal-localisation diagram (Serre note §3).
-- A cocycle c_ij lives in M_(fi fj). Its triple equation is checked in
-- M_(fk (fi fj)), using the actual restriction maps. Restriction along
-- either path from M_fi to that triple agrees by localisation uniqueness.
-- Degree-one vanishing means mere local b_i with b_j-b_i=c_ij.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module SM = SerreModule[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (Md : SM.Over[A].Module) {
 module Data = SerreModuleGluingData[l].Over[A,setA,Md] ;
 module R = Data.R ; module Z = Data.Z ; module O = Data.O ;
 module Overlap = SerreModuleBasicRestrictionsOverlap[l].Over[A,setA,Md] ;
 module Cover (n : Nat) (fs : Fin n -> A.R)
  (covers : O.Le Z.lattice.top (Z.J.bigJ n (\ i -> Z.D (fs i)))) {
  module C = Data.Cover[n,fs,covers] ;
  Cochain : U l = (i j : Fin n) -> C.Pair[i,j].P.L.Carrier ;
  module Triple (k i j : Fin n) {
   module Step = Overlap.At[fs k,C.Pair[i,j].overlap] ;
   domain : A.R = Step.gh ;
   module P = Data.Local[domain] ;
   below-k : O.Le (Z.D domain) (Z.D (fs k)) = Data.left (fs k) C.Pair[i,j].overlap ;
   below-ij : O.Le (Z.D domain) (Z.D C.Pair[i,j].overlap) = Step.below ;
   below-i : O.Le (Z.D domain) (Z.D (fs i)) =
    O.le-trans (Z.D domain) (Z.D C.Pair[i,j].overlap) (Z.D (fs i)) below-ij (Data.left (fs i) (fs j)) ;
   below-j : O.Le (Z.D domain) (Z.D (fs j)) =
    O.le-trans (Z.D domain) (Z.D C.Pair[i,j].overlap) (Z.D (fs j)) below-ij (Data.right (fs i) (fs j)) ;
   below-ki : O.Le (Z.D domain) (Z.D C.Pair[k,i].overlap) =
    O.le-trans (Z.D domain) (Z.lattice.meet (Z.D (fs k)) (Z.D (fs i))) (Z.D C.Pair[k,i].overlap)
     (O.meet-glb (Z.D (fs k)) (Z.D (fs i)) (Z.D domain) below-k below-i)
     (O.le-of-eq (Z.lattice.meet (Z.D (fs k)) (Z.D (fs i))) (Z.D C.Pair[k,i].overlap) (sym (Data.Support.at-mul (fs k) (fs i)))) ;
   below-kj : O.Le (Z.D domain) (Z.D C.Pair[k,j].overlap) =
    O.le-trans (Z.D domain) (Z.lattice.meet (Z.D (fs k)) (Z.D (fs j))) (Z.D C.Pair[k,j].overlap)
     (O.meet-glb (Z.D (fs k)) (Z.D (fs j)) (Z.D domain) below-k below-j)
     (O.le-of-eq (Z.lattice.meet (Z.D (fs k)) (Z.D (fs j))) (Z.D C.Pair[k,j].overlap) (sym (Data.Support.at-mul (fs k) (fs j)))) ;
   module KI = R.At[C.Pair[k,i].overlap,domain,below-ki] ;
   module IJ = Step.P ;
   module KJ = R.At[C.Pair[k,j].overlap,domain,below-kj] ;
   through-i (x : C.Index[i].P.L.Carrier) :
    Id P.L.Carrier (IJ.map (C.Pair[i,j].L.map x)) (KI.map (C.Pair[k,i].Rho.map x)) =
    trans (R.rho-comp (fs i) C.Pair[i,j].overlap domain (Data.left (fs i) (fs j)) below-ij below-i x)
     (sym (R.rho-comp (fs i) C.Pair[k,i].overlap domain (Data.right (fs k) (fs i)) below-ki below-i x)) ;
   through-j (x : C.Index[j].P.L.Carrier) :
    Id P.L.Carrier (IJ.map (C.Pair[i,j].Rho.map x)) (KJ.map (C.Pair[k,j].Rho.map x)) =
    trans (R.rho-comp (fs j) C.Pair[i,j].overlap domain (Data.right (fs i) (fs j)) below-ij below-j x)
     (sym (R.rho-comp (fs j) C.Pair[k,j].overlap domain (Data.right (fs k) (fs j)) below-kj below-j x)) ;
   Law (c : Cochain) : U l = Id P.L.Carrier
    (P.Native.localised.madd (KI.map (c k i)) (IJ.map (c i j))) (KJ.map (c k j)) ;
  } ;
  CocycleLaw (c : Cochain) : U l = (k i j : Fin n) -> Triple[k,i,j].Law c ;
  Boundary (c : Cochain) (bs : C.Families) : U l = (i j : Fin n) ->
   Id C.Pair[i,j].P.L.Carrier
    (C.Pair[i,j].P.Laws.sub (C.Pair[i,j].Rho.map (bs j)) (C.Pair[i,j].L.map (bs i))) (c i j) ;
  IsBoundary (c : Cochain) : U l = Tr.Trunc[(bs : C.Families) * Boundary c bs].carrier ;
 } ;
} ;
