-- Semilinear carrier equivalences remain equivalences after localisation.
-- For q:M->N over psi:A->B, the induced map sends x/f^p to q(x)/(psi f)^p.
-- Equal images of two fractions yield a target power equality; scalar
-- compatibility and injectivity of q turn it into the source equality
-- criterion. Conversely lift the numerator of a target fraction through
-- the specified equivalence q. Thus the induced linear map has unique
-- inhabited fibres. No inverse ring map or identification of modules is
-- required, which makes this apply to evaluation with a scalar change.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module Over (A B : CRing) (psi : RingHom[l].Hom A B)
 (Md : SM.Over[A].Module) (Nd : SM.Over[B].Module)
 (q : MM.Between[A,B,psi,Md,Nd].Hom)
 (equiv : Pr.isEquiv Md.M Nd.M (MM.Between[A,B,psi,Md,Nd].map q)) (f : A.R) {
 module Q = MM.Between[A,B,psi,Md,Nd] ;
 module Induced = SerreModuleLocalisationLinear[l].Along[A,B,psi,Md,Nd,q,f] ;
 module S = Induced.S ; module T = Induced.T ;
 same-fractions (x y : Md.M) (p : Nat)
  (same : Id T.L.Carrier
   (Induced.Maps.map Induced.induced (S.L.fraction x p))
   (Induced.Maps.map Induced.induced (S.L.fraction y p))) :
  Id S.L.Carrier (S.L.fraction x p) (S.L.fraction y p) =
  Tr.Trunc[T.L.Witness (Q.map q x,p) (Q.map q y,p)].induction @l
   (\ w -> Id S.L.Carrier (S.L.fraction x p) (S.L.fraction y p)) (\ w -> S.L.carrier-set _ _)
   (\ w -> S.L.equal x y p p (Tr.Trunc[S.L.Witness (x,p) (y,p)].inc
    (w.1,Iso[l].injective Md.M Nd.M (Q.map q) equiv _ _
     (trans (Induced.Map.power-map (plus w.1 p) x)
      (trans w.2 (sym (Induced.Map.power-map (plus w.1 p) y)))))))
   (T.L.detect (Q.map q x) (Q.map q y) p p
    (trans (sym (Induced.induced-at x p)) (trans same (Induced.induced-at y p)))) ;
 injective (x y : S.L.Carrier) :
  Id T.L.Carrier (Induced.Maps.map Induced.induced x) (Induced.Maps.map Induced.induced y) -> Id S.L.Carrier x y =
  S.L.pair-induction
   (\ x y -> Id T.L.Carrier (Induced.Maps.map Induced.induced x) (Induced.Maps.map Induced.induced y) -> Id S.L.Carrier x y)
   (\ x y -> FE.isProp-Pi (Id T.L.Carrier (Induced.Maps.map Induced.induced x) (Induced.Maps.map Induced.induced y))
    (\ e -> Id S.L.Carrier x y) (\ e -> S.L.carrier-set _ _)) same-fractions x y ;
 Fibre (y : T.L.Carrier) : U l = (x : S.L.Carrier) * Id T.L.Carrier (Induced.Maps.map Induced.induced x) y ;
 fibre-prop (y : T.L.Carrier) : Pr.isProp (Fibre y) = \ x z ->
  Pr.Sigma-eq S.L.Carrier (\ x -> Id T.L.Carrier (Induced.Maps.map Induced.induced x) y) x.1 z.1 x.2 z.2
   (injective x.1 z.1 (trans x.2 (sym z.2))) (T.L.carrier-set _ _) ;
 preimage (y : T.L.Carrier) : Fibre y =
  Tr.Trunc[(a : Nd.M) * (p : Nat) * Id T.L.Carrier (T.L.fraction a p) y].induction @l
   (\ t -> Fibre y) (\ t -> fibre-prop y)
   (\ w -> (S.L.fraction (equiv.sec w.1) w.2.1,
    trans (Induced.induced-at (equiv.sec w.1) w.2.1)
     (trans (ap (\ a -> T.L.fraction a w.2.1) (equiv.sec-eq w.1)) w.2.2))) (T.L.represented y) ;
 inverse (y : T.L.Carrier) : S.L.Carrier = (preimage y).1 ;
 right (y : T.L.Carrier) : Id T.L.Carrier (Induced.Maps.map Induced.induced (inverse y)) y = (preimage y).2 ;
 left (x : S.L.Carrier) : Id S.L.Carrier (inverse (Induced.Maps.map Induced.induced x)) x = injective _ _ (right (Induced.Maps.map Induced.induced x)) ;
 equivalence : Pr.isEquiv S.L.Carrier T.L.Carrier (Induced.Maps.map Induced.induced) =
  Pr.qinv S.L.Carrier T.L.Carrier (Induced.Maps.map Induced.induced) inverse right left ;
 opaque inverse ;
} ;
