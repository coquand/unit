-- Binary products commute with module localisation (Serre, Section 3).
-- Projection on the two numerators defines the comparison. Equality of
-- both projected fractions supplies two killing exponents; adding them
-- gives a single exponent witnessing equality of the pair fractions.
-- Conversely x/f^p and y/f^q have the common denominator f^(p+q), with
-- numerator (f^q x,f^p y). Thus the comparison has unique inverse images.
-- Uniqueness permits elimination of mere representatives into these fibres.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module LC = SerreModuleLocalisation[l] ; module LM = SerreModuleLocalisationMaps[l] ;
module NB = NatBound[l] ;
module At (A : CRing) (Md Nd : SM.Over[A].Module) (f : A.R) {
 module Pair = SerreModuleProducts[l].Pair[A,Md,Nd] ;
 module S = LC.At[A,Pair.product,f] ;
 module T = LC.At[A,Md,f] ; module NLoc = LC.At[A,Nd,f] ;
 module First = LM.Along[A,A,RingHom[l].identity A,Pair.product,Md,Pair.first,f] ;
 module Second = LM.Along[A,A,RingHom[l].identity A,Pair.product,Nd,Pair.second,f] ;
 Target : U l = T.Carrier * NLoc.Carrier ;
 target-set : Pr.isSet Target = Pr.isSet-Sigma T.Carrier (\ x -> NLoc.Carrier) T.carrier-set (\ x -> NLoc.carrier-set) ;
 pair-path (x y : Target) (p : Id T.Carrier x.1 y.1) (q : Id NLoc.Carrier x.2 y.2) : Id Target x y =
  Pr.trans Target x (y.1,x.2) y
   (Pr.ap T.Carrier Target (\ a -> (a,x.2)) x.1 y.1 p)
   (Pr.ap NLoc.Carrier Target (\ b -> (y.1,b)) x.2 y.2 q) ;
 forward (x : S.Carrier) : Target = (First.induced x,Second.induced x) ;
 on-fractions (x : Pair.Carrier) (p : Nat) :
  Id Target (forward (S.fraction x p)) (T.fraction x.1 p,NLoc.fraction x.2 p) =
  pair-path _ _ (First.fraction-map x p) (Second.fraction-map x p) ;
 module Extend (M : SM.Over[A].Module) {
  module V = LC.At[A,M,f] ;
  reorder (e d q : Nat) : Id Nat (plus (plus e d) q) (plus d (plus e q)) =
   trans (ap (\ k -> plus k q) (plus-comm e d)) (NB.plus-assoc d e q) ;
  equality (x y : M.M) (p q e d : Nat)
   (h : Id M.M (V.power (plus e q) x) (V.power (plus e p) y)) :
   Id M.M (V.power (plus (plus e d) q) x) (V.power (plus (plus e d) p) y) =
   trans (ap (\ k -> V.power k x) (reorder e d q))
    (trans (V.power-add d (plus e q) x)
     (trans (ap (V.power d) h)
      (trans (sym (V.power-add d (plus e p) y)) (sym (ap (\ k -> V.power k y) (reorder e d p)))))) ;
 } ;
 module Witnesses (x y : Pair.Carrier) (p q : Nat)
  (h : T.Witness (x.1,p) (y.1,q)) (k : NLoc.Witness (x.2,p) (y.2,q)) {
  exponent : Nat = plus h.1 k.1 ;
  first : Id Md.M (T.power (plus exponent q) x.1) (T.power (plus exponent p) y.1) =
   Extend[Md].equality x.1 y.1 p q h.1 k.1 h.2 ;
  second : Id Nd.M (NLoc.power (plus exponent q) x.2) (NLoc.power (plus exponent p) y.2) =
   trans (ap (\ e -> NLoc.power (plus e q) x.2) (plus-comm h.1 k.1))
    (trans (Extend[Nd].equality x.2 y.2 p q k.1 h.1 k.2)
     (sym (ap (\ e -> NLoc.power (plus e p) y.2) (plus-comm h.1 k.1)))) ;
  witness : S.Witness (x,p) (y,q) = (exponent,Pair.ext _ _
   (trans (First.power-map (plus exponent q) x)
    (trans first (sym (First.power-map (plus exponent p) y))))
   (trans (Second.power-map (plus exponent q) x)
    (trans second (sym (Second.power-map (plus exponent p) y))))) ;
 } ;
 fraction-injective (x y : Pair.Carrier) (p q : Nat)
  (h : Id Target (forward (S.fraction x p)) (forward (S.fraction y q))) :
  Id S.Carrier (S.fraction x p) (S.fraction y q) =
  Tr.Trunc[T.Witness (x.1,p) (y.1,q)].induction @l
   (\ w -> Id S.Carrier (S.fraction x p) (S.fraction y q)) (\ w -> S.carrier-set _ _)
   (\ w -> Tr.Trunc[NLoc.Witness (x.2,p) (y.2,q)].induction @l
    (\ z -> Id S.Carrier (S.fraction x p) (S.fraction y q)) (\ z -> S.carrier-set _ _)
    (\ z -> S.equal x y p q (Tr.Trunc[S.Witness (x,p) (y,q)].inc (Witnesses[x,y,p,q,w,z].witness)))
    (NLoc.detect x.2 y.2 p q (ap (\ v -> v.2)
     (trans (sym (on-fractions x p)) (trans h (on-fractions y q))))))
   (T.detect x.1 y.1 p q (ap (\ v -> v.1)
    (trans (sym (on-fractions x p)) (trans h (on-fractions y q))))) ;
 injective (x : S.Carrier) : (y : S.Carrier) -> Id Target (forward x) (forward y) -> Id S.Carrier x y =
  S.induction @l
   (\ x -> (y : S.Carrier) -> Id Target (forward x) (forward y) -> Id S.Carrier x y)
   (\ x -> FE.isProp-Pi S.Carrier (\ y -> Id Target (forward x) (forward y) -> Id S.Carrier x y)
    (\ y -> FE.isProp-Pi (Id Target (forward x) (forward y)) (\ h -> Id S.Carrier x y) (\ h -> S.carrier-set x y)))
   (\ a p -> S.induction @l
    (\ y -> Id Target (forward (S.fraction a p)) (forward y) -> Id S.Carrier (S.fraction a p) y)
    (\ y -> FE.isProp-Pi (Id Target (forward (S.fraction a p)) (forward y))
     (\ h -> Id S.Carrier (S.fraction a p) y) (\ h -> S.carrier-set _ _))
    (\ b q -> fraction-injective a b p q)) x ;
 Fibre (y : Target) : U l = (x : S.Carrier) * Id Target (forward x) y ;
 fibre-prop (y : Target) : Pr.isProp (Fibre y) = \ u v ->
  Pr.Sigma-eq S.Carrier (\ x -> Id Target (forward x) y) u.1 v.1 u.2 v.2
   (injective u.1 v.1 (trans u.2 (sym v.2))) (target-set (forward v.1) y) ;
 common (x : Md.M) (y : Nd.M) (p q : Nat) : S.Carrier =
  S.fraction (T.power q x,NLoc.power p y) (plus p q) ;
 common-equation (x : Md.M) (y : Nd.M) (p q : Nat) :
  Id Target (forward (common x y p q)) (T.fraction x p,NLoc.fraction y q) =
  trans (on-fractions (T.power q x,NLoc.power p y) (plus p q))
   (pair-path _ _
    (trans (ap (T.fraction (T.power q x)) (plus-comm p q)) (T.raise x p q))
    (NLoc.raise y q p)) ;
 inhabited (y : Target) : Tr.Trunc[Fibre y].carrier =
  Tr.Trunc[(a : Md.M) * (p : Nat) * Id T.Carrier (T.fraction a p) y.1].induction @l
   (\ t -> Tr.Trunc[Fibre y].carrier) (\ t -> Tr.Trunc[Fibre y].proposition)
   (\ a -> Tr.Trunc[(b : Nd.M) * (q : Nat) * Id NLoc.Carrier (NLoc.fraction b q) y.2].induction @l
    (\ t -> Tr.Trunc[Fibre y].carrier) (\ t -> Tr.Trunc[Fibre y].proposition)
    (\ b -> Tr.Trunc[Fibre y].inc (common a.1 b.1 a.2.1 b.2.1,
     trans (common-equation a.1 b.1 a.2.1 b.2.1) (pair-path _ y a.2.2 b.2.2))) (NLoc.represented y.2))
   (T.represented y.1) ;
 preimage (y : Target) : Fibre y = Tr.Trunc[Fibre y].induction @l
  (\ t -> Fibre y) (\ t -> fibre-prop y) (\ t -> t) (inhabited y) ;
 inverse (y : Target) : S.Carrier = (preimage y).1 ;
 forward-inverse (y : Target) : Id Target (forward (inverse y)) y = (preimage y).2 ;
 inverse-forward (x : S.Carrier) : Id S.Carrier (inverse (forward x)) x =
  injective (inverse (forward x)) x (forward-inverse (forward x)) ;
 inverse-on-fractions (x : Md.M) (y : Nd.M) (p : Nat) :
  Id S.Carrier (inverse (T.fraction x p,NLoc.fraction y p)) (S.fraction (x,y) p) =
  injective _ _ (trans (forward-inverse (T.fraction x p,NLoc.fraction y p)) (sym (on-fractions (x,y) p))) ;
 equivalence : Pr.Equiv S.Carrier Target =
  (forward,Pr.qinv S.Carrier Target forward inverse forward-inverse inverse-forward) ;
 opaque forward ; opaque inverse ;
} ;
