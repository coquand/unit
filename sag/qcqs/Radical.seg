-- Radicals of finitely generated ideals (DESIGN.md, step 2).  A family
-- b = (b_1, .., b_n) of elements of A generates the ideal (b); x is in the
-- radical of (b) if some power x^k is in (b).  For families a, b, a <= b
-- means that every a_i is in the radical of (b): this is the order of the
-- Zariski lattice, D(a) <= D(b).
--
-- Lemma (two powers).  For all p, q there are X, Y with
--  (u + v)^(p+q) = X u^p + Y v^q.
--  By induction: for p = 0 or q = 0 take X = (u + v)^q, Y = 0, or X = 0,
--  Y = (u + v)^(p+0).  For p + 1, q + 1, with N = p + (q + 1) = (p + 1) + q,
--  write (u + v)^N = X1 u^p + Y1 v^(q+1) and (u + v)^N = X2 u^(p+1) + Y2 v^q
--  (induction hypotheses); then
--   (u + v)^(N+1) = u (u + v)^N + v (u + v)^N
--                 = (X1 + v X2) u^(p+1) + (u Y1 + Y2) v^(q+1).
-- Lemma (the radical is an ideal).  It contains the generators and 0, and
-- is closed under c x (since (c x)^p = c^p x^p) and under x + y (two
-- powers); so it contains every linear combination of elements of the
-- radical.
-- Lemma (powers).  If x^k is in the radical of (c), so is x:
--  (x^k)^m = x^N for some N.
-- Theorem (transitivity).  If a <= b and b <= c then a <= c: a_i^k is a
--  linear combination of the b_j, which are in the radical of (c), so a_i^k
--  is in it, hence a_i.  (Finite choice turns "every b_j merely has a
--  power in (c)" into a choice of powers.)
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (A : CRing) {
 open A ; open RL[A] ;
 module P = AffinePowers[l].Over[A] ;
 module S = FiniteIdeal[l].Sums[A] ;
 power (x : R) (k : Nat) : R = P.power x k ;

 -- finite families and the ideals they generate
 Fam : U l = (n : Nat) * (Fin n -> R) ;
 size (b : Fam) : Nat = b.1 ;
 gen (b : Fam) : Fin (size b) -> R = b.2 ;
 InIdeal (b : Fam) (x : R) : U l = S.Coordinates (size b) (gen b) x ;
 ideal-zero (b : Fam) : InIdeal b z = (\ i -> z,S.lin-zero (size b) (gen b)) ;
 ideal-gen (b : Fam) (i : Fin (size b)) : InIdeal b (gen b i) = S.coordinates (size b) (gen b) i ;
 ideal-add (b : Fam) (x y : R) (h : InIdeal b x) (k : InIdeal b y) : InIdeal b (add x y) =
  (\ i -> add (h.1 i) (k.1 i),
   trans (S.lin-add (size b) (gen b) h.1 k.1) (cong2 R add _ _ _ _ h.2 k.2)) ;
 ideal-scale (b : Fam) (c x : R) (h : InIdeal b x) : InIdeal b (mul c x) =
  (\ i -> mul c (h.1 i),trans (S.lin-scale (size b) (gen b) h.1 c) (ap (mul c) h.2)) ;
 ideal-eq (b : Fam) (x y : R) (e : Id R x y) (h : InIdeal b x) : InIdeal b y = (h.1,trans h.2 e) ;

 -- two powers
 Two (u v : R) (p q : Nat) : U l =
  (X Y : R) * Id R (power (add u v) (plus p q)) (add (mul X (power u p)) (mul Y (power v q))) ;
 two-step (u v Pu Pv N X1 Y1 X2 Y2 : R)
  (e1 : Id R N (add (mul X1 Pu) (mul Y1 (mul v Pv))))
  (e2 : Id R N (add (mul X2 (mul u Pu)) (mul Y2 Pv))) :
  Id R (mul (add u v) N) (add (mul (add X1 (mul v X2)) (mul u Pu)) (mul (add (mul u Y1) Y2) (mul v Pv))) = calc R {
  mul (add u v) N
   =< dist-left u v N > add (mul u N) (mul v N)
   =< cong2 R add _ _ _ _ (ap (mul u) e1) (ap (mul v) e2)
    > add (mul u (add (mul X1 Pu) (mul Y1 (mul v Pv)))) (mul v (add (mul X2 (mul u Pu)) (mul Y2 Pv)))
   =< cong2 R add _ _ _ _ (dist u (mul X1 Pu) (mul Y1 (mul v Pv))) (dist v (mul X2 (mul u Pu)) (mul Y2 Pv))
    > add (add (mul u (mul X1 Pu)) (mul u (mul Y1 (mul v Pv)))) (add (mul v (mul X2 (mul u Pu))) (mul v (mul Y2 Pv)))
   =< cong2 R add _ _ _ _
       (cong2 R add _ _ _ _ (mul-swap u X1 Pu) (mulA u Y1 (mul v Pv)))
       (cong2 R add _ _ _ _ (mulA v X2 (mul u Pu)) (mul-swap v Y2 Pv))
    > add (add (mul X1 (mul u Pu)) (mul (mul u Y1) (mul v Pv))) (add (mul (mul v X2) (mul u Pu)) (mul Y2 (mul v Pv)))
   =< swap (mul X1 (mul u Pu)) (mul (mul u Y1) (mul v Pv)) (mul (mul v X2) (mul u Pu)) (mul Y2 (mul v Pv))
    > add (add (mul X1 (mul u Pu)) (mul (mul v X2) (mul u Pu))) (add (mul (mul u Y1) (mul v Pv)) (mul Y2 (mul v Pv)))
   =< cong2 R add _ _ _ _ (sym (dist-left X1 (mul v X2) (mul u Pu))) (sym (dist-left (mul u Y1) Y2 (mul v Pv)))
    > add (mul (add X1 (mul v X2)) (mul u Pu)) (mul (add (mul u Y1) Y2) (mul v Pv)) } ;
 two (u v : R) : (p q : Nat) -> Two u v p q = split {
  zero -> \ q -> (power (add u v) q,z,
    trans (sym (mulO (power (add u v) q)))
     (sym (trans (ap (add (mul (power (add u v) q) o)) (zero-mul (power v q))) (addZ (mul (power (add u v) q) o))))) ;
  suc p | outer -> split {
   zero -> (z,power (add u v) (plus (suc p) zero),
     trans (sym (mulO (power (add u v) (plus (suc p) zero))))
      (sym (trans (ap (\ t -> add t (mul (power (add u v) (plus (suc p) zero)) o)) (zero-mul (power u (suc p))))
        (zl (mul (power (add u v) (plus (suc p) zero)) o))))) ;
   suc q | inner ->
    (add (outer (suc q)).1 (mul v inner.1),add (mul u (outer (suc q)).2.1) inner.2.1,
     two-step u v (power u p) (power v q) (power (add u v) (plus p (suc q)))
      (outer (suc q)).1 (outer (suc q)).2.1 inner.1 inner.2.1
      (outer (suc q)).2.2
      (trans (ap (power (add u v)) (plus-suc p q)) inner.2.2)) } } ;

 -- the radical
 RadData (b : Fam) (x : R) : U l = (k : Nat) * InIdeal b (power x k) ;
 -- the parts of x^k = sum b_i v_i
 rad-power {b : Fam} {x : R} (r : RadData b x) : Nat = r.1 ;
 rad-coefficients {b : Fam} {x : R} (r : RadData b x) : Fin (size b) -> R = r.2.1 ;
 rad-equation {b : Fam} {x : R} (r : RadData b x) :
  Id R (S.lin (size b) (gen b) (rad-coefficients r)) (power x (rad-power r)) = r.2.2 ;
 InRad (b : Fam) (x : R) : U l = Tr.Trunc[RadData b x].carrier ;
 rad-prop (b : Fam) (x : R) : Pr.isProp (InRad b x) = Tr.Trunc[RadData b x].proposition ;
 rad-gen (b : Fam) (i : Fin (size b)) : RadData b (gen b i) =
  (suc zero,ideal-eq b (gen b i) (power (gen b i) (suc zero)) (sym (mulO (gen b i))) (ideal-gen b i)) ;
 rad-zero (b : Fam) : RadData b z =
  (suc zero,ideal-eq b z (power z (suc zero)) (sym (zero-mul o)) (ideal-zero b)) ;
 rad-scale (b : Fam) (c x : R) (h : RadData b x) : RadData b (mul c x) =
  (h.1,ideal-eq b (mul (power c h.1) (power x h.1)) (power (mul c x) h.1) (sym (P.power-mul c x h.1))
    (ideal-scale b (power c h.1) (power x h.1) h.2)) ;
 rad-add (b : Fam) (x y : R) (h : RadData b x) (k : RadData b y) : RadData b (add x y) =
  (plus h.1 k.1,
   ideal-eq b (add (mul (two x y h.1 k.1).1 (power x h.1)) (mul (two x y h.1 k.1).2.1 (power y k.1)))
    (power (add x y) (plus h.1 k.1)) (sym (two x y h.1 k.1).2.2)
    (ideal-add b _ _ (ideal-scale b (two x y h.1 k.1).1 (power x h.1) h.2)
                     (ideal-scale b (two x y h.1 k.1).2.1 (power y k.1) k.2))) ;
 -- every linear combination of elements of the radical is in the radical
 rad-sum : (n : Nat) (b : Fam) (w : Fin n -> R) -> ((i : Fin n) -> RadData b (w i)) ->
  RadData b (S.sum n w) = split {
  zero -> \ b w h -> rad-zero b ;
  suc n | ih -> \ b w h -> rad-add b (w (inr tt)) (S.sum n (\ i -> w (inl i)))
    (h (inr tt)) (ih b (\ i -> w (inl i)) (\ i -> h (inl i))) } ;
 rad-eq (b : Fam) (x y : R) (e : Id R x y) (h : RadData b x) : RadData b y =
  (h.1,ideal-eq b (power x h.1) (power y h.1) (ap (\ t -> power t h.1) e) h.2) ;
 rad-lin (n : Nat) (fs v : Fin n -> R) (c : Fam) (h : (i : Fin n) -> RadData c (fs i)) :
  RadData c (S.lin n fs v) =
  rad-sum n c (\ i -> mul (fs i) (v i))
   (\ i -> rad-eq c (mul (v i) (fs i)) (mul (fs i) (v i)) (mulC (v i) (fs i)) (rad-scale c (v i) (fs i) (h i))) ;

 -- powers: (x^k)^m = x^N for some N
 power-power (x : R) (k : Nat) : (m : Nat) -> (N : Nat) * Id R (power (power x k) m) (power x N) = split {
  zero -> (zero,refl o) ;
  suc m | ih -> (plus k ih.1,trans (ap (mul (power x k)) ih.2) (sym (P.power-add x k ih.1))) } ;
 rad-root (c : Fam) (x : R) (k : Nat) (h : RadData c (power x k)) : RadData c x =
  ((power-power x k h.1).1,
   ideal-eq c (power (power x k) h.1) (power x (power-power x k h.1).1) (power-power x k h.1).2 h.2) ;

 -- the order on families
 Le (a b : Fam) : U l = (i : Fin (size a)) -> InRad b (gen a i) ;
 le-prop (a b : Fam) : Pr.isProp (Le a b) =
  F.isProp-Pi (Fin (size a)) (\ i -> InRad b (gen a i)) (\ i -> rad-prop b (gen a i)) ;
 le-refl (a : Fam) : Le a a = \ i -> Tr.Trunc[RadData a (gen a i)].inc (rad-gen a i) ;
 -- a <= b and b <= c give a <= c
 rad-trans (b c : Fam) (x : R) (h : RadData b x) (k : (j : Fin (size b)) -> RadData c (gen b j)) :
  RadData c x =
  rad-root c x h.1
   (rad-eq c (S.lin (size b) (gen b) h.2.1) (power x h.1) h.2.2
    (rad-lin (size b) (gen b) h.2.1 c k)) ;
 in-rad-trans (b c : Fam) (x : R) (h : InRad b x) (k : Le b c) : InRad c x =
  Tr.Trunc[(j : Fin (size b)) -> RadData c (gen b j)].induction @l (\ t -> InRad c x) (\ t -> rad-prop c x)
   (\ kk -> Tr.Trunc[RadData b x].induction @l (\ t -> InRad c x) (\ t -> rad-prop c x)
     (\ hh -> Tr.Trunc[RadData c x].inc (rad-trans b c x hh kk)) h)
   (AffineFinite[l].choice (size b) (\ j -> RadData c (gen b j)) k) ;
 le-trans (a b c : Fam) (h : Le a b) (k : Le b c) : Le a c = \ i -> in-rad-trans b c (gen a i) (h i) k ;
} ;
