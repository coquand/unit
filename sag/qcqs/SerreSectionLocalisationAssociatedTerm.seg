-- The actual basic member comparison for compact-affine localisation.
-- For D(h)<=w, restrict scalars on associated sections over D(h) along
-- O(w)->O(D(h)), then evaluate at h. This is a semilinear carrier
-- equivalence over the actual map O(w)->A_h. Localise at the section of
-- s on w. The image of that scalar is phi_h(s), by its component formula.
-- Transport the complete native localisation along this scalar equality
-- and apply the checked iterated localisation comparison. The result is
-- an actual equivalence from the localised member to M_(s*h), with a
-- named equation on original member sections. No rings or module carriers
-- are silently identified across the scalar change.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module RH = RingHom[l] ; module RM = RingMaps[l] ;
module MM = SerreModuleMaps[l] ; module SM = SerreModule[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (Md : SM.Over[A].Module) {
 module Associated = SerreAssociatedSheaf[l].Over[A,setA,Md] ;
 module AM = Associated.AM ; module S = AM.N ; module Z = AM.Z ; module O = Z.O ;
 module AF = AM.AF ; module RingSections = AM.G.S ;
 module Glo = Global[l].Over[A,setA,AF.Loc,AF.set,AF.inclusion,AF.elementary] ;
 module RingBasic = BasicOpen[l].Over[A,AF.Loc,AF.set,AF.inclusion,AF.elementary] ;
 module Basic = SerreAssociatedBasicOpen[l].Over[A,AF.Loc,AF.set,AF.inclusion,AF.elementary,AM.system] ;
 module At (w : Z.lattice.L) (s h : A.R) (below : O.Le (Z.D h) w) {
  module Source = MM.RestrictScalars[RingSections.ring w,RingSections.ring (Z.D h),
   RingSections.restriction (Z.D h) w below].Of[S.Ops[Z.D h].section-module] ;
  phi : RH.Hom (RingSections.ring w) (AF.Loc h) =
   RH.compose (RingSections.ring w) (RingSections.ring (Z.D h)) (AF.Loc h)
    RingBasic.At[h].evaluation (RingSections.restriction (Z.D h) w below) ;
  module Maps = MM.Between[RingSections.ring w,AF.Loc h,phi,Source.restricted,AM.R.Local[h].Scalars.localised] ;
  evaluation : Maps.Hom = new Maps.Hom[Basic.At[h].Maps.map Basic.At[h].evaluation,
   Basic.At[h].Maps.map-add Basic.At[h].evaluation,
   \ a x -> trans (ap (Basic.At[h].Maps.map Basic.At[h].evaluation) (Source.scalar-at a x))
    (trans (Basic.At[h].Maps.map-scale Basic.At[h].evaluation (RM.map (RingSections.restriction (Z.D h) w below) a) x)
     (ap (\ b -> AM.R.Local[h].Scalars.localised.sm b (Basic.At[h].Maps.map Basic.At[h].evaluation x))
      (sym (RM.map-compose RingBasic.At[h].evaluation (RingSections.restriction (Z.D h) w below) a))))] ;
  evaluation-at (x : S.Section (Z.D h)) :
   Id AM.R.Local[h].Native.L.Carrier (Maps.map evaluation x) (Basic.At[h].Maps.map Basic.At[h].evaluation x) =
   refl (Basic.At[h].Maps.map Basic.At[h].evaluation x) ;
  evaluation-equiv : Pr.isEquiv (S.Section (Z.D h)) AM.R.Local[h].Native.L.Carrier (Maps.map evaluation) =
   Iso[l].equiv-homotopy (S.Section (Z.D h)) AM.R.Local[h].Native.L.Carrier
    (Basic.At[h].Maps.map Basic.At[h].evaluation) (Maps.map evaluation)
    (\ x -> sym (evaluation-at x)) Basic.At[h].equivalence ;
  section-s : (RingSections.ring w).R = RM.map Glo.Of[w].sections s ;
  scalar-equation : Id (AF.Loc h).R (RM.map phi section-s) (RM.map (AF.inclusion h) s) =
   trans (RM.map-compose RingBasic.At[h].evaluation (RingSections.restriction (Z.D h) w below) section-s)
    (trans (ap (RM.map RingBasic.At[h].evaluation) (RingSections.restriction-map (Z.D h) w below section-s))
     (trans (RingBasic.At[h].evaluation-map (RingSections.restrict (Z.D h) w below section-s))
      (trans (RingSections.restrict-at (Z.D h) w below section-s h RingBasic.At[h].gg)
       (Glo.Of[w].section-at s h (O.le-trans (Z.D h) (Z.D h) w RingBasic.At[h].gg below))))) ;
  module LocalEvaluation = SerreSectionLocalisationEquivalence[l].Over[
   RingSections.ring w,AF.Loc h,phi,Source.restricted,AM.R.Local[h].Scalars.localised,evaluation,evaluation-equiv,section-s] ;
  module ChangeElement = SerreModuleLocalisationElementTransport[l].Over[
   AF.Loc h,AM.R.Local[h].Scalars.localised,RM.map phi section-s].Along[RM.map (AF.inclusion h) s,scalar-equation] ;
  module Iterated = SerreModuleBasicRestrictionsIterated[l].Over[A,setA,Md].At[h,s] ;
  map (x : LocalEvaluation.S.L.Carrier) : AM.R.Local[Iterated.OL.gh].Native.L.Carrier =
   Iterated.Comparison.forward (ChangeElement.map (LocalEvaluation.Induced.Maps.map LocalEvaluation.Induced.induced x)) ;
  equivalence : Pr.isEquiv LocalEvaluation.S.L.Carrier AM.R.Local[Iterated.OL.gh].Native.L.Carrier map =
   Iso[l].equiv-compose LocalEvaluation.S.L.Carrier ChangeElement.Target.Carrier AM.R.Local[Iterated.OL.gh].Native.L.Carrier
    Iterated.Comparison.forward
    (\ x -> ChangeElement.map (LocalEvaluation.Induced.Maps.map LocalEvaluation.Induced.induced x)) Iterated.Comparison.equivalence
    (Iso[l].equiv-compose LocalEvaluation.S.L.Carrier LocalEvaluation.T.L.Carrier ChangeElement.Target.Carrier
     ChangeElement.map (LocalEvaluation.Induced.Maps.map LocalEvaluation.Induced.induced)
     ChangeElement.equivalence LocalEvaluation.equivalence) ;
  on-original (x : S.Section (Z.D h)) :
   Id AM.R.Local[Iterated.OL.gh].Native.L.Carrier (map (LocalEvaluation.S.L.fraction x zero))
    (Iterated.P.map (Basic.At[h].Maps.map Basic.At[h].evaluation x)) =
   trans (ap (\ z -> Iterated.Comparison.forward (ChangeElement.map z)) (LocalEvaluation.Induced.induced-at x zero))
    (trans (ap Iterated.Comparison.forward (ChangeElement.on-fraction (Maps.map evaluation x) zero))
     (trans (Iterated.canonical-equation (Maps.map evaluation x))
      (ap Iterated.P.map (evaluation-at x)))) ;
  module Support = Z.Sup.Of[Z.D,Z.support] ;
  target-open : Z.lattice.L = Z.lattice.meet (Z.D h) (Z.D s) ;
  target-below : O.Le target-open w = O.le-trans target-open (Z.D h) w (O.meet-left (Z.D h) (Z.D s)) below ;
  open-equation : Id Z.lattice.L (Z.D Iterated.OL.gh) target-open =
   trans (Support.at-mul s h) (Z.lattice.meetC (Z.D s) (Z.D h)) ;
  basic-below : O.Le (Z.D Iterated.OL.gh) w =
   O.le-trans (Z.D Iterated.OL.gh) target-open w
    (O.le-of-eq (Z.D Iterated.OL.gh) target-open open-equation) target-below ;
  module EqualOpens = SerreModuleSheafEqualOpens[l].Over[Z.lattice,AM.G.SH.structure,Associated.associated,w].Equal[
   Z.D Iterated.OL.gh,basic-below,target-open,target-below,open-equation] ;
  extension-equiv : Pr.isEquiv AM.R.Local[Iterated.OL.gh].Native.L.Carrier (S.Section (Z.D Iterated.OL.gh)) Basic.At[Iterated.OL.gh].extend =
   Pr.qinv AM.R.Local[Iterated.OL.gh].Native.L.Carrier (S.Section (Z.D Iterated.OL.gh))
    Basic.At[Iterated.OL.gh].extend Basic.At[Iterated.OL.gh].eval
    Basic.At[Iterated.OL.gh].extend-eval Basic.At[Iterated.OL.gh].eval-extend ;
  section-map (x : LocalEvaluation.S.L.Carrier) : S.Section target-open =
   EqualOpens.Forward.Maps.map EqualOpens.Forward.linear (Basic.At[Iterated.OL.gh].extend (map x)) ;
  section-equivalence : Pr.isEquiv LocalEvaluation.S.L.Carrier (S.Section target-open) section-map =
   Iso[l].equiv-compose LocalEvaluation.S.L.Carrier (S.Section (Z.D Iterated.OL.gh)) (S.Section target-open)
    (EqualOpens.Forward.Maps.map EqualOpens.Forward.linear)
    (\ x -> Basic.At[Iterated.OL.gh].extend (map x)) EqualOpens.equivalence
    (Iso[l].equiv-compose LocalEvaluation.S.L.Carrier AM.R.Local[Iterated.OL.gh].Native.L.Carrier (S.Section (Z.D Iterated.OL.gh))
     Basic.At[Iterated.OL.gh].extend map extension-equiv equivalence) ;
  eval-restriction (x : S.Section (Z.D h)) :
   Id AM.R.Local[Iterated.OL.gh].Native.L.Carrier
    (Basic.At[Iterated.OL.gh].eval (S.restrict (Z.D Iterated.OL.gh) (Z.D h) Iterated.OL.below x))
    (Iterated.P.map (Basic.At[h].Maps.map Basic.At[h].evaluation x)) =
   trans (Basic.natural h Iterated.OL.gh Iterated.OL.below x)
    (trans (AM.component-restriction h Iterated.OL.gh Iterated.OL.below (Basic.At[h].eval x))
     (ap Iterated.P.map (sym (Basic.At[h].evaluation-at x)))) ;
  extension-restriction (x : S.Section (Z.D h)) :
   Id (S.Section (Z.D Iterated.OL.gh))
    (Basic.At[Iterated.OL.gh].extend (Iterated.P.map (Basic.At[h].Maps.map Basic.At[h].evaluation x)))
    (S.restrict (Z.D Iterated.OL.gh) (Z.D h) Iterated.OL.below x) =
   trans (ap Basic.At[Iterated.OL.gh].extend (sym (eval-restriction x)))
    (Basic.At[Iterated.OL.gh].extend-eval (S.restrict (Z.D Iterated.OL.gh) (Z.D h) Iterated.OL.below x)) ;
  section-on-original (x : S.Section (Z.D h)) :
   Id (S.Section target-open) (section-map (LocalEvaluation.S.L.fraction x zero))
    (S.restrict target-open (Z.D h) (O.meet-left (Z.D h) (Z.D s)) x) =
   trans (ap (\ y -> EqualOpens.Forward.Maps.map EqualOpens.Forward.linear (Basic.At[Iterated.OL.gh].extend y)) (on-original x))
    (trans (ap (EqualOpens.Forward.Maps.map EqualOpens.Forward.linear) (extension-restriction x))
     (trans (EqualOpens.Forward.at (S.restrict (Z.D Iterated.OL.gh) (Z.D h) Iterated.OL.below x))
      (trans (S.restriction-map target-open (Z.D Iterated.OL.gh) EqualOpens.forward-below
       (S.restrict (Z.D Iterated.OL.gh) (Z.D h) Iterated.OL.below x))
       (S.restrict-comp target-open (Z.D Iterated.OL.gh) (Z.D h) EqualOpens.forward-below Iterated.OL.below
        (O.meet-left (Z.D h) (Z.D s)) x)))) ;
  opaque section-map ;
  opaque evaluation ; opaque map ;
 } ;
} ;
