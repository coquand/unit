-- Isomorphisms of module presheaves and sheaves (Serre, Section 4).
-- A natural linear morphism whose section maps are equivalences has a
-- natural linear inverse. Apply the injective forward map to prove the
-- inverse preserves addition and scalars, and to prove naturality.
-- This keeps inverse construction behind named component equations.
level l ; open Ring[l] ; open Presentations[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module DL = DistLattice[l] ;
module MS = SerreModuleSheaf[l] ;
module MM = SerreModuleMaps[l] ;
module On (L : DL.DLat) (G : RingedLattice[l].On[L].Presheaf) {
 module O = DL.Order[L] ;
 Equivalence (E F : MS.On[L,G].Presheaf) : U l =
  (q : MS.On[L,G].Transform[E,F].Hom) * ((a : L.L) ->
   Pr.isEquiv (E.module-at a).M (F.module-at a).M (MS.On[L,G].Transform[E,F].at q a)) ;
 forward {E F : MS.On[L,G].Presheaf} (e : Equivalence E F) : MS.On[L,G].Transform[E,F].Hom = e.1 ;
 equiv-at {E F : MS.On[L,G].Presheaf} (e : Equivalence E F) (a : L.L) :
  Pr.isEquiv (E.module-at a).M (F.module-at a).M (MS.On[L,G].Transform[E,F].at (forward e) a) = e.2 a ;
 module Inverse (E F : MS.On[L,G].Presheaf) (e : Equivalence E F) {
  module EF = MS.On[L,G].Transform[E,F] ;
  module FI = MS.On[L,G].Transform[F,E] ;
  module EO = MS.On[L,G].Of[E] ;
  module FO = MS.On[L,G].Of[F] ;
  inverse-map (a : L.L) : (F.module-at a).M -> (E.module-at a).M = (equiv-at e a).sec ;
  right-at (a : L.L) (y : (F.module-at a).M) :
   Id (F.module-at a).M (EF.at (forward e) a (inverse-map a y)) y = (equiv-at e a).sec-eq y ;
  left-at (a : L.L) (x : (E.module-at a).M) :
   Id (E.module-at a).M (inverse-map a (EF.at (forward e) a x)) x =
   Pr.sec-ret (E.module-at a).M (F.module-at a).M (EF.at (forward e) a) (equiv-at e a) x ;
  additive (a : L.L) (x y : (F.module-at a).M) :
   Id (E.module-at a).M (inverse-map a ((F.module-at a).madd x y))
    ((E.module-at a).madd (inverse-map a x) (inverse-map a y)) =
   Iso[l].injective (E.module-at a).M (F.module-at a).M (EF.at (forward e) a) (equiv-at e a) _ _
    (trans (right-at a ((F.module-at a).madd x y))
     (sym (trans (EF.at-add (forward e) a (inverse-map a x) (inverse-map a y))
      (cong2 (F.module-at a).M (F.module-at a).madd _ _ _ _ (right-at a x) (right-at a y))))) ;
  scalar (a : L.L) (r : (G.ring a).R) (x : (F.module-at a).M) :
   Id (E.module-at a).M (inverse-map a ((F.module-at a).sm r x)) ((E.module-at a).sm r (inverse-map a x)) =
   Iso[l].injective (E.module-at a).M (F.module-at a).M (EF.at (forward e) a) (equiv-at e a) _ _
    (trans (right-at a ((F.module-at a).sm r x))
     (sym (trans (EF.at-scale (forward e) a r (inverse-map a x))
      (ap ((F.module-at a).sm r) (right-at a x))))) ;
  natural (a b : L.L) (k : O.Le a b) (x : (F.module-at b).M) :
   Id (E.module-at a).M (inverse-map a (FO.restrict a b k x)) (EO.restrict a b k (inverse-map b x)) =
   Iso[l].injective (E.module-at a).M (F.module-at a).M (EF.at (forward e) a) (equiv-at e a) _ _
    (trans (right-at a (FO.restrict a b k x))
     (sym (trans ((forward e).natural a b k (inverse-map b x))
      (ap (FO.restrict a b k) (right-at b x))))) ;
  inverse-component (a : L.L) :
   MM.Between[G.ring a,G.ring a,RingHom[l].identity (G.ring a),F.module-at a,E.module-at a].Hom =
   new MM.Between[G.ring a,G.ring a,RingHom[l].identity (G.ring a),F.module-at a,E.module-at a].Hom[
    inverse-map a,additive a,scalar a] ;
  inverse : FI.Hom = new FI.Hom[inverse-component,natural] ;
  inverse-at (a : L.L) (x : (F.module-at a).M) :
   Id (E.module-at a).M (FI.at inverse a x) (inverse-map a x) = refl (inverse-map a x) ;
  equivalence : Equivalence F E = (inverse,\ a ->
   Pr.qinv (F.module-at a).M (E.module-at a).M (inverse-map a) (EF.at (forward e) a) (left-at a) (right-at a)) ;
  opaque inverse ;
 } ;
} ;
