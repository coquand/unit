-- Every compact open subspace of a qcqs scheme is qcqs.
-- AffineRefinement gives a merely existing finite affine cover v_i of e
-- in X.  Regard v_i <= e as opens of X|e.  They cover its top by
-- Slice.join-inc.  The double restriction (X|e)|v_i is isomorphic to
-- X|v_i (SliceNested); using the inverse isomorphism transfers affineness
-- from X|v_i to the double restriction.  This gives an affine atlas in
-- X|e.  Eliminate the merely given refinement only into IsQcqs, a truncation.
level l ; open Ring[l] ; open Presentations[l] ;
module Tr = Truncation[l] ;
module DL = DistLattice[l] ;
module Over (M : DL.DLat) (X : LocallyRinged[l].On[M].LocallyRinged) (e : M.L) {
 module Q = Qcqs[l].Over[M,X] ;
 module B = AffineBasis[l].Over[M,X] ;
 module Sl = Slice[l].Over[M,X,e] ;
 module QS = Qcqs[l].Over[Sl.lattice,Sl.restricted] ;
 module FromCover (c : B.Cover e) {
  opens (i : Fin c.count) : Sl.Opens = (c.opens i,c.below i) ;
  covers : Id Sl.Opens (Sl.JS.bigJ c.count opens) Sl.topS =
   Sl.ext (Sl.JS.bigJ c.count opens) Sl.topS (trans (Sl.join-inc c.count opens) c.covers) ;
  module At (i : Fin c.count) {
   module N = SliceNested[l].Over[M,X,e,opens i] ;
   module V = Iso[l].Invert[N.Nested.lattice,N.Single.lattice,N.Nested.sheaf,N.Single.sheaf,N.morphism,N.iso] ;
   affine : QS.AffineOpen (opens i) =
    AffineTransport[l].Over[N.Single.lattice,N.Nested.lattice,N.Single.restricted,N.Nested.restricted,V.inverse,V.inverse-iso,c.affine i].affine ;
  } ;
  cover : QS.AffineCover = struct { count = c.count ; opens = opens ; covers = covers ; affine = \ i -> At[i].affine } ;
 } ;
 qcqs (q : Q.IsQcqs) : QS.IsQcqs =
  Tr.Trunc[B.Cover e].induction @l (\ t -> QS.IsQcqs) (\ t -> Tr.Trunc[QS.AffineCover].proposition)
   (\ c -> Tr.Trunc[QS.AffineCover].inc FromCover[c].cover) (AffineRefinement[l].Over[M,X].refined q e) ;
} ;
