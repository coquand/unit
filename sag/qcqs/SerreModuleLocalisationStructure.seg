-- The module structure on localisation (Serre note, Section 3).
-- Addition is induced by the linear addition map M x M -> M and the
-- finite product comparison.  Its common-denominator formula reduces
-- every module law to the corresponding numerator law, by fraction
-- induction with one common denominator for two or three elements.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module SM = SerreModule[l] ;
module MM = SerreModuleMaps[l] ; module LC = SerreModuleLocalisation[l] ;
module LM = SerreModuleLocalisationMaps[l] ;
module At (A : CRing) (Md : SM.Over[A].Module) (f : A.R) {
 module L = LC.At[A,Md,f] ;
 module Action = SerreModuleLocalisationAction[l].At[A,Md,f] ;
 module Pair = SerreModuleProducts[l].Pair[A,Md,Md] ;
 module ML = SM.Over[A].Laws[Md] ;
 module H = MM.Between[A,A,RingHom[l].identity A,Pair.product,Md] ;
 addition : H.Hom = new H.Hom[
  \ x -> Md.madd x.1 x.2,
  \ x y -> ML.swap-four x.1 y.1 x.2 y.2,
  \ a x -> sym (Md.smD a x.1 x.2)] ;
 addition-at (x : Pair.Carrier) : Id Md.M (H.map addition x) (Md.madd x.1 x.2) = refl (Md.madd x.1 x.2) ;
 module AddMap = LM.Along[A,A,RingHom[l].identity A,Pair.product,Md,addition,f] ;
 module Comparison = SerreModuleLocalisationProduct[l].At[A,Md,Md,f] ;
 add (a b : L.Carrier) : L.Carrier = AddMap.induced (Comparison.inverse (a,b)) ;
 add-at (x y : Md.M) (p : Nat) :
  Id L.Carrier (add (L.fraction x p) (L.fraction y p)) (L.fraction (Md.madd x y) p) =
  trans (ap AddMap.induced (Comparison.inverse-on-fractions x y p))
   (trans (AddMap.fraction-map (x,y) p) (ap (\ z -> L.fraction z p) (addition-at (x,y)))) ;
 add-assoc (a b c : L.Carrier) : Id L.Carrier (add a (add b c)) (add (add a b) c) =
  L.triple-induction (\ a b c -> Id L.Carrier (add a (add b c)) (add (add a b) c))
   (\ a b c -> L.carrier-set _ _)
   (\ x y z p -> trans (ap (add (L.fraction x p)) (add-at y z p))
    (trans (add-at x (Md.madd y z) p)
     (trans (ap (\ w -> L.fraction w p) (Md.maddA x y z))
      (trans (sym (add-at (Md.madd x y) z p))
       (ap (\ a -> add a (L.fraction z p)) (sym (add-at x y p))))))) a b c ;
 add-comm (a b : L.Carrier) : Id L.Carrier (add a b) (add b a) =
  L.pair-induction (\ a b -> Id L.Carrier (add a b) (add b a)) (\ a b -> L.carrier-set _ _)
   (\ x y p -> trans (add-at x y p)
    (trans (ap (\ w -> L.fraction w p) (Md.maddC x y)) (sym (add-at y x p)))) a b ;
 add-zero (a : L.Carrier) : Id L.Carrier (add a Action.mz) a =
  L.induction @l (\ a -> Id L.Carrier (add a Action.mz) a) (\ a -> L.carrier-set _ _)
   (\ x p -> trans (ap (add (L.fraction x p)) (sym (Action.zero-at p)))
    (trans (add-at x Md.mz p) (ap (\ w -> L.fraction w p) (Md.maddZ x)))) a ;
 add-negative (a : L.Carrier) : Id L.Carrier (add a (Action.negative a)) Action.mz =
  L.induction @l (\ a -> Id L.Carrier (add a (Action.negative a)) Action.mz) (\ a -> L.carrier-set _ _)
   (\ x p -> trans (ap (add (L.fraction x p)) (Action.negative-at x p))
    (trans (add-at x (Md.mneg x) p)
     (trans (ap (\ w -> L.fraction w p) (Md.maddN x)) (Action.zero-at p)))) a ;
 scale-add (a : A.R) (x y : L.Carrier) :
  Id L.Carrier (Action.scale a (add x y)) (add (Action.scale a x) (Action.scale a y)) =
  L.pair-induction (\ x y -> Id L.Carrier (Action.scale a (add x y)) (add (Action.scale a x) (Action.scale a y)))
   (\ x y -> L.carrier-set _ _)
   (\ x y p -> trans (ap (Action.scale a) (add-at x y p))
    (trans (Action.scale-at a (Md.madd x y) p)
     (trans (ap (\ w -> L.fraction w p) (Md.smD a x y))
      (trans (sym (add-at (Md.sm a x) (Md.sm a y) p))
       (cong2 L.Carrier add _ _ _ _ (sym (Action.scale-at a x p)) (sym (Action.scale-at a y p))))))) x y ;
 add-scale (a b : A.R) (x : L.Carrier) :
  Id L.Carrier (Action.scale (A.add a b) x) (add (Action.scale a x) (Action.scale b x)) =
  L.induction @l (\ x -> Id L.Carrier (Action.scale (A.add a b) x) (add (Action.scale a x) (Action.scale b x)))
   (\ x -> L.carrier-set _ _)
   (\ x p -> trans (Action.scale-at (A.add a b) x p)
    (trans (ap (\ w -> L.fraction w p) (Md.smE a b x))
     (trans (sym (add-at (Md.sm a x) (Md.sm b x) p))
      (cong2 L.Carrier add _ _ _ _ (sym (Action.scale-at a x p)) (sym (Action.scale-at b x p)))))) x ;
 localised : SM.Over[A].Module = new SM.Over[A].Module[
  L.Carrier,L.carrier-set,Action.mz,add,Action.negative,
  add-assoc,add-comm,add-zero,add-negative,Action.scale,Action.scale-assoc,Action.scale-one,scale-add,add-scale] ;
 module Canonical = MM.Between[A,A,RingHom[l].identity A,Md,localised] ;
 canonical : Canonical.Hom = new Canonical.Hom[
  \ x -> L.fraction x zero,\ x y -> sym (add-at x y zero),\ a x -> sym (Action.scale-at a x zero)] ;
 canonical-at (x : Md.M) : Id L.Carrier (Canonical.map canonical x) (L.fraction x zero) = refl (L.fraction x zero) ;
 opaque add ;
 opaque canonical ;
 opaque addition ;
} ;
