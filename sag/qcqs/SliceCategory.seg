-- Univalence of slices, following relative-totalisation.tex §6.
-- An object is (x,s:x->b); an arrow f to (y,t) satisfies t f=s.
-- Decorate the base categorical identity system by these arrows.  Over
-- identity x~=x the compatible decorations are (t,t 1=s), a contractible
-- singleton by the right-unit law.  Thus their structured iso total
-- spaces are contractible.  A structured iso gives an actual slice iso:
-- its inverse commutes since s e^-1=t e e^-1=t.  Conversely project the
-- actual inverse equations to obtain the base iso.  This correspondence
-- retains the whole slice arrow, so the actual categorical singleton
-- retracts onto the structured one.  FromTotal proves univalence.
level l ; open Base ; open Prelude[l] ;
module CC = Category[l,l] ;
module CL = FunExtUA[l] ;
module G = SipGeneric[l] ;
module Over (C : CC.Category) (b : C.pre.ob) {
 module A = Arrows[l,l].Arrows[C.pre] ;
 module O = CC.Objects[C] ;
 base-total (x : C.pre.ob) : CL.isContr ((y : C.pre.ob) * C.pre.Iso x y) =
  ((x,C.pre.iso-id x),\ w -> O.singl-prop x (x,C.pre.iso-id x) w) ;
 Compatible (x y : C.pre.ob) (s : C.pre.hom x b) (t : C.pre.hom y b) (e : C.pre.Iso x y) : U l =
  Id (C.pre.hom x b) (A.cmp t (A.arr e)) s ;
 rho (x : C.pre.ob) (s : C.pre.hom x b) : Compatible x x s s (C.pre.iso-id x) = A.unit-r s ;
 unit (x : C.pre.ob) (s : C.pre.hom x b) : CL.isContr ((t : C.pre.hom x b) * Compatible x x s t (C.pre.iso-id x)) =
  G.ctr-retract ((t : C.pre.hom x b) * Id (C.pre.hom x b) t s)
   ((t : C.pre.hom x b) * Compatible x x s t (C.pre.iso-id x)) (CL.sing (C.pre.hom x b) s)
   (\ w -> (w.1,trans _ _ _ _ (sym _ _ _ (A.unit-r w.1)) w.2))
   (\ w -> (w.1,trans _ _ _ _ (A.unit-r w.1) w.2))
   (\ w -> Sigma-eq (C.pre.hom x b) (\ t -> Compatible x x s t (C.pre.iso-id x)) w.1 w.1 _ _ (refl w.1)
    (C.pre.hom-set x b (A.cmp w.1 (C.pre.idn x)) s)) ;
 module B = DecoratedIdentity[l].Over[C.pre.ob,\ x y -> C.pre.Iso x y,\ x -> C.pre.iso-id x,base-total] ;
 module S = B.Data[\ x -> C.pre.hom x b,Compatible,rho,unit] ;
 Hom (x y : S.Obj) : U l = (f : C.pre.hom x.1 y.1) * Id (C.pre.hom x.1 b) (A.cmp y.2 f) x.2 ;
 ext (x y : S.Obj) (f g : Hom x y) (e : Id (C.pre.hom x.1 y.1) f.1 g.1) : Id (Hom x y) f g =
  Sigma-eq (C.pre.hom x.1 y.1) (\ h -> Id (C.pre.hom x.1 b) (A.cmp y.2 h) x.2) f.1 g.1 f.2 g.2 e (C.pre.hom-set x.1 b _ _) ;
 set (x y : S.Obj) : isSet (Hom x y) = isSet-Sigma (C.pre.hom x.1 y.1)
  (\ h -> Id (C.pre.hom x.1 b) (A.cmp y.2 h) x.2) (C.pre.hom-set x.1 y.1)
  (\ h -> prop-to-set _ (C.pre.hom-set x.1 b _ _)) ;
 identity (x : S.Obj) : Hom x x = (C.pre.idn x.1,A.unit-r x.2) ;
 compose (x y z : S.Obj) (g : Hom y z) (f : Hom x y) : Hom x z =
  (A.cmp g.1 f.1,trans _ _ _ _ (A.assoc z.2 g.1 f.1)
   (trans _ _ _ _ (A.right g.2 f.1) f.2)) ;
 precategory : CC.Precategory = new CC.Precategory[S.Obj,Hom,set,identity,compose,
  \ x y f -> ext x y _ _ (A.unit-l f.1),\ x y f -> ext x y _ _ (A.unit-r f.1),
  \ w x y z f g h -> ext w z _ _ (A.assoc h.1 g.1 f.1)] ;
 module SA = Arrows[l,l].Arrows[precategory] ;
 module ToIso (x y : S.Obj) (e : S.Rel x y) {
  forward : Hom x y = (A.arr e.1,e.2) ;
  inverse : Hom y x = (A.inv e.1,trans _ _ _ _ (A.right (sym _ _ _ e.2) (A.inv e.1)) (A.undo-r y.2 e.1)) ;
  categorical : precategory.Iso x y = (forward,inverse,
   ext x x _ _ (A.inv-arr e.1),ext y y _ _ (A.arr-inv e.1)) ;
 } ;
 module FromIso (x y : S.Obj) (e : precategory.Iso x y) {
  underlying : C.pre.Iso x.1 y.1 = (e.1.1,e.2.1.1,
   ap (Hom x x) (C.pre.hom x.1 x.1) (\ f -> f.1) _ _ e.2.2.1,
   ap (Hom y y) (C.pre.hom y.1 y.1) (\ f -> f.1) _ _ e.2.2.2) ;
  structured : S.Rel x y = (underlying,e.1.2) ;
 } ;
 module Single (x : S.Obj) {
  Total : U l = (y : S.Obj) * precategory.Iso x y ;
  contractible : CL.isContr Total = G.ctr-retract (S.Total x) Total (S.total-contr x)
   (\ w -> (w.1,FromIso[x,w.1,w.2].structured)) (\ w -> (w.1,ToIso[x,w.1,w.2].categorical))
   (\ w -> ap (precategory.Iso x w.1) Total (\ e -> (w.1,e)) _ _ (SA.iso-eq _ _ (refl w.2.1))) ;
  proposition : isProp Total = \ u v -> CL.pathC Total contractible u v ;
 } ;
 univalent : CC.Univalent precategory = CC.FromTotal[precategory,\ x -> Single[x].proposition].univalent ;
 category : CC.Category = new CC.Category[precategory,univalent] ;
} ;
