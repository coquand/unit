-- Products of small modules (Serre note, Section 3, finite exactness).
-- A family has its pointwise module structure; function extensionality
-- proves every law. Evaluation is linear. A family of semilinear maps
-- induces its pointwise semilinear map. The same construction includes
-- finite and empty products and records their component equations.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module Pair (A : CRing) (Md Nd : SM.Over[A].Module) {
 Carrier : U l = Md.M * Nd.M ;
 ext (x y : Carrier) (p : Id Md.M x.1 y.1) (q : Id Nd.M x.2 y.2) : Id Carrier x y =
  Pr.trans Carrier x (y.1,x.2) y
   (Pr.ap Md.M Carrier (\ a -> (a,x.2)) x.1 y.1 p)
   (Pr.ap Nd.M Carrier (\ b -> (y.1,b)) x.2 y.2 q) ;
 product : SM.Over[A].Module = new SM.Over[A].Module[
  Carrier,Pr.isSet-Sigma Md.M (\ x -> Nd.M) Md.setM (\ x -> Nd.setM),
  (Md.mz,Nd.mz),\ x y -> (Md.madd x.1 y.1,Nd.madd x.2 y.2),\ x -> (Md.mneg x.1,Nd.mneg x.2),
  \ x y z -> ext _ _ (Md.maddA x.1 y.1 z.1) (Nd.maddA x.2 y.2 z.2),
  \ x y -> ext _ _ (Md.maddC x.1 y.1) (Nd.maddC x.2 y.2),
  \ x -> ext _ _ (Md.maddZ x.1) (Nd.maddZ x.2),
  \ x -> ext _ _ (Md.maddN x.1) (Nd.maddN x.2),
  \ a x -> (Md.sm a x.1,Nd.sm a x.2),
  \ a b x -> ext _ _ (Md.smA a b x.1) (Nd.smA a b x.2),
  \ x -> ext _ _ (Md.smO x.1) (Nd.smO x.2),
  \ a x y -> ext _ _ (Md.smD a x.1 y.1) (Nd.smD a x.2 y.2),
  \ a b x -> ext _ _ (Md.smE a b x.1) (Nd.smE a b x.2)] ;
 first : MM.Between[A,A,RingHom[l].identity A,product,Md].Hom =
  new MM.Between[A,A,RingHom[l].identity A,product,Md].Hom[\ x -> x.1,\ x y -> refl (Md.madd x.1 y.1),\ a x -> refl (Md.sm a x.1)] ;
 second : MM.Between[A,A,RingHom[l].identity A,product,Nd].Hom =
  new MM.Between[A,A,RingHom[l].identity A,product,Nd].Hom[\ x -> x.2,\ x y -> refl (Nd.madd x.2 y.2),\ a x -> refl (Nd.sm a x.2)] ;
 first-at (x : Carrier) : Id Md.M (MM.Between[A,A,RingHom[l].identity A,product,Md].map first x) x.1 = refl x.1 ;
 second-at (x : Carrier) : Id Nd.M (MM.Between[A,A,RingHom[l].identity A,product,Nd].map second x) x.2 = refl x.2 ;
} ;
module Over (A : CRing) (I : U l) (Ms : I -> SM.Over[A].Module) {
 Carrier : U l = (i : I) -> (Ms i).M ;
 ext (x y : Carrier) (h : (i : I) -> Id (Ms i).M (x i) (y i)) : Id Carrier x y =
  F.funext I (\ i -> (Ms i).M) x y h ;
 product : SM.Over[A].Module = new SM.Over[A].Module[
  Carrier,F.isSet-Pi I (\ i -> (Ms i).M) (\ i -> (Ms i).setM),
  \ i -> (Ms i).mz,\ x y i -> (Ms i).madd (x i) (y i),\ x i -> (Ms i).mneg (x i),
  \ x y z -> ext _ _ (\ i -> (Ms i).maddA (x i) (y i) (z i)),
  \ x y -> ext _ _ (\ i -> (Ms i).maddC (x i) (y i)),
  \ x -> ext _ _ (\ i -> (Ms i).maddZ (x i)),
  \ x -> ext _ _ (\ i -> (Ms i).maddN (x i)),
  \ a x i -> (Ms i).sm a (x i),
  \ a b x -> ext _ _ (\ i -> (Ms i).smA a b (x i)),
  \ x -> ext _ _ (\ i -> (Ms i).smO (x i)),
  \ a x y -> ext _ _ (\ i -> (Ms i).smD a (x i) (y i)),
  \ a b x -> ext _ _ (\ i -> (Ms i).smE a b (x i))] ;
 zero-at (i : I) : Id (Ms i).M (product.mz i) (Ms i).mz = refl (Ms i).mz ;
 add-at (x y : Carrier) (i : I) : Id (Ms i).M (product.madd x y i) ((Ms i).madd (x i) (y i)) =
  refl ((Ms i).madd (x i) (y i)) ;
 neg-at (x : Carrier) (i : I) : Id (Ms i).M (product.mneg x i) ((Ms i).mneg (x i)) =
  refl ((Ms i).mneg (x i)) ;
 scalar-at (a : A.R) (x : Carrier) (i : I) : Id (Ms i).M (product.sm a x i) ((Ms i).sm a (x i)) =
  refl ((Ms i).sm a (x i)) ;
 projection (i : I) : MM.Between[A,A,RingHom[l].identity A,product,Ms i].Hom =
  new MM.Between[A,A,RingHom[l].identity A,product,Ms i].Hom[
   \ x -> x i,\ x y -> add-at x y i,\ a x -> scalar-at a x i] ;
 projection-at (i : I) (x : Carrier) :
  Id (Ms i).M (MM.Between[A,A,RingHom[l].identity A,product,Ms i].map (projection i) x) (x i) = refl (x i) ;
 -- Keep the record transparent so its dependent carrier remains available;
 -- clients use the component equations for its operations.
} ;
module Maps (A B : CRing) (h : RingHom[l].Hom A B) (I : U l)
 (Ms : I -> SM.Over[A].Module) (Ns : I -> SM.Over[B].Module)
 (fs : (i : I) -> MM.Between[A,B,h,Ms i,Ns i].Hom) {
 module S = Over[A,I,Ms] ; module T = Over[B,I,Ns] ;
 at (x : S.Carrier) : T.Carrier = \ i -> MM.Between[A,B,h,Ms i,Ns i].map (fs i) (x i) ;
 at-component (x : S.Carrier) (i : I) :
  Id (Ns i).M (at x i) (MM.Between[A,B,h,Ms i,Ns i].map (fs i) (x i)) =
  refl (MM.Between[A,B,h,Ms i,Ns i].map (fs i) (x i)) ;
 additive (x y : S.Carrier) : Id T.Carrier (at (S.product.madd x y)) (T.product.madd (at x) (at y)) =
  T.ext _ _ (\ i ->
   trans (at-component (S.product.madd x y) i)
    (trans (ap (MM.Between[A,B,h,Ms i,Ns i].map (fs i)) (S.add-at x y i))
     (trans (MM.Between[A,B,h,Ms i,Ns i].map-add (fs i) (x i) (y i))
      (sym (T.add-at (at x) (at y) i))))) ;
 scalar (a : A.R) (x : S.Carrier) :
  Id T.Carrier (at (S.product.sm a x)) (T.product.sm (RingMaps[l].map h a) (at x)) =
  T.ext _ _ (\ i ->
   trans (at-component (S.product.sm a x) i)
    (trans (ap (MM.Between[A,B,h,Ms i,Ns i].map (fs i)) (S.scalar-at a x i))
     (trans (MM.Between[A,B,h,Ms i,Ns i].map-scale (fs i) a (x i))
      (sym (T.scalar-at (RingMaps[l].map h a) (at x) i))))) ;
 induced : MM.Between[A,B,h,S.product,T.product].Hom =
  new MM.Between[A,B,h,S.product,T.product].Hom[at,additive,scalar] ;
 induced-at (x : S.Carrier) (i : I) :
  Id (Ns i).M (MM.Between[A,B,h,S.product,T.product].map induced x i)
   (MM.Between[A,B,h,Ms i,Ns i].map (fs i) (x i)) = at-component x i ;
 opaque induced ;
} ;
