-- Natural equivalences of arbitrary set functors on small test rings.
-- A natural transformation with bijective components has a natural inverse.
-- To check its naturality, apply the injective forward component; its two
-- sides become equal by forward naturality and the section equations.
-- The inverse equations are componentwise section/retraction equations,
-- then transformation extensionality.  Composite components are composites
-- of equivalences.  No equality of functor records is required.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Hi = Prelude[l+] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
NaturalEquivalence (F G : SF.SetFunctor) : U l+ =
 (alpha : SF.Transform[F,G].Nat) * ((A : T.Test) -> Pr.isEquiv (F.obj A) (G.obj A) (SF.Transform[F,G].at alpha A)) ;
forward {F G : SF.SetFunctor} (e : NaturalEquivalence F G) : SF.Transform[F,G].Nat = e.1 ;
equiv-at {F G : SF.SetFunctor} (e : NaturalEquivalence F G) (A : T.Test) : Pr.isEquiv (F.obj A) (G.obj A) (SF.Transform[F,G].at (forward e) A) = e.2 A ;
module Inverse (F G : SF.SetFunctor) (e : NaturalEquivalence F G) {
 module FG = SF.Transform[F,G] ;
 module GF = SF.Transform[G,F] ;
 inverse-map (A : T.Test) : G.obj A -> F.obj A = (equiv-at e A).sec ;
 natural (A B : T.Test) (h : RingHom[l].Hom A.ring B.ring) (y : G.obj A) :
  Id (F.obj B) (inverse-map B (G.reindex A B h y)) (F.reindex A B h (inverse-map A y)) =
  Iso[l].injective (F.obj B) (G.obj B) (FG.at (forward e) B) (equiv-at e B)
   (inverse-map B (G.reindex A B h y)) (F.reindex A B h (inverse-map A y))
   (trans ((equiv-at e B).sec-eq (G.reindex A B h y))
    (sym (trans (FG.natural (forward e) A B h (inverse-map A y)) (ap (G.reindex A B h) ((equiv-at e A).sec-eq y))))) ;
 inverse : GF.Nat = (inverse-map,natural) ;
 left-at (A : T.Test) (x : F.obj A) : Id (F.obj A) (GF.at inverse A (FG.at (forward e) A x)) x =
  Pr.sec-ret (F.obj A) (G.obj A) (FG.at (forward e) A) (equiv-at e A) x ;
 right-at (A : T.Test) (y : G.obj A) : Id (G.obj A) (FG.at (forward e) A (GF.at inverse A y)) y =
  (equiv-at e A).sec-eq y ;
 inverse-equiv : NaturalEquivalence G F =
  (inverse,\ A -> Pr.qinv (G.obj A) (F.obj A) (inverse-map A) (FG.at (forward e) A)
   (Pr.sec-ret (F.obj A) (G.obj A) (FG.at (forward e) A) (equiv-at e A)) (equiv-at e A).sec-eq) ;
 left : Id (SF.Transform[F,F].Nat) SF.Composite[F,G,F,inverse,forward e].composite (SF.identity F) =
  SF.Transform[F,F].ext SF.Composite[F,G,F,inverse,forward e].composite (SF.identity F)
   (\ A x -> Pr.sec-ret (F.obj A) (G.obj A) (FG.at (forward e) A) (equiv-at e A) x) ;
 right : Id (SF.Transform[G,G].Nat) SF.Composite[G,F,G,forward e,inverse].composite (SF.identity G) =
  SF.Transform[G,G].ext SF.Composite[G,F,G,forward e,inverse].composite (SF.identity G) (\ A y -> (equiv-at e A).sec-eq y) ;
} ;
identity (F : SF.SetFunctor) : NaturalEquivalence F F =
 (SF.identity F,\ A -> Pr.qinv (F.obj A) (F.obj A) (\ x -> x) (\ x -> x) (\ x -> refl x) (\ x -> refl x)) ;
module Composite (F G H : SF.SetFunctor) (e : NaturalEquivalence F G) (d : NaturalEquivalence G H) {
 equivalence : NaturalEquivalence F H =
  (SF.Composite[F,G,H,forward d,forward e].composite,\ A ->
   Iso[l].equiv-compose (F.obj A) (G.obj A) (H.obj A) (SF.Transform[G,H].at (forward d) A) (SF.Transform[F,G].at (forward e) A)
    (equiv-at d A) (equiv-at e A)) ;
} ;
