-- Every compact open of a qcqs scheme merely has a finite affine cover.
-- First a finite affine cover inside X|e gives one inside X: forget the
-- bound by e on each open; the section rings are unchanged.  The nested
-- slice is isomorphic to the single slice (SliceNested), so each member
-- stays affine (AffineTransport).  Covers stay covers by Slice.join-inc.
-- For a finite affine atlas e_i of X, refine u /\ e_i inside the affine
-- X|e_i (AffineBasis), then forget the slice.  AffineCoverJoin flattens
-- these finitely many finite covers.  Their join is u by LatticeCover.
-- A qcqs atlas merely exists; eliminate it only into mere existence of
-- the resulting affine cover of u.  No atlas is chosen as structure.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module DL = DistLattice[l] ;
module Over (M : DL.DLat) (X : LocallyRinged[l].On[M].LocallyRinged) {
 module O = DL.Order[M] ;
 module J = DL.Joins[M] ;
 module Q = Qcqs[l].Over[M,X] ;
 module B = AffineBasis[l].Over[M,X] ;
 module Unions = AffineCoverJoin[l].Over[M,X] ;
 module Inside (e : M.L) {
  module Sl = Slice[l].Over[M,X,e] ;
  module BS = AffineBasis[l].Over[Sl.lattice,Sl.restricted] ;
  module Lift (u : Sl.Opens) (c : BS.Cover u) {
   opens (i : Fin c.count) : M.L = Sl.inc (c.opens i) ;
   below (i : Fin c.count) : O.Le (opens i) (Sl.inc u) = Sl.le-inc (c.opens i) u (c.below i) ;
   covers : Id M.L (J.bigJ c.count opens) (Sl.inc u) =
    trans (sym (Sl.join-inc c.count c.opens)) (ap Sl.inc c.covers) ;
   module At (i : Fin c.count) {
    module N = SliceNested[l].Over[M,X,e,c.opens i] ;
    affine : Q.AffineOpen (opens i) =
     AffineTransport[l].Over[N.Nested.lattice,N.Single.lattice,N.Nested.restricted,N.Single.restricted,N.morphism,N.iso,c.affine i].affine ;
   } ;
   cover : B.Cover (Sl.inc u) = struct {
    count = c.count ; opens = opens ; below = below ; covers = covers ; affine = \ i -> At[i].affine } ;
  } ;
  refined (affine : AffineCriterion[l].Over[Sl.lattice,Sl.restricted].IsAffine) (u : Sl.Opens) : B.Merely (Sl.inc u) =
   Tr.Trunc[BS.Cover u].induction @l (\ t -> B.Merely (Sl.inc u)) (\ t -> B.merely-prop (Sl.inc u))
    (\ c -> Tr.Trunc[B.Cover (Sl.inc u)].inc Lift[u,c].cover) (BS.FromAffine[affine].refined u) ;
 } ;
 module FromCover (c : Q.AffineCover) {
  atlas-covers : O.Le M.top (J.bigJ c.count c.opens) = O.le-of-eq M.top (J.bigJ c.count c.opens) (sym c.covers) ;
  module LC = LatticeCover[l].Over[M,c.count,c.opens,atlas-covers] ;
  module At (u : M.L) {
   pieces (i : Fin c.count) : M.L = M.meet u (c.opens i) ;
   cover-eq : Id M.L (J.bigJ c.count pieces) u =
    O.le-antisym (J.bigJ c.count pieces) u
     (J.least c.count pieces u (\ i -> O.meet-left u (c.opens i))) (LC.covered u) ;
   refined-pieces (i : Fin c.count) : B.Merely (pieces i) =
    Inside[c.opens i].refined (c.affine i) (Inside[c.opens i].Sl.cut u) ;
   refined : B.Merely u =
    Pr.subst M.L B.Merely (J.bigJ c.count pieces) u cover-eq (Unions.merely c.count pieces refined-pieces) ;
  } ;
 } ;
 refined (qcqs : Q.IsQcqs) (u : M.L) : B.Merely u =
  Tr.Trunc[Q.AffineCover].induction @l (\ t -> B.Merely u) (\ t -> B.merely-prop u) (\ c -> FromCover[c].At[u].refined) qcqs ;
} ;
