-- Changing equal presentations of a space once, including diagrams.
-- An equality X=X' transports a morphism with source X; an equality
-- Y=Y' transports its target.  Both together give change.  Path induction
-- proves that this preserves composition and isomorphisms: when the
-- equalities are reflexivity, each assertion is the original assertion.
-- This interface lets a diagram be checked at its defining presentation
-- and then moved as a diagram, without rechecking the fields of its
-- lattice or sheaf in every application.
level l ; open Ring[l] ;
module Hi = Prelude[l+] ;
module Sp = Spaces[l] ;
source (X X' Y : Sp.Space) (p : Id Sp.Space X X') (f : Sp.Hom X Y) : Sp.Hom X' Y =
 Hi.subst Sp.Space (\ W -> Sp.Hom W Y) X X' p f ;
target (X Y Y' : Sp.Space) (q : Id Sp.Space Y Y') (f : Sp.Hom X Y) : Sp.Hom X Y' =
 Hi.subst Sp.Space (\ W -> Sp.Hom X W) Y Y' q f ;
change (X X' Y Y' : Sp.Space) (p : Id Sp.Space X X') (q : Id Sp.Space Y Y') (f : Sp.Hom X Y) : Sp.Hom X' Y' =
 target X' Y Y' q (source X X' Y p f) ;
module Of (X X' Y Y' : Sp.Space) (p : Id Sp.Space X X') (q : Id Sp.Space Y Y') (f : Sp.Hom X Y) {
 iso (i : Sp.IsIso X Y f) : Sp.IsIso X' Y' (change X X' Y Y' p q f) =
  idJ Sp.Space X (\ W e -> Sp.IsIso W Y' (change X W Y Y' e q f))
   (idJ Sp.Space Y (\ W e -> Sp.IsIso X W (change X X Y W (refl X) e f)) i Y' q) X' p ;
} ;
module Composite (X X' Y Y' Z Z' : Sp.Space)
 (p : Id Sp.Space X X') (q : Id Sp.Space Y Y') (r : Id Sp.Space Z Z')
 (g : Sp.Hom Y Z) (f : Sp.Hom X Y) {
 equation : Id (Sp.Hom X' Z') (change X X' Z Z' p r (Sp.compose X Y Z g f))
  (Sp.compose X' Y' Z' (change Y Y' Z Z' q r g) (change X X' Y Y' p q f)) =
  idJ Sp.Space X (\ W e -> Id (Sp.Hom W Z') (change X W Z Z' e r (Sp.compose X Y Z g f))
   (Sp.compose W Y' Z' (change Y Y' Z Z' q r g) (change X W Y Y' e q f)))
   (idJ Sp.Space Y (\ V e -> Id (Sp.Hom X Z') (change X X Z Z' (refl X) r (Sp.compose X Y Z g f))
    (Sp.compose X V Z' (change Y V Z Z' e r g) (change X X Y V (refl X) e f)))
    (idJ Sp.Space Z (\ W e -> Id (Sp.Hom X W) (change X X Z W (refl X) e (Sp.compose X Y Z g f))
     (Sp.compose X Y W (change Y Y Z W (refl Y) e g) (change X X Y Y (refl X) (refl Y) f)))
     (refl (Sp.compose X Y Z g f)) Z' r) Y' q) X' p ;
} ;
