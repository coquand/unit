-- Structure identity for set-carrier commutative rings.
-- Apply SipGeneric to zero, one, addition, multiplication and negation.
-- The ring laws over a set and sethood itself are propositions.
-- The existing ring records retract onto these structured types by their
-- fields; record induction proves the retraction.  Their isomorphism
-- total spaces are therefore contractible.  Fundamental gives iso
-- induction.  A bijective ring homomorphism gives precisely these data;
-- its zero and negation equations are RingMaps' derived preservation laws.
level l ; open Base ;
module Pr = Prelude[l] ;
module Hi = Prelude[l+] ;
module G = SipGeneric[l] ;
module IT = IdentityTools[l] ;
module RR = Ring[l] ;
module RH = RingHom[l] ;
module RM = RingMaps[l] ;
unary : G.Notion = struct {
 S = \ X -> X -> X ;
 Iota = \ X Y s t e -> (x : X) -> Id Y (e.1 (s x)) (t (e.1 x)) ;
 rho = \ X s x -> refl (s x) ;
 unit = \ X s -> G.hsing X X s } ;
Data : G.Notion = G.join G.point (G.join G.point (G.join G.binop (G.join G.binop unary))) ;
zero (X : U l) (d : Data.S X) : X = d.1 ;
one (X : U l) (d : Data.S X) : X = d.2.1 ;
add (X : U l) (d : Data.S X) : X -> X -> X = d.2.2.1 ;
mul (X : U l) (d : Data.S X) : X -> X -> X = d.2.2.2.1 ;
neg (X : U l) (d : Data.S X) : X -> X = d.2.2.2.2 ;
module Laws (X : U l) (d : Data.S X) {
 AddAssociative : U l = (x y z : X) -> Id X (add X d x (add X d y z)) (add X d (add X d x y) z) ;
 AddCommutative : U l = (x y : X) -> Id X (add X d x y) (add X d y x) ;
 AddZero : U l = (x : X) -> Id X (add X d x (zero X d)) (x) ;
 AddInverse : U l = (x : X) -> Id X (add X d x (neg X d x)) (zero X d) ;
 MulAssociative : U l = (x y z : X) -> Id X (mul X d x (mul X d y z)) (mul X d (mul X d x y) z) ;
 MulCommutative : U l = (x y : X) -> Id X (mul X d x y) (mul X d y x) ;
 MulOne : U l = (x : X) -> Id X (mul X d x (one X d)) (x) ;
 Distributive : U l = (x y z : X) -> Id X (mul X d x (add X d y z)) (add X d (mul X d x y) (mul X d x z)) ;
 Rest : U l = AddAssociative * AddCommutative * AddZero * AddInverse * MulAssociative * MulCommutative * MulOne * Distributive ;
 add-assoc (h : Rest) : AddAssociative = h.1 ;
 add-comm (h : Rest) : AddCommutative = h.2.1 ;
 add-zero (h : Rest) : AddZero = h.2.2.1 ;
 add-inverse (h : Rest) : AddInverse = h.2.2.2.1 ;
 mul-assoc (h : Rest) : MulAssociative = h.2.2.2.2.1 ;
 mul-comm (h : Rest) : MulCommutative = h.2.2.2.2.2.1 ;
 mul-one (h : Rest) : MulOne = h.2.2.2.2.2.2.1 ;
 distributive (h : Rest) : Distributive = h.2.2.2.2.2.2.2 ;
 module Prop (setX : Pr.isSet X) {
  p-add-assoc : Pr.isProp AddAssociative = IT.FE.isProp-Pi X (\ x -> (y z : X) -> Id X (add X d x (add X d y z)) (add X d (add X d x y) z)) (\ x -> IT.FE.isProp-Pi X (\ y -> (z : X) -> Id X (add X d x (add X d y z)) (add X d (add X d x y) z)) (\ y -> IT.FE.isProp-Pi X (\ z -> Id X (add X d x (add X d y z)) (add X d (add X d x y) z)) (\ z -> setX (add X d x (add X d y z)) (add X d (add X d x y) z)))) ;
  p-add-comm : Pr.isProp AddCommutative = IT.FE.isProp-Pi X (\ x -> (y : X) -> Id X (add X d x y) (add X d y x)) (\ x -> IT.FE.isProp-Pi X (\ y -> Id X (add X d x y) (add X d y x)) (\ y -> setX (add X d x y) (add X d y x))) ;
  p-add-zero : Pr.isProp AddZero = IT.FE.isProp-Pi X (\ x -> Id X (add X d x (zero X d)) (x)) (\ x -> setX (add X d x (zero X d)) (x)) ;
  p-add-inverse : Pr.isProp AddInverse = IT.FE.isProp-Pi X (\ x -> Id X (add X d x (neg X d x)) (zero X d)) (\ x -> setX (add X d x (neg X d x)) (zero X d)) ;
  p-mul-assoc : Pr.isProp MulAssociative = IT.FE.isProp-Pi X (\ x -> (y z : X) -> Id X (mul X d x (mul X d y z)) (mul X d (mul X d x y) z)) (\ x -> IT.FE.isProp-Pi X (\ y -> (z : X) -> Id X (mul X d x (mul X d y z)) (mul X d (mul X d x y) z)) (\ y -> IT.FE.isProp-Pi X (\ z -> Id X (mul X d x (mul X d y z)) (mul X d (mul X d x y) z)) (\ z -> setX (mul X d x (mul X d y z)) (mul X d (mul X d x y) z)))) ;
  p-mul-comm : Pr.isProp MulCommutative = IT.FE.isProp-Pi X (\ x -> (y : X) -> Id X (mul X d x y) (mul X d y x)) (\ x -> IT.FE.isProp-Pi X (\ y -> Id X (mul X d x y) (mul X d y x)) (\ y -> setX (mul X d x y) (mul X d y x))) ;
  p-mul-one : Pr.isProp MulOne = IT.FE.isProp-Pi X (\ x -> Id X (mul X d x (one X d)) (x)) (\ x -> setX (mul X d x (one X d)) (x)) ;
  p-distributive : Pr.isProp Distributive = IT.FE.isProp-Pi X (\ x -> (y z : X) -> Id X (mul X d x (add X d y z)) (add X d (mul X d x y) (mul X d x z))) (\ x -> IT.FE.isProp-Pi X (\ y -> (z : X) -> Id X (mul X d x (add X d y z)) (add X d (mul X d x y) (mul X d x z))) (\ y -> IT.FE.isProp-Pi X (\ z -> Id X (mul X d x (add X d y z)) (add X d (mul X d x y) (mul X d x z))) (\ z -> setX (mul X d x (add X d y z)) (add X d (mul X d x y) (mul X d x z))))) ;
  rest : Pr.isProp Rest = IT.both AddAssociative (AddCommutative * AddZero * AddInverse * MulAssociative * MulCommutative * MulOne * Distributive) p-add-assoc (IT.both AddCommutative (AddZero * AddInverse * MulAssociative * MulCommutative * MulOne * Distributive) p-add-comm (IT.both AddZero (AddInverse * MulAssociative * MulCommutative * MulOne * Distributive) p-add-zero (IT.both AddInverse (MulAssociative * MulCommutative * MulOne * Distributive) p-add-inverse (IT.both MulAssociative (MulCommutative * MulOne * Distributive) p-mul-assoc (IT.both MulCommutative (MulOne * Distributive) p-mul-comm (IT.both MulOne (Distributive) p-mul-one (p-distributive))))))) ;
 } ;
} ;
Ax (X : U l) (d : Data.S X) : U l = (s : Pr.isSet X) * Laws[X,d].Rest ;
ax-prop (X : U l) (d : Data.S X) : Pr.isProp (Ax X d) =
 Pr.isProp-Sigma (Pr.isSet X) (\ s -> Laws[X,d].Rest) (IT.set-prop X) (\ s -> Laws[X,d].Prop[s].rest) ;
N : G.Notion = G.axioms Data Ax ax-prop ;
module S = G.Over[N] ;
RD : U l+ = (A : RR.CRing) * Pr.isSet A.R ;
fields (A : RD) : S.Str = (A.1.R,((A.1.z,(A.1.o,(A.1.add,(A.1.mul,A.1.neg)))), (A.2,(A.1.addA,(A.1.addC,(A.1.addZ,(A.1.addN,(A.1.mulA,(A.1.mulC,(A.1.mulO,A.1.dist)))))))))) ;
module From (t : S.Str) {
 module L = Laws[t.1,t.2.1] ;
 ring : RR.CRing = new RR.CRing[t.1,zero t.1 t.2.1,one t.1 t.2.1,add t.1 t.2.1,mul t.1 t.2.1,neg t.1 t.2.1,L.add-assoc t.2.2.2,L.add-comm t.2.2.2,L.add-zero t.2.2.2,L.add-inverse t.2.2.2,L.mul-assoc t.2.2.2,L.mul-comm t.2.2.2,L.mul-one t.2.2.2,L.distributive t.2.2.2] ;
} ;
make (t : S.Str) : RD = (From[t].ring,t.2.2.1) ;
RIso (A B : RD) : U l = S.Iso (fields A) (fields B) ;
id-iso (A : RD) : RIso A A = S.idIso (fields A) ;
Total (A : RD) : U l+ = (B : RD) * RIso A B ;
back-ring (A : RD) : (B : RR.CRing) (sB : Pr.isSet B.R) (e : RIso A (B,sB)) -> Id (Total A) (make (fields (B,sB)),e) ((B,sB),e) = split {
 CRing R z o ad mu neg a b c d e f g h -> \ sB phi -> refl ((new RR.CRing[R,z,o,ad,mu,neg,a,b,c,d,e,f,g,h],sB),phi) } ;
back (A B : RD) (e : RIso A B) : Id (Total A) (make (fields B),e) (B,e) = back-ring A B.1 B.2 e ;
total-contr (A : RD) : FunExtUA[l+].isContr (Total A) =
 SipGeneric[l+].ctr-retract (S.Total (fields A)) (Total A) (S.total-contr (fields A))
  (\ t -> (fields t.1,t.2)) (\ t -> (make t.1,t.2)) (\ t -> back A t.1 t.2) ;
opaque total-contr ;
module Fd = G.Fundamental[RD,RIso,id-iso,total-contr] ;
hom (A B : RD) (e : RIso A B) : RH.Hom A.1 B.1 = (e.1.1,e.2.2.1,e.2.2.2.1,e.2.2.2.2.1) ;
of-hom (A B : RD) (h : RH.Hom A.1 B.1) (eq : Pr.isEquiv A.1.R B.1.R (RM.map h)) : RIso A B =
 ((RM.map h,eq),(RM.map-zero h,(RM.map-one h,(RM.map-add h,(RM.map-mul h,RM.map-neg h))))) ;
hom-of (A B : RD) (h : RH.Hom A.1 B.1) (eq : Pr.isEquiv A.1.R B.1.R (RM.map h)) :
 Id (RH.Hom A.1 B.1) (hom A B (of-hom A B h eq)) h = RH.Properties[A.1,B.1,B.2].ext _ _ (\ x -> refl (RM.map h x)) ;
hom-id (A : RD) : Id (RH.Hom A.1 A.1) (hom A A (id-iso A)) (RH.identity A.1) = RH.Properties[A.1,A.1,A.2].ext _ _ (\ x -> refl x) ;
