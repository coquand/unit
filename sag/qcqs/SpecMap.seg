-- The map X -> Spec A of a ring map phi : A -> O_X(top) (DESIGN.md, step 5,
-- item 2; zeuner1 Thm 3.12).  X is a locally ringed lattice on M, with
-- invertibility map D_m; A is a set; Spec A is O on L_A over the family
-- f_g : A -> R_g of Sections.  Maps of ringed lattices go from L_A to M
-- (LocallyRinged.Maps): a lattice map pi : L_A -> M and ring maps
-- O(u) -> O_X(pi u).
--
-- The lattice map.  d r = D_top(phi r) is a support, since D_top is one and
--  phi is a ring map; let pi : L_A -> M be the lattice map with
--  pi(D r) = d r (ZariskiUniversal).
-- The basic maps.  phi_A : A -> O_X(pi(D g)), r |-> (phi r)|pi(D g), inverts
--  the powers of g: for s = g^n, pi(D g) = d g <= d s = D_top(phi s), so
--  (phi s)|pi(D g) is a unit.  Hence phi_g : R_g -> O_X(pi(D g)) with
--  phi_g(f_g r) = (phi r)|pi(D g) (universal property).  For D h <= D g,
--  phi_g(x)|pi(D h) = phi_h(rho_{g,h} x): both sides are ring maps of x
--  and agree on f_g(r), where both are (phi r)|pi(D h).
-- The sheaf map.  pi#_u : O(u) -> O_X(pi u) is the extension of the phi_g
--  (Extension); it commutes with restriction.
-- Locality: D_(pi u)(pi# s) <= pi(D_u s).
--  Basic opens.  For s in O(D g) let x = eval s, a fraction f_g(p) x = f_g(a)
--  with p a power of g, and w = pi(D g), t = pi# s = phi_g(x)
--  (extend-basic).  y = phi_g(f_g p) is a unit with y t = (phi a)|w, so
--   D_w(t) = D_w(y) /\ D_w(t) = D_w(y t) = w /\ D_top(phi a)
--          = pi(D g) /\ pi(D a) = pi(D(g a)) = pi(D_(D g)(s))
--  (one and mul laws, InvOpen.Restrict, SpecInv.Basic).
--  General opens.  Merely u = D a_1 \/ .. \/ D a_n.  Then pi u is covered by
--  the pi(D a_i), so D_(pi u)(t) is the join of the D_(pi(D a_i))(t|..)
--  (InvOpen.Join), and t|pi(D a_i) = pi#(s|D a_i); each is below
--  pi(D_(D a_i)(s|D a_i)) = pi(D a_i /\ D_u(s)) <= pi(D_u s).
-- The global component.  (pi# (a|top))|top = phi a: by the fitting equation
--  at D 1 = top, (pi# (a|top))|pi(D 1) = phi_1(f_1 a) = (phi a)|pi(D 1).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (Loc : A.R -> CRing) (set : (g : A.R) -> Pr.isSet (Loc g).R)
 (f : (g : A.R) -> RH.Hom A (Loc g))
 (el : (g : A.R) -> Bridge[l].Over[A,g].LocH.Elementary (Loc g) (f g))
 (M : DL.DLat) (X : LocallyRinged[l].On[M].LocallyRinged) (phi : RH.Hom A (X.sheaf.ring M.top)) {
 open A ; open Radical[l].Over[A] ;
 open ZariskiLattice[l].Over[A] ;
 module S = Sections[l].Over[A,Loc,set,f,el] ;
 module B = BasicOpen[l].Over[A,Loc,set,f,el] ;
 module Sh = Sheaf[l].Over[A,Loc,set,f,el] ;
 module SI = SpecInv[l].Over[A,Loc,set,f,el] ;
 module Gb = Global[l].Over[A,setA,Loc,set,f,el] ;
 module Sp = Sup.Of[D,support] ;
 module MO = DL.Order[M] ;
 module MJ = DL.Joins[M] ;
 module GO = RingedLattice[l].On[M].Of[X.sheaf] ;
 module IG = InvOpen[l].On[M].Of[X.sheaf] ;
 module IGL = IG.Local[X.is-sheaf] ;
 module LX = LocallyRinged[l].On[M].Laws[X.sheaf,X.inv] ;
 module LA = LocallyRinged[l].On[lattice].Laws[Sh.structure,SI.inv-map] ;
 module IO = SI.IO ;
 module P = AffinePowers[l].Over[A] ;

 -- the support r |-> D_top(phi r)
 d (r : R) : M.L = LX.d M.top (map phi r) ;
 d-add (x y : R) : MO.Le (d (add x y)) (M.join (d x) (d y)) =
  Pr.subst (X.sheaf.ring M.top).R (\ e -> MO.Le (LX.d M.top e) (M.join (d x) (d y)))
   ((X.sheaf.ring M.top).add (map phi x) (map phi y)) (map phi (add x y)) (sym (map-add phi x y))
   (X.is-support.2.2.2 M.top (map phi x) (map phi y)) ;
 d-support : DL.Supports[A,M].Support d =
  (trans (ap (LX.d M.top) (map-one phi)) (LX.one-law M.top),
   trans (ap (LX.d M.top) (map-zero phi)) (X.is-support.2.1 M.top),
   \ x y -> trans (ap (LX.d M.top) (map-mul phi x y)) (LX.mul-law M.top (map phi x) (map phi y)),
   d-add) ;
 module Sd = DL.Supports[A,M].Of[d,d-support] ;

 -- the lattice map
 pi : DL.Hom lattice M = ZariskiUniversal[l].Over[A,M,d,d-support].factor ;
 pi-D (r : R) : Id M.L (DL.hmap pi (D r)) (d r) = ZariskiUniversal[l].Over[A,M,d,d-support].factor-D r ;
 module PM = DL.JoinMaps[lattice,M,pi] ;

 -- the basic maps phi_g : R_g -> O_X(pi(D g))
 module Basic (g : R) {
  module Bg = Bridge[l].Over[A,g] ;
  le-top : MO.Le (DL.hmap pi (D g)) M.top = MO.le-top (DL.hmap pi (D g)) ;
  on-A : RH.Hom A (X.sheaf.ring (DL.hmap pi (D g))) =
   RH.compose A (X.sheaf.ring M.top) (X.sheaf.ring (DL.hmap pi (D g))) (X.sheaf.res (DL.hmap pi (D g)) M.top le-top) phi ;
  -- pi(D g) <= d s for a power s of g
  below (s : R) (q : Bg.Powers s) : MO.Le (DL.hmap pi (D g)) (d s) =
   MO.le-trans (DL.hmap pi (D g)) (d g) (d s) (MO.le-of-eq (DL.hmap pi (D g)) (d g) (pi-D g))
    (Pr.subst R (\ e -> MO.Le (d g) (d e)) (P.power g (Bg.index q)) s (Bg.index-eq q) (Sd.power-above g (Bg.index q))) ;
  inverts : Bg.LocH.Inverts (X.sheaf.ring (DL.hmap pi (D g))) on-A = \ s q ->
   IG.to-unit (LX.d-open M.top (map phi s)) (DL.hmap pi (D g)) le-top (below s q) ;
  extension : Bg.LocH.Extension (Loc g) (X.sheaf.ring (DL.hmap pi (D g))) (f g) on-A =
   (Bg.LocH.universal (Loc g) (f g) (el g) (X.sheaf.ring (DL.hmap pi (D g))) (X.sheaf.ring-set (DL.hmap pi (D g))) on-A inverts).1 ;
  phi-g : RH.Hom (Loc g) (X.sheaf.ring (DL.hmap pi (D g))) = extension.1 ;
  phi-g-on (a : R) : Id (X.sheaf.ring (DL.hmap pi (D g))).R (map phi-g (map (f g) a)) (map on-A a) =
   ap (\ k -> map k a) extension.2 ;
 } ;

 -- phi_g(x)|pi(D h) = phi_h(rho_{g,h} x)
 module Compat (g h : R) (hg : O.Le (D h) (D g)) {
  module LH = Bridge[l].Over[A,g].LocH ;
  left : RH.Hom (Loc g) (X.sheaf.ring (DL.hmap pi (D h))) =
   RH.compose (Loc g) (X.sheaf.ring (DL.hmap pi (D g))) (X.sheaf.ring (DL.hmap pi (D h)))
    (X.sheaf.res (DL.hmap pi (D h)) (DL.hmap pi (D g)) (PM.monotone (D h) (D g) hg)) Basic[g].phi-g ;
  right : RH.Hom (Loc g) (X.sheaf.ring (DL.hmap pi (D h))) =
   RH.compose (Loc g) (Loc h) (X.sheaf.ring (DL.hmap pi (D h))) Basic[h].phi-g (S.rho g h hg) ;
  on-A (a : R) : Id (X.sheaf.ring (DL.hmap pi (D h))).R (map left (map (f g) a)) (map right (map (f g) a)) =
   calc (X.sheaf.ring (DL.hmap pi (D h))).R {
    map left (map (f g) a)
     =< map-compose (X.sheaf.res (DL.hmap pi (D h)) (DL.hmap pi (D g)) (PM.monotone (D h) (D g) hg)) Basic[g].phi-g (map (f g) a)
      > GO.restrict (DL.hmap pi (D h)) (DL.hmap pi (D g)) (PM.monotone (D h) (D g) hg) (map Basic[g].phi-g (map (f g) a))
     =< ap (GO.restrict (DL.hmap pi (D h)) (DL.hmap pi (D g)) (PM.monotone (D h) (D g) hg)) (Basic[g].phi-g-on a)
      > GO.restrict (DL.hmap pi (D h)) (DL.hmap pi (D g)) (PM.monotone (D h) (D g) hg) (GO.restrict (DL.hmap pi (D g)) M.top Basic[g].le-top (map phi a))
     =< X.sheaf.res-comp (DL.hmap pi (D h)) (DL.hmap pi (D g)) M.top (PM.monotone (D h) (D g) hg) Basic[g].le-top Basic[h].le-top (map phi a)
      > GO.restrict (DL.hmap pi (D h)) M.top Basic[h].le-top (map phi a)
     =< sym (Basic[h].phi-g-on a) > map Basic[h].phi-g (map (f h) a)
     =< sym (ap (map Basic[h].phi-g) (S.rho-on g h hg a)) > map Basic[h].phi-g (map (S.rho g h hg) (map (f g) a))
     =< sym (map-compose Basic[h].phi-g (S.rho g h hg) (map (f g) a)) > map right (map (f g) a) } ;
  equal : Id (RH.Hom (Loc g) (X.sheaf.ring (DL.hmap pi (D h)))) left right =
   LH.Agree[Loc g,f g,LH.is-loc (Loc g) (f g) (el g),X.sheaf.ring (DL.hmap pi (D h)),X.sheaf.ring-set (DL.hmap pi (D h)),
    left,right,on-A].equal ;
 } ;
 phi-compat (g h : R) (hg : O.Le (D h) (D g)) (x : (Loc g).R) :
  Id (X.sheaf.ring (DL.hmap pi (D h))).R
   (GO.restrict (DL.hmap pi (D h)) (DL.hmap pi (D g)) (PM.monotone (D h) (D g) hg) (map Basic[g].phi-g x))
   (map Basic[h].phi-g (map (S.rho g h hg) x)) =
  trans (sym (map-compose (X.sheaf.res (DL.hmap pi (D h)) (DL.hmap pi (D g)) (PM.monotone (D h) (D g) hg)) Basic[g].phi-g x))
   (trans (ap (\ k -> map k x) Compat[g,h,hg].equal) (map-compose Basic[h].phi-g (S.rho g h hg) x)) ;

 -- the sheaf map, and the map of ringed lattices
 module E = Extension[l].Over[A,Loc,set,f,el,M,X.sheaf,X.is-sheaf,pi].Extend[\ g -> Basic[g].phi-g,phi-compat] ;
 module Mp = LocallyRinged[l].Maps[lattice,M,Sh.structure,X.sheaf] ;
 natural (u v : lattice.L) (k : O.Le u v) (s : S.Section v) :
  Id (X.sheaf.ring (DL.hmap pi u)).R
   (GO.restrict (DL.hmap pi u) (DL.hmap pi v) (PM.monotone u v k) (map (E.extension-map v) s))
   (map (E.extension-map u) (map (S.restriction u v k) s)) = calc (X.sheaf.ring (DL.hmap pi u)).R {
  GO.restrict (DL.hmap pi u) (DL.hmap pi v) (PM.monotone u v k) (map (E.extension-map v) s)
   =< ap (GO.restrict (DL.hmap pi u) (DL.hmap pi v) (PM.monotone u v k)) (E.extension-map-at v s)
    > GO.restrict (DL.hmap pi u) (DL.hmap pi v) (PM.monotone u v k) (E.extend v s)
   =< E.extend-restrict u v k s > E.extend u (S.restrict u v k s)
   =< sym (ap (E.extend u) (S.restriction-map u v k s)) > E.extend u (map (S.restriction u v k) s)
   =< sym (E.extension-map-at u (map (S.restriction u v k) s)) > map (E.extension-map u) (map (S.restriction u v k) s) } ;
 morphism : Mp.Ringed = new Mp.Ringed[pi,E.extension-map,natural] ;

 -- locality on a basic open
 module LocalBasic (g : R) (s : S.Section (D g)) {
  module LH = Bridge[l].Over[A,g].LocH ;
  x : (Loc g).R = B.At[g].eval s ;
  t : (X.sheaf.ring (DL.hmap pi (D g))).R = map Basic[g].phi-g x ;
  module At (q : LH.Fraction (Loc g) (f g) x) {
   y : (X.sheaf.ring (DL.hmap pi (D g))).R = map Basic[g].phi-g (map (f g) (LH.den q)) ;
   y-unit : IG.Unit (DL.hmap pi (D g)) y =
    Pr.subst (X.sheaf.ring (DL.hmap pi (D g))).R (IG.Unit (DL.hmap pi (D g))) (map Basic[g].on-A (LH.den q)) y
     (sym (Basic[g].phi-g-on (LH.den q))) (Basic[g].inverts (LH.den q) (LH.den-in q)) ;
   -- y t = (phi a)|pi(D g)
   product : Id (X.sheaf.ring (DL.hmap pi (D g))).R ((X.sheaf.ring (DL.hmap pi (D g))).mul y t)
    (GO.restrict (DL.hmap pi (D g)) M.top Basic[g].le-top (map phi (LH.num q))) = calc (X.sheaf.ring (DL.hmap pi (D g))).R {
    (X.sheaf.ring (DL.hmap pi (D g))).mul y t
     =< sym (map-mul Basic[g].phi-g (map (f g) (LH.den q)) x) > map Basic[g].phi-g ((Loc g).mul (map (f g) (LH.den q)) x)
     =< ap (map Basic[g].phi-g) (LH.eqn q) > map Basic[g].phi-g (map (f g) (LH.num q))
     =< Basic[g].phi-g-on (LH.num q) > map Basic[g].on-A (LH.num q)
     =< map-compose (X.sheaf.res (DL.hmap pi (D g)) M.top Basic[g].le-top) phi (LH.num q)
      > GO.restrict (DL.hmap pi (D g)) M.top Basic[g].le-top (map phi (LH.num q)) } ;
   d-y : Id M.L (LX.d (DL.hmap pi (D g)) y) (DL.hmap pi (D g)) =
    IG.unique (LX.d-open (DL.hmap pi (D g)) y) (IG.whole (DL.hmap pi (D g)) y y-unit) ;
   t-y : MO.Le (LX.d (DL.hmap pi (D g)) t) (LX.d (DL.hmap pi (D g)) y) =
    MO.le-trans (LX.d (DL.hmap pi (D g)) t) (DL.hmap pi (D g)) (LX.d (DL.hmap pi (D g)) y)
     (IG.below (LX.d-open (DL.hmap pi (D g)) t)) (MO.le-of-eq (DL.hmap pi (D g)) (LX.d (DL.hmap pi (D g)) y) (sym d-y)) ;
   -- D_w(y t) = w /\ D_top(phi a)
   restricted : Id M.L (LX.d (DL.hmap pi (D g)) (GO.restrict (DL.hmap pi (D g)) M.top Basic[g].le-top (map phi (LH.num q))))
    (M.meet (DL.hmap pi (D g)) (d (LH.num q))) =
    IG.Restrict[M.top,DL.hmap pi (D g),Basic[g].le-top,map phi (LH.num q),d (LH.num q),LX.d-open M.top (map phi (LH.num q))].restrict-eq
     (LX.d (DL.hmap pi (D g)) (GO.restrict (DL.hmap pi (D g)) M.top Basic[g].le-top (map phi (LH.num q))))
     (LX.d-open (DL.hmap pi (D g)) (GO.restrict (DL.hmap pi (D g)) M.top Basic[g].le-top (map phi (LH.num q)))) ;
   -- w /\ D_top(phi a) = pi(D_(D g)(s))
   image : Id M.L (M.meet (DL.hmap pi (D g)) (d (LH.num q))) (DL.hmap pi (LA.d (D g) s)) = calc M.L {
    M.meet (DL.hmap pi (D g)) (d (LH.num q))
     =< ap (M.meet (DL.hmap pi (D g))) (sym (pi-D (LH.num q))) > M.meet (DL.hmap pi (D g)) (DL.hmap pi (D (LH.num q)))
     =< sym (DL.hmap-meet pi (D g) (D (LH.num q))) > DL.hmap pi (lattice.meet (D g) (D (LH.num q)))
     =< ap (DL.hmap pi) (sym (Sp.at-mul g (LH.num q))) > DL.hmap pi (D (mul g (LH.num q)))
     =< ap (DL.hmap pi) (IO.unique SI.Basic[g,s].At[q].is-open (LA.d-open (D g) s)) > DL.hmap pi (LA.d (D g) s) } ;
   le : MO.Le (LX.d (DL.hmap pi (D g)) t) (DL.hmap pi (LA.d (D g) s)) =
    MO.le-trans (LX.d (DL.hmap pi (D g)) t) (M.meet (LX.d (DL.hmap pi (D g)) y) (LX.d (DL.hmap pi (D g)) t))
     (DL.hmap pi (LA.d (D g) s))
     (MO.meet-glb (LX.d (DL.hmap pi (D g)) y) (LX.d (DL.hmap pi (D g)) t) (LX.d (DL.hmap pi (D g)) t) t-y
       (MO.le-refl (LX.d (DL.hmap pi (D g)) t)))
     (MO.le-of-eq _ _ (trans (sym (LX.mul-law (DL.hmap pi (D g)) y t))
       (trans (ap (LX.d (DL.hmap pi (D g))) product) (trans restricted image)))) ;
  } ;
  le : MO.Le (LX.d (DL.hmap pi (D g)) (E.extend (D g) s)) (DL.hmap pi (LA.d (D g) s)) =
   Pr.subst (X.sheaf.ring (DL.hmap pi (D g))).R (\ e -> MO.Le (LX.d (DL.hmap pi (D g)) e) (DL.hmap pi (LA.d (D g) s)))
    t (E.extend (D g) s) (sym (E.extend-basic g s))
    (Tr.Trunc[LH.Fraction (Loc g) (f g) x].induction @l (\ c -> MO.Le (LX.d (DL.hmap pi (D g)) t) (DL.hmap pi (LA.d (D g) s)))
      (\ c -> MO.le-prop (LX.d (DL.hmap pi (D g)) t) (DL.hmap pi (LA.d (D g) s)))
      (\ q -> At[q].le) (LH.fractions (el g) x)) ;
 } ;

 -- locality on an arbitrary open, through a presentation
 module Locality (u : lattice.L) (s : S.Section u) {
  module At (q : Presentation u) {
   piece (i : Fin (size (generators q))) : S.Section (D (gen (generators q) i)) =
    S.restrict (D (gen (generators q) i)) u (gen-below q i) s ;
   le-i (i : Fin (size (generators q))) : MO.Le (DL.hmap pi (D (gen (generators q) i))) (DL.hmap pi u) =
    PM.monotone (D (gen (generators q) i)) u (gen-below q i) ;
   covers : MO.Le (DL.hmap pi u) (MJ.bigJ (size (generators q)) (\ i -> DL.hmap pi (D (gen (generators q) i)))) =
    MO.le-of-eq (DL.hmap pi u) (MJ.bigJ (size (generators q)) (\ i -> DL.hmap pi (D (gen (generators q) i))))
     (trans (ap (DL.hmap pi) (presents q)) (PM.preserves (size (generators q)) (\ i -> D (gen (generators q) i)))) ;
   opens (i : Fin (size (generators q))) : M.L =
    LX.d (DL.hmap pi (D (gen (generators q) i))) (GO.restrict (DL.hmap pi (D (gen (generators q) i))) (DL.hmap pi u) (le-i i) (E.extend u s)) ;
   is-open : IG.IsInvOpen (DL.hmap pi u) (E.extend u s) (MJ.bigJ (size (generators q)) opens) =
    IGL.Join[DL.hmap pi u,E.extend u s,size (generators q),\ i -> DL.hmap pi (D (gen (generators q) i)),le-i,covers,opens,
     \ i -> LX.d-open (DL.hmap pi (D (gen (generators q) i))) (GO.restrict (DL.hmap pi (D (gen (generators q) i))) (DL.hmap pi u) (le-i i) (E.extend u s))].inv-open ;
   -- D_(D a_i)(s|D a_i) <= D_u(s)
   piece-le (i : Fin (size (generators q))) : O.Le (LA.d (D (gen (generators q) i)) (piece i)) (LA.d u s) =
    Pr.subst lattice.L (\ e -> O.Le e (LA.d u s)) (lattice.meet (D (gen (generators q) i)) (LA.d u s))
     (LA.d (D (gen (generators q) i)) (piece i))
     (sym (IO.Restrict[u,D (gen (generators q) i),gen-below q i,s,LA.d u s,LA.d-open u s].restrict-eq
       (LA.d (D (gen (generators q) i)) (piece i)) (LA.d-open (D (gen (generators q) i)) (piece i))))
     (O.meet-right (D (gen (generators q) i)) (LA.d u s)) ;
   open-le (i : Fin (size (generators q))) : MO.Le (opens i) (DL.hmap pi (LA.d u s)) =
    MO.le-trans (opens i) (DL.hmap pi (LA.d (D (gen (generators q) i)) (piece i))) (DL.hmap pi (LA.d u s))
     (Pr.subst (X.sheaf.ring (DL.hmap pi (D (gen (generators q) i)))).R
       (\ e -> MO.Le (LX.d (DL.hmap pi (D (gen (generators q) i))) e) (DL.hmap pi (LA.d (D (gen (generators q) i)) (piece i))))
       (E.extend (D (gen (generators q) i)) (piece i))
       (GO.restrict (DL.hmap pi (D (gen (generators q) i))) (DL.hmap pi u) (le-i i) (E.extend u s))
       (sym (E.extend-restrict (D (gen (generators q) i)) u (gen-below q i) s))
       LocalBasic[gen (generators q) i,piece i].le)
     (PM.monotone (LA.d (D (gen (generators q) i)) (piece i)) (LA.d u s) (piece-le i)) ;
   le : MO.Le (LX.d (DL.hmap pi u) (E.extend u s)) (DL.hmap pi (LA.d u s)) =
    MO.le-trans (LX.d (DL.hmap pi u) (E.extend u s)) (MJ.bigJ (size (generators q)) opens) (DL.hmap pi (LA.d u s))
     (MO.le-of-eq _ _ (IG.unique (LX.d-open (DL.hmap pi u) (E.extend u s)) is-open))
     (MJ.least (size (generators q)) opens (DL.hmap pi (LA.d u s)) open-le) ;
  } ;
  le : MO.Le (LX.d (DL.hmap pi u) (E.extend u s)) (DL.hmap pi (LA.d u s)) =
   Tr.Trunc[Presentation u].induction @l (\ c -> MO.Le (LX.d (DL.hmap pi u) (E.extend u s)) (DL.hmap pi (LA.d u s)))
    (\ c -> MO.le-prop (LX.d (DL.hmap pi u) (E.extend u s)) (DL.hmap pi (LA.d u s))) (\ q -> At[q].le) (presented u) ;
 } ;
 is-local : Mp.Of[morphism,SI.inv-map,X.inv].IsLocal = \ u s ->
  Pr.subst (X.sheaf.ring (DL.hmap pi u)).R (\ e -> MO.Le (LX.d (DL.hmap pi u) e) (DL.hmap pi (LA.d u s)))
   (E.extend u s) (map (E.extension-map u) s) (sym (E.extension-map-at u s)) Locality[u,s].le ;

 -- the global component is phi
 top-le : MO.Le M.top (DL.hmap pi lattice.top) = MO.le-of-eq M.top (DL.hmap pi lattice.top) (sym (DL.hmap-top pi)) ;
 top-le-one : MO.Le M.top (DL.hmap pi (D o)) =
  Pr.subst lattice.L (\ e -> MO.Le M.top (DL.hmap pi e)) lattice.top (D o) Gb.top-D top-le ;
 global (a : R) :
  Id (X.sheaf.ring M.top).R (GO.restrict M.top (DL.hmap pi lattice.top) top-le (E.extend lattice.top (map Gb.global a))) (map phi a) =
  calc (X.sheaf.ring M.top).R {
   GO.restrict M.top (DL.hmap pi lattice.top) top-le (E.extend lattice.top (map Gb.global a))
    =< sym (X.sheaf.res-comp M.top (DL.hmap pi (D o)) (DL.hmap pi lattice.top) top-le-one
         (PM.monotone (D o) lattice.top Gb.one-top) top-le (E.extend lattice.top (map Gb.global a)))
     > GO.restrict M.top (DL.hmap pi (D o)) top-le-one
        (GO.restrict (DL.hmap pi (D o)) (DL.hmap pi lattice.top) (PM.monotone (D o) lattice.top Gb.one-top)
          (E.extend lattice.top (map Gb.global a)))
    =< ap (GO.restrict M.top (DL.hmap pi (D o)) top-le-one) (E.extend-fits lattice.top (map Gb.global a) o Gb.one-top)
     > GO.restrict M.top (DL.hmap pi (D o)) top-le-one (E.val lattice.top (map Gb.global a) o Gb.one-top)
    =< ap (\ e -> GO.restrict M.top (DL.hmap pi (D o)) top-le-one (map Basic[o].phi-g e))
         (Gb.Of[lattice.top].section-at a o Gb.one-top)
     > GO.restrict M.top (DL.hmap pi (D o)) top-le-one (map Basic[o].phi-g (map (f o) a))
    =< ap (GO.restrict M.top (DL.hmap pi (D o)) top-le-one)
         (trans (Basic[o].phi-g-on a) (map-compose (X.sheaf.res (DL.hmap pi (D o)) M.top Basic[o].le-top) phi a))
     > GO.restrict M.top (DL.hmap pi (D o)) top-le-one (GO.restrict (DL.hmap pi (D o)) M.top Basic[o].le-top (map phi a))
    =< X.sheaf.res-comp M.top (DL.hmap pi (D o)) M.top top-le-one Basic[o].le-top (MO.le-refl M.top) (map phi a)
     > GO.restrict M.top M.top (MO.le-refl M.top) (map phi a)
    =< X.sheaf.res-id M.top (MO.le-refl M.top) (map phi a) > map phi a } ;
} ;
