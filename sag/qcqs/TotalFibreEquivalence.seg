-- Totalising the fibre functor of q:G->h_k recovers G (note §5).
-- Forget (iota,(z,q(z)=iota)).  Its inverse is (q(z),(z,refl)).
-- Naturality preserves the underlying z.  The right inverse is refl;
-- for the left, path induction on the DISPLAYED equation q(z)=iota
-- identifies the whole pair, including its fibre proof.  The same proof
-- records that the equivalence preserves projection to h_k.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module T = AffineTests[l] ;
module RH = RingHom[l] ;
module SF = TestFunctors[l] ;
module TE = TestEquivalences[l] ;
module Over (K : T.Test) (G : SF.SetFunctor) (q : SF.Transform[G,SF.Representable[K].functor].Nat) {
 module S = RelativeFibres[l].Over[K,G,q] ;
 module TF = RelativeTotal[l].Over[K,S.functor] ;
 module At (B : T.Test) {
  forward (p : TF.functor.obj B) : G.obj B = S.point {S.BP.algebra B (TF.At[B].base p)} (TF.At[B].value p) ;
  inverse (z : G.obj B) : TF.functor.obj B = (S.N.at q B z,(z,refl (S.N.at q B z))) ;
  right (z : G.obj B) : Id (G.obj B) (forward (inverse z)) z = refl z ;
  restore (z : G.obj B) : (i : RH.Hom K.ring B.ring) (e : Id (RH.Hom K.ring B.ring) (S.N.at q B z) i) ->
   Id (TF.functor.obj B) (inverse z) (i,(z,e)) = \ i e -> idJ (RH.Hom K.ring B.ring) (S.N.at q B z)
    (\ i1 e1 -> Id (TF.functor.obj B) (inverse z) (i1,(z,e1))) (refl (inverse z)) i e ;
  left (p : TF.functor.obj B) : Id (TF.functor.obj B) (inverse (forward p)) p = restore (forward p) (TF.At[B].base p) (S.member {S.BP.algebra B (TF.At[B].base p)} (TF.At[B].value p)) ;
  over-base (p : TF.functor.obj B) : Id (RH.Hom K.ring B.ring) (S.N.at q B (forward p)) (TF.At[B].base p) = S.member {S.BP.algebra B (TF.At[B].base p)} (TF.At[B].value p) ;
 } ;
 transformation : SF.Transform[TF.functor,G].Nat = (\ B -> At[B].forward,\ B C h p -> refl (G.reindex B C h (At[B].forward p))) ;
 equivalence : TE.NaturalEquivalence TF.functor G = (transformation,\ B -> Pr.qinv (TF.functor.obj B) (G.obj B) At[B].forward At[B].inverse At[B].right At[B].left) ;
 opaque equivalence ;
} ;
