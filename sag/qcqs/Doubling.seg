-- Doubling a locally ringed lattice along an open (DESIGN.md, step 4,
-- Next 1; DOUBLE-ORIGIN.md).
--
-- Let (L, O) be a locally ringed lattice, D_u its invertibility map, and
-- d in L.  On the doubled lattice L2 (DoubleLattice), with mid(u, v) =
-- u /\ d = v /\ d,
--  O2(u, v) = O(u) x_O(mid) O(v),
-- the pairs (s, t) with s|mid = t|mid (FibreProduct).
-- Restriction.  For (u2, v2) <= (u, v), (s, t) |-> (s|u2, t|v2) (Lift):
--  both restrict on mid(u2, v2) to the restriction of s|mid = t|mid, since
--  mid(u2, v2) <= mid(u, v).  Identity and composition hold componentwise.
-- Sheaf.  Let (u_i, v_i) cover (u, v) and (s_i, t_i) be compatible.  The
--  first components cover u and are compatible (first projection of the
--  compatibility; restriction does not depend on the witness), so they
--  have an amalgam s; likewise t on v.  s|mid = t|mid by separation on
--  the cover mid_i of mid ((u_1 \/ .. \/ u_n) /\ d <= \/ (u_i /\ d)):
--  both restrict on mid_i to s_i|mid_i = t_i|mid_i.  An amalgam (s2, t2)
--  has components that are amalgams of the s_i and of the t_i, so it
--  equals (s, t) by separation in O; matching is a proposition.
-- Invertibility.  D2_(u,v)(s, t) = (D_u s, D_v t).  It lies in L2:
--  (D_u s) /\ d = mid /\ D_u s (DoubleLattice.restrict-d, D_u s <= u), the
--  invertibility open of s|mid (InvOpen.Restrict); likewise for t, and
--  s|mid = t|mid, so the two are equal by uniqueness.  It is the
--  invertibility open: (a, b) is a unit iff a and b are
--  (FibreProduct), and (w, w2) <= (D_u s, D_v t) iff w <= D_u s and
--  w2 <= D_v t.
-- Support.  D2(0) = (D 0, D 0) = bot and D2(s + t) <= D2 s \/ D2 t hold
--  componentwise; the laws for 1 and products hold for every invertibility
--  map (LocallyRinged).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module DL = DistLattice[l] ;
module Over (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged) (d : L.L) {
 module O = DL.Order[L] ;
 module J = DL.Joins[L] ;
 module DD = DoubleLattice[l].Over[L,d] ;
 module OD = DD.OD ;
 module GO = RingedLattice[l].On[L].Of[X.sheaf] ;
 module R2 = RingedLattice[l].On[DD.lattice] ;
 module LR2 = LocallyRinged[l].On[DD.lattice] ;

 -- the sections over x: pairs agreeing on mid x
 module At (x : DD.Opens) {
  module P = FibreProduct[l].Over[X.sheaf.ring (DD.first x),X.sheaf.ring (DD.second x),X.sheaf.ring (DD.mid x),
   X.sheaf.ring-set (DD.first x),X.sheaf.ring-set (DD.second x),X.sheaf.ring-set (DD.mid x),
   X.sheaf.res (DD.mid x) (DD.first x) (DD.mid-first x),X.sheaf.res (DD.mid x) (DD.second x) (DD.mid-second x)] ;
 } ;
 ring (x : DD.Opens) : CRing = At[x].P.ring ;
 ring-set (x : DD.Opens) : Pr.isSet (ring x).R = At[x].P.pair-set ;
 left (x : DD.Opens) (z : (ring x).R) : (X.sheaf.ring (DD.first x)).R = At[x].P.left z ;
 right (x : DD.Opens) (z : (ring x).R) : (X.sheaf.ring (DD.second x)).R = At[x].P.right z ;
 agree (x : DD.Opens) (z : (ring x).R) :
  Id (X.sheaf.ring (DD.mid x)).R (GO.restrict (DD.mid x) (DD.first x) (DD.mid-first x) (left x z))
   (GO.restrict (DD.mid x) (DD.second x) (DD.mid-second x) (right x z)) = At[x].P.agree z ;
 ext (x : DD.Opens) (z z2 : (ring x).R) (e1 : Id (X.sheaf.ring (DD.first x)).R (left x z) (left x z2))
  (e2 : Id (X.sheaf.ring (DD.second x)).R (right x z) (right x z2)) : Id (ring x).R z z2 = At[x].P.ext z z2 e1 e2 ;

 -- restriction
 module Res (y x : DD.Opens) (k : OD.Le y x) {
  k1 : O.Le (DD.first y) (DD.first x) = DD.le-first y x k ;
  k2 : O.Le (DD.second y) (DD.second x) = DD.le-second y x k ;
  -- mid y <= first x and mid y <= second x, through mid x
  a1 : O.Le (DD.mid y) (DD.first x) = O.le-trans (DD.mid y) (DD.mid x) (DD.first x) (DD.mid-le y x k) (DD.mid-first x) ;
  a2 : O.Le (DD.mid y) (DD.second x) = O.le-trans (DD.mid y) (DD.mid x) (DD.second x) (DD.mid-le y x k) (DD.mid-second x) ;
  first-part : RH.Hom (ring x) (X.sheaf.ring (DD.first y)) =
   RH.compose (ring x) (X.sheaf.ring (DD.first x)) (X.sheaf.ring (DD.first y)) (X.sheaf.res (DD.first y) (DD.first x) k1) At[x].P.proj-left ;
  second-part : RH.Hom (ring x) (X.sheaf.ring (DD.second y)) =
   RH.compose (ring x) (X.sheaf.ring (DD.second x)) (X.sheaf.ring (DD.second y)) (X.sheaf.res (DD.second y) (DD.second x) k2) At[x].P.proj-right ;
  agrees (z : (ring x).R) : At[y].P.Agree (map first-part z) (map second-part z) = calc (X.sheaf.ring (DD.mid y)).R {
   GO.restrict (DD.mid y) (DD.first y) (DD.mid-first y) (GO.restrict (DD.first y) (DD.first x) k1 (left x z))
    =< X.sheaf.res-comp (DD.mid y) (DD.first y) (DD.first x) (DD.mid-first y) k1 a1 (left x z)
    > GO.restrict (DD.mid y) (DD.first x) a1 (left x z)
    =< sym (X.sheaf.res-comp (DD.mid y) (DD.mid x) (DD.first x) (DD.mid-le y x k) (DD.mid-first x) a1 (left x z))
    > GO.restrict (DD.mid y) (DD.mid x) (DD.mid-le y x k) (GO.restrict (DD.mid x) (DD.first x) (DD.mid-first x) (left x z))
    =< ap (GO.restrict (DD.mid y) (DD.mid x) (DD.mid-le y x k)) (agree x z)
    > GO.restrict (DD.mid y) (DD.mid x) (DD.mid-le y x k) (GO.restrict (DD.mid x) (DD.second x) (DD.mid-second x) (right x z))
    =< X.sheaf.res-comp (DD.mid y) (DD.mid x) (DD.second x) (DD.mid-le y x k) (DD.mid-second x) a2 (right x z)
    > GO.restrict (DD.mid y) (DD.second x) a2 (right x z)
    =< sym (X.sheaf.res-comp (DD.mid y) (DD.second y) (DD.second x) (DD.mid-second y) k2 a2 (right x z))
    > GO.restrict (DD.mid y) (DD.second y) (DD.mid-second y) (GO.restrict (DD.second y) (DD.second x) k2 (right x z)) } ;
  res : RH.Hom (ring x) (ring y) = At[y].P.Lift[ring x,first-part,second-part,agrees].lift ;
  -- its components, by definition
  left-res (z : (ring x).R) :
   Id (X.sheaf.ring (DD.first y)).R (left y (map res z)) (GO.restrict (DD.first y) (DD.first x) k1 (left x z)) =
   refl (GO.restrict (DD.first y) (DD.first x) k1 (left x z)) ;
  right-res (z : (ring x).R) :
   Id (X.sheaf.ring (DD.second y)).R (right y (map res z)) (GO.restrict (DD.second y) (DD.second x) k2 (right x z)) =
   refl (GO.restrict (DD.second y) (DD.second x) k2 (right x z)) ;
 } ;
 res (y x : DD.Opens) (k : OD.Le y x) : RH.Hom (ring x) (ring y) = Res[y,x,k].res ;
 res-id (x : DD.Opens) (k : OD.Le x x) (z : (ring x).R) : Id (ring x).R (map (res x x k) z) z =
  ext x (map (res x x k) z) z
   (trans (Res[x,x,k].left-res z) (X.sheaf.res-id (DD.first x) (Res[x,x,k].k1) (left x z)))
   (trans (Res[x,x,k].right-res z) (X.sheaf.res-id (DD.second x) (Res[x,x,k].k2) (right x z))) ;
 res-comp (x1 x2 x3 : DD.Opens) (a : OD.Le x1 x2) (b : OD.Le x2 x3) (c : OD.Le x1 x3) (z : (ring x3).R) :
  Id (ring x1).R (map (res x1 x2 a) (map (res x2 x3 b) z)) (map (res x1 x3 c) z) =
  ext x1 (map (res x1 x2 a) (map (res x2 x3 b) z)) (map (res x1 x3 c) z)
   (X.sheaf.res-comp (DD.first x1) (DD.first x2) (DD.first x3) (Res[x1,x2,a].k1) (Res[x2,x3,b].k1) (Res[x1,x3,c].k1) (left x3 z))
   (X.sheaf.res-comp (DD.second x1) (DD.second x2) (DD.second x3) (Res[x1,x2,a].k2) (Res[x2,x3,b].k2) (Res[x1,x3,c].k2) (right x3 z)) ;
 presheaf : R2.Presheaf = new R2.Presheaf[ring,ring-set,res,res-id,res-comp] ;
 module G2 = R2.Of[presheaf] ;

 -- the sheaf property
 module Glue (x : DD.Opens) (n : Nat) (ms : Fin n -> DD.Opens) (le : (i : Fin n) -> OD.Le (ms i) x)
  (covers : OD.Le x (DD.JD.bigJ n ms)) (xs : (i : Fin n) -> (ring (ms i)).R)
  (c : G2.Cover[x,n,ms,le,covers].Compatible xs) {
  module C2 = G2.Cover[x,n,ms,le,covers] ;
  -- the first components
  le1 (i : Fin n) : O.Le (DD.first (ms i)) (DD.first x) = DD.le-first (ms i) x (le i) ;
  covers1 : O.Le (DD.first x) (J.bigJ n (\ i -> DD.first (ms i))) =
   O.le-trans (DD.first x) (DD.first (DD.JD.bigJ n ms)) (J.bigJ n (\ i -> DD.first (ms i)))
    (DD.le-first x (DD.JD.bigJ n ms) covers) (O.le-of-eq _ _ (DD.join-first n ms)) ;
  s (i : Fin n) : (X.sheaf.ring (DD.first (ms i))).R = left (ms i) (xs i) ;
  module S1 = RingedLattice[l].On[L].Sheaf[X.sheaf,X.is-sheaf].Cover[DD.first x,n,\ i -> DD.first (ms i),le1,covers1] ;
  compatible1 : S1.C.Compatible s = \ i j ->
   trans (GO.res-irr (L.meet (DD.first (ms i)) (DD.first (ms j))) (DD.first (ms i))
     (O.meet-left (DD.first (ms i)) (DD.first (ms j))) (Res[DD.lattice.meet (ms i) (ms j),ms i,OD.meet-left (ms i) (ms j)].k1) (s i))
    (trans (ap (left (DD.lattice.meet (ms i) (ms j))) (c i j))
     (GO.res-irr (L.meet (DD.first (ms i)) (DD.first (ms j))) (DD.first (ms j))
      (Res[DD.lattice.meet (ms i) (ms j),ms j,OD.meet-right (ms i) (ms j)].k1) (O.meet-right (DD.first (ms i)) (DD.first (ms j))) (s j))) ;
  glued1 : S1.C.Amalgam s = (S1.glue s compatible1).1 ;
  -- the second components
  le2 (i : Fin n) : O.Le (DD.second (ms i)) (DD.second x) = DD.le-second (ms i) x (le i) ;
  covers2 : O.Le (DD.second x) (J.bigJ n (\ i -> DD.second (ms i))) =
   O.le-trans (DD.second x) (DD.second (DD.JD.bigJ n ms)) (J.bigJ n (\ i -> DD.second (ms i)))
    (DD.le-second x (DD.JD.bigJ n ms) covers) (O.le-of-eq _ _ (DD.join-second n ms)) ;
  t (i : Fin n) : (X.sheaf.ring (DD.second (ms i))).R = right (ms i) (xs i) ;
  module S2 = RingedLattice[l].On[L].Sheaf[X.sheaf,X.is-sheaf].Cover[DD.second x,n,\ i -> DD.second (ms i),le2,covers2] ;
  compatible2 : S2.C.Compatible t = \ i j ->
   trans (GO.res-irr (L.meet (DD.second (ms i)) (DD.second (ms j))) (DD.second (ms i))
     (O.meet-left (DD.second (ms i)) (DD.second (ms j))) (Res[DD.lattice.meet (ms i) (ms j),ms i,OD.meet-left (ms i) (ms j)].k2) (t i))
    (trans (ap (right (DD.lattice.meet (ms i) (ms j))) (c i j))
     (GO.res-irr (L.meet (DD.second (ms i)) (DD.second (ms j))) (DD.second (ms j))
      (Res[DD.lattice.meet (ms i) (ms j),ms j,OD.meet-right (ms i) (ms j)].k2) (O.meet-right (DD.second (ms i)) (DD.second (ms j))) (t j))) ;
  glued2 : S2.C.Amalgam t = (S2.glue t compatible2).1 ;
  -- the two amalgams agree on mid x, by separation on the mid (ms i)
  mid-le (i : Fin n) : O.Le (DD.mid (ms i)) (DD.mid x) = DD.mid-le (ms i) x (le i) ;
  covers-mid : O.Le (DD.mid x) (J.bigJ n (\ i -> DD.mid (ms i))) =
   O.le-trans (DD.mid x) (L.meet (J.bigJ n (\ i -> DD.first (ms i))) d) (J.bigJ n (\ i -> DD.mid (ms i)))
    (O.meet-mono (DD.first x) d (J.bigJ n (\ i -> DD.first (ms i))) d covers1 (O.le-refl d))
    (J.meet-join-right n (\ i -> DD.first (ms i)) d) ;
  module SM = RingedLattice[l].On[L].Sheaf[X.sheaf,X.is-sheaf].Cover[DD.mid x,n,\ i -> DD.mid (ms i),mid-le,covers-mid] ;
  b1 (i : Fin n) : O.Le (DD.mid (ms i)) (DD.first x) =
   O.le-trans (DD.mid (ms i)) (DD.first (ms i)) (DD.first x) (DD.mid-first (ms i)) (le1 i) ;
  b2 (i : Fin n) : O.Le (DD.mid (ms i)) (DD.second x) =
   O.le-trans (DD.mid (ms i)) (DD.second (ms i)) (DD.second x) (DD.mid-second (ms i)) (le2 i) ;
  agree-at (i : Fin n) :
   Id (X.sheaf.ring (DD.mid (ms i))).R
    (SM.C.restrictions (GO.restrict (DD.mid x) (DD.first x) (DD.mid-first x) (S1.C.amalgam glued1)) i)
    (SM.C.restrictions (GO.restrict (DD.mid x) (DD.second x) (DD.mid-second x) (S2.C.amalgam glued2)) i) =
   calc (X.sheaf.ring (DD.mid (ms i))).R {
    GO.restrict (DD.mid (ms i)) (DD.mid x) (mid-le i) (GO.restrict (DD.mid x) (DD.first x) (DD.mid-first x) (S1.C.amalgam glued1))
     =< X.sheaf.res-comp (DD.mid (ms i)) (DD.mid x) (DD.first x) (mid-le i) (DD.mid-first x) (b1 i) (S1.C.amalgam glued1)
     > GO.restrict (DD.mid (ms i)) (DD.first x) (b1 i) (S1.C.amalgam glued1)
     =< sym (X.sheaf.res-comp (DD.mid (ms i)) (DD.first (ms i)) (DD.first x) (DD.mid-first (ms i)) (le1 i) (b1 i) (S1.C.amalgam glued1))
     > GO.restrict (DD.mid (ms i)) (DD.first (ms i)) (DD.mid-first (ms i)) (GO.restrict (DD.first (ms i)) (DD.first x) (le1 i) (S1.C.amalgam glued1))
     =< ap (GO.restrict (DD.mid (ms i)) (DD.first (ms i)) (DD.mid-first (ms i))) (S1.C.matches glued1 i)
     > GO.restrict (DD.mid (ms i)) (DD.first (ms i)) (DD.mid-first (ms i)) (s i)
     =< agree (ms i) (xs i)
     > GO.restrict (DD.mid (ms i)) (DD.second (ms i)) (DD.mid-second (ms i)) (t i)
     =< ap (GO.restrict (DD.mid (ms i)) (DD.second (ms i)) (DD.mid-second (ms i))) (sym (S2.C.matches glued2 i))
     > GO.restrict (DD.mid (ms i)) (DD.second (ms i)) (DD.mid-second (ms i)) (GO.restrict (DD.second (ms i)) (DD.second x) (le2 i) (S2.C.amalgam glued2))
     =< X.sheaf.res-comp (DD.mid (ms i)) (DD.second (ms i)) (DD.second x) (DD.mid-second (ms i)) (le2 i) (b2 i) (S2.C.amalgam glued2)
     > GO.restrict (DD.mid (ms i)) (DD.second x) (b2 i) (S2.C.amalgam glued2)
     =< sym (X.sheaf.res-comp (DD.mid (ms i)) (DD.mid x) (DD.second x) (mid-le i) (DD.mid-second x) (b2 i) (S2.C.amalgam glued2))
     > GO.restrict (DD.mid (ms i)) (DD.mid x) (mid-le i) (GO.restrict (DD.mid x) (DD.second x) (DD.mid-second x) (S2.C.amalgam glued2)) } ;
  agrees : At[x].P.Agree (S1.C.amalgam glued1) (S2.C.amalgam glued2) =
   SM.separated (GO.restrict (DD.mid x) (DD.first x) (DD.mid-first x) (S1.C.amalgam glued1))
    (GO.restrict (DD.mid x) (DD.second x) (DD.mid-second x) (S2.C.amalgam glued2)) agree-at ;
  glued : (ring x).R = At[x].P.pair (S1.C.amalgam glued1) (S2.C.amalgam glued2) agrees ;
  matches : C2.Matches xs glued = \ i ->
   ext (ms i) (C2.restrictions glued i) (xs i) (S1.C.matches glued1 i) (S2.C.matches glued2 i) ;
  -- matching is a proposition
  matches-prop (z : (ring x).R) : Pr.isProp (C2.Matches xs z) =
   F.isProp-Pi (Fin n) (\ i -> Id (ring (ms i)).R (C2.restrictions z i) (xs i)) (\ i ->
    ring-set (ms i) (C2.restrictions z i) (xs i)) ;
  -- every amalgam is (glued, matches)
  unique (a : C2.Amalgam xs) : Id (C2.Amalgam xs) (glued,matches) a =
   Pr.Sigma-eq (ring x).R (C2.Matches xs) glued (C2.amalgam a) matches (C2.matches a)
    (ext x glued (C2.amalgam a)
     (S1.separated (S1.C.amalgam glued1) (left x (C2.amalgam a)) (\ i ->
       trans (S1.C.matches glued1 i) (sym (ap (left (ms i)) (C2.matches a i)))))
     (S2.separated (S2.C.amalgam glued2) (right x (C2.amalgam a)) (\ i ->
       trans (S2.C.matches glued2 i) (sym (ap (right (ms i)) (C2.matches a i))))))
    (matches-prop (C2.amalgam a)) ;
  sheaf : Localisation[l].isContr (C2.Amalgam xs) = ((glued,matches),unique) ;
 } ;
 is-sheaf : G2.IsSheaf = \ x n ms le covers xs c -> Glue[x,n,ms,le,covers,xs,c].sheaf ;

 -- the invertibility map, componentwise
 module IX = InvOpen[l].On[L].Of[X.sheaf] ;
 module LX = LocallyRinged[l].On[L].Laws[X.sheaf,X.inv] ;
 module I2 = InvOpen[l].On[DD.lattice].Of[presheaf] ;
 module Inv (x : DD.Opens) (z : (ring x).R) {
  v1 : L.L = LX.d (DD.first x) (left x z) ;
  v2 : L.L = LX.d (DD.second x) (right x z) ;
  -- on mid x, the restrictions of the components have invertibility opens mid x /\ v_i
  open1 : IX.IsInvOpen (DD.mid x) (GO.restrict (DD.mid x) (DD.first x) (DD.mid-first x) (left x z)) (L.meet (DD.mid x) v1) =
   IX.Restrict[DD.first x,DD.mid x,DD.mid-first x,left x z,v1,LX.d-open (DD.first x) (left x z)].restrict ;
  open2 : IX.IsInvOpen (DD.mid x) (GO.restrict (DD.mid x) (DD.second x) (DD.mid-second x) (right x z)) (L.meet (DD.mid x) v2) =
   IX.Restrict[DD.second x,DD.mid x,DD.mid-second x,right x z,v2,LX.d-open (DD.second x) (right x z)].restrict ;
  mid-eq : Id L.L (L.meet (DD.mid x) v1) (L.meet (DD.mid x) v2) =
   IX.unique (Pr.subst (X.sheaf.ring (DD.mid x)).R (\ w -> IX.IsInvOpen (DD.mid x) w (L.meet (DD.mid x) v1)) _ _ (agree x z) open1) open2 ;
  overlap : DD.Overlap v1 v2 = calc L.L {
   L.meet v1 d =< sym (DD.restrict-d (DD.first x) v1 (IX.below (LX.d-open (DD.first x) (left x z)))) > L.meet (DD.mid x) v1
    =< mid-eq > L.meet (DD.mid x) v2
    =< ap (\ w -> L.meet w v2) (DD.overlap x) > L.meet (L.meet (DD.second x) d) v2
    =< DD.restrict-d (DD.second x) v2 (IX.below (LX.d-open (DD.second x) (right x z))) > L.meet v2 d } ;
  v : DD.Opens = DD.pair v1 v2 overlap ;
  -- the components of a restriction of z are restrictions of its components (Res.left-res)
  forward : I2.Forward x z v = \ y k h ->
   At[y].P.unit-pair (map (res y x k) z)
    (Pr.subst (X.sheaf.ring (DD.first y)).R (IX.Unit (DD.first y)) _ _ (sym (Res[y,x,k].left-res z))
     (IX.to-unit (LX.d-open (DD.first x) (left x z)) (DD.first y) (Res[y,x,k].k1) (DD.le-first y v h)))
    (Pr.subst (X.sheaf.ring (DD.second y)).R (IX.Unit (DD.second y)) _ _ (sym (Res[y,x,k].right-res z))
     (IX.to-unit (LX.d-open (DD.second x) (right x z)) (DD.second y) (Res[y,x,k].k2) (DD.le-second y v h))) ;
  backward : I2.Backward x z v = \ y k e ->
   DD.le-pair y v
    (IX.from-unit (LX.d-open (DD.first x) (left x z)) (DD.first y) (Res[y,x,k].k1)
     (Pr.subst (X.sheaf.ring (DD.first y)).R (IX.Unit (DD.first y)) _ _ (Res[y,x,k].left-res z)
      (At[y].P.unit-left (map (res y x k) z) e)))
    (IX.from-unit (LX.d-open (DD.second x) (right x z)) (DD.second y) (Res[y,x,k].k2)
     (Pr.subst (X.sheaf.ring (DD.second y)).R (IX.Unit (DD.second y)) _ _ (Res[y,x,k].right-res z)
      (At[y].P.unit-right (map (res y x k) z) e))) ;
  inv-open : I2.InvOpen x z =
   (v,DD.le-pair v x (IX.below (LX.d-open (DD.first x) (left x z))) (IX.below (LX.d-open (DD.second x) (right x z))),
    forward,backward) ;
 } ;
 inv : I2.InvMap = \ x z -> Inv[x,z].inv-open ;

 -- the support laws, componentwise
 module L2 = LR2.Laws[presheaf,inv] ;
 zero-law-X : LX.ZeroLaw = X.is-support.2.1 ;
 add-law-X : LX.AddLaw = X.is-support.2.2.2 ;
 -- the components of D2(z), by definition
 d-first (x : DD.Opens) (z : (ring x).R) : Id L.L (DD.first (L2.d x z)) (LX.d (DD.first x) (left x z)) =
  refl (LX.d (DD.first x) (left x z)) ;
 d-second (x : DD.Opens) (z : (ring x).R) : Id L.L (DD.second (L2.d x z)) (LX.d (DD.second x) (right x z)) =
  refl (LX.d (DD.second x) (right x z)) ;
 zero-law : L2.ZeroLaw = \ x ->
  DD.ext (L2.d x (ring x).z) DD.botD
   (trans (d-first x (ring x).z) (zero-law-X (DD.first x))) (trans (d-second x (ring x).z) (zero-law-X (DD.second x))) ;
 add-law : L2.AddLaw = \ x z z2 ->
  DD.le-pair (L2.d x ((ring x).add z z2)) (DD.joinD (L2.d x z) (L2.d x z2))
   (add-law-X (DD.first x) (left x z) (left x z2)) (add-law-X (DD.second x) (right x z) (right x z2)) ;

 -- the doubled locally ringed lattice
 doubled : LR2.LocallyRinged = new LR2.LocallyRinged[presheaf,is-sheaf,inv,L2.support zero-law add-law] ;
} ;
