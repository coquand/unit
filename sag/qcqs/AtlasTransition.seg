-- Transition isomorphisms recovered from two affine functorial charts.
-- Represent |U/\V| using the first chart (AtlasOverlap), and |V/\U|
-- using the second.  OpenSymmetry identifies these overlap functors and
-- keeps their underlying point of F.  Compose with the inverse of the
-- second representation to get a natural equivalence of their geometric
-- functors.  Both spaces are qcqs, so GeometricRecovery gives a geometric
-- transition isomorphism.  Its point equation, the inverse law of the
-- second representation and OpenSymmetry.trace show that it keeps the
-- point of F.  AtlasOverlap.trace then expresses the usual square with
-- both chart inclusions.  Triple-domain and cocycle laws come next.
level l ; open Ring[l] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module TE = TestEquivalences[l] ;
module CO = CompactOpens[l] ;
module SP = Spaces[l] ;
module Op = OpenMaps[l] ;
module Over (F : SF.SetFunctor) (u v : CO.Over[F].Open) (A B : T.Test)
 (ea : TE.NaturalEquivalence SF.Representable[A].functor OpenRealisation[l].Over[F,u].functor)
 (eb : TE.NaturalEquivalence SF.Representable[B].functor OpenRealisation[l].Over[F,v].functor) {
 module CA = AtlasOverlap[l].Over[F,u,A,ea] ;
 module CB = AtlasOverlap[l].Over[F,v,B,eb] ;
 module Left = CA.With[v] ;
 module Right = CB.With[u] ;
 module Swap = OpenSymmetry[l].Over[F,u,v] ;
 module RI = TE.Inverse[SF.Geometric[Right.AR.space].functor,Right.I.Meet.functor,Right.equivalence] ;
 module First = TE.Composite[SF.Geometric[Left.AR.space].functor,Left.I.Meet.functor,Right.I.Meet.functor,Left.equivalence,Swap.R.equivalence] ;
 equivalence : TE.NaturalEquivalence SF.Geometric[Left.AR.space].functor SF.Geometric[Right.AR.space].functor =
  TE.Composite[SF.Geometric[Left.AR.space].functor,Right.I.Meet.functor,SF.Geometric[Right.AR.space].functor,First.equivalence,RI.inverse-equiv].equivalence ;
 equivalence-at (C : T.Test) (p : SP.Hom (T.space C) Left.AR.space) :
  Id (SP.Hom (T.space C) Right.AR.space)
   (SF.Transform[SF.Geometric[Left.AR.space].functor,SF.Geometric[Right.AR.space].functor].at (TE.forward equivalence) C p)
   (RI.inverse-map C (SF.Transform[Left.I.Meet.functor,Right.I.Meet.functor].at (TE.forward Swap.R.equivalence) C
    (SF.Transform[SF.Geometric[Left.AR.space].functor,Left.I.Meet.functor].at (TE.forward Left.equivalence) C p))) =
  refl (RI.inverse-map C (SF.Transform[Left.I.Meet.functor,Right.I.Meet.functor].at (TE.forward Swap.R.equivalence) C
    (SF.Transform[SF.Geometric[Left.AR.space].functor,Left.I.Meet.functor].at (TE.forward Left.equivalence) C p))) ;
 opaque equivalence ;
 module G = GeometricRecovery[l].Over[Left.AR.space,Right.AR.space,Left.AR.qcqs,Right.AR.qcqs,equivalence] ;
 module Point (C : T.Test) (p : SP.Hom (T.space C) Left.AR.space) {
  overlap-equation : Id (F.obj C)
   (Right.I.Meet.point {C} (SF.Transform[SF.Geometric[Right.AR.space].functor,Right.I.Meet.functor].at (TE.forward Right.equivalence) C
    (SP.compose (T.space C) Left.AR.space Right.AR.space G.forward p)))
   (Left.I.Meet.point {C} (SF.Transform[SF.Geometric[Left.AR.space].functor,Left.I.Meet.functor].at (TE.forward Left.equivalence) C p)) =
   trans (ap (\ q -> Right.I.Meet.point {C}
     (SF.Transform[SF.Geometric[Right.AR.space].functor,Right.I.Meet.functor].at (TE.forward Right.equivalence) C q)) (trans (G.forward-on C p) (equivalence-at C p)))
    (trans (ap (Right.I.Meet.point {C}) (RI.right-at C
      (SF.Transform[Left.I.Meet.functor,Right.I.Meet.functor].at (TE.forward Swap.R.equivalence) C
       (SF.Transform[SF.Geometric[Left.AR.space].functor,Left.I.Meet.functor].at (TE.forward Left.equivalence) C p))))
     (Swap.trace C (SF.Transform[SF.Geometric[Left.AR.space].functor,Left.I.Meet.functor].at (TE.forward Left.equivalence) C p))) ;
  chart-equation : Id (F.obj C)
   (SF.Transform[CB.AF.G.functor,F].at CB.chart-inclusion C
    (SP.compose (T.space C) Right.AR.space (T.space B) (Op.inclusion (T.space B) Right.AR.AC.extent)
     (SP.compose (T.space C) Left.AR.space Right.AR.space G.forward p)))
   (SF.Transform[CA.AF.G.functor,F].at CA.chart-inclusion C
    (SP.compose (T.space C) Left.AR.space (T.space A) (Op.inclusion (T.space A) Left.AR.AC.extent) p)) =
   trans (sym (Right.trace C (SP.compose (T.space C) Left.AR.space Right.AR.space G.forward p)))
    (trans overlap-equation (Left.trace C p)) ;
 } ;
} ;
