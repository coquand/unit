-- Gluing, the second half of the basic sheaf lemma (DESIGN.md, step 3).
-- Let D g = D h_1 \/ .. \/ D h_n with D h_i <= D g, and let x_i in R_{h_i}
-- agree on overlaps: rho(x_i) = rho(x_j) in R_{h_i h_j}.
--
-- Theorem.  There is exactly one x in R_g with rho_{g,h_i}(x) = x_i.
--  Uniqueness is separation; so existence is a proposition, and merely
--  given data may be used.
--  Normal form.  Write f(s_i) x_i = f(y_i), s_i a power of h_i.  In
--  R_{h_i h_j} the agreement gives f(y_i s_j) = f(y_j s_i), so a power
--  (h_i h_j)^(m_ij) kills d_ij = y_i s_j - y_j s_i; let M bound all m_ij.
--  Put w_i = h_i^(M+1), k_i = w_i s_i, y'_i = w_i y_i.  Then D k_i = D h_i,
--  x'_i = rho_{h_i,k_i}(x_i) satisfies f(k_i) x'_i = f(y'_i), and
--   y'_i k_j = (w_i w_j)(y_i s_j) = (h_i h_j)^(M+1) (y_i s_j)
--            = (h_i h_j)^(M+1) (y_j s_i) = y'_j k_i.
--  Strict case.  Let D k_i = D h_i and y_i k_j = y_j k_i.  As D g <= D(k),
--  g^p = sum k_i c_i; put Y = sum y_i c_i, so Y k_j = y_j g^p, and
--  x = f_g(Y) / f_g(g^p).  In R_{k_j}, f(g^p) rho(x) = f(Y), hence
--  f(g^p) f(k_j) rho(x) = f(Y k_j) = f(g^p) f(y_j), and f(g^p) is a unit:
--  f(k_j) rho_{g,k_j}(x) = f(y_j).
--  Back to h_j.  With the normal form, rho_{g,k_j}(x) = x'_j (cancel the
--  unit f(k_j)); that is rho_{h_j,k_j}(rho_{g,h_j} x) = rho_{h_j,k_j}(x_j),
--  and rho_{h_j,k_j} is injective since D h_j = D k_j.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module NB = NatBound[l] ;
module Over (A : CRing) (Loc : A.R -> CRing) (set : (g : A.R) -> Pr.isSet (Loc g).R)
 (f : (g : A.R) -> RH.Hom A (Loc g))
 (el : (g : A.R) -> Bridge[l].Over[A,g].LocH.Elementary (Loc g) (f g)) {
 open A ; open RL[A] ;
 open Radical[l].Over[A] ; open FamilyLattice[l].Over[A] ;
 open ZariskiLattice[l].Over[A] ;
 module Sm = FiniteIdeal[l].Sums[A] ;
 module Sp = Sup.Of[D,support] ;
 module P = AffinePowers[l].Over[A] ;
 module Reg = Regularity[l].Over[A] ;
 module S = Sections[l].Over[A,Loc,set,f,el] ;
 module Sep = Separation[l].Over[A,Loc,set,f,el] ;

 -- D(a b) <= D a and D(a b) <= D b
 le-left (a b : R) : O.Le (D (mul a b)) (D a) = Sp.scaled a b ;
 le-right (a b : R) : O.Le (D (mul a b)) (D b) =
  Pr.subst R (\ t -> O.Le (D t) (D b)) (mul b a) (mul a b) (mulC b a) (Sp.scaled b a) ;
 -- a unit u is cancellable
 cancel (C : CRing) (u : C.R) (hu : RL[C].unit u) (a b : C.R) (e : Id C.R (C.mul u a) (C.mul u b)) : Id C.R a b =
  Regularity[l].Over[C].from-kernel u (\ v h -> RL[C].unit-reg u v hu h) a b e ;

 module Cover (g : R) (n : Nat) (hs : Fin n -> R) (below : (i : Fin n) -> O.Le (D (hs i)) (D g))
  (covers : O.Le (D g) (J.bigJ n (\ i -> D (hs i))))
  (xs : (i : Fin n) -> (Loc (hs i)).R)
  (agree : (i j : Fin n) -> Id (Loc (mul (hs i) (hs j))).R
    (map (S.rho (hs i) (mul (hs i) (hs j)) (le-left (hs i) (hs j))) (xs i))
    (map (S.rho (hs j) (mul (hs i) (hs j)) (le-right (hs i) (hs j))) (xs j))) {
  module BG = Bridge[l].Over[A,g] ;
  module SC = Sep.Cover[g,n,hs,below,covers] ;
  Glue : U l = (x : (Loc g).R) * ((i : Fin n) -> Id (Loc (hs i)).R (map (SC.rho-i i) x) (xs i)) ;
  glue-prop : Pr.isProp Glue = \ a b ->
   Pr.Sigma-eq (Loc g).R (\ x -> (i : Fin n) -> Id (Loc (hs i)).R (map (SC.rho-i i) x) (xs i)) a.1 b.1 a.2 b.2
    (SC.injective a.1 b.1 (\ i -> trans (a.2 i) (sym (b.2 i))))
    (F.isProp-Pi (Fin n) (\ i -> Id (Loc (hs i)).R (map (SC.rho-i i) b.1) (xs i)) (\ i -> set (hs i) _ _)) ;

  -- the strict case
  module Strict (ks : Fin n -> R) (kb : (i : Fin n) -> O.Le (D (ks i)) (D (hs i)))
   (hk : (i : Fin n) -> O.Le (D (hs i)) (D (ks i))) (ys : Fin n -> R)
   (crossed : (i j : Fin n) -> Id R (mul (ys i) (ks j)) (mul (ys j) (ks i))) {
   kg (i : Fin n) : O.Le (D (ks i)) (D g) = O.le-trans (D (ks i)) (D (hs i)) (D g) (kb i) (below i) ;
   module Rad (r : RadData (n,ks) g) {
    p : Nat = rad-power r ;
    c : Fin n -> R = rad-coefficients r ;
    Y : R = Sm.lin n ys c ;
    -- Y k_j = y_j g^p
    Y-k (j : Fin n) : Id R (mul Y (ks j)) (mul (ys j) (power g p)) = calc R {
     mul Y (ks j) =< mulC Y (ks j) > mul (ks j) (Sm.lin n ys c)
      =< sym (Sm.lin-scale n ys c (ks j)) > Sm.lin n ys (\ i -> mul (ks j) (c i))
      =< Sm.sum-cong n (\ i -> mul (ys i) (mul (ks j) (c i))) (\ i -> mul (ys j) (mul (ks i) (c i)))
          (\ i -> trans (mulA (ys i) (ks j) (c i))
            (trans (ap (\ t -> mul t (c i)) (crossed i j)) (sym (mulA (ys j) (ks i) (c i)))))
       > Sm.sum n (\ i -> mul (ys j) (mul (ks i) (c i)))
      =< Sm.sum-scale (ys j) n (\ i -> mul (ks i) (c i)) > mul (ys j) (Sm.lin n ks c)
      =< ap (mul (ys j)) (rad-equation r) > mul (ys j) (power g p) } ;
    u : RL[Loc g].unit (map (f g) (power g p)) = BG.LocH.inverts (el g) (power g p) (p,refl (power g p)) ;
    x : (Loc g).R = (Loc g).mul (map (f g) Y) u.1 ;
    -- f_g(g^p) x = f_g(Y)
    x-eq : Id (Loc g).R ((Loc g).mul (map (f g) (power g p)) x) (map (f g) Y) =
     trans (RL[Loc g].mul-swap (map (f g) (power g p)) (map (f g) Y) u.1)
      (trans (ap ((Loc g).mul (map (f g) Y)) u.2) ((Loc g).mulO (map (f g) Y))) ;
    module At (j : Fin n) {
     rj : RH.Hom (Loc g) (Loc (ks j)) = S.rho g (ks j) (kg j) ;
     -- f_{k_j}(g^p) rho(x) = f_{k_j}(Y)
     rho-x : Id (Loc (ks j)).R ((Loc (ks j)).mul (map (f (ks j)) (power g p)) (map rj x)) (map (f (ks j)) Y) =
      calc (Loc (ks j)).R {
      (Loc (ks j)).mul (map (f (ks j)) (power g p)) (map rj x)
       =< ap (\ t -> (Loc (ks j)).mul t (map rj x)) (sym (S.rho-on g (ks j) (kg j) (power g p)))
        > (Loc (ks j)).mul (map rj (map (f g) (power g p))) (map rj x)
       =< sym (map-mul rj (map (f g) (power g p)) x) > map rj ((Loc g).mul (map (f g) (power g p)) x)
       =< ap (map rj) x-eq > map rj (map (f g) Y)
       =< S.rho-on g (ks j) (kg j) Y > map (f (ks j)) Y } ;
     unit-gp : RL[Loc (ks j)].unit (map (f (ks j)) (power g p)) =
      Restriction[l].Over[A,Loc,set,f,el].Pair[g,ks j,kg j].unit-power p ;
     -- f_{k_j}(k_j) rho(x) = f_{k_j}(y_j)
     k-x : Id (Loc (ks j)).R ((Loc (ks j)).mul (map (f (ks j)) (ks j)) (map rj x)) (map (f (ks j)) (ys j)) =
      cancel (Loc (ks j)) (map (f (ks j)) (power g p)) unit-gp
       ((Loc (ks j)).mul (map (f (ks j)) (ks j)) (map rj x)) (map (f (ks j)) (ys j)) (calc (Loc (ks j)).R {
       (Loc (ks j)).mul (map (f (ks j)) (power g p)) ((Loc (ks j)).mul (map (f (ks j)) (ks j)) (map rj x))
        =< RL[Loc (ks j)].mul-swap (map (f (ks j)) (power g p)) (map (f (ks j)) (ks j)) (map rj x)
         > (Loc (ks j)).mul (map (f (ks j)) (ks j)) ((Loc (ks j)).mul (map (f (ks j)) (power g p)) (map rj x))
        =< ap ((Loc (ks j)).mul (map (f (ks j)) (ks j))) rho-x
         > (Loc (ks j)).mul (map (f (ks j)) (ks j)) (map (f (ks j)) Y)
        =< sym (map-mul (f (ks j)) (ks j) Y) > map (f (ks j)) (mul (ks j) Y)
        =< ap (map (f (ks j))) (trans (mulC (ks j) Y) (Y-k j)) > map (f (ks j)) (mul (ys j) (power g p))
        =< map-mul (f (ks j)) (ys j) (power g p) > (Loc (ks j)).mul (map (f (ks j)) (ys j)) (map (f (ks j)) (power g p))
        =< (Loc (ks j)).mulC (map (f (ks j)) (ys j)) (map (f (ks j)) (power g p))
         > (Loc (ks j)).mul (map (f (ks j)) (power g p)) (map (f (ks j)) (ys j)) }) ;
    } ;
   } ;
  } ;

  -- the normal form
  Frac (i : Fin n) : U l = Bridge[l].Over[A,hs i].LocH.Fraction (Loc (hs i)) (f (hs i)) (xs i) ;
  fractions : Tr.Trunc[(i : Fin n) -> Frac i].carrier =
   AffineFinite[l].choice n Frac (\ i -> Bridge[l].Over[A,hs i].LocH.fractions (el (hs i)) (xs i)) ;
  module Fr (ps : (i : Fin n) -> Frac i) {
   y (i : Fin n) : R = Bridge[l].Over[A,hs i].LocH.num {Loc (hs i)} {f (hs i)} {xs i} (ps i) ;
   s (i : Fin n) : R = Bridge[l].Over[A,hs i].LocH.den {Loc (hs i)} {f (hs i)} {xs i} (ps i) ;
   e (i j : Fin n) : R = mul (hs i) (hs j) ;
   -- f(y_i s_j) = f(y_j s_i) in R_{h_i h_j}
   cross (i j : Fin n) : Id (Loc (e i j)).R (map (f (e i j)) (mul (y i) (s j))) (map (f (e i j)) (mul (y j) (s i))) =
    calc (Loc (e i j)).R {
    map (f (e i j)) (mul (y i) (s j)) =< map-mul (f (e i j)) (y i) (s j)
      > (Loc (e i j)).mul (map (f (e i j)) (y i)) (map (f (e i j)) (s j))
     =< ap (\ t -> (Loc (e i j)).mul t (map (f (e i j)) (s j))) (Sep.image-num (hs i) (e i j) (le-left (hs i) (hs j)) (xs i) (ps i))
      > (Loc (e i j)).mul ((Loc (e i j)).mul (map (f (e i j)) (s i)) (map (S.rho (hs i) (e i j) (le-left (hs i) (hs j))) (xs i)))
         (map (f (e i j)) (s j))
     =< ap (\ t -> (Loc (e i j)).mul ((Loc (e i j)).mul (map (f (e i j)) (s i)) t) (map (f (e i j)) (s j))) (agree i j)
      > (Loc (e i j)).mul ((Loc (e i j)).mul (map (f (e i j)) (s i)) (map (S.rho (hs j) (e i j) (le-right (hs i) (hs j))) (xs j)))
         (map (f (e i j)) (s j))
     =< trans ((Loc (e i j)).mulC ((Loc (e i j)).mul (map (f (e i j)) (s i)) (map (S.rho (hs j) (e i j) (le-right (hs i) (hs j))) (xs j)))
          (map (f (e i j)) (s j)))
         (trans (RL[Loc (e i j)].mul-swap (map (f (e i j)) (s j)) (map (f (e i j)) (s i))
            (map (S.rho (hs j) (e i j) (le-right (hs i) (hs j))) (xs j)))
          ((Loc (e i j)).mulC (map (f (e i j)) (s i))
            ((Loc (e i j)).mul (map (f (e i j)) (s j)) (map (S.rho (hs j) (e i j) (le-right (hs i) (hs j))) (xs j)))))
      > (Loc (e i j)).mul ((Loc (e i j)).mul (map (f (e i j)) (s j)) (map (S.rho (hs j) (e i j) (le-right (hs i) (hs j))) (xs j)))
         (map (f (e i j)) (s i))
     =< ap (\ t -> (Loc (e i j)).mul t (map (f (e i j)) (s i))) (sym (Sep.image-num (hs j) (e i j) (le-right (hs i) (hs j)) (xs j) (ps j)))
      > (Loc (e i j)).mul (map (f (e i j)) (y j)) (map (f (e i j)) (s i))
     =< sym (map-mul (f (e i j)) (y j) (s i)) > map (f (e i j)) (mul (y j) (s i)) } ;
   d (i j : Fin n) : R = add (mul (y i) (s j)) (neg (mul (y j) (s i))) ;
   Killer (i j : Fin n) : U l = Bridge[l].Over[A,e i j].LocH.Killer (d i j) ;
   killers : Tr.Trunc[(i j : Fin n) -> Killer i j].carrier =
    AffineFinite[l].choice n (\ i -> (j : Fin n) -> Killer i j) (\ i ->
     AffineFinite[l].choice n (\ j -> Killer i j) (\ j ->
      Bridge[l].Over[A,e i j].LocH.kernel (el (e i j)) (d i j)
       (Bridge[l].Over[A,e i j].At[Loc (e i j),set (e i j),f (e i j),el (e i j),e i j].zero-difference
         (mul (y i) (s j)) (mul (y j) (s i)) (cross i j)))) ;

   module Ks (cs : (i j : Fin n) -> Killer i j) {
    t (i j : Fin n) : R = Bridge[l].Over[A,e i j].LocH.kill {d i j} (cs i j) ;
    m (i j : Fin n) : Nat = Bridge[l].Over[A,e i j].index (Bridge[l].Over[A,e i j].LocH.kill-in {d i j} (cs i j)) ;
    M : Nat = NB.bound n (\ i -> NB.bound n (\ j -> m i j)) ;
    above (i j : Fin n) : NB.Above (m i j) M =
     NB.above-trans (m i j) (NB.bound n (\ jj -> m i jj)) M (NB.bound-above n (\ jj -> m i jj) j)
      (NB.bound-above n (\ ii -> NB.bound n (\ jj -> m ii jj)) i) ;
    -- (h_i h_j)^(M+1) d_ij = 0
    kill-M (i j : Fin n) : Id R (mul (power (e i j) M) (d i j)) z = calc R {
     mul (power (e i j) M) (d i j)
      =< ap (\ q -> mul (power (e i j) q) (d i j)) (sym (NB.excess-eq (above i j)))
       > mul (power (e i j) (plus (m i j) (NB.excess (above i j)))) (d i j)
      =< ap (\ q -> mul q (d i j)) (P.power-add (e i j) (m i j) (NB.excess (above i j)))
       > mul (mul (power (e i j) (m i j)) (power (e i j) (NB.excess (above i j)))) (d i j)
      =< ap (\ q -> mul (mul q (power (e i j) (NB.excess (above i j)))) (d i j))
          (Bridge[l].Over[A,e i j].index-eq (Bridge[l].Over[A,e i j].LocH.kill-in {d i j} (cs i j)))
       > mul (mul (t i j) (power (e i j) (NB.excess (above i j)))) (d i j)
      =< ap (\ q -> mul q (d i j)) (mulC (t i j) (power (e i j) (NB.excess (above i j))))
       > mul (mul (power (e i j) (NB.excess (above i j))) (t i j)) (d i j)
      =< sym (mulA (power (e i j) (NB.excess (above i j))) (t i j) (d i j))
       > mul (power (e i j) (NB.excess (above i j))) (mul (t i j) (d i j))
      =< ap (mul (power (e i j) (NB.excess (above i j)))) (Bridge[l].Over[A,e i j].LocH.kill-eq {d i j} (cs i j))
       > mul (power (e i j) (NB.excess (above i j))) z
      =< mul-zero (power (e i j) (NB.excess (above i j))) > z } ;
    kill-M1 (i j : Fin n) : Id R (mul (power (e i j) (suc M)) (d i j)) z =
     trans (sym (mulA (e i j) (power (e i j) M) (d i j)))
      (trans (ap (mul (e i j)) (kill-M i j)) (mul-zero (e i j))) ;
    w (i : Fin n) : R = mul (hs i) (P.power (hs i) M) ;
    k (i : Fin n) : R = mul (w i) (s i) ;
    yk (i : Fin n) : R = mul (w i) (y i) ;
    w-power (i : Fin n) : Id R (P.power (hs i) (suc M)) (w i) = refl (w i) ;
    -- w_i w_j = (h_i h_j)^(M+1)
    ww (i j : Fin n) : Id R (mul (w i) (w j)) (power (e i j) (suc M)) =
     trans (cong2 R mul _ _ _ _ (sym (w-power i)) (sym (w-power j))) (sym (P.power-mul (hs i) (hs j) (suc M))) ;
    -- (h_i h_j)^(M+1) (y_i s_j) = (h_i h_j)^(M+1) (y_j s_i)
    cleared (i j : Fin n) : Id R (mul (power (e i j) (suc M)) (mul (y i) (s j))) (mul (power (e i j) (suc M)) (mul (y j) (s i))) =
     Reg.difference (mul (power (e i j) (suc M)) (mul (y i) (s j))) (mul (power (e i j) (suc M)) (mul (y j) (s i)))
      (trans (sym (Bridge[l].Over[A,g].times-difference (power (e i j) (suc M)) (mul (y i) (s j)) (mul (y j) (s i)))) (kill-M1 i j)) ;
    cross-k (i j : Fin n) : Id R (mul (yk i) (k j)) (mul (yk j) (k i)) = calc R {
     mul (yk i) (k j) =< mul-four (w i) (y i) (w j) (s j) > mul (mul (w i) (w j)) (mul (y i) (s j))
      =< ap (\ q -> mul q (mul (y i) (s j))) (ww i j) > mul (power (e i j) (suc M)) (mul (y i) (s j))
      =< cleared i j > mul (power (e i j) (suc M)) (mul (y j) (s i))
      =< ap (\ q -> mul q (mul (y j) (s i))) (trans (sym (ww i j)) (mulC (w i) (w j))) > mul (mul (w j) (w i)) (mul (y j) (s i))
      =< sym (mul-four (w j) (y j) (w i) (s i)) > mul (yk j) (k i) } ;
    -- D k_i = D h_i
    kb (i : Fin n) : O.Le (D (k i)) (D (hs i)) =
     O.le-trans (D (k i)) (D (w i)) (D (hs i)) (Sp.scaled (w i) (s i)) (Sp.scaled (hs i) (P.power (hs i) M)) ;
    s-above (i : Fin n) : O.Le (D (hs i)) (D (s i)) =
     Pr.subst R (\ q -> O.Le (D (hs i)) (D q))
      (power (hs i) (Bridge[l].Over[A,hs i].index (Bridge[l].Over[A,hs i].LocH.den-in {Loc (hs i)} {f (hs i)} {xs i} (ps i)))) (s i)
      (Bridge[l].Over[A,hs i].index-eq (Bridge[l].Over[A,hs i].LocH.den-in {Loc (hs i)} {f (hs i)} {xs i} (ps i)))
      (Sp.power-above (hs i) (Bridge[l].Over[A,hs i].index (Bridge[l].Over[A,hs i].LocH.den-in {Loc (hs i)} {f (hs i)} {xs i} (ps i)))) ;
    hk (i : Fin n) : O.Le (D (hs i)) (D (k i)) =
     Pr.subst lattice.L (\ q -> O.Le (D (hs i)) q) (lattice.meet (D (w i)) (D (s i))) (D (k i)) (sym (Sp.at-mul (w i) (s i)))
      (O.meet-glb (D (w i)) (D (s i)) (D (hs i))
       (Pr.subst R (\ q -> O.Le (D (hs i)) (D q)) (P.power (hs i) (suc M)) (w i) (w-power i) (Sp.power-above (hs i) (suc M)))
       (s-above i)) ;
    -- xk_i = rho_{h_i,k_i}(x_i), with f(k_i) xk_i = f(yk_i)
    xk (i : Fin n) : (Loc (k i)).R = map (S.rho (hs i) (k i) (kb i)) (xs i) ;
    k-eq (i : Fin n) : Id (Loc (k i)).R ((Loc (k i)).mul (map (f (k i)) (k i)) (xk i)) (map (f (k i)) (yk i)) =
     calc (Loc (k i)).R {
     (Loc (k i)).mul (map (f (k i)) (k i)) (xk i)
      =< ap (\ q -> (Loc (k i)).mul q (xk i)) (map-mul (f (k i)) (w i) (s i))
       > (Loc (k i)).mul ((Loc (k i)).mul (map (f (k i)) (w i)) (map (f (k i)) (s i))) (xk i)
      =< sym ((Loc (k i)).mulA (map (f (k i)) (w i)) (map (f (k i)) (s i)) (xk i))
       > (Loc (k i)).mul (map (f (k i)) (w i)) ((Loc (k i)).mul (map (f (k i)) (s i)) (xk i))
      =< ap ((Loc (k i)).mul (map (f (k i)) (w i))) (sym (Sep.image-num (hs i) (k i) (kb i) (xs i) (ps i)))
       > (Loc (k i)).mul (map (f (k i)) (w i)) (map (f (k i)) (y i))
      =< sym (map-mul (f (k i)) (w i) (y i)) > map (f (k i)) (yk i) } ;
   } ;
  } ;

  -- the glued element, from a normal form and a radical certificate
  module Final (ps : (i : Fin n) -> Frac i) (cs : (i j : Fin n) -> Fr[ps].Killer i j)
   (r : RadData (n,Fr[ps].Ks[cs].k) g) {
   module N = Fr[ps].Ks[cs] ;
   module St = Strict[N.k,N.kb,N.hk,N.yk,N.cross-k] ;
   module SR = St.Rad[r] ;
   unit-k (j : Fin n) : RL[Loc (N.k j)].unit (map (f (N.k j)) (N.k j)) =
    Bridge[l].Over[A,N.k j].LocH.inverts (el (N.k j)) (N.k j) (suc zero,mulO (N.k j)) ;
   at-k (j : Fin n) : Id (Loc (N.k j)).R (map (S.rho g (N.k j) (St.kg j)) SR.x) (N.xk j) =
    cancel (Loc (N.k j)) (map (f (N.k j)) (N.k j)) (unit-k j) (map (S.rho g (N.k j) (St.kg j)) SR.x) (N.xk j)
     (trans (SR.At[j].k-x) (sym (N.k-eq j))) ;
   at (j : Fin n) : Id (Loc (hs j)).R (map (SC.rho-i j) SR.x) (xs j) =
    Sep.Single[hs j,N.k j,N.kb j,N.hk j].injective (map (SC.rho-i j) SR.x) (xs j)
     (trans (S.rho-comp-at g (hs j) (N.k j) (below j) (N.kb j) (St.kg j) SR.x) (at-k j)) ;
   glued : Glue = (SR.x,at) ;
  } ;
  glue : Glue =
   Tr.Trunc[(i : Fin n) -> Frac i].induction @l (\ q -> Glue) (\ q -> glue-prop)
    (\ ps -> Tr.Trunc[(i j : Fin n) -> Fr[ps].Killer i j].induction @l (\ q -> Glue) (\ q -> glue-prop)
      (\ cs -> Tr.Trunc[RadData (n,Fr[ps].Ks[cs].k) g].induction @l (\ q -> Glue) (\ q -> glue-prop)
        (\ r -> Final[ps,cs,r].glued)
        (SC.radical-of (Fr[ps].Ks[cs].k) (Fr[ps].Ks[cs].hk)))
      (Fr[ps].killers))
    fractions ;
  -- the basic sheaf lemma: exactly one x with rho_{g,h_i}(x) = x_i
  sheaf : Localisation[l].isContr Glue = (glue,\ b -> glue-prop glue b) ;
 } ;
} ;
