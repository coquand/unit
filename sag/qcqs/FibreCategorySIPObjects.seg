-- The identification of equivalent univalent categories acts on objects
-- as the functor (objects and arrows in U l).
-- Let (F, G, u, v) : C ~ D and p = FibreCategorySIPTheorem.On[C,D,e]
-- .equality.  Transport of objects along p (obC p, a subst over
-- categories) is F.obj pointwise.  The path p is a composite, and
-- transport of objects along a composite is the composite of the
-- transports (ob-trans, obC-trans: J on the second path).  The pieces:
-- (1) record eta (pre-eta, category-eta): split, then refl;
-- (2) ap (to-pre O) of a path of structures on the same objects O (the
--     structure-equality): the objects stay O, J (ob-const);
-- (3) the Sigma path of pre-path-to-category: its first component is the
--     path of precategories, J on it and on the second component
--     (obC-sigma);
-- (4) the reindexing equality, built by equivalence induction eqind on
--     the object equivalence F.obj: eqind is J on ua e followed by a
--     subst along idtoeqv (ua e) = e; the subst does not change the path
--     (subst-ob, J), the J part acts as coe (ua e) (path-ob, J, base case
--     by split on the structure), and coe (ua e) = e.1 (ua-beta).
level l ; open Base ;
module K = Category[l,l] ;
module P = Prelude[l] ;
module R = Prelude[l+] ;
module S = FibreCategorySIP[l] ;
module CE = FibreCategoryEquivalence[l] ;
module Reindex = FibreCategorySIPReindex[l] ;
module UA = Axioms[l].UnivalenceLemmas[univ @l] ;

-- transport of objects along a path of precategories
ob-along (X Y : K.Precategory) (r : Id K.Precategory X Y) (x : X.ob) : Y.ob =
 R.subst K.Precategory (\ Z -> Z.ob) X Y r x ;
ob-trans (X Y Z : K.Precategory) (r : Id K.Precategory X Y) (t : Id K.Precategory Y Z) (x : X.ob) :
 Id Z.ob (ob-along X Z (R.trans K.Precategory X Y Z r t) x) (ob-along Y Z t (ob-along X Y r x)) =
 idJ K.Precategory Y (\ W t' -> Id W.ob (ob-along X W (R.trans K.Precategory X Y W r t') x) (ob-along Y W t' (ob-along X Y r x)))
  (refl (ob-along X Y r x)) Z t ;
ob-eta : (X : K.Precategory) (x : X.ob) ->
 Id X.ob (ob-along (S.to-pre X.ob (S.from-pre X)) X (S.pre-eta X) x) x =
 split { Precategory O h hs i c ul ur a -> \ x -> refl x } ;
ob-eta-sym : (X : K.Precategory) (x : X.ob) ->
 Id X.ob (ob-along X (S.to-pre X.ob (S.from-pre X)) (R.sym K.Precategory (S.to-pre X.ob (S.from-pre X)) X (S.pre-eta X)) x) x =
 split { Precategory O h hs i c ul ur a -> \ x -> refl x } ;
ob-const (O : U l) (s t : S.Structure[O]) (r : Id (S.Structure[O]) s t) (x : O) :
 Id O (ob-along (S.to-pre O s) (S.to-pre O t) (R.ap (S.Structure[O]) K.Precategory (S.to-pre O) s t r) x) x =
 idJ (S.Structure[O]) s (\ t' r' -> Id O (ob-along (S.to-pre O s) (S.to-pre O t') (R.ap (S.Structure[O]) K.Precategory (S.to-pre O) s t' r') x) x)
  (refl x) t r ;

-- (4) the reindexing equality acts as the object equivalence
module ReindexOb (A : U l) {
 module RI = Reindex.Reindex[A] ;
 Along (B : U l) (f : A -> B) (s : S.Structure[B]) (r : Id K.Precategory (S.to-pre A (Reindex.pullback A B f s)) (S.to-pre B s)) (x : A) : B =
  ob-along (S.to-pre A (Reindex.pullback A B f s)) (S.to-pre B s) r x ;
 base-ob : (s : S.Structure[A]) (x : A) -> Id A (Along A (\ y -> y) s (RI.base s) x) x =
  split { Structure h hs i c ul ur a -> \ x -> refl x } ;
 J-part (B : U l) (p : Id (U l) A B) : RI.Motive B (Axioms[l].idtoeqv A B p) =
  idJ (U l) A (\ X q -> RI.Motive X (Axioms[l].idtoeqv A X q)) RI.base B p ;
 path-ob (B : U l) (p : Id (U l) A B) (s : S.Structure[B]) (x : A) :
  Id B (Along B (Axioms[l].idtoeqv A B p).1 s (J-part B p s) x) (P.coe A B p x) =
  idJ (U l) A (\ X q -> (s' : S.Structure[X]) -> Id X (Along X (Axioms[l].idtoeqv A X q).1 s' (J-part X q s') x) (P.coe A X q x))
   (\ s' -> base-ob s' x) B p s ;
 subst-ob (B : U l) (e0 e1 : P.Equiv A B) (w : Id (P.Equiv A B) e0 e1) (m : RI.Motive B e0) (s : S.Structure[B]) (x : A) :
  Id B (Along B e1.1 s (R.subst (P.Equiv A B) (RI.Motive B) e0 e1 w m s) x) (Along B e0.1 s (m s) x) =
  idJ (P.Equiv A B) e0 (\ e' w' -> Id B (Along B e'.1 s (R.subst (P.Equiv A B) (RI.Motive B) e0 e' w' m s) x) (Along B e0.1 s (m s) x))
   (refl (Along B e0.1 s (m s) x)) e1 w ;
 equality-ob (B : U l) (e : P.Equiv A B) (s : S.Structure[B]) (x : A) :
  Id B (Along B e.1 s (RI.equality B e s) x) (e.1 x) =
  P.trans B (Along B e.1 s (RI.equality B e s) x) (Along B (Axioms[l].idtoeqv A B (UA.ua A B e)).1 s (J-part B (UA.ua A B e) s) x) (e.1 x)
   (subst-ob B (Axioms[l].idtoeqv A B (UA.ua A B e)) e ((univ @l A B).sec-eq e) (J-part B (UA.ua A B e)) s x)
   (P.trans B (Along B (Axioms[l].idtoeqv A B (UA.ua A B e)).1 s (J-part B (UA.ua A B e) s) x) (P.coe A B (UA.ua A B e) x) (e.1 x)
    (path-ob B (UA.ua A B e) s x) (UA.ua-beta A B e x)) ;
} ;

-- transport of objects along a path of categories
obC (C D : K.Category) (p : Id K.Category C D) (x : C.pre.ob) : D.pre.ob =
 R.subst K.Category (\ X -> X.pre.ob) C D p x ;
obC-trans (C D E : K.Category) (p : Id K.Category C D) (q : Id K.Category D E) (x : C.pre.ob) :
 Id E.pre.ob (obC C E (R.trans K.Category C D E p q) x) (obC D E q (obC C D p x)) =
 idJ K.Category D (\ W q' -> Id W.pre.ob (obC C W (R.trans K.Category C D W p q') x) (obC D W q' (obC C D p x)))
  (refl (obC C D p x)) E q ;
obC-eta : (C : K.Category) (x : C.pre.ob) ->
 Id C.pre.ob (obC (S.category-from (S.category-raw C)) C (S.category-eta C) x) x =
 split { Category X u -> \ x -> refl x } ;
obC-eta-sym : (C : K.Category) (x : C.pre.ob) ->
 Id C.pre.ob (obC C (S.category-from (S.category-raw C)) (R.sym K.Category (S.category-from (S.category-raw C)) C (S.category-eta C)) x) x =
 split { Category X u -> \ x -> refl x } ;
-- (3) the Sigma path: J on the second component, then on the first
module Sigma (X : K.Precategory) (u : S.UnivalentHigh X) (x : X.ob) {
 Pair (Y : K.Precategory) (u' : S.UnivalentHigh Y) : S.CategoryRaw = (Y,u') ;
 Lift (Y : K.Precategory) (u' : S.UnivalentHigh Y) (w : Id S.CategoryRaw (Pair X u) (Pair Y u')) : Id K.Category (S.category-from (Pair X u)) (S.category-from (Pair Y u')) =
  R.ap S.CategoryRaw K.Category S.category-from (Pair X u) (Pair Y u') w ;
 inner (u' : S.UnivalentHigh X) (w : Id (S.UnivalentHigh X) u u') :
  Id X.ob (obC (S.category-from (Pair X u)) (S.category-from (Pair X u')) (Lift X u' (R.ap (S.UnivalentHigh X) S.CategoryRaw (\ v -> Pair X v) u u' w)) x) x =
  idJ (S.UnivalentHigh X) u (\ v w' -> Id X.ob (obC (S.category-from (Pair X u)) (S.category-from (Pair X v)) (Lift X v (R.ap (S.UnivalentHigh X) S.CategoryRaw (\ v' -> Pair X v') u v w')) x) x)
   (refl x) u' w ;
 sigma-ob (Y : K.Precategory) (r : Id K.Precategory X Y) (pB : R.isProp (S.UnivalentHigh Y)) (u' : S.UnivalentHigh Y) :
  Id Y.ob (obC (S.category-from (Pair X u)) (S.category-from (Pair Y u')) (Lift Y u' (R.Sigma-eq K.Precategory S.UnivalentHigh X Y u u' r pB)) x) (ob-along X Y r x) =
  idJ K.Precategory X (\ Z r' -> (pB' : R.isProp (S.UnivalentHigh Z)) (u'' : S.UnivalentHigh Z) ->
    Id Z.ob (obC (S.category-from (Pair X u)) (S.category-from (Pair Z u'')) (Lift Z u'' (R.Sigma-eq K.Precategory S.UnivalentHigh X Z u u'' r' pB')) x) (ob-along X Z r' x))
   (\ pB' u'' -> inner u'' (pB' u u'')) Y r pB u' ;
} ;
-- pre-path-to-category acts on objects as its path of precategories
module PrePath (C D : K.Category) (q : Id K.Precategory C.pre D.pre) {
 c0 : K.Category = S.category-from (S.category-raw C) ;
 d0 : K.Category = S.category-from (S.category-raw D) ;
 middle : Id K.Category c0 d0 =
  R.ap S.CategoryRaw K.Category S.category-from (S.category-raw C) (S.category-raw D)
   (R.Sigma-eq K.Precategory S.UnivalentHigh C.pre D.pre C.univalent D.univalent q (S.Proofs[D].univalence-prop)) ;
 tail : Id K.Category c0 D = R.trans K.Category c0 d0 D middle (S.category-eta D) ;
 objects (x : C.pre.ob) : Id D.pre.ob (obC C D (S.pre-path-to-category C D q) x) (ob-along C.pre D.pre q x) =
  P.trans D.pre.ob (obC C D (S.pre-path-to-category C D q) x) (obC c0 D tail (obC C c0 (R.sym K.Category c0 C (S.category-eta C)) x))
   (ob-along C.pre D.pre q x)
   (obC-trans C c0 D (R.sym K.Category c0 C (S.category-eta C)) tail x)
   (P.trans D.pre.ob (obC c0 D tail (obC C c0 (R.sym K.Category c0 C (S.category-eta C)) x)) (obC c0 D tail x) (ob-along C.pre D.pre q x)
    (P.ap C.pre.ob D.pre.ob (obC c0 D tail) (obC C c0 (R.sym K.Category c0 C (S.category-eta C)) x) x (obC-eta-sym C x))
    (P.trans D.pre.ob (obC c0 D tail x) (obC d0 D (S.category-eta D) (obC c0 d0 middle x)) (ob-along C.pre D.pre q x)
     (obC-trans c0 d0 D middle (S.category-eta D) x)
     (P.trans D.pre.ob (obC d0 D (S.category-eta D) (obC c0 d0 middle x)) (obC c0 d0 middle x) (ob-along C.pre D.pre q x)
      (obC-eta D (obC c0 d0 middle x))
      (Sigma[C.pre,C.univalent,x].sigma-ob D.pre q (S.Proofs[D].univalence-prop) D.univalent)))) ;
} ;

-- the theorem: transport of objects along the identification is F.obj
module On (C D : K.Category) (e : CE.Equivalence[C,D]) {
 module T = FibreCategorySIPTheorem[l].On[C,D,e] ;
 F (x : C.pre.ob) : D.pre.ob = e.forward.obj x ;
 Mid : K.Precategory = S.to-pre T.O T.pulled ;
 Pulled : K.Precategory = S.to-pre D.pre.ob T.target ;
 source-path : Id K.Precategory C.pre (S.to-pre T.O T.source) =
  R.sym K.Precategory (S.to-pre T.O T.source) C.pre (S.pre-eta C.pre) ;
 first-ob (x : C.pre.ob) : Id C.pre.ob (ob-along C.pre Mid T.first x) x =
  P.trans C.pre.ob (ob-along C.pre Mid T.first x) (ob-along (S.to-pre T.O T.source) Mid (R.ap (S.Structure[T.O]) K.Precategory (S.to-pre T.O) T.source T.pulled T.structure-equality) (ob-along C.pre (S.to-pre T.O T.source) source-path x)) x
   (ob-trans C.pre (S.to-pre T.O T.source) Mid source-path (R.ap (S.Structure[T.O]) K.Precategory (S.to-pre T.O) T.source T.pulled T.structure-equality) x)
   (P.trans C.pre.ob (ob-along (S.to-pre T.O T.source) Mid (R.ap (S.Structure[T.O]) K.Precategory (S.to-pre T.O) T.source T.pulled T.structure-equality) (ob-along C.pre (S.to-pre T.O T.source) source-path x)) (ob-along C.pre (S.to-pre T.O T.source) source-path x) x
    (ob-const T.O T.source T.pulled T.structure-equality (ob-along C.pre (S.to-pre T.O T.source) source-path x))
    (ob-eta-sym C.pre x)) ;
 second-ob (x : C.pre.ob) : Id D.pre.ob (ob-along Mid Pulled T.second x) (F x) =
  ReindexOb[T.O].equality-ob D.pre.ob T.E.object-equivalence T.target x ;
 rest : Id K.Precategory Mid D.pre = R.trans K.Precategory Mid Pulled D.pre T.second (S.pre-eta D.pre) ;
 rest-ob (x : C.pre.ob) : Id D.pre.ob (ob-along Mid D.pre rest x) (F x) =
  P.trans D.pre.ob (ob-along Mid D.pre rest x) (ob-along Pulled D.pre (S.pre-eta D.pre) (ob-along Mid Pulled T.second x)) (F x)
   (ob-trans Mid Pulled D.pre T.second (S.pre-eta D.pre) x)
   (P.trans D.pre.ob (ob-along Pulled D.pre (S.pre-eta D.pre) (ob-along Mid Pulled T.second x)) (ob-along Mid Pulled T.second x) (F x)
    (ob-eta D.pre (ob-along Mid Pulled T.second x)) (second-ob x)) ;
 precategory-ob (x : C.pre.ob) : Id D.pre.ob (ob-along C.pre D.pre T.precategory-equality x) (F x) =
  P.trans D.pre.ob (ob-along C.pre D.pre T.precategory-equality x) (ob-along Mid D.pre rest (ob-along C.pre Mid T.first x)) (F x)
   (ob-trans C.pre Mid D.pre T.first rest x)
   (P.trans D.pre.ob (ob-along Mid D.pre rest (ob-along C.pre Mid T.first x)) (ob-along Mid D.pre rest x) (F x)
    (P.ap C.pre.ob D.pre.ob (ob-along Mid D.pre rest) (ob-along C.pre Mid T.first x) x (first-ob x))
    (rest-ob x)) ;
 objects (x : C.pre.ob) : Id D.pre.ob (obC C D T.equality x) (F x) =
  P.trans D.pre.ob (obC C D T.equality x) (ob-along C.pre D.pre T.precategory-equality x) (F x)
   (PrePath[C,D,T.precategory-equality].objects x) (precategory-ob x) ;
} ;
