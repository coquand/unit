-- Restriction of a module sheaf twice agrees with restriction once.
-- Flattening the nested slice keeps the original open and section carrier.
-- Its scalar map is the identity, so the comparison is linear. The two
-- restriction maps have the same original endpoints; proof independence
-- of the original restrictions proves naturality. Every component is
-- the identity on sections, hence is an equivalence.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module DL = DistLattice[l] ;
module MS = SerreModuleSheaf[l] ; module MM = SerreModuleMaps[l] ;
module On (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged)
 (e : L.L) (u : Slice[l].Over[L,X,e].Opens)
 (M : MS.On[L,X.sheaf].ModuleSheaf) {
 module C = SliceNested[l].Over[L,X,e,u] ;
 module First = SerreModuleSheafRestriction[l].On[L,X,e,M] ;
 module Twice = SerreModuleSheafRestriction[l].On[C.S.lattice,C.S.restricted,u,First.restricted] ;
 module Once = SerreModuleSheafRestriction[l].On[L,X,C.S.inc u,M] ;
 module Image = SerreModuleSheafDirectImage[l].Over[C.Nested.lattice,C.Single.lattice,
  C.Nested.sheaf,C.Single.sheaf,C.morphism,Once.restricted] ;
 module MO = MS.On[L,X.sheaf].Of[M.presheaf] ;
 module Maps = MS.On[C.Nested.lattice,C.Nested.sheaf].Transform[Twice.presheaf,Image.presheaf] ;
 module I = SerreModuleSheafIso[l].On[C.Nested.lattice,C.Nested.sheaf] ;
 sharp-at (a : C.Nested.Opens) (r : (C.Nested.sheaf.ring a).R) :
  Id (X.sheaf.ring (C.S.inc (C.Nested.inc a))).R
   (RingMaps[l].map (C.morphism.sharp a) r) r = refl r ;
 scalar (a : C.Nested.Opens) (r : (C.Nested.sheaf.ring a).R)
  (x : (Twice.presheaf.module-at a).M) :
  Id (Twice.presheaf.module-at a).M ((Twice.presheaf.module-at a).sm r x)
   ((Image.presheaf.module-at a).sm r x) =
  sym (trans (Image.At[a].Scalars.scalar-at r x)
   (ap (\ s -> (M.presheaf.module-at (C.S.inc (C.Nested.inc a))).sm s x) (sharp-at a r))) ;
 component (a : C.Nested.Opens) :
  MM.Between[C.Nested.sheaf.ring a,C.Nested.sheaf.ring a,
   RingHom[l].identity (C.Nested.sheaf.ring a),Twice.presheaf.module-at a,Image.presheaf.module-at a].Hom =
  new MM.Between[C.Nested.sheaf.ring a,C.Nested.sheaf.ring a,
   RingHom[l].identity (C.Nested.sheaf.ring a),Twice.presheaf.module-at a,Image.presheaf.module-at a].Hom[
   \ x -> x,\ x y -> refl ((Twice.presheaf.module-at a).madd x y),scalar a] ;
 natural (a b : C.Nested.Opens) (k : C.Nested.OS.Le a b)
  (x : (Twice.presheaf.module-at b).M) :
  Id (Twice.presheaf.module-at a).M (Twice.RO.restrict a b k x) (Image.PO.restrict a b k x) =
  trans (Twice.restrict-inc a b k x)
   (trans (First.restrict-inc (C.Nested.inc a) (C.Nested.inc b) (C.Nested.le-inc a b k) x)
    (trans (MO.res-irr (C.S.inc (C.Nested.inc a)) (C.S.inc (C.Nested.inc b))
     (C.S.le-inc (C.Nested.inc a) (C.Nested.inc b) (C.Nested.le-inc a b k))
     (C.Single.le-inc (Image.p a) (Image.p b) (Image.mono a b k)) x)
     (trans (sym (Once.restrict-inc (Image.p a) (Image.p b) (Image.mono a b k) x))
      (sym (trans (Image.presheaf-res a b k x) (Image.restrict-at a b k x)))))) ;
 comparison : Maps.Hom = new Maps.Hom[component,natural] ;
 comparison-at (a : C.Nested.Opens) (x : (Twice.presheaf.module-at a).M) :
  Id (Twice.presheaf.module-at a).M (Maps.at comparison a x) x = refl x ;
 equivalence : I.Equivalence Twice.presheaf Image.presheaf =
  (comparison,\ a -> Pr.qinv (Twice.presheaf.module-at a).M (Image.presheaf.module-at a).M
   (Maps.at comparison a) (\ x -> x) (comparison-at a) (comparison-at a)) ;
 opaque comparison ;
} ;
