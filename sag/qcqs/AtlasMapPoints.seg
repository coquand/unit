-- The morphism recovered from an affine atlas induces the original family.
-- Fix p : Spec B -> X.  The inverse images of the chart opens cover Spec B,
-- since p* preserves finite joins and top.  On the inverse image V_i of
-- U_i, the pullback restriction r_i : V_i -> U_i makes the square commute.
-- For any affine probe q into V_i, the composite p(j q) factors through
-- U_i by that square.  AtlasMap.chart-equation therefore identifies its
-- image under the recovered map with alpha_A(p(j q)).  Naturality of alpha
-- for the affine morphism j q identifies this with alpha_B(p)(j q).
-- V_i is qcqs (SliceQcqs and AffineQcqs), so ProbeSeparation gives equality
-- on V_i.  MapSeparation on the pulled-back chart cover gives equality on
-- Spec B.  Extensionality of natural families gives the inverse law.
level l ; open Ring[l] ; open Presentations[l] ;
module DL = DistLattice[l] ;
module Sp = Spaces[l] ;
module Op = OpenMaps[l] ;
module T = AffineTests[l] ;
module FP = FunctorPoints[l] ;
module Over (X Y : Sp.Space) (alpha : FP.Maps[X,Y].Nat)
 (c : Qcqs[l].Over[X.lattice,X.structure].AffineCover) {
 module N = FP.Maps[X,Y] ;
 module M = AtlasMap[l].Over[X,Y,alpha].FromCover[c] ;
 module At (B : T.Test) (p : Sp.Hom (T.space B) X) {
  module O = DL.Order[(T.space B).lattice] ;
  module J = DL.Joins[(T.space B).lattice] ;
  module PL = DL.JoinMaps[X.lattice,(T.space B).lattice,(Sp.underlying p).lat] ;
  pieces (i : Fin c.count) : (T.space B).lattice.L = DL.hmap (Sp.underlying p).lat (c.opens i) ;
  covers : Id (T.space B).lattice.L (J.bigJ c.count pieces) (T.space B).lattice.top =
   trans (sym (PL.preserves c.count c.opens))
    (trans (ap (DL.hmap (Sp.underlying p).lat) c.covers) (DL.hmap-top (Sp.underlying p).lat)) ;
  cover-le : O.Le (T.space B).lattice.top (J.bigJ c.count pieces) = O.le-of-eq (T.space B).lattice.top (J.bigJ c.count pieces) (sym covers) ;
  module Piece (i : Fin c.count) {
   module PB = OpenPullback[l].Over[T.space B,X,p,c.opens i] ;
   left : Sp.Hom (Op.space (T.space B) (pieces i)) Y =
    Sp.compose (Op.space (T.space B) (pieces i)) (T.space B) Y
     (Sp.compose (T.space B) X Y M.morphism p) (Op.inclusion (T.space B) (pieces i)) ;
   right : Sp.Hom (Op.space (T.space B) (pieces i)) Y =
    Sp.compose (Op.space (T.space B) (pieces i)) (T.space B) Y (N.at alpha B p) (Op.inclusion (T.space B) (pieces i)) ;
   module Probe (A : T.Test) (q : Sp.Hom (T.space A) (Op.space (T.space B) (pieces i))) {
    through-chart : Sp.Hom (T.space A) (Op.space X (c.opens i)) =
     Sp.compose (T.space A) (Op.space (T.space B) (pieces i)) (Op.space X (c.opens i)) PB.morphism q ;
    through-test : Sp.Hom (T.space A) (T.space B) =
     Sp.compose (T.space A) (Op.space (T.space B) (pieces i)) (T.space B) (Op.inclusion (T.space B) (pieces i)) q ;
    factor : Id (Sp.Hom (T.space A) X)
     (Sp.compose (T.space A) (Op.space X (c.opens i)) X (Op.inclusion X (c.opens i)) through-chart)
     (Sp.compose (T.space A) (T.space B) X p through-test) =
     trans Sp.Associativity[T.space A,Op.space (T.space B) (pieces i),Op.space X (c.opens i),X,Op.inclusion X (c.opens i),PB.morphism,q].assoc
      (trans (ap (\ h -> Sp.compose (T.space A) (Op.space (T.space B) (pieces i)) X h q) PB.triangle)
       (sym Sp.Associativity[T.space A,Op.space (T.space B) (pieces i),T.space B,X,p,Op.inclusion (T.space B) (pieces i),q].assoc)) ;
    equation : Id (Sp.Hom (T.space A) Y)
     (Sp.compose (T.space A) (Op.space (T.space B) (pieces i)) Y left q)
     (Sp.compose (T.space A) (Op.space (T.space B) (pieces i)) Y right q) =
     calc (Sp.Hom (T.space A) Y) {
      Sp.compose (T.space A) (Op.space (T.space B) (pieces i)) Y left q
       =< sym Sp.Associativity[T.space A,Op.space (T.space B) (pieces i),T.space B,Y,
           Sp.compose (T.space B) X Y M.morphism p,Op.inclusion (T.space B) (pieces i),q].assoc
        > Sp.compose (T.space A) (T.space B) Y (Sp.compose (T.space B) X Y M.morphism p) through-test
       =< sym Sp.Associativity[T.space A,T.space B,X,Y,M.morphism,p,through-test].assoc
        > Sp.compose (T.space A) X Y M.morphism (Sp.compose (T.space A) (T.space B) X p through-test)
       =< ap (Sp.compose (T.space A) X Y M.morphism) (sym factor)
        > Sp.compose (T.space A) X Y M.morphism (Sp.compose (T.space A) (Op.space X (c.opens i)) X (Op.inclusion X (c.opens i)) through-chart)
       =< M.chart-equation i A through-chart
        > N.at alpha A (Sp.compose (T.space A) (Op.space X (c.opens i)) X (Op.inclusion X (c.opens i)) through-chart)
       =< ap (N.at alpha A) factor > N.at alpha A (Sp.compose (T.space A) (T.space B) X p through-test)
       =< N.natural-map alpha B A through-test p > Sp.compose (T.space A) (T.space B) Y (N.at alpha B p) through-test
       =< Sp.Associativity[T.space A,Op.space (T.space B) (pieces i),T.space B,Y,N.at alpha B p,Op.inclusion (T.space B) (pieces i),q].assoc
        > Sp.compose (T.space A) (Op.space (T.space B) (pieces i)) Y right q } ;
   } ;
   equality : Id (Sp.Hom (Op.space (T.space B) (pieces i)) Y) left right =
    ProbeSeparation[l].Over[Op.space (T.space B) (pieces i),Y].Compare[left,right,\ A q -> Probe[A,q].equation].separated
     (SliceQcqs[l].Over[(T.space B).lattice,(T.space B).structure,pieces i].qcqs AffineQcqs[l].TestSpace[B].qcqs) ;
  } ;
  module Sep = MapSeparation[l].Maps[Y.lattice,(T.space B).lattice,Y.structure.sheaf,(T.space B).structure] ;
  equation : Id (Sp.Hom (T.space B) Y) (Sp.compose (T.space B) X Y M.morphism p) (N.at alpha B p) =
   Sp.ext (T.space B) Y (Sp.compose (T.space B) X Y M.morphism p) (N.at alpha B p)
    (Sep.Cover[c.count,pieces,cover-le].separated (Sp.underlying (Sp.compose (T.space B) X Y M.morphism p)) (Sp.underlying {T.space B} {Y} (N.at alpha B p))
     (\ i -> ap (Sp.underlying {Op.space (T.space B) (pieces i)} {Y}) Piece[i].equality)) ;
 } ;
 induced : Id N.Nat (N.induced M.morphism) alpha = N.ext (N.induced M.morphism) alpha (\ B p -> At[B,p].equation) ;
} ;
