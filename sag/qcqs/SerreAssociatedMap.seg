-- Functoriality of associated module sheaves (Serre, Section 4).
-- Localise an A-linear map on every basic open. Its A_g-linearity follows
-- from the checked scalar-naturality theorem, after the explicit scalar
-- restriction comparisons. The local maps commute with restriction by
-- uniqueness of extensions out of M_g. Applying them componentwise gives
-- a natural linear map of the genuine associated module sheaves.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module RH = RingHom[l] ; module RM = RingMaps[l] ;
module LL = SerreModuleLocalisationLinear[l] ; module UP = SerreModuleLocalisationUniversal[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (Md Nd : SM.Over[A].Module)
 (u : MM.Between[A,A,RH.identity A,Md,Nd].Hom) {
 module Original = MM.Between[A,A,RH.identity A,Md,Nd] ;
 module Source = SerreAssociatedSheaf[l].Over[A,setA,Md] ;
 module Target = SerreAssociatedSheaf[l].Over[A,setA,Nd] ;
 module M = Source.S ; module N = Target.S ; module Z = Source.AM.Z ; module O = Z.O ;
 module MR = Source.BR ; module NR = Target.BR ; module AF = Source.AM.AF ;
 module Local (g : A.R) {
  module Native = LL.Along[A,A,RH.identity A,Md,Nd,u,g] ;
  module X = MR.Local[g].Scalars ; module Y = NR.Local[g].Scalars ;
  module XR = MM.RestrictScalars[A,AF.Loc g,AF.inclusion g].Of[X.localised] ;
  module YR = MM.RestrictScalars[A,AF.Loc g,AF.inclusion g].Of[Y.localised] ;
  module Restricted = MM.Between[A,A,RH.identity A,XR.restricted,YR.restricted] ;
  source-scalar (a : A.R) (x : Native.S.L.Carrier) :
   Id Native.S.L.Carrier (XR.restricted.sm a x) (Native.S.localised.sm a x) =
   trans (XR.scalar-at a x) (trans (X.ER.module-scalar-at (RM.map (AF.inclusion g) a) x) (X.ER.original-action a x)) ;
  target-scalar (a : A.R) (x : Native.T.L.Carrier) :
   Id Native.T.L.Carrier (YR.restricted.sm a x) (Native.T.localised.sm a x) =
   trans (YR.scalar-at a x) (trans (Y.ER.module-scalar-at (RM.map (AF.inclusion g) a) x) (Y.ER.original-action a x)) ;
  restricted : Restricted.Hom = new Restricted.Hom[Native.Maps.map Native.induced,Native.Maps.map-add Native.induced,
   \ a x -> trans (ap (Native.Maps.map Native.induced) (source-scalar a x))
    (trans (Native.Maps.map-scale Native.induced a x) (sym (target-scalar a (Native.Maps.map Native.induced x))))] ;
  restricted-at (x : Native.S.L.Carrier) : Id Native.T.L.Carrier
   (Restricted.map restricted x) (Native.Maps.map Native.induced x) = refl (Native.Maps.map Native.induced x) ;
  opaque restricted ;
  module Scalars = SerreModuleScalarNaturality[l].Over[A,setA,g,AF.Loc g,AF.set g,AF.inclusion g,AF.elementary g] ;
  module Promotion = Scalars.Between[X.localised,Y.localised,restricted] ;
  module Maps = MM.Between[AF.Loc g,AF.Loc g,RH.identity (AF.Loc g),X.localised,Y.localised] ;
  linear : Maps.Hom = Promotion.linear ;
  at (x : Native.S.L.Carrier) : Native.T.L.Carrier = Maps.map linear x ;
  native-at (x : Native.S.L.Carrier) : Id Native.T.L.Carrier (at x) (Native.Maps.map Native.induced x) =
   trans (Promotion.linear-at x) (restricted-at x) ;
  on-fractions (x : Md.M) (p : Nat) :
   Id Native.T.L.Carrier (at (Native.S.L.fraction x p)) (Native.T.L.fraction (Original.map u x) p) =
   trans (native-at (Native.S.L.fraction x p)) (Native.induced-at x p) ;
  opaque linear ;
 } ;
 module Commute (g h : A.R) (le : O.Le (Z.D h) (Z.D g)) {
  module MS = MR.At[g,h,le] ; module NS = NR.At[g,h,le] ;
  module Maps = MM.Between[A,A,RH.identity A,MR.Local[g].Native.localised,NR.Local[h].Native.localised] ;
  module OrigTarget = MM.Between[A,A,RH.identity A,Md,NR.Local[h].Native.localised] ;
  original : OrigTarget.Hom = new OrigTarget.Hom[
   \ x -> NR.Local[h].Native.Canonical.map NR.Local[h].Native.canonical (Original.map u x),
   \ x y -> trans (ap (NR.Local[h].Native.Canonical.map NR.Local[h].Native.canonical) (Original.map-add u x y))
    (NR.Local[h].Native.Canonical.map-add NR.Local[h].Native.canonical (Original.map u x) (Original.map u y)),
   \ a x -> trans (ap (NR.Local[h].Native.Canonical.map NR.Local[h].Native.canonical) (Original.map-scale u a x))
    (NR.Local[h].Native.Canonical.map-scale NR.Local[h].Native.canonical a (Original.map u x))] ;
  module ExtensionProof = UP.Extend[A,Md,NR.Local[h].Native.localised,g,original,NS.invertible] ;
  left : Maps.Hom = new Maps.Hom[
   \ x -> NS.map (Local[g].Native.Maps.map Local[g].Native.induced x),
   \ x y -> trans (ap NS.map (Local[g].Native.Maps.map-add Local[g].Native.induced x y))
    (NS.map-add (Local[g].Native.Maps.map Local[g].Native.induced x) (Local[g].Native.Maps.map Local[g].Native.induced y)),
   \ a x -> trans (ap NS.map (Local[g].Native.Maps.map-scale Local[g].Native.induced a x))
    (NS.map-scale a (Local[g].Native.Maps.map Local[g].Native.induced x))] ;
  right : Maps.Hom = new Maps.Hom[
   \ x -> Local[h].Native.Maps.map Local[h].Native.induced (MS.map x),
   \ x y -> trans (ap (Local[h].Native.Maps.map Local[h].Native.induced) (MS.map-add x y))
    (Local[h].Native.Maps.map-add Local[h].Native.induced (MS.map x) (MS.map y)),
   \ a x -> trans (ap (Local[h].Native.Maps.map Local[h].Native.induced) (MS.map-scale a x))
    (Local[h].Native.Maps.map-scale Local[h].Native.induced a (MS.map x))] ;
  left-original (x : Md.M) : Id NR.Local[h].Native.L.Carrier
   (Maps.map left (MR.Local[g].Native.L.fraction x zero)) (OrigTarget.map original x) =
   trans (ap NS.map (Local[g].Native.induced-at x zero))
    (trans (NS.on-original (Original.map u x)) (sym (NR.Local[h].Native.canonical-at (Original.map u x)))) ;
  right-original (x : Md.M) : Id NR.Local[h].Native.L.Carrier
   (Maps.map right (MR.Local[g].Native.L.fraction x zero)) (OrigTarget.map original x) =
   trans (ap (Local[h].Native.Maps.map Local[h].Native.induced) (MS.on-original x))
    (trans (Local[h].Native.induced-at x zero) (sym (NR.Local[h].Native.canonical-at (Original.map u x)))) ;
  native (x : MR.Local[g].Native.L.Carrier) : Id NR.Local[h].Native.L.Carrier
   (NS.map (Local[g].Native.Maps.map Local[g].Native.induced x))
   (Local[h].Native.Maps.map Local[h].Native.induced (MS.map x)) =
   trans (ExtensionProof.Other[left,left-original].unique x) (sym (ExtensionProof.Other[right,right-original].unique x)) ;
  equation (x : MR.Local[g].Native.L.Carrier) : Id NR.Local[h].Native.L.Carrier
   (N.rho g h le (Local[g].at x)) (Local[h].at (M.rho g h le x)) =
   trans (Target.AM.component-restriction g h le (Local[g].at x))
    (trans (ap NS.map (Local[g].native-at x))
     (trans (native x)
      (trans (sym (Local[h].native-at (MS.map x)))
       (ap Local[h].at (sym (Source.AM.component-restriction g h le x)))))) ;
  opaque original ; opaque left ; opaque right ;
 } ;
 section-map (v : Z.lattice.L) (s : M.Section v) : N.Section v =
  (\ g k -> Local[g].at (M.at s g k),\ g h kg hg ->
   trans (Commute[g,h,hg].equation (M.at s g kg)) (ap Local[h].at (M.compat s g h kg hg))) ;
 section-map-at (v : Z.lattice.L) (s : M.Section v) (g : A.R) (k : O.Le (Z.D g) v) :
  Id NR.Local[g].Native.L.Carrier (N.at (section-map v s) g k) (Local[g].at (M.at s g k)) = refl (Local[g].at (M.at s g k)) ;
 module At (v : Z.lattice.L) {
  module Maps = MM.Between[Source.AM.G.S.ring v,Source.AM.G.S.ring v,RH.identity (Source.AM.G.S.ring v),M.Ops[v].section-module,N.Ops[v].section-module] ;
  additive (s t : M.Section v) : Id (N.Section v) (section-map v (M.Ops[v].add s t)) (N.Ops[v].add (section-map v s) (section-map v t)) =
   N.section-ext v _ _ (\ g k -> trans (section-map-at v (M.Ops[v].add s t) g k)
    (trans (ap Local[g].at (M.Ops[v].add-at s t g k))
     (trans (Local[g].Maps.map-add Local[g].linear (M.at s g k) (M.at t g k))
      (trans (cong2 NR.Local[g].Native.L.Carrier NR.Local[g].Native.add _ _ _ _
       (sym (section-map-at v s g k)) (sym (section-map-at v t g k)))
       (sym (N.Ops[v].add-at (section-map v s) (section-map v t) g k)))))) ;
  scalar (r : (Source.AM.G.S.ring v).R) (s : M.Section v) :
   Id (N.Section v) (section-map v (M.Ops[v].scale r s)) (N.Ops[v].scale r (section-map v s)) =
   N.section-ext v _ _ (\ g k -> trans (section-map-at v (M.Ops[v].scale r s) g k)
    (trans (ap Local[g].at (M.Ops[v].scale-at r s g k))
     (trans (Local[g].Maps.map-scale Local[g].linear (Source.AM.G.S.at r g k) (M.at s g k))
      (trans (ap (NR.Local[g].Scalars.localised.sm (Source.AM.G.S.at r g k)) (sym (section-map-at v s g k)))
       (sym (N.Ops[v].scale-at r (section-map v s) g k)))))) ;
  component : Maps.Hom = new Maps.Hom[section-map v,additive,scalar] ;
  component-at (s : M.Section v) : Id (N.Section v) (Maps.map component s) (section-map v s) = refl (section-map v s) ;
  opaque component ;
 } ;
 natural (v w : Z.lattice.L) (le : O.Le v w) (s : M.Section w) :
  Id (N.Section v) (section-map v (M.restrict v w le s)) (N.restrict v w le (section-map w s)) =
  N.section-ext v _ _ (\ g k -> trans (section-map-at v (M.restrict v w le s) g k)
   (trans (ap Local[g].at (M.restrict-at v w le s g k))
    (trans (sym (section-map-at w s g (O.le-trans (Z.D g) v w k le))) (sym (N.restrict-at v w le (section-map w s) g k))))) ;
 module Modules = SerreModuleSheaf[l].On[Z.lattice,Source.AM.G.SH.structure] ;
 module Transform = Modules.Transform[M.presheaf,N.presheaf] ;
 morphism : Transform.Hom = new Transform.Hom[\ v -> At[v].component,
  \ v w le s -> trans (At[v].component-at (Modules.Of[M.presheaf].restrict v w le s))
   (trans (ap (section-map v) (M.restriction-map v w le s))
    (trans (natural v w le s)
     (trans (sym (N.restriction-map v w le (section-map w s)))
      (ap (Modules.Of[N.presheaf].restrict v w le) (sym (At[w].component-at s))))))] ;
 morphism-at (v : Z.lattice.L) (s : M.Section v) : Id (N.Section v) (Transform.at morphism v s) (section-map v s) = At[v].component-at s ;
 opaque morphism ;
} ;
