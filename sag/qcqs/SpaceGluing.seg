-- Finite-cover descent of geometric maps, with geometric equalities.
-- Given maps X|e_i -> Y agreeing on X|(e_i /\ e_j), OpenAgreement
-- supplies the component equations of MapGluing.  Its local gluing is
-- a map X->Y with the prescribed restrictions.  MapSeparation proves
-- uniqueness.  Local maps are a set, so the matching laws are propositions;
-- Sigma extensionality makes the type of amalgams contractible.
-- Neither source affineness nor a nonempty cover is required.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module DL = DistLattice[l] ;
module Sp = Spaces[l] ;
module Op = OpenMaps[l] ;
module Over (X Y : Sp.Space) (n : Nat) (es : Fin n -> X.lattice.L)
 (covers : DL.Order[X.lattice].Le X.lattice.top (DL.Joins[X.lattice].bigJ n es)) {
 module O = DL.Order[X.lattice] ;
 restrict (p : Sp.Hom X Y) (i : Fin n) : Sp.Hom (Op.space X (es i)) Y =
  Sp.compose (Op.space X (es i)) X Y p (Op.inclusion X (es i)) ;
 module Intersection (i j : Fin n) {
  module Left = Op.Below[X,X.lattice.meet (es i) (es j),es i,O.meet-left (es i) (es j)] ;
  module Right = Op.Below[X,X.lattice.meet (es i) (es j),es j,O.meet-right (es i) (es j)] ;
 } ;
 module Family (ps : (i : Fin n) -> Sp.Hom (Op.space X (es i)) Y) {
  Compatible : U l = (i j : Fin n) -> Id (Sp.Hom (Op.space X (X.lattice.meet (es i) (es j))) Y)
   (Sp.compose (Op.space X (X.lattice.meet (es i) (es j))) (Op.space X (es i)) Y (ps i) Intersection[i,j].Left.embedding)
   (Sp.compose (Op.space X (X.lattice.meet (es i) (es j))) (Op.space X (es j)) Y (ps j) Intersection[i,j].Right.embedding) ;
  Matches (p : Sp.Hom X Y) : U l = (i : Fin n) -> Id (Sp.Hom (Op.space X (es i)) Y) (restrict p i) (ps i) ;
  matches-prop (p : Sp.Hom X Y) : Pr.isProp (Matches p) =
   FE.isProp-Pi (Fin n) (\ i -> Id (Sp.Hom (Op.space X (es i)) Y) (restrict p i) (ps i))
    (\ i -> Sp.set (Op.space X (es i)) Y (restrict p i) (ps i)) ;
  Amalgam : U l = (p : Sp.Hom X Y) * Matches p ;
  module Glue (compatible : Compatible) {
   module Pair (i j : Fin n) {
    module A = OpenAgreement[l].Over[X,Y,es i,es j,ps i,ps j].Equal[compatible i j] ;
   } ;
   module M = MapGluing[l].Over[Y.lattice,X.lattice,Y.structure.sheaf,X.structure,n,es,covers] ;
   module G = M.Family[\ i -> Sp.underlying (ps i)].Compatible[
    \ i j u -> Pair[i,j].A.overlap u,\ u s i j -> Pair[i,j].A.At[u].agree s] ;
   morphism : Sp.Hom X Y = (G.morphism,G.Local[Y.structure.inv,\ i -> Sp.is-local (ps i)].local) ;
   matches : Matches morphism = \ i -> Sp.ext (Op.space X (es i)) Y (restrict morphism i) (ps i) G.Restricts[i].restricts ;
   module S = MapSeparation[l].Maps[Y.lattice,X.lattice,Y.structure.sheaf,X.structure] ;
   unique (p : Sp.Hom X Y) (on : Matches p) : Id (Sp.Hom X Y) morphism p =
    Sp.ext X Y morphism p (S.Cover[n,es,covers].separated (Sp.underlying morphism) (Sp.underlying p)
     (\ i -> ap (Sp.underlying {Op.space X (es i)} {Y}) (trans (matches i) (sym (on i))))) ;
   centre : Amalgam = (morphism,matches) ;
   contract (a : Amalgam) : Id Amalgam centre a = Pr.Sigma-eq (Sp.Hom X Y) Matches morphism a.1 matches a.2 (unique a.1 a.2) (matches-prop a.1) ;
   gluing : Localisation[l].isContr Amalgam = (centre,contract) ;
  } ;
 } ;
} ;
