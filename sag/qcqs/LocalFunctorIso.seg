-- Compatible chart isomorphisms of sheaves glue to an isomorphism.
-- Let U_i cover F and V_i cover H, both Zariski sheaves, and let
-- E_i:|U_i|=|V_i| be natural equivalences.  Assume their composites into
-- H agree on the U-overlaps, and their inverses into F agree on the
-- V-overlaps.  CompactCoverDescent glues these maps to a:F->H, b:H->F.
-- On U_i, a is inclusion E_i and b is inclusion E_i^-1, so ba is the
-- identity there; similarly ab is the identity on V_i.  CompactCover-
-- Separation proves the two identities globally.  Evaluating those
-- identities yields pointwise inverse laws and a natural equivalence.
-- This is the final local-to-global step used to identify a reconstructed
-- geometric functor with its original functorial affine atlas.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Hi = Prelude[l+] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module TE = TestEquivalences[l] ;
module CO = CompactOpens[l] ;
module TS = TestSheaves[l] ;
module Over (F H : SF.SetFunctor) (sheafF : TS.IsSheaf F) (sheafH : TS.IsSheaf H)
 (n : Nat) (us : Fin n -> CO.Over[F].Open) (vs : Fin n -> CO.Over[H].Open)
 (coversF : (B : T.Test) (x : F.obj B) -> Id T.At[B].Z.lattice.L
  (T.At[B].Z.J.bigJ n (\ i -> CO.Over[F].value (us i) B x)) T.At[B].Z.lattice.top)
 (coversH : (B : T.Test) (y : H.obj B) -> Id T.At[B].Z.lattice.L
  (T.At[B].Z.J.bigJ n (\ i -> CO.Over[H].value (vs i) B y)) T.At[B].Z.lattice.top) {
 module Forward = CompactCoverDescent[l].Over[F,H,sheafH,n,us,coversF] ;
 module Backward = CompactCoverDescent[l].Over[H,F,sheafF,n,vs,coversH] ;
 module Piece (i : Fin n) {
  module UO = Forward.Piece[i].R ;
  module VO = Backward.Piece[i].R ;
 } ;
 module Given (es : (i : Fin n) -> TE.NaturalEquivalence Piece[i].UO.functor Piece[i].VO.functor) {
  module Part (i : Fin n) {
   module E = TE.Inverse[Piece[i].UO.functor,Piece[i].VO.functor,es i] ;
   forward : Forward.Piece[i].N.Nat = SF.Composite[Piece[i].UO.functor,Piece[i].VO.functor,H,Piece[i].VO.inclusion,TE.forward (es i)].composite ;
   backward : Backward.Piece[i].N.Nat = SF.Composite[Piece[i].VO.functor,Piece[i].UO.functor,F,Piece[i].UO.inclusion,E.inverse].composite ;
  } ;
  module FF = Forward.Family[\ i -> Part[i].forward] ;
  module BB = Backward.Family[\ i -> Part[i].backward] ;
  module Compatible (forward-compatible : FF.Compatible) (backward-compatible : BB.Compatible) {
   module FG = FF.Glue[forward-compatible] ;
   module BG = BB.Glue[backward-compatible] ;
   module FN = SF.Transform[F,H] ;
   module BN = SF.Transform[H,F] ;
   module FEnd = SF.Transform[F,F] ;
   module HEnd = SF.Transform[H,H] ;
   module FThen = SF.Composite[F,H,F,BG.extension,FG.extension] ;
   module HThen = SF.Composite[H,F,H,FG.extension,BG.extension] ;
   module OnF (B : T.Test) (x : F.obj B) (i : Fin n) (m : Piece[i].UO.Member B x) {
    p : Piece[i].VO.obj B = SF.Transform[Piece[i].UO.functor,Piece[i].VO.functor].at (TE.forward (es i)) B (x,m) ;
    equation : Id (F.obj B) (FEnd.at FThen.composite B x) x =
     trans (ap (BN.at BG.extension B) (FG.LocalEquation[B,x,i,m].equation))
      (trans (BG.LocalEquation[B,Piece[i].VO.point {B} p,i,Piece[i].VO.member {B} p].equation)
       (ap (Piece[i].UO.point {B}) (Part[i].E.left-at B (x,m)))) ;
   } ;
   module OnH (B : T.Test) (y : H.obj B) (i : Fin n) (m : Piece[i].VO.Member B y) {
    p : Piece[i].UO.obj B = SF.Transform[Piece[i].VO.functor,Piece[i].UO.functor].at Part[i].E.inverse B (y,m) ;
    equation : Id (H.obj B) (HEnd.at HThen.composite B y) y =
     trans (ap (FN.at FG.extension B) (BG.LocalEquation[B,y,i,m].equation))
      (trans (FG.LocalEquation[B,Piece[i].UO.point {B} p,i,Piece[i].UO.member {B} p].equation)
       (ap (Piece[i].VO.point {B}) (Part[i].E.right-at B (y,m)))) ;
   } ;
   inverse-forward : Id FEnd.Nat FThen.composite (SF.identity F) =
    CompactCoverSeparation[l].Over[F,F,sheafF,n,us,coversF].Compare[FThen.composite,SF.identity F,\ i ->
     SF.Transform[Piece[i].UO.functor,F].ext
      SF.Composite[Piece[i].UO.functor,F,F,FThen.composite,Piece[i].UO.inclusion].composite
      SF.Composite[Piece[i].UO.functor,F,F,SF.identity F,Piece[i].UO.inclusion].composite
      (\ B p -> OnF[B,Piece[i].UO.point {B} p,i,Piece[i].UO.member {B} p].equation)].equal ;
   forward-inverse : Id HEnd.Nat HThen.composite (SF.identity H) =
    CompactCoverSeparation[l].Over[H,H,sheafH,n,vs,coversH].Compare[HThen.composite,SF.identity H,\ i ->
     SF.Transform[Piece[i].VO.functor,H].ext
      SF.Composite[Piece[i].VO.functor,H,H,HThen.composite,Piece[i].VO.inclusion].composite
      SF.Composite[Piece[i].VO.functor,H,H,SF.identity H,Piece[i].VO.inclusion].composite
      (\ B p -> OnH[B,Piece[i].VO.point {B} p,i,Piece[i].VO.member {B} p].equation)].equal ;
   equivalence : TE.NaturalEquivalence F H = (FG.extension,\ B -> Pr.qinv (F.obj B) (H.obj B) (FN.at FG.extension B) (BN.at BG.extension B)
    (\ y -> Hi.ap HEnd.Nat (H.obj B) (\ a -> HEnd.at a B y) HThen.composite (SF.identity H) forward-inverse)
    (\ x -> Hi.ap FEnd.Nat (F.obj B) (\ a -> FEnd.at a B x) FThen.composite (SF.identity F) inverse-forward)) ;
  } ;
 } ;
} ;
