-- The identification of equivalent univalent categories acts on arrows
-- as the functor (objects and arrows in U l).
-- An arrow with its ends is a point of Arr X = (x y : X.ob) * X.hom x y.
-- Let (F, G, u, v) : C ~ D and p = FibreCategorySIPTheorem.On[C,D,e]
-- .equality.  Transport of Arr along p (arrC p) sends (x, y, f) to
-- (F x, F y, F f).  As for objects (FibreCategorySIPObjects), transport
-- along a composite is the composite of the transports (arr-trans,
-- arrC-trans), and the pieces are:
-- (1) record eta (pre-eta, category-eta): split, then refl;
-- (2) ap (to-pre O) of a path r of structures on O: (x, y, f) goes to
--     (x, y, r_* f), r_* f the transport in the hom family (arr-const, J).
--     For r = structure-equality = FibreCategorySIPFixed.equal, built by
--     eqind on the fibrewise equivalence F.map, r_* f = F f:
--     the statement "r_* f = e f" (Good) holds at the base case, where r
--     is fixed-hom-equal: a record eta (split) and ap of a map keeping the
--     hom family (J); it is preserved by the J part of eqind (J on the
--     path of families) and by its subst along idto (path e) = e (J);
-- (3) the Sigma path of pre-path-to-category: J on both components;
-- (4) the reindexing equality, built by eqind on F.obj: (x, y, g) goes to
--     (F x, F y, g): base case by split on the structure, then J on
--     ua e and J on idtoeqv (ua e) = e as in (2).  (No ua-beta: the
--     statement is about e.1, carried along the subst.)
-- This is a direct computation through the SAME path as SerreQCohEquivalence
-- .equality, not an induction principle for equivalences.
level l ; open Base ;
module K = Category[l,l] ;
module P = Prelude[l] ;
module R = Prelude[l+] ;
module S = FibreCategorySIP[l] ;
module CE = FibreCategoryEquivalence[l] ;
module Reindex = FibreCategorySIPReindex[l] ;
module Fixed = FibreCategorySIPFixed[l] ;
module UA = Axioms[l].UnivalenceLemmas[univ @l] ;

-- arrows with their ends, and their transport along paths of precategories
Arr (X : K.Precategory) : U l = (x : X.ob) * (y : X.ob) * X.hom x y ;
arr-along (X Y : K.Precategory) (r : Id K.Precategory X Y) (a : Arr X) : Arr Y =
 R.subst K.Precategory (\ Z -> Arr Z) X Y r a ;
arr-trans (X Y Z : K.Precategory) (r : Id K.Precategory X Y) (t : Id K.Precategory Y Z) (a : Arr X) :
 Id (Arr Z) (arr-along X Z (R.trans K.Precategory X Y Z r t) a) (arr-along Y Z t (arr-along X Y r a)) =
 idJ K.Precategory Y (\ W t' -> Id (Arr W) (arr-along X W (R.trans K.Precategory X Y W r t') a) (arr-along Y W t' (arr-along X Y r a)))
  (refl (arr-along X Y r a)) Z t ;
arr-eta : (X : K.Precategory) (a : Arr X) ->
 Id (Arr X) (arr-along (S.to-pre X.ob (S.from-pre X)) X (S.pre-eta X) a) a =
 split { Precategory O h hs i c ul ur a -> \ w -> refl w } ;
arr-eta-sym : (X : K.Precategory) (a : Arr X) ->
 Id (Arr X) (arr-along X (S.to-pre X.ob (S.from-pre X)) (R.sym K.Precategory (S.to-pre X.ob (S.from-pre X)) X (S.pre-eta X)) a) a =
 split { Precategory O h hs i c ul ur a -> \ w -> refl w } ;

-- (2) paths of structures on fixed objects: arrows move in the hom family
hom-along (O : U l) (s t : S.Structure[O]) (r : Id (S.Structure[O]) s t) (x y : O) (f : s.hom x y) : t.hom x y =
 R.subst (S.Structure[O]) (\ w -> w.hom x y) s t r f ;
hom-trans (O : U l) (s t w : S.Structure[O]) (r : Id (S.Structure[O]) s t) (q : Id (S.Structure[O]) t w) (x y : O) (f : s.hom x y) :
 Id (w.hom x y) (hom-along O s w (R.trans (S.Structure[O]) s t w r q) x y f) (hom-along O t w q x y (hom-along O s t r x y f)) =
 idJ (S.Structure[O]) t (\ w' q' -> Id (w'.hom x y) (hom-along O s w' (R.trans (S.Structure[O]) s t w' r q') x y f) (hom-along O t w' q' x y (hom-along O s t r x y f)))
  (refl (hom-along O s t r x y f)) w q ;
arr-const (O : U l) (s t : S.Structure[O]) (r : Id (S.Structure[O]) s t) (x y : O) (f : s.hom x y) :
 Id (Arr (S.to-pre O t)) (arr-along (S.to-pre O s) (S.to-pre O t) (R.ap (S.Structure[O]) K.Precategory (S.to-pre O) s t r) (x,(y,f)))
  (x,(y,hom-along O s t r x y f)) =
 idJ (S.Structure[O]) s (\ t' r' -> Id (Arr (S.to-pre O t')) (arr-along (S.to-pre O s) (S.to-pre O t') (R.ap (S.Structure[O]) K.Precategory (S.to-pre O) s t' r') (x,(y,f)))
   (x,(y,hom-along O s t' r' x y f)))
  (refl (x,(y,f))) t r ;
hom-raw-eta-sym (O : U l) : (s : S.Structure[O]) (x y : O) (f : s.hom x y) ->
 Id (s.hom x y) (hom-along O s (S.structure-from O (S.structure-raw O s))
  (R.sym (S.Structure[O]) (S.structure-from O (S.structure-raw O s)) s (S.structure-raw-eta O s)) x y f) f =
 split { Structure h hs i c ul ur a -> \ x y f -> refl f } ;
-- a path of operations keeps the hom family
hom-ops (O : U l) (h : O -> O -> U l) (o o' : S.Operations[O,h]) (w : Id (S.Operations[O,h]) o o') (x y : O) (f : h x y) :
 Id (h x y) (hom-along O (S.structure-from O (h,o)) (S.structure-from O (h,o'))
  (R.ap (S.Operations[O,h]) (S.Structure[O]) (\ v -> S.structure-from O (h,v)) o o' w) x y f) f =
 idJ (S.Operations[O,h]) o (\ v w' -> Id (h x y) (hom-along O (S.structure-from O (h,o)) (S.structure-from O (h,v))
   (R.ap (S.Operations[O,h]) (S.Structure[O]) (\ v' -> S.structure-from O (h,v')) o v w') x y f) f)
  (refl f) o' w ;

module FixedArrows (O : U l) (s : S.Structure[O]) {
 module FO = Fixed.On[O,s] ;
 target (v : FO.F.Family) (t : FO.Ops v) : S.Structure[O] = S.structure-from O (FO.Curried v,t) ;
 -- the path m t il cl moves f to e f
 Good (v : FO.F.Family) (e : FO.F.FiberEquiv v) (m : FO.Motive v e) : U l+ =
  (t : FO.Ops v) (il : FO.IdLaw v e t) (cl : FO.CompLaw v e t) (x y : O) (f : s.hom x y) ->
   Id (v (x,y)) (hom-along O s (target v t) (m t il cl) x y f) ((e (x,y)).1 f) ;
 -- base case: fixed-hom-equal is a record eta followed by ap of a path of operations
 module BaseArrows (t : FO.Ops FO.source) (il : FO.IdLaw FO.source (\ i -> P.idEquiv (FO.source i)) t)
  (cl : FO.CompLaw FO.source (\ i -> P.idEquiv (FO.source i)) t) (x y : O) (f : s.hom x y) {
  module B = FO.BaseCase[t,il,cl] ;
  raw : S.Structure[O] = S.structure-from O (S.structure-raw O s) ;
  eta-path : Id (S.Structure[O]) s raw = R.sym (S.Structure[O]) raw s (S.structure-raw-eta O s) ;
  ops-path : Id (S.Structure[O]) raw (target FO.source t) =
   R.ap (S.Operations[O,s.hom]) (S.Structure[O]) (\ o -> S.structure-from O (s.hom,o)) (S.structure-raw O s).2 t
    (S.Fixed[O,s.hom].equal (S.structure-raw O s).2 t B.identity-eq B.composition-eq) ;
  result : Id (s.hom x y) (hom-along O s (target FO.source t) B.result x y f) f =
   P.trans (s.hom x y) (hom-along O s (target FO.source t) B.result x y f)
    (hom-along O raw (target FO.source t) ops-path x y (hom-along O s raw eta-path x y f)) f
    (hom-trans O s raw (target FO.source t) eta-path ops-path x y f)
    (P.trans (s.hom x y) (hom-along O raw (target FO.source t) ops-path x y (hom-along O s raw eta-path x y f))
     (hom-along O raw (target FO.source t) ops-path x y f) f
     (P.ap (s.hom x y) (s.hom x y) (hom-along O raw (target FO.source t) ops-path x y) (hom-along O s raw eta-path x y f) f
      (hom-raw-eta-sym O s x y f))
     (hom-ops O s.hom (S.structure-raw O s).2 t
      (S.Fixed[O,s.hom].equal (S.structure-raw O s).2 t B.identity-eq B.composition-eq) x y f)) ;
 } ;
 base-good : Good FO.source (\ i -> P.idEquiv (FO.source i)) FO.base =
  \ t il cl x y f -> BaseArrows[t,il,cl,x,y,f].result ;
 -- the J part of eqind
 J-good (G : FO.F.Family) (p : Id FO.F.Family FO.source G) :
  Good G (FO.F.idto G p) (idJ FO.F.Family FO.source (\ X q -> FO.Motive X (FO.F.idto X q)) FO.base G p) =
  idJ FO.F.Family FO.source (\ X q -> Good X (FO.F.idto X q) (idJ FO.F.Family FO.source (\ X' q' -> FO.Motive X' (FO.F.idto X' q')) FO.base X q))
   base-good G p ;
 -- the subst part of eqind
 subst-good (G : FO.F.Family) (e0 e1 : FO.F.FiberEquiv G) (w : Id (FO.F.FiberEquiv G) e0 e1) (m : FO.Motive G e0) (g : Good G e0 m) :
  Good G e1 (R.subst (FO.F.FiberEquiv G) (FO.Motive G) e0 e1 w m) =
  idJ (FO.F.FiberEquiv G) e0 (\ e' w' -> Good G e' (R.subst (FO.F.FiberEquiv G) (FO.Motive G) e0 e' w' m)) g e1 w ;
 equal-good (v : FO.F.Family) (e : FO.F.FiberEquiv v) : Good v e (FO.F.eqind FO.Motive FO.base v e) =
  subst-good v (FO.F.idto v (FO.F.path v e)) e (FO.F.beta v e)
   (idJ FO.F.Family FO.source (\ X q -> FO.Motive X (FO.F.idto X q)) FO.base v (FO.F.path v e))
   (J-good v (FO.F.path v e)) ;
} ;

-- (4) the reindexing equality: (x, y, g) goes to (e x, e y, g)
module ReindexArrows (A : U l) {
 module RI = Reindex.Reindex[A] ;
 Good (B : U l) (e : P.Equiv A B) (m : RI.Motive B e) : U l+ =
  (s : S.Structure[B]) (x y : A) (g : s.hom (e.1 x) (e.1 y)) ->
   Id (Arr (S.to-pre B s)) (arr-along (S.to-pre A (Reindex.pullback A B e.1 s)) (S.to-pre B s) (m s) (x,(y,g))) (e.1 x,(e.1 y,g)) ;
 base-arr : (s : S.Structure[A]) (x y : A) (g : s.hom x y) ->
  Id (Arr (S.to-pre A s)) (arr-along (S.to-pre A (Reindex.pullback A A (P.idEquiv A).1 s)) (S.to-pre A s) (RI.base s) (x,(y,g))) (x,(y,g)) =
  split { Structure h hs i c ul ur a -> \ x y g -> refl (x,(y,g)) } ;
 J-part (B : U l) (p : Id (U l) A B) : RI.Motive B (Axioms[l].idtoeqv A B p) =
  idJ (U l) A (\ X q -> RI.Motive X (Axioms[l].idtoeqv A X q)) RI.base B p ;
 J-good (B : U l) (p : Id (U l) A B) : Good B (Axioms[l].idtoeqv A B p) (J-part B p) =
  idJ (U l) A (\ X q -> Good X (Axioms[l].idtoeqv A X q) (J-part X q)) base-arr B p ;
 subst-good (B : U l) (e0 e1 : P.Equiv A B) (w : Id (P.Equiv A B) e0 e1) (m : RI.Motive B e0) (g : Good B e0 m) :
  Good B e1 (R.subst (P.Equiv A B) (RI.Motive B) e0 e1 w m) =
  idJ (P.Equiv A B) e0 (\ e' w' -> Good B e' (R.subst (P.Equiv A B) (RI.Motive B) e0 e' w' m)) g e1 w ;
 equality-good (B : U l) (e : P.Equiv A B) : Good B e (RI.equality B e) =
  subst-good B (Axioms[l].idtoeqv A B (UA.ua A B e)) e ((univ @l A B).sec-eq e) (J-part B (UA.ua A B e)) (J-good B (UA.ua A B e)) ;
} ;

-- transport of arrows along a path of categories
arrC (C D : K.Category) (p : Id K.Category C D) (a : Arr C.pre) : Arr D.pre =
 R.subst K.Category (\ X -> Arr X.pre) C D p a ;
arrC-trans (C D E : K.Category) (p : Id K.Category C D) (q : Id K.Category D E) (a : Arr C.pre) :
 Id (Arr E.pre) (arrC C E (R.trans K.Category C D E p q) a) (arrC D E q (arrC C D p a)) =
 idJ K.Category D (\ W q' -> Id (Arr W.pre) (arrC C W (R.trans K.Category C D W p q') a) (arrC D W q' (arrC C D p a)))
  (refl (arrC C D p a)) E q ;
arrC-eta : (C : K.Category) (a : Arr C.pre) ->
 Id (Arr C.pre) (arrC (S.category-from (S.category-raw C)) C (S.category-eta C) a) a =
 split { Category X u -> \ a -> refl a } ;
arrC-eta-sym : (C : K.Category) (a : Arr C.pre) ->
 Id (Arr C.pre) (arrC C (S.category-from (S.category-raw C)) (R.sym K.Category (S.category-from (S.category-raw C)) C (S.category-eta C)) a) a =
 split { Category X u -> \ a -> refl a } ;
-- (3) the Sigma path: J on the second component, then on the first
module Sigma (X : K.Precategory) (u : S.UnivalentHigh X) (a : Arr X) {
 Pair (Y : K.Precategory) (u' : S.UnivalentHigh Y) : S.CategoryRaw = (Y,u') ;
 Lift (Y : K.Precategory) (u' : S.UnivalentHigh Y) (w : Id S.CategoryRaw (Pair X u) (Pair Y u')) : Id K.Category (S.category-from (Pair X u)) (S.category-from (Pair Y u')) =
  R.ap S.CategoryRaw K.Category S.category-from (Pair X u) (Pair Y u') w ;
 inner (u' : S.UnivalentHigh X) (w : Id (S.UnivalentHigh X) u u') :
  Id (Arr X) (arrC (S.category-from (Pair X u)) (S.category-from (Pair X u')) (Lift X u' (R.ap (S.UnivalentHigh X) S.CategoryRaw (\ v -> Pair X v) u u' w)) a) a =
  idJ (S.UnivalentHigh X) u (\ v w' -> Id (Arr X) (arrC (S.category-from (Pair X u)) (S.category-from (Pair X v)) (Lift X v (R.ap (S.UnivalentHigh X) S.CategoryRaw (\ v' -> Pair X v') u v w')) a) a)
   (refl a) u' w ;
 sigma-arr (Y : K.Precategory) (r : Id K.Precategory X Y) (pB : R.isProp (S.UnivalentHigh Y)) (u' : S.UnivalentHigh Y) :
  Id (Arr Y) (arrC (S.category-from (Pair X u)) (S.category-from (Pair Y u')) (Lift Y u' (R.Sigma-eq K.Precategory S.UnivalentHigh X Y u u' r pB)) a) (arr-along X Y r a) =
  idJ K.Precategory X (\ Z r' -> (pB' : R.isProp (S.UnivalentHigh Z)) (u'' : S.UnivalentHigh Z) ->
    Id (Arr Z) (arrC (S.category-from (Pair X u)) (S.category-from (Pair Z u'')) (Lift Z u'' (R.Sigma-eq K.Precategory S.UnivalentHigh X Z u u'' r' pB')) a) (arr-along X Z r' a))
   (\ pB' u'' -> inner u'' (pB' u u'')) Y r pB u' ;
} ;
-- pre-path-to-category acts on arrows as its path of precategories
module PrePath (C D : K.Category) (q : Id K.Precategory C.pre D.pre) {
 c0 : K.Category = S.category-from (S.category-raw C) ;
 d0 : K.Category = S.category-from (S.category-raw D) ;
 middle : Id K.Category c0 d0 =
  R.ap S.CategoryRaw K.Category S.category-from (S.category-raw C) (S.category-raw D)
   (R.Sigma-eq K.Precategory S.UnivalentHigh C.pre D.pre C.univalent D.univalent q (S.Proofs[D].univalence-prop)) ;
 tail : Id K.Category c0 D = R.trans K.Category c0 d0 D middle (S.category-eta D) ;
 back : Id K.Category C c0 = R.sym K.Category c0 C (S.category-eta C) ;
 arrows (a : Arr C.pre) : Id (Arr D.pre) (arrC C D (S.pre-path-to-category C D q) a) (arr-along C.pre D.pre q a) =
  P.trans (Arr D.pre) (arrC C D (S.pre-path-to-category C D q) a) (arrC c0 D tail (arrC C c0 back a))
   (arr-along C.pre D.pre q a)
   (arrC-trans C c0 D back tail a)
   (P.trans (Arr D.pre) (arrC c0 D tail (arrC C c0 back a)) (arrC c0 D tail a) (arr-along C.pre D.pre q a)
    (P.ap (Arr C.pre) (Arr D.pre) (arrC c0 D tail) (arrC C c0 back a) a (arrC-eta-sym C a))
    (P.trans (Arr D.pre) (arrC c0 D tail a) (arrC d0 D (S.category-eta D) (arrC c0 d0 middle a)) (arr-along C.pre D.pre q a)
     (arrC-trans c0 d0 D middle (S.category-eta D) a)
     (P.trans (Arr D.pre) (arrC d0 D (S.category-eta D) (arrC c0 d0 middle a)) (arrC c0 d0 middle a) (arr-along C.pre D.pre q a)
      (arrC-eta D (arrC c0 d0 middle a))
      (Sigma[C.pre,C.univalent,a].sigma-arr D.pre q (S.Proofs[D].univalence-prop) D.univalent)))) ;
} ;

-- the theorem: transport of arrows along the identification is F.map
module On (C D : K.Category) (e : CE.Equivalence[C,D]) {
 module T = FibreCategorySIPTheorem[l].On[C,D,e] ;
 F (x : C.pre.ob) : D.pre.ob = e.forward.obj x ;
 image (x y : C.pre.ob) (f : C.pre.hom x y) : Arr D.pre = (F x,(F y,e.forward.map x y f)) ;
 Src : K.Precategory = S.to-pre T.O T.source ;
 Mid : K.Precategory = S.to-pre T.O T.pulled ;
 Pulled : K.Precategory = S.to-pre D.pre.ob T.target ;
 source-path : Id K.Precategory C.pre Src = R.sym K.Precategory Src C.pre (S.pre-eta C.pre) ;
 structure-path : Id K.Precategory Src Mid = R.ap (S.Structure[T.O]) K.Precategory (S.to-pre T.O) T.source T.pulled T.structure-equality ;
 -- the structure-equality moves f to F f
 structure-hom (x y : C.pre.ob) (f : C.pre.hom x y) :
  Id (D.pre.hom (F x) (F y)) (hom-along T.O T.source T.pulled T.structure-equality x y f) (e.forward.map x y f) =
  FixedArrows[T.O,T.source].equal-good T.hom-family T.hom-equivalence T.ops T.identity-law T.composition-law x y f ;
 first-arr (x y : C.pre.ob) (f : C.pre.hom x y) :
  Id (Arr Mid) (arr-along C.pre Mid T.first (x,(y,f))) (x,(y,e.forward.map x y f)) =
  P.trans (Arr Mid) (arr-along C.pre Mid T.first (x,(y,f))) (arr-along Src Mid structure-path (arr-along C.pre Src source-path (x,(y,f))))
   (x,(y,e.forward.map x y f))
   (arr-trans C.pre Src Mid source-path structure-path (x,(y,f)))
   (P.trans (Arr Mid) (arr-along Src Mid structure-path (arr-along C.pre Src source-path (x,(y,f)))) (arr-along Src Mid structure-path (x,(y,f)))
    (x,(y,e.forward.map x y f))
    (P.ap (Arr C.pre) (Arr Mid) (arr-along Src Mid structure-path) (arr-along C.pre Src source-path (x,(y,f))) (x,(y,f)) (arr-eta-sym C.pre (x,(y,f))))
    (P.trans (Arr Mid) (arr-along Src Mid structure-path (x,(y,f))) (x,(y,hom-along T.O T.source T.pulled T.structure-equality x y f))
     (x,(y,e.forward.map x y f))
     (arr-const T.O T.source T.pulled T.structure-equality x y f)
     (P.ap (D.pre.hom (F x) (F y)) (Arr Mid) (\ g -> (x,(y,g))) (hom-along T.O T.source T.pulled T.structure-equality x y f) (e.forward.map x y f)
      (structure-hom x y f)))) ;
 second-arr (x y : C.pre.ob) (g : D.pre.hom (F x) (F y)) : Id (Arr Pulled) (arr-along Mid Pulled T.second (x,(y,g))) (F x,(F y,g)) =
  ReindexArrows[T.O].equality-good D.pre.ob T.E.object-equivalence T.target x y g ;
 rest : Id K.Precategory Mid D.pre = R.trans K.Precategory Mid Pulled D.pre T.second (S.pre-eta D.pre) ;
 rest-arr (x y : C.pre.ob) (g : D.pre.hom (F x) (F y)) : Id (Arr D.pre) (arr-along Mid D.pre rest (x,(y,g))) (F x,(F y,g)) =
  P.trans (Arr D.pre) (arr-along Mid D.pre rest (x,(y,g))) (arr-along Pulled D.pre (S.pre-eta D.pre) (arr-along Mid Pulled T.second (x,(y,g)))) (F x,(F y,g))
   (arr-trans Mid Pulled D.pre T.second (S.pre-eta D.pre) (x,(y,g)))
   (P.trans (Arr D.pre) (arr-along Pulled D.pre (S.pre-eta D.pre) (arr-along Mid Pulled T.second (x,(y,g)))) (arr-along Mid Pulled T.second (x,(y,g))) (F x,(F y,g))
    (arr-eta D.pre (arr-along Mid Pulled T.second (x,(y,g)))) (second-arr x y g)) ;
 precategory-arr (x y : C.pre.ob) (f : C.pre.hom x y) : Id (Arr D.pre) (arr-along C.pre D.pre T.precategory-equality (x,(y,f))) (image x y f) =
  P.trans (Arr D.pre) (arr-along C.pre D.pre T.precategory-equality (x,(y,f))) (arr-along Mid D.pre rest (arr-along C.pre Mid T.first (x,(y,f)))) (image x y f)
   (arr-trans C.pre Mid D.pre T.first rest (x,(y,f)))
   (P.trans (Arr D.pre) (arr-along Mid D.pre rest (arr-along C.pre Mid T.first (x,(y,f)))) (arr-along Mid D.pre rest (x,(y,e.forward.map x y f))) (image x y f)
    (P.ap (Arr Mid) (Arr D.pre) (arr-along Mid D.pre rest) (arr-along C.pre Mid T.first (x,(y,f))) (x,(y,e.forward.map x y f)) (first-arr x y f))
    (rest-arr x y (e.forward.map x y f))) ;
 -- p_* (x, y, f) = (F x, F y, F f)
 arrows (x y : C.pre.ob) (f : C.pre.hom x y) : Id (Arr D.pre) (arrC C D T.equality (x,(y,f))) (image x y f) =
  P.trans (Arr D.pre) (arrC C D T.equality (x,(y,f))) (arr-along C.pre D.pre T.precategory-equality (x,(y,f))) (image x y f)
   (PrePath[C,D,T.precategory-equality].arrows (x,(y,f))) (precategory-arr x y f) ;
} ;
