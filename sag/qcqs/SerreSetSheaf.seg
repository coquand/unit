-- Finite-cover sheaves of small sets (Serre, Sections 5--6).
-- A presheaf has restriction along lattice inclusions. The inclusion
-- witnesses are propositions, so restriction is independent of them.
-- Sheafhood is unique amalgamation, including the empty cover.
-- Separation follows by comparing two amalgams of the restrictions of
-- one section. These definitions supply the underlying set sheaves of
-- module sheaves and torsors without any synthetic assumptions.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module DL = DistLattice[l] ;
module LC = Localisation[l] ;
module On (L : DL.DLat) {
 module O = DL.Order[L] ;
 module J = DL.Joins[L] ;
 record Presheaf {
  obj : L.L -> U l ;
  set (a : L.L) : Pr.isSet (obj a) ;
  res (a b : L.L) (k : O.Le a b) : obj b -> obj a ;
  res-id (a : L.L) (k : O.Le a a) (x : obj a) : Id (obj a) (res a a k x) x ;
  res-comp (a b c : L.L) (k : O.Le a b) (h : O.Le b c) (t : O.Le a c) (x : obj c) :
   Id (obj a) (res a b k (res b c h x)) (res a c t x) ;
 } ;
 module Of (G : Presheaf) {
  restrict (a b : L.L) (k : O.Le a b) (x : G.obj b) : G.obj a = G.res a b k x ;
  restrict-at (a b : L.L) (k : O.Le a b) (x : G.obj b) :
   Id (G.obj a) (restrict a b k x) (G.res a b k x) = refl (G.res a b k x) ;
  res-irr (a b : L.L) (k h : O.Le a b) (x : G.obj b) :
   Id (G.obj a) (restrict a b k x) (restrict a b h x) =
   ap (\ t -> restrict a b t x) (O.le-prop a b k h) ;
  module Cover (m : L.L) (n : Nat) (ms : Fin n -> L.L)
   (le : (i : Fin n) -> O.Le (ms i) m) (covers : O.Le m (J.bigJ n ms)) {
   Compatible (xs : (i : Fin n) -> G.obj (ms i)) : U l =
    (i j : Fin n) -> Id (G.obj (L.meet (ms i) (ms j)))
     (restrict (L.meet (ms i) (ms j)) (ms i) (O.meet-left (ms i) (ms j)) (xs i))
     (restrict (L.meet (ms i) (ms j)) (ms j) (O.meet-right (ms i) (ms j)) (xs j)) ;
   Matches (xs : (i : Fin n) -> G.obj (ms i)) (x : G.obj m) : U l =
    (i : Fin n) -> Id (G.obj (ms i)) (restrict (ms i) m (le i) x) (xs i) ;
   Amalgam (xs : (i : Fin n) -> G.obj (ms i)) : U l = (x : G.obj m) * Matches xs x ;
   amalgam {xs : (i : Fin n) -> G.obj (ms i)} (u : Amalgam xs) : G.obj m = u.1 ;
   matches {xs : (i : Fin n) -> G.obj (ms i)} (u : Amalgam xs) : Matches xs (amalgam u) = u.2 ;
   restrictions (x : G.obj m) (i : Fin n) : G.obj (ms i) = restrict (ms i) m (le i) x ;
   restrictions-compatible (x : G.obj m) : Compatible (restrictions x) = \ i j ->
    trans (G.res-comp (L.meet (ms i) (ms j)) (ms i) m (O.meet-left (ms i) (ms j)) (le i)
     (O.le-trans (L.meet (ms i) (ms j)) (ms i) m (O.meet-left (ms i) (ms j)) (le i)) x)
     (sym (G.res-comp (L.meet (ms i) (ms j)) (ms j) m (O.meet-right (ms i) (ms j)) (le j)
      (O.le-trans (L.meet (ms i) (ms j)) (ms i) m (O.meet-left (ms i) (ms j)) (le i)) x)) ;
  } ;
  IsSheaf : U l =
   (m : L.L) (n : Nat) (ms : Fin n -> L.L) (le : (i : Fin n) -> O.Le (ms i) m)
   (covers : O.Le m (J.bigJ n ms)) (xs : (i : Fin n) -> G.obj (ms i)) ->
   Cover[m,n,ms,le,covers].Compatible xs -> LC.isContr (Cover[m,n,ms,le,covers].Amalgam xs) ;
 } ;
 module SheafProofs (G : Presheaf) (sheaf : Of[G].IsSheaf) {
  module Cover (m : L.L) (n : Nat) (ms : Fin n -> L.L)
   (le : (i : Fin n) -> O.Le (ms i) m) (covers : O.Le m (J.bigJ n ms)) {
   module C = Of[G].Cover[m,n,ms,le,covers] ;
   glue (xs : (i : Fin n) -> G.obj (ms i)) (compatible : C.Compatible xs) : LC.isContr (C.Amalgam xs) =
    sheaf m n ms le covers xs compatible ;
   separated (x y : G.obj m)
    (e : (i : Fin n) -> Id (G.obj (ms i)) (C.restrictions x i) (C.restrictions y i)) : Id (G.obj m) x y =
    ap (\ u -> C.amalgam u)
     (trans (sym ((glue (C.restrictions x) (C.restrictions-compatible x)).2 (x,\ i -> refl (C.restrictions x i))))
      ((glue (C.restrictions x) (C.restrictions-compatible x)).2 (y,\ i -> sym (e i)))) ;
  } ;
 } ;
} ;
