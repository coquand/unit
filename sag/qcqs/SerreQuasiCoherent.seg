-- Quasi-coherence as a property (Serre note, Section 4).
-- On a compact open w, restrict M to X|w and push it along the canonical
-- map X|w -> Spec O(w). An affine model is a small O(w)-module N and
-- a specified equivalence of this direct-image sheaf with the checked
-- associated sheaf of N. Quasi-coherence merely asserts a finite affine
-- cover with such models; neither the atlas nor the modules are chosen
-- globally. Module structures form a type one universe higher, so the
-- existence is truncated at that level. No resizing is used.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module BigTr = Truncation[l+] ;
module DL = DistLattice[l] ; module SM = SerreModule[l] ;
module MS = SerreModuleSheaf[l] ;
module On (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged)
 (M : MS.On[L,X.sheaf].ModuleSheaf) {
 module Scheme = Qcqs[l].Over[L,X] ;
 module At (w : L.L) {
  module S = Slice[l].Over[L,X,w] ;
  module Restricted = SerreModuleSheafRestriction[l].On[L,X,w,M] ;
  module Canonical = AffineCriterion[l].Over[S.lattice,S.restricted] ;
  module Image = SerreModuleSheafDirectImage[l].Over[Canonical.ZG.lattice,S.lattice,
   Canonical.Can.Sh.structure,S.sheaf,Canonical.canonical,Restricted.restricted] ;
  module Maps = SerreModuleSheafIso[l].On[Canonical.ZG.lattice,Canonical.Can.Sh.structure] ;
  record Model {
   coefficients : SM.Over[S.sheaf.ring S.lattice.top].Module ;
   comparison : Maps.Equivalence Image.presheaf
    SerreAssociatedSheaf[l].Over[S.sheaf.ring S.lattice.top,
     S.sheaf.ring-set S.lattice.top,coefficients].associated.presheaf ;
  } ;
 } ;
 record Atlas {
  cover : Scheme.AffineCover ;
  models : (i : Fin cover.count) -> At[cover.opens i].Model ;
 } ;
 IsQuasiCoherent : U l+ = BigTr.Trunc[Atlas].carrier ;
 is-qc-prop : Prelude[l+].isProp IsQuasiCoherent = BigTr.Trunc[Atlas].proposition ;
 from-atlas (atlas : Atlas) : IsQuasiCoherent = BigTr.Trunc[Atlas].inc atlas ;
 underlying-qcqs (qc : IsQuasiCoherent) : Scheme.IsQcqs =
  BigTr.Trunc[Atlas].induction @l (\ a -> Scheme.IsQcqs)
   (\ a -> Tr.Trunc[Scheme.AffineCover].proposition)
   (\ a -> Tr.Trunc[Scheme.AffineCover].inc a.cover) qc ;
} ;
