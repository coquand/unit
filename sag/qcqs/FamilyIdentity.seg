-- Identity systems pass to indexed families.
-- The total space of pointwise isomorphisms is a retract of the product
-- of the individual contractible total spaces, by exchanging Pi and
-- Sigma.  Weak function extensionality makes that product contractible.
-- Fundamental then gives induction on family isomorphisms.
-- Right induction is path induction with the final endpoint fixed,
-- followed by Fundamental's equation idToIso(sip e)=e.
level l ; open Base ; open Prelude[l] ;
module G = SipGeneric[l] ;
module CL = FunExtUA[l] ;
module FE = FunExtUA[l].FE[univ @l] ;
module Over (A C : U l) (I : C -> C -> U l) (idI : (x : C) -> I x x)
 (tc : (x : C) -> CL.isContr ((y : C) * I x y)) {
 Relation (f g : A -> C) : U l = (a : A) -> I (f a) (g a) ;
 identity (f : A -> C) : Relation f f = \ a -> idI (f a) ;
 Total (f : A -> C) : U l = (g : A -> C) * Relation f g ;
 total-contr (f : A -> C) : CL.isContr (Total f) =
  G.ctr-retract ((a : A) -> (y : C) * I (f a) y) (Total f)
   (FE.wfe A (\ a -> (y : C) * I (f a) y) (\ a -> tc (f a)))
   (\ w a -> (w.1 a,w.2 a)) (\ w -> (\ a -> (w a).1,\ a -> (w a).2)) (\ w -> refl w) ;
 opaque total-contr ;
 module Fd = G.Fundamental[A -> C,Relation,identity,total-contr] ;
} ;
module Right (C : U l) (I : C -> C -> U l) (idI : (x : C) -> I x x)
 (tc : (x : C) -> CL.isContr ((y : C) * I x y)) {
 module Fd = G.Fundamental[C,I,idI,tc] ;
 induction (x : C) (P : (y : C) -> I y x -> U l) (base : P x (idI x)) (y : C) (e : I y x) : P y e =
  subst (I y x) (P y) (Fd.idToIso y x (Fd.sip y x e)) e (Fd.idToIso-sip y x e)
   (Paths[l].idJR C x (\ z p -> P z (Fd.idToIso z x p)) base y (Fd.sip y x e)) ;
 incoming (x : C) : CL.isContr ((y : C) * I y x) =
  ((x,idI x),\ w -> induction x (\ y e -> Id ((z : C) * I z x) (x,idI x) (y,e))
   (refl (x,idI x)) w.1 w.2) ;
} ;
