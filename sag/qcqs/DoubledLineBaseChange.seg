-- Base change of the points of the doubled-origin line (DESIGN.md, Next 4,
-- milestone 1, base change).
--
-- Let h : B -> B2 be a map of k-algebras (h . iota = iota2), and Spec h :
-- Spec B2 -> Spec B (SpecHom), with lattice map Zar(h): D b |-> D(h b)
-- (SpecMap.pi-D, Global.d-global).  For a k-point psi of S over B,
-- psi . Spec h is a k-point over B2, and
--   coordinates(psi . Spec h) = (h t, Zar(h) u0, Zar(h) u1)
-- for coordinates(psi) = (t, u0, u1) (DoubledLinePoints).
-- Local: composites of local maps (Compose).  Over k, and the coordinate:
--  fold . (psi . Spec h) = (fold . psi) . Spec h (Compose.Assoc), whose
--  global component is Gamma(Spec h) . phi (SpecHom.Precompose), and
--  Gamma(Spec h)(b|top) = (h b)|top (SpecHom.global).  So on constants it
--  is (h (iota a))|top = (iota2 a)|top, and at X it is (h t)|top, read in B2
--  as h t.  The charts: (psi . Spec h)*(e) = Zar(h)(psi*(e)) by definition.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) (B : CRing) (setB : Pr.isSet B.R) (iota : RH.Hom k B)
 (B2 : CRing) (setB2 : Pr.isSet B2.R) (iota2 : RH.Hom k B2) (h : RH.Hom B B2)
 (over : (a : k.R) -> Id B2.R (map h (map iota a)) (map iota2 a)) {
 module P1 = DoubledLinePoints[l].Over[k,setk,B,setB,iota] ;
 module P2 = DoubledLinePoints[l].Over[k,setk,B2,setB2,iota2] ;
 module SH = SpecHom[l].Over[B,setB,P1.AB.Loc,P1.AB.set,P1.AB.inclusion,P1.AB.elementary,
  B2,setB2,P2.AB.Loc,P2.AB.set,P2.AB.inclusion,P2.AB.elementary,h] ;
 module Cp = Compose[l].Maps[P1.DU.DD.lattice,P1.ZB.lattice,P2.ZB.lattice,P1.DU.Dbl.doubled.sheaf,P1.AB.spec.sheaf,P2.AB.spec.sheaf] ;

 -- Zar(h), the lattice map of Spec h: D b |-> D (h b)
 zar-D (b : B.R) : Id P2.ZB.lattice.L (DL.hmap SH.morphism.lat (P1.ZB.D b)) (P2.ZB.D (map h b)) =
  trans (SH.Into.Of[SH.phi].SM.pi-D b)
   (trans (ap (P2.LB.d P2.ZB.lattice.top) (SH.phi-map b)) (P2.GB.d-global (map h b))) ;

 -- the point psi . Spec h
 module Pull (p : P1.Points) {
  module C = Cp.Of[SH.morphism,p.1.1] ;
  local : Cp.PQ.Of[C.composite,P1.DU.Dbl.doubled.inv,P2.AB.spec.inv].IsLocal =
   C.Local[P1.DU.Dbl.doubled.inv,P1.AB.spec.inv,P2.AB.spec.inv,p.1.2,SH.local].local ;
  -- fold . (psi . Spec h) = (fold . psi) . Spec h
  module As = Compose[l].Assoc[P1.DLn.Z.lattice,P1.DU.DD.lattice,P1.ZB.lattice,P2.ZB.lattice,
   P1.DLn.line.sheaf,P1.DU.Dbl.doubled.sheaf,P1.AB.spec.sheaf,P2.AB.spec.sheaf,P1.DU.Fd.fold,p.1.1,SH.morphism] ;
  module Pre = SpecHom[l].Precompose[P1.DLn.P.ring,P1.DLn.P.set,P1.AK.Loc,P1.AK.set,P1.AK.inclusion,P1.AK.elementary,
   P1.ZB.lattice,P1.AB.spec,P2.ZB.lattice,P2.AB.spec,SH.morphism,P1.DU.Of[p.1.1].C.composite] ;
  -- its global component is Gamma(Spec h) . phi
  component (a : P1.DLn.P.ring.R) :
   Id (P2.AB.spec.sheaf.ring P2.ZB.lattice.top).R (map (P2.SU.component (P2.DU.Of[C.composite].C.composite)) a)
    (map Pre.gamma (map (P1.SU.component (P1.DU.Of[p.1.1].C.composite)) a)) =
   trans (ap (\ g -> map (P2.SU.component g) a) (sym As.assoc)) (Pre.component a) ;
  -- Gamma(Spec h)(b|top) = (h b)|top
  gamma-global (b : B.R) :
   Id (P2.AB.spec.sheaf.ring P2.ZB.lattice.top).R (map Pre.gamma (map P1.GB.global b)) (map P2.GB.global (map h b)) =
   SH.global b ;
  over-k : P2.OverK (P2.DU.Of[C.composite].C.composite) =
   P2.HK.ext (P2.UP.restrict (P2.SU.component (P2.DU.Of[C.composite].C.composite))) P2.iota-top (\ a ->
    calc (P2.AB.spec.sheaf.ring P2.ZB.lattice.top).R {
     map (P2.SU.component (P2.DU.Of[C.composite].C.composite)) (P1.DLn.P.constant a)
      =< component (P1.DLn.P.constant a)
      > map Pre.gamma (map (P1.SU.component (P1.DU.Of[p.1.1].C.composite)) (P1.DLn.P.constant a))
      =< ap (\ g -> map Pre.gamma (map g a)) p.2 > map Pre.gamma (map P1.GB.global (map iota a))
      =< gamma-global (map iota a) > map P2.GB.global (map h (map iota a))
      =< ap (map P2.GB.global) (over a) > map P2.GB.global (map iota2 a) }) ;
  point : P2.Points = ((C.composite,local),over-k) ;
  -- its coordinate is h t
  coordinate-eq : Id B2.R (P2.Forth[point].coordinate) (map h (P1.Forth[p].coordinate)) = calc B2.R {
   P2.Forth[point].coordinate
    =< ap P2.GB.evaluate (component P1.DLn.P.variable)
    > P2.GB.evaluate (map Pre.gamma (map (P1.SU.component (P1.DU.Of[p.1.1].C.composite)) P1.DLn.P.variable))
    =< ap (\ s -> P2.GB.evaluate (map Pre.gamma s))
        (sym (P1.GB.global-evaluate (map (P1.SU.component (P1.DU.Of[p.1.1].C.composite)) P1.DLn.P.variable)))
    > P2.GB.evaluate (map Pre.gamma (map P1.GB.global (P1.Forth[p].coordinate)))
    =< ap P2.GB.evaluate (gamma-global (P1.Forth[p].coordinate)) > P2.GB.evaluate (map P2.GB.global (map h (P1.Forth[p].coordinate)))
    =< P2.GB.evaluate-global (map h (P1.Forth[p].coordinate)) > map h (P1.Forth[p].coordinate) } ;
 } ;

 -- base change of coordinates: (t, u0, u1) |-> (h t, Zar(h) u0, Zar(h) u1)
 module Image (c : P1.Coordinates) {
  covers : Id P2.ZB.lattice.L (P2.ZB.lattice.join (DL.hmap SH.morphism.lat c.1.2.1) (DL.hmap SH.morphism.lat c.1.2.2)) P2.ZB.lattice.top =
   trans (sym (DL.hmap-join SH.morphism.lat c.1.2.1 c.1.2.2))
    (trans (ap (DL.hmap SH.morphism.lat) c.2.1) (DL.hmap-top SH.morphism.lat)) ;
  meet-eq : Id P2.ZB.lattice.L (P2.ZB.lattice.meet (DL.hmap SH.morphism.lat c.1.2.1) (DL.hmap SH.morphism.lat c.1.2.2))
   (P2.ZB.D (map h c.1.1)) =
   trans (sym (DL.hmap-meet SH.morphism.lat c.1.2.1 c.1.2.2))
    (trans (ap (DL.hmap SH.morphism.lat) c.2.2) (zar-D c.1.1)) ;
  image : P2.Coordinates = ((map h c.1.1,DL.hmap SH.morphism.lat c.1.2.1,DL.hmap SH.morphism.lat c.1.2.2),covers,meet-eq) ;
 } ;

 -- naturality: the coordinates of psi . Spec h are the image of those of psi
 natural (p : P1.Points) : Id P2.Coordinates (P2.forth Pull[p].point) Image[P1.forth p].image =
  Pr.Sigma-eq (B2.R * P2.ZB.lattice.L * P2.ZB.lattice.L) P2.Conditions
   (P2.forth Pull[p].point).1 Image[P1.forth p].image.1 (P2.forth Pull[p].point).2 Image[P1.forth p].image.2
   (ap (\ t -> (t,DL.hmap SH.morphism.lat (DL.hmap p.1.1.lat P1.DU.Ch.e),DL.hmap SH.morphism.lat (DL.hmap p.1.1.lat P1.DU.Ch.e2)))
     Pull[p].coordinate-eq)
   (P2.conditions-prop Image[P1.forth p].image.1) ;
} ;
