-- Affine representables are Zariski sheaves on all small ring tests.
-- Let maps h_i : A -> B[1/a_i] agree on the overlaps.  For each a in A,
-- the existing basic gluing theorem gives a unique value in B[1/1] with
-- components h_i(a).  These values preserve 1,+,* by separation, since
-- each h_i does and restrictions are ring maps.  Thus they give a ring
-- map A -> B[1/1].  Compose with Global.back : B[1/1] -> B.
-- Its image in B[1/a_i] is h_i(a): rho-on and Global.f-back identify
-- f_i(back z) with rho_i(z).  These are the matching equations.
-- Equality of elements of B is detected by the f_i: apply separation to
-- f_1(x),f_1(y), then Global.back-f.  This proves uniqueness of the glued
-- map by ring-map extensionality; matching laws are propositions.  The
-- empty cover is included.  No fraction construction is analysed again.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module TS = TestSheaves[l] ;
module Over (A : T.Test) (c : TS.CoverData) {
 module F = SF.Representable[A] ;
 module C = TS.OnCover[F.functor,c].C ;
 module D = TS.OnCover[F.functor,c].D ;
 module Z = T.At[TS.base c].Z ;
 module AB = T.At[TS.base c].A ;
 module Gb = T.At[TS.base c].G ;
 below (i : Fin (TS.count c)) : Z.O.Le (Z.D (TS.generators c i)) (Z.D (TS.base c).ring.o) = Z.O.le-top (Z.D (TS.generators c i)) ;
 cover-le : Z.O.Le (Z.D (TS.base c).ring.o) (Z.J.bigJ (TS.count c) (\ i -> Z.D (TS.generators c i))) =
  Z.O.le-of-eq (Z.D (TS.base c).ring.o) (Z.J.bigJ (TS.count c) (\ i -> Z.D (TS.generators c i))) (sym (TS.covers c)) ;
 module Sep = Separation[l].Over[(TS.base c).ring,AB.Loc,AB.set,AB.inclusion,AB.elementary].Cover[(TS.base c).ring.o,TS.count c,TS.generators c,below,cover-le] ;
 image-back (i : Fin (TS.count c)) (z : (AB.Loc (TS.base c).ring.o).R) : Id (D.basic i).ring.R
  (map (AB.inclusion (TS.generators c i)) (map Gb.back z)) (map (Sep.rho-i i) z) =
  trans (sym (D.S.rho-on (TS.base c).ring.o (TS.generators c i) (below i) (map Gb.back z)))
   (ap (map (Sep.rho-i i)) (Gb.f-back z)) ;
 separate (x y : (TS.base c).ring.R) (e : (i : Fin (TS.count c)) -> Id (D.basic i).ring.R
  (map (AB.inclusion (TS.generators c i)) x) (map (AB.inclusion (TS.generators c i)) y)) : Id (TS.base c).ring.R x y =
  trans (sym (Gb.back-f x))
   (trans (ap (map Gb.back) (Sep.injective (map (AB.inclusion (TS.base c).ring.o) x) (map (AB.inclusion (TS.base c).ring.o) y)
     (\ i -> trans (D.S.rho-on (TS.base c).ring.o (TS.generators c i) (below i) x)
      (trans (e i) (sym (D.S.rho-on (TS.base c).ring.o (TS.generators c i) (below i) y)))))) (Gb.back-f y)) ;
 module Family (xs : C.Values) (compatible : C.Compatible xs) {
  module Value (a : A.ring.R) {
   ys (i : Fin (TS.count c)) : (D.basic i).ring.R = map {A.ring} {(D.basic i).ring} (xs i) a ;
   agree (i j : Fin (TS.count c)) : Id (D.double i j).ring.R (map (D.left i j) (ys i)) (map (D.right i j) (ys j)) =
    ap (\ h -> map {A.ring} {(D.double i j).ring} h a) (compatible i j) ;
   module G = D.G.Cover[(TS.base c).ring.o,TS.count c,TS.generators c,below,cover-le,ys,agree] ;
   value : (AB.Loc (TS.base c).ring.o).R = G.sheaf.1.1 ;
   matches (i : Fin (TS.count c)) : Id (D.basic i).ring.R (map (Sep.rho-i i) value) (ys i) = G.sheaf.1.2 i ;
  } ;
  glue (a : A.ring.R) : (AB.Loc (TS.base c).ring.o).R = Value[a].value ;
  one : Id (AB.Loc (TS.base c).ring.o).R (glue A.ring.o) (AB.Loc (TS.base c).ring.o).o =
   Sep.injective (glue A.ring.o) (AB.Loc (TS.base c).ring.o).o (\ i ->
    trans (Value[A.ring.o].matches i) (trans (map-one {A.ring} {(D.basic i).ring} (xs i)) (sym (map-one (Sep.rho-i i))))) ;
  add (a b : A.ring.R) : Id (AB.Loc (TS.base c).ring.o).R (glue (A.ring.add a b)) ((AB.Loc (TS.base c).ring.o).add (glue a) (glue b)) =
   Sep.injective (glue (A.ring.add a b)) ((AB.Loc (TS.base c).ring.o).add (glue a) (glue b)) (\ i ->
    trans (Value[A.ring.add a b].matches i) (trans (map-add {A.ring} {(D.basic i).ring} (xs i) a b)
     (trans (cong2 (D.basic i).ring.R (D.basic i).ring.add _ _ _ _ (sym (Value[a].matches i)) (sym (Value[b].matches i)))
      (sym (map-add (Sep.rho-i i) (glue a) (glue b)))))) ;
  mul (a b : A.ring.R) : Id (AB.Loc (TS.base c).ring.o).R (glue (A.ring.mul a b)) ((AB.Loc (TS.base c).ring.o).mul (glue a) (glue b)) =
   Sep.injective (glue (A.ring.mul a b)) ((AB.Loc (TS.base c).ring.o).mul (glue a) (glue b)) (\ i ->
    trans (Value[A.ring.mul a b].matches i) (trans (map-mul {A.ring} {(D.basic i).ring} (xs i) a b)
     (trans (cong2 (D.basic i).ring.R (D.basic i).ring.mul _ _ _ _ (sym (Value[a].matches i)) (sym (Value[b].matches i)))
      (sym (map-mul (Sep.rho-i i) (glue a) (glue b)))))) ;
  glued-map : RH.Hom A.ring (AB.Loc (TS.base c).ring.o) = (glue,one,add,mul) ;
  map-back : RH.Hom A.ring (TS.base c).ring = RH.compose A.ring (AB.Loc (TS.base c).ring.o) (TS.base c).ring Gb.back glued-map ;
  matches (a : A.ring.R) (i : Fin (TS.count c)) : Id (D.basic i).ring.R
   (map (AB.inclusion (TS.generators c i)) (map map-back a)) (map {A.ring} {(D.basic i).ring} (xs i) a) =
   trans (image-back i (glue a)) (Value[a].matches i) ;
  matching (i : Fin (TS.count c)) : Id (RH.Hom A.ring (D.basic i).ring)
   (F.functor.reindex (TS.base c) (D.basic i) (AB.inclusion (TS.generators c i)) map-back) (xs i) =
   RH.Properties[A.ring,(D.basic i).ring,(D.basic i).carrier-set].ext
    (F.functor.reindex (TS.base c) (D.basic i) (AB.inclusion (TS.generators c i)) map-back) (xs i) (\ a -> matches a i) ;
  amalgam : C.Amalgam xs = (map-back,matching) ;
  unique (p : C.Amalgam xs) : Id (C.Amalgam xs) amalgam p =
   Pr.Sigma-eq (F.functor.obj (TS.base c)) (C.Matches xs) map-back p.1 matching p.2
    (RH.Properties[A.ring,(TS.base c).ring,(TS.base c).carrier-set].ext map-back p.1 (\ a ->
     separate (map map-back a) (map {A.ring} {(TS.base c).ring} p.1 a) (\ i ->
      trans (matches a i) (sym (ap (\ h -> map {A.ring} {(D.basic i).ring} h a) (p.2 i))))))
    (C.matches-prop xs p.1) ;
  sheaf : Localisation[l].isContr (C.Amalgam xs) = (amalgam,unique) ;
 } ;
} ;
is-sheaf (A : T.Test) : TS.IsSheaf SF.Representable[A].functor = \ c xs k -> Over[A,c].Family[xs,k].sheaf ;
