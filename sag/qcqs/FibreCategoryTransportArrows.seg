-- Transported structures on transported arrows (objects and arrows in U k).
-- Arrows with their ends: Arr X = (x y : X.ob) * X.hom x y
-- (FibreCategorySIPArrows).  For p : C = D, transport of Arr along p is
-- (p_* x, p_* y, p_* f), p_* f the arrow moved by J (Along.hom): J on p,
-- refl at refl (Along.arrow).  Moving a structure along p commutes with
-- these transports (J on p, refl at refl):
--   the cokernel projection of p_* f is p_* of the projection of f,
--   p_* f (x) p_* g = p_* (f (x) g), the associator and the unitors at
--   moved objects are the moved ones.
-- When p is the identification of an equivalence e, p_* = F on objects
-- (FibreCategorySIPObjects) and on arrows (FibreCategorySIPArrows), so,
-- stated in Arr D (the ends move with the arrow):
--   (Coker) the cokernel projection of F f is F (projection of f):
--     (F y, coker (F f), proj) = (F y, F (coker f), F proj);
--   (M) F f (x) F g = F (f (x) g) over F x (x) F x' = F (x (x) x') etc.;
--     the associator at (F x, F y, F z) is F of the associator, and the
--     unitors at F x are F of the unitors (unit object F I).
level k ; open Base ;
module K = Category[k,k] ;
module P = Prelude[k] ;
module MCat = MonoidalCategory[k] ;
module CA = CategoryAbelian[k] ;
module Ob = FibreCategorySIPObjects[k] ;
module Ar = FibreCategorySIPArrows[k] ;
module TO = FibreCategoryTransportObjects[k] ;
module CE = FibreCategoryEquivalence[k] ;

-- operations producing arrows with their ends
module Ops (D : K.Category) {
 Arr : U k = Ar.Arr D.pre ;
 module Cok (H : CA.HasCokernels D) {
  -- the cokernel projection of a, with its ends
  projection (a : Arr) : Arr = (a.2.1,((H.2 a.1 a.2.1 a.2.2).1,(H.2 a.1 a.2.1 a.2.2).2.1)) ;
 } ;
 module Mon (S : MCat.Monoidal[D]) {
  tmap (a b : Arr) : Arr = (S.tensor a.1 b.1,(S.tensor a.2.1 b.2.1,S.tmap a.1 a.2.1 b.1 b.2.1 a.2.2 b.2.2)) ;
  associator (x y z : D.pre.ob) : Arr =
   (S.tensor (S.tensor x y) z,(S.tensor x (S.tensor y z),(S.associator x y z).1)) ;
  left-unitor (i x : D.pre.ob) (l : D.pre.Iso (S.tensor i x) x) : Arr = (S.tensor i x,(x,l.1)) ;
  right-unitor (i x : D.pre.ob) (r : D.pre.Iso (S.tensor x i) x) : Arr = (S.tensor x i,(x,r.1)) ;
 } ;
} ;

module Along (C D : K.Category) (p : Id K.Category C D) {
 module A = TO.Along[C,D,p] ;
 module OC = Ops[C] ; module OD = Ops[D] ;
 move (a : OC.Arr) : OD.Arr = Ar.arrC C D p a ;
 -- p_* (x, y, f) = (p_* x, p_* y, p_* f)
 arrow (x y : C.pre.ob) (f : C.pre.hom x y) : Id OD.Arr (move (x,(y,f))) (A.ob x,(A.ob y,A.hom x y f)) =
  idJ K.Category C (\ Z q -> Id (Ar.Arr Z.pre) (Ar.arrC C Z q (x,(y,f)))
    (Ob.obC C Z q x,(Ob.obC C Z q y,idJ K.Category C (\ Z' q' -> Z'.pre.hom (Ob.obC C Z' q' x) (Ob.obC C Z' q' y)) f Z q)))
   (refl (x,(y,f))) D p ;
 module Coker (H : CA.HasCokernels C) {
  module AC = A.Coker[H] ;
  module CC = OC.Cok[H] ; module CD = OD.Cok[AC.moved] ;
  projection (x y : C.pre.ob) (f : C.pre.hom x y) :
   Id OD.Arr (CD.projection (A.ob x,(A.ob y,A.hom x y f))) (move (CC.projection (x,(y,f)))) =
   idJ K.Category C (\ Z q -> Id (Ar.Arr Z.pre)
     (Ops[Z].Cok[CA.Transport[C,Z,q].move CA.HasCokernels H].projection
      (Ob.obC C Z q x,(Ob.obC C Z q y,idJ K.Category C (\ Z' q' -> Z'.pre.hom (Ob.obC C Z' q' x) (Ob.obC C Z' q' y)) f Z q)))
     (Ar.arrC C Z q (CC.projection (x,(y,f)))))
    (refl (CC.projection (x,(y,f)))) D p ;
 } ;
 module M (S : MCat.Monoidal[C]) {
  module AM = A.M[S] ;
  module MC = OC.Mon[S] ; module MD = OD.Mon[AM.moved] ;
  tmap (x y : C.pre.ob) (f : C.pre.hom x y) (x' y' : C.pre.ob) (g : C.pre.hom x' y') :
   Id OD.Arr (MD.tmap (move (x,(y,f))) (move (x',(y',g)))) (move (MC.tmap (x,(y,f)) (x',(y',g)))) =
   idJ K.Category C (\ Z q -> Id (Ar.Arr Z.pre)
     (Ops[Z].Mon[MCat.transport C Z q S].tmap (Ar.arrC C Z q (x,(y,f))) (Ar.arrC C Z q (x',(y',g))))
     (Ar.arrC C Z q (MC.tmap (x,(y,f)) (x',(y',g)))))
    (refl (MC.tmap (x,(y,f)) (x',(y',g)))) D p ;
  associator (x y z : C.pre.ob) :
   Id OD.Arr (MD.associator (A.ob x) (A.ob y) (A.ob z)) (move (MC.associator x y z)) =
   idJ K.Category C (\ Z q -> Id (Ar.Arr Z.pre)
     (Ops[Z].Mon[MCat.transport C Z q S].associator (Ob.obC C Z q x) (Ob.obC C Z q y) (Ob.obC C Z q z))
     (Ar.arrC C Z q (MC.associator x y z)))
    (refl (MC.associator x y z)) D p ;
  left-unitor (x : C.pre.ob) :
   Id OD.Arr (MD.left-unitor AM.moved.unit (A.ob x) (AM.moved.left-unitor (A.ob x)))
    (move (MC.left-unitor S.unit x (S.left-unitor x))) =
   idJ K.Category C (\ Z q -> Id (Ar.Arr Z.pre)
     (Ops[Z].Mon[MCat.transport C Z q S].left-unitor (MCat.transport C Z q S).unit (Ob.obC C Z q x)
      ((MCat.transport C Z q S).left-unitor (Ob.obC C Z q x)))
     (Ar.arrC C Z q (MC.left-unitor S.unit x (S.left-unitor x))))
    (refl (MC.left-unitor S.unit x (S.left-unitor x))) D p ;
  right-unitor (x : C.pre.ob) :
   Id OD.Arr (MD.right-unitor AM.moved.unit (A.ob x) (AM.moved.right-unitor (A.ob x)))
    (move (MC.right-unitor S.unit x (S.right-unitor x))) =
   idJ K.Category C (\ Z q -> Id (Ar.Arr Z.pre)
     (Ops[Z].Mon[MCat.transport C Z q S].right-unitor (MCat.transport C Z q S).unit (Ob.obC C Z q x)
      ((MCat.transport C Z q S).right-unitor (Ob.obC C Z q x)))
     (Ar.arrC C Z q (MC.right-unitor S.unit x (S.right-unitor x))))
    (refl (MC.right-unitor S.unit x (S.right-unitor x))) D p ;
 } ;
} ;

-- along the identification of an equivalence: F on objects and arrows
module Equivalent (C D : K.Category) (e : CE.Equivalence[C,D]) {
 module EO = Ob.On[C,D,e] ;
 module EA = Ar.On[C,D,e] ;
 module AL = Along[C,D,EO.T.equality] ;
 module A = AL.A ;
 module OD = AL.OD ;
 F (x : C.pre.ob) : D.pre.ob = e.forward.obj x ;
 image (x y : C.pre.ob) (f : C.pre.hom x y) : OD.Arr = EA.image x y f ;
 -- p_* f, over the object paths, is F f
 arrows (x y : C.pre.ob) (f : C.pre.hom x y) : Id OD.Arr (A.ob x,(A.ob y,A.hom x y f)) (image x y f) =
  P.trans OD.Arr (A.ob x,(A.ob y,A.hom x y f)) (AL.move (x,(y,f))) (image x y f)
   (P.sym OD.Arr (AL.move (x,(y,f))) (A.ob x,(A.ob y,A.hom x y f)) (AL.arrow x y f))
   (EA.arrows x y f) ;
 -- objects moved to F: the three-argument case
 ap3 (g : D.pre.ob -> D.pre.ob -> D.pre.ob -> OD.Arr) (x y z : C.pre.ob) :
  Id OD.Arr (g (F x) (F y) (F z)) (g (A.ob x) (A.ob y) (A.ob z)) =
  P.trans OD.Arr (g (F x) (F y) (F z)) (g (A.ob x) (F y) (F z)) (g (A.ob x) (A.ob y) (A.ob z))
   (P.ap D.pre.ob OD.Arr (\ a -> g a (F y) (F z)) (F x) (A.ob x) (P.sym D.pre.ob (A.ob x) (F x) (EO.objects x)))
   (P.trans OD.Arr (g (A.ob x) (F y) (F z)) (g (A.ob x) (A.ob y) (F z)) (g (A.ob x) (A.ob y) (A.ob z))
    (P.ap D.pre.ob OD.Arr (\ b -> g (A.ob x) b (F z)) (F y) (A.ob y) (P.sym D.pre.ob (A.ob y) (F y) (EO.objects y)))
    (P.ap D.pre.ob OD.Arr (\ c -> g (A.ob x) (A.ob y) c) (F z) (A.ob z) (P.sym D.pre.ob (A.ob z) (F z) (EO.objects z)))) ;
 module Coker (H : CA.HasCokernels C) {
  module AC = AL.Coker[H] ;
  moved : CA.HasCokernels D = AC.AC.moved ;
  module CD = AC.CD ;
  -- the cokernel projection of F f is F of the cokernel projection of f
  projection (x y : C.pre.ob) (f : C.pre.hom x y) :
   Id OD.Arr (CD.projection (image x y f)) (image y (H.2 x y f).1 (H.2 x y f).2.1) =
   P.trans OD.Arr (CD.projection (image x y f)) (CD.projection (A.ob x,(A.ob y,A.hom x y f))) (image y (H.2 x y f).1 (H.2 x y f).2.1)
    (P.ap OD.Arr OD.Arr CD.projection (image x y f) (A.ob x,(A.ob y,A.hom x y f))
     (P.sym OD.Arr (A.ob x,(A.ob y,A.hom x y f)) (image x y f) (arrows x y f)))
    (P.trans OD.Arr (CD.projection (A.ob x,(A.ob y,A.hom x y f))) (AL.move (AC.CC.projection (x,(y,f)))) (image y (H.2 x y f).1 (H.2 x y f).2.1)
     (AC.projection x y f) (EA.arrows y (H.2 x y f).1 (H.2 x y f).2.1)) ;
  -- in particular the cokernel object of F f is F (coker f)
  object (x y : C.pre.ob) (f : C.pre.hom x y) :
   Id D.pre.ob (moved.2 (F x) (F y) (e.forward.map x y f)).1 (F (H.2 x y f).1) =
   P.ap OD.Arr D.pre.ob (\ t -> t.2.1) (CD.projection (image x y f)) (image y (H.2 x y f).1 (H.2 x y f).2.1) (projection x y f) ;
 } ;
 module M (S : MCat.Monoidal[C]) {
  module AM = AL.M[S] ;
  moved : MCat.Monoidal[D] = AM.AM.moved ;
  module MC = AM.MC ; module MD = AM.MD ;
  -- F f (x) F g = F (f (x) g)
  tmap (x y : C.pre.ob) (f : C.pre.hom x y) (x' y' : C.pre.ob) (g : C.pre.hom x' y') :
   Id OD.Arr (MD.tmap (image x y f) (image x' y' g))
    (image (S.tensor x x') (S.tensor y y') (S.tmap x y x' y' f g)) =
   P.trans OD.Arr (MD.tmap (image x y f) (image x' y' g)) (MD.tmap (AL.move (x,(y,f))) (AL.move (x',(y',g))))
    (image (S.tensor x x') (S.tensor y y') (S.tmap x y x' y' f g))
    (P.trans OD.Arr (MD.tmap (image x y f) (image x' y' g)) (MD.tmap (AL.move (x,(y,f))) (image x' y' g))
     (MD.tmap (AL.move (x,(y,f))) (AL.move (x',(y',g))))
     (P.ap OD.Arr OD.Arr (\ a -> MD.tmap a (image x' y' g)) (image x y f) (AL.move (x,(y,f)))
      (P.sym OD.Arr (AL.move (x,(y,f))) (image x y f) (EA.arrows x y f)))
     (P.ap OD.Arr OD.Arr (\ b -> MD.tmap (AL.move (x,(y,f))) b) (image x' y' g) (AL.move (x',(y',g)))
      (P.sym OD.Arr (AL.move (x',(y',g))) (image x' y' g) (EA.arrows x' y' g))))
    (P.trans OD.Arr (MD.tmap (AL.move (x,(y,f))) (AL.move (x',(y',g)))) (AL.move (MC.tmap (x,(y,f)) (x',(y',g))))
     (image (S.tensor x x') (S.tensor y y') (S.tmap x y x' y' f g))
     (AM.tmap x y f x' y' g) (EA.arrows (S.tensor x x') (S.tensor y y') (S.tmap x y x' y' f g))) ;
  -- the associator at (F x, F y, F z) is F of the associator
  associator (x y z : C.pre.ob) :
   Id OD.Arr (MD.associator (F x) (F y) (F z))
    (image (S.tensor (S.tensor x y) z) (S.tensor x (S.tensor y z)) (S.associator x y z).1) =
   P.trans OD.Arr (MD.associator (F x) (F y) (F z)) (MD.associator (A.ob x) (A.ob y) (A.ob z))
    (image (S.tensor (S.tensor x y) z) (S.tensor x (S.tensor y z)) (S.associator x y z).1)
    (ap3 MD.associator x y z)
    (P.trans OD.Arr (MD.associator (A.ob x) (A.ob y) (A.ob z)) (AL.move (MC.associator x y z))
     (image (S.tensor (S.tensor x y) z) (S.tensor x (S.tensor y z)) (S.associator x y z).1)
     (AM.associator x y z) (EA.arrows (S.tensor (S.tensor x y) z) (S.tensor x (S.tensor y z)) (S.associator x y z).1)) ;
  -- the unitors at F x are F of the unitors
  left-unitor (x : C.pre.ob) :
   Id OD.Arr (MD.left-unitor moved.unit (F x) (moved.left-unitor (F x))) (image (S.tensor S.unit x) x (S.left-unitor x).1) =
   P.trans OD.Arr (MD.left-unitor moved.unit (F x) (moved.left-unitor (F x)))
    (MD.left-unitor moved.unit (A.ob x) (moved.left-unitor (A.ob x))) (image (S.tensor S.unit x) x (S.left-unitor x).1)
    (P.ap D.pre.ob OD.Arr (\ a -> MD.left-unitor moved.unit a (moved.left-unitor a)) (F x) (A.ob x)
     (P.sym D.pre.ob (A.ob x) (F x) (EO.objects x)))
    (P.trans OD.Arr (MD.left-unitor moved.unit (A.ob x) (moved.left-unitor (A.ob x))) (AL.move (MC.left-unitor S.unit x (S.left-unitor x)))
     (image (S.tensor S.unit x) x (S.left-unitor x).1)
     (AM.left-unitor x) (EA.arrows (S.tensor S.unit x) x (S.left-unitor x).1)) ;
  right-unitor (x : C.pre.ob) :
   Id OD.Arr (MD.right-unitor moved.unit (F x) (moved.right-unitor (F x))) (image (S.tensor x S.unit) x (S.right-unitor x).1) =
   P.trans OD.Arr (MD.right-unitor moved.unit (F x) (moved.right-unitor (F x)))
    (MD.right-unitor moved.unit (A.ob x) (moved.right-unitor (A.ob x))) (image (S.tensor x S.unit) x (S.right-unitor x).1)
    (P.ap D.pre.ob OD.Arr (\ a -> MD.right-unitor moved.unit a (moved.right-unitor a)) (F x) (A.ob x)
     (P.sym D.pre.ob (A.ob x) (F x) (EO.objects x)))
    (P.trans OD.Arr (MD.right-unitor moved.unit (A.ob x) (moved.right-unitor (A.ob x))) (AL.move (MC.right-unitor S.unit x (S.right-unitor x)))
     (image (S.tensor x S.unit) x (S.right-unitor x).1)
     (AM.right-unitor x) (EA.arrows (S.tensor x S.unit) x (S.right-unitor x).1)) ;
 } ;
} ;
