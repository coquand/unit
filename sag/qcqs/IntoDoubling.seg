-- Maps into the doubling (DESIGN.md, Next 4, interface (a), construction).
--
-- Let Y2 be the doubling of Y along d (Doubling), X a locally ringed
-- lattice, f : X -> Y a map (ringed convention: (L, O_Y) -> (M, O_X), f*
-- its lattice map), and u0, u1 opens of X with u0 \/ u1 = top and
-- u0 /\ u1 = f*(d).  We build the map psi : X -> Y2.
-- Lemma (cross).  If w <= u0 /\ u1 = f*(d) and w <= f*(a) for (a, b) in
--  L2, then w <= f*(a) /\ f*(d) = f*(a /\ d) = f*(b /\ d) <= f*(b); and
--  symmetrically.
-- Lattice.  psi(a, b) = (u0 /\ f* a) \/ (u1 /\ f* b).  bot: u0 /\ bot =
--  bot.  top: u0 \/ u1 = top.  Joins: u0 /\ f*(a \/ a2) = (u0 /\ f* a) \/
--  (u0 /\ f* a2), then interchange the joins.  Meets: psi is monotone, so
--  psi(x /\ y) <= psi x /\ psi y.  Conversely psi x /\ psi y is the join
--  of four meets (distributivity); (u0 /\ f* a) /\ (u0 /\ f* a2) <=
--  u0 /\ f*(a /\ a2), and the cross term (u0 /\ f* a) /\ (u1 /\ f* b2) lies
--  below u1 and f* b2, and below f* b by (cross); so it lies below
--  u1 /\ f*(b /\ b2).
-- Sections.  For (s, t) in O2(a, b), the sections f#(s)|(u0 /\ f* a) and
--  f#(t)|(u1 /\ f* b) agree on w = their meet: w <= f*(a /\ d) (cross), and
--  there f#(s) and f#(t) restrict to f#(s|mid) = f#(t|mid) (f natural, s
--  and t agree on mid).  psi#(s, t) is their amalgam on the binary cover
--  of psi(a, b) (RingedLattice.Sheaf.Two.Lift: a ring map).
-- Lemma (parts).  psi#(s, t) restricted to any w <= u0 /\ f* a is f#(s)|w
--  (restrict in two steps).  Naturality: two restrictions of psi# agree on
--  the parts of psi(y), by (parts) and f natural; separation.
-- Lemma (local).  For f local, V = D(psi#(s, t)) <= psi(D s, D t):
--  V = (V /\ p0) \/ (V /\ p1) (V <= p0 \/ p1, p_i the parts), and
--  p0 /\ V is the invertibility open of psi#(s, t)|p0 = f#(s)|p0, i.e.
--  p0 /\ D(f# s) <= u0 /\ f*(D s) (InvOpen.Restrict, uniqueness, f local).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;
module Over (L : DL.DLat) (Y : LocallyRinged[l].On[L].LocallyRinged) (d : L.L)
 (M : DL.DLat) (X : LocallyRinged[l].On[M].LocallyRinged)
 (f : LocallyRinged[l].Maps[L,M,Y.sheaf,X.sheaf].Ringed)
 (u0 u1 : M.L) (covers : Id M.L (M.join u0 u1) M.top) (overlap : Id M.L (M.meet u0 u1) (DL.hmap f.lat d)) {
 module O = DL.Order[L] ;
 module OM = DL.Order[M] ;
 module Dbl = Doubling[l].Over[L,Y,d] ;
 module DD = Dbl.DD ;
 module FL = DL.JoinMaps[L,M,f.lat] ;
 module GY = Dbl.GO ;
 module GX = RingedLattice[l].On[M].Of[X.sheaf] ;

 -- below u0 and u1, hence below f*(d)
 below-d (w : M.L) (k0 : OM.Le w u0) (k1 : OM.Le w u1) : OM.Le w (DL.hmap f.lat d) =
  OM.le-trans w (M.meet u0 u1) (DL.hmap f.lat d) (OM.meet-glb u0 u1 w k0 k1) (OM.le-of-eq (M.meet u0 u1) (DL.hmap f.lat d) overlap) ;
 -- below f*(d) and f*(a), or f*(d) and f*(b): below f*(mid (a, b))
 below-mid0 (x : DD.Opens) (w : M.L) (kd : OM.Le w (DL.hmap f.lat d)) (ka : OM.Le w (DL.hmap f.lat (DD.first x))) :
  OM.Le w (DL.hmap f.lat (DD.mid x)) =
  OM.le-trans w (M.meet (DL.hmap f.lat (DD.first x)) (DL.hmap f.lat d)) (DL.hmap f.lat (DD.mid x))
   (OM.meet-glb (DL.hmap f.lat (DD.first x)) (DL.hmap f.lat d) w ka kd)
   (OM.le-of-eq (M.meet (DL.hmap f.lat (DD.first x)) (DL.hmap f.lat d)) (DL.hmap f.lat (DD.mid x))
     (sym (DL.hmap-meet f.lat (DD.first x) d))) ;
 below-mid1 (x : DD.Opens) (w : M.L) (kd : OM.Le w (DL.hmap f.lat d)) (kb : OM.Le w (DL.hmap f.lat (DD.second x))) :
  OM.Le w (DL.hmap f.lat (DD.mid x)) =
  OM.le-trans w (M.meet (DL.hmap f.lat (DD.second x)) (DL.hmap f.lat d)) (DL.hmap f.lat (DD.mid x))
   (OM.meet-glb (DL.hmap f.lat (DD.second x)) (DL.hmap f.lat d) w kb kd)
   (OM.le-of-eq (M.meet (DL.hmap f.lat (DD.second x)) (DL.hmap f.lat d)) (DL.hmap f.lat (DD.mid x))
     (trans (sym (DL.hmap-meet f.lat (DD.second x) d)) (ap (DL.hmap f.lat) (sym (DD.overlap x))))) ;
 -- (cross)
 cross0 (x : DD.Opens) (w : M.L) (kd : OM.Le w (DL.hmap f.lat d)) (ka : OM.Le w (DL.hmap f.lat (DD.first x))) :
  OM.Le w (DL.hmap f.lat (DD.second x)) =
  OM.le-trans w (DL.hmap f.lat (DD.mid x)) (DL.hmap f.lat (DD.second x)) (below-mid0 x w kd ka)
   (FL.monotone (DD.mid x) (DD.second x) (DD.mid-second x)) ;
 cross1 (x : DD.Opens) (w : M.L) (kd : OM.Le w (DL.hmap f.lat d)) (kb : OM.Le w (DL.hmap f.lat (DD.second x))) :
  OM.Le w (DL.hmap f.lat (DD.first x)) =
  OM.le-trans w (DL.hmap f.lat (DD.mid x)) (DL.hmap f.lat (DD.first x)) (below-mid1 x w kd kb)
   (FL.monotone (DD.mid x) (DD.first x) (DD.mid-first x)) ;

 -- the lattice map
 part0 (x : DD.Opens) : M.L = M.meet u0 (DL.hmap f.lat (DD.first x)) ;
 part1 (x : DD.Opens) : M.L = M.meet u1 (DL.hmap f.lat (DD.second x)) ;
 image (x : DD.Opens) : M.L = M.join (part0 x) (part1 x) ;
 in0 (x : DD.Opens) (w : M.L) (k : OM.Le w (part0 x)) : OM.Le w u0 =
  OM.le-trans w (part0 x) u0 k (OM.meet-left u0 (DL.hmap f.lat (DD.first x))) ;
 at0 (x : DD.Opens) (w : M.L) (k : OM.Le w (part0 x)) : OM.Le w (DL.hmap f.lat (DD.first x)) =
  OM.le-trans w (part0 x) (DL.hmap f.lat (DD.first x)) k (OM.meet-right u0 (DL.hmap f.lat (DD.first x))) ;
 in1 (x : DD.Opens) (w : M.L) (k : OM.Le w (part1 x)) : OM.Le w u1 =
  OM.le-trans w (part1 x) u1 k (OM.meet-left u1 (DL.hmap f.lat (DD.second x))) ;
 at1 (x : DD.Opens) (w : M.L) (k : OM.Le w (part1 x)) : OM.Le w (DL.hmap f.lat (DD.second x)) =
  OM.le-trans w (part1 x) (DL.hmap f.lat (DD.second x)) k (OM.meet-right u1 (DL.hmap f.lat (DD.second x))) ;

 image-bot : Id M.L (image DD.botD) M.bot = calc M.L {
  image DD.botD
   =< cong2 M.L M.join _ _ _ _ (ap (M.meet u0) (DL.hmap-bot f.lat)) (ap (M.meet u1) (DL.hmap-bot f.lat))
   > M.join (M.meet u0 M.bot) (M.meet u1 M.bot)
   =< cong2 M.L M.join _ _ _ _ (OM.meet-bot u0) (OM.meet-bot u1) > M.join M.bot M.bot
   =< M.joinB M.bot > M.bot } ;
 image-top : Id M.L (image DD.topD) M.top = calc M.L {
  image DD.topD
   =< cong2 M.L M.join _ _ _ _ (ap (M.meet u0) (DL.hmap-top f.lat)) (ap (M.meet u1) (DL.hmap-top f.lat))
   > M.join (M.meet u0 M.top) (M.meet u1 M.top)
   =< cong2 M.L M.join _ _ _ _ (M.meetT u0) (M.meetT u1) > M.join u0 u1
   =< covers > M.top } ;
 part0-join (x y : DD.Opens) : Id M.L (part0 (DD.joinD x y)) (M.join (part0 x) (part0 y)) =
  trans (ap (M.meet u0) (DL.hmap-join f.lat (DD.first x) (DD.first y)))
   (M.dist u0 (DL.hmap f.lat (DD.first x)) (DL.hmap f.lat (DD.first y))) ;
 part1-join (x y : DD.Opens) : Id M.L (part1 (DD.joinD x y)) (M.join (part1 x) (part1 y)) =
  trans (ap (M.meet u1) (DL.hmap-join f.lat (DD.second x) (DD.second y)))
   (M.dist u1 (DL.hmap f.lat (DD.second x)) (DL.hmap f.lat (DD.second y))) ;
 image-join (x y : DD.Opens) : Id M.L (image (DD.joinD x y)) (M.join (image x) (image y)) =
  trans (cong2 M.L M.join _ _ _ _ (part0-join x y) (part1-join x y))
   (OM.join-interchange (part0 x) (part0 y) (part1 x) (part1 y)) ;
 image-mono (x y : DD.Opens) (k : DD.OD.Le x y) : OM.Le (image x) (image y) =
  OM.join-mono (part0 x) (part1 x) (part0 y) (part1 y)
   (OM.meet-mono u0 (DL.hmap f.lat (DD.first x)) u0 (DL.hmap f.lat (DD.first y)) (OM.le-refl u0)
     (FL.monotone (DD.first x) (DD.first y) (DD.le-first x y k)))
   (OM.meet-mono u1 (DL.hmap f.lat (DD.second x)) u1 (DL.hmap f.lat (DD.second y)) (OM.le-refl u1)
     (FL.monotone (DD.second x) (DD.second y) (DD.le-second x y k))) ;
 -- below u0, f* a and f* a2: below part0 (x /\ y)
 part0-meet (x y : DD.Opens) (w : M.L) (k0 : OM.Le w u0) (ka : OM.Le w (DL.hmap f.lat (DD.first x)))
  (ka2 : OM.Le w (DL.hmap f.lat (DD.first y))) : OM.Le w (part0 (DD.meetD x y)) =
  OM.meet-glb u0 (DL.hmap f.lat (DD.first (DD.meetD x y))) w k0
   (OM.le-trans w (M.meet (DL.hmap f.lat (DD.first x)) (DL.hmap f.lat (DD.first y))) (DL.hmap f.lat (DD.first (DD.meetD x y)))
     (OM.meet-glb (DL.hmap f.lat (DD.first x)) (DL.hmap f.lat (DD.first y)) w ka ka2)
     (OM.le-of-eq _ _ (sym (DL.hmap-meet f.lat (DD.first x) (DD.first y))))) ;
 part1-meet (x y : DD.Opens) (w : M.L) (k1 : OM.Le w u1) (kb : OM.Le w (DL.hmap f.lat (DD.second x)))
  (kb2 : OM.Le w (DL.hmap f.lat (DD.second y))) : OM.Le w (part1 (DD.meetD x y)) =
  OM.meet-glb u1 (DL.hmap f.lat (DD.second (DD.meetD x y))) w k1
   (OM.le-trans w (M.meet (DL.hmap f.lat (DD.second x)) (DL.hmap f.lat (DD.second y))) (DL.hmap f.lat (DD.second (DD.meetD x y)))
     (OM.meet-glb (DL.hmap f.lat (DD.second x)) (DL.hmap f.lat (DD.second y)) w kb kb2)
     (OM.le-of-eq _ _ (sym (DL.hmap-meet f.lat (DD.second x) (DD.second y))))) ;
 -- the four meets of psi x /\ psi y
 module Meet (x y : DD.Opens) {
  w00 : M.L = M.meet (part0 x) (part0 y) ;
  w01 : M.L = M.meet (part0 x) (part1 y) ;
  w10 : M.L = M.meet (part1 x) (part0 y) ;
  w11 : M.L = M.meet (part1 x) (part1 y) ;
  le00 : OM.Le w00 (image (DD.meetD x y)) =
   OM.le-trans w00 (part0 (DD.meetD x y)) (image (DD.meetD x y))
    (part0-meet x y w00 (in0 x w00 (OM.meet-left (part0 x) (part0 y)))
      (at0 x w00 (OM.meet-left (part0 x) (part0 y))) (at0 y w00 (OM.meet-right (part0 x) (part0 y))))
    (OM.join-left (part0 (DD.meetD x y)) (part1 (DD.meetD x y))) ;
  le01 : OM.Le w01 (image (DD.meetD x y)) =
   OM.le-trans w01 (part1 (DD.meetD x y)) (image (DD.meetD x y))
    (part1-meet x y w01 (in1 y w01 (OM.meet-right (part0 x) (part1 y)))
      (cross0 x w01 (below-d w01 (in0 x w01 (OM.meet-left (part0 x) (part1 y))) (in1 y w01 (OM.meet-right (part0 x) (part1 y))))
        (at0 x w01 (OM.meet-left (part0 x) (part1 y))))
      (at1 y w01 (OM.meet-right (part0 x) (part1 y))))
    (OM.join-right (part0 (DD.meetD x y)) (part1 (DD.meetD x y))) ;
  le10 : OM.Le w10 (image (DD.meetD x y)) =
   OM.le-trans w10 (part0 (DD.meetD x y)) (image (DD.meetD x y))
    (part0-meet x y w10 (in0 y w10 (OM.meet-right (part1 x) (part0 y)))
      (cross1 x w10 (below-d w10 (in0 y w10 (OM.meet-right (part1 x) (part0 y))) (in1 x w10 (OM.meet-left (part1 x) (part0 y))))
        (at1 x w10 (OM.meet-left (part1 x) (part0 y))))
      (at0 y w10 (OM.meet-right (part1 x) (part0 y))))
    (OM.join-left (part0 (DD.meetD x y)) (part1 (DD.meetD x y))) ;
  le11 : OM.Le w11 (image (DD.meetD x y)) =
   OM.le-trans w11 (part1 (DD.meetD x y)) (image (DD.meetD x y))
    (part1-meet x y w11 (in1 x w11 (OM.meet-left (part1 x) (part1 y)))
      (at1 x w11 (OM.meet-left (part1 x) (part1 y))) (at1 y w11 (OM.meet-right (part1 x) (part1 y))))
    (OM.join-right (part0 (DD.meetD x y)) (part1 (DD.meetD x y))) ;
  image-meet : Id M.L (image (DD.meetD x y)) (M.meet (image x) (image y)) =
   OM.le-antisym (image (DD.meetD x y)) (M.meet (image x) (image y))
    (OM.meet-glb (image x) (image y) (image (DD.meetD x y))
      (image-mono (DD.meetD x y) x (DD.OD.meet-left x y)) (image-mono (DD.meetD x y) y (DD.OD.meet-right x y)))
    (OM.meet-joins-below (part0 x) (part1 x) (part0 y) (part1 y) (image (DD.meetD x y)) le00 le01 le10 le11) ;
 } ;
 lat : DL.Hom DD.lattice M = (image,image-bot,image-top,image-join,\ x y -> Meet[x,y].image-meet) ;

 -- the sections over x
 module XS = RingedLattice[l].On[M].Sheaf[X.sheaf,X.is-sheaf] ;
 module At (x : DD.Opens) {
  -- f#(s)|part0 and f#(t)|part1, ring maps out of O2(x)
  sec0 : RH.Hom (Dbl.ring x) (X.sheaf.ring (part0 x)) =
   RH.compose (Dbl.ring x) (X.sheaf.ring (DL.hmap f.lat (DD.first x))) (X.sheaf.ring (part0 x))
    (X.sheaf.res (part0 x) (DL.hmap f.lat (DD.first x)) (OM.meet-right u0 (DL.hmap f.lat (DD.first x))))
    (RH.compose (Dbl.ring x) (Y.sheaf.ring (DD.first x)) (X.sheaf.ring (DL.hmap f.lat (DD.first x)))
      (f.sharp (DD.first x)) Dbl.At[x].P.proj-left) ;
  sec1 : RH.Hom (Dbl.ring x) (X.sheaf.ring (part1 x)) =
   RH.compose (Dbl.ring x) (X.sheaf.ring (DL.hmap f.lat (DD.second x))) (X.sheaf.ring (part1 x))
    (X.sheaf.res (part1 x) (DL.hmap f.lat (DD.second x)) (OM.meet-right u1 (DL.hmap f.lat (DD.second x))))
    (RH.compose (Dbl.ring x) (Y.sheaf.ring (DD.second x)) (X.sheaf.ring (DL.hmap f.lat (DD.second x)))
      (f.sharp (DD.second x)) Dbl.At[x].P.proj-right) ;
  module T = XS.Two[image x,part0 x,part1 x,OM.join-left (part0 x) (part1 x),OM.join-right (part0 x) (part1 x),OM.le-refl (image x)] ;
  -- they agree on w = part0 x /\ part1 x, which lies below f*(mid x)
  w : M.L = M.meet (part0 x) (part1 x) ;
  kw0 : OM.Le w (part0 x) = OM.meet-left (part0 x) (part1 x) ;
  kw1 : OM.Le w (part1 x) = OM.meet-right (part0 x) (part1 x) ;
  km : OM.Le w (DL.hmap f.lat (DD.mid x)) = below-mid0 x w (below-d w (in0 x w kw0) (in1 x w kw1)) (at0 x w kw0) ;
  agrees (z : (Dbl.ring x).R) : T.Agree (map sec0 z) (map sec1 z) = calc (X.sheaf.ring w).R {
   GX.restrict w (part0 x) kw0 (map sec0 z)
    =< X.sheaf.res-comp w (part0 x) (DL.hmap f.lat (DD.first x)) kw0 (OM.meet-right u0 (DL.hmap f.lat (DD.first x))) (at0 x w kw0)
        (map (f.sharp (DD.first x)) (Dbl.left x z))
    > GX.restrict w (DL.hmap f.lat (DD.first x)) (at0 x w kw0) (map (f.sharp (DD.first x)) (Dbl.left x z))
    =< sym (X.sheaf.res-comp w (DL.hmap f.lat (DD.mid x)) (DL.hmap f.lat (DD.first x)) km
         (FL.monotone (DD.mid x) (DD.first x) (DD.mid-first x)) (at0 x w kw0) (map (f.sharp (DD.first x)) (Dbl.left x z)))
    > GX.restrict w (DL.hmap f.lat (DD.mid x)) km
       (GX.restrict (DL.hmap f.lat (DD.mid x)) (DL.hmap f.lat (DD.first x)) (FL.monotone (DD.mid x) (DD.first x) (DD.mid-first x))
         (map (f.sharp (DD.first x)) (Dbl.left x z)))
    =< ap (GX.restrict w (DL.hmap f.lat (DD.mid x)) km) (f.natural (DD.mid x) (DD.first x) (DD.mid-first x) (Dbl.left x z))
    > GX.restrict w (DL.hmap f.lat (DD.mid x)) km
       (map (f.sharp (DD.mid x)) (GY.restrict (DD.mid x) (DD.first x) (DD.mid-first x) (Dbl.left x z)))
    =< ap (\ r -> GX.restrict w (DL.hmap f.lat (DD.mid x)) km (map (f.sharp (DD.mid x)) r)) (Dbl.agree x z)
    > GX.restrict w (DL.hmap f.lat (DD.mid x)) km
       (map (f.sharp (DD.mid x)) (GY.restrict (DD.mid x) (DD.second x) (DD.mid-second x) (Dbl.right x z)))
    =< ap (GX.restrict w (DL.hmap f.lat (DD.mid x)) km) (sym (f.natural (DD.mid x) (DD.second x) (DD.mid-second x) (Dbl.right x z)))
    > GX.restrict w (DL.hmap f.lat (DD.mid x)) km
       (GX.restrict (DL.hmap f.lat (DD.mid x)) (DL.hmap f.lat (DD.second x)) (FL.monotone (DD.mid x) (DD.second x) (DD.mid-second x))
         (map (f.sharp (DD.second x)) (Dbl.right x z)))
    =< X.sheaf.res-comp w (DL.hmap f.lat (DD.mid x)) (DL.hmap f.lat (DD.second x)) km
         (FL.monotone (DD.mid x) (DD.second x) (DD.mid-second x)) (at1 x w kw1) (map (f.sharp (DD.second x)) (Dbl.right x z))
    > GX.restrict w (DL.hmap f.lat (DD.second x)) (at1 x w kw1) (map (f.sharp (DD.second x)) (Dbl.right x z))
    =< sym (X.sheaf.res-comp w (part1 x) (DL.hmap f.lat (DD.second x)) kw1 (OM.meet-right u1 (DL.hmap f.lat (DD.second x)))
         (at1 x w kw1) (map (f.sharp (DD.second x)) (Dbl.right x z)))
    > GX.restrict w (part1 x) kw1 (map sec1 z) } ;
  -- psi#: the amalgam, a ring map
  module S = T.Lift[Dbl.ring x,sec0,sec1,agrees] ;
  sharp-at : RH.Hom (Dbl.ring x) (X.sheaf.ring (image x)) = S.lift ;
  -- (parts): restricted below part0 x, psi#(s, t) is f#(s)
  restrict0 (z : (Dbl.ring x).R) (v : M.L) (k : OM.Le v (part0 x)) (k2 : OM.Le v (image x)) (k3 : OM.Le v (DL.hmap f.lat (DD.first x))) :
   Id (X.sheaf.ring v).R (GX.restrict v (image x) k2 (map sharp-at z))
    (GX.restrict v (DL.hmap f.lat (DD.first x)) k3 (map (f.sharp (DD.first x)) (Dbl.left x z))) = calc (X.sheaf.ring v).R {
   GX.restrict v (image x) k2 (map sharp-at z)
    =< sym (X.sheaf.res-comp v (part0 x) (image x) k (OM.join-left (part0 x) (part1 x)) k2 (map sharp-at z))
    > GX.restrict v (part0 x) k (GX.restrict (part0 x) (image x) (OM.join-left (part0 x) (part1 x)) (map sharp-at z))
    =< ap (GX.restrict v (part0 x) k) (S.lift0 z)
    > GX.restrict v (part0 x) k (map sec0 z)
    =< X.sheaf.res-comp v (part0 x) (DL.hmap f.lat (DD.first x)) k (OM.meet-right u0 (DL.hmap f.lat (DD.first x))) k3
        (map (f.sharp (DD.first x)) (Dbl.left x z))
    > GX.restrict v (DL.hmap f.lat (DD.first x)) k3 (map (f.sharp (DD.first x)) (Dbl.left x z)) } ;
  restrict1 (z : (Dbl.ring x).R) (v : M.L) (k : OM.Le v (part1 x)) (k2 : OM.Le v (image x)) (k3 : OM.Le v (DL.hmap f.lat (DD.second x))) :
   Id (X.sheaf.ring v).R (GX.restrict v (image x) k2 (map sharp-at z))
    (GX.restrict v (DL.hmap f.lat (DD.second x)) k3 (map (f.sharp (DD.second x)) (Dbl.right x z))) = calc (X.sheaf.ring v).R {
   GX.restrict v (image x) k2 (map sharp-at z)
    =< sym (X.sheaf.res-comp v (part1 x) (image x) k (OM.join-right (part0 x) (part1 x)) k2 (map sharp-at z))
    > GX.restrict v (part1 x) k (GX.restrict (part1 x) (image x) (OM.join-right (part0 x) (part1 x)) (map sharp-at z))
    =< ap (GX.restrict v (part1 x) k) (S.lift1 z)
    > GX.restrict v (part1 x) k (map sec1 z)
    =< X.sheaf.res-comp v (part1 x) (DL.hmap f.lat (DD.second x)) k (OM.meet-right u1 (DL.hmap f.lat (DD.second x))) k3
        (map (f.sharp (DD.second x)) (Dbl.right x z))
    > GX.restrict v (DL.hmap f.lat (DD.second x)) k3 (map (f.sharp (DD.second x)) (Dbl.right x z)) } ;
 } ;
 -- typed at the image of x, image x by definition
 sharp (x : DD.Opens) : RH.Hom (Dbl.ring x) (X.sheaf.ring (DL.hmap lat x)) = At[x].sharp-at ;

 -- naturality, on the two parts of psi y
 module Natural (y x : DD.Opens) (k : DD.OD.Le y x) (z : (Dbl.ring x).R) {
  m : OM.Le (image y) (image x) = DL.JoinMaps[DD.lattice,M,lat].monotone y x k ;
  k1 : O.Le (DD.first y) (DD.first x) = Dbl.Res[y,x,k].k1 ;
  k2 : O.Le (DD.second y) (DD.second x) = Dbl.Res[y,x,k].k2 ;
  j0 : OM.Le (part0 y) (image y) = OM.join-left (part0 y) (part1 y) ;
  j1 : OM.Le (part1 y) (image y) = OM.join-right (part0 y) (part1 y) ;
  -- part0 y <= part0 x
  p0 : OM.Le (part0 y) (part0 x) =
   OM.meet-mono u0 (DL.hmap f.lat (DD.first y)) u0 (DL.hmap f.lat (DD.first x)) (OM.le-refl u0) (FL.monotone (DD.first y) (DD.first x) k1) ;
  p1 : OM.Le (part1 y) (part1 x) =
   OM.meet-mono u1 (DL.hmap f.lat (DD.second y)) u1 (DL.hmap f.lat (DD.second x)) (OM.le-refl u1) (FL.monotone (DD.second y) (DD.second x) k2) ;
  on0 : Id (X.sheaf.ring (part0 y)).R
   (GX.restrict (part0 y) (image y) j0 (GX.restrict (image y) (image x) m (map (sharp x) z)))
   (GX.restrict (part0 y) (image y) j0 (map (sharp y) (map (Dbl.res y x k) z))) = calc (X.sheaf.ring (part0 y)).R {
   GX.restrict (part0 y) (image y) j0 (GX.restrict (image y) (image x) m (map (sharp x) z))
    =< X.sheaf.res-comp (part0 y) (image y) (image x) j0 m (OM.le-trans (part0 y) (image y) (image x) j0 m) (map (sharp x) z)
    > GX.restrict (part0 y) (image x) (OM.le-trans (part0 y) (image y) (image x) j0 m) (map (sharp x) z)
    =< At[x].restrict0 z (part0 y) p0 (OM.le-trans (part0 y) (image y) (image x) j0 m) (at0 x (part0 y) p0)
    > GX.restrict (part0 y) (DL.hmap f.lat (DD.first x)) (at0 x (part0 y) p0) (map (f.sharp (DD.first x)) (Dbl.left x z))
    =< sym (X.sheaf.res-comp (part0 y) (DL.hmap f.lat (DD.first y)) (DL.hmap f.lat (DD.first x)) (at0 y (part0 y) (OM.le-refl (part0 y)))
         (FL.monotone (DD.first y) (DD.first x) k1) (at0 x (part0 y) p0) (map (f.sharp (DD.first x)) (Dbl.left x z)))
    > GX.restrict (part0 y) (DL.hmap f.lat (DD.first y)) (at0 y (part0 y) (OM.le-refl (part0 y)))
       (GX.restrict (DL.hmap f.lat (DD.first y)) (DL.hmap f.lat (DD.first x)) (FL.monotone (DD.first y) (DD.first x) k1)
         (map (f.sharp (DD.first x)) (Dbl.left x z)))
    =< ap (GX.restrict (part0 y) (DL.hmap f.lat (DD.first y)) (at0 y (part0 y) (OM.le-refl (part0 y))))
        (f.natural (DD.first y) (DD.first x) k1 (Dbl.left x z))
    > GX.restrict (part0 y) (DL.hmap f.lat (DD.first y)) (at0 y (part0 y) (OM.le-refl (part0 y)))
       (map (f.sharp (DD.first y)) (GY.restrict (DD.first y) (DD.first x) k1 (Dbl.left x z)))
    =< sym (At[y].restrict0 (map (Dbl.res y x k) z) (part0 y) (OM.le-refl (part0 y)) j0 (at0 y (part0 y) (OM.le-refl (part0 y))))
    > GX.restrict (part0 y) (image y) j0 (map (sharp y) (map (Dbl.res y x k) z)) } ;
  on1 : Id (X.sheaf.ring (part1 y)).R
   (GX.restrict (part1 y) (image y) j1 (GX.restrict (image y) (image x) m (map (sharp x) z)))
   (GX.restrict (part1 y) (image y) j1 (map (sharp y) (map (Dbl.res y x k) z))) = calc (X.sheaf.ring (part1 y)).R {
   GX.restrict (part1 y) (image y) j1 (GX.restrict (image y) (image x) m (map (sharp x) z))
    =< X.sheaf.res-comp (part1 y) (image y) (image x) j1 m (OM.le-trans (part1 y) (image y) (image x) j1 m) (map (sharp x) z)
    > GX.restrict (part1 y) (image x) (OM.le-trans (part1 y) (image y) (image x) j1 m) (map (sharp x) z)
    =< At[x].restrict1 z (part1 y) p1 (OM.le-trans (part1 y) (image y) (image x) j1 m) (at1 x (part1 y) p1)
    > GX.restrict (part1 y) (DL.hmap f.lat (DD.second x)) (at1 x (part1 y) p1) (map (f.sharp (DD.second x)) (Dbl.right x z))
    =< sym (X.sheaf.res-comp (part1 y) (DL.hmap f.lat (DD.second y)) (DL.hmap f.lat (DD.second x)) (at1 y (part1 y) (OM.le-refl (part1 y)))
         (FL.monotone (DD.second y) (DD.second x) k2) (at1 x (part1 y) p1) (map (f.sharp (DD.second x)) (Dbl.right x z)))
    > GX.restrict (part1 y) (DL.hmap f.lat (DD.second y)) (at1 y (part1 y) (OM.le-refl (part1 y)))
       (GX.restrict (DL.hmap f.lat (DD.second y)) (DL.hmap f.lat (DD.second x)) (FL.monotone (DD.second y) (DD.second x) k2)
         (map (f.sharp (DD.second x)) (Dbl.right x z)))
    =< ap (GX.restrict (part1 y) (DL.hmap f.lat (DD.second y)) (at1 y (part1 y) (OM.le-refl (part1 y))))
        (f.natural (DD.second y) (DD.second x) k2 (Dbl.right x z))
    > GX.restrict (part1 y) (DL.hmap f.lat (DD.second y)) (at1 y (part1 y) (OM.le-refl (part1 y)))
       (map (f.sharp (DD.second y)) (GY.restrict (DD.second y) (DD.second x) k2 (Dbl.right x z)))
    =< sym (At[y].restrict1 (map (Dbl.res y x k) z) (part1 y) (OM.le-refl (part1 y)) j1 (at1 y (part1 y) (OM.le-refl (part1 y))))
    > GX.restrict (part1 y) (image y) j1 (map (sharp y) (map (Dbl.res y x k) z)) } ;
  natural : Id (X.sheaf.ring (DL.hmap lat y)).R
   (GX.restrict (DL.hmap lat y) (DL.hmap lat x) m (map (sharp x) z)) (map (sharp y) (map (Dbl.res y x k) z)) =
   At[y].T.separated (GX.restrict (image y) (image x) m (map (sharp x) z)) (map (sharp y) (map (Dbl.res y x k) z)) on0 on1 ;
 } ;
 module Mp = LocallyRinged[l].Maps[DD.lattice,M,Dbl.doubled.sheaf,X.sheaf] ;
 natural (y x : DD.Opens) (k : DD.OD.Le y x) (z : (Dbl.ring x).R) :
  Id (X.sheaf.ring (DL.hmap lat y)).R
   (map (X.sheaf.res (DL.hmap lat y) (DL.hmap lat x) (DL.JoinMaps[DD.lattice,M,lat].monotone y x k)) (map (sharp x) z))
   (map (sharp y) (map (Dbl.res y x k) z)) = Natural[y,x,k,z].natural ;
 psi : Mp.Ringed = new Mp.Ringed[lat,sharp,natural] ;

 -- psi is local when f is
 module Local (floc : LocallyRinged[l].Maps[L,M,Y.sheaf,X.sheaf].Of[f,Y.inv,X.inv].IsLocal) {
  module LX = LocallyRinged[l].On[M].Laws[X.sheaf,X.inv] ;
  module LY = Dbl.LX ;
  module IX = InvOpen[l].On[M].Of[X.sheaf] ;
  module Parts (x : DD.Opens) (z : (Dbl.ring x).R) {
   j0 : OM.Le (part0 x) (image x) = OM.join-left (part0 x) (part1 x) ;
   j1 : OM.Le (part1 x) (image x) = OM.join-right (part0 x) (part1 x) ;
   r0 : OM.Le (part0 x) (DL.hmap f.lat (DD.first x)) = OM.meet-right u0 (DL.hmap f.lat (DD.first x)) ;
   r1 : OM.Le (part1 x) (DL.hmap f.lat (DD.second x)) = OM.meet-right u1 (DL.hmap f.lat (DD.second x)) ;
   -- on part0, the invertibility open of psi#(s, t) is that of f#(s)
   eq0 : Id M.L (M.meet (part0 x) (LX.d (image x) (map (sharp x) z)))
    (M.meet (part0 x) (LX.d (DL.hmap f.lat (DD.first x)) (map (f.sharp (DD.first x)) (Dbl.left x z)))) =
    IX.unique (IX.Restrict[image x,part0 x,j0,map (sharp x) z,LX.d (image x) (map (sharp x) z),LX.d-open (image x) (map (sharp x) z)].restrict)
     (Pr.subst (X.sheaf.ring (part0 x)).R
       (\ r -> IX.IsInvOpen (part0 x) r (M.meet (part0 x) (LX.d (DL.hmap f.lat (DD.first x)) (map (f.sharp (DD.first x)) (Dbl.left x z)))))
       (GX.restrict (part0 x) (DL.hmap f.lat (DD.first x)) r0 (map (f.sharp (DD.first x)) (Dbl.left x z)))
       (GX.restrict (part0 x) (image x) j0 (map (sharp x) z))
       (sym (At[x].restrict0 z (part0 x) (OM.le-refl (part0 x)) j0 r0))
       (IX.Restrict[DL.hmap f.lat (DD.first x),part0 x,r0,map (f.sharp (DD.first x)) (Dbl.left x z),
         LX.d (DL.hmap f.lat (DD.first x)) (map (f.sharp (DD.first x)) (Dbl.left x z)),
         LX.d-open (DL.hmap f.lat (DD.first x)) (map (f.sharp (DD.first x)) (Dbl.left x z))].restrict)) ;
   eq1 : Id M.L (M.meet (part1 x) (LX.d (image x) (map (sharp x) z)))
    (M.meet (part1 x) (LX.d (DL.hmap f.lat (DD.second x)) (map (f.sharp (DD.second x)) (Dbl.right x z)))) =
    IX.unique (IX.Restrict[image x,part1 x,j1,map (sharp x) z,LX.d (image x) (map (sharp x) z),LX.d-open (image x) (map (sharp x) z)].restrict)
     (Pr.subst (X.sheaf.ring (part1 x)).R
       (\ r -> IX.IsInvOpen (part1 x) r (M.meet (part1 x) (LX.d (DL.hmap f.lat (DD.second x)) (map (f.sharp (DD.second x)) (Dbl.right x z)))))
       (GX.restrict (part1 x) (DL.hmap f.lat (DD.second x)) r1 (map (f.sharp (DD.second x)) (Dbl.right x z)))
       (GX.restrict (part1 x) (image x) j1 (map (sharp x) z))
       (sym (At[x].restrict1 z (part1 x) (OM.le-refl (part1 x)) j1 r1))
       (IX.Restrict[DL.hmap f.lat (DD.second x),part1 x,r1,map (f.sharp (DD.second x)) (Dbl.right x z),
         LX.d (DL.hmap f.lat (DD.second x)) (map (f.sharp (DD.second x)) (Dbl.right x z)),
         LX.d-open (DL.hmap f.lat (DD.second x)) (map (f.sharp (DD.second x)) (Dbl.right x z))].restrict)) ;
   -- hence D(psi#(s, t)) /\ part_i <= part_i (D2(s, t)), f being local
   le0 : OM.Le (M.meet (LX.d (image x) (map (sharp x) z)) (part0 x)) (part0 (Dbl.L2.d x z)) =
    OM.le-trans (M.meet (LX.d (image x) (map (sharp x) z)) (part0 x))
     (M.meet (part0 x) (LX.d (DL.hmap f.lat (DD.first x)) (map (f.sharp (DD.first x)) (Dbl.left x z)))) (part0 (Dbl.L2.d x z))
     (OM.le-of-eq _ _ (trans (M.meetC (LX.d (image x) (map (sharp x) z)) (part0 x)) eq0))
     (OM.meet-mono (part0 x) (LX.d (DL.hmap f.lat (DD.first x)) (map (f.sharp (DD.first x)) (Dbl.left x z)))
       u0 (DL.hmap f.lat (LY.d (DD.first x) (Dbl.left x z)))
       (OM.meet-left u0 (DL.hmap f.lat (DD.first x))) (floc (DD.first x) (Dbl.left x z))) ;
   le1 : OM.Le (M.meet (LX.d (image x) (map (sharp x) z)) (part1 x)) (part1 (Dbl.L2.d x z)) =
    OM.le-trans (M.meet (LX.d (image x) (map (sharp x) z)) (part1 x))
     (M.meet (part1 x) (LX.d (DL.hmap f.lat (DD.second x)) (map (f.sharp (DD.second x)) (Dbl.right x z)))) (part1 (Dbl.L2.d x z))
     (OM.le-of-eq _ _ (trans (M.meetC (LX.d (image x) (map (sharp x) z)) (part1 x)) eq1))
     (OM.meet-mono (part1 x) (LX.d (DL.hmap f.lat (DD.second x)) (map (f.sharp (DD.second x)) (Dbl.right x z)))
       u1 (DL.hmap f.lat (LY.d (DD.second x) (Dbl.right x z)))
       (OM.meet-left u1 (DL.hmap f.lat (DD.second x))) (floc (DD.second x) (Dbl.right x z))) ;
   -- V <= V /\ (part0 \/ part1) = (V /\ part0) \/ (V /\ part1)
   local : OM.Le (LX.d (image x) (map (sharp x) z)) (image (Dbl.L2.d x z)) =
    OM.le-trans (LX.d (image x) (map (sharp x) z)) (M.meet (LX.d (image x) (map (sharp x) z)) (image x)) (image (Dbl.L2.d x z))
     (OM.meet-glb (LX.d (image x) (map (sharp x) z)) (image x) (LX.d (image x) (map (sharp x) z))
       (OM.le-refl (LX.d (image x) (map (sharp x) z))) (IX.below (LX.d-open (image x) (map (sharp x) z))))
     (OM.meet-join-below (LX.d (image x) (map (sharp x) z)) (part0 x) (part1 x) (image (Dbl.L2.d x z))
       (OM.le-trans _ (part0 (Dbl.L2.d x z)) (image (Dbl.L2.d x z)) le0 (OM.join-left (part0 (Dbl.L2.d x z)) (part1 (Dbl.L2.d x z))))
       (OM.le-trans _ (part1 (Dbl.L2.d x z)) (image (Dbl.L2.d x z)) le1 (OM.join-right (part0 (Dbl.L2.d x z)) (part1 (Dbl.L2.d x z))))) ;
  } ;
  local : Mp.Of[psi,Dbl.doubled.inv,X.inv].IsLocal = \ x z -> Parts[x,z].local ;
 } ;
} ;
