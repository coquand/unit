-- The Zariski lattice as a functor on all small commutative rings.
-- For h : A -> B, D_B . h is a support, hence ZariskiUniversal gives the
-- unique lattice map h_* with h_*(D a)=D(h a).  The identity and composite
-- lattice maps satisfy these generator equations, so uniqueness proves
-- the functor laws.  This builds the set functor with no geometric model.
-- The inverse-image map of Spec h satisfies the same equation, by
-- SpecMap.pi-D and Global.d-global, so it agrees with h_* by uniqueness.
-- The comparison uses the named underlying-map of AffineTests.Map, not
-- unfolding the construction of its geometric morphism.
level l ; open Ring[l] ;
module DL = DistLattice[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module Sp = Spaces[l] ;
module OnMap (A B : T.Test) (h : RH.Hom A.ring B.ring) {
 module ZA = ZariskiLattice[l].Over[A.ring] ;
 module ZB = ZariskiLattice[l].Over[B.ring] ;
 module P = DL.SupportMaps[A.ring,B.ring,ZB.lattice].Pull[h,ZB.D,ZB.support] ;
 module UZ = ZariskiUniversal[l].Over[A.ring,ZB.lattice,\ a -> ZB.D (map h a),P.support] ;
 lattice-map : DL.Hom ZA.lattice ZB.lattice = UZ.factor ;
 on-D (a : A.ring.R) : Id ZB.lattice.L (DL.hmap lattice-map (ZA.D a)) (ZB.D (map h a)) = UZ.factor-D a ;
 module SpecMapView = T.Map[A,B,h] ;
 module SM = SpecMapView.S.Into.Of[SpecMapView.S.phi].SM ;
 spec-D (a : A.ring.R) : Id ZB.lattice.L (DL.hmap (Sp.underlying SpecMapView.morphism).lat (ZA.D a)) (ZB.D (map h a)) =
  trans (ap (\ p -> DL.hmap p.lat (ZA.D a)) SpecMapView.underlying-map)
   (trans (SM.pi-D a) (trans (ap (SM.LX.d ZB.lattice.top) (SpecMapView.S.phi-map a)) (T.At[B].G.d-global (map h a)))) ;
 spec-lattice (u : ZA.lattice.L) : Id ZB.lattice.L (DL.hmap (Sp.underlying SpecMapView.morphism).lat u) (DL.hmap lattice-map u) =
  UZ.unique (Sp.underlying SpecMapView.morphism).lat spec-D u ;
 unique (k : DL.Hom ZA.lattice ZB.lattice) (e : (a : A.ring.R) -> Id ZB.lattice.L (DL.hmap k (ZA.D a)) (ZB.D (map h a)))
  (u : ZA.lattice.L) : Id ZB.lattice.L (DL.hmap k u) (DL.hmap lattice-map u) = UZ.unique k e u ;
 opaque lattice-map ;
} ;
module Identity (A : T.Test) {
 module Z = ZariskiLattice[l].Over[A.ring] ;
 module M = OnMap[A,A,RH.identity A.ring] ;
 identity (u : Z.lattice.L) : Id Z.lattice.L (DL.hmap M.lattice-map u) u =
  sym (M.unique (DL.identity Z.lattice) (\ a -> refl (Z.D a)) u) ;
} ;
module Composition (A B C : T.Test) (h : RH.Hom A.ring B.ring) (k : RH.Hom B.ring C.ring) {
 module H = OnMap[A,B,h] ;
 module K = OnMap[B,C,k] ;
 module Direct = OnMap[A,C,RH.compose A.ring B.ring C.ring k h] ;
 composite : DL.Hom H.ZA.lattice K.ZB.lattice = DL.compose H.ZA.lattice H.ZB.lattice K.ZB.lattice K.lattice-map H.lattice-map ;
 on-D (a : A.ring.R) : Id K.ZB.lattice.L (DL.hmap composite (H.ZA.D a)) (K.ZB.D (map (RH.compose A.ring B.ring C.ring k h) a)) =
  trans (DL.hmap-compose K.lattice-map H.lattice-map (H.ZA.D a))
   (trans (ap (DL.hmap K.lattice-map) (H.on-D a)) (K.on-D (map h a))) ;
 composition (u : H.ZA.lattice.L) : Id K.ZB.lattice.L (DL.hmap Direct.lattice-map u) (DL.hmap K.lattice-map (DL.hmap H.lattice-map u)) =
  trans (sym (Direct.unique composite on-D u)) (DL.hmap-compose K.lattice-map H.lattice-map u) ;
} ;
functor : SF.SetFunctor = new SF.SetFunctor[\ A -> ZariskiLattice[l].Over[A.ring].lattice.L,
 \ A -> ZariskiLattice[l].Over[A.ring].lattice.setL,
 \ A B h u -> DL.hmap OnMap[A,B,h].lattice-map u,
 \ A u -> Identity[A].identity u,\ A B C h k u -> Composition[A,B,C,h,k].composition u] ;
