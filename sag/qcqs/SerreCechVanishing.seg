-- The H^1 form of Theorem thm:serre (Serre note, Corollary 5.4).
-- For a finite cover u_1, .., u_n of X and a module M, H1 = Z1/~ is the
-- checked Cech group (SerreCechCocycles); Vanishes says it is zero.
-- (1) If every M-torsor merely has a global section, H1 vanishes on every
--  finite cover: a class is that of a cocycle c, the class of the twisted
--  torsor T_c is c (SerreCechIsoClass.AtCocycle), and a torsor with a
--  global section has zero class.
-- (2) If H1 vanishes on a cover, a torsor with sections on its members
--  merely has a global section (zero class, SerreCechIsoClass).
-- (3) If X has an affine cover on which H1(K) vanishes for every
--  quasi-coherent K, X is affine: the partition torsor of that cover has
--  points on its members (SerrePartition.point), hence merely a global
--  section, which is a partition of unity subordinate to the cover
--  (SerrePartitionCover.principal-cover-at); conclude by
--  SerreAffineness.FromCover.
-- Hence, for qcqs X: X is affine iff H1 vanishes on every finite affine
-- cover for every quasi-coherent module iff it vanishes on one merely given
-- affine cover; the affine case uses the converse (SerreAffineConverse).
-- Vanishing is a statement about H1, not about a chosen cover: no
-- comparison of the groups of two covers is needed.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module BigTr = Truncation[l+] ;
module DL = DistLattice[l] ;
module MS = SerreModuleSheaf[l] ;
module On (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged) {
 module O = DL.Order[L] ; module J = DL.Joins[L] ;
 module Q = Qcqs[l].Over[L,X] ;
 module AC = AffineCriterion[l].Over[L,X] ;
 module Fixed (n : Nat) (as : Fin n -> L.L) (covers : O.Le L.top (J.bigJ n as)) (M : MS.On[L,X.sheaf].ModuleSheaf) {
  module Z = SerreCechCocycles[l].On[L,X.sheaf,M,n,as] ;
  module IC = SerreCechIsoClass[l].On[L,X.sheaf,M,n,as,covers] ;
  Vanishes : U l = (h : Z.H1) -> Id Z.H1 h Z.zero ;
  -- (1)
  from-acyclic (acyclic : SerreTorsor[l].On[L,X.sheaf].Over[M].Acyclic1) : Vanishes = \ h ->
   Z.Q.induction @l (\ k -> Id Z.H1 k Z.zero) (\ k -> Z.h1-set k Z.zero)
    (\ c -> trans (sym IC.AtCocycle[c].class-equation)
     (IC.AtCocycle[c].Class.section-to-zero IC.AtCocycle[c].covered (acyclic IC.AtCocycle[c].Local.torsor))) h ;
  -- (2)
  section (vanish : Vanishes) (T : IC.Torsors.Torsor) (covered : IC.TorsorClass[T].Covered) :
   Tr.Trunc[T.presheaf.obj L.top].carrier =
   IC.TorsorClass[T].zero-to-section covered (vanish (IC.TorsorClass[T].class covered)) ;
 } ;
 -- vanishing on an affine cover, for every quasi-coherent module
 VanishesOn (cover : Q.AffineCover) : U l+ = (M : MS.On[L,X.sheaf].ModuleSheaf) ->
  SerreQuasiCoherent[l].On[L,X,M].IsQuasiCoherent ->
  Fixed[cover.count,cover.opens,O.le-of-eq _ _ (sym cover.covers),M].Vanishes ;
 -- (1), for the hypothesis of the criterion
 every (hypothesis : SerrePartitionCover[l].On[L,X].Hypothesis) (cover : Q.AffineCover) : VanishesOn cover = \ M qc ->
  Fixed[cover.count,cover.opens,O.le-of-eq _ _ (sym cover.covers),M].from-acyclic (hypothesis M qc) ;
 -- (3)
 module FromCover (cover : Q.AffineCover) (vanish : VanishesOn cover) {
  module PC = SerrePartitionCover[l].On[L,X].Cover[cover] ;
  module F = Fixed[cover.count,cover.opens,O.le-of-eq _ _ (sym cover.covers),PC.P.kernel] ;
  covered : F.IC.TorsorClass[PC.P.torsor].Covered = Tr.Trunc[F.IC.TorsorClass[PC.P.torsor].Trivialisations].inc PC.P.point ;
  global : Tr.Trunc[PC.P.torsor.presheaf.obj L.top].carrier =
   F.section (vanish PC.P.kernel SerrePartitionQuasiCoherent[l].On[L,X,cover].quasi-coherent) PC.P.torsor covered ;
  affine : AC.IsAffine =
   Tr.Trunc[PC.PrincipalCover].induction @l (\ x -> AC.IsAffine) (\ x -> SerreAffineness[l].AffineProp[L,X].is-affine-prop)
    (\ P -> SerreAffineness[l].FromCover[L,X,cover,P].affine) (PC.principal-cover-at global) ;
 } ;
 -- Theorem thm:serre, H1 form, for a qcqs X
 module Theorem (qcqs : Q.IsQcqs) {
  Some : U l+ = BigTr.Trunc[(cover : Q.AffineCover) * VanishesOn cover].carrier ;
  Every : U l+ = (cover : Q.AffineCover) -> VanishesOn cover ;
  affine-to-every (affine : AC.IsAffine) : Every = every (SerreAffineConverse[l].On[L,X,affine].hypothesis) ;
  every-to-some (e : Every) : Some =
   Tr.Trunc[Q.AffineCover].induction @(l+) (\ x -> Some) (\ x -> BigTr.Trunc[(cover : Q.AffineCover) * VanishesOn cover].proposition)
    (\ c -> BigTr.Trunc[(cover : Q.AffineCover) * VanishesOn cover].inc (c,e c)) qcqs ;
  some-to-affine (s : Some) : AC.IsAffine =
   BigTr.Trunc[(cover : Q.AffineCover) * VanishesOn cover].induction @l (\ x -> AC.IsAffine)
    (\ x -> SerreAffineness[l].AffineProp[L,X].is-affine-prop) (\ p -> FromCover[p.1,p.2].affine) s ;
 } ;
} ;
