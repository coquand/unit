-- Compatible ring maps glue on a finite cover, uniquely.
-- Given h_i : T -> G(m_i), define lift(t) as the sheaf amalgam of h_i(t).
-- Its restriction is h_i(t), by the amalgam equation.  To prove it keeps
-- 1, + and multiplication, restrict the proposed equation to each m_i;
-- the restriction and h_i are ring maps, so separation proves it.
-- Any map with these restrictions is pointwise equal to lift, again by
-- separation, hence equal as a ring map.  The empty cover is included.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module DL = DistLattice[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module Over (M : DL.DLat) (G : RingedLattice[l].On[M].Presheaf)
 (sheaf : RingedLattice[l].On[M].Of[G].IsSheaf) (m : M.L) (n : Nat) (ms : Fin n -> M.L)
 (le : (i : Fin n) -> DL.Order[M].Le (ms i) m) (covers : DL.Order[M].Le m (DL.Joins[M].bigJ n ms))
 (T : CRing) (hs : (i : Fin n) -> RH.Hom T (G.ring (ms i)))
 (compatible : (t : T.R) -> RingedLattice[l].On[M].Of[G].Cover[m,n,ms,le,covers].Compatible (\ i -> map (hs i) t)) {
 module GO = RingedLattice[l].On[M].Of[G] ;
 module C = GO.Cover[m,n,ms,le,covers] ;
 module SC = RingedLattice[l].On[M].Sheaf[G,sheaf].Cover[m,n,ms,le,covers] ;
 glued (t : T.R) : C.Amalgam (\ i -> map (hs i) t) = (SC.glue (\ i -> map (hs i) t) (compatible t)).1 ;
 lift-map (t : T.R) : (G.ring m).R = C.amalgam (glued t) ;
 matches (t : T.R) (i : Fin n) : Id (G.ring (ms i)).R (GO.restrict (ms i) m (le i) (lift-map t)) (map (hs i) t) =
  C.matches (glued t) i ;
 lift-one : Id (G.ring m).R (lift-map T.o) (G.ring m).o =
  SC.separated (lift-map T.o) (G.ring m).o (\ i ->
   trans (matches T.o i) (trans (map-one (hs i)) (sym (map-one (G.res (ms i) m (le i)))))) ;
 lift-add (t t2 : T.R) : Id (G.ring m).R (lift-map (T.add t t2)) ((G.ring m).add (lift-map t) (lift-map t2)) =
  SC.separated (lift-map (T.add t t2)) ((G.ring m).add (lift-map t) (lift-map t2)) (\ i ->
   trans (matches (T.add t t2) i) (trans (map-add (hs i) t t2)
    (trans (cong2 (G.ring (ms i)).R (G.ring (ms i)).add _ _ _ _ (sym (matches t i)) (sym (matches t2 i)))
     (sym (map-add (G.res (ms i) m (le i)) (lift-map t) (lift-map t2)))))) ;
 lift-mul (t t2 : T.R) : Id (G.ring m).R (lift-map (T.mul t t2)) ((G.ring m).mul (lift-map t) (lift-map t2)) =
  SC.separated (lift-map (T.mul t t2)) ((G.ring m).mul (lift-map t) (lift-map t2)) (\ i ->
   trans (matches (T.mul t t2) i) (trans (map-mul (hs i) t t2)
    (trans (cong2 (G.ring (ms i)).R (G.ring (ms i)).mul _ _ _ _ (sym (matches t i)) (sym (matches t2 i)))
     (sym (map-mul (G.res (ms i) m (le i)) (lift-map t) (lift-map t2)))))) ;
 lift : RH.Hom T (G.ring m) = (lift-map,lift-one,lift-add,lift-mul) ;
 lift-at (t : T.R) : Id (G.ring m).R (map lift t) (lift-map t) = refl (lift-map t) ;
 lift-matches (t : T.R) (i : Fin n) : Id (G.ring (ms i)).R
  (GO.restrict (ms i) m (le i) (map lift t)) (map (hs i) t) =
  trans (ap (GO.restrict (ms i) m (le i)) (lift-at t)) (matches t i) ;
 unique (h : RH.Hom T (G.ring m)) (on : (t : T.R) (i : Fin n) -> Id (G.ring (ms i)).R (GO.restrict (ms i) m (le i) (map h t)) (map (hs i) t)) :
  Id (RH.Hom T (G.ring m)) h lift =
  RH.Properties[T,G.ring m,G.ring-set m].ext h lift (\ t -> SC.separated (map h t) (lift-map t) (\ i -> trans (on t i) (sym (matches t i)))) ;
 opaque lift ;
} ;
