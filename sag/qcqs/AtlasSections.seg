-- The section laws of the recovered atlas (reviewed before code in the
-- restricted-cocycle subsection of unit/doc/functorial-schemes.tex).
-- Restrict the equality of triple-domain maps to w=t_jk(t_ij b).
-- The composite formula for sharp and OpenFactor.trace identify the
-- first image with c_jk(c_ij s), since restriction from w to itself is
-- identity.  Below.Pull.trace identifies the second with c_ik s|w.
-- Slice.res-inc and res-comp give exactly FiniteRingGlue's second leg.
-- On the diagonal apply the same restricted-map equality to
-- h_ii=inclusion; res-comp and res-id give the section identity.
level l ; open Ring[l] ; open Presentations[l] ;
module DL = DistLattice[l] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module TE = TestEquivalences[l] ;
module CO = CompactOpens[l] ;
module SP = Spaces[l] ;
module RM = RingMaps[l] ;
module Over (F : SF.SetFunctor) (n : Nat) (us : Fin n -> CO.Over[F].Open)
 (as : Fin n -> T.Test)
 (es : (i : Fin n) -> TE.NaturalEquivalence SF.Representable[as i].functor OpenRealisation[l].Over[F,us i].functor) {
 module A = AtlasLaws[l].Over[F,n,us,as,es] ;
 module D = A.D ;
 module L = A.L ;
 module R = L.R ;
 module At (i j k : Fin n) (b : (D.X i).lattice.L) {
  module K = A.At[i,j,k,b] ;
  module Tr = K.Tr ;
  module O = K.O ;
  module GO = R.Component[k].GO ;
  module SK = D.Patch[j,k].S ;
  c : D.Patch[i,j].S.Opens = DL.hmap (SP.underlying (D.h i j)).lat b ;
  w : (D.X k).lattice.L = K.left ;
  wr : O.Le w K.right = O.le-trans _ _ _ (O.le-of-eq _ _ K.equation) (O.meet-right (D.d k j) K.right) ;
  p : Tr.SQ.Opens = Tr.A.P.at w K.below-q ;
  kp : Tr.SQ.OS.Le p (DL.hmap (SP.underlying Tr.P.composite).lat b) =
   Tr.A.at-le c w K.below-q (O.le-refl w) ;
  kq : Tr.SQ.OS.Le p (DL.hmap (SP.underlying Tr.Q.C.composite).lat b) = Tr.Q.at-le b w K.below-q wr ;
  module MA = MapAgreement[l].Maps[(D.X i).lattice,Tr.SQ.lattice,(D.X i).structure.sheaf,Tr.SQ.sheaf] ;
  composite-section (s : ((D.X i).structure.sheaf.ring b).R) :
   Id (Tr.SQ.sheaf.ring (DL.hmap (SP.underlying Tr.P.composite).lat b)).R
    (RM.map ((SP.underlying Tr.P.composite).sharp b) s)
    (RM.map ((SP.underlying Tr.A.factor).sharp c) (L.transport-section i j b s)) = Tr.P.C.sharp-map b s ;
  first-restricted (s : ((D.X i).structure.sheaf.ring b).R) :
   Id ((D.X k).structure.sheaf.ring w).R
    (Tr.SQ.SO.restrict p (DL.hmap (SP.underlying Tr.P.composite).lat b) kp (RM.map ((SP.underlying Tr.P.composite).sharp b) s))
    (Tr.SQ.SO.restrict p (DL.hmap (SP.underlying Tr.A.factor).lat c) kp
     (RM.map ((SP.underlying Tr.A.factor).sharp c) (L.transport-section i j b s))) =
   ap (Tr.SQ.SO.restrict p (DL.hmap (SP.underlying Tr.P.composite).lat b) kp) (composite-section s) ;
  factor-restricted (s : ((D.X i).structure.sheaf.ring b).R) :
   Id ((D.X k).structure.sheaf.ring w).R
    (Tr.SQ.SO.restrict p (DL.hmap (SP.underlying Tr.A.factor).lat c) kp
     (RM.map ((SP.underlying Tr.A.factor).sharp c) (L.transport-section i j b s)))
    (GO.restrict w w (O.le-refl w) (L.transport-section j k (D.t i j b) (L.transport-section i j b s))) =
   Tr.A.trace c w K.below-q (O.le-refl w) (L.transport-section i j b s) ;
  first (s : ((D.X i).structure.sheaf.ring b).R) :
   Id ((D.X k).structure.sheaf.ring w).R
    (Tr.SQ.SO.restrict p (DL.hmap (SP.underlying Tr.P.composite).lat b) kp (RM.map ((SP.underlying Tr.P.composite).sharp b) s))
    (L.transport-section j k (D.t i j b) (L.transport-section i j b s)) =
   trans (first-restricted s) (trans (factor-restricted s)
    ((D.X k).structure.sheaf.res-id w (O.le-refl w) (L.transport-section j k (D.t i j b) (L.transport-section i j b s)))) ;
  equation (s : ((D.X i).structure.sheaf.ring b).R) :
   Id ((D.X k).structure.sheaf.ring w).R
    (L.transport-section j k (D.t i j b) (L.transport-section i j b s))
    (GO.restrict w K.right wr (L.transport-section i k b s)) =
   trans (sym (first s))
    (trans (MA.restrict-eq (SP.underlying Tr.P.composite) (SP.underlying Tr.Q.C.composite)
      (ap (SP.underlying {Tr.Z} {D.X i}) Tr.equation) b p kp kq s)
     (Tr.Q.trace b w K.below-q wr s)) ;
  v : R.FL.Opens = L.TL.extension i b ;
  second (s : ((D.X i).structure.sheaf.ring b).R) :
   Id ((D.X k).structure.sheaf.ring w).R
    (RM.map (R.leg2 v j k) (L.transport-section i k b s))
    (GO.restrict w K.right wr (L.transport-section i k b s)) =
   trans (SK.res-inc (R.mid v j k) (SK.cut K.right) (R.mid-second v j k)
     (RM.map (SK.down K.right) (L.transport-section i k b s)))
    ((D.X k).structure.sheaf.res-comp w ((D.X k).lattice.meet K.right (D.d k j)) K.right
     (SK.le-inc (R.mid v j k) (SK.cut K.right) (R.mid-second v j k))
     (O.meet-left K.right (D.d k j)) wr (L.transport-section i k b s)) ;
 } ;
 section-cocycle : L.SectionCocycle = \ i b s j k -> trans (At[i,j,k,b].equation s) (sym (At[i,j,k,b].second s)) ;
 module Diagonal (i : Fin n) (b : (D.X i).lattice.L) {
  module S = D.Patch[i,i].S ;
  module O = S.O ;
  module GO = S.GO ;
  ub : O.Le b (D.d i i) = O.le-trans _ _ _ (O.le-top b) (O.le-of-eq _ _ (sym (D.diagonal i))) ;
  p : S.Opens = (b,ub) ;
  back : O.Le b (D.t i i b) = O.le-of-eq _ _ (sym (A.identity i b)) ;
  kp : S.OS.Le p (DL.hmap (SP.underlying (D.h i i)).lat b) = S.le-in p _ back ;
  kq : S.OS.Le p (S.cut b) = S.le-in p (S.cut b) (O.meet-glb b (D.d i i) b (O.le-refl b) ub) ;
  module MA = MapAgreement[l].Maps[(D.X i).lattice,S.lattice,(D.X i).structure.sheaf,S.sheaf] ;
  equation (s : ((D.X i).structure.sheaf.ring b).R) :
   Id ((D.X i).structure.sheaf.ring b).R
    (GO.restrict b (D.t i i b) back (L.transport-section i i b s)) s =
   trans (GO.res-irr b (D.t i i b) back (S.le-inc p _ kp) (L.transport-section i i b s))
    (trans (sym (S.res-inc p _ kp (L.transport-section i i b s)))
     (trans (MA.restrict-eq (SP.underlying (D.h i i)) S.inclusion
       (ap (SP.underlying {OpenMaps[l].space (D.X i) (D.d i i)} {D.X i}) (D.identity i)) b p kp kq s)
      (trans (S.res-inc p (S.cut b) kq (RM.map (S.down b) s))
       (trans ((D.X i).structure.sheaf.res-comp b ((D.X i).lattice.meet b (D.d i i)) b
         (S.le-inc p (S.cut b) kq) (O.meet-left b (D.d i i)) (O.le-refl b) s)
        ((D.X i).structure.sheaf.res-id b (O.le-refl b) s))))) ;
 } ;
 section-identity : L.SectionIdentity = \ i b s -> Diagonal[i,b].equation s ;
 module Glued = L.Laws[section-cocycle,section-identity] ;
} ;
