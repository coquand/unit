-- Geometric representations of overlaps of a functorial affine chart.
-- Let e:h_A=|U| be an actual affine chart of F.  Its geometric chart
-- map h_(Spec A)->F is e after the inverse of the affine equivalence,
-- followed by the inclusion |U|->F.
-- Pull V back to |U| and then along e.  This is a compact open W of h_A.
-- RealisationTransfer identifies |W| with the realisation of the first
-- pullback; OpenIntersections identifies the latter with |U/\V|.
-- AffineOpenRealisation represents |W| by (Spec A)|d.  Thus the overlap
-- is represented by that qcqs open subspace, without choosing generators
-- and without asserting affineness of the overlap.
-- Its inclusion into F is the restriction of the geometric chart map:
-- AffineOpenRealisation.trace identifies the affine image of its underlying
-- ring-map point with the geometric inclusion; cancel the affine
-- equivalence using its inverse law, then apply e and forget membership.
level l ; open Ring[l] ;
module RH = RingHom[l] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module TE = TestEquivalences[l] ;
module CO = CompactOpens[l] ;
module SP = Spaces[l] ;
module Op = OpenMaps[l] ;
module Over (F : SF.SetFunctor) (u : CO.Over[F].Open) (A : T.Test)
 (e : TE.NaturalEquivalence SF.Representable[A].functor OpenRealisation[l].Over[F,u].functor) {
 module UO = OpenRealisation[l].Over[F,u] ;
 module AF = AffineFunctor[l].Spectrum[A] ;
 module AI = TE.Inverse[AF.H.functor,AF.G.functor,AF.equivalence] ;
 chart-equivalence : TE.NaturalEquivalence AF.G.functor UO.functor =
  TE.Composite[AF.G.functor,AF.H.functor,UO.functor,AI.inverse-equiv,e].equivalence ;
 chart-inclusion : SF.Transform[AF.G.functor,F].Nat =
  SF.Composite[AF.G.functor,UO.functor,F,UO.inclusion,TE.forward chart-equivalence].composite ;
 generic : F.obj A = UO.point {A} (SF.Transform[AF.H.functor,UO.functor].at (TE.forward e) A (RH.identity A.ring)) ;
 -- A chart inclusion is injective on affine points, since its lift to
 -- |U| is an equivalence and |U|->F has proposition fibres.
 injective (B : T.Test) (p q : AF.G.functor.obj B)
  (eq : Id (F.obj B) (SF.Transform[AF.G.functor,F].at chart-inclusion B p)
   (SF.Transform[AF.G.functor,F].at chart-inclusion B q)) : Id (AF.G.functor.obj B) p q =
  Iso[l].injective (AF.G.functor.obj B) (UO.obj B)
   (SF.Transform[AF.G.functor,UO.functor].at (TE.forward chart-equivalence) B) (TE.equiv-at chart-equivalence B) p q
   (UO.point-ext B (SF.Transform[AF.G.functor,UO.functor].at (TE.forward chart-equivalence) B p)
    (SF.Transform[AF.G.functor,UO.functor].at (TE.forward chart-equivalence) B q) eq) ;
 -- Equality of maps into the affine chart can consequently be checked
 -- after the chart inclusion into F, on all affine probes of a qcqs source.
 module Maps (Z : SP.Space) (f g : SP.Hom Z (T.space A))
  (on : (B : T.Test) (p : SP.Hom (T.space B) Z) -> Id (F.obj B)
   (SF.Transform[AF.G.functor,F].at chart-inclusion B (SP.compose (T.space B) Z (T.space A) f p))
   (SF.Transform[AF.G.functor,F].at chart-inclusion B (SP.compose (T.space B) Z (T.space A) g p))) {
  equal (qcqs : Qcqs[l].Over[Z.lattice,Z.structure].IsQcqs) : Id (SP.Hom Z (T.space A)) f g =
   ProbeSeparation[l].Over[Z,T.space A].Compare[f,g,\ B p -> injective B
    (SP.compose (T.space B) Z (T.space A) f p) (SP.compose (T.space B) Z (T.space A) g p) (on B p)].separated qcqs ;
 } ;
 module With (v : CO.Over[F].Open) {
  module I = OpenIntersections[l].Over[F,u,v] ;
  pulled : CO.Over[AF.H.functor].Open = CO.Pullback[AF.H.functor,UO.functor,TE.forward e].pull I.pulled ;
  module AR = AffineOpenRealisation[l].Over[A,pulled] ;
  module R = RealisationTransfer[l].Over[AF.H.functor,UO.functor,pulled,I.pulled,e].Given[
   \ B h m -> m,\ B h m -> m] ;
  module IntoNested = TE.Composite[SF.Geometric[AR.space].functor,AR.UO.functor,I.Nested.functor,AR.equivalence,R.equivalence] ;
  equivalence : TE.NaturalEquivalence SF.Geometric[AR.space].functor I.Meet.functor =
   TE.Composite[SF.Geometric[AR.space].functor,I.Nested.functor,I.Meet.functor,IntoNested.equivalence,I.equivalence].equivalence ;
  extent : Id T.At[A].Z.lattice.L AR.AC.extent (CO.Over[F].value v A generic) = refl AR.AC.extent ;
  underlying (B : T.Test) (p : SF.Geometric[AR.space].functor.obj B) : Id (F.obj B)
   (I.Meet.point {B} (SF.Transform[SF.Geometric[AR.space].functor,I.Meet.functor].at (TE.forward equivalence) B p))
   (UO.point {B} (SF.Transform[AF.H.functor,UO.functor].at (TE.forward e) B
    (AR.UO.point {B} (SF.Transform[SF.Geometric[AR.space].functor,AR.UO.functor].at (TE.forward AR.equivalence) B p)))) =
   trans (I.forward-point B (SF.Transform[AR.UO.functor,I.Nested.functor].at (TE.forward R.equivalence) B
     (SF.Transform[SF.Geometric[AR.space].functor,AR.UO.functor].at (TE.forward AR.equivalence) B p)))
    (ap (UO.point {B}) (R.forward-point B
     (SF.Transform[SF.Geometric[AR.space].functor,AR.UO.functor].at (TE.forward AR.equivalence) B p))) ;
  classifier (B : T.Test) (p : AF.G.functor.obj B) : Id T.At[B].Z.lattice.L
   (DistLattice[l].hmap (SP.underlying {T.space B} {T.space A} p).lat AR.AC.extent)
   (CO.Over[F].value v B (SF.Transform[AF.G.functor,F].at chart-inclusion B p)) =
   trans (sym (ap (\ q -> DistLattice[l].hmap (SP.underlying {T.space B} {T.space A} q).lat AR.AC.extent) (AI.right-at B p)))
    (AR.comparison B (AI.inverse-map B p)) ;
  trace (B : T.Test) (p : SF.Geometric[AR.space].functor.obj B) : Id (F.obj B)
   (I.Meet.point {B} (SF.Transform[SF.Geometric[AR.space].functor,I.Meet.functor].at (TE.forward equivalence) B p))
   (SF.Transform[AF.G.functor,F].at chart-inclusion B
    (SP.compose (T.space B) AR.space (T.space A) (Op.inclusion (T.space A) AR.AC.extent) p)) =
   trans (underlying B p) (ap (\ h -> UO.point {B} (SF.Transform[AF.H.functor,UO.functor].at (TE.forward e) B h))
    (trans (sym (AI.left-at B (AR.UO.point {B}
      (SF.Transform[SF.Geometric[AR.space].functor,AR.UO.functor].at (TE.forward AR.equivalence) B p))))
     (ap (AI.inverse-map B) (AR.trace B p)))) ;
  opaque equivalence ;
 } ;
} ;
