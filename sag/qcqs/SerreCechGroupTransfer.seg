-- Transport a module along a specified carrier equivalence.
-- Define operations by the inverse, the given module operation, and the
-- forward map. The inverse equations reduce each transported module law
-- to the corresponding original law. This transfers the cokernel module
-- to the previously specified small H1 quotient, without a second choice
-- of quotient or an identification of carriers by computation.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module SM = SerreModule[l] ;
module Over (A : CRing) (Md : SM.Over[A].Module) (X : U l) (setX : Pr.isSet X) (e : Pr.Equiv Md.M X) {
 forward (x : Md.M) : X = e.1 x ;
 backward (x : X) : Md.M = e.2.sec x ;
 back-forward (x : Md.M) : Id Md.M (backward (forward x)) x = Pr.sec-ret Md.M X e.1 e.2 x ;
 forward-back (x : X) : Id X (forward (backward x)) x = e.2.sec-eq x ;
 zero : X = forward Md.mz ;
 add (x y : X) : X = forward (Md.madd (backward x) (backward y)) ;
 negative (x : X) : X = forward (Md.mneg (backward x)) ;
 scale (r : A.R) (x : X) : X = forward (Md.sm r (backward x)) ;
 add-back (x y : X) : Id Md.M (backward (add x y)) (Md.madd (backward x) (backward y)) =
  back-forward (Md.madd (backward x) (backward y)) ;
 negative-back (x : X) : Id Md.M (backward (negative x)) (Md.mneg (backward x)) = back-forward (Md.mneg (backward x)) ;
 scale-back (r : A.R) (x : X) : Id Md.M (backward (scale r x)) (Md.sm r (backward x)) = back-forward (Md.sm r (backward x)) ;
 addA (x y z : X) : Id X (add x (add y z)) (add (add x y) z) =
  trans (ap (\ u -> forward (Md.madd (backward x) u)) (add-back y z))
   (trans (ap forward (Md.maddA (backward x) (backward y) (backward z)))
    (sym (ap (\ u -> forward (Md.madd u (backward z))) (add-back x y)))) ;
 addC (x y : X) : Id X (add x y) (add y x) = ap forward (Md.maddC (backward x) (backward y)) ;
 addZ (x : X) : Id X (add x zero) x =
  trans (ap (\ u -> forward (Md.madd (backward x) u)) (back-forward Md.mz))
   (trans (ap forward (Md.maddZ (backward x))) (forward-back x)) ;
 addN (x : X) : Id X (add x (negative x)) zero =
  trans (ap (\ u -> forward (Md.madd (backward x) u)) (negative-back x)) (ap forward (Md.maddN (backward x))) ;
 smA (r s : A.R) (x : X) : Id X (scale r (scale s x)) (scale (A.mul r s) x) =
  trans (ap (\ u -> forward (Md.sm r u)) (scale-back s x)) (ap forward (Md.smA r s (backward x))) ;
 smO (x : X) : Id X (scale A.o x) x = trans (ap forward (Md.smO (backward x))) (forward-back x) ;
 smD (r : A.R) (x y : X) : Id X (scale r (add x y)) (add (scale r x) (scale r y)) =
  trans (ap (\ u -> forward (Md.sm r u)) (add-back x y))
   (trans (ap forward (Md.smD r (backward x) (backward y)))
    (sym (trans (ap (\ u -> forward (Md.madd u (backward (scale r y)))) (scale-back r x))
     (ap (\ u -> forward (Md.madd (Md.sm r (backward x)) u)) (scale-back r y))))) ;
 smE (r s : A.R) (x : X) : Id X (scale (A.add r s) x) (add (scale r x) (scale s x)) =
  trans (ap forward (Md.smE r s (backward x)))
   (sym (trans (ap (\ u -> forward (Md.madd u (backward (scale s x)))) (scale-back r x))
    (ap (\ u -> forward (Md.madd (Md.sm r (backward x)) u)) (scale-back s x)))) ;
 transferred : SM.Over[A].Module = new SM.Over[A].Module[X,setX,zero,add,negative,addA,addC,addZ,addN,scale,smA,smO,smD,smE] ;
 forward-add (x y : Md.M) : Id X (add (forward x) (forward y)) (forward (Md.madd x y)) =
  trans (ap (\ u -> forward (Md.madd u (backward (forward y)))) (back-forward x))
   (ap (\ u -> forward (Md.madd x u)) (back-forward y)) ;
 forward-scale (r : A.R) (x : Md.M) : Id X (scale r (forward x)) (forward (Md.sm r x)) =
  ap (\ u -> forward (Md.sm r u)) (back-forward x) ;
 opaque add ; opaque negative ; opaque scale ;
} ;
