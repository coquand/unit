-- The scalar map on the localisation chart, evaluated on image-A basics.
-- Evaluate the chart's sharp at D(incl a) on the underlying D(g*a).
-- The resulting map from (A_g)_(incl a) sends an original r in A_g to
-- its actual restriction in A_(g*a). This follows from phi_g-on and
-- the component formula for extension on D(g). On arbitrary sections,
-- extend-basic identifies sharp followed by evaluation with this map.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (g : A.R) {
 module Cht = SpecBasicOpen[l].Over[A,setA,g] ;
 module Basis = SerreSpecBasicOpenBasis[l].Over[A,setA,g] ;
 module S = Cht.BO.S ; module ZA = Cht.ZA ; module ZB = Cht.ZG ;
 module Sl = Cht.Sl ; module SO = Cht.KM.SM.GO ;
 module Basic (a : A.R) {
  b : (Cht.SA.Loc g).R = Basis.coefficient a ;
  domain : Sl.Opens = DL.hmap Cht.KM.morphism.lat (ZB.D b) ;
  underlying : ZA.lattice.L = Sl.inc domain ;
  below : ZA.O.Le (ZA.D (A.mul g a)) underlying =
   ZA.O.le-of-eq _ _ (sym (Basis.k-basic-underlying a)) ;
  top-le : Sl.OS.Le domain Sl.lattice.top = Cht.KM.SM.Basic[b].le-top ;
  original-below : ZA.O.Le (ZA.D (A.mul g a)) (ZA.D g) =
   ZA.O.le-trans _ underlying (ZA.D g) below (Sl.le-inc domain Sl.lattice.top top-le) ;
  evaluation : RH.Hom (Sl.restricted.sheaf.ring domain) (Cht.SA.Loc (A.mul g a)) = S.component underlying (A.mul g a) below ;
  local-map : RH.Hom (Cht.SG.Loc b) (Cht.SA.Loc (A.mul g a)) =
   RH.compose _ _ _ evaluation Cht.KM.SM.Basic[b].phi-g ;
  phi-map (r : (Cht.SA.Loc g).R) : Id (S.Section (ZA.D g)) (map Cht.phi r) (Cht.BO.At[g].extend r) =
   Cht.BO.At[g].extension-map r ;
  original-restrict (s : S.Section (ZA.D g)) : Id (S.Section underlying)
   (Cht.GX.restrict underlying (ZA.D g) (Sl.le-inc domain Sl.lattice.top top-le) s)
   (S.restrict underlying (ZA.D g) (Sl.le-inc domain Sl.lattice.top top-le) s) =
   S.restriction-map underlying (ZA.D g) (Sl.le-inc domain Sl.lattice.top top-le) s ;
  on-original (r : (Cht.SA.Loc g).R) : Id (Cht.SA.Loc (A.mul g a)).R
   (map local-map (map (Cht.SG.inclusion b) r)) (map (S.rho g (A.mul g a) original-below) r) =
   calc (Cht.SA.Loc (A.mul g a)).R {
    map local-map (map (Cht.SG.inclusion b) r)
     =< map-compose evaluation Cht.KM.SM.Basic[b].phi-g (map (Cht.SG.inclusion b) r)
      > map evaluation (map Cht.KM.SM.Basic[b].phi-g (map (Cht.SG.inclusion b) r))
     =< ap (map evaluation) (Cht.KM.SM.Basic[b].phi-g-on r)
      > map evaluation (map Cht.KM.SM.Basic[b].on-A r)
     =< ap (map evaluation) (map-compose (Sl.restricted.sheaf.res domain Sl.lattice.top top-le) Cht.phi r)
      > map evaluation (SO.restrict domain Sl.lattice.top top-le (map Cht.phi r))
     =< ap (map evaluation) (Sl.res-inc domain Sl.lattice.top top-le (map Cht.phi r))
      > map evaluation (Cht.GX.restrict underlying (ZA.D g) (Sl.le-inc domain Sl.lattice.top top-le) (map Cht.phi r))
     =< ap (map evaluation) (original-restrict (map Cht.phi r))
      > map evaluation (S.restrict underlying (ZA.D g) (Sl.le-inc domain Sl.lattice.top top-le) (map Cht.phi r))
     =< S.component-map underlying (A.mul g a) below _
      > S.at (S.restrict underlying (ZA.D g) (Sl.le-inc domain Sl.lattice.top top-le) (map Cht.phi r)) (A.mul g a) below
     =< S.restrict-at underlying (ZA.D g) (Sl.le-inc domain Sl.lattice.top top-le) (map Cht.phi r) (A.mul g a) below
      > S.at (map Cht.phi r) (A.mul g a) original-below
     =< ap (\ s -> S.at s (A.mul g a) original-below) (phi-map r)
      > S.at (Cht.BO.At[g].extend r) (A.mul g a) original-below
     =< Cht.BO.At[g].extend-at r (A.mul g a) original-below
      > map (S.rho g (A.mul g a) original-below) r } ;
  sharp-evaluated (s : Cht.KM.SM.S.Section (ZB.D b)) : Id (Cht.SA.Loc (A.mul g a)).R
   (map evaluation (map (Cht.KM.morphism.sharp (ZB.D b)) s))
   (map local-map (map Cht.KM.SM.B.At[b].evaluation s)) =
   calc (Cht.SA.Loc (A.mul g a)).R {
    map evaluation (map (Cht.KM.morphism.sharp (ZB.D b)) s)
     =< ap (map evaluation) (Cht.KM.SM.E.extension-map-at (ZB.D b) s)
      > map evaluation (Cht.KM.SM.E.extend (ZB.D b) s)
     =< ap (map evaluation) (Cht.KM.SM.E.extend-basic b s)
      > map evaluation (map Cht.KM.SM.Basic[b].phi-g (Cht.KM.SM.B.At[b].eval s))
     =< sym (map-compose evaluation Cht.KM.SM.Basic[b].phi-g (Cht.KM.SM.B.At[b].eval s))
      > map local-map (Cht.KM.SM.B.At[b].eval s)
     =< sym (ap (map local-map) (Cht.KM.SM.B.At[b].evaluation-map s))
      > map local-map (map Cht.KM.SM.B.At[b].evaluation s) } ;
  opaque local-map ;
 } ;
} ;
