-- Extend compatible module maps on a basis to a sheaf map.
-- Every open merely has a finite cover by basis elements. Equality of
-- target sections can thus be checked on all basis subopens. For an
-- actual basis cover apply the local maps to the restricted source
-- section. On an overlap test equality on basis subopens; local
-- naturality and source composition prove compatibility. Glue in F.
-- Test its restriction on any basis element by the cover obtained by
-- intersection and another use of basis separation on each overlap.
-- The resulting section is unique, so mere covers determine it.
-- Addition, scalar action and naturality are checked on basis subopens;
-- the original maps are recovered on basis elements by identity laws.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module DL = DistLattice[l] ;
module MS = SerreModuleSheaf[l] ; module MM = SerreModuleMaps[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ; module Tr = Truncation[l] ;
module On (L : DL.DLat) (G : RingedLattice[l].On[L].Presheaf)
 (E F : MS.On[L,G].ModuleSheaf) (B : U l) (el : B -> L.L) {
 module O = DL.Order[L] ; module J = DL.Joins[L] ;
 module EO = MS.On[L,G].Of[E.presheaf] ; module FO = MS.On[L,G].Of[F.presheaf] ;
 module GO = RingedLattice[l].On[L].Of[G] ;
 record BasisCover (a : L.L) {
  count : Nat ;
  generators : Fin count -> B ;
  below (i : Fin count) : O.Le (el (generators i)) a ;
  covers : O.Le a (J.bigJ count (\ i -> el (generators i))) ;
 } ;
 record BasisMaps {
  component (b : B) : MM.Between[G.ring (el b),G.ring (el b),RingHom[l].identity (G.ring (el b)),E.presheaf.module-at (el b),F.presheaf.module-at (el b)].Hom ;
  natural (b c : B) (k : O.Le (el b) (el c)) (x : (E.presheaf.module-at (el c)).M) :
   Id (F.presheaf.module-at (el b)).M
    (FO.restrict (el b) (el c) k
     (MM.Between[G.ring (el c),G.ring (el c),RingHom[l].identity (G.ring (el c)),E.presheaf.module-at (el c),F.presheaf.module-at (el c)].map (component c) x))
    (MM.Between[G.ring (el b),G.ring (el b),RingHom[l].identity (G.ring (el b)),E.presheaf.module-at (el b),F.presheaf.module-at (el b)].map (component b) (EO.restrict (el b) (el c) k x)) ;
 } ;
 module Over (basis : (a : L.L) -> Tr.Trunc[BasisCover[a]].carrier) (local : BasisMaps) {
  at (b : B) (x : (E.presheaf.module-at (el b)).M) : (F.presheaf.module-at (el b)).M =
   MM.Between[G.ring (el b),G.ring (el b),RingHom[l].identity (G.ring (el b)),E.presheaf.module-at (el b),F.presheaf.module-at (el b)].map (local.component b) x ;
  module Separate (a : L.L) (x y : (F.presheaf.module-at a).M)
   (same : (b : B) (k : O.Le (el b) a) -> Id (F.presheaf.module-at (el b)).M (FO.restrict (el b) a k x) (FO.restrict (el b) a k y)) {
   module Actual (c : BasisCover[a]) {
    module S = SerreSetSheaf[l].On[L].SheafProofs[FO.underlying,F.sheaf].Cover[
     a,c.count,\ i -> el (c.generators i),c.below,c.covers] ;
    equal : Id (F.presheaf.module-at a).M x y = S.separated x y (\ i -> same (c.generators i) (c.below i)) ;
   } ;
   equal : Id (F.presheaf.module-at a).M x y = Tr.Trunc[BasisCover[a]].induction @l
    (\ t -> Id (F.presheaf.module-at a).M x y) (\ t -> (F.presheaf.module-at a).setM _ _)
    (\ c -> Actual[c].equal) (basis a) ;
   opaque equal ;
  } ;
  image (a : L.L) (x : (E.presheaf.module-at a).M) (b : B) (k : O.Le (el b) a) : (F.presheaf.module-at (el b)).M =
   at b (EO.restrict (el b) a k x) ;
  through (a : L.L) (x : (E.presheaf.module-at a).M) (b c : B)
   (bc : O.Le (el b) (el c)) (ca : O.Le (el c) a) (ba : O.Le (el b) a) :
   Id (F.presheaf.module-at (el b)).M (FO.restrict (el b) (el c) bc (image a x c ca)) (image a x b ba) =
   trans (local.natural b c bc (EO.restrict (el c) a ca x))
    (ap (at b) (E.presheaf.res-comp (el b) (el c) a bc ca ba x)) ;
  Matches (a : L.L) (x : (E.presheaf.module-at a).M) (y : (F.presheaf.module-at a).M) : U l =
   (b : B) (k : O.Le (el b) a) -> Id (F.presheaf.module-at (el b)).M (FO.restrict (el b) a k y) (image a x b k) ;
  matches-prop (a : L.L) (x : (E.presheaf.module-at a).M) (y : (F.presheaf.module-at a).M) : Pr.isProp (Matches a x y) =
   FE.isProp-Pi B (\ b -> (k : O.Le (el b) a) -> Id (F.presheaf.module-at (el b)).M (FO.restrict (el b) a k y) (image a x b k))
    (\ b -> FE.isProp-Pi (O.Le (el b) a) (\ k -> Id (F.presheaf.module-at (el b)).M (FO.restrict (el b) a k y) (image a x b k))
     (\ k -> (F.presheaf.module-at (el b)).setM _ _)) ;
  Candidate (a : L.L) (x : (E.presheaf.module-at a).M) : U l = (y : (F.presheaf.module-at a).M) * Matches a x y ;
  candidate-prop (a : L.L) (x : (E.presheaf.module-at a).M) : Pr.isProp (Candidate a x) = \ u v ->
   Pr.Sigma-eq (F.presheaf.module-at a).M (Matches a x) u.1 v.1 u.2 v.2
    Separate[a,u.1,v.1,\ b k -> trans (u.2 b k) (sym (v.2 b k))].equal (matches-prop a x v.1) ;
  module Actual (a : L.L) (x : (E.presheaf.module-at a).M) (cover : BasisCover[a]) {
   pieces (i : Fin cover.count) : L.L = el (cover.generators i) ;
   sections (i : Fin cover.count) : (F.presheaf.module-at (pieces i)).M = image a x (cover.generators i) (cover.below i) ;
   module C = FO.Cover[a,cover.count,pieces,cover.below,cover.covers].C ;
   module S = SerreSetSheaf[l].On[L].SheafProofs[FO.underlying,F.sheaf].Cover[a,cover.count,pieces,cover.below,cover.covers] ;
   module Pair (i j : Fin cover.count) {
    w : L.L = L.meet (pieces i) (pieces j) ;
    wa : O.Le w a = O.le-trans w (pieces i) a (O.meet-left (pieces i) (pieces j)) (cover.below i) ;
    module Below (b : B) (bw : O.Le (el b) w) {
     bi : O.Le (el b) (pieces i) = O.le-trans (el b) w (pieces i) bw (O.meet-left (pieces i) (pieces j)) ;
     bj : O.Le (el b) (pieces j) = O.le-trans (el b) w (pieces j) bw (O.meet-right (pieces i) (pieces j)) ;
     ba : O.Le (el b) a = O.le-trans (el b) w a bw wa ;
     equation : Id (F.presheaf.module-at (el b)).M
      (FO.restrict (el b) w bw (FO.restrict w (pieces i) (O.meet-left (pieces i) (pieces j)) (sections i)))
      (FO.restrict (el b) w bw (FO.restrict w (pieces j) (O.meet-right (pieces i) (pieces j)) (sections j))) =
      trans (F.presheaf.res-comp (el b) w (pieces i) bw (O.meet-left (pieces i) (pieces j)) bi (sections i))
       (trans (through a x b (cover.generators i) bi (cover.below i) ba)
        (trans (sym (through a x b (cover.generators j) bj (cover.below j) ba))
         (sym (F.presheaf.res-comp (el b) w (pieces j) bw (O.meet-right (pieces i) (pieces j)) bj (sections j))))) ;
    } ;
    compatible : Id (F.presheaf.module-at w).M
     (FO.restrict w (pieces i) (O.meet-left (pieces i) (pieces j)) (sections i))
     (FO.restrict w (pieces j) (O.meet-right (pieces i) (pieces j)) (sections j)) =
     Separate[w,FO.restrict w (pieces i) (O.meet-left (pieces i) (pieces j)) (sections i),
      FO.restrict w (pieces j) (O.meet-right (pieces i) (pieces j)) (sections j),\ b bw -> Below[b,bw].equation].equal ;
   } ;
   glued : C.Amalgam sections = (S.glue sections (\ i j -> Pair[i,j].compatible)).1 ;
   section : (F.presheaf.module-at a).M = C.amalgam glued ;
   matches-cover (i : Fin cover.count) : Id (F.presheaf.module-at (pieces i)).M (FO.restrict (pieces i) a (cover.below i) section) (sections i) = C.matches glued i ;
   module OnBasis (b : B) (ba : O.Le (el b) a) {
    opens (i : Fin cover.count) : L.L = L.meet (el b) (pieces i) ;
    below (i : Fin cover.count) : O.Le (opens i) (el b) = O.meet-left (el b) (pieces i) ;
    covers : O.Le (el b) (J.bigJ cover.count opens) =
     J.meet-cover (el b) cover.count pieces (O.le-trans (el b) a (J.bigJ cover.count pieces) ba cover.covers) ;
    module FS = SerreSetSheaf[l].On[L].SheafProofs[FO.underlying,F.sheaf].Cover[el b,cover.count,opens,below,covers] ;
    module Piece (i : Fin cover.count) {
     w : L.L = opens i ;
     wb : O.Le w (el b) = below i ; wc : O.Le w (pieces i) = O.meet-right (el b) (pieces i) ;
     module Below (d : B) (dw : O.Le (el d) w) {
      db : O.Le (el d) (el b) = O.le-trans (el d) w (el b) dw wb ;
      dc : O.Le (el d) (pieces i) = O.le-trans (el d) w (pieces i) dw wc ;
      da : O.Le (el d) a = O.le-trans (el d) (el b) a db ba ;
      left : Id (F.presheaf.module-at (el d)).M
       (FO.restrict (el d) w dw (FO.restrict w (el b) wb (FO.restrict (el b) a ba section))) (image a x d da) =
       trans (F.presheaf.res-comp (el d) w (el b) dw wb db (FO.restrict (el b) a ba section))
        (trans (F.presheaf.res-comp (el d) (el b) a db ba da section)
         (trans (sym (F.presheaf.res-comp (el d) (pieces i) a dc (cover.below i) da section))
          (trans (ap (FO.restrict (el d) (pieces i) dc) (matches-cover i))
           (through a x d (cover.generators i) dc (cover.below i) da)))) ;
      right : Id (F.presheaf.module-at (el d)).M
       (FO.restrict (el d) w dw (FO.restrict w (el b) wb (image a x b ba))) (image a x d da) =
       trans (F.presheaf.res-comp (el d) w (el b) dw wb db (image a x b ba)) (through a x d b db ba da) ;
     } ;
     equation : Id (F.presheaf.module-at w).M
      (FO.restrict w (el b) wb (FO.restrict (el b) a ba section)) (FO.restrict w (el b) wb (image a x b ba)) =
      Separate[w,FO.restrict w (el b) wb (FO.restrict (el b) a ba section),FO.restrict w (el b) wb (image a x b ba),
       \ d dw -> trans Below[d,dw].left (sym Below[d,dw].right)].equal ;
    } ;
    equation : Id (F.presheaf.module-at (el b)).M (FO.restrict (el b) a ba section) (image a x b ba) =
     FS.separated (FO.restrict (el b) a ba section) (image a x b ba) (\ i -> Piece[i].equation) ;
   } ;
   candidate : Candidate a x = (section,\ b ba -> OnBasis[b,ba].equation) ;
   opaque glued ; opaque section ; opaque candidate ;
  } ;
  chosen (a : L.L) (x : (E.presheaf.module-at a).M) : Candidate a x =
   Tr.Trunc[BasisCover[a]].induction @l (\ t -> Candidate a x) (\ t -> candidate-prop a x) (\ cover -> Actual[a,x,cover].candidate) (basis a) ;
  map (a : L.L) (x : (E.presheaf.module-at a).M) : (F.presheaf.module-at a).M = (chosen a x).1 ;
  map-basis (a : L.L) (x : (E.presheaf.module-at a).M) (b : B) (ba : O.Le (el b) a) :
   Id (F.presheaf.module-at (el b)).M (FO.restrict (el b) a ba (map a x)) (image a x b ba) = (chosen a x).2 b ba ;
  opaque chosen ; opaque map ;
  module Additive (a : L.L) (x y : (E.presheaf.module-at a).M) {
   equation (b : B) (ba : O.Le (el b) a) : Id (F.presheaf.module-at (el b)).M
    (FO.restrict (el b) a ba (map a ((E.presheaf.module-at a).madd x y)))
    (FO.restrict (el b) a ba ((F.presheaf.module-at a).madd (map a x) (map a y))) =
    trans (map-basis a ((E.presheaf.module-at a).madd x y) b ba)
     (trans (ap (at b) (EO.res-add (el b) a ba x y))
      (trans (MM.Between[G.ring (el b),G.ring (el b),RingHom[l].identity (G.ring (el b)),E.presheaf.module-at (el b),F.presheaf.module-at (el b)].map-add
       (local.component b) (EO.restrict (el b) a ba x) (EO.restrict (el b) a ba y))
       (trans (cong2 (F.presheaf.module-at (el b)).M (F.presheaf.module-at (el b)).madd _ _ _ _
        (sym (map-basis a x b ba)) (sym (map-basis a y b ba)))
        (sym (FO.res-add (el b) a ba (map a x) (map a y)))))) ;
  } ;
  additive (a : L.L) (x y : (E.presheaf.module-at a).M) :
   Id (F.presheaf.module-at a).M (map a ((E.presheaf.module-at a).madd x y)) ((F.presheaf.module-at a).madd (map a x) (map a y)) =
   Separate[a,map a ((E.presheaf.module-at a).madd x y),(F.presheaf.module-at a).madd (map a x) (map a y),Additive[a,x,y].equation].equal ;
  module Scalar (a : L.L) (r : (G.ring a).R) (x : (E.presheaf.module-at a).M) {
   equation (b : B) (ba : O.Le (el b) a) : Id (F.presheaf.module-at (el b)).M
    (FO.restrict (el b) a ba (map a ((E.presheaf.module-at a).sm r x)))
    (FO.restrict (el b) a ba ((F.presheaf.module-at a).sm r (map a x))) =
    trans (map-basis a ((E.presheaf.module-at a).sm r x) b ba)
     (trans (ap (at b) (EO.res-scale (el b) a ba r x))
      (trans (MM.Between[G.ring (el b),G.ring (el b),RingHom[l].identity (G.ring (el b)),E.presheaf.module-at (el b),F.presheaf.module-at (el b)].map-scale
       (local.component b) (GO.restrict (el b) a ba r) (EO.restrict (el b) a ba x))
       (trans (ap ((F.presheaf.module-at (el b)).sm (GO.restrict (el b) a ba r)) (sym (map-basis a x b ba)))
        (sym (FO.res-scale (el b) a ba r (map a x)))))) ;
  } ;
  scalar (a : L.L) (r : (G.ring a).R) (x : (E.presheaf.module-at a).M) :
   Id (F.presheaf.module-at a).M (map a ((E.presheaf.module-at a).sm r x)) ((F.presheaf.module-at a).sm r (map a x)) =
   Separate[a,map a ((E.presheaf.module-at a).sm r x),(F.presheaf.module-at a).sm r (map a x),Scalar[a,r,x].equation].equal ;
  module Naturality (a b : L.L) (ab : O.Le a b) (x : (E.presheaf.module-at b).M) {
   equation (c : B) (ca : O.Le (el c) a) : Id (F.presheaf.module-at (el c)).M
    (FO.restrict (el c) a ca (map a (EO.restrict a b ab x)))
    (FO.restrict (el c) a ca (FO.restrict a b ab (map b x))) =
    trans (map-basis a (EO.restrict a b ab x) c ca)
     (trans (ap (at c) (E.presheaf.res-comp (el c) a b ca ab (O.le-trans (el c) a b ca ab) x))
      (trans (sym (map-basis b x c (O.le-trans (el c) a b ca ab)))
       (sym (F.presheaf.res-comp (el c) a b ca ab (O.le-trans (el c) a b ca ab) (map b x))))) ;
  } ;
  natural (a b : L.L) (ab : O.Le a b) (x : (E.presheaf.module-at b).M) :
   Id (F.presheaf.module-at a).M (map a (EO.restrict a b ab x)) (FO.restrict a b ab (map b x)) =
   Separate[a,map a (EO.restrict a b ab x),FO.restrict a b ab (map b x),Naturality[a,b,ab,x].equation].equal ;
  module Maps = MS.On[L,G].Transform[E.presheaf,F.presheaf] ;
  morphism : Maps.Hom = new Maps.Hom[
   \ a -> new MM.Between[G.ring a,G.ring a,RingHom[l].identity (G.ring a),E.presheaf.module-at a,F.presheaf.module-at a].Hom[map a,additive a,scalar a],natural] ;
  morphism-at (a : L.L) (x : (E.presheaf.module-at a).M) : Id (F.presheaf.module-at a).M (Maps.at morphism a x) (map a x) = refl (map a x) ;
  on-basis (b : B) (x : (E.presheaf.module-at (el b)).M) : Id (F.presheaf.module-at (el b)).M (Maps.at morphism (el b) x) (at b x) =
   trans (morphism-at (el b) x)
    (trans (sym (F.presheaf.res-id (el b) (O.le-refl (el b)) (map (el b) x)))
     (trans (map-basis (el b) x b (O.le-refl (el b))) (ap (at b) (E.presheaf.res-id (el b) (O.le-refl (el b)) x)))) ;
  module Unique (q : Maps.Hom)
   (on : (b : B) (x : (E.presheaf.module-at (el b)).M) -> Id (F.presheaf.module-at (el b)).M (Maps.at q (el b) x) (at b x)) {
   equation (a : L.L) (x : (E.presheaf.module-at a).M) (b : B) (ba : O.Le (el b) a) :
    Id (F.presheaf.module-at (el b)).M (FO.restrict (el b) a ba (Maps.at q a x)) (FO.restrict (el b) a ba (Maps.at morphism a x)) =
    trans (sym (q.natural (el b) a ba x))
     (trans (on b (EO.restrict (el b) a ba x))
      (sym (trans (ap (FO.restrict (el b) a ba) (morphism-at a x)) (map-basis a x b ba)))) ;
   unique-at (a : L.L) (x : (E.presheaf.module-at a).M) : Id (F.presheaf.module-at a).M (Maps.at q a x) (Maps.at morphism a x) =
    Separate[a,Maps.at q a x,Maps.at morphism a x,equation a x].equal ;
  } ;
  opaque morphism ;
 } ;
} ;
