-- Module presheaves and sheaves (Serre note, Section 4).
-- Restriction is semilinear over restriction of functions.  The underlying
-- set presheaf supplies finite-cover compatibility and unique amalgams;
-- thus the empty cover is part of sheafhood.  A morphism is a family of
-- linear maps commuting with restriction.  Local surjectivity asserts
-- mere finite-cover lifts, rather than surjectivity on each section module.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module DL = DistLattice[l] ;
module SM = SerreModule[l] ;
module MM = SerreModuleMaps[l] ;
module SS = SerreSetSheaf[l] ;
module Tr = Truncation[l] ;
module On (L : DL.DLat) (G : RingedLattice[l].On[L].Presheaf) {
 module O = DL.Order[L] ;
 module J = DL.Joins[L] ;
 module GO = RingedLattice[l].On[L].Of[G] ;
 record Presheaf {
  module-at : (a : L.L) -> SM.Over[G.ring a].Module ;
  res (a b : L.L) (k : O.Le a b) :
   MM.Between[G.ring b,G.ring a,G.res a b k,module-at b,module-at a].Hom ;
  res-id (a : L.L) (k : O.Le a a) (x : (module-at a).M) :
   Id (module-at a).M (MM.Between[G.ring a,G.ring a,G.res a a k,module-at a,module-at a].map (res a a k) x) x ;
  res-comp (a b c : L.L) (k : O.Le a b) (h : O.Le b c) (t : O.Le a c) (x : (module-at c).M) :
   Id (module-at a).M
    (MM.Between[G.ring b,G.ring a,G.res a b k,module-at b,module-at a].map (res a b k)
     (MM.Between[G.ring c,G.ring b,G.res b c h,module-at c,module-at b].map (res b c h) x))
    (MM.Between[G.ring c,G.ring a,G.res a c t,module-at c,module-at a].map (res a c t) x) ;
 } ;
 module Of (M : Presheaf) {
  restrict (a b : L.L) (k : O.Le a b) (x : (M.module-at b).M) : (M.module-at a).M =
   MM.Between[G.ring b,G.ring a,G.res a b k,M.module-at b,M.module-at a].map (M.res a b k) x ;
  res-irr (a b : L.L) (k h : O.Le a b) (x : (M.module-at b).M) :
   Id (M.module-at a).M (restrict a b k x) (restrict a b h x) =
   ap (\ t -> restrict a b t x) (O.le-prop a b k h) ;
  res-add (a b : L.L) (k : O.Le a b) (x y : (M.module-at b).M) :
   Id (M.module-at a).M (restrict a b k ((M.module-at b).madd x y))
    ((M.module-at a).madd (restrict a b k x) (restrict a b k y)) =
   MM.Between[G.ring b,G.ring a,G.res a b k,M.module-at b,M.module-at a].map-add (M.res a b k) x y ;
  res-scale (a b : L.L) (k : O.Le a b) (r : (G.ring b).R) (x : (M.module-at b).M) :
   Id (M.module-at a).M (restrict a b k ((M.module-at b).sm r x))
    ((M.module-at a).sm (GO.restrict a b k r) (restrict a b k x)) =
   MM.Between[G.ring b,G.ring a,G.res a b k,M.module-at b,M.module-at a].map-scale (M.res a b k) r x ;
  res-zero (a b : L.L) (k : O.Le a b) :
   Id (M.module-at a).M (restrict a b k (M.module-at b).mz) (M.module-at a).mz =
   MM.Between[G.ring b,G.ring a,G.res a b k,M.module-at b,M.module-at a].map-zero (M.res a b k) ;
  res-neg (a b : L.L) (k : O.Le a b) (x : (M.module-at b).M) :
   Id (M.module-at a).M (restrict a b k ((M.module-at b).mneg x))
    ((M.module-at a).mneg (restrict a b k x)) =
   MM.Between[G.ring b,G.ring a,G.res a b k,M.module-at b,M.module-at a].map-neg (M.res a b k) x ;
  res-sub (a b : L.L) (k : O.Le a b) (x y : (M.module-at b).M) :
   Id (M.module-at a).M
    (restrict a b k (SM.Over[G.ring b].Laws[M.module-at b].sub x y))
    (SM.Over[G.ring a].Laws[M.module-at a].sub (restrict a b k x) (restrict a b k y)) =
   trans (ap (restrict a b k) (SM.Over[G.ring b].Laws[M.module-at b].sub-at x y))
    (trans (res-add a b k x ((M.module-at b).mneg y))
     (trans (ap ((M.module-at a).madd (restrict a b k x)) (res-neg a b k y))
      (sym (SM.Over[G.ring a].Laws[M.module-at a].sub-at (restrict a b k x) (restrict a b k y))))) ;
  underlying : SS.On[L].Presheaf = new SS.On[L].Presheaf[
   \ a -> (M.module-at a).M,\ a -> (M.module-at a).setM,restrict,M.res-id,M.res-comp] ;
  underlying-res (a b : L.L) (k : O.Le a b) (x : (M.module-at b).M) :
   Id (M.module-at a).M (underlying.res a b k x) (restrict a b k x) = refl (restrict a b k x) ;
  module Cover (a : L.L) (n : Nat) (as : Fin n -> L.L)
   (le : (i : Fin n) -> O.Le (as i) a) (covers : O.Le a (J.bigJ n as)) {
   module C = SS.On[L].Of[underlying].Cover[a,n,as,le,covers] ;
  } ;
  IsSheaf : U l = SS.On[L].Of[underlying].IsSheaf ;
 } ;
 record ModuleSheaf {
  presheaf : Presheaf ;
  sheaf : Of[presheaf].IsSheaf ;
 } ;
 module Transform (E F : Presheaf) {
  module EO = Of[E] ;
  module FO = Of[F] ;
  record Hom {
   component (a : L.L) : MM.Between[G.ring a,G.ring a,RingHom[l].identity (G.ring a),E.module-at a,F.module-at a].Hom ;
   natural (a b : L.L) (k : O.Le a b) (x : (E.module-at b).M) :
    Id (F.module-at a).M
     (MM.Between[G.ring a,G.ring a,RingHom[l].identity (G.ring a),E.module-at a,F.module-at a].map (component a) (EO.restrict a b k x))
     (FO.restrict a b k (MM.Between[G.ring b,G.ring b,RingHom[l].identity (G.ring b),E.module-at b,F.module-at b].map (component b) x)) ;
  } ;
  at (q : Hom) (a : L.L) (x : (E.module-at a).M) : (F.module-at a).M =
   MM.Between[G.ring a,G.ring a,RingHom[l].identity (G.ring a),E.module-at a,F.module-at a].map (q.component a) x ;
  at-add (q : Hom) (a : L.L) (x y : (E.module-at a).M) :
   Id (F.module-at a).M (at q a ((E.module-at a).madd x y))
    ((F.module-at a).madd (at q a x) (at q a y)) =
   MM.Between[G.ring a,G.ring a,RingHom[l].identity (G.ring a),E.module-at a,F.module-at a].map-add (q.component a) x y ;
  at-zero (q : Hom) (a : L.L) : Id (F.module-at a).M (at q a (E.module-at a).mz) (F.module-at a).mz =
   MM.Between[G.ring a,G.ring a,RingHom[l].identity (G.ring a),E.module-at a,F.module-at a].map-zero (q.component a) ;
  at-neg (q : Hom) (a : L.L) (x : (E.module-at a).M) :
   Id (F.module-at a).M (at q a ((E.module-at a).mneg x)) ((F.module-at a).mneg (at q a x)) =
   MM.Between[G.ring a,G.ring a,RingHom[l].identity (G.ring a),E.module-at a,F.module-at a].map-neg (q.component a) x ;
  at-sub (q : Hom) (a : L.L) (x y : (E.module-at a).M) :
   Id (F.module-at a).M (at q a (SM.Over[G.ring a].Laws[E.module-at a].sub x y))
    (SM.Over[G.ring a].Laws[F.module-at a].sub (at q a x) (at q a y)) =
   trans (ap (at q a) (SM.Over[G.ring a].Laws[E.module-at a].sub-at x y))
    (trans (at-add q a x ((E.module-at a).mneg y))
     (trans (ap ((F.module-at a).madd (at q a x)) (at-neg q a y))
      (sym (SM.Over[G.ring a].Laws[F.module-at a].sub-at (at q a x) (at q a y))))) ;
  at-scale (q : Hom) (a : L.L) (r : (G.ring a).R) (x : (E.module-at a).M) :
   Id (F.module-at a).M (at q a ((E.module-at a).sm r x)) ((F.module-at a).sm r (at q a x)) =
   MM.Between[G.ring a,G.ring a,RingHom[l].identity (G.ring a),E.module-at a,F.module-at a].map-scale (q.component a) r x ;
  record LocalLift (q : Hom) (a : L.L) (y : (F.module-at a).M) {
   count : Nat ;
   opens : Fin count -> L.L ;
   below (i : Fin count) : O.Le (opens i) a ;
   covers : O.Le a (J.bigJ count opens) ;
   lifts (i : Fin count) : (E.module-at (opens i)).M ;
   lifts-to (i : Fin count) : Id (F.module-at (opens i)).M
    (at q (opens i) (lifts i)) (FO.restrict (opens i) a (below i) y) ;
  } ;
  LocallySurjective (q : Hom) : U l = (a : L.L) (y : (F.module-at a).M) ->
   Tr.Trunc[LocalLift[q,a,y]].carrier ;
 } ;
} ;
