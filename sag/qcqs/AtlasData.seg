-- Actual finite affine charts and the recovered overlap maps.
-- The indices h_ij:X_j|d_ji->X_i are those of finite gluing.
-- Their trace is AtlasTransition's chart square with associativity.
-- The generic point of chart i belongs to U_i, so d_ii=top.
-- On the diagonal the trace compares h_ii with the inclusion; chart
-- injectivity and qcqs probe separation give equality of these maps.
-- AtlasDomains, included into the source chart lattice, gives
-- t_jk(d_ji)=d_ki meet d_kj before any triple composite is formed.
level l ; open Ring[l] ; open Presentations[l] ;
module DL = DistLattice[l] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module TE = TestEquivalences[l] ;
module CO = CompactOpens[l] ;
module SP = Spaces[l] ;
module Op = OpenMaps[l] ;
module Over (F : SF.SetFunctor) (n : Nat) (us : Fin n -> CO.Over[F].Open)
 (as : Fin n -> T.Test)
 (es : (i : Fin n) -> TE.NaturalEquivalence SF.Representable[as i].functor OpenRealisation[l].Over[F,us i].functor) {
 X (i : Fin n) : SP.Space = T.space (as i) ;
 module Entry (i : Fin n) { module C = AtlasOverlap[l].Over[F,us i,as i,es i] ; } ;
 module Pair (i j : Fin n) { module W = Entry[i].C.With[us j] ; } ;
 d (i j : Fin n) : (X i).lattice.L = Pair[i,j].W.AR.AC.extent ;
 module Patch (i j : Fin n) { module S = Op.At[X j,d j i].Sl ; } ;
 module Transition (i j : Fin n) {
  module TR = AtlasTransition[l].Over[F,us j,us i,as j,as i,es j,es i] ;
  module H = SP.Composite[Op.space (X j) (d j i),Op.space (X i) (d i j),X i,Op.inclusion (X i) (d i j),TR.G.forward] ;
 } ;
 h (i j : Fin n) : SP.Hom (Op.space (X j) (d j i)) (X i) = Transition[i,j].H.composite ;
 t (i j : Fin n) (b : (X i).lattice.L) : (X j).lattice.L =
  Patch[i,j].S.inc (DL.hmap (SP.underlying (h i j)).lat b) ;
 below (i j : Fin n) (b : (X i).lattice.L) : DL.Order[(X j).lattice].Le (t i j b) (d j i) =
  Patch[i,j].S.below (DL.hmap (SP.underlying (h i j)).lat b) ;
 point (i : Fin n) (B : T.Test) (p : SP.Hom (T.space B) (X i)) : F.obj B =
  SF.Transform[Entry[i].C.AF.G.functor,F].at Entry[i].C.chart-inclusion B p ;
 trace (i j : Fin n) (B : T.Test) (p : SP.Hom (T.space B) (Op.space (X j) (d j i))) :
  Id (F.obj B) (point i B (SP.compose (T.space B) (Op.space (X j) (d j i)) (X i) (h i j) p))
   (point j B (SP.compose (T.space B) (Op.space (X j) (d j i)) (X j) (Op.inclusion (X j) (d j i)) p)) =
  trans (ap (point i B) (sym SP.Associativity[T.space B,Op.space (X j) (d j i),Op.space (X i) (d i j),X i,
    Op.inclusion (X i) (d i j),Transition[i,j].TR.G.forward,p].assoc))
   Transition[i,j].TR.Point[B,p].chart-equation ;
 member (i : Fin n) (B : T.Test) (p : SP.Hom (T.space B) (X i)) :
  Id T.At[B].Z.lattice.L (CO.Over[F].value (us i) B (point i B p)) T.At[B].Z.lattice.top =
  Entry[i].C.UO.member {B} (SF.Transform[Entry[i].C.AF.G.functor,Entry[i].C.UO.functor].at
   (TE.forward Entry[i].C.chart-equivalence) B p) ;
 diagonal (i : Fin n) : Id (X i).lattice.L (d i i) (X i).lattice.top =
  trans Pair[i,i].W.extent
   (Entry[i].C.UO.member {as i} (SF.Transform[SF.Representable[as i].functor,Entry[i].C.UO.functor].at
    (TE.forward (es i)) (as i) (RingHom[l].identity (as i).ring))) ;
 identity (i : Fin n) : Id (SP.Hom (Op.space (X i) (d i i)) (X i)) (h i i) (Op.inclusion (X i) (d i i)) =
  trans (ap (SP.compose (Op.space (X i) (d i i)) (Op.space (X i) (d i i)) (X i) (Op.inclusion (X i) (d i i)))
    AtlasInverse[l].Diagonal[F,us i,as i,es i].identity)
   SP.Laws[Op.space (X i) (d i i),X i,Op.inclusion (X i) (d i i)].right ;
 module Domain (i j k : Fin n) {
  module D = AtlasDomains[l].Over[F,us k,us j,us i,as k,as j,es k,es j] ;
  equation : Id (X k).lattice.L (t j k (d j i)) ((X k).lattice.meet (d k i) (d k j)) =
   ap Patch[j,k].S.inc D.equation ;
 } ;
 opaque h ;
} ;
