-- lambda_(a,g) is an equivalence iff restriction M(a) -> M(D_a g) clears
-- and kills at g (SerreLambdaElementary, with h = lambda and u the
-- restriction, over O(a)). lambda clears fractions to the restriction:
-- g^p lambda(x/g^p) = x|D_a g. The second direction uses that g acts
-- invertibly on M(D_a g), because g|D_a g is a unit.
-- Along a ring map phi : B -> O(a) with phi(f) = g, the same clearing and
-- killing hold over B at f (SerreLambdaElementaryOps.RestrictScalars).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module DL = DistLattice[l] ;
module RH = RingHom[l] ; module RM = RingMaps[l] ;
module MS = SerreModuleSheaf[l] ; module EL = SerreLambdaElementary[l] ;
module On (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged)
 (M : MS.On[L,X.sheaf].ModuleSheaf) (a : L.L) (g : (X.sheaf.ring a).R) {
 module Lam = SerreLambda[l].On[L,X,M,a].At[g] ;
 module C = Lam.C ;
 -- restriction M(a) -> M(D_a g), linear over O(a)
 module E = EL.Over[X.sheaf.ring a,M.presheaf.module-at a,C.Scalars.restricted,C.original,g] ;
 clears (x : (M.presheaf.module-at a).M) (p : Nat) :
  Id (M.presheaf.module-at Lam.open-g).M (E.T.power p (Lam.map (E.S.fraction x p))) (E.H.map C.original x) =
  trans (C.clears x p) (sym (C.original-at x)) ;
 module Elementary (equiv : Lam.IsEquivalence) {
  module F = E.FromEquivalence[Lam.map,clears,equiv] ;
  clear : E.Clear = F.clear ;
  kill : E.Kill = F.kill ;
 } ;
 equivalence (clear : E.Clear) (kill : E.Kill) : Lam.IsEquivalence =
  E.ToEquivalence[C.invertible,Lam.map,clears,clear,kill].equivalence ;
 module Along (B : CRing) (phi : RH.Hom B (X.sheaf.ring a)) (f : B.R) (image : Id (X.sheaf.ring a).R (RM.map phi f) g) {
  module R = SerreLambdaElementaryOps[l].RestrictScalars[B,X.sheaf.ring a,phi,
   M.presheaf.module-at a,C.Scalars.restricted,C.original,f,g,image] ;
  module Restricted (equiv : Lam.IsEquivalence) {
   module F = Elementary[equiv] ;
   clear : R.EA.Clear = R.clear F.clear ;
   kill : R.EA.Kill = R.kill F.kill ;
  } ;
 } ;
} ;
