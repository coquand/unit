-- Agreement and finite-cover separation for maps of ringed lattices.
-- In geometric order these are maps out of the space on M.
--
-- Equal maps give equal section images after restriction to any common
-- smaller open: path induction on the equality leaves res-irr.
-- Maps agree on e if their inverse images intersect e equally, and their
-- section images agree after restriction to each common w <= e.  Both
-- conditions are stated in the ambient lattice, so no slice is identified.
-- On a finite cover, lattice agreement gives equality by LatticeCover.ext.
-- For s over u, compare the two images in G(pi2 u), restricting the first
-- along pi2 u <= pi u.  The opens pi2 u /\ e_i cover pi2 u; res-comp and
-- section agreement give equality there, and sheaf separation gives it
-- globally.  MapEquality.ext finishes.  This includes the empty cover.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module DL = DistLattice[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module Maps (L M : DL.DLat) (F : RingedLattice[l].On[L].Presheaf) (G : RingedLattice[l].On[M].Presheaf) {
 module O = DL.Order[M] ;
 module J = DL.Joins[M] ;
 module GO = RingedLattice[l].On[M].Of[G] ;
 module MP = LocallyRinged[l].Maps[L,M,F,G] ;
 module EQ = MapEquality[l].Maps[L,M,F,G] ;

 -- equal maps have equal images after restriction to a common open
 restrict-eq (pi : MP.Ringed) : (pi2 : MP.Ringed) -> Id MP.Ringed pi pi2 ->
  (u : L.L) (w : M.L) (k : O.Le w (DL.hmap pi.lat u)) (k2 : O.Le w (DL.hmap pi2.lat u)) (s : (F.ring u).R) ->
  Id (G.ring w).R (GO.restrict w (DL.hmap pi.lat u) k (map (pi.sharp u) s))
   (GO.restrict w (DL.hmap pi2.lat u) k2 (map (pi2.sharp u) s)) =
  \ pi2 p -> idJ MP.Ringed pi
   (\ pi3 p3 -> (u : L.L) (w : M.L) (k : O.Le w (DL.hmap pi.lat u)) (k3 : O.Le w (DL.hmap pi3.lat u)) (s : (F.ring u).R) ->
    Id (G.ring w).R (GO.restrict w (DL.hmap pi.lat u) k (map (pi.sharp u) s))
     (GO.restrict w (DL.hmap pi3.lat u) k3 (map (pi3.sharp u) s)))
   (\ u w k k3 s -> GO.res-irr w (DL.hmap pi.lat u) k k3 (map (pi.sharp u) s)) pi2 p ;

 LatticeOn (pi pi2 : MP.Ringed) (e : M.L) : U l =
  (u : L.L) -> Id M.L (M.meet (DL.hmap pi.lat u) e) (M.meet (DL.hmap pi2.lat u) e) ;
 SectionsOn (pi pi2 : MP.Ringed) (e : M.L) : U l =
  (u : L.L) (w : M.L) -> O.Le w e -> (k : O.Le w (DL.hmap pi.lat u)) (k2 : O.Le w (DL.hmap pi2.lat u)) (s : (F.ring u).R) ->
   Id (G.ring w).R (GO.restrict w (DL.hmap pi.lat u) k (map (pi.sharp u) s))
    (GO.restrict w (DL.hmap pi2.lat u) k2 (map (pi2.sharp u) s)) ;
 AgreeOn (pi pi2 : MP.Ringed) (e : M.L) : U l = LatticeOn pi pi2 e * SectionsOn pi pi2 e ;
 lattice-on {pi pi2 : MP.Ringed} {e : M.L} (h : AgreeOn pi pi2 e) : LatticeOn pi pi2 e = h.1 ;
 sections-on {pi pi2 : MP.Ringed} {e : M.L} (h : AgreeOn pi pi2 e) : SectionsOn pi pi2 e = h.2 ;

 module Cover (sheaf : GO.IsSheaf) (n : Nat) (es : Fin n -> M.L) (covers : O.Le M.top (J.bigJ n es)) {
  module LC = LatticeCover[l].Over[M,n,es,covers] ;
  module SG = RingedLattice[l].On[M].Sheaf[G,sheaf] ;
  module Compare (pi pi2 : MP.Ringed) (h : (i : Fin n) -> AgreeOn pi pi2 (es i)) {
   lat-eq (u : L.L) : Id M.L (DL.hmap pi.lat u) (DL.hmap pi2.lat u) =
    LC.ext (DL.hmap pi.lat u) (DL.hmap pi2.lat u) (\ i -> lattice-on (h i) u) ;
   le (u : L.L) : O.Le (DL.hmap pi2.lat u) (DL.hmap pi.lat u) =
    O.le-of-eq (DL.hmap pi2.lat u) (DL.hmap pi.lat u) (sym (lat-eq u)) ;
   module At (u : L.L) {
    pieces (i : Fin n) : M.L = M.meet (DL.hmap pi2.lat u) (es i) ;
    piece-le (i : Fin n) : O.Le (pieces i) (DL.hmap pi2.lat u) = O.meet-left (DL.hmap pi2.lat u) (es i) ;
    piece-pi (i : Fin n) : O.Le (pieces i) (DL.hmap pi.lat u) =
     O.le-trans (pieces i) (DL.hmap pi2.lat u) (DL.hmap pi.lat u) (piece-le i) (le u) ;
    module C = SG.Cover[DL.hmap pi2.lat u,n,pieces,piece-le,LC.covered (DL.hmap pi2.lat u)] ;
    on-piece (s : (F.ring u).R) (i : Fin n) :
     Id (G.ring (pieces i)).R
      (GO.restrict (pieces i) (DL.hmap pi2.lat u) (piece-le i)
       (GO.restrict (DL.hmap pi2.lat u) (DL.hmap pi.lat u) (le u) (map (pi.sharp u) s)))
      (GO.restrict (pieces i) (DL.hmap pi2.lat u) (piece-le i) (map (pi2.sharp u) s)) =
     trans (G.res-comp (pieces i) (DL.hmap pi2.lat u) (DL.hmap pi.lat u) (piece-le i) (le u) (piece-pi i) (map (pi.sharp u) s))
      (sections-on (h i) u (pieces i) (O.meet-right (DL.hmap pi2.lat u) (es i)) (piece-pi i) (piece-le i) s) ;
    sharp-eq (s : (F.ring u).R) : Id (G.ring (DL.hmap pi2.lat u)).R
     (GO.restrict (DL.hmap pi2.lat u) (DL.hmap pi.lat u) (le u) (map (pi.sharp u) s)) (map (pi2.sharp u) s) =
     C.separated (GO.restrict (DL.hmap pi2.lat u) (DL.hmap pi.lat u) (le u) (map (pi.sharp u) s))
      (map (pi2.sharp u) s) (on-piece s) ;
   } ;
   separated : Id MP.Ringed pi pi2 = EQ.ext pi pi2 lat-eq le (\ u s -> At[u].sharp-eq s) ;
  } ;
 } ;
} ;
