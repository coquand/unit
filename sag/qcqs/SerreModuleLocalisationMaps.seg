-- Localising semilinear maps (Serre note, Section 3).
-- A semilinear map carries the n-fold f-action to the n-fold h(f)-action.
-- It therefore carries witnesses of fraction equality to such witnesses
-- and descends uniquely to the quotient. Its formula on fractions and
-- uniqueness are exposed before the induced map is made opaque.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module LC = SerreModuleLocalisation[l] ;
module Along (A B : CRing) (h : RingHom[l].Hom A B)
 (Md : SM.Over[A].Module) (Nd : SM.Over[B].Module)
 (v : MM.Between[A,B,h,Md,Nd].Hom) (f : A.R) {
 module H = MM.Between[A,B,h,Md,Nd] ;
 module S = LC.At[A,Md,f] ;
 module T = LC.At[B,Nd,RingMaps[l].map h f] ;
 power-map : (n : Nat) (x : Md.M) ->
  Id Nd.M (H.map v (S.power n x)) (T.power n (H.map v x)) = split {
  zero -> \ x -> trans (ap (H.map v) (S.power-at-zero x)) (sym (T.power-at-zero (H.map v x))) ;
  suc n | ih -> \ x -> trans (ap (H.map v) (S.power-at-suc n x))
   (trans (H.map-scale v f (S.power n x))
    (trans (ap (Nd.sm (RingMaps[l].map h f)) (ih x)) (sym (T.power-at-suc n (H.map v x))))) } ;
 witness (x y : Md.M) (p q : Nat) (w : S.Witness (x,p) (y,q)) :
  T.Witness (H.map v x,p) (H.map v y,q) =
  (w.1,trans (sym (power-map (plus w.1 q) x))
   (trans (ap (H.map v) w.2) (power-map (plus w.1 p) y))) ;
 respects (x y : Md.M) (p q : Nat) (e : S.Relation (x,p) (y,q)) :
  Id T.Carrier (T.fraction (H.map v x) p) (T.fraction (H.map v y) q) =
  Tr.Trunc[S.Witness (x,p) (y,q)].induction @l
   (\ w -> Id T.Carrier (T.fraction (H.map v x) p) (T.fraction (H.map v y) q))
   (\ w -> T.carrier-set _ _)
   (\ w -> T.equal (H.map v x) (H.map v y) p q
    (Tr.Trunc[T.Witness (H.map v x,p) (H.map v y,q)].inc (witness x y p q w))) e ;
 module D = S.Descend[T.Carrier,T.carrier-set,\ x p -> T.fraction (H.map v x) p,respects] ;
 induced (x : S.Carrier) : T.Carrier = D.map x ;
 fraction-map (x : Md.M) (p : Nat) :
  Id T.Carrier (induced (S.fraction x p)) (T.fraction (H.map v x) p) = D.beta x p ;
 unique (k : S.Carrier -> T.Carrier)
  (on-fractions : (x : Md.M) (p : Nat) -> Id T.Carrier (k (S.fraction x p)) (T.fraction (H.map v x) p)) :
  (x : S.Carrier) -> Id T.Carrier (induced x) (k x) =
  S.induction @l (\ x -> Id T.Carrier (induced x) (k x)) (\ x -> T.carrier-set _ _)
   (\ x p -> trans (fraction-map x p) (sym (on-fractions x p))) ;
 opaque induced ;
} ;
