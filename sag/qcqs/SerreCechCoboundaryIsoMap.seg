-- A coboundary translates twisted coordinate torsors (Serre §5).
-- If d=c+delta(b), send x_i to x_i+b_i. The difference on an overlap
-- is the old difference plus delta(b), hence d. Restriction commutes
-- with these coordinate translations. Addition of a module section
-- commutes with adding the fixed b_i, so the map is equivariant.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module DL = DistLattice[l] ;
module MS = SerreModuleSheaf[l] ; module SM = SerreModule[l] ;
module On (L : DL.DLat) (G : RingedLattice[l].On[L].Presheaf)
 (M : MS.On[L,G].ModuleSheaf) (n : Nat) (as : Fin n -> L.L)
 (covers : DL.Order[L].Le L.top (DL.Joins[L].bigJ n as)) {
 module Z = SerreCechCocycles[l].On[L,G,M,n,as] ; module C = Z.C ;
 module O = DL.Order[L] ; module MO = C.MO ;
 module Maps = SerreCechIsoClassMaps[l].On[L,G,M] ;
 module Translation (c d : Z.Cocycle) (bs : C.C0.Carrier)
  (cochain-eq : Id C.C1.Carrier (Z.value d) (C.C1.product.madd (Z.value c) (C.delta bs))) {
  module Source = SerreCechTorsorLocal[l].On[L,G,M,n,as,c,covers] ;
  module Target = SerreCechTorsorLocal[l].On[L,G,M,n,as,d,covers] ;
  module T = Source.T ; module V = Target.T ;
  correction (a : L.L) (i : Fin n) : (M.presheaf.module-at (L.meet a (as i))).M =
   MO.restrict (L.meet a (as i)) (as i) (O.meet-right a (as i)) (bs i) ;
  module Pair (a : L.L) (p : T.PairIndex) {
   module P = V.Pair[a,p] ; module SP = T.Pair[a,p] ;
   wi : O.Le P.domain (as p.1) = O.le-trans P.domain (L.meet a (as p.1)) (as p.1) P.below-left (O.meet-right a (as p.1)) ;
   wj : O.Le P.domain (as p.2) = O.le-trans P.domain (L.meet a (as p.2)) (as p.2) P.below-right (O.meet-right a (as p.2)) ;
   module B = C.Below[P.domain,p.1,p.2,wi,wj] ;
   module Additive = SerreCechAlgebra[l].Over[G.ring P.domain,M.presheaf.module-at P.domain] ;
   left : Id (M.presheaf.module-at P.domain).M (P.left (correction a)) (MO.restrict P.domain (as p.1) wi (bs p.1)) =
    M.presheaf.res-comp P.domain (L.meet a (as p.1)) (as p.1) P.below-left (O.meet-right a (as p.1)) wi (bs p.1) ;
   right : Id (M.presheaf.module-at P.domain).M (P.right (correction a)) (MO.restrict P.domain (as p.2) wj (bs p.2)) =
    M.presheaf.res-comp P.domain (L.meet a (as p.2)) (as p.2) P.below-right (O.meet-right a (as p.2)) wj (bs p.2) ;
   boundary : Id (M.presheaf.module-at P.domain).M
    (P.Laws.sub (P.right (correction a)) (P.left (correction a)))
    (MO.restrict P.domain (C.overlap p.1 p.2) P.below-overlap (C.delta bs p.1 p.2)) =
    trans (cong2 (M.presheaf.module-at P.domain).M P.Laws.sub _ _ _ _ right left)
     (trans (sym (B.delta-res bs))
      (MO.res-irr P.domain (C.overlap p.1 p.2) B.meet-below P.below-overlap (C.delta bs p.1 p.2))) ;
   source-difference (x : T.Fibre.Section a) : Id (M.presheaf.module-at P.domain).M
    (P.Laws.sub (P.right (T.Fibre.value a x)) (P.left (T.Fibre.value a x)))
    (MO.restrict P.domain (C.overlap p.1 p.2) P.below-overlap (Z.value c p.1 p.2)) =
    trans (cong2 (M.presheaf.module-at P.domain).M P.Laws.sub _ _ _ _
     (MO.res-irr P.domain (L.meet a (as p.2)) P.below-right SP.below-right (T.Fibre.value a x p.2))
     (MO.res-irr P.domain (L.meet a (as p.1)) P.below-left SP.below-left (T.Fibre.value a x p.1)))
     (trans (ap (\ z -> z p) (T.section-equation a x))
      (MO.res-irr P.domain (C.overlap p.1 p.2) SP.below-overlap P.below-overlap (Z.value c p.1 p.2))) ;
   shifted (x : T.Fibre.Section a) : Id (M.presheaf.module-at P.domain).M
    (V.difference a (T.E.At[a].P.product.madd (T.Fibre.value a x) (correction a)) p) (V.twist a p) =
    trans (cong2 (M.presheaf.module-at P.domain).M P.Laws.sub _ _ _ _
     (MO.res-add P.domain (L.meet a (as p.2)) P.below-right (T.Fibre.value a x p.2) (correction a p.2))
     (MO.res-add P.domain (L.meet a (as p.1)) P.below-left (T.Fibre.value a x p.1) (correction a p.1)))
     (trans (Additive.sub-add (P.right (T.Fibre.value a x)) (P.right (correction a))
      (P.left (T.Fibre.value a x)) (P.left (correction a)))
      (trans (cong2 (M.presheaf.module-at P.domain).M (M.presheaf.module-at P.domain).madd _ _ _ _
       (source-difference x) boundary)
       (trans (sym (MO.res-add P.domain (C.overlap p.1 p.2) P.below-overlap (Z.value c p.1 p.2) (C.delta bs p.1 p.2)))
        (ap (MO.restrict P.domain (C.overlap p.1 p.2) P.below-overlap) (sym (ap (\ z -> z p.1 p.2) cochain-eq)))))) ;
  } ;
  move (a : L.L) (x : T.Fibre.Section a) : V.Fibre.Section a =
   V.make-section a (T.E.At[a].P.product.madd (T.Fibre.value a x) (correction a))
    (V.F.At[a].P.ext _ _ (\ p -> Pair[a,p].shifted x)) ;
  move-value (a : L.L) (x : T.Fibre.Section a) : Id V.E.At[a].P.Carrier
   (V.Fibre.value a (move a x)) (T.E.At[a].P.product.madd (T.Fibre.value a x) (correction a)) =
   V.make-value a (T.E.At[a].P.product.madd (T.Fibre.value a x) (correction a))
    (V.F.At[a].P.ext _ _ (\ p -> Pair[a,p].shifted x)) ;
  move-coordinate (a : L.L) (x : T.Fibre.Section a) (i : Fin n) :
   Id (M.presheaf.module-at (L.meet a (as i))).M (V.Fibre.value a (move a x) i)
    ((M.presheaf.module-at (L.meet a (as i))).madd (T.Fibre.value a x i) (correction a i)) = ap (\ z -> z i) (move-value a x) ;
  module Natural (a b : L.L) (k : O.Le a b) (x : T.Fibre.Section b) (i : Fin n) {
   da : L.L = L.meet a (as i) ; db : L.L = L.meet b (as i) ;
   le : O.Le da db = T.ChartPush[i].Push.mono a b k ;
   correction-res : Id (M.presheaf.module-at da).M (MO.restrict da db le (correction b i)) (correction a i) =
    M.presheaf.res-comp da db (as i) le (O.meet-right b (as i)) (O.meet-right a (as i)) (bs i) ;
   equation : Id (M.presheaf.module-at da).M
    (V.Fibre.value a (move a (T.Fibre.restrict a b k x)) i) (V.Fibre.value a (V.Fibre.restrict a b k (move b x)) i) =
    trans (move-coordinate a (T.Fibre.restrict a b k x) i)
     (trans (cong2 (M.presheaf.module-at da).M (M.presheaf.module-at da).madd _ _ _ _
      (Source.Action.restriction-coordinate a b k x i) (sym correction-res))
      (trans (sym (MO.res-add da db le (T.Fibre.value b x i) (correction b i)))
       (trans (ap (MO.restrict da db le) (sym (move-coordinate b x i)))
        (sym (Target.Action.restriction-coordinate a b k (move b x) i))))) ;
  } ;
  natural (a b : L.L) (k : O.Le a b) (x : T.Fibre.Section b) :
   Id (V.Fibre.Section a) (move a (T.Fibre.restrict a b k x)) (V.Fibre.restrict a b k (move b x)) =
   V.Fibre.ext a _ _ (V.E.At[a].P.ext _ _ (\ i -> Natural[a,b,k,x,i].equation)) ;
  module Equivariance (a : L.L) (x : T.Fibre.Section a) (m : (M.presheaf.module-at a).M) (i : Fin n) {
   domain : L.L = L.meet a (as i) ;
   equation : Id (M.presheaf.module-at domain).M
    (V.Fibre.value a (move a (Source.Action.action a x m)) i)
    (V.Fibre.value a (Target.Action.action a (move a x) m) i) =
    trans (move-coordinate a (Source.Action.action a x m) i)
     (trans (ap (\ z -> (M.presheaf.module-at domain).madd z (correction a i)) (Source.Action.action-coordinate a x m i))
      (trans (sym ((M.presheaf.module-at domain).maddA (T.Fibre.value a x i) (Source.Action.diagonal a m i) (correction a i)))
       (trans (ap ((M.presheaf.module-at domain).madd (T.Fibre.value a x i))
        ((M.presheaf.module-at domain).maddC (Source.Action.diagonal a m i) (correction a i)))
        (trans ((M.presheaf.module-at domain).maddA (T.Fibre.value a x i) (correction a i) (Source.Action.diagonal a m i))
         (trans (ap (\ z -> (M.presheaf.module-at domain).madd z (Source.Action.diagonal a m i)) (sym (move-coordinate a x i)))
          (sym (Target.Action.action-coordinate a (move a x) m i))))))) ;
  } ;
  equivariant (a : L.L) (x : T.Fibre.Section a) (m : (M.presheaf.module-at a).M) :
   Id (V.Fibre.Section a) (move a (Source.Action.action a x m)) (Target.Action.action a (move a x) m) =
   V.Fibre.ext a _ _ (V.E.At[a].P.ext _ _ (\ i -> Equivariance[a,x,m,i].equation)) ;
  morphism : Maps.Between[Source.torsor,Target.torsor].EquivariantMap =
   new Maps.Between[Source.torsor,Target.torsor].EquivariantMap[move,natural,equivariant] ;
  morphism-at (a : L.L) (x : T.Fibre.Section a) : Id (V.Fibre.Section a) (morphism.at a x) (move a x) = refl (move a x) ;
  opaque move ; opaque morphism ;
 } ;
} ;
