-- Affine torsor triviality for an associated module (note, Lemma
-- lem:affine-torsor, for M = assoc(N) on Spec A).
-- Let T be a torsor under assoc(N). Local inhabitation of the top open
-- merely gives a finite cover u_1 \/ .. \/ u_n with sections; refine it by
-- principal opens D(f_k) <= u_(i_k) (ZariskiLattice.refined) and restrict
-- the sections: t_k in T(D f_k), and top <= D f_1 \/ .. \/ D f_m.
-- Write t_i = t_j + c_ij on D f_i /\ D f_j (SerreTorsorCech) and take the
-- component c'_ij of the section c_ij at f_i f_j: an element of N_(f_i f_j),
-- that is, the basic evaluation of c_ij. Components restrict to components,
-- so restricting c'_ki, c'_ij, c'_kj to N_(f_k f_i f_j) gives the components
-- there of c_ki, c_ij, c_kj; uniqueness of differences (the torsor cocycle
-- law) gives c'_ki + c'_ij = c'_kj there. Degree-one gluing
-- (SerreModuleCechGluing) merely gives b_i in N_(f_i) with
-- b_j - b_i = c'_ij. Extend b_i to the section e_i of assoc(N) on D f_i.
-- At every D h <= D f_i /\ D f_j, the components satisfy
--  (c_ij)_h = rho(c'_ij) = rho(b_j) - rho(b_i) = (e_j)_h - (e_i)_h,
-- so c_ij + e_i = e_j on the overlap, and t_i + e_i glue to a global
-- section. All choices stay inside the truncation. The empty cover is the
-- case n = 0 of the same argument (the empty-cover sheaf axiom glues).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module SM = SerreModule[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (Md : SM.Over[A].Module) {
 module Sh = SerreAssociatedSheaf[l].Over[A,setA,Md] ;
 module AM = Sh.AM ; module S = Sh.S ; module B = Sh.B ;
 module R = AM.R ; module Z = AM.Z ; module O = Z.O ;
 module Data = SerreModuleGluingData[l].Over[A,setA,Md] ;
 module MO = SerreModuleSheaf[l].On[Z.lattice,AM.G.SH.structure].Of[Sh.associated.presheaf] ;
 module Torsors = SerreTorsor[l].On[Z.lattice,AM.G.SH.structure].Over[Sh.associated] ;
 -- by definition of restriction of associated sections
 at-restrict (u v : Z.lattice.L) (vu : O.Le v u) (s : S.Section u) (h : A.R) (k : O.Le (Z.D h) v) :
  Id R.Local[h].Native.L.Carrier (S.at (MO.restrict v u vu s) h k) (S.at s h (O.le-trans (Z.D h) v u k vu)) =
  ap (\ t -> S.at t h k) (S.restriction-map v u vu s) ;
 -- a component restricts to the component below it
 restrict-component (u : Z.lattice.L) (s : S.Section u) (g h : A.R) (kg : O.Le (Z.D g) u)
  (hg : O.Le (Z.D h) (Z.D g)) (kh : O.Le (Z.D h) u) :
  Id R.Local[h].Native.L.Carrier (R.At[g,h,hg].map (S.at s g kg)) (S.at s h kh) =
  trans (sym (AM.component-restriction g h hg (S.at s g kg)))
   (trans (S.compat s g h kg hg) (S.component-irr u s h (O.le-trans (Z.D h) (Z.D g) u hg kg) kh)) ;
 -- the extension of x in N_g has component rho(x) at D h <= D g
 extend-component (g h : A.R) (x : R.Local[g].Native.L.Carrier) (k : O.Le (Z.D h) (Z.D g)) :
  Id R.Local[h].Native.L.Carrier (S.at (B.At[g].extend x) h k) (R.At[g,h,k].map x) =
  trans (B.At[g].extend-at x h k) (AM.component-restriction g h k x) ;
 overlap-below (f g : A.R) : O.Le (Z.D (A.mul f g)) (Z.lattice.meet (Z.D f) (Z.D g)) =
  O.meet-glb (Z.D f) (Z.D g) (Z.D (A.mul f g)) (Data.left f g) (Data.right f g) ;
 overlap-above (f g : A.R) : O.Le (Z.lattice.meet (Z.D f) (Z.D g)) (Z.D (A.mul f g)) =
  O.le-of-eq (Z.lattice.meet (Z.D f) (Z.D g)) (Z.D (A.mul f g)) (sym (Data.Support.at-mul f g)) ;

 -- a principal cover of the top open with sections of T
 module Principal (T : Torsors.Torsor) (n : Nat) (fs : Fin n -> A.R)
  (covers : O.Le Z.lattice.top (Z.J.bigJ n (\ i -> Z.D (fs i))))
  (ts : (i : Fin n) -> T.presheaf.obj (Z.D (fs i))) {
  module TC = SerreTorsorCech[l].On[Z.lattice,AM.G.SH.structure,Sh.associated,T,n,\ i -> Z.D (fs i),covers,ts] ;
  module D = SerreModuleCechGluingData[l].Over[A,setA,Md].Cover[n,fs,covers] ;
  -- c'_ij: the component at f_i f_j of the difference c_ij
  cochain : D.Cochain = \ i j -> S.at (TC.cocycle i j) (A.mul (fs i) (fs j)) (overlap-below (fs i) (fs j)) ;
  cochain-restricts (i j : Fin n) (h : A.R) (e : O.Le (Z.D h) (Z.D (A.mul (fs i) (fs j))))
   (k : O.Le (Z.D h) (TC.overlap i j)) :
   Id R.Local[h].Native.L.Carrier (R.At[A.mul (fs i) (fs j),h,e].map (cochain i j)) (S.at (TC.cocycle i j) h k) =
   restrict-component (TC.overlap i j) (TC.cocycle i j) (A.mul (fs i) (fs j)) h (overlap-below (fs i) (fs j)) e k ;
  -- the cocycle law in N_(f_k f_i f_j)
  module Law (k i j : Fin n) {
   module T3 = D.Triple[k,i,j] ;
   w : Z.lattice.L = Z.D T3.domain ;
   here : O.Le w w = O.le-refl w ;
   module Pair (a b : Fin n) (wa : O.Le w (Z.D (fs a))) (wb : O.Le w (Z.D (fs b)))
    (e : O.Le w (Z.D (A.mul (fs a) (fs b)))) {
    below : O.Le w (TC.overlap a b) = TC.Below[w,a,b,wa,wb].meet-below ;
    restricted : R.Local[T3.domain].Native.L.Carrier =
     S.at (MO.restrict w (TC.overlap a b) below (TC.cocycle a b)) T3.domain here ;
    image : Id R.Local[T3.domain].Native.L.Carrier
     (R.At[A.mul (fs a) (fs b),T3.domain,e].map (cochain a b)) restricted =
     trans (cochain-restricts a b T3.domain e (O.le-trans w w (TC.overlap a b) here below))
      (sym (at-restrict (TC.overlap a b) w below (TC.cocycle a b) T3.domain here)) ;
   } ;
   module KI = Pair[k,i,T3.below-k,T3.below-i,T3.below-ki] ;
   module IJ = Pair[i,j,T3.below-i,T3.below-j,T3.below-ij] ;
   module KJ = Pair[k,j,T3.below-k,T3.below-j,T3.below-kj] ;
   law : T3.Law cochain = calc R.Local[T3.domain].Native.L.Carrier {
    T3.P.Native.localised.madd (T3.KI.map (cochain k i)) (T3.IJ.map (cochain i j))
     =< cong2 R.Local[T3.domain].Native.L.Carrier T3.P.Native.localised.madd _ _ _ _ KI.image IJ.image
      > T3.P.Native.localised.madd KI.restricted IJ.restricted
     =< sym (S.Ops[w].add-at (MO.restrict w (TC.overlap k i) KI.below (TC.cocycle k i))
          (MO.restrict w (TC.overlap i j) IJ.below (TC.cocycle i j)) T3.domain here)
      > S.at (S.Ops[w].add (MO.restrict w (TC.overlap k i) KI.below (TC.cocycle k i))
          (MO.restrict w (TC.overlap i j) IJ.below (TC.cocycle i j))) T3.domain here
     =< ap (\ s -> S.at s T3.domain here)
          (TC.cocycle-law w k i j T3.below-k T3.below-i T3.below-j)
      > KJ.restricted
     =< sym KJ.image > T3.KJ.map (cochain k j) } ;
  } ;
  cocycle : D.CocycleLaw cochain = \ k i j -> Law[k,i,j].law ;
  -- a coboundary for c' corrects the local sections
  module Corrected (bs : D.C.Families) (boundary : D.Boundary cochain bs) {
   section (i : Fin n) : S.Section (Z.D (fs i)) = B.At[fs i].extend (bs i) ;
   module At (i j : Fin n) (h : A.R) (k : O.Le (Z.D h) (TC.overlap i j)) {
    module Q = D.C.Pair[i,j] ;
    module Sub = Data.Local[h].Laws ;
    module Group = SerreCechAlgebra[l].Over[A,R.Local[h].Native.localised] ;
    ki : O.Le (Z.D h) (Z.D (fs i)) = O.le-trans (Z.D h) (TC.overlap i j) (Z.D (fs i)) k (O.meet-left (Z.D (fs i)) (Z.D (fs j))) ;
    kj : O.Le (Z.D h) (Z.D (fs j)) = O.le-trans (Z.D h) (TC.overlap i j) (Z.D (fs j)) k (O.meet-right (Z.D (fs i)) (Z.D (fs j))) ;
    e : O.Le (Z.D h) (Z.D Q.overlap) = O.le-trans (Z.D h) (TC.overlap i j) (Z.D Q.overlap) k (overlap-above (fs i) (fs j)) ;
    module Down = R.At[Q.overlap,h,e] ;
    module Lin = SerreModuleClearErrors[l].Over[A].Along[Q.P.Native.localised,R.Local[h].Native.localised,Down.native] ;
    left : R.Local[h].Native.L.Carrier = R.At[fs i,h,ki].map (bs i) ;
    right : R.Local[h].Native.L.Carrier = R.At[fs j,h,kj].map (bs j) ;
    difference : Id R.Local[h].Native.L.Carrier (S.at (TC.cocycle i j) h k) (Sub.sub right left) =
     calc R.Local[h].Native.L.Carrier {
      S.at (TC.cocycle i j) h k
       =< sym (cochain-restricts i j h e k) > Down.map (cochain i j)
       =< ap Down.map (sym (boundary i j)) > Down.map (Q.P.Laws.sub (Q.Rho.map (bs j)) (Q.L.map (bs i)))
       =< Lin.map-sub (Q.Rho.map (bs j)) (Q.L.map (bs i))
        > Sub.sub (Down.map (Q.Rho.map (bs j))) (Down.map (Q.L.map (bs i)))
       =< cong2 R.Local[h].Native.L.Carrier Sub.sub _ _ _ _
           (R.rho-comp (fs j) Q.overlap h (Data.right (fs i) (fs j)) e kj (bs j))
           (R.rho-comp (fs i) Q.overlap h (Data.left (fs i) (fs j)) e ki (bs i))
        > Sub.sub right left } ;
    corrected : Id R.Local[h].Native.L.Carrier
     (R.Local[h].Native.localised.madd (S.at (TC.cocycle i j) h k)
      (S.at (MO.restrict (TC.overlap i j) (Z.D (fs i)) (O.meet-left (Z.D (fs i)) (Z.D (fs j))) (section i)) h k))
     (S.at (MO.restrict (TC.overlap i j) (Z.D (fs j)) (O.meet-right (Z.D (fs i)) (Z.D (fs j))) (section j)) h k) =
     calc R.Local[h].Native.L.Carrier {
      R.Local[h].Native.localised.madd (S.at (TC.cocycle i j) h k)
       (S.at (MO.restrict (TC.overlap i j) (Z.D (fs i)) (O.meet-left (Z.D (fs i)) (Z.D (fs j))) (section i)) h k)
       =< cong2 R.Local[h].Native.L.Carrier R.Local[h].Native.localised.madd _ _ _ _ difference
           (trans (at-restrict (Z.D (fs i)) (TC.overlap i j) (O.meet-left (Z.D (fs i)) (Z.D (fs j))) (section i) h k)
            (extend-component (fs i) h (bs i) ki))
        > R.Local[h].Native.localised.madd (Sub.sub right left) left
       =< Group.sub-plus-right right left > right
       =< sym (trans (at-restrict (Z.D (fs j)) (TC.overlap i j) (O.meet-right (Z.D (fs i)) (Z.D (fs j))) (section j) h k)
           (extend-component (fs j) h (bs j) kj))
        > S.at (MO.restrict (TC.overlap i j) (Z.D (fs j)) (O.meet-right (Z.D (fs i)) (Z.D (fs j))) (section j)) h k } ;
   } ;
   equation (i j : Fin n) : Id (S.Section (TC.overlap i j))
    (S.Ops[TC.overlap i j].add (TC.cocycle i j)
     (MO.restrict (TC.overlap i j) (Z.D (fs i)) (O.meet-left (Z.D (fs i)) (Z.D (fs j))) (section i)))
    (MO.restrict (TC.overlap i j) (Z.D (fs j)) (O.meet-right (Z.D (fs i)) (Z.D (fs j))) (section j)) =
    S.section-ext (TC.overlap i j) _ _ (\ h k -> At[i,j,h,k].corrected) ;
   global : T.presheaf.obj Z.lattice.top = TC.Correction[section,equation].global-section ;
  } ;
  global : Tr.Trunc[T.presheaf.obj Z.lattice.top].carrier =
   Tr.Trunc[(bs : D.C.Families) * D.Boundary cochain bs].induction @l
    (\ q -> Tr.Trunc[T.presheaf.obj Z.lattice.top].carrier)
    (\ q -> Tr.Trunc[T.presheaf.obj Z.lattice.top].proposition)
    (\ b -> Tr.Trunc[T.presheaf.obj Z.lattice.top].inc Corrected[b.1,b.2].global)
    (SerreModuleCechGluing[l].Over[A,setA,Md].Cover[n,fs,covers].vanishing cochain cocycle) ;
 } ;

 -- refine a cover with sections by principal opens
 module Refine (T : Torsors.Torsor) (n : Nat) (us : Fin n -> Z.lattice.L)
  (covers : O.Le Z.lattice.top (Z.J.bigJ n us)) (ts : (i : Fin n) -> T.presheaf.obj (us i))
  (r : Z.Refinement n us) {
  principal-covers : O.Le Z.lattice.top (Z.J.bigJ (Z.count r) (\ k -> Z.D (Z.piece r k))) =
   Pr.subst Z.lattice.L (\ x -> O.Le Z.lattice.top x) (Z.J.bigJ n us)
    (Z.J.bigJ (Z.count r) (\ k -> Z.D (Z.piece r k))) (Z.refines r) covers ;
  sections (k : Fin (Z.count r)) : T.presheaf.obj (Z.D (Z.piece r k)) =
   T.presheaf.res (Z.D (Z.piece r k)) (us (Z.tag r k)) (Z.tag-below r k) (ts (Z.tag r k)) ;
  global : Tr.Trunc[T.presheaf.obj Z.lattice.top].carrier =
   Principal[T,Z.count r,Z.piece r,principal-covers,sections].global ;
 } ;
 module Inhabited (T : Torsors.Torsor) {
  Local : U l = (n : Nat) * (us : Fin n -> Z.lattice.L) * ((i : Fin n) -> O.Le (us i) Z.lattice.top)
   * O.Le Z.lattice.top (Z.J.bigJ n us) * ((i : Fin n) -> T.presheaf.obj (us i)) ;
  from-local (c : Local) : Tr.Trunc[T.presheaf.obj Z.lattice.top].carrier =
   Tr.Trunc[Z.Refinement c.1 c.2.1].induction @l
    (\ q -> Tr.Trunc[T.presheaf.obj Z.lattice.top].carrier)
    (\ q -> Tr.Trunc[T.presheaf.obj Z.lattice.top].proposition)
    (\ r -> Refine[T,c.1,c.2.1,c.2.2.2.1,c.2.2.2.2,r].global)
    (Z.refined c.1 c.2.1) ;
  global : Tr.Trunc[T.presheaf.obj Z.lattice.top].carrier =
   Tr.Trunc[Local].induction @l
    (\ q -> Tr.Trunc[T.presheaf.obj Z.lattice.top].carrier)
    (\ q -> Tr.Trunc[T.presheaf.obj Z.lattice.top].proposition)
    from-local (T.local-sections Z.lattice.top) ;
 } ;
 -- Lemma lem:affine-torsor for assoc(N): every torsor merely has a global section
 acyclic : Torsors.Acyclic1 = \ T -> Inhabited[T].global ;
} ;
