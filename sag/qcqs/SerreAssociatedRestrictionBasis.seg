-- The associated-module restriction comparison on image-A basic opens.
-- Evaluate the associated M_g-module at D(incl a), use iterated module
-- localisation to reach M_(a*g), and the canonical equal-open restriction
-- to M_(g*a). The actual chart scalar map is supplied by the evaluated
-- ringed chart. Its equation on A_g promotes the native comparison to
-- semilinearity over (A_g)_(incl a), by scalar naturality.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module RH = RingHom[l] ; module RM = RingMaps[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (Md : SM.Over[A].Module) (g : A.R) {
 module Raw = SerreAssociatedRestrictionLocal[l].Over[A,setA,Md,g] ;
 module R = Raw.R ; module AF = R.AF ; module ZA = R.Z ; module O = ZA.O ;
 module Geometry = SerreSpecBasicOpenBasis[l].Over[A,setA,g] ;
 module Rings = SerreSpecBasicOpenRings[l].Over[A,setA,g] ;
 module Cht = Geometry.Cht ;
 module Source = SerreAssociatedSheaf[l].Over[AF.Loc g,AF.set g,Raw.Mg.localised] ;
 module SB = SerreAssociatedBasicOpen[l].Over[AF.Loc g,Source.AM.AF.Loc,Source.AM.AF.set,
  Source.AM.AF.inclusion,Source.AM.AF.elementary,Source.AM.system] ;
 module Original = SerreAssociatedSheaf[l].Over[A,setA,Md] ;
 module AB = SerreAssociatedBasicOpen[l].Over[A,AF.Loc,AF.set,AF.inclusion,AF.elementary,Original.AM.system] ;
 module At (a : A.R) {
  module RR = Rings.Basic[a] ; module Native = Raw.Basic[a] ;
  ag : A.R = A.mul a g ;
  ga : A.R = A.mul g a ;
  below : O.Le (ZA.D ga) (ZA.D ag) = O.le-of-eq _ _ (ap ZA.D (A.mulC g a)) ;
  reverse-below : O.Le (ZA.D ag) (ZA.D ga) = O.le-of-eq _ _ (ap ZA.D (A.mulC a g)) ;
  module Swap = Raw.Along[ag,ga,Native.I.OL.below,RR.original-below,below] ;
  module Back = R.At[ga,ag,reverse-below] ;
  swap-equivalence : Pr.isEquiv R.Local[ag].Native.L.Carrier R.Local[ga].Native.L.Carrier Swap.P.map =
   Pr.qinv R.Local[ag].Native.L.Carrier R.Local[ga].Native.L.Carrier Swap.P.map Back.map
    (\ x -> trans (R.rho-comp ga ag ga reverse-below below (O.le-refl (ZA.D ga)) x) (R.rho-id ga (O.le-refl (ZA.D ga)) x))
    (\ x -> trans (R.rho-comp ag ga ag below reverse-below (O.le-refl (ZA.D ag)) x) (R.rho-id ag (O.le-refl (ZA.D ag)) x)) ;
  module NativeMaps = MM.Between[AF.Loc g,AF.Loc g,RH.identity (AF.Loc g),Native.Native.Source.localised,Swap.TS.restricted] ;
  native : NativeMaps.Hom = new NativeMaps.Hom[
   \ x -> Swap.Maps.map Swap.restriction (Native.map x),
   \ x y -> trans (ap (Swap.Maps.map Swap.restriction) (Native.Native.To.map-add Native.native-map x y))
    (Swap.Maps.map-add Swap.restriction (Native.map x) (Native.map y)),
   \ r x -> trans (ap (Swap.Maps.map Swap.restriction) (Native.Native.To.map-scale Native.native-map r x))
    (Swap.Maps.map-scale Swap.restriction r (Native.map x))] ;
  native-at (x : Native.I.SourcePower.Carrier) :
   Id R.Local[ga].Native.L.Carrier (NativeMaps.map native x) (Swap.P.map (Native.map x)) =
   Swap.restriction-at (Native.map x) ;
  native-equivalence : Pr.isEquiv Native.I.SourcePower.Carrier R.Local[ga].Native.L.Carrier (NativeMaps.map native) =
   Iso[l].equiv-homotopy _ _ (\ x -> Swap.P.map (Native.map x)) (NativeMaps.map native)
    (\ x -> sym (native-at x))
    (Iso[l].equiv-compose Native.I.SourcePower.Carrier R.Local[ag].Native.L.Carrier R.Local[ga].Native.L.Carrier
     Swap.P.map Native.map swap-equivalence Native.equivalence) ;
  module SourceModule = Source.BR.Local[RR.b].Scalars ;
  module TargetModule = R.Local[ga].Scalars ;
  module SourceRestricted = MM.RestrictScalars[AF.Loc g,Source.AM.AF.Loc RR.b,Source.AM.AF.inclusion RR.b].Of[SourceModule.localised] ;
  module TargetModuleRestricted = MM.RestrictScalars[Source.AM.AF.Loc RR.b,AF.Loc ga,RR.local-map].Of[TargetModule.localised] ;
  module TargetRestricted = MM.RestrictScalars[AF.Loc g,Source.AM.AF.Loc RR.b,Source.AM.AF.inclusion RR.b].Of[TargetModuleRestricted.restricted] ;
  module RestrictedMaps = MM.Between[AF.Loc g,AF.Loc g,RH.identity (AF.Loc g),SourceRestricted.restricted,TargetRestricted.restricted] ;
  source-scalar (r : (AF.Loc g).R) (x : Native.I.SourcePower.Carrier) :
   Id Native.I.SourcePower.Carrier (SourceRestricted.restricted.sm r x) (Native.Native.Source.localised.sm r x) =
   trans (SourceRestricted.scalar-at r x)
    (trans (SourceModule.ER.module-scalar-at (RM.map (Source.AM.AF.inclusion RR.b) r) x) (SourceModule.ER.original-action r x)) ;
  target-scalar (r : (AF.Loc g).R) (x : R.Local[ga].Native.L.Carrier) :
   Id R.Local[ga].Native.L.Carrier (TargetRestricted.restricted.sm r x) (Swap.TS.restricted.sm r x) =
   trans (TargetRestricted.scalar-at r x)
    (trans (TargetModuleRestricted.scalar-at (RM.map (Source.AM.AF.inclusion RR.b) r) x)
     (trans (ap (\ b -> TargetModule.localised.sm b x) (RR.on-original r)) (sym (Swap.TS.scalar-at r x)))) ;
  restricted : RestrictedMaps.Hom = new RestrictedMaps.Hom[NativeMaps.map native,NativeMaps.map-add native,
   \ r x -> trans (ap (NativeMaps.map native) (source-scalar r x))
    (trans (NativeMaps.map-scale native r x) (sym (target-scalar r (NativeMaps.map native x))))] ;
  module Scalars = SerreModuleScalarNaturality[l].Over[AF.Loc g,AF.set g,RR.b,
   Source.AM.AF.Loc RR.b,Source.AM.AF.set RR.b,Source.AM.AF.inclusion RR.b,Source.AM.AF.elementary RR.b] ;
  module Promotion = Scalars.Between[SourceModule.localised,TargetModuleRestricted.restricted,restricted] ;
  module Maps = MM.Between[Source.AM.AF.Loc RR.b,AF.Loc ga,RR.local-map,SourceModule.localised,TargetModule.localised] ;
  linear : Maps.Hom = new Maps.Hom[Promotion.Maps.map Promotion.linear,Promotion.Maps.map-add Promotion.linear,
   \ r x -> trans (Promotion.Maps.map-scale Promotion.linear r x)
    (TargetModuleRestricted.scalar-at r (Promotion.Maps.map Promotion.linear x))] ;
  map (x : Native.I.SourcePower.Carrier) : R.Local[ga].Native.L.Carrier = Maps.map linear x ;
  map-native (x : Native.I.SourcePower.Carrier) : Id R.Local[ga].Native.L.Carrier (map x) (NativeMaps.map native x) = Promotion.linear-at x ;
  equivalence : Pr.isEquiv Native.I.SourcePower.Carrier R.Local[ga].Native.L.Carrier map =
   Iso[l].equiv-homotopy _ _ (NativeMaps.map native) map (\ x -> sym (map-native x)) native-equivalence ;
  on-original (x : Raw.Mg.localised.M) :
   Id R.Local[ga].Native.L.Carrier (map (Native.I.SourcePower.fraction x zero)) (R.At[g,ga,RR.original-below].map x) =
   trans (map-native (Native.I.SourcePower.fraction x zero))
    (trans (native-at (Native.I.SourcePower.fraction x zero))
     (trans (ap Swap.P.map (Native.on-original x))
      (R.rho-comp g ag ga Native.I.OL.below below RR.original-below x))) ;
  opaque native ; opaque restricted ; opaque linear ;
 } ;
} ;
