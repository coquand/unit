-- Localisation preserves equalisers (Serre note, Section 3).
-- Express an equaliser as the kernel of the difference. On fractions,
-- localisation preserves that difference by the addition and negation
-- formulas. Kernel preservation followed by the canonical comparison
-- of kernels of pointwise equal maps gives the linear equaliser iso.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module LL = SerreModuleLocalisationLinear[l] ;
module Over (A : CRing) (B C : SM.Over[A].Module)
 (u v : MM.Between[A,A,RingHom[l].identity A,B,C].Hom) (f : A.R) {
 module Original = SerreModuleEqualiser[l].Over[A,B,C,u,v] ;
 module MapU = LL.Along[A,A,RingHom[l].identity A,B,C,u,f] ;
 module MapV = LL.Along[A,A,RingHom[l].identity A,B,C,v,f] ;
 module MapDifference = LL.Along[A,A,RingHom[l].identity A,B,C,Original.difference,f] ;
 module Target = SerreModuleEqualiser[l].Over[A,MapU.S.localised,MapU.T.localised,MapU.induced,MapV.induced] ;
 sub-fractions (x y : C.M) (p : Nat) : Id MapU.T.L.Carrier
  (Target.CL.sub (MapU.T.L.fraction x p) (MapU.T.L.fraction y p))
  (MapU.T.L.fraction (Original.CL.sub x y) p) =
  trans (Target.CL.sub-at (MapU.T.L.fraction x p) (MapU.T.L.fraction y p))
   (trans (ap (MapU.T.add (MapU.T.L.fraction x p)) (MapU.T.Action.negative-at y p))
    (trans (MapU.T.add-at x (C.mneg y) p) (ap (\ z -> MapU.T.L.fraction z p) (sym (Original.CL.sub-at x y))))) ;
 difference-compatible (x : MapU.S.L.Carrier) : Id MapU.T.L.Carrier
  (MapDifference.Maps.map MapDifference.induced x) (Target.H.map Target.difference x) =
  MapU.S.L.induction @l
   (\ x -> Id MapU.T.L.Carrier (MapDifference.Maps.map MapDifference.induced x) (Target.H.map Target.difference x))
   (\ x -> MapU.T.L.carrier-set _ _)
   (\ x p -> trans (MapDifference.induced-at x p)
    (trans (ap (\ y -> MapU.T.L.fraction y p) (Original.difference-at x))
     (trans (sym (sub-fractions (Original.H.map u x) (Original.H.map v x) p))
      (trans (cong2 MapU.T.L.Carrier Target.CL.sub _ _ _ _ (sym (MapU.induced-at x p)) (sym (MapV.induced-at x p)))
       (sym (Target.difference-at (MapU.S.L.fraction x p))))))) x ;
 module Kernel = SerreModuleLocalisationKernel[l].At[A,B,C,Original.difference,f] ;
 module SameKernel = SerreModuleKernelHomotopy[l].Over[A,MapU.S.localised,MapU.T.localised,
  MapDifference.induced,Target.difference,difference-compatible] ;
 kernel-equiv : Pr.isEquiv Kernel.S.L.Carrier Kernel.Target.Carrier (Kernel.Maps.map Kernel.comparison) =
  Iso[l].equiv-homotopy Kernel.S.L.Carrier Kernel.Target.Carrier Kernel.forward
   (Kernel.Maps.map Kernel.comparison) (\ x -> sym (Kernel.comparison-at x)) Kernel.equivalence.2 ;
 same-kernel-equiv : Pr.isEquiv SameKernel.S.Carrier SameKernel.T.Carrier (SameKernel.Maps.map SameKernel.comparison) =
  Iso[l].equiv-homotopy SameKernel.S.Carrier SameKernel.T.Carrier SameKernel.forward
   (SameKernel.Maps.map SameKernel.comparison) (\ x -> sym (SameKernel.comparison-at x)) SameKernel.equivalence ;
 module Maps = MM.Between[A,A,RingHom[l].identity A,Kernel.S.localised,Target.K.kernel] ;
 comparison : Maps.Hom = new Maps.Hom[
  \ x -> SameKernel.Maps.map SameKernel.comparison (Kernel.Maps.map Kernel.comparison x),
  \ x y -> trans (ap (SameKernel.Maps.map SameKernel.comparison) (Kernel.Maps.map-add Kernel.comparison x y))
   (SameKernel.Maps.map-add SameKernel.comparison (Kernel.Maps.map Kernel.comparison x) (Kernel.Maps.map Kernel.comparison y)),
  \ a x -> trans (ap (SameKernel.Maps.map SameKernel.comparison) (Kernel.Maps.map-scale Kernel.comparison a x))
   (SameKernel.Maps.map-scale SameKernel.comparison a (Kernel.Maps.map Kernel.comparison x))] ;
 comparison-at (x : Kernel.S.L.Carrier) : Id Target.K.Carrier (Maps.map comparison x)
  (SameKernel.Maps.map SameKernel.comparison (Kernel.Maps.map Kernel.comparison x)) =
  refl (SameKernel.Maps.map SameKernel.comparison (Kernel.Maps.map Kernel.comparison x)) ;
 equivalence : Pr.isEquiv Kernel.S.L.Carrier Target.K.Carrier (Maps.map comparison) =
  Iso[l].equiv-homotopy Kernel.S.L.Carrier Target.K.Carrier
   (\ x -> SameKernel.Maps.map SameKernel.comparison (Kernel.Maps.map Kernel.comparison x)) (Maps.map comparison)
   (\ x -> sym (comparison-at x))
   (Iso[l].equiv-compose Kernel.S.L.Carrier Kernel.Target.Carrier Target.K.Carrier
    (SameKernel.Maps.map SameKernel.comparison) (Kernel.Maps.map Kernel.comparison) same-kernel-equiv kernel-equiv) ;
 opaque comparison ;
} ;
