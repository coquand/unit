-- Affineness is invariant under isomorphisms.
-- Let pi : X -> Y be an isomorphism and Y affine.  Compose the canonical
-- Y -> Spec Gamma(Y) with pi.  This is an isomorphism X -> Spec Gamma(Y),
-- since both factors are isomorphisms.  AffineCriterion gives X affine.
-- Only the affine criterion and composition of isomorphisms are used.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module DL = DistLattice[l] ;
module Over (L M : DL.DLat) (Y : LocallyRinged[l].On[L].LocallyRinged)
 (X : LocallyRinged[l].On[M].LocallyRinged)
 (pi : LocallyRinged[l].Maps[L,M,Y.sheaf,X.sheaf].Ringed)
 (iso : Iso[l].Maps[L,M,Y.sheaf,X.sheaf].IsIso pi)
 (affineY : AffineCriterion[l].Over[L,Y].IsAffine) {
 module AY = AffineCriterion[l].Over[L,Y] ;
 module AX = AffineCriterion[l].Over[M,X] ;
 module C = Compose[l].Maps[AY.ZG.lattice,L,M,AY.Can.Sh.structure,Y.sheaf,X.sheaf].Of[pi,AY.canonical] ;
 composite-iso : Iso[l].Maps[AY.ZG.lattice,M,AY.Can.Sh.structure,X.sheaf].IsIso C.composite = C.iso affineY iso ;
 affine : AX.IsAffine =
  AX.Criterion[Y.sheaf.ring L.top,Y.sheaf.ring-set L.top,AY.GX.Loc,AY.GX.set,AY.GX.inclusion,AY.GX.elementary,
   C.composite,composite-iso].affine ;
} ;
