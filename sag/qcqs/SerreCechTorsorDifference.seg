-- Unique differences between twisted-coordinate sections (Serre §5).
-- On a meet chart, subtract the first coordinates from the second.
-- The two twisted equations have the same right side, so the coordinate
-- differences agree on overlaps. Glue in M. Its restrictions translate
-- the first section to the second; separation makes it unique.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module DL = DistLattice[l] ;
module SM = SerreModule[l] ; module MS = SerreModuleSheaf[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module On (L : DL.DLat) (G : RingedLattice[l].On[L].Presheaf)
 (M : MS.On[L,G].ModuleSheaf) (n : Nat) (as : Fin n -> L.L)
 (c : SerreCechCocycles[l].On[L,G,M,n,as].Cocycle)
 (covers : DL.Order[L].Le L.top (DL.Joins[L].bigJ n as)) {
 module T = SerreCechTorsorCoordinates[l].On[L,G,M,n,as,c] ;
 module Action = SerreCechTorsorAction[l].On[L,G,M,n,as,c] ;
 module O = T.O ; module J = DL.Joins[L] ; module MO = T.MO ;
 module OnOpen (a : L.L) {
  piece (i : Fin n) : L.L = L.meet a (as i) ;
  below (i : Fin n) : O.Le (piece i) a = O.meet-left a (as i) ;
  covering : O.Le a (J.bigJ n piece) = J.meet-cover a n as
   (O.le-trans a L.top (J.bigJ n as) (O.le-top a) covers) ;
  module C = MO.Cover[a,n,piece,below,covering].C ;
  module S = SerreSetSheaf[l].On[L].SheafProofs[MO.underlying,M.sheaf].Cover[a,n,piece,below,covering] ;
  module At (i : Fin n) {
   module Laws = SM.Over[G.ring (piece i)].Laws[M.presheaf.module-at (piece i)] ;
   module Additive = SerreCechAlgebra[l].Over[G.ring (piece i),M.presheaf.module-at (piece i)] ;
  } ;
  module Below (w : L.L) (wa : O.Le w a) (i j : Fin n)
   (wi : O.Le w (as i)) (wj : O.Le w (as j)) {
   module P = T.Pair[a,(i,j)] ;
   left : O.Le w (piece i) = O.meet-glb a (as i) w wa wi ;
   right : O.Le w (piece j) = O.meet-glb a (as j) w wa wj ;
   overlap : O.Le w (T.Z.C.overlap i j) = O.meet-glb (as i) (as j) w wi wj ;
   domain : O.Le w P.domain = O.meet-glb a (T.Z.C.overlap i j) w wa overlap ;
   module Laws = SM.Over[G.ring w].Laws[M.presheaf.module-at w] ;
   coordinate-equation (x : T.Fibre.Section a) :
    Id (M.presheaf.module-at w).M
     (Laws.sub (MO.restrict w (piece j) right (T.Fibre.value a x j))
      (MO.restrict w (piece i) left (T.Fibre.value a x i)))
     (MO.restrict w (T.Z.C.overlap i j) overlap (T.Z.value c i j)) =
    trans (cong2 (M.presheaf.module-at w).M Laws.sub _ _ _ _
     (sym (M.presheaf.res-comp w P.domain (piece j) domain P.below-right right (T.Fibre.value a x j)))
     (sym (M.presheaf.res-comp w P.domain (piece i) domain P.below-left left (T.Fibre.value a x i))))
     (trans (sym (MO.res-sub w P.domain domain (P.right (T.Fibre.value a x)) (P.left (T.Fibre.value a x))))
      (trans (ap (MO.restrict w P.domain domain)
       (ap (\ z -> z (i,j)) (T.section-equation a x)))
       (M.presheaf.res-comp w P.domain (T.Z.C.overlap i j) domain P.below-overlap overlap (T.Z.value c i j)))) ;
  } ;
  module Difference (x y : T.Fibre.Section a) {
   coordinates (i : Fin n) : (M.presheaf.module-at (piece i)).M =
    At[i].Laws.sub (T.Fibre.value a y i) (T.Fibre.value a x i) ;
   module Pair (i j : Fin n) {
    w : L.L = L.meet (piece i) (piece j) ;
    wi : O.Le w (piece i) = O.meet-left (piece i) (piece j) ;
    wj : O.Le w (piece j) = O.meet-right (piece i) (piece j) ;
    wa : O.Le w a = O.le-trans w (piece i) a wi (below i) ;
    ii : O.Le w (as i) = O.le-trans w (piece i) (as i) wi (O.meet-right a (as i)) ;
    jj : O.Le w (as j) = O.le-trans w (piece j) (as j) wj (O.meet-right a (as j)) ;
    module B = Below[w,wa,i,j,ii,jj] ;
    module Additive = SerreCechAlgebra[l].Over[G.ring w,M.presheaf.module-at w] ;
    left-eq (t : T.Fibre.Section a) :
     Id (M.presheaf.module-at w).M (MO.restrict w (piece i) wi (T.Fibre.value a t i))
      (MO.restrict w (piece i) B.left (T.Fibre.value a t i)) = MO.res-irr w (piece i) wi B.left (T.Fibre.value a t i) ;
    right-eq (t : T.Fibre.Section a) :
     Id (M.presheaf.module-at w).M (MO.restrict w (piece j) wj (T.Fibre.value a t j))
      (MO.restrict w (piece j) B.right (T.Fibre.value a t j)) = MO.res-irr w (piece j) wj B.right (T.Fibre.value a t j) ;
    compatible : Id (M.presheaf.module-at w).M
     (MO.restrict w (piece i) wi (coordinates i)) (MO.restrict w (piece j) wj (coordinates j)) =
     trans (MO.res-sub w (piece i) wi (T.Fibre.value a y i) (T.Fibre.value a x i))
      (trans (cong2 (M.presheaf.module-at w).M B.Laws.sub _ _ _ _ (left-eq y) (left-eq x))
       (trans (sym (Additive.parallel
        (MO.restrict w (piece j) B.right (T.Fibre.value a y j))
        (MO.restrict w (piece i) B.left (T.Fibre.value a y i))
        (MO.restrict w (piece j) B.right (T.Fibre.value a x j))
        (MO.restrict w (piece i) B.left (T.Fibre.value a x i))
        (trans (B.coordinate-equation y) (sym (B.coordinate-equation x)))))
        (trans (sym (cong2 (M.presheaf.module-at w).M B.Laws.sub _ _ _ _ (right-eq y) (right-eq x)))
         (sym (MO.res-sub w (piece j) wj (T.Fibre.value a y j) (T.Fibre.value a x j)))))) ;
   } ;
   glued : C.Amalgam coordinates = (S.glue coordinates (\ i j -> Pair[i,j].compatible)).1 ;
   section : (M.presheaf.module-at a).M = C.amalgam glued ;
   matches (i : Fin n) : Id (M.presheaf.module-at (piece i)).M (MO.restrict (piece i) a (below i) section) (coordinates i) = C.matches glued i ;
   equation : Id (T.Fibre.Section a) (Action.action a x section) y =
    T.Fibre.ext a (Action.action a x section) y
     (trans (Action.action-value a x section)
      (T.E.At[a].P.ext _ _ (\ i ->
       trans (ap ((M.presheaf.module-at (piece i)).madd (T.Fibre.value a x i)) (matches i))
        (trans ((M.presheaf.module-at (piece i)).maddC (T.Fibre.value a x i) (coordinates i))
         (At[i].Additive.sub-plus-right (T.Fibre.value a y i) (T.Fibre.value a x i)))))) ;
   module Other (m : (M.presheaf.module-at a).M) (e : Id (T.Fibre.Section a) (Action.action a x m) y) {
    coordinate (i : Fin n) : Id (M.presheaf.module-at (piece i)).M (MO.restrict (piece i) a (below i) m) (coordinates i) =
     trans (sym (At[i].Additive.sub-cancel-right (MO.restrict (piece i) a (below i) m) (T.Fibre.value a x i)))
      (ap (\ z -> At[i].Laws.sub z (T.Fibre.value a x i))
       (trans ((M.presheaf.module-at (piece i)).maddC (MO.restrict (piece i) a (below i) m) (T.Fibre.value a x i))
        (trans (sym (ap (\ z -> z i) (Action.action-value a x m)))
         (ap (\ z -> T.Fibre.value a z i) e)))) ;
    unique : Id (M.presheaf.module-at a).M section m =
     S.separated section m (\ i -> trans (matches i) (sym (coordinate i))) ;
   } ;
   equation-prop (m : (M.presheaf.module-at a).M) : Pr.isProp (Id (T.Fibre.Section a) (Action.action a x m) y) =
    T.Fibre.section-set a (Action.action a x m) y ;
   contractible : Localisation[l].isContr ((m : (M.presheaf.module-at a).M) * Id (T.Fibre.Section a) (Action.action a x m) y) =
    ((section,equation),\ z -> Pr.Sigma-eq (M.presheaf.module-at a).M
     (\ m -> Id (T.Fibre.Section a) (Action.action a x m) y)
     section z.1 equation z.2 Other[z.1,z.2].unique (equation-prop z.1)) ;
   opaque glued ; opaque section ; opaque contractible ;
  } ;
 } ;
} ;
