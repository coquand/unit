-- The support ideal J_U (Serre note, Section 7, Lemma lem:J-sheaf).
-- Fix U in L (the parameter V below).  J_U(a) = { t in O(a) | D_a(t) <= U }: the section t is the
-- underlying element and membership is a proposition.
-- Lemma (ideal).  J_U(a) is an O(a)-submodule of O(a):
--  0: D_a(0) = 0 <= U (zero law);
--  s + t: D_a(s+t) <= D_a(s) \/ D_a(t) <= U (addition law);
--  r t: D_a(r t) = D_a(r) /\ D_a(t) <= D_a(t) <= U (product law);
--  -t: -t = t (-1), so D_a(-t) <= D_a(t) <= U by the product case.
-- Lemma (restriction).  D_b(t|b) = b /\ D_a(t) <= D_a(t) <= U, by
--  uniqueness of invertibility opens (InvOpen.Restrict).
-- Lemma (sheaf).  A compatible family of members on a finite cover of a
--  glues in O; the amalgam t has D_a(t) = \/ D_(a_i)(t|a_i) (InvOpen.Join
--  and uniqueness), and each D_(a_i)(t|a_i) <= U, so t is a member.
--  Uniqueness is uniqueness in O, membership being a proposition.
-- Lemma (J_U|U = O|U).  For a <= U every t in O(a) is a member, since
--  D_a(t) <= a <= U; so the inclusion J_U(a) -> O(a) has the inverse
--  t |-> (t, D_a(t) <= a <= U), compatibly with restriction.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module DL = DistLattice[l] ;
module SM = SerreModule[l] ;
module MM = SerreModuleMaps[l] ;
module MS = SerreModuleSheaf[l] ;
module SS = SerreSetSheaf[l] ;
module RM = RingMaps[l] ;
-- the support laws used below; they do not depend on the bound U
module Support (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged) {
 module O = DL.Order[L] ;
 module GO = RingedLattice[l].On[L].Of[X.sheaf] ;
 module LX = LocallyRinged[l].On[L].Laws[X.sheaf,X.inv] ;
 module IO = InvOpen[l].On[L].Of[X.sheaf] ;
 zero-support (a : L.L) : Id L.L (LX.d a (X.sheaf.ring a).z) L.bot = X.is-support.2.1 a ;
 add-support (a : L.L) (s t : (X.sheaf.ring a).R) :
  O.Le (LX.d a ((X.sheaf.ring a).add s t)) (L.join (LX.d a s) (LX.d a t)) = X.is-support.2.2.2 a s t ;
 -- D_a(r t) <= D_a(t)
 scale-support (a : L.L) (r t : (X.sheaf.ring a).R) : O.Le (LX.d a ((X.sheaf.ring a).mul r t)) (LX.d a t) =
  O.le-trans (LX.d a ((X.sheaf.ring a).mul r t)) (L.meet (LX.d a r) (LX.d a t)) (LX.d a t)
   (O.le-of-eq _ _ (LX.mul-law a r t)) (O.meet-right (LX.d a r) (LX.d a t)) ;
 -- -t = t (-1)
 neg-as-product (a : L.L) (t : (X.sheaf.ring a).R) :
  Id (X.sheaf.ring a).R ((X.sheaf.ring a).neg t) ((X.sheaf.ring a).mul ((X.sheaf.ring a).neg (X.sheaf.ring a).o) t) = calc (X.sheaf.ring a).R {
  (X.sheaf.ring a).neg t
   =< ap (X.sheaf.ring a).neg (sym ((X.sheaf.ring a).mulO t)) > (X.sheaf.ring a).neg ((X.sheaf.ring a).mul t (X.sheaf.ring a).o)
   =< sym (RL[X.sheaf.ring a].mul-neg t (X.sheaf.ring a).o) > (X.sheaf.ring a).mul t ((X.sheaf.ring a).neg (X.sheaf.ring a).o)
   =< (X.sheaf.ring a).mulC t ((X.sheaf.ring a).neg (X.sheaf.ring a).o) > (X.sheaf.ring a).mul ((X.sheaf.ring a).neg (X.sheaf.ring a).o) t } ;
 -- D_b(t|b) = b /\ D_a(t)
 restrict-support (a b : L.L) (k : O.Le b a) (t : (X.sheaf.ring a).R) :
  Id L.L (LX.d b (GO.restrict b a k t)) (L.meet b (LX.d a t)) =
  IO.Restrict[a,b,k,t,LX.d a t,LX.d-open a t].restrict-eq (LX.d b (GO.restrict b a k t)) (LX.d-open b (GO.restrict b a k t)) ;
} ;
module On (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged) (V : L.L) {
 module O = DL.Order[L] ;
 module J = DL.Joins[L] ;
 module GO = RingedLattice[l].On[L].Of[X.sheaf] ;
 module LX = LocallyRinged[l].On[L].Laws[X.sheaf,X.inv] ;
 module IO = InvOpen[l].On[L].Of[X.sheaf] ;
 module Sp = Support[L,X] ;
 module Str = SerreModuleSheafStructure[l].On[L,X.sheaf,X.is-sheaf] ;
 module SO = MS.On[L,X.sheaf].Of[Str.presheaf] ;
 -- D_a(t) <= V
 Member (a : L.L) (t : (X.sheaf.ring a).R) : U l = O.Le (LX.d a t) V ;
 member-prop (a : L.L) (t : (X.sheaf.ring a).R) : Pr.isProp (Member a t) = O.le-prop (LX.d a t) V ;
 module At (a : L.L) {
  Carrier : U l = (t : (X.sheaf.ring a).R) * Member a t ;
  value (x : Carrier) : (X.sheaf.ring a).R = x.1 ;
  member (x : Carrier) : Member a (value x) = x.2 ;
  ext (x y : Carrier) (p : Id (X.sheaf.ring a).R (value x) (value y)) : Id Carrier x y =
   Pr.Sigma-eq (X.sheaf.ring a).R (Member a) (value x) (value y) (member x) (member y) p (member-prop a (value y)) ;
  set : Pr.isSet Carrier = Pr.isSet-Sigma (X.sheaf.ring a).R (Member a) (X.sheaf.ring-set a)
   (\ t -> Pr.prop-to-set (Member a t) (member-prop a t)) ;
  zero : Carrier = ((X.sheaf.ring a).z,
   O.le-trans (LX.d a (X.sheaf.ring a).z) L.bot V (O.le-of-eq _ _ (Sp.zero-support a)) (O.bot-le V)) ;
  add (x y : Carrier) : Carrier = ((X.sheaf.ring a).add (value x) (value y),
   O.le-trans (LX.d a ((X.sheaf.ring a).add (value x) (value y))) (L.join (LX.d a (value x)) (LX.d a (value y))) V
    (Sp.add-support a (value x) (value y)) (O.join-lub (LX.d a (value x)) (LX.d a (value y)) V (member x) (member y))) ;
  scale (r : (X.sheaf.ring a).R) (x : Carrier) : Carrier = ((X.sheaf.ring a).mul r (value x),
   O.le-trans (LX.d a ((X.sheaf.ring a).mul r (value x))) (LX.d a (value x)) V (Sp.scale-support a r (value x)) (member x)) ;
  neg (x : Carrier) : Carrier = ((X.sheaf.ring a).neg (value x),
   Pr.subst (X.sheaf.ring a).R (Member a) _ _ (sym (Sp.neg-as-product a (value x)))
    (member (scale ((X.sheaf.ring a).neg (X.sheaf.ring a).o) x))) ;
  ideal-module : SM.Over[X.sheaf.ring a].Module = new SM.Over[X.sheaf.ring a].Module[
   Carrier,set,zero,add,neg,
   \ x y z -> ext (add x (add y z)) (add (add x y) z) ((X.sheaf.ring a).addA (value x) (value y) (value z)),
   \ x y -> ext (add x y) (add y x) ((X.sheaf.ring a).addC (value x) (value y)),
   \ x -> ext (add x zero) x ((X.sheaf.ring a).addZ (value x)),
   \ x -> ext (add x (neg x)) zero ((X.sheaf.ring a).addN (value x)),scale,
   \ r s x -> ext (scale r (scale s x)) (scale ((X.sheaf.ring a).mul r s) x) ((X.sheaf.ring a).mulA r s (value x)),
   \ x -> ext (scale (X.sheaf.ring a).o x) x ((Str.presheaf.module-at a).smO (value x)),
   \ r x y -> ext (scale r (add x y)) (add (scale r x) (scale r y)) ((X.sheaf.ring a).dist r (value x) (value y)),
   \ r s x -> ext (scale ((X.sheaf.ring a).add r s) x) (add (scale r x) (scale s x)) ((Str.presheaf.module-at a).smE r s (value x))] ;
  zero-value : Id (X.sheaf.ring a).R (value zero) (X.sheaf.ring a).z = refl (X.sheaf.ring a).z ;
  add-value (x y : Carrier) : Id (X.sheaf.ring a).R (value (add x y)) ((X.sheaf.ring a).add (value x) (value y)) =
   refl ((X.sheaf.ring a).add (value x) (value y)) ;
  neg-value (x : Carrier) : Id (X.sheaf.ring a).R (value (neg x)) ((X.sheaf.ring a).neg (value x)) =
   refl ((X.sheaf.ring a).neg (value x)) ;
  scale-value (r : (X.sheaf.ring a).R) (x : Carrier) : Id (X.sheaf.ring a).R (value (scale r x)) ((X.sheaf.ring a).mul r (value x)) =
   refl ((X.sheaf.ring a).mul r (value x)) ;
  opaque ext ; opaque set ;
 } ;
 -- restriction stability: D_b(t|b) = b /\ D_a(t) <= V
 restrict-member (a b : L.L) (k : O.Le b a) (t : (X.sheaf.ring a).R) (m : Member a t) : Member b (GO.restrict b a k t) =
  O.le-trans (LX.d b (GO.restrict b a k t)) (L.meet b (LX.d a t)) V
   (O.le-of-eq _ _ (Sp.restrict-support a b k t))
   (O.le-trans (L.meet b (LX.d a t)) (LX.d a t) V (O.meet-right b (LX.d a t)) m) ;
 restrict (b a : L.L) (k : O.Le b a) (x : At[a].Carrier) : At[b].Carrier =
  (GO.restrict b a k (At[a].value x),restrict-member a b k (At[a].value x) (At[a].member x)) ;
 restrict-value (b a : L.L) (k : O.Le b a) (x : At[a].Carrier) :
  Id (X.sheaf.ring b).R (At[b].value (restrict b a k x)) (GO.restrict b a k (At[a].value x)) =
  refl (GO.restrict b a k (At[a].value x)) ;
 restriction (b a : L.L) (k : O.Le b a) :
  MM.Between[X.sheaf.ring a,X.sheaf.ring b,X.sheaf.res b a k,At[a].ideal-module,At[b].ideal-module].Hom =
  new MM.Between[X.sheaf.ring a,X.sheaf.ring b,X.sheaf.res b a k,At[a].ideal-module,At[b].ideal-module].Hom[
   restrict b a k,
   \ x y -> At[b].ext (restrict b a k (At[a].add x y)) (At[b].add (restrict b a k x) (restrict b a k y))
    (RM.map-add (X.sheaf.res b a k) (At[a].value x) (At[a].value y)),
   \ r x -> At[b].ext (restrict b a k (At[a].scale r x)) (At[b].scale (RM.map (X.sheaf.res b a k) r) (restrict b a k x))
    (RM.map-mul (X.sheaf.res b a k) r (At[a].value x))] ;
 presheaf : MS.On[L,X.sheaf].Presheaf = new MS.On[L,X.sheaf].Presheaf[
  \ a -> At[a].ideal-module,restriction,
  \ a k x -> At[a].ext (restrict a a k x) x (X.sheaf.res-id a k (At[a].value x)),
  \ a b c k h t x -> At[a].ext (restrict a b k (restrict b c h x)) (restrict a c t x)
   (X.sheaf.res-comp a b c k h t (At[c].value x))] ;
 module JO = MS.On[L,X.sheaf].Of[presheaf] ;
 module Cover (a : L.L) (n : Nat) (as : Fin n -> L.L)
  (le : (i : Fin n) -> O.Le (as i) a) (covers : O.Le a (J.bigJ n as))
  (xs : (i : Fin n) -> At[as i].Carrier) (compatible : JO.Cover[a,n,as,le,covers].C.Compatible xs) {
  module OC = SO.Cover[a,n,as,le,covers].C ;
  module JC = JO.Cover[a,n,as,le,covers].C ;
  module OS = SS.On[L].SheafProofs[SO.underlying,Str.structure.sheaf].Cover[a,n,as,le,covers] ;
  values (i : Fin n) : (X.sheaf.ring (as i)).R = At[as i].value (xs i) ;
  values-compatible : OC.Compatible values = \ i j ->
   ap (At[L.meet (as i) (as j)].value) (compatible i j) ;
  glued : OC.Amalgam values = (OS.glue values values-compatible).1 ;
  glued-value : (X.sheaf.ring a).R = OC.amalgam glued ;
  glued-matches (i : Fin n) : Id (X.sheaf.ring (as i)).R (GO.restrict (as i) a (le i) glued-value) (values i) =
   trans (sym (Str.restrict-at (as i) a (le i) glued-value)) (OC.matches glued i) ;
  -- D_a(t) = \/ D_(a_i)(t|a_i)
  pieces (i : Fin n) : L.L = LX.d (as i) (GO.restrict (as i) a (le i) glued-value) ;
  module JoinOpen = IO.Local[X.is-sheaf].Join[a,glued-value,n,as,le,covers,pieces,
   \ i -> LX.d-open (as i) (GO.restrict (as i) a (le i) glued-value)] ;
  join-support : Id L.L (LX.d a glued-value) (J.bigJ n pieces) = IO.unique (LX.d-open a glued-value) JoinOpen.inv-open ;
  piece-member (i : Fin n) : O.Le (pieces i) V =
   Pr.subst (X.sheaf.ring (as i)).R (Member (as i)) _ _ (sym (glued-matches i)) (At[as i].member (xs i)) ;
  glued-member : Member a glued-value =
   O.le-trans (LX.d a glued-value) (J.bigJ n pieces) V (O.le-of-eq _ _ join-support) (J.least n pieces V piece-member) ;
  center : At[a].Carrier = (glued-value,glued-member) ;
  center-matches : JC.Matches xs center = \ i -> At[as i].ext (restrict (as i) a (le i) center) (xs i) (glued-matches i) ;
  matches-prop (x : At[a].Carrier) : Pr.isProp (JC.Matches xs x) =
   FE.isProp-Pi (Fin n) (\ i -> Id (At[as i].Carrier) (restrict (as i) a (le i) x) (xs i))
    (\ i -> At[as i].set _ _) ;
  unique (u : JC.Amalgam xs) : Id (At[a].Carrier) center (JC.amalgam u) =
   At[a].ext center (JC.amalgam u)
    (OS.separated glued-value (At[a].value (JC.amalgam u)) (\ i ->
     trans (OC.matches glued i) (sym (ap (At[as i].value) (JC.matches u i))))) ;
  amalgamation : Localisation[l].isContr (JC.Amalgam xs) =
   ((center,center-matches),\ u -> Pr.Sigma-eq (At[a].Carrier) (JC.Matches xs)
    center (JC.amalgam u) center-matches (JC.matches u) (unique u) (matches-prop (JC.amalgam u))) ;
  opaque glued ; opaque glued-member ; opaque amalgamation ;
 } ;
 sheaf : JO.IsSheaf = \ a n as le covers xs compatible -> Cover[a,n,as,le,covers,xs,compatible].amalgamation ;
 ideal : MS.On[L,X.sheaf].ModuleSheaf = new MS.On[L,X.sheaf].ModuleSheaf[presheaf,sheaf] ;
 -- the inclusion J_U -> O
 module Inclusion = MS.On[L,X.sheaf].Transform[presheaf,Str.presheaf] ;
 inclusion-component (a : L.L) :
  MM.Between[X.sheaf.ring a,X.sheaf.ring a,RingHom[l].identity (X.sheaf.ring a),At[a].ideal-module,Str.presheaf.module-at a].Hom =
  new MM.Between[X.sheaf.ring a,X.sheaf.ring a,RingHom[l].identity (X.sheaf.ring a),At[a].ideal-module,Str.presheaf.module-at a].Hom[
   At[a].value,At[a].add-value,At[a].scale-value] ;
 inclusion : Inclusion.Hom = new Inclusion.Hom[inclusion-component,\ a b k x -> restrict-value a b k x] ;
 inclusion-at (a : L.L) (x : At[a].Carrier) :
  Id (X.sheaf.ring a).R (Inclusion.at inclusion a x) (At[a].value x) = refl (At[a].value x) ;
 inclusion-injective (a : L.L) (x y : At[a].Carrier)
  (e : Id (X.sheaf.ring a).R (Inclusion.at inclusion a x) (Inclusion.at inclusion a y)) : Id (At[a].Carrier) x y =
  At[a].ext x y (trans (sym (inclusion-at a x)) (trans e (inclusion-at a y))) ;
 -- J_U|V = O|V: below V every section is a member
 module Full (a : L.L) (below : O.Le a V) {
  full-member (t : (X.sheaf.ring a).R) : Member a t =
   O.le-trans (LX.d a t) a V (IO.below (LX.d-open a t)) below ;
  full (t : (X.sheaf.ring a).R) : At[a].Carrier = (t,full-member t) ;
  full-value (t : (X.sheaf.ring a).R) : Id (X.sheaf.ring a).R (At[a].value (full t)) t = refl t ;
  full-inclusion (x : At[a].Carrier) : Id (At[a].Carrier) (full (Inclusion.at inclusion a x)) x =
   At[a].ext (full (Inclusion.at inclusion a x)) x (inclusion-at a x) ;
  inclusion-full (t : (X.sheaf.ring a).R) : Id (X.sheaf.ring a).R (Inclusion.at inclusion a (full t)) t =
   inclusion-at a (full t) ;
 } ;
 opaque sheaf ; opaque inclusion ;
} ;
