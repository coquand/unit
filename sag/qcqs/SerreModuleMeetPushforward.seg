-- Meet pushforward of module sheaves (Serre, Sections 5 and 8).
-- For a fixed U define P(a)=Q(a meet U), restricting scalars along
-- O(a)->O(a meet U). Restrictions in Q are semilinear for this action:
-- the two scalar composites agree by the presheaf composition equation.
-- Meeting a finite cover with U gives a cover of a meet U. Compatible
-- sections remain compatible on the new overlaps by restriction of their
-- original overlap equations; no equality of section carriers is used.
-- Gluing and uniqueness in Q prove that P is a module sheaf.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module DL = DistLattice[l] ;
module MM = SerreModuleMaps[l] ;
module MS = SerreModuleSheaf[l] ;
module SS = SerreSetSheaf[l] ;
module On (L : DL.DLat) (G : RingedLattice[l].On[L].Presheaf)
 (Q : MS.On[L,G].ModuleSheaf) (u : L.L) {
 module O = DL.Order[L] ;
 module J = DL.Joins[L] ;
 module QO = MS.On[L,G].Of[Q.presheaf] ;
 module GO = RingedLattice[l].On[L].Of[G] ;
 domain (a : L.L) : L.L = L.meet a u ;
 below (a : L.L) : O.Le (domain a) a = O.meet-left a u ;
 mono (a b : L.L) (k : O.Le a b) : O.Le (domain a) (domain b) =
  O.meet-mono a u b u k (O.le-refl u) ;
 module At (a : L.L) {
  module Scalars = MM.RestrictScalars[G.ring a,G.ring (domain a),G.res (domain a) a (below a)].Of[Q.presheaf.module-at (domain a)] ;
 } ;
 restrict (a b : L.L) (k : O.Le a b) (x : (Q.presheaf.module-at (domain b)).M) : (Q.presheaf.module-at (domain a)).M =
  QO.restrict (domain a) (domain b) (mono a b k) x ;
 restrict-at (a b : L.L) (k : O.Le a b) (x : (Q.presheaf.module-at (domain b)).M) :
  Id (Q.presheaf.module-at (domain a)).M (restrict a b k x) (QO.restrict (domain a) (domain b) (mono a b k) x) =
  refl (QO.restrict (domain a) (domain b) (mono a b k) x) ;
 scalar-square (a b : L.L) (k : O.Le a b) (r : (G.ring b).R) :
  Id (G.ring (domain a)).R
   (GO.restrict (domain a) (domain b) (mono a b k) (GO.restrict (domain b) b (below b) r))
   (GO.restrict (domain a) a (below a) (GO.restrict a b k r)) =
  trans (G.res-comp (domain a) (domain b) b (mono a b k) (below b)
   (O.le-trans (domain a) a b (below a) k) r)
   (sym (G.res-comp (domain a) a b (below a) k (O.le-trans (domain a) a b (below a) k) r)) ;
 restriction (a b : L.L) (k : O.Le a b) :
  MM.Between[G.ring b,G.ring a,G.res a b k,At[b].Scalars.restricted,At[a].Scalars.restricted].Hom =
  new MM.Between[G.ring b,G.ring a,G.res a b k,At[b].Scalars.restricted,At[a].Scalars.restricted].Hom[
   restrict a b k,\ x y -> QO.res-add (domain a) (domain b) (mono a b k) x y,
   \ r x -> trans (QO.res-scale (domain a) (domain b) (mono a b k) (GO.restrict (domain b) b (below b) r) x)
    (ap (\ s -> (Q.presheaf.module-at (domain a)).sm s (restrict a b k x)) (scalar-square a b k r))] ;
 presheaf : MS.On[L,G].Presheaf = new MS.On[L,G].Presheaf[
  \ a -> At[a].Scalars.restricted,restriction,
  \ a k x -> Q.presheaf.res-id (domain a) (mono a a k) x,
  \ a b c k h t x -> Q.presheaf.res-comp (domain a) (domain b) (domain c) (mono a b k) (mono b c h) (mono a c t) x] ;
 module PO = MS.On[L,G].Of[presheaf] ;
 presheaf-res (a b : L.L) (k : O.Le a b) (x : (Q.presheaf.module-at (domain b)).M) :
  Id (Q.presheaf.module-at (domain a)).M (PO.restrict a b k x) (restrict a b k x) = refl (restrict a b k x) ;
 opaque below ; opaque mono ; opaque scalar-square ;
 module Cover (a : L.L) (n : Nat) (as : Fin n -> L.L)
  (le : (i : Fin n) -> O.Le (as i) a) (covers : O.Le a (J.bigJ n as))
  (xs : (i : Fin n) -> (Q.presheaf.module-at (domain (as i))).M)
  (compatible : PO.Cover[a,n,as,le,covers].C.Compatible xs) {
  pieces (i : Fin n) : L.L = domain (as i) ;
  piece-below (i : Fin n) : O.Le (pieces i) (domain a) = mono (as i) a (le i) ;
  piece-covers : O.Le (domain a) (J.bigJ n pieces) =
   O.le-trans (domain a) (L.meet (J.bigJ n as) u) (J.bigJ n pieces)
    (O.meet-mono a u (J.bigJ n as) u covers (O.le-refl u)) (J.meet-join-right n as u) ;
  opaque piece-below ; opaque piece-covers ;
  module QC = QO.Cover[domain a,n,pieces,piece-below,piece-covers].C ;
  module QS = SS.On[L].SheafProofs[QO.underlying,Q.sheaf].Cover[domain a,n,pieces,piece-below,piece-covers] ;
  module PC = PO.Cover[a,n,as,le,covers].C ;
  module Pair (i j : Fin n) {
   overlap : L.L = L.meet (pieces i) (pieces j) ;
   original : L.L = domain (L.meet (as i) (as j)) ;
   below-i : O.Le overlap (as i) = O.le-trans overlap (pieces i) (as i)
    (O.meet-left (pieces i) (pieces j)) (below (as i)) ;
   below-j : O.Le overlap (as j) = O.le-trans overlap (pieces j) (as j)
    (O.meet-right (pieces i) (pieces j)) (below (as j)) ;
   below-u : O.Le overlap u = O.le-trans overlap (pieces i) u
    (O.meet-left (pieces i) (pieces j)) (O.meet-right (as i) u) ;
   below-original : O.Le overlap original =
    O.meet-glb (L.meet (as i) (as j)) u overlap (O.meet-glb (as i) (as j) overlap below-i below-j) below-u ;
   agree : Id (Q.presheaf.module-at overlap).M
    (QO.restrict overlap (pieces i) (O.meet-left (pieces i) (pieces j)) (xs i))
    (QO.restrict overlap (pieces j) (O.meet-right (pieces i) (pieces j)) (xs j)) =
    trans (sym (Q.presheaf.res-comp overlap original (pieces i) below-original
     (mono (L.meet (as i) (as j)) (as i) (O.meet-left (as i) (as j))) (O.meet-left (pieces i) (pieces j)) (xs i)))
     (trans (ap (QO.restrict overlap original below-original) (compatible i j))
      (Q.presheaf.res-comp overlap original (pieces j) below-original
       (mono (L.meet (as i) (as j)) (as j) (O.meet-right (as i) (as j))) (O.meet-right (pieces i) (pieces j)) (xs j))) ;
  } ;
  pieces-compatible : QC.Compatible xs = \ i j -> Pair[i,j].agree ;
  glued : QC.Amalgam xs = (QS.glue xs pieces-compatible).1 ;
  center : (Q.presheaf.module-at (domain a)).M = QC.amalgam glued ;
  matches : PC.Matches xs center = \ i ->
   trans (QO.res-irr (domain (as i)) (domain a) (mono (as i) a (le i)) (piece-below i) center) (QC.matches glued i) ;
  matches-prop (x : (Q.presheaf.module-at (domain a)).M) : Pr.isProp (PC.Matches xs x) =
   FE.isProp-Pi (Fin n) (\ i -> Id (Q.presheaf.module-at (domain (as i))).M (restrict (as i) a (le i) x) (xs i))
    (\ i -> (Q.presheaf.module-at (domain (as i))).setM _ _) ;
  unique (z : PC.Amalgam xs) : Id (Q.presheaf.module-at (domain a)).M center (PC.amalgam z) =
   QS.separated center (PC.amalgam z) (\ i -> trans (QC.matches glued i)
    (sym (trans (QO.res-irr (domain (as i)) (domain a) (piece-below i) (mono (as i) a (le i)) (PC.amalgam z)) (PC.matches z i)))) ;
  amalgamation : Localisation[l].isContr (PC.Amalgam xs) =
   ((center,matches),\ z -> Pr.Sigma-eq (Q.presheaf.module-at (domain a)).M (PC.Matches xs)
    center (PC.amalgam z) matches (PC.matches z) (unique z) (matches-prop (PC.amalgam z))) ;
  opaque glued ; opaque amalgamation ;
 } ;
 sheaf : PO.IsSheaf = \ a n as le covers xs compatible -> Cover[a,n,as,le,covers,xs,compatible].amalgamation ;
 pushforward : MS.On[L,G].ModuleSheaf = new MS.On[L,G].ModuleSheaf[presheaf,sheaf] ;
 opaque sheaf ;
} ;
