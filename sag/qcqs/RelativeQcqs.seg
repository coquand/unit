-- Native relative functorial qcqs: the sheaf condition on actual algebra
-- diagrams and mere finite affine compact-open atlases (note §4).
-- Affineness merely supplies an algebra and a native natural equivalence.
-- All object conditions are propositions; atlas witnesses are not part
-- of the scheme object.  The finite cover equation is pointwise in Zar.
level l ; open Ring[l] ; open Presentations[l] ;
module Hi = Prelude[l+] ;
module Tr = Truncation[l+] ;
module T = AffineTests[l] ;
module Over (K : T.Test) {
 module R = RelativeFunctors[l].Over[K] ;
 module E = RelativeEquivalences[l].Over[K] ;
 AffineWitness (F : R.SetFunctor) : U l+ = (A : R.BP.Algebra) * E.NaturalEquivalence R.Representable[A].functor F ;
 IsAffine (F : R.SetFunctor) : U l+ = Tr.Trunc[AffineWitness F].carrier ;
 module At (F : R.SetFunctor) {
  module O = RelativeOpens[l].Over[K,F] ;
  AffineCover : U l+ = sig {
   count : Nat ;
   opens : Fin count -> O.Open ;
   covers : (A : R.BP.Algebra) (x : F.obj A) -> Id AffineTests[l].At[R.BP.test A].Z.lattice.L
    (AffineTests[l].At[R.BP.test A].Z.J.bigJ count (\ i -> O.value (opens i) A x)) AffineTests[l].At[R.BP.test A].Z.lattice.top ;
   affine : (i : Fin count) -> IsAffine O.Realisation[opens i].functor
  } ;
  HasAtlas : U l+ = Tr.Trunc[AffineCover].carrier ;
  IsQcqs : U l+ = RelativeSheaves[l].Over[K,F].IsSheaf * HasAtlas ;
  proposition : Hi.isProp IsQcqs = Hi.isProp-Sigma (RelativeSheaves[l].Over[K,F].IsSheaf) (\ s -> HasAtlas)
   RelativeSheaves[l].Over[K,F].proposition (\ s -> Tr.Trunc[AffineCover].proposition) ;
 } ;
} ;
