-- A geometric qcqs affine atlas induces a functorial compact-open atlas.
-- Send e_i to its classifier p |-> p*(e_i) (GeometricOpens).  The covering
-- equation follows because p* preserves finite joins and top.  The
-- realisation is h_(X|e_i), which is affine by AffineFunctor; compose its
-- representing equivalence with the realisation equivalence.  A geometric
-- atlas merely exists; eliminate it into HasAtlas, a truncation at l+1.
-- GeometricSheaf supplies sheafhood for every h_X.  Together with this
-- atlas, a geometric qcqs scheme is therefore a functorial qcqs scheme.
level l ; open Ring[l] ; open Presentations[l] ;
module Tr = Truncation[l] ;
module BigTr = Truncation[l+] ;
module DL = DistLattice[l] ;
module Sp = Spaces[l] ;
module Op = OpenMaps[l] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module CO = CompactOpens[l] ;
module TE = TestEquivalences[l] ;
module QF = FunctorialQcqs[l] ;
module Over (X : Sp.Space) {
 module Q = Qcqs[l].Over[X.lattice,X.structure] ;
 module F = SF.Geometric[X] ;
 module G = GeometricOpens[l].Over[X] ;
 module QX = QF.Over[F.functor] ;
 module FromCover (c : Q.AffineCover) {
  module At (i : Fin c.count) {
   module A = AffineFunctor[l].FromAffine[Op.space X (c.opens i),c.affine i] ;
   module R = G.Realisation[c.opens i] ;
   witness : QF.AffineWitness R.R.functor =
    (A.witness.1,TE.Composite[SF.Representable[A.witness.1].functor,SF.Geometric[Op.space X (c.opens i)].functor,R.R.functor,A.witness.2,R.equivalence].equivalence) ;
   affine : QF.IsAffine R.R.functor = BigTr.Trunc[QF.AffineWitness R.R.functor].inc witness ;
  } ;
  covers (B : T.Test) (p : F.functor.obj B) : Id ZariskiLattice[l].Over[B.ring].lattice.L
   (DL.Joins[ZariskiLattice[l].Over[B.ring].lattice].bigJ c.count (\ i -> G.C.value (G.classifier (c.opens i)) B p)) ZariskiLattice[l].Over[B.ring].lattice.top =
   trans (sym (DL.JoinMaps[X.lattice,(T.space B).lattice,(Sp.underlying {T.space B} {X} p).lat].preserves c.count c.opens))
    (trans (ap (DL.hmap (Sp.underlying {T.space B} {X} p).lat) c.covers) (DL.hmap-top (Sp.underlying {T.space B} {X} p).lat)) ;
  cover : QX.AffineCover = struct { count = c.count ; opens = \ i -> G.classifier (c.opens i) ; covers = covers ; affine = \ i -> At[i].affine } ;
 } ;
 has-atlas (qcqs : Q.IsQcqs) : QX.HasAtlas =
  Tr.Trunc[Q.AffineCover].induction @(l+) (\ t -> QX.HasAtlas) (\ t -> BigTr.Trunc[QX.AffineCover].proposition)
   (\ c -> BigTr.Trunc[QX.AffineCover].inc FromCover[c].cover) qcqs ;
 qcqs (geometric : Q.IsQcqs) : QX.IsQcqs = (GeometricSheaf[l].is-sheaf X,has-atlas geometric) ;
} ;
