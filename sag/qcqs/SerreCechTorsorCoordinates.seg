-- Twisted Cech coordinates as an actual sheaf of sets.
-- Form the product E(a)=prod_i M(a meet u_i) and the product
-- F(a)=prod_ij M(a meet (u_i meet u_j)), using meet pushforward.
-- The natural difference map sends x to x_j-x_i on each overlap.
-- A cocycle c determines a global section of F by restriction.
-- Its fibre is a sheaf by the checked general fibre-sheaf theorem.
-- The named equation identifies its fibre condition with delta x=c.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module DL = DistLattice[l] ;
module MS = SerreModuleSheaf[l] ; module SM = SerreModule[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module On (L : DL.DLat) (G : RingedLattice[l].On[L].Presheaf)
 (M : MS.On[L,G].ModuleSheaf) (n : Nat) (as : Fin n -> L.L)
 (c : SerreCechCocycles[l].On[L,G,M,n,as].Cocycle) {
 module Z = SerreCechCocycles[l].On[L,G,M,n,as] ;
 module O = DL.Order[L] ; module MO = MS.On[L,G].Of[M.presheaf] ;
 PairIndex : U l = Fin n * Fin n ;
 module ChartPush (i : Fin n) { module Push = SerreModuleMeetPushforward[l].On[L,G,M,as i] ; } ;
 module OverlapPush (p : PairIndex) { module Push = SerreModuleMeetPushforward[l].On[L,G,M,Z.C.overlap p.1 p.2] ; } ;
 module E = SerreModuleSheafProducts[l].On[L,G,Fin n,\ i -> ChartPush[i].Push.pushforward] ;
 module F = SerreModuleSheafProducts[l].On[L,G,PairIndex,\ p -> OverlapPush[p].Push.pushforward] ;
 module EO = MS.On[L,G].Of[E.presheaf] ; module FO = MS.On[L,G].Of[F.presheaf] ;
 module Pair (a : L.L) (p : PairIndex) {
  domain : L.L = L.meet a (Z.C.overlap p.1 p.2) ;
  below-a : O.Le domain a = O.meet-left a (Z.C.overlap p.1 p.2) ;
  below-overlap : O.Le domain (Z.C.overlap p.1 p.2) = O.meet-right a (Z.C.overlap p.1 p.2) ;
  below-left : O.Le domain (L.meet a (as p.1)) =
   O.meet-glb a (as p.1) domain below-a
    (O.le-trans domain (Z.C.overlap p.1 p.2) (as p.1) below-overlap (O.meet-left (as p.1) (as p.2))) ;
  below-right : O.Le domain (L.meet a (as p.2)) =
   O.meet-glb a (as p.2) domain below-a
    (O.le-trans domain (Z.C.overlap p.1 p.2) (as p.2) below-overlap (O.meet-right (as p.1) (as p.2))) ;
  module Laws = SM.Over[G.ring domain].Laws[M.presheaf.module-at domain] ;
  left (x : E.At[a].P.Carrier) : (M.presheaf.module-at domain).M =
   MO.restrict domain (L.meet a (as p.1)) below-left (x p.1) ;
  right (x : E.At[a].P.Carrier) : (M.presheaf.module-at domain).M =
   MO.restrict domain (L.meet a (as p.2)) below-right (x p.2) ;
 } ;
 difference (a : L.L) (x : E.At[a].P.Carrier) : F.At[a].P.Carrier =
  \ p -> Pair[a,p].Laws.sub (Pair[a,p].right x) (Pair[a,p].left x) ;
 module Naturality (a b : L.L) (k : O.Le a b) (x : E.At[b].P.Carrier) (p : PairIndex) {
  module A = Pair[a,p] ; module B = Pair[b,p] ;
  le : O.Le A.domain B.domain = OverlapPush[p].Push.mono a b k ;
  left-le : O.Le (L.meet a (as p.1)) (L.meet b (as p.1)) = ChartPush[p.1].Push.mono a b k ;
  right-le : O.Le (L.meet a (as p.2)) (L.meet b (as p.2)) = ChartPush[p.2].Push.mono a b k ;
  left-eq : Id (M.presheaf.module-at A.domain).M (A.left (EO.restrict a b k x)) (MO.restrict A.domain B.domain le (B.left x)) =
   trans (M.presheaf.res-comp A.domain (L.meet a (as p.1)) (L.meet b (as p.1)) A.below-left left-le
    (O.le-trans A.domain B.domain (L.meet b (as p.1)) le B.below-left) (x p.1))
    (sym (M.presheaf.res-comp A.domain B.domain (L.meet b (as p.1)) le B.below-left
     (O.le-trans A.domain B.domain (L.meet b (as p.1)) le B.below-left) (x p.1))) ;
  right-eq : Id (M.presheaf.module-at A.domain).M (A.right (EO.restrict a b k x)) (MO.restrict A.domain B.domain le (B.right x)) =
   trans (M.presheaf.res-comp A.domain (L.meet a (as p.2)) (L.meet b (as p.2)) A.below-right right-le
    (O.le-trans A.domain B.domain (L.meet b (as p.2)) le B.below-right) (x p.2))
    (sym (M.presheaf.res-comp A.domain B.domain (L.meet b (as p.2)) le B.below-right
     (O.le-trans A.domain B.domain (L.meet b (as p.2)) le B.below-right) (x p.2))) ;
  equation : Id (M.presheaf.module-at A.domain).M
   (difference a (EO.restrict a b k x) p) (FO.restrict a b k (difference b x) p) =
   trans (cong2 (M.presheaf.module-at A.domain).M A.Laws.sub _ _ _ _ right-eq left-eq)
    (sym (MO.res-sub A.domain B.domain le (B.right x) (B.left x))) ;
 } ;
 natural (a b : L.L) (k : O.Le a b) (x : E.At[b].P.Carrier) :
  Id F.At[a].P.Carrier (difference a (EO.restrict a b k x)) (FO.restrict a b k (difference b x)) =
  F.At[a].P.ext _ _ (\ p -> Naturality[a,b,k,x,p].equation) ;
 module Sets = SerreSetSheafFibre[l].On[L].Between[EO.underlying,FO.underlying] ;
 natural-map : Sets.NaturalMap = new Sets.NaturalMap[difference,natural] ;
 twist (a : L.L) : F.At[a].P.Carrier = \ p -> MO.restrict Pair[a,p].domain (Z.C.overlap p.1 p.2) Pair[a,p].below-overlap (Z.value c p.1 p.2) ;
 module Fibre = Sets.Fibre[natural-map,twist L.top] ;
 target-eq (a : L.L) : Id F.At[a].P.Carrier (Fibre.target a) (twist a) =
  F.At[a].P.ext _ _ (\ p -> M.presheaf.res-comp Pair[a,p].domain Pair[L.top,p].domain (Z.C.overlap p.1 p.2)
   (OverlapPush[p].Push.mono a L.top (O.le-top a)) Pair[L.top,p].below-overlap Pair[a,p].below-overlap (Z.value c p.1 p.2)) ;
 presheaf : SerreSetSheaf[l].On[L].Presheaf = Fibre.presheaf ;
 sheaf : SerreSetSheaf[l].On[L].Of[presheaf].IsSheaf = Fibre.SheafProof[E.sheaf,F.sheaf].is-sheaf ;
 section-equation (a : L.L) (x : Fibre.Section a) : Id F.At[a].P.Carrier (difference a (Fibre.value a x)) (twist a) =
  trans (Fibre.equation a x) (target-eq a) ;
 make-section (a : L.L) (x : E.At[a].P.Carrier) (eq : Id F.At[a].P.Carrier (difference a x) (twist a)) : Fibre.Section a =
  (x,trans eq (sym (target-eq a))) ;
 make-value (a : L.L) (x : E.At[a].P.Carrier) (eq : Id F.At[a].P.Carrier (difference a x) (twist a)) :
  Id E.At[a].P.Carrier (Fibre.value a (make-section a x eq)) x = refl x ;
 opaque natural-map ; opaque sheaf ;
} ;
