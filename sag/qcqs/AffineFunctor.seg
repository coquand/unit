-- The functor of points of an affine space is affine as a functor.
-- First h_A(B)=Hom(A,B) -> Hom(Spec B,Spec A) is natural: take the Yoneda
-- extension of the identity point of Spec A.  At h its value is 1 . Spec h,
-- hence Spec h by the unit law, and it is an equivalence by
-- AffineTests.MapsEquivalence (equiv-homotopy).
-- For affine X, its canonical map c : X -> Spec Gamma X is an isomorphism.
-- Compose the preceding natural equivalence with the point-functor
-- equivalence induced by c^-1.  This supplies a witness of functorial
-- affineness, and hence its mere existence, without choosing a new ring.
level l ; open Ring[l] ;
module Tr = Truncation[l+] ;
module Sp = Spaces[l] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module TE = TestEquivalences[l] ;
module QF = FunctorialQcqs[l] ;
module Spectrum (A : T.Test) {
 module H = SF.Representable[A] ;
 module G = SF.Geometric[T.space A] ;
 module Y = TestYoneda[l].Over[A,G.functor] ;
 module N = SF.Transform[H.functor,G.functor] ;
 transformation : N.Nat = Y.extend Sp.Identity[T.space A].identity ;
 equivalence : TE.NaturalEquivalence H.functor G.functor = (transformation,\ B ->
  Iso[l].equiv-homotopy (H.functor.obj B) (G.functor.obj B) (\ h -> T.Map[A,B,h].morphism) (N.at transformation B)
   (\ h -> sym Sp.Laws[T.space B,T.space A,T.Map[A,B,h].morphism].left) T.MapsEquivalence[A,B].equivalence) ;
 map-at (B : T.Test) (h : RingHom[l].Hom A.ring B.ring) : Id (G.functor.obj B)
  (N.at (TE.forward equivalence) B h) T.Map[A,B,h].morphism = Sp.Laws[T.space B,T.space A,T.Map[A,B,h].morphism].left ;
 opaque equivalence ;
} ;
module FromAffine (X : Sp.Space) (affine : AffineCriterion[l].Over[X.lattice,X.structure].IsAffine) {
 module A = AffineSource[l].FromAffine[X,X,affine] ;
 module V = Sp.InvertMap[X,T.space A.test,A.canonical,A.canonical-iso] ;
 module G = GeometricEquivalence[l].Over[T.space A.test,X,V.inverse,V.inverse-iso] ;
 module H = Spectrum[A.test] ;
 witness : QF.AffineWitness SF.Geometric[X].functor =
  (A.test,TE.Composite[H.H.functor,H.G.functor,SF.Geometric[X].functor,H.equivalence,G.equivalence].equivalence) ;
 affine-functor : QF.IsAffine SF.Geometric[X].functor = Tr.Trunc[QF.AffineWitness SF.Geometric[X].functor].inc witness ;
} ;
