-- A common bound for finitely many natural numbers: the sum
-- bound(v) = v_1 + .. + v_n is above every v_i, that is
-- v_i + r = bound(v) for some r (DESIGN.md, step 3: one exponent for
-- finitely many killers).
level l ; open Ring[l] ; open Presentations[l] ;
plus-assoc : (a b c : Nat) -> Id Nat (plus (plus a b) c) (plus a (plus b c)) = split {
 zero -> \ b c -> refl (plus b c) ;
 suc a | r -> \ b c -> ap (\ k -> suc k) (r b c) } ;
-- m + r = M for some r
Above (m M : Nat) : U l = (r : Nat) * Id Nat (plus m r) M ;
excess {m M : Nat} (a : Above m M) : Nat = a.1 ;
excess-eq {m M : Nat} (a : Above m M) : Id Nat (plus m (excess a)) M = a.2 ;
bound : (n : Nat) -> (Fin n -> Nat) -> Nat = split {
 zero -> \ v -> zero ;
 suc n | r -> \ v -> plus (v (inr tt)) (r (\ i -> v (inl i))) } ;
-- a + B is above b when b + q = B
above-right (a b B : Nat) (q : Above b B) : Above b (plus a B) =
 (plus (excess q) a,calc Nat {
  plus b (plus (excess q) a) =< sym (plus-assoc b (excess q) a) > plus (plus b (excess q)) a
   =< ap (\ k -> plus k a) (excess-eq q) > plus B a
   =< plus-comm B a > plus a B }) ;
above-last (n : Nat) (v : Fin (suc n) -> Nat) : (t : Top) -> Above (v (inr t)) (bound (suc n) v) = split {
 tt -> (bound n (\ i -> v (inl i)),refl (bound (suc n) v)) } ;
bound-above : (n : Nat) (v : Fin n -> Nat) (i : Fin n) -> Above (v i) (bound n v) = split {
 zero -> \ v -> split { } ;
 suc n | r -> \ v -> split {
  inl i -> above-right (v (inr tt)) (v (inl i)) (bound n (\ j -> v (inl j))) (r (\ j -> v (inl j)) i) ;
  inr t -> above-last n v t } } ;
above-trans (a b c : Nat) (p : Above a b) (q : Above b c) : Above a c =
 (plus (excess p) (excess q),calc Nat {
  plus a (plus (excess p) (excess q)) =< sym (plus-assoc a (excess p) (excess q)) > plus (plus a (excess p)) (excess q)
   =< ap (\ k -> plus k (excess q)) (excess-eq p) > plus b (excess q)
   =< excess-eq q > c }) ;
