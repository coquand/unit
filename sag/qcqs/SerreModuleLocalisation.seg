-- Fraction equality for module localisation (Serre note, Section 3).
-- For the endomorphism f acting on a module, (x,p) represents x/f^p.
-- Fractions (x,p),(y,q) agree iff some additional iterate e makes
-- f^(e+q)x = f^(e+p)y.  Transitivity applies the two given equations
-- after further iterates and commutes powers.  The effective quotient
-- supplies exactly this equality criterion.  In particular x/1 is zero
-- iff some power of f kills x.  No synthetic localisation is used.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module SM = SerreModule[l] ;
module NB = NatBound[l] ;
swap-four (a b c d : Nat) : Id Nat (plus (plus a b) (plus c d)) (plus (plus a c) (plus b d)) = calc Nat {
 plus (plus a b) (plus c d)
  =< NB.plus-assoc a b (plus c d) > plus a (plus b (plus c d))
  =< ap (plus a) (sym (NB.plus-assoc b c d)) > plus a (plus (plus b c) d)
  =< ap (\ n -> plus a (plus n d)) (plus-comm b c) > plus a (plus (plus c b) d)
  =< ap (plus a) (NB.plus-assoc c b d) > plus a (plus c (plus b d))
  =< sym (NB.plus-assoc a c (plus b d)) > plus (plus a c) (plus b d) } ;
module At (A : CRing) (Md : SM.Over[A].Module) (f : A.R) {
 module ML = SM.Over[A].Laws[Md] ;
 module AP = AffinePowers[l].Over[A] ;
 power : Nat -> Md.M -> Md.M = split {
  zero -> \ x -> x ; suc n | ih -> \ x -> Md.sm f (ih x) } ;
 power-add : (n k : Nat) (x : Md.M) -> Id Md.M (power (plus n k) x) (power n (power k x)) = split {
  zero -> \ k x -> refl (power k x) ;
  suc n | ih -> \ k x -> ap (Md.sm f) (ih k x) } ;
 power-comm (n k : Nat) (x : Md.M) : Id Md.M (power n (power k x)) (power k (power n x)) =
  trans (sym (power-add n k x)) (trans (ap (\ j -> power j x) (plus-comm n k)) (power-add k n x)) ;
 power-zero : (n : Nat) -> Id Md.M (power n Md.mz) Md.mz = split {
  zero -> refl Md.mz ; suc n | ih -> trans (ap (Md.sm f) ih) (ML.sm-zero f) } ;
 power-scalar : (n : Nat) (x : Md.M) -> Id Md.M (power n x) (Md.sm (AP.power f n) x) = split {
  zero -> \ x -> sym (Md.smO x) ;
  suc n | ih -> \ x -> trans (ap (Md.sm f) (ih x)) (Md.smA f (AP.power f n) x) } ;
 power-at-zero (x : Md.M) : Id Md.M (power zero x) x = refl x ;
 power-at-suc (n : Nat) (x : Md.M) : Id Md.M (power (suc n) x) (Md.sm f (power n x)) = refl (Md.sm f (power n x)) ;
 power-additive : (n : Nat) (x y : Md.M) -> Id Md.M (power n (Md.madd x y)) (Md.madd (power n x) (power n y)) = split {
  zero -> \ x y -> refl (Md.madd x y) ;
  suc n | ih -> \ x y -> trans (ap (Md.sm f) (ih x y)) (Md.smD f (power n x) (power n y)) } ;
 power-scale : (n : Nat) (a : A.R) (x : Md.M) -> Id Md.M (power n (Md.sm a x)) (Md.sm a (power n x)) = split {
  zero -> \ a x -> refl (Md.sm a x) ;
  suc n | ih -> \ a x -> trans (ap (Md.sm f) (ih a x)) (ML.sm-swap f a (power n x)) } ;
 power-negative : (n : Nat) (x : Md.M) -> Id Md.M (power n (Md.mneg x)) (Md.mneg (power n x)) = split {
  zero -> \ x -> refl (Md.mneg x) ;
  suc n | ih -> \ x -> trans (ap (Md.sm f) (ih x)) (ML.sm-neg f (power n x)) } ;
 Fraction : U l = Md.M * Nat ;
 numerator (x : Fraction) : Md.M = x.1 ;
 exponent (x : Fraction) : Nat = x.2 ;
 Witness (x y : Fraction) : U l =
  (e : Nat) * Id Md.M (power (plus e (exponent y)) (numerator x)) (power (plus e (exponent x)) (numerator y)) ;
 Relation (x y : Fraction) : U l = Tr.Trunc[Witness x y].carrier ;
 proposition (x y : Fraction) : Pr.isProp (Relation x y) = Tr.Trunc[Witness x y].proposition ;
 reflexive (x : Fraction) : Relation x x = Tr.Trunc[Witness x x].inc (zero,refl (power (exponent x) (numerator x))) ;
 symmetric (x y : Fraction) : Relation x y -> Relation y x =
  Tr.Trunc[Witness x y].induction @l (\ w -> Relation y x) (\ w -> proposition y x)
   (\ w -> Tr.Trunc[Witness y x].inc (w.1,sym w.2)) ;
 left-exponent (e d p q : Nat) : Id Nat (plus (plus (plus e d) p) q) (plus (plus d q) (plus e p)) =
  trans (NB.plus-assoc (plus e d) p q)
   (trans (cong2 Nat plus _ _ _ _ (plus-comm e d) (plus-comm p q)) (swap-four d e q p)) ;
 right-exponent (e d p q : Nat) : Id Nat (plus (plus (plus e d) p) q) (plus (plus e q) (plus d p)) =
  trans (NB.plus-assoc (plus e d) p q)
   (trans (ap (plus (plus e d)) (plus-comm p q)) (swap-four e d q p)) ;
 join (x y z : Fraction) (h : Witness x y) (k : Witness y z) : Witness x z =
  (plus (plus h.1 k.1) (exponent y),calc Md.M {
   power (plus (plus (plus h.1 k.1) (exponent y)) (exponent z)) (numerator x)
    =< ap (\ n -> power n (numerator x)) (left-exponent h.1 k.1 (exponent y) (exponent z))
    > power (plus (plus k.1 (exponent z)) (plus h.1 (exponent y))) (numerator x)
    =< power-add (plus k.1 (exponent z)) (plus h.1 (exponent y)) (numerator x)
    > power (plus k.1 (exponent z)) (power (plus h.1 (exponent y)) (numerator x))
    =< ap (power (plus k.1 (exponent z))) h.2
    > power (plus k.1 (exponent z)) (power (plus h.1 (exponent x)) (numerator y))
    =< power-comm (plus k.1 (exponent z)) (plus h.1 (exponent x)) (numerator y)
    > power (plus h.1 (exponent x)) (power (plus k.1 (exponent z)) (numerator y))
    =< ap (power (plus h.1 (exponent x))) k.2
    > power (plus h.1 (exponent x)) (power (plus k.1 (exponent y)) (numerator z))
    =< sym (power-add (plus h.1 (exponent x)) (plus k.1 (exponent y)) (numerator z))
    > power (plus (plus h.1 (exponent x)) (plus k.1 (exponent y))) (numerator z)
    =< ap (\ n -> power n (numerator z)) (sym (right-exponent h.1 k.1 (exponent y) (exponent x)))
    > power (plus (plus (plus h.1 k.1) (exponent y)) (exponent x)) (numerator z) }) ;
 transitive (x y z : Fraction) (h : Relation x y) (k : Relation y z) : Relation x z =
  Tr.Trunc[Witness x y].induction @l (\ w -> Relation x z) (\ w -> proposition x z)
   (\ w -> Tr.Trunc[Witness y z].induction @l (\ v -> Relation x z) (\ v -> proposition x z)
    (\ v -> Tr.Trunc[Witness x z].inc (join x y z w v)) k) h ;
 module Q = Quotient[l].Quot[Fraction,Relation,proposition,reflexive,symmetric,transitive] ;
 Carrier : U l = Q.Q ;
 carrier-set : Pr.isSet Carrier = Q.set ;
 fraction (x : Md.M) (p : Nat) : Carrier = Q.inc (x,p) ;
 equal (x y : Md.M) (p q : Nat) : Relation (x,p) (y,q) -> Id Carrier (fraction x p) (fraction y q) =
  Q.relates (x,p) (y,q) ;
 detect (x y : Md.M) (p q : Nat) : Id Carrier (fraction x p) (fraction y q) -> Relation (x,p) (y,q) =
  Q.effective (x,p) (y,q) ;
 Killed (x : Md.M) : U l = (e : Nat) * Id Md.M (power e x) Md.mz ;
 killed-zero (x : Md.M) : Tr.Trunc[Killed x].carrier -> Id Carrier (fraction x zero) (fraction Md.mz zero) =
  Tr.Trunc[Killed x].induction @l (\ w -> Id Carrier (fraction x zero) (fraction Md.mz zero)) (\ w -> carrier-set _ _)
   (\ w -> equal x Md.mz zero zero (Tr.Trunc[Witness (x,zero) (Md.mz,zero)].inc
    (w.1,trans (ap (\ n -> power n x) (plus-zero w.1))
     (trans w.2 (sym (trans (ap (\ n -> power n Md.mz) (plus-zero w.1)) (power-zero w.1))))))) ;
 zero-killed (x : Md.M) (h : Id Carrier (fraction x zero) (fraction Md.mz zero)) : Tr.Trunc[Killed x].carrier =
  Tr.Trunc[Witness (x,zero) (Md.mz,zero)].induction @l
   (\ w -> Tr.Trunc[Killed x].carrier) (\ w -> Tr.Trunc[Killed x].proposition)
   (\ w -> Tr.Trunc[Killed x].inc (w.1,trans (sym (ap (\ n -> power n x) (plus-zero w.1)))
    (trans w.2 (trans (ap (\ n -> power n Md.mz) (plus-zero w.1)) (power-zero w.1)))) )
   (detect x Md.mz zero zero h) ;
 -- Raising the numerator and denominator by the same power changes nothing.
 raise (x : Md.M) (p d : Nat) : Id Carrier (fraction (power d x) (plus d p)) (fraction x p) =
  equal (power d x) x (plus d p) p
   (Tr.Trunc[Witness (power d x,plus d p) (x,p)].inc
    (zero,trans (power-comm p d x) (sym (power-add d p x)))) ;
 represented (q : Carrier) : Tr.Trunc[(x : Md.M) * (p : Nat) * Id Carrier (fraction x p) q].carrier =
  Q.induction @l
   (\ q -> Tr.Trunc[(x : Md.M) * (p : Nat) * Id Carrier (fraction x p) q].carrier)
   (\ q -> Tr.Trunc[(x : Md.M) * (p : Nat) * Id Carrier (fraction x p) q].proposition)
   (\ v -> Tr.Trunc[(x : Md.M) * (p : Nat) * Id Carrier (fraction x p) (Q.inc v)].inc
    (numerator v,exponent v,refl (Q.inc v))) q ;
 induction : [j] (P : Carrier -> U j) -> ((q : Carrier) -> Prelude[j].isProp (P q)) ->
  ((x : Md.M) (p : Nat) -> P (fraction x p)) -> (q : Carrier) -> P q = <j> \ P prop step ->
   Q.induction @j P prop (\ v -> step (numerator v) (exponent v)) ;
 module Descend (B : U l) (setB : Pr.isSet B) (value : Md.M -> Nat -> B)
  (respect : (x y : Md.M) (p q : Nat) -> Relation (x,p) (y,q) -> Id B (value x p) (value y q)) {
  module D = Q.Descend[B,setB,\ v -> value (numerator v) (exponent v),
   \ v w h -> respect (numerator v) (numerator w) (exponent v) (exponent w) h] ;
  map (q : Carrier) : B = D.map q ;
  beta (x : Md.M) (p : Nat) : Id B (map (fraction x p)) (value x p) = D.beta (x,p) ;
  opaque map ;
 } ;
 raise-right (x : Md.M) (p d : Nat) : Id Carrier (fraction (power d x) (plus p d)) (fraction x p) =
  trans (ap (fraction (power d x)) (plus-comm p d)) (raise x p d) ;
 pair-induction (P : Carrier -> Carrier -> U l)
  (prop : (a b : Carrier) -> Pr.isProp (P a b))
  (step : (x y : Md.M) (p : Nat) -> P (fraction x p) (fraction y p))
  (a b : Carrier) : P a b =
  induction @l (\ a -> P a b) (\ a -> prop a b)
   (\ x p -> induction @l (\ b -> P (fraction x p) b) (\ b -> prop (fraction x p) b)
    (\ y q -> subst (P (fraction x p)) (raise y q p)
     (subst (\ a -> P a (fraction (power p y) (plus p q))) (raise-right x p q)
      (step (power q x) (power p y) (plus p q)))) b) a ;
 triple-induction (P : Carrier -> Carrier -> Carrier -> U l)
  (prop : (a b c : Carrier) -> Pr.isProp (P a b c))
  (step : (x y z : Md.M) (p : Nat) -> P (fraction x p) (fraction y p) (fraction z p))
  (a b c : Carrier) : P a b c =
  pair-induction (\ a b -> P a b c) (\ a b -> prop a b c)
   (\ x y p -> induction @l (\ c -> P (fraction x p) (fraction y p) c)
    (\ c -> prop (fraction x p) (fraction y p) c)
    (\ z q -> subst (P (fraction x p) (fraction y p)) (raise z q p)
     (subst (\ b -> P (fraction x p) b (fraction (power p z) (plus p q))) (raise-right y p q)
      (subst (\ a -> P a (fraction (power q y) (plus p q)) (fraction (power p z) (plus p q))) (raise-right x p q)
       (step (power q x) (power q y) (power p z) (plus p q))))) c) a b ;
 opaque fraction ;
 opaque Carrier ;
 opaque power ;
} ;
