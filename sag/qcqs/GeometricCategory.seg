-- Univalence of the existing geometric category of all spaces.
-- A bijectivity proof for a ringed map is a proposition: each of its
-- components is bi-invertibility between sets.  SpaceIsoIdentity gives
-- a retraction from structural isomorphism total spaces onto actual
-- geometric isomorphisms, retaining the whole underlying ringed map.
-- These total spaces are therefore contractible.  Right induction
-- reverses their order to the geometric convention.
-- Categorical isomorphisms and the existing bijectivity criterion agree:
-- InvertMap gives an inverse; conversely two inverse equations make
-- both composites isomorphisms and Compose.Inverse gives the criterion.
-- Retract the categorical singleton onto the contractible total above;
-- Category.FromTotal gives univalence of the actual precategory.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Hi = Prelude[l+] ;
module IT = IdentityTools[l] ;
module DL = DistLattice[l] ;
module SI = SpaceIdentity[l] ;
module SP = Spaces[l] ;
module CC = Category[l+,l] ;
module At (X Y : SP.Space) {
 module IM = Iso[l].Maps[Y.lattice,X.lattice,Y.structure.sheaf,X.structure.sheaf] ;
 iso-prop (f : SP.Hom X Y) : Pr.isProp (SP.IsIso X Y f) =
  IT.both (Pr.isEquiv Y.lattice.L X.lattice.L (DL.hmap (SP.underlying f).lat))
   ((u : Y.lattice.L) -> Pr.isEquiv (Y.structure.sheaf.ring u).R (X.structure.sheaf.ring (DL.hmap (SP.underlying f).lat u)).R (RingMaps[l].map ((SP.underlying f).sharp u)))
   (IT.Equivalence[Y.lattice.L,X.lattice.L,Y.lattice.setL,X.lattice.setL,DL.hmap (SP.underlying f).lat].equal)
   (IT.FE.isProp-Pi Y.lattice.L (\ u -> Pr.isEquiv (Y.structure.sheaf.ring u).R (X.structure.sheaf.ring (DL.hmap (SP.underlying f).lat u)).R (RingMaps[l].map ((SP.underlying f).sharp u)))
    (\ u -> IT.Equivalence[(Y.structure.sheaf.ring u).R,(X.structure.sheaf.ring (DL.hmap (SP.underlying f).lat u)).R,
      Y.structure.sheaf.ring-set u,X.structure.sheaf.ring-set (DL.hmap (SP.underlying f).lat u),RingMaps[l].map ((SP.underlying f).sharp u)].equal)) ;
} ;
Equipped (X Y : SP.Space) : U l = (f : SP.Hom X Y) * SP.IsIso X Y f ;
id-equipped (X : SP.Space) : Equipped X X = (SP.Identity[X].identity,Compose[l].Identity[X.lattice,X.structure.sheaf].iso) ;
OppTotal (X : SP.Space) : U l+ = (Y : SP.Space) * Equipped Y X ;
forward (X : SP.Space) (w : SI.Total X) : OppTotal X = (w.1,SI.morphism X w.1 w.2,SI.iso X w.1 w.2) ;
backward (X : SP.Space) (w : OppTotal X) : SI.Total X =
 (w.1,(SpaceIsoIdentity[l].Over[X].recover-record w.1 (SP.underlying w.2.1) w.2.2).1) ;
restore (X : SP.Space) (w : OppTotal X) : Id (OppTotal X) (forward X (backward X w)) w =
 Hi.ap (Equipped w.1 X) (OppTotal X) (\ z -> (w.1,z)) _ _
  (Pr.Sigma-eq (SP.Hom w.1 X) (SP.IsIso w.1 X) _ _ _ _
   (SP.ext w.1 X _ _ ((SpaceIsoIdentity[l].Over[X].recover-record w.1 (SP.underlying w.2.1) w.2.2).2))
   (At[w.1,X].iso-prop w.2.1)) ;
op-total-contr (X : SP.Space) : FunExtUA[l+].isContr (OppTotal X) =
 SipGeneric[l+].ctr-retract (SI.Total X) (OppTotal X) (SI.total-contr X) (backward X) (forward X) (restore X) ;
opaque op-total-contr ;
module Rev = FamilyIdentity[l+].Right[SP.Space,\ X Y -> Equipped Y X,id-equipped,op-total-contr] ;
total-contr (X : SP.Space) : FunExtUA[l+].isContr ((Y : SP.Space) * Equipped X Y) = Rev.incoming X ;
precategory : CC.Precategory = new CC.Precategory[SP.Space,SP.Hom,SP.set,\ X -> SP.Identity[X].identity,SP.compose,
 \ X Y f -> SP.Laws[X,Y,f].left,\ X Y f -> SP.Laws[X,Y,f].right,
 \ W X Y Z f g h -> SP.Associativity[W,X,Y,Z,h,g,f].assoc] ;
module Arr = Arrows[l+,l].Arrows[precategory] ;
module ToIso (X Y : SP.Space) (e : Equipped X Y) {
 module V = SP.InvertMap[X,Y,e.1,e.2] ;
 categorical : precategory.Iso X Y = (e.1,V.inverse,V.inverse-left,V.inverse-right) ;
} ;
module FromIso (X Y : SP.Space) (e : precategory.Iso X Y) {
 left : SP.IsIso X X (SP.compose X Y X e.2.1 e.1) =
  Pr.subst (SP.Hom X X) (SP.IsIso X X) _ _ (sym e.2.2.1) Compose[l].Identity[X.lattice,X.structure.sheaf].iso ;
 right : SP.IsIso Y Y (SP.compose Y X Y e.1 e.2.1) =
  Pr.subst (SP.Hom Y Y) (SP.IsIso Y Y) _ _ (sym e.2.2.2) Compose[l].Identity[Y.lattice,Y.structure.sheaf].iso ;
 iso : SP.IsIso X Y e.1 = Compose[l].Inverse[Y.lattice,X.lattice,Y.structure.sheaf,X.structure.sheaf,
  SP.underlying {X} {Y} e.1,SP.underlying {Y} {X} e.2.1,right,left].iso ;
 equipped : Equipped X Y = (e.1,iso) ;
} ;
module Single (X : SP.Space) {
 Total : U l+ = (Y : SP.Space) * precategory.Iso X Y ;
 contractible : FunExtUA[l+].isContr Total =
  SipGeneric[l+].ctr-retract ((Y : SP.Space) * Equipped X Y) Total (total-contr X)
   (\ w -> (w.1,FromIso[X,w.1,w.2].equipped)) (\ w -> (w.1,ToIso[X,w.1,w.2].categorical))
   (\ w -> Hi.ap (precategory.Iso X w.1) Total (\ e -> (w.1,e)) _ _ (Arr.iso-eq _ _ (refl w.2.1))) ;
 proposition : Hi.isProp Total = \ u v -> FunExtUA[l+].pathC Total contractible u v ;
} ;
univalent : CC.Univalent precategory = CC.FromTotal[precategory,\ X -> Single[X].proposition].univalent ;
category : CC.Category = new CC.Category[precategory,univalent] ;
