-- The projective line over k (DESIGN.md, Next 5, step 2): Spec k[X] glued to
-- itself along the automorphism X |-> X^-1 of the punctured chart D(X)
-- (PuncturedChart, GlueTransition).  k is any commutative ring.
--
-- Its opens are the pairs (u, v) of opens of k[X] with
-- u /\ D(X) = sigma*(v /\ D(X)); its sections over (u, v) the pairs (s, t)
-- with s|(u /\ D(X)) = sigma#(t|(v /\ D(X))).  The charts e1 = (top, D(X))
-- and e2 = (D(X), top) are each Spec k[X] (GlueTransition.First/Second), so
-- the affine criterion applies to both; they cover, so P^1 is a qcqs scheme
-- (as DoubledLineQcqs).
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) {
 module PC = PuncturedChart[l].Over[k,setk] ;
 module P = PC.I.P ;
 module SB = PC.SB ;
 module GT = GlueTransition[l].Over[SB.ZA.lattice,SB.SA.spec,SB.ZA.D P.variable,PC.automorphism,PC.local,PC.iso] ;
 -- the projective line
 projective-line : GT.GA.LRG.LocallyRinged = GT.glued ;
 -- both charts are affine
 module Q = Qcqs[l].Over[GT.PB.lattice,GT.glued] ;
 affine1 : Q.AffineOpen GT.e1 =
  AffineCriterion[l].Over[GT.First.S1.lattice,GT.First.S1.restricted].Criterion[P.ring,P.set,SB.SA.Loc,SB.SA.set,SB.SA.inclusion,
   SB.SA.elementary,GT.First.chart,GT.First.chart-iso].affine ;
 affine2 : Q.AffineOpen GT.e2 =
  AffineCriterion[l].Over[GT.Second.S2.lattice,GT.Second.S2.restricted].Criterion[P.ring,P.set,SB.SA.Loc,SB.SA.set,SB.SA.inclusion,
   SB.SA.elementary,GT.Second.chart,GT.Second.chart-iso].affine ;
 -- P^1 is a qcqs scheme
 qcqs : Q.IsQcqs = Q.Two[GT.e1,GT.e2,GT.covers,affine1,affine2].qcqs ;
} ;
