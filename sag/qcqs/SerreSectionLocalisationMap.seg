-- The canonical section-localisation map (Serre note, Section 4).
-- For any module sheaf M, restriction from the top to D(f) is A-linear,
-- after restricting scalars from O(D(f)) to A=O(top). The restricted f
-- is a unit on its invertibility open, so its action on M(D(f)) is an
-- equivalence. The module-localisation universal property consequently
-- gives M(top)_f -> M(D(f)), uniquely specified on original sections.
-- This constructs the canonical map without quasi-coherence. Proving it
-- an equivalence is a separate theorem requiring quasi-coherent models.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module DL = DistLattice[l] ;
module RH = RingHom[l] ; module RM = RingMaps[l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module MS = SerreModuleSheaf[l] ;
module UP = SerreModuleLocalisationUniversal[l] ;
module On (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged)
 (M : MS.On[L,X.sheaf].ModuleSheaf) {
 module O = DL.Order[L] ;
 module MO = MS.On[L,X.sheaf].Of[M.presheaf] ;
 module LX = LocallyRinged[l].On[L].Laws[X.sheaf,X.inv] ;
 module Inv = InvOpen[l].On[L].Of[X.sheaf] ;
 module At (f : (X.sheaf.ring L.top).R) {
  open-f : L.L = LX.d L.top f ;
  below : O.Le open-f L.top = Inv.below (LX.d-open L.top f) ;
  ring-map : RH.Hom (X.sheaf.ring L.top) (X.sheaf.ring open-f) = X.sheaf.res open-f L.top below ;
  module Scalars = MM.RestrictScalars[X.sheaf.ring L.top,X.sheaf.ring open-f,ring-map].Of[M.presheaf.module-at open-f] ;
  module Original = MM.Between[X.sheaf.ring L.top,X.sheaf.ring L.top,
   RH.identity (X.sheaf.ring L.top),M.presheaf.module-at L.top,Scalars.restricted] ;
  original : Original.Hom = new Original.Hom[
   MO.restrict open-f L.top below,MO.res-add open-f L.top below,
   \ a x -> trans (MO.res-scale open-f L.top below a x)
    (sym (Scalars.scalar-at a (MO.restrict open-f L.top below x)))] ;
  original-at (x : (M.presheaf.module-at L.top).M) :
   Id (M.presheaf.module-at open-f).M (Original.map original x) (MO.restrict open-f L.top below x) =
   refl (MO.restrict open-f L.top below x) ;
  unit : RL[X.sheaf.ring open-f].unit (RM.map ring-map f) = Inv.unit-on (LX.d-open L.top f) ;
  module UnitAction = SerreModuleBasicRestrictions[l].UnitAction[
   X.sheaf.ring open-f,M.presheaf.module-at open-f,RM.map ring-map f,unit] ;
  invertible : Pr.isEquiv (M.presheaf.module-at open-f).M (M.presheaf.module-at open-f).M (Scalars.restricted.sm f) =
   Iso[l].equiv-homotopy (M.presheaf.module-at open-f).M (M.presheaf.module-at open-f).M
    ((M.presheaf.module-at open-f).sm (RM.map ring-map f)) (Scalars.restricted.sm f)
    (\ x -> sym (Scalars.scalar-at f x)) UnitAction.equiv ;
  module E = UP.Extend[X.sheaf.ring L.top,M.presheaf.module-at L.top,Scalars.restricted,f,original,invertible] ;
  native : E.To.Hom = E.lift ;
  map (x : E.S.Carrier) : (M.presheaf.module-at open-f).M = E.To.map native x ;
  on-original (x : (M.presheaf.module-at L.top).M) :
   Id (M.presheaf.module-at open-f).M (map (E.S.fraction x zero)) (MO.restrict open-f L.top below x) =
   trans (E.extends x) (original-at x) ;
  on-fraction (x : (M.presheaf.module-at L.top).M) (p : Nat) :
   Id (M.presheaf.module-at open-f).M (map (E.S.fraction x p))
    (E.InverseAction.back p (MO.restrict open-f L.top below x)) =
   trans (E.lift-map-at (E.S.fraction x p))
    (trans (E.lift-at x p) (ap (E.InverseAction.back p) (original-at x))) ;
  clears (x : (M.presheaf.module-at L.top).M) (p : Nat) :
   Id (M.presheaf.module-at open-f).M (E.T.power p (map (E.S.fraction x p)))
    (MO.restrict open-f L.top below x) =
   trans (ap (E.T.power p) (on-fraction x p)) (E.InverseAction.power-back p (MO.restrict open-f L.top below x)) ;
  module Other (k : E.To.Hom)
   (on : (x : (M.presheaf.module-at L.top).M) ->
    Id (M.presheaf.module-at open-f).M (E.To.map k (E.S.fraction x zero)) (MO.restrict open-f L.top below x)) {
   unique (x : E.S.Carrier) : Id (M.presheaf.module-at open-f).M (E.To.map k x) (map x) =
    E.Other[k,\ a -> trans (on a) (sym (original-at a))].unique x ;
  } ;
  opaque original ; opaque invertible ; opaque native ; opaque map ;
 } ;
} ;
