-- The natural M-action on twisted Cech coordinates.
-- Add the restriction of m in M(a) to every coordinate. The two further
-- restrictions of m on an overlap agree by composition. Hence their
-- difference vanishes and the twisted equation is preserved. The module
-- laws prove the action laws coordinatewise, and restriction commutes
-- with the action by the same composition equation.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module DL = DistLattice[l] ;
module MS = SerreModuleSheaf[l] ; module SM = SerreModule[l] ;
module On (L : DL.DLat) (G : RingedLattice[l].On[L].Presheaf)
 (M : MS.On[L,G].ModuleSheaf) (n : Nat) (as : Fin n -> L.L)
 (c : SerreCechCocycles[l].On[L,G,M,n,as].Cocycle) {
 module T = SerreCechTorsorCoordinates[l].On[L,G,M,n,as,c] ;
 module O = T.O ; module MO = T.MO ;
 diagonal (a : L.L) (m : (M.presheaf.module-at a).M) : T.E.At[a].P.Carrier =
  \ i -> MO.restrict (L.meet a (as i)) a (O.meet-left a (as i)) m ;
 module Pair (a : L.L) (p : T.PairIndex) {
  module P = T.Pair[a,p] ;
  module Additive = SerreCechAlgebra[l].Over[G.ring P.domain,M.presheaf.module-at P.domain] ;
  left-diagonal (m : (M.presheaf.module-at a).M) :
   Id (M.presheaf.module-at P.domain).M (P.left (diagonal a m)) (MO.restrict P.domain a P.below-a m) =
   M.presheaf.res-comp P.domain (L.meet a (as p.1)) a P.below-left (O.meet-left a (as p.1)) P.below-a m ;
  right-diagonal (m : (M.presheaf.module-at a).M) :
   Id (M.presheaf.module-at P.domain).M (P.right (diagonal a m)) (MO.restrict P.domain a P.below-a m) =
   M.presheaf.res-comp P.domain (L.meet a (as p.2)) a P.below-right (O.meet-left a (as p.2)) P.below-a m ;
  preserves (x : T.E.At[a].P.Carrier) (m : (M.presheaf.module-at a).M) :
   Id (M.presheaf.module-at P.domain).M
    (T.difference a (T.E.At[a].P.product.madd x (diagonal a m)) p) (T.difference a x p) =
   trans (cong2 (M.presheaf.module-at P.domain).M P.Laws.sub _ _ _ _
    (MO.res-add P.domain (L.meet a (as p.2)) P.below-right (x p.2) (diagonal a m p.2))
    (MO.res-add P.domain (L.meet a (as p.1)) P.below-left (x p.1) (diagonal a m p.1)))
    (trans (cong2 (M.presheaf.module-at P.domain).M P.Laws.sub _ _ _ _
     (ap ((M.presheaf.module-at P.domain).madd (P.right x)) (right-diagonal m))
     (ap ((M.presheaf.module-at P.domain).madd (P.left x)) (left-diagonal m)))
     (Additive.sub-add-same (P.right x) (P.left x) (MO.restrict P.domain a P.below-a m))) ;
 } ;
 preserves (a : L.L) (x : T.E.At[a].P.Carrier) (m : (M.presheaf.module-at a).M) :
  Id T.F.At[a].P.Carrier (T.difference a (T.E.At[a].P.product.madd x (diagonal a m))) (T.difference a x) =
  T.F.At[a].P.ext _ _ (\ p -> Pair[a,p].preserves x m) ;
 action (a : L.L) (x : T.Fibre.Section a) (m : (M.presheaf.module-at a).M) : T.Fibre.Section a =
  T.make-section a (T.E.At[a].P.product.madd (T.Fibre.value a x) (diagonal a m))
   (trans (preserves a (T.Fibre.value a x) m) (T.section-equation a x)) ;
 action-value (a : L.L) (x : T.Fibre.Section a) (m : (M.presheaf.module-at a).M) :
  Id T.E.At[a].P.Carrier (T.Fibre.value a (action a x m)) (T.E.At[a].P.product.madd (T.Fibre.value a x) (diagonal a m)) =
  T.make-value a (T.E.At[a].P.product.madd (T.Fibre.value a x) (diagonal a m))
   (trans (preserves a (T.Fibre.value a x) m) (T.section-equation a x)) ;
 action-zero (a : L.L) (x : T.Fibre.Section a) : Id (T.Fibre.Section a) (action a x (M.presheaf.module-at a).mz) x =
  T.Fibre.ext a (action a x (M.presheaf.module-at a).mz) x
   (trans (action-value a x (M.presheaf.module-at a).mz)
    (T.E.At[a].P.ext _ _ (\ i ->
     trans (ap ((M.presheaf.module-at (L.meet a (as i))).madd (T.Fibre.value a x i))
      (MO.res-zero (L.meet a (as i)) a (O.meet-left a (as i))))
      ((M.presheaf.module-at (L.meet a (as i))).maddZ (T.Fibre.value a x i))))) ;
 action-coordinate (a : L.L) (x : T.Fibre.Section a) (m : (M.presheaf.module-at a).M) (i : Fin n) :
  Id (M.presheaf.module-at (L.meet a (as i))).M (T.Fibre.value a (action a x m) i)
   ((M.presheaf.module-at (L.meet a (as i))).madd (T.Fibre.value a x i) (diagonal a m i)) =
  ap (\ z -> z i) (action-value a x m) ;
 restriction-coordinate (a b : L.L) (k : O.Le a b) (x : T.Fibre.Section b) (i : Fin n) :
  Id (M.presheaf.module-at (L.meet a (as i))).M (T.Fibre.value a (T.Fibre.restrict a b k x) i)
   (MO.restrict (L.meet a (as i)) (L.meet b (as i)) (T.ChartPush[i].Push.mono a b k) (T.Fibre.value b x i)) =
  ap (\ z -> z i) (T.Fibre.restrict-value a b k x) ;
 module Addition (a : L.L) (x : T.Fibre.Section a) (m m2 : (M.presheaf.module-at a).M) (i : Fin n) {
  d : L.L = L.meet a (as i) ;
  N : SM.Over[G.ring d].Module = M.presheaf.module-at d ;
  equation : Id N.M (T.Fibre.value a (action a (action a x m) m2) i)
   (T.Fibre.value a (action a x ((M.presheaf.module-at a).madd m m2)) i) =
   trans (action-coordinate a (action a x m) m2 i)
    (trans (ap (\ z -> N.madd z (diagonal a m2 i)) (action-coordinate a x m i))
     (trans (sym (N.maddA (T.Fibre.value a x i) (diagonal a m i) (diagonal a m2 i)))
      (trans (ap (N.madd (T.Fibre.value a x i)) (sym (MO.res-add d a (O.meet-left a (as i)) m m2)))
       (sym (action-coordinate a x ((M.presheaf.module-at a).madd m m2) i))))) ;
 } ;
 action-add (a : L.L) (x : T.Fibre.Section a) (m m2 : (M.presheaf.module-at a).M) :
  Id (T.Fibre.Section a) (action a (action a x m) m2) (action a x ((M.presheaf.module-at a).madd m m2)) =
  T.Fibre.ext a (action a (action a x m) m2) (action a x ((M.presheaf.module-at a).madd m m2))
   (T.E.At[a].P.ext _ _ (\ i -> Addition[a,x,m,m2,i].equation)) ;
 module RestrictionLaw (a b : L.L) (k : O.Le a b) (x : T.Fibre.Section b) (m : (M.presheaf.module-at b).M) (i : Fin n) {
  da : L.L = L.meet a (as i) ; db : L.L = L.meet b (as i) ;
  le : O.Le da db = T.ChartPush[i].Push.mono a b k ;
  N : SM.Over[G.ring da].Module = M.presheaf.module-at da ;
  scalar-equation : Id N.M (MO.restrict da db le (diagonal b m i)) (diagonal a (MO.restrict a b k m) i) =
   trans (M.presheaf.res-comp da db b le (O.meet-left b (as i))
    (O.le-trans da a b (O.meet-left a (as i)) k) m)
    (sym (M.presheaf.res-comp da a b (O.meet-left a (as i)) k
     (O.le-trans da a b (O.meet-left a (as i)) k) m)) ;
  equation : Id N.M (T.Fibre.value a (T.Fibre.restrict a b k (action b x m)) i)
   (T.Fibre.value a (action a (T.Fibre.restrict a b k x) (MO.restrict a b k m)) i) =
   trans (restriction-coordinate a b k (action b x m) i)
    (trans (ap (MO.restrict da db le) (action-coordinate b x m i))
     (trans (MO.res-add da db le (T.Fibre.value b x i) (diagonal b m i))
      (trans (cong2 N.M N.madd _ _ _ _ (sym (restriction-coordinate a b k x i)) scalar-equation)
       (sym (action-coordinate a (T.Fibre.restrict a b k x) (MO.restrict a b k m) i))))) ;
 } ;
 action-res (a b : L.L) (k : O.Le a b) (x : T.Fibre.Section b) (m : (M.presheaf.module-at b).M) :
  Id (T.Fibre.Section a) (T.Fibre.restrict a b k (action b x m))
   (action a (T.Fibre.restrict a b k x) (MO.restrict a b k m)) =
  T.Fibre.ext a (T.Fibre.restrict a b k (action b x m)) (action a (T.Fibre.restrict a b k x) (MO.restrict a b k m))
   (T.E.At[a].P.ext _ _ (\ i -> RestrictionLaw[a,b,k,x,m,i].equation)) ;
 opaque action ;
} ;
