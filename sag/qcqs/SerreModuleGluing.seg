-- Degree-zero module gluing (Serre note §3).
-- First clear all denominators to a common exponent r. On M_fj the
-- error t_i|fj-f_i^r s_j vanishes after localising at f_i, by the given
-- overlap compatibility. Actual overlap kernel detection and finite
-- choice give one exponent e killing all errors. Replacing t_i by
-- f_i^e t_i and r by r+e gives the exact equations on every member.
-- The partition-of-one argument then produces the unique amalgam.
-- Every choice is eliminated into that proposition; the empty cover
-- is handled by the same finite sums and separation argument.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module SM = SerreModule[l] ; module CF = SerreModuleClearFinite[l] ;
module CE = SerreModuleClearErrors[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (Md : SM.Over[A].Module) {
 module Data = SerreModuleGluingData[l].Over[A,setA,Md] ;
 module P = AffinePowers[l].Over[A] ;
 module Overlap = SerreModuleBasicRestrictionsOverlap[l].Over[A,setA,Md] ;
 module Cover (n : Nat) (fs : Fin n -> A.R)
  (covers : Data.O.Le Data.Z.lattice.top (Data.Z.J.bigJ n (\ i -> Data.Z.D (fs i)))) {
  module C = Data.Cover[n,fs,covers] ;
  module Partition = SerreModuleGluingPartition[l].Over[A,setA,Md].Cover[n,fs,covers] ;
  module Initial (xs : C.Families) (compatible : C.Compatible xs)
   (r : Nat) (ts : Fin n -> Md.M)
   (initial : (i : Fin n) -> Id C.Index[i].P.L.Carrier (C.Index[i].P.L.fraction (ts i) zero)
    (C.Index[i].P.Native.localised.sm (P.power (fs i) r) (xs i))) {
   module Pair (i j : Fin n) {
    module N = C.Index[j].P.Native ; module ML = C.Index[j].P.Laws ;
    module Q = C.Pair[i,j] ;
    module Sub = CE.Over[A].Along[N.localised,Q.P.Native.localised,Q.Rho.native] ;
    module Step = Overlap.At[fs i,fs j] ;
    error : N.L.Carrier = ML.sub (N.L.fraction (ts i) zero) (N.localised.sm (P.power (fs i) r) (xs j)) ;
    error-at : Id N.L.Carrier error (ML.sub (N.L.fraction (ts i) zero) (N.localised.sm (P.power (fs i) r) (xs j))) = refl error ;
    image-equation : Id Q.P.L.Carrier (Q.Rho.map (N.L.fraction (ts i) zero))
     (Q.Rho.map (N.localised.sm (P.power (fs i) r) (xs j))) =
     trans (Q.Rho.on-original (ts i))
      (trans (sym (Q.L.on-original (ts i)))
       (trans (ap Q.L.map (initial i))
        (trans (Q.L.map-scale (P.power (fs i) r) (xs i))
         (trans (ap (Q.P.Native.localised.sm (P.power (fs i) r)) (compatible i j))
          (sym (Q.Rho.map-scale (P.power (fs i) r) (xs j))))))) ;
    vanishes : Id Q.P.L.Carrier (Q.Rho.map error) Q.P.Native.Action.mz =
     trans (Sub.map-sub (N.L.fraction (ts i) zero) (N.localised.sm (P.power (fs i) r) (xs j)))
      (trans (ap (\ x -> Q.P.Laws.sub x (Q.Rho.map (N.localised.sm (P.power (fs i) r) (xs j)))) image-equation)
       (Q.P.Laws.sub-self (Q.Rho.map (N.localised.sm (P.power (fs i) r) (xs j))))) ;
    killed : Tr.Trunc[Step.Kill error].carrier = Step.kill error
     (trans (Data.R.rho-irr (fs j) Q.overlap Step.below (Data.right (fs i) (fs j)) error) vanishes) ;
    opaque error ;
   } ;
   module Errors = CE.Over[A].Matrix[n,n,\ i j -> C.Index[j].P.Native.localised,\ i j -> fs i,\ i j -> Pair[i,j].error] ;
   common-errors : Tr.Trunc[Errors.Common].carrier = Errors.common (\ i j -> Pair[i,j].killed) ;
   module Correct (e : Nat)
    (kills : (i j : Fin n) -> Id C.Index[j].P.L.Carrier
     (C.Index[j].P.Native.localised.sm (P.power (fs i) e) Pair[i,j].error) C.Index[j].P.Native.Action.mz) {
    numerators (i : Fin n) : Md.M = Md.sm (P.power (fs i) e) (ts i) ;
    module PairExact (i j : Fin n) {
     module N = C.Index[j].P.Native ; module ML = C.Index[j].P.Laws ; module H = C.Index[j].P.H ;
     killed-equality : Id N.L.Carrier
      (N.localised.sm (P.power (fs i) e) (N.L.fraction (ts i) zero))
      (N.localised.sm (P.power (fs i) e) (N.localised.sm (P.power (fs i) r) (xs j))) =
      ML.sub-zero _ _ (trans (sym (ML.sm-sub (P.power (fs i) e) (N.L.fraction (ts i) zero)
       (N.localised.sm (P.power (fs i) r) (xs j))))
       (trans (sym (ap (N.localised.sm (P.power (fs i) e)) Pair[i,j].error-at)) (kills i j))) ;
     exact : Id N.L.Carrier (N.L.fraction (numerators i) zero) (N.localised.sm (P.power (fs i) (plus r e)) (xs j)) =
      trans (sym (N.canonical-at (numerators i)))
       (trans (H.map-scale N.canonical (P.power (fs i) e) (ts i))
        (trans (ap (N.localised.sm (P.power (fs i) e)) (N.canonical-at (ts i)))
         (trans killed-equality (CF.Over[A].Action[N.localised].raise (fs i) r (plus r e) (e,refl (plus r e)) (xs j))))) ;
    } ;
    amalgam : C.Amalgam xs = Partition.Exact[xs,plus r e,numerators,\ i j -> PairExact[i,j].exact].amalgam ;
   } ;
   amalgam : C.Amalgam xs =
    Tr.Trunc[Errors.Common].induction @l (\ w -> C.Amalgam xs) (\ w -> C.amalgam-prop xs)
     (\ w -> Correct[w.1,w.2].amalgam) common-errors ;
  } ;
  amalgam (xs : C.Families) (compatible : C.Compatible xs) : C.Amalgam xs =
   Tr.Trunc[C.Clear[xs].Family.Common].induction @l (\ w -> C.Amalgam xs) (\ w -> C.amalgam-prop xs)
    (\ w -> Initial[xs,compatible,w.1,w.2.1,\ i -> trans (sym (C.Index[i].P.Native.canonical-at (w.2.1 i))) (w.2.2 i)].amalgam) C.Clear[xs].initial ;
  equaliser (xs : C.Families) (compatible : C.Compatible xs) : Localisation[l].isContr (C.Amalgam xs) =
   (amalgam xs compatible,\ a -> C.amalgam-prop xs (amalgam xs compatible) a) ;
 } ;
} ;
