-- Localisation as a property of a ring map (DESIGN.md, step 1; Isaev,
-- Def. 2.1).  A is a commutative ring and S a multiplicative monoid of A.
--
-- Universal form.  f : A -> T inverts S, and for every ring T' (a set) and
-- every g : A -> T' inverting S, the extensions  (h : T -> T', h . f = g)
-- form a contractible type.
-- Elementary form.  f inverts S; every x : T merely has a fraction
-- (y, s), s in S, with f(s) x = f(y); and f(y) = 0 merely gives s in S
-- with s y = 0.
--
-- Theorem (the elementary form gives the universal form).  Let g : A -> T'
-- invert S.
--  Transfer.  If f(u) = f(v) then g(u) = g(v): the elementary form gives t
--  in S with t (u - v) = 0, so g(t) (g(u) - g(v)) = 0, and g(t) is a unit.
--  Values.  c : T' is a value of x along a fraction (y, s) of x if
--  g(s) c = g(y).  A value along one fraction is a value along every
--  fraction (y', s'): f(y s') = f(s) x f(s') = f(y' s), so by transfer
--  g(y) g(s') = g(y') g(s), and g(s) (g(s') c) = g(s') g(y) = g(s) g(y');
--  cancel g(s).  Two values of x agree (x merely has a fraction, and g(s)
--  is a unit), and g(y) g(s)^-1 is a value along (y, s); so every x has
--  exactly one value h(x).
--  h is a ring map.  If (y, s) and (y', s') are fractions of x and w, then
--  (y s' + y' s, s s') and (y y', s s') are fractions of x + w and x w,
--  and h(x) + h(w), h(x) h(w) are values along them: the same two
--  identities (the fraction rules) hold in T and in T'.
--  h . f = g, since (y, 1) is a fraction of f(y).
--  Uniqueness.  If k . f = g then k(x) is a value of x: apply k to
--  f(s) x = f(y).
-- Corollary.  Two ring maps k, k' out of a localisation with k f = k' f
-- are equal (k f inverts S, since ring maps preserve units).
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;

isContr (X : U l) : U l = (c : X) * ((x : X) -> Id X c x) ;

-- The fraction rules: if a x = y and b w = y', then
-- (a b)(x + w) = y b + y' a  and  (a b)(x w) = y y'.
module Rules (C : CRing) {
 open C ;
 sum-rule (a b x w y y' : R) (e : Id R (mul a x) y) (e' : Id R (mul b w) y') :
  Id R (mul (mul a b) (add x w)) (add (mul y b) (mul y' a)) = calc R {
  mul (mul a b) (add x w)
   =< dist (mul a b) x w > add (mul (mul a b) x) (mul (mul a b) w)
   =< ap (\ t -> add t (mul (mul a b) w)) (trans (ap (\ t -> mul t x) (mulC a b))
        (trans (sym (mulA b a x)) (mulC b (mul a x)))) > add (mul (mul a x) b) (mul (mul a b) w)
   =< ap (add (mul (mul a x) b)) (trans (sym (mulA a b w)) (mulC a (mul b w)))
    > add (mul (mul a x) b) (mul (mul b w) a)
   =< ap (\ t -> add (mul t b) (mul (mul b w) a)) e > add (mul y b) (mul (mul b w) a)
   =< ap (\ t -> add (mul y b) (mul t a)) e' > add (mul y b) (mul y' a) } ;
 product-rule (a b x w y y' : R) (e : Id R (mul a x) y) (e' : Id R (mul b w) y') :
  Id R (mul (mul a b) (mul x w)) (mul y y') =
  trans (RL[C].mul-four a b x w) (trans (ap (\ t -> mul t (mul b w)) e) (ap (mul y) e')) ;
} ;

-- The images of y s' + y' s and y y' under a ring map.
module Images (A C : CRing) (phi : RH.Hom A C) {
 sum-image (y s y' s' : A.R) :
  Id C.R (map phi (A.add (A.mul y s') (A.mul y' s))) (C.add (C.mul (map phi y) (map phi s')) (C.mul (map phi y') (map phi s))) =
  trans (map-add phi (A.mul y s') (A.mul y' s))
   (trans (ap (\ t -> C.add t (map phi (A.mul y' s))) (map-mul phi y s'))
    (ap (C.add (C.mul (map phi y) (map phi s'))) (map-mul phi y' s))) ;
 product-image (a b : A.R) : Id C.R (map phi (A.mul a b)) (C.mul (map phi a) (map phi b)) = (map-mul phi) a b ;
} ;

module Over (A : CRing) (S : A.R -> U l) (one : S A.o)
 (product : (s t : A.R) -> S s -> S t -> S (A.mul s t)) {
 Inverts (T : CRing) (f : RH.Hom A T) : U l = (s : A.R) -> S s -> RL[T].unit (map f s) ;
 Extension (T T' : CRing) (f : RH.Hom A T) (g : RH.Hom A T') : U l =
  (h : RH.Hom T T') * Id (RH.Hom A T') (RH.compose A T T' h f) g ;
 IsUniversal (T : CRing) (f : RH.Hom A T) : U l+ =
  (T' : CRing) -> Pr.isSet T'.R -> (g : RH.Hom A T') -> Inverts T' g -> isContr (Extension T T' f g) ;
 IsLoc (T : CRing) (f : RH.Hom A T) : U l+ = Inverts T f * IsUniversal T f ;

 Fraction (T : CRing) (f : RH.Hom A T) (x : T.R) : U l =
  (y s : A.R) * S s * Id T.R (T.mul (map f s) x) (map f y) ;
 -- the parts of a fraction
 num {T : CRing} {f : RH.Hom A T} {x : T.R} (p : Fraction T f x) : A.R = p.1 ;
 den {T : CRing} {f : RH.Hom A T} {x : T.R} (p : Fraction T f x) : A.R = p.2.1 ;
 den-in {T : CRing} {f : RH.Hom A T} {x : T.R} (p : Fraction T f x) : S (den p) = p.2.2.1 ;
 eqn {T : CRing} {f : RH.Hom A T} {x : T.R} (p : Fraction T f x) :
  Id T.R (T.mul (map f (den p)) x) (map f (num p)) = p.2.2.2 ;
 Killer (y : A.R) : U l = (s : A.R) * S s * Id A.R (A.mul s y) A.z ;
 kill {y : A.R} (c : Killer y) : A.R = c.1 ;
 kill-in {y : A.R} (c : Killer y) : S (kill c) = c.2.1 ;
 kill-eq {y : A.R} (c : Killer y) : Id A.R (A.mul (kill c) y) A.z = c.2.2 ;
 Fractions (T : CRing) (f : RH.Hom A T) : U l = (x : T.R) -> Tr.Trunc[Fraction T f x].carrier ;
 Kernel (T : CRing) (f : RH.Hom A T) : U l =
  (y : A.R) -> Id T.R (map f y) T.z -> Tr.Trunc[Killer y].carrier ;
 Elementary (T : CRing) (f : RH.Hom A T) : U l = Inverts T f * Fractions T f * Kernel T f ;
 inverts {T : CRing} {f : RH.Hom A T} (el : Elementary T f) : Inverts T f = el.1 ;
 fractions {T : CRing} {f : RH.Hom A T} (el : Elementary T f) : Fractions T f = el.2.1 ;
 kernel {T : CRing} {f : RH.Hom A T} (el : Elementary T f) : Kernel T f = el.2.2 ;

 -- (y s' + y' s, s s') and (y y', s s') are fractions of x + w and x w
 module FractionRules (T : CRing) (f : RH.Hom A T) {
  module I = Images[A,T,f] ;
  sum (x w : T.R) (p : Fraction T f x) (q : Fraction T f w) : Fraction T f (T.add x w) =
   (A.add (A.mul (num p) (den q)) (A.mul (num q) (den p)),A.mul (den p) (den q),product (den p) (den q) (den-in p) (den-in q),
    trans (ap (\ t -> T.mul t (T.add x w)) (I.product-image (den p) (den q)))
     (trans (Rules[T].sum-rule (map f (den p)) (map f (den q)) x w (map f (num p)) (map f (num q)) (eqn p) (eqn q))
      (sym (I.sum-image (num p) (den p) (num q) (den q))))) ;
  prod (x w : T.R) (p : Fraction T f x) (q : Fraction T f w) : Fraction T f (T.mul x w) =
   (A.mul (num p) (num q),A.mul (den p) (den q),product (den p) (den q) (den-in p) (den-in q),
    trans (ap (\ t -> T.mul t (T.mul x w)) (I.product-image (den p) (den q)))
     (trans (Rules[T].product-rule (map f (den p)) (map f (den q)) x w (map f (num p)) (map f (num q)) (eqn p) (eqn q))
      (sym (I.product-image (num p) (num q))))) ;
  -- (1, 1) is a fraction of 1, and (y, 1) one of f(y)
  unit : Fraction T f T.o = (A.o,A.o,one,T.mulO (map f A.o)) ;
  image (y : A.R) : Fraction T f (map f y) =
   (y,A.o,one,trans (ap (\ t -> T.mul t (map f y)) (map-one f)) (RL[T].one-left (map f y))) ;
 } ;

 module FromElementary (T : CRing) (f : RH.Hom A T) (el : Elementary T f)
  (T' : CRing) (setT' : Pr.isSet T'.R) (g : RH.Hom A T') (gS : Inverts T' g) {
  open T' ; open RL[T'] ;
  module Reg = Regularity[l].Over[T'] ;
  module FR = FractionRules[T,f] ;
  module G = Images[A,T',g] ;
  cancel (s : A.R) (hs : S s) : Reg.Regular (map g s) =
   Reg.from-kernel (map g s) (\ a h -> unit-reg (map g s) a (gS s hs) h) ;

  -- Transfer: f(u) = f(v) gives g(u) = g(v).
  difference (C : CRing) (phi : RH.Hom A C) (u v : A.R) :
   Id C.R (map phi (A.add u (A.neg v))) (C.add (map phi u) (C.neg (map phi v))) =
   trans (map-add phi u (A.neg v)) (ap (C.add (map phi u)) (RH.negation A C phi v)) ;
  killed (u v : A.R) (c : Killer (A.add u (A.neg v))) : Id R (map g u) (map g v) =
   Reg.difference (map g u) (map g v)
    (trans (sym (difference T' g u v))
     (cancel (kill c) (kill-in c) (map g (A.add u (A.neg v))) z
      (calc R {
        mul (map g (kill c)) (map g (A.add u (A.neg v)))
         =< sym (map-mul g (kill c) (A.add u (A.neg v))) > (map g) (A.mul (kill c) (A.add u (A.neg v)))
         =< ap (map g) (kill-eq c) > (map g) A.z
         =< RH.zero A T' g > z
         =< sym (mul-zero (map g (kill c))) > mul (map g (kill c)) z }))) ;
  transfer (u v : A.R) (e : Id T.R (map f u) (map f v)) : Id R (map g u) (map g v) =
   Tr.Trunc[Killer (A.add u (A.neg v))].induction @l (\ k -> Id R (map g u) (map g v)) (\ k -> setT' _ _)
    (killed u v)
    (kernel el (A.add u (A.neg v))
     (trans (difference T f u v)
      (trans (ap (\ t -> T.add t (T.neg (map f v))) e) (T.addN (map f v))))) ;

  -- Two fractions of x: f(y s') = f(y' s).
  swap-ends (C : CRing) (a x b : C.R) : Id C.R (C.mul (C.mul a x) b) (C.mul (C.mul b x) a) =
   trans (C.mulC (C.mul a x) b) (trans (ap (C.mul b) (C.mulC a x)) (C.mulA b x a)) ;
  cross (x : T.R) (p q : Fraction T f x) :
   Id T.R (map f (A.mul (num p) (den q))) (map f (A.mul (num q) (den p))) = calc T.R {
   (map f) (A.mul (num p) (den q))
    =< (map-mul f) (num p) (den q) > T.mul (map f (num p)) (map f (den q))
    =< ap (\ t -> T.mul t (map f (den q))) (sym (eqn p)) > T.mul (T.mul (map f (den p)) x) (map f (den q))
    =< swap-ends T (map f (den p)) x (map f (den q)) > T.mul (T.mul (map f (den q)) x) (map f (den p))
    =< ap (\ t -> T.mul t (map f (den p))) (eqn q) > T.mul (map f (num q)) (map f (den p))
    =< sym (map-mul f (num q) (den p)) > (map f) (A.mul (num q) (den p)) } ;

  -- Values.
  Along (x : T.R) (p : Fraction T f x) (c : R) : U l = Id R (mul (map g (den p)) c) (map g (num p)) ;
  Value (x : T.R) (c : R) : U l = (p : Fraction T f x) -> Along x p c ;
  along-every (x : T.R) (p : Fraction T f x) (c : R) (a : Along x p c) : Value x c = \ q ->
   cancel (den p) (den-in p) (mul (map g (den q)) c) (map g (num q)) (calc R {
    mul (map g (den p)) (mul (map g (den q)) c)
     =< mul-swap (map g (den p)) (map g (den q)) c > mul (map g (den q)) (mul (map g (den p)) c)
     =< ap (mul (map g (den q))) a > mul (map g (den q)) (map g (num p))
     =< mulC (map g (den q)) (map g (num p)) > mul (map g (num p)) (map g (den q))
     =< sym (map-mul g (num p) (den q)) > (map g) (A.mul (num p) (den q))
     =< transfer (A.mul (num p) (den q)) (A.mul (num q) (den p)) (cross x p q) > (map g) (A.mul (num q) (den p))
     =< (map-mul g) (num q) (den p) > mul (map g (num q)) (map g (den p))
     =< mulC (map g (num q)) (map g (den p)) > mul (map g (den p)) (map g (num q)) }) ;
  value-prop (x : T.R) (c : R) : Pr.isProp (Value x c) =
   F.isProp-Pi (Fraction T f x) (\ p -> Along x p c) (\ p -> setT' _ _) ;
  value-unique (x : T.R) (c c' : R) (v : Value x c) (v' : Value x c') : Id R c c' =
   Tr.Trunc[Fraction T f x].induction @l (\ p -> Id R c c') (\ p -> setT' _ _)
    (\ p -> cancel (den p) (den-in p) c c' (trans (v p) (sym (v' p)))) (fractions el x) ;
  Values (x : T.R) : U l = (c : R) * Value x c ;
  values-prop (x : T.R) : Pr.isProp (Values x) = \ a b ->
   Pr.Sigma-eq R (Value x) a.1 b.1 a.2 b.2 (value-unique x a.1 b.1 a.2 b.2) (value-prop x b.1) ;
  -- g(y) g(s)^-1 is a value along (y, s)
  quotient (x : T.R) (p : Fraction T f x) : R = mul (map g (num p)) (gS (den p) (den-in p)).1 ;
  quotient-along (x : T.R) (p : Fraction T f x) : Along x p (quotient x p) =
   trans (mul-swap (map g (den p)) (map g (num p)) (gS (den p) (den-in p)).1)
    (trans (ap (mul (map g (num p))) (gS (den p) (den-in p)).2) (mulO (map g (num p)))) ;
  values (x : T.R) : Values x =
   Tr.Trunc[Fraction T f x].induction @l (\ p -> Values x) (\ p -> values-prop x)
    (\ p -> (quotient x p,along-every x p (quotient x p) (quotient-along x p))) (fractions el x) ;

  -- The extension: h(x) is the value of x.
  h-map (x : T.R) : R = (values x).1 ;
  h-value (x : T.R) : Value x (h-map x) = (values x).2 ;
  characterise (x : T.R) (c : R) (v : Value x c) : Id R (h-map x) c =
   value-unique x (h-map x) c (h-value x) v ;
  opaque values ;

  both (x w : T.R) (P : U l) (pP : Pr.isProp P)
   (k : Fraction T f x -> Fraction T f w -> P) : P =
   Tr.Trunc[Fraction T f x].induction @l (\ p -> P) (\ p -> pP)
    (\ p -> Tr.Trunc[Fraction T f w].induction @l (\ q -> P) (\ q -> pP) (k p) (fractions el w)) (fractions el x) ;
  preserves-one : Id R (h-map T.o) o =
   characterise T.o o (along-every T.o FR.unit o (mulO (map g A.o))) ;
  preserves-add (x w : T.R) : Id R (h-map (T.add x w)) (add (h-map x) (h-map w)) =
   both x w (Id R (h-map (T.add x w)) (add (h-map x) (h-map w))) (setT' _ _) (\ p q ->
    characterise (T.add x w) (add (h-map x) (h-map w))
     (along-every (T.add x w) (FR.sum x w p q) (add (h-map x) (h-map w))
      (trans (ap (\ t -> mul t (add (h-map x) (h-map w))) (G.product-image (den p) (den q)))
       (trans (Rules[T'].sum-rule (map g (den p)) (map g (den q)) (h-map x) (h-map w) (map g (num p)) (map g (num q))
                (h-value x p) (h-value w q))
        (sym (G.sum-image (num p) (den p) (num q) (den q))))))) ;
  preserves-mul (x w : T.R) : Id R (h-map (T.mul x w)) (mul (h-map x) (h-map w)) =
   both x w (Id R (h-map (T.mul x w)) (mul (h-map x) (h-map w))) (setT' _ _) (\ p q ->
    characterise (T.mul x w) (mul (h-map x) (h-map w))
     (along-every (T.mul x w) (FR.prod x w p q) (mul (h-map x) (h-map w))
      (trans (ap (\ t -> mul t (mul (h-map x) (h-map w))) (G.product-image (den p) (den q)))
       (trans (Rules[T'].product-rule (map g (den p)) (map g (den q)) (h-map x) (h-map w) (map g (num p)) (map g (num q))
                (h-value x p) (h-value w q))
        (sym (G.product-image (num p) (num q))))))) ;
  h : RH.Hom T T' = (h-map,preserves-one,preserves-add,preserves-mul) ;
  on-image (y : A.R) : Id R (h-map (map f y)) (map g y) =
   characterise (map f y) (map g y) (along-every (map f y) (FR.image y) (map g y)
    (trans (ap (\ t -> mul t (map g y)) (map-one g)) (one-left (map g y)))) ;
  extends : Id (RH.Hom A T') (RH.compose A T T' h f) g =
   RH.Properties[A,T',setT'].ext (RH.compose A T T' h f) g on-image ;

  -- Uniqueness: k . f = g makes k(x) a value of x.
  module Other (k : RH.Hom T T') (e : Id (RH.Hom A T') (RH.compose A T T' k f) g) {
   on-A (a : A.R) : Id R (map k (map f a)) (map g a) =
    Pr.happly A.R (\ a -> R) (\ a -> (map k) (map f a)) (map g) (ap (\ phi -> map phi) e) a ;
   value (x : T.R) : Value x (map k x) = \ p -> calc R {
    mul (map g (den p)) (map k x)
     =< ap (\ t -> mul t (map k x)) (sym (on-A (den p))) > mul (map k (map f (den p))) (map k x)
     =< sym (map-mul k (map f (den p)) x) > (map k) (T.mul (map f (den p)) x)
     =< ap (map k) (eqn p) > (map k) (map f (num p))
     =< on-A (num p) > (map g) (num p) } ;
   equal : Id (RH.Hom T T') h k =
    RH.Properties[T,T',setT'].ext h k (\ x -> characterise x (map k x) (value x)) ;
  } ;
  contractible : isContr (Extension T T' f g) =
   ((h,extends),\ o' -> Pr.Sigma-eq (RH.Hom T T') (\ k -> Id (RH.Hom A T') (RH.compose A T T' k f) g)
     h o'.1 extends o'.2 (Other[o'.1,o'.2].equal) (RH.Properties[A,T',setT'].set _ _)) ;
 } ;

 universal (T : CRing) (f : RH.Hom A T) (el : Elementary T f) : IsUniversal T f =
  \ T' setT' g gS -> FromElementary[T,f,el,T',setT',g,gS].contractible ;
 is-loc (T : CRing) (f : RH.Hom A T) (el : Elementary T f) : IsLoc T f = ((inverts el),universal T f el) ;
 opaque universal ;

 -- A ring map k carries units to units, so k . f inverts S when f does.
 inverts-after (T T' : CRing) (f : RH.Hom A T) (k : RH.Hom T T') (fS : Inverts T f) :
  Inverts T' (RH.compose A T T' k f) = \ s hs ->
  (map k (fS s hs).1,
   trans (sym (map-mul k (map f s) (fS s hs).1)) (trans (ap (map k) (fS s hs).2) (map-one k))) ;
 -- Two maps out of a localisation that agree on A are equal: both are
 -- extensions of k' . f, and the extensions form a contractible type.
 module Agree (T : CRing) (f : RH.Hom A T) (loc : IsLoc T f) (T' : CRing) (setT' : Pr.isSet T'.R)
  (k k' : RH.Hom T T') (e : (a : A.R) -> Id T'.R (map k (map f a)) (map k' (map f a))) {
  extensions : isContr (Extension T T' f (RH.compose A T T' k' f)) =
   loc.2 T' setT' (RH.compose A T T' k' f) (inverts-after T T' f k' loc.1) ;
  on-A : Id (RH.Hom A T') (RH.compose A T T' k f) (RH.compose A T T' k' f) =
   RH.Properties[A,T',setT'].ext (RH.compose A T T' k f) (RH.compose A T T' k' f) e ;
  equal : Id (RH.Hom T T') k k' =
   Pr.ap (Extension T T' f (RH.compose A T T' k' f)) (RH.Hom T T') (\ x -> x.1)
    (k,on-A) (k',refl (RH.compose A T T' k' f))
    (trans (sym (extensions.2 (k,on-A))) (extensions.2 (k',refl (RH.compose A T T' k' f)))) ;
 } ;
} ;
