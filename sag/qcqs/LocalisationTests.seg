-- Basic affine tests and change of the base ring, by universal properties.
-- For h:B->C and g in B, beta_C h sends g to a unit in C[1/h(g)].
-- Localisation gives the unique map h_g:B[1/g]->C[1/h(g)] extending
-- beta_C h.  The extension equation is stated as a ring-map equality.
-- For any u in Zar(B), D(g)<=u iff beta_g*(u)=top.  Forward: beta_g*(Dg)
-- is top because beta_g(g) is a unit; apply monotonicity.  Backward:
-- equality after beta_g implies u /\ Dg = top /\ Dg by
-- ZariskiSeparated.intersection, hence Dg<=u.  This is the basic-open
-- membership criterion used in descent along compact-open covers.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;
module T = AffineTests[l] ;
module ZF = ZariskiFunctor[l] ;
module At (B : T.Test) (g : B.ring.R) {
 module A = T.At[B].A ;
 module Z = T.At[B].Z ;
 module M = ZF.OnMap[B,(T.localised B g),A.inclusion g] ;
 basic-top : Id M.ZB.lattice.L (ZF.functor.reindex B (T.localised B g) (A.inclusion g) (Z.D g)) M.ZB.lattice.top =
  trans (M.on-D g) (ZariskiUnits[l].Over[(T.localised B g)].At[map (A.inclusion g) g].from-unit SpecBasicOpen[l].Over[B.ring,B.carrier-set,g].beta-unit) ;
 forward (u : Z.lattice.L) (below : Z.O.Le (Z.D g) u) :
  Id M.ZB.lattice.L (ZF.functor.reindex B (T.localised B g) (A.inclusion g) u) M.ZB.lattice.top =
  M.ZB.O.le-antisym _ _ (M.ZB.O.le-top _)
   (M.ZB.O.le-trans _ _ _ (M.ZB.O.le-of-eq _ _ (sym basic-top))
    (DL.JoinMaps[Z.lattice,M.ZB.lattice,M.lattice-map].monotone (Z.D g) u below)) ;
 backward (u : Z.lattice.L) (member : Id M.ZB.lattice.L (ZF.functor.reindex B (T.localised B g) (A.inclusion g) u) M.ZB.lattice.top) : Z.O.Le (Z.D g) u =
  trans (Z.lattice.meetC (Z.D g) u)
    (trans (ZariskiSeparated[l].OnRing[B,g].intersection u Z.lattice.top
      (trans member (sym (DL.hmap-top M.lattice-map)))) (Z.O.top-meet (Z.D g))) ;
} ;
module BaseChange (B C : T.Test) (h : RH.Hom B.ring C.ring) (g : B.ring.R) {
 module BLoc = At[B,g] ;
 module CLoc = At[C,map h g] ;
 module P = AffinePowers[l].Over[B.ring] ;
 module LH = Bridge[l].Over[B.ring,g].LocH ;
 composite : RH.Hom B.ring (T.localised C (map h g)).ring =
  RH.compose B.ring C.ring (T.localised C (map h g)).ring (CLoc.A.inclusion (map h g)) h ;
 image-unit : RL[(T.localised C (map h g)).ring].unit (map composite g) =
  SpecBasicOpen[l].Over[C.ring,C.carrier-set,map h g].beta-unit ;
 module Pow = AffinePowers[l].Over[(T.localised C (map h g)).ring] ;
 power-unit (m : Nat) : RL[(T.localised C (map h g)).ring].unit (map composite (P.power g m)) =
  Pr.subst (T.localised C (map h g)).ring.R (\ t -> RL[(T.localised C (map h g)).ring].unit t)
   (Pow.power (map composite g) m) (map composite (P.power g m))
   (sym (AffinePowers[l].power-map B.ring (T.localised C (map h g)).ring composite g m))
   (Pow.Units[(T.localised C (map h g)).carrier-set].power-unit (map composite g) image-unit m) ;
 inverts : LH.Inverts (T.localised C (map h g)).ring composite = \ s p ->
  Pr.subst B.ring.R (\ t -> RL[(T.localised C (map h g)).ring].unit (map composite t))
   (P.power g (Bridge[l].Over[B.ring,g].index p)) s (Bridge[l].Over[B.ring,g].index-eq p)
   (power-unit (Bridge[l].Over[B.ring,g].index p)) ;
 extensions : Localisation[l].isContr (LH.Extension (T.localised B g).ring (T.localised C (map h g)).ring (BLoc.A.inclusion g) composite) =
  LH.universal (T.localised B g).ring (BLoc.A.inclusion g) (BLoc.A.elementary g) (T.localised C (map h g)).ring (T.localised C (map h g)).carrier-set composite inverts ;
 map-local : RH.Hom (T.localised B g).ring (T.localised C (map h g)).ring = extensions.1.1 ;
 square : Id (RH.Hom B.ring (T.localised C (map h g)).ring)
  (RH.compose B.ring (T.localised B g).ring (T.localised C (map h g)).ring map-local (BLoc.A.inclusion g)) composite = extensions.1.2 ;
 -- Any test functor carries the square to a commuting square.
 module Functor (F : TestFunctors[l].SetFunctor) {
  equation (x : F.obj B) : Id (F.obj (T.localised C (map h g)))
   (F.reindex C (T.localised C (map h g)) (CLoc.A.inclusion (map h g)) (F.reindex B C h x))
   (F.reindex (T.localised B g) (T.localised C (map h g)) map-local (F.reindex B (T.localised B g) (BLoc.A.inclusion g) x)) =
   trans (sym (F.composition B C (T.localised C (map h g)) h (CLoc.A.inclusion (map h g)) x))
    (trans (ap (\ k -> F.reindex B (T.localised C (map h g)) k x) (sym square))
     (F.composition B (T.localised B g) (T.localised C (map h g)) (BLoc.A.inclusion g) map-local x)) ;
 } ;
} ;
