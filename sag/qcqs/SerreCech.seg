-- Cech cochains and coboundaries (Serre note, Section 5).
-- All section modules are regarded as modules over global functions by
-- restriction of scalars. Their finite products form C0 and C1. The
-- coboundary is delta(b)_ij=b_j|ij-b_i|ij. Restriction is additive and
-- semilinear, so delta is linear over global functions. Restricting delta
-- to a smaller open gives the difference of the restricted sections;
-- the telescoping identity proves the cocycle equation.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module DL = DistLattice[l] ;
module SM = SerreModule[l] ;
module MM = SerreModuleMaps[l] ;
module MP = SerreModuleProducts[l] ;
module MS = SerreModuleSheaf[l] ;
module On (L : DL.DLat) (G : RingedLattice[l].On[L].Presheaf)
 (M : MS.On[L,G].ModuleSheaf) (n : Nat) (as : Fin n -> L.L) {
 module O = DL.Order[L] ;
 module MO = MS.On[L,G].Of[M.presheaf] ;
 module GO = RingedLattice[l].On[L].Of[G] ;
 module Scalars (a : L.L) {
  module Change = MM.RestrictScalars[G.ring L.top,G.ring a,G.res a L.top (O.le-top a)].Of[M.presheaf.module-at a] ;
 } ;
 module C0 = MP.Over[G.ring L.top,Fin n,\ i -> Scalars[as i].Change.restricted] ;
 overlap (i j : Fin n) : L.L = L.meet (as i) (as j) ;
 module Row (i : Fin n) {
  module Product = MP.Over[G.ring L.top,Fin n,\ j -> Scalars[overlap i j].Change.restricted] ;
 } ;
 module C1 = MP.Over[G.ring L.top,Fin n,\ i -> Row[i].Product.product] ;
 module AtPair (i j : Fin n) {
  module Laws = SM.Over[G.ring (overlap i j)].Laws[M.presheaf.module-at (overlap i j)] ;
  module Additive = SerreCechAlgebra[l].Over[G.ring (overlap i j),M.presheaf.module-at (overlap i j)] ;
  from-left (b : C0.Carrier) : (M.presheaf.module-at (overlap i j)).M =
   MO.restrict (overlap i j) (as i) (O.meet-left (as i) (as j)) (b i) ;
  from-right (b : C0.Carrier) : (M.presheaf.module-at (overlap i j)).M =
   MO.restrict (overlap i j) (as j) (O.meet-right (as i) (as j)) (b j) ;
 } ;
 delta (b : C0.Carrier) : C1.Carrier = \ i j -> AtPair[i,j].Laws.sub (AtPair[i,j].from-right b) (AtPair[i,j].from-left b) ;
 delta-at (b : C0.Carrier) (i j : Fin n) : Id (M.presheaf.module-at (overlap i j)).M
  (delta b i j) (AtPair[i,j].Laws.sub (AtPair[i,j].from-right b) (AtPair[i,j].from-left b)) = refl (delta b i j) ;
 additive (b c : C0.Carrier) : Id C1.Carrier (delta (C0.product.madd b c)) (C1.product.madd (delta b) (delta c)) =
  C1.ext _ _ (\ i -> Row[i].Product.ext _ _ (\ j ->
   trans (cong2 (M.presheaf.module-at (overlap i j)).M AtPair[i,j].Laws.sub _ _ _ _
    (MO.res-add (overlap i j) (as j) (O.meet-right (as i) (as j)) (b j) (c j))
    (MO.res-add (overlap i j) (as i) (O.meet-left (as i) (as j)) (b i) (c i)))
    (AtPair[i,j].Additive.sub-add (AtPair[i,j].from-right b) (AtPair[i,j].from-right c)
     (AtPair[i,j].from-left b) (AtPair[i,j].from-left c)))) ;
 scalar (r : (G.ring L.top).R) (b : C0.Carrier) :
  Id C1.Carrier (delta (C0.product.sm r b)) (C1.product.sm r (delta b)) =
  C1.ext _ _ (\ i -> Row[i].Product.ext _ _ (\ j ->
   trans (cong2 (M.presheaf.module-at (overlap i j)).M AtPair[i,j].Laws.sub _ _ _ _
    (trans (MO.res-scale (overlap i j) (as j) (O.meet-right (as i) (as j)) (GO.restrict (as j) L.top (O.le-top (as j)) r) (b j))
     (ap (\ s -> (M.presheaf.module-at (overlap i j)).sm s (AtPair[i,j].from-right b))
      (G.res-comp (overlap i j) (as j) L.top (O.meet-right (as i) (as j)) (O.le-top (as j)) (O.le-top (overlap i j)) r)))
    (trans (MO.res-scale (overlap i j) (as i) (O.meet-left (as i) (as j)) (GO.restrict (as i) L.top (O.le-top (as i)) r) (b i))
     (ap (\ s -> (M.presheaf.module-at (overlap i j)).sm s (AtPair[i,j].from-left b))
      (G.res-comp (overlap i j) (as i) L.top (O.meet-left (as i) (as j)) (O.le-top (as i)) (O.le-top (overlap i j)) r))))
    (sym (AtPair[i,j].Laws.sm-sub (GO.restrict (overlap i j) L.top (O.le-top (overlap i j)) r)
     (AtPair[i,j].from-right b) (AtPair[i,j].from-left b))))) ;
 module Maps = MM.Between[G.ring L.top,G.ring L.top,RingHom[l].identity (G.ring L.top),C0.product,C1.product] ;
 coboundary : Maps.Hom = new Maps.Hom[delta,additive,scalar] ;
 coboundary-at (b : C0.Carrier) : Id C1.Carrier (Maps.map coboundary b) (delta b) = refl (delta b) ;
 module Below (w : L.L) (i j : Fin n) (wi : O.Le w (as i)) (wj : O.Le w (as j)) {
  meet-below : O.Le w (overlap i j) = O.meet-glb (as i) (as j) w wi wj ;
  module Laws = SM.Over[G.ring w].Laws[M.presheaf.module-at w] ;
  right-res (b : C0.Carrier) : Id (M.presheaf.module-at w).M
   (MO.restrict w (overlap i j) meet-below (AtPair[i,j].from-right b)) (MO.restrict w (as j) wj (b j)) =
   M.presheaf.res-comp w (overlap i j) (as j) meet-below (O.meet-right (as i) (as j)) wj (b j) ;
  left-res (b : C0.Carrier) : Id (M.presheaf.module-at w).M
   (MO.restrict w (overlap i j) meet-below (AtPair[i,j].from-left b)) (MO.restrict w (as i) wi (b i)) =
   M.presheaf.res-comp w (overlap i j) (as i) meet-below (O.meet-left (as i) (as j)) wi (b i) ;
  delta-res (b : C0.Carrier) : Id (M.presheaf.module-at w).M
   (MO.restrict w (overlap i j) meet-below (delta b i j))
   (Laws.sub (MO.restrict w (as j) wj (b j)) (MO.restrict w (as i) wi (b i))) =
   trans (ap (MO.restrict w (overlap i j) meet-below)
    (AtPair[i,j].Laws.sub-at (AtPair[i,j].from-right b) (AtPair[i,j].from-left b)))
    (trans (MO.res-add w (overlap i j) meet-below (AtPair[i,j].from-right b)
     ((M.presheaf.module-at (overlap i j)).mneg (AtPair[i,j].from-left b)))
     (trans (cong2 (M.presheaf.module-at w).M (M.presheaf.module-at w).madd _ _ _ _ (right-res b)
      (trans (MO.res-neg w (overlap i j) meet-below (AtPair[i,j].from-left b))
       (ap (M.presheaf.module-at w).mneg (left-res b))))
      (sym (Laws.sub-at (MO.restrict w (as j) wj (b j)) (MO.restrict w (as i) wi (b i)))))) ;
 } ;
 delta-cocycle (b : C0.Carrier) (w : L.L) (i j k : Fin n)
  (wi : O.Le w (as i)) (wj : O.Le w (as j)) (wk : O.Le w (as k)) :
  Id (M.presheaf.module-at w).M
   ((M.presheaf.module-at w).madd
    (MO.restrict w (overlap i j) Below[w,i,j,wi,wj].meet-below (delta b i j))
    (MO.restrict w (overlap j k) Below[w,j,k,wj,wk].meet-below (delta b j k)))
   (MO.restrict w (overlap i k) Below[w,i,k,wi,wk].meet-below (delta b i k)) =
  trans (cong2 (M.presheaf.module-at w).M (M.presheaf.module-at w).madd _ _ _ _
   (Below[w,i,j,wi,wj].delta-res b) (Below[w,j,k,wj,wk].delta-res b))
   (trans (SerreCechAlgebra[l].Over[G.ring w,M.presheaf.module-at w].telescope
    (MO.restrict w (as i) wi (b i)) (MO.restrict w (as j) wj (b j)) (MO.restrict w (as k) wk (b k)))
    (sym (Below[w,i,k,wi,wk].delta-res b))) ;
 opaque coboundary ;
} ;
