-- The sheaf of lifts is a torsor under the kernel (Serre, Section 6).
-- Its sheaf property is the general fibre-sheaf construction. Addition
-- by a kernel section preserves the fibre equation. The difference of
-- two lifts is their additive difference and belongs to the kernel.
-- Cancellation gives the unique translating kernel element. Local
-- surjectivity supplies a finite cover by lifts. Applying torsor
-- vanishing gives a mere global lift; the identity restriction equation
-- removes the displayed restriction at the top open. A lift over a is a
-- point of the torsor over a.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module DL = DistLattice[l] ;
module MS = SerreModuleSheaf[l] ;
module SM = SerreModule[l] ;
module MM = SerreModuleMaps[l] ;
module Tr = Truncation[l] ;
module On (L : DL.DLat) (G : RingedLattice[l].On[L].Presheaf)
 (E F : MS.On[L,G].ModuleSheaf)
 (q : MS.On[L,G].Transform[E.presheaf,F.presheaf].Hom)
 (surjective : MS.On[L,G].Transform[E.presheaf,F.presheaf].LocallySurjective q)
 (y : (F.presheaf.module-at L.top).M) {
 module O = DL.Order[L] ;
 module EO = MS.On[L,G].Of[E.presheaf] ;
 module FO = MS.On[L,G].Of[F.presheaf] ;
 module Maps = MS.On[L,G].Transform[E.presheaf,F.presheaf] ;
 module K = SerreModuleKernel[l].On[L,G,E,F,q] ;
 module Sets = SerreSetSheafFibre[l].On[L].Between[EO.underlying,FO.underlying] ;
 natural-map : Sets.NaturalMap = new Sets.NaturalMap[Maps.at q,q.natural] ;
 module Fibre = Sets.Fibre[natural-map,y] ;
 module Torsors = SerreTorsor[l].On[L,G].Over[K.kernel] ;
 module At (a : L.L) {
  module Laws = SM.Over[G.ring a].Laws[E.presheaf.module-at a] ;
  module QM = MM.Between[G.ring a,G.ring a,RingHom[l].identity (G.ring a),E.presheaf.module-at a,F.presheaf.module-at a] ;
  add-inverse-left (x z : (E.presheaf.module-at a).M) : Id (E.presheaf.module-at a).M ((E.presheaf.module-at a).madd ((E.presheaf.module-at a).mneg x) ((E.presheaf.module-at a).madd x z)) z =
   trans ((E.presheaf.module-at a).maddA ((E.presheaf.module-at a).mneg x) x z)
    (trans (ap (\ w -> (E.presheaf.module-at a).madd w z) (trans ((E.presheaf.module-at a).maddC ((E.presheaf.module-at a).mneg x) x) ((E.presheaf.module-at a).maddN x))) (Laws.zero-left z)) ;
  add-inverse-right (x z : (E.presheaf.module-at a).M) : Id (E.presheaf.module-at a).M ((E.presheaf.module-at a).madd x ((E.presheaf.module-at a).madd z ((E.presheaf.module-at a).mneg x))) z =
   trans (ap ((E.presheaf.module-at a).madd x) ((E.presheaf.module-at a).maddC z ((E.presheaf.module-at a).mneg x)))
    (trans ((E.presheaf.module-at a).maddA x ((E.presheaf.module-at a).mneg x) z) (trans (ap (\ w -> (E.presheaf.module-at a).madd w z) ((E.presheaf.module-at a).maddN x)) (Laws.zero-left z))) ;
  action (t : Fibre.Section a) (n : K.At[a].Carrier) : Fibre.Section a =
   ((E.presheaf.module-at a).madd (Fibre.value a t) (K.At[a].value n),
    trans (Maps.at-add q a (Fibre.value a t) (K.At[a].value n))
     (trans (cong2 (F.presheaf.module-at a).M (F.presheaf.module-at a).madd _ _ _ _ (Fibre.equation a t) (K.At[a].member n)) ((F.presheaf.module-at a).maddZ (Fibre.target a)))) ;
  action-value (t : Fibre.Section a) (n : K.At[a].Carrier) :
   Id (E.presheaf.module-at a).M (Fibre.value a (action t n)) ((E.presheaf.module-at a).madd (Fibre.value a t) (K.At[a].value n)) =
   refl ((E.presheaf.module-at a).madd (Fibre.value a t) (K.At[a].value n)) ;
  action-zero (t : Fibre.Section a) : Id (Fibre.Section a) (action t K.At[a].zero) t =
   Fibre.ext a (action t K.At[a].zero) t ((E.presheaf.module-at a).maddZ (Fibre.value a t)) ;
  action-add (t : Fibre.Section a) (n m : K.At[a].Carrier) :
   Id (Fibre.Section a) (action (action t n) m) (action t (K.At[a].add n m)) =
   Fibre.ext a (action (action t n) m) (action t (K.At[a].add n m))
    (sym ((E.presheaf.module-at a).maddA (Fibre.value a t) (K.At[a].value n) (K.At[a].value m))) ;
  difference (t u : Fibre.Section a) : K.At[a].Carrier =
   ((E.presheaf.module-at a).madd (Fibre.value a u) ((E.presheaf.module-at a).mneg (Fibre.value a t)),
    trans (Maps.at-add q a (Fibre.value a u) ((E.presheaf.module-at a).mneg (Fibre.value a t)))
     (trans (cong2 (F.presheaf.module-at a).M (F.presheaf.module-at a).madd _ _ _ _ (Fibre.equation a u)
      (trans (QM.map-neg (q.component a) (Fibre.value a t)) (ap (F.presheaf.module-at a).mneg (Fibre.equation a t))))
      ((F.presheaf.module-at a).maddN (Fibre.target a)))) ;
  difference-equation (t u : Fibre.Section a) : Id (Fibre.Section a) (action t (difference t u)) u =
   Fibre.ext a (action t (difference t u)) u (add-inverse-right (Fibre.value a t) (Fibre.value a u)) ;
  difference-unique (t u : Fibre.Section a) (n : K.At[a].Carrier)
   (e : Id (Fibre.Section a) (action t n) u) : Id (K.At[a].Carrier) (difference t u) n =
   K.At[a].ext (difference t u) n
    (trans ((E.presheaf.module-at a).maddC (Fibre.value a u) ((E.presheaf.module-at a).mneg (Fibre.value a t)))
     (trans (ap ((E.presheaf.module-at a).madd ((E.presheaf.module-at a).mneg (Fibre.value a t))) (sym (ap (Fibre.value a) e)))
      (add-inverse-left (Fibre.value a t) (K.At[a].value n)))) ;
  equation-prop (t u : Fibre.Section a) (n : K.At[a].Carrier) :
   Pr.isProp (Id (Fibre.Section a) (action t n) u) = Fibre.section-set a (action t n) u ;
  unique-difference (t u : Fibre.Section a) : Localisation[l].isContr
   ((n : K.At[a].Carrier) * Id (Fibre.Section a) (action t n) u) =
   ((difference t u,difference-equation t u),\ z ->
    Pr.Sigma-eq (K.At[a].Carrier) (\ n -> Id (Fibre.Section a) (action t n) u)
     (difference t u) z.1 (difference-equation t u) z.2 (difference-unique t u z.1 z.2) (equation-prop t u z.1)) ;
 } ;
 action-res (a b : L.L) (k : O.Le a b) (t : Fibre.Section b) (n : K.At[b].Carrier) :
  Id (Fibre.Section a) (Fibre.restrict a b k (At[b].action t n))
   (At[a].action (Fibre.restrict a b k t) (K.restrict a b k n)) =
  Fibre.ext a (Fibre.restrict a b k (At[b].action t n))
   (At[a].action (Fibre.restrict a b k t) (K.restrict a b k n))
   (EO.res-add a b k (Fibre.value b t) (K.At[b].value n)) ;
 LocalSections (a : L.L) : U l =
  (n : Nat) * (as : Fin n -> L.L) * ((i : Fin n) -> O.Le (as i) a)
   * O.Le a (DL.Joins[L].bigJ n as) * ((i : Fin n) -> Fibre.Section (as i)) ;
 from-local-lift (a : L.L) (z : Maps.LocalLift[q,a,Fibre.target a]) : LocalSections a =
  (z.count,z.opens,z.below,z.covers,\ i ->
   (z.lifts i,trans (z.lifts-to i) (Fibre.target-res (z.opens i) a (z.below i)))) ;
 local-sections (a : L.L) : Tr.Trunc[LocalSections a].carrier =
  Tr.Trunc[Maps.LocalLift[q,a,Fibre.target a]].induction @l
   (\ z -> Tr.Trunc[LocalSections a].carrier) (\ z -> Tr.Trunc[LocalSections a].proposition)
   (\ z -> Tr.Trunc[LocalSections a].inc (from-local-lift a z)) (surjective a (Fibre.target a)) ;
 torsor : Torsors.Torsor = new Torsors.Torsor[
  Fibre.presheaf,Fibre.SheafProof[E.sheaf,F.sheaf].is-sheaf,
  \ a -> At[a].action,\ a -> At[a].action-zero,\ a -> At[a].action-add,
  action-res,\ a -> At[a].unique-difference,local-sections] ;
 global-value (z : torsor.presheaf.obj L.top) : (E.presheaf.module-at L.top).M = Fibre.value L.top z ;
 global-equation (z : torsor.presheaf.obj L.top) :
  Id (F.presheaf.module-at L.top).M (Maps.at q L.top (global-value z)) y =
  trans (Fibre.equation L.top z) (F.presheaf.res-id L.top (O.le-top L.top) y) ;
 -- a lift over a is a point of the torsor
 point (a : L.L) (x : (E.presheaf.module-at a).M)
  (e : Id (F.presheaf.module-at a).M (Maps.at q a x) (Fibre.target a)) : torsor.presheaf.obj a = (x,e) ;
 opaque torsor ;
 global-lift (vanishing : Torsors.Acyclic1) :
  Tr.Trunc[(x : (E.presheaf.module-at L.top).M) * Id (F.presheaf.module-at L.top).M (Maps.at q L.top x) y].carrier =
  Tr.Trunc[torsor.presheaf.obj L.top].induction @l
   (\ z -> Tr.Trunc[(x : (E.presheaf.module-at L.top).M) * Id (F.presheaf.module-at L.top).M (Maps.at q L.top x) y].carrier)
   (\ z -> Tr.Trunc[(x : (E.presheaf.module-at L.top).M) * Id (F.presheaf.module-at L.top).M (Maps.at q L.top x) y].proposition)
   (\ z -> Tr.Trunc[(x : (E.presheaf.module-at L.top).M) * Id (F.presheaf.module-at L.top).M (Maps.at q L.top x) y].inc
    (global-value z,global-equation z))
   (vanishing torsor) ;
} ;
