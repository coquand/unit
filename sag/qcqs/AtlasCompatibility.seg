-- Forward and inverse compatibility for the reconstructed chart maps.
-- If p in chart i and r in chart j have the same F-point, the classifier
-- puts r in d_ji.  Factor r through that overlap.  The transition trace
-- and injectivity of chart i identify its image with p.  Equality of the
-- two overlap maps into the glued space proves equal geometric points.
-- Conversely, equality of their geometric points puts r in d_ji by the
-- reconstructed classifier.  The same overlap square and injectivity
-- of the reconstructed chart identify its transition image with p.
-- The transition trace now gives equality of the original F-points.
level l ; open Ring[l] ; open Presentations[l] ;
module DL = DistLattice[l] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module TE = TestEquivalences[l] ;
module CO = CompactOpens[l] ;
module SP = Spaces[l] ;
module Op = OpenMaps[l] ;
module Over (F : SF.SetFunctor) (n : Nat) (us : Fin n -> CO.Over[F].Open)
 (as : Fin n -> T.Test)
 (es : (i : Fin n) -> TE.NaturalEquivalence SF.Representable[as i].functor OpenRealisation[l].Over[F,us i].functor) {
 module R = AtlasReconstruction[l].Over[F,n,us,as,es] ;
 module D = R.D ;
 module Lift (i j : Fin n) (B : T.Test) (r : SP.Hom (T.space B) (D.X j))
  (m : Id T.At[B].Z.lattice.L (CO.Over[F].value (us i) B (D.point j B r)) T.At[B].Z.lattice.top) {
  module UP = SliceUniversal[l].Over[(D.X j).lattice,(D.X j).structure,D.d j i,(T.space B).lattice,(T.space B).structure.sheaf] ;
  module V = UP.Back[SP.underlying r,trans (D.Pair[j,i].W.classifier B r) m] ;
  q : SP.Hom (T.space B) (Op.space (D.X j) (D.d j i)) = (V.factor,V.local (T.space B).structure.inv (SP.is-local r)) ;
  triangle : Id (SP.Hom (T.space B) (D.X j))
   (SP.compose (T.space B) (Op.space (D.X j) (D.d j i)) (D.X j) (Op.inclusion (D.X j) (D.d j i)) q) r = SP.ext _ _ _ _ V.factor-cut ;
  moved : SP.Hom (T.space B) (D.X i) = SP.compose (T.space B) (Op.space (D.X j) (D.d j i)) (D.X i) (D.h i j) q ;
  trace : Id (F.obj B) (D.point i B moved) (D.point j B r) =
   trans (D.trace i j B q) (ap (D.point j B) triangle) ;
  square : Id (R.H.functor.obj B) (R.At[i].inclusion B moved) (R.At[j].inclusion B r) =
   trans SP.Associativity[T.space B,Op.space (D.X j) (D.d j i),D.X i,R.X,R.G.Projection[i].morphism,D.h i j,q].assoc
    (trans (ap (\ f -> SP.compose (T.space B) (Op.space (D.X j) (D.d j i)) R.X f q) R.G.OverlapAgreement[i,j].equation)
     (trans (sym SP.Associativity[T.space B,Op.space (D.X j) (D.d j i),D.X j,R.X,R.G.Projection[j].morphism,Op.inclusion (D.X j) (D.d j i),q].assoc)
      (ap (R.At[j].inclusion B) triangle))) ;
 } ;
 module Compare (i j : Fin n) (B : T.Test) (p : SP.Hom (T.space B) (D.X i)) (r : SP.Hom (T.space B) (D.X j)) {
  module Forward (eq : Id (F.obj B) (D.point i B p) (D.point j B r)) {
   member : Id T.At[B].Z.lattice.L (CO.Over[F].value (us i) B (D.point j B r)) T.At[B].Z.lattice.top =
    trans (ap (CO.Over[F].value (us i) B) (sym eq)) (D.member i B p) ;
   module Q = Lift[i,j,B,r,member] ;
   equal : Id (R.H.functor.obj B) (R.At[i].inclusion B p) (R.At[j].inclusion B r) =
    trans (ap (R.At[i].inclusion B) (D.Entry[i].C.injective B p Q.moved (trans eq (sym Q.trace)))) Q.square ;
  } ;
  module Backward (eq : Id (R.H.functor.obj B) (R.At[i].inclusion B p) (R.At[j].inclusion B r)) {
   member : Id T.At[B].Z.lattice.L (CO.Over[F].value (us i) B (D.point j B r)) T.At[B].Z.lattice.top =
    trans (sym (R.classifier j i B r))
     (trans (ap (R.GO.C.value (R.vs i) B) (sym eq)) (R.At[i].member B p)) ;
   module Q = Lift[i,j,B,r,member] ;
   equal : Id (F.obj B) (D.point i B p) (D.point j B r) =
    trans (ap (D.point i B) (R.At[i].injective B p Q.moved (trans eq (sym Q.square)))) Q.trace ;
  } ;
 } ;
} ;
