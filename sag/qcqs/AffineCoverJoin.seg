-- Finite unions of opens with finite affine covers again have such covers.
-- The empty family covers bottom.  For u and v, concatenate the two finite
-- families (FiniteLatticeFamilies); every member is affine and lies below
-- u \/ v, and the join is u \/ v.  Induction gives the result for a finite
-- join.  Finite choice under truncation gives the merely-existing version;
-- its elimination target is itself a propositional truncation.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module DL = DistLattice[l] ;
module Over (M : DL.DLat) (X : LocallyRinged[l].On[M].LocallyRinged) {
 module O = DL.Order[M] ;
 module J = DL.Joins[M] ;
 module B = AffineBasis[l].Over[M,X] ;
 module FF = FiniteLatticeFamilies[l].Over[M] ;
 empty : B.Cover M.bot = struct {
  count = zero ; opens = AffineFinite[l].empty-section (\ i -> M.L) ;
  below = AffineFinite[l].empty-section (\ i -> O.Le (AffineFinite[l].empty-section (\ j -> M.L) i) M.bot) ;
  covers = refl M.bot ; affine = AffineFinite[l].empty-section (\ i -> B.Q.AffineOpen (AffineFinite[l].empty-section (\ j -> M.L) i)) } ;
 module Union (u v : M.L) (a : B.Cover u) (b : B.Cover v) {
  family : FF.Family = FF.append (a.count,a.opens) b.count b.opens ;
  below : (i : Fin (FF.size family)) -> O.Le (FF.entry family i) (M.join u v) =
   FF.all (a.count,a.opens) (\ w -> O.Le w (M.join u v))
    (\ i -> O.le-trans (a.opens i) u (M.join u v) (a.below i) (O.join-left u v)) b.count b.opens
    (\ i -> O.le-trans (b.opens i) v (M.join u v) (b.below i) (O.join-right u v)) ;
  affine : (i : Fin (FF.size family)) -> B.Q.AffineOpen (FF.entry family i) =
   FF.all (a.count,a.opens) B.Q.AffineOpen a.affine b.count b.opens b.affine ;
  covers : Id M.L (FF.join family) (M.join u v) =
   trans (FF.append-join (a.count,a.opens) b.count b.opens) (cong2 M.L M.join _ _ _ _ a.covers b.covers) ;
  cover : B.Cover (M.join u v) = struct { count = FF.size family ; opens = FF.entry family ; below = below ; covers = covers ; affine = affine } ;
 } ;
 finite : (n : Nat) (us : Fin n -> M.L) -> ((i : Fin n) -> B.Cover (us i)) -> B.Cover (J.bigJ n us) = split {
  zero -> \ us hs -> empty ;
  suc n | r -> \ us hs -> Union[us (inr tt),J.bigJ n (\ i -> us (inl i)),hs (inr tt),r (\ i -> us (inl i)) (\ i -> hs (inl i))].cover } ;
 merely (n : Nat) (us : Fin n -> M.L) (hs : (i : Fin n) -> B.Merely (us i)) : B.Merely (J.bigJ n us) =
  Tr.Trunc[(i : Fin n) -> B.Cover (us i)].induction @l (\ t -> B.Merely (J.bigJ n us)) (\ t -> B.merely-prop (J.bigJ n us))
   (\ cs -> Tr.Trunc[B.Cover (J.bigJ n us)].inc (finite n us cs)) (AffineFinite[l].choice n (\ i -> B.Cover (us i)) hs) ;
} ;
