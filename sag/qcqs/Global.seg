-- The global sections of Spec A: O(top) = A (DESIGN.md, step 5, item 1).
-- Over the family f_g : A -> R_g of Sections; A is a set.
--
-- The section of a.  For a in A, the components f_g(a), D g <= u, are
--  compatible (rho_{g,h} f_g(a) = f_h(a)), so they form a section a|u of
--  O(u); a |-> a|top is a ring map A -> O(top), componentwise.
-- Lemma.  f_1 : A -> R_1 is an isomorphism.  The powers of 1 are units, so
--  the identity of A inverts them and extends to back : R_1 -> A with
--  back(f_1 a) = a (universal property).  f_1 . back and the identity of
--  R_1 agree on A, so they are equal (Localisation.Agree).
-- Theorem.  a |-> a|top is an isomorphism, with inverse s |-> back(s_1)
--  (top = D 1 by definition).  back((a|top)_1) = back(f_1 a) = a; and for
--  a section s, f_g(back(s_1)) = rho_{1,g}(f_1(back(s_1))) = rho_{1,g}(s_1)
--  = s_g, by the lemma and compatibility of s.
-- Lemma (extend-global).  On D g, the section of f_g(a) (BasicOpen) is
--  (a|top)|D g: both have the component rho_{g,h}(f_g a) = f_h(a) at h.
-- Lemma (d-global).  D_top(a|top) = D a: a|top = a|D 1 has the fraction
--  a/1, so its invertibility open is D(1 a) (SpecInv.Basic).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (Loc : A.R -> CRing) (set : (g : A.R) -> Pr.isSet (Loc g).R)
 (f : (g : A.R) -> RH.Hom A (Loc g))
 (el : (g : A.R) -> Bridge[l].Over[A,g].LocH.Elementary (Loc g) (f g)) {
 open A ;
 open ZariskiLattice[l].Over[A] ;
 module S = Sections[l].Over[A,Loc,set,f,el] ;
 module LH = Bridge[l].Over[A,o].LocH ;
 module P = AffinePowers[l].Over[A] ;

 -- top = D 1, by definition
 top-D : Id lattice.L lattice.top (D o) = refl (D o) ;
 one-top : O.Le (D o) lattice.top = O.le-refl (D o) ;

 -- the section a|u
 module Of (u : lattice.L) {
  section (a : R) : S.Section u = (\ g k -> map (f g) a, \ g h kg hg -> S.rho-on g h hg a) ;
  section-at (a : R) (g : R) (k : O.Le (D g) u) : Id (Loc g).R (S.at (section a) g k) (map (f g) a) =
   refl (map (f g) a) ;
  sections : RH.Hom A (S.ring u) =
   (section,
    S.Ops[u].ext (section o) S.Ops[u].oneS (\ g k -> map-one (f g)),
    \ a b -> S.Ops[u].ext (section (add a b)) (S.Ops[u].addS (section a) (section b)) (\ g k -> map-add (f g) a b),
    \ a b -> S.Ops[u].ext (section (mul a b)) (S.Ops[u].mulS (section a) (section b)) (\ g k -> map-mul (f g) a b)) ;
 } ;

 -- f_1 is an isomorphism
 inverts-id : LH.Inverts A (RH.identity A) = \ s p ->
  Pr.subst R (RL[A].unit) (P.power o (Bridge[l].Over[A,o].index p)) s (Bridge[l].Over[A,o].index-eq p)
   (P.Units[setA].power-unit o (o,mulO o) (Bridge[l].Over[A,o].index p)) ;
 back-ext : LH.Extension (Loc o) A (f o) (RH.identity A) =
  (LH.universal (Loc o) (f o) (el o) A setA (RH.identity A) inverts-id).1 ;
 back : RH.Hom (Loc o) A = back-ext.1 ;
 back-f (a : R) : Id R (map back (map (f o) a)) a = ap (\ k -> map k a) back-ext.2 ;
 f-back (x : (Loc o).R) : Id (Loc o).R (map (f o) (map back x)) x =
  ap (\ k -> map k x)
   (LH.Agree[Loc o,f o,LH.is-loc (Loc o) (f o) (el o),Loc o,set o,RH.compose (Loc o) A (Loc o) (f o) back,RH.identity (Loc o),
     \ a -> ap (map (f o)) (back-f a)].equal) ;

 -- Gamma(Spec A) = A
 global : RH.Hom A (S.ring lattice.top) = Of[lattice.top].sections ;
 evaluate (s : S.Section lattice.top) : R = map back (S.at s o one-top) ;
 evaluate-global (a : R) : Id R (evaluate (map global a)) a = back-f a ;
 below-one (g : R) (k : O.Le (D g) lattice.top) : O.Le (D g) (D o) =
  Pr.subst lattice.L (\ t -> O.Le (D g) t) lattice.top (D o) top-D k ;
 global-evaluate (s : S.Section lattice.top) : Id (S.Section lattice.top) (map global (evaluate s)) s =
  S.section-ext lattice.top (map global (evaluate s)) s (\ g k -> calc (Loc g).R {
   map (f g) (evaluate s) =< sym (S.rho-on o g (below-one g k) (evaluate s))
     > map (S.rho o g (below-one g k)) (map (f o) (evaluate s))
    =< ap (map (S.rho o g (below-one g k))) (f-back (S.at s o one-top)) > map (S.rho o g (below-one g k)) (S.at s o one-top)
    =< S.compat s o g one-top (below-one g k) > S.at s g (O.le-trans (D g) (D o) lattice.top (below-one g k) one-top)
    =< S.component-irr lattice.top s g (O.le-trans (D g) (D o) lattice.top (below-one g k) one-top) k > S.at s g k }) ;
 iso : Pr.isEquiv R (S.Section lattice.top) (map global) =
  Pr.qinv R (S.Section lattice.top) (map global) evaluate global-evaluate evaluate-global ;

 -- extend(f_g a) = (a|top)|D g
 module B = BasicOpen[l].Over[A,Loc,set,f,el] ;
 extend-global (g a : R) :
  Id (S.Section (D g)) (B.At[g].extend (map (f g) a)) (S.restrict (D g) lattice.top (O.le-top (D g)) (map global a)) =
  S.section-ext (D g) (B.At[g].extend (map (f g) a)) (S.restrict (D g) lattice.top (O.le-top (D g)) (map global a)) (\ h k ->
   calc (Loc h).R {
    S.at (B.At[g].extend (map (f g) a)) h k =< B.At[g].extend-at (map (f g) a) h k > map (S.rho g h k) (map (f g) a)
     =< S.rho-on g h k a > map (f h) a
     =< sym (Of[lattice.top].section-at a h (O.le-trans (D h) (D g) lattice.top k (O.le-top (D g))))
      > S.at (map global a) h (O.le-trans (D h) (D g) lattice.top k (O.le-top (D g)))
     =< sym (S.restrict-at (D g) lattice.top (O.le-top (D g)) (map global a) h k)
      > S.at (S.restrict (D g) lattice.top (O.le-top (D g)) (map global a)) h k }) ;

 -- D_top(a|top) = D a
 module SI = SpecInv[l].Over[A,Loc,set,f,el] ;
 module LA = LocallyRinged[l].On[lattice].Laws[Sheaf[l].Over[A,Loc,set,f,el].structure,SI.inv-map] ;
 d-global (a : R) : Id lattice.L (LA.d lattice.top (map global a)) (D a) =
  trans (SI.IO.unique (LA.d-open lattice.top (map global a))
    SI.Basic[o,map global a].At[Bridge[l].Over[A,o].LocH.FractionRules[Loc o,f o].image a].is-open)
   (ap D (RL[A].one-left a)) ;
} ;
