-- Functorial qcqs is invariant under natural equivalence F ~= H.
-- Pull each compact open of an H-atlas back along the equivalence.
-- The cover equation is its original equation evaluated at the image.
-- RealisationTransfer identifies each pulled realisation with the old
-- one; compose the affine witness with its inverse.  Eliminate both
-- affine witnesses and the atlas only into the corresponding truncations.
-- SheafTransfer supplies sheafhood of F.
level l ; open Ring[l] ; open Presentations[l] ;
module Tr = Truncation[l+] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module TE = TestEquivalences[l] ;
module CO = CompactOpens[l] ;
module QF = FunctorialQcqs[l] ;
module Over (F H : SF.SetFunctor) (e : TE.NaturalEquivalence F H) {
 module Q = QF.Over[F] ;
 module QH = QF.Over[H] ;
 module P = CO.Pullback[F,H,TE.forward e] ;
 module FromCover (c : QH.AffineCover) {
  opens (i : Fin c.count) : CO.Over[F].Open = P.pull (c.opens i) ;
  module At (i : Fin c.count) {
   module V = RealisationTransfer[l].Over[F,H,opens i,c.opens i,e] ;
   module R = V.Given[\ B x m -> m,\ B x m -> m] ;
   module I = TE.Inverse[V.RU.functor,V.RV.functor,R.equivalence] ;
   witness (a : QF.AffineWitness V.RV.functor) : QF.AffineWitness V.RU.functor =
    (a.1,TE.Composite[SF.Representable[a.1].functor,V.RV.functor,V.RU.functor,a.2,I.inverse-equiv].equivalence) ;
   affine : QF.IsAffine V.RU.functor = Tr.Trunc[QF.AffineWitness V.RV.functor].induction @(l+)
    (\ t -> QF.IsAffine V.RU.functor) (\ t -> Tr.Trunc[QF.AffineWitness V.RU.functor].proposition)
    (\ a -> Tr.Trunc[QF.AffineWitness V.RU.functor].inc (witness a)) (c.affine i) ;
  } ;
  cover : Q.AffineCover = struct {
   count = c.count ; opens = opens ;
   covers = \ B x -> c.covers B (SF.Transform[F,H].at (TE.forward e) B x) ;
   affine = \ i -> At[i].affine } ;
 } ;
 has-atlas (a : QH.HasAtlas) : Q.HasAtlas = Tr.Trunc[QH.AffineCover].induction @(l+)
  (\ t -> Q.HasAtlas) (\ t -> Tr.Trunc[Q.AffineCover].proposition)
  (\ c -> Tr.Trunc[Q.AffineCover].inc FromCover[c].cover) a ;
 qcqs (q : QH.IsQcqs) : Q.IsQcqs = (SheafTransfer[l].Over[F,H,e,q.1].is-sheaf,has-atlas q.2) ;
} ;
