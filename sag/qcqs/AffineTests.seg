-- All small affine tests, with their actual geometric morphisms.
-- A test is a commutative ring with set carrier; Test lives one universe
-- above its carrier.  Its affine space is the existing Affine.spec.
-- Into[T,X] is SpecUniversal in geometric notation: maps X -> Spec T
-- correspond to ring maps T -> Gamma X, with the same inverse laws.
-- For h : A -> B, Spec h is SpecHom with the existing fraction families.
-- The component equation is the defining SpecUniversal equation.
-- The identity's component is a |-> a|top, by res-id.  Spec identity has
-- the same component, so SpecUniversal.unique identifies the two maps.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module Sp = Spaces[l] ;
record Test {
 ring : CRing ;
 carrier-set : Pr.isSet ring.R ;
} ;
module At (T : Test) {
 module A = Affine[l].Over[T.ring] ;
 module Z = ZariskiLattice[l].Over[T.ring] ;
 module G = Global[l].Over[T.ring,T.carrier-set,A.Loc,A.set,A.inclusion,A.elementary] ;
} ;
-- The affine test B[1/g], shared by localisation and cover diagrams.
localised (B : Test) (g : B.ring.R) : Test = new Test[At[B].A.Loc g,At[B].A.set g] ;
space (T : Test) : Sp.Space = new Sp.Space[At[T].Z.lattice,At[T].A.spec] ;
module Into (T : Test) (X : Sp.Space) {
 module UP = SpecUniversal[l].Over[T.ring,T.carrier-set,At[T].A.Loc,At[T].A.set,At[T].A.inclusion,At[T].A.elementary,X.lattice,X.structure] ;
 component (f : Sp.Hom X (space T)) : RH.Hom T.ring (X.structure.sheaf.ring X.lattice.top) = UP.component (Sp.underlying f) ;
 morphism (phi : RH.Hom T.ring (X.structure.sheaf.ring X.lattice.top)) : Sp.Hom X (space T) =
  (UP.Of[phi].morphism,UP.Of[phi].local) ;
 component-of (phi : RH.Hom T.ring (X.structure.sheaf.ring X.lattice.top)) (a : T.ring.R) :
  Id (X.structure.sheaf.ring X.lattice.top).R (map (component (morphism phi)) a) (map phi a) = UP.Of[phi].component-of a ;
 morphism-component (f : Sp.Hom X (space T)) : Id (Sp.Hom X (space T)) (morphism (component f)) f =
  Sp.ext X (space T) (morphism (component f)) f (UP.morphism-component (Sp.underlying f) (Sp.is-local f)) ;
 unique (f g : Sp.Hom X (space T)) (e : (a : T.ring.R) ->
  Id (X.structure.sheaf.ring X.lattice.top).R (map (component f) a) (map (component g) a)) : Id (Sp.Hom X (space T)) f g =
  Sp.ext X (space T) f g (UP.unique (Sp.underlying f) (Sp.underlying g) (Sp.is-local f) (Sp.is-local g) e) ;
} ;
module Map (A B : Test) (h : RH.Hom A.ring B.ring) {
 module S = SpecHom[l].Over[A.ring,A.carrier-set,At[A].A.Loc,At[A].A.set,At[A].A.inclusion,At[A].A.elementary,
  B.ring,B.carrier-set,At[B].A.Loc,At[B].A.set,At[B].A.inclusion,At[B].A.elementary,h] ;
 morphism : Sp.Hom (space B) (space A) = (S.morphism,S.local) ;
 underlying-map : Id S.Into.Mp.Ringed (Sp.underlying morphism) S.morphism = refl S.morphism ;
 component (a : A.ring.R) : Id ((space B).structure.sheaf.ring (space B).lattice.top).R
  (map (Into[A,space B].component morphism) a) (map At[B].G.global (map h a)) =
  calc ((space B).structure.sheaf.ring (space B).lattice.top).R {
   map (Into[A,space B].component morphism) a
    =< ap (\ p -> map (S.Into.component p) a) underlying-map > map (S.Into.component S.morphism) a
    =< S.Into.Of[S.phi].component-of a > map S.phi a
    =< S.phi-map a > map At[B].G.global (map h a) } ;
 opaque morphism ;
} ;
module Identity (A : Test) {
 module T = Into[A,space A] ;
 module S = Map[A,A,RH.identity A.ring] ;
 component (a : A.ring.R) : Id ((space A).structure.sheaf.ring (space A).lattice.top).R
  (map (T.component Sp.Identity[space A].identity) a) (map At[A].G.global a) =
  trans (T.UP.component-map (Sp.underlying Sp.Identity[space A].identity) a)
   ((space A).structure.sheaf.res-id (space A).lattice.top (T.UP.psi-top (Sp.underlying Sp.Identity[space A].identity)) (map At[A].G.global a)) ;
 identity : Id (Sp.Hom (space A) (space A)) S.morphism Sp.Identity[space A].identity =
  T.unique S.morphism Sp.Identity[space A].identity (\ a -> trans (S.component a) (sym (component a))) ;
} ;

-- Spec(k h) = Spec h . Spec k: both have component a |-> k(h(a))|top.
-- SpecHom.Then computes the composite's component; SpecUniversal gives
-- equality of the maps.  All affine maps arise this way: extract their
-- component and compose with Gamma(Spec B) -> B, the inverse of Global.
-- The two inverse laws are Global's inverse laws and SpecUniversal.unique.
module Composition (A B C : Test) (h : RH.Hom A.ring B.ring) (k : RH.Hom B.ring C.ring) {
 module First = Map[A,B,h] ;
 module Second = Map[B,C,k] ;
 module Direct = Map[A,C,RH.compose A.ring B.ring C.ring k h] ;
 module Then = First.S.Then[At[C].Z.lattice,At[C].A.spec,Sp.underlying Second.morphism] ;
 module T = Into[A,space C] ;
 composite-view : Id T.UP.Mp.Ringed
  (Sp.underlying (Sp.compose (space C) (space B) (space A) First.morphism Second.morphism)) Then.C.composite =
  ap (\ p -> Compose[l].Maps[At[A].Z.lattice,At[B].Z.lattice,At[C].Z.lattice,
    At[A].A.spec.sheaf,At[B].A.spec.sheaf,At[C].A.spec.sheaf].Of[Sp.underlying Second.morphism,p].composite) First.underlying-map ;
 second-view (b : B.ring.R) : Id ((space C).structure.sheaf.ring (space C).lattice.top).R
  (map (Then.UA.component (Sp.underlying Second.morphism)) b) (map At[C].G.global (map k b)) =
  trans (ap (\ p -> map (Then.UA.component p) b) Second.underlying-map)
   (trans (Second.S.Into.Of[Second.S.phi].component-of b) (Second.S.phi-map b)) ;
 composite-component (a : A.ring.R) : Id ((space C).structure.sheaf.ring (space C).lattice.top).R
  (map (T.component (Sp.compose (space C) (space B) (space A) First.morphism Second.morphism)) a)
  (map At[C].G.global (map k (map h a))) =
  trans (ap (\ p -> map (T.UP.component p) a) composite-view)
   (trans (Then.component a) (second-view (map h a))) ;
 composition : Id (Sp.Hom (space C) (space A)) Direct.morphism
  (Sp.compose (space C) (space B) (space A) First.morphism Second.morphism) =
  T.unique Direct.morphism (Sp.compose (space C) (space B) (space A) First.morphism Second.morphism)
   (\ a -> trans (Direct.component a)
    (trans (ap (map At[C].G.global) (map-compose k h a)) (sym (composite-component a)))) ;
} ;
module MapsEquivalence (A B : Test) {
 module T = Into[A,space B] ;
 module GI = Iso[l].Inverse[B.ring,(space B).structure.sheaf.ring (space B).lattice.top,At[B].G.global,At[B].G.iso] ;
 extract (f : Sp.Hom (space B) (space A)) : RH.Hom A.ring B.ring =
  RH.compose A.ring ((space B).structure.sheaf.ring (space B).lattice.top) B.ring GI.inverse (T.component f) ;
 extract-map (h : RH.Hom A.ring B.ring) : Id (RH.Hom A.ring B.ring) (extract Map[A,B,h].morphism) h =
  RH.Properties[A.ring,B.ring,B.carrier-set].ext (extract Map[A,B,h].morphism) h (\ a ->
   trans (ap (map GI.inverse) (Map[A,B,h].component a)) (GI.left (map h a))) ;
 rebuild (f : Sp.Hom (space B) (space A)) : Id (Sp.Hom (space B) (space A)) Map[A,B,extract f].morphism f =
  T.unique Map[A,B,extract f].morphism f (\ a -> trans (Map[A,B,extract f].component a) (GI.right (map (T.component f) a))) ;
 equivalence : Pr.isEquiv (RH.Hom A.ring B.ring) (Sp.Hom (space B) (space A)) (\ h -> Map[A,B,h].morphism) =
  Pr.qinv (RH.Hom A.ring B.ring) (Sp.Hom (space B) (space A)) (\ h -> Map[A,B,h].morphism) extract rebuild extract-map ;
} ;
