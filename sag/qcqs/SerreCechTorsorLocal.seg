-- Local points of the twisted-coordinate torsor (Serre §5).
-- On chart i use the coordinate family x_j=c_ij. The cocycle equation
-- c_ij+c_jk=c_ik gives x_k-x_j=c_jk on the required meet domain.
-- Restrict these actual points to a meet u_i to obtain local sections
-- on the finite meet cover of each a. Together with unique differences
-- and the checked natural action, this packages an actual M-torsor.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module DL = DistLattice[l] ;
module SM = SerreModule[l] ; module MS = SerreModuleSheaf[l] ;
module Tr = Truncation[l] ;
module On (L : DL.DLat) (G : RingedLattice[l].On[L].Presheaf)
 (M : MS.On[L,G].ModuleSheaf) (n : Nat) (as : Fin n -> L.L)
 (c : SerreCechCocycles[l].On[L,G,M,n,as].Cocycle)
 (covers : DL.Order[L].Le L.top (DL.Joins[L].bigJ n as)) {
 module T = SerreCechTorsorCoordinates[l].On[L,G,M,n,as,c] ;
 module Action = SerreCechTorsorAction[l].On[L,G,M,n,as,c] ;
 module Difference = SerreCechTorsorDifference[l].On[L,G,M,n,as,c,covers] ;
 module O = T.O ; module J = DL.Joins[L] ; module MO = T.MO ; module Z = T.Z ;
 module Below (w : L.L) (i j k : Fin n)
  (wi : O.Le w (as i)) (wj : O.Le w (as j)) (wk : O.Le w (as k)) {
  module Q = Z.Triple[i,j,k] ;
  ij : O.Le w (Z.C.overlap i j) = O.meet-glb (as i) (as j) w wi wj ;
  jk : O.Le w (Z.C.overlap j k) = O.meet-glb (as j) (as k) w wj wk ;
  ik : O.Le w (Z.C.overlap i k) = O.meet-glb (as i) (as k) w wi wk ;
  triple : O.Le w Q.domain = O.meet-glb (Z.C.overlap i j) (as k) w ij wk ;
  cocycle : Id (M.presheaf.module-at w).M
   ((M.presheaf.module-at w).madd
    (MO.restrict w (Z.C.overlap i j) ij (Z.value c i j))
    (MO.restrict w (Z.C.overlap j k) jk (Z.value c j k)))
   (MO.restrict w (Z.C.overlap i k) ik (Z.value c i k)) =
   trans (cong2 (M.presheaf.module-at w).M (M.presheaf.module-at w).madd _ _ _ _
    (sym (M.presheaf.res-comp w Q.domain (Z.C.overlap i j) triple Q.ij ij (Z.value c i j)))
    (sym (M.presheaf.res-comp w Q.domain (Z.C.overlap j k) triple Q.jk jk (Z.value c j k))))
    (trans (sym (MO.res-add w Q.domain triple
     (MO.restrict Q.domain (Z.C.overlap i j) Q.ij (Z.value c i j))
     (MO.restrict Q.domain (Z.C.overlap j k) Q.jk (Z.value c j k))))
     (trans (ap (MO.restrict w Q.domain triple) (Z.law c i j k))
      (M.presheaf.res-comp w Q.domain (Z.C.overlap i k) triple Q.ik ik (Z.value c i k)))) ;
 } ;
 module OnChart (i : Fin n) {
  coordinates (j : Fin n) : (M.presheaf.module-at (L.meet (as i) (as j))).M = Z.value c i j ;
  module Pair (p : T.PairIndex) {
   module P = T.Pair[as i,p] ;
   wi : O.Le P.domain (as i) = P.below-a ;
   wj : O.Le P.domain (as p.1) = O.le-trans P.domain (Z.C.overlap p.1 p.2) (as p.1)
    P.below-overlap (O.meet-left (as p.1) (as p.2)) ;
   wk : O.Le P.domain (as p.2) = O.le-trans P.domain (Z.C.overlap p.1 p.2) (as p.2)
    P.below-overlap (O.meet-right (as p.1) (as p.2)) ;
   module B = Below[P.domain,i,p.1,p.2,wi,wj,wk] ;
   module Additive = SerreCechAlgebra[l].Over[G.ring P.domain,M.presheaf.module-at P.domain] ;
   left-eq : Id (M.presheaf.module-at P.domain).M (P.left coordinates)
    (MO.restrict P.domain (Z.C.overlap i p.1) B.ij (Z.value c i p.1)) =
    MO.res-irr P.domain (Z.C.overlap i p.1) P.below-left B.ij (Z.value c i p.1) ;
   right-eq : Id (M.presheaf.module-at P.domain).M (P.right coordinates)
    (MO.restrict P.domain (Z.C.overlap i p.2) B.ik (Z.value c i p.2)) =
    MO.res-irr P.domain (Z.C.overlap i p.2) P.below-right B.ik (Z.value c i p.2) ;
   equation : Id (M.presheaf.module-at P.domain).M (T.difference (as i) coordinates p) (T.twist (as i) p) =
    trans (cong2 (M.presheaf.module-at P.domain).M P.Laws.sub _ _ _ _ right-eq left-eq)
     (trans (ap (\ z -> P.Laws.sub z (MO.restrict P.domain (Z.C.overlap i p.1) B.ij (Z.value c i p.1))) (sym B.cocycle))
      (trans (ap (\ z -> P.Laws.sub z (MO.restrict P.domain (Z.C.overlap i p.1) B.ij (Z.value c i p.1)))
       ((M.presheaf.module-at P.domain).maddC
        (MO.restrict P.domain (Z.C.overlap i p.1) B.ij (Z.value c i p.1))
        (MO.restrict P.domain (Z.C.overlap p.1 p.2) B.jk (Z.value c p.1 p.2))))
       (trans (Additive.sub-cancel-right
        (MO.restrict P.domain (Z.C.overlap p.1 p.2) B.jk (Z.value c p.1 p.2))
        (MO.restrict P.domain (Z.C.overlap i p.1) B.ij (Z.value c i p.1)))
        (MO.res-irr P.domain (Z.C.overlap p.1 p.2) B.jk P.below-overlap (Z.value c p.1 p.2))))) ;
  } ;
  point : T.Fibre.Section (as i) = T.make-section (as i) coordinates (T.F.At[as i].P.ext _ _ (\ p -> Pair[p].equation)) ;
  point-value : Id T.E.At[as i].P.Carrier (T.Fibre.value (as i) point) coordinates =
   T.make-value (as i) coordinates (T.F.At[as i].P.ext _ _ (\ p -> Pair[p].equation)) ;
  opaque point ;
 } ;
 local-sections (a : L.L) :
  Tr.Trunc[(k : Nat) * (bs : Fin k -> L.L) * ((j : Fin k) -> O.Le (bs j) a)
   * O.Le a (J.bigJ k bs) * ((j : Fin k) -> T.presheaf.obj (bs j))].carrier =
  Tr.Trunc[(k : Nat) * (bs : Fin k -> L.L) * ((j : Fin k) -> O.Le (bs j) a)
   * O.Le a (J.bigJ k bs) * ((j : Fin k) -> T.presheaf.obj (bs j))].inc
   (n,Difference.OnOpen[a].piece,Difference.OnOpen[a].below,Difference.OnOpen[a].covering,
    \ i -> T.Fibre.restrict (L.meet a (as i)) (as i) (O.meet-right a (as i)) OnChart[i].point) ;
 module Torsors = SerreTorsor[l].On[L,G].Over[M] ;
 torsor : Torsors.Torsor = new Torsors.Torsor[T.presheaf,T.sheaf,
  Action.action,Action.action-zero,Action.action-add,Action.action-res,
  \ a x y -> Difference.OnOpen[a].Difference[x,y].contractible,local-sections] ;
 local-point (i : Fin n) : torsor.presheaf.obj (as i) = OnChart[i].point ;
 local-point-value (i : Fin n) :
  Id T.E.At[as i].P.Carrier (T.Fibre.value (as i) (local-point i)) OnChart[i].coordinates = OnChart[i].point-value ;
 -- Keep the structural record transparent for its displayed section carrier.
 -- The action, sheafhood, local points and difference proof are opaque.
 opaque local-sections ;
} ;
