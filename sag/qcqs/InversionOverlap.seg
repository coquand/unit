-- The key lemma for the global sections of P^1 (DESIGN.md, Next 5, step 4).
-- k is any commutative ring (the zero ring included), A = k[X],
-- L = A[1/X] with f = f_X, x = f(X), and the involution sigma (Inversion),
-- sigma . f = tau the polynomial map fixing k with tau(X) = x^-1.
--
-- Lemma.  If f(p) = sigma(f(q)) for p, q in A, then p = q and p is the
-- constant coef_0(p).
-- Proof.  By induction on a coefficient list of q (the statement is a
-- proposition, A being a set), for every p at once.
--  q = 0: f(p) = tau(0) = 0 = f(0), so p = 0 (f is injective,
--   VariableKernel), and 0 is the constant 0.
--  q = c + X q' (horner): f(p) = tau(q) = f(c) + x^-1 tau(q').  Put
--   p' = X (p - c); then f(p') = x (f(p) - f(c)) = x x^-1 tau(q') = tau(q'),
--   so by induction p' = q' and p' is the constant coef_0(p') = 0
--   (PolynomialCoefficients.shift-coef).  Hence X (p - c) = 0, so p = c
--   (X is regular), and q' = 0, so q = c + X 0 = c.
-- The review planned one step for all coefficients (multiply by X^n and
-- compare coefficients above n); peeling one coefficient at a time needs
-- only the constant coefficient of X g.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) {
 module I = Inversion[l].Over[k,setk] ;
 module P = I.P ;
 module PR = Poly[l].PolyR[k] ;
 module PC = PolynomialCoefficients[l].Over[k,setk] ;
 module VK = VariableKernel[l].Over[k,setk] ;
 module RP = RL[P.ring] ;
 module RLx = RL[I.AP.Loc P.variable] ;

 -- the conclusion: p = q, and p is a constant
 Constant (p q : P.ring.R) : U l = Id P.ring.R p q * Id P.ring.R p (P.constant (PC.coef p zero)) ;
 constant-prop (p q : P.ring.R) : Pr.isProp (Constant p q) =
  Pr.isProp-Sigma (Id P.ring.R p q) (\ e -> Id P.ring.R p (P.constant (PC.coef p zero)))
   (P.set p q) (\ e -> P.set p (P.constant (PC.coef p zero))) ;
 -- the constant 0 is 0
 constant-zero : Id P.ring.R (P.constant k.z) P.zeroQ = P.Q.relates (cons k.z nil) nil PC.zero-tail ;
 -- the constant coefficient of a constant
 coef-constant (c : k.R) : Id k.R (PC.coef (P.constant c) zero) c = PC.coef-include (cons c nil) zero ;

 -- q = 0
 module Zero (p : P.ring.R) (e : Id (I.AP.Loc P.variable).R (map (I.AP.inclusion P.variable) p) (map I.T.extend P.zeroQ)) {
  vanish : Id P.ring.R p P.zeroQ =
   VK.Kernel[p,P.zeroQ,trans e (trans (map-zero I.T.extend) (sym (map-zero (I.AP.inclusion P.variable))))].equal ;
  constant : Constant p P.zeroQ =
   (vanish,
    trans vanish (sym (calc P.ring.R {
     P.constant (PC.coef p zero) =< ap (\ t -> P.constant (PC.coef t zero)) vanish > P.constant (PC.coef P.zeroQ zero)
      =< ap P.constant (PC.coef-zero zero) > P.constant k.z
      =< constant-zero > P.zeroQ }))) ;
 } ;

 -- q = c + X q'
 module Step (c : k.R) (cs : PR.P)
  (ih : (p : P.ring.R) -> Id (I.AP.Loc P.variable).R (map (I.AP.inclusion P.variable) p) (map I.T.extend (P.include cs)) -> Constant p (P.include cs))
  (p : P.ring.R) (e : Id (I.AP.Loc P.variable).R (map (I.AP.inclusion P.variable) p) (map I.T.extend (P.include (cons c cs)))) {
  q1 : P.ring.R = P.include cs ;
  w : (I.AP.Loc P.variable).R = map I.T.extend q1 ;
  -- f(p) = f(c) + x^-1 tau(q')
  expand : Id (I.AP.Loc P.variable).R (map (I.AP.inclusion P.variable) p)
   ((I.AP.Loc P.variable).add (map (I.AP.inclusion P.variable) (P.constant c)) ((I.AP.Loc P.variable).mul I.x-inv w)) = calc (I.AP.Loc P.variable).R {
   map (I.AP.inclusion P.variable) p =< e > map I.T.extend (P.include (cons c cs))
    =< ap (map I.T.extend) (P.horner c cs) > map I.T.extend (P.ring.add (P.constant c) (P.ring.mul P.variable q1))
    =< map-add I.T.extend (P.constant c) (P.ring.mul P.variable q1)
     > (I.AP.Loc P.variable).add (map I.T.extend (P.constant c)) (map I.T.extend (P.ring.mul P.variable q1))
    =< ap ((I.AP.Loc P.variable).add (map I.T.extend (P.constant c))) (map-mul I.T.extend P.variable q1)
     > (I.AP.Loc P.variable).add (map I.T.extend (P.constant c)) ((I.AP.Loc P.variable).mul (map I.T.extend P.variable) w)
    =< ap (\ t -> (I.AP.Loc P.variable).add t ((I.AP.Loc P.variable).mul (map I.T.extend P.variable) w)) (I.T.on-constants c)
     > (I.AP.Loc P.variable).add (map (I.AP.inclusion P.variable) (P.constant c)) ((I.AP.Loc P.variable).mul (map I.T.extend P.variable) w)
    =< ap (\ t -> (I.AP.Loc P.variable).add (map (I.AP.inclusion P.variable) (P.constant c)) ((I.AP.Loc P.variable).mul t w)) I.T.on-variable
     > (I.AP.Loc P.variable).add (map (I.AP.inclusion P.variable) (P.constant c)) ((I.AP.Loc P.variable).mul I.x-inv w) } ;
  -- p' = X (p - c) has f(p') = tau(q')
  p1 : P.ring.R = P.ring.mul P.variable (P.ring.add p (P.ring.neg (P.constant c))) ;
  difference : Id (I.AP.Loc P.variable).R (map (I.AP.inclusion P.variable) (P.ring.add p (P.ring.neg (P.constant c)))) ((I.AP.Loc P.variable).mul I.x-inv w) =
   calc (I.AP.Loc P.variable).R {
    map (I.AP.inclusion P.variable) (P.ring.add p (P.ring.neg (P.constant c)))
     =< map-add (I.AP.inclusion P.variable) p (P.ring.neg (P.constant c))
      > (I.AP.Loc P.variable).add (map (I.AP.inclusion P.variable) p) (map (I.AP.inclusion P.variable) (P.ring.neg (P.constant c)))
     =< ap ((I.AP.Loc P.variable).add (map (I.AP.inclusion P.variable) p)) (map-neg (I.AP.inclusion P.variable) (P.constant c))
      > (I.AP.Loc P.variable).add (map (I.AP.inclusion P.variable) p) ((I.AP.Loc P.variable).neg (map (I.AP.inclusion P.variable) (P.constant c)))
     =< ap (\ t -> (I.AP.Loc P.variable).add t ((I.AP.Loc P.variable).neg (map (I.AP.inclusion P.variable) (P.constant c)))) expand
      > (I.AP.Loc P.variable).add ((I.AP.Loc P.variable).add (map (I.AP.inclusion P.variable) (P.constant c)) ((I.AP.Loc P.variable).mul I.x-inv w))
         ((I.AP.Loc P.variable).neg (map (I.AP.inclusion P.variable) (P.constant c)))
     =< ap (\ t -> (I.AP.Loc P.variable).add t ((I.AP.Loc P.variable).neg (map (I.AP.inclusion P.variable) (P.constant c))))
         ((I.AP.Loc P.variable).addC (map (I.AP.inclusion P.variable) (P.constant c)) ((I.AP.Loc P.variable).mul I.x-inv w))
      > (I.AP.Loc P.variable).add ((I.AP.Loc P.variable).add ((I.AP.Loc P.variable).mul I.x-inv w) (map (I.AP.inclusion P.variable) (P.constant c)))
         ((I.AP.Loc P.variable).neg (map (I.AP.inclusion P.variable) (P.constant c)))
     =< RLx.add-neg-cancel ((I.AP.Loc P.variable).mul I.x-inv w) (map (I.AP.inclusion P.variable) (P.constant c))
      > (I.AP.Loc P.variable).mul I.x-inv w } ;
  shifted : Id (I.AP.Loc P.variable).R (map (I.AP.inclusion P.variable) p1) w = calc (I.AP.Loc P.variable).R {
   map (I.AP.inclusion P.variable) p1 =< map-mul (I.AP.inclusion P.variable) P.variable (P.ring.add p (P.ring.neg (P.constant c)))
     > (I.AP.Loc P.variable).mul I.x (map (I.AP.inclusion P.variable) (P.ring.add p (P.ring.neg (P.constant c))))
    =< ap ((I.AP.Loc P.variable).mul I.x) difference > (I.AP.Loc P.variable).mul I.x ((I.AP.Loc P.variable).mul I.x-inv w)
    =< (I.AP.Loc P.variable).mulA I.x I.x-inv w > (I.AP.Loc P.variable).mul ((I.AP.Loc P.variable).mul I.x I.x-inv) w
    =< ap (\ t -> (I.AP.Loc P.variable).mul t w) I.x-x-inv > (I.AP.Loc P.variable).mul (I.AP.Loc P.variable).o w
    =< RLx.one-left w > w } ;
  -- by induction, p' = q' = 0
  induction : Constant p1 q1 = ih p1 shifted ;
  p1-zero : Id P.ring.R p1 P.zeroQ = calc P.ring.R {
   p1 =< induction.2 > P.constant (PC.coef p1 zero)
    =< ap P.constant (PC.shift-coef (P.ring.add p (P.ring.neg (P.constant c)))).1 > P.constant k.z
    =< constant-zero > P.zeroQ } ;
  q1-zero : Id P.ring.R q1 P.zeroQ = trans (sym induction.1) p1-zero ;
  -- so p = c and q = c
  p-c : Id P.ring.R p (P.constant c) =
   VK.Reg.difference p (P.constant c)
    (VK.regular (P.ring.add p (P.ring.neg (P.constant c))) P.zeroQ (trans p1-zero (sym (RP.mul-zero P.variable)))) ;
  q-c : Id P.ring.R (P.include (cons c cs)) (P.constant c) = calc P.ring.R {
   P.include (cons c cs) =< P.horner c cs > P.ring.add (P.constant c) (P.ring.mul P.variable q1)
    =< ap (\ t -> P.ring.add (P.constant c) (P.ring.mul P.variable t)) q1-zero
     > P.ring.add (P.constant c) (P.ring.mul P.variable P.zeroQ)
    =< RP.add-mulzero (P.constant c) P.variable > P.constant c } ;
  constant : Constant p (P.include (cons c cs)) =
   (trans p-c (sym q-c),
    trans p-c (ap P.constant (sym (trans (ap (\ t -> PC.coef t zero) p-c) (coef-constant c))))) ;
 } ;

 -- the lemma, first for tau(q)
 on-lists : (cs : PR.P) (p : P.ring.R) -> Id (I.AP.Loc P.variable).R (map (I.AP.inclusion P.variable) p) (map I.T.extend (P.include cs)) ->
  Constant p (P.include cs) = split {
  nil -> \ p e -> Zero[p,e].constant ;
  cons c cs | ih -> \ p e -> Step[c,cs,ih,p,e].constant } ;
 on-tau : (q p : P.ring.R) -> Id (I.AP.Loc P.variable).R (map (I.AP.inclusion P.variable) p) (map I.T.extend q) -> Constant p q =
  P.Q.induction @l (\ q -> (p : P.ring.R) -> Id (I.AP.Loc P.variable).R (map (I.AP.inclusion P.variable) p) (map I.T.extend q) -> Constant p q)
   (\ q -> F.isProp-Pi P.ring.R (\ p -> Id (I.AP.Loc P.variable).R (map (I.AP.inclusion P.variable) p) (map I.T.extend q) -> Constant p q)
     (\ p -> F.isProp-Pi (Id (I.AP.Loc P.variable).R (map (I.AP.inclusion P.variable) p) (map I.T.extend q)) (\ e -> Constant p q)
       (\ e -> constant-prop p q)))
   on-lists ;
 -- f(p) = sigma(f(q)) gives p = q, a constant
 overlap (p q : P.ring.R) (e : Id (I.AP.Loc P.variable).R (map (I.AP.inclusion P.variable) p) (map I.sigma (map (I.AP.inclusion P.variable) q))) : Constant p q =
  on-tau q p (trans e (I.sigma-f q)) ;
} ;
