-- Native functors on the existing k-algebra tests (§1 of the note).
-- Values are small sets; action is on genuine algebra maps and obeys
-- identity and composition.  Natural transformations have pointwise
-- naturality; it is a proposition, so they are a set and are equal by
-- their values.  The representable is the existing algebra hom type.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Hi = Prelude[l+] ;
module FE = Axioms[l+].FunExtLemmas[fe @l+] ;
module T = AffineTests[l] ;
module RH = RingHom[l] ;
module Over (K : T.Test) {
 module RT = RelativeTests[l].Over[K] ;
 module BP = RT.BP ;
 record SetFunctor {
  obj : BP.Algebra -> U l ;
  set (A : BP.Algebra) : Pr.isSet (obj A) ;
  reindex (A B : BP.Algebra) : BP.Hom A B -> obj A -> obj B ;
  identity (A : BP.Algebra) (x : obj A) : Id (obj A) (reindex A A (BP.id-hom A) x) x ;
  composition (A B C : BP.Algebra) (f : BP.Hom A B) (g : BP.Hom B C) (x : obj A) :
   Id (obj C) (reindex A C (BP.compose-hom A B C g f) x) (reindex B C g (reindex A B f x)) ;
 } ;
 module Transform (F G : SetFunctor) {
  Comp : U l+ = (A : BP.Algebra) -> F.obj A -> G.obj A ;
  Natural (a : Comp) : U l+ = (A B : BP.Algebra) (h : BP.Hom A B) (x : F.obj A) ->
   Id (G.obj B) (a B (F.reindex A B h x)) (G.reindex A B h (a A x)) ;
  natural-prop (a : Comp) : Hi.isProp (Natural a) =
   FE.isProp-Pi BP.Algebra (\ A -> (B : BP.Algebra) (h : BP.Hom A B) (x : F.obj A) -> Id (G.obj B) (a B (F.reindex A B h x)) (G.reindex A B h (a A x))) (\ A ->
   FE.isProp-Pi BP.Algebra (\ B -> (h : BP.Hom A B) (x : F.obj A) -> Id (G.obj B) (a B (F.reindex A B h x)) (G.reindex A B h (a A x))) (\ B ->
   FE.isProp-Pi (BP.Hom A B) (\ h -> (x : F.obj A) -> Id (G.obj B) (a B (F.reindex A B h x)) (G.reindex A B h (a A x))) (\ h ->
   FE.isProp-Pi (F.obj A) (\ x -> Id (G.obj B) (a B (F.reindex A B h x)) (G.reindex A B h (a A x))) (\ x -> G.set B _ _)))) ;
  Nat : U l+ = (a : Comp) * Natural a ;
  at (a : Nat) (A : BP.Algebra) (x : F.obj A) : G.obj A = a.1 A x ;
  natural (a : Nat) : Natural a.1 = a.2 ;
  ext (a b : Nat) (e : (A : BP.Algebra) (x : F.obj A) -> Id (G.obj A) (at a A x) (at b A x)) : Id Nat a b =
   Hi.Sigma-eq Comp Natural a.1 b.1 a.2 b.2
    (FE.funext BP.Algebra (\ A -> F.obj A -> G.obj A) a.1 b.1 (\ A -> FE.funext (F.obj A) (\ x -> G.obj A) (a.1 A) (b.1 A) (e A))) (natural-prop b.1) ;
  set : Hi.isSet Nat = Hi.isSet-Sigma Comp Natural
   (FE.isSet-Pi BP.Algebra (\ A -> F.obj A -> G.obj A) (\ A -> FE.isSet-Pi (F.obj A) (\ x -> G.obj A) (\ x -> G.set A)))
   (\ a -> Hi.prop-to-set (Natural a) (natural-prop a)) ;
 } ;
 identity (F : SetFunctor) : Transform[F,F].Nat = (\ A x -> x,\ A B h x -> refl (F.reindex A B h x)) ;
 module Composite (F G H : SetFunctor) (b : Transform[G,H].Nat) (a : Transform[F,G].Nat) {
  composite : Transform[F,H].Nat = (\ A x -> Transform[G,H].at b A (Transform[F,G].at a A x),\ A B h x ->
   trans (ap (Transform[G,H].at b B) (Transform[F,G].natural a A B h x))
    (Transform[G,H].natural b A B h (Transform[F,G].at a A x))) ;
 } ;
 module Representable (A : BP.Algebra) {
  functor : SetFunctor = new SetFunctor[\ B -> BP.Hom A B,\ B -> RT.set A B,\ B C h f -> BP.compose-hom A B C h f,
   \ B f -> RT.ext A B _ _ (RH.Properties[(BP.test A).ring,(BP.test B).ring,(BP.test B).carrier-set].ext _ _ (\ x -> refl (RingMaps[l].map (BP.ring-map f) x))),
   \ B C D f g h -> RT.ext A D _ _ (RH.Properties[(BP.test A).ring,(BP.test D).ring,(BP.test D).carrier-set].ext _ _ (\ x -> refl
    (RingMaps[l].map (BP.ring-map g) (RingMaps[l].map (BP.ring-map f) (RingMaps[l].map (BP.ring-map h) x)))))] ;
 } ;
} ;
