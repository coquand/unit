-- Identity of module presheaves and sheaves on (L, G): the presheaves F
-- with a natural linear equivalence E ~ F (SerreModuleSheafIso.Equivalence)
-- form a contractible type, and so do the sheaves.
-- Informal proof, as FunctorIdentity for set functors.  A presheaf is a
-- family of modules a |-> E(a) (a module over G(a)), decorated by
-- restriction maps and their two laws.  (1) Families: pointwise linear
-- equivalences have a contractible total space, a retract of the product
-- over a of the contractible totals of SerreModuleLinearIdentity (weak
-- function extensionality).  (2) Decoration: at the identity family
-- equivalence, naturality says that two restriction maps agree pointwise;
-- by function extensionality (over a, b, k) and extensionality of
-- semilinear maps they are equal, and the laws are propositions; so the
-- total space of decorations is contractible (DecoratedIdentity.Data).
-- (3) The record Presheaf is a retract of these parts (record eta by
-- splitting), and a natural linear equivalence is these parts reordered
-- (record eta of Transform.Hom).  (4) Sheafhood is a proposition (a
-- product of contractibility assertions), so DecoratedIdentity.Property
-- gives the sheaves.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Hi = Prelude[l+] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module IT = IdentityTools[l] ;
module GH = SipGeneric[l+] ;
module DL = DistLattice[l] ;
module SM = SerreModule[l] ;
module MM = SerreModuleMaps[l] ;
module SS = SerreSetSheaf[l] ;
module MS = SerreModuleSheaf[l] ;
module LI = SerreModuleLinearIdentity[l] ;
-- semilinear maps are determined by their underlying maps
module Semi (A B : CRing) (h : RingHom[l].Hom A B) (M : SM.Over[A].Module) (N : SM.Over[B].Module) {
 module H = MM.Between[A,B,h,M,N] ;
 AddAt (f : M.M -> N.M) (x y : M.M) : U l = Id N.M (f (M.madd x y)) (N.madd (f x) (f y)) ;
 ScaleAt (f : M.M -> N.M) (r : A.R) (x : M.M) : U l = Id N.M (f (M.sm r x)) (N.sm (RingMaps[l].map h r) (f x)) ;
 Additive (f : M.M -> N.M) : U l = (x y : M.M) -> AddAt f x y ;
 Scalar (f : M.M -> N.M) : U l = (r : A.R) (x : M.M) -> ScaleAt f r x ;
 Laws (f : M.M -> N.M) : U l = Additive f * Scalar f ;
 laws-prop (f : M.M -> N.M) : Pr.isProp (Laws f) =
  IT.both (Additive f) (Scalar f)
   (FL.isProp-Pi M.M (\ x -> (y : M.M) -> AddAt f x y) (\ x -> FL.isProp-Pi M.M (AddAt f x) (\ y -> N.setM _ _)))
   (FL.isProp-Pi A.R (\ r -> (x : M.M) -> ScaleAt f r x) (\ r -> FL.isProp-Pi M.M (ScaleAt f r) (\ x -> N.setM _ _))) ;
 pack (f : H.Hom) : (u : M.M -> N.M) * Laws u = (f.fn,f.additive,f.scalar) ;
 unpack (w : (u : M.M -> N.M) * Laws u) : H.Hom = new H.Hom[w.1,w.2.1,w.2.2] ;
 eta : (f : H.Hom) -> Id H.Hom (unpack (pack f)) f = split { Hom fn additive scalar -> refl (new H.Hom[fn,additive,scalar]) } ;
 ext (f g : H.Hom) (at : (x : M.M) -> Id N.M (f.fn x) (g.fn x)) : Id H.Hom f g =
  trans (sym (eta f)) (trans (ap unpack
   (Pr.Sigma-eq _ Laws f.fn g.fn (pack f).2 (pack g).2 (FL.funext M.M (\ x -> N.M) f.fn g.fn at) (laws-prop g.fn))) (eta g)) ;
} ;
-- sheafhood of a set presheaf is a proposition
module SetSheaf (L : DL.DLat) (S : SS.On[L].Presheaf) {
 module SO = SS.On[L].Of[S] ;
 module O = DL.Order[L] ;
 module J = DL.Joins[L] ;
 module LC = Localisation[l] ;
 Glue (m : L.L) (n : Nat) (ms : Fin n -> L.L) (le : (i : Fin n) -> O.Le (ms i) m)
  (covers : O.Le m (J.bigJ n ms)) (xs : (i : Fin n) -> S.obj (ms i)) : U l =
  SO.Cover[m,n,ms,le,covers].Compatible xs -> LC.isContr (SO.Cover[m,n,ms,le,covers].Amalgam xs) ;
 sheaf-prop : Pr.isProp SO.IsSheaf =
  FL.isProp-Pi L.L (\ m -> (n : Nat) (ms : Fin n -> L.L) (le : (i : Fin n) -> O.Le (ms i) m)
   (covers : O.Le m (J.bigJ n ms)) (xs : (i : Fin n) -> S.obj (ms i)) -> Glue m n ms le covers xs) (\ m ->
  FL.isProp-Pi Nat (\ n -> (ms : Fin n -> L.L) (le : (i : Fin n) -> O.Le (ms i) m)
   (covers : O.Le m (J.bigJ n ms)) (xs : (i : Fin n) -> S.obj (ms i)) -> Glue m n ms le covers xs) (\ n ->
  FL.isProp-Pi (Fin n -> L.L) (\ ms -> (le : (i : Fin n) -> O.Le (ms i) m)
   (covers : O.Le m (J.bigJ n ms)) (xs : (i : Fin n) -> S.obj (ms i)) -> Glue m n ms le covers xs) (\ ms ->
  FL.isProp-Pi ((i : Fin n) -> O.Le (ms i) m) (\ le ->
   (covers : O.Le m (J.bigJ n ms)) (xs : (i : Fin n) -> S.obj (ms i)) -> Glue m n ms le covers xs) (\ le ->
  FL.isProp-Pi (O.Le m (J.bigJ n ms)) (\ covers -> (xs : (i : Fin n) -> S.obj (ms i)) -> Glue m n ms le covers xs) (\ covers ->
  FL.isProp-Pi ((i : Fin n) -> S.obj (ms i)) (Glue m n ms le covers) (\ xs ->
  FL.isProp-Pi (SO.Cover[m,n,ms,le,covers].Compatible xs) (\ c -> LC.isContr (SO.Cover[m,n,ms,le,covers].Amalgam xs)) (\ c ->
   IT.contr-prop (SO.Cover[m,n,ms,le,covers].Amalgam xs)))))))) ;
} ;
module On (L : DL.DLat) (G : RingedLattice[l].On[L].Presheaf) {
 module O = DL.Order[L] ;
 module P = MS.On[L,G] ;
 module I = SerreModuleSheafIso[l].On[L,G] ;
 -- (1) families of modules
 Family : U l+ = (a : L.L) -> SM.Over[G.ring a].Module ;
 Relation (m n : Family) : U l = (a : L.L) -> LI.Over[G.ring a].LinearEquivalence (m a) (n a) ;
 identity (m : Family) : Relation m m = \ a -> LI.Over[G.ring a].identity (m a) ;
 family-total-contr (m : Family) : FunExtUA[l+].isContr ((n : Family) * Relation m n) =
  GH.ctr-retract ((a : L.L) -> LI.Over[G.ring a].Total (m a)) ((n : Family) * Relation m n)
   (FunExtUA[l+].FE[univ @l+].wfe L.L (\ a -> LI.Over[G.ring a].Total (m a)) (\ a -> LI.Over[G.ring a].total-contr (m a)))
   (\ w a -> (w.1 a,w.2 a)) (\ w -> (\ a -> (w a).1,\ a -> (w a).2)) (\ w -> refl w) ;
 opaque family-total-contr ;
 -- (2) restriction maps and their laws
 module ResMap (m : Family) (a b : L.L) (k : O.Le a b) {
  module S = Semi[G.ring b,G.ring a,G.res a b k,m b,m a] ;
 } ;
 Res (m : Family) : U l = (a b : L.L) (k : O.Le a b) -> ResMap[m,a,b,k].S.H.Hom ;
 module Laws (m : Family) (r : Res m) {
  IdAt (a : L.L) (k : O.Le a a) (x : (m a).M) : U l = Id (m a).M ((r a a k).fn x) x ;
  CompAt (a b c : L.L) (k : O.Le a b) (h : O.Le b c) (t : O.Le a c) (x : (m c).M) : U l =
   Id (m a).M ((r a b k).fn ((r b c h).fn x)) ((r a c t).fn x) ;
  IdLaw : U l = (a : L.L) (k : O.Le a a) (x : (m a).M) -> IdAt a k x ;
  CompLaw : U l = (a b c : L.L) (k : O.Le a b) (h : O.Le b c) (t : O.Le a c) (x : (m c).M) -> CompAt a b c k h t x ;
  All : U l = IdLaw * CompLaw ;
  id-prop : Pr.isProp IdLaw =
   FL.isProp-Pi L.L (\ a -> (k : O.Le a a) (x : (m a).M) -> IdAt a k x) (\ a ->
    FL.isProp-Pi (O.Le a a) (\ k -> (x : (m a).M) -> IdAt a k x) (\ k ->
     FL.isProp-Pi (m a).M (IdAt a k) (\ x -> (m a).setM _ _))) ;
  comp-prop : Pr.isProp CompLaw =
   FL.isProp-Pi L.L (\ a -> (b c : L.L) (k : O.Le a b) (h : O.Le b c) (t : O.Le a c) (x : (m c).M) -> CompAt a b c k h t x) (\ a ->
   FL.isProp-Pi L.L (\ b -> (c : L.L) (k : O.Le a b) (h : O.Le b c) (t : O.Le a c) (x : (m c).M) -> CompAt a b c k h t x) (\ b ->
   FL.isProp-Pi L.L (\ c -> (k : O.Le a b) (h : O.Le b c) (t : O.Le a c) (x : (m c).M) -> CompAt a b c k h t x) (\ c ->
   FL.isProp-Pi (O.Le a b) (\ k -> (h : O.Le b c) (t : O.Le a c) (x : (m c).M) -> CompAt a b c k h t x) (\ k ->
   FL.isProp-Pi (O.Le b c) (\ h -> (t : O.Le a c) (x : (m c).M) -> CompAt a b c k h t x) (\ h ->
   FL.isProp-Pi (O.Le a c) (\ t -> (x : (m c).M) -> CompAt a b c k h t x) (\ t ->
   FL.isProp-Pi (m c).M (CompAt a b c k h t) (\ x -> (m a).setM _ _))))))) ;
  all-prop : Pr.isProp All = IT.both IdLaw CompLaw id-prop comp-prop ;
 } ;
 Structure (m : Family) : U l = (r : Res m) * Laws[m,r].All ;
 restriction {m : Family} (s : Structure m) : Res m = s.1 ;
 NaturalAt (m n : Family) (s : Structure m) (t : Structure n) (e : Relation m n)
  (a b : L.L) (k : O.Le a b) (x : (m b).M) : U l =
  Id (n a).M ((e a).1.fn ((restriction s a b k).fn x)) ((restriction t a b k).fn ((e b).1.fn x)) ;
 Natural (m n : Family) (s : Structure m) (t : Structure n) (e : Relation m n) : U l =
  (a b : L.L) (k : O.Le a b) (x : (m b).M) -> NaturalAt m n s t e a b k x ;
 natural-prop (m n : Family) (s : Structure m) (t : Structure n) (e : Relation m n) : Pr.isProp (Natural m n s t e) =
  FL.isProp-Pi L.L (\ a -> (b : L.L) (k : O.Le a b) (x : (m b).M) -> NaturalAt m n s t e a b k x) (\ a ->
  FL.isProp-Pi L.L (\ b -> (k : O.Le a b) (x : (m b).M) -> NaturalAt m n s t e a b k x) (\ b ->
  FL.isProp-Pi (O.Le a b) (\ k -> (x : (m b).M) -> NaturalAt m n s t e a b k x) (\ k ->
  FL.isProp-Pi (m b).M (NaturalAt m n s t e a b k) (\ x -> (n a).setM _ _)))) ;
 rho (m : Family) (s : Structure m) : Natural m m s s (identity m) = \ a b k x -> refl ((restriction s a b k).fn x) ;
 module Unit (m : Family) (s : Structure m) {
  same-res (t : Structure m) (h : Natural m m s t (identity m)) : Id (Res m) (restriction s) (restriction t) =
   FL.funext L.L (\ a -> (b : L.L) (k : O.Le a b) -> ResMap[m,a,b,k].S.H.Hom) (restriction s) (restriction t) (\ a ->
    FL.funext L.L (\ b -> (k : O.Le a b) -> ResMap[m,a,b,k].S.H.Hom) (restriction s a) (restriction t a) (\ b ->
     FL.funext (O.Le a b) (\ k -> ResMap[m,a,b,k].S.H.Hom) (restriction s a b) (restriction t a b) (\ k ->
      ResMap[m,a,b,k].S.ext (restriction s a b k) (restriction t a b k) (h a b k)))) ;
  same (t : Structure m) (h : Natural m m s t (identity m)) : Id (Structure m) s t =
   Pr.Sigma-eq (Res m) (\ r -> Laws[m,r].All) s.1 t.1 s.2 t.2 (same-res t h) Laws[m,t.1].all-prop ;
  contractible : FunExtUA[l+].isContr ((t : Structure m) * Natural m m s t (identity m)) =
   ((s,rho m s),\ w -> Pr.Sigma-eq (Structure m) (\ t -> Natural m m s t (identity m))
    s w.1 (rho m s) w.2 (same w.1 w.2) (natural-prop m m s w.1 (identity m))) ;
 } ;
 module B = DecoratedIdentity[l+].Over[Family,\ m n -> Relation m n,identity,family-total-contr] ;
 module D = B.Data[\ m -> Structure m,\ m n s t e -> Natural m n s t e,rho,\ m s -> Unit[m,s].contractible] ;
 -- (3) the record of presheaves
 fields (E : P.Presheaf) : D.Obj = (E.module-at,(E.res,(E.res-id,E.res-comp))) ;
 make (g : D.Obj) : P.Presheaf = new P.Presheaf[g.1,g.2.1,g.2.2.1,g.2.2.2] ;
 PresheafIso (E F : P.Presheaf) : U l = (e : Relation E.module-at F.module-at) * Natural E.module-at F.module-at (fields E).2 (fields F).2 e ;
 PresheafTotal (E : P.Presheaf) : U l+ = (F : P.Presheaf) * PresheafIso E F ;
 back (E : P.Presheaf) : (F : P.Presheaf) (e : PresheafIso E F) -> Id (PresheafTotal E) (make (fields F),e) (F,e) = split {
  Presheaf module-at res res-id res-comp -> \ e -> refl (new P.Presheaf[module-at,res,res-id,res-comp],e) } ;
 presheaf-iso-total-contr (E : P.Presheaf) : FunExtUA[l+].isContr (PresheafTotal E) =
  GH.ctr-retract (D.Total (fields E)) (PresheafTotal E) (D.total-contr (fields E))
   (\ w -> (fields w.1,w.2)) (\ w -> (make w.1,w.2)) (\ w -> back E w.1 w.2) ;
 opaque presheaf-iso-total-contr ;
 -- natural linear equivalences are these parts reordered
 to-equivalence (E F : P.Presheaf) (e : PresheafIso E F) : I.Equivalence E F =
  (new P.Transform[E,F].Hom[\ a -> (e.1 a).1,e.2],\ a -> (e.1 a).2) ;
 from-equivalence (E F : P.Presheaf) (e : I.Equivalence E F) : PresheafIso E F =
  (\ a -> ((I.forward e).component a,I.equiv-at e a),(I.forward e).natural) ;
 restore (E F : P.Presheaf) : (q : P.Transform[E,F].Hom)
  (v : (a : L.L) -> Pr.isEquiv (E.module-at a).M (F.module-at a).M (P.Transform[E,F].at q a)) ->
  Id (I.Equivalence E F) (to-equivalence E F (from-equivalence E F (q,v))) (q,v) = split {
  Hom component natural -> \ v -> refl (new P.Transform[E,F].Hom[component,natural],v) } ;
 EquivalenceTotal (E : P.Presheaf) : U l+ = (F : P.Presheaf) * I.Equivalence E F ;
 equivalence-total-contr (E : P.Presheaf) : FunExtUA[l+].isContr (EquivalenceTotal E) =
  GH.ctr-retract (PresheafTotal E) (EquivalenceTotal E) (presheaf-iso-total-contr E)
   (\ w -> (w.1,from-equivalence E w.1 w.2)) (\ w -> (w.1,to-equivalence E w.1 w.2))
   (\ w -> Hi.ap (I.Equivalence E w.1) (EquivalenceTotal E) (\ e -> (w.1,e)) _ _ (restore E w.1 w.2.1 w.2.2)) ;
 opaque equivalence-total-contr ;
 id-equivalence (E : P.Presheaf) : I.Equivalence E E = to-equivalence E E (D.identity (fields E)) ;
 -- (4) sheaves
 sheaf-prop (E : P.Presheaf) : Pr.isProp P.Of[E].IsSheaf = SetSheaf[L,P.Of[E].underlying].sheaf-prop ;
 module C = DecoratedIdentity[l+].Over[P.Presheaf,\ E F -> I.Equivalence E F,id-equivalence,equivalence-total-contr] ;
 module Sh = C.Property[\ E -> P.Of[E].IsSheaf,sheaf-prop] ;
 sheaf-fields (E : P.ModuleSheaf) : Sh.Obj = (E.presheaf,E.sheaf) ;
 sheaf-make (g : Sh.Obj) : P.ModuleSheaf = new P.ModuleSheaf[g.1,g.2] ;
 SheafTotal (E : P.ModuleSheaf) : U l+ = (F : P.ModuleSheaf) * I.Equivalence E.presheaf F.presheaf ;
 sheaf-back (E : P.ModuleSheaf) : (F : P.ModuleSheaf) (e : I.Equivalence E.presheaf F.presheaf) ->
  Id (SheafTotal E) (sheaf-make (sheaf-fields F),e) (F,e) = split {
  ModuleSheaf presheaf sheaf -> \ e -> refl (new P.ModuleSheaf[presheaf,sheaf],e) } ;
 sheaf-total-contr (E : P.ModuleSheaf) : FunExtUA[l+].isContr (SheafTotal E) =
  GH.ctr-retract (Sh.Total (sheaf-fields E)) (SheafTotal E) (Sh.total-contr (sheaf-fields E))
   (\ w -> (sheaf-fields w.1,w.2)) (\ w -> (sheaf-make w.1,w.2)) (\ w -> sheaf-back E w.1 w.2) ;
 opaque sheaf-total-contr ;
} ;
