-- On an affine chart the scalar equalizer gives uniqueness and existence.
-- Equality of two chart points is equality of their underlying points.
level l ; open Ring[l] ;
module Tr = Truncation[l+] ;
module T = AffineTests[l] ;
module EQ = AffineCoverEqualiser[l] ;
module SF = TestFunctors[l] ;
module CO = CompactOpens[l] ;
module Q = FunctorialQcqs[l] ;
module Over (F : SF.SetFunctor) (u : CO.Over[F].Open) (affine : Q.IsAffine OpenRealisation[l].Over[F,u].functor)
 (A : T.Test) (d : EQ.Diagram[A]) {
 module R = OpenRealisation[l].Over[F,u] ;
 module D = EQ.On[A,d] ;
 module D0 = D.For[F] ;
 module D1 = D.For[R.functor] ;
 module Via (w : Q.AffineWitness R.functor) {
  module Rep = D.Representable[w.1] ;
  module Transfer = D.Transfer[Rep.F.functor,R.functor,w.2] ;
  separate (x y : R.obj A) (e : Id (F.obj d.cover) (D0.restrict x.1) (D0.restrict y.1)) : Id (R.obj A) x y =
   Transfer.separate Rep.separate x y (R.point-ext d.cover (D1.restrict x) (D1.restrict y) e) ;
  module Point (y : R.obj d.cover) (e : D0.Compatible y.1) {
   module M = Transfer.Matching[y,R.point-ext d.overlap
    (R.reindex d.cover d.overlap d.left y) (R.reindex d.cover d.overlap d.right y) e] ;
   lift : D1.Lifts y = M.lift Rep.Point[M.value,M.compatible].amalgam ;
  } ;
 } ;
 separate (x y : R.obj A) (e : Id (F.obj d.cover) (D0.restrict x.1) (D0.restrict y.1)) : Id (R.obj A) x y =
  Tr.Trunc[Q.AffineWitness R.functor].induction @l (\ t -> Id (R.obj A) x y) (\ t -> R.set A x y)
   (\ w -> Via[w].separate x y e) affine ;
 lift (y : R.obj d.cover) (e : D0.Compatible y.1) : D1.Lifts y =
  Tr.Trunc[Q.AffineWitness R.functor].induction @l (\ t -> D1.Lifts y)
   (\ t x x' -> D1.lifts-ext y x x' (separate x.1 x'.1
    (trans (ap (R.point {d.cover}) x.2) (sym (ap (R.point {d.cover}) x'.2)))))
   (\ w -> Via[w].Point[y,e].lift) affine ;
} ;
