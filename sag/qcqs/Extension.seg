-- The extension lemma for maps out of O (DESIGN.md, step 3, item 6).
-- Let G be a sheaf of rings on a lattice M (RingedLattice), pi : L_A -> M a
-- lattice map, and phi_g : R_g -> G(pi(D g)) ring maps compatible with
-- restriction: phi_g(x)|pi(D h) = phi_h(rho_{g,h} x) for D h <= D g.
-- For s in O(u) write v_g = phi_g(s_g) for D g <= u; then
-- v_g|pi(D h) = phi_h(rho_{g,h} s_g) = v_h (toward).
--
-- Theorem.  For every u and s in O(u) there is exactly one t in G(pi u)
--  that fits s: t|pi(D g) = v_g for every D g <= u.
--  Uniqueness.  Merely u = D a_1 \/ .. \/ D a_n, so pi u is covered by the
--  pi(D a_j), as pi preserves joins; two fitting t agree on each pi(D a_j),
--  so are equal (separation in G).  So existence is a proposition, and a
--  presentation may be used.
--  Existence.  The v_(a_j) are compatible: with w = a_j a_k,
--  pi(D a_j) /\ pi(D a_k) = pi(D w), and both restrictions of v_(a_j) and
--  v_(a_k) to it are v_w.  Let t be their amalgam.  For D g <= u, pi(D g)
--  is covered by the pi(D(g a_j)) (BasicCover), and
--   (t|pi(D g))|pi(D(g a_j)) = (t|pi(D a_j))|pi(D(g a_j)) = v_(a_j)|.. = v_(g a_j)
--                            = v_g|pi(D(g a_j)),
--  so t|pi(D g) = v_g (separation in G).  The element t does not depend on
--  the presentation: it is characterised by the fitting equations, which
--  mention only basic opens below u.
-- Corollaries, all from uniqueness.  s |-> t is a ring map O(u) -> G(pi u)
--  (sums, products and 1 fit); it commutes with restriction to v <= u
--  ((t|pi v)|pi(D g) = t|pi(D g) = v_g); on D g it is phi_g after evaluation;
--  and any family of ring maps O(u) -> G(pi u) commuting with restriction
--  and equal to phi_g . eval on basic opens is this one.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module DL = DistLattice[l] ;
module Over (A : CRing) (Loc : A.R -> CRing) (set : (g : A.R) -> Pr.isSet (Loc g).R)
 (f : (g : A.R) -> RH.Hom A (Loc g))
 (el : (g : A.R) -> Bridge[l].Over[A,g].LocH.Elementary (Loc g) (f g))
 (M : DL.DLat) (G : RingedLattice[l].On[M].Presheaf) (sheafG : RingedLattice[l].On[M].Of[G].IsSheaf)
 (pi : DL.Hom ZariskiLattice[l].Over[A].lattice M) {
 open A ; open Radical[l].Over[A] ;
 open ZariskiLattice[l].Over[A] ;
 module S = Sections[l].Over[A,Loc,set,f,el] ;
 module B = BasicOpen[l].Over[A,Loc,set,f,el] ;
 module Gl = Gluing[l].Over[A,Loc,set,f,el] ;
 module Sp = Sup.Of[D,support] ;
 module RG = RingedLattice[l].On[M] ;
 module GO = RG.Of[G] ;
 module GS = RG.Sheaf[G,sheafG] ;
 module PM = DL.JoinMaps[lattice,M,pi] ;

 module Extend (phi : (g : R) -> RH.Hom (Loc g) (G.ring (DL.hmap pi (D g))))
  (phi-compat : (g h : R) (hg : O.Le (D h) (D g)) (x : (Loc g).R) ->
    Id (G.ring (DL.hmap pi (D h))).R
     (GO.restrict (DL.hmap pi (D h)) (DL.hmap pi (D g)) (PM.monotone (D h) (D g) hg) (map (phi g) x))
     (map (phi h) (map (S.rho g h hg) x))) {

  -- v_g = phi_g(s_g)
  val (u : lattice.L) (s : S.Section u) (g : R) (kg : O.Le (D g) u) : (G.ring (DL.hmap pi (D g))).R =
   map (phi g) (S.at s g kg) ;
  val-irr (u : lattice.L) (s : S.Section u) (g : R) (kg kg2 : O.Le (D g) u) :
   Id (G.ring (DL.hmap pi (D g))).R (val u s g kg) (val u s g kg2) =
   ap (map (phi g)) (S.component-irr u s g kg kg2) ;
  toward (u : lattice.L) (s : S.Section u) (g h : R) (kg : O.Le (D g) u) (hg : O.Le (D h) (D g)) :
   Id (G.ring (DL.hmap pi (D h))).R
    (GO.restrict (DL.hmap pi (D h)) (DL.hmap pi (D g)) (PM.monotone (D h) (D g) hg) (val u s g kg))
    (val u s h (O.le-trans (D h) (D g) u hg kg)) =
   trans (phi-compat g h hg (S.at s g kg)) (ap (map (phi h)) (S.compat s g h kg hg)) ;

  -- t fits s
  Fits (u : lattice.L) (s : S.Section u) (t : (G.ring (DL.hmap pi u)).R) : U l =
   (g : R) (kg : O.Le (D g) u) ->
    Id (G.ring (DL.hmap pi (D g))).R (GO.restrict (DL.hmap pi (D g)) (DL.hmap pi u) (PM.monotone (D g) u kg) t) (val u s g kg) ;
  Ext (u : lattice.L) (s : S.Section u) : U l = (t : (G.ring (DL.hmap pi u)).R) * Fits u s t ;
  value {u : lattice.L} {s : S.Section u} (e : Ext u s) : (G.ring (DL.hmap pi u)).R = e.1 ;
  fits {u : lattice.L} {s : S.Section u} (e : Ext u s) : Fits u s (value e) = e.2 ;
  fits-prop (u : lattice.L) (s : S.Section u) (t : (G.ring (DL.hmap pi u)).R) : Pr.isProp (Fits u s t) =
   F.isProp-Pi R (\ g -> (kg : O.Le (D g) u) ->
     Id (G.ring (DL.hmap pi (D g))).R (GO.restrict (DL.hmap pi (D g)) (DL.hmap pi u) (PM.monotone (D g) u kg) t) (val u s g kg))
    (\ g -> F.isProp-Pi (O.Le (D g) u) (\ kg ->
      Id (G.ring (DL.hmap pi (D g))).R (GO.restrict (DL.hmap pi (D g)) (DL.hmap pi u) (PM.monotone (D g) u kg) t) (val u s g kg))
     (\ kg -> G.ring-set (DL.hmap pi (D g)) _ _)) ;

  -- the cover of pi u by the pi(D a_j), for u = D a_1 \/ .. \/ D a_n
  module Along (u : lattice.L) (n : Nat) (a : Fin n -> R) (e : Id lattice.L u (J.bigJ n (\ j -> D (a j)))) {
   a-below (j : Fin n) : O.Le (D (a j)) u =
    Pr.subst lattice.L (\ x -> O.Le (D (a j)) x) (J.bigJ n (\ k -> D (a k))) u (sym e) (J.below n (\ k -> D (a k)) j) ;
   le-j (j : Fin n) : RG.O.Le (DL.hmap pi (D (a j))) (DL.hmap pi u) = PM.monotone (D (a j)) u (a-below j) ;
   covers : RG.O.Le (DL.hmap pi u) (RG.J.bigJ n (\ j -> DL.hmap pi (D (a j)))) =
    RG.O.le-of-eq (DL.hmap pi u) (RG.J.bigJ n (\ j -> DL.hmap pi (D (a j))))
     (trans (ap (DL.hmap pi) e) (PM.preserves n (\ j -> D (a j)))) ;
   module GC = GS.Cover[DL.hmap pi u,n,\ j -> DL.hmap pi (D (a j)),le-j,covers] ;
  } ;

  -- uniqueness
  ext-prop (u : lattice.L) (s : S.Section u) : Pr.isProp (Ext u s) = \ e e2 ->
   Pr.Sigma-eq (G.ring (DL.hmap pi u)).R (Fits u s) (value e) (value e2) (fits e) (fits e2)
    (Tr.Trunc[Presentation u].induction @l (\ q -> Id (G.ring (DL.hmap pi u)).R (value e) (value e2))
      (\ q -> G.ring-set (DL.hmap pi u) _ _)
      (\ p -> Along[u,size (generators p),gen (generators p),presents p].GC.separated (value e) (value e2) (\ j ->
        trans (fits e (gen (generators p) j) (Along[u,size (generators p),gen (generators p),presents p].a-below j))
         (sym (fits e2 (gen (generators p) j) (Along[u,size (generators p),gen (generators p),presents p].a-below j)))))
      (presented u))
    (fits-prop u s (value e2)) ;

  -- existence, from a presentation
  module Exists (u : lattice.L) (s : S.Section u) (n : Nat) (a : Fin n -> R) (e : Id lattice.L u (J.bigJ n (\ j -> D (a j)))) {
   module AL = Along[u,n,a,e] ;
   locals (j : Fin n) : (G.ring (DL.hmap pi (D (a j)))).R = val u s (a j) (AL.a-below j) ;
   -- pi(D a_j) /\ pi(D a_k) <= pi(D(a_j a_k))
   meet-le (j k : Fin n) :
    RG.O.Le (M.meet (DL.hmap pi (D (a j))) (DL.hmap pi (D (a k)))) (DL.hmap pi (D (mul (a j) (a k)))) =
    RG.O.le-of-eq (M.meet (DL.hmap pi (D (a j))) (DL.hmap pi (D (a k)))) (DL.hmap pi (D (mul (a j) (a k))))
     (sym (trans (ap (DL.hmap pi) (Sp.at-mul (a j) (a k))) (DL.hmap-meet pi (D (a j)) (D (a k))))) ;
   -- both restrictions of v_(a_j), v_(a_k) to the meet are those of v_(a_j a_k)
   compatible : AL.GC.C.Compatible locals = \ j k -> calc (G.ring (M.meet (DL.hmap pi (D (a j))) (DL.hmap pi (D (a k))))).R {
    GO.restrict (M.meet (DL.hmap pi (D (a j))) (DL.hmap pi (D (a k)))) (DL.hmap pi (D (a j)))
      (RG.O.meet-left (DL.hmap pi (D (a j))) (DL.hmap pi (D (a k)))) (locals j)
     =< sym (G.res-comp (M.meet (DL.hmap pi (D (a j))) (DL.hmap pi (D (a k)))) (DL.hmap pi (D (mul (a j) (a k))))
         (DL.hmap pi (D (a j))) (meet-le j k) (PM.monotone (D (mul (a j) (a k))) (D (a j)) (Gl.le-left (a j) (a k)))
         (RG.O.meet-left (DL.hmap pi (D (a j))) (DL.hmap pi (D (a k)))) (locals j))
      > GO.restrict (M.meet (DL.hmap pi (D (a j))) (DL.hmap pi (D (a k)))) (DL.hmap pi (D (mul (a j) (a k)))) (meet-le j k)
         (GO.restrict (DL.hmap pi (D (mul (a j) (a k)))) (DL.hmap pi (D (a j)))
           (PM.monotone (D (mul (a j) (a k))) (D (a j)) (Gl.le-left (a j) (a k))) (locals j))
     =< ap (GO.restrict (M.meet (DL.hmap pi (D (a j))) (DL.hmap pi (D (a k)))) (DL.hmap pi (D (mul (a j) (a k)))) (meet-le j k))
         (trans (toward u s (a j) (mul (a j) (a k)) (AL.a-below j) (Gl.le-left (a j) (a k)))
           (trans (val-irr u s (mul (a j) (a k))
               (O.le-trans (D (mul (a j) (a k))) (D (a j)) u (Gl.le-left (a j) (a k)) (AL.a-below j))
               (O.le-trans (D (mul (a j) (a k))) (D (a k)) u (Gl.le-right (a j) (a k)) (AL.a-below k)))
             (sym (toward u s (a k) (mul (a j) (a k)) (AL.a-below k) (Gl.le-right (a j) (a k))))))
      > GO.restrict (M.meet (DL.hmap pi (D (a j))) (DL.hmap pi (D (a k)))) (DL.hmap pi (D (mul (a j) (a k)))) (meet-le j k)
         (GO.restrict (DL.hmap pi (D (mul (a j) (a k)))) (DL.hmap pi (D (a k)))
           (PM.monotone (D (mul (a j) (a k))) (D (a k)) (Gl.le-right (a j) (a k))) (locals k))
     =< G.res-comp (M.meet (DL.hmap pi (D (a j))) (DL.hmap pi (D (a k)))) (DL.hmap pi (D (mul (a j) (a k))))
         (DL.hmap pi (D (a k))) (meet-le j k) (PM.monotone (D (mul (a j) (a k))) (D (a k)) (Gl.le-right (a j) (a k)))
         (RG.O.meet-right (DL.hmap pi (D (a j))) (DL.hmap pi (D (a k)))) (locals k)
      > GO.restrict (M.meet (DL.hmap pi (D (a j))) (DL.hmap pi (D (a k)))) (DL.hmap pi (D (a k)))
         (RG.O.meet-right (DL.hmap pi (D (a j))) (DL.hmap pi (D (a k)))) (locals k) } ;
   amalgam : (G.ring (DL.hmap pi u)).R = AL.GC.C.amalgam (AL.GC.glue locals compatible).1 ;
   amalgam-at (j : Fin n) :
    Id (G.ring (DL.hmap pi (D (a j)))).R (GO.restrict (DL.hmap pi (D (a j))) (DL.hmap pi u) (AL.le-j j) amalgam) (locals j) =
    AL.GC.C.matches (AL.GC.glue locals compatible).1 j ;

   -- the fitting equation at an arbitrary D g <= u
   module At (g : R) (kg : O.Le (D g) u) {
    le-g : O.Le (D g) (J.bigJ n (\ j -> D (a j))) =
     Pr.subst lattice.L (\ x -> O.Le (D g) x) u (J.bigJ n (\ j -> D (a j))) e kg ;
    module BC = BasicCover[g,n,a,le-g] ;
    le-gj (j : Fin n) : RG.O.Le (DL.hmap pi (D (mul g (a j)))) (DL.hmap pi (D g)) =
     PM.monotone (D (mul g (a j))) (D g) (BC.below j) ;
    cov-g : RG.O.Le (DL.hmap pi (D g)) (RG.J.bigJ n (\ j -> DL.hmap pi (D (mul g (a j))))) =
     RG.O.le-trans (DL.hmap pi (D g)) (DL.hmap pi (J.bigJ n (\ j -> D (mul g (a j))))) (RG.J.bigJ n (\ j -> DL.hmap pi (D (mul g (a j)))))
      (PM.monotone (D g) (J.bigJ n (\ j -> D (mul g (a j)))) BC.covers)
      (RG.O.le-of-eq (DL.hmap pi (J.bigJ n (\ j -> D (mul g (a j))))) (RG.J.bigJ n (\ j -> DL.hmap pi (D (mul g (a j)))))
        (PM.preserves n (\ j -> D (mul g (a j))))) ;
    module GCg = GS.Cover[DL.hmap pi (D g),n,\ j -> DL.hmap pi (D (mul g (a j))),le-gj,cov-g] ;
    -- D(g a_j) <= u
    kgj (j : Fin n) : O.Le (D (mul g (a j))) u = O.le-trans (D (mul g (a j))) (D g) u (BC.below j) kg ;
    fits-g : Id (G.ring (DL.hmap pi (D g))).R
      (GO.restrict (DL.hmap pi (D g)) (DL.hmap pi u) (PM.monotone (D g) u kg) amalgam) (val u s g kg) =
     GCg.separated (GO.restrict (DL.hmap pi (D g)) (DL.hmap pi u) (PM.monotone (D g) u kg) amalgam) (val u s g kg) (\ j ->
      calc (G.ring (DL.hmap pi (D (mul g (a j))))).R {
       GO.restrict (DL.hmap pi (D (mul g (a j)))) (DL.hmap pi (D g)) (le-gj j)
        (GO.restrict (DL.hmap pi (D g)) (DL.hmap pi u) (PM.monotone (D g) u kg) amalgam)
        =< G.res-comp (DL.hmap pi (D (mul g (a j)))) (DL.hmap pi (D g)) (DL.hmap pi u) (le-gj j) (PM.monotone (D g) u kg)
            (PM.monotone (D (mul g (a j))) u (kgj j)) amalgam
         > GO.restrict (DL.hmap pi (D (mul g (a j)))) (DL.hmap pi u) (PM.monotone (D (mul g (a j))) u (kgj j)) amalgam
        =< sym (G.res-comp (DL.hmap pi (D (mul g (a j)))) (DL.hmap pi (D (a j))) (DL.hmap pi u)
            (PM.monotone (D (mul g (a j))) (D (a j)) (BC.below-gen j)) (AL.le-j j) (PM.monotone (D (mul g (a j))) u (kgj j)) amalgam)
         > GO.restrict (DL.hmap pi (D (mul g (a j)))) (DL.hmap pi (D (a j))) (PM.monotone (D (mul g (a j))) (D (a j)) (BC.below-gen j))
            (GO.restrict (DL.hmap pi (D (a j))) (DL.hmap pi u) (AL.le-j j) amalgam)
        =< ap (GO.restrict (DL.hmap pi (D (mul g (a j)))) (DL.hmap pi (D (a j))) (PM.monotone (D (mul g (a j))) (D (a j)) (BC.below-gen j)))
            (amalgam-at j)
         > GO.restrict (DL.hmap pi (D (mul g (a j)))) (DL.hmap pi (D (a j))) (PM.monotone (D (mul g (a j))) (D (a j)) (BC.below-gen j))
            (locals j)
        =< toward u s (a j) (mul g (a j)) (AL.a-below j) (BC.below-gen j)
         > val u s (mul g (a j)) (O.le-trans (D (mul g (a j))) (D (a j)) u (BC.below-gen j) (AL.a-below j))
        =< val-irr u s (mul g (a j)) (O.le-trans (D (mul g (a j))) (D (a j)) u (BC.below-gen j) (AL.a-below j)) (kgj j)
         > val u s (mul g (a j)) (kgj j)
        =< sym (toward u s g (mul g (a j)) kg (BC.below j))
         > GO.restrict (DL.hmap pi (D (mul g (a j)))) (DL.hmap pi (D g)) (le-gj j) (val u s g kg) }) ;
   } ;
   ext : Ext u s = (amalgam,\ g kg -> At[g,kg].fits-g) ;
  } ;

  extension (u : lattice.L) (s : S.Section u) : Ext u s =
   Tr.Trunc[Presentation u].induction @l (\ q -> Ext u s) (\ q -> ext-prop u s)
    (\ p -> Exists[u,s,size (generators p),gen (generators p),presents p].ext) (presented u) ;
  extend (u : lattice.L) (s : S.Section u) : (G.ring (DL.hmap pi u)).R = value (extension u s) ;
  extend-fits (u : lattice.L) (s : S.Section u) : Fits u s (extend u s) = fits (extension u s) ;
  unique (u : lattice.L) (s : S.Section u) (t : (G.ring (DL.hmap pi u)).R) (ft : Fits u s t) :
   Id (G.ring (DL.hmap pi u)).R t (extend u s) =
   ap (\ x -> value x) (ext-prop u s (t,ft) (extension u s)) ;

  -- the extension is a ring map
  fits-one (u : lattice.L) : Fits u (S.ring u).o (G.ring (DL.hmap pi u)).o = \ g kg -> calc (G.ring (DL.hmap pi (D g))).R {
   GO.restrict (DL.hmap pi (D g)) (DL.hmap pi u) (PM.monotone (D g) u kg) (G.ring (DL.hmap pi u)).o
    =< map-one (G.res (DL.hmap pi (D g)) (DL.hmap pi u) (PM.monotone (D g) u kg)) > (G.ring (DL.hmap pi (D g))).o
    =< sym (map-one (phi g)) > val u (S.ring u).o g kg } ;
  fits-add (u : lattice.L) (s s2 : S.Section u) :
   Fits u ((S.ring u).add s s2) ((G.ring (DL.hmap pi u)).add (extend u s) (extend u s2)) = \ g kg ->
   calc (G.ring (DL.hmap pi (D g))).R {
    GO.restrict (DL.hmap pi (D g)) (DL.hmap pi u) (PM.monotone (D g) u kg) ((G.ring (DL.hmap pi u)).add (extend u s) (extend u s2))
     =< map-add (G.res (DL.hmap pi (D g)) (DL.hmap pi u) (PM.monotone (D g) u kg)) (extend u s) (extend u s2)
      > (G.ring (DL.hmap pi (D g))).add (GO.restrict (DL.hmap pi (D g)) (DL.hmap pi u) (PM.monotone (D g) u kg) (extend u s))
         (GO.restrict (DL.hmap pi (D g)) (DL.hmap pi u) (PM.monotone (D g) u kg) (extend u s2))
     =< cong2 (G.ring (DL.hmap pi (D g))).R (G.ring (DL.hmap pi (D g))).add _ _ _ _ (extend-fits u s g kg) (extend-fits u s2 g kg)
      > (G.ring (DL.hmap pi (D g))).add (val u s g kg) (val u s2 g kg)
     =< sym (map-add (phi g) (S.at s g kg) (S.at s2 g kg)) > map (phi g) ((Loc g).add (S.at s g kg) (S.at s2 g kg))
     =< sym (ap (map (phi g)) (S.Ops[u].add-at s s2 g kg)) > val u ((S.ring u).add s s2) g kg } ;
  fits-mul (u : lattice.L) (s s2 : S.Section u) :
   Fits u ((S.ring u).mul s s2) ((G.ring (DL.hmap pi u)).mul (extend u s) (extend u s2)) = \ g kg ->
   calc (G.ring (DL.hmap pi (D g))).R {
    GO.restrict (DL.hmap pi (D g)) (DL.hmap pi u) (PM.monotone (D g) u kg) ((G.ring (DL.hmap pi u)).mul (extend u s) (extend u s2))
     =< map-mul (G.res (DL.hmap pi (D g)) (DL.hmap pi u) (PM.monotone (D g) u kg)) (extend u s) (extend u s2)
      > (G.ring (DL.hmap pi (D g))).mul (GO.restrict (DL.hmap pi (D g)) (DL.hmap pi u) (PM.monotone (D g) u kg) (extend u s))
         (GO.restrict (DL.hmap pi (D g)) (DL.hmap pi u) (PM.monotone (D g) u kg) (extend u s2))
     =< cong2 (G.ring (DL.hmap pi (D g))).R (G.ring (DL.hmap pi (D g))).mul _ _ _ _ (extend-fits u s g kg) (extend-fits u s2 g kg)
      > (G.ring (DL.hmap pi (D g))).mul (val u s g kg) (val u s2 g kg)
     =< sym (map-mul (phi g) (S.at s g kg) (S.at s2 g kg)) > map (phi g) ((Loc g).mul (S.at s g kg) (S.at s2 g kg))
     =< sym (ap (map (phi g)) (S.Ops[u].mul-at s s2 g kg)) > val u ((S.ring u).mul s s2) g kg } ;
  extension-map (u : lattice.L) : RH.Hom (S.ring u) (G.ring (DL.hmap pi u)) =
   (extend u,
    sym (unique u (S.ring u).o (G.ring (DL.hmap pi u)).o (fits-one u)),
    \ s s2 -> sym (unique u ((S.ring u).add s s2) ((G.ring (DL.hmap pi u)).add (extend u s) (extend u s2)) (fits-add u s s2)),
    \ s s2 -> sym (unique u ((S.ring u).mul s s2) ((G.ring (DL.hmap pi u)).mul (extend u s) (extend u s2)) (fits-mul u s s2))) ;
  extension-map-at (u : lattice.L) (s : S.Section u) : Id (G.ring (DL.hmap pi u)).R (map (extension-map u) s) (extend u s) =
   refl (extend u s) ;

  -- it commutes with restriction
  extend-restrict (v u : lattice.L) (vu : O.Le v u) (s : S.Section u) :
   Id (G.ring (DL.hmap pi v)).R (GO.restrict (DL.hmap pi v) (DL.hmap pi u) (PM.monotone v u vu) (extend u s))
    (extend v (S.restrict v u vu s)) =
   unique v (S.restrict v u vu s) (GO.restrict (DL.hmap pi v) (DL.hmap pi u) (PM.monotone v u vu) (extend u s)) (\ g kg ->
    calc (G.ring (DL.hmap pi (D g))).R {
     GO.restrict (DL.hmap pi (D g)) (DL.hmap pi v) (PM.monotone (D g) v kg)
      (GO.restrict (DL.hmap pi v) (DL.hmap pi u) (PM.monotone v u vu) (extend u s))
      =< G.res-comp (DL.hmap pi (D g)) (DL.hmap pi v) (DL.hmap pi u) (PM.monotone (D g) v kg) (PM.monotone v u vu)
          (PM.monotone (D g) u (O.le-trans (D g) v u kg vu)) (extend u s)
       > GO.restrict (DL.hmap pi (D g)) (DL.hmap pi u) (PM.monotone (D g) u (O.le-trans (D g) v u kg vu)) (extend u s)
      =< extend-fits u s g (O.le-trans (D g) v u kg vu) > val u s g (O.le-trans (D g) v u kg vu)
      =< sym (ap (map (phi g)) (S.restrict-at v u vu s g kg)) > val v (S.restrict v u vu s) g kg }) ;

  -- on a basic open it is phi_g after evaluation
  extend-basic (g : R) (s : S.Section (D g)) :
   Id (G.ring (DL.hmap pi (D g))).R (extend (D g) s) (map (phi g) (B.At[g].eval s)) =
   sym (unique (D g) s (map (phi g) (B.At[g].eval s)) (\ h kh ->
    trans (toward (D g) s g h B.At[g].gg kh) (val-irr (D g) s h (O.le-trans (D h) (D g) (D g) kh B.At[g].gg) kh))) ;

  -- and it is the only such family of maps
  module Unique (psi : (u : lattice.L) -> RH.Hom (S.ring u) (G.ring (DL.hmap pi u)))
   (natural : (v u : lattice.L) (vu : O.Le v u) (s : S.Section u) ->
     Id (G.ring (DL.hmap pi v)).R (GO.restrict (DL.hmap pi v) (DL.hmap pi u) (PM.monotone v u vu) (map (psi u) s))
      (map (psi v) (S.restrict v u vu s)))
   (basic : (g : R) (s : S.Section (D g)) -> Id (G.ring (DL.hmap pi (D g))).R (map (psi (D g)) s) (map (phi g) (B.At[g].eval s))) {
   agrees (u : lattice.L) (s : S.Section u) : Id (G.ring (DL.hmap pi u)).R (map (psi u) s) (extend u s) =
    unique u s (map (psi u) s) (\ g kg -> calc (G.ring (DL.hmap pi (D g))).R {
     GO.restrict (DL.hmap pi (D g)) (DL.hmap pi u) (PM.monotone (D g) u kg) (map (psi u) s)
      =< natural (D g) u kg s > map (psi (D g)) (S.restrict (D g) u kg s)
      =< basic g (S.restrict (D g) u kg s) > map (phi g) (B.At[g].eval (S.restrict (D g) u kg s))
      =< ap (map (phi g)) (S.restrict-at (D g) u kg s g B.At[g].gg)
       > val u s g (O.le-trans (D g) (D g) u B.At[g].gg kg)
      =< val-irr u s g (O.le-trans (D g) (D g) u B.At[g].gg kg) kg > val u s g kg }) ;
  } ;
 } ;
} ;
