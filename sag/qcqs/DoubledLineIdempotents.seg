-- The points of the doubled-origin line as idempotents (DESIGN.md, Next 4,
-- milestone 2).
--
-- Theorem.  For a k-algebra B,  Hom_k(Spec B, S)  ~=  Sigma (t : B), Idem(B/(t)).
-- Proof.  Hom_k(Spec B, S) ~= { (t, u0, u1) | u0 \/ u1 = top, u0 /\ u1 = D(t) }
--  (DoubledLinePoints); for fixed t these pairs are the splittings of
--  [D t, top], which correspond to the idempotents of B/(t)
--  (ZariskiQuotient).  Regrouping the triple is the identity on components.
--  The zero ring B/(1) (t a unit) is included: it has the one idempotent
--  0 = 1, and D(t) = top has the one splitting (top, top).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) (B : CRing) (setB : Pr.isSet B.R) (iota : RH.Hom k B) {
 module DP = DoubledLinePoints[l].Over[k,setk,B,setB,iota] ;
 module At (t : B.R) {
  module Z = ZariskiQuotient[l].Over[B,setB,t] ;
 } ;
 -- t with an idempotent of B/(t)
 Data : U l = (t : B.R) * At[t].Z.TQ.IA.Idem ;
 -- (t, (u0, u1)) as a triple
 regroup (t : B.R) (s : At[t].Z.I.Splittings) : DP.Coordinates = ((t,s.1.1,s.1.2),s.2) ;
 coordinates (q : Data) : DP.Coordinates = regroup q.1 (At[q.1].Z.splitting-of q.2) ;
 idempotent (c : DP.Coordinates) : Data = (c.1.1,At[c.1.1].Z.splitting.sec ((c.1.2.1,c.1.2.2),c.2)) ;
 coordinates-idempotent (c : DP.Coordinates) : Id DP.Coordinates (coordinates (idempotent c)) c =
  ap (regroup c.1.1) (At[c.1.1].Z.splitting.sec-eq ((c.1.2.1,c.1.2.2),c.2)) ;
 idempotent-coordinates (q : Data) : Id Data (idempotent (coordinates q)) q =
  ap (\ e -> (q.1,e)) (Pr.sec-ret At[q.1].Z.TQ.IA.Idem At[q.1].Z.I.Splittings At[q.1].Z.splitting-of At[q.1].Z.splitting q.2) ;
 coordinates-equiv : Pr.isEquiv Data DP.Coordinates coordinates =
  Pr.qinv Data DP.Coordinates coordinates idempotent coordinates-idempotent idempotent-coordinates ;
 -- the point of (t, e)
 point (q : Data) : DP.Points = DP.back (coordinates q) ;
 back-equiv : Pr.isEquiv DP.Coordinates DP.Points DP.back =
  Pr.qinv DP.Coordinates DP.Points DP.back DP.forth (\ p -> DP.BackForth[p].law) (\ c -> DP.ForthBack[c].law) ;
 equivalence : Pr.isEquiv Data DP.Points point =
  Iso[l].equiv-compose Data DP.Coordinates DP.Points DP.back coordinates back-equiv coordinates-equiv ;
} ;
