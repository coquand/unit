-- A linear map killing the kernel of a surjection descends. Every fibre
-- supplies merely a representative, but its image is uniquely defined.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module SM = SerreModule[l] ; module Bil = SerreBilinear[l] ;
module Over (A : CRing) (P M N : SM.Over[A].Module) {
 module L = Bil.Over[A] ;
 module Along (q : L.Linear[P,M].H.Hom) (g : L.Linear[P,N].H.Hom)
  (onto : (x : M.M) -> Tr.Trunc[(p : P.M) * Id M.M (q.fn p) x].carrier)
  (kills : (p : P.M) -> Id M.M (q.fn p) M.mz -> Id N.M (g.fn p) N.mz) {
  module PS = SM.Over[A].Laws[P] ; module MS = SM.Over[A].Laws[M] ; module NS = SM.Over[A].Laws[N] ;
  module Q = SerreModuleMapExact[l].Over[A,P,M,q] ;
  module G = SerreModuleMapExact[l].Over[A,P,N,g] ;
  same (p r : P.M) (e : Id M.M (q.fn p) (q.fn r)) : Id N.M (g.fn p) (g.fn r) =
   NS.sub-zero _ _ (trans (sym (G.map-sub p r))
    (kills (PS.sub p r) (trans (Q.map-sub p r) (trans (ap (\ z -> MS.sub z (q.fn r)) e) (MS.sub-self (q.fn r)))))) ;
  Value (x : M.M) (z : N.M) : U l = (p : P.M) * Id M.M (q.fn p) x * Id N.M (g.fn p) z ;
  Candidate (x : M.M) : U l = (z : N.M) * Tr.Trunc[Value x z].carrier ;
  value-eq (x : M.M) (z w : N.M) (a : Value x z) (b : Value x w) : Id N.M z w =
   trans (sym a.2.2) (trans (same a.1 b.1 (trans a.2.1 (sym b.2.1))) b.2.2) ;
  compare (x : M.M) (c d : Candidate x) : Id N.M c.1 d.1 =
   Tr.Trunc[Value x c.1].induction @l (\ a -> Id N.M c.1 d.1) (\ a -> N.setM _ _)
    (\ a -> Tr.Trunc[Value x d.1].induction @l (\ b -> Id N.M c.1 d.1) (\ b -> N.setM _ _)
     (value-eq x c.1 d.1 a) d.2) c.2 ;
  prop (x : M.M) : Pr.isProp (Candidate x) = \ c d ->
   Pr.Sigma-eq N.M (\ z -> Tr.Trunc[Value x z].carrier) c.1 d.1 c.2 d.2 (compare x c d) Tr.Trunc[Value x d.1].proposition ;
  choose (x : M.M) : Candidate x =
   Tr.Trunc[(p : P.M) * Id M.M (q.fn p) x].induction @l (\ w -> Candidate x) (\ w -> prop x)
    (\ w -> (g.fn w.1,Tr.Trunc[Value x (g.fn w.1)].inc (w.1,w.2,refl (g.fn w.1)))) (onto x) ;
  fn (x : M.M) : N.M = (choose x).1 ;
  at (p : P.M) : Id N.M (fn (q.fn p)) (g.fn p) =
   compare (q.fn p) (choose (q.fn p)) (g.fn p,Tr.Trunc[Value (q.fn p) (g.fn p)].inc (p,refl (q.fn p),refl (g.fn p))) ;
  from (x : M.M) (p : P.M) (e : Id M.M (q.fn p) x) : Id N.M (fn x) (g.fn p) = trans (ap fn (sym e)) (at p) ;
  add (x y : M.M) : Id N.M (fn (M.madd x y)) (N.madd (fn x) (fn y)) =
   Tr.Trunc[(p : P.M) * Id M.M (q.fn p) x].induction @l
    (\ p -> Id N.M (fn (M.madd x y)) (N.madd (fn x) (fn y))) (\ p -> N.setM _ _)
    (\ p -> Tr.Trunc[(r : P.M) * Id M.M (q.fn r) y].induction @l
     (\ r -> Id N.M (fn (M.madd x y)) (N.madd (fn x) (fn y))) (\ r -> N.setM _ _)
     (\ r -> trans (from (M.madd x y) (P.madd p.1 r.1)
      (trans (q.additive p.1 r.1) (cong2 M.M M.madd _ _ _ _ p.2 r.2)))
      (trans (g.additive p.1 r.1) (cong2 N.M N.madd _ _ _ _ (sym (from x p.1 p.2)) (sym (from y r.1 r.2))))) (onto y)) (onto x) ;
  scale (a : A.R) (x : M.M) : Id N.M (fn (M.sm a x)) (N.sm a (fn x)) =
   Tr.Trunc[(p : P.M) * Id M.M (q.fn p) x].induction @l
    (\ p -> Id N.M (fn (M.sm a x)) (N.sm a (fn x))) (\ p -> N.setM _ _)
    (\ p -> trans (from (M.sm a x) (P.sm a p.1) (trans (q.scalar a p.1) (ap (M.sm a) p.2)))
     (trans (g.scalar a p.1) (ap (N.sm a) (sym (from x p.1 p.2))))) (onto x) ;
  descended : L.Linear[M,N].H.Hom = new L.Linear[M,N].H.Hom[fn,add,scale] ;
 } ;
} ;
