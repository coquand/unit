-- An open inclusion is a monomorphism on geometric maps.
-- SliceUniversal.cancel says that two ringed maps into X|e are equal
-- when their composites with X|e->X are equal.  Equality of local maps
-- reduces to that of their underlying maps (Spaces.ext).
level l ; open Ring[l] ;
module Sp = Spaces[l] ;
module Op = OpenMaps[l] ;
module Over (X A : Sp.Space) (e : X.lattice.L) {
 module S = Op.At[X,e].Sl ;
 module UP = SliceUniversal[l].Over[X.lattice,X.structure,e,A.lattice,A.structure.sheaf] ;
 cancel (f g : Sp.Hom A (Op.space X e))
  (eq : Id (Sp.Hom A X) (Sp.compose A (Op.space X e) X (Op.inclusion X e) f)
   (Sp.compose A (Op.space X e) X (Op.inclusion X e) g)) : Id (Sp.Hom A (Op.space X e)) f g =
  Sp.ext A (Op.space X e) f g (UP.cancel (Sp.underlying f) (Sp.underlying g) (ap (Sp.underlying {A} {X}) eq)) ;
} ;
