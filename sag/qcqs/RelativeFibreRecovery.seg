-- Taking fibres of the total projection recovers F (note §5).
-- Send x in F(B,iota) to ((iota,x),refl).  On algebra maps, total-on
-- identifies the underlying points; fibre point-ext gives naturality.
-- The inverse transports a total value along its DISPLAYED base path.
-- The right inverse is Sigma-path for that same path, and the left is
-- transport at refl.  Neither equation discards a dependent component.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module T = AffineTests[l] ;
module Over (K : T.Test) (F : RelativeFunctors[l].Over[K].SetFunctor) {
 module TF = RelativeTotal[l].Over[K,F] ;
 module R = TF.R ;
 module BP = R.BP ;
 module E = RelativeEquivalences[l].Over[K] ;
 module S = RelativeFibres[l].Over[K,TF.functor,TF.projection] ;
 forward (A : BP.Algebra) (x : F.obj A) : S.obj A = (TF.At[BP.test A].pair (BP.iota A) x,refl (BP.iota A)) ;
 back (A : BP.Algebra) (p : S.obj A) : F.obj A = TF.At[BP.test A].DP.move (S.member p) (TF.At[BP.test A].value (S.point p)) ;
 right (A : BP.Algebra) (p : S.obj A) : Id (S.obj A) (forward A (back A p)) p = S.ext A _ _
  (sym (TF.At[BP.test A].DP.pair-equality (TF.At[BP.test A].value (S.point p)) (back A p) (S.member p) (refl (back A p)))) ;
 left (A : BP.Algebra) (x : F.obj A) : Id (F.obj A) (back A (forward A x)) x = refl x ;
 transformation : R.Transform[F,S.functor].Nat = (forward,\ A B h x -> S.ext B _ _ (sym (TF.on-algebra A B h x))) ;
 equivalence : E.NaturalEquivalence F S.functor = (transformation,\ A -> Pr.qinv (F.obj A) (S.obj A) (forward A) (back A) (right A) (left A)) ;
 opaque equivalence ;
} ;
