-- The converse of Theorem thm:serre (Serre note, Corollary 5.2): on an
-- affine X every torsor under a quasi-coherent module merely has a global
-- section. With SerreAffineness this is the criterion as an equivalence.
-- Proof. Let X be affine and M quasi-coherent. Every lambda_(1,g) is an
-- equivalence (SerreAffineLocalisation). The top open of X is affine
-- (AffineQcqs), so the lambda-criterion at w = 1 (SerreLambdaCriterion)
-- gives an affine model at 1: M is the associated sheaf of M(1) along the
-- canonical chart (affine reconstruction). Move a torsor along that chart
-- (SerreTorsorChart): its moved torsor is under an associated module on
-- Spec O(1), so merely has a global section (SerreAffineTorsor), which is
-- merely a section of the torsor over 1.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module DL = DistLattice[l] ; module MS = SerreModuleSheaf[l] ;
module On (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged)
 (affineX : AffineCriterion[l].Over[L,X].IsAffine) {
 affine-top : Qcqs[l].Over[L,X].AffineOpen L.top = AffineQcqs[l].Over[new Spaces[l].Space[L,X],affineX].affine-top ;
 module Of (M : MS.On[L,X.sheaf].ModuleSheaf) (qc : SerreQuasiCoherent[l].On[L,X,M].IsQuasiCoherent) {
  lambda (g : (X.sheaf.ring L.top).R) : SerreLambda[l].On[L,X,M,L.top].At[g].IsEquivalence =
   SerreAffineLocalisation[l].On[L,X,affineX,M].lambda qc g ;
  -- affine reconstruction: M|1 is associated to M(1) along the chart
  model : SerreQuasiCoherent[l].On[L,X,M].At[L.top].Model =
   SerreLambdaCriterion[l].On[L,X,M,L.top,affine-top,lambda].model ;
  acyclic : SerreTorsor[l].On[L,X.sheaf].Over[M].Acyclic1 = \ T ->
   SerreTorsorChart[l].On[L,X,M,L.top,affine-top,model,T].section ;
 } ;
 -- the hypothesis of the criterion holds on an affine X
 hypothesis : SerrePartitionCover[l].On[L,X].Hypothesis = \ M qc -> Of[M,qc].acyclic ;
} ;
-- Theorem thm:serre as an equivalence, for a qcqs X
module Criterion (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged) (qcqs : Qcqs[l].Over[L,X].IsQcqs) {
 to-affine (hypothesis : SerrePartitionCover[l].On[L,X].Hypothesis) : AffineCriterion[l].Over[L,X].IsAffine =
  SerreAffineness[l].Serre[L,X,qcqs,hypothesis].affine ;
 from-affine (affine : AffineCriterion[l].Over[L,X].IsAffine) : SerrePartitionCover[l].On[L,X].Hypothesis =
  On[L,X,affine].hypothesis ;
} ;
