-- The pullback of two lattice maps (DESIGN.md, Next 5, step 2: the opens of
-- a gluing).
--
-- For lattice maps f : L1 -> M and g : L2 -> M,
--  P = { (u, v) : L1 x L2 | f u = g v },
-- with componentwise operations.  The condition is an equation in a set,
-- so two elements with equal components are equal (ext), and the lattice
-- laws hold componentwise.
-- Closure.  f and g preserve bot, top, joins and meets, so
--  f (u \/ u2) = f u \/ f u2 = g v \/ g v2 = g (v \/ v2), and likewise for
--  the others.
-- The projections are lattice maps, by definition; hence they are monotone
--  and preserve finite joins (DistLattice.JoinMaps).  Conversely x <= y when
--  both components are (ext).
-- DoubleLattice is the case f = g = (- /\ d), into the opens below d.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module DL = DistLattice[l] ;
module Over (L1 L2 M : DL.DLat) (f : DL.Hom L1 M) (g : DL.Hom L2 M) {
 module O1 = DL.Order[L1] ;
 module O2 = DL.Order[L2] ;
 Match (u : L1.L) (v : L2.L) : U l = Id M.L (DL.hmap f u) (DL.hmap g v) ;
 Opens : U l = (p : L1.L * L2.L) * Match p.1 p.2 ;
 pair (u : L1.L) (v : L2.L) (e : Match u v) : Opens = ((u,v),e) ;
 first (x : Opens) : L1.L = x.1.1 ;
 second (x : Opens) : L2.L = x.1.2 ;
 match (x : Opens) : Match (first x) (second x) = x.2 ;
 ext (x y : Opens) (e1 : Id L1.L (first x) (first y)) (e2 : Id L2.L (second x) (second y)) : Id Opens x y =
  Pr.Sigma-eq (L1.L * L2.L) (\ p -> Match p.1 p.2) x.1 y.1 x.2 y.2
   (trans (Pr.ap L1.L (L1.L * L2.L) (\ u -> (u,second x)) (first x) (first y) e1)
     (Pr.ap L2.L (L1.L * L2.L) (\ v -> (first y,v)) (second x) (second y) e2))
   (M.setL (DL.hmap f (first y)) (DL.hmap g (second y))) ;
 opens-set : Pr.isSet Opens =
  Pr.isSet-Sigma (L1.L * L2.L) (\ p -> Match p.1 p.2)
   (Pr.isSet-Sigma L1.L (\ u -> L2.L) L1.setL (\ u -> L2.setL))
   (\ p -> Pr.prop-to-set (Match p.1 p.2) (M.setL (DL.hmap f p.1) (DL.hmap g p.2))) ;

 botP : Opens = pair L1.bot L2.bot (trans (DL.hmap-bot f) (sym (DL.hmap-bot g))) ;
 topP : Opens = pair L1.top L2.top (trans (DL.hmap-top f) (sym (DL.hmap-top g))) ;
 joinP (x y : Opens) : Opens = pair (L1.join (first x) (first y)) (L2.join (second x) (second y))
  (trans (DL.hmap-join f (first x) (first y))
   (trans (cong2 M.L M.join _ _ _ _ (match x) (match y)) (sym (DL.hmap-join g (second x) (second y))))) ;
 meetP (x y : Opens) : Opens = pair (L1.meet (first x) (first y)) (L2.meet (second x) (second y))
  (trans (DL.hmap-meet f (first x) (first y))
   (trans (cong2 M.L M.meet _ _ _ _ (match x) (match y)) (sym (DL.hmap-meet g (second x) (second y))))) ;
 lattice : DL.DLat = new DL.DLat[Opens,opens-set,botP,topP,joinP,meetP,
  \ x y w -> ext (joinP x (joinP y w)) (joinP (joinP x y) w) (L1.joinA (first x) (first y) (first w)) (L2.joinA (second x) (second y) (second w)),
  \ x y -> ext (joinP x y) (joinP y x) (L1.joinC (first x) (first y)) (L2.joinC (second x) (second y)),
  \ x -> ext (joinP x botP) x (L1.joinB (first x)) (L2.joinB (second x)),
  \ x y w -> ext (meetP x (meetP y w)) (meetP (meetP x y) w) (L1.meetA (first x) (first y) (first w)) (L2.meetA (second x) (second y) (second w)),
  \ x y -> ext (meetP x y) (meetP y x) (L1.meetC (first x) (first y)) (L2.meetC (second x) (second y)),
  \ x -> ext (meetP x topP) x (L1.meetT (first x)) (L2.meetT (second x)),
  \ x y -> ext (meetP x (joinP x y)) x (L1.absorb-meet (first x) (first y)) (L2.absorb-meet (second x) (second y)),
  \ x y -> ext (joinP x (meetP x y)) x (L1.absorb-join (first x) (first y)) (L2.absorb-join (second x) (second y)),
  \ x y w -> ext (meetP x (joinP y w)) (joinP (meetP x y) (meetP x w)) (L1.dist (first x) (first y) (first w)) (L2.dist (second x) (second y) (second w))] ;

 module OP = DL.Order[lattice] ;
 module JP = DL.Joins[lattice] ;
 -- the projections are lattice maps
 first-map : DL.Hom lattice L1 =
  (first,refl L1.bot,refl L1.top,\ x y -> refl (L1.join (first x) (first y)),\ x y -> refl (L1.meet (first x) (first y))) ;
 second-map : DL.Hom lattice L2 =
  (second,refl L2.bot,refl L2.top,\ x y -> refl (L2.join (second x) (second y)),\ x y -> refl (L2.meet (second x) (second y))) ;
 le-first (x y : Opens) (k : OP.Le x y) : O1.Le (first x) (first y) = DL.JoinMaps[lattice,L1,first-map].monotone x y k ;
 le-second (x y : Opens) (k : OP.Le x y) : O2.Le (second x) (second y) = DL.JoinMaps[lattice,L2,second-map].monotone x y k ;
 le-pair (x y : Opens) (k1 : O1.Le (first x) (first y)) (k2 : O2.Le (second x) (second y)) : OP.Le x y =
  ext (meetP x y) x k1 k2 ;
 join-first (n : Nat) (h : Fin n -> Opens) : Id L1.L (first (JP.bigJ n h)) (DL.Joins[L1].bigJ n (\ i -> first (h i))) =
  DL.JoinMaps[lattice,L1,first-map].preserves n h ;
 join-second (n : Nat) (h : Fin n -> Opens) : Id L2.L (second (JP.bigJ n h)) (DL.Joins[L2].bigJ n (\ i -> second (h i))) =
  DL.JoinMaps[lattice,L2,second-map].preserves n h ;
} ;
