-- Degree-zero gluing on a relative principal cover D(g)<=join D(h_i).
-- Clear denominators and pairwise errors exactly as in the unit-ideal
-- proof. The corrected numerators satisfy t_i|h_j=h_i^r*s_j. The formal
-- Nullstellensatz expresses g^p as a combination of the h_i^r. Form
-- that combination of the t_i and divide by g^p in M_g. Clearing this
-- denominator proves every matching equation. Relative separation makes
-- the amalgam unique and permits all choices to remain truncated.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module CF = SerreModuleClearFinite[l] ; module CE = SerreModuleClearErrors[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (Md : SM.Over[A].Module) {
 module Data = SerreModuleGluingData[l].Over[A,setA,Md] ;
 module R = Data.R ; module Z = Data.Z ; module O = Data.O ;
 module AP = AffinePowers[l].Over[A] ;
 module Overlap = SerreModuleBasicRestrictionsOverlap[l].Over[A,setA,Md] ;
 module Rad = Radical[l].Over[A] ; module FL = FamilyLattice[l].Over[A] ;
 module MS = SerreModuleSums[l].Over[A,Md] ;
 module Cover (g : A.R) (n : Nat) (fs : Fin n -> A.R)
  (below : (i : Fin n) -> O.Le (Z.D (fs i)) (Z.D g))
  (covers : O.Le (Z.D g) (Z.J.bigJ n (\ i -> Z.D (fs i)))) {
  module G = R.Local[g].Native ;
  module Sep = SerreModuleBasicRestrictionsSeparation[l].Over[A,setA,Md].Cover[g,n,fs,below,covers] ;
  module C {
   module Index (i : Fin n) { module P = Data.Local[fs i] ; module Res = R.At[g,fs i,below i] ; } ;
   module Pair (i j : Fin n) {
    overlap : A.R = A.mul (fs i) (fs j) ;
    module L = R.At[fs i,overlap,Data.left (fs i) (fs j)] ;
    module Rho = R.At[fs j,overlap,Data.right (fs i) (fs j)] ;
    module P = Data.Local[overlap] ;
   } ;
   Families : U l = (i : Fin n) -> Index[i].P.L.Carrier ;
   Compatible (xs : Families) : U l = (i j : Fin n) ->
    Id Pair[i,j].P.L.Carrier (Pair[i,j].L.map (xs i)) (Pair[i,j].Rho.map (xs j)) ;
   Matches (xs : Families) (x : G.L.Carrier) : U l = (i : Fin n) -> Id Index[i].P.L.Carrier (Index[i].Res.map x) (xs i) ;
   Amalgam (xs : Families) : U l = (x : G.L.Carrier) * Matches xs x ;
   matches-prop (xs : Families) (x : G.L.Carrier) : Pr.isProp (Matches xs x) =
    Axioms[l].FunExtLemmas[fe @l].isProp-Pi (Fin n)
     (\ i -> Id Index[i].P.L.Carrier (Index[i].Res.map x) (xs i)) (\ i -> Index[i].P.L.carrier-set _ _) ;
   amalgam-prop (xs : Families) : Pr.isProp (Amalgam xs) = \ a b ->
    Pr.Sigma-eq G.L.Carrier (Matches xs) a.1 b.1 a.2 b.2
     (Sep.injective a.1 b.1 (\ i -> trans (a.2 i) (sym (b.2 i)))) (matches-prop xs b.1) ;
   module Clear (xs : Families) {
    module Family = CF.Over[A].Family[n,\ i -> Md,\ i -> Index[i].P.Native.localised,
     \ i -> Index[i].P.Native.canonical,fs,xs] ;
    initial : Tr.Trunc[Family.Common].carrier = Family.common
     (\ i -> SerreModuleClearFractions[l].At[A,Md,fs i].clearing (xs i)) ;
   } ;
  } ;
  module Partition {
   module Exact (xs : C.Families) (r : Nat) (ts : Fin n -> Md.M)
    (exact : (i j : Fin n) -> Id C.Index[j].P.L.Carrier
     (C.Index[j].P.L.fraction (ts i) zero) (C.Index[j].P.Native.localised.sm (AP.power (fs i) r) (xs j))) {
    powers (i : Fin n) : A.R = AP.power (fs i) r ;
    radical : Rad.InRad (n,powers) g = Z.reflect (FL.single g) (n,powers)
     (O.le-trans (Z.D g) (Z.J.bigJ n (\ i -> Z.D (fs i))) (Z.cls (n,powers)) covers
      (O.le-trans (Z.J.bigJ n (\ i -> Z.D (fs i))) (Z.J.bigJ n (\ i -> Z.D (powers i))) (Z.cls (n,powers))
       (Z.J.least n (\ i -> Z.D (fs i)) (Z.J.bigJ n (\ i -> Z.D (powers i)))
        (\ i -> O.le-trans (Z.D (fs i)) (Z.D (powers i)) (Z.J.bigJ n (\ j -> Z.D (powers j)))
         (Data.Support.power-above (fs i) r) (Z.J.below n (\ j -> Z.D (powers j)) i)))
       (O.le-of-eq (Z.J.bigJ n (\ i -> Z.D (powers i))) (Z.cls (n,powers)) (sym (Z.generated (n,powers)))))) (inr tt) ;
    module Chosen (d : Rad.RadData (n,powers) g) {
     coefficient (i : Fin n) : A.R = Rad.rad-coefficients d i ;
     weights (i : Fin n) : A.R = A.mul (powers i) (coefficient i) ;
     section : Md.M = MS.sum n (\ i -> Md.sm (coefficient i) (ts i)) ;
     module Index (j : Fin n) {
      module N = C.Index[j].P.Native ; module H = C.Index[j].P.H ;
      module Sums = SerreModuleSums[l].Over[A,N.localised] ;
      module MapSums = SerreModuleSums[l].Map[A,A,RingHom[l].identity A,Md,N.localised,N.canonical] ;
      term (i : Fin n) : Id N.L.Carrier (H.map N.canonical (Md.sm (coefficient i) (ts i))) (N.localised.sm (weights i) (xs j)) =
       trans (H.map-scale N.canonical (coefficient i) (ts i))
        (trans (ap (N.localised.sm (coefficient i)) (trans (N.canonical-at (ts i)) (exact i j)))
         (trans (N.localised.smA (coefficient i) (powers i) (xs j))
          (ap (\ a -> N.localised.sm a (xs j)) (A.mulC (coefficient i) (powers i))))) ;
      equation : Id N.L.Carrier (N.L.fraction section zero) (N.localised.sm (AP.power g (Rad.rad-power d)) (xs j)) =
       trans (sym (N.canonical-at section))
        (trans (MapSums.sum-map n (\ i -> Md.sm (coefficient i) (ts i)))
         (trans (Sums.sum-cong n (\ i -> H.map N.canonical (Md.sm (coefficient i) (ts i)))
          (\ i -> N.localised.sm (weights i) (xs j)) term)
          (trans (Sums.sum-scalars n weights (xs j)) (ap (\ a -> N.localised.sm a (xs j)) (Rad.rad-equation d))))) ;
      matches : Id N.L.Carrier (C.Index[j].Res.map (G.L.fraction section (Rad.rad-power d))) (xs j) =
       C.Index[j].Res.E.InverseAction.power-injective (Rad.rad-power d) _ _
        (trans (C.Index[j].Res.clears section (Rad.rad-power d))
         (trans equation (sym (C.Index[j].Res.E.T.power-scalar (Rad.rad-power d) (xs j))))) ;
     } ;
     amalgam : C.Amalgam xs = (G.L.fraction section (Rad.rad-power d),\ j -> Index[j].matches) ;
    } ;
    amalgam : C.Amalgam xs = Tr.Trunc[Rad.RadData (n,powers) g].induction @l
     (\ t -> C.Amalgam xs) (\ t -> C.amalgam-prop xs) (\ d -> Chosen[d].amalgam) radical ;
   } ;
  } ;
  module Initial (xs : C.Families) (compatible : C.Compatible xs)
   (r : Nat) (ts : Fin n -> Md.M)
   (initial : (i : Fin n) -> Id C.Index[i].P.L.Carrier (C.Index[i].P.L.fraction (ts i) zero)
    (C.Index[i].P.Native.localised.sm (AP.power (fs i) r) (xs i))) {
   module Pair (i j : Fin n) {
    module N = C.Index[j].P.Native ; module ML = C.Index[j].P.Laws ;
    module Q = C.Pair[i,j] ;
    module Sub = CE.Over[A].Along[N.localised,Q.P.Native.localised,Q.Rho.native] ;
    module Step = Overlap.At[fs i,fs j] ;
    error : N.L.Carrier = ML.sub (N.L.fraction (ts i) zero) (N.localised.sm (AP.power (fs i) r) (xs j)) ;
    error-at : Id N.L.Carrier error (ML.sub (N.L.fraction (ts i) zero) (N.localised.sm (AP.power (fs i) r) (xs j))) = refl error ;
    image-equation : Id Q.P.L.Carrier (Q.Rho.map (N.L.fraction (ts i) zero))
     (Q.Rho.map (N.localised.sm (AP.power (fs i) r) (xs j))) =
     trans (Q.Rho.on-original (ts i))
      (trans (sym (Q.L.on-original (ts i)))
       (trans (ap Q.L.map (initial i))
        (trans (Q.L.map-scale (AP.power (fs i) r) (xs i))
         (trans (ap (Q.P.Native.localised.sm (AP.power (fs i) r)) (compatible i j))
          (sym (Q.Rho.map-scale (AP.power (fs i) r) (xs j))))))) ;
    vanishes : Id Q.P.L.Carrier (Q.Rho.map error) Q.P.Native.Action.mz =
     trans (Sub.map-sub (N.L.fraction (ts i) zero) (N.localised.sm (AP.power (fs i) r) (xs j)))
      (trans (ap (\ x -> Q.P.Laws.sub x (Q.Rho.map (N.localised.sm (AP.power (fs i) r) (xs j)))) image-equation)
       (Q.P.Laws.sub-self (Q.Rho.map (N.localised.sm (AP.power (fs i) r) (xs j))))) ;
    killed : Tr.Trunc[Step.Kill error].carrier = Step.kill error
     (trans (Data.R.rho-irr (fs j) Q.overlap Step.below (Data.right (fs i) (fs j)) error) vanishes) ;
    opaque error ;
   } ;
   module Errors = CE.Over[A].Matrix[n,n,\ i j -> C.Index[j].P.Native.localised,\ i j -> fs i,\ i j -> Pair[i,j].error] ;
   common-errors : Tr.Trunc[Errors.Common].carrier = Errors.common (\ i j -> Pair[i,j].killed) ;
   module Correct (e : Nat)
    (kills : (i j : Fin n) -> Id C.Index[j].P.L.Carrier
     (C.Index[j].P.Native.localised.sm (AP.power (fs i) e) Pair[i,j].error) C.Index[j].P.Native.Action.mz) {
    numerators (i : Fin n) : Md.M = Md.sm (AP.power (fs i) e) (ts i) ;
    module PairExact (i j : Fin n) {
     module N = C.Index[j].P.Native ; module ML = C.Index[j].P.Laws ; module H = C.Index[j].P.H ;
     killed-equality : Id N.L.Carrier
      (N.localised.sm (AP.power (fs i) e) (N.L.fraction (ts i) zero))
      (N.localised.sm (AP.power (fs i) e) (N.localised.sm (AP.power (fs i) r) (xs j))) =
      ML.sub-zero _ _ (trans (sym (ML.sm-sub (AP.power (fs i) e) (N.L.fraction (ts i) zero)
       (N.localised.sm (AP.power (fs i) r) (xs j))))
       (trans (sym (ap (N.localised.sm (AP.power (fs i) e)) Pair[i,j].error-at)) (kills i j))) ;
     exact : Id N.L.Carrier (N.L.fraction (numerators i) zero) (N.localised.sm (AP.power (fs i) (plus r e)) (xs j)) =
      trans (sym (N.canonical-at (numerators i)))
       (trans (H.map-scale N.canonical (AP.power (fs i) e) (ts i))
        (trans (ap (N.localised.sm (AP.power (fs i) e)) (N.canonical-at (ts i)))
         (trans killed-equality (CF.Over[A].Action[N.localised].raise (fs i) r (plus r e) (e,refl (plus r e)) (xs j))))) ;
    } ;
    amalgam : C.Amalgam xs = Partition.Exact[xs,plus r e,numerators,\ i j -> PairExact[i,j].exact].amalgam ;
   } ;
   amalgam : C.Amalgam xs =
    Tr.Trunc[Errors.Common].induction @l (\ w -> C.Amalgam xs) (\ w -> C.amalgam-prop xs)
     (\ w -> Correct[w.1,w.2].amalgam) common-errors ;
  } ;
  amalgam (xs : C.Families) (compatible : C.Compatible xs) : C.Amalgam xs =
   Tr.Trunc[C.Clear[xs].Family.Common].induction @l (\ w -> C.Amalgam xs) (\ w -> C.amalgam-prop xs)
    (\ w -> Initial[xs,compatible,w.1,w.2.1,\ i -> trans (sym (C.Index[i].P.Native.canonical-at (w.2.1 i))) (w.2.2 i)].amalgam) C.Clear[xs].initial ;
  equaliser (xs : C.Families) (compatible : C.Compatible xs) : Localisation[l].isContr (C.Amalgam xs) =
   (amalgam xs compatible,\ a -> C.amalgam-prop xs (amalgam xs compatible) a) ;
 } ;
} ;
