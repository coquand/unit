-- Full Cech classification for torsors trivial on a finite cover (Serre §5).
-- A mere family of local sections gives a unique H1 class because changing
-- the sections changes the cocycle by a coboundary. Extract that unique
-- class without extracting a family of sections. Equality of these classes
-- is equivalent to mere equivariant natural isomorphism, by the checked
-- supplied-section theorem. Every H1 class is merely represented by its
-- coordinate torsor, using quotient induction into a proposition one level
-- higher; no small universe of all torsors or resizing is asserted.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ;
module DL = DistLattice[l] ; module MS = SerreModuleSheaf[l] ;
module Tr = Truncation[l] ; module BigTr = Truncation[l+] ;
module On (L : DL.DLat) (G : RingedLattice[l].On[L].Presheaf)
 (M : MS.On[L,G].ModuleSheaf) (n : Nat) (as : Fin n -> L.L)
 (covers : DL.Order[L].Le L.top (DL.Joins[L].bigJ n as)) {
 module Supplied = SerreCechIsoClassSections[l].On[L,G,M,n,as,covers] ;
 module Maps = Supplied.Maps ; module Torsors = Maps.Torsors ;
 module Z = Supplied.Z ;
 module TorsorClass (T : Torsors.Torsor) {
  Trivialisations : U l = (i : Fin n) -> T.presheaf.obj (as i) ;
  Covered : U l = Tr.Trunc[Trivialisations].carrier ;
  module With (ts : Trivialisations) { module C = SerreCechTriviality[l].On[L,G,M,T,n,as,covers,ts] ; } ;
  Witness (h : Z.H1) : U l = (ts : Trivialisations) * Id Z.H1 With[ts].C.class h ;
  Has (h : Z.H1) : U l = Tr.Trunc[Witness h].carrier ;
  Candidate : U l = (h : Z.H1) * Has h ;
  module Two (h k : Z.H1) {
   equal-witness (u : Witness h) (v : Witness k) : Id Z.H1 h k =
    trans (sym u.2) (trans (SerreCechChangeTrivialisation[l].On[L,G,M,T,n,as,covers,u.1,v.1].class-equal) v.2) ;
   equal (u : Has h) (v : Has k) : Id Z.H1 h k =
    Tr.Trunc[Witness h].induction @l (\ t -> Id Z.H1 h k) (\ t -> Z.h1-set _ _)
     (\ a -> Tr.Trunc[Witness k].induction @l (\ t -> Id Z.H1 h k) (\ t -> Z.h1-set _ _)
      (equal-witness a) v) u ;
  } ;
  candidate-prop : Pr.isProp Candidate = \ u v ->
   Pr.Sigma-eq Z.H1 Has u.1 v.1 u.2 v.2 (Two[u.1,v.1].equal u.2 v.2) Tr.Trunc[Witness v.1].proposition ;
  at (ts : Trivialisations) : Candidate = (With[ts].C.class,Tr.Trunc[Witness With[ts].C.class].inc (ts,refl With[ts].C.class)) ;
  chosen (covered : Covered) : Candidate = Tr.Trunc[Trivialisations].induction @l
   (\ t -> Candidate) (\ t -> candidate-prop) at covered ;
  class (covered : Covered) : Z.H1 = (chosen covered).1 ;
  on-sections (covered : Covered) (ts : Trivialisations) : Id Z.H1 (class covered) With[ts].C.class =
   Two[class covered,With[ts].C.class].equal (chosen covered).2 (at ts).2 ;
  independent (a b : Covered) : Id Z.H1 (class a) (class b) = Two[class a,class b].equal (chosen a).2 (chosen b).2 ;
  zero-to-section (covered : Covered) (zero-class : Id Z.H1 (class covered) Z.zero) : Tr.Trunc[T.presheaf.obj L.top].carrier =
   Tr.Trunc[Trivialisations].induction @l (\ t -> Tr.Trunc[T.presheaf.obj L.top].carrier)
    (\ t -> Tr.Trunc[T.presheaf.obj L.top].proposition)
    (\ ts -> With[ts].C.trivial (trans (sym (on-sections covered ts)) zero-class)) covered ;
  section-to-zero (covered : Covered) (section : Tr.Trunc[T.presheaf.obj L.top].carrier) : Id Z.H1 (class covered) Z.zero =
   Tr.Trunc[Trivialisations].induction @l (\ t -> Id Z.H1 (class covered) Z.zero) (\ t -> Z.h1-set _ _)
    (\ ts -> trans (on-sections covered ts) (With[ts].C.section-zero section)) covered ;
  zero-classification (covered : Covered) : Pr.Equiv (Id Z.H1 (class covered) Z.zero) (Tr.Trunc[T.presheaf.obj L.top].carrier) =
   (zero-to-section covered,Pr.qinv (Id Z.H1 (class covered) Z.zero) (Tr.Trunc[T.presheaf.obj L.top].carrier)
    (zero-to-section covered) (section-to-zero covered)
    (\ t -> Tr.Trunc[T.presheaf.obj L.top].proposition (zero-to-section covered (section-to-zero covered t)) t)
    (\ p -> Z.h1-set _ _ (section-to-zero covered (zero-to-section covered p)) p)) ;
  opaque chosen ; opaque class ;
 } ;
 module Between (T V : Torsors.Torsor) (ct : TorsorClass[T].Covered) (cv : TorsorClass[V].Covered) {
  module TC = TorsorClass[T] ; module VC = TorsorClass[V] ;
  SameClass : U l = Id Z.H1 (TC.class ct) (VC.class cv) ;
  Isomorphic : U l = Tr.Trunc[Maps.Between[T,V].EquivariantIso].carrier ;
  module WithSections (ts : TC.Trivialisations) (vs : VC.Trivialisations) {
   module C = Supplied.ForSections[T,V,ts,vs] ;
   same-to-iso (same : SameClass) : Isomorphic = C.classes-to-isomorphism
    (trans (sym (TC.on-sections ct ts)) (trans same (VC.on-sections cv vs))) ;
   iso-to-same (e : Isomorphic) : SameClass =
    trans (TC.on-sections ct ts) (trans (C.isomorphism-to-classes e) (sym (VC.on-sections cv vs))) ;
  } ;
  same-to-isomorphism (same : SameClass) : Isomorphic =
   Tr.Trunc[TC.Trivialisations].induction @l (\ t -> Isomorphic) (\ t -> Tr.Trunc[Maps.Between[T,V].EquivariantIso].proposition)
    (\ ts -> Tr.Trunc[VC.Trivialisations].induction @l (\ t -> Isomorphic) (\ t -> Tr.Trunc[Maps.Between[T,V].EquivariantIso].proposition)
     (\ vs -> WithSections[ts,vs].same-to-iso same) cv) ct ;
  isomorphism-to-same (e : Isomorphic) : SameClass =
   Tr.Trunc[TC.Trivialisations].induction @l (\ t -> SameClass) (\ t -> Z.h1-set _ _)
    (\ ts -> Tr.Trunc[VC.Trivialisations].induction @l (\ t -> SameClass) (\ t -> Z.h1-set _ _)
     (\ vs -> WithSections[ts,vs].iso-to-same e) cv) ct ;
  classification : Pr.Equiv SameClass Isomorphic =
   (same-to-isomorphism,Pr.qinv SameClass Isomorphic same-to-isomorphism isomorphism-to-same
    (\ e -> Tr.Trunc[Maps.Between[T,V].EquivariantIso].proposition (same-to-isomorphism (isomorphism-to-same e)) e)
    (\ p -> Z.h1-set _ _ (isomorphism-to-same (same-to-isomorphism p)) p)) ;
 } ;
 Representation (h : Z.H1) : U l+ =
  BigTr.Trunc[(T : Torsors.Torsor) * (ct : TorsorClass[T].Covered) * Id Z.H1 (TorsorClass[T].class ct) h].carrier ;
 module AtCocycle (c : Z.Cocycle) {
  module Local = SerreCechTorsorLocal[l].On[L,G,M,n,as,c,covers] ;
  module Recovery = SerreCechCanonicalCocycle[l].On[L,G,M,n,as,c,covers] ;
  module Class = TorsorClass[Local.torsor] ;
  covered : Class.Covered = Tr.Trunc[Class.Trivialisations].inc Local.local-point ;
  class-equation : Id Z.H1 (Class.class covered) (Z.class c) =
   trans (Class.on-sections covered Local.local-point) Recovery.class-equation ;
  representation : Representation (Z.class c) =
   BigTr.Trunc[(T : Torsors.Torsor) * (ct : TorsorClass[T].Covered) * Id Z.H1 (TorsorClass[T].class ct) (Z.class c)].inc
    (Local.torsor,covered,class-equation) ;
 } ;
 represented (h : Z.H1) : Representation h = Z.Q.induction @(l+) Representation
  (\ h -> BigTr.Trunc[(T : Torsors.Torsor) * (ct : TorsorClass[T].Covered) * Id Z.H1 (TorsorClass[T].class ct) h].proposition)
  (\ c -> AtCocycle[c].representation) h ;
} ;
