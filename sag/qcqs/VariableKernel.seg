-- f_X : A -> A[1/X] is injective, for A = k[X] over any ring k (moved from
-- DoubledLineGlobal; used there and for the projective line).
-- If f_X(a) = f_X(b), then f_X(a - b) = 0, so merely X^n (a - b) = 0
-- (elementary form); X is a non-zero-divisor of k[X]
-- (PolynomialCoefficients), hence so is X^n (Regularity), and a = b.
-- Lemma (unit).  D(1) <= D(X) in the Zariski lattice of k[X] gives 1 = 0 in
-- k: merely 1 = 1^n = X q (Bridge, the Nullstellensatz), and evaluating at
-- 0 gives 1 = 0 q(0) = 0 (moved from DoubledLineNotAffine).
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) {
 module P = PolynomialRing[l].Extension[k,setk] ;
 module AF = Affine[l].Over[P.ring] ;
 module PC = PolynomialCoefficients[l].Over[k,setk] ;
 module Reg = Regularity[l].Over[P.ring] ;
 module BX = Bridge[l].Over[P.ring,P.variable] ;
 module RA = RL[P.ring] ;

 regular : Reg.Regular P.variable = Reg.from-kernel P.variable PC.variable-regular ;
 module Kernel (a b : P.ring.R)
  (e : Id (AF.Loc P.variable).R (map (AF.inclusion P.variable) a) (map (AF.inclusion P.variable) b)) {
  difference-zero : Id (AF.Loc P.variable).R (map (AF.inclusion P.variable) (P.ring.add a (P.ring.neg b))) (AF.Loc P.variable).z = calc (AF.Loc P.variable).R {
   map (AF.inclusion P.variable) (P.ring.add a (P.ring.neg b))
    =< map-add (AF.inclusion P.variable) a (P.ring.neg b)
     > (AF.Loc P.variable).add (map (AF.inclusion P.variable) a) (map (AF.inclusion P.variable) (P.ring.neg b))
    =< ap ((AF.Loc P.variable).add (map (AF.inclusion P.variable) a)) (map-neg (AF.inclusion P.variable) b)
     > (AF.Loc P.variable).add (map (AF.inclusion P.variable) a) ((AF.Loc P.variable).neg (map (AF.inclusion P.variable) b))
    =< ap (\ t -> (AF.Loc P.variable).add t ((AF.Loc P.variable).neg (map (AF.inclusion P.variable) b))) e
     > (AF.Loc P.variable).add (map (AF.inclusion P.variable) b) ((AF.Loc P.variable).neg (map (AF.inclusion P.variable) b))
    =< (AF.Loc P.variable).addN (map (AF.inclusion P.variable) b) > (AF.Loc P.variable).z } ;
  -- a killer X^n of a - b
  module By (c : BX.LocH.Killer (P.ring.add a (P.ring.neg b))) {
   killer-regular : Reg.Regular (BX.LocH.kill c) =
    Pr.subst P.ring.R Reg.Regular (Reg.Pow.power P.variable (BX.index (BX.LocH.kill-in c))) (BX.LocH.kill c)
     (BX.index-eq (BX.LocH.kill-in c)) (Reg.powers P.variable regular (BX.index (BX.LocH.kill-in c))) ;
   equal : Id P.ring.R a b =
    Reg.difference a b (killer-regular (P.ring.add a (P.ring.neg b)) P.ring.z
     (trans (BX.LocH.kill-eq c) (sym (RA.mul-zero (BX.LocH.kill c))))) ;
  } ;
  equal : Id P.ring.R a b =
   Tr.Trunc[BX.LocH.Killer (P.ring.add a (P.ring.neg b))].induction @l (\ c -> Id P.ring.R a b) (\ c -> P.set a b)
    (\ c -> By[c].equal) (BX.LocH.kernel (AF.elementary P.variable) (P.ring.add a (P.ring.neg b)) difference-zero) ;
 } ;

 -- D(1) <= D(X) gives 1 = 0 in k
 module Z = ZariskiLattice[l].Over[P.ring] ;
 module Ev = Evaluation[l].Evaluate[k,k,setk,setk,RH.identity k,k.z] ;
 module BO = Bridge[l].Over[P.ring,P.ring.o] ;
 power-one : (n : Nat) -> Id P.ring.R (Reg.Pow.power P.ring.o n) P.ring.o = split {
  zero -> refl P.ring.o ;
  suc n | ih -> trans (ap (P.ring.mul P.ring.o) ih) (P.ring.mulO P.ring.o) } ;
 -- 1 = X q gives 1 = 0 after evaluation at 0
 at-zero (dv : BO.Divides P.variable) : Id k.R k.o k.z = calc k.R {
  k.o =< sym (map-one Ev.extension) > map Ev.extension P.ring.o
   =< ap (map Ev.extension) (trans (sym (power-one (BO.exponent dv))) (BO.divides-eq dv))
    > map Ev.extension (P.ring.mul P.variable (BO.cofactor dv))
   =< map-mul Ev.extension P.variable (BO.cofactor dv)
    > k.mul (map Ev.extension P.variable) (map Ev.extension (BO.cofactor dv))
   =< ap (\ t -> k.mul t (map Ev.extension (BO.cofactor dv))) Ev.on-variable > k.mul k.z (map Ev.extension (BO.cofactor dv))
   =< k.mulC k.z (map Ev.extension (BO.cofactor dv)) > k.mul (map Ev.extension (BO.cofactor dv)) k.z
   =< RL[k].mul-zero (map Ev.extension (BO.cofactor dv)) > k.z } ;
 one-zero (le : DL.Order[Z.lattice].Le (Z.D P.ring.o) (Z.D P.variable)) : Id k.R k.o k.z =
  Tr.Trunc[BO.Divides P.variable].induction @l (\ c -> Id k.R k.o k.z) (\ c -> setk k.o k.z) at-zero
   (BO.le-below P.variable le) ;
} ;
