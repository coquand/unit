-- An embedding has propositional fibres.
-- Over f(b), lift a path f(a)=f(b) through ap(f); its section equation
-- reduces the fibre point to (a,ap(f)(p)).  Path induction gives equality
-- with (b,refl).  Path induction on a general fibre point reduces the
-- general assertion to that case.  Thus mere inhabited fibres can be
-- inhabited without choosing representatives.
level l ; open Base ; open Prelude[l] ;
module Over (A B : U l) (f : A -> B)
 (embedding : (x y : A) -> isEquiv (Id A x y) (Id B (f x) (f y)) (ap A B f x y)) {
 Fibre (b : B) : U l = (a : A) * Id B (f a) b ;
 at-refl (b a : A) (p : Id A a b) : Id (Fibre (f b)) (a,ap A B f a b p) (b,refl (f b)) =
  Paths[l].idJR A b (\ a1 p1 -> Id (Fibre (f b)) (a1,ap A B f a1 b p1) (b,refl (f b))) (refl (b,refl (f b))) a p ;
 at-image (b a : A) (u : Id B (f a) (f b)) : Id (Fibre (f b)) (a,u) (b,refl (f b)) =
  trans (Fibre (f b)) (a,u) (a,ap A B f a b ((embedding a b).sec u)) (b,refl (f b))
   (ap (Id B (f a) (f b)) (Fibre (f b)) (\ v -> (a,v)) u (ap A B f a b ((embedding a b).sec u))
    (sym (Id B (f a) (f b)) (ap A B f a b ((embedding a b).sec u)) u ((embedding a b).sec-eq u)))
   (at-refl b a ((embedding a b).sec u)) ;
 centre (a : A) (b : B) (p : Id B (f a) b) : (w : Fibre b) -> Id (Fibre b) w (a,p) =
  idJ B (f a) (\ b1 p1 -> (w : Fibre b1) -> Id (Fibre b1) w (a,p1)) (\ w -> at-image a w.1 w.2) b p ;
 proposition (b : B) : isProp (Fibre b) = \ u v -> centre v.1 b v.2 u ;
} ;
