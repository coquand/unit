-- Localisation preserves kernels (Serre note, Section 3).
-- The localised inclusion lands in the kernel, by its fraction formula.
-- It is injective: an equality of underlying fractions gives a killing
-- witness which is also an equality in the kernel subtype.
-- For surjectivity, write a kernel element as x/f^p. Its image being zero
-- implies that the image of x is killed by some f^e. Thus f^e*x belongs
-- to the original kernel and represents the element with denominator
-- f^(e+p). Unique fibres permit the mere representatives to determine
-- the inverse. The comparison is linear by the induced inclusion map.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module K = SerreModuleKernelAlgebra[l] ;
module LS = SerreModuleLocalisationStructure[l] ;
module LL = SerreModuleLocalisationLinear[l] ;
module LA = SerreModuleLocalisationAction[l] ;
module At (A : CRing) (Md Nd : SM.Over[A].Module)
 (q : MM.Between[A,A,RingHom[l].identity A,Md,Nd].Hom) (f : A.R) {
 module Original = K.Over[A,Md,Nd,q] ;
 module S = LS.At[A,Original.kernel,f] ;
 module T = LS.At[A,Md,f] ; module N = LS.At[A,Nd,f] ;
 module NA = LA.At[A,Nd,f] ;
 module P = AffinePowers[l].Over[A] ;
 module Q = LL.Along[A,A,RingHom[l].identity A,Md,Nd,q,f] ;
 module I = LL.Along[A,A,RingHom[l].identity A,Original.kernel,Md,Original.inclusion,f] ;
 module Target = K.Over[A,T.localised,N.localised,Q.induced] ;
 ambient (x : S.L.Carrier) : T.L.Carrier = I.Maps.map I.induced x ;
 ambient-fraction (x : Original.Carrier) (p : Nat) :
  Id T.L.Carrier (ambient (S.L.fraction x p)) (T.L.fraction (Original.value x) p) =
  trans (I.induced-at x p) (ap (\ y -> T.L.fraction y p) (Original.inclusion-at x)) ;
 killed (x : S.L.Carrier) : Target.Member (ambient x) =
  S.L.induction @l (\ x -> Target.Member (ambient x)) (\ x -> Target.member-prop (ambient x))
   (\ x p -> trans (ap (Q.Maps.map Q.induced) (ambient-fraction x p))
    (trans (Q.induced-at (Original.value x) p)
     (trans (ap (\ y -> N.L.fraction y p) (Original.member x)) (NA.zero-at p)))) x ;
 forward (x : S.L.Carrier) : Target.Carrier = (ambient x,killed x) ;
 forward-value (x : S.L.Carrier) : Id T.L.Carrier (Target.value (forward x)) (ambient x) = refl (ambient x) ;
 forward-fraction (x : Original.Carrier) (p : Nat) :
  Id T.L.Carrier (Target.value (forward (S.L.fraction x p))) (T.L.fraction (Original.value x) p) =
  trans (forward-value (S.L.fraction x p)) (ambient-fraction x p) ;
 power-value (n : Nat) (x : Original.Carrier) :
  Id Md.M (Original.value (S.L.power n x)) (T.L.power n (Original.value x)) =
  trans (sym (Original.inclusion-at (S.L.power n x)))
   (trans (I.Map.power-map n x) (ap (T.L.power n) (Original.inclusion-at x))) ;
 fraction-injective (x y : Original.Carrier) (p r : Nat)
  (e : Id Target.Carrier (forward (S.L.fraction x p)) (forward (S.L.fraction y r))) :
  Id S.L.Carrier (S.L.fraction x p) (S.L.fraction y r) =
  Tr.Trunc[T.L.Witness (Original.value x,p) (Original.value y,r)].induction @l
   (\ t -> Id S.L.Carrier (S.L.fraction x p) (S.L.fraction y r)) (\ t -> S.L.carrier-set _ _)
   (\ t -> S.L.equal x y p r (Tr.Trunc[S.L.Witness (x,p) (y,r)].inc
    (t.1,Original.ext _ _
     (trans (power-value (plus t.1 r) x) (trans t.2 (sym (power-value (plus t.1 p) y)))))))
   (T.L.detect (Original.value x) (Original.value y) p r
    (trans (sym (forward-fraction x p))
     (trans (ap Target.value e) (forward-fraction y r)))) ;
 injective (x : S.L.Carrier) : (y : S.L.Carrier) -> Id Target.Carrier (forward x) (forward y) -> Id S.L.Carrier x y =
  S.L.induction @l
   (\ x -> (y : S.L.Carrier) -> Id Target.Carrier (forward x) (forward y) -> Id S.L.Carrier x y)
   (\ x -> FE.isProp-Pi S.L.Carrier (\ y -> Id Target.Carrier (forward x) (forward y) -> Id S.L.Carrier x y)
    (\ y -> FE.isProp-Pi (Id Target.Carrier (forward x) (forward y)) (\ e -> Id S.L.Carrier x y) (\ e -> S.L.carrier-set _ _)))
   (\ a p -> S.L.induction @l
    (\ y -> Id Target.Carrier (forward (S.L.fraction a p)) (forward y) -> Id S.L.Carrier (S.L.fraction a p) y)
    (\ y -> FE.isProp-Pi (Id Target.Carrier (forward (S.L.fraction a p)) (forward y))
     (\ e -> Id S.L.Carrier (S.L.fraction a p) y) (\ e -> S.L.carrier-set _ _))
    (\ b r -> fraction-injective a b p r)) x ;
 clear-denominator (x : Nd.M) (p : Nat) :
  Id N.L.Carrier (NA.scale (P.power f p) (N.L.fraction x p)) (N.L.fraction x zero) =
  trans (NA.scale-at (P.power f p) x p)
   (trans (ap (\ y -> N.L.fraction y p) (sym (N.L.power-scalar p x)))
    (trans (ap (N.L.fraction (N.L.power p x)) (sym (plus-zero p))) (N.L.raise x zero p))) ;
 numerator-zero (x : Nd.M) (p : Nat) (e : Id N.L.Carrier (N.L.fraction x p) NA.mz) :
  Id N.L.Carrier (N.L.fraction x zero) NA.mz =
  trans (sym (clear-denominator x p)) (trans (ap (NA.scale (P.power f p)) e) (NA.scale-zero (P.power f p))) ;
 Fibre (y : Target.Carrier) : U l = (x : S.L.Carrier) * Id Target.Carrier (forward x) y ;
 fibre-prop (y : Target.Carrier) : Pr.isProp (Fibre y) = \ x z ->
  Pr.Sigma-eq S.L.Carrier (\ x -> Id Target.Carrier (forward x) y) x.1 z.1 x.2 z.2
   (injective x.1 z.1 (trans x.2 (sym z.2))) (Target.set _ _) ;
 module Representative (y : Target.Carrier) (x : Md.M) (p : Nat)
  (e : Id T.L.Carrier (T.L.fraction x p) (Target.value y)) {
  image-zero : Id N.L.Carrier (N.L.fraction (Original.Q.map q x) p) NA.mz =
   trans (sym (Q.induced-at x p)) (trans (ap (Q.Maps.map Q.induced) e) (Target.member y)) ;
  killers : Tr.Trunc[N.L.Killed (Original.Q.map q x)].carrier =
   N.L.zero-killed (Original.Q.map q x) (numerator-zero (Original.Q.map q x) p image-zero) ;
  module Killed (w : N.L.Killed (Original.Q.map q x)) {
   numerator : Original.Carrier = (T.L.power w.1 x,trans (Q.Map.power-map w.1 x) w.2) ;
   source : S.L.Carrier = S.L.fraction numerator (plus w.1 p) ;
   equation : Id Target.Carrier (forward source) y =
    Target.ext (forward source) y
     (trans (forward-fraction numerator (plus w.1 p)) (trans (T.L.raise x p w.1) e)) ;
  } ;
  preimage : Tr.Trunc[Fibre y].carrier = Tr.Trunc[N.L.Killed (Original.Q.map q x)].induction @l
   (\ t -> Tr.Trunc[Fibre y].carrier) (\ t -> Tr.Trunc[Fibre y].proposition)
   (\ w -> Tr.Trunc[Fibre y].inc (Killed[w].source,Killed[w].equation)) killers ;
 } ;
 inhabited (y : Target.Carrier) : Tr.Trunc[Fibre y].carrier =
  Tr.Trunc[(x : Md.M) * (p : Nat) * Id T.L.Carrier (T.L.fraction x p) (Target.value y)].induction @l
   (\ t -> Tr.Trunc[Fibre y].carrier) (\ t -> Tr.Trunc[Fibre y].proposition)
   (\ r -> Representative[y,r.1,r.2.1,r.2.2].preimage) (T.L.represented (Target.value y)) ;
 preimage (y : Target.Carrier) : Fibre y = Tr.Trunc[Fibre y].induction @l
  (\ t -> Fibre y) (\ t -> fibre-prop y) (\ t -> t) (inhabited y) ;
 inverse (y : Target.Carrier) : S.L.Carrier = (preimage y).1 ;
 forward-inverse (y : Target.Carrier) : Id Target.Carrier (forward (inverse y)) y = (preimage y).2 ;
 inverse-forward (x : S.L.Carrier) : Id S.L.Carrier (inverse (forward x)) x =
  injective _ _ (forward-inverse (forward x)) ;
 equivalence : Pr.Equiv S.L.Carrier Target.Carrier =
  (forward,Pr.qinv S.L.Carrier Target.Carrier forward inverse forward-inverse inverse-forward) ;
 module Maps = MM.Between[A,A,RingHom[l].identity A,S.localised,Target.kernel] ;
 comparison : Maps.Hom = new Maps.Hom[forward,
  \ x y -> Target.ext _ _ (I.Maps.map-add I.induced x y),
  \ a x -> Target.ext _ _ (I.Maps.map-scale I.induced a x)] ;
 comparison-at (x : S.L.Carrier) : Id Target.Carrier (Maps.map comparison x) (forward x) = refl (forward x) ;
 opaque forward ; opaque inverse ; opaque comparison ;
} ;
