-- Yoneda on all small commutative test rings, for an arbitrary set functor.
-- Evaluation sends alpha : h_A -> F to alpha_A(1).  Its inverse sends
-- x in F(A) to h |-> F(h)(x), natural by F's composition law.
-- Evaluation after extension is F(1)(x)=x.  Conversely naturality at
-- h : A -> B gives F(h)(alpha_A(1)) = alpha_B(h . 1) = alpha_B(h),
-- using extensionality of ring maps for h . 1 = h.  Transformation
-- extensionality gives the other inverse law.  Nat lives in U (l+1),
-- although F(A) is small; the equivalence is stated at that larger level.
level l ; open Ring[l] ;
module Hi = Prelude[l+] ;
module RH = RingHom[l] ;
module RM = RingMaps[l] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module Over (A : T.Test) (F : SF.SetFunctor) {
 module H = SF.Representable[A] ;
 module N = SF.Transform[H.functor,F] ;
 eval (alpha : N.Nat) : F.obj A = N.at alpha A (RH.identity A.ring) ;
 extend (x : F.obj A) : N.Nat = (\ B h -> F.reindex A B h x,\ B C h f -> F.composition A B C f h x) ;
 extend-at (x : F.obj A) (B : T.Test) (h : RH.Hom A.ring B.ring) : Id (F.obj B) (N.at (extend x) B h) (F.reindex A B h x) =
  refl (F.reindex A B h x) ;
 eval-extend (x : F.obj A) : Id (F.obj A) (eval (extend x)) x = F.identity A x ;
 right-unit (B : T.Test) (h : RH.Hom A.ring B.ring) : Id (RH.Hom A.ring B.ring) (RH.compose A.ring A.ring B.ring h (RH.identity A.ring)) h =
  RH.Properties[A.ring,B.ring,B.carrier-set].ext (RH.compose A.ring A.ring B.ring h (RH.identity A.ring)) h (\ a -> refl (RM.map h a)) ;
 extend-eval (alpha : N.Nat) : Id N.Nat (extend (eval alpha)) alpha =
  N.ext (extend (eval alpha)) alpha (\ B h -> trans (sym (N.natural alpha A B h (RH.identity A.ring))) (ap (N.at alpha B) (right-unit B h))) ;
 equivalence : Hi.Equiv N.Nat (F.obj A) = (eval,Hi.qinv N.Nat (F.obj A) eval extend eval-extend extend-eval) ;
} ;
module Representables (A B : T.Test) {
 module Y = Over[A,SF.Representable[B].functor] ;
 equivalence : Hi.Equiv (SF.Transform[SF.Representable[A].functor,SF.Representable[B].functor].Nat) (RH.Hom B.ring A.ring) = Y.equivalence ;
} ;
