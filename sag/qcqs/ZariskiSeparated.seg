-- The Zariski lattice functor is separated on finite basic covers.
-- For beta : B -> B[1/g], SpecBasicOpen factors Spec beta through X|D(g)
-- by an isomorphism j.  Thus equality of beta_*(u) and beta_*(v) gives
-- equality of cut(u),cut(v), by injectivity of j's lattice map; their
-- underlying opens are u /\ D(g),v /\ D(g).  The relation between the
-- factorisation and beta_* is its factor-cut equation followed by
-- AffineTests.underlying-map and ZariskiFunctor.spec-lattice.
-- On a cover D(a_i), equality after every beta_i therefore gives equality
-- after meeting with every D(a_i).  LatticeCover.ext proves u=v.  This is
-- purely point-free, and includes the empty cover.
level l ; open Ring[l] ; open Presentations[l] ;
module DL = DistLattice[l] ;
module T = AffineTests[l] ;
module Sp = Spaces[l] ;
module ZF = ZariskiFunctor[l] ;
module TS = TestSheaves[l] ;
module OnRing (B : T.Test) (g : B.ring.R) {
 module AB = T.At[B].A ;
 module Z = T.At[B].Z ;
 module SB = SpecBasicOpen[l].Over[B.ring,B.carrier-set,g] ;
 local-test : T.Test = new T.Test[AB.Loc g,AB.set g] ;
 module TM = T.Map[B,local-test,AB.inclusion g] ;
 module ZM = ZF.OnMap[B,local-test,AB.inclusion g] ;
 module JI = Iso[l].Maps[SB.Sl.lattice,SB.ZG.lattice,SB.Sl.sheaf,SB.SG.spec.sheaf] ;
 cut-image (u : Z.lattice.L) : Id SB.ZG.lattice.L
  (DL.hmap SB.JB.factor.lat (SB.Sl.cut u)) (ZF.functor.reindex B local-test (AB.inclusion g) u) =
  trans (ap (\ p -> DL.hmap p.lat u) SB.JB.factor-cut)
   (trans (sym (ap (\ p -> DL.hmap p.lat u) TM.underlying-map)) (ZM.spec-lattice u)) ;
 intersection (u v : Z.lattice.L) (e : Id SB.ZG.lattice.L
  (ZF.functor.reindex B local-test (AB.inclusion g) u) (ZF.functor.reindex B local-test (AB.inclusion g) v)) :
  Id Z.lattice.L (Z.lattice.meet u (Z.D g)) (Z.lattice.meet v (Z.D g)) =
  ap SB.Sl.inc (Iso[l].injective SB.Sl.Opens SB.ZG.lattice.L (DL.hmap SB.JB.factor.lat) (JI.lat-equiv {SB.JB.factor} SB.j-iso)
   (SB.Sl.cut u) (SB.Sl.cut v) (trans (cut-image u) (trans e (sym (cut-image v))))) ;
} ;
module Over (c : TS.CoverData) {
 module D = TS.OnCover[ZF.functor,c].D ;
 module Z = T.At[TS.base c].Z ;
 cover-le : Z.O.Le Z.lattice.top (Z.J.bigJ (TS.count c) (\ i -> Z.D (TS.generators c i))) =
  Z.O.le-of-eq Z.lattice.top (Z.J.bigJ (TS.count c) (\ i -> Z.D (TS.generators c i))) (sym (TS.covers c)) ;
 module LC = LatticeCover[l].Over[Z.lattice,TS.count c,\ i -> Z.D (TS.generators c i),cover-le] ;
 separated (u v : Z.lattice.L) (e : (i : Fin (TS.count c)) -> Id (ZF.functor.obj (D.basic i))
  (ZF.functor.reindex (TS.base c) (D.basic i) (D.AB.inclusion (TS.generators c i)) u)
  (ZF.functor.reindex (TS.base c) (D.basic i) (D.AB.inclusion (TS.generators c i)) v)) : Id Z.lattice.L u v =
  LC.ext u v (\ i -> OnRing[TS.base c,TS.generators c i].intersection u v (e i)) ;
} ;
