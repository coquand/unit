-- The projective line over a nonzero ring is not affine (DESIGN.md, Next 5,
-- step 5), by the argument of DoubledLineNotAffine.  Let Gamma be its ring
-- of global sections and pi : L_Gamma -> L_P1 the lattice map of the
-- canonical map (SpecMap at the identity of Gamma), with pi(D r) = D_top(r).
-- An open (u, v) of P^1 is diagonal when u = v.
--
-- (1) A global section r = (s, t) has s = t (ProjectiveLineGlobal: both are
--     the same constant).
-- (2) So D_top(r) = (D_top(s), D_top(t)) (GlueAlong: componentwise) is
--     diagonal.
-- (3) pi(D r) = D_top(r) is diagonal; every y in L_Gamma is merely a finite
--     join of generators D(r_i), pi preserves finite joins, and diagonal opens
--     are closed under them (LatticePullback.join-first/join-second).
--     So every pi y is diagonal.
-- (4) If the canonical map is an isomorphism, the chart e1 = (top, D(X)) is
--     some pi y, hence diagonal: top = D(X), so D 1 <= D(X), and 1 = 0 in k
--     (VariableKernel.one-zero).
-- No k-point is constructed, and the Zariski lattice of Gamma is never
-- identified with that of k.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) {
 module PG = ProjectiveLineGlobal[l].Over[k,setk] ;
 module GT = PG.GT ;
 module GA = PG.GA ;
 module PB = PG.PB ;
 module SB = PG.SB ;
 module VK = VariableKernel[l].Over[k,setk] ;
 module O = DL.Order[SB.ZA.lattice] ;
 module J = DL.Joins[SB.ZA.lattice] ;
 module AC = AffineCriterion[l].Over[PB.lattice,GT.glued] ;
 module SM = AC.Can.Of[RH.identity (GT.glued.sheaf.ring PB.lattice.top)].SM ;
 module ZG = AC.ZG ;
 module RG = Radical[l].Over[GT.glued.sheaf.ring PB.lattice.top] ;

 -- diagonal opens
 Diag (x : PB.Opens) : U l = Id SB.ZA.lattice.L (PB.first x) (PB.second x) ;
 diag-prop (x : PB.Opens) : Pr.isProp (Diag x) = SB.ZA.lattice.setL (PB.first x) (PB.second x) ;
 diag-joins (n : Nat) (xs : Fin n -> PB.Opens) (h : (i : Fin n) -> Diag (xs i)) : Diag (PB.JP.bigJ n xs) = calc SB.ZA.lattice.L {
  PB.first (PB.JP.bigJ n xs) =< PB.join-first n xs > J.bigJ n (\ i -> PB.first (xs i))
   =< ap (J.bigJ n) (F.funext (Fin n) (\ i -> SB.ZA.lattice.L) (\ i -> PB.first (xs i)) (\ i -> PB.second (xs i)) h)
    > J.bigJ n (\ i -> PB.second (xs i))
   =< sym (PB.join-second n xs) > PB.second (PB.JP.bigJ n xs) } ;

 -- (2) the invertibility open of a global section is diagonal
 d-diagonal (r : (GT.glued.sheaf.ring PB.lattice.top).R) : Diag (SM.d r) = calc SB.ZA.lattice.L {
  PB.first (SM.d r) =< GA.d-first PB.lattice.top r > GA.LX1.d (PB.first PB.lattice.top) (GA.left PB.lattice.top r)
   =< ap (GA.LX1.d (PB.first PB.lattice.top)) (PG.Back[r].equal-components)
    > GA.LX2.d (PB.second PB.lattice.top) (GA.right PB.lattice.top r)
   =< sym (GA.d-second PB.lattice.top r) > PB.second (SM.d r) } ;
 -- (3) every open in the image of pi is diagonal
 image-D (r : (GT.glued.sheaf.ring PB.lattice.top).R) : Diag (DL.hmap SM.pi (ZG.D r)) =
  Pr.subst PB.Opens Diag (SM.d r) (DL.hmap SM.pi (ZG.D r)) (sym (SM.pi-D r)) (d-diagonal r) ;
 module Image (y : ZG.lattice.L) {
  module At (q : ZG.Presentation y) {
   gens (i : Fin (RG.size (ZG.generators q))) : PB.Opens = DL.hmap SM.pi (ZG.D (RG.gen (ZG.generators q) i)) ;
   joins : Id PB.Opens (DL.hmap SM.pi y) (PB.JP.bigJ (RG.size (ZG.generators q)) gens) =
    trans (ap (DL.hmap SM.pi) (ZG.presents q))
     (SM.PM.preserves (RG.size (ZG.generators q)) (\ i -> ZG.D (RG.gen (ZG.generators q) i))) ;
   diagonal : Diag (DL.hmap SM.pi y) =
    Pr.subst PB.Opens Diag (PB.JP.bigJ (RG.size (ZG.generators q)) gens) (DL.hmap SM.pi y) (sym joins)
     (diag-joins (RG.size (ZG.generators q)) gens (\ i -> image-D (RG.gen (ZG.generators q) i))) ;
  } ;
  diagonal : Diag (DL.hmap SM.pi y) =
   Tr.Trunc[ZG.Presentation y].induction @l (\ c -> Diag (DL.hmap SM.pi y)) (\ c -> diag-prop (DL.hmap SM.pi y))
    (\ q -> At[q].diagonal) (ZG.presented y) ;
 } ;

 -- (4) if P^1 is affine, then 1 = 0 in k
 module IfAffine (aff : AC.IsAffine) {
  lat-equiv : Pr.isEquiv ZG.lattice.L PB.lattice.L (DL.hmap AC.canonical.lat) = AC.I.lat-equiv {AC.canonical} aff ;
  -- e1 is in the image, hence diagonal: top = D(X)
  s1 : Diag (DL.hmap SM.pi (lat-equiv.sec GT.e1)) = Image[lat-equiv.sec GT.e1].diagonal ;
  s2 : Id PB.Opens (DL.hmap SM.pi (lat-equiv.sec GT.e1)) GT.e1 = lat-equiv.sec-eq GT.e1 ;
  e-diagonal : Diag GT.e1 = Pr.subst PB.Opens Diag (DL.hmap SM.pi (lat-equiv.sec GT.e1)) GT.e1 s2 s1 ;
  one-le : O.Le (SB.ZA.D SB.A.o) (SB.ZA.D PG.P.variable) =
   O.le-of-eq (SB.ZA.D SB.A.o) (SB.ZA.D PG.P.variable) (trans (sym SB.Gb.top-D) e-diagonal) ;
  one-zero : Id k.R k.o k.z = VK.one-zero one-le ;
 } ;
 -- over a nonzero ring the projective line is not affine
 not-affine (nonzero : Id k.R k.o k.z -> Empty) (aff : AC.IsAffine) : Empty = nonzero IfAffine[aff].one-zero ;
} ;
