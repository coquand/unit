-- Restriction to a compact open preserves module-sheaf maps/equivalences.
-- Use the original component at the included open. Its linearity and
-- naturality are unchanged, and pointwise inverse data restrict as well.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module DL = DistLattice[l] ; module MS = SerreModuleSheaf[l] ;
module Over (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged) (e : L.L)
 (E N : MS.On[L,X.sheaf].ModuleSheaf) {
 module S = Slice[l].Over[L,X,e] ;
 module Source = SerreModuleSheafRestriction[l].On[L,X,e,E] ;
 module Target = SerreModuleSheafRestriction[l].On[L,X,e,N] ;
 module Original = MS.On[L,X.sheaf].Transform[E.presheaf,N.presheaf] ;
 module Maps = MS.On[S.lattice,S.sheaf].Transform[Source.presheaf,Target.presheaf] ;
 module Of (q : Original.Hom) {
  induced : Maps.Hom = new Maps.Hom[\ a -> q.component (S.inc a),
   \ a b k x -> q.natural (S.inc a) (S.inc b) (S.le-inc a b k) x] ;
  induced-at (a : S.Opens) (x : (E.presheaf.module-at (S.inc a)).M) :
   Id (N.presheaf.module-at (S.inc a)).M (Maps.at induced a x) (Original.at q (S.inc a) x) = refl (Original.at q (S.inc a) x) ;
  opaque induced ;
 } ;
 module Equivalence (eq : SerreModuleSheafIso[l].On[L,X.sheaf].Equivalence E.presheaf N.presheaf) {
  module OriginalIso = SerreModuleSheafIso[l].On[L,X.sheaf] ;
  module Map = Of[OriginalIso.forward eq] ;
  equivalence : SerreModuleSheafIso[l].On[S.lattice,S.sheaf].Equivalence Source.presheaf Target.presheaf =
   (Map.induced,\ a -> Iso[l].equiv-homotopy
    (E.presheaf.module-at (S.inc a)).M (N.presheaf.module-at (S.inc a)).M
    (Original.at (OriginalIso.forward eq) (S.inc a)) (Maps.at Map.induced a)
    (\ x -> sym (Map.induced-at a x)) (OriginalIso.equiv-at eq (S.inc a))) ;
 } ;
} ;
