-- Extending scalar multiplication to localised scalar fractions.
-- For a module N on which f acts invertibly, the linear map
-- a |-> a*x from A extends uniquely to the localisation of A as a
-- module.  Evaluation gives the scalar action a/f^p * x = f^-p(a*x).
-- The extension is additive in each variable. Commuting inverse powers
-- with scalars proves the product-of-fractions action equation.
-- The comparison with the existing localised ring transports these
-- equations to its carrier; no new ring of fractions is constructed.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module SM = SerreModule[l] ;
module MM = SerreModuleMaps[l] ; module RH = RingHom[l] ;
module LC = SerreModuleLocalisation[l] ; module LS = SerreModuleLocalisationStructure[l] ;
module LU = SerreModuleLocalisationUniversal[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (Nd : SM.Over[A].Module)
 (f : A.R) (invertible : Pr.isEquiv Nd.M Nd.M (Nd.sm f)) {
 module Native = SM.Over[A] ;
 module S = LC.At[A,Native.regular setA,f] ;
 module Scalar = LS.At[A,Native.regular setA,f] ;
 module Inverse = LU.Inverse[A,Nd,f,invertible] ;
 module H = MM.Between[A,A,RH.identity A,Native.regular setA,Nd] ;
 module At (x : Nd.M) {
  multiples : H.Hom = new H.Hom[
   \ a -> Nd.sm a x,\ a b -> Nd.smE a b x,\ a b -> sym (Nd.smA a b x)] ;
  multiples-at (a : A.R) : Id Nd.M (H.map multiples a) (Nd.sm a x) = refl (Nd.sm a x) ;
  module Extend = LU.Extend[A,Native.regular setA,Nd,f,multiples,invertible] ;
  opaque multiples ;
 } ;
 action (r : S.Carrier) (x : Nd.M) : Nd.M = At[x].Extend.lift-map r ;
 fraction-action (a : A.R) (p : Nat) (x : Nd.M) :
  Id Nd.M (action (S.fraction a p) x) (Inverse.back p (Nd.sm a x)) =
  trans (At[x].Extend.lift-at a p) (ap (Inverse.back p) (At[x].multiples-at a)) ;
 original-action (a : A.R) (x : Nd.M) : Id Nd.M (action (S.fraction a zero) x) (Nd.sm a x) =
  trans (fraction-action a zero x) (Inverse.back-zero (Nd.sm a x)) ;
 add-scalars (r s : S.Carrier) (x : Nd.M) :
  Id Nd.M (action (Scalar.add r s) x) (Nd.madd (action r x) (action s x)) = At[x].Extend.lift-add r s ;
 add-vectors (r : S.Carrier) (x y : Nd.M) :
  Id Nd.M (action r (Nd.madd x y)) (Nd.madd (action r x) (action r y)) =
  S.induction @l (\ r -> Id Nd.M (action r (Nd.madd x y)) (Nd.madd (action r x) (action r y))) (\ r -> Nd.setM _ _)
   (\ a p -> trans (fraction-action a p (Nd.madd x y))
    (trans (ap (Inverse.back p) (Nd.smD a x y))
     (trans (Inverse.back-add p (Nd.sm a x) (Nd.sm a y))
      (cong2 Nd.M Nd.madd _ _ _ _ (sym (fraction-action a p x)) (sym (fraction-action a p y)))))) r ;
 one-action (x : Nd.M) : Id Nd.M (action (S.fraction A.o zero) x) x =
  trans (original-action A.o x) (Nd.smO x) ;
 fraction-compose (a b : A.R) (p q : Nat) (x : Nd.M) :
  Id Nd.M (action (S.fraction a p) (action (S.fraction b q) x)) (action (S.fraction (A.mul a b) (plus p q)) x) =
  trans (fraction-action a p (action (S.fraction b q) x))
   (trans (ap (\ y -> Inverse.back p (Nd.sm a y)) (fraction-action b q x))
    (trans (ap (Inverse.back p) (sym (Inverse.back-scale q a (Nd.sm b x))))
     (trans (Inverse.back-compose p q (Nd.sm a (Nd.sm b x)))
      (trans (ap (Inverse.back (plus p q)) (Nd.smA a b x)) (sym (fraction-action (A.mul a b) (plus p q) x)))))) ;
 opaque action ;
} ;
