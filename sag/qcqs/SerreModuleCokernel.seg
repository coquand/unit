-- Cokernels of module maps (Serre note, Section 3, finite exactness).
-- Use the existing small quotient by y=x+d(b). Addition, negation and
-- scalar action preserve this relation, and descend to the same quotient.
-- Their equations on classes imply all module laws by quotient induction.
-- A linear map killing d descends uniquely; equality of classes detects
-- exactly membership in the image, as proved by the effective quotient.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module Over (A : CRing) (B C : SM.Over[A].Module)
 (d : MM.Between[A,A,RingHom[l].identity A,B,C].Hom) {
 module CQ = SerreCechQuotient[l].Over[A,B,C,d] ;
 module D = MM.Between[A,A,RingHom[l].identity A,B,C] ;
 module ML = SM.Over[A].Laws[C] ;
 module Group = SerreCechAlgebra[l].Over[A,C] ;
 add-witness (x y z : C.M) (w : CQ.Witness x y) : CQ.Witness (C.madd x z) (C.madd y z) =
  (w.1,trans (ap (\ t -> C.madd t z) w.2)
   (trans (sym (C.maddA x (D.map d w.1) z))
    (trans (ap (C.madd x) (C.maddC (D.map d w.1) z)) (C.maddA x z (D.map d w.1))))) ;
 add-first (x y z : C.M) (r : CQ.Related x y) :
  Id CQ.Class (CQ.class (C.madd x z)) (CQ.class (C.madd y z)) =
  Tr.Trunc[CQ.Witness x y].induction @l
   (\ t -> Id CQ.Class (CQ.class (C.madd x z)) (CQ.class (C.madd y z))) (\ t -> CQ.set _ _)
   (\ w -> CQ.class-equal (C.madd x z) (C.madd y z)
    (Tr.Trunc[CQ.Witness (C.madd x z) (C.madd y z)].inc (add-witness x y z w))) r ;
 add-second (x y z : C.M) (r : CQ.Related y z) :
  Id CQ.Class (CQ.class (C.madd x y)) (CQ.class (C.madd x z)) =
  trans (ap CQ.class (C.maddC x y))
   (trans (add-first y z x r) (ap CQ.class (C.maddC z x))) ;
 module Left (y : C.M) {
  module Desc = CQ.Q.Descend[CQ.Class,CQ.set,\ x -> CQ.class (C.madd x y),\ x z r -> add-first x z y r] ;
 } ;
 left-respect (y z : C.M) (r : CQ.Related y z) (x : CQ.Class) :
  Id CQ.Class (Left[y].Desc.map x) (Left[z].Desc.map x) =
  CQ.Q.induction @l (\ x -> Id CQ.Class (Left[y].Desc.map x) (Left[z].Desc.map x)) (\ x -> CQ.set _ _)
   (\ x -> trans (Left[y].Desc.beta x) (trans (add-second x y z r) (sym (Left[z].Desc.beta x)))) x ;
 module Add = CQ.Q.Descend[CQ.Class -> CQ.Class,
  FE.isSet-Pi CQ.Class (\ x -> CQ.Class) (\ x -> CQ.set),\ y -> Left[y].Desc.map,
  \ y z r -> FE.funext CQ.Class (\ x -> CQ.Class) _ _ (left-respect y z r)] ;
 add (x y : CQ.Class) : CQ.Class = Add.map y x ;
 add-class (x y : C.M) : Id CQ.Class (add (CQ.class x) (CQ.class y)) (CQ.class (C.madd x y)) =
  trans (ap (\ f -> f (CQ.class x)) (Add.beta y)) (Left[y].Desc.beta x) ;
 neg-witness (x y : C.M) (w : CQ.Witness x y) : CQ.Witness (C.mneg x) (C.mneg y) =
  (B.mneg w.1,trans (ap C.mneg w.2)
   (trans (Group.neg-add x (D.map d w.1)) (ap (C.madd (C.mneg x)) (sym (D.map-neg d w.1))))) ;
 neg-respect (x y : C.M) (r : CQ.Related x y) : Id CQ.Class (CQ.class (C.mneg x)) (CQ.class (C.mneg y)) =
  Tr.Trunc[CQ.Witness x y].induction @l
   (\ t -> Id CQ.Class (CQ.class (C.mneg x)) (CQ.class (C.mneg y))) (\ t -> CQ.set _ _)
   (\ w -> CQ.class-equal (C.mneg x) (C.mneg y)
    (Tr.Trunc[CQ.Witness (C.mneg x) (C.mneg y)].inc (neg-witness x y w))) r ;
 module Neg = CQ.Q.Descend[CQ.Class,CQ.set,\ x -> CQ.class (C.mneg x),neg-respect] ;
 negative (x : CQ.Class) : CQ.Class = Neg.map x ;
 negative-class (x : C.M) : Id CQ.Class (negative (CQ.class x)) (CQ.class (C.mneg x)) = Neg.beta x ;
 scale-witness (a : A.R) (x y : C.M) (w : CQ.Witness x y) : CQ.Witness (C.sm a x) (C.sm a y) =
  (B.sm a w.1,trans (ap (C.sm a) w.2)
   (trans (C.smD a x (D.map d w.1)) (ap (C.madd (C.sm a x)) (sym (D.map-scale d a w.1))))) ;
 scale-respect (a : A.R) (x y : C.M) (r : CQ.Related x y) : Id CQ.Class (CQ.class (C.sm a x)) (CQ.class (C.sm a y)) =
  Tr.Trunc[CQ.Witness x y].induction @l
   (\ t -> Id CQ.Class (CQ.class (C.sm a x)) (CQ.class (C.sm a y))) (\ t -> CQ.set _ _)
   (\ w -> CQ.class-equal (C.sm a x) (C.sm a y)
    (Tr.Trunc[CQ.Witness (C.sm a x) (C.sm a y)].inc (scale-witness a x y w))) r ;
 module Scalar (a : A.R) { module Desc = CQ.Q.Descend[CQ.Class,CQ.set,\ x -> CQ.class (C.sm a x),scale-respect a] ; } ;
 scale (a : A.R) (x : CQ.Class) : CQ.Class = Scalar[a].Desc.map x ;
 scale-class (a : A.R) (x : C.M) : Id CQ.Class (scale a (CQ.class x)) (CQ.class (C.sm a x)) = Scalar[a].Desc.beta x ;
 induction (P : CQ.Class -> U l) (prop : (x : CQ.Class) -> Pr.isProp (P x))
  (step : (x : C.M) -> P (CQ.class x)) : (x : CQ.Class) -> P x = CQ.Q.induction @l P prop step ;
 pair-induction (P : CQ.Class -> CQ.Class -> U l) (prop : (x y : CQ.Class) -> Pr.isProp (P x y))
  (step : (x y : C.M) -> P (CQ.class x) (CQ.class y)) (x y : CQ.Class) : P x y =
  induction (\ x -> P x y) (\ x -> prop x y)
   (\ a -> induction (P (CQ.class a)) (prop (CQ.class a)) (step a) y) x ;
 triple-induction (P : CQ.Class -> CQ.Class -> CQ.Class -> U l)
  (prop : (x y z : CQ.Class) -> Pr.isProp (P x y z))
  (step : (x y z : C.M) -> P (CQ.class x) (CQ.class y) (CQ.class z)) (x y z : CQ.Class) : P x y z =
  pair-induction (\ x y -> P x y z) (\ x y -> prop x y z)
   (\ a b -> induction (P (CQ.class a) (CQ.class b)) (prop (CQ.class a) (CQ.class b)) (step a b) z) x y ;
 add-assoc (x y z : CQ.Class) : Id CQ.Class (add x (add y z)) (add (add x y) z) =
  triple-induction (\ x y z -> Id CQ.Class (add x (add y z)) (add (add x y) z)) (\ x y z -> CQ.set _ _)
   (\ x y z -> trans (ap (add (CQ.class x)) (add-class y z))
    (trans (add-class x (C.madd y z))
     (trans (ap CQ.class (C.maddA x y z))
      (trans (sym (add-class (C.madd x y) z)) (ap (\ w -> add w (CQ.class z)) (sym (add-class x y))))))) x y z ;
 add-comm (x y : CQ.Class) : Id CQ.Class (add x y) (add y x) =
  pair-induction (\ x y -> Id CQ.Class (add x y) (add y x)) (\ x y -> CQ.set _ _)
   (\ x y -> trans (add-class x y) (trans (ap CQ.class (C.maddC x y)) (sym (add-class y x)))) x y ;
 add-zero (x : CQ.Class) : Id CQ.Class (add x CQ.zero) x =
  induction (\ x -> Id CQ.Class (add x CQ.zero) x) (\ x -> CQ.set _ _)
   (\ x -> trans (add-class x C.mz) (ap CQ.class (C.maddZ x))) x ;
 add-negative (x : CQ.Class) : Id CQ.Class (add x (negative x)) CQ.zero =
  induction (\ x -> Id CQ.Class (add x (negative x)) CQ.zero) (\ x -> CQ.set _ _)
   (\ x -> trans (ap (add (CQ.class x)) (negative-class x))
    (trans (add-class x (C.mneg x)) (ap CQ.class (C.maddN x)))) x ;
 scale-assoc (a b : A.R) (x : CQ.Class) : Id CQ.Class (scale a (scale b x)) (scale (A.mul a b) x) =
  induction (\ x -> Id CQ.Class (scale a (scale b x)) (scale (A.mul a b) x)) (\ x -> CQ.set _ _)
   (\ x -> trans (ap (scale a) (scale-class b x))
    (trans (scale-class a (C.sm b x)) (trans (ap CQ.class (C.smA a b x)) (sym (scale-class (A.mul a b) x))))) x ;
 scale-one (x : CQ.Class) : Id CQ.Class (scale A.o x) x =
  induction (\ x -> Id CQ.Class (scale A.o x) x) (\ x -> CQ.set _ _)
   (\ x -> trans (scale-class A.o x) (ap CQ.class (C.smO x))) x ;
 scale-add (a : A.R) (x y : CQ.Class) : Id CQ.Class (scale a (add x y)) (add (scale a x) (scale a y)) =
  pair-induction (\ x y -> Id CQ.Class (scale a (add x y)) (add (scale a x) (scale a y))) (\ x y -> CQ.set _ _)
   (\ x y -> trans (ap (scale a) (add-class x y))
    (trans (scale-class a (C.madd x y))
     (trans (ap CQ.class (C.smD a x y))
      (trans (sym (add-class (C.sm a x) (C.sm a y)))
       (cong2 CQ.Class add _ _ _ _ (sym (scale-class a x)) (sym (scale-class a y))))))) x y ;
 add-scale (a b : A.R) (x : CQ.Class) : Id CQ.Class (scale (A.add a b) x) (add (scale a x) (scale b x)) =
  induction (\ x -> Id CQ.Class (scale (A.add a b) x) (add (scale a x) (scale b x))) (\ x -> CQ.set _ _)
   (\ x -> trans (scale-class (A.add a b) x)
    (trans (ap CQ.class (C.smE a b x))
     (trans (sym (add-class (C.sm a x) (C.sm b x)))
      (cong2 CQ.Class add _ _ _ _ (sym (scale-class a x)) (sym (scale-class b x)))))) x ;
 cokernel : SM.Over[A].Module = new SM.Over[A].Module[
  CQ.Class,CQ.set,CQ.zero,add,negative,add-assoc,add-comm,add-zero,add-negative,
  scale,scale-assoc,scale-one,scale-add,add-scale] ;
 module Projection = MM.Between[A,A,RingHom[l].identity A,C,cokernel] ;
 projection : Projection.Hom = new Projection.Hom[CQ.class,\ x y -> sym (add-class x y),\ a x -> sym (scale-class a x)] ;
 projection-at (x : C.M) : Id CQ.Class (Projection.map projection x) (CQ.class x) = refl (CQ.class x) ;
 killed (b : B.M) : Id CQ.Class (CQ.class (D.map d b)) CQ.zero =
  CQ.image-zero (D.map d b) (Tr.Trunc[(w : B.M) * Id C.M (D.map d b) (D.map d w)].inc (b,refl (D.map d b))) ;
 module Factor (Pd : SM.Over[A].Module)
  (u : MM.Between[A,A,RingHom[l].identity A,C,Pd].Hom)
  (kills : (b : B.M) -> Id Pd.M (MM.Between[A,A,RingHom[l].identity A,C,Pd].map u (D.map d b)) Pd.mz) {
  module H = MM.Between[A,A,RingHom[l].identity A,C,Pd] ;
  module Maps = MM.Between[A,A,RingHom[l].identity A,cokernel,Pd] ;
  respect-witness (x y : C.M) (w : CQ.Witness x y) : Id Pd.M (H.map u x) (H.map u y) =
   sym (trans (ap (H.map u) w.2)
    (trans (H.map-add u x (D.map d w.1)) (trans (ap (Pd.madd (H.map u x)) (kills w.1)) (Pd.maddZ (H.map u x))))) ;
  respects (x y : C.M) (r : CQ.Related x y) : Id Pd.M (H.map u x) (H.map u y) =
   Tr.Trunc[CQ.Witness x y].induction @l (\ t -> Id Pd.M (H.map u x) (H.map u y))
    (\ t -> Pd.setM _ _) (respect-witness x y) r ;
  module Desc = CQ.Q.Descend[Pd.M,Pd.setM,H.map u,respects] ;
  additive (x y : CQ.Class) : Id Pd.M (Desc.map (add x y)) (Pd.madd (Desc.map x) (Desc.map y)) =
   pair-induction (\ x y -> Id Pd.M (Desc.map (add x y)) (Pd.madd (Desc.map x) (Desc.map y))) (\ x y -> Pd.setM _ _)
    (\ x y -> trans (ap Desc.map (add-class x y))
     (trans (Desc.beta (C.madd x y))
      (trans (H.map-add u x y) (cong2 Pd.M Pd.madd _ _ _ _ (sym (Desc.beta x)) (sym (Desc.beta y)))))) x y ;
  scalar (a : A.R) (x : CQ.Class) : Id Pd.M (Desc.map (scale a x)) (Pd.sm a (Desc.map x)) =
   induction (\ x -> Id Pd.M (Desc.map (scale a x)) (Pd.sm a (Desc.map x))) (\ x -> Pd.setM _ _)
    (\ x -> trans (ap Desc.map (scale-class a x))
     (trans (Desc.beta (C.sm a x)) (trans (H.map-scale u a x) (ap (Pd.sm a) (sym (Desc.beta x)))))) x ;
  factor : Maps.Hom = new Maps.Hom[Desc.map,additive,scalar] ;
  factor-at (x : C.M) : Id Pd.M (Maps.map factor (CQ.class x)) (H.map u x) = Desc.beta x ;
  unique (v : Maps.Hom) (on-classes : (x : C.M) -> Id Pd.M (Maps.map v (CQ.class x)) (H.map u x)) :
   (x : CQ.Class) -> Id Pd.M (Maps.map v x) (Maps.map factor x) =
   induction (\ x -> Id Pd.M (Maps.map v x) (Maps.map factor x)) (\ x -> Pd.setM _ _)
    (\ x -> trans (on-classes x) (sym (factor-at x))) ;
  opaque factor ;
 } ;
 opaque add ; opaque negative ; opaque scale ; opaque projection ;
} ;
