-- Small-set-valued functors on all small commutative test rings.
-- The objects of the test category live in U (l+1), its arrows in U l.
-- A functor has small set values and pointwise identity/composition laws.
-- Natural transformations are component functions with pointwise naturality;
-- naturality is a proposition, so equality is pointwise (funext), and they
-- form a set in U (l+1).  Composition is pointwise and uses the two
-- naturality equations.  The representable h_A maps h to postcomposition;
-- its laws follow by extensionality of ring maps.  Existing geometric
-- functors of points are instances; their natural families have this same
-- Sigma representation, so the comparison is by definition.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Hi = Prelude[l+] ;
module FE = Axioms[l+].FunExtLemmas[fe @l+] ;
module RH = RingHom[l] ;
module RM = RingMaps[l] ;
module T = AffineTests[l] ;
record SetFunctor {
 obj : T.Test -> U l ;
 set (A : T.Test) : Pr.isSet (obj A) ;
 reindex (A B : T.Test) : RH.Hom A.ring B.ring -> obj A -> obj B ;
 identity (A : T.Test) (x : obj A) : Id (obj A) (reindex A A (RH.identity A.ring) x) x ;
 composition (A B C : T.Test) (h : RH.Hom A.ring B.ring) (k : RH.Hom B.ring C.ring) (x : obj A) :
  Id (obj C) (reindex A C (RH.compose A.ring B.ring C.ring k h) x) (reindex B C k (reindex A B h x)) ;
} ;
module Transform (F G : SetFunctor) {
 Comp : U l+ = (A : T.Test) -> F.obj A -> G.obj A ;
 Natural (alpha : Comp) : U l+ = (A B : T.Test) (h : RH.Hom A.ring B.ring) (x : F.obj A) ->
  Id (G.obj B) (alpha B (F.reindex A B h x)) (G.reindex A B h (alpha A x)) ;
 natural-prop (alpha : Comp) : Hi.isProp (Natural alpha) =
  FE.isProp-Pi T.Test (\ A -> (B : T.Test) (h : RH.Hom A.ring B.ring) (x : F.obj A) ->
   Id (G.obj B) (alpha B (F.reindex A B h x)) (G.reindex A B h (alpha A x))) (\ A ->
  FE.isProp-Pi T.Test (\ B -> (h : RH.Hom A.ring B.ring) (x : F.obj A) ->
   Id (G.obj B) (alpha B (F.reindex A B h x)) (G.reindex A B h (alpha A x))) (\ B ->
  FE.isProp-Pi (RH.Hom A.ring B.ring) (\ h -> (x : F.obj A) ->
   Id (G.obj B) (alpha B (F.reindex A B h x)) (G.reindex A B h (alpha A x))) (\ h ->
  FE.isProp-Pi (F.obj A) (\ x -> Id (G.obj B) (alpha B (F.reindex A B h x)) (G.reindex A B h (alpha A x))) (\ x ->
   G.set B (alpha B (F.reindex A B h x)) (G.reindex A B h (alpha A x)))))) ;
 Nat : U l+ = (alpha : Comp) * Natural alpha ;
 at (alpha : Nat) (A : T.Test) (x : F.obj A) : G.obj A = alpha.1 A x ;
 natural (alpha : Nat) (A B : T.Test) (h : RH.Hom A.ring B.ring) (x : F.obj A) :
  Id (G.obj B) (at alpha B (F.reindex A B h x)) (G.reindex A B h (at alpha A x)) = alpha.2 A B h x ;
 ext (alpha beta : Nat) (e : (A : T.Test) (x : F.obj A) -> Id (G.obj A) (at alpha A x) (at beta A x)) : Id Nat alpha beta =
  Hi.Sigma-eq Comp Natural alpha.1 beta.1 alpha.2 beta.2
   (FE.funext T.Test (\ A -> F.obj A -> G.obj A) alpha.1 beta.1 (\ A ->
    FE.funext (F.obj A) (\ x -> G.obj A) (alpha.1 A) (beta.1 A) (e A))) (natural-prop beta.1) ;
 set : Hi.isSet Nat = Hi.isSet-Sigma Comp Natural
  (FE.isSet-Pi T.Test (\ A -> F.obj A -> G.obj A) (\ A -> FE.isSet-Pi (F.obj A) (\ x -> G.obj A) (\ x -> G.set A)))
  (\ alpha -> Hi.prop-to-set (Natural alpha) (natural-prop alpha)) ;
} ;
identity (F : SetFunctor) : Transform[F,F].Nat = (\ A x -> x,\ A B h x -> refl (F.reindex A B h x)) ;
module Composite (F G H : SetFunctor) (beta : Transform[G,H].Nat) (alpha : Transform[F,G].Nat) {
 module FG = Transform[F,G] ;
 module GH = Transform[G,H] ;
 composite : Transform[F,H].Nat = (\ A x -> GH.at beta A (FG.at alpha A x),
  \ A B h x -> trans (ap (GH.at beta B) (FG.natural alpha A B h x)) (GH.natural beta A B h (FG.at alpha A x))) ;
} ;
module Representable (A : T.Test) {
 obj (B : T.Test) : U l = RH.Hom A.ring B.ring ;
 reindex (B C : T.Test) (h : RH.Hom B.ring C.ring) (f : obj B) : obj C = RH.compose A.ring B.ring C.ring h f ;
 idn (B : T.Test) (f : obj B) : Id (obj B) (reindex B B (RH.identity B.ring) f) f =
  RH.Properties[A.ring,B.ring,B.carrier-set].ext (reindex B B (RH.identity B.ring) f) f (\ a -> refl (RM.map {A.ring} {B.ring} f a)) ;
 comp (B C D : T.Test) (h : RH.Hom B.ring C.ring) (k : RH.Hom C.ring D.ring) (f : obj B) :
  Id (obj D) (reindex B D (RH.compose B.ring C.ring D.ring k h) f) (reindex C D k (reindex B C h f)) =
  RH.Properties[A.ring,D.ring,D.carrier-set].ext (reindex B D (RH.compose B.ring C.ring D.ring k h) f) (reindex C D k (reindex B C h f))
   (\ a -> refl (RM.map k (RM.map h (RM.map {A.ring} {B.ring} f a)))) ;
 functor : SetFunctor = new SetFunctor[obj,\ B -> RH.Properties[A.ring,B.ring,B.carrier-set].set,reindex,idn,comp] ;
} ;
module Geometric (X : Spaces[l].Space) {
 module P = FunctorPoints[l].On[X] ;
 functor : SetFunctor = new SetFunctor[P.points,\ B -> Spaces[l].set (T.space B) X,P.reindex,P.identity,P.composition] ;
} ;
module GeometricMaps (X Y : Spaces[l].Space) {
 from-points (alpha : FunctorPoints[l].Maps[X,Y].Nat) : Transform[Geometric[X].functor,Geometric[Y].functor].Nat = alpha ;
 to-points (alpha : Transform[Geometric[X].functor,Geometric[Y].functor].Nat) : FunctorPoints[l].Maps[X,Y].Nat = alpha ;
} ;
