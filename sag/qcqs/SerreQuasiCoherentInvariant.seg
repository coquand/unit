-- Quasi-coherence is invariant under natural linear equivalence.
-- Restrict the equivalence to each atlas member and take its direct image
-- along that member's specified canonical affine map. Compose its inverse
-- with the old associated-module model. The same finite affine cover and
-- coefficient modules therefore give an atlas for the equivalent sheaf.
-- Eliminate the mere atlas only into the target quasi-coherence property.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l+] ; module Tr = Truncation[l+] ;
module DL = DistLattice[l] ; module MS = SerreModuleSheaf[l] ;
module QC = SerreQuasiCoherent[l] ;
module Transport (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged)
 (E F : MS.On[L,X.sheaf].ModuleSheaf)
 (e : SerreModuleSheafIso[l].On[L,X.sheaf].Equivalence E.presheaf F.presheaf) {
 module Source = QC.On[L,X,E] ; module Target = QC.On[L,X,F] ;
 module At (w : L.L) (model : Source.At[w].Model) {
  module S = Source.At[w] ; module T = Target.At[w] ;
  module Restricted = SerreModuleSheafRestrictionMaps[l].Over[L,X,w,E,F].Equivalence[e] ;
  module Image = SerreModuleSheafDirectImageMaps[l].Over[S.Canonical.ZG.lattice,S.S.lattice,
   S.Canonical.Can.Sh.structure,S.S.sheaf,S.Canonical.canonical,S.Restricted.restricted,T.Restricted.restricted].Equivalence[Restricted.equivalence] ;
  module Inv = SerreModuleSheafIso[l].On[S.Canonical.ZG.lattice,S.Canonical.Can.Sh.structure].Inverse[
   S.Image.presheaf,T.Image.presheaf,Image.equivalence] ;
  module Associated = SerreAssociatedSheaf[l].Over[S.S.sheaf.ring S.S.lattice.top,
   S.S.sheaf.ring-set S.S.lattice.top,model.coefficients] ;
  module Composite = SerreModuleSheafIsoOps[l].Over[S.Canonical.ZG.lattice,S.Canonical.Can.Sh.structure].Composite[
   T.Image.presheaf,S.Image.presheaf,Associated.associated.presheaf,Inv.equivalence,model.comparison] ;
  transported : T.Model = new T.Model[model.coefficients,Composite.equivalence] ;
 } ;
 atlas (a : Source.Atlas) : Target.Atlas = new Target.Atlas[a.cover,\ i -> At[a.cover.opens i,a.models i].transported] ;
 forward (qc : Source.IsQuasiCoherent) : Target.IsQuasiCoherent =
  Tr.Trunc[Source.Atlas].induction @(l+) (\ a -> Target.IsQuasiCoherent)
   (\ a -> Target.is-qc-prop) (\ a -> Target.from-atlas (atlas a)) qc ;
} ;
module Invariance (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged)
 (E F : MS.On[L,X.sheaf].ModuleSheaf)
 (e : SerreModuleSheafIso[l].On[L,X.sheaf].Equivalence E.presheaf F.presheaf) {
 module Forward = Transport[L,X,E,F,e] ;
 module Inv = SerreModuleSheafIso[l].On[L,X.sheaf].Inverse[E.presheaf,F.presheaf,e] ;
 module Backward = Transport[L,X,F,E,Inv.equivalence] ;
 equivalence : Pr.Equiv Forward.Source.IsQuasiCoherent Forward.Target.IsQuasiCoherent =
  (Forward.forward,Pr.qinv Forward.Source.IsQuasiCoherent Forward.Target.IsQuasiCoherent
   Forward.forward Backward.forward
   (\ a -> Forward.Target.is-qc-prop (Forward.forward (Backward.forward a)) a)
   (\ a -> Forward.Source.is-qc-prop (Backward.forward (Forward.forward a)) a)) ;
} ;
