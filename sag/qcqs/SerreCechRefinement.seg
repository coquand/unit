-- Cech H1 along a refinement (Serre note, Corollary 5.6).
-- Let U = (u_i) and W = (w_a) be finite covers with w_a <= u_(tau a).
-- Restriction of cocycles, rho(c)_ab = c_(tau a tau b)|(w_a /\ w_b), is a
-- cocycle (restrict the cocycle law of U to the triple overlap), additive.
-- Torsors. For a torsor with sections t_i on U, the restricted sections
-- t_(tau a)|w_a have cocycle rho of that of the t_i (differences commute
-- with restriction). Hence phi[c] = [rho c] is well defined on H1(U): it is
-- the W-class of T_c (SerreCechCanonicalCocycle recovers c from the points
-- of T_c), and c ~ d makes T_c and T_d isomorphic, which have equal
-- W-classes (SerreCechIsoClass). phi is additive, and it sends the U-class
-- of any torsor to its W-class.
-- If every torsor has sections on the members of U, phi is bijective:
-- psi[d] is the U-class of T_d; phi(psi[d]) is the W-class of T_d, which is
-- [d]; and T_(rho c) and T_c have the same W-class, so are isomorphic and
-- have the same U-class [c].
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module DL = DistLattice[l] ;
module MS = SerreModuleSheaf[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module On (L : DL.DLat) (G : RingedLattice[l].On[L].Presheaf) (M : MS.On[L,G].ModuleSheaf)
 (n : Nat) (as : Fin n -> L.L) (covers-u : DL.Order[L].Le L.top (DL.Joins[L].bigJ n as))
 (k : Nat) (ws : Fin k -> L.L) (covers-w : DL.Order[L].Le L.top (DL.Joins[L].bigJ k ws))
 (tau : Fin k -> Fin n) (below : (a : Fin k) -> DL.Order[L].Le (ws a) (as (tau a))) {
 module O = DL.Order[L] ;
 module MO = MS.On[L,G].Of[M.presheaf] ;
 module UC = SerreCechIsoClass[l].On[L,G,M,n,as,covers-u] ;
 module WC = SerreCechIsoClass[l].On[L,G,M,k,ws,covers-w] ;
 module ZU = UC.Z ; module ZW = WC.Z ;
 module GU = SerreCechGroup[l].On[L,G,M,n,as] ; module GW = SerreCechGroup[l].On[L,G,M,k,ws] ;
 module Torsors = SerreTorsor[l].On[L,G].Over[M] ;
 -- the restriction of cochains
 pair-below (a b : Fin k) : O.Le (ZW.C.overlap a b) (ZU.C.overlap (tau a) (tau b)) =
  O.meet-glb (as (tau a)) (as (tau b)) (ZW.C.overlap a b)
   (O.le-trans _ (ws a) _ (O.meet-left (ws a) (ws b)) (below a))
   (O.le-trans _ (ws b) _ (O.meet-right (ws a) (ws b)) (below b)) ;
 cochain (c : ZU.C.C1.Carrier) : ZW.C.C1.Carrier = \ a b ->
  MO.restrict (ZW.C.overlap a b) (ZU.C.overlap (tau a) (tau b)) (pair-below a b) (c (tau a) (tau b)) ;
 module Law (c : ZU.Cocycle) (a b e : Fin k) {
  module TW = ZW.Triple[a,b,e] ; module TU = ZU.Triple[tau a,tau b,tau e] ;
  dom : L.L = TW.domain ;
  dom-below : O.Le dom TU.domain =
   O.meet-glb (ZU.C.overlap (tau a) (tau b)) (as (tau e)) dom
    (O.le-trans _ (ZW.C.overlap a b) _ TW.ij (pair-below a b)) (O.le-trans _ (ws e) _ TW.below-k (below e)) ;
  through (p q : Fin k) (h : O.Le dom (ZW.C.overlap p q)) (x : (M.presheaf.module-at (ZU.C.overlap (tau p) (tau q))).M)
   (t : O.Le TU.domain (ZU.C.overlap (tau p) (tau q))) :
   Id (M.presheaf.module-at dom).M
    (MO.restrict dom (ZW.C.overlap p q) h (MO.restrict (ZW.C.overlap p q) (ZU.C.overlap (tau p) (tau q)) (pair-below p q) x))
    (MO.restrict dom TU.domain dom-below (MO.restrict TU.domain (ZU.C.overlap (tau p) (tau q)) t x)) =
   trans (M.presheaf.res-comp dom (ZW.C.overlap p q) (ZU.C.overlap (tau p) (tau q)) h (pair-below p q)
     (O.le-trans _ TU.domain _ dom-below t) x)
    (sym (M.presheaf.res-comp dom TU.domain (ZU.C.overlap (tau p) (tau q)) dom-below t (O.le-trans _ TU.domain _ dom-below t) x)) ;
  law : TW.Law (cochain (ZU.value c)) = calc (M.presheaf.module-at dom).M {
   (M.presheaf.module-at dom).madd
    (MO.restrict dom (ZW.C.overlap a b) TW.ij (cochain (ZU.value c) a b))
    (MO.restrict dom (ZW.C.overlap b e) TW.jk (cochain (ZU.value c) b e))
    =< cong2 (M.presheaf.module-at dom).M (M.presheaf.module-at dom).madd _ _ _ _
        (through a b TW.ij (ZU.value c (tau a) (tau b)) TU.ij) (through b e TW.jk (ZU.value c (tau b) (tau e)) TU.jk)
     > (M.presheaf.module-at dom).madd
        (MO.restrict dom TU.domain dom-below (MO.restrict TU.domain (ZU.C.overlap (tau a) (tau b)) TU.ij (ZU.value c (tau a) (tau b))))
        (MO.restrict dom TU.domain dom-below (MO.restrict TU.domain (ZU.C.overlap (tau b) (tau e)) TU.jk (ZU.value c (tau b) (tau e))))
    =< sym (MO.res-add dom TU.domain dom-below _ _)
     > MO.restrict dom TU.domain dom-below ((M.presheaf.module-at TU.domain).madd
        (MO.restrict TU.domain (ZU.C.overlap (tau a) (tau b)) TU.ij (ZU.value c (tau a) (tau b)))
        (MO.restrict TU.domain (ZU.C.overlap (tau b) (tau e)) TU.jk (ZU.value c (tau b) (tau e))))
    =< ap (MO.restrict dom TU.domain dom-below) (ZU.law c (tau a) (tau b) (tau e))
     > MO.restrict dom TU.domain dom-below (MO.restrict TU.domain (ZU.C.overlap (tau a) (tau e)) TU.ik (ZU.value c (tau a) (tau e)))
    =< sym (through a e TW.ik (ZU.value c (tau a) (tau e)) TU.ik)
     > MO.restrict dom (ZW.C.overlap a e) TW.ik (cochain (ZU.value c) a e) } ;
 } ;
 restrict (c : ZU.Cocycle) : ZW.Cocycle = (cochain (ZU.value c),\ a b e -> Law[c,a,b,e].law) ;
 restrict-value (c : ZU.Cocycle) : Id ZW.C.C1.Carrier (ZW.value (restrict c)) (cochain (ZU.value c)) = refl (cochain (ZU.value c)) ;
 restrict-add (c d : ZU.Cocycle) : Id ZW.Cocycle (restrict (GU.CG.add c d)) (GW.CG.add (restrict c) (restrict d)) =
  ZW.ext _ _ (FE.funext (Fin k) (\ a -> (b : Fin k) -> (M.presheaf.module-at (ZW.C.overlap a b)).M) _ _ (\ a ->
   FE.funext (Fin k) (\ b -> (M.presheaf.module-at (ZW.C.overlap a b)).M) _ _ (\ b ->
    MO.res-add (ZW.C.overlap a b) (ZU.C.overlap (tau a) (tau b)) (pair-below a b)
     (ZU.value c (tau a) (tau b)) (ZU.value d (tau a) (tau b))))) ;
 -- a torsor with sections on U, restricted to W
 module Restricted (T : Torsors.Torsor) (ts : (i : Fin n) -> T.presheaf.obj (as i)) {
  module TD = Torsors.Of[T] ;
  wts (a : Fin k) : T.presheaf.obj (ws a) = T.presheaf.res (ws a) (as (tau a)) (below a) (ts (tau a)) ;
  module CU = SerreCechTriviality[l].On[L,G,M,T,n,as,covers-u,ts] ;
  module CW = SerreCechTriviality[l].On[L,G,M,T,k,ws,covers-w,wts] ;
  side (a b : Fin k) (p : Fin k) (h : O.Le (ZW.C.overlap a b) (ws p)) (hu : O.Le (ZU.C.overlap (tau a) (tau b)) (as (tau p))) :
   Id (T.presheaf.obj (ZW.C.overlap a b)) (T.presheaf.res (ZW.C.overlap a b) (ws p) h (wts p))
    (T.presheaf.res (ZW.C.overlap a b) (ZU.C.overlap (tau a) (tau b)) (pair-below a b)
     (T.presheaf.res (ZU.C.overlap (tau a) (tau b)) (as (tau p)) hu (ts (tau p)))) =
   trans (T.presheaf.res-comp (ZW.C.overlap a b) (ws p) (as (tau p)) h (below p) (O.le-trans _ (ws p) _ h (below p)) (ts (tau p)))
    (sym (T.presheaf.res-comp (ZW.C.overlap a b) (ZU.C.overlap (tau a) (tau b)) (as (tau p)) (pair-below a b) hu
     (O.le-trans _ (ws p) _ h (below p)) (ts (tau p)))) ;
  ap2-diff (a b : Fin k) : Id (M.presheaf.module-at (ZW.C.overlap a b)).M (CW.TC.cocycle a b)
   (TD.diff (ZW.C.overlap a b)
    (T.presheaf.res (ZW.C.overlap a b) (ZU.C.overlap (tau a) (tau b)) (pair-below a b) (CU.TC.right (tau a) (tau b)))
    (T.presheaf.res (ZW.C.overlap a b) (ZU.C.overlap (tau a) (tau b)) (pair-below a b) (CU.TC.left (tau a) (tau b)))) =
   trans (ap (\ t -> TD.diff (ZW.C.overlap a b) t (CW.TC.left a b))
     (side a b b (O.meet-right (ws a) (ws b)) (O.meet-right (as (tau a)) (as (tau b)))))
    (ap (TD.diff (ZW.C.overlap a b)
      (T.presheaf.res (ZW.C.overlap a b) (ZU.C.overlap (tau a) (tau b)) (pair-below a b) (CU.TC.right (tau a) (tau b))))
     (side a b a (O.meet-left (ws a) (ws b)) (O.meet-left (as (tau a)) (as (tau b))))) ;
  pointwise (a b : Fin k) : Id (M.presheaf.module-at (ZW.C.overlap a b)).M (CW.TC.cocycle a b) (cochain CU.cochain a b) =
   trans (ap2-diff a b)
    (TD.diff-res (ZW.C.overlap a b) (ZU.C.overlap (tau a) (tau b)) (pair-below a b) (CU.TC.right (tau a) (tau b)) (CU.TC.left (tau a) (tau b))) ;
  value-pointwise (a b : Fin k) : Id (M.presheaf.module-at (ZW.C.overlap a b)).M (ZW.value CW.cocycle a b)
   (ZW.value (restrict CU.cocycle) a b) =
   trans (ap (\ x -> x a b) CW.cocycle-value)
    (trans (pointwise a b) (trans (ap (\ x -> cochain x a b) (sym CU.cocycle-value))
     (ap (\ x -> x a b) (sym (restrict-value CU.cocycle))))) ;
  cocycle-eq : Id ZW.Cocycle CW.cocycle (restrict CU.cocycle) =
   ZW.ext _ _ (FE.funext (Fin k) (\ a -> (b : Fin k) -> (M.presheaf.module-at (ZW.C.overlap a b)).M) _ _ (\ a ->
    FE.funext (Fin k) (\ b -> (M.presheaf.module-at (ZW.C.overlap a b)).M) _ _ (\ b -> value-pointwise a b))) ;
  covered : WC.TorsorClass[T].Covered = Tr.Trunc[WC.TorsorClass[T].Trivialisations].inc wts ;
 } ;
 -- the W-class of T_c is [rho c]
 module Twisted (c : ZU.Cocycle) {
  module A = UC.AtCocycle[c] ;
  module S = Restricted[A.Local.torsor,A.Local.local-point] ;
  w-class : ZW.H1 = WC.TorsorClass[A.Local.torsor].class S.covered ;
  w-class-eq : Id ZW.H1 w-class (ZW.class (restrict c)) =
   trans (WC.TorsorClass[A.Local.torsor].on-sections S.covered S.wts) (trans S.CW.class-at
    (ap ZW.class (trans S.cocycle-eq (ap restrict A.Recovery.cocycle-equation)))) ;
 } ;
 respects (c d : ZU.Cocycle) (r : ZU.Related c d) : Id ZW.H1 (ZW.class (restrict c)) (ZW.class (restrict d)) =
  trans (sym Twisted[c].w-class-eq) (trans
   (WC.Between[UC.AtCocycle[c].Local.torsor,UC.AtCocycle[d].Local.torsor,Twisted[c].S.covered,Twisted[d].S.covered].isomorphism-to-same
    (UC.Between[UC.AtCocycle[c].Local.torsor,UC.AtCocycle[d].Local.torsor,UC.AtCocycle[c].covered,UC.AtCocycle[d].covered].same-to-isomorphism
     (trans UC.AtCocycle[c].class-equation (trans (ZU.Q.relates c d r) (sym UC.AtCocycle[d].class-equation)))))
   Twisted[d].w-class-eq) ;
 module Phi = ZU.Q.Descend[ZW.H1,ZW.h1-set,\ c -> ZW.class (restrict c),respects] ;
 phi (h : ZU.H1) : ZW.H1 = Phi.map h ;
 phi-class (c : ZU.Cocycle) : Id ZW.H1 (phi (ZU.class c)) (ZW.class (restrict c)) = Phi.beta c ;
 -- phi is additive
 phi-add-class (c d : ZU.Cocycle) :
  Id ZW.H1 (phi (GU.h1-module.madd (ZU.class c) (ZU.class d))) (GW.h1-module.madd (phi (ZU.class c)) (phi (ZU.class d))) =
  calc ZW.H1 {
   phi (GU.h1-module.madd (ZU.class c) (ZU.class d))
    =< ap phi (GU.add-class c d) > phi (ZU.class (GU.CG.add c d))
    =< phi-class (GU.CG.add c d) > ZW.class (restrict (GU.CG.add c d))
    =< ap ZW.class (restrict-add c d) > ZW.class (GW.CG.add (restrict c) (restrict d))
    =< sym (GW.add-class (restrict c) (restrict d)) > GW.h1-module.madd (ZW.class (restrict c)) (ZW.class (restrict d))
    =< sym (cong2 ZW.H1 GW.h1-module.madd _ _ _ _ (phi-class c) (phi-class d))
     > GW.h1-module.madd (phi (ZU.class c)) (phi (ZU.class d)) } ;
 phi-add (h g : ZU.H1) : Id ZW.H1 (phi (GU.h1-module.madd h g)) (GW.h1-module.madd (phi h) (phi g)) =
  ZU.Q.induction @l (\ x -> Id ZW.H1 (phi (GU.h1-module.madd x g)) (GW.h1-module.madd (phi x) (phi g))) (\ x -> ZW.h1-set _ _)
   (\ c -> ZU.Q.induction @l (\ y -> Id ZW.H1 (phi (GU.h1-module.madd (ZU.class c) y)) (GW.h1-module.madd (phi (ZU.class c)) (phi y)))
    (\ y -> ZW.h1-set _ _) (\ d -> phi-add-class c d) g) h ;
 -- phi sends the U-class of a torsor to its W-class
 phi-torsor (T : Torsors.Torsor) (cov : UC.TorsorClass[T].Covered) (wcov : WC.TorsorClass[T].Covered) :
  Id ZW.H1 (phi (UC.TorsorClass[T].class cov)) (WC.TorsorClass[T].class wcov) =
  Tr.Trunc[UC.TorsorClass[T].Trivialisations].induction @l
   (\ t -> Id ZW.H1 (phi (UC.TorsorClass[T].class cov)) (WC.TorsorClass[T].class wcov)) (\ t -> ZW.h1-set _ _)
   (\ ts -> calc ZW.H1 {
     phi (UC.TorsorClass[T].class cov)
      =< ap phi (trans (UC.TorsorClass[T].on-sections cov ts) Restricted[T,ts].CU.class-at) > phi (ZU.class Restricted[T,ts].CU.cocycle)
      =< phi-class Restricted[T,ts].CU.cocycle > ZW.class (restrict Restricted[T,ts].CU.cocycle)
      =< ap ZW.class (sym Restricted[T,ts].cocycle-eq) > ZW.class Restricted[T,ts].CW.cocycle
      =< sym (trans (WC.TorsorClass[T].on-sections Restricted[T,ts].covered Restricted[T,ts].wts) Restricted[T,ts].CW.class-at) > WC.TorsorClass[T].class Restricted[T,ts].covered
      =< WC.TorsorClass[T].independent Restricted[T,ts].covered wcov > WC.TorsorClass[T].class wcov })
   cov ;
 -- when every torsor has sections on the members of U, phi is bijective
 module Onto (covered : (T : Torsors.Torsor) -> UC.TorsorClass[T].Covered) {
  module TwW (d : ZW.Cocycle) { module A = WC.AtCocycle[d] ; T : Torsors.Torsor = A.Local.torsor ; } ;
  psi-respects (d e : ZW.Cocycle) (r : ZW.Related d e) :
   Id ZU.H1 (UC.TorsorClass[TwW[d].T].class (covered TwW[d].T)) (UC.TorsorClass[TwW[e].T].class (covered TwW[e].T)) =
   UC.Between[TwW[d].T,TwW[e].T,covered TwW[d].T,covered TwW[e].T].isomorphism-to-same
    (WC.Between[TwW[d].T,TwW[e].T,TwW[d].A.covered,TwW[e].A.covered].same-to-isomorphism
     (trans TwW[d].A.class-equation (trans (ZW.Q.relates d e r) (sym TwW[e].A.class-equation)))) ;
  module Psi = ZW.Q.Descend[ZU.H1,ZU.h1-set,\ d -> UC.TorsorClass[TwW[d].T].class (covered TwW[d].T),psi-respects] ;
  psi (h : ZW.H1) : ZU.H1 = Psi.map h ;
  phi-psi (h : ZW.H1) : Id ZW.H1 (phi (psi h)) h =
   ZW.Q.induction @l (\ x -> Id ZW.H1 (phi (psi x)) x) (\ x -> ZW.h1-set _ _)
    (\ d -> trans (ap phi (Psi.beta d))
     (trans (phi-torsor TwW[d].T (covered TwW[d].T) TwW[d].A.covered) TwW[d].A.class-equation)) h ;
  psi-phi (h : ZU.H1) : Id ZU.H1 (psi (phi h)) h =
   ZU.Q.induction @l (\ x -> Id ZU.H1 (psi (phi x)) x) (\ x -> ZU.h1-set _ _)
    (\ c -> calc ZU.H1 {
      psi (phi (ZU.class c))
       =< ap psi (phi-class c) > psi (ZW.class (restrict c))
       =< Psi.beta (restrict c) > UC.TorsorClass[TwW[restrict c].T].class (covered TwW[restrict c].T)
       =< UC.Between[TwW[restrict c].T,UC.AtCocycle[c].Local.torsor,covered TwW[restrict c].T,UC.AtCocycle[c].covered].isomorphism-to-same
           (WC.Between[TwW[restrict c].T,UC.AtCocycle[c].Local.torsor,TwW[restrict c].A.covered,Twisted[c].S.covered].same-to-isomorphism
            (trans TwW[restrict c].A.class-equation (sym Twisted[c].w-class-eq)))
        > UC.TorsorClass[UC.AtCocycle[c].Local.torsor].class UC.AtCocycle[c].covered
       =< UC.AtCocycle[c].class-equation > ZU.class c }) h ;
  equivalence : Pr.Equiv ZU.H1 ZW.H1 = (phi,Pr.qinv ZU.H1 ZW.H1 phi psi phi-psi psi-phi) ;
 } ;
} ;
