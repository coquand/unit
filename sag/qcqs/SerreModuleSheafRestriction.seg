-- Restrict a module sheaf to a compact open (Serre, Section 4).
-- The existing slice lattice supplies the opens u <= e and their actual
-- rings. Keep the original section modules and restrictions. A finite
-- cover in the slice becomes a cover in the original lattice by the
-- named finite-join comparison. Compatibility differs only in the
-- inclusion witnesses, which are propositions; hence original unique
-- amalgamation proves sheafhood on the slice, including empty covers.
level l ; open Ring[l] ; open Presentations[l] ;
module DL = DistLattice[l] ;
module MS = SerreModuleSheaf[l] ;
module SS = SerreSetSheaf[l] ;
module On (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged)
 (e : L.L) (M : MS.On[L,X.sheaf].ModuleSheaf) {
 module O = DL.Order[L] ;
 module J = DL.Joins[L] ;
 module S = Slice[l].Over[L,X,e] ;
 module MO = MS.On[L,X.sheaf].Of[M.presheaf] ;
 presheaf : MS.On[S.lattice,S.sheaf].Presheaf = new MS.On[S.lattice,S.sheaf].Presheaf[
  \ a -> M.presheaf.module-at (S.inc a),
  \ a b k -> M.presheaf.res (S.inc a) (S.inc b) (S.le-inc a b k),
  \ a k x -> M.presheaf.res-id (S.inc a) (S.le-inc a a k) x,
  \ a b c k h t x -> M.presheaf.res-comp (S.inc a) (S.inc b) (S.inc c)
   (S.le-inc a b k) (S.le-inc b c h) (S.le-inc a c t) x] ;
 module RO = MS.On[S.lattice,S.sheaf].Of[presheaf] ;
 restrict-inc (a b : S.Opens) (k : S.OS.Le a b) (x : (M.presheaf.module-at (S.inc b)).M) :
  Id (M.presheaf.module-at (S.inc a)).M (RO.restrict a b k x)
   (MO.restrict (S.inc a) (S.inc b) (S.le-inc a b k) x) =
  refl (MO.restrict (S.inc a) (S.inc b) (S.le-inc a b k) x) ;
 module Cover (a : S.Opens) (n : Nat) (as : Fin n -> S.Opens)
  (le : (i : Fin n) -> S.OS.Le (as i) a) (covers : S.OS.Le a (S.JS.bigJ n as)) {
  covers-source : O.Le (S.inc a) (J.bigJ n (\ i -> S.inc (as i))) =
   S.Glue[a,n,as,le,covers].covers-X ;
  module C = RO.Cover[a,n,as,le,covers].C ;
  module Original = MO.Cover[S.inc a,n,\ i -> S.inc (as i),\ i -> S.le-inc (as i) a (le i),covers-source].C ;
  compatible (xs : (i : Fin n) -> (M.presheaf.module-at (S.inc (as i))).M)
   (h : C.Compatible xs) : Original.Compatible xs = \ i j ->
   trans (MO.res-irr (L.meet (S.inc (as i)) (S.inc (as j))) (S.inc (as i))
    (O.meet-left (S.inc (as i)) (S.inc (as j)))
    (S.le-inc (S.meetS (as i) (as j)) (as i) (S.OS.meet-left (as i) (as j))) (xs i))
   (trans (h i j)
    (MO.res-irr (L.meet (S.inc (as i)) (S.inc (as j))) (S.inc (as j))
     (S.le-inc (S.meetS (as i) (as j)) (as j) (S.OS.meet-right (as i) (as j)))
     (O.meet-right (S.inc (as i)) (S.inc (as j))) (xs j))) ;
  glue (xs : (i : Fin n) -> (M.presheaf.module-at (S.inc (as i))).M)
   (h : C.Compatible xs) : Localisation[l].isContr (C.Amalgam xs) =
   M.sheaf (S.inc a) n (\ i -> S.inc (as i)) (\ i -> S.le-inc (as i) a (le i)) covers-source xs (compatible xs h) ;
  opaque glue ;
 } ;
 sheaf : RO.IsSheaf = \ a n as le covers xs h -> Cover[a,n,as,le,covers].glue xs h ;
 restricted : MS.On[S.lattice,S.sheaf].ModuleSheaf = new MS.On[S.lattice,S.sheaf].ModuleSheaf[presheaf,sheaf] ;
 opaque sheaf ;
} ;
