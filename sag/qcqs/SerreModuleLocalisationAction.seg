-- Scalar action and inversion of f on the fraction carrier.
-- Multiplication by a acts on the numerator and descends since it
-- commutes with every power of f.  Increasing the denominator exponent
-- descends as well; the raising equation says that it is inverse to f.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module SM = SerreModule[l] ; module LC = SerreModuleLocalisation[l] ;
module At (A : CRing) (Md : SM.Over[A].Module) (f : A.R) {
 module L = LC.At[A,Md,f] ;
 module ML = SM.Over[A].Laws[Md] ;
 scale-respect (a : A.R) (x y : Md.M) (p q : Nat) (r : L.Relation (x,p) (y,q)) :
  Id L.Carrier (L.fraction (Md.sm a x) p) (L.fraction (Md.sm a y) q) =
  Tr.Trunc[L.Witness (x,p) (y,q)].induction @l
   (\ w -> Id L.Carrier (L.fraction (Md.sm a x) p) (L.fraction (Md.sm a y) q))
   (\ w -> L.carrier-set (L.fraction (Md.sm a x) p) (L.fraction (Md.sm a y) q))
   (\ w -> L.equal (Md.sm a x) (Md.sm a y) p q
    (Tr.Trunc[L.Witness (Md.sm a x,p) (Md.sm a y,q)].inc
     (w.1,trans (L.power-scale (plus w.1 q) a x)
      (trans (ap (Md.sm a) w.2) (sym (L.power-scale (plus w.1 p) a y)))))) r ;
 module Scalar (a : A.R) {
  module D = L.Descend[L.Carrier,L.carrier-set,\ x p -> L.fraction (Md.sm a x) p,scale-respect a] ;
 } ;
 scale (a : A.R) (q : L.Carrier) : L.Carrier = Scalar[a].D.map q ;
 scale-at (a : A.R) (x : Md.M) (p : Nat) : Id L.Carrier (scale a (L.fraction x p)) (L.fraction (Md.sm a x) p) = Scalar[a].D.beta x p ;
 shift-respect (x y : Md.M) (p q : Nat) (r : L.Relation (x,p) (y,q)) :
  Id L.Carrier (L.fraction x (suc p)) (L.fraction y (suc q)) =
  Tr.Trunc[L.Witness (x,p) (y,q)].induction @l
   (\ w -> Id L.Carrier (L.fraction x (suc p)) (L.fraction y (suc q)))
   (\ w -> L.carrier-set (L.fraction x (suc p)) (L.fraction y (suc q)))
   (\ w -> L.equal x y (suc p) (suc q)
    (Tr.Trunc[L.Witness (x,suc p) (y,suc q)].inc
     (w.1,trans (ap (\ n -> L.power n x) (plus-suc w.1 q))
      (trans (L.power-at-suc (plus w.1 q) x)
       (trans (ap (Md.sm f) w.2)
        (trans (sym (L.power-at-suc (plus w.1 p) y)) (sym (ap (\ n -> L.power n y) (plus-suc w.1 p))))))))) r ;
 module Shift = L.Descend[L.Carrier,L.carrier-set,\ x p -> L.fraction x (suc p),shift-respect] ;
 inverse (q : L.Carrier) : L.Carrier = Shift.map q ;
 inverse-at (x : Md.M) (p : Nat) : Id L.Carrier (inverse (L.fraction x p)) (L.fraction x (suc p)) = Shift.beta x p ;
 raise-once (x : Md.M) (p : Nat) : Id L.Carrier (L.fraction (Md.sm f x) (suc p)) (L.fraction x p) =
  trans (ap (\ y -> L.fraction y (suc p))
   (sym (trans (L.power-at-suc zero x) (ap (Md.sm f) (L.power-at-zero x)))))
   (L.raise x p (suc zero)) ;
 inverse-left (q : L.Carrier) : Id L.Carrier (inverse (scale f q)) q =
  L.induction @l (\ q -> Id L.Carrier (inverse (scale f q)) q)
   (\ q -> L.carrier-set (inverse (scale f q)) q)
   (\ x p -> trans (ap inverse (scale-at f x p)) (trans (inverse-at (Md.sm f x) p) (raise-once x p))) q ;
 inverse-right (q : L.Carrier) : Id L.Carrier (scale f (inverse q)) q =
  L.induction @l (\ q -> Id L.Carrier (scale f (inverse q)) q)
   (\ q -> L.carrier-set (scale f (inverse q)) q)
   (\ x p -> trans (ap (scale f) (inverse-at x p)) (trans (scale-at f x (suc p)) (raise-once x p))) q ;
 invertible : Pr.isEquiv L.Carrier L.Carrier (scale f) =
  Pr.qinv L.Carrier L.Carrier (scale f) inverse inverse-right inverse-left ;
 mz : L.Carrier = L.fraction Md.mz zero ;
 zero-at (p : Nat) : Id L.Carrier (L.fraction Md.mz p) mz =
  L.equal Md.mz Md.mz p zero
   (Tr.Trunc[L.Witness (Md.mz,p) (Md.mz,zero)].inc
    (zero,trans (L.power-at-zero Md.mz) (sym (L.power-zero p)))) ;
 scale-zero (a : A.R) : Id L.Carrier (scale a mz) mz =
  trans (scale-at a Md.mz zero) (ap (\ x -> L.fraction x zero) (ML.sm-zero a)) ;
 scale-one (q : L.Carrier) : Id L.Carrier (scale A.o q) q =
  L.induction @l (\ q -> Id L.Carrier (scale A.o q) q)
   (\ q -> L.carrier-set (scale A.o q) q)
   (\ x p -> trans (scale-at A.o x p) (ap (\ y -> L.fraction y p) (Md.smO x))) q ;
 scale-assoc (a b : A.R) (q : L.Carrier) : Id L.Carrier (scale a (scale b q)) (scale (A.mul a b) q) =
  L.induction @l (\ q -> Id L.Carrier (scale a (scale b q)) (scale (A.mul a b) q))
   (\ q -> L.carrier-set (scale a (scale b q)) (scale (A.mul a b) q))
   (\ x p -> trans (ap (scale a) (scale-at b x p))
    (trans (scale-at a (Md.sm b x) p)
     (trans (ap (\ y -> L.fraction y p) (Md.smA a b x)) (sym (scale-at (A.mul a b) x p))))) q ;
 negative-respect (x y : Md.M) (p q : Nat) (r : L.Relation (x,p) (y,q)) :
  Id L.Carrier (L.fraction (Md.mneg x) p) (L.fraction (Md.mneg y) q) =
  Tr.Trunc[L.Witness (x,p) (y,q)].induction @l
   (\ w -> Id L.Carrier (L.fraction (Md.mneg x) p) (L.fraction (Md.mneg y) q))
   (\ w -> L.carrier-set (L.fraction (Md.mneg x) p) (L.fraction (Md.mneg y) q))
   (\ w -> L.equal (Md.mneg x) (Md.mneg y) p q
    (Tr.Trunc[L.Witness (Md.mneg x,p) (Md.mneg y,q)].inc
     (w.1,trans (L.power-negative (plus w.1 q) x)
      (trans (ap Md.mneg w.2) (sym (L.power-negative (plus w.1 p) y)))))) r ;
 module Negative = L.Descend[L.Carrier,L.carrier-set,\ x p -> L.fraction (Md.mneg x) p,negative-respect] ;
 negative (q : L.Carrier) : L.Carrier = Negative.map q ;
 negative-at (x : Md.M) (p : Nat) : Id L.Carrier (negative (L.fraction x p)) (L.fraction (Md.mneg x) p) = Negative.beta x p ;
 opaque negative ;
 opaque scale ;
 opaque inverse ;
} ;
