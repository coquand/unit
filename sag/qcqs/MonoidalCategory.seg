-- Monoidal and symmetric monoidal structure on a univalent category C
-- (objects and arrows in U k).
--
-- A monoidal structure: a tensor x (x) y on objects and f (x) g on arrows,
-- functorial in both variables at once (identities to identities,
-- composites to composites: a functor C x C -> C stated directly); a
-- unit object I; natural isos
--   associator  a : (x (x) y) (x) z ~ x (x) (y (x) z),
--   left unitor l : I (x) x ~ x,   right unitor r : x (x) I ~ x;
-- the pentagon a_{w,x,y(x)z} a_{w(x)x,y,z} = (1 (x) a_{x,y,z}) a_{w,x(x)y,z}
-- (a_{w,x,y} (x) 1) and the triangle (1 (x) l_y) a_{x,I,y} = r_x (x) 1.
-- The tensor, the unit and the three isos are data; the laws are
-- propositions, as hom types are sets.
-- A symmetric structure adds a natural braiding b : x (x) y ~ y (x) x with
-- b_{y,x} b_{x,y} = 1 and the hexagon a_{y,z,x} b_{x,y(x)z} a_{x,y,z} =
-- (1 (x) b_{x,z}) a_{y,x,z} (b_{x,y} (x) 1).
-- Transport: both are families over categories, so an identification
-- C = D carries a structure on C to one on D (one subst).
level k ; open Base ;
module K = Category[k,k] ;
module P = Prelude[k+] ;

record Monoidal (C : K.Category) {
 tensor : C.pre.ob -> C.pre.ob -> C.pre.ob ;
 tmap (x x' y y' : C.pre.ob) (f : C.pre.hom x x') (g : C.pre.hom y y') :
  C.pre.hom (tensor x y) (tensor x' y') ;
 tmap-idn (x y : C.pre.ob) :
  Id (C.pre.hom (tensor x y) (tensor x y)) (tmap x x y y (C.pre.idn x) (C.pre.idn y)) (C.pre.idn (tensor x y)) ;
 tmap-comp (x x' x'' y y' y'' : C.pre.ob) (f' : C.pre.hom x' x'') (f : C.pre.hom x x')
  (g' : C.pre.hom y' y'') (g : C.pre.hom y y') :
  Id (C.pre.hom (tensor x y) (tensor x'' y''))
   (tmap x x'' y y'' (C.pre.comp x x' x'' f' f) (C.pre.comp y y' y'' g' g))
   (C.pre.comp (tensor x y) (tensor x' y') (tensor x'' y'') (tmap x' x'' y' y'' f' g') (tmap x x' y y' f g)) ;
 unit : C.pre.ob ;
 associator (x y z : C.pre.ob) : C.pre.Iso (tensor (tensor x y) z) (tensor x (tensor y z)) ;
 associator-natural (x x' y y' z z' : C.pre.ob) (f : C.pre.hom x x') (g : C.pre.hom y y') (h : C.pre.hom z z') :
  Id (C.pre.hom (tensor (tensor x y) z) (tensor x' (tensor y' z')))
   (C.pre.comp (tensor (tensor x y) z) (tensor (tensor x' y') z') (tensor x' (tensor y' z'))
    (associator x' y' z').1 (tmap (tensor x y) (tensor x' y') z z' (tmap x x' y y' f g) h))
   (C.pre.comp (tensor (tensor x y) z) (tensor x (tensor y z)) (tensor x' (tensor y' z'))
    (tmap x x' (tensor y z) (tensor y' z') f (tmap y y' z z' g h)) (associator x y z).1) ;
 left-unitor (x : C.pre.ob) : C.pre.Iso (tensor unit x) x ;
 left-natural (x x' : C.pre.ob) (f : C.pre.hom x x') :
  Id (C.pre.hom (tensor unit x) x')
   (C.pre.comp (tensor unit x) (tensor unit x') x' (left-unitor x').1 (tmap unit unit x x' (C.pre.idn unit) f))
   (C.pre.comp (tensor unit x) x x' f (left-unitor x).1) ;
 right-unitor (x : C.pre.ob) : C.pre.Iso (tensor x unit) x ;
 right-natural (x x' : C.pre.ob) (f : C.pre.hom x x') :
  Id (C.pre.hom (tensor x unit) x')
   (C.pre.comp (tensor x unit) (tensor x' unit) x' (right-unitor x').1 (tmap x x' unit unit f (C.pre.idn unit)))
   (C.pre.comp (tensor x unit) x x' f (right-unitor x).1) ;
 pentagon (w x y z : C.pre.ob) :
  Id (C.pre.hom (tensor (tensor (tensor w x) y) z) (tensor w (tensor x (tensor y z))))
   (C.pre.comp (tensor (tensor (tensor w x) y) z) (tensor (tensor w x) (tensor y z)) (tensor w (tensor x (tensor y z)))
    (associator w x (tensor y z)).1 (associator (tensor w x) y z).1)
   (C.pre.comp (tensor (tensor (tensor w x) y) z) (tensor w (tensor (tensor x y) z)) (tensor w (tensor x (tensor y z)))
    (tmap w w (tensor (tensor x y) z) (tensor x (tensor y z)) (C.pre.idn w) (associator x y z).1)
    (C.pre.comp (tensor (tensor (tensor w x) y) z) (tensor (tensor w (tensor x y)) z) (tensor w (tensor (tensor x y) z))
     (associator w (tensor x y) z).1
     (tmap (tensor (tensor w x) y) (tensor w (tensor x y)) z z (associator w x y).1 (C.pre.idn z)))) ;
 triangle (x y : C.pre.ob) :
  Id (C.pre.hom (tensor (tensor x unit) y) (tensor x y))
   (C.pre.comp (tensor (tensor x unit) y) (tensor x (tensor unit y)) (tensor x y)
    (tmap x x (tensor unit y) y (C.pre.idn x) (left-unitor y).1) (associator x unit y).1)
   (tmap (tensor x unit) x y y (right-unitor x).1 (C.pre.idn y)) ;
} ;

record Symmetric (C : K.Category) {
 monoidal : Monoidal[C] ;
 braiding (x y : C.pre.ob) : C.pre.Iso (monoidal.tensor x y) (monoidal.tensor y x) ;
 braiding-natural (x x' y y' : C.pre.ob) (f : C.pre.hom x x') (g : C.pre.hom y y') :
  Id (C.pre.hom (monoidal.tensor x y) (monoidal.tensor y' x'))
   (C.pre.comp (monoidal.tensor x y) (monoidal.tensor x' y') (monoidal.tensor y' x')
    (braiding x' y').1 (monoidal.tmap x x' y y' f g))
   (C.pre.comp (monoidal.tensor x y) (monoidal.tensor y x) (monoidal.tensor y' x')
    (monoidal.tmap y y' x x' g f) (braiding x y).1) ;
 symmetry (x y : C.pre.ob) :
  Id (C.pre.hom (monoidal.tensor x y) (monoidal.tensor x y))
   (C.pre.comp (monoidal.tensor x y) (monoidal.tensor y x) (monoidal.tensor x y) (braiding y x).1 (braiding x y).1)
   (C.pre.idn (monoidal.tensor x y)) ;
 hexagon (x y z : C.pre.ob) :
  Id (C.pre.hom (monoidal.tensor (monoidal.tensor x y) z) (monoidal.tensor y (monoidal.tensor z x)))
   (C.pre.comp (monoidal.tensor (monoidal.tensor x y) z) (monoidal.tensor (monoidal.tensor y z) x)
    (monoidal.tensor y (monoidal.tensor z x))
    (monoidal.associator y z x).1
    (C.pre.comp (monoidal.tensor (monoidal.tensor x y) z) (monoidal.tensor x (monoidal.tensor y z))
     (monoidal.tensor (monoidal.tensor y z) x)
     (braiding x (monoidal.tensor y z)).1 (monoidal.associator x y z).1))
   (C.pre.comp (monoidal.tensor (monoidal.tensor x y) z) (monoidal.tensor y (monoidal.tensor x z))
    (monoidal.tensor y (monoidal.tensor z x))
    (monoidal.tmap y y (monoidal.tensor x z) (monoidal.tensor z x) (C.pre.idn y) (braiding x z).1)
    (C.pre.comp (monoidal.tensor (monoidal.tensor x y) z) (monoidal.tensor (monoidal.tensor y x) z)
     (monoidal.tensor y (monoidal.tensor x z))
     (monoidal.associator y x z).1
     (monoidal.tmap (monoidal.tensor x y) (monoidal.tensor y x) z z (braiding x y).1 (C.pre.idn z)))) ;
} ;

-- transport along an identification of categories
transport (C D : K.Category) (p : Id K.Category C D) (m : Monoidal[C]) : Monoidal[D] =
 P.subst K.Category (\ E -> Monoidal[E]) C D p m ;
transport-symmetric (C D : K.Category) (p : Id K.Category C D) (m : Symmetric[C]) : Symmetric[D] =
 P.subst K.Category (\ E -> Symmetric[E]) C D p m ;
