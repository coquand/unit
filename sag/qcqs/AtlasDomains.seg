-- A recovered transition identifies the correct overlap domains.
-- Let theta:X_A|d_AB -> X_B|d_BA be AtlasTransition's isomorphism,
-- and W any compact open of F.  Pull W back to the two charts, obtaining
-- d_AW,d_BW.  Then theta*(cut_B d_BW)=cut_A d_AW.
-- Test the equation on every affine probe p of the first overlap.
-- The two inverse images are the W-values of the two chart points,
-- by AtlasOverlap.classifier.  Those points of F agree by
-- AtlasTransition.chart-equation, so their W-values agree.  The source
-- overlap is qcqs, and GeometricOpenSeparation proves equality of opens.
-- In particular the equation includes the domains of triple transitions;
-- it is proved before asserting the cocycle equation on those domains.
level l ; open Ring[l] ;
module DL = DistLattice[l] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module TE = TestEquivalences[l] ;
module CO = CompactOpens[l] ;
module SP = Spaces[l] ;
module Op = OpenMaps[l] ;
module Over (F : SF.SetFunctor) (u v w : CO.Over[F].Open) (A B : T.Test)
 (ea : TE.NaturalEquivalence SF.Representable[A].functor OpenRealisation[l].Over[F,u].functor)
 (eb : TE.NaturalEquivalence SF.Representable[B].functor OpenRealisation[l].Over[F,v].functor) {
 module TR = AtlasTransition[l].Over[F,u,v,A,B,ea,eb] ;
 module WA = TR.CA.With[w] ;
 module WB = TR.CB.With[w] ;
 module SA = TR.Left.AR.GR.Sl ;
 module SB = TR.Right.AR.GR.Sl ;
 first : TR.Left.AR.space.lattice.L = DL.hmap (SP.underlying TR.G.forward).lat (SB.cut WB.AR.AC.extent) ;
 second : TR.Left.AR.space.lattice.L = SA.cut WA.AR.AC.extent ;
 module Point (C : T.Test) (p : SP.Hom (T.space C) TR.Left.AR.space) {
  first-image : Id T.At[C].Z.lattice.L (DL.hmap (SP.underlying p).lat first)
   (DL.hmap (SP.underlying (SP.compose (T.space C) TR.Right.AR.space (T.space B) (Op.inclusion (T.space B) TR.Right.AR.AC.extent)
    (SP.compose (T.space C) TR.Left.AR.space TR.Right.AR.space TR.G.forward p))).lat WB.AR.AC.extent) =
   refl (DL.hmap (SP.underlying p).lat first) ;
  second-image : Id T.At[C].Z.lattice.L (DL.hmap (SP.underlying p).lat second)
   (DL.hmap (SP.underlying (SP.compose (T.space C) TR.Left.AR.space (T.space A) (Op.inclusion (T.space A) TR.Left.AR.AC.extent) p)).lat WA.AR.AC.extent) =
   refl (DL.hmap (SP.underlying p).lat second) ;
  equation : Id T.At[C].Z.lattice.L (DL.hmap (SP.underlying p).lat first) (DL.hmap (SP.underlying p).lat second) =
   trans first-image
    (trans (WB.classifier C (SP.compose (T.space C) TR.Right.AR.space (T.space B) (Op.inclusion (T.space B) TR.Right.AR.AC.extent)
      (SP.compose (T.space C) TR.Left.AR.space TR.Right.AR.space TR.G.forward p)))
     (trans (ap (CO.Over[F].value w C) TR.Point[C,p].chart-equation)
      (trans (sym (WA.classifier C (SP.compose (T.space C) TR.Left.AR.space (T.space A)
        (Op.inclusion (T.space A) TR.Left.AR.AC.extent) p))) (sym second-image)))) ;
 } ;
 equation : Id TR.Left.AR.space.lattice.L first second =
  GeometricOpenSeparation[l].Over[TR.Left.AR.space].Compare[first,second,\ C p -> Point[C,p].equation].equal TR.Left.AR.qcqs ;
} ;
