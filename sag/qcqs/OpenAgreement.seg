-- Equality on an intersection gives the component agreement used by gluing.
-- Let f : X|e0 -> Y and g : X|e1 -> Y agree after restriction to
-- X|(e0 /\ e1).  The lattice trace of restriction is p(v) /\ (e0 /\ e1).
-- Since p(v) <= e0, this is p(v) /\ e1; the other side is q(v) /\ e0.
-- Taking the lattice component of the equality proves overlap agreement.
-- For sections, w = p(v) /\ q(v) lies below e0 /\ e1.  Equal restricted
-- maps give equal images restricted to w (MapAgreement.restrict-eq).
-- OpenMaps.Below.Pull.trace identifies these with the original section
-- maps restricted to w.  These are MapGluing's exact two hypotheses.
level l ; open Ring[l] ;
module DL = DistLattice[l] ;
module Sp = Spaces[l] ;
module Op = OpenMaps[l] ;
module RM = RingMaps[l] ;
module Over (X Y : Sp.Space) (e0 e1 : X.lattice.L)
 (f : Sp.Hom (Op.space X e0) Y) (g : Sp.Hom (Op.space X e1) Y) {
 module O = DL.Order[X.lattice] ;
 module S0 = Op.At[X,e0].Sl ;
 module S1 = Op.At[X,e1].Sl ;
 module SW = Op.At[X,X.lattice.meet e0 e1].Sl ;
 module GO = RingedLattice[l].On[X.lattice].Of[X.structure.sheaf] ;
 module B0 = Op.Below[X,X.lattice.meet e0 e1,e0,O.meet-left e0 e1] ;
 module B1 = Op.Below[X,X.lattice.meet e0 e1,e1,O.meet-right e0 e1] ;
 module P0 = B0.Pull[Y,f] ;
 module P1 = B1.Pull[Y,g] ;
 first (v : Y.lattice.L) : X.lattice.L = S0.inc (DL.hmap (Sp.underlying f).lat v) ;
 second (v : Y.lattice.L) : X.lattice.L = S1.inc (DL.hmap (Sp.underlying g).lat v) ;
 left-cut (v : Y.lattice.L) : Id X.lattice.L (X.lattice.meet (first v) (X.lattice.meet e0 e1)) (X.lattice.meet (first v) e1) =
  trans (X.lattice.meetA (first v) e0 e1) (ap (\ a -> X.lattice.meet a e1) (S0.below (DL.hmap (Sp.underlying f).lat v))) ;
 right-cut (v : Y.lattice.L) : Id X.lattice.L (X.lattice.meet (second v) (X.lattice.meet e0 e1)) (X.lattice.meet (second v) e0) =
  trans (ap (X.lattice.meet (second v)) (X.lattice.meetC e0 e1))
   (trans (X.lattice.meetA (second v) e1 e0) (ap (\ a -> X.lattice.meet a e0) (S1.below (DL.hmap (Sp.underlying g).lat v)))) ;
 module Equal (eq : Id (Sp.Hom (Op.space X (X.lattice.meet e0 e1)) Y) P0.C.composite P1.C.composite) {
  overlap (v : Y.lattice.L) : Id X.lattice.L (X.lattice.meet (first v) e1) (X.lattice.meet (second v) e0) =
   trans (sym (left-cut v)) (trans (sym (P0.lattice-trace v))
    (trans (ap (\ h -> SW.inc (DL.hmap (Sp.underlying h).lat v)) eq) (trans (P1.lattice-trace v) (right-cut v)))) ;
  module At (v : Y.lattice.L) {
   w : X.lattice.L = X.lattice.meet (first v) (second v) ;
   below : O.Le w (X.lattice.meet e0 e1) =
    O.meet-glb e0 e1 w
     (O.le-trans w (first v) e0 (O.meet-left (first v) (second v)) (S0.below (DL.hmap (Sp.underlying f).lat v)))
     (O.le-trans w (second v) e1 (O.meet-right (first v) (second v)) (S1.below (DL.hmap (Sp.underlying g).lat v))) ;
   module MA = MapAgreement[l].Maps[Y.lattice,SW.lattice,Y.structure.sheaf,SW.sheaf] ;
   agree (s : (Y.structure.sheaf.ring v).R) : Id (X.structure.sheaf.ring w).R
    (GO.restrict w (first v) (O.meet-left (first v) (second v)) (RM.map ((Sp.underlying f).sharp v) s))
    (GO.restrict w (second v) (O.meet-right (first v) (second v)) (RM.map ((Sp.underlying g).sharp v) s)) =
    trans (sym (P0.trace v w below (O.meet-left (first v) (second v)) s))
     (trans (MA.restrict-eq (Sp.underlying P0.C.composite) (Sp.underlying P1.C.composite)
       (ap (Sp.underlying {Op.space X (X.lattice.meet e0 e1)} {Y}) eq) v (P0.at w below)
       (P0.at-le v w below (O.meet-left (first v) (second v))) (P1.at-le v w below (O.meet-right (first v) (second v))) s)
      (P1.trace v w below (O.meet-right (first v) (second v)) s)) ;
  } ;
 } ;
} ;
