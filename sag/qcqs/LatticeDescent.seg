-- Gluing the inverse-image maps on a finite cover (functor-of-points note).
-- The local maps p_i preserve bottom, joins and meets, and send top to e_i.
-- They take values below e_i.  On overlaps p_i(u) /\ e_j <= p_j(u).
-- Define p(u) = join_i p_i(u).  Each p_i(u) <= p(u); distributivity and
-- overlap agreement give p(u) /\ e_i = p_i(u).  Bottom is preserved since
-- every p_i(bot) is bottom.  Top, joins and meets can be checked after
-- meeting with every e_i (LatticeCover.ext); the local laws give them.
-- Thus p is a lattice map, with the stated restrictions.  Its uniqueness
-- follows from the same cover extensionality.  Empty covers are included.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module DL = DistLattice[l] ;
module Over (L M : DL.DLat) (n : Nat) (es : Fin n -> M.L)
 (covers : DL.Order[M].Le M.top (DL.Joins[M].bigJ n es))
 (parts : Fin n -> L.L -> M.L)
 (below : (i : Fin n) (u : L.L) -> DL.Order[M].Le (parts i u) (es i))
 (bottom : (i : Fin n) -> Id M.L (parts i L.bot) M.bot)
 (top : (i : Fin n) -> Id M.L (parts i L.top) (es i))
 (joins : (i : Fin n) (u v : L.L) -> Id M.L (parts i (L.join u v)) (M.join (parts i u) (parts i v)))
 (meets : (i : Fin n) (u v : L.L) -> Id M.L (parts i (L.meet u v)) (M.meet (parts i u) (parts i v)))
 (overlap : (i j : Fin n) (u : L.L) -> DL.Order[M].Le (M.meet (parts i u) (es j)) (parts j u)) {
 module O = DL.Order[M] ;
 module J = DL.Joins[M] ;
 module LC = LatticeCover[l].Over[M,n,es,covers] ;
 image (u : L.L) : M.L = J.bigJ n (\ i -> parts i u) ;
 part-le (i : Fin n) (u : L.L) : O.Le (parts i u) (image u) = J.below n (\ j -> parts j u) i ;
 intersection (u : L.L) (i : Fin n) : Id M.L (M.meet (image u) (es i)) (parts i u) =
  O.le-antisym (M.meet (image u) (es i)) (parts i u)
   (O.le-trans (M.meet (image u) (es i)) (J.bigJ n (\ j -> M.meet (parts j u) (es i))) (parts i u)
     (J.meet-join-right n (\ j -> parts j u) (es i))
     (J.least n (\ j -> M.meet (parts j u) (es i)) (parts i u) (\ j -> overlap j i u)))
   (O.meet-glb (image u) (es i) (parts i u) (part-le i u) (below i u)) ;
 image-bot : Id M.L (image L.bot) M.bot =
  O.le-antisym (image L.bot) M.bot
   (J.least n (\ i -> parts i L.bot) M.bot (\ i -> O.le-of-eq (parts i L.bot) M.bot (bottom i))) (O.bot-le (image L.bot)) ;
 image-top : Id M.L (image L.top) M.top =
  LC.ext (image L.top) M.top (\ i -> trans (intersection L.top i) (trans (top i) (sym (O.top-meet (es i))))) ;
 image-join (u v : L.L) : Id M.L (image (L.join u v)) (M.join (image u) (image v)) =
  LC.ext (image (L.join u v)) (M.join (image u) (image v)) (\ i -> calc M.L {
   M.meet (image (L.join u v)) (es i) =< intersection (L.join u v) i > parts i (L.join u v)
    =< joins i u v > M.join (parts i u) (parts i v)
    =< cong2 M.L M.join _ _ _ _ (sym (intersection u i)) (sym (intersection v i))
     > M.join (M.meet (image u) (es i)) (M.meet (image v) (es i))
    =< sym (DoubleLattice[l].Over[M,es i].join-d (image u) (image v)) > M.meet (M.join (image u) (image v)) (es i) }) ;
 image-meet (u v : L.L) : Id M.L (image (L.meet u v)) (M.meet (image u) (image v)) =
  LC.ext (image (L.meet u v)) (M.meet (image u) (image v)) (\ i -> calc M.L {
   M.meet (image (L.meet u v)) (es i) =< intersection (L.meet u v) i > parts i (L.meet u v)
    =< meets i u v > M.meet (parts i u) (parts i v)
    =< cong2 M.L M.meet _ _ _ _ (sym (intersection u i)) (sym (intersection v i))
     > M.meet (M.meet (image u) (es i)) (M.meet (image v) (es i))
    =< sym (DoubleLattice[l].Over[M,es i].meet-d (image u) (image v)) > M.meet (M.meet (image u) (image v)) (es i) }) ;
 lat : DL.Hom L M = (image,image-bot,image-top,image-join,image-meet) ;
 covered (u : L.L) : O.Le (image u) (J.bigJ n (\ i -> parts i u)) = O.le-refl (image u) ;
 unique (h : DL.Hom L M) (on : (u : L.L) (i : Fin n) -> Id M.L (M.meet (DL.hmap h u) (es i)) (parts i u)) : Id (DL.Hom L M) h lat =
  DL.HomProperties[L,M].ext h lat (\ u -> LC.ext (DL.hmap h u) (image u) (\ i -> trans (on u i) (sym (intersection u i)))) ;
 opaque image ;
} ;
