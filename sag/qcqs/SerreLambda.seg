-- The canonical localisation map at any open (Serre note, Section 4).
-- For an open a, restrict M to the slice X|a, whose top is a and whose
-- ring at the top is O(a). The checked canonical map at the top of that
-- slice is lambda_(a,g) : M(a)_g -> M(D_a(g)) for g in O(a), with
-- x/g^r |-> (g|D_a g)^-r (x|D_a g). The invertibility open of the slice
-- has underlying open D_a(g) by definition, and its sections are those of
-- M; so no new map is written, only the instance on the slice.
-- No quasi-coherence or model is used.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module DL = DistLattice[l] ;
module MS = SerreModuleSheaf[l] ;
module On (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged)
 (M : MS.On[L,X.sheaf].ModuleSheaf) (a : L.L) {
 module S = Slice[l].Over[L,X,a] ;
 module R = SerreModuleSheafRestriction[l].On[L,X,a,M] ;
 module MO = MS.On[L,X.sheaf].Of[M.presheaf] ;
 module LX = LocallyRinged[l].On[L].Laws[X.sheaf,X.inv] ;
 module At (g : (X.sheaf.ring a).R) {
  module C = SerreSectionLocalisationMap[l].On[S.lattice,S.restricted,R.restricted].At[g] ;
  -- D_a(g), the underlying open of the slice's invertibility open
  open-g : L.L = LX.d a g ;
  open-g-inc : Id L.L (S.inc C.open-f) open-g = refl open-g ;
  below : DL.Order[L].Le open-g a = S.le-inc C.open-f S.lattice.top C.below ;
  -- M(a)_g, the native localisation over O(a)
  Source : U l = C.E.S.Carrier ;
  fraction (x : (M.presheaf.module-at a).M) (p : Nat) : Source = C.E.S.fraction x p ;
  map (z : Source) : (M.presheaf.module-at open-g).M = C.map z ;
  on-original (x : (M.presheaf.module-at a).M) :
   Id (M.presheaf.module-at open-g).M (map (fraction x zero)) (MO.restrict open-g a below x) =
   C.on-original x ;
  on-fraction (x : (M.presheaf.module-at a).M) (p : Nat) :
   Id (M.presheaf.module-at open-g).M (map (fraction x p))
    (C.E.InverseAction.back p (MO.restrict open-g a below x)) =
   C.on-fraction x p ;
  IsEquivalence : U l = Pr.isEquiv Source (M.presheaf.module-at open-g).M map ;
 } ;
} ;
