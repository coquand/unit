-- Clearing finitely many errors (Serre note, degree-zero and degree-one).
-- A power killing an error can be increased: multiply its zero equation
-- by the missing power. Choose all witnesses under truncation and bound
-- their exponents by the nested finite sum. The resulting single power
-- kills every matrix or triple error, including an empty family.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module SM = SerreModule[l] ; module NB = NatBound[l] ;
module CF = SerreModuleClearFinite[l] ;
module Over (A : CRing) {
 module P = AffinePowers[l].Over[A] ;
 module Along (Md Nd : SM.Over[A].Module)
  (phi : SerreModuleMaps[l].Between[A,A,RingHom[l].identity A,Md,Nd].Hom) {
  module H = SerreModuleMaps[l].Between[A,A,RingHom[l].identity A,Md,Nd] ;
  module S = SM.Over[A].Laws[Md] ; module T = SM.Over[A].Laws[Nd] ;
  map-sub (x y : Md.M) : Id Nd.M (H.map phi (S.sub x y)) (T.sub (H.map phi x) (H.map phi y)) =
   trans (ap (H.map phi) (S.sub-at x y))
    (trans (H.map-add phi x (Md.mneg y))
     (trans (ap (Nd.madd (H.map phi x)) (H.map-neg phi y)) (sym (T.sub-at (H.map phi x) (H.map phi y))))) ;
 } ;
 module At (Md : SM.Over[A].Module) (f : A.R) (x : Md.M) {
  module ML = SM.Over[A].Laws[Md] ;
  Witness : U l = (p : Nat) * Id Md.M (Md.sm (P.power f p) x) Md.mz ;
  exponent (w : Witness) : Nat = w.1 ;
  equation (w : Witness) : Id Md.M (Md.sm (P.power f (exponent w)) x) Md.mz = w.2 ;
  raised (w : Witness) (r : Nat) (above : NB.Above (exponent w) r) :
   Id Md.M (Md.sm (P.power f r) x) Md.mz =
   trans (sym (CF.Over[A].Action[Md].raise f (exponent w) r above x))
    (trans (ap (Md.sm (P.power f (NB.excess above))) (equation w)) (ML.sm-zero (P.power f (NB.excess above)))) ;
 } ;
 module Matrix (n m : Nat) (Ms : Fin n -> Fin m -> SM.Over[A].Module)
  (fs : Fin n -> Fin m -> A.R) (xs : (i : Fin n) (j : Fin m) -> (Ms i j).M) {
  module Index (i : Fin n) (j : Fin m) { module K = At[Ms i j,fs i j,xs i j] ; } ;
  Witnesses : U l = (i : Fin n) (j : Fin m) -> Index[i,j].K.Witness ;
  Common : U l = (r : Nat) * ((i : Fin n) (j : Fin m) ->
   Id (Ms i j).M ((Ms i j).sm (P.power (fs i j) r) (xs i j)) (Ms i j).mz) ;
  module Chosen (ws : Witnesses) {
   exponents (i : Fin n) (j : Fin m) : Nat = Index[i,j].K.exponent (ws i j) ;
   bound : Nat = CF.bound2 n m exponents ;
   equations (i : Fin n) (j : Fin m) :
    Id (Ms i j).M ((Ms i j).sm (P.power (fs i j) bound) (xs i j)) (Ms i j).mz =
    Index[i,j].K.raised (ws i j) bound (CF.bound2-above n m exponents i j) ;
   common : Common = (bound,equations) ;
  } ;
  common (ws : (i : Fin n) (j : Fin m) -> Tr.Trunc[Index[i,j].K.Witness].carrier) : Tr.Trunc[Common].carrier =
   Tr.Trunc[Witnesses].induction @l (\ w -> Tr.Trunc[Common].carrier) (\ w -> Tr.Trunc[Common].proposition)
    (\ w -> Tr.Trunc[Common].inc Chosen[w].common)
    (CF.choice2 n m (\ i j -> Index[i,j].K.Witness) ws) ;
 } ;
 module Cube (n m k : Nat) (Ms : Fin n -> Fin m -> Fin k -> SM.Over[A].Module)
  (fs : Fin n -> Fin m -> Fin k -> A.R) (xs : (i : Fin n) (j : Fin m) (t : Fin k) -> (Ms i j t).M) {
  module Index (i : Fin n) (j : Fin m) (t : Fin k) { module K = At[Ms i j t,fs i j t,xs i j t] ; } ;
  Witnesses : U l = (i : Fin n) (j : Fin m) (t : Fin k) -> Index[i,j,t].K.Witness ;
  Common : U l = (r : Nat) * ((i : Fin n) (j : Fin m) (t : Fin k) ->
   Id (Ms i j t).M ((Ms i j t).sm (P.power (fs i j t) r) (xs i j t)) (Ms i j t).mz) ;
  module Chosen (ws : Witnesses) {
   exponents (i : Fin n) (j : Fin m) (t : Fin k) : Nat = Index[i,j,t].K.exponent (ws i j t) ;
   bound : Nat = CF.bound3 n m k exponents ;
   equations (i : Fin n) (j : Fin m) (t : Fin k) :
    Id (Ms i j t).M ((Ms i j t).sm (P.power (fs i j t) bound) (xs i j t)) (Ms i j t).mz =
    Index[i,j,t].K.raised (ws i j t) bound (CF.bound3-above n m k exponents i j t) ;
   common : Common = (bound,equations) ;
  } ;
  common (ws : (i : Fin n) (j : Fin m) (t : Fin k) -> Tr.Trunc[Index[i,j,t].K.Witness].carrier) : Tr.Trunc[Common].carrier =
   Tr.Trunc[Witnesses].induction @l (\ w -> Tr.Trunc[Common].carrier) (\ w -> Tr.Trunc[Common].proposition)
    (\ w -> Tr.Trunc[Common].inc Chosen[w].common)
    (CF.choice3 n m k (\ i j t -> Index[i,j,t].K.Witness) ws) ;
 } ;
} ;
