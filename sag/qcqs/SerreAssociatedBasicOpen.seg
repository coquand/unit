-- Evaluation of compatible module families on a basic open.
-- A section on D(g) evaluates at g. Conversely x in M_g restricts to
-- every basic open below D(g); composition proves compatibility.
-- Restricting back at g is the identity, and extending the value of a
-- section recovers it by compatibility and proof independence. Evaluation
-- is semilinear over the existing ring evaluation O(D(g))->A_g.
-- This generic comparison uses no cover and no sheafhood assumption.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module RH = RingHom[l] ; module RM = RingMaps[l] ;
module MM = SerreModuleMaps[l] ;
module Over (A : CRing) (Loc : A.R -> CRing) (set : (g : A.R) -> Pr.isSet (Loc g).R)
 (f : (g : A.R) -> RH.Hom A (Loc g))
 (el : (g : A.R) -> Bridge[l].Over[A,g].LocH.Elementary (Loc g) (f g))
 (B : SerreAssociatedSections[l].Over[A,Loc,set,f,el].System) {
 module G = SerreAssociatedSections[l].Over[A,Loc,set,f,el] ;
 module N = G.Of[B] ; module Z = G.Z ; module O = Z.O ;
 module RingBasic = BasicOpen[l].Over[A,Loc,set,f,el] ;
 module At (g : A.R) {
  gg : O.Le (Z.D g) (Z.D g) = O.le-refl (Z.D g) ;
  eval (s : N.Section (Z.D g)) : (B.module-at g).M = N.at s g gg ;
  extend (x : (B.module-at g).M) : N.Section (Z.D g) =
   (\ h k -> N.rho g h k x,\ h j hg jh ->
    B.res-comp g h j hg jh (O.le-trans (Z.D j) (Z.D h) (Z.D g) jh hg) x) ;
  extend-at (x : (B.module-at g).M) (h : A.R) (k : O.Le (Z.D h) (Z.D g)) :
   Id (B.module-at h).M (N.at (extend x) h k) (N.rho g h k x) = refl (N.rho g h k x) ;
  eval-extend (x : (B.module-at g).M) : Id (B.module-at g).M (eval (extend x)) x =
   trans (extend-at x g gg) (B.res-id g gg x) ;
  extend-eval (s : N.Section (Z.D g)) : Id (N.Section (Z.D g)) (extend (eval s)) s =
   N.section-ext (Z.D g) (extend (eval s)) s (\ h k ->
    trans (extend-at (eval s) h k)
     (trans (N.compat s g h gg k)
      (N.component-irr (Z.D g) s h (O.le-trans (Z.D h) (Z.D g) (Z.D g) k gg) k))) ;
  module Maps = MM.Between[G.S.ring (Z.D g),Loc g,RingBasic.At[g].evaluation,N.Ops[Z.D g].section-module,B.module-at g] ;
  evaluation : Maps.Hom = new Maps.Hom[eval,
   \ s t -> N.Ops[Z.D g].add-at s t g gg,
   \ r s -> trans (N.Ops[Z.D g].scale-at r s g gg)
    (ap (\ a -> (B.module-at g).sm a (eval s)) (sym (RingBasic.At[g].evaluation-map r)))] ;
  evaluation-at (s : N.Section (Z.D g)) : Id (B.module-at g).M (Maps.map evaluation s) (eval s) = refl (eval s) ;
  equivalence : Pr.isEquiv (N.Section (Z.D g)) (B.module-at g).M (Maps.map evaluation) =
   Pr.qinv (N.Section (Z.D g)) (B.module-at g).M (Maps.map evaluation) extend
    (\ x -> trans (evaluation-at (extend x)) (eval-extend x))
    (\ s -> trans (ap extend (evaluation-at s)) (extend-eval s)) ;
  opaque evaluation ;
  opaque extend ;
 } ;
 natural (g h : A.R) (le : O.Le (Z.D h) (Z.D g)) (s : N.Section (Z.D g)) :
  Id (B.module-at h).M (At[h].eval (N.restrict (Z.D h) (Z.D g) le s)) (N.rho g h le (At[g].eval s)) =
  trans (N.restrict-at (Z.D h) (Z.D g) le s h At[h].gg)
   (trans (N.component-irr (Z.D g) s h
    (O.le-trans (Z.D h) (Z.D h) (Z.D g) At[h].gg le)
    (O.le-trans (Z.D h) (Z.D g) (Z.D g) le At[g].gg))
    (sym (N.compat s g h At[g].gg le))) ;
} ;
