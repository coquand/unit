-- An isomorphism of spaces induces a natural equivalence of point functors.
-- The inverse on B-valued points is postcomposition with the inverse map.
-- Both inverse equations follow from associativity, the corresponding
-- geometric inverse equation, and the left unit law.  The forward family
-- is the existing induced natural transformation, with no new map notion.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Sp = Spaces[l] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module TE = TestEquivalences[l] ;
module Over (X Y : Sp.Space) (f : Sp.Hom X Y) (iso : Sp.IsIso X Y f) {
 module V = Sp.InvertMap[X,Y,f,iso] ;
 module At (B : T.Test) {
  forward (p : Sp.Hom (T.space B) X) : Sp.Hom (T.space B) Y = Sp.compose (T.space B) X Y f p ;
  backward (p : Sp.Hom (T.space B) Y) : Sp.Hom (T.space B) X = Sp.compose (T.space B) Y X V.inverse p ;
  right (p : Sp.Hom (T.space B) Y) : Id (Sp.Hom (T.space B) Y) (forward (backward p)) p =
   trans Sp.Associativity[T.space B,Y,X,Y,f,V.inverse,p].assoc
    (trans (ap (\ h -> Sp.compose (T.space B) Y Y h p) V.inverse-right) Sp.Laws[T.space B,Y,p].left) ;
  left (p : Sp.Hom (T.space B) X) : Id (Sp.Hom (T.space B) X) (backward (forward p)) p =
   trans Sp.Associativity[T.space B,X,Y,X,V.inverse,f,p].assoc
    (trans (ap (\ h -> Sp.compose (T.space B) X X h p) V.inverse-left) Sp.Laws[T.space B,X,p].left) ;
 } ;
 equivalence : TE.NaturalEquivalence SF.Geometric[X].functor SF.Geometric[Y].functor =
  (SF.GeometricMaps[X,Y].from-points (FunctorPoints[l].Maps[X,Y].induced f),\ B ->
   Pr.qinv (Sp.Hom (T.space B) X) (Sp.Hom (T.space B) Y) At[B].forward At[B].backward At[B].right At[B].left) ;
} ;
