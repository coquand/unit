-- Nested restriction: for u <= e, (X|e)|u is isomorphic to X|u.
-- An open of the first is a v <= e together with v <= u.  Forget the
-- redundant bound by e; the inverse restores it by v <= u <= e.
-- They are inverse by extensionality of the subtypes.  Forgetting preserves
-- the lattice operations by definition, as do the section rings; the
-- section maps are identities.  Naturality is proof-independence of
-- restriction, after spelling out the restrictions in both slices.
-- Thus the map is an isomorphism; it is local by Iso.Local.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module DL = DistLattice[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module Over (M : DL.DLat) (X : LocallyRinged[l].On[M].LocallyRinged) (e : M.L)
 (u : Slice[l].Over[M,X,e].Opens) {
 module O = DL.Order[M] ;
 module GO = RingedLattice[l].On[M].Of[X.sheaf] ;
 module S = Slice[l].Over[M,X,e] ;
 module Single = Slice[l].Over[M,X,S.inc u] ;
 module Nested = Slice[l].Over[S.lattice,S.restricted,u] ;
 flatten (v : Nested.Opens) : Single.Opens =
  (S.inc (Nested.inc v),S.le-inc (Nested.inc v) u (Nested.below v)) ;
 inner (v : Single.Opens) : S.Opens =
  (Single.inc v,O.le-trans (Single.inc v) (S.inc u) e (Single.below v) (S.below u)) ;
 restore (v : Single.Opens) : Nested.Opens = (inner v,S.le-in (inner v) u (Single.below v)) ;
 flatten-restore (v : Single.Opens) : Id Single.Opens (flatten (restore v)) v =
  Single.ext (flatten (restore v)) v (refl (Single.inc v)) ;
 restore-flatten (v : Nested.Opens) : Id Nested.Opens (restore (flatten v)) v =
  Nested.ext (restore (flatten v)) v (S.ext (Nested.inc (restore (flatten v))) (Nested.inc v) (refl (S.inc (Nested.inc v)))) ;
 lat : DL.Hom Nested.lattice Single.lattice =
  (flatten,Single.ext (flatten Nested.botS) Single.botS (refl M.bot),
   Single.ext (flatten Nested.topS) Single.topS (refl (S.inc u)),
   \ v w -> Single.ext (flatten (Nested.joinS v w)) (Single.joinS (flatten v) (flatten w)) (refl (M.join (S.inc (Nested.inc v)) (S.inc (Nested.inc w)))),
   \ v w -> Single.ext (flatten (Nested.meetS v w)) (Single.meetS (flatten v) (flatten w)) (refl (M.meet (S.inc (Nested.inc v)) (S.inc (Nested.inc w))))) ;
 module MP = LocallyRinged[l].Maps[Nested.lattice,Single.lattice,Nested.sheaf,Single.sheaf] ;
 sharp (v : Nested.Opens) : RH.Hom (Nested.sheaf.ring v) (Single.sheaf.ring (DL.hmap lat v)) =
  RH.identity (X.sheaf.ring (S.inc (Nested.inc v))) ;
 natural (v w : Nested.Opens) (k : Nested.OS.Le v w) (s : (Nested.sheaf.ring w).R) :
  Id (Single.sheaf.ring (DL.hmap lat v)).R
   (Single.SO.restrict (DL.hmap lat v) (DL.hmap lat w) (DL.JoinMaps[Nested.lattice,Single.lattice,lat].monotone v w k) (map (sharp w) s))
   (map (sharp v) (Nested.SO.restrict v w k s)) =
  trans (Single.res-inc (DL.hmap lat v) (DL.hmap lat w) (DL.JoinMaps[Nested.lattice,Single.lattice,lat].monotone v w k) s)
   (trans (GO.res-irr (S.inc (Nested.inc v)) (S.inc (Nested.inc w))
     (Single.le-inc (DL.hmap lat v) (DL.hmap lat w) (DL.JoinMaps[Nested.lattice,Single.lattice,lat].monotone v w k))
     (S.le-inc (Nested.inc v) (Nested.inc w) (Nested.le-inc v w k)) s)
    (trans (sym (S.res-inc (Nested.inc v) (Nested.inc w) (Nested.le-inc v w k) s)) (sym (Nested.res-inc v w k s)))) ;
 morphism : MP.Ringed = new MP.Ringed[lat,sharp,natural] ;
 module I = Iso[l].Maps[Nested.lattice,Single.lattice,Nested.sheaf,Single.sheaf] ;
 iso : I.IsIso morphism =
  (Pr.qinv Nested.Opens Single.Opens flatten restore flatten-restore restore-flatten,
   \ v -> Pr.qinv (Nested.sheaf.ring v).R (Single.sheaf.ring (DL.hmap lat v)).R (map (sharp v)) (\ s -> s)
    (\ s -> refl s) (\ s -> refl s)) ;
 local : MP.Of[morphism,Nested.inv,Single.inv].IsLocal = I.Local[morphism,iso,Nested.inv,Single.inv].local ;
} ;
