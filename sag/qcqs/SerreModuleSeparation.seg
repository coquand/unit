-- Uniqueness in degree-zero module gluing (Serre note, Section 3).
-- If x/1 is zero on each member of a finite principal cover, the fraction
-- criterion and finite choice give killing exponents. Their finite sum
-- is a common bound. Thus every f_i raised to that bound annihilates x.
-- The unit-ideal powers lemma supplies a partition of one by these powers;
-- applying that partition to x proves x=0. This includes the empty cover.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module SM = SerreModule[l] ; module LC = SerreModuleLocalisation[l] ;
module NB = NatBound[l] ;
module Over (A : CRing) (Md : SM.Over[A].Module) {
 module ML = SM.Over[A].Laws[Md] ;
 module P = AffinePowers[l].Over[A] ;
 module Z = ZariskiLattice[l].Over[A] ;
 module S = FiniteIdeal[l].Sums[A] ;
 module MS = SerreModuleSums[l].Over[A,Md] ;
 module Cover (n : Nat) (fs : Fin n -> A.R)
  (covers : Z.O.Le Z.lattice.top (Z.J.bigJ n (\ i -> Z.D (fs i)))) {
  module Powers = SerreUnitIdealPowers[l].Over[A].Family[n,fs,covers] ;
  module At (i : Fin n) { module L = LC.At[A,Md,fs i] ; } ;
  Killers (x : Md.M) : U l = (i : Fin n) -> At[i].L.Killed x ;
  killers (x : Md.M)
   (vanishes : (i : Fin n) -> Id At[i].L.Carrier (At[i].L.fraction x zero) (At[i].L.fraction Md.mz zero)) :
   Tr.Trunc[Killers x].carrier = AffineFinite[l].choice n (\ i -> At[i].L.Killed x)
    (\ i -> At[i].L.zero-killed x (vanishes i)) ;
  module Killed (x : Md.M) (ks : Killers x) {
   exponents (i : Fin n) : Nat = (ks i).1 ;
   bound : Nat = NB.bound n exponents ;
   killed-at (i : Fin n) : Id Md.M (At[i].L.power bound x) Md.mz =
    trans (ap (\ r -> At[i].L.power r x) (sym (NB.excess-eq (NB.bound-above n exponents i))))
     (trans (At[i].L.power-add (exponents i) (NB.excess (NB.bound-above n exponents i)) x)
      (trans (At[i].L.power-comm (exponents i) (NB.excess (NB.bound-above n exponents i)) x)
       (trans (ap (At[i].L.power (NB.excess (NB.bound-above n exponents i))) (ks i).2)
        (At[i].L.power-zero (NB.excess (NB.bound-above n exponents i)))))) ;
   scalar-killed (i : Fin n) : Id Md.M (Md.sm (Powers.powers bound i) x) Md.mz =
    trans (ap (\ a -> Md.sm a x) (Powers.powers-at bound i))
     (trans (sym (At[i].L.power-scalar bound x)) (killed-at i)) ;
   module Partition (coeffs : Radical[l].Over[A].InIdeal (n,Powers.powers bound) A.o) {
    coefficient (i : Fin n) : A.R = coeffs.1 i ;
    weights (i : Fin n) : A.R = A.mul (Powers.powers bound i) (coefficient i) ;
    one : Id A.R (S.sum n weights) A.o = coeffs.2 ;
    annihilate (i : Fin n) : Id Md.M (Md.sm (weights i) x) Md.mz =
     trans (sym (Md.smA (Powers.powers bound i) (coefficient i) x))
      (trans (ML.sm-swap (Powers.powers bound i) (coefficient i) x)
       (trans (ap (Md.sm (coefficient i)) (scalar-killed i)) (ML.sm-zero (coefficient i)))) ;
    zero : Id Md.M x Md.mz = MS.partition-zero n weights one x annihilate ;
   } ;
   zero : Id Md.M x Md.mz =
    Tr.Trunc[Radical[l].Over[A].InIdeal (n,Powers.powers bound) A.o].induction @l
     (\ t -> Id Md.M x Md.mz) (\ t -> Md.setM x Md.mz) (\ c -> Partition[c].zero) (Powers.coefficients bound) ;
  } ;
  separated (x : Md.M)
   (vanishes : (i : Fin n) -> Id At[i].L.Carrier (At[i].L.fraction x zero) (At[i].L.fraction Md.mz zero)) :
   Id Md.M x Md.mz =
   Tr.Trunc[Killers x].induction @l (\ t -> Id Md.M x Md.mz) (\ t -> Md.setM x Md.mz)
    (\ ks -> Killed[x,ks].zero) (killers x vanishes) ;
 } ;
} ;
