-- The global sections of the projective line (DESIGN.md, Next 5, step 4):
-- Gamma(P^1_k) = k, for any commutative ring k.
--
-- A = k[X], Y = Spec A, d = D(X), Y|d its punctured part with
-- Gamma(Y|d) = O(d), phi = extend : L = A[1/X] -> O(d) (SpecBasicOpen), and
-- theta the automorphism of Y|d with Gamma(theta)(phi y) = phi(sigma y)
-- (PuncturedChart).  A global section of P^1 is a pair (s, t) of global
-- sections of Y with s|(top /\ d) = theta#(t|(top /\ d)) (GlueAlong).
-- Restrict this equation to d (an equal open, so the restriction is
-- injective, Iso.EqualOpens).
-- Lemma (left).  (s|(top /\ d))|d = phi(f(a)) for s = a|top: it is the
--  global component of the inclusion at a (SpecBasicOpen.cut-component).
-- Lemma (right).  ((theta#(t|(top /\ d)))|...)|d = phi(sigma(f(b))) for
--  t = b|top: by res-comp it is the global component of theta . inclusion at
--  b, i.e. Gamma(theta) of the global component of the inclusion
--  (SpecHom.Precompose), and Gamma(theta)(phi(f b)) = phi(sigma(f b)).
-- Hence (phi injective, BasicOpen) (s, t) is a section iff f(a) = sigma(f(b)).
-- Theorem.  a |-> (a|top, a|top) is a ring isomorphism k -> Gamma(P^1), with
--  inverse (s, t) |-> coef_0(a): the pair is a section since sigma fixes k
--  (Inversion.sigma-k); conversely f(a) = sigma(f(b)) gives a = b, a
--  constant (InversionOverlap), so (s, t) = (coef_0(a)|top, coef_0(a)|top).
--  In particular s = t (equal-components).
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) {
 module PL = ProjectiveLine[l].Over[k,setk] ;
 module PC = PL.PC ;
 module SB = PL.SB ;
 module I = PC.I ;
 module P = I.P ;
 module GT = PL.GT ;
 module GA = GT.GA ;
 module PB = GT.PB ;
 module Sl = SB.Sl ;
 module UA = SB.UA ;
 module Gb = SB.Gb ;
 module IO = InversionOverlap[l].Over[k,setk] ;
 module FP = GA.At[PB.lattice.top].P ;
 -- Gamma(theta) after the inclusion
 module PRE = SpecHom[l].Precompose[P.ring,P.set,SB.SA.Loc,SB.SA.set,SB.SA.inclusion,SB.SA.elementary,
  Sl.lattice,Sl.restricted,Sl.lattice,Sl.restricted,PC.automorphism,Sl.inclusion] ;

 -- restriction from top /\ d to d, injective
 to-d (w : (Sl.sheaf.ring (GA.mid PB.lattice.top)).R) : (Sl.restricted.sheaf.ring Sl.lattice.top).R =
  UA.GO.restrict Sl.lattice.top (GA.mid PB.lattice.top) (UA.psi-top Sl.inclusion) w ;
 to-d-injective (w w2 : (Sl.sheaf.ring (GA.mid PB.lattice.top)).R) (e : Id (Sl.restricted.sheaf.ring Sl.lattice.top).R (to-d w) (to-d w2)) :
  Id (Sl.sheaf.ring (GA.mid PB.lattice.top)).R w w2 =
  Iso[l].injective (Sl.sheaf.ring (GA.mid PB.lattice.top)).R (Sl.sheaf.ring Sl.lattice.top).R to-d
   (Iso[l].EqualOpens[Sl.lattice,Sl.sheaf,Sl.lattice.top,GA.mid PB.lattice.top,UA.psi-top Sl.inclusion,
     Sl.OS.le-top (GA.mid PB.lattice.top)].equiv) w w2 e ;
 -- phi is injective
 phi-injective (y y2 : (SB.SA.Loc P.variable).R) (e : Id (Sl.restricted.sheaf.ring Sl.lattice.top).R (map SB.phi y) (map SB.phi y2)) :
  Id (SB.SA.Loc P.variable).R y y2 =
  trans (sym (SB.BO.At[P.variable].eval-extend y)) (trans (ap SB.BO.At[P.variable].eval e) (SB.BO.At[P.variable].eval-extend y2)) ;

 -- the two sides of the gluing equation, restricted to d
 left-trace (s : (SB.SA.spec.sheaf.ring SB.ZA.lattice.top).R) :
  Id (Sl.restricted.sheaf.ring Sl.lattice.top).R (to-d (map (Sl.inclusion.sharp (PB.first PB.lattice.top)) s))
   (map SB.phi (map (SB.SA.inclusion P.variable) (Gb.evaluate s))) = calc (Sl.restricted.sheaf.ring Sl.lattice.top).R {
  to-d (map (Sl.inclusion.sharp (PB.first PB.lattice.top)) s)
   =< refl (to-d (map (Sl.inclusion.sharp SB.ZA.lattice.top) s)) > to-d (map (Sl.inclusion.sharp SB.ZA.lattice.top) s)
   =< ap (\ t -> to-d (map (Sl.inclusion.sharp SB.ZA.lattice.top) t)) (sym (Gb.global-evaluate s))
    > to-d (map (Sl.inclusion.sharp SB.ZA.lattice.top) (map Gb.global (Gb.evaluate s)))
   =< sym (UA.component-map Sl.inclusion (Gb.evaluate s)) > map (UA.component Sl.inclusion) (Gb.evaluate s)
   =< SB.cut-component (Gb.evaluate s) > map SB.phi (map (SB.SA.inclusion P.variable) (Gb.evaluate s)) } ;
 -- the second side restricted to d, by res-comp
 mid-d : Sl.OS.Le Sl.lattice.top (GA.M2.p (PB.second PB.lattice.top)) =
  Sl.OS.le-trans Sl.lattice.top (GA.mid PB.lattice.top) (GA.M2.p (PB.second PB.lattice.top))
   (UA.psi-top Sl.inclusion) (GA.mid-second PB.lattice.top) ;
 leg2-d (t : (SB.SA.spec.sheaf.ring SB.ZA.lattice.top).R) :
  Id (Sl.restricted.sheaf.ring Sl.lattice.top).R (to-d (map (GA.leg2 PB.lattice.top) t))
   (UA.GO.restrict Sl.lattice.top (GA.M2.p (PB.second PB.lattice.top)) mid-d
     (map (GT.C.composite.sharp (PB.second PB.lattice.top)) t)) =
  Sl.restricted.sheaf.res-comp Sl.lattice.top (GA.mid PB.lattice.top) (GA.M2.p (PB.second PB.lattice.top))
   (UA.psi-top Sl.inclusion) (GA.mid-second PB.lattice.top) mid-d
   (map (GT.C.composite.sharp (PB.second PB.lattice.top)) t) ;
 -- the global component of theta . inclusion, as Gamma(theta) after the inclusion
 component-theta (b : P.ring.R) :
  Id (Sl.restricted.sheaf.ring Sl.lattice.top).R (map (UA.component GT.C.composite) b)
   (map PRE.gamma (map (UA.component Sl.inclusion) b)) = PRE.component b ;
 right-trace (t : (SB.SA.spec.sheaf.ring SB.ZA.lattice.top).R) :
  Id (Sl.restricted.sheaf.ring Sl.lattice.top).R (to-d (map (GA.leg2 PB.lattice.top) t))
   (map SB.phi (map I.sigma (map (SB.SA.inclusion P.variable) (Gb.evaluate t)))) = calc (Sl.restricted.sheaf.ring Sl.lattice.top).R {
  to-d (map (GA.leg2 PB.lattice.top) t)
   =< leg2-d t
    > UA.GO.restrict Sl.lattice.top (GA.M2.p (PB.second PB.lattice.top)) mid-d
       (map (GT.C.composite.sharp (PB.second PB.lattice.top)) t)
   =< UA.GO.res-irr Sl.lattice.top (GA.M2.p (PB.second PB.lattice.top)) mid-d (UA.psi-top GT.C.composite)
       (map (GT.C.composite.sharp (PB.second PB.lattice.top)) t)
    > UA.GO.restrict Sl.lattice.top (DL.hmap GT.C.composite.lat SB.ZA.lattice.top) (UA.psi-top GT.C.composite)
       (map (GT.C.composite.sharp SB.ZA.lattice.top) t)
   =< ap (\ s -> UA.GO.restrict Sl.lattice.top (DL.hmap GT.C.composite.lat SB.ZA.lattice.top) (UA.psi-top GT.C.composite)
         (map (GT.C.composite.sharp SB.ZA.lattice.top) s)) (sym (Gb.global-evaluate t))
    > UA.GO.restrict Sl.lattice.top (DL.hmap GT.C.composite.lat SB.ZA.lattice.top) (UA.psi-top GT.C.composite)
       (map (GT.C.composite.sharp SB.ZA.lattice.top) (map Gb.global (Gb.evaluate t)))
   =< sym (UA.component-map GT.C.composite (Gb.evaluate t)) > map (UA.component GT.C.composite) (Gb.evaluate t)
   =< component-theta (Gb.evaluate t) > map PRE.gamma (map (UA.component Sl.inclusion) (Gb.evaluate t))
   =< ap (map PRE.gamma) (SB.cut-component (Gb.evaluate t))
    > map PRE.gamma (map SB.phi (map (SB.SA.inclusion P.variable) (Gb.evaluate t)))
   =< PC.gamma-automorphism (map (SB.SA.inclusion P.variable) (Gb.evaluate t))
    > map SB.phi (map I.sigma (map (SB.SA.inclusion P.variable) (Gb.evaluate t))) } ;

 -- a global section (s, t) has f(a) = sigma(f(b))
 overlap (z : (GA.ring PB.lattice.top).R) :
  Id (SB.SA.Loc P.variable).R (map (SB.SA.inclusion P.variable) (Gb.evaluate (GA.left PB.lattice.top z)))
   (map I.sigma (map (SB.SA.inclusion P.variable) (Gb.evaluate (GA.right PB.lattice.top z)))) =
  phi-injective (map (SB.SA.inclusion P.variable) (Gb.evaluate (GA.left PB.lattice.top z)))
   (map I.sigma (map (SB.SA.inclusion P.variable) (Gb.evaluate (GA.right PB.lattice.top z))))
   (trans (sym (left-trace (GA.left PB.lattice.top z)))
    (trans (ap to-d (GA.agree PB.lattice.top z)) (right-trace (GA.right PB.lattice.top z)))) ;
 -- conversely, f(a) = sigma(f(b)) makes (a|top, b|top) a section
 agree-back (a b : P.ring.R)
  (e : Id (SB.SA.Loc P.variable).R (map (SB.SA.inclusion P.variable) a) (map I.sigma (map (SB.SA.inclusion P.variable) b))) :
  FP.Agree (map Gb.global a) (map Gb.global b) =
  to-d-injective (map (Sl.inclusion.sharp (PB.first PB.lattice.top)) (map Gb.global a)) (map (GA.leg2 PB.lattice.top) (map Gb.global b))
   (calc (Sl.restricted.sheaf.ring Sl.lattice.top).R {
    to-d (map (Sl.inclusion.sharp (PB.first PB.lattice.top)) (map Gb.global a))
     =< left-trace (map Gb.global a) > map SB.phi (map (SB.SA.inclusion P.variable) (Gb.evaluate (map Gb.global a)))
     =< ap (\ x -> map SB.phi (map (SB.SA.inclusion P.variable) x)) (Gb.evaluate-global a)
      > map SB.phi (map (SB.SA.inclusion P.variable) a)
     =< ap (map SB.phi) e > map SB.phi (map I.sigma (map (SB.SA.inclusion P.variable) b))
     =< ap (\ x -> map SB.phi (map I.sigma (map (SB.SA.inclusion P.variable) x))) (sym (Gb.evaluate-global b))
      > map SB.phi (map I.sigma (map (SB.SA.inclusion P.variable) (Gb.evaluate (map Gb.global b))))
     =< sym (right-trace (map Gb.global b)) > to-d (map (GA.leg2 PB.lattice.top) (map Gb.global b)) }) ;

 -- the canonical isomorphism k -> Gamma(P^1), a |-> (a|top, a|top)
 constant-global : RH.Hom k (SB.SA.spec.sheaf.ring SB.ZA.lattice.top) =
  RH.compose k P.ring (SB.SA.spec.sheaf.ring SB.ZA.lattice.top) Gb.global P.inclusion ;
 fixed (c : k.R) : Id (SB.SA.Loc P.variable).R (map (SB.SA.inclusion P.variable) (P.constant c))
  (map I.sigma (map (SB.SA.inclusion P.variable) (P.constant c))) = sym (I.sigma-k c) ;
 module Dg = FP.Lift[k,constant-global,constant-global,\ c -> agree-back (P.constant c) (P.constant c) (fixed c)] ;
 diagonal : RH.Hom k (GA.ring PB.lattice.top) = Dg.lift ;
 -- the inverse: evaluate the first polynomial at 0
 back (z : (GA.ring PB.lattice.top).R) : k.R = IO.PC.coef (Gb.evaluate (GA.left PB.lattice.top z)) zero ;
 back-diagonal (c : k.R) : Id k.R (back (map diagonal c)) c = calc k.R {
  back (map diagonal c) =< ap (\ s -> IO.PC.coef (Gb.evaluate s) zero) (Dg.left-lift c)
    > IO.PC.coef (Gb.evaluate (map Gb.global (P.constant c))) zero
   =< ap (\ p -> IO.PC.coef p zero) (Gb.evaluate-global (P.constant c)) > IO.PC.coef (P.constant c) zero
   =< IO.coef-constant c > c } ;
 module Back (z : (GA.ring PB.lattice.top).R) {
  constant : IO.Constant (Gb.evaluate (GA.left PB.lattice.top z)) (Gb.evaluate (GA.right PB.lattice.top z)) =
   IO.overlap (Gb.evaluate (GA.left PB.lattice.top z)) (Gb.evaluate (GA.right PB.lattice.top z)) (overlap z) ;
  -- both components are the same polynomial
  equal-components : Id (SB.SA.spec.sheaf.ring SB.ZA.lattice.top).R (GA.left PB.lattice.top z) (GA.right PB.lattice.top z) =
   calc (SB.SA.spec.sheaf.ring SB.ZA.lattice.top).R {
    GA.left PB.lattice.top z =< sym (Gb.global-evaluate (GA.left PB.lattice.top z))
     > map Gb.global (Gb.evaluate (GA.left PB.lattice.top z))
     =< ap (map Gb.global) constant.1 > map Gb.global (Gb.evaluate (GA.right PB.lattice.top z))
     =< Gb.global-evaluate (GA.right PB.lattice.top z) > GA.right PB.lattice.top z } ;
  left-eq : Id (SB.SA.spec.sheaf.ring SB.ZA.lattice.top).R (GA.left PB.lattice.top (map diagonal (back z))) (GA.left PB.lattice.top z) =
   calc (SB.SA.spec.sheaf.ring SB.ZA.lattice.top).R {
    GA.left PB.lattice.top (map diagonal (back z)) =< Dg.left-lift (back z) > map Gb.global (P.constant (back z))
     =< ap (map Gb.global) (sym constant.2) > map Gb.global (Gb.evaluate (GA.left PB.lattice.top z))
     =< Gb.global-evaluate (GA.left PB.lattice.top z) > GA.left PB.lattice.top z } ;
  right-eq : Id (SB.SA.spec.sheaf.ring SB.ZA.lattice.top).R (GA.right PB.lattice.top (map diagonal (back z))) (GA.right PB.lattice.top z) =
   calc (SB.SA.spec.sheaf.ring SB.ZA.lattice.top).R {
    GA.right PB.lattice.top (map diagonal (back z)) =< Dg.right-lift (back z) > map Gb.global (P.constant (back z))
     =< ap (map Gb.global) (sym constant.2) > map Gb.global (Gb.evaluate (GA.left PB.lattice.top z))
     =< ap (map Gb.global) constant.1 > map Gb.global (Gb.evaluate (GA.right PB.lattice.top z))
     =< Gb.global-evaluate (GA.right PB.lattice.top z) > GA.right PB.lattice.top z } ;
 } ;
 diagonal-back (z : (GA.ring PB.lattice.top).R) : Id (GA.ring PB.lattice.top).R (map diagonal (back z)) z =
  GA.ext PB.lattice.top (map diagonal (back z)) z Back[z].left-eq Back[z].right-eq ;
 iso : Pr.isEquiv k.R (GA.ring PB.lattice.top).R (map diagonal) =
  Pr.qinv k.R (GA.ring PB.lattice.top).R (map diagonal) back diagonal-back back-diagonal ;
} ;
