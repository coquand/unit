-- The elementary form of a localisation transfers along a ring iso.
-- Let f : A -> T be an elementary localisation at the powers of h and
-- psi : T -> T2 a bijective ring map with psi . f = f2 on elements.
-- Then f2 is elementary. Units: psi maps the unit f(s) to f2(s).
-- Fractions: for y in T2 take a fraction f(s) x = f(a) of x = psi^-1 y
-- and apply psi. Kernel: f2(a) = 0 gives psi(f a) = psi 0, so f(a) = 0
-- by injectivity, and the elementary kernel of f gives a killer.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module Transfer (A : CRing) (h : A.R) (T T2 : CRing) (f : RH.Hom A T) (f2 : RH.Hom A T2)
 (el : Bridge[l].Over[A,h].LocH.Elementary T f)
 (psi : RH.Hom T T2) (psi-equiv : Pr.isEquiv T.R T2.R (map psi))
 (on : (a : A.R) -> Id T2.R (map psi (map f a)) (map f2 a)) {
 module LH = Bridge[l].Over[A,h].LocH ;
 inverts : LH.Inverts T2 f2 = \ s q ->
  Pr.subst T2.R (\ e -> RL[T2].unit e) (map psi (map f s)) (map f2 s) (on s)
   (AffineRing[l].unit-map T T2 psi (map f s) (LH.inverts el s q)) ;
 module Image (y : T2.R) {
  x : T.R = psi-equiv.sec y ;
  x-eq : Id T2.R (map psi x) y = psi-equiv.sec-eq y ;
  moved (p : LH.Fraction T f x) : LH.Fraction T2 f2 y =
   (LH.num p,LH.den p,LH.den-in p,calc T2.R {
    T2.mul (map f2 (LH.den p)) y
     =< cong2 T2.R T2.mul _ _ _ _ (sym (on (LH.den p))) (sym x-eq)
      > T2.mul (map psi (map f (LH.den p))) (map psi x)
     =< sym (map-mul psi (map f (LH.den p)) x) > map psi (T.mul (map f (LH.den p)) x)
     =< ap (map psi) (LH.eqn p) > map psi (map f (LH.num p))
     =< on (LH.num p) > map f2 (LH.num p) }) ;
  fraction : Tr.Trunc[LH.Fraction T2 f2 y].carrier =
   Tr.Trunc[LH.Fraction T f x].induction @l (\ t -> Tr.Trunc[LH.Fraction T2 f2 y].carrier)
    (\ t -> Tr.Trunc[LH.Fraction T2 f2 y].proposition)
    (\ p -> Tr.Trunc[LH.Fraction T2 f2 y].inc (moved p)) (LH.fractions el x) ;
 } ;
 fractions : LH.Fractions T2 f2 = \ y -> Image[y].fraction ;
 zero-before (a : A.R) (z : Id T2.R (map f2 a) T2.z) : Id T.R (map f a) T.z =
  Iso[l].injective T.R T2.R (map psi) psi-equiv _ _
   (trans (on a) (trans z (sym (map-zero psi)))) ;
 kernel : LH.Kernel T2 f2 = \ a z -> LH.kernel el a (zero-before a z) ;
 elementary : LH.Elementary T2 f2 = (inverts,fractions,kernel) ;
} ;
