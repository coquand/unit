-- The lambda-criterion (Serre note, Lemma 4.2), the other direction.
-- Let w be an open, B = O(w), and suppose M has an affine model at w: an
-- equivalence e from the direct image of M|w along the canonical chart
-- Spec B -> X|w to the associated sheaf of a B-module N. Then for every s
-- in B, lambda_(w,s) : M(w)_s -> M(D_w s) is an equivalence; more
-- generally so is lambda_(v,s|v) on every chart open v = pi(D h).
-- Proof. By SerreLambdaClearing it suffices that restriction
-- rho : M(v) -> M(D_v c), c = s|v, clears and kills at c, over O(v); by
-- SerreLambdaElementarySquare.Unrestrict, that it does so at s over B,
-- O(v) being a B-algebra by restriction. Put t = s h.
--  Basic values. For g in B, value_g : M(pi D g) -> N_g evaluates e at g
--   (AssociatedBasicOpen); it is bijective. It is B-linear, b acting on
--   M(pi D g) by restriction: the chart's sharp sends the section of b/1
--   to b| (Extension.extend-basic, SpecMap.phi-g-on), e is linear over the
--   structure sheaf, and evaluation is semilinear over ring evaluation.
--  The square. v = pi(D h) and D_v(c) = v /\ D_w(s) = D_w(s h) = pi(D t)
--   (InvOpen.Restrict, the product law, SpecMap.pi-D). Put
--   i = value_h . restriction : M(v) -> N_h and
--   j = value_t . restriction : M(D_v c) -> N_t; both are bijective and
--   B-linear. By composition of restrictions, naturality of e and of
--   evaluation, j . rho = r . i with r : N_h -> N_t the native restriction.
--  r clears and kills at s (SerreModuleBasicRestrictionsOverlap at s, h);
--  so does rho (SerreLambdaElementarySquare.Square).
-- Lemma 4.2 itself is the case h = 1, v = w (the chart preserves top).
-- No affineness of w is used: only the model and the chart map.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module DL = DistLattice[l] ;
module RH = RingHom[l] ; module RM = RingMaps[l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ; module MS = SerreModuleSheaf[l] ;
module On (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged)
 (M : MS.On[L,X.sheaf].ModuleSheaf) (w : L.L) (model : SerreQuasiCoherent[l].On[L,X,M].At[w].Model) {
 module QC = SerreQuasiCoherent[l].On[L,X,M].At[w] ;
 module S = QC.S ; module R = QC.Restricted ; module AC = QC.Canonical ; module Image = QC.Image ;
 module RO = R.RO ; module SO = S.OS ;
 module O = DL.Order[L] ; module GO = RingedLattice[l].On[L].Of[X.sheaf] ;
 module MO = MS.On[L,X.sheaf].Of[M.presheaf] ; module IX = InvOpen[l].On[L].Of[X.sheaf] ;
 module LX = LocallyRinged[l].On[L].Laws[X.sheaf,X.inv] ;
 B : CRing = S.sheaf.ring S.lattice.top ;
 N : SM.Over[B].Module = R.restricted.presheaf.module-at S.lattice.top ;
 module Assoc = SerreAssociatedSheaf[l].Over[B,S.sheaf.ring-set S.lattice.top,model.coefficients] ;
 module BR = Assoc.AM.R ;
 module CanonicalMap = AC.Can.Of[RH.identity B].SM ;
 module T = MS.On[AC.ZG.lattice,AC.Can.Sh.structure].Transform[Image.presheaf,Assoc.associated.presheaf] ;
 forward : T.Hom = QC.Maps.forward model.comparison ;
 chart-open (g : B.R) : S.Opens = DL.hmap AC.canonical.lat (AC.ZG.D g) ;
 Target (g : B.R) : SM.Over[S.sheaf.ring (chart-open g)].Module = R.restricted.presheaf.module-at (chart-open g) ;
 down (g : B.R) (b : B.R) : (S.sheaf.ring (chart-open g)).R = S.SO.restrict (chart-open g) S.lattice.top (SO.le-top (chart-open g)) b ;
 -- M(pi D g) as a B-module, by restriction
 Q (g : B.R) : SM.Over[B].Module = MM.RestrictScalars[B,S.sheaf.ring (chart-open g),
  S.sheaf.res (chart-open g) S.lattice.top (SO.le-top (chart-open g))].Of[Target g].restricted ;
 -- the basic value M(pi D g) -> N_g
 module Basic (g : B.R) {
  module Ev = Assoc.B.At[g] ;
  module Native = BR.Local[g].Native ;
  value (z : (Target g).M) : Native.L.Carrier = Ev.Maps.map Ev.evaluation (T.at forward (AC.ZG.D g) z) ;
  value-equiv : Pr.isEquiv (Target g).M Native.L.Carrier value =
   Iso[l].equiv-compose _ _ _ (Ev.Maps.map Ev.evaluation) (T.at forward (AC.ZG.D g))
    Ev.equivalence (QC.Maps.equiv-at model.comparison (AC.ZG.D g)) ;
  -- the structure-sheaf section of b/1 on D g
  scalar (b : B.R) : (AC.Can.Sh.structure.ring (AC.ZG.D g)).R = CanonicalMap.B.At[g].extend (RM.map (AC.GX.inclusion g) b) ;
  scalar-sharp (b : B.R) : Id (S.sheaf.ring (chart-open g)).R (RM.map (AC.canonical.sharp (AC.ZG.D g)) (scalar b)) (down g b) =
   calc (S.sheaf.ring (chart-open g)).R {
    RM.map (AC.canonical.sharp (AC.ZG.D g)) (scalar b)
     =< CanonicalMap.E.extension-map-at (AC.ZG.D g) (scalar b) > CanonicalMap.E.extend (AC.ZG.D g) (scalar b)
     =< CanonicalMap.E.extend-basic g (scalar b) > RM.map CanonicalMap.Basic[g].phi-g (CanonicalMap.B.At[g].eval (scalar b))
     =< ap (RM.map CanonicalMap.Basic[g].phi-g) (CanonicalMap.B.At[g].eval-extend (RM.map (AC.GX.inclusion g) b))
      > RM.map CanonicalMap.Basic[g].phi-g (RM.map (AC.GX.inclusion g) b)
     =< CanonicalMap.Basic[g].phi-g-on b > RM.map CanonicalMap.Basic[g].on-A b
     =< RM.map-compose (S.sheaf.res (chart-open g) S.lattice.top CanonicalMap.Basic[g].le-top) (RH.identity B) b > down g b } ;
  scalar-eval (b : B.R) : Id (AC.GX.Loc g).R (RM.map Assoc.B.RingBasic.At[g].evaluation (scalar b)) (RM.map (AC.GX.inclusion g) b) =
   trans (Assoc.B.RingBasic.At[g].evaluation-map (scalar b)) (CanonicalMap.B.At[g].eval-extend (RM.map (AC.GX.inclusion g) b)) ;
  value-add (z y : (Target g).M) :
   Id Native.L.Carrier (value ((Target g).madd z y)) (Native.localised.madd (value z) (value y)) =
   trans (ap (Ev.Maps.map Ev.evaluation) (T.at-add forward (AC.ZG.D g) z y))
    (Ev.Maps.map-add Ev.evaluation (T.at forward (AC.ZG.D g) z) (T.at forward (AC.ZG.D g) y)) ;
  value-scale (b : B.R) (z : (Target g).M) :
   Id Native.L.Carrier (value ((Target g).sm (down g b) z)) (Native.localised.sm b (value z)) =
   calc Native.L.Carrier {
    value ((Target g).sm (down g b) z)
     =< ap (\ c -> value ((Target g).sm c z)) (sym (scalar-sharp b))
      > value ((Image.presheaf.module-at (AC.ZG.D g)).sm (scalar b) z)
     =< ap (Ev.Maps.map Ev.evaluation) (T.at-scale forward (AC.ZG.D g) (scalar b) z)
      > Ev.Maps.map Ev.evaluation ((Assoc.associated.presheaf.module-at (AC.ZG.D g)).sm (scalar b) (T.at forward (AC.ZG.D g) z))
     =< Ev.Maps.map-scale Ev.evaluation (scalar b) (T.at forward (AC.ZG.D g) z)
      > BR.Local[g].Scalars.localised.sm (RM.map Assoc.B.RingBasic.At[g].evaluation (scalar b)) (value z)
     =< ap (\ c -> BR.Local[g].Scalars.localised.sm c (value z)) (scalar-eval b)
      > BR.Local[g].Scalars.localised.sm (RM.map (AC.GX.inclusion g) b) (value z)
     =< BR.Local[g].Scalars.ER.original-action b (value z) > Native.localised.sm b (value z) } ;
  hom : MM.Between[B,B,RH.identity B,Q g,Native.localised].Hom =
   new MM.Between[B,B,RH.identity B,Q g,Native.localised].Hom[value,value-add,value-scale] ;
  hom-at (z : (Target g).M) : Id Native.L.Carrier (MM.Between[B,B,RH.identity B,Q g,Native.localised].map hom z) (value z) =
   refl (value z) ;
 } ;
 -- lambda on an open v = pi(D h) of the chart, at the restriction c of s
 module Principal (h s : B.R) (v : L.L) (le : O.Le v w) (v-eq : Id L.L (S.inc (chart-open h)) v) {
  c : (X.sheaf.ring v).R = GO.restrict v w le s ;
  module Cl = SerreLambdaClearing[l].On[L,X,M,v,c] ;
  module C = Cl.C ;
  module Ov = SerreModuleBasicRestrictionsOverlap[l].Over[B,S.sheaf.ring-set S.lattice.top,model.coefficients].At[s,h] ;
  t : B.R = Ov.gh ;
  module Src = Basic[h] ; module Tgt = Basic[t] ;
  -- D_v(c) = v /\ D_w(s) = D_w(h) /\ D_w(s) = D_w(s h) = pi(D t)
  chart-d (g : B.R) : Id L.L (S.inc (chart-open g)) (LX.d w g) = ap S.inc (CanonicalMap.pi-D g) ;
  d-eq : Id L.L Cl.Lam.open-g (S.inc (chart-open t)) = calc L.L {
   Cl.Lam.open-g
    =< IX.Restrict[w,v,le,s,LX.d w s,LX.d-open w s].restrict-eq (LX.d v c) (LX.d-open v c) > L.meet v (LX.d w s)
    =< ap (\ a -> L.meet a (LX.d w s)) (trans (sym v-eq) (chart-d h)) > L.meet (LX.d w h) (LX.d w s)
    =< L.meetC (LX.d w h) (LX.d w s) > L.meet (LX.d w s) (LX.d w h)
    =< sym (LX.mul-law w s h) > LX.d w t
    =< sym (chart-d t) > S.inc (chart-open t) } ;
  -- the B-modules M(v) and M(D_v c), by restriction along O(w) -> O(v)
  phi : RH.Hom B (X.sheaf.ring v) = X.sheaf.res v w le ;
  module Un = SerreLambdaElementarySquare[l].Unrestrict[B,X.sheaf.ring v,phi,M.presheaf.module-at v,C.Scalars.restricted,
   C.original,s,c,refl c] ;
  module RS = Un.R ;
  Md : SM.Over[B].Module = RS.RMd.restricted ;
  Nd : SM.Over[B].Module = RS.RNd.restricted ;
  -- i : M(v) -> N_h
  to-chart : O.Le (S.inc (chart-open h)) v = O.le-of-eq _ _ v-eq ;
  from-chart : O.Le v (S.inc (chart-open h)) = O.le-of-eq _ _ (sym v-eq) ;
  first (x : Md.M) : (Target h).M = MO.restrict (S.inc (chart-open h)) v to-chart x ;
  first-equiv : Pr.isEquiv Md.M (Target h).M first =
   Pr.qinv _ _ first (MO.restrict v (S.inc (chart-open h)) from-chart)
    (\ y -> trans (M.presheaf.res-comp (S.inc (chart-open h)) v (S.inc (chart-open h)) to-chart from-chart (O.le-refl (S.inc (chart-open h))) y)
     (M.presheaf.res-id (S.inc (chart-open h)) (O.le-refl (S.inc (chart-open h))) y))
    (\ x -> trans (M.presheaf.res-comp v (S.inc (chart-open h)) v from-chart to-chart (O.le-refl v) x)
     (M.presheaf.res-id v (O.le-refl v) x)) ;
  first-add (x y : Md.M) : Id (Target h).M (first (Md.madd x y)) ((Target h).madd (first x) (first y)) =
   MO.res-add (S.inc (chart-open h)) v to-chart x y ;
  first-scale (b : B.R) (x : Md.M) : Id (Target h).M (first (Md.sm b x)) ((Target h).sm (down h b) (first x)) =
   trans (MO.res-scale (S.inc (chart-open h)) v to-chart (RM.map phi b) x)
    (ap (\ a -> (Target h).sm a (first x))
     (X.sheaf.res-comp (S.inc (chart-open h)) v w to-chart le (S.le-inc (chart-open h) S.lattice.top (SO.le-top (chart-open h))) b)) ;
  i : MM.Between[B,B,RH.identity B,Md,Src.Native.localised].Hom =
   new MM.Between[B,B,RH.identity B,Md,Src.Native.localised].Hom[\ x -> Src.value (first x),
    \ x y -> trans (ap Src.value (first-add x y)) (Src.value-add (first x) (first y)),
    \ b x -> trans (ap Src.value (first-scale b x)) (Src.value-scale b (first x))] ;
  i-equiv : Pr.isEquiv Md.M Src.Native.L.Carrier (MM.Between[B,B,RH.identity B,Md,Src.Native.localised].map i) =
   Iso[l].equiv-compose _ _ _ Src.value first Src.value-equiv first-equiv ;
  -- j : M(D_v c) -> N_t
  to-open : O.Le (S.inc (chart-open t)) Cl.Lam.open-g = O.le-of-eq _ _ (sym d-eq) ;
  from-open : O.Le Cl.Lam.open-g (S.inc (chart-open t)) = O.le-of-eq _ _ d-eq ;
  second (y : Nd.M) : (Target t).M = MO.restrict (S.inc (chart-open t)) Cl.Lam.open-g to-open y ;
  second-equiv : Pr.isEquiv Nd.M (Target t).M second =
   Pr.qinv _ _ second (MO.restrict Cl.Lam.open-g (S.inc (chart-open t)) from-open)
    (\ y -> trans (M.presheaf.res-comp (S.inc (chart-open t)) Cl.Lam.open-g (S.inc (chart-open t)) to-open from-open (O.le-refl (S.inc (chart-open t))) y)
     (M.presheaf.res-id (S.inc (chart-open t)) (O.le-refl (S.inc (chart-open t))) y))
    (\ y -> trans (M.presheaf.res-comp Cl.Lam.open-g (S.inc (chart-open t)) Cl.Lam.open-g from-open to-open (O.le-refl Cl.Lam.open-g) y)
     (M.presheaf.res-id Cl.Lam.open-g (O.le-refl Cl.Lam.open-g) y)) ;
  second-add (x y : Nd.M) : Id (Target t).M (second (Nd.madd x y)) ((Target t).madd (second x) (second y)) =
   MO.res-add (S.inc (chart-open t)) Cl.Lam.open-g to-open x y ;
  second-scale (b : B.R) (y : Nd.M) : Id (Target t).M (second (Nd.sm b y)) ((Target t).sm (down t b) (second y)) =
   trans (MO.res-scale (S.inc (chart-open t)) Cl.Lam.open-g to-open (RM.map C.ring-map (RM.map phi b)) y)
    (ap (\ a -> (Target t).sm a (second y))
     (trans (ap (GO.restrict (S.inc (chart-open t)) Cl.Lam.open-g to-open)
       (X.sheaf.res-comp Cl.Lam.open-g v w Cl.Lam.below le (O.le-trans Cl.Lam.open-g v w Cl.Lam.below le) b))
      (X.sheaf.res-comp (S.inc (chart-open t)) Cl.Lam.open-g w to-open (O.le-trans Cl.Lam.open-g v w Cl.Lam.below le)
       (S.le-inc (chart-open t) S.lattice.top (SO.le-top (chart-open t))) b))) ;
  j : MM.Between[B,B,RH.identity B,Nd,Tgt.Native.localised].Hom =
   new MM.Between[B,B,RH.identity B,Nd,Tgt.Native.localised].Hom[\ y -> Tgt.value (second y),
    \ x y -> trans (ap Tgt.value (second-add x y)) (Tgt.value-add (second x) (second y)),
    \ b y -> trans (ap Tgt.value (second-scale b y)) (Tgt.value-scale b (second y))] ;
  j-equiv : Pr.isEquiv Nd.M Tgt.Native.L.Carrier (MM.Between[B,B,RH.identity B,Nd,Tgt.Native.localised].map j) =
   Iso[l].equiv-compose _ _ _ Tgt.value second Tgt.value-equiv second-equiv ;
  -- the square j . rho = r . i
  module EO = MS.On[AC.ZG.lattice,AC.Can.Sh.structure].Of[Assoc.associated.presheaf] ;
  module FO = MS.On[AC.ZG.lattice,AC.Can.Sh.structure].Of[Image.presheaf] ;
  mono : SO.Le (chart-open t) (chart-open h) = Image.mono (AC.ZG.D t) (AC.ZG.D h) Ov.below ;
  restricted (x : Md.M) : Id (Target t).M (second (MM.Between[B,B,RH.identity B,Md,Nd].map RS.restricted x))
   (FO.restrict (AC.ZG.D t) (AC.ZG.D h) Ov.below (first x)) =
   calc (Target t).M {
    second (MM.Between[B,B,RH.identity B,Md,Nd].map RS.restricted x)
     =< ap second (C.original-at x) > second (MO.restrict Cl.Lam.open-g v Cl.Lam.below x)
     =< M.presheaf.res-comp (S.inc (chart-open t)) Cl.Lam.open-g v to-open Cl.Lam.below
         (O.le-trans (S.inc (chart-open t)) (S.inc (chart-open h)) v (S.le-inc (chart-open t) (chart-open h) mono) to-chart) x
      > MO.restrict (S.inc (chart-open t)) v (O.le-trans (S.inc (chart-open t)) (S.inc (chart-open h)) v (S.le-inc (chart-open t) (chart-open h) mono) to-chart) x
     =< sym (M.presheaf.res-comp (S.inc (chart-open t)) (S.inc (chart-open h)) v (S.le-inc (chart-open t) (chart-open h) mono) to-chart
         (O.le-trans (S.inc (chart-open t)) (S.inc (chart-open h)) v (S.le-inc (chart-open t) (chart-open h) mono) to-chart) x)
      > FO.restrict (AC.ZG.D t) (AC.ZG.D h) Ov.below (first x) } ;
  evaluate-natural (z : (Target h).M) : Id Tgt.Native.L.Carrier
   (Tgt.value (FO.restrict (AC.ZG.D t) (AC.ZG.D h) Ov.below z)) (Ov.P.map (Src.value z)) =
   calc Tgt.Native.L.Carrier {
    Tgt.value (FO.restrict (AC.ZG.D t) (AC.ZG.D h) Ov.below z)
     =< ap (Tgt.Ev.Maps.map Tgt.Ev.evaluation) (forward.natural (AC.ZG.D t) (AC.ZG.D h) Ov.below z)
      > Tgt.Ev.Maps.map Tgt.Ev.evaluation (EO.restrict (AC.ZG.D t) (AC.ZG.D h) Ov.below (T.at forward (AC.ZG.D h) z))
     =< Tgt.Ev.evaluation-at (EO.restrict (AC.ZG.D t) (AC.ZG.D h) Ov.below (T.at forward (AC.ZG.D h) z))
      > Tgt.Ev.eval (EO.restrict (AC.ZG.D t) (AC.ZG.D h) Ov.below (T.at forward (AC.ZG.D h) z))
     =< ap Tgt.Ev.eval (Assoc.S.restriction-map (AC.ZG.D t) (AC.ZG.D h) Ov.below (T.at forward (AC.ZG.D h) z))
      > Tgt.Ev.eval (Assoc.S.restrict (AC.ZG.D t) (AC.ZG.D h) Ov.below (T.at forward (AC.ZG.D h) z))
     =< Assoc.B.natural h t Ov.below (T.at forward (AC.ZG.D h) z)
      > Assoc.S.rho h t Ov.below (Src.Ev.eval (T.at forward (AC.ZG.D h) z))
     =< Assoc.AM.component-restriction h t Ov.below (Src.Ev.eval (T.at forward (AC.ZG.D h) z))
      > Ov.P.map (Src.Ev.eval (T.at forward (AC.ZG.D h) z))
     =< ap Ov.P.map (sym (Src.Ev.evaluation-at (T.at forward (AC.ZG.D h) z))) > Ov.P.map (Src.value z) } ;
  commutes (x : Md.M) : Id Tgt.Native.L.Carrier
   (MM.Between[B,B,RH.identity B,Nd,Tgt.Native.localised].map j (MM.Between[B,B,RH.identity B,Md,Nd].map RS.restricted x))
   (Ov.P.map (MM.Between[B,B,RH.identity B,Md,Src.Native.localised].map i x)) =
   trans (ap Tgt.value (restricted x)) (evaluate-natural (first x)) ;
  module Sq = SerreLambdaElementarySquare[l].Square[B,Md,Nd,Src.Native.localised,Tgt.Native.localised,
   RS.restricted,Ov.P.native,i,i-equiv,j,j-equiv,commutes,s] ;
  equivalence : SerreLambda[l].On[L,X,M,v].At[c].IsEquivalence =
   Cl.equivalence (Un.clear (Sq.clear Ov.clear)) (Un.kill (Sq.kill Ov.kill)) ;
 } ;
 -- Lemma 4.2, model => lambda: the case h = 1, v = w
 top-eq : Id L.L (S.inc (chart-open B.o)) w = ap S.inc (DL.hmap-top AC.canonical.lat) ;
 lambda (s : B.R) : SerreLambda[l].On[L,X,M,w].At[s].IsEquivalence =
  Pr.subst (X.sheaf.ring w).R (\ g -> SerreLambda[l].On[L,X,M,w].At[g].IsEquivalence)
   (GO.restrict w w (O.le-refl w) s) s (X.sheaf.res-id w (O.le-refl w) s)
   Principal[B.o,s,w,O.le-refl w,top-eq].equivalence ;
} ;
