-- Equivariant natural isomorphisms of sheaf torsors (Serre §5).
-- The structures are quantified over, not collected into a small type.
-- A natural equivariant map with pointwise equivalences has a natural
-- equivariant inverse: apply its injective forward map to check the two
-- equations. Identity and composition are pointwise.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module DL = DistLattice[l] ;
module MS = SerreModuleSheaf[l] ;
module On (L : DL.DLat) (G : RingedLattice[l].On[L].Presheaf)
 (M : MS.On[L,G].ModuleSheaf) {
 module O = DL.Order[L] ; module MO = MS.On[L,G].Of[M.presheaf] ;
 module Torsors = SerreTorsor[l].On[L,G].Over[M] ;
 module Between (T V : Torsors.Torsor) {
  record EquivariantMap {
   at (a : L.L) : T.presheaf.obj a -> V.presheaf.obj a ;
   natural (a b : L.L) (k : O.Le a b) (t : T.presheaf.obj b) :
    Id (V.presheaf.obj a) (at a (T.presheaf.res a b k t)) (V.presheaf.res a b k (at b t)) ;
   action (a : L.L) (t : T.presheaf.obj a) (m : (M.presheaf.module-at a).M) :
    Id (V.presheaf.obj a) (at a (T.action a t m)) (V.action a (at a t) m) ;
  } ;
  record EquivariantIso {
   morphism : EquivariantMap ;
   equivalent (a : L.L) : Pr.isEquiv (T.presheaf.obj a) (V.presheaf.obj a) (morphism.at a) ;
  } ;
 } ;
 identity (T : Torsors.Torsor) : Between[T,T].EquivariantIso =
  new Between[T,T].EquivariantIso[
   new Between[T,T].EquivariantMap[\ a t -> t,\ a b k t -> refl (T.presheaf.res a b k t),\ a t m -> refl (T.action a t m)],
   \ a -> Pr.qinv (T.presheaf.obj a) (T.presheaf.obj a) (\ t -> t) (\ t -> t) (\ t -> refl t) (\ t -> refl t)] ;
 module Inverse (T V : Torsors.Torsor) (e : Between[T,V].EquivariantIso) {
  at (a : L.L) (u : V.presheaf.obj a) : T.presheaf.obj a = (e.equivalent a).sec u ;
  right (a : L.L) (u : V.presheaf.obj a) : Id (V.presheaf.obj a) (e.morphism.at a (at a u)) u = (e.equivalent a).sec-eq u ;
  left (a : L.L) (t : T.presheaf.obj a) : Id (T.presheaf.obj a) (at a (e.morphism.at a t)) t =
   Pr.sec-ret (T.presheaf.obj a) (V.presheaf.obj a) (e.morphism.at a) (e.equivalent a) t ;
  injective (a : L.L) (t u : T.presheaf.obj a) (p : Id (V.presheaf.obj a) (e.morphism.at a t) (e.morphism.at a u)) : Id (T.presheaf.obj a) t u =
   trans (sym (left a t)) (trans (ap (at a) p) (left a u)) ;
  natural (a b : L.L) (k : O.Le a b) (u : V.presheaf.obj b) :
   Id (T.presheaf.obj a) (at a (V.presheaf.res a b k u)) (T.presheaf.res a b k (at b u)) =
   injective a _ _ (trans (right a (V.presheaf.res a b k u))
    (sym (trans (e.morphism.natural a b k (at b u)) (ap (V.presheaf.res a b k) (right b u))))) ;
  action (a : L.L) (u : V.presheaf.obj a) (m : (M.presheaf.module-at a).M) :
   Id (T.presheaf.obj a) (at a (V.action a u m)) (T.action a (at a u) m) =
   injective a _ _ (trans (right a (V.action a u m))
    (sym (trans (e.morphism.action a (at a u) m) (ap (\ v -> V.action a v m) (right a u))))) ;
  inverse : Between[V,T].EquivariantIso = new Between[V,T].EquivariantIso[
   new Between[V,T].EquivariantMap[at,natural,action],
   \ a -> Pr.qinv (V.presheaf.obj a) (T.presheaf.obj a) (at a) (e.morphism.at a) (left a) (right a)] ;
  inverse-at (a : L.L) (u : V.presheaf.obj a) : Id (T.presheaf.obj a) (inverse.morphism.at a u) (at a u) = refl (at a u) ;
  opaque inverse ;
 } ;
 module Composition (T V W : Torsors.Torsor) (e : Between[T,V].EquivariantIso) (f : Between[V,W].EquivariantIso) {
  at (a : L.L) (t : T.presheaf.obj a) : W.presheaf.obj a = f.morphism.at a (e.morphism.at a t) ;
  natural (a b : L.L) (k : O.Le a b) (t : T.presheaf.obj b) :
   Id (W.presheaf.obj a) (at a (T.presheaf.res a b k t)) (W.presheaf.res a b k (at b t)) =
   trans (ap (f.morphism.at a) (e.morphism.natural a b k t)) (f.morphism.natural a b k (e.morphism.at b t)) ;
  action (a : L.L) (t : T.presheaf.obj a) (m : (M.presheaf.module-at a).M) :
   Id (W.presheaf.obj a) (at a (T.action a t m)) (W.action a (at a t) m) =
   trans (ap (f.morphism.at a) (e.morphism.action a t m)) (f.morphism.action a (e.morphism.at a t) m) ;
  equivalent (a : L.L) : Pr.isEquiv (T.presheaf.obj a) (W.presheaf.obj a) (at a) =
   Iso[l].equiv-compose (T.presheaf.obj a) (V.presheaf.obj a) (W.presheaf.obj a)
    (f.morphism.at a) (e.morphism.at a) (f.equivalent a) (e.equivalent a) ;
  composite : Between[T,W].EquivariantIso = new Between[T,W].EquivariantIso[
   new Between[T,W].EquivariantMap[at,natural,action],equivalent] ;
  composite-at (a : L.L) (t : T.presheaf.obj a) : Id (W.presheaf.obj a) (composite.morphism.at a t) (at a t) = refl (at a t) ;
  opaque composite ;
 } ;
} ;
