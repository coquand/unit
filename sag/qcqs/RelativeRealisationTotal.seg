-- Totalisation commutes with realising a relative compact open (§4).
-- Reorder (iota,(x,m)) to ((iota,x),m).  This keeps the total point and
-- its membership proof.  Naturality follows by point-ext: the two
-- underlying total points have the same defining reindexing formula.
-- Both inverse equations are reflexive reorderings of these pairs.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module TE = TestEquivalences[l] ;
module Over (K : T.Test) (F : RelativeFunctors[l].Over[K].SetFunctor) (u : RelativeOpens[l].Over[K,F].Open) {
 module O = RelativeOpens[l].Over[K,F] ;
 module RO = O.Realisation[u] ;
 module TR = RelativeTotal[l].Over[K,RO.functor] ;
 module R = OpenRealisation[l].Over[O.TF.functor,O.to-total u] ;
 forward (B : T.Test) (p : TR.functor.obj B) : R.obj B = ((TR.At[B].base p,RO.point {O.BP.algebra B (TR.At[B].base p)} (TR.At[B].value p)),RO.member {O.BP.algebra B (TR.At[B].base p)} (TR.At[B].value p)) ;
 back (B : T.Test) (p : R.obj B) : TR.functor.obj B = ((R.point {B} p).1,((R.point {B} p).2,R.member {B} p)) ;
 transformation : SF.Transform[TR.functor,R.functor].Nat = (forward,\ B C h p -> R.point-ext C _ _ (refl
  (O.TF.functor.reindex B C h (R.point {B} (forward B p))))) ;
 equivalence : TE.NaturalEquivalence TR.functor R.functor = (transformation,\ B -> Pr.qinv (TR.functor.obj B) (R.obj B) (forward B) (back B)
  (\ p -> refl p) (\ p -> refl p)) ;
 opaque equivalence ;
} ;
