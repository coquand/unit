-- Locality and sheafhood are properties of a ring presheaf.
-- Sheafhood is a product of contractibility assertions.  Invertibility
-- maps are propositions by uniqueness of their opens; the support laws
-- are products of equalities and inequalities in sets.
-- Apply the property extension of PresheafIdentity.  The existing
-- LocallyRinged record retracts onto those parts by record induction.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module IT = IdentityTools[l] ;
module DL = DistLattice[l] ;
module Over (L : DL.DLat) {
 module RL = RingedLattice[l].On[L] ;
 module LR = LocallyRinged[l].On[L] ;
 module P = PresheafIdentity[l].Over[L] ;
 module At (G : RL.Presheaf) {
  module GO = RL.Of[G] ;
  module IO = InvOpen[l].On[L].Of[G] ;
  sheaf-prop : Pr.isProp GO.IsSheaf = IT.FE.isProp-Pi (L.L) (\ u -> (n : Nat) (us : Fin n -> L.L) (le : (i : Fin n) -> DL.Order[L].Le (us i) u) (covers : DL.Order[L].Le u (DL.Joins[L].bigJ n us)) (xs : (i : Fin n) -> (G.ring (us i)).R) (c : GO.Cover[u,n,us,le,covers].Compatible xs) -> Localisation[l].isContr (GO.Cover[u,n,us,le,covers].Amalgam xs)) (\ u -> IT.FE.isProp-Pi (Nat) (\ n -> (us : Fin n -> L.L) (le : (i : Fin n) -> DL.Order[L].Le (us i) u) (covers : DL.Order[L].Le u (DL.Joins[L].bigJ n us)) (xs : (i : Fin n) -> (G.ring (us i)).R) (c : GO.Cover[u,n,us,le,covers].Compatible xs) -> Localisation[l].isContr (GO.Cover[u,n,us,le,covers].Amalgam xs)) (\ n -> IT.FE.isProp-Pi (Fin n -> L.L) (\ us -> (le : (i : Fin n) -> DL.Order[L].Le (us i) u) (covers : DL.Order[L].Le u (DL.Joins[L].bigJ n us)) (xs : (i : Fin n) -> (G.ring (us i)).R) (c : GO.Cover[u,n,us,le,covers].Compatible xs) -> Localisation[l].isContr (GO.Cover[u,n,us,le,covers].Amalgam xs)) (\ us -> IT.FE.isProp-Pi ((i : Fin n) -> DL.Order[L].Le (us i) u) (\ le -> (covers : DL.Order[L].Le u (DL.Joins[L].bigJ n us)) (xs : (i : Fin n) -> (G.ring (us i)).R) (c : GO.Cover[u,n,us,le,covers].Compatible xs) -> Localisation[l].isContr (GO.Cover[u,n,us,le,covers].Amalgam xs)) (\ le -> IT.FE.isProp-Pi (DL.Order[L].Le u (DL.Joins[L].bigJ n us)) (\ covers -> (xs : (i : Fin n) -> (G.ring (us i)).R) (c : GO.Cover[u,n,us,le,covers].Compatible xs) -> Localisation[l].isContr (GO.Cover[u,n,us,le,covers].Amalgam xs)) (\ covers -> IT.FE.isProp-Pi ((i : Fin n) -> (G.ring (us i)).R) (\ xs -> (c : GO.Cover[u,n,us,le,covers].Compatible xs) -> Localisation[l].isContr (GO.Cover[u,n,us,le,covers].Amalgam xs)) (\ xs -> IT.FE.isProp-Pi (GO.Cover[u,n,us,le,covers].Compatible xs) (\ c -> Localisation[l].isContr (GO.Cover[u,n,us,le,covers].Amalgam xs)) (\ c -> IT.contr-prop (GO.Cover[u,n,us,le,covers].Amalgam xs)))))))) ;
  module Support (inv : IO.InvMap) {
   module Laws = LR.Laws[G,inv] ;
   SupportOne : U l = (u : L.L) -> Id L.L (Laws.d u (G.ring u).o) u ;
   p-SupportOne : Pr.isProp SupportOne = IT.FE.isProp-Pi (L.L) (\ u -> Id L.L (Laws.d u (G.ring u).o) u) (\ u -> L.setL _ _) ;
   SupportZero : U l = Laws.ZeroLaw ;
   p-SupportZero : Pr.isProp SupportZero = IT.FE.isProp-Pi (L.L) (\ u -> Id L.L (Laws.d u (G.ring u).z) L.bot) (\ u -> L.setL _ _) ;
   SupportMul : U l = (u : L.L) (s t : (G.ring u).R) -> Id L.L (Laws.d u ((G.ring u).mul s t)) (L.meet (Laws.d u s) (Laws.d u t)) ;
   p-SupportMul : Pr.isProp SupportMul = IT.FE.isProp-Pi (L.L) (\ u -> (s : (G.ring u).R) (t : (G.ring u).R) -> Id L.L (Laws.d u ((G.ring u).mul s t)) (L.meet (Laws.d u s) (Laws.d u t))) (\ u -> IT.FE.isProp-Pi ((G.ring u).R) (\ s -> (t : (G.ring u).R) -> Id L.L (Laws.d u ((G.ring u).mul s t)) (L.meet (Laws.d u s) (Laws.d u t))) (\ s -> IT.FE.isProp-Pi ((G.ring u).R) (\ t -> Id L.L (Laws.d u ((G.ring u).mul s t)) (L.meet (Laws.d u s) (Laws.d u t))) (\ t -> L.setL _ _))) ;
   SupportAdd : U l = Laws.AddLaw ;
   p-SupportAdd : Pr.isProp SupportAdd = IT.FE.isProp-Pi (L.L) (\ u -> (s : (G.ring u).R) (t : (G.ring u).R) -> DL.Order[L].Le (Laws.d u ((G.ring u).add s t)) (L.join (Laws.d u s) (Laws.d u t))) (\ u -> IT.FE.isProp-Pi ((G.ring u).R) (\ s -> (t : (G.ring u).R) -> DL.Order[L].Le (Laws.d u ((G.ring u).add s t)) (L.join (Laws.d u s) (Laws.d u t))) (\ s -> IT.FE.isProp-Pi ((G.ring u).R) (\ t -> DL.Order[L].Le (Laws.d u ((G.ring u).add s t)) (L.join (Laws.d u s) (Laws.d u t))) (\ t -> DL.Order[L].le-prop _ _))) ;
   proposition : Pr.isProp Laws.IsSupport = IT.both SupportOne (SupportZero * SupportMul * SupportAdd) p-SupportOne
    (IT.both SupportZero (SupportMul * SupportAdd) p-SupportZero (IT.both SupportMul SupportAdd p-SupportMul p-SupportAdd)) ;
  } ;
  Property : U l = GO.IsSheaf * ((inv : IO.InvMap) * LR.Laws[G,inv].IsSupport) ;
  proposition : Pr.isProp Property = IT.both GO.IsSheaf ((inv : IO.InvMap) * LR.Laws[G,inv].IsSupport) sheaf-prop
   (Pr.isProp-Sigma IO.InvMap (\ inv -> LR.Laws[G,inv].IsSupport) IO.inv-map-prop (\ inv -> Support[inv].proposition)) ;
 } ;
 module B = DecoratedIdentity[l+].Over[RL.Presheaf,\ G H -> P.PIso G H,P.id-iso,P.total-contr] ;
 module Q = B.Property[\ G -> At[G].Property,\ G -> At[G].proposition] ;
 fields (X : LR.LocallyRinged) : Q.Obj = (X.sheaf,X.is-sheaf,X.inv,X.is-support) ;
 make (t : Q.Obj) : LR.LocallyRinged = new LR.LocallyRinged[t.1,t.2.1,t.2.2.1,t.2.2.2] ;
 LIso (X Y : LR.LocallyRinged) : U l+ = Q.Rel (fields X) (fields Y) ;
 id-iso (X : LR.LocallyRinged) : LIso X X = Q.identity (fields X) ;
 Total (X : LR.LocallyRinged) : U l+ = (Y : LR.LocallyRinged) * LIso X Y ;
 back (X : LR.LocallyRinged) : (Y : LR.LocallyRinged) (e : LIso X Y) -> Id (Total X) (make (fields Y),e) (Y,e) = split {
  LocallyRinged sh a b c -> \ e -> refl (new LR.LocallyRinged[sh,a,b,c],e) } ;
 total-contr (X : LR.LocallyRinged) : FunExtUA[l+].isContr (Total X) =
  SipGeneric[l+].ctr-retract (Q.Total (fields X)) (Total X) (Q.total-contr (fields X))
   (\ w -> (fields w.1,w.2)) (\ w -> (make w.1,w.2)) (\ w -> back X w.1 w.2) ;
 opaque total-contr ;
 module Fd = SipGeneric[l+].Fundamental[LR.LocallyRinged,LIso,id-iso,total-contr] ;
} ;
