-- Structure identity for small modules over a fixed ring A (SerreModule).
-- A linear equivalence M ~ N is a linear map whose underlying map is an
-- equivalence.  The modules N with a linear equivalence M ~ N form a
-- contractible type.  Proof: a module structure on a set X is a binary
-- operation and an action of A (data, SipGeneric's binop and action) with
-- axioms: X a set, the operation an abelian group, the action a module
-- action.  Zero and negation are part of the axioms: given associativity
-- and commutativity they are unique, so the axioms are a proposition
-- (the only algebraic fact used, as in pn/AbAxioms).  SipGeneric then
-- gives a contractible total space of its isomorphisms (an equivalence of
-- carriers preserving + and the action), and the record SerreModule.Module
-- with linear equivalences is a retract of it (fields, mk; record eta by
-- splitting).
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Hi = Prelude[l+] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module G = SipGeneric[l] ;
module GH = SipGeneric[l+] ;
module SM = SerreModule[l] ;
-- abelian groups: a property of a binary operation
module Ab (X : U l) (ad : X -> X -> X) {
 Assoc : U l = (x y w : X) -> Id X (ad x (ad y w)) (ad (ad x y) w) ;
 Comm : U l = (x y : X) -> Id X (ad x y) (ad y x) ;
 Unit (z : X) : U l = (x : X) -> Id X (ad x z) x ;
 Neg (z : X) : U l = (n : X -> X) * ((x : X) -> Id X (ad x (n x)) z) ;
 Zero : U l = (z : X) * Unit z * Neg z ;
 Ax : U l = Assoc * Comm * Zero ;
 module P (sX : Pr.isSet X) {
  pi (B : X -> U l) (pB : (x : X) -> Pr.isProp (B x)) : Pr.isProp ((x : X) -> B x) = FL.isProp-Pi X B pB ;
  assoc-prop : Pr.isProp Assoc = pi (\ x -> (y w : X) -> Id X (ad x (ad y w)) (ad (ad x y) w)) (\ x ->
   pi (\ y -> (w : X) -> Id X (ad x (ad y w)) (ad (ad x y) w)) (\ y ->
    pi (\ w -> Id X (ad x (ad y w)) (ad (ad x y) w)) (\ w -> sX (ad x (ad y w)) (ad (ad x y) w)))) ;
  comm-prop : Pr.isProp Comm = pi (\ x -> (y : X) -> Id X (ad x y) (ad y x)) (\ x ->
   pi (\ y -> Id X (ad x y) (ad y x)) (\ y -> sX (ad x y) (ad y x))) ;
  unit-prop (z : X) : Pr.isProp (Unit z) = pi (\ x -> Id X (ad x z) x) (\ x -> sX (ad x z) x) ;
  -- a family whose fibres are propositions and which forces equal indices
  prop-sigma (A : U l) (B : A -> U l) (u : (a a' : A) -> B a -> B a' -> Id A a a')
   (pB : (a : A) -> Pr.isProp (B a)) : Pr.isProp ((a : A) * B a) =
   \ w w' -> Pr.Sigma-eq A B w.1 w'.1 w.2 w'.2 (u w.1 w'.1 w.2 w'.2) (pB w'.1) ;
  module Uniq (a : Assoc) (c : Comm) {
   zero-uniq (z z' : X) (hz : Unit z) (hz' : Unit z') : Id X z z' =
    trans (sym (hz' z)) (trans (c z z') (hz z')) ;
   neg-uniq (z : X) (hz : Unit z) (n n' : X -> X) (hn : (x : X) -> Id X (ad x (n x)) z)
    (hn' : (x : X) -> Id X (ad x (n' x)) z) (x : X) : Id X (n x) (n' x) = calc X {
    n x =< sym (hz (n x)) > ad (n x) z
     =< ap (ad (n x)) (sym (hn' x)) > ad (n x) (ad x (n' x))
     =< a (n x) x (n' x) > ad (ad (n x) x) (n' x)
     =< ap (\ t -> ad t (n' x)) (c (n x) x) > ad (ad x (n x)) (n' x)
     =< ap (\ t -> ad t (n' x)) (hn x) > ad z (n' x)
     =< c z (n' x) > ad (n' x) z
     =< hz (n' x) > n' x } ;
   neg-prop (z : X) (hz : Unit z) : Pr.isProp (Neg z) =
    prop-sigma (X -> X) (\ n -> (x : X) -> Id X (ad x (n x)) z)
     (\ n n' hn hn' -> FL.funext X (\ x -> X) n n' (neg-uniq z hz n n' hn hn'))
     (\ n -> pi (\ x -> Id X (ad x (n x)) z) (\ x -> sX (ad x (n x)) z)) ;
   zero-prop : Pr.isProp Zero =
    prop-sigma X (\ z -> Unit z * Neg z) (\ z z' u u' -> zero-uniq z z' u.1 u'.1)
     (\ z -> Pr.isProp-Sigma (Unit z) (\ hz -> Neg z) (unit-prop z) (\ hz -> neg-prop z hz)) ;
  } ;
  ax-prop : Pr.isProp Ax =
   Pr.isProp-Sigma Assoc (\ a -> Comm * Zero) assoc-prop (\ a ->
    Pr.isProp-Sigma Comm (\ c -> Zero) comm-prop (\ c -> Uniq[a,c].zero-prop)) ;
 } ;
} ;
module Over (A : CRing) {
 module S = SM.Over[A] ;
 -- the laws of the action
 module Act (X : U l) (ad : X -> X -> X) (sc : A.R -> X -> X) {
  SA : U l = (a b : A.R) (x : X) -> Id X (sc a (sc b x)) (sc (A.mul a b) x) ;
  SO : U l = (x : X) -> Id X (sc A.o x) x ;
  SD : U l = (a : A.R) (x y : X) -> Id X (sc a (ad x y)) (ad (sc a x) (sc a y)) ;
  SE : U l = (a b : A.R) (x : X) -> Id X (sc (A.add a b) x) (ad (sc a x) (sc b x)) ;
  Ax : U l = SA * SO * SD * SE ;
  module P (sX : Pr.isSet X) {
   pX (B : X -> U l) (pB : (x : X) -> Pr.isProp (B x)) : Pr.isProp ((x : X) -> B x) = FL.isProp-Pi X B pB ;
   pR (B : A.R -> U l) (pB : (a : A.R) -> Pr.isProp (B a)) : Pr.isProp ((a : A.R) -> B a) = FL.isProp-Pi A.R B pB ;
   sa : Pr.isProp SA = pR (\ a -> (b : A.R) (x : X) -> Id X (sc a (sc b x)) (sc (A.mul a b) x)) (\ a ->
    pR (\ b -> (x : X) -> Id X (sc a (sc b x)) (sc (A.mul a b) x)) (\ b ->
     pX (\ x -> Id X (sc a (sc b x)) (sc (A.mul a b) x)) (\ x -> sX (sc a (sc b x)) (sc (A.mul a b) x)))) ;
   so : Pr.isProp SO = pX (\ x -> Id X (sc A.o x) x) (\ x -> sX (sc A.o x) x) ;
   sd : Pr.isProp SD = pR (\ a -> (x y : X) -> Id X (sc a (ad x y)) (ad (sc a x) (sc a y))) (\ a ->
    pX (\ x -> (y : X) -> Id X (sc a (ad x y)) (ad (sc a x) (sc a y))) (\ x ->
     pX (\ y -> Id X (sc a (ad x y)) (ad (sc a x) (sc a y))) (\ y -> sX (sc a (ad x y)) (ad (sc a x) (sc a y))))) ;
   se : Pr.isProp SE = pR (\ a -> (b : A.R) (x : X) -> Id X (sc (A.add a b) x) (ad (sc a x) (sc b x))) (\ a ->
    pR (\ b -> (x : X) -> Id X (sc (A.add a b) x) (ad (sc a x) (sc b x))) (\ b ->
     pX (\ x -> Id X (sc (A.add a b) x) (ad (sc a x) (sc b x))) (\ x -> sX (sc (A.add a b) x) (ad (sc a x) (sc b x))))) ;
   ax-prop : Pr.isProp Ax =
    Pr.isProp-Sigma SA (\ h -> SO * SD * SE) sa (\ h -> Pr.isProp-Sigma SO (\ h1 -> SD * SE) so (\ h1 ->
     Pr.isProp-Sigma SD (\ h2 -> SE) sd (\ h2 -> se))) ;
  } ;
 } ;
 -- the notion of module structure
 Data : G.Notion = G.join G.binop (G.action A.R) ;
 Ax (X : U l) (d : Data.S X) : U l = (sX : Pr.isSet X) * Ab[X,d.1].Ax * Act[X,d.1,d.2].Ax ;
 ax-prop (X : U l) (d : Data.S X) : Pr.isProp (Ax X d) =
  Pr.isProp-Sigma (Pr.isSet X) (\ sX -> Ab[X,d.1].Ax * Act[X,d.1,d.2].Ax) (IdentityTools[l].set-prop X) (\ sX ->
   Pr.isProp-Sigma Ab[X,d.1].Ax (\ h -> Act[X,d.1,d.2].Ax) Ab[X,d.1].P[sX].ax-prop (\ h -> Act[X,d.1,d.2].P[sX].ax-prop)) ;
 Structure : G.Notion = G.axioms Data Ax ax-prop ;
 module St = G.Over[Structure] ;
 -- the record of modules is St.Str
 fields (M : S.Module) : St.Str = (M.M,(M.madd,M.sm),M.setM,(M.maddA,M.maddC,M.mz,M.maddZ,M.mneg,M.maddN),
  (M.smA,M.smO,M.smD,M.smE)) ;
 mk (B : St.Str) : S.Module = new S.Module[B.1,B.2.2.1,B.2.2.2.1.2.2.1,B.2.1.1,B.2.2.2.1.2.2.2.2.1,
  B.2.2.2.1.1,B.2.2.2.1.2.1,B.2.2.2.1.2.2.2.1,B.2.2.2.1.2.2.2.2.2,
  B.2.1.2,B.2.2.2.2.1,B.2.2.2.2.2.1,B.2.2.2.2.2.2.1,B.2.2.2.2.2.2.2] ;
 -- linear equivalences
 module Lin (M N : S.Module) { module H = SerreBilinear[l].Over[A].Linear[M,N].H ; } ;
 LinearEquivalence (M N : S.Module) : U l = (f : Lin[M,N].H.Hom) * Pr.isEquiv M.M N.M f.fn ;
 identity (M : S.Module) : LinearEquivalence M M =
  (SerreBilinear[l].Over[A].identity M,Pr.qinv M.M M.M (\ x -> x) (\ x -> x) (\ x -> refl x) (\ x -> refl x)) ;
 Total (M : S.Module) : U l+ = (N : S.Module) * LinearEquivalence M N ;
 to-iso (M N : S.Module) (e : LinearEquivalence M N) : St.Iso (fields M) (fields N) =
  ((e.1.fn,e.2),(e.1.additive,e.1.scalar)) ;
 from-iso (M : S.Module) (B : St.Str) (i : St.Iso (fields M) B) : LinearEquivalence M (mk B) =
  (new Lin[M,mk B].H.Hom[i.1.1,i.2.1,i.2.2],i.1.2) ;
 back (M : S.Module) : (N : S.Module) (f : Lin[M,N].H.Hom) (q : Pr.isEquiv M.M N.M f.fn) ->
  Id (Total M) (mk (fields N),from-iso M (fields N) (to-iso M N (f,q))) (N,(f,q)) = split {
  Module X setX mz madd mneg maddA maddC maddZ maddN sm smA smO smD smE -> split {
   Hom fn additive scalar -> \ q -> refl (new S.Module[X,setX,mz,madd,mneg,maddA,maddC,maddZ,maddN,sm,smA,smO,smD,smE],
    (new Lin[M,new S.Module[X,setX,mz,madd,mneg,maddA,maddC,maddZ,maddN,sm,smA,smO,smD,smE]].H.Hom[fn,additive,scalar],q)) } } ;
 total-contr (M : S.Module) : FunExtUA[l+].isContr (Total M) =
  GH.ctr-retract (St.Total (fields M)) (Total M) (St.total-contr (fields M))
   (\ w -> (fields w.1,to-iso M w.1 w.2)) (\ c -> (mk c.1,from-iso M c.1 c.2)) (\ w -> back M w.1 w.2.1 w.2.2) ;
 opaque total-contr ;
} ;
