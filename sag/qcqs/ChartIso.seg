-- The charts of the doubling as isomorphisms (DESIGN.md, Next 1).  For the
-- doubling X2 of X along d (Doubling) and its two charts e = (top, d),
-- e2 = (d, top) (Chart), X is isomorphic to X2|e and to X2|e2 (Slice, Iso).
--
-- First chart.  The lattice map u |-> iota u = (u, u /\ d) lands below e
--  and preserves bot (bot /\ d = bot), top (top /\ d = d), joins and meets
--  (Chart); it is bijective with inverse the first component (iota-first).
--  The ring maps are Chart.to, bijective with inverse the left component
--  (left-to, to-left); they commute with restriction (Chart.natural, with
--  another witness of iota u <= iota v).  Isomorphisms are local (Iso).
-- Second chart: the same with iota2 u = (u /\ d, u), to2 and the right
--  component.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;
module Over (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged) (d : L.L) {
 module O = DL.Order[L] ;
 module Ch = Chart[l].Over[L,X,d] ;
 module Dbl = Ch.Dbl ;
 module DD = Ch.DD ;
 module GO = Ch.GO ;

 -- the first chart
 module S1 = Slice[l].Over[DD.lattice,Dbl.doubled,Ch.e] ;
 iota-bot : Id DD.Opens (Ch.iota L.bot) DD.botD = DD.ext (Ch.iota L.bot) DD.botD (refl L.bot) (O.bot-le d) ;
 iota-top : Id DD.Opens (Ch.iota L.top) Ch.e = DD.ext (Ch.iota L.top) Ch.e (refl L.top) (O.top-meet d) ;
 point1 (u : L.L) : S1.Opens = (Ch.iota u,Ch.iota-below u) ;
 lat1 : DL.Hom L S1.lattice =
  (point1,S1.ext (point1 L.bot) S1.botS iota-bot,S1.ext (point1 L.top) S1.topS iota-top,
   \ u v -> S1.ext (point1 (L.join u v)) (S1.joinS (point1 u) (point1 v)) (Ch.iota-join u v),
   \ u v -> S1.ext (point1 (L.meet u v)) (S1.meetS (point1 u) (point1 v)) (Ch.iota-meet u v)) ;
 module M1 = LocallyRinged[l].Maps[L,S1.lattice,X.sheaf,S1.sheaf] ;
 -- the section ring at the image of u is Dbl.ring (inc (lat u)), by definition
 sharp1 (u : L.L) : RH.Hom (X.sheaf.ring u) (Dbl.ring (S1.inc (DL.hmap lat1 u))) = Ch.to u ;
 -- restriction in X2|e is that of X2, at the inclusions of the images
 natural1 (u v : L.L) (k : O.Le u v) (s : (X.sheaf.ring v).R) :
  Id (Dbl.ring (S1.inc (DL.hmap lat1 u))).R
   (map (Dbl.res (S1.inc (DL.hmap lat1 u)) (S1.inc (DL.hmap lat1 v))
      (S1.le-inc (DL.hmap lat1 u) (DL.hmap lat1 v) (DL.JoinMaps[L,S1.lattice,lat1].monotone u v k)))
     (map (sharp1 v) s))
   (map (sharp1 u) (GO.restrict u v k s)) =
  trans (Dbl.G2.res-irr (S1.inc (DL.hmap lat1 u)) (S1.inc (DL.hmap lat1 v))
     (S1.le-inc (DL.hmap lat1 u) (DL.hmap lat1 v) (DL.JoinMaps[L,S1.lattice,lat1].monotone u v k)) (Ch.iota-le u v k)
     (map (sharp1 v) s))
   (Ch.natural u v k s) ;
 chart1 : M1.Ringed = new M1.Ringed[lat1,sharp1,natural1] ;
 module I1 = Iso[l].Maps[L,S1.lattice,X.sheaf,S1.sheaf] ;
 lattice-equiv1 : Pr.isEquiv L.L S1.lattice.L (DL.hmap lat1) =
  Pr.qinv L.L S1.Opens point1 (\ x -> DD.first (S1.inc x))
   (\ x -> S1.ext (point1 (DD.first (S1.inc x))) x (Ch.iota-first (S1.inc x) (S1.below x))) (\ u -> refl u) ;
 sharp-equiv1 (u : L.L) : Pr.isEquiv (X.sheaf.ring u).R (Dbl.ring (S1.inc (DL.hmap lat1 u))).R (map (sharp1 u)) =
  Pr.qinv (X.sheaf.ring u).R (Dbl.ring (S1.inc (DL.hmap lat1 u))).R (map (sharp1 u)) (Dbl.left (S1.inc (DL.hmap lat1 u)))
   (Ch.At[u].to-left) (Ch.At[u].left-to) ;
 iso1 : I1.IsIso chart1 = (lattice-equiv1,sharp-equiv1) ;
 local1 : M1.Of[chart1,X.inv,S1.inv].IsLocal = I1.Local[chart1,iso1,X.inv,S1.inv].local ;

 -- the second chart
 module S2 = Slice[l].Over[DD.lattice,Dbl.doubled,Ch.e2] ;
 iota2-bot : Id DD.Opens (Ch.iota2 L.bot) DD.botD = DD.ext (Ch.iota2 L.bot) DD.botD (O.bot-le d) (refl L.bot) ;
 iota2-top : Id DD.Opens (Ch.iota2 L.top) Ch.e2 = DD.ext (Ch.iota2 L.top) Ch.e2 (O.top-meet d) (refl L.top) ;
 point2 (u : L.L) : S2.Opens = (Ch.iota2 u,Ch.iota2-below u) ;
 lat2 : DL.Hom L S2.lattice =
  (point2,S2.ext (point2 L.bot) S2.botS iota2-bot,S2.ext (point2 L.top) S2.topS iota2-top,
   \ u v -> S2.ext (point2 (L.join u v)) (S2.joinS (point2 u) (point2 v)) (Ch.iota2-join u v),
   \ u v -> S2.ext (point2 (L.meet u v)) (S2.meetS (point2 u) (point2 v)) (Ch.iota2-meet u v)) ;
 module M2 = LocallyRinged[l].Maps[L,S2.lattice,X.sheaf,S2.sheaf] ;
 -- the section ring at the image of u is Dbl.ring (inc (lat u)), by definition
 sharp2 (u : L.L) : RH.Hom (X.sheaf.ring u) (Dbl.ring (S2.inc (DL.hmap lat2 u))) = Ch.to2 u ;
 -- restriction in X2|e is that of X2, at the inclusions of the images
 natural2 (u v : L.L) (k : O.Le u v) (s : (X.sheaf.ring v).R) :
  Id (Dbl.ring (S2.inc (DL.hmap lat2 u))).R
   (map (Dbl.res (S2.inc (DL.hmap lat2 u)) (S2.inc (DL.hmap lat2 v))
      (S2.le-inc (DL.hmap lat2 u) (DL.hmap lat2 v) (DL.JoinMaps[L,S2.lattice,lat2].monotone u v k)))
     (map (sharp2 v) s))
   (map (sharp2 u) (GO.restrict u v k s)) =
  trans (Dbl.G2.res-irr (S2.inc (DL.hmap lat2 u)) (S2.inc (DL.hmap lat2 v))
     (S2.le-inc (DL.hmap lat2 u) (DL.hmap lat2 v) (DL.JoinMaps[L,S2.lattice,lat2].monotone u v k)) (Ch.iota2-le u v k)
     (map (sharp2 v) s))
   (Ch.natural2 u v k s) ;
 chart2 : M2.Ringed = new M2.Ringed[lat2,sharp2,natural2] ;
 module I2 = Iso[l].Maps[L,S2.lattice,X.sheaf,S2.sheaf] ;
 lattice-equiv2 : Pr.isEquiv L.L S2.lattice.L (DL.hmap lat2) =
  Pr.qinv L.L S2.Opens point2 (\ x -> DD.second (S2.inc x))
   (\ x -> S2.ext (point2 (DD.second (S2.inc x))) x (Ch.iota2-second (S2.inc x) (S2.below x))) (\ u -> refl u) ;
 sharp-equiv2 (u : L.L) : Pr.isEquiv (X.sheaf.ring u).R (Dbl.ring (S2.inc (DL.hmap lat2 u))).R (map (sharp2 u)) =
  Pr.qinv (X.sheaf.ring u).R (Dbl.ring (S2.inc (DL.hmap lat2 u))).R (map (sharp2 u)) (Dbl.right (S2.inc (DL.hmap lat2 u)))
   (Ch.At2[u].to-right) (Ch.At2[u].right-to) ;
 iso2 : I2.IsIso chart2 = (lattice-equiv2,sharp-equiv2) ;
 local2 : M2.Of[chart2,X.inv,S2.inv].IsLocal = I2.Local[chart2,iso2,X.inv,S2.inv].local ;
} ;
