-- Clearing a fraction denominator (Serre note §3, degree-zero gluing).
-- Multiplication by f^p sends x/f^p to x/1, by the raising equation.
-- Every fraction merely has a representative, so every local section
-- merely has a numerator after multiplication by a power of f.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module SM = SerreModule[l] ; module LS = SerreModuleLocalisationStructure[l] ;
module At (A : CRing) (Md : SM.Over[A].Module) (f : A.R) {
 module Local = LS.At[A,Md,f] ; module L = Local.L ;
 module P = AffinePowers[l].Over[A] ;
 module AtSection (q : L.Carrier) { module C = SerreModuleClearFinite[l].Over[A].At[Md,Local.localised,Local.canonical,f,q] ; } ;
 clears (x : Md.M) (p : Nat) :
  Id L.Carrier (Local.localised.sm (P.power f p) (L.fraction x p)) (L.fraction x zero) =
  trans (Local.Action.scale-at (P.power f p) x p)
   (trans (ap (\ y -> L.fraction y p) (sym (L.power-scalar p x)))
    (trans (ap (L.fraction (L.power p x)) (sym (plus-zero p))) (L.raise x zero p))) ;
 witness (q : L.Carrier) (x : Md.M) (p : Nat) (eq : Id L.Carrier (L.fraction x p) q) : AtSection[q].C.Witness =
  (p,x,trans (Local.canonical-at x)
   (trans (sym (clears x p)) (ap (Local.localised.sm (P.power f p)) eq))) ;
 clearing (q : L.Carrier) : Tr.Trunc[AtSection[q].C.Witness].carrier =
  Tr.Trunc[(x : Md.M) * (p : Nat) * Id L.Carrier (L.fraction x p) q].induction @l
   (\ t -> Tr.Trunc[AtSection[q].C.Witness].carrier) (\ t -> Tr.Trunc[AtSection[q].C.Witness].proposition)
   (\ t -> Tr.Trunc[AtSection[q].C.Witness].inc (witness q t.1 t.2.1 t.2.2)) (L.represented q) ;
} ;
