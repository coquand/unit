-- Classification of a torsor with specified local sections (Serre §5).
-- A point has coordinate x_i given by t=t_i+x_i. Difference composition
-- proves x_j-x_i=c_ij. Conversely the local points t_i+x_i agree by the
-- twisted equation and glue. Difference uniqueness and sheaf separation
-- give the inverse equations. The coordinate map is natural and respects
-- the M-action, so these are equivariant sheaf isomorphisms.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module DL = DistLattice[l] ;
module MS = SerreModuleSheaf[l] ; module SM = SerreModule[l] ;
module On (L : DL.DLat) (G : RingedLattice[l].On[L].Presheaf)
 (M : MS.On[L,G].ModuleSheaf) (T : SerreTorsor[l].On[L,G].Over[M].Torsor)
 (n : Nat) (as : Fin n -> L.L) (covers : DL.Order[L].Le L.top (DL.Joins[L].bigJ n as))
 (ts : (i : Fin n) -> T.presheaf.obj (as i)) {
 module C = SerreCechTriviality[l].On[L,G,M,T,n,as,covers,ts] ;
 module TC = C.TC ; module TO = TC.TO ; module O = TC.O ; module MO = TC.MO ;
 module X = SerreCechTorsorCoordinates[l].On[L,G,M,n,as,C.cocycle] ;
 module XA = SerreCechTorsorAction[l].On[L,G,M,n,as,C.cocycle] ;
 module XD = SerreCechTorsorDifference[l].On[L,G,M,n,as,C.cocycle,covers] ;
 module OnOpen (a : L.L) {
  module Cover = XD.OnOpen[a] ;
  module S = SerreSetSheaf[l].On[L].SheafProofs[T.presheaf,T.sheaf].Cover[a,n,Cover.piece,Cover.below,Cover.covering] ;
  module SC = S.C ;
  base (i : Fin n) : T.presheaf.obj (Cover.piece i) =
   T.presheaf.res (Cover.piece i) (as i) (O.meet-right a (as i)) (ts i) ;
  local-target (t : T.presheaf.obj a) (i : Fin n) : T.presheaf.obj (Cover.piece i) = T.presheaf.res (Cover.piece i) a (Cover.below i) t ;
  coordinates (t : T.presheaf.obj a) : X.E.At[a].P.Carrier = \ i -> TO.diff (Cover.piece i) (base i) (local-target t i) ;
  module Pair (p : X.PairIndex) {
   module P = X.Pair[a,p] ;
   wi : O.Le P.domain (as p.1) = O.le-trans P.domain (Cover.piece p.1) (as p.1) P.below-left (O.meet-right a (as p.1)) ;
   wj : O.Le P.domain (as p.2) = O.le-trans P.domain (Cover.piece p.2) (as p.2) P.below-right (O.meet-right a (as p.2)) ;
   module B = TC.Below[P.domain,p.1,p.2,wi,wj] ;
   left-base : T.presheaf.obj P.domain = T.presheaf.res P.domain (as p.1) wi (ts p.1) ;
   right-base : T.presheaf.obj P.domain = T.presheaf.res P.domain (as p.2) wj (ts p.2) ;
   module Additive = SerreCechAlgebra[l].Over[G.ring P.domain,M.presheaf.module-at P.domain] ;
   joint-target (t : T.presheaf.obj a) : T.presheaf.obj P.domain = T.presheaf.res P.domain a P.below-a t ;
   left-coordinate (t : T.presheaf.obj a) : Id (M.presheaf.module-at P.domain).M
    (P.left (coordinates t)) (TO.diff P.domain left-base (joint-target t)) =
    trans (sym (TO.diff-res P.domain (Cover.piece p.1) P.below-left (base p.1) (local-target t p.1)))
     (trans (ap (\ u -> TO.diff P.domain u (T.presheaf.res P.domain (Cover.piece p.1) P.below-left (local-target t p.1)))
      (T.presheaf.res-comp P.domain (Cover.piece p.1) (as p.1) P.below-left (O.meet-right a (as p.1)) wi (ts p.1)))
      (ap (TO.diff P.domain left-base)
       (T.presheaf.res-comp P.domain (Cover.piece p.1) a P.below-left (Cover.below p.1) P.below-a t))) ;
   right-coordinate (t : T.presheaf.obj a) : Id (M.presheaf.module-at P.domain).M
    (P.right (coordinates t)) (TO.diff P.domain right-base (joint-target t)) =
    trans (sym (TO.diff-res P.domain (Cover.piece p.2) P.below-right (base p.2) (local-target t p.2)))
     (trans (ap (\ u -> TO.diff P.domain u (T.presheaf.res P.domain (Cover.piece p.2) P.below-right (local-target t p.2)))
      (T.presheaf.res-comp P.domain (Cover.piece p.2) (as p.2) P.below-right (O.meet-right a (as p.2)) wj (ts p.2)))
      (ap (TO.diff P.domain right-base)
       (T.presheaf.res-comp P.domain (Cover.piece p.2) a P.below-right (Cover.below p.2) P.below-a t))) ;
   cocycle-coordinate : Id (M.presheaf.module-at P.domain).M (X.twist a p) (TO.diff P.domain right-base left-base) =
    trans (ap (MO.restrict P.domain (C.Z.C.overlap p.1 p.2) P.below-overlap)
     (ap (\ z -> z p.1 p.2) C.cocycle-value))
     (trans (MO.res-irr P.domain (C.Z.C.overlap p.1 p.2) P.below-overlap B.meet-below (TC.cocycle p.1 p.2)) B.cocycle-res) ;
   equation (t : T.presheaf.obj a) : Id (M.presheaf.module-at P.domain).M
    (X.difference a (coordinates t) p) (X.twist a p) =
    trans (cong2 (M.presheaf.module-at P.domain).M P.Laws.sub _ _ _ _ (right-coordinate t) (left-coordinate t))
     (trans (ap (\ z -> P.Laws.sub z (TO.diff P.domain left-base (joint-target t))) (TO.diff-compose P.domain right-base left-base (joint-target t)))
      (trans (Additive.sub-cancel-right (TO.diff P.domain right-base left-base) (TO.diff P.domain left-base (joint-target t)))
       (sym cocycle-coordinate))) ;
  } ;
  forward (t : T.presheaf.obj a) : X.Fibre.Section a =
   X.make-section a (coordinates t) (X.F.At[a].P.ext _ _ (\ p -> Pair[p].equation t)) ;
  forward-value (t : T.presheaf.obj a) : Id X.E.At[a].P.Carrier (X.Fibre.value a (forward t)) (coordinates t) =
   X.make-value a (coordinates t) (X.F.At[a].P.ext _ _ (\ p -> Pair[p].equation t)) ;
  module Back (x : X.Fibre.Section a) {
   corrected (i : Fin n) : T.presheaf.obj (Cover.piece i) = T.action (Cover.piece i) (base i) (X.Fibre.value a x i) ;
   module OnPair (i j : Fin n) {
    w : L.L = L.meet (Cover.piece i) (Cover.piece j) ;
    wi : O.Le w (Cover.piece i) = O.meet-left (Cover.piece i) (Cover.piece j) ;
    wj : O.Le w (Cover.piece j) = O.meet-right (Cover.piece i) (Cover.piece j) ;
    wa : O.Le w a = O.le-trans w (Cover.piece i) a wi (Cover.below i) ;
    ii : O.Le w (as i) = O.le-trans w (Cover.piece i) (as i) wi (O.meet-right a (as i)) ;
    jj : O.Le w (as j) = O.le-trans w (Cover.piece j) (as j) wj (O.meet-right a (as j)) ;
    module B = XD.OnOpen[a].Below[w,wa,i,j,ii,jj] ;
    module TB = TC.Below[w,i,j,ii,jj] ;
    module Additive = SerreCechAlgebra[l].Over[G.ring w,M.presheaf.module-at w] ;
    left-base : T.presheaf.obj w = T.presheaf.res w (as i) ii (ts i) ;
    right-base : T.presheaf.obj w = T.presheaf.res w (as j) jj (ts j) ;
    left-correction : (M.presheaf.module-at w).M = MO.restrict w (Cover.piece i) B.left (X.Fibre.value a x i) ;
    right-correction : (M.presheaf.module-at w).M = MO.restrict w (Cover.piece j) B.right (X.Fibre.value a x j) ;
    difference-equation : Id (M.presheaf.module-at w).M (B.Laws.sub right-correction left-correction) (TO.diff w right-base left-base) =
     trans (B.coordinate-equation x)
      (trans (ap (MO.restrict w (C.Z.C.overlap i j) B.overlap) (ap (\ z -> z i j) C.cocycle-value))
       (trans (MO.res-irr w (C.Z.C.overlap i j) B.overlap TB.meet-below (TC.cocycle i j)) TB.cocycle-res)) ;
    corrected-equation : Id (M.presheaf.module-at w).M
     ((M.presheaf.module-at w).madd (TO.diff w right-base left-base) left-correction) right-correction =
     trans (ap (\ z -> (M.presheaf.module-at w).madd z left-correction) (sym difference-equation))
      (Additive.sub-plus-right right-correction left-correction) ;
    left-restrict : Id (T.presheaf.obj w) (T.presheaf.res w (Cover.piece i) wi (corrected i))
     (T.action w left-base left-correction) =
     trans (T.action-res w (Cover.piece i) wi (base i) (X.Fibre.value a x i))
      (trans (ap (\ t -> T.action w t (MO.restrict w (Cover.piece i) wi (X.Fibre.value a x i)))
       (T.presheaf.res-comp w (Cover.piece i) (as i) wi (O.meet-right a (as i)) ii (ts i)))
       (ap (T.action w left-base) (MO.res-irr w (Cover.piece i) wi B.left (X.Fibre.value a x i)))) ;
    right-restrict : Id (T.presheaf.obj w) (T.presheaf.res w (Cover.piece j) wj (corrected j))
     (T.action w right-base right-correction) =
     trans (T.action-res w (Cover.piece j) wj (base j) (X.Fibre.value a x j))
      (trans (ap (\ t -> T.action w t (MO.restrict w (Cover.piece j) wj (X.Fibre.value a x j)))
       (T.presheaf.res-comp w (Cover.piece j) (as j) wj (O.meet-right a (as j)) jj (ts j)))
       (ap (T.action w right-base) (MO.res-irr w (Cover.piece j) wj B.right (X.Fibre.value a x j)))) ;
    compatible : Id (T.presheaf.obj w) (T.presheaf.res w (Cover.piece i) wi (corrected i)) (T.presheaf.res w (Cover.piece j) wj (corrected j)) =
     trans left-restrict
      (trans (ap (\ t -> T.action w t left-correction) (sym (TO.diff-equation w right-base left-base)))
       (trans (T.action-add w right-base (TO.diff w right-base left-base) left-correction)
        (trans (ap (T.action w right-base) corrected-equation) (sym right-restrict)))) ;
   } ;
   glued : SC.Amalgam corrected = (S.glue corrected (\ i j -> OnPair[i,j].compatible)).1 ;
   section : T.presheaf.obj a = SC.amalgam glued ;
   matches (i : Fin n) : Id (T.presheaf.obj (Cover.piece i)) (T.presheaf.res (Cover.piece i) a (Cover.below i) section) (corrected i) = SC.matches glued i ;
   opaque glued ; opaque section ;
  } ;
  backward (x : X.Fibre.Section a) : T.presheaf.obj a = Back[x].section ;
  backward-forward (t : T.presheaf.obj a) : Id (T.presheaf.obj a) (backward (forward t)) t =
   S.separated (backward (forward t)) t (\ i -> trans (Back[forward t].matches i)
    (trans (ap (T.action (Cover.piece i) (base i)) (ap (\ z -> z i) (forward-value t)))
     (TO.diff-equation (Cover.piece i) (base i) (local-target t i)))) ;
  forward-backward (x : X.Fibre.Section a) : Id (X.Fibre.Section a) (forward (backward x)) x =
   X.Fibre.ext a (forward (backward x)) x
    (trans (forward-value (backward x)) (X.E.At[a].P.ext _ _ (\ i ->
     trans (ap (TO.diff (Cover.piece i) (base i)) (Back[x].matches i))
      (TO.diff-action (Cover.piece i) (base i) (X.Fibre.value a x i))))) ;
  equivalence : Pr.isEquiv (T.presheaf.obj a) (X.Fibre.Section a) forward =
   Pr.qinv (T.presheaf.obj a) (X.Fibre.Section a) forward backward forward-backward backward-forward ;
  opaque forward ; opaque backward ;
 } ;
 module Naturality (a b : L.L) (k : O.Le a b) (t : T.presheaf.obj b) {
  module A = OnOpen[a] ; module B = OnOpen[b] ;
  module AtIndex (i : Fin n) {
   da : L.L = A.Cover.piece i ; db : L.L = B.Cover.piece i ;
   le : O.Le da db = X.ChartPush[i].Push.mono a b k ;
   target-le : O.Le da b = O.le-trans da a b (A.Cover.below i) k ;
   base-equation : Id (T.presheaf.obj da) (T.presheaf.res da db le (B.base i)) (A.base i) =
    T.presheaf.res-comp da db (as i) le (O.meet-right b (as i)) (O.meet-right a (as i)) (ts i) ;
   target-equation : Id (T.presheaf.obj da) (T.presheaf.res da db le (B.local-target t i))
    (A.local-target (T.presheaf.res a b k t) i) =
    trans (T.presheaf.res-comp da db b le (B.Cover.below i) target-le t)
     (sym (T.presheaf.res-comp da a b (A.Cover.below i) k target-le t)) ;
   equation : Id (M.presheaf.module-at da).M
    (X.EO.restrict a b k (B.coordinates t) i) (A.coordinates (T.presheaf.res a b k t) i) =
    trans (sym (TO.diff-res da db le (B.base i) (B.local-target t i)))
     (trans (ap (\ u -> TO.diff da u (T.presheaf.res da db le (B.local-target t i))) base-equation)
      (ap (TO.diff da (A.base i)) target-equation)) ;
  } ;
  natural : Id (X.Fibre.Section a) (X.Fibre.restrict a b k (B.forward t)) (A.forward (T.presheaf.res a b k t)) =
   X.Fibre.ext a (X.Fibre.restrict a b k (B.forward t)) (A.forward (T.presheaf.res a b k t))
    (trans (X.Fibre.restrict-value a b k (B.forward t))
     (trans (ap (X.EO.restrict a b k) (B.forward-value t))
      (trans (X.E.At[a].P.ext _ _ (\ i -> AtIndex[i].equation))
       (sym (A.forward-value (T.presheaf.res a b k t)))))) ;
 } ;
 module Equivariance (a : L.L) (t : T.presheaf.obj a) (m : (M.presheaf.module-at a).M) {
  module A = OnOpen[a] ;
  module AtIndex (i : Fin n) {
   d : L.L = A.Cover.piece i ;
   vector : (M.presheaf.module-at d).M = MO.restrict d a (A.Cover.below i) m ;
   equation : Id (M.presheaf.module-at d).M
    (A.coordinates (T.action a t m) i)
    ((M.presheaf.module-at d).madd (A.coordinates t i) vector) =
    trans (ap (TO.diff d (A.base i)) (T.action-res d a (A.Cover.below i) t m))
     (trans (TO.diff-compose d (A.base i) (A.local-target t i) (T.action d (A.local-target t i) vector))
      (ap ((M.presheaf.module-at d).madd (A.coordinates t i)) (TO.diff-action d (A.local-target t i) vector))) ;
  } ;
  equivariant : Id (X.Fibre.Section a) (A.forward (T.action a t m)) (XA.action a (A.forward t) m) =
   X.Fibre.ext a (A.forward (T.action a t m)) (XA.action a (A.forward t) m)
    (trans (A.forward-value (T.action a t m))
     (trans (X.E.At[a].P.ext _ _ (\ i -> AtIndex[i].equation))
      (trans (ap (\ z -> X.E.At[a].P.product.madd z (XA.diagonal a m)) (sym (A.forward-value t)))
       (sym (XA.action-value a (A.forward t) m))))) ;
 } ;
} ;
