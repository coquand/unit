-- Direct image of a module sheaf along a map of ringed lattices (Serre §4).
-- For pi:L->K and sharp:F(a)->G(pi a), take N(pi a) with scalars
-- restricted along sharp. The ringed naturality square proves that its
-- restrictions are semilinear. A lattice map preserves finite covers.
-- Compatibility on pi(a meet b) restricts to compatibility on
-- pi(a) meet pi(b), using the named meet equation; no section carriers
-- are identified by transport. Unique gluing in N proves sheafhood.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module FE = Axioms[l].FunExtLemmas[fe @l] ;
module DL = DistLattice[l] ; module MM = SerreModuleMaps[l] ;
module MS = SerreModuleSheaf[l] ; module SS = SerreSetSheaf[l] ;
module Over (L K : DL.DLat) (F : RingedLattice[l].On[L].Presheaf)
 (G : RingedLattice[l].On[K].Presheaf) (pi : LocallyRinged[l].Maps[L,K,F,G].Ringed)
 (N : MS.On[K,G].ModuleSheaf) {
 module O = DL.Order[L] ; module Q = DL.Order[K] ;
 module JL = DL.Joins[L] ; module JK = DL.Joins[K] ;
 module Image = DL.JoinMaps[L,K,pi.lat] ;
 module NO = MS.On[K,G].Of[N.presheaf] ;
 p (a : L.L) : K.L = DL.hmap pi.lat a ;
 mono (a b : L.L) (k : O.Le a b) : Q.Le (p a) (p b) = Image.monotone a b k ;
 module At (a : L.L) {
  module Scalars = MM.RestrictScalars[F.ring a,G.ring (p a),pi.sharp a].Of[N.presheaf.module-at (p a)] ;
 } ;
 restrict (a b : L.L) (k : O.Le a b) (x : (N.presheaf.module-at (p b)).M) : (N.presheaf.module-at (p a)).M =
  NO.restrict (p a) (p b) (mono a b k) x ;
 restrict-at (a b : L.L) (k : O.Le a b) (x : (N.presheaf.module-at (p b)).M) :
  Id (N.presheaf.module-at (p a)).M (restrict a b k x) (NO.restrict (p a) (p b) (mono a b k) x) =
  refl (NO.restrict (p a) (p b) (mono a b k) x) ;
 restriction (a b : L.L) (k : O.Le a b) :
  MM.Between[F.ring b,F.ring a,F.res a b k,At[b].Scalars.restricted,At[a].Scalars.restricted].Hom =
  new MM.Between[F.ring b,F.ring a,F.res a b k,At[b].Scalars.restricted,At[a].Scalars.restricted].Hom[
   restrict a b k,\ x y -> NO.res-add (p a) (p b) (mono a b k) x y,
   \ r x -> trans (ap (restrict a b k) (At[b].Scalars.scalar-at r x))
    (trans (NO.res-scale (p a) (p b) (mono a b k) (RingMaps[l].map (pi.sharp b) r) x)
     (trans (ap (\ s -> (N.presheaf.module-at (p a)).sm s (restrict a b k x)) (pi.natural a b k r))
      (sym (At[a].Scalars.scalar-at (RingMaps[l].map (F.res a b k) r) (restrict a b k x)))))] ;
 presheaf : MS.On[L,F].Presheaf = new MS.On[L,F].Presheaf[
  \ a -> At[a].Scalars.restricted,restriction,
  \ a k x -> N.presheaf.res-id (p a) (mono a a k) x,
  \ a b c k h t x -> N.presheaf.res-comp (p a) (p b) (p c) (mono a b k) (mono b c h) (mono a c t) x] ;
 module PO = MS.On[L,F].Of[presheaf] ;
 presheaf-res (a b : L.L) (k : O.Le a b) (x : (N.presheaf.module-at (p b)).M) :
  Id (N.presheaf.module-at (p a)).M (PO.restrict a b k x) (restrict a b k x) = refl (restrict a b k x) ;
 module Cover (a : L.L) (n : Nat) (as : Fin n -> L.L)
  (le : (i : Fin n) -> O.Le (as i) a) (covers : O.Le a (JL.bigJ n as))
  (xs : (i : Fin n) -> (N.presheaf.module-at (p (as i))).M)
  (compatible : PO.Cover[a,n,as,le,covers].C.Compatible xs) {
  pieces (i : Fin n) : K.L = p (as i) ;
  piece-below (i : Fin n) : Q.Le (pieces i) (p a) = mono (as i) a (le i) ;
  piece-covers : Q.Le (p a) (JK.bigJ n pieces) =
   Q.le-trans (p a) (p (JL.bigJ n as)) (JK.bigJ n pieces) (mono a (JL.bigJ n as) covers)
    (Q.le-of-eq (p (JL.bigJ n as)) (JK.bigJ n pieces) (Image.preserves n as)) ;
  module NC = NO.Cover[p a,n,pieces,piece-below,piece-covers].C ;
  module NS = SS.On[K].SheafProofs[NO.underlying,N.sheaf].Cover[p a,n,pieces,piece-below,piece-covers] ;
  module PC = PO.Cover[a,n,as,le,covers].C ;
  module Pair (i j : Fin n) {
   overlap : K.L = K.meet (pieces i) (pieces j) ;
   original : K.L = p (L.meet (as i) (as j)) ;
   below-original : Q.Le overlap original =
    Q.le-of-eq overlap original (sym (DL.hmap-meet pi.lat (as i) (as j))) ;
   agree : Id (N.presheaf.module-at overlap).M
    (NO.restrict overlap (pieces i) (Q.meet-left (pieces i) (pieces j)) (xs i))
    (NO.restrict overlap (pieces j) (Q.meet-right (pieces i) (pieces j)) (xs j)) =
    trans (sym (N.presheaf.res-comp overlap original (pieces i) below-original
     (mono (L.meet (as i) (as j)) (as i) (O.meet-left (as i) (as j))) (Q.meet-left (pieces i) (pieces j)) (xs i)))
     (trans (ap (NO.restrict overlap original below-original) (compatible i j))
      (N.presheaf.res-comp overlap original (pieces j) below-original
       (mono (L.meet (as i) (as j)) (as j) (O.meet-right (as i) (as j))) (Q.meet-right (pieces i) (pieces j)) (xs j))) ;
  } ;
  glued : NC.Amalgam xs = (NS.glue xs (\ i j -> Pair[i,j].agree)).1 ;
  center : (N.presheaf.module-at (p a)).M = NC.amalgam glued ;
  matches : PC.Matches xs center = \ i ->
   trans (NO.res-irr (p (as i)) (p a) (mono (as i) a (le i)) (piece-below i) center) (NC.matches glued i) ;
  matches-prop (x : (N.presheaf.module-at (p a)).M) : Pr.isProp (PC.Matches xs x) =
   FE.isProp-Pi (Fin n) (\ i -> Id (N.presheaf.module-at (p (as i))).M (restrict (as i) a (le i) x) (xs i))
    (\ i -> (N.presheaf.module-at (p (as i))).setM _ _) ;
  unique (z : PC.Amalgam xs) : Id (N.presheaf.module-at (p a)).M center (PC.amalgam z) =
   NS.separated center (PC.amalgam z) (\ i -> trans (NC.matches glued i)
    (sym (trans (NO.res-irr (p (as i)) (p a) (piece-below i) (mono (as i) a (le i)) (PC.amalgam z)) (PC.matches z i)))) ;
  amalgamation : Localisation[l].isContr (PC.Amalgam xs) =
   ((center,matches),\ z -> Pr.Sigma-eq (N.presheaf.module-at (p a)).M (PC.Matches xs)
    center (PC.amalgam z) matches (PC.matches z) (unique z) (matches-prop (PC.amalgam z))) ;
  opaque glued ; opaque amalgamation ;
 } ;
 sheaf : PO.IsSheaf = \ a n as le covers xs compatible -> Cover[a,n,as,le,covers,xs,compatible].amalgamation ;
 direct-image : MS.On[L,F].ModuleSheaf = new MS.On[L,F].ModuleSheaf[presheaf,sheaf] ;
 opaque sheaf ;
} ;
