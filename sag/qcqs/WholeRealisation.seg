-- The realisation of the whole compact open is naturally equivalent to F.
-- Forgetting the proof top=top is natural.  Its inverse pairs x with refl;
-- one inverse law is refl and the other point-ext.  The natural inverse
-- is supplied by TestEquivalences, so no equality of functor records occurs.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module SF = TestFunctors[l] ;
module CO = CompactOpens[l] ;
module TE = TestEquivalences[l] ;
module Over (F : SF.SetFunctor) {
 module C = CO.Over[F] ;
 module R = OpenRealisation[l].Over[F,C.whole] ;
 equivalence : TE.NaturalEquivalence R.functor F =
  (R.inclusion,\ A -> Pr.qinv (R.obj A) (F.obj A) (R.point {A}) (\ x -> (x,refl ZariskiLattice[l].Over[A.ring].lattice.top))
   (\ x -> refl x) (\ p -> R.point-ext A (R.point p,refl ZariskiLattice[l].Over[A.ring].lattice.top) p (refl (R.point p)))) ;
 module V = TE.Inverse[R.functor,F,equivalence] ;
} ;
