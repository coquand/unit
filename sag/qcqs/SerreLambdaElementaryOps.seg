-- Clearing and killing are preserved by three operations.
-- (RestrictScalars) Along a ring map phi : A -> B, if a B-linear u clears
--  and kills at b = phi(f), so does its restriction of scalars at f, since
--  phi(f^r) = b^r acts as f^r on the restricted modules.
-- (AfterEquivalence) If v = e . u with e a bijective linear map, v clears and
--  kills when u does: apply e to the clearing equation, and use
--  injectivity of e with e(0) = 0 for the kernel.
-- (Product) For a finite family u_i, the product map clears and kills
--  when each u_i does. Choose the finitely many witnesses merely, take
--  one exponent R above every r_i, and multiply by the excess powers:
--  f^R = f^e f^r. Finiteness is the finite choice and the common bound.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module RH = RingHom[l] ; module RM = RingMaps[l] ;
module NB = NatBound[l] ; module MP = SerreModuleProducts[l] ;
module EL = SerreLambdaElementary[l] ;
module Raise (A : CRing) (Md : SM.Over[A].Module) (f : A.R) {
 module AP = AffinePowers[l].Over[A] ;
 -- f^R y = f^e (f^r y) when r + e = R
 raise (r R : Nat) (above : NB.Above r R) (y : Md.M) :
  Id Md.M (Md.sm (AP.power f R) y) (Md.sm (AP.power f (NB.excess above)) (Md.sm (AP.power f r) y)) =
  calc Md.M {
   Md.sm (AP.power f R) y
    =< ap (\ n -> Md.sm (AP.power f n) y) (sym (NB.excess-eq above)) > Md.sm (AP.power f (plus r (NB.excess above))) y
    =< ap (\ a -> Md.sm a y) (trans (AP.power-add f r (NB.excess above)) (A.mulC (AP.power f r) (AP.power f (NB.excess above))))
     > Md.sm (A.mul (AP.power f (NB.excess above)) (AP.power f r)) y
    =< sym (Md.smA (AP.power f (NB.excess above)) (AP.power f r) y)
     > Md.sm (AP.power f (NB.excess above)) (Md.sm (AP.power f r) y) } ;
} ;
module RestrictScalars (A B : CRing) (phi : RH.Hom A B) (Md Nd : SM.Over[B].Module)
 (u : MM.Between[B,B,RH.identity B,Md,Nd].Hom) (f : A.R) (b : B.R) (image : Id B.R (RM.map phi f) b) {
 module RS = MM.RestrictScalars[A,B,phi] ;
 module RMd = RS.Of[Md] ; module RNd = RS.Of[Nd] ;
 module HB = MM.Between[B,B,RH.identity B,Md,Nd] ;
 module HA = MM.Between[A,A,RH.identity A,RMd.restricted,RNd.restricted] ;
 restricted : HA.Hom = new HA.Hom[HB.map u,HB.map-add u,\ a x -> HB.map-scale u (RM.map phi a) x] ;
 restricted-at (x : Md.M) : Id Nd.M (HA.map restricted x) (HB.map u x) = refl (HB.map u x) ;
 module EB = EL.Over[B,Md,Nd,u,b] ;
 module EA = EL.Over[A,RMd.restricted,RNd.restricted,restricted,f] ;
 power (r : Nat) : Id B.R (RM.map phi (EA.AP.power f r)) (EB.AP.power b r) =
  trans (AffinePowers[l].power-map A B phi f r) (ap (\ c -> EB.AP.power c r) image) ;
 clearing (y : Nd.M) (c : EB.Clearing y) : EA.Clearing y =
  (c.1,c.2.1,trans (restricted-at c.2.1) (trans c.2.2 (ap (\ a -> Nd.sm a y) (sym (power c.1))))) ;
 clear (h : EB.Clear) : EA.Clear = \ y -> Tr.Trunc[EB.Clearing y].induction @l
  (\ t -> Tr.Trunc[EA.Clearing y].carrier) (\ t -> Tr.Trunc[EA.Clearing y].proposition)
  (\ c -> Tr.Trunc[EA.Clearing y].inc (clearing y c)) (h y) ;
 killing (x : Md.M) (k : EB.Killing x) : EA.Killing x =
  (k.1,trans (ap (\ a -> Md.sm a x) (power k.1)) k.2) ;
 kill (h : EB.Kill) : EA.Kill = \ x e -> Tr.Trunc[EB.Killing x].induction @l
  (\ t -> Tr.Trunc[EA.Killing x].carrier) (\ t -> Tr.Trunc[EA.Killing x].proposition)
  (\ k -> Tr.Trunc[EA.Killing x].inc (killing x k)) (h x (trans (sym (restricted-at x)) e)) ;
} ;
module AfterEquivalence (A : CRing) (Md Nd Nd2 : SM.Over[A].Module)
 (u : MM.Between[A,A,RH.identity A,Md,Nd].Hom) (e : MM.Between[A,A,RH.identity A,Nd,Nd2].Hom)
 (e-equiv : Pr.isEquiv Nd.M Nd2.M (MM.Between[A,A,RH.identity A,Nd,Nd2].map e))
 (v : MM.Between[A,A,RH.identity A,Md,Nd2].Hom)
 (agree : (x : Md.M) -> Id Nd2.M (MM.Between[A,A,RH.identity A,Md,Nd2].map v x)
  (MM.Between[A,A,RH.identity A,Nd,Nd2].map e (MM.Between[A,A,RH.identity A,Md,Nd].map u x)))
 (f : A.R) {
 module HE = MM.Between[A,A,RH.identity A,Nd,Nd2] ;
 module EU = EL.Over[A,Md,Nd,u,f] ;
 module EV = EL.Over[A,Md,Nd2,v,f] ;
 clearing (y : Nd2.M) (c : EU.Clearing (e-equiv.sec y)) : EV.Clearing y =
  (c.1,c.2.1,calc Nd2.M {
   EV.H.map v c.2.1 =< agree c.2.1 > HE.map e (EU.H.map u c.2.1)
    =< ap (HE.map e) c.2.2 > HE.map e (Nd.sm (EU.AP.power f c.1) (e-equiv.sec y))
    =< HE.map-scale e (EU.AP.power f c.1) (e-equiv.sec y) > Nd2.sm (EU.AP.power f c.1) (HE.map e (e-equiv.sec y))
    =< ap (Nd2.sm (EU.AP.power f c.1)) (e-equiv.sec-eq y) > Nd2.sm (EU.AP.power f c.1) y }) ;
 clear (h : EU.Clear) : EV.Clear = \ y -> Tr.Trunc[EU.Clearing (e-equiv.sec y)].induction @l
  (\ t -> Tr.Trunc[EV.Clearing y].carrier) (\ t -> Tr.Trunc[EV.Clearing y].proposition)
  (\ c -> Tr.Trunc[EV.Clearing y].inc (clearing y c)) (h (e-equiv.sec y)) ;
 zero-before (x : Md.M) (z : Id Nd2.M (EV.H.map v x) Nd2.mz) : Id Nd.M (EU.H.map u x) Nd.mz =
  Iso[l].injective Nd.M Nd2.M (HE.map e) e-equiv _ _ (trans (sym (agree x)) (trans z (sym (HE.map-zero e)))) ;
 kill (h : EU.Kill) : EV.Kill = \ x z -> h x (zero-before x z) ;
} ;
module Product (A : CRing) (I : U l) (Ms Ns : I -> SM.Over[A].Module)
 (us : (i : I) -> MM.Between[A,A,RH.identity A,Ms i,Ns i].Hom) (f : A.R)
 (choose : (B : I -> U l) -> ((i : I) -> Tr.Trunc[B i].carrier) -> Tr.Trunc[(i : I) -> B i].carrier)
 (bound : (I -> Nat) -> Nat) (above : (v : I -> Nat) (i : I) -> NB.Above (v i) (bound v)) {
 module PM = MP.Maps[A,A,RH.identity A,I,Ms,Ns,us] ;
 module E (i : I) { module E = EL.Over[A,Ms i,Ns i,us i,f] ; } ;
 module EP = EL.Over[A,PM.S.product,PM.T.product,PM.induced,f] ;
 module ClearAt (y : PM.T.Carrier) (cs : (i : I) -> E[i].E.Clearing (y i)) {
  exponent : Nat = bound (\ i -> (cs i).1) ;
  module At (i : I) {
   module R = Raise[A,Ns i,f] ;
   ab : NB.Above (cs i).1 exponent = above (\ i -> (cs i).1) i ;
   source : (Ms i).M = (Ms i).sm (E[i].E.AP.power f (NB.excess ab)) (cs i).2.1 ;
   equation : Id (Ns i).M (PM.T.product.sm (E[i].E.AP.power f exponent) y i) (E[i].E.H.map (us i) source) =
    calc (Ns i).M {
     PM.T.product.sm (E[i].E.AP.power f exponent) y i
      =< PM.T.scalar-at (E[i].E.AP.power f exponent) y i > (Ns i).sm (E[i].E.AP.power f exponent) (y i)
      =< R.raise (cs i).1 exponent ab (y i)
       > (Ns i).sm (E[i].E.AP.power f (NB.excess ab)) ((Ns i).sm (E[i].E.AP.power f (cs i).1) (y i))
      =< ap ((Ns i).sm (E[i].E.AP.power f (NB.excess ab))) (sym (cs i).2.2)
       > (Ns i).sm (E[i].E.AP.power f (NB.excess ab)) (E[i].E.H.map (us i) (cs i).2.1)
      =< sym (E[i].E.H.map-scale (us i) (E[i].E.AP.power f (NB.excess ab)) (cs i).2.1)
       > E[i].E.H.map (us i) source } ;
  } ;
  source : PM.S.Carrier = \ i -> At[i].source ;
  clearing : EP.Clearing y = (exponent,source,PM.T.ext _ _ (\ i ->
   trans (PM.induced-at source i) (sym At[i].equation))) ;
 } ;
 clear (each : (i : I) -> E[i].E.Clear) : EP.Clear = \ y ->
  Tr.Trunc[(i : I) -> E[i].E.Clearing (y i)].induction @l (\ t -> Tr.Trunc[EP.Clearing y].carrier)
   (\ t -> Tr.Trunc[EP.Clearing y].proposition) (\ cs -> Tr.Trunc[EP.Clearing y].inc ClearAt[y,cs].clearing)
   (choose (\ i -> E[i].E.Clearing (y i)) (\ i -> each i (y i))) ;
 module KillAt (x : PM.S.Carrier) (ks : (i : I) -> E[i].E.Killing (x i)) {
  exponent : Nat = bound (\ i -> (ks i).1) ;
  module At (i : I) {
   module R = Raise[A,Ms i,f] ;
   ab : NB.Above (ks i).1 exponent = above (\ i -> (ks i).1) i ;
   equation : Id (Ms i).M (PM.S.product.sm (E[i].E.AP.power f exponent) x i) (Ms i).mz =
    calc (Ms i).M {
     PM.S.product.sm (E[i].E.AP.power f exponent) x i
      =< PM.S.scalar-at (E[i].E.AP.power f exponent) x i > (Ms i).sm (E[i].E.AP.power f exponent) (x i)
      =< R.raise (ks i).1 exponent ab (x i)
       > (Ms i).sm (E[i].E.AP.power f (NB.excess ab)) ((Ms i).sm (E[i].E.AP.power f (ks i).1) (x i))
      =< ap ((Ms i).sm (E[i].E.AP.power f (NB.excess ab))) (ks i).2
       > (Ms i).sm (E[i].E.AP.power f (NB.excess ab)) (Ms i).mz
      =< SM.Over[A].Laws[Ms i].sm-zero (E[i].E.AP.power f (NB.excess ab)) > (Ms i).mz } ;
  } ;
  killing : EP.Killing x = (exponent,PM.S.ext _ _ (\ i -> trans At[i].equation (sym (PM.S.zero-at i)))) ;
 } ;
 component-zero (x : PM.S.Carrier) (z : Id PM.T.Carrier (EP.H.map PM.induced x) PM.T.product.mz) (i : I) :
  Id (Ns i).M (E[i].E.H.map (us i) (x i)) (Ns i).mz =
  trans (sym (PM.induced-at x i)) (trans (ap (\ t -> t i) z) (PM.T.zero-at i)) ;
 kill (each : (i : I) -> E[i].E.Kill) : EP.Kill = \ x z ->
  Tr.Trunc[(i : I) -> E[i].E.Killing (x i)].induction @l (\ t -> Tr.Trunc[EP.Killing x].carrier)
   (\ t -> Tr.Trunc[EP.Killing x].proposition) (\ ks -> Tr.Trunc[EP.Killing x].inc KillAt[x,ks].killing)
   (choose (\ i -> E[i].E.Killing (x i)) (\ i -> each i (x i) (component-zero x z i))) ;
} ;
-- the two finite index sets used below
module FinIndex (n : Nat) {
 choose (B : Fin n -> U l) (h : (i : Fin n) -> Tr.Trunc[B i].carrier) : Tr.Trunc[(i : Fin n) -> B i].carrier =
  AffineFinite[l].choice n B h ;
 bound (v : Fin n -> Nat) : Nat = NB.bound n v ;
 above (v : Fin n -> Nat) (i : Fin n) : NB.Above (v i) (bound v) = NB.bound-above n v i ;
 } ;
module FinPairs (n : Nat) {
  choose (B : (Fin n * Fin n) -> U l) (h : (ij : Fin n * Fin n) -> Tr.Trunc[B ij].carrier) :
   Tr.Trunc[(ij : Fin n * Fin n) -> B ij].carrier =
   Tr.Trunc[(i : Fin n) -> (j : Fin n) -> B (i,j)].induction @l
    (\ t -> Tr.Trunc[(ij : Fin n * Fin n) -> B ij].carrier)
    (\ t -> Tr.Trunc[(ij : Fin n * Fin n) -> B ij].proposition)
    (\ c -> Tr.Trunc[(ij : Fin n * Fin n) -> B ij].inc (\ ij -> c ij.1 ij.2))
    (AffineFinite[l].choice n (\ i -> (j : Fin n) -> B (i,j))
     (\ i -> AffineFinite[l].choice n (\ j -> B (i,j)) (\ j -> h (i,j)))) ;
  row (v : (Fin n * Fin n) -> Nat) (i : Fin n) : Nat = NB.bound n (\ j -> v (i,j)) ;
  bound (v : (Fin n * Fin n) -> Nat) : Nat = NB.bound n (row v) ;
  above (v : (Fin n * Fin n) -> Nat) (ij : Fin n * Fin n) : NB.Above (v ij) (bound v) =
   NB.above-trans (v ij) (row v ij.1) (bound v)
    (NB.bound-above n (\ j -> v (ij.1,j)) ij.2) (NB.bound-above n (row v) ij.1) ;
 } ;
-- A finite product on which f acts invertibly in each coordinate.
module ProductInvertible (A : CRing) (I : U l) (Ms : I -> SM.Over[A].Module) (f : A.R)
 (each : (i : I) -> Pr.isEquiv (Ms i).M (Ms i).M ((Ms i).sm f)) {
 module P = MP.Over[A,I,Ms] ;
 inverse (x : P.Carrier) : P.Carrier = \ i -> (each i).sec (x i) ;
 equivalence : Pr.isEquiv P.Carrier P.Carrier (P.product.sm f) =
  Pr.qinv P.Carrier P.Carrier (P.product.sm f) inverse
   (\ x -> P.ext _ _ (\ i -> trans (P.scalar-at f (inverse x) i) ((each i).sec-eq (x i))))
   (\ x -> P.ext _ _ (\ i -> trans (ap (each i).sec (P.scalar-at f x i))
     (Pr.sec-ret (Ms i).M (Ms i).M ((Ms i).sm f) (each i) (x i)))) ;
} ;
