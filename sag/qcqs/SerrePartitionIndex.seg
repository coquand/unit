-- Finite index sets for the partition torsor (Serre note, Section 6).
-- Equality on Fin n is decidable (the Fin of the shared ring foundation;
-- the same decision as pn/FinSwap, which this directory does not reach).
-- For a module M, a decision d of i = j and v in M put
--  on d v = v if i = j, and 0 otherwise.
-- Lemma (spike).  sum_i on (i = j) (g i) = g j.  By induction on n with
--  Fin (suc n) = Fin n + 1 and sum (suc n) g = g(last) + sum n (g . inl):
--  for j the last index the other summands are 0; for j = inl j' the last
--  summand is 0 and the rest is the spike at j' (the decision for inl i,
--  inl j' is that for i, j', so on agrees with it).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module SM = SerreModule[l] ;
Dec (A : U l) : U l = Plus A (Not A) ;
code (A B : U l) : Plus A B -> U l = split { inl a -> Top ; inr b -> Empty } ;
inl-inr (A B : U l) (a : A) (b : B) (p : Id (Plus A B) (inl a) (inr b)) : Empty =
 Pr.subst (Plus A B) (code A B) (inl a) (inr b) p tt ;
left (A B : U l) (d : A) : Plus A B -> A = split { inl a -> a ; inr b -> d } ;
inl-inj (A B : U l) (a a' : A) (p : Id (Plus A B) (inl a) (inl a')) : Id A a a' = ap (left A B a) p ;
lift-dec (k : Nat) (a b : Fin k) : Dec (Id (Fin k) a b) -> Dec (Id (Fin (suc k)) (inl a) (inl b)) = split {
 inl p -> inl (ap (\ c -> inl c) p) ;
 inr n -> inr (\ p -> n (inl-inj (Fin k) Top a b p)) } ;
-- decidable equality on Fin n
deq : (k : Nat) (a b : Fin k) -> Dec (Id (Fin k) a b) = split {
 zero -> split { } ;
 suc k | ih -> split {
  inl a -> split {
   inl b -> lift-dec k a b (ih a b) ;
   inr t -> inr (\ p -> inl-inr (Fin k) Top a t p) } ;
  inr t -> split {
   inl b -> inr (\ p -> inl-inr (Fin k) Top b t (sym p)) ;
   inr t' -> inl (ap (\ s -> inr s) (AffineFinite[l].top-eq t t')) } } } ;
module Over (A : CRing) (Md : SM.Over[A].Module) {
 open Md ;
 module ML = SM.Over[A].Laws[Md] ;
 module MS = SerreModuleSums[l].Over[A,Md] ;
 on (P : U l) : Dec P -> M -> M = split { inl e -> \ v -> v ; inr n -> \ v -> mz } ;
 on-yes (P : U l) (e : P) (v : M) : Id M (on P (inl e) v) v = refl v ;
 on-no (P : U l) (n : Not P) (v : M) : Id M (on P (inr n) v) mz = refl mz ;
 -- the decision for inl i, inl j is that for i, j
 on-lift (k : Nat) (a b : Fin k) : (d : Dec (Id (Fin k) a b)) (v : M) ->
  Id M (on (Id (Fin (suc k)) (inl a) (inl b)) (lift-dec k a b d) v) (on (Id (Fin k) a b) d v) = split {
  inl p -> \ v -> refl v ;
  inr n -> \ v -> refl mz } ;
 spike (n : Nat) (j : Fin n) (g : Fin n -> M) (i : Fin n) : M = on (Id (Fin n) i j) (deq n i j) (g i) ;
 spike-sum : (n : Nat) (j : Fin n) (g : Fin n -> M) -> Id M (MS.sum n (spike n j g)) (g j) = split {
  zero -> split { } ;
  suc n | ih -> split {
   inl j -> \ g -> calc M {
    MS.sum (suc n) (spike (suc n) (inl j) g)
     =< MS.sum-step n (spike (suc n) (inl j) g)
     > madd mz (MS.sum n (\ i -> spike (suc n) (inl j) g (inl i)))
     =< ML.zero-left (MS.sum n (\ i -> spike (suc n) (inl j) g (inl i)))
     > MS.sum n (\ i -> spike (suc n) (inl j) g (inl i))
     =< MS.sum-cong n (\ i -> spike (suc n) (inl j) g (inl i)) (spike n j (\ i -> g (inl i)))
         (\ i -> on-lift n i j (deq n i j) (g (inl i)))
     > MS.sum n (spike n j (\ i -> g (inl i)))
     =< ih j (\ i -> g (inl i)) > g (inl j) } ;
   inr t -> \ g -> calc M {
    MS.sum (suc n) (spike (suc n) (inr t) g)
     =< MS.sum-step n (spike (suc n) (inr t) g)
     > madd (g (inr tt)) (MS.sum n (\ i -> mz))
     =< ap (madd (g (inr tt))) (MS.sum-zero n) > madd (g (inr tt)) mz
     =< maddZ (g (inr tt)) > g (inr tt)
     =< ap (\ s -> g (inr s)) (AffineFinite[l].top-eq tt t) > g (inr t) } } } ;
} ;
