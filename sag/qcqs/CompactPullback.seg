-- Pull back a compact open along an affine point x in F(A).
-- The corresponding point map is h |-> F(h)(x) (Yoneda).  Naturality of
-- U says that its classifier at h : A -> B is h_*(U_A(x)), exactly the
-- classifier extended by Yoneda from U_A(x).  Transformation ext gives
-- equality of these compact opens, without choosing ideal generators.
-- Consequently membership is equivalent to h_*(U_A(x))=top; the two maps
-- are concatenation with naturality or its inverse.  Both types are
-- propositions, so these maps form an equivalence.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Hi = Prelude[l+] ;
module SF = TestFunctors[l] ;
module CO = CompactOpens[l] ;
module ZF = ZariskiFunctor[l] ;
module T = AffineTests[l] ;
module Over (F : SF.SetFunctor) (u : CO.Over[F].Open) (A : T.Test) (x : F.obj A) {
 module C = CO.Over[F] ;
 module H = SF.Representable[A] ;
 module Y = TestYoneda[l].Over[A,F] ;
 module YZ = TestYoneda[l].Over[A,ZF.functor] ;
 module P = CO.Pullback[H.functor,F,Y.extend x] ;
 module CH = CO.Over[H.functor] ;
 classifier : Id CH.Open (P.pull u) (YZ.extend (C.value u A x)) =
  CH.N.ext (P.pull u) (YZ.extend (C.value u A x)) (\ B h -> C.N.natural u A B h x) ;
 module At (B : T.Test) (h : RingHom[l].Hom A.ring B.ring) {
  module R = OpenRealisation[l].Over[F,u] ;
  Condition : U l = Id ZariskiLattice[l].Over[B.ring].lattice.L
   (ZF.functor.reindex A B h (C.value u A x)) ZariskiLattice[l].Over[B.ring].lattice.top ;
  condition-prop : Pr.isProp Condition = ZariskiLattice[l].Over[B.ring].lattice.setL
   (ZF.functor.reindex A B h (C.value u A x)) ZariskiLattice[l].Over[B.ring].lattice.top ;
  to-condition (p : R.Member B (F.reindex A B h x)) : Condition = trans (sym (C.N.natural u A B h x)) p ;
  from-condition (p : Condition) : R.Member B (F.reindex A B h x) = trans (C.N.natural u A B h x) p ;
  equivalence : Pr.Equiv (R.Member B (F.reindex A B h x)) Condition =
   (to-condition,Pr.qinv (R.Member B (F.reindex A B h x)) Condition to-condition from-condition
    (\ p -> condition-prop (to-condition (from-condition p)) p)
    (\ p -> R.member-prop B (F.reindex A B h x) (from-condition (to-condition p)) p)) ;
 } ;
} ;
