-- Restrictions of sections are linear over any fixed containing open.
-- Restrict scalars from O(w) to each section module. Restriction's
-- semilinearity becomes O(w)-linearity by the scalar res-comp equation.
-- For equal opens, the restrictions in the two directions are inverse
-- by module res-comp and res-id. This compares whole native modules
-- without retyping elements of different section carriers.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module DL = DistLattice[l] ;
module MS = SerreModuleSheaf[l] ; module MM = SerreModuleMaps[l] ;
module RH = RingHom[l] ; module RM = RingMaps[l] ;
module Over (L : DL.DLat) (G : RingedLattice[l].On[L].Presheaf)
 (M : MS.On[L,G].ModuleSheaf) (w : L.L) {
 module O = DL.Order[L] ; module GO = RingedLattice[l].On[L].Of[G] ;
 module MO = MS.On[L,G].Of[M.presheaf] ;
 module At (u : L.L) (below : O.Le u w) {
  module Scalars = MM.RestrictScalars[G.ring w,G.ring u,G.res u w below].Of[M.presheaf.module-at u] ;
 }
 ;
 module Pair (u : L.L) (ku : O.Le u w) (v : L.L) (kv : O.Le v w) (k : O.Le v u) {
  module Source = At[u,ku].Scalars ; module Target = At[v,kv].Scalars ;
  module Maps = MM.Between[G.ring w,G.ring w,RH.identity (G.ring w),Source.restricted,Target.restricted] ;
  linear : Maps.Hom = new Maps.Hom[MO.restrict v u k,MO.res-add v u k,
   \ r x -> trans (ap (MO.restrict v u k) (Source.scalar-at r x))
    (trans (MO.res-scale v u k (RM.map (G.res u w ku) r) x)
     (trans (ap (\ a -> (M.presheaf.module-at v).sm a (MO.restrict v u k x)) (G.res-comp v u w k ku kv r))
      (sym (Target.scalar-at r (MO.restrict v u k x)))))] ;
  at (x : (M.presheaf.module-at u).M) : Id (M.presheaf.module-at v).M (Maps.map linear x) (MO.restrict v u k x) =
   refl (MO.restrict v u k x) ;
  opaque linear ;
 } ;
 module Equal (u : L.L) (ku : O.Le u w) (v : L.L) (kv : O.Le v w) (e : Id L.L u v) {
  forward-below : O.Le v u = O.le-of-eq v u (sym e) ;
  backward-below : O.Le u v = O.le-of-eq u v e ;
  module Forward = Pair[u,ku,v,kv,forward-below] ;
  module Backward = Pair[v,kv,u,ku,backward-below] ;
  right (x : (M.presheaf.module-at v).M) : Id (M.presheaf.module-at v).M
   (Forward.Maps.map Forward.linear (Backward.Maps.map Backward.linear x)) x =
   trans (Forward.at (Backward.Maps.map Backward.linear x))
    (trans (ap (MO.restrict v u forward-below) (Backward.at x))
     (trans (M.presheaf.res-comp v u v forward-below backward-below (O.le-refl v) x) (M.presheaf.res-id v (O.le-refl v) x))) ;
  left (x : (M.presheaf.module-at u).M) : Id (M.presheaf.module-at u).M
   (Backward.Maps.map Backward.linear (Forward.Maps.map Forward.linear x)) x =
   trans (Backward.at (Forward.Maps.map Forward.linear x))
    (trans (ap (MO.restrict u v backward-below) (Forward.at x))
     (trans (M.presheaf.res-comp u v u backward-below forward-below (O.le-refl u) x) (M.presheaf.res-id u (O.le-refl u) x))) ;
  equivalence : Pr.isEquiv (M.presheaf.module-at u).M (M.presheaf.module-at v).M (Forward.Maps.map Forward.linear) =
   Pr.qinv (M.presheaf.module-at u).M (M.presheaf.module-at v).M (Forward.Maps.map Forward.linear)
    (Backward.Maps.map Backward.linear) right left ;
 } ;
} ;
