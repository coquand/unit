-- The pullback restriction of a geometric morphism to an open, with its
-- square in geometric notation.  This is SliceMap's factorisation and
-- triangle; locality is preserved.  No general fibre product is needed.
level l ; open Ring[l] ;
module DL = DistLattice[l] ;
module Sp = Spaces[l] ;
module Op = OpenMaps[l] ;
module Over (X Y : Sp.Space) (p : Sp.Hom X Y) (e : Y.lattice.L) {
 inverse-image : X.lattice.L = DL.hmap (Sp.underlying p).lat e ;
 module S = SliceMap[l].Over[Y.lattice,X.lattice,Y.structure,X.structure,Sp.underlying p,e] ;
 morphism : Sp.Hom (Op.space X inverse-image) (Op.space Y e) = (S.morphism,S.local (Sp.is-local p)) ;
 triangle : Id (Sp.Hom (Op.space X inverse-image) Y)
  (Sp.compose (Op.space X inverse-image) (Op.space Y e) Y (Op.inclusion Y e) morphism)
  (Sp.compose (Op.space X inverse-image) X Y p (Op.inclusion X inverse-image)) =
  Sp.ext (Op.space X inverse-image) Y
   (Sp.compose (Op.space X inverse-image) (Op.space Y e) Y (Op.inclusion Y e) morphism)
   (Sp.compose (Op.space X inverse-image) X Y p (Op.inclusion X inverse-image)) S.triangle ;
} ;
