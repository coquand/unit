-- Natural families over K and their extension to ordinary ring tests.
-- A relative map is f with s_Y f = s_X; its induced family sends p to f p.
-- The base equation uses associativity, the equation for f, and that for p.
-- Naturality follows from associativity and point-ext.
-- To extend a relative family alpha, lift an ordinary point canonically,
-- apply alpha, and forget the base equation.  The canonical lift after
-- reindexing and the reindexed canonical lift have equal underlying
-- points; BasePoints.total-ext identifies them.  Relative naturality then
-- proves ordinary naturality.  Output base equations show that this
-- extension preserves the base point.  Every relative point equals the
-- canonical lift of its underlying point, so extension recovers alpha's
-- underlying value on every relative point.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Hi = Prelude[l+] ;
module FE = Axioms[l+].FunExtLemmas[fe @l+] ;
module Sp = Spaces[l] ;
module T = AffineTests[l] ;
module FP = FunctorPoints[l] ;
module Over (K : T.Test) (X Y : Sp.Space) (sx : Sp.Hom X (T.space K)) (sy : Sp.Hom Y (T.space K)) {
 module BP = BasePoints[l].Over[K] ;
 module PX = BP.On[X,sx] ;
 module PY = BP.On[Y,sy] ;
 module Ordinary = FP.Maps[X,Y] ;
 OverMap : U l = (f : Sp.Hom X Y) * Id (Sp.Hom X (T.space K)) (Sp.compose X Y (T.space K) sy f) sx ;
 map-ext (f g : OverMap) (e : Id (Sp.Hom X Y) f.1 g.1) : Id OverMap f g =
  Pr.Sigma-eq (Sp.Hom X Y) (\ h -> Id (Sp.Hom X (T.space K)) (Sp.compose X Y (T.space K) sy h) sx)
   f.1 g.1 f.2 g.2 e (Sp.set X (T.space K) (Sp.compose X Y (T.space K) sy g.1) sx) ;
 overmap-set : Pr.isSet OverMap = Pr.isSet-Sigma (Sp.Hom X Y)
  (\ h -> Id (Sp.Hom X (T.space K)) (Sp.compose X Y (T.space K) sy h) sx) (Sp.set X Y)
  (\ h -> Pr.prop-to-set (Id (Sp.Hom X (T.space K)) (Sp.compose X Y (T.space K) sy h) sx)
   (Sp.set X (T.space K) (Sp.compose X Y (T.space K) sy h) sx)) ;
 Comp : U l+ = (A : BP.Algebra) -> PX.Points A -> PY.Points A ;
 Natural (alpha : Comp) : U l+ = (A B : BP.Algebra) (h : BP.Hom A B) (p : PX.Points A) ->
  Id (PY.Points B) (alpha B PX.Reindex[A,B,h,p].reindex) PY.Reindex[A,B,h,alpha A p].reindex ;
 natural-prop (alpha : Comp) : Hi.isProp (Natural alpha) =
  FE.isProp-Pi BP.Algebra (\ A -> (B : BP.Algebra) (h : BP.Hom A B) (p : PX.Points A) ->
   Id (PY.Points B) (alpha B PX.Reindex[A,B,h,p].reindex) PY.Reindex[A,B,h,alpha A p].reindex) (\ A ->
  FE.isProp-Pi BP.Algebra (\ B -> (h : BP.Hom A B) (p : PX.Points A) ->
   Id (PY.Points B) (alpha B PX.Reindex[A,B,h,p].reindex) PY.Reindex[A,B,h,alpha A p].reindex) (\ B ->
  FE.isProp-Pi (BP.Hom A B) (\ h -> (p : PX.Points A) ->
   Id (PY.Points B) (alpha B PX.Reindex[A,B,h,p].reindex) PY.Reindex[A,B,h,alpha A p].reindex) (\ h ->
  FE.isProp-Pi (PX.Points A) (\ p -> Id (PY.Points B) (alpha B PX.Reindex[A,B,h,p].reindex) PY.Reindex[A,B,h,alpha A p].reindex)
   (\ p -> PY.set B (alpha B PX.Reindex[A,B,h,p].reindex) PY.Reindex[A,B,h,alpha A p].reindex)))) ;
 Nat : U l+ = (alpha : Comp) * Natural alpha ;
 at (alpha : Nat) (A : BP.Algebra) (p : PX.Points A) : PY.Points A = alpha.1 A p ;
 natural (alpha : Nat) (A B : BP.Algebra) (h : BP.Hom A B) (p : PX.Points A) :
  Id (PY.Points B) (at alpha B PX.Reindex[A,B,h,p].reindex) PY.Reindex[A,B,h,at alpha A p].reindex = alpha.2 A B h p ;
 ext (alpha beta : Nat) (e : (A : BP.Algebra) (p : PX.Points A) -> Id (PY.Points A) (at alpha A p) (at beta A p)) : Id Nat alpha beta =
  Hi.Sigma-eq Comp Natural alpha.1 beta.1 alpha.2 beta.2
   (FE.funext BP.Algebra (\ A -> PX.Points A -> PY.Points A) alpha.1 beta.1 (\ A ->
    FE.funext (PX.Points A) (\ p -> PY.Points A) (alpha.1 A) (beta.1 A) (e A))) (natural-prop beta.1) ;
 set : Hi.isSet Nat = Hi.isSet-Sigma Comp Natural
  (FE.isSet-Pi BP.Algebra (\ A -> PX.Points A -> PY.Points A) (\ A ->
   FE.isSet-Pi (PX.Points A) (\ p -> PY.Points A) (\ p -> PY.set A)))
  (\ alpha -> Hi.prop-to-set (Natural alpha) (natural-prop alpha)) ;
 module Induced (f : OverMap) {
  module At (A : BP.Algebra) (p : PX.Points A) {
   base : Id (Sp.Hom (T.space (BP.test A)) (T.space K))
    (Sp.compose (T.space (BP.test A)) Y (T.space K) sy (Sp.compose (T.space (BP.test A)) X Y f.1 (PX.point p))) T.Map[K,(BP.test A),(BP.iota A)].morphism =
    trans Sp.Associativity[T.space (BP.test A),X,Y,T.space K,sy,f.1,PX.point p].assoc
     (trans (ap (\ g -> Sp.compose (T.space (BP.test A)) X (T.space K) g (PX.point p)) f.2) (PX.base p)) ;
   point : PY.Points A = (Sp.compose (T.space (BP.test A)) X Y f.1 (PX.point p),base) ;
  } ;
  induced : Nat = (\ A p -> At[A,p].point,\ A B h p ->
   PY.point-ext B At[B,PX.Reindex[A,B,h,p].reindex].point PY.Reindex[A,B,h,At[A,p].point].reindex
    Sp.Associativity[T.space (BP.test B),T.space (BP.test A),X,Y,f.1,PX.point p,T.Map[(BP.test A),(BP.test B),BP.ring-map h].morphism].assoc) ;
 } ;
 induced (f : OverMap) : Nat = Induced[f].induced ;
 module OrdinaryExtension (alpha : Nat) {
  total-action (B : T.Test) (p : PX.At[B].Total) : Sp.Hom (T.space B) Y = PY.point (at alpha (BP.algebra B p.1) p.2) ;
  module At (A B : T.Test) (h : RingHom[l].Hom A.ring B.ring) (p : Sp.Hom (T.space A) X) {
   module R = PX.TotalReindex[A,B,h,PX.At[A].lift p] ;
   lifts-eq : Id PX.At[B].Total (PX.At[B].lift (FP.On[X].reindex A B h p)) R.reindex =
    PX.At[B].total-ext (PX.At[B].lift (FP.On[X].reindex A B h p)) R.reindex (refl (FP.On[X].reindex A B h p)) ;
   naturality : Id (Sp.Hom (T.space B) Y)
    (total-action B (PX.At[B].lift (FP.On[X].reindex A B h p))) (FP.On[Y].reindex A B h (total-action A (PX.At[A].lift p))) =
    trans (ap (total-action B) lifts-eq)
     (ap (PY.point {BP.algebra B R.target})
      (natural alpha (BP.algebra A (PX.At[A].lift p).1) (BP.algebra B R.target) R.morphism (PX.At[A].lift p).2)) ;
  } ;
  extend : Ordinary.Nat = (\ B p -> total-action B (PX.At[B].lift p),\ A B h p -> At[A,B,h,p].naturality) ;
  base-output (B : T.Test) (p : Sp.Hom (T.space B) X) : Id (Sp.Hom (T.space B) (T.space K))
   (Sp.compose (T.space B) Y (T.space K) sy (Ordinary.at extend B p)) (Sp.compose (T.space B) X (T.space K) sx p) =
   trans (PY.base (at alpha (BP.algebra B (PX.At[B].lift p).1) (PX.At[B].lift p).2)) (sym (PX.base (PX.At[B].lift p).2)) ;
  on-relative (A : BP.Algebra) (p : PX.Points A) : Id (Sp.Hom (T.space (BP.test A)) Y)
   (Ordinary.at extend (BP.test A) (PX.point p)) (PY.point (at alpha A p)) =
   ap (total-action (BP.test A)) (PX.At[(BP.test A)].total-ext (PX.At[(BP.test A)].lift (PX.point p)) ((BP.iota A),p) (refl (PX.point p))) ;
 } ;
} ;
