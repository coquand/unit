-- Full faithfulness of the functor of points, absolute form.
-- Let X be qcqs, Y any locally ringed lattice, and alpha : h_X -> h_Y.
-- A solution is f : X -> Y with induced(f) = alpha.  Solutions form a
-- proposition: two maps inducing alpha are equal by ProbeSeparation's
-- faithfulness; the attached equations are propositions since Nat is a set.
-- From an actual affine atlas, AtlasMap gives f and AtlasMapPoints its
-- equation.  Eliminate the merely existing atlas into the proposition of
-- solutions, at level l+1.  Recover alpha as its unique map.  Its induced
-- family is alpha; recover(induced f) = f by faithfulness.  Thus induced is
-- an equivalence.  No choice of atlas and no resizing principle is used.
level l ; open Ring[l] ;
module Hi = Prelude[l+] ;
module Tr = Truncation[l] ;
module Sp = Spaces[l] ;
module FP = FunctorPoints[l] ;
module Over (X Y : Sp.Space) (qcqs : Qcqs[l].Over[X.lattice,X.structure].IsQcqs) {
 module Q = Qcqs[l].Over[X.lattice,X.structure] ;
 module N = FP.Maps[X,Y] ;
 module F = ProbeSeparation[l].Over[X,Y].Natural[qcqs] ;
 Solution (alpha : N.Nat) : U l+ = (f : Sp.Hom X Y) * Id N.Nat (N.induced f) alpha ;
 solution-prop (alpha : N.Nat) : Hi.isProp (Solution alpha) = \ a b ->
  Hi.Sigma-eq (Sp.Hom X Y) (\ f -> Id N.Nat (N.induced f) alpha) a.1 b.1 a.2 b.2
   (F.faithful a.1 b.1 (Hi.trans N.Nat (N.induced a.1) alpha (N.induced b.1) a.2 (Hi.sym N.Nat (N.induced b.1) alpha b.2)))
   (N.set (N.induced b.1) alpha) ;
 solution (alpha : N.Nat) : Solution alpha =
  Tr.Trunc[Q.AffineCover].induction @(l+) (\ t -> Solution alpha) (\ t -> solution-prop alpha)
   (\ c -> (AtlasMap[l].Over[X,Y,alpha].FromCover[c].morphism,AtlasMapPoints[l].Over[X,Y,alpha,c].induced)) qcqs ;
 recover (alpha : N.Nat) : Sp.Hom X Y = (solution alpha).1 ;
 induced-recover (alpha : N.Nat) : Id N.Nat (N.induced (recover alpha)) alpha = (solution alpha).2 ;
 recover-induced (f : Sp.Hom X Y) : Id (Sp.Hom X Y) (recover (N.induced f)) f = F.faithful (recover (N.induced f)) f (induced-recover (N.induced f)) ;
 equivalence : Hi.isEquiv (Sp.Hom X Y) N.Nat N.induced = Hi.qinv (Sp.Hom X Y) N.Nat N.induced recover induced-recover recover-induced ;
} ;
