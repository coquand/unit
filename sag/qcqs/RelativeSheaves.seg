-- Native relative Zariski sheafhood (§3 of the note).
-- Every finite basic algebra diagram, including the empty diagram, has
-- a contractible amalgam type for each compatible family.  This is a
-- proposition, by contractibility-proposition and function extensionality.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Hi = Prelude[l+] ;
module FE = Axioms[l+].FunExtLemmas[fe @l+] ;
module T = AffineTests[l] ;
module RH = RingHom[l] ;
module TS = TestSheaves[l] ;
module Over (K : T.Test) (F : RelativeFunctors[l].Over[K].SetFunctor) {
 module C = RelativeCovers[l].Over[K,F] ;
 IsSheaf : U l+ = (c : TS.CoverData) (iota : RH.Hom K.ring (TS.base c).ring) (xs : C.Cover[c,iota].Values) -> C.Cover[c,iota].Compatible xs ->
  Localisation[l].isContr (C.Cover[c,iota].Amalgam xs) ;
 proposition : Hi.isProp IsSheaf = FE.isProp-Pi TS.CoverData (\ c -> (iota : RH.Hom K.ring (TS.base c).ring) (xs : C.Cover[c,iota].Values) ->
  C.Cover[c,iota].Compatible xs -> Localisation[l].isContr (C.Cover[c,iota].Amalgam xs)) (\ c ->
  FE.isProp-Pi (RH.Hom K.ring (TS.base c).ring) (\ iota -> (xs : C.Cover[c,iota].Values) -> C.Cover[c,iota].Compatible xs -> Localisation[l].isContr (C.Cover[c,iota].Amalgam xs)) (\ iota ->
  FE.isProp-Pi C.Cover[c,iota].Values (\ xs -> C.Cover[c,iota].Compatible xs -> Localisation[l].isContr (C.Cover[c,iota].Amalgam xs)) (\ xs ->
  FE.isProp-Pi (C.Cover[c,iota].Compatible xs) (\ h -> Localisation[l].isContr (C.Cover[c,iota].Amalgam xs))
   (\ h -> TS.contr-prop (C.Cover[c,iota].Amalgam xs) (C.Cover[c,iota].amalgam-set xs))))) ;
} ;
