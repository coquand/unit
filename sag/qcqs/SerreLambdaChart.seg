-- The chart ring fact: on an affine w, lambda for O is an equivalence.
-- Put B = O(w) and let s be in B. The canonical chart Spec B -> X|w is
-- the map of the identity of B; its basic ring map
-- phi_s : B_s -> O(pi(D s)) sends b/1 to b|pi(D s) (SpecMap). Since w is
-- affine the chart's sharp at D s is bijective, and
-- sharp(extend x) = phi_s(x) (Extension.extend-basic), with extend
-- inverse to evaluation (BasicOpen); so phi_s is bijective. The open
-- pi(D s) is D_w(s) (SpecMap.pi-D), and restriction between equal opens
-- is bijective; the composite psi : B_s -> O(D_w s) sends b/1 to b|D_w s.
-- Hence restriction B -> O(D_w s) is an elementary localisation at s
-- (RingLocalisationElementary), and the native-fraction bridge
-- (SerreModuleRingLocalisationBridge) is a bijection from the native
-- localisation B_s. That bridge agrees with lambda on original sections,
-- so lambda_(w,s) is it (uniqueness of localisation extensions).
-- No associated model of O is used.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module DL = DistLattice[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module On (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged) (w : L.L)
 (affine : Qcqs[l].Over[L,X].AffineOpen w) {
 module ST = SerreModuleSheafStructure[l].On[L,X.sheaf,X.is-sheaf] ;
 module S = Slice[l].Over[L,X,w] ;
 module AC = AffineCriterion[l].Over[S.lattice,S.restricted] ;
 module SM = AC.Can.Of[RH.identity (X.sheaf.ring w)].SM ;
 module SO = DL.Order[S.lattice] ;
 module At (s : (X.sheaf.ring w).R) {
  module Lam = SerreLambda[l].On[L,X,ST.structure,w].At[s] ;
  module C = Lam.C ;
  module CO = SerreSectionLocalisationMap[l].On[S.lattice,S.restricted,SerreLambda[l].On[L,X,ST.structure,w].R.restricted] ;
  Loc : CRing = AC.GX.Loc s ;
  chart-open : S.Opens = DL.hmap SM.pi (AC.ZG.D s) ;
  -- the chart's sharp at D s, after extension, is phi_s
  sharp (x : (AC.Can.Sh.structure.ring (AC.ZG.D s)).R) : (X.sheaf.ring (S.inc chart-open)).R =
   map (AC.canonical.sharp (AC.ZG.D s)) x ;
  sharp-equiv : Pr.isEquiv (AC.Can.Sh.structure.ring (AC.ZG.D s)).R (X.sheaf.ring (S.inc chart-open)).R sharp =
   AC.I.sharp-equiv {AC.canonical} affine (AC.ZG.D s) ;
  extend-equiv : Pr.isEquiv Loc.R (AC.Can.Sh.structure.ring (AC.ZG.D s)).R (SM.B.At[s].extend) =
   Pr.qinv Loc.R (AC.Can.Sh.structure.ring (AC.ZG.D s)).R SM.B.At[s].extend SM.B.At[s].eval
    SM.B.At[s].extend-eval SM.B.At[s].eval-extend ;
  sharp-extend (x : Loc.R) : Id (X.sheaf.ring (S.inc chart-open)).R (sharp (SM.B.At[s].extend x)) (map SM.Basic[s].phi-g x) =
   calc (X.sheaf.ring (S.inc chart-open)).R {
    sharp (SM.B.At[s].extend x)
     =< SM.E.extension-map-at (AC.ZG.D s) (SM.B.At[s].extend x) > SM.E.extend (AC.ZG.D s) (SM.B.At[s].extend x)
     =< SM.E.extend-basic s (SM.B.At[s].extend x) > map SM.Basic[s].phi-g (SM.B.At[s].eval (SM.B.At[s].extend x))
     =< ap (map SM.Basic[s].phi-g) (SM.B.At[s].eval-extend x) > map SM.Basic[s].phi-g x } ;
  phi-equiv : Pr.isEquiv Loc.R (X.sheaf.ring (S.inc chart-open)).R (map SM.Basic[s].phi-g) =
   Iso[l].equiv-homotopy Loc.R (X.sheaf.ring (S.inc chart-open)).R (\ x -> sharp (SM.B.At[s].extend x))
    (map SM.Basic[s].phi-g) sharp-extend
    (Iso[l].equiv-compose Loc.R (AC.Can.Sh.structure.ring (AC.ZG.D s)).R (X.sheaf.ring (S.inc chart-open)).R
     sharp SM.B.At[s].extend sharp-equiv extend-equiv) ;
  -- pi(D s) is D_w(s)
  same-open : Id S.Opens chart-open C.open-f = SM.pi-D s ;
  to-open : SO.Le C.open-f chart-open = SO.le-of-eq C.open-f chart-open (sym same-open) ;
  from-open : SO.Le chart-open C.open-f = SO.le-of-eq chart-open C.open-f same-open ;
  move : RH.Hom (X.sheaf.ring (S.inc chart-open)) (X.sheaf.ring Lam.open-g) = S.sheaf.res C.open-f chart-open to-open ;
  move-equiv : Pr.isEquiv (X.sheaf.ring (S.inc chart-open)).R (X.sheaf.ring Lam.open-g).R (map move) =
   Iso[l].EqualOpens[S.lattice,S.sheaf,C.open-f,chart-open,to-open,from-open].equiv ;
  psi : RH.Hom Loc (X.sheaf.ring Lam.open-g) = RH.compose Loc (X.sheaf.ring (S.inc chart-open)) (X.sheaf.ring Lam.open-g) move SM.Basic[s].phi-g ;
  psi-equiv : Pr.isEquiv Loc.R (X.sheaf.ring Lam.open-g).R (map psi) =
   Iso[l].equiv-homotopy Loc.R (X.sheaf.ring Lam.open-g).R (\ x -> map move (map SM.Basic[s].phi-g x)) (map psi)
    (\ x -> sym (map-compose move SM.Basic[s].phi-g x))
    (Iso[l].equiv-compose Loc.R (X.sheaf.ring (S.inc chart-open)).R (X.sheaf.ring Lam.open-g).R
     (map move) (map SM.Basic[s].phi-g) move-equiv phi-equiv) ;
  psi-on (b : (X.sheaf.ring w).R) : Id (X.sheaf.ring Lam.open-g).R (map psi (map (AC.GX.inclusion s) b)) (map C.ring-map b) =
   calc (X.sheaf.ring Lam.open-g).R {
    map psi (map (AC.GX.inclusion s) b)
     =< map-compose move SM.Basic[s].phi-g (map (AC.GX.inclusion s) b)
      > map move (map SM.Basic[s].phi-g (map (AC.GX.inclusion s) b))
     =< ap (map move) (SM.Basic[s].phi-g-on b) > map move (map SM.Basic[s].on-A b)
     =< ap (map move) (map-compose (S.sheaf.res chart-open S.lattice.top SM.Basic[s].le-top) (RH.identity (X.sheaf.ring w)) b)
      > map move (map (S.sheaf.res chart-open S.lattice.top SM.Basic[s].le-top) b)
     =< S.sheaf.res-comp C.open-f chart-open S.lattice.top to-open SM.Basic[s].le-top C.below b
      > map C.ring-map b } ;
  module El = SerreRingLocalisationElementary[l].Transfer[X.sheaf.ring w,s,Loc,X.sheaf.ring Lam.open-g,
   AC.GX.inclusion s,C.ring-map,AC.GX.elementary s,psi,psi-equiv,psi-on] ;
  module Br = SerreModuleRingLocalisationBridge[l].Over[X.sheaf.ring w,X.sheaf.ring-set w,s,
   X.sheaf.ring Lam.open-g,X.sheaf.ring-set Lam.open-g,C.ring-map,El.elementary] ;
  -- the bridge and lambda both clear s^p on x/s^p to the restriction of x;
  -- the action of s on O(D_w s) is invertible, so they agree
  restrict-ring (x : (X.sheaf.ring w).R) :
   Id (X.sheaf.ring Lam.open-g).R (CO.MO.restrict C.open-f S.lattice.top C.below x) (map C.ring-map x) =
   refl (map C.ring-map x) ;
  same-fraction (x : (X.sheaf.ring w).R) (p : Nat) :
   Id (X.sheaf.ring Lam.open-g).R (Br.forward (C.E.S.fraction x p)) (Lam.map (C.E.S.fraction x p)) =
   C.E.InverseAction.power-injective p _ _
    (trans (Br.forward-clears x p) (trans (sym (restrict-ring x)) (sym (C.clears x p)))) ;
  same (z : Lam.Source) : Id (X.sheaf.ring Lam.open-g).R (Br.forward z) (Lam.map z) =
   C.E.S.induction @l (\ z -> Id (X.sheaf.ring Lam.open-g).R (Br.forward z) (Lam.map z))
    (\ z -> X.sheaf.ring-set Lam.open-g _ _) same-fraction z ;
  equivalence : Lam.IsEquivalence =
   Iso[l].equiv-homotopy Lam.Source (X.sheaf.ring Lam.open-g).R Br.forward Lam.map same Br.equivalence ;
 } ;
} ;
