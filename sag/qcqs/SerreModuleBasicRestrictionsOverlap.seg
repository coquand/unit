-- Clear a newly inverted factor on a module overlap (Serre, Section 3).
-- Restricting x/h^p to M_(gh) gives g^p*x/(gh)^p: multiplying by h^p
-- checks the formula, since h is invertible there. Thus g^p times an
-- arbitrary overlap fraction lifts to M_h. If a restricted fraction
-- vanishes, numerator kernel detection gives (gh)^e*g^p*x=0. Commuting
-- scalar powers says h^e kills g^(e+p)*x, proving the local power-killing
-- assertion. All representative and exponent choices remain truncated.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module SM = SerreModule[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (Md : SM.Over[A].Module) {
 module R = SerreModuleBasicRestrictions[l].Over[A,setA,Md] ;
 module Z = R.Z ; module O = Z.O ;
 module AP = AffinePowers[l].Over[A] ;
 module ML = SM.Over[A].Laws[Md] ;
 module Sp = DistLattice[l].Supports[A,Z.lattice].Of[Z.D,Z.support] ;
 module At (g h : A.R) {
  gh : A.R = A.mul g h ;
  below : O.Le (Z.D gh) (Z.D h) =
   O.le-trans (Z.D gh) (Z.D (A.mul h g)) (Z.D h)
    (O.le-of-eq (Z.D gh) (Z.D (A.mul h g)) (ap Z.D (A.mulC g h))) (Sp.scaled h g) ;
  module P = R.At[h,gh,below] ;
  module H = R.Local[h].Native ;
  module K = R.Local[gh].Native ;
  module Self = R.At[gh,gh,O.le-refl (Z.D gh)] ;
  source-power (p : Nat) (x : Md.M) :
   Id Md.M (Md.sm (AP.power h p) (Md.sm (AP.power g p) x)) (K.L.power p x) =
   trans (Md.smA (AP.power h p) (AP.power g p) x)
    (trans (ap (\ a -> Md.sm a x)
     (trans (A.mulC (AP.power h p) (AP.power g p)) (sym (AP.power-mul g h p))))
     (sym (K.L.power-scalar p x))) ;
  candidate-clears (x : Md.M) (p : Nat) : Id K.L.Carrier
   (P.E.T.power p (K.L.fraction (Md.sm (AP.power g p) x) p)) (K.L.fraction x zero) =
   trans (P.E.T.power-scalar p (K.L.fraction (Md.sm (AP.power g p) x) p))
    (trans (K.Action.scale-at (AP.power h p) (Md.sm (AP.power g p) x) p)
     (trans (ap (\ y -> K.L.fraction y p) (source-power p x))
      (trans (ap (K.L.fraction (K.L.power p x)) (sym (plus-zero p))) (K.L.raise x zero p)))) ;
  on-fraction (x : Md.M) (p : Nat) : Id K.L.Carrier
   (P.map (H.L.fraction x p)) (K.L.fraction (Md.sm (AP.power g p) x) p) =
   P.E.InverseAction.power-injective p _ _ (trans (P.clears x p) (sym (candidate-clears x p))) ;
  Clear (z : K.L.Carrier) : U l = (r : Nat) * (y : H.L.Carrier) *
   Id K.L.Carrier (P.map y) (K.localised.sm (AP.power g r) z) ;
  clear-fraction (x : Md.M) (p : Nat) : Clear (K.L.fraction x p) =
   (p,H.L.fraction x p,trans (on-fraction x p) (sym (K.Action.scale-at (AP.power g p) x p))) ;
  clear (z : K.L.Carrier) : Tr.Trunc[Clear z].carrier =
   K.L.induction @l (\ z -> Tr.Trunc[Clear z].carrier) (\ z -> Tr.Trunc[Clear z].proposition)
    (\ x p -> Tr.Trunc[Clear (K.L.fraction x p)].inc (clear-fraction x p)) z ;
  numerator-zero (x : Md.M) (p : Nat) (e : Id K.L.Carrier (K.L.fraction x p) K.Action.mz) :
   Id K.L.Carrier (K.L.fraction x zero) K.Action.mz =
   trans (sym (Self.E.diagonal x p))
    (trans (ap (Self.E.SP.power p) e)
     (trans (Self.E.SP.power-scalar p K.Action.mz)
      (SM.Over[A].Laws[K.localised].sm-zero (AP.power gh p)))) ;
  commute-kill (x : Md.M) (p e : Nat) :
   Id Md.M (H.L.power e (Md.sm (AP.power g (plus e p)) x))
    (K.L.power e (Md.sm (AP.power g p) x)) =
   trans (H.L.power-scalar e (Md.sm (AP.power g (plus e p)) x))
    (trans (ap (Md.sm (AP.power h e))
     (trans (ap (\ a -> Md.sm a x) (AP.power-add g e p)) (sym (Md.smA (AP.power g e) (AP.power g p) x))))
     (trans (Md.smA (AP.power h e) (AP.power g e) (Md.sm (AP.power g p) x))
      (trans (ap (\ a -> Md.sm a (Md.sm (AP.power g p) x))
       (trans (A.mulC (AP.power h e) (AP.power g e)) (sym (AP.power-mul g h e))))
       (sym (K.L.power-scalar e (Md.sm (AP.power g p) x)))))) ;
  Kill (y : H.L.Carrier) : U l = (r : Nat) * Id H.L.Carrier (H.localised.sm (AP.power g r) y) H.Action.mz ;
  fraction-killed (x : Md.M) (p : Nat) (w : H.L.Killed x) : Id H.L.Carrier (H.L.fraction x p) H.Action.mz =
   H.L.equal x Md.mz p zero (Tr.Trunc[H.L.Witness (x,p) (Md.mz,zero)].inc
    (w.1,trans (ap (\ n -> H.L.power n x) (plus-zero w.1))
     (trans w.2 (sym (H.L.power-zero (plus w.1 p)))))) ;
  kill-witness (x : Md.M) (p : Nat) (w : K.L.Killed (Md.sm (AP.power g p) x)) : Kill (H.L.fraction x p) =
   (plus w.1 p,
    trans (H.Action.scale-at (AP.power g (plus w.1 p)) x p)
     (fraction-killed (Md.sm (AP.power g (plus w.1 p)) x) p (w.1,trans (commute-kill x p w.1) w.2))) ;
  killed-fraction (x : Md.M) (p : Nat) (e : Id K.L.Carrier (P.map (H.L.fraction x p)) K.Action.mz) :
   Tr.Trunc[Kill (H.L.fraction x p)].carrier =
   Tr.Trunc[K.L.Killed (Md.sm (AP.power g p) x)].induction @l
    (\ w -> Tr.Trunc[Kill (H.L.fraction x p)].carrier)
    (\ w -> Tr.Trunc[Kill (H.L.fraction x p)].proposition)
    (\ w -> Tr.Trunc[Kill (H.L.fraction x p)].inc (kill-witness x p w))
    (K.L.zero-killed (Md.sm (AP.power g p) x)
     (numerator-zero (Md.sm (AP.power g p) x) p (trans (sym (on-fraction x p)) e))) ;
  kill (y : H.L.Carrier) : Id K.L.Carrier (P.map y) K.Action.mz -> Tr.Trunc[Kill y].carrier =
   H.L.induction @l (\ y -> Id K.L.Carrier (P.map y) K.Action.mz -> Tr.Trunc[Kill y].carrier)
    (\ y -> Axioms[l].FunExtLemmas[fe @l].isProp-Pi (Id K.L.Carrier (P.map y) K.Action.mz)
     (\ e -> Tr.Trunc[Kill y].carrier) (\ e -> Tr.Trunc[Kill y].proposition)) killed-fraction y ;
 } ;
} ;
