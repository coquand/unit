-- Basic compact opens of an affine representable are affine functors.
-- The classifier is the Yoneda extension of D(a).  Write L=A[1/a].
-- The forward natural map sends k : L -> B to k . beta.  It lands in D(a):
-- beta(a) is a unit, so is its image, and ZariskiUnits gives D(k beta a)=top.
-- Conversely, membership of h : A -> B gives that h(a) is a unit.  Its
-- powers are units (power-map), so localisation's universal property
-- supplies a unique extension L -> B.  Its equation gives the first
-- inverse law by realisation point-ext; uniqueness out of a localisation
-- gives the other.  The forward family is natural by Yoneda and the
-- realisation lifting interface.  Thus its componentwise bijections give
-- a natural equivalence h_L -> |D(a)|, and a witness of affineness.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l+] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module ZF = ZariskiFunctor[l] ;
module TE = TestEquivalences[l] ;
module QF = FunctorialQcqs[l] ;
module Over (A : T.Test) (a : A.ring.R) {
 module AB = T.At[A].A ;
 module ZA = T.At[A].Z ;
 module H = SF.Representable[A] ;
 module YZ = TestYoneda[l].Over[A,ZF.functor] ;
 basic : CompactOpens[l].Over[H.functor].Open = YZ.extend (ZA.D a) ;
 module R = OpenRealisation[l].Over[H.functor,basic] ;
 local-test : T.Test = new T.Test[AB.Loc a,AB.set a] ;
 module HL = SF.Representable[local-test] ;
 module Y = TestYoneda[l].Over[local-test,H.functor] ;
 module SB = SpecBasicOpen[l].Over[A.ring,A.carrier-set,a] ;
 lands (B : T.Test) (k : RH.Hom local-test.ring B.ring) : R.Member B (RH.compose A.ring local-test.ring B.ring k (AB.inclusion a)) =
  trans (ZF.OnMap[A,B,RH.compose A.ring local-test.ring B.ring k (AB.inclusion a)].on-D a)
   (ZariskiUnits[l].Over[B].At[map k (map (AB.inclusion a) a)].from-unit
    (AffineRing[l].unit-map local-test.ring B.ring k (map (AB.inclusion a) a) SB.beta-unit)) ;
 module Lift = R.Lift[HL.functor,Y.extend (AB.inclusion a),lands] ;
 module At (B : T.Test) {
  module Br = Bridge[l].Over[A.ring,a] ;
  module PA = AffinePowers[l].Over[A.ring] ;
  module PB = AffinePowers[l].Over[B.ring] ;
  forward (k : RH.Hom local-test.ring B.ring) : R.obj B =
   (RH.compose A.ring local-test.ring B.ring k (AB.inclusion a),lands B k) ;
  module Back (p : R.obj B) {
   unit : RL[B.ring].unit (map {A.ring} {B.ring} (R.point p) a) =
    ZariskiUnits[l].Over[B].At[map {A.ring} {B.ring} (R.point p) a].to-unit
     (trans (sym (ZF.OnMap[A,B,R.point p].on-D a)) (R.member p)) ;
   unit-power (n : Nat) : RL[B.ring].unit (map {A.ring} {B.ring} (R.point p) (PA.power a n)) =
    Pr.subst B.ring.R (RL[B.ring].unit) (PB.power (map {A.ring} {B.ring} (R.point p) a) n)
     (map {A.ring} {B.ring} (R.point p) (PA.power a n)) (sym (AffinePowers[l].power-map A.ring B.ring (R.point p) a n))
     (PB.Units[B.carrier-set].power-unit (map {A.ring} {B.ring} (R.point p) a) unit n) ;
   inverts : Br.LocH.Inverts B.ring (R.point p) = \ s hs ->
    Pr.subst A.ring.R (\ x -> RL[B.ring].unit (map {A.ring} {B.ring} (R.point p) x)) (PA.power a (Br.index hs)) s (Br.index-eq hs) (unit-power (Br.index hs)) ;
   extensions : Localisation[l].isContr (Br.LocH.Extension local-test.ring B.ring (AB.inclusion a) (R.point p)) =
    Br.LocH.universal local-test.ring (AB.inclusion a) (AB.elementary a) B.ring B.carrier-set (R.point p) inverts ;
   backward : RH.Hom local-test.ring B.ring = extensions.1.1 ;
   on-base : Id (RH.Hom A.ring B.ring) (RH.compose A.ring local-test.ring B.ring backward (AB.inclusion a)) (R.point p) = extensions.1.2 ;
   forward-back : Id (R.obj B) (forward backward) p = R.point-ext B (forward backward) p on-base ;
  } ;
  back-forward (k : RH.Hom local-test.ring B.ring) : Id (RH.Hom local-test.ring B.ring) Back[forward k].backward k =
   Br.LocH.Agree[local-test.ring,AB.inclusion a,Br.LocH.is-loc local-test.ring (AB.inclusion a) (AB.elementary a),B.ring,B.carrier-set,
    Back[forward k].backward,k,\ x -> ap (\ h -> map {A.ring} {B.ring} h x) Back[forward k].on-base].equal ;
 } ;
 equivalence : TE.NaturalEquivalence HL.functor R.functor =
  (Lift.lift,\ B -> Pr.qinv (RH.Hom local-test.ring B.ring) (R.obj B) At[B].forward (\ p -> At[B].Back[p].backward)
   (\ p -> At[B].Back[p].forward-back) At[B].back-forward) ;
 affine : QF.IsAffine R.functor = Tr.Trunc[QF.AffineWitness R.functor].inc (local-test,equivalence) ;
} ;
