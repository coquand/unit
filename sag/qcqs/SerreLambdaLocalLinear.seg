-- Two facts about B-linear maps out of a native localisation N_s.
-- (Clears) If k : N_s -> Q is B-linear, then s^p k(x/s^p) = k(x/1),
--  since s^p (x/s^p) = x/1 in N_s.
-- (Semilinear) Let psi : B_s -> T be a ring map and P a T-module, and
--  suppose k : N_s -> P satisfies k(b z) = psi(b/1) k(z). Then k is
--  semilinear over psi for the action of the ring of fractions B_s on N_s:
--  k(r z) = psi(r) k(z). Write r merely as a/d with d a power of s, so
--  (d/1) r = a/1. Then psi(d/1) k(r z) = k((d/1) r z) = k(a z) =
--  psi(a/1) k(z) = psi(d/1) psi(r) k(z), and psi(d/1) is a unit in T.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module RH = RingHom[l] ; module RM = RingMaps[l] ; module LC = SerreModuleLocalisation[l] ;
module Over (B : CRing) (setB : Pr.isSet B.R) (Md : SM.Over[B].Module) (s : B.R) {
 module Sc = SerreModuleLocalisationScalarsRing[l].At[B,setB,Md,s] ;
 module Native = Sc.Native ;
 module AF = Affine[l].Over[B] ; module LH = Bridge[l].Over[B,s].LocH ;
 module AP = AffinePowers[l].Over[B] ;
 module SP = LC.At[B,Native.localised,s] ;
 diagonal (x : Md.M) (p : Nat) : Id Native.L.Carrier (SP.power p (Native.L.fraction x p)) (Native.L.fraction x zero) =
  trans (SP.power-scalar p (Native.L.fraction x p))
   (trans (Native.Action.scale-at (AP.power s p) x p)
    (trans (ap (\ y -> Native.L.fraction y p) (sym (Native.L.power-scalar p x)))
     (trans (ap (Native.L.fraction (Native.L.power p x)) (sym (plus-zero p))) (Native.L.raise x zero p)))) ;
 module Clears (Q : SM.Over[B].Module) (k : Native.L.Carrier -> Q.M)
  (k-scale : (b : B.R) (z : Native.L.Carrier) -> Id Q.M (k (Native.localised.sm b z)) (Q.sm b (k z))) {
  module T = LC.At[B,Q,s] ;
  clears (x : Md.M) (p : Nat) : Id Q.M (T.power p (k (Native.L.fraction x p))) (k (Native.L.fraction x zero)) =
   trans (T.power-scalar p (k (Native.L.fraction x p)))
    (trans (sym (k-scale (AP.power s p) (Native.L.fraction x p)))
     (ap k (trans (sym (SP.power-scalar p (Native.L.fraction x p))) (diagonal x p)))) ;
 } ;
 module Semilinear (T : CRing) (P : SM.Over[T].Module) (psi : RH.Hom (AF.Loc s) T)
  (k : Native.L.Carrier -> P.M)
  (k-scale : (b : B.R) (z : Native.L.Carrier) ->
   Id P.M (k (Native.localised.sm b z)) (P.sm (RM.map psi (RM.map (AF.inclusion s) b)) (k z))) {
  module Rep (r : (AF.Loc s).R) (rep : LH.Fraction (AF.Loc s) (AF.inclusion s) r) (z : Native.L.Carrier) {
   d : B.R = LH.den rep ;
   unit : RL[T].unit (RM.map psi (RM.map (AF.inclusion s) d)) =
    AffineRing[l].unit-map (AF.Loc s) T psi (RM.map (AF.inclusion s) d) (LH.inverts (AF.elementary s) d (LH.den-in rep)) ;
   module Act = SerreModuleBasicRestrictions[l].UnitAction[T,P,RM.map psi (RM.map (AF.inclusion s) d),unit] ;
   source : Id Native.L.Carrier (Native.localised.sm d (Sc.localised.sm r z)) (Native.localised.sm (LH.num rep) z) =
    trans (sym (Sc.ER.original-action d (Sc.localised.sm r z)))
     (trans (Sc.localised.smA (RM.map (AF.inclusion s) d) r z)
      (trans (ap (\ a -> Sc.localised.sm a z) (LH.eqn rep)) (Sc.ER.original-action (LH.num rep) z))) ;
   ring : Id T.R (T.mul (RM.map psi (RM.map (AF.inclusion s) d)) (RM.map psi r)) (RM.map psi (RM.map (AF.inclusion s) (LH.num rep))) =
    trans (sym (RM.map-mul psi (RM.map (AF.inclusion s) d) r)) (ap (RM.map psi) (LH.eqn rep)) ;
   equation : Id P.M (k (Sc.localised.sm r z)) (P.sm (RM.map psi r) (k z)) =
    Iso[l].injective P.M P.M (P.sm (RM.map psi (RM.map (AF.inclusion s) d))) Act.equiv _ _ (calc P.M {
     P.sm (RM.map psi (RM.map (AF.inclusion s) d)) (k (Sc.localised.sm r z))
      =< sym (k-scale d (Sc.localised.sm r z)) > k (Native.localised.sm d (Sc.localised.sm r z))
      =< ap k source > k (Native.localised.sm (LH.num rep) z)
      =< k-scale (LH.num rep) z > P.sm (RM.map psi (RM.map (AF.inclusion s) (LH.num rep))) (k z)
      =< ap (\ c -> P.sm c (k z)) (sym ring)
       > P.sm (T.mul (RM.map psi (RM.map (AF.inclusion s) d)) (RM.map psi r)) (k z)
      =< sym (P.smA (RM.map psi (RM.map (AF.inclusion s) d)) (RM.map psi r) (k z))
       > P.sm (RM.map psi (RM.map (AF.inclusion s) d)) (P.sm (RM.map psi r) (k z)) }) ;
  } ;
  scale (r : (AF.Loc s).R) (z : Native.L.Carrier) : Id P.M (k (Sc.localised.sm r z)) (P.sm (RM.map psi r) (k z)) =
   Tr.Trunc[LH.Fraction (AF.Loc s) (AF.inclusion s) r].induction @l
    (\ w -> Id P.M (k (Sc.localised.sm r z)) (P.sm (RM.map psi r) (k z))) (\ w -> P.setM _ _)
    (\ rep -> Rep[r,rep,z].equation) (LH.fractions (AF.elementary s) r) ;
 } ;
} ;
