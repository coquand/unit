-- lambda on an open v of a slice X|u is lambda on v in X.
-- For v <= u and c in O(v), SerreLambda of X at v and SerreLambda of the
-- slice X|u at v have the same section modules, the same open D_v(c)
-- (the invertibility opens of X|u are those of X), and restriction maps
-- that differ only in the witnesses of the inequalities. So clearing and
-- killing pass along the square of identities (SerreLambdaElementarySquare),
-- as in SerreLambdaTop.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module DL = DistLattice[l] ;
module RH = RingHom[l] ; module MM = SerreModuleMaps[l] ; module MS = SerreModuleSheaf[l] ;
module On (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged)
 (M : MS.On[L,X.sheaf].ModuleSheaf) (u : L.L) (v : Slice[l].Over[L,X,u].Opens)
 (c : (X.sheaf.ring (Slice[l].Over[L,X,u].inc v)).R)
 (equiv : SerreLambda[l].On[L,X,M,Slice[l].Over[L,X,u].inc v].At[c].IsEquivalence) {
 module S = Slice[l].Over[L,X,u] ;
 module R = SerreModuleSheafRestriction[l].On[L,X,u,M] ;
 module GO = RingedLattice[l].On[L].Of[X.sheaf] ;
 module MO = MS.On[L,X.sheaf].Of[M.presheaf] ;
 module Cl1 = SerreLambdaClearing[l].On[L,X,M,S.inc v,c] ;
 module Cl2 = SerreLambdaClearing[l].On[S.lattice,S.restricted,R.restricted,v,c] ;
 module F1 = Cl1.Elementary[equiv] ;
 A : CRing = X.sheaf.ring (S.inc v) ;
 Md : SerreModule[l].Over[A].Module = M.presheaf.module-at (S.inc v) ;
 D : L.L = Cl1.Lam.open-g ;
 module HI = MM.Between[A,A,RH.identity A,Md,Md] ;
 module HJ = MM.Between[A,A,RH.identity A,Cl2.C.Scalars.restricted,Cl1.C.Scalars.restricted] ;
 i : HI.Hom = new HI.Hom[\ x -> x,\ x y -> refl (Md.madd x y),\ a x -> refl (Md.sm a x)] ;
 i-equiv : Pr.isEquiv Md.M Md.M (HI.map i) = Pr.qinv _ _ (HI.map i) (\ x -> x) (\ x -> refl x) (\ x -> refl x) ;
 j : HJ.Hom = new HJ.Hom[\ y -> y,\ x y -> refl ((M.presheaf.module-at D).madd x y),
  \ a y -> ap (\ r -> (M.presheaf.module-at D).sm r y)
   (GO.res-irr D (S.inc v) (S.le-inc Cl2.Lam.open-g v Cl2.Lam.below) Cl1.Lam.below a)] ;
 j-equiv : Pr.isEquiv (M.presheaf.module-at D).M (M.presheaf.module-at D).M (HJ.map j) =
  Pr.qinv _ _ (HJ.map j) (\ y -> y) (\ y -> refl y) (\ y -> refl y) ;
 j-at (y : (M.presheaf.module-at D).M) : Id (M.presheaf.module-at D).M (HJ.map j y) y = refl y ;
 i-at (x : Md.M) : Id Md.M (HI.map i x) x = refl x ;
 commutes (x : Md.M) : Id (M.presheaf.module-at D).M (HJ.map j (Cl2.E.H.map Cl2.C.original x)) (Cl1.E.H.map Cl1.C.original (HI.map i x)) =
  calc (M.presheaf.module-at D).M {
   HJ.map j (Cl2.E.H.map Cl2.C.original x)
    =< j-at (Cl2.E.H.map Cl2.C.original x) > Cl2.E.H.map Cl2.C.original x
    =< Cl2.C.original-at x > MO.restrict D (S.inc v) (S.le-inc Cl2.Lam.open-g v Cl2.Lam.below) x
    =< MO.res-irr D (S.inc v) (S.le-inc Cl2.Lam.open-g v Cl2.Lam.below) Cl1.Lam.below x > MO.restrict D (S.inc v) Cl1.Lam.below x
    =< sym (Cl1.C.original-at x) > Cl1.E.H.map Cl1.C.original x
    =< ap (Cl1.E.H.map Cl1.C.original) (sym (i-at x)) > Cl1.E.H.map Cl1.C.original (HI.map i x) } ;
 module Sq = SerreLambdaElementarySquare[l].Square[A,Md,Cl2.C.Scalars.restricted,Md,Cl1.C.Scalars.restricted,
  Cl2.C.original,Cl1.C.original,i,i-equiv,j,j-equiv,commutes,c] ;
 equivalence : SerreLambda[l].On[S.lattice,S.restricted,R.restricted,v].At[c].IsEquivalence =
  Cl2.equivalence (Sq.clear F1.clear) (Sq.kill F1.kill) ;
} ;
