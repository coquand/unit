-- The univalent category of module sheaves on (L, G) (PLAN-QCOH-UA, step 2).
-- Informal proof.  Objects: module sheaves (SerreModuleSheaf.ModuleSheaf);
-- arrows E -> F: natural linear maps (Transform.Hom) of the presheaves.
-- A natural map is a family of linear maps with a naturality proof, a
-- proposition (equations in sets); so two natural maps with the same
-- section maps are equal (ext), and the arrows form a set (Hedberg).
-- Identity (SerreModuleSheafIsoOps.Identity) and composition are
-- pointwise, so the unit and associativity laws hold by ext.
-- Categorical isos are natural linear equivalences
-- (SerreModuleSheafIso.Equivalence): an equivalence has the natural
-- inverse of SerreModuleSheafIso.Inverse (to-iso); conversely the two
-- inverse equations, evaluated at a section, make every section map an
-- equivalence (to-equivalence).  The two maps are inverse (iso-eq: an iso
-- is determined by its arrow; being an equivalence is a proposition).
-- Univalence: the singleton of isos at E is a retract of the total space
-- of natural linear equivalences out of E, contractible by
-- SerreModuleSheafIdentity; Category.FromTotal.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Hi = Prelude[l+] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module IT = IdentityTools[l] ;
module GH = SipGeneric[l+] ;
module DL = DistLattice[l] ;
module MS = SerreModuleSheaf[l] ;
module CC = Category[l+,l] ;
module On (L : DL.DLat) (G : RingedLattice[l].On[L].Presheaf) {
 module O = DL.Order[L] ;
 module P = MS.On[L,G] ;
 module I = SerreModuleSheafIso[l].On[L,G] ;
 module SI = SerreModuleSheafIdentity[l].On[L,G] ;
 module Ops = SerreModuleSheafIsoOps[l].Over[L,G] ;
 -- natural maps are determined by their section maps
 module Arrow (E F : P.Presheaf) {
  module T = P.Transform[E,F] ;
  module C (a : L.L) { module H = SerreBilinear[l].Over[G.ring a].Hom[E.module-at a,F.module-at a] ; } ;
  Components : U l = (a : L.L) -> C[a].H.H.Hom ;
  NaturalAt (c : Components) (a b : L.L) (k : O.Le a b) (x : (E.module-at b).M) : U l =
   Id (F.module-at a).M ((c a).fn (T.EO.restrict a b k x)) (T.FO.restrict a b k ((c b).fn x)) ;
  Natural (c : Components) : U l = (a b : L.L) (k : O.Le a b) (x : (E.module-at b).M) -> NaturalAt c a b k x ;
  natural-prop (c : Components) : Pr.isProp (Natural c) =
   FL.isProp-Pi L.L (\ a -> (b : L.L) (k : O.Le a b) (x : (E.module-at b).M) -> NaturalAt c a b k x) (\ a ->
   FL.isProp-Pi L.L (\ b -> (k : O.Le a b) (x : (E.module-at b).M) -> NaturalAt c a b k x) (\ b ->
   FL.isProp-Pi (O.Le a b) (\ k -> (x : (E.module-at b).M) -> NaturalAt c a b k x) (\ k ->
   FL.isProp-Pi (E.module-at b).M (NaturalAt c a b k) (\ x -> (F.module-at a).setM _ _)))) ;
  pack (q : T.Hom) : (c : Components) * Natural c = (q.component,q.natural) ;
  unpack (w : (c : Components) * Natural c) : T.Hom = new T.Hom[w.1,w.2] ;
  eta : (q : T.Hom) -> Id T.Hom (unpack (pack q)) q = split { Hom component natural -> refl (new T.Hom[component,natural]) } ;
  Agree (q r : T.Hom) : U l = (a : L.L) (x : (E.module-at a).M) -> Id (F.module-at a).M (T.at q a x) (T.at r a x) ;
  ext (q r : T.Hom) (h : Agree q r) : Id T.Hom q r =
   trans (sym (eta q)) (trans (ap unpack
    (Pr.Sigma-eq Components Natural q.component r.component q.natural r.natural
     (FL.funext L.L (\ a -> C[a].H.H.Hom) q.component r.component (\ a -> C[a].H.ext (q.component a) (r.component a) (h a)))
     (natural-prop r.component))) (eta r)) ;
  agree-prop (q r : T.Hom) : Pr.isProp (Agree q r) =
   FL.isProp-Pi L.L (\ a -> (x : (E.module-at a).M) -> Id (F.module-at a).M (T.at q a x) (T.at r a x)) (\ a ->
    FL.isProp-Pi (E.module-at a).M (\ x -> Id (F.module-at a).M (T.at q a x) (T.at r a x)) (\ x -> (F.module-at a).setM _ _)) ;
  set : Pr.isSet T.Hom = \ q -> Pr.Hedberg[T.Hom,q,Agree q,agree-prop q,\ a x -> refl (T.at q a x),ext q].hedberg ;
 } ;
 -- composition, pointwise
 module Composite (E F H : P.Presheaf) (g : P.Transform[F,H].Hom) (f : P.Transform[E,F].Hom) {
  module EF = P.Transform[E,F] ; module FH = P.Transform[F,H] ; module EH = P.Transform[E,H] ;
  component (a : L.L) : Arrow[E,H].C[a].H.H.Hom =
   SerreBilinear[l].Over[G.ring a].Composite[E.module-at a,F.module-at a,H.module-at a,f.component a,g.component a].map ;
  natural (a b : L.L) (k : O.Le a b) (x : (E.module-at b).M) : Arrow[E,H].NaturalAt component a b k x =
   trans (ap (FH.at g a) (f.natural a b k x)) (g.natural a b k (EF.at f b x)) ;
  composite : EH.Hom = new EH.Hom[component,natural] ;
  -- by definition
  composite-at (a : L.L) (x : (E.module-at a).M) :
   Id (H.module-at a).M (EH.at composite a x) (FH.at g a (EF.at f a x)) = refl (FH.at g a (EF.at f a x)) ;
 } ;
 hom (E F : P.ModuleSheaf) : U l = P.Transform[E.presheaf,F.presheaf].Hom ;
 idn (E : P.ModuleSheaf) : hom E E = Ops.Identity[E.presheaf].identity ;
 comp (E F H : P.ModuleSheaf) (g : hom F H) (f : hom E F) : hom E H =
  Composite[E.presheaf,F.presheaf,H.presheaf,g,f].composite ;
 at (E F : P.ModuleSheaf) (f : hom E F) (a : L.L) (x : (E.presheaf.module-at a).M) : (F.presheaf.module-at a).M =
  P.Transform[E.presheaf,F.presheaf].at f a x ;
 idn-at (E : P.ModuleSheaf) (a : L.L) (x : (E.presheaf.module-at a).M) :
  Id (E.presheaf.module-at a).M (at E E (idn E) a x) x = Ops.Identity[E.presheaf].identity-at a x ;
 unit-l (E F : P.ModuleSheaf) (f : hom E F) : Id (hom E F) (comp E F F (idn F) f) f =
  Arrow[E.presheaf,F.presheaf].ext _ _ (\ a x -> idn-at F a (at E F f a x)) ;
 unit-r (E F : P.ModuleSheaf) (f : hom E F) : Id (hom E F) (comp E E F f (idn E)) f =
  Arrow[E.presheaf,F.presheaf].ext _ _ (\ a x -> ap (at E F f a) (idn-at E a x)) ;
 assoc (W X Y Z : P.ModuleSheaf) (f : hom W X) (g : hom X Y) (h : hom Y Z) :
  Id (hom W Z) (comp W Y Z h (comp W X Y g f)) (comp W X Z (comp X Y Z h g) f) =
  Arrow[W.presheaf,Z.presheaf].ext _ _ (\ a x -> refl (at Y Z h a (at X Y g a (at W X f a x)))) ;
 precategory : CC.Precategory = new CC.Precategory[P.ModuleSheaf,hom,
  \ E F -> Arrow[E.presheaf,F.presheaf].set,idn,comp,unit-l,unit-r,assoc] ;
 module Arr = Arrows[l+,l].Arrows[precategory] ;
 -- natural linear equivalences are categorical isos
 module ToIso (E F : P.ModuleSheaf) (e : I.Equivalence E.presheaf F.presheaf) {
  module V = I.Inverse[E.presheaf,F.presheaf,e] ;
  left : Id (hom E E) (comp E F E V.inverse (I.forward e)) (idn E) =
   Arrow[E.presheaf,E.presheaf].ext _ _ (\ a x ->
    trans (V.inverse-at a (at E F (I.forward e) a x)) (trans (V.left-at a x) (sym (idn-at E a x)))) ;
  right : Id (hom F F) (comp F E F (I.forward e) V.inverse) (idn F) =
   Arrow[F.presheaf,F.presheaf].ext _ _ (\ a y ->
    trans (ap (at E F (I.forward e) a) (V.inverse-at a y)) (trans (V.right-at a y) (sym (idn-at F a y)))) ;
  categorical : precategory.Iso E F = (I.forward e,V.inverse,left,right) ;
 } ;
 -- categorical isos are natural linear equivalences
 module FromIso (E F : P.ModuleSheaf) (e : precategory.Iso E F) {
  section (a : L.L) (y : (F.presheaf.module-at a).M) : Id (F.presheaf.module-at a).M (at E F e.1 a (at F E e.2.1 a y)) y =
   trans (ap (\ q -> at F F q a y) e.2.2.2) (idn-at F a y) ;
  retraction (a : L.L) (x : (E.presheaf.module-at a).M) : Id (E.presheaf.module-at a).M (at F E e.2.1 a (at E F e.1 a x)) x =
   trans (ap (\ q -> at E E q a x) e.2.2.1) (idn-at E a x) ;
  equivalence : I.Equivalence E.presheaf F.presheaf = (e.1,\ a ->
   Pr.qinv (E.presheaf.module-at a).M (F.presheaf.module-at a).M (at E F e.1 a) (at F E e.2.1 a) (section a) (retraction a)) ;
 } ;
 to-iso (E F : P.ModuleSheaf) (e : I.Equivalence E.presheaf F.presheaf) : precategory.Iso E F = ToIso[E,F,e].categorical ;
 to-equivalence (E F : P.ModuleSheaf) (e : precategory.Iso E F) : I.Equivalence E.presheaf F.presheaf = FromIso[E,F,e].equivalence ;
 -- the two maps are inverse
 iso-again (E F : P.ModuleSheaf) (e : precategory.Iso E F) : Id (precategory.Iso E F) (to-iso E F (to-equivalence E F e)) e =
  Arr.iso-eq _ _ (refl e.1) ;
 equivalence-again (E F : P.ModuleSheaf) (e : I.Equivalence E.presheaf F.presheaf) :
  Id (I.Equivalence E.presheaf F.presheaf) (to-equivalence E F (to-iso E F e)) e =
  Pr.Sigma-eq (hom E F) (\ q -> (a : L.L) -> Pr.isEquiv (E.presheaf.module-at a).M (F.presheaf.module-at a).M (at E F q a))
   _ _ _ _ (refl e.1)
   (FL.isProp-Pi L.L (\ a -> Pr.isEquiv (E.presheaf.module-at a).M (F.presheaf.module-at a).M (at E F e.1 a)) (\ a ->
    IT.Equivalence[(E.presheaf.module-at a).M,(F.presheaf.module-at a).M,(E.presheaf.module-at a).setM,
     (F.presheaf.module-at a).setM,at E F e.1 a].equal)) ;
 iso-equivalence (E F : P.ModuleSheaf) : Pr.Equiv (I.Equivalence E.presheaf F.presheaf) (precategory.Iso E F) =
  (to-iso E F,Pr.qinv (I.Equivalence E.presheaf F.presheaf) (precategory.Iso E F) (to-iso E F) (to-equivalence E F)
   (iso-again E F) (equivalence-again E F)) ;
 -- univalence
 module Single (E : P.ModuleSheaf) {
  Total : U l+ = (F : P.ModuleSheaf) * precategory.Iso E F ;
  contractible : FunExtUA[l+].isContr Total =
   GH.ctr-retract (SI.SheafTotal E) Total (SI.sheaf-total-contr E)
    (\ w -> (w.1,to-equivalence E w.1 w.2)) (\ w -> (w.1,to-iso E w.1 w.2))
    (\ w -> Hi.ap (precategory.Iso E w.1) Total (\ e -> (w.1,e)) _ _ (iso-again E w.1 w.2)) ;
  proposition : Hi.isProp Total = \ u v -> FunExtUA[l+].pathC Total contractible u v ;
 } ;
 univalent : CC.Univalent precategory = CC.FromTotal[precategory,\ E -> Single[E].proposition].univalent ;
 category : CC.Category = new CC.Category[precategory,univalent] ;
} ;
