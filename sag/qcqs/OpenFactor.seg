-- Restrict h:X|e->Y to X|q and factor through Y|v.
-- Assume q<=e and q<=t(v), where t is h's inverse image in X.
-- Below.Pull gives the restricted map, whose inverse image of v is
-- t(v) meet q=q.  SliceUniversal.Back gives the factor and its triangle.
-- Its inverse image of a slice open b is t(inc b) meet q; its section
-- image, restricted to w<=q,t(inc b), is h# restricted directly to w.
-- The latter is Below.Pull.trace since Back keeps the section maps.
level l ; open Ring[l] ;
module DL = DistLattice[l] ;
module SP = Spaces[l] ;
module Op = OpenMaps[l] ;
module Over (X Y : SP.Space) (e q : X.lattice.L)
 (h : SP.Hom (Op.space X e) Y) (qe : DL.Order[X.lattice].Le q e)
 (v : Y.lattice.L)
 (qv : DL.Order[X.lattice].Le q (Op.At[X,e].Sl.inc (DL.hmap (SP.underlying h).lat v))) {
 module O = DL.Order[X.lattice] ;
 module SE = Op.At[X,e].Sl ;
 module SQ = Op.At[X,q].Sl ;
 module SV = Op.At[Y,v].Sl ;
 module B = Op.Below[X,q,e,qe] ;
 module P = B.Pull[Y,h] ;
 module UP = SliceUniversal[l].Over[Y.lattice,Y.structure,v,SQ.lattice,SQ.sheaf] ;
 top : Id SQ.Opens (DL.hmap (SP.underlying P.C.composite).lat v) SQ.topS =
  SQ.ext _ _ (trans (P.lattice-trace v)
   (trans (X.lattice.meetC (SE.inc (DL.hmap (SP.underlying h).lat v)) q) qv)) ;
 module F = UP.Back[SP.underlying P.C.composite,top] ;
 factor : SP.Hom (Op.space X q) (Op.space Y v) =
  (F.factor,F.local SQ.inv (SP.is-local P.C.composite)) ;
 triangle : Id (SP.Hom (Op.space X q) Y)
  (SP.compose (Op.space X q) (Op.space Y v) Y (Op.inclusion Y v) factor) P.C.composite =
  SP.ext _ _ _ _ F.factor-cut ;
 lattice-trace (b : SV.Opens) : Id X.lattice.L
  (SQ.inc (DL.hmap (SP.underlying factor).lat b))
  (X.lattice.meet (SE.inc (DL.hmap (SP.underlying h).lat (SV.inc b))) q) = P.lattice-trace (SV.inc b) ;
 at-le (b : SV.Opens) (w : X.lattice.L) (wq : O.Le w q)
  (k : O.Le w (SE.inc (DL.hmap (SP.underlying h).lat (SV.inc b)))) :
  SQ.OS.Le (P.at w wq) (DL.hmap (SP.underlying factor).lat b) =
  SQ.le-in (P.at w wq) _ (O.le-trans _ _ _
   (O.meet-glb _ _ _ k wq) (O.le-of-eq _ _ (sym (lattice-trace b)))) ;
 trace (b : SV.Opens) (w : X.lattice.L) (wq : O.Le w q)
  (k : O.Le w (SE.inc (DL.hmap (SP.underlying h).lat (SV.inc b))))
  (s : (Y.structure.sheaf.ring (SV.inc b)).R) :
  Id (X.structure.sheaf.ring w).R
   (SQ.SO.restrict (P.at w wq) (DL.hmap (SP.underlying factor).lat b) (at-le b w wq k)
    (RingMaps[l].map ((SP.underlying factor).sharp b) s))
   (SE.GO.restrict w (SE.inc (DL.hmap (SP.underlying h).lat (SV.inc b))) k
    (RingMaps[l].map ((SP.underlying h).sharp (SV.inc b)) s)) =
  trans (SQ.SO.res-irr (P.at w wq) _ (at-le b w wq k) (P.at-le (SV.inc b) w wq k)
    (RingMaps[l].map ((SP.underlying factor).sharp b) s)) (P.trace (SV.inc b) w wq k s) ;
 opaque factor ;
} ;
