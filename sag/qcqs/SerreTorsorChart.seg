-- A torsor moved along an affine chart with a model (Serre note, the
-- converse). Let w be an affine open with B = O(w), and e an equivalence
-- from the direct image Image of M|w along the chart Spec B -> X|w to the
-- associated sheaf assoc(N). For an M-torsor T on X put
--  T'(V) = T(psi V),  psi V = pi(V) as an open of X,
-- with action t + x = t + e^-1(x). Then T' is an assoc(N)-torsor on Spec B:
--  sheaf: pi preserves finite joins and meets, so a cover of V gives one
--   of psi V and compatibility transfers along the meet equation; glue in T;
--  action: e^-1 is additive and natural, so the laws are those of T;
--  differences: e(t - u) is the unique solution, e being bijective;
--  local sections: pi is bijective (w is affine), so the pieces of a cover
--   of psi V with sections are the images of opens of Spec B, and the order
--   of Spec B is reflected (pi preserves meets and is injective).
-- Since psi(1) = w, a global section of T' (SerreAffineTorsor) is merely a
-- section of T over w.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module DL = DistLattice[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module MS = SerreModuleSheaf[l] ; module SS = SerreSetSheaf[l] ;
module On (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged)
 (M : MS.On[L,X.sheaf].ModuleSheaf) (w : L.L) (affine : Qcqs[l].Over[L,X].AffineOpen w)
 (model : SerreQuasiCoherent[l].On[L,X,M].At[w].Model)
 (T : SerreTorsor[l].On[L,X.sheaf].Over[M].Torsor) {
 module QC = SerreQuasiCoherent[l].On[L,X,M].At[w] ;
 module S = QC.S ; module AC = QC.Canonical ; module Image = QC.Image ;
 B : CRing = S.sheaf.ring S.lattice.top ;
 module AT = SerreAffineTorsor[l].Over[B,S.sheaf.ring-set S.lattice.top,model.coefficients] ;
 module Assoc = AT.Sh ;
 module Z = AC.ZG ; module ZO = DL.Order[Z.lattice] ; module ZJ = DL.Joins[Z.lattice] ;
 module O = DL.Order[L] ; module J = DL.Joins[L] ; module SO = S.OS ;
 module P = DL.JoinMaps[Z.lattice,S.lattice,AC.canonical.lat] ;
 module MO = MS.On[L,X.sheaf].Of[M.presheaf] ;
 module TO = SS.On[L].Of[T.presheaf] ;
 module TS = SS.On[L].SheafProofs[T.presheaf,T.sheaf] ;
 module TD = SerreTorsor[l].On[L,X.sheaf].Over[M].Of[T] ;
 module Inv = QC.Maps.Inverse[Image.presheaf,Assoc.associated.presheaf,model.comparison] ;
 module Fwd = MS.On[Z.lattice,AC.Can.Sh.structure].Transform[Image.presheaf,Assoc.associated.presheaf] ;
 module NO = MS.On[Z.lattice,AC.Can.Sh.structure].Of[Assoc.associated.presheaf] ;
 -- the chart on opens
 psi (V : Z.lattice.L) : L.L = S.inc (DL.hmap AC.canonical.lat V) ;
 mono (V V2 : Z.lattice.L) (k : ZO.Le V V2) : O.Le (psi V) (psi V2) = S.le-inc _ _ (Image.mono V V2 k) ;
 join-eq (n : Nat) (as : Fin n -> Z.lattice.L) : Id L.L (psi (ZJ.bigJ n as)) (J.bigJ n (\ i -> psi (as i))) =
  trans (ap S.inc (P.preserves n as)) (S.join-inc n (\ i -> DL.hmap AC.canonical.lat (as i))) ;
 top-eq : Id L.L (psi Z.lattice.top) w = ap S.inc (DL.hmap-top AC.canonical.lat) ;
 -- the presheaf T'
 presheaf : SS.On[Z.lattice].Presheaf = new SS.On[Z.lattice].Presheaf[
  \ V -> T.presheaf.obj (psi V),\ V -> T.presheaf.set (psi V),
  \ V V2 k -> T.presheaf.res (psi V) (psi V2) (mono V V2 k),
  \ V k x -> T.presheaf.res-id (psi V) (mono V V k) x,
  \ a b c k h t x -> T.presheaf.res-comp (psi a) (psi b) (psi c) (mono a b k) (mono b c h) (mono a c t) x] ;
 module PO = SS.On[Z.lattice].Of[presheaf] ;
 module Cover (a : Z.lattice.L) (n : Nat) (as : Fin n -> Z.lattice.L)
  (le : (i : Fin n) -> ZO.Le (as i) a) (covers : ZO.Le a (ZJ.bigJ n as))
  (xs : (i : Fin n) -> T.presheaf.obj (psi (as i)))
  (compatible : PO.Cover[a,n,as,le,covers].Compatible xs) {
  pieces (i : Fin n) : L.L = psi (as i) ;
  piece-below (i : Fin n) : O.Le (pieces i) (psi a) = mono (as i) a (le i) ;
  piece-covers : O.Le (psi a) (J.bigJ n pieces) =
   O.le-trans (psi a) (psi (ZJ.bigJ n as)) (J.bigJ n pieces) (mono a (ZJ.bigJ n as) covers)
    (O.le-of-eq (psi (ZJ.bigJ n as)) (J.bigJ n pieces) (join-eq n as)) ;
  module NC = TO.Cover[psi a,n,pieces,piece-below,piece-covers] ;
  module NS = TS.Cover[psi a,n,pieces,piece-below,piece-covers] ;
  module PC = PO.Cover[a,n,as,le,covers] ;
  module Pair (i j : Fin n) {
   overlap : L.L = L.meet (pieces i) (pieces j) ;
   original : L.L = psi (Z.lattice.meet (as i) (as j)) ;
   below-original : O.Le overlap original =
    O.le-of-eq overlap original (sym (ap S.inc (DL.hmap-meet AC.canonical.lat (as i) (as j)))) ;
   agree : Id (T.presheaf.obj overlap)
    (TO.restrict overlap (pieces i) (O.meet-left (pieces i) (pieces j)) (xs i))
    (TO.restrict overlap (pieces j) (O.meet-right (pieces i) (pieces j)) (xs j)) =
    trans (sym (T.presheaf.res-comp overlap original (pieces i) below-original
     (mono (Z.lattice.meet (as i) (as j)) (as i) (ZO.meet-left (as i) (as j))) (O.meet-left (pieces i) (pieces j)) (xs i)))
     (trans (ap (TO.restrict overlap original below-original) (compatible i j))
      (T.presheaf.res-comp overlap original (pieces j) below-original
       (mono (Z.lattice.meet (as i) (as j)) (as j) (ZO.meet-right (as i) (as j))) (O.meet-right (pieces i) (pieces j)) (xs j))) ;
  } ;
  glued : NC.Amalgam xs = (NS.glue xs (\ i j -> Pair[i,j].agree)).1 ;
  center : T.presheaf.obj (psi a) = NC.amalgam glued ;
  matches : PC.Matches xs center = \ i ->
   trans (TO.res-irr (psi (as i)) (psi a) (mono (as i) a (le i)) (piece-below i) center) (NC.matches glued i) ;
  matches-prop (x : T.presheaf.obj (psi a)) : Pr.isProp (PC.Matches xs x) =
   FE.isProp-Pi (Fin n) (\ i -> Id (T.presheaf.obj (psi (as i))) (PO.restrict (as i) a (le i) x) (xs i))
    (\ i -> T.presheaf.set (psi (as i)) _ _) ;
  unique (z : PC.Amalgam xs) : Id (T.presheaf.obj (psi a)) center (PC.amalgam z) =
   NS.separated center (PC.amalgam z) (\ i -> trans (NC.matches glued i)
    (sym (trans (TO.res-irr (psi (as i)) (psi a) (piece-below i) (mono (as i) a (le i)) (PC.amalgam z)) (PC.matches z i)))) ;
  amalgamation : Localisation[l].isContr (PC.Amalgam xs) =
   ((center,matches),\ z -> Pr.Sigma-eq (T.presheaf.obj (psi a)) (PC.Matches xs)
    center (PC.amalgam z) matches (PC.matches z) (unique z) (matches-prop (PC.amalgam z))) ;
  opaque glued ;
 } ;
 sheaf : PO.IsSheaf = \ a n as le covers xs compatible -> Cover[a,n,as,le,covers,xs,compatible].amalgamation ;
 -- the action through e^-1
 back (V : Z.lattice.L) (x : (Assoc.associated.presheaf.module-at V).M) : (M.presheaf.module-at (psi V)).M = Inv.inverse-map V x ;
 forth (V : Z.lattice.L) (y : (M.presheaf.module-at (psi V)).M) : (Assoc.associated.presheaf.module-at V).M =
  Fwd.at (QC.Maps.forward model.comparison) V y ;
 action (V : Z.lattice.L) (t : T.presheaf.obj (psi V)) (x : (Assoc.associated.presheaf.module-at V).M) : T.presheaf.obj (psi V) =
  T.action (psi V) t (back V x) ;
 back-zero (V : Z.lattice.L) : Id (M.presheaf.module-at (psi V)).M (back V (Assoc.associated.presheaf.module-at V).mz)
  (M.presheaf.module-at (psi V)).mz =
  SerreModuleMaps[l].Between[AC.Can.Sh.structure.ring V,AC.Can.Sh.structure.ring V,RingHom[l].identity (AC.Can.Sh.structure.ring V),
   Assoc.associated.presheaf.module-at V,Image.presheaf.module-at V].map-zero (Inv.inverse-component V) ;
 action-zero (V : Z.lattice.L) (t : T.presheaf.obj (psi V)) :
  Id (T.presheaf.obj (psi V)) (action V t (Assoc.associated.presheaf.module-at V).mz) t =
  trans (ap (T.action (psi V) t) (back-zero V)) (T.action-zero (psi V) t) ;
 action-add (V : Z.lattice.L) (t : T.presheaf.obj (psi V)) (x y : (Assoc.associated.presheaf.module-at V).M) :
  Id (T.presheaf.obj (psi V)) (action V (action V t x) y) (action V t ((Assoc.associated.presheaf.module-at V).madd x y)) =
  trans (T.action-add (psi V) t (back V x) (back V y)) (ap (T.action (psi V) t) (sym (Inv.additive V x y))) ;
 action-res (a b : Z.lattice.L) (k : ZO.Le a b) (t : T.presheaf.obj (psi b)) (x : (Assoc.associated.presheaf.module-at b).M) :
  Id (T.presheaf.obj (psi a)) (T.presheaf.res (psi a) (psi b) (mono a b k) (action b t x))
   (action a (T.presheaf.res (psi a) (psi b) (mono a b k) t) (NO.restrict a b k x)) =
  trans (T.action-res (psi a) (psi b) (mono a b k) t (back b x))
   (ap (T.action (psi a) (T.presheaf.res (psi a) (psi b) (mono a b k) t)) (sym (Inv.natural a b k x))) ;
 -- the difference is e(t - u)
 module Difference (V : Z.lattice.L) (t u : T.presheaf.obj (psi V)) {
  Solution : U l = (x : (Assoc.associated.presheaf.module-at V).M) * Id (T.presheaf.obj (psi V)) (action V t x) u ;
  centre : Solution = (forth V (TD.diff (psi V) t u),
   trans (ap (T.action (psi V) t) (Inv.left-at V (TD.diff (psi V) t u))) (TD.diff-equation (psi V) t u)) ;
  unique (z : Solution) : Id Solution centre z =
   Pr.Sigma-eq (Assoc.associated.presheaf.module-at V).M (\ x -> Id (T.presheaf.obj (psi V)) (action V t x) u)
    centre.1 z.1 centre.2 z.2
    (trans (ap (forth V) (TD.diff-unique (psi V) t u (back V z.1) z.2)) (Inv.right-at V z.1))
    (T.presheaf.set (psi V) _ _) ;
  contractible : Localisation[l].isContr Solution = (centre,unique) ;
 } ;
 -- local sections, pulled back along the bijective chart
 module Pull (V : Z.lattice.L) (c : (n : Nat) * (bs : Fin n -> L.L) * ((i : Fin n) -> O.Le (bs i) (psi V))
   * O.Le (psi V) (J.bigJ n bs) * ((i : Fin n) -> T.presheaf.obj (bs i))) {
  n : Nat = c.1 ;
  bs (i : Fin n) : L.L = c.2.1 i ;
  bs-below (i : Fin n) : O.Le (bs i) (psi V) = c.2.2.1 i ;
  equiv : Pr.isEquiv Z.lattice.L S.Opens (DL.hmap AC.canonical.lat) = AC.I.lat-equiv {AC.canonical} affine ;
  slice-open (i : Fin n) : S.Opens = (bs i,O.le-trans (bs i) (psi V) w (bs-below i) (S.below (DL.hmap AC.canonical.lat V))) ;
  as (i : Fin n) : Z.lattice.L = equiv.sec (slice-open i) ;
  as-eq (i : Fin n) : Id L.L (psi (as i)) (bs i) = ap S.inc (equiv.sec-eq (slice-open i)) ;
  -- the order of Spec B is reflected
  reflect (x y : Z.lattice.L) (k : O.Le (psi x) (psi y)) : ZO.Le x y =
   Iso[l].injective Z.lattice.L S.Opens (DL.hmap AC.canonical.lat) equiv _ _
    (trans (DL.hmap-meet AC.canonical.lat x y) (S.le-in _ _ k)) ;
  below (i : Fin n) : ZO.Le (as i) V =
   reflect (as i) V (O.le-trans (psi (as i)) (bs i) (psi V) (O.le-of-eq _ _ (as-eq i)) (bs-below i)) ;
  joins : Id L.L (J.bigJ n bs) (psi (ZJ.bigJ n as)) =
   sym (trans (join-eq n as) (ap (J.bigJ n) (FE.funext (Fin n) (\ i -> L.L) (\ i -> psi (as i)) bs as-eq))) ;
  covers : ZO.Le V (ZJ.bigJ n as) =
   reflect V (ZJ.bigJ n as) (O.le-trans (psi V) (J.bigJ n bs) (psi (ZJ.bigJ n as)) c.2.2.2.1 (O.le-of-eq _ _ joins)) ;
  sections (i : Fin n) : T.presheaf.obj (psi (as i)) =
   T.presheaf.res (psi (as i)) (bs i) (O.le-of-eq _ _ (as-eq i)) (c.2.2.2.2 i) ;
  local : (m : Nat) * (as2 : Fin m -> Z.lattice.L) * ((i : Fin m) -> ZO.Le (as2 i) V)
   * ZO.Le V (ZJ.bigJ m as2) * ((i : Fin m) -> T.presheaf.obj (psi (as2 i))) = (n,as,below,covers,sections) ;
 } ;
 Local (V : Z.lattice.L) : U l = (m : Nat) * (as2 : Fin m -> Z.lattice.L) * ((i : Fin m) -> ZO.Le (as2 i) V)
  * ZO.Le V (ZJ.bigJ m as2) * ((i : Fin m) -> T.presheaf.obj (psi (as2 i))) ;
 local-sections (V : Z.lattice.L) : Tr.Trunc[Local V].carrier =
  Tr.Trunc[(n : Nat) * (bs : Fin n -> L.L) * ((i : Fin n) -> O.Le (bs i) (psi V))
   * O.Le (psi V) (J.bigJ n bs) * ((i : Fin n) -> T.presheaf.obj (bs i))].induction @l
   (\ q -> Tr.Trunc[Local V].carrier) (\ q -> Tr.Trunc[Local V].proposition)
   (\ c -> Tr.Trunc[Local V].inc Pull[V,c].local) (T.local-sections (psi V)) ;
 torsor : AT.Torsors.Torsor = new AT.Torsors.Torsor[presheaf,sheaf,action,action-zero,action-add,action-res,
  \ V t u -> Difference[V,t,u].contractible,local-sections] ;
 -- a section of T over w
 section : Tr.Trunc[T.presheaf.obj w].carrier =
  Tr.Trunc[T.presheaf.obj (psi Z.lattice.top)].induction @l (\ q -> Tr.Trunc[T.presheaf.obj w].carrier)
   (\ q -> Tr.Trunc[T.presheaf.obj w].proposition)
   (\ t -> Tr.Trunc[T.presheaf.obj w].inc (T.presheaf.res w (psi Z.lattice.top) (O.le-of-eq _ _ (sym top-eq)) t))
   (AT.acyclic torsor) ;
} ;
