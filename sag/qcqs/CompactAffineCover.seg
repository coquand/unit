-- Compact opens of affine representables are functorial qcqs schemes.
-- For U : h_A -> Zar set u=U_A(1).  Naturality and h . 1=h give
-- h_*(u)=U_B(h).  Choose a finite presentation u=join D(a_i), merely.
-- In |U| pull back each basic D(a_i) along |U| -> h_A.  Its realisation
-- is equivalent to |D(a_i)|: membership in D(a_i) implies membership in U
-- by D(a_i)<=u and monotonicity of h_*.  The map pairs the same h with
-- the two membership proofs; its inverse forgets the redundant U proof.
-- Both inverse laws are point-ext.  BasicAffineFunctor makes these charts
-- affine.  They cover: join h_*D(a_i)=h_*u=U_B(h)=top.
-- Eliminate the merely given presentation into HasAtlas at l+1.  Sheafhood
-- is OpenSheaf applied to the representable sheaf.  Thus no presentation
-- is chosen as part of the scheme structure, and empty presentations work.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Hi = Prelude[l+] ;
module Tr = Truncation[l] ;
module BigTr = Truncation[l+] ;
module RH = RingHom[l] ;
module DL = DistLattice[l] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module TE = TestEquivalences[l] ;
module CO = CompactOpens[l] ;
module ZF = ZariskiFunctor[l] ;
module QF = FunctorialQcqs[l] ;
module Over (A : T.Test) (u : CO.Over[SF.Representable[A].functor].Open) {
 module H = SF.Representable[A] ;
 module C = CO.Over[H.functor] ;
 module ZA = T.At[A].Z ;
 module Families = Radical[l].Over[A.ring] ;
 module R = OpenRealisation[l].Over[H.functor,u] ;
 module CR = CO.Over[R.functor] ;
 module Q = QF.Over[R.functor] ;
 module Y = TestYoneda[l].Over[A,ZF.functor] ;
 extent : ZA.lattice.L = C.value u A (RH.identity A.ring) ;
 value-as-image (B : T.Test) (h : RH.Hom A.ring B.ring) : Id ZariskiLattice[l].Over[B.ring].lattice.L
  (ZF.functor.reindex A B h extent) (C.value u B h) =
  trans (sym (C.N.natural u A B h (RH.identity A.ring))) (ap (C.value u B) (Y.right-unit B h)) ;
 module BasicPiece (a : A.ring.R) (below : ZA.O.Le (ZA.D a) extent) {
  module Bf = BasicAffineFunctor[l].Over[A,a] ;
  module Rb = Bf.R ;
  module Membership (B : T.Test) (h : RH.Hom A.ring B.ring) {
   module O = DL.Order[ZariskiLattice[l].Over[B.ring].lattice] ;
   module ZM = ZF.OnMap[A,B,h] ;
   member (m : Rb.Member B h) : R.Member B h =
    trans (sym (value-as-image B h))
     (O.le-antisym (ZF.functor.reindex A B h extent) ZM.ZB.lattice.top (O.le-top (ZF.functor.reindex A B h extent))
      (O.le-trans ZM.ZB.lattice.top (ZF.functor.reindex A B h (ZA.D a)) (ZF.functor.reindex A B h extent)
       (O.le-of-eq ZM.ZB.lattice.top (ZF.functor.reindex A B h (ZA.D a)) (sym m))
       (DL.JoinMaps[ZA.lattice,ZM.ZB.lattice,ZM.lattice-map].monotone (ZA.D a) extent below))) ;
  } ;
  module Up = R.Lift[Rb.functor,Rb.inclusion,\ B p -> Membership[B,Rb.point {B} p].member (Rb.member {B} p)] ;
  classifier : CR.Open = CO.Pullback[R.functor,H.functor,R.inclusion].pull Bf.basic ;
  module V = OpenRealisation[l].Over[R.functor,classifier] ;
  module IntoV = V.Lift[Rb.functor,Up.lift,\ B p -> Rb.member {B} p] ;
  module At (B : T.Test) {
   forward (p : Rb.obj B) : V.obj B = ((Rb.point {B} p,Membership[B,Rb.point {B} p].member (Rb.member {B} p)),Rb.member {B} p) ;
   backward (p : V.obj B) : Rb.obj B = (R.point {B} (V.point {B} p),V.member {B} p) ;
   forward-back (p : V.obj B) : Id (V.obj B) (forward (backward p)) p =
    V.point-ext B (forward (backward p)) p
     (R.point-ext B (V.point {B} (forward (backward p))) (V.point {B} p) (refl (R.point {B} (V.point {B} p)))) ;
   back-forward (p : Rb.obj B) : Id (Rb.obj B) (backward (forward p)) p = Rb.point-ext B (backward (forward p)) p (refl (Rb.point {B} p)) ;
  } ;
  equivalence : TE.NaturalEquivalence Rb.functor V.functor =
   (IntoV.lift,\ B -> Pr.qinv (Rb.obj B) (V.obj B) At[B].forward At[B].backward At[B].forward-back At[B].back-forward) ;
  witness : QF.AffineWitness V.functor =
   (Bf.local-test,TE.Composite[Bf.HL.functor,Rb.functor,V.functor,Bf.equivalence,equivalence].equivalence) ;
  affine : QF.IsAffine V.functor = BigTr.Trunc[QF.AffineWitness V.functor].inc witness ;
 } ;
 module Presented (p : ZA.Presentation extent) {
  opens (i : Fin (Families.size (ZA.generators p))) : CR.Open = BasicPiece[Families.gen (ZA.generators p) i,ZA.gen-below p i].classifier ;
  covers (B : T.Test) (x : R.obj B) : Id ZariskiLattice[l].Over[B.ring].lattice.L
   (DL.Joins[ZariskiLattice[l].Over[B.ring].lattice].bigJ (Families.size (ZA.generators p)) (\ i -> CR.value (opens i) B x)) ZariskiLattice[l].Over[B.ring].lattice.top =
   trans (sym (DL.JoinMaps[ZA.lattice,ZariskiLattice[l].Over[B.ring].lattice,ZF.OnMap[A,B,R.point {B} x].lattice-map].preserves
     (Families.size (ZA.generators p)) (\ i -> ZA.D (Families.gen (ZA.generators p) i))))
    (trans (ap (ZF.functor.reindex A B (R.point {B} x)) (sym (ZA.presents p)))
     (trans (value-as-image B (R.point {B} x)) (R.member {B} x))) ;
  cover : Q.AffineCover = struct {
   count = Families.size (ZA.generators p) ; opens = opens ; covers = covers ;
   affine = \ i -> BasicPiece[Families.gen (ZA.generators p) i,ZA.gen-below p i].affine } ;
 } ;
 has-atlas : Q.HasAtlas =
  Tr.Trunc[ZA.Presentation extent].induction @(l+) (\ t -> Q.HasAtlas) (\ t -> BigTr.Trunc[Q.AffineCover].proposition)
   (\ p -> BigTr.Trunc[Q.AffineCover].inc Presented[p].cover) (ZA.presented extent) ;
 qcqs : Q.IsQcqs = (OpenSheaf[l].Over[H.functor,u,RepresentableSheaf[l].is-sheaf A].is-sheaf,has-atlas) ;
} ;
