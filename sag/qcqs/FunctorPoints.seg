-- Functors of points on all small commutative rings.
-- A point of X at B is a local map Spec B -> X.  A ring map A -> B acts
-- by precomposition with Spec of that map.  Identity is AffineTests'
-- identity law followed by the unit law; composition is its composition
-- law followed by associativity of geometric maps.
-- Natural families form a type in U (l+1), since Test is there, although
-- each point set is in U l.  Naturality is a proposition.  Function
-- extensionality and equality of maps give extensionality and sethood.
-- A map f : X -> Y induces p |-> f p; naturality is associativity.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Hi = Prelude[l+] ;
module FE = Axioms[l+].FunExtLemmas[fe @l+] ;
module RH = RingHom[l] ;
module Sp = Spaces[l] ;
module T = AffineTests[l] ;
module On (X : Sp.Space) {
 points (B : T.Test) : U l = Sp.Hom (T.space B) X ;
 reindex (A B : T.Test) (h : RH.Hom A.ring B.ring) (p : points A) : points B =
  Sp.compose (T.space B) (T.space A) X p T.Map[A,B,h].morphism ;
 identity (A : T.Test) (p : points A) : Id (points A) (reindex A A (RH.identity A.ring) p) p =
  trans (ap (Sp.compose (T.space A) (T.space A) X p) T.Identity[A].identity) Sp.Laws[T.space A,X,p].right ;
 composition (A B C : T.Test) (h : RH.Hom A.ring B.ring) (k : RH.Hom B.ring C.ring) (p : points A) :
  Id (points C) (reindex A C (RH.compose A.ring B.ring C.ring k h) p) (reindex B C k (reindex A B h p)) =
  trans (ap (Sp.compose (T.space C) (T.space A) X p) T.Composition[A,B,C,h,k].composition)
   Sp.Associativity[T.space C,T.space B,T.space A,X,p,T.Map[A,B,h].morphism,T.Map[B,C,k].morphism].assoc ;
} ;
module Maps (X Y : Sp.Space) {
 module PX = On[X] ;
 module PY = On[Y] ;
 Comp : U l+ = (B : T.Test) -> PX.points B -> PY.points B ;
 Natural (alpha : Comp) : U l+ =
  (A B : T.Test) (h : RH.Hom A.ring B.ring) (p : PX.points A) ->
   Id (PY.points B) (alpha B (PX.reindex A B h p)) (PY.reindex A B h (alpha A p)) ;
 natural-prop (alpha : Comp) : Hi.isProp (Natural alpha) =
  FE.isProp-Pi T.Test (\ A -> (B : T.Test) (h : RH.Hom A.ring B.ring) (p : PX.points A) ->
   Id (PY.points B) (alpha B (PX.reindex A B h p)) (PY.reindex A B h (alpha A p))) (\ A ->
  FE.isProp-Pi T.Test (\ B -> (h : RH.Hom A.ring B.ring) (p : PX.points A) ->
   Id (PY.points B) (alpha B (PX.reindex A B h p)) (PY.reindex A B h (alpha A p))) (\ B ->
  FE.isProp-Pi (RH.Hom A.ring B.ring) (\ h -> (p : PX.points A) ->
   Id (PY.points B) (alpha B (PX.reindex A B h p)) (PY.reindex A B h (alpha A p))) (\ h ->
  FE.isProp-Pi (PX.points A) (\ p -> Id (PY.points B) (alpha B (PX.reindex A B h p)) (PY.reindex A B h (alpha A p))) (\ p ->
   Sp.set (T.space B) Y (alpha B (PX.reindex A B h p)) (PY.reindex A B h (alpha A p)))))) ;
 Nat : U l+ = (alpha : Comp) * Natural alpha ;
 at (alpha : Nat) (B : T.Test) (p : PX.points B) : PY.points B = alpha.1 B p ;
 natural (alpha : Nat) (A B : T.Test) (h : RH.Hom A.ring B.ring) (p : PX.points A) :
  Id (PY.points B) (at alpha B (PX.reindex A B h p)) (PY.reindex A B h (at alpha A p)) = alpha.2 A B h p ;
 ext (alpha beta : Nat) (e : (B : T.Test) (p : PX.points B) -> Id (PY.points B) (at alpha B p) (at beta B p)) : Id Nat alpha beta =
  Hi.Sigma-eq Comp Natural alpha.1 beta.1 alpha.2 beta.2
   (FE.funext T.Test (\ B -> PX.points B -> PY.points B) alpha.1 beta.1 (\ B ->
    FE.funext (PX.points B) (\ p -> PY.points B) (alpha.1 B) (beta.1 B) (e B))) (natural-prop beta.1) ;
 set : Hi.isSet Nat = Hi.isSet-Sigma Comp Natural
  (FE.isSet-Pi T.Test (\ B -> PX.points B -> PY.points B) (\ B ->
   FE.isSet-Pi (PX.points B) (\ p -> PY.points B) (\ p -> Sp.set (T.space B) Y)))
  (\ alpha -> Hi.prop-to-set (Natural alpha) (natural-prop alpha)) ;
 induced (f : Sp.Hom X Y) : Nat =
  (\ B p -> Sp.compose (T.space B) X Y f p,
   \ A B h p -> Sp.Associativity[T.space B,T.space A,X,Y,f,p,T.Map[A,B,h].morphism].assoc) ;
 -- every geometric map between affine tests is Spec of a ring map
 natural-map (alpha : Nat) (A B : T.Test) (q : Sp.Hom (T.space B) (T.space A)) (p : PX.points A) :
  Id (PY.points B) (at alpha B (Sp.compose (T.space B) (T.space A) X p q))
   (Sp.compose (T.space B) (T.space A) Y (at alpha A p) q) =
  trans (ap (\ r -> at alpha B (Sp.compose (T.space B) (T.space A) X p r)) (sym (T.MapsEquivalence[A,B].rebuild q)))
   (trans (natural alpha A B (T.MapsEquivalence[A,B].extract q) p)
    (ap (Sp.compose (T.space B) (T.space A) Y (at alpha A p)) (T.MapsEquivalence[A,B].rebuild q))) ;
} ;

-- Natural families compose pointwise.  Naturality is the two naturality
-- equations, with the first carried through the second component function.
module NaturalComposition (X Y Z : Sp.Space) (beta : Maps[Y,Z].Nat) (alpha : Maps[X,Y].Nat) {
 module XY = Maps[X,Y] ;
 module YZ = Maps[Y,Z] ;
 module XZ = Maps[X,Z] ;
 composite : XZ.Nat =
  (\ B p -> YZ.at beta B (XY.at alpha B p),
   \ A B h p -> trans (ap (YZ.at beta B) (XY.natural alpha A B h p)) (YZ.natural beta A B h (XY.at alpha A p))) ;
} ;
