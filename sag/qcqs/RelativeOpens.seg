-- Relative compact opens and their totalisations (note §4).
-- An open is a native natural map to the restriction of Zar.  Realisation
-- pairs a relative point with membership; naturality and preservation of
-- top give its reindexing, and point extensionality gives its laws.
-- To totalise an open evaluate at (B,iota,x).  Its naturality is that on
-- canonical algebra maps.  Conversely restrict an absolute total open
-- to these pairs; total-on gives naturality on arbitrary algebra maps.
-- The value equations are by definition and retain the underlying point.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module T = AffineTests[l] ;
module DL = DistLattice[l] ;
module ZF = ZariskiFunctor[l] ;
module SF = TestFunctors[l] ;
module CO = CompactOpens[l] ;
module Over (K : T.Test) (F : RelativeFunctors[l].Over[K].SetFunctor) {
 module R = RelativeFunctors[l].Over[K] ;
 module BP = R.BP ;
 module Z = RelativeRestriction[l].Over[K,ZF.functor] ;
 module N = R.Transform[F,Z.functor] ;
 module TF = RelativeTotal[l].Over[K,F] ;
 Open : U l+ = N.Nat ;
 value (u : Open) (A : BP.Algebra) (x : F.obj A) : ZF.functor.obj (BP.test A) = N.at u A x ;
 module Realisation (u : Open) {
  Member (A : BP.Algebra) (x : F.obj A) : U l = Id T.At[BP.test A].Z.lattice.L (value u A x) T.At[BP.test A].Z.lattice.top ;
  obj (A : BP.Algebra) : U l = (x : F.obj A) * Member A x ;
  point {A : BP.Algebra} (p : obj A) : F.obj A = p.1 ;
  member {A : BP.Algebra} (p : obj A) : Member A (point p) = p.2 ;
  member-prop (A : BP.Algebra) (x : F.obj A) : Pr.isProp (Member A x) = T.At[BP.test A].Z.lattice.setL _ _ ;
  ext (A : BP.Algebra) (p q : obj A) (e : Id (F.obj A) (point p) (point q)) : Id (obj A) p q =
   Pr.Sigma-eq (F.obj A) (Member A) p.1 q.1 p.2 q.2 e (member-prop A q.1) ;
  set (A : BP.Algebra) : Pr.isSet (obj A) = Pr.isSet-Sigma (F.obj A) (Member A) (F.set A) (\ x -> Pr.prop-to-set (Member A x) (member-prop A x)) ;
  reindex (A B : BP.Algebra) (h : BP.Hom A B) (p : obj A) : obj B =
   (F.reindex A B h (point p),trans (N.natural u A B h (point p))
    (trans (ap (ZF.functor.reindex (BP.test A) (BP.test B) (BP.ring-map h)) (member p))
     (DL.hmap-top ZF.OnMap[BP.test A,BP.test B,BP.ring-map h].lattice-map))) ;
  functor : R.SetFunctor = new R.SetFunctor[obj,set,reindex,
   \ A p -> ext A _ _ (F.identity A (point p)),
   \ A B C f g p -> ext C _ _ (F.composition A B C f g (point p))] ;
 } ;
 to-total (u : Open) : CO.Over[TF.functor].Open =
  (\ B p -> value u (BP.algebra B (TF.At[B].base p)) (TF.At[B].value p),
   \ B C h p -> N.natural u (BP.algebra B (TF.At[B].base p)) (BP.algebra C (R.RT.push B C h (TF.At[B].base p)))
    (R.RT.canonical B C h (TF.At[B].base p)) (TF.At[B].value p)) ;
 from-total (u : CO.Over[TF.functor].Open) : Open = (\ A x -> CO.Over[TF.functor].value u (BP.test A) (TF.At[BP.test A].pair (BP.iota A) x),
  \ A B h x -> trans (ap (CO.Over[TF.functor].value u (BP.test B)) (sym (TF.on-algebra A B h x)))
   (CO.Over[TF.functor].N.natural u (BP.test A) (BP.test B) (BP.ring-map h) (TF.At[BP.test A].pair (BP.iota A) x))) ;
 total-value (u : Open) (B : T.Test) (p : TF.functor.obj B) : Id T.At[B].Z.lattice.L
  (CO.Over[TF.functor].value (to-total u) B p) (value u (BP.algebra B (TF.At[B].base p)) (TF.At[B].value p)) = refl (CO.Over[TF.functor].value (to-total u) B p) ;
 from-value (u : CO.Over[TF.functor].Open) (A : BP.Algebra) (x : F.obj A) : Id T.At[BP.test A].Z.lattice.L
  (value (from-total u) A x) (CO.Over[TF.functor].value u (BP.test A) (TF.At[BP.test A].pair (BP.iota A) x)) = refl (value (from-total u) A x) ;
 to-from (u : CO.Over[TF.functor].Open) : Id CO.Over[TF.functor].Open (to-total (from-total u)) u =
  CO.Over[TF.functor].N.ext _ _ (\ B p -> refl (CO.Over[TF.functor].value u B p)) ;
 from-to (u : Open) : Id Open (from-total (to-total u)) u = N.ext _ _ (\ A x -> refl (value u A x)) ;
} ;
