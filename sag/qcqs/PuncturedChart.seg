-- The automorphism X |-> X^-1 of the punctured chart (DESIGN.md, Next 5,
-- step 1).  Y = Spec k[X], Y|D(X) its punctured part (Slice), L = k[X][1/X]
-- with the involution sigma (Inversion).
--
-- Spec sigma is an automorphism of Spec L (SpecHom.Isomorphism, sigma its
-- own inverse).  With the isomorphism j : Spec L ~= Y|D(X) and its inverse k
-- (SpecBasicOpen), the automorphism of Y|D(X) is, in geometric notation,
--  Y|D(X) --k--> Spec L --Spec sigma--> Spec L --j--> Y|D(X);
-- as a map of ringed lattices it is the composite j, Spec sigma, k
-- (Compose), an isomorphism and local.
-- Lemma (global component).  With phi = extend : L -> O(D(X)) = Gamma(Y|D(X))
--  (SpecBasicOpen), Gamma(automorphism)(phi y) = phi(sigma y).  Gamma is
--  functorial (Compose), and the three components are known:
--  Gamma(j)(phi y) = y|top (SpecBasicOpen.gamma-phi), Gamma(Spec sigma)(y|top)
--  = (sigma y)|top (SpecHom.global), and Gamma(k)(x|top) = phi x (the global
--  component of the map of phi).
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) {
 module I = Inversion[l].Over[k,setk] ;
 module SB = SpecBasicOpen[l].Over[I.P.ring,I.P.set,I.P.variable] ;
 -- Spec sigma
 module SS = SpecHom[l].Isomorphism[I.AP.Loc I.P.variable,I.AP.set I.P.variable,SB.SG.Loc,SB.SG.set,SB.SG.inclusion,SB.SG.elementary,
  I.AP.Loc I.P.variable,I.AP.set I.P.variable,SB.SG.Loc,SB.SG.set,SB.SG.inclusion,SB.SG.elementary,I.sigma,I.sigma,
  I.sigma-sigma,I.sigma-sigma] ;
 -- the automorphism of the punctured chart
 module C1 = Compose[l].Maps[SB.Sl.lattice,SB.ZG.lattice,SB.ZG.lattice,SB.Sl.sheaf,SB.SG.spec.sheaf,SB.SG.spec.sheaf].Of[SS.R1.Fw.morphism,SB.JB.factor] ;
 module C2 = Compose[l].Maps[SB.Sl.lattice,SB.ZG.lattice,SB.Sl.lattice,SB.Sl.sheaf,SB.SG.spec.sheaf,SB.Sl.sheaf].Of[SB.KM.morphism,C1.composite] ;
 automorphism : LocallyRinged[l].Maps[SB.Sl.lattice,SB.Sl.lattice,SB.Sl.sheaf,SB.Sl.sheaf].Ringed = C2.composite ;
 iso : Iso[l].Maps[SB.Sl.lattice,SB.Sl.lattice,SB.Sl.sheaf,SB.Sl.sheaf].IsIso automorphism =
  C2.iso (C1.iso SB.j-iso SS.iso) SB.k-iso ;
 local : LocallyRinged[l].Maps[SB.Sl.lattice,SB.Sl.lattice,SB.Sl.sheaf,SB.Sl.sheaf].Of[automorphism,SB.Sl.inv,SB.Sl.inv].IsLocal =
  C2.Local[SB.Sl.inv,SB.SG.spec.inv,SB.Sl.inv,
   C1.Local[SB.Sl.inv,SB.SG.spec.inv,SB.SG.spec.inv,SB.j-local,SS.R1.Fw.local].local,SB.KM.local].local ;

 -- the global component of the automorphism is sigma
 gamma-j (y : (I.AP.Loc I.P.variable).R) :
  Id (SB.SG.spec.sheaf.ring SB.ZG.lattice.top).R (map C1.GP.gamma (map SB.phi y)) (map SB.J.GA.global y) =
  trans (sym (map-compose SB.PA.gamma SB.phi y)) (ap (\ h -> map h y) SB.gamma-phi) ;
 gamma-sigma (y : (I.AP.Loc I.P.variable).R) :
  Id (SB.SG.spec.sheaf.ring SB.ZG.lattice.top).R (map C1.GR.gamma (map SB.J.GA.global y)) (map SB.J.GA.global (map I.sigma y)) =
  SS.R1.Fw.global y ;
 gamma-k (x : (I.AP.Loc I.P.variable).R) :
  Id (SB.Sl.restricted.sheaf.ring SB.Sl.lattice.top).R (map C2.GR.gamma (map SB.J.GA.global x)) (map SB.phi x) =
  trans (sym (SB.K.component-map SB.KM.morphism x)) (SB.KM.component-of x) ;
 -- Gamma(automorphism), on the structure sheaf of the slice as a locally ringed lattice
 module GA = Compose[l].Gamma[SB.Sl.lattice,SB.Sl.lattice,SB.Sl.restricted.sheaf,SB.Sl.restricted.sheaf,automorphism] ;
 gamma-automorphism (y : (I.AP.Loc I.P.variable).R) :
  Id (SB.Sl.restricted.sheaf.ring SB.Sl.lattice.top).R (map GA.gamma (map SB.phi y)) (map SB.phi (map I.sigma y)) =
  calc (SB.Sl.restricted.sheaf.ring SB.Sl.lattice.top).R {
   map GA.gamma (map SB.phi y) =< refl (map C2.GC.gamma (map SB.phi y)) > map C2.GC.gamma (map SB.phi y)
    =< C2.gamma-composite (map SB.phi y) > map C2.GR.gamma (map C2.GP.gamma (map SB.phi y))
    =< ap (map C2.GR.gamma) (C1.gamma-composite (map SB.phi y))
     > map C2.GR.gamma (map C1.GR.gamma (map C1.GP.gamma (map SB.phi y)))
    =< ap (\ t -> map C2.GR.gamma (map C1.GR.gamma t)) (gamma-j y)
     > map C2.GR.gamma (map C1.GR.gamma (map SB.J.GA.global y))
    =< ap (map C2.GR.gamma) (gamma-sigma y) > map C2.GR.gamma (map SB.J.GA.global (map I.sigma y))
    =< gamma-k (map I.sigma y) > map SB.phi (map I.sigma y) } ;
} ;
