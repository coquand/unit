-- A module-sheaf map is an equivalence if it is so on a covering basis.
-- It suffices that every open merely has a finite cover by opens where
-- the component map is an equivalence. First prove injectivity on every
-- open by restriction to such a cover and source separation. Local inverse
-- images of a target section then agree on overlaps by that injectivity.
-- Glue them in the source and check their image by target separation.
-- Fibres are propositions, so mere covers determine actual inverses.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module DL = DistLattice[l] ;
module MS = SerreModuleSheaf[l] ; module SS = SerreSetSheaf[l] ;
module Over (L : DL.DLat) (G : RingedLattice[l].On[L].Presheaf)
 (E F : MS.On[L,G].ModuleSheaf) (q : MS.On[L,G].Transform[E.presheaf,F.presheaf].Hom) {
 module O = DL.Order[L] ; module J = DL.Joins[L] ;
 module H = MS.On[L,G].Transform[E.presheaf,F.presheaf] ;
 module EO = MS.On[L,G].Of[E.presheaf] ; module FO = MS.On[L,G].Of[F.presheaf] ;
 record GoodCover (a : L.L) {
  count : Nat ;
  opens : Fin count -> L.L ;
  below : (i : Fin count) -> O.Le (opens i) a ;
  covers : O.Le a (J.bigJ count opens) ;
  local (i : Fin count) : Pr.isEquiv (E.presheaf.module-at (opens i)).M (F.presheaf.module-at (opens i)).M (H.at q (opens i)) ;
 } ;
 module With (covering : (a : L.L) -> Tr.Trunc[GoodCover[a]].carrier) {
  module InjectiveCover (a : L.L) (c : GoodCover[a]) {
   module ES = SS.On[L].SheafProofs[EO.underlying,E.sheaf].Cover[a,c.count,c.opens,c.below,c.covers] ;
   equal (x y : (E.presheaf.module-at a).M)
    (e : Id (F.presheaf.module-at a).M (H.at q a x) (H.at q a y)) : Id (E.presheaf.module-at a).M x y =
    ES.separated x y (\ i -> Iso[l].injective (E.presheaf.module-at (c.opens i)).M (F.presheaf.module-at (c.opens i)).M
     (H.at q (c.opens i)) (c.local i) _ _
     (trans (q.natural (c.opens i) a (c.below i) x)
      (trans (ap (FO.restrict (c.opens i) a (c.below i)) e) (sym (q.natural (c.opens i) a (c.below i) y))))) ;
  } ;
  injective (a : L.L) (x y : (E.presheaf.module-at a).M)
   (e : Id (F.presheaf.module-at a).M (H.at q a x) (H.at q a y)) : Id (E.presheaf.module-at a).M x y =
   Tr.Trunc[GoodCover[a]].induction @l (\ c -> Id (E.presheaf.module-at a).M x y)
    (\ c -> (E.presheaf.module-at a).setM x y) (\ c -> InjectiveCover[a,c].equal x y e) (covering a) ;
  Fibre (a : L.L) (y : (F.presheaf.module-at a).M) : U l =
   (x : (E.presheaf.module-at a).M) * Id (F.presheaf.module-at a).M (H.at q a x) y ;
  fibre-prop (a : L.L) (y : (F.presheaf.module-at a).M) : Pr.isProp (Fibre a y) = \ x z ->
   Pr.Sigma-eq (E.presheaf.module-at a).M (\ x -> Id (F.presheaf.module-at a).M (H.at q a x) y)
    x.1 z.1 x.2 z.2 (injective a x.1 z.1 (trans x.2 (sym z.2))) ((F.presheaf.module-at a).setM _ _) ;
  module Lift (a : L.L) (y : (F.presheaf.module-at a).M) (c : GoodCover[a]) {
   module EC = EO.Cover[a,c.count,c.opens,c.below,c.covers].C ;
   module ES = SS.On[L].SheafProofs[EO.underlying,E.sheaf].Cover[a,c.count,c.opens,c.below,c.covers] ;
   module FS = SS.On[L].SheafProofs[FO.underlying,F.sheaf].Cover[a,c.count,c.opens,c.below,c.covers] ;
   local (i : Fin c.count) : (E.presheaf.module-at (c.opens i)).M =
    (c.local i).sec (FO.restrict (c.opens i) a (c.below i) y) ;
   image (i : Fin c.count) : Id (F.presheaf.module-at (c.opens i)).M (H.at q (c.opens i) (local i))
    (FO.restrict (c.opens i) a (c.below i) y) = (c.local i).sec-eq (FO.restrict (c.opens i) a (c.below i) y) ;
   module Pair (i j : Fin c.count) {
    domain : L.L = L.meet (c.opens i) (c.opens j) ;
    below : O.Le domain a = O.le-trans domain (c.opens i) a (O.meet-left (c.opens i) (c.opens j)) (c.below i) ;
    left-image : Id (F.presheaf.module-at domain).M
     (H.at q domain (EO.restrict domain (c.opens i) (O.meet-left (c.opens i) (c.opens j)) (local i)))
     (FO.restrict domain a below y) =
     trans (q.natural domain (c.opens i) (O.meet-left (c.opens i) (c.opens j)) (local i))
      (trans (ap (FO.restrict domain (c.opens i) (O.meet-left (c.opens i) (c.opens j))) (image i))
       (F.presheaf.res-comp domain (c.opens i) a (O.meet-left (c.opens i) (c.opens j)) (c.below i) below y)) ;
    right-image : Id (F.presheaf.module-at domain).M
     (H.at q domain (EO.restrict domain (c.opens j) (O.meet-right (c.opens i) (c.opens j)) (local j)))
     (FO.restrict domain a below y) =
     trans (q.natural domain (c.opens j) (O.meet-right (c.opens i) (c.opens j)) (local j))
      (trans (ap (FO.restrict domain (c.opens j) (O.meet-right (c.opens i) (c.opens j))) (image j))
       (F.presheaf.res-comp domain (c.opens j) a (O.meet-right (c.opens i) (c.opens j)) (c.below j) below y)) ;
   } ;
   compatible : EC.Compatible local = \ i j -> injective Pair[i,j].domain _ _
    (trans Pair[i,j].left-image (sym Pair[i,j].right-image)) ;
   glued : EC.Amalgam local = (ES.glue local compatible).1 ;
   value : (E.presheaf.module-at a).M = EC.amalgam glued ;
   equation : Id (F.presheaf.module-at a).M (H.at q a value) y =
    FS.separated (H.at q a value) y (\ i -> trans (sym (q.natural (c.opens i) a (c.below i) value))
     (trans (ap (H.at q (c.opens i)) (EC.matches glued i)) (image i))) ;
   lift : Fibre a y = (value,equation) ;
   opaque glued ;
  } ;
  preimage (a : L.L) (y : (F.presheaf.module-at a).M) : Fibre a y =
   Tr.Trunc[GoodCover[a]].induction @l (\ c -> Fibre a y) (\ c -> fibre-prop a y)
    (\ c -> Lift[a,y,c].lift) (covering a) ;
  inverse (a : L.L) (y : (F.presheaf.module-at a).M) : (E.presheaf.module-at a).M = (preimage a y).1 ;
  right (a : L.L) (y : (F.presheaf.module-at a).M) : Id (F.presheaf.module-at a).M (H.at q a (inverse a y)) y = (preimage a y).2 ;
  left (a : L.L) (x : (E.presheaf.module-at a).M) : Id (E.presheaf.module-at a).M (inverse a (H.at q a x)) x =
   injective a _ _ (right a (H.at q a x)) ;
  equivalence : SerreModuleSheafIso[l].On[L,G].Equivalence E.presheaf F.presheaf =
   (q,\ a -> Pr.qinv (E.presheaf.module-at a).M (F.presheaf.module-at a).M (H.at q a) (inverse a) (right a) (left a)) ;
  opaque inverse ;
 } ;
} ;
