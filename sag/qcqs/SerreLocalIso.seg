-- Isomorphisms are local on the target (serre-affineness.tex, Lemma
-- lem:localiso).  In the ringed convention a geometric map g : Y -> Z is a
-- map pi : (L, O_Z) -> (M, O_Y) of ringed lattices, pi = g^* on opens and
-- pi#_u : O_Z(u) -> O_Y(pi u).  Let e_1, .., e_n cover L (top <= \/ e_i)
-- and suppose that every restricted map Y|pi(e_i) -> Z|e_i (SliceMap) is
-- an isomorphism (Restricted.IsIso).  Then pi is an isomorphism (Iso.IsIso)
-- and local.
--
-- Below a member.  For w <= e_i the section map of the i-th restricted map
--  at w is pi#_w followed by the restriction from pi w to the equal open
--  pi w /\ pi e_i (SliceMap, by definition: sharp-at).  That restriction
--  is bijective (Iso.EqualOpens), so pi#_w is (Iso.equiv-cancel).
-- Lattice.  Every u is below the join of its pieces u /\ e_i (cover).
--  Injective: if pi u = pi u2, the pieces u /\ e_i and u2 /\ e_i have the
--  same image pi u /\ pi e_i under the injective i-th restricted lattice map
--  (lat-at), so they are equal; then u <= \/ (u /\ e_i) = \/ (u2 /\ e_i) <= u2,
--  and symmetrically.
--  Surjective: for m in M let b_i <= e_i be the inverse image of
--  m /\ pi e_i under the i-th restricted lattice map, so pi b_i = m /\ pi e_i,
--  and put b = \/ b_i.  Then pi b = \/ pi b_i = \/ (m /\ pi e_i) = m, since
--  the pi e_i cover M (pi preserves top and finite joins).  The relation
--  b_i /\ e_j = b_j /\ e_i of the informal text is not needed for this.
-- Sections.  Fix u, covered by its pieces w_i = u /\ e_i, so that pi u is
--  covered by the pi w_i.
--  Injective: if pi# s = pi# s2, then pi#(s|w_i) = (pi# s)|pi w_i (pi
--  natural) agree, so s|w_i = s2|w_i (pi#_(w_i) is injective), and s = s2 by
--  separation in O_Z.
--  Surjective: for t in O_Y(pi u) let s_i = (pi#_(w_i))^-1 (t|pi w_i).  For
--  v <= w_i, pi#(s_i|v) = t|pi v (pi natural, res-comp: image-res).  On
--  v = w_i /\ w_j, below e_i, both s_i|v and s_j|v are therefore sent by the
--  injective pi#_v to t|pi v; so the s_i are compatible and glue to s in
--  O_Z(u).  pi# s and t have the same restrictions pi#(s|w_i) = pi#(s_i) =
--  t|pi w_i, so they are equal (separation in O_Y).
-- Isomorphisms are local (Iso.Maps.Local).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module DL = DistLattice[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;

-- the restriction of pi over e is an isomorphism
module Restricted (L M : DL.DLat) (Z : LocallyRinged[l].On[L].LocallyRinged)
 (Y : LocallyRinged[l].On[M].LocallyRinged) (pi : LocallyRinged[l].Maps[L,M,Z.sheaf,Y.sheaf].Ringed) (e : L.L) {
 module S = SliceMap[l].Over[L,M,Z,Y,pi,e] ;
 IsIso : U l = Iso[l].Maps[S.SY.lattice,S.SX.lattice,S.SY.sheaf,S.SX.sheaf].IsIso S.morphism ;
} ;

module Over (L M : DL.DLat) (Z : LocallyRinged[l].On[L].LocallyRinged)
 (Y : LocallyRinged[l].On[M].LocallyRinged) (pi : LocallyRinged[l].Maps[L,M,Z.sheaf,Y.sheaf].Ringed)
 (n : Nat) (es : Fin n -> L.L) (covers : DL.Order[L].Le L.top (DL.Joins[L].bigJ n es))
 (restricted-iso : (i : Fin n) -> Restricted[L,M,Z,Y,pi,es i].IsIso) {
 module OL = DL.Order[L] ;
 module OM = DL.Order[M] ;
 module JL = DL.Joins[L] ;
 module JM = DL.Joins[M] ;
 module P = DL.JoinMaps[L,M,pi.lat] ;
 module GZ = RingedLattice[l].On[L].Of[Z.sheaf] ;
 module GY = RingedLattice[l].On[M].Of[Y.sheaf] ;
 module I = Iso[l].Maps[L,M,Z.sheaf,Y.sheaf] ;
 p (u : L.L) : M.L = DL.hmap pi.lat u ;

 -- the i-th restricted map, by definition
 module Piece (i : Fin n) {
  module S = Restricted[L,M,Z,Y,pi,es i].S ;
  module SZ = S.SY ;
  module SY = S.SX ;
  lat-equiv : Pr.isEquiv SZ.Opens SY.Opens (DL.hmap S.morphism.lat) = (restricted-iso i).1 ;
  lat-at (x : SZ.Opens) : Id M.L (SY.inc (DL.hmap S.morphism.lat x)) (M.meet (p (SZ.inc x)) (p (es i))) =
   refl (M.meet (p (SZ.inc x)) (p (es i))) ;
  sharp-at (x : SZ.Opens) (s : (Z.sheaf.ring (SZ.inc x)).R) :
   Id (Y.sheaf.ring (M.meet (p (SZ.inc x)) (p (es i)))).R (map (S.morphism.sharp x) s)
    (GY.restrict (M.meet (p (SZ.inc x)) (p (es i))) (p (SZ.inc x)) (OM.meet-left (p (SZ.inc x)) (p (es i)))
      (map (pi.sharp (SZ.inc x)) s)) =
   refl (GY.restrict (M.meet (p (SZ.inc x)) (p (es i))) (p (SZ.inc x)) (OM.meet-left (p (SZ.inc x)) (p (es i)))
      (map (pi.sharp (SZ.inc x)) s)) ;
 } ;

 -- below a member, pi# is bijective
 module Below (i : Fin n) (w : L.L) (k : OL.Le w (es i)) {
  module Pc = Piece[i] ;
  x : Pc.SZ.Opens = (w,k) ;
  up : OM.Le (p w) (M.meet (p w) (p (es i))) =
   OM.meet-glb (p w) (p (es i)) (p w) (OM.le-refl (p w)) (P.monotone w (es i) k) ;
  module EO = Iso[l].EqualOpens[M,Y.sheaf,M.meet (p w) (p (es i)),p w,OM.meet-left (p w) (p (es i)),up] ;
  restricted-equiv : Pr.isEquiv (Z.sheaf.ring w).R (Y.sheaf.ring (M.meet (p w) (p (es i)))).R
   (\ s -> GY.restrict (M.meet (p w) (p (es i))) (p w) (OM.meet-left (p w) (p (es i))) (map (pi.sharp w) s)) =
   Iso[l].equiv-homotopy (Z.sheaf.ring w).R (Y.sheaf.ring (M.meet (p w) (p (es i)))).R (map (Pc.S.morphism.sharp x))
    (\ s -> GY.restrict (M.meet (p w) (p (es i))) (p w) (OM.meet-left (p w) (p (es i))) (map (pi.sharp w) s))
    (Pc.sharp-at x) ((restricted-iso i).2 x) ;
  sharp-equiv : Pr.isEquiv (Z.sheaf.ring w).R (Y.sheaf.ring (p w)).R (map (pi.sharp w)) =
   Iso[l].equiv-cancel (Z.sheaf.ring w).R (Y.sheaf.ring (p w)).R (Y.sheaf.ring (M.meet (p w) (p (es i)))).R
    (GY.restrict (M.meet (p w) (p (es i))) (p w) (OM.meet-left (p w) (p (es i)))) (map (pi.sharp w)) EO.equiv
    restricted-equiv ;
 } ;

 -- the lattice map
 -- the pi e_i cover M
 cover-M : OM.Le M.top (JM.bigJ n (\ i -> p (es i))) =
  OM.le-trans M.top (p (JL.bigJ n es)) (JM.bigJ n (\ i -> p (es i)))
   (OM.le-trans M.top (p L.top) (p (JL.bigJ n es)) (OM.le-of-eq M.top (p L.top) (sym (DL.hmap-top pi.lat)))
     (P.monotone L.top (JL.bigJ n es) covers))
   (OM.le-of-eq (p (JL.bigJ n es)) (JM.bigJ n (\ i -> p (es i))) (P.preserves n es)) ;
 -- u is below the join of its pieces
 split-le (u : L.L) : OL.Le u (JL.bigJ n (\ i -> L.meet u (es i))) =
  JL.meet-cover u n es (OL.le-trans u L.top (JL.bigJ n es) (OL.le-top u) covers) ;
 -- the inverse image of m /\ pi e_i
 piece (i : Fin n) (m : M.L) : L.L = Piece[i].SZ.inc (Piece[i].lat-equiv.sec (Piece[i].SY.cut m)) ;
 piece-eq (i : Fin n) (m : M.L) : Id M.L (p (piece i m)) (M.meet m (p (es i))) = calc M.L {
  p (piece i m)
   =< sym (P.monotone (piece i m) (es i) (Piece[i].SZ.below (Piece[i].lat-equiv.sec (Piece[i].SY.cut m))))
    > M.meet (p (piece i m)) (p (es i))
   =< sym (Piece[i].lat-at (Piece[i].lat-equiv.sec (Piece[i].SY.cut m)))
    > Piece[i].SY.inc (DL.hmap Piece[i].S.morphism.lat (Piece[i].lat-equiv.sec (Piece[i].SY.cut m)))
   =< ap Piece[i].SY.inc (Piece[i].lat-equiv.sec-eq (Piece[i].SY.cut m)) > M.meet m (p (es i)) } ;
 back (m : M.L) : L.L = JL.bigJ n (\ i -> piece i m) ;
 back-le (m : M.L) : OM.Le (p (back m)) m =
  OM.le-trans (p (back m)) (JM.bigJ n (\ i -> p (piece i m))) m
   (OM.le-of-eq (p (back m)) (JM.bigJ n (\ i -> p (piece i m))) (P.preserves n (\ i -> piece i m)))
   (JM.least n (\ i -> p (piece i m)) m (\ i ->
     OM.le-trans (p (piece i m)) (M.meet m (p (es i))) m (OM.le-of-eq (p (piece i m)) (M.meet m (p (es i))) (piece-eq i m))
      (OM.meet-left m (p (es i))))) ;
 le-back (m : M.L) : OM.Le m (p (back m)) =
  OM.le-trans m (JM.bigJ n (\ i -> M.meet m (p (es i)))) (p (back m))
   (JM.meet-cover m n (\ i -> p (es i)) (OM.le-trans m M.top (JM.bigJ n (\ i -> p (es i))) (OM.le-top m) cover-M))
   (OM.le-trans (JM.bigJ n (\ i -> M.meet m (p (es i)))) (JM.bigJ n (\ i -> p (piece i m))) (p (back m))
     (JM.least n (\ i -> M.meet m (p (es i))) (JM.bigJ n (\ i -> p (piece i m))) (\ i ->
       OM.le-trans (M.meet m (p (es i))) (p (piece i m)) (JM.bigJ n (\ i2 -> p (piece i2 m)))
        (OM.le-of-eq (M.meet m (p (es i))) (p (piece i m)) (sym (piece-eq i m)))
        (JM.below n (\ i2 -> p (piece i2 m)) i)))
     (OM.le-of-eq (JM.bigJ n (\ i -> p (piece i m))) (p (back m)) (sym (P.preserves n (\ i -> piece i m))))) ;
 back-eq (m : M.L) : Id M.L (p (back m)) m = OM.le-antisym (p (back m)) m (back-le m) (le-back m) ;
 -- equal images give equal pieces
 piece-inj (i : Fin n) (u u2 : L.L) (e : Id M.L (p u) (p u2)) : Id L.L (L.meet u (es i)) (L.meet u2 (es i)) =
  ap Piece[i].SZ.inc (Iso[l].injective Piece[i].SZ.Opens Piece[i].SY.Opens (DL.hmap Piece[i].S.morphism.lat) Piece[i].lat-equiv
   (Piece[i].SZ.cut u) (Piece[i].SZ.cut u2)
   (Piece[i].SY.ext (DL.hmap Piece[i].S.morphism.lat (Piece[i].SZ.cut u)) (DL.hmap Piece[i].S.morphism.lat (Piece[i].SZ.cut u2))
    (calc M.L {
     Piece[i].SY.inc (DL.hmap Piece[i].S.morphism.lat (Piece[i].SZ.cut u))
      =< Piece[i].lat-at (Piece[i].SZ.cut u) > M.meet (p (L.meet u (es i))) (p (es i))
      =< ap (\ t -> M.meet t (p (es i))) (DL.hmap-meet pi.lat u (es i)) > M.meet (M.meet (p u) (p (es i))) (p (es i))
      =< ap (\ t -> M.meet (M.meet t (p (es i))) (p (es i))) e > M.meet (M.meet (p u2) (p (es i))) (p (es i))
      =< sym (ap (\ t -> M.meet t (p (es i))) (DL.hmap-meet pi.lat u2 (es i))) > M.meet (p (L.meet u2 (es i))) (p (es i))
      =< sym (Piece[i].lat-at (Piece[i].SZ.cut u2)) > Piece[i].SY.inc (DL.hmap Piece[i].S.morphism.lat (Piece[i].SZ.cut u2)) }))) ;
 below-of (u u2 : L.L) (e : Id M.L (p u) (p u2)) : OL.Le u u2 =
  OL.le-trans u (JL.bigJ n (\ i -> L.meet u (es i))) u2 (split-le u)
   (JL.least n (\ i -> L.meet u (es i)) u2 (\ i ->
     OL.le-trans (L.meet u (es i)) (L.meet u2 (es i)) u2 (OL.le-of-eq (L.meet u (es i)) (L.meet u2 (es i)) (piece-inj i u u2 e))
      (OL.meet-left u2 (es i)))) ;
 lat-inj (u u2 : L.L) (e : Id M.L (p u) (p u2)) : Id L.L u u2 =
  OL.le-antisym u u2 (below-of u u2 e) (below-of u2 u (sym e)) ;
 lat-equiv : Pr.isEquiv L.L M.L (DL.hmap pi.lat) =
  Pr.qinv L.L M.L (DL.hmap pi.lat) back back-eq (\ u -> lat-inj (back (p u)) u (back-eq (p u))) ;

 -- the section maps at u
 module AtOpen (u : L.L) {
  w (i : Fin n) : L.L = L.meet u (es i) ;
  w-le (i : Fin n) : OL.Le (w i) u = OL.meet-left u (es i) ;
  w-e (i : Fin n) : OL.Le (w i) (es i) = OL.meet-right u (es i) ;
  module CZ = RingedLattice[l].On[L].Sheaf[Z.sheaf,Z.is-sheaf].Cover[u,n,w,w-le,split-le u] ;
  pw-le (i : Fin n) : OM.Le (p (w i)) (p u) = P.monotone (w i) u (w-le i) ;
  covers-Y : OM.Le (p u) (JM.bigJ n (\ i -> p (w i))) =
   OM.le-trans (p u) (p (JL.bigJ n w)) (JM.bigJ n (\ i -> p (w i))) (P.monotone u (JL.bigJ n w) (split-le u))
    (OM.le-of-eq (p (JL.bigJ n w)) (JM.bigJ n (\ i -> p (w i))) (P.preserves n w)) ;
  module CY = RingedLattice[l].On[M].Sheaf[Y.sheaf,Y.is-sheaf].Cover[p u,n,\ i -> p (w i),pw-le,covers-Y] ;
  equiv-at (i : Fin n) : Pr.isEquiv (Z.sheaf.ring (w i)).R (Y.sheaf.ring (p (w i))).R (map (pi.sharp (w i))) =
   Below[i,w i,w-e i].sharp-equiv ;
  -- injective
  injective (s s2 : (Z.sheaf.ring u).R) (e : Id (Y.sheaf.ring (p u)).R (map (pi.sharp u) s) (map (pi.sharp u) s2)) :
   Id (Z.sheaf.ring u).R s s2 =
   CZ.separated s s2 (\ i -> Iso[l].injective (Z.sheaf.ring (w i)).R (Y.sheaf.ring (p (w i))).R (map (pi.sharp (w i)))
    (equiv-at i) (CZ.C.restrictions s i) (CZ.C.restrictions s2 i) (calc (Y.sheaf.ring (p (w i))).R {
     map (pi.sharp (w i)) (CZ.C.restrictions s i)
      =< sym (pi.natural (w i) u (w-le i) s) > GY.restrict (p (w i)) (p u) (pw-le i) (map (pi.sharp u) s)
      =< ap (GY.restrict (p (w i)) (p u) (pw-le i)) e > GY.restrict (p (w i)) (p u) (pw-le i) (map (pi.sharp u) s2)
      =< pi.natural (w i) u (w-le i) s2 > map (pi.sharp (w i)) (CZ.C.restrictions s2 i) })) ;
  -- surjective
  module Lift (t : (Y.sheaf.ring (p u)).R) {
   local (i : Fin n) : (Z.sheaf.ring (w i)).R = (equiv-at i).sec (CY.C.restrictions t i) ;
   local-eq (i : Fin n) : Id (Y.sheaf.ring (p (w i))).R (map (pi.sharp (w i)) (local i)) (CY.C.restrictions t i) =
    (equiv-at i).sec-eq (CY.C.restrictions t i) ;
   image-res (i : Fin n) (v : L.L) (k : OL.Le v (w i)) :
    Id (Y.sheaf.ring (p v)).R (map (pi.sharp v) (GZ.restrict v (w i) k (local i)))
     (GY.restrict (p v) (p u) (P.monotone v u (OL.le-trans v (w i) u k (w-le i))) t) = calc (Y.sheaf.ring (p v)).R {
    map (pi.sharp v) (GZ.restrict v (w i) k (local i))
     =< sym (pi.natural v (w i) k (local i)) > GY.restrict (p v) (p (w i)) (P.monotone v (w i) k) (map (pi.sharp (w i)) (local i))
     =< ap (GY.restrict (p v) (p (w i)) (P.monotone v (w i) k)) (local-eq i)
      > GY.restrict (p v) (p (w i)) (P.monotone v (w i) k) (CY.C.restrictions t i)
     =< Y.sheaf.res-comp (p v) (p (w i)) (p u) (P.monotone v (w i) k) (pw-le i)
         (P.monotone v u (OL.le-trans v (w i) u k (w-le i))) t
      > GY.restrict (p v) (p u) (P.monotone v u (OL.le-trans v (w i) u k (w-le i))) t } ;
   compatible : CZ.C.Compatible local = \ i j ->
    Iso[l].injective (Z.sheaf.ring (L.meet (w i) (w j))).R (Y.sheaf.ring (p (L.meet (w i) (w j)))).R
     (map (pi.sharp (L.meet (w i) (w j))))
     Below[i,L.meet (w i) (w j),OL.le-trans (L.meet (w i) (w j)) (w i) (es i) (OL.meet-left (w i) (w j)) (w-e i)].sharp-equiv
     (GZ.restrict (L.meet (w i) (w j)) (w i) (OL.meet-left (w i) (w j)) (local i))
     (GZ.restrict (L.meet (w i) (w j)) (w j) (OL.meet-right (w i) (w j)) (local j))
     (calc (Y.sheaf.ring (p (L.meet (w i) (w j)))).R {
      map (pi.sharp (L.meet (w i) (w j))) (GZ.restrict (L.meet (w i) (w j)) (w i) (OL.meet-left (w i) (w j)) (local i))
       =< image-res i (L.meet (w i) (w j)) (OL.meet-left (w i) (w j))
        > GY.restrict (p (L.meet (w i) (w j))) (p u)
           (P.monotone (L.meet (w i) (w j)) u (OL.le-trans (L.meet (w i) (w j)) (w i) u (OL.meet-left (w i) (w j)) (w-le i))) t
       =< GY.res-irr (p (L.meet (w i) (w j))) (p u)
           (P.monotone (L.meet (w i) (w j)) u (OL.le-trans (L.meet (w i) (w j)) (w i) u (OL.meet-left (w i) (w j)) (w-le i)))
           (P.monotone (L.meet (w i) (w j)) u (OL.le-trans (L.meet (w i) (w j)) (w j) u (OL.meet-right (w i) (w j)) (w-le j))) t
        > GY.restrict (p (L.meet (w i) (w j))) (p u)
           (P.monotone (L.meet (w i) (w j)) u (OL.le-trans (L.meet (w i) (w j)) (w j) u (OL.meet-right (w i) (w j)) (w-le j))) t
       =< sym (image-res j (L.meet (w i) (w j)) (OL.meet-right (w i) (w j)))
        > map (pi.sharp (L.meet (w i) (w j))) (GZ.restrict (L.meet (w i) (w j)) (w j) (OL.meet-right (w i) (w j)) (local j)) }) ;
   glued : CZ.C.Amalgam local = (CZ.glue local compatible).1 ;
   s : (Z.sheaf.ring u).R = CZ.C.amalgam glued ;
   s-at (i : Fin n) : Id (Z.sheaf.ring (w i)).R (CZ.C.restrictions s i) (local i) = CZ.C.matches glued i ;
   hits : Id (Y.sheaf.ring (p u)).R (map (pi.sharp u) s) t =
    CY.separated (map (pi.sharp u) s) t (\ i -> calc (Y.sheaf.ring (p (w i))).R {
     CY.C.restrictions (map (pi.sharp u) s) i
      =< pi.natural (w i) u (w-le i) s > map (pi.sharp (w i)) (CZ.C.restrictions s i)
      =< ap (map (pi.sharp (w i))) (s-at i) > map (pi.sharp (w i)) (local i)
      =< local-eq i > CY.C.restrictions t i }) ;
  } ;
  sharp-equiv : Pr.isEquiv (Z.sheaf.ring u).R (Y.sheaf.ring (p u)).R (map (pi.sharp u)) =
   Pr.qinv (Z.sheaf.ring u).R (Y.sheaf.ring (p u)).R (map (pi.sharp u)) (\ t -> Lift[t].s) (\ t -> Lift[t].hits)
    (\ s2 -> injective Lift[map (pi.sharp u) s2].s s2 Lift[map (pi.sharp u) s2].hits) ;
 } ;

 -- pi is an isomorphism, and local
 iso : I.IsIso pi = (lat-equiv,\ u -> AtOpen[u].sharp-equiv) ;
 local : LocallyRinged[l].Maps[L,M,Z.sheaf,Y.sheaf].Of[pi,Z.inv,Y.inv].IsLocal = I.Local[pi,iso,Z.inv,Y.inv].local ;
} ;
