-- The associated sheaf M~ is quasi-coherent on Spec A (PLAN-QCOH-UA,
-- step 3).
-- Informal proof. Spec A is affine (AffineQcqs.TestSpace), so its top open
-- is affine, and by the lambda-criterion (SerreLambdaCriterion) M~ has an
-- affine model at top as soon as lambda_(top,s) : M~(top)_s -> M~(D_top s)
-- is an equivalence for every s in O(top); the one-chart atlas {top}
-- then gives quasi-coherence.
-- lambda_(top,s) is an equivalence iff restriction M~(top) -> M~(D_top s)
-- clears and kills at s (SerreLambdaClearing). Write s = a|top with
-- a in A (Global: a |-> a|top is bijective); it suffices that the
-- restriction clears and kills at a over A (SerreLambdaElementarySquare,
-- Unrestrict). Compare it with the canonical map M -> M_a by the square
--   M~(top) --restrict--> M~(D_top s)
--     | glob^-1                | restrict to D a = D_top s (Global.d-global), eval_a
--     M ------- x |-> x/1 ---> M_a
-- of A-linear bijections (SerreTildeGlobal): it commutes since
-- eval_a(glob(x)|D a) = x/1. The canonical map clears and kills at a: it
-- is the composite of the identity of M_a with x |-> x/1, which clears
-- fractions (a^p (x/a^p) = x/1, SerreLambdaLocalLinear.diagonal), and the
-- identity is bijective (SerreLambdaElementary.FromEquivalence). Clearing
-- and killing pass back along the square (SerreLambdaElementarySquare).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module RH = RingHom[l] ; module RM = RingMaps[l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module EL = SerreLambdaElementary[l] ; module ES = SerreLambdaElementarySquare[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (Md : SM.Over[A].Module) {
 module GM = SerreTildeGlobal[l].Over[A,setA,Md] ;
 module Z = GM.Z ; module O = Z.O ; module Glo = GM.Glo ; module Rings = GM.Rings ; module S = GM.S ;
 module QC = SerreQuasiCoherent[l].On[Z.lattice,GM.AF.spec,GM.Sh.associated] ;
 module LX = LocallyRinged[l].On[Z.lattice].Laws[GM.AF.spec.sheaf,GM.AF.spec.inv] ;
 -- Spec A is affine, so is its top open
 affine : AffineCriterion[l].Over[Z.lattice,GM.AF.spec].IsAffine = AffineQcqs[l].TestSpace[new AffineTests[l].Test[A,setA]].affine ;
 module Top = AffineQcqs[l].Over[new Spaces[l].Space[Z.lattice,GM.AF.spec],affine] ;
 module At (s : (GM.AF.spec.sheaf.ring Z.lattice.top).R) {
  module Cl = SerreLambdaClearing[l].On[Z.lattice,GM.AF.spec,GM.Sh.associated,Z.lattice.top,s] ;
  module C = Cl.C ;
  a : A.R = Glo.evaluate s ;
  image : Id (GM.AF.spec.sheaf.ring Z.lattice.top).R (RM.map Glo.global a) s = Glo.global-evaluate s ;
  module Un = ES.Unrestrict[A,GM.AF.spec.sheaf.ring Z.lattice.top,Glo.global,GM.Sh.associated.presheaf.module-at Z.lattice.top,
   C.Scalars.restricted,C.original,a,s,image] ;
  module R = Un.R ;
  -- D_top(s) = D a
  open-s : Z.lattice.L = Cl.Lam.open-g ;
  open-eq : Id Z.lattice.L open-s (Z.D a) = trans (ap (\ t -> LX.d Z.lattice.top t) (sym image)) (Glo.d-global a) ;
  to-a : O.Le (Z.D a) open-s = O.le-of-eq _ _ (sym open-eq) ;
  from-a : O.Le open-s (Z.D a) = O.le-of-eq _ _ open-eq ;
  -- the canonical map M -> M_a
  Q : SM.Over[A].Module = GM.BR.Local[a].Native.localised ;
  module Can = EL.Over[A,Md,Q,GM.BR.Local[a].Native.canonical,a] ;
  module LM = SerreLambdaLocalLinear[l].Over[A,setA,Md,a] ;
  identity-equiv : Pr.isEquiv (GM.Local a) (GM.Local a) (\ z -> z) =
   Pr.qinv (GM.Local a) (GM.Local a) (\ z -> z) (\ z -> z) (\ z -> refl z) (\ z -> refl z) ;
  module CanE = Can.FromEquivalence[\ z -> z,
   \ x p -> trans (LM.diagonal x p) (sym (GM.BR.Local[a].Native.canonical-at x)),identity-equiv] ;
  -- the right side of the square
  move (y : S.Section open-s) : GM.Local a = GM.Ev.At[a].eval (S.restrict (Z.D a) open-s to-a y) ;
  module J = MM.Between[A,A,RH.identity A,R.RNd.restricted,Q] ;
  move-add (y w : S.Section open-s) :
   Id (GM.Local a) (move (S.Ops[open-s].add y w)) (Q.madd (move y) (move w)) =
   refl (Q.madd (move y) (move w)) ;
  move-scale (b : A.R) (y : S.Section open-s) :
   Id (GM.Local a) (move (R.RNd.restricted.sm b y)) (Q.sm b (move y)) = calc (GM.Local a) {
    move (R.RNd.restricted.sm b y)
     =< ap (\ r -> move (S.Ops[open-s].scale r y))
         (trans (Rings.restriction-map open-s Z.lattice.top Cl.Lam.below (RM.map Glo.global b)) (GM.restrict-section open-s Z.lattice.top Cl.Lam.below b))
      > move (S.Ops[open-s].scale (RM.map Glo.Of[open-s].sections b) y)
     =< ap GM.Ev.At[a].eval (GM.restrict-scale (Z.D a) open-s to-a b y)
      > GM.Ev.At[a].eval (S.Ops[Z.D a].scale (RM.map Glo.Of[Z.D a].sections b) (S.restrict (Z.D a) open-s to-a y))
     =< GM.scale-section (Z.D a) b (S.restrict (Z.D a) open-s to-a y) a GM.Ev.At[a].gg > Q.sm b (move y) } ;
  j : J.Hom = new J.Hom[move,move-add,move-scale] ;
  back (z : GM.Local a) : S.Section open-s = S.restrict open-s (Z.D a) from-a (GM.Ev.At[a].extend z) ;
  j-equiv : Pr.isEquiv (S.Section open-s) (GM.Local a) (J.map j) =
   Pr.qinv (S.Section open-s) (GM.Local a) (J.map j) back
    (\ z -> trans (ap GM.Ev.At[a].eval
      (trans (S.restrict-comp (Z.D a) open-s (Z.D a) to-a from-a (O.le-refl (Z.D a)) (GM.Ev.At[a].extend z))
       (S.restrict-id (Z.D a) (O.le-refl (Z.D a)) (GM.Ev.At[a].extend z))))
      (GM.Ev.At[a].eval-extend z))
    (\ y -> trans (ap (S.restrict open-s (Z.D a) from-a) (GM.Ev.At[a].extend-eval (S.restrict (Z.D a) open-s to-a y)))
      (trans (S.restrict-comp open-s (Z.D a) open-s from-a to-a (O.le-refl open-s) y) (S.restrict-id open-s (O.le-refl open-s) y))) ;
  i-equiv : Pr.isEquiv (S.Section Z.lattice.top) Md.M GM.inverse.fn =
   Pr.qinv (S.Section Z.lattice.top) Md.M GM.inverse.fn GM.glob GM.inverse-glob GM.glob-inverse ;
  -- the square commutes: eval_a(y|D a) = (glob^-1 y)/1
  commutes (y : S.Section Z.lattice.top) : Id (GM.Local a) (J.map j (MM.Between[A,A,RH.identity A,R.RMd.restricted,R.RNd.restricted].map R.restricted y))
   (Can.H.map GM.BR.Local[a].Native.canonical (GM.inverse.fn y)) = calc (GM.Local a) {
    move (MM.Between[A,A,RH.identity A,R.RMd.restricted,R.RNd.restricted].map R.restricted y)
     =< ap move (trans (C.original-at y) (S.restriction-map open-s Z.lattice.top Cl.Lam.below y))
      > move (S.restrict open-s Z.lattice.top Cl.Lam.below y)
     =< ap GM.Ev.At[a].eval (S.restrict-comp (Z.D a) open-s Z.lattice.top to-a Cl.Lam.below (O.le-top (Z.D a)) y)
      > GM.Ev.At[a].eval (S.restrict (Z.D a) Z.lattice.top (O.le-top (Z.D a)) y)
     =< ap (\ t -> GM.Ev.At[a].eval (S.restrict (Z.D a) Z.lattice.top (O.le-top (Z.D a)) t)) (sym (GM.glob-inverse y))
      > GM.Ev.At[a].eval (S.restrict (Z.D a) Z.lattice.top (O.le-top (Z.D a)) (GM.glob (GM.inverse.fn y)))
     =< ap GM.Ev.At[a].eval (GM.restrict-global a (GM.inverse.fn y))
      > GM.Ev.At[a].eval (GM.Ev.At[a].extend (GM.fraction a (GM.inverse.fn y)))
     =< GM.Ev.At[a].eval-extend (GM.fraction a (GM.inverse.fn y)) > GM.fraction a (GM.inverse.fn y)
     =< sym (GM.BR.Local[a].Native.canonical-at (GM.inverse.fn y))
      > Can.H.map GM.BR.Local[a].Native.canonical (GM.inverse.fn y) } ;
  module Sq = ES.Square[A,R.RMd.restricted,R.RNd.restricted,Md,Q,R.restricted,GM.BR.Local[a].Native.canonical,
   GM.inverse,i-equiv,j,j-equiv,commutes,a] ;
  lambda : Cl.Lam.IsEquivalence = Cl.equivalence (Un.clear (Sq.clear CanE.clear)) (Un.kill (Sq.kill CanE.kill)) ;
 } ;
 -- the affine model at top and the one-chart atlas
 model : QC.At[Z.lattice.top].Model = SerreLambdaCriterion[l].On[Z.lattice,GM.AF.spec,GM.Sh.associated,Z.lattice.top,Top.affine-top,\ s -> At[s].lambda].model ;
 atlas : QC.Atlas = new QC.Atlas[Top.cover,\ i -> model] ;
 qcoh : QC.IsQuasiCoherent = QC.from-atlas atlas ;
} ;
