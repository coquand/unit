-- The precategory of small A-modules (SerreModuleCategory.modules) is
-- univalent (PLAN-QCOH-UA, step 1).
--
-- Informal proof.  A module is a carrier X with data (zero, addition,
-- negation, scaling by A) and axioms (X is a set, the eight module laws).
-- This is a notion of structure in the sense of SipGeneric: point, binop,
-- unop (a unary operation, below) and action A.R joined, with axioms.  The
-- axioms form a proposition: being a set is one (isSet-prop), and
-- given that, each law is a family of paths in a set (funext).  Hence
-- (SipGeneric.Over.total-contr, by univalence) the type of modules N with a
-- linear equivalence M ~ N (an equivalence of carriers preserving the four
-- operations) is contractible; the record Module is this Sigma type field by
-- field (fields, mk, back: eta of the record).
-- A categorical iso e : M ~ N gives such a linear equivalence (ToLin): its
-- arrow is an equivalence of carriers (SerreModuleCategory.underlying), and
-- it preserves zero and negation (SerreModuleMaps.map-zero, map-neg).
-- Conversely (FromLin) a linear equivalence is a linear map with an
-- inverse (SerreModuleCategory.FromEquiv.iso).  Going there and back
-- gives the same arrow (record eta of linear maps), hence the same iso
-- (Arrows.iso-eq).  So the singleton of isos at M is a retract of a
-- contractible type, a proposition, and Category.FromTotal gives
-- univalence.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ;
module G = SipGeneric[l] ; module GH = SipGeneric[l+] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module SM = SerreModule[l] ; module MC = SerreModuleCategory[l] ;
module Bil = SerreBilinear[l] ; module CC = Category[l+,l] ;

-- a unary operation, a notion of structure
unop : G.Notion = new G.Notion[
 S := \ X -> X -> X,
 Iota := \ X Y s t e -> (x : X) -> Id Y (e.1 (s x)) (t (e.1 x)),
 rho := \ X s x -> refl (s x),
 unit := \ X s -> G.hsing X X s
] ;

-- families of paths in a set are propositions
module PH (R X : U l) (sX : Pr.isSet X) {
 p1 (f g : X -> X) : Pr.isProp ((x : X) -> Id X (f x) (g x)) =
  FE.isProp-Pi X (\ x -> Id X (f x) (g x)) (\ x -> sX (f x) (g x)) ;
 p2 (f g : X -> X -> X) : Pr.isProp ((x y : X) -> Id X (f x y) (g x y)) =
  FE.isProp-Pi X (\ x -> (y : X) -> Id X (f x y) (g x y)) (\ x -> p1 (f x) (g x)) ;
 p3 (f g : X -> X -> X -> X) : Pr.isProp ((x y w : X) -> Id X (f x y w) (g x y w)) =
  FE.isProp-Pi X (\ x -> (y w : X) -> Id X (f x y w) (g x y w)) (\ x -> p2 (f x) (g x)) ;
 r1 (f g : R -> X -> X) : Pr.isProp ((a : R) (x : X) -> Id X (f a x) (g a x)) =
  FE.isProp-Pi R (\ a -> (x : X) -> Id X (f a x) (g a x)) (\ a -> p1 (f a) (g a)) ;
 r2 (f g : R -> X -> X -> X) : Pr.isProp ((a : R) (x y : X) -> Id X (f a x y) (g a x y)) =
  FE.isProp-Pi R (\ a -> (x y : X) -> Id X (f a x y) (g a x y)) (\ a -> p2 (f a) (g a)) ;
 rr1 (f g : R -> R -> X -> X) : Pr.isProp ((a b : R) (x : X) -> Id X (f a b x) (g a b x)) =
  FE.isProp-Pi R (\ a -> (b : R) (x : X) -> Id X (f a b x) (g a b x)) (\ a -> r1 (f a) (g a)) ;
} ;
-- being a set is a proposition
isSet-prop (X : U l) : Pr.isProp (Pr.isSet X) =
 FE.isProp-Pi X (\ x -> (y : X) -> Pr.isProp (Id X x y)) (\ x ->
  FE.isProp-Pi X (\ y -> Pr.isProp (Id X x y)) (\ y -> FE.isProp-isProp (Id X x y))) ;
prod (X Y : U l) (pX : Pr.isProp X) (pY : Pr.isProp Y) : Pr.isProp (X * Y) =
 Pr.isProp-Sigma X (\ u -> Y) pX (\ u -> pY) ;

module Over (A : CRing) {
 module S = SM.Over[A] ; module K = MC.Over[A] ; module L = Bil.Over[A] ;
 -- the data of a module: zero, addition, negation, scaling
 Data : G.Notion = G.join G.point (G.join G.binop (G.join unop (G.action A.R))) ;
 module Laws (X : U l) (d : Data.S X) {
  mz : X = d.1 ; madd : X -> X -> X = d.2.1 ; mneg : X -> X = d.2.2.1 ; sm : A.R -> X -> X = d.2.2.2 ;
  LA : U l = (x y z : X) -> Id X (madd x (madd y z)) (madd (madd x y) z) ;
  LC : U l = (x y : X) -> Id X (madd x y) (madd y x) ;
  LZ : U l = (x : X) -> Id X (madd x mz) x ;
  LN : U l = (x : X) -> Id X (madd x (mneg x)) mz ;
  SA : U l = (a b : A.R) (x : X) -> Id X (sm a (sm b x)) (sm (A.mul a b) x) ;
  SO : U l = (x : X) -> Id X (sm A.o x) x ;
  SD : U l = (a : A.R) (x y : X) -> Id X (sm a (madd x y)) (madd (sm a x) (sm a y)) ;
  SE : U l = (a b : A.R) (x : X) -> Id X (sm (A.add a b) x) (madd (sm a x) (sm b x)) ;
  Rest : U l = LA * LC * LZ * LN * SA * SO * SD * SE ;
  rest-prop (sX : Pr.isSet X) : Pr.isProp Rest =
   prod LA _ (PH[A.R,X,sX].p3 (\ x y z -> madd x (madd y z)) (\ x y z -> madd (madd x y) z))
   (prod LC _ (PH[A.R,X,sX].p2 (\ x y -> madd x y) (\ x y -> madd y x))
   (prod LZ _ (PH[A.R,X,sX].p1 (\ x -> madd x mz) (\ x -> x))
   (prod LN _ (PH[A.R,X,sX].p1 (\ x -> madd x (mneg x)) (\ x -> mz))
   (prod SA _ (PH[A.R,X,sX].rr1 (\ a b x -> sm a (sm b x)) (\ a b x -> sm (A.mul a b) x))
   (prod SO _ (PH[A.R,X,sX].p1 (\ x -> sm A.o x) (\ x -> x))
   (prod SD _ (PH[A.R,X,sX].r2 (\ a x y -> sm a (madd x y)) (\ a x y -> madd (sm a x) (sm a y)))
    (PH[A.R,X,sX].rr1 (\ a b x -> sm (A.add a b) x) (\ a b x -> madd (sm a x) (sm b x))))))))) ;
  -- the parts of a proof of the laws
  module Of (r : Rest) {
   la : LA = r.1 ; lc : LC = r.2.1 ; lz : LZ = r.2.2.1 ; ln : LN = r.2.2.2.1 ;
   sa : SA = r.2.2.2.2.1 ; so : SO = r.2.2.2.2.2.1 ; sd : SD = r.2.2.2.2.2.2.1 ; se : SE = r.2.2.2.2.2.2.2 ;
  } ;
 } ;
 Ax (X : U l) (d : Data.S X) : U l = Pr.isSet X * Laws[X,d].Rest ;
 ax-prop (X : U l) (d : Data.S X) : Pr.isProp (Ax X d) =
  Pr.isProp-Sigma (Pr.isSet X) (\ sX -> Laws[X,d].Rest) (isSet-prop X) (\ sX -> Laws[X,d].rest-prop sX) ;
 N : G.Notion = G.axioms Data Ax ax-prop ;
 module St = G.Over[N] ;

 -- the record of modules is St.Str
 fields (M : S.Module) : St.Str = (M.M, (M.mz, M.madd, M.mneg, M.sm), M.setM,
  (M.maddA, M.maddC, M.maddZ, M.maddN, M.smA, M.smO, M.smD, M.smE)) ;
 module Parts (B : St.Str) {
  X : U l = B.1 ; d : Data.S X = B.2.1 ; module W = Laws[X,d] ; module R = W.Of[B.2.2.2] ;
  built : S.Module = new S.Module[X,B.2.2.1,W.mz,W.madd,W.mneg,R.la,R.lc,R.lz,R.ln,W.sm,R.sa,R.so,R.sd,R.se] ;
 } ;
 mk (B : St.Str) : S.Module = Parts[B].built ;

 -- linear equivalences: an equivalence of carriers preserving the data
 LinEquiv (M P : S.Module) : U l = St.Iso (fields M) (fields P) ;
 idLin (M : S.Module) : LinEquiv M M = St.idIso (fields M) ;
 Total (M : S.Module) : U l+ = (P : S.Module) * LinEquiv M P ;
 back-eta (M : S.Module) : (P : S.Module) (phi : LinEquiv M P) -> Id (Total M) (mk (fields P), phi) (P, phi) = split {
  Module X setM mz madd mneg maddA maddC maddZ maddN sm smA smO smD smE -> \ phi ->
   refl (new S.Module[X,setM,mz,madd,mneg,maddA,maddC,maddZ,maddN,sm,smA,smO,smD,smE], phi) } ;
 total-contr (M : S.Module) : FunExtUA[l+].isContr (Total M) =
  GH.ctr-retract (St.Total (fields M)) (Total M) (St.total-contr (fields M))
   (\ c -> (fields c.1, c.2)) (\ c -> (mk c.1, c.2)) (\ c -> back-eta M c.1 c.2) ;
 opaque total-contr ;
 -- the structure identity principle for modules: Id Module M P ~ LinEquiv M P
 module Fd = G.Fundamental[S.Module,LinEquiv,idLin,total-contr] ;

 -- categorical isos and linear equivalences
 module Arr = Arrows[l+,l].Arrows[K.modules] ;
 module ToLin (M P : S.Module) (e : K.modules.Iso M P) {
  module H = L.Linear[M,P].H ;
  f : K.Hom M P = e.1 ;
  equiv : Pr.Equiv M.M P.M = (f.fn, K.underlying M P e) ;
  lin : LinEquiv M P = (equiv, H.map-zero f, f.additive, H.map-neg f, f.scalar) ;
 } ;
 module FromLin (M P : S.Module) (phi : LinEquiv M P) {
  f : K.Hom M P = new L.Linear[M,P].H.Hom[phi.1.1,phi.2.2.1,phi.2.2.2.2] ;
  iso : K.modules.Iso M P = K.FromEquiv[M,P,f,phi.1.2].iso ;
 } ;
 -- there and back: the same arrow, hence the same iso
 round (M P : S.Module) (e : K.modules.Iso M P) : Id (K.modules.Iso M P) (FromLin[M,P,ToLin[M,P,e].lin].iso) e =
  Arr.iso-eq _ _ (L.Hom[M,P].eta e.1) ;

 module Single (M : S.Module) {
  Singl : U l+ = CC.Singletons[K.modules].Singl M ;
  contractible : FunExtUA[l+].isContr Singl =
   GH.ctr-retract (Total M) Singl (total-contr M)
    (\ w -> (w.1, ToLin[M,w.1,w.2].lin)) (\ c -> (c.1, FromLin[M,c.1,c.2].iso))
    (\ w -> Hi.ap (K.modules.Iso M w.1) Singl (\ e -> (w.1, e)) _ _ (round M w.1 w.2)) ;
  proposition : Hi.isProp Singl = \ u v -> FunExtUA[l+].pathC Singl contractible u v ;
 } ;
 univalent : CC.Univalent K.modules = CC.FromTotal[K.modules,\ M -> Single[M].proposition].univalent ;
 category : CC.Category = new CC.Category[K.modules,univalent] ;
} ;
