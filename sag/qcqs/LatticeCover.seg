-- Finite covers detect inequalities and equalities in a distributive lattice.
-- If top <= join e_i, then each x is covered by x /\ e_i (meet-cover).
-- Thus x <= y if every x /\ e_i <= y (meet-below, then x <= x /\ top).
-- In particular x <= y can be tested after meeting both sides with e_i.
-- If those intersections are equal, antisymmetry gives x = y.
-- No inhabitedness of the index type is needed: the empty cover works too.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module DL = DistLattice[l] ;
module Over (M : DL.DLat) (n : Nat) (es : Fin n -> M.L)
 (covers : DL.Order[M].Le M.top (DL.Joins[M].bigJ n es)) {
 module O = DL.Order[M] ;
 module J = DL.Joins[M] ;
 covered (x : M.L) : O.Le x (J.bigJ n (\ i -> M.meet x (es i))) =
  J.meet-cover x n es (O.le-trans x M.top (J.bigJ n es) (O.le-top x) covers) ;
 below (x y : M.L) (h : (i : Fin n) -> O.Le (M.meet x (es i)) y) : O.Le x y =
  O.le-trans x (J.bigJ n (\ i -> M.meet x (es i))) y (covered x)
   (J.least n (\ i -> M.meet x (es i)) y h) ;
 local-le (x y : M.L) (h : (i : Fin n) -> O.Le (M.meet x (es i)) (M.meet y (es i))) : O.Le x y =
  below x y (\ i -> O.le-trans (M.meet x (es i)) (M.meet y (es i)) y (h i) (O.meet-left y (es i))) ;
 ext (x y : M.L) (h : (i : Fin n) -> Id M.L (M.meet x (es i)) (M.meet y (es i))) : Id M.L x y =
  O.le-antisym x y
   (local-le x y (\ i -> O.le-of-eq (M.meet x (es i)) (M.meet y (es i)) (h i)))
   (local-le y x (\ i -> O.le-of-eq (M.meet y (es i)) (M.meet x (es i)) (sym (h i)))) ;
} ;
