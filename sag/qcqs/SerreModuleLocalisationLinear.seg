-- The induced fraction map is semilinear (Serre, Section 3).
-- On two fractions with a common denominator it preserves addition by
-- additivity of the numerator map. It preserves scalar action by its
-- semilinearity. Fraction induction extends these equations to all inputs.
level l ; open Ring[l] ; open Presentations[l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module LC = SerreModuleLocalisation[l] ; module LM = SerreModuleLocalisationMaps[l] ;
module LS = SerreModuleLocalisationStructure[l] ;
module LA = SerreModuleLocalisationAction[l] ;
module Along (A B : CRing) (h : RingHom[l].Hom A B)
 (Md : SM.Over[A].Module) (Nd : SM.Over[B].Module)
 (v : MM.Between[A,B,h,Md,Nd].Hom) (f : A.R) {
 module H = MM.Between[A,B,h,Md,Nd] ;
 module Map = LM.Along[A,B,h,Md,Nd,v,f] ;
 module S = LS.At[A,Md,f] ;
 module T = LS.At[B,Nd,RingMaps[l].map h f] ;
 module SA = LA.At[A,Md,f] ;
 module TA = LA.At[B,Nd,RingMaps[l].map h f] ;
 additive (x y : S.L.Carrier) :
  Id T.L.Carrier (Map.induced (S.add x y)) (T.add (Map.induced x) (Map.induced y)) =
  S.L.pair-induction
   (\ x y -> Id T.L.Carrier (Map.induced (S.add x y)) (T.add (Map.induced x) (Map.induced y)))
   (\ x y -> T.L.carrier-set _ _)
   (\ x y p -> trans (ap Map.induced (S.add-at x y p))
    (trans (Map.fraction-map (Md.madd x y) p)
     (trans (ap (\ z -> T.L.fraction z p) (H.map-add v x y))
      (trans (sym (T.add-at (H.map v x) (H.map v y) p))
       (cong2 T.L.Carrier T.add _ _ _ _ (sym (Map.fraction-map x p)) (sym (Map.fraction-map y p))))))) x y ;
 scalar (a : A.R) (x : S.L.Carrier) :
  Id T.L.Carrier (Map.induced (SA.scale a x)) (TA.scale (RingMaps[l].map h a) (Map.induced x)) =
  S.L.induction @l
   (\ x -> Id T.L.Carrier (Map.induced (SA.scale a x)) (TA.scale (RingMaps[l].map h a) (Map.induced x)))
   (\ x -> T.L.carrier-set _ _)
   (\ x p -> trans (ap Map.induced (SA.scale-at a x p))
    (trans (Map.fraction-map (Md.sm a x) p)
     (trans (ap (\ z -> T.L.fraction z p) (H.map-scale v a x))
      (trans (sym (TA.scale-at (RingMaps[l].map h a) (H.map v x) p))
       (ap (TA.scale (RingMaps[l].map h a)) (sym (Map.fraction-map x p))))))) x ;
 module Maps = MM.Between[A,B,h,S.localised,T.localised] ;
 induced : Maps.Hom = new Maps.Hom[Map.induced,additive,scalar] ;
 induced-at (x : Md.M) (p : Nat) :
  Id T.L.Carrier (Maps.map induced (S.L.fraction x p)) (T.L.fraction (H.map v x) p) = Map.fraction-map x p ;
 opaque induced ;
} ;
