-- Extract the lattice laws from equality of actual triple-domain maps.
-- Their inverse images of b are t_jk(t_ij b) meet q and t_ik b meet q.
-- Monotonicity puts the former below q.  The domain equation and
-- t_ik b<=d_ki simplify the latter to d_kj meet t_ik b.
-- The diagonal follows by taking inverse images in h_ii=inclusion and
-- then using d_ii=top.  These are exactly FiniteTransitionLattice's laws.
level l ; open Ring[l] ; open Presentations[l] ;
module DL = DistLattice[l] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module TE = TestEquivalences[l] ;
module CO = CompactOpens[l] ;
module SP = Spaces[l] ;
module Op = OpenMaps[l] ;
module Over (F : SF.SetFunctor) (n : Nat) (us : Fin n -> CO.Over[F].Open)
 (as : Fin n -> T.Test)
 (es : (i : Fin n) -> TE.NaturalEquivalence SF.Representable[as i].functor OpenRealisation[l].Over[F,us i].functor) {
 module C = AtlasCocycle[l].Over[F,n,us,as,es] ;
 module D = C.D ;
 module G = FiniteTransitionGlue[l].Over[n,D.X,D.d].Data[D.h] ;
 identity : G.T.Identity = \ i b ->
  trans (ap (\ f -> D.Patch[i,i].S.inc (DL.hmap (SP.underlying f).lat b)) (D.identity i))
   (trans (ap ((D.X i).lattice.meet b) (D.diagonal i)) ((D.X i).lattice.meetT b)) ;
 module At (i j k : Fin n) (b : (D.X i).lattice.L) {
  module Tr = C.Triple[i,j,k] ;
  module O = Tr.O ;
  left : (D.X k).lattice.L = D.t j k (D.t i j b) ;
  right : (D.X k).lattice.L = D.t i k b ;
  below-q : O.Le left Tr.q =
   D.Patch[j,k].S.le-inc _ _
    (DL.JoinMaps[(D.X j).lattice,D.Patch[j,k].S.lattice,(SP.underlying (D.h j k)).lat].monotone
     (D.t i j b) (D.d j i) (D.below i j b)) ;
  first : Id (D.X k).lattice.L
   (Tr.SQ.inc (DL.hmap (SP.underlying Tr.P.composite).lat b)) ((D.X k).lattice.meet left Tr.q) =
   Tr.A.lattice-trace (DL.hmap (SP.underlying (D.h i j)).lat b) ;
  second : Id (D.X k).lattice.L
   (Tr.SQ.inc (DL.hmap (SP.underlying Tr.Q.C.composite).lat b)) ((D.X k).lattice.meet right Tr.q) = Tr.Q.lattice-trace b ;
  right-cut : Id (D.X k).lattice.L ((D.X k).lattice.meet right Tr.q) ((D.X k).lattice.meet (D.d k j) right) =
   trans (ap ((D.X k).lattice.meet right) D.Domain[i,j,k].equation)
    (trans ((D.X k).lattice.meetA right (D.d k i) (D.d k j))
     (trans (ap (\ a -> (D.X k).lattice.meet a (D.d k j)) (D.below i k b))
      ((D.X k).lattice.meetC right (D.d k j)))) ;
  equation : Id (D.X k).lattice.L left ((D.X k).lattice.meet (D.d k j) right) =
   trans (sym below-q) (trans (sym first)
    (trans (ap (\ f -> Tr.SQ.inc (DL.hmap (SP.underlying f).lat b)) Tr.equation)
     (trans second right-cut))) ;
 } ;
 cocycle : G.T.Cocycle = \ i j k b -> At[i,j,k,b].equation ;
 module L = G.Lattice[identity,cocycle] ;
} ;
