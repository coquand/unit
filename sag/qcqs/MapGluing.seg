-- Finite-cover gluing of maps out of a locally ringed lattice X.
-- Let e_i cover X and pi_i : X|e_i -> Y.  View each inverse image p_i(u)
-- in X.  Overlap agreement says p_i(u) /\ e_j = p_j(u) /\ e_i, and the
-- section images agree on p_i(u) /\ p_j(u).
-- LatticeDescent gives p(u) = join_i p_i(u), with p(u) /\ e_i = p_i(u).
-- For each u, SheafMaps glues the section maps into G(p(u)).  To check
-- naturality, restrict to p_i(u): res-comp, the amalgam equations and
-- naturality of pi_i give the same value.  Sheaf separation finishes.
-- The resulting map restricts to pi_i: on lattices this is intersection;
-- on sections it is the amalgam equation after res-comp.
-- Locality is checked on e_i.  Its local proof uses compatibility of
-- invertibility opens with restriction and the locality of pi_i.
-- Uniqueness is MapSeparation on the cover.  No affineness is used.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module DL = DistLattice[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module Over (L M : DL.DLat) (F : RingedLattice[l].On[L].Presheaf)
 (X : LocallyRinged[l].On[M].LocallyRinged) (n : Nat) (es : Fin n -> M.L)
 (covers : DL.Order[M].Le M.top (DL.Joins[M].bigJ n es)) {
 module OL = DL.Order[L] ;
 module O = DL.Order[M] ;
 module J = DL.Joins[M] ;
 module GO = RingedLattice[l].On[M].Of[X.sheaf] ;
 module SG = RingedLattice[l].On[M].Sheaf[X.sheaf,X.is-sheaf] ;
 module MP = LocallyRinged[l].Maps[L,M,F,X.sheaf] ;
 module Sep = MapSeparation[l].Maps[L,M,F,X] ;
 module OnPiece (i : Fin n) {
  module Sl = Slice[l].Over[M,X,es i] ;
  module MC = LocallyRinged[l].Maps[L,Sl.lattice,F,Sl.sheaf] ;
 } ;
 module Family (pis : (i : Fin n) -> OnPiece[i].MC.Ringed) {
  piece (i : Fin n) (u : L.L) : M.L = OnPiece[i].Sl.inc (DL.hmap (pis i).lat u) ;
  piece-below (i : Fin n) (u : L.L) : O.Le (piece i u) (es i) = OnPiece[i].Sl.below (DL.hmap (pis i).lat u) ;
  piece-map (i : Fin n) (u : L.L) : RH.Hom (F.ring u) (X.sheaf.ring (piece i u)) = (pis i).sharp u ;
  piece-bot (i : Fin n) : Id M.L (piece i L.bot) M.bot = ap OnPiece[i].Sl.inc (DL.hmap-bot (pis i).lat) ;
  piece-top (i : Fin n) : Id M.L (piece i L.top) (es i) = ap OnPiece[i].Sl.inc (DL.hmap-top (pis i).lat) ;
  piece-join (i : Fin n) (u v : L.L) : Id M.L (piece i (L.join u v)) (M.join (piece i u) (piece i v)) =
   ap OnPiece[i].Sl.inc (DL.hmap-join (pis i).lat u v) ;
  piece-meet (i : Fin n) (u v : L.L) : Id M.L (piece i (L.meet u v)) (M.meet (piece i u) (piece i v)) =
   ap OnPiece[i].Sl.inc (DL.hmap-meet (pis i).lat u v) ;
  piece-mono (i : Fin n) (u v : L.L) (k : OL.Le u v) : O.Le (piece i u) (piece i v) =
   OnPiece[i].Sl.le-inc (DL.hmap (pis i).lat u) (DL.hmap (pis i).lat v)
    (DL.JoinMaps[L,OnPiece[i].Sl.lattice,(pis i).lat].monotone u v k) ;
  piece-natural (i : Fin n) (u v : L.L) (k : OL.Le u v) (s : (F.ring v).R) :
   Id (X.sheaf.ring (piece i u)).R
    (GO.restrict (piece i u) (piece i v) (piece-mono i u v k) (map (piece-map i v) s))
    (map (piece-map i u) (map (F.res u v k) s)) =
   trans (sym (OnPiece[i].Sl.res-inc (DL.hmap (pis i).lat u) (DL.hmap (pis i).lat v)
     (DL.JoinMaps[L,OnPiece[i].Sl.lattice,(pis i).lat].monotone u v k) (map (piece-map i v) s))) ((pis i).natural u v k s) ;

  module Compatible
   (overlap : (i j : Fin n) (u : L.L) -> Id M.L (M.meet (piece i u) (es j)) (M.meet (piece j u) (es i)))
   (agree : (u : L.L) (s : (F.ring u).R) (i j : Fin n) ->
     Id (X.sheaf.ring (M.meet (piece i u) (piece j u))).R
      (GO.restrict (M.meet (piece i u) (piece j u)) (piece i u) (O.meet-left (piece i u) (piece j u)) (map (piece-map i u) s))
      (GO.restrict (M.meet (piece i u) (piece j u)) (piece j u) (O.meet-right (piece i u) (piece j u)) (map (piece-map j u) s))) {
   overlap-le (i j : Fin n) (u : L.L) : O.Le (M.meet (piece i u) (es j)) (piece j u) =
    O.le-trans (M.meet (piece i u) (es j)) (M.meet (piece j u) (es i)) (piece j u)
     (O.le-of-eq (M.meet (piece i u) (es j)) (M.meet (piece j u) (es i)) (overlap i j u)) (O.meet-left (piece j u) (es i)) ;
   module LD = LatticeDescent[l].Over[L,M,n,es,covers,piece,piece-below,piece-bot,piece-top,piece-join,piece-meet,overlap-le] ;
   module At (u : L.L) {
    module Lift = SheafMaps[l].Over[M,X.sheaf,X.is-sheaf,LD.image u,n,\ i -> piece i u,\ i -> LD.part-le i u,
     LD.covered u,F.ring u,\ i -> piece-map i u,agree u] ;
    module SC = SG.Cover[LD.image u,n,\ i -> piece i u,\ i -> LD.part-le i u,LD.covered u] ;
   } ;
   sharp (u : L.L) : RH.Hom (F.ring u) (X.sheaf.ring (LD.image u)) = At[u].Lift.lift ;
   matches (u : L.L) (s : (F.ring u).R) (i : Fin n) :
    Id (X.sheaf.ring (piece i u)).R (GO.restrict (piece i u) (LD.image u) (LD.part-le i u) (map (sharp u) s)) (map (piece-map i u) s) =
    At[u].Lift.lift-matches s i ;
   module Natural (u v : L.L) (k : OL.Le u v) (s : (F.ring v).R) {
    le : O.Le (LD.image u) (LD.image v) = DL.JoinMaps[L,M,LD.lat].monotone u v k ;
    common (i : Fin n) : O.Le (piece i u) (LD.image v) =
     O.le-trans (piece i u) (LD.image u) (LD.image v) (LD.part-le i u) le ;
    on-piece (i : Fin n) : Id (X.sheaf.ring (piece i u)).R
     (GO.restrict (piece i u) (LD.image u) (LD.part-le i u) (GO.restrict (LD.image u) (LD.image v) le (map (sharp v) s)))
     (GO.restrict (piece i u) (LD.image u) (LD.part-le i u) (map (sharp u) (map (F.res u v k) s))) =
     calc (X.sheaf.ring (piece i u)).R {
      GO.restrict (piece i u) (LD.image u) (LD.part-le i u) (GO.restrict (LD.image u) (LD.image v) le (map (sharp v) s))
       =< X.sheaf.res-comp (piece i u) (LD.image u) (LD.image v) (LD.part-le i u) le (common i) (map (sharp v) s)
        > GO.restrict (piece i u) (LD.image v) (common i) (map (sharp v) s)
       =< sym (X.sheaf.res-comp (piece i u) (piece i v) (LD.image v) (piece-mono i u v k) (LD.part-le i v) (common i) (map (sharp v) s))
        > GO.restrict (piece i u) (piece i v) (piece-mono i u v k) (GO.restrict (piece i v) (LD.image v) (LD.part-le i v) (map (sharp v) s))
       =< ap (GO.restrict (piece i u) (piece i v) (piece-mono i u v k)) (matches v s i)
        > GO.restrict (piece i u) (piece i v) (piece-mono i u v k) (map (piece-map i v) s)
       =< piece-natural i u v k s > map (piece-map i u) (map (F.res u v k) s)
       =< sym (matches u (map (F.res u v k) s) i) > GO.restrict (piece i u) (LD.image u) (LD.part-le i u) (map (sharp u) (map (F.res u v k) s)) } ;
    natural : Id (X.sheaf.ring (LD.image u)).R
     (GO.restrict (LD.image u) (LD.image v) le (map (sharp v) s)) (map (sharp u) (map (F.res u v k) s)) =
     At[u].SC.separated (GO.restrict (LD.image u) (LD.image v) le (map (sharp v) s)) (map (sharp u) (map (F.res u v k) s)) on-piece ;
   } ;
   morphism : MP.Ringed = new MP.Ringed[LD.lat,sharp,\ u v k s -> Natural[u,v,k,s].natural] ;

   -- the constructed map has the prescribed restrictions
   module Restricts (i : Fin n) {
    module Sl = OnPiece[i].Sl ;
    module EQ = MapEquality[l].Maps[L,Sl.lattice,F,Sl.sheaf] ;
    module CT = Sep.Cut[es i] ;
    lat-eq (u : L.L) : Id Sl.Opens (DL.hmap (CT.restrict morphism).lat u) (DL.hmap (pis i).lat u) =
     Sl.ext (DL.hmap (CT.restrict morphism).lat u) (DL.hmap (pis i).lat u) (LD.intersection u i) ;
    le (u : L.L) : Sl.OS.Le (DL.hmap (pis i).lat u) (DL.hmap (CT.restrict morphism).lat u) =
     Sl.le-in (DL.hmap (pis i).lat u) (DL.hmap (CT.restrict morphism).lat u)
      (O.meet-glb (LD.image u) (es i) (piece i u) (LD.part-le i u) (piece-below i u)) ;
    sharp-eq (u : L.L) (s : (F.ring u).R) :
     Id (Sl.sheaf.ring (DL.hmap (pis i).lat u)).R
      (Sl.SO.restrict (DL.hmap (pis i).lat u) (DL.hmap (CT.restrict morphism).lat u) (le u) (map ((CT.restrict morphism).sharp u) s))
      (map ((pis i).sharp u) s) =
     trans (Sl.res-inc (DL.hmap (pis i).lat u) (DL.hmap (CT.restrict morphism).lat u) (le u) (map ((CT.restrict morphism).sharp u) s))
      (trans (ap (GO.restrict (piece i u) (M.meet (LD.image u) (es i))
        (Sl.le-inc (DL.hmap (pis i).lat u) (DL.hmap (CT.restrict morphism).lat u) (le u)))
       (CT.C.Of[Sl.inclusion,morphism].sharp-map u s))
       (trans (X.sheaf.res-comp (piece i u) (M.meet (LD.image u) (es i)) (LD.image u)
         (Sl.le-inc (DL.hmap (pis i).lat u) (DL.hmap (CT.restrict morphism).lat u) (le u)) (O.meet-left (LD.image u) (es i))
         (LD.part-le i u) (map (sharp u) s)) (matches u s i))) ;
    restricts : Id OnPiece[i].MC.Ringed (CT.restrict morphism) (pis i) = EQ.ext (CT.restrict morphism) (pis i) lat-eq le sharp-eq ;
   } ;
   unique (pi : MP.Ringed) (on : (i : Fin n) -> Id OnPiece[i].MC.Ringed (Sep.Cut[es i].restrict pi) (pis i)) : Id MP.Ringed pi morphism =
    Sep.Cover[n,es,covers].separated pi morphism (\ i -> trans (on i) (sym Restricts[i].restricts)) ;

   -- amalgams form a contractible type, since their matching laws are propositions
   Matches (pi : MP.Ringed) : U l =
    (i : Fin n) -> Id OnPiece[i].MC.Ringed (Sep.Cut[es i].restrict pi) (pis i) ;
   matches-prop (pi : MP.Ringed) : Pr.isProp (Matches pi) =
    FE.isProp-Pi (Fin n) (\ i -> Id OnPiece[i].MC.Ringed (Sep.Cut[es i].restrict pi) (pis i)) (\ i ->
     MapEquality[l].Maps[L,OnPiece[i].Sl.lattice,F,OnPiece[i].Sl.sheaf].set (Sep.Cut[es i].restrict pi) (pis i)) ;
   Amalgam : U l = (pi : MP.Ringed) * Matches pi ;
   centre : Amalgam = (morphism,\ i -> Restricts[i].restricts) ;
   contract (a : Amalgam) : Id Amalgam centre a =
    Pr.Sigma-eq MP.Ringed Matches morphism a.1 (\ i -> Restricts[i].restricts) a.2 (sym (unique a.1 a.2)) (matches-prop a.1) ;
   gluing : Localisation[l].isContr Amalgam = (centre,contract) ;

   -- invertibility support can be checked on the cover
   module Local (DF : InvOpen[l].On[L].Of[F].InvMap)
    (locals : (i : Fin n) -> OnPiece[i].MC.Of[pis i,DF,OnPiece[i].Sl.inv].IsLocal) {
    module LF = LocallyRinged[l].On[L].Laws[F,DF] ;
    module LX = LocallyRinged[l].On[M].Laws[X.sheaf,X.inv] ;
    module IX = InvOpen[l].On[M].Of[X.sheaf] ;
    module LC = LatticeCover[l].Over[M,n,es,covers] ;
    module AtLocal (u : L.L) (s : (F.ring u).R) {
     piece-local (i : Fin n) : O.Le (LX.d (piece i u) (map (piece-map i u) s)) (piece i (LF.d u s)) =
      Pr.subst M.L (\ v -> O.Le v (piece i (LF.d u s)))
       (OnPiece[i].Sl.inc (OnPiece[i].Sl.LS.d (DL.hmap (pis i).lat u) (map ((pis i).sharp u) s)))
       (LX.d (piece i u) (map (piece-map i u) s))
       (OnPiece[i].Sl.d-inc (DL.hmap (pis i).lat u) (map ((pis i).sharp u) s))
       (OnPiece[i].Sl.le-inc (OnPiece[i].Sl.LS.d (DL.hmap (pis i).lat u) (map ((pis i).sharp u) s))
        (DL.hmap (pis i).lat (LF.d u s)) (locals i u s)) ;
     restricted-d (i : Fin n) :
      Id M.L (M.meet (piece i u) (LX.d (LD.image u) (map (sharp u) s))) (LX.d (piece i u) (map (piece-map i u) s)) =
      trans (sym (IX.Restrict[LD.image u,piece i u,LD.part-le i u,map (sharp u) s,
        LX.d (LD.image u) (map (sharp u) s),LX.d-open (LD.image u) (map (sharp u) s)].restrict-eq
         (LX.d (piece i u) (GO.restrict (piece i u) (LD.image u) (LD.part-le i u) (map (sharp u) s)))
         (LX.d-open (piece i u) (GO.restrict (piece i u) (LD.image u) (LD.part-le i u) (map (sharp u) s)))))
       (ap (LX.d (piece i u)) (matches u s i)) ;
     below-piece (i : Fin n) : O.Le (M.meet (LX.d (LD.image u) (map (sharp u) s)) (es i)) (piece i u) =
      O.le-trans (M.meet (LX.d (LD.image u) (map (sharp u) s)) (es i)) (M.meet (LD.image u) (es i)) (piece i u)
       (O.meet-mono (LX.d (LD.image u) (map (sharp u) s)) (es i) (LD.image u) (es i)
        (IX.below (LX.d-open (LD.image u) (map (sharp u) s))) (O.le-refl (es i)))
       (O.le-of-eq (M.meet (LD.image u) (es i)) (piece i u) (LD.intersection u i)) ;
     on-piece (i : Fin n) : O.Le (M.meet (LX.d (LD.image u) (map (sharp u) s)) (es i)) (LD.image (LF.d u s)) =
      O.le-trans (M.meet (LX.d (LD.image u) (map (sharp u) s)) (es i))
       (M.meet (piece i u) (LX.d (LD.image u) (map (sharp u) s))) (LD.image (LF.d u s))
       (O.meet-glb (piece i u) (LX.d (LD.image u) (map (sharp u) s))
        (M.meet (LX.d (LD.image u) (map (sharp u) s)) (es i)) (below-piece i)
        (O.meet-left (LX.d (LD.image u) (map (sharp u) s)) (es i)))
       (O.le-trans (M.meet (piece i u) (LX.d (LD.image u) (map (sharp u) s)))
        (LX.d (piece i u) (map (piece-map i u) s)) (LD.image (LF.d u s))
        (O.le-of-eq (M.meet (piece i u) (LX.d (LD.image u) (map (sharp u) s)))
         (LX.d (piece i u) (map (piece-map i u) s)) (restricted-d i))
        (O.le-trans (LX.d (piece i u) (map (piece-map i u) s)) (piece i (LF.d u s)) (LD.image (LF.d u s))
         (piece-local i) (LD.part-le i (LF.d u s)))) ;
    } ;
    local : MP.Of[morphism,DF,X.inv].IsLocal = \ u s ->
     LC.below (LX.d (LD.image u) (map (sharp u) s)) (LD.image (LF.d u s)) AtLocal[u,s].on-piece ;
    module EL = MapEquality[l].Maps[L,M,F,X.sheaf].Local[DF,X.inv] ;
    LocalAmalgam : U l = (pi : EL.LocalMap) * Matches pi.1 ;
    local-centre : LocalAmalgam = ((morphism,local),\ i -> Restricts[i].restricts) ;
    local-contract (a : LocalAmalgam) : Id LocalAmalgam local-centre a =
     Pr.Sigma-eq EL.LocalMap (\ pi -> Matches pi.1) (morphism,local) a.1 (\ i -> Restricts[i].restricts) a.2
      (EL.local-ext (morphism,local) a.1 (sym (unique a.1.1 a.2))) (matches-prop a.1.1) ;
    local-gluing : Localisation[l].isContr LocalAmalgam = (local-centre,local-contract) ;
   } ;
  } ;
 } ;
} ;
