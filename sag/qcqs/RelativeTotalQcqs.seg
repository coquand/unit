-- A native relative qcqs functor has absolute qcqs totalisation (§4).
-- An affine witness h^k_A~=F totalises to an equivalence.  Compose with
-- the inverse of RelativeTotalAffine to obtain an ordinary affine witness.
-- For a chart realisation also compose RelativeRealisationTotal.
-- Cover values are the same values at the named total point, so covers
-- totalise pointwise.  Eliminate affine witnesses into affineness and the
-- atlas into HasAtlas, both propositions.  RelativeTotalSheaf supplies
-- the independent sheaf part.  No affine witnesses are chosen globally.
level l ; open Ring[l] ; open Presentations[l] ;
module Tr = Truncation[l+] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module TE = TestEquivalences[l] ;
module QF = FunctorialQcqs[l] ;
module Over (K : T.Test) {
 module RQ = RelativeQcqs[l].Over[K] ;
 module AffineWitness (F : RQ.R.SetFunctor) (w : RQ.AffineWitness F) {
  module A = RelativeTotalAffine[l].Over[K,w.1] ;
  module AI = TE.Inverse[A.TR.functor,A.H.functor,A.equivalence] ;
  module M = RelativeTotalMaps[l].Over[K,RQ.R.Representable[w.1].functor,F].Equivalence[w.2] ;
  witness : QF.AffineWitness RelativeTotal[l].Over[K,F].functor =
   (RQ.R.BP.test w.1,TE.Composite[A.H.functor,A.TR.functor,RelativeTotal[l].Over[K,F].functor,AI.inverse-equiv,M.equivalence].equivalence) ;
 } ;
 module At (F : RQ.R.SetFunctor) {
  module Q = RQ.At[F] ;
  module TF = RelativeTotal[l].Over[K,F] ;
  module AQ = QF.Over[TF.functor] ;
  module FromCover (c : Q.AffineCover) {
   module Part (i : Fin c.count) {
    module RR = RelativeRealisationTotal[l].Over[K,F,c.opens i] ;
    witness (w : RQ.AffineWitness RR.RO.functor) : QF.AffineWitness RR.R.functor =
     (RQ.R.BP.test w.1,TE.Composite[SF.Representable[RQ.R.BP.test w.1].functor,RR.TR.functor,RR.R.functor,
      AffineWitness[RR.RO.functor,w].witness.2,RR.equivalence].equivalence) ;
    affine : QF.IsAffine RR.R.functor = Tr.Trunc[RQ.AffineWitness RR.RO.functor].induction @(l+)
     (\ t -> QF.IsAffine RR.R.functor) (\ t -> Tr.Trunc[QF.AffineWitness RR.R.functor].proposition)
     (\ w -> Tr.Trunc[QF.AffineWitness RR.R.functor].inc (witness w)) (c.affine i) ;
   } ;
   cover : AQ.AffineCover = struct {
    count = c.count ; opens = \ i -> Q.O.to-total (c.opens i) ;
    covers = \ B p -> c.covers (RQ.R.BP.algebra B (TF.At[B].base p)) (TF.At[B].value p) ;
    affine = \ i -> Part[i].affine } ;
  } ;
  has-atlas (a : Q.HasAtlas) : AQ.HasAtlas = Tr.Trunc[Q.AffineCover].induction @(l+)
   (\ t -> AQ.HasAtlas) (\ t -> Tr.Trunc[AQ.AffineCover].proposition)
   (\ c -> Tr.Trunc[AQ.AffineCover].inc FromCover[c].cover) a ;
  qcqs (q : Q.IsQcqs) : AQ.IsQcqs = (RelativeTotalSheaf[l].Over[K,F,q.1].is-sheaf,has-atlas q.2) ;
 } ;
} ;
