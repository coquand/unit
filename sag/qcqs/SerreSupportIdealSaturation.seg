-- Saturated submodule sheaves and the canonical localisation map
-- (Serre note, Sections 7 and 8).
-- Let iota : S -> E be a natural linear map, injective on every open (a
-- submodule sheaf), a an open, g in O(a), and a_g = D_a(g).  S is
-- saturated at (a, g) when every x in E(a) with x|a_g in S(a_g) has
-- merely some e with g^e x in S(a).
-- Lemma (saturation).  If lambda^E_(a,g) is an equivalence and S is
-- saturated at (a, g), then lambda^S_(a,g) is an equivalence.
-- Proof.  lambda_(a,g) is an equivalence iff restriction to a_g clears
-- and kills at g (SerreLambdaClearing).  E's restriction does both.
--  Kill for S: if x|a_g = 0 then (iota x)|a_g = iota(x|a_g) = 0, so
--   g^r iota x = iota(g^r x) = 0 for some r, and g^r x = 0 (iota injective).
--  Clear for S: for y in S(a_g), merely x|a_g = g^r iota y = iota(g^r y)
--   with x in E(a); by saturation g^e x = iota z with z in S(a); then
--   iota(z|a_g) = (g^e x)|a_g = g^e g^r iota y = iota(g^(e+r) y), so
--   z|a_g = g^(e+r) y (iota injective).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module DL = DistLattice[l] ;
module RH = RingHom[l] ; module RM = RingMaps[l] ;
module MS = SerreModuleSheaf[l] ;
module On (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged)
 (S E : MS.On[L,X.sheaf].ModuleSheaf)
 (iota : MS.On[L,X.sheaf].Transform[S.presheaf,E.presheaf].Hom)
 (injective : (a : L.L) (x y : (S.presheaf.module-at a).M) ->
  Id (E.presheaf.module-at a).M (MS.On[L,X.sheaf].Transform[S.presheaf,E.presheaf].at iota a x)
   (MS.On[L,X.sheaf].Transform[S.presheaf,E.presheaf].at iota a y) -> Id (S.presheaf.module-at a).M x y)
 (a : L.L) (g : (X.sheaf.ring a).R) {
 module I = MS.On[L,X.sheaf].Transform[S.presheaf,E.presheaf] ;
 module SO = MS.On[L,X.sheaf].Of[S.presheaf] ;
 module EO = MS.On[L,X.sheaf].Of[E.presheaf] ;
 module SC = SerreLambdaClearing[l].On[L,X,S,a,g] ;
 module EC = SerreLambdaClearing[l].On[L,X,E,a,g] ;
 module AP = AffinePowers[l].Over[X.sheaf.ring a] ;
 ag : L.L = SC.Lam.open-g ;
 below : DL.Order[L].Le ag a = SC.Lam.below ;
 -- the scalar g^r acting on sections over a_g
 gr (r : Nat) : (X.sheaf.ring ag).R = RM.map SC.C.ring-map (AP.power g r) ;
 -- x|a_g in S(a_g) gives merely g^e x in S(a)
 Saturated : U l = (x : (E.presheaf.module-at a).M) (y : (S.presheaf.module-at ag).M) ->
  Id (E.presheaf.module-at ag).M (I.at iota ag y) (EO.restrict ag a below x) ->
  Tr.Trunc[(e : Nat) * (z : (S.presheaf.module-at a).M)
   * Id (E.presheaf.module-at a).M (I.at iota a z) ((E.presheaf.module-at a).sm (AP.power g e) x)].carrier ;
 -- the restrictions, as the linear maps of SerreLambdaClearing
 s-restrict (x : (S.presheaf.module-at a).M) : Id (S.presheaf.module-at ag).M (SC.E.H.map SC.C.original x) (SO.restrict ag a below x) =
  SC.C.original-at x ;
 e-restrict (x : (E.presheaf.module-at a).M) : Id (E.presheaf.module-at ag).M (EC.E.H.map EC.C.original x) (EO.restrict ag a below x) =
  EC.C.original-at x ;
 -- iota commutes with restriction to a_g
 iota-restrict (x : (S.presheaf.module-at a).M) :
  Id (E.presheaf.module-at ag).M (I.at iota ag (SC.E.H.map SC.C.original x)) (EC.E.H.map EC.C.original (I.at iota a x)) = calc (E.presheaf.module-at ag).M {
  I.at iota ag (SC.E.H.map SC.C.original x)
   =< ap (I.at iota ag) (s-restrict x) > I.at iota ag (SO.restrict ag a below x)
   =< iota.natural ag a below x > EO.restrict ag a below (I.at iota a x)
   =< sym (e-restrict (I.at iota a x)) > EC.E.H.map EC.C.original (I.at iota a x) } ;
 module Given (equiv : EC.Lam.IsEquivalence) (saturated : Saturated) {
  module EE = EC.Elementary[equiv] ;
  -- kill
  module Killing (x : (S.presheaf.module-at a).M) (w : EC.E.Killing (I.at iota a x)) {
   killed : Id (S.presheaf.module-at a).M ((S.presheaf.module-at a).sm (AP.power g w.1) x) (S.presheaf.module-at a).mz =
    injective a _ _ (trans (I.at-scale iota a (AP.power g w.1) x) (trans w.2 (sym (I.at-zero iota a)))) ;
   killing : SC.E.Killing x = (w.1,killed) ;
  } ;
  e-zero (x : (S.presheaf.module-at a).M) (zero-res : Id (S.presheaf.module-at ag).M (SC.E.H.map SC.C.original x) (S.presheaf.module-at ag).mz) :
   Id (E.presheaf.module-at ag).M (EC.E.H.map EC.C.original (I.at iota a x)) (E.presheaf.module-at ag).mz =
   trans (sym (iota-restrict x)) (trans (ap (I.at iota ag) zero-res) (I.at-zero iota ag)) ;
  kill : SC.E.Kill = \ x zero-res ->
   Tr.Trunc[EC.E.Killing (I.at iota a x)].induction @l (\ t -> Tr.Trunc[SC.E.Killing x].carrier)
    (\ t -> Tr.Trunc[SC.E.Killing x].proposition)
    (\ w -> Tr.Trunc[SC.E.Killing x].inc Killing[x,w].killing)
    (EE.kill (I.at iota a x) (e-zero x zero-res)) ;
  -- clear
  module Clearing (y : (S.presheaf.module-at ag).M) (c : EC.E.Clearing (I.at iota ag y)) {
   r : Nat = c.1 ;
   x : (E.presheaf.module-at a).M = c.2.1 ;
   -- x|a_g = g^r iota y = iota(g^r y)
   in-s : Id (E.presheaf.module-at ag).M (I.at iota ag ((S.presheaf.module-at ag).sm (gr r) y)) (EO.restrict ag a below x) =
    calc (E.presheaf.module-at ag).M {
     I.at iota ag ((S.presheaf.module-at ag).sm (gr r) y)
      =< I.at-scale iota ag (gr r) y > (E.presheaf.module-at ag).sm (gr r) (I.at iota ag y)
      =< sym c.2.2 > EC.E.H.map EC.C.original x
      =< e-restrict x > EO.restrict ag a below x } ;
   module Moved (e : Nat) (z : (S.presheaf.module-at a).M)
    (ez : Id (E.presheaf.module-at a).M (I.at iota a z) ((E.presheaf.module-at a).sm (AP.power g e) x)) {
    -- g^e g^r = g^(e+r) on a_g
    exponents : Id (X.sheaf.ring ag).R ((X.sheaf.ring ag).mul (gr e) (gr r)) (gr (plus e r)) =
     trans (sym (RM.map-mul SC.C.ring-map (AP.power g e) (AP.power g r)))
      (ap (RM.map SC.C.ring-map) (sym (AP.power-add g e r))) ;
    moved : Id (S.presheaf.module-at ag).M (SC.E.H.map SC.C.original z) ((S.presheaf.module-at ag).sm (gr (plus e r)) y) =
     injective ag _ _ (calc (E.presheaf.module-at ag).M {
      I.at iota ag (SC.E.H.map SC.C.original z)
       =< iota-restrict z > EC.E.H.map EC.C.original (I.at iota a z)
       =< ap (EC.E.H.map EC.C.original) ez > EC.E.H.map EC.C.original ((E.presheaf.module-at a).sm (AP.power g e) x)
       =< EC.E.H.map-scale EC.C.original (AP.power g e) x > (E.presheaf.module-at ag).sm (gr e) (EC.E.H.map EC.C.original x)
       =< ap ((E.presheaf.module-at ag).sm (gr e)) c.2.2 > (E.presheaf.module-at ag).sm (gr e) ((E.presheaf.module-at ag).sm (gr r) (I.at iota ag y))
       =< (E.presheaf.module-at ag).smA (gr e) (gr r) (I.at iota ag y)
       > (E.presheaf.module-at ag).sm ((X.sheaf.ring ag).mul (gr e) (gr r)) (I.at iota ag y)
       =< ap (\ t -> (E.presheaf.module-at ag).sm t (I.at iota ag y)) exponents > (E.presheaf.module-at ag).sm (gr (plus e r)) (I.at iota ag y)
       =< sym (I.at-scale iota ag (gr (plus e r)) y) > I.at iota ag ((S.presheaf.module-at ag).sm (gr (plus e r)) y) }) ;
    clearing : SC.E.Clearing y = (plus e r,z,moved) ;
   } ;
   clearing : Tr.Trunc[SC.E.Clearing y].carrier =
    Tr.Trunc[(e : Nat) * (z : (S.presheaf.module-at a).M)
     * Id (E.presheaf.module-at a).M (I.at iota a z) ((E.presheaf.module-at a).sm (AP.power g e) x)].induction @l
     (\ t -> Tr.Trunc[SC.E.Clearing y].carrier) (\ t -> Tr.Trunc[SC.E.Clearing y].proposition)
     (\ w -> Tr.Trunc[SC.E.Clearing y].inc Moved[w.1,w.2.1,w.2.2].clearing)
     (saturated x ((S.presheaf.module-at ag).sm (gr r) y) in-s) ;
  } ;
  clear : SC.E.Clear = \ y ->
   Tr.Trunc[EC.E.Clearing (I.at iota ag y)].induction @l (\ t -> Tr.Trunc[SC.E.Clearing y].carrier)
    (\ t -> Tr.Trunc[SC.E.Clearing y].proposition) (\ c -> Clearing[y,c].clearing) (EE.clear (I.at iota ag y)) ;
  equivalence : SC.Lam.IsEquivalence = SC.equivalence clear kill ;
 } ;
} ;
