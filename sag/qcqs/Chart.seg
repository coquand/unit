-- The first chart of a doubling is the original locally ringed lattice
-- (DESIGN.md, step 4, Next 3; DOUBLE-ORIGIN.md), stated concretely.
--
-- Let X = (L, O, D) be locally ringed, d in L, and X2 its doubling along d
-- (Doubling).  Put e = (top, d) and iota u = (u, u /\ d).
-- Lattice.  iota preserves joins and meets ((u \/ v) /\ d =
--  (u /\ d) \/ (v /\ d); (u /\ v) /\ d = (u /\ d) /\ (v /\ d)), is monotone,
--  lands below e, and every x <= e is iota (first x): second x <= d, so
--  second x = second x /\ d = first x /\ d.  So iota is an isomorphism of
--  L onto the opens below e, with inverse first.
-- Rings.  mid (iota u) = u /\ d = second (iota u), so the sections over
--  iota u are the pairs (s, t) with s|(u /\ d) = t.  The map
--  to s = (s, s|(u /\ d)) is a ring map (FibreProduct.Lift, with the
--  identity and the restriction) with inverse left: left (to s) = s by
--  definition, and to (left z) = z since right z = (right z)|mid =
--  (left z)|mid.  It commutes with restriction: on the first component by
--  definition (and independence of the witness), on the second both sides
--  are s|(v /\ d).
-- Invertibility.  D2 (to s) = (D_u s, D_(u /\ d)(s|(u /\ d))), and
--  D_(u /\ d)(s|(u /\ d)) = (u /\ d) /\ D_u s (InvOpen.Restrict and
--  uniqueness) = D_u s /\ d (DoubleLattice.restrict-d); so
--  D2 (to s) = iota (D_u s).
-- The second chart.  e2 = (d, top), iota2 u = (u /\ d, u), with the same
--  proofs on the other component.  Here mid (iota2 u) = (u /\ d) /\ d,
--  equal to u /\ d but not by definition, so the inverse goes through it:
--  for a pair (a, s), a = (a|mid)|(u /\ d) = (s|mid)|(u /\ d) = s|(u /\ d).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;
module Over (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged) (d : L.L) {
 module O = DL.Order[L] ;
 module Dbl = Doubling[l].Over[L,X,d] ;
 module DD = Dbl.DD ;
 module OD = DD.OD ;
 module GO = Dbl.GO ;
 module IX = Dbl.IX ;
 module LX = Dbl.LX ;

 -- the lattice
 e : DD.Opens = DD.pair L.top d (trans (O.top-meet d) (sym (O.meet-idem d))) ;
 iota (u : L.L) : DD.Opens = DD.pair u (L.meet u d) (sym (DD.meet-d-twice u)) ;
 iota-join (u v : L.L) : Id DD.Opens (iota (L.join u v)) (DD.joinD (iota u) (iota v)) =
  DD.ext (iota (L.join u v)) (DD.joinD (iota u) (iota v)) (refl (L.join u v)) (DD.join-d u v) ;
 iota-meet (u v : L.L) : Id DD.Opens (iota (L.meet u v)) (DD.meetD (iota u) (iota v)) =
  DD.ext (iota (L.meet u v)) (DD.meetD (iota u) (iota v)) (refl (L.meet u v)) (DD.meet-d u v) ;
 iota-le (u v : L.L) (k : O.Le u v) : OD.Le (iota u) (iota v) =
  DD.le-pair (iota u) (iota v) k (O.meet-mono u d v d k (O.le-refl d)) ;
 iota-below (u : L.L) : OD.Le (iota u) e = DD.le-pair (iota u) e (O.le-top u) (O.meet-right u d) ;
 iota-first (x : DD.Opens) (k : OD.Le x e) : Id DD.Opens (iota (DD.first x)) x =
  DD.ext (iota (DD.first x)) x (refl (DD.first x)) (trans (DD.overlap x) (DD.le-second x e k)) ;

 -- the rings: O(u) is the ring of sections over iota u
 module At (u : L.L) {
  module P = Dbl.At[iota u].P ;
  -- s|(u /\ d), the second component of to s
  down : RH.Hom (X.sheaf.ring u) (X.sheaf.ring (L.meet u d)) = X.sheaf.res (L.meet u d) u (O.meet-left u d) ;
  agrees (s : (X.sheaf.ring u).R) : P.Agree (map (RH.identity (X.sheaf.ring u)) s) (map down s) =
   sym (X.sheaf.res-comp (L.meet u d) (L.meet u d) u (DD.mid-second (iota u)) (O.meet-left u d) (O.meet-left u d) s) ;
  to : RH.Hom (X.sheaf.ring u) (Dbl.ring (iota u)) = P.Lift[X.sheaf.ring u,RH.identity (X.sheaf.ring u),down,agrees].lift ;
  -- the components of to s, by definition
  left-to (s : (X.sheaf.ring u).R) : Id (X.sheaf.ring u).R (Dbl.left (iota u) (map to s)) s = refl s ;
  right-to (s : (X.sheaf.ring u).R) :
   Id (X.sheaf.ring (L.meet u d)).R (Dbl.right (iota u) (map to s)) (GO.restrict (L.meet u d) u (O.meet-left u d) s) =
   refl (GO.restrict (L.meet u d) u (O.meet-left u d) s) ;
  -- the inverse is the first component
  to-left (z : (Dbl.ring (iota u)).R) : Id (Dbl.ring (iota u)).R (map to (Dbl.left (iota u) z)) z =
   Dbl.ext (iota u) (map to (Dbl.left (iota u) z)) z (refl (Dbl.left (iota u) z))
    (trans (Dbl.agree (iota u) z) (X.sheaf.res-id (L.meet u d) (DD.mid-second (iota u)) (Dbl.right (iota u) z))) ;
 } ;
 to (u : L.L) : RH.Hom (X.sheaf.ring u) (Dbl.ring (iota u)) = At[u].to ;
 -- to commutes with restriction
 natural (v u : L.L) (k : O.Le v u) (s : (X.sheaf.ring u).R) :
  Id (Dbl.ring (iota v)).R (map (Dbl.res (iota v) (iota u) (iota-le v u k)) (map (to u) s)) (map (to v) (GO.restrict v u k s)) =
  Dbl.ext (iota v) (map (Dbl.res (iota v) (iota u) (iota-le v u k)) (map (to u) s)) (map (to v) (GO.restrict v u k s))
   (GO.res-irr v u (Dbl.Res[iota v,iota u,iota-le v u k].k1) k s)
   (trans (X.sheaf.res-comp (L.meet v d) (L.meet u d) u (Dbl.Res[iota v,iota u,iota-le v u k].k2) (O.meet-left u d)
      (O.le-trans (L.meet v d) v u (O.meet-left v d) k) s)
    (sym (X.sheaf.res-comp (L.meet v d) v u (O.meet-left v d) k (O.le-trans (L.meet v d) v u (O.meet-left v d) k) s))) ;
 -- to carries invertibility opens to invertibility opens
 inv-second (u : L.L) (s : (X.sheaf.ring u).R) :
  Id L.L (LX.d (L.meet u d) (GO.restrict (L.meet u d) u (O.meet-left u d) s)) (L.meet (LX.d u s) d) =
  trans (IX.unique (LX.d-open (L.meet u d) (GO.restrict (L.meet u d) u (O.meet-left u d) s))
     (IX.Restrict[u,L.meet u d,O.meet-left u d,s,LX.d u s,LX.d-open u s].restrict))
   (DD.restrict-d u (LX.d u s) (IX.below (LX.d-open u s))) ;
 inv-to (u : L.L) (s : (X.sheaf.ring u).R) : Id DD.Opens (Dbl.L2.d (iota u) (map (to u) s)) (iota (LX.d u s)) =
  DD.ext (Dbl.L2.d (iota u) (map (to u) s)) (iota (LX.d u s))
   (Dbl.d-first (iota u) (map (to u) s)) (trans (Dbl.d-second (iota u) (map (to u) s)) (inv-second u s)) ;

 -- the second chart
 e2 : DD.Opens = DD.pair d L.top (trans (O.meet-idem d) (sym (O.top-meet d))) ;
 iota2 (u : L.L) : DD.Opens = DD.pair (L.meet u d) u (DD.meet-d-twice u) ;
 iota2-join (u v : L.L) : Id DD.Opens (iota2 (L.join u v)) (DD.joinD (iota2 u) (iota2 v)) =
  DD.ext (iota2 (L.join u v)) (DD.joinD (iota2 u) (iota2 v)) (DD.join-d u v) (refl (L.join u v)) ;
 iota2-meet (u v : L.L) : Id DD.Opens (iota2 (L.meet u v)) (DD.meetD (iota2 u) (iota2 v)) =
  DD.ext (iota2 (L.meet u v)) (DD.meetD (iota2 u) (iota2 v)) (DD.meet-d u v) (refl (L.meet u v)) ;
 iota2-le (u v : L.L) (k : O.Le u v) : OD.Le (iota2 u) (iota2 v) =
  DD.le-pair (iota2 u) (iota2 v) (O.meet-mono u d v d k (O.le-refl d)) k ;
 iota2-below (u : L.L) : OD.Le (iota2 u) e2 = DD.le-pair (iota2 u) e2 (O.meet-right u d) (O.le-top u) ;
 iota2-second (x : DD.Opens) (k : OD.Le x e2) : Id DD.Opens (iota2 (DD.second x)) x =
  DD.ext (iota2 (DD.second x)) x (trans (sym (DD.overlap x)) (DD.le-first x e2 k)) (refl (DD.second x)) ;

 module At2 (u : L.L) {
  module P = Dbl.At[iota2 u].P ;
  -- u /\ d <= mid (iota2 u) = (u /\ d) /\ d
  up : O.Le (L.meet u d) (DD.mid (iota2 u)) = O.le-of-eq (L.meet u d) (DD.mid (iota2 u)) (sym (DD.meet-d-twice u)) ;
  agrees (s : (X.sheaf.ring u).R) : P.Agree (map (At[u].down) s) (map (RH.identity (X.sheaf.ring u)) s) =
   X.sheaf.res-comp (DD.mid (iota2 u)) (L.meet u d) u (DD.mid-first (iota2 u)) (O.meet-left u d) (DD.mid-second (iota2 u)) s ;
  to-pair : RH.Hom (X.sheaf.ring u) (Dbl.ring (iota2 u)) = P.Lift[X.sheaf.ring u,At[u].down,RH.identity (X.sheaf.ring u),agrees].lift ;
  -- the components of to s, by definition
  left-to (s : (X.sheaf.ring u).R) :
   Id (X.sheaf.ring (L.meet u d)).R (Dbl.left (iota2 u) (map to-pair s)) (GO.restrict (L.meet u d) u (O.meet-left u d) s) =
   refl (GO.restrict (L.meet u d) u (O.meet-left u d) s) ;
  right-to (s : (X.sheaf.ring u).R) : Id (X.sheaf.ring u).R (Dbl.right (iota2 u) (map to-pair s)) s = refl s ;
  -- the inverse is the second component
  to-right (z : (Dbl.ring (iota2 u)).R) : Id (Dbl.ring (iota2 u)).R (map to-pair (Dbl.right (iota2 u) z)) z =
   Dbl.ext (iota2 u) (map to-pair (Dbl.right (iota2 u) z)) z (calc (X.sheaf.ring (L.meet u d)).R {
    GO.restrict (L.meet u d) u (O.meet-left u d) (Dbl.right (iota2 u) z)
     =< sym (X.sheaf.res-comp (L.meet u d) (DD.mid (iota2 u)) u up (DD.mid-second (iota2 u)) (O.meet-left u d) (Dbl.right (iota2 u) z))
     > GO.restrict (L.meet u d) (DD.mid (iota2 u)) up (GO.restrict (DD.mid (iota2 u)) u (DD.mid-second (iota2 u)) (Dbl.right (iota2 u) z))
     =< ap (GO.restrict (L.meet u d) (DD.mid (iota2 u)) up) (sym (Dbl.agree (iota2 u) z))
     > GO.restrict (L.meet u d) (DD.mid (iota2 u)) up (GO.restrict (DD.mid (iota2 u)) (L.meet u d) (DD.mid-first (iota2 u)) (Dbl.left (iota2 u) z))
     =< X.sheaf.res-comp (L.meet u d) (DD.mid (iota2 u)) (L.meet u d) up (DD.mid-first (iota2 u)) (O.le-refl (L.meet u d)) (Dbl.left (iota2 u) z)
     > GO.restrict (L.meet u d) (L.meet u d) (O.le-refl (L.meet u d)) (Dbl.left (iota2 u) z)
     =< X.sheaf.res-id (L.meet u d) (O.le-refl (L.meet u d)) (Dbl.left (iota2 u) z) > Dbl.left (iota2 u) z })
    (refl (Dbl.right (iota2 u) z)) ;
 } ;
 to2 (u : L.L) : RH.Hom (X.sheaf.ring u) (Dbl.ring (iota2 u)) = At2[u].to-pair ;
 natural2 (v u : L.L) (k : O.Le v u) (s : (X.sheaf.ring u).R) :
  Id (Dbl.ring (iota2 v)).R (map (Dbl.res (iota2 v) (iota2 u) (iota2-le v u k)) (map (to2 u) s)) (map (to2 v) (GO.restrict v u k s)) =
  Dbl.ext (iota2 v) (map (Dbl.res (iota2 v) (iota2 u) (iota2-le v u k)) (map (to2 u) s)) (map (to2 v) (GO.restrict v u k s))
   (trans (X.sheaf.res-comp (L.meet v d) (L.meet u d) u (Dbl.Res[iota2 v,iota2 u,iota2-le v u k].k1) (O.meet-left u d)
      (O.le-trans (L.meet v d) v u (O.meet-left v d) k) s)
    (sym (X.sheaf.res-comp (L.meet v d) v u (O.meet-left v d) k (O.le-trans (L.meet v d) v u (O.meet-left v d) k) s)))
   (GO.res-irr v u (Dbl.Res[iota2 v,iota2 u,iota2-le v u k].k2) k s) ;
 inv-to2 (u : L.L) (s : (X.sheaf.ring u).R) : Id DD.Opens (Dbl.L2.d (iota2 u) (map (to2 u) s)) (iota2 (LX.d u s)) =
  DD.ext (Dbl.L2.d (iota2 u) (map (to2 u) s)) (iota2 (LX.d u s))
   (trans (Dbl.d-first (iota2 u) (map (to2 u) s)) (inv-second u s)) (Dbl.d-second (iota2 u) (map (to2 u) s)) ;
} ;
