-- Fixed-base comparison of relative and total cover equations (§3).
-- Pair each native value with the specified localisation structure map.
-- Total-on identifies reindexing along each actual algebra map with the
-- corresponding paired relative value.  Pairing takes relative equations
-- to total ones.  Conversely the resulting two pairs have the SAME
-- specified base map, so DependentPairs.injective recovers the fibre
-- equality.  This proves both compatibility and matching comparisons.
level l ; open Ring[l] ; open Presentations[l] ;
module T = AffineTests[l] ;
module RH = RingHom[l] ;
module TS = TestSheaves[l] ;
module Over (K : T.Test) (F : RelativeFunctors[l].Over[K].SetFunctor)
 (c : TS.CoverData) (iota : RH.Hom K.ring (TS.base c).ring) {
 module TF = RelativeTotal[l].Over[K,F] ;
 module BP = TF.BP ;
 module RC = RelativeCovers[l].Over[K,F].Cover[c,iota] ;
 module TC = TS.OnCover[TF.functor,c].C ;
 pairs (xs : RC.Values) : TC.Values = \ i -> TF.At[RC.D.basic i].pair (BP.iota (RC.basic i)) (xs i) ;
 restriction-on (x : F.obj RC.base) (i : Fin (TS.count c)) :
  Id (TF.functor.obj (RC.D.basic i)) (TC.restrictions (TF.At[TS.base c].pair iota x) i) (pairs (RC.restrictions x) i) =
  TF.on-algebra RC.base (RC.basic i) (RC.inclusion i) x ;
 left-on (xs : RC.Values) (i j : Fin (TS.count c)) : Id (TF.functor.obj (RC.D.double i j))
  (TF.functor.reindex (RC.D.basic i) (RC.D.double i j) (RC.D.left i j) (pairs xs i))
  (TF.At[RC.D.double i j].pair (BP.iota (RC.double i j)) (F.reindex (RC.basic i) (RC.double i j) (RC.left i j) (xs i))) =
  TF.on-algebra (RC.basic i) (RC.double i j) (RC.left i j) (xs i) ;
 right-on (xs : RC.Values) (i j : Fin (TS.count c)) : Id (TF.functor.obj (RC.D.double i j))
  (TF.functor.reindex (RC.D.basic j) (RC.D.double i j) (RC.D.right i j) (pairs xs j))
  (TF.At[RC.D.double i j].pair (BP.iota (RC.double i j)) (F.reindex (RC.basic j) (RC.double i j) (RC.right i j) (xs j))) =
  TF.on-algebra (RC.basic j) (RC.double i j) (RC.right i j) (xs j) ;
 pair-compatible (xs : RC.Values) (h : RC.Compatible xs) : TC.Compatible (pairs xs) = \ i j ->
  trans (left-on xs i j) (trans (ap (TF.At[RC.D.double i j].pair (BP.iota (RC.double i j))) (h i j)) (sym (right-on xs i j))) ;
 fibre-compatible (xs : RC.Values) (h : TC.Compatible (pairs xs)) : RC.Compatible xs = \ i j ->
  TF.At[RC.D.double i j].DP.injective (BP.iota (RC.double i j)) _ _
   (trans (sym (left-on xs i j)) (trans (h i j) (right-on xs i j))) ;
 pair-matches (xs : RC.Values) (x : F.obj RC.base) (h : RC.Matches xs x) : TC.Matches (pairs xs) (TF.At[TS.base c].pair iota x) =
  \ i -> trans (restriction-on x i) (ap (TF.At[RC.D.basic i].pair (BP.iota (RC.basic i))) (h i)) ;
 fibre-matches (xs : RC.Values) (x : F.obj RC.base) (h : TC.Matches (pairs xs) (TF.At[TS.base c].pair iota x)) : RC.Matches xs x =
  \ i -> TF.At[RC.D.basic i].DP.injective (BP.iota (RC.basic i)) _ _ (trans (sym (restriction-on x i)) (h i)) ;
} ;
