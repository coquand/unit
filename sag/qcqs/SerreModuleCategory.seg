-- Small modules and linear maps form a locally small precategory.
-- An underlying equivalence supplies the linear inverse by cancellation.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module SM = SerreModule[l] ;
module Bil = SerreBilinear[l] ; module C = Category[l+,l] ;
module Over (A : CRing) {
 module S = SM.Over[A] ; module L = Bil.Over[A] ;
 Hom (M N : S.Module) : U l = L.Linear[M,N].H.Hom ;
 comp (M N P : S.Module) (g : Hom N P) (f : Hom M N) : Hom M P =
  L.Composite[M,N,P,f,g].map ;
 modules : C.Precategory = new C.Precategory[
  S.Module,Hom,\ M N -> L.Hom[M,N].set,L.identity,comp,
  \ M N f -> L.Hom[M,N].ext _ _ (\ x -> refl (f.fn x)),
  \ M N f -> L.Hom[M,N].ext _ _ (\ x -> refl (f.fn x)),
  \ K M N P f g h -> L.Hom[K,P].ext _ _ (\ x -> refl (h.fn (g.fn (f.fn x))))] ;
 module FromEquiv (M N : S.Module) (f : Hom M N) (eq : Pr.isEquiv M.M N.M f.fn) {
  injective (a b : M.M) : Id N.M (f.fn a) (f.fn b) -> Id M.M a b =
   Iso[l].injective M.M N.M f.fn eq a b ;
  add (x y : N.M) : Id M.M (eq.sec (N.madd x y)) (M.madd (eq.sec x) (eq.sec y)) =
   injective _ _ (trans (eq.sec-eq (N.madd x y))
    (sym (trans (f.additive (eq.sec x) (eq.sec y)) (cong2 N.M N.madd _ _ _ _ (eq.sec-eq x) (eq.sec-eq y))))) ;
  scale (a : A.R) (x : N.M) : Id M.M (eq.sec (N.sm a x)) (M.sm a (eq.sec x)) =
   injective _ _ (trans (eq.sec-eq (N.sm a x)) (sym (trans (f.scalar a (eq.sec x)) (ap (N.sm a) (eq.sec-eq x))))) ;
  inverse : Hom N M = new L.Linear[N,M].H.Hom[eq.sec,add,scale] ;
  left (x : M.M) : Id M.M (inverse.fn (f.fn x)) x = Pr.sec-ret M.M N.M f.fn eq x ;
  right (x : N.M) : Id N.M (f.fn (inverse.fn x)) x = eq.sec-eq x ;
  iso : modules.Iso M N = (f,inverse,L.Hom[M,M].ext _ _ left,L.Hom[N,N].ext _ _ right) ;
 } ;
 evaluate (M N : S.Module) (x : M.M) (g : Hom M N) : N.M = g.fn x ;
 underlying (M N : S.Module) (e : modules.Iso M N) : Pr.isEquiv M.M N.M e.1.fn =
  Pr.qinv M.M N.M e.1.fn e.2.1.fn
   (\ y -> ap (evaluate N N y) e.2.2.2)
   (\ x -> ap (evaluate M M x) e.2.2.1) ;
} ;
