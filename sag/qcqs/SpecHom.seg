-- Spec of a ring map (DESIGN.md, Next 1).  For rings B, A (sets, with
-- localisation families as in Sections) and a ring map beta : B -> A,
-- Spec beta : Spec A -> Spec B is, as a map of ringed lattices L_B -> L_A,
-- the map of SpecMap for X = Spec A and phi = (a |-> a|top) . beta.  It is
-- local, with global component phi (SpecUniversal).
--
-- Lemma (composite).  For a map psi : L_A -> M into a locally ringed X,
--  the global component of psi . Spec beta is (global component of psi) .
--  beta.  Let p = (Spec beta) top >= top and y = (Spec beta)#(b|top) in
--  O_A(p), so y|top = (beta b)|top.  Then
--   (psi#_p y)|top = ((psi#_p y)|psi top)|top        (res-comp)
--                  = (psi#_top (y|top))|top         (psi natural)
--                  = (psi#_top ((beta b)|top))|top.
-- Lemma (retract).  If gamma : A -> B has gamma . beta = 1, then
--  Spec gamma . Spec beta : L_B -> L_B is an isomorphism.  It is local
--  (Compose) with global component (b |-> b|top) . gamma . beta = b |-> b|top
--  (composite), as is the identity of Spec B (res-id).  By SpecUnique both
--  agree with the map of b |-> b|top: the identity is an isomorphism, so
--  that map is one, so the composite is one (Iso.Transfer).
-- Lemma (precompose).  For psi : L_A -> M and any rho : (M, O_X) ->
--  (M2, O_X2), the global component of rho . psi is Gamma(rho) . (global
--  component of psi), Gamma(rho) = (restriction to top) . rho#_top:
--   (rho#(psi#(a|top)))|top = ((rho#(psi#(a|top)))|rho top)|top
--                           = (rho#((psi#(a|top))|top))|top   (rho natural).
-- Theorem.  If beta is a ring isomorphism, Spec beta is an isomorphism:
--  both composites with Spec(beta^-1) are (retract), and Compose.Inverse.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;
module Over (B : CRing) (setB : Pr.isSet B.R) (LocB : B.R -> CRing) (setLB : (g : B.R) -> Pr.isSet (LocB g).R)
 (fB : (g : B.R) -> RH.Hom B (LocB g))
 (elB : (g : B.R) -> Bridge[l].Over[B,g].LocH.Elementary (LocB g) (fB g))
 (A : CRing) (setA : Pr.isSet A.R) (Loc : A.R -> CRing) (set : (g : A.R) -> Pr.isSet (Loc g).R)
 (f : (g : A.R) -> RH.Hom A (Loc g))
 (el : (g : A.R) -> Bridge[l].Over[A,g].LocH.Elementary (Loc g) (f g))
 (beta : RH.Hom B A) {
 module ZA = ZariskiLattice[l].Over[A] ;
 module ZB = ZariskiLattice[l].Over[B] ;
 module SA = SpecLocal[l].Over[A,Loc,set,f,el] ;
 module ShA = Sheaf[l].Over[A,Loc,set,f,el] ;
 module GA = Global[l].Over[A,setA,Loc,set,f,el] ;
 module Into = SpecUniversal[l].Over[B,setB,LocB,setLB,fB,elB,ZA.lattice,SA.spec] ;
 phi : RH.Hom B (SA.spec.sheaf.ring ZA.lattice.top) = RH.compose B A (SA.spec.sheaf.ring ZA.lattice.top) GA.global beta ;
 phi-map (b : B.R) : Id (SA.spec.sheaf.ring ZA.lattice.top).R (map phi b) (map GA.global (map beta b)) =
  map-compose GA.global beta b ;
 morphism : Into.Mp.Ringed = Into.Of[phi].morphism ;
 local : Into.Mp.Of[morphism,Into.SI.inv-map,SA.spec.inv].IsLocal = Into.Of[phi].local ;
 -- the global component of Spec beta, written with the restriction of the structure sheaf
 global (b : B.R) : Id (ShA.structure.ring ZA.lattice.top).R
  (map (ShA.structure.res ZA.lattice.top (DL.hmap morphism.lat ZB.lattice.top) (Into.psi-top morphism))
    (map (morphism.sharp ZB.lattice.top) (map Into.Gb.global b)))
  (map GA.global (map beta b)) =
  trans (sym (Into.component-map morphism b)) (trans (Into.Of[phi].component-of b) (phi-map b)) ;

 -- the global component of psi . Spec beta
 module Then (M : DL.DLat) (X : LocallyRinged[l].On[M].LocallyRinged)
  (psi : LocallyRinged[l].Maps[ZA.lattice,M,ShA.structure,X.sheaf].Ringed) {
  module UA = SpecUniversal[l].Over[A,setA,Loc,set,f,el,M,X] ;
  module UB = SpecUniversal[l].Over[B,setB,LocB,setLB,fB,elB,M,X] ;
  module MO = DL.Order[M] ;
  module GO = RingedLattice[l].On[M].Of[X.sheaf] ;
  module C = Compose[l].Maps[ZB.lattice,ZA.lattice,M,Into.Sh.structure,ShA.structure,X.sheaf].Of[psi,morphism] ;
  -- psi top <= psi p
  le-p : MO.Le (DL.hmap psi.lat ZA.lattice.top) (DL.hmap psi.lat (DL.hmap morphism.lat ZB.lattice.top)) =
   DL.JoinMaps[ZA.lattice,M,psi.lat].monotone ZA.lattice.top (DL.hmap morphism.lat ZB.lattice.top) (Into.psi-top morphism) ;
  -- top <= psi top <= psi p
  top-p : MO.Le M.top (DL.hmap psi.lat (DL.hmap morphism.lat ZB.lattice.top)) =
   MO.le-trans M.top (DL.hmap psi.lat ZA.lattice.top) (DL.hmap psi.lat (DL.hmap morphism.lat ZB.lattice.top)) (UA.psi-top psi) le-p ;
  component (b : B.R) : Id (X.sheaf.ring M.top).R (map (UB.component C.composite) b) (map (UA.component psi) (map beta b)) =
   calc (X.sheaf.ring M.top).R {
    map (UB.component C.composite) b
     =< UB.component-map C.composite b
      > GO.restrict M.top (DL.hmap C.lat ZB.lattice.top) (UB.psi-top C.composite)
         (map (C.composite.sharp ZB.lattice.top) (map Into.Gb.global b))
     =< C.restrict-composite M.top ZB.lattice.top (UB.psi-top C.composite) top-p (map Into.Gb.global b)
      > GO.restrict M.top (DL.hmap psi.lat (DL.hmap morphism.lat ZB.lattice.top)) top-p (map (psi.sharp (DL.hmap morphism.lat ZB.lattice.top)) (map (morphism.sharp ZB.lattice.top) (map Into.Gb.global b)))
     =< sym (X.sheaf.res-comp M.top (DL.hmap psi.lat ZA.lattice.top) (DL.hmap psi.lat (DL.hmap morphism.lat ZB.lattice.top)) (UA.psi-top psi) le-p top-p
          (map (psi.sharp (DL.hmap morphism.lat ZB.lattice.top)) (map (morphism.sharp ZB.lattice.top) (map Into.Gb.global b))))
      > GO.restrict M.top (DL.hmap psi.lat ZA.lattice.top) (UA.psi-top psi)
         (GO.restrict (DL.hmap psi.lat ZA.lattice.top) (DL.hmap psi.lat (DL.hmap morphism.lat ZB.lattice.top)) le-p (map (psi.sharp (DL.hmap morphism.lat ZB.lattice.top)) (map (morphism.sharp ZB.lattice.top) (map Into.Gb.global b))))
     =< ap (GO.restrict M.top (DL.hmap psi.lat ZA.lattice.top) (UA.psi-top psi))
         (psi.natural ZA.lattice.top (DL.hmap morphism.lat ZB.lattice.top) (Into.psi-top morphism) (map (morphism.sharp ZB.lattice.top) (map Into.Gb.global b)))
      > GO.restrict M.top (DL.hmap psi.lat ZA.lattice.top) (UA.psi-top psi)
         (map (psi.sharp ZA.lattice.top) (map (ShA.structure.res ZA.lattice.top (DL.hmap morphism.lat ZB.lattice.top) (Into.psi-top morphism)) (map (morphism.sharp ZB.lattice.top) (map Into.Gb.global b))))
     =< ap (\ e -> GO.restrict M.top (DL.hmap psi.lat ZA.lattice.top) (UA.psi-top psi) (map (psi.sharp ZA.lattice.top) e))
         (global b)
      > GO.restrict M.top (DL.hmap psi.lat ZA.lattice.top) (UA.psi-top psi)
         (map (psi.sharp ZA.lattice.top) (map GA.global (map beta b)))
     =< sym (UA.component-map psi (map beta b)) > map (UA.component psi) (map beta b) } ;
 } ;
} ;

-- Spec gamma . Spec beta is an isomorphism when gamma . beta = 1
module Retract (B : CRing) (setB : Pr.isSet B.R) (LocB : B.R -> CRing) (setLB : (g : B.R) -> Pr.isSet (LocB g).R)
 (fB : (g : B.R) -> RH.Hom B (LocB g))
 (elB : (g : B.R) -> Bridge[l].Over[B,g].LocH.Elementary (LocB g) (fB g))
 (A : CRing) (setA : Pr.isSet A.R) (Loc : A.R -> CRing) (set : (g : A.R) -> Pr.isSet (Loc g).R)
 (f : (g : A.R) -> RH.Hom A (Loc g))
 (el : (g : A.R) -> Bridge[l].Over[A,g].LocH.Elementary (Loc g) (f g))
 (beta : RH.Hom B A) (gamma : RH.Hom A B) (ret : (b : B.R) -> Id B.R (map gamma (map beta b)) b) {
 module Fw = Over[B,setB,LocB,setLB,fB,elB,A,setA,Loc,set,f,el,beta] ;
 module Bw = Over[A,setA,Loc,set,f,el,B,setB,LocB,setLB,fB,elB,gamma] ;
 module SB = Bw.SA ;
 module GB = Bw.GA ;
 module T = Fw.Then[Fw.ZB.lattice,SB.spec,Bw.morphism] ;
 module SM = SpecMap[l].Over[B,setB,LocB,setLB,fB,elB,Fw.ZB.lattice,SB.spec,GB.global] ;
 -- the composite: local, global component b |-> b|top
 local : SM.Mp.Of[T.C.composite,SB.SI.inv-map,SB.spec.inv].IsLocal =
  T.C.Local[SB.SI.inv-map,Fw.SA.spec.inv,SB.spec.inv,Fw.local,Bw.local].local ;
 component (b : B.R) : Id (SB.spec.sheaf.ring Fw.ZB.lattice.top).R (map (T.UB.component T.C.composite) b) (map GB.global b) =
  calc (SB.spec.sheaf.ring Fw.ZB.lattice.top).R {
   map (T.UB.component T.C.composite) b =< T.component b > map (T.UA.component Bw.morphism) (map beta b)
    =< Bw.Into.Of[Bw.phi].component-of (map beta b) > map Bw.phi (map beta b)
    =< Bw.phi-map (map beta b) > map GB.global (map gamma (map beta b))
    =< ap (map GB.global) (ret b) > map GB.global b } ;
 module SC = SpecUnique[l].Over[B,setB,LocB,setLB,fB,elB,Fw.ZB.lattice,SB.spec,GB.global,T.C.composite,local,
  \ b -> trans (sym (T.UB.component-map T.C.composite b)) (component b)] ;
 -- the identity: local, global component b |-> b|top
 module Id0 = Compose[l].Identity[Fw.ZB.lattice,SB.spec.sheaf] ;
 id-local : SM.Mp.Of[Id0.identity,SB.SI.inv-map,SB.spec.inv].IsLocal = Id0.local SB.spec.inv ;
 module SI = SpecUnique[l].Over[B,setB,LocB,setLB,fB,elB,Fw.ZB.lattice,SB.spec,GB.global,Id0.identity,id-local,
  \ b -> Id0.fixes Fw.ZB.lattice.top (T.UB.psi-top Id0.identity) (map GB.global b)] ;
 -- both agree with the map of b |-> b|top
 module I = Iso[l].Maps[Fw.ZB.lattice,Fw.ZB.lattice,SM.Sh.structure,SB.spec.sheaf] ;
 map-iso : I.IsIso SM.morphism = I.Transfer[Id0.identity,SM.morphism,SI.lat-eq,SI.le-pi,SI.sharp-eq].forward Id0.iso ;
 iso : I.IsIso T.C.composite = I.Transfer[T.C.composite,SM.morphism,SC.lat-eq,SC.le-pi,SC.sharp-eq].backward map-iso ;
} ;

-- Spec of a ring isomorphism is an isomorphism
module Isomorphism (B : CRing) (setB : Pr.isSet B.R) (LocB : B.R -> CRing) (setLB : (g : B.R) -> Pr.isSet (LocB g).R)
 (fB : (g : B.R) -> RH.Hom B (LocB g))
 (elB : (g : B.R) -> Bridge[l].Over[B,g].LocH.Elementary (LocB g) (fB g))
 (A : CRing) (setA : Pr.isSet A.R) (Loc : A.R -> CRing) (set : (g : A.R) -> Pr.isSet (Loc g).R)
 (f : (g : A.R) -> RH.Hom A (Loc g))
 (el : (g : A.R) -> Bridge[l].Over[A,g].LocH.Elementary (Loc g) (f g))
 (beta : RH.Hom B A) (gamma : RH.Hom A B)
 (ret : (b : B.R) -> Id B.R (map gamma (map beta b)) b) (sec : (a : A.R) -> Id A.R (map beta (map gamma a)) a) {
 module R1 = Retract[B,setB,LocB,setLB,fB,elB,A,setA,Loc,set,f,el,beta,gamma,ret] ;
 module R2 = Retract[A,setA,Loc,set,f,el,B,setB,LocB,setLB,fB,elB,gamma,beta,sec] ;
 iso : Iso[l].Maps[R1.Fw.ZB.lattice,R1.Fw.ZA.lattice,R1.SM.Sh.structure,R1.Fw.SA.spec.sheaf].IsIso R1.Fw.morphism =
  Compose[l].Inverse[R1.Fw.ZB.lattice,R1.Fw.ZA.lattice,R1.SM.Sh.structure,R1.Fw.SA.spec.sheaf,R1.Fw.morphism,R1.Bw.morphism,
   R1.iso,R2.iso].iso ;
} ;

-- the global component of rho . psi
module Precompose (A : CRing) (setA : Pr.isSet A.R) (Loc : A.R -> CRing) (set : (g : A.R) -> Pr.isSet (Loc g).R)
 (f : (g : A.R) -> RH.Hom A (Loc g))
 (el : (g : A.R) -> Bridge[l].Over[A,g].LocH.Elementary (Loc g) (f g))
 (M : DL.DLat) (X : LocallyRinged[l].On[M].LocallyRinged) (M2 : DL.DLat) (X2 : LocallyRinged[l].On[M2].LocallyRinged)
 (rho : LocallyRinged[l].Maps[M,M2,X.sheaf,X2.sheaf].Ringed)
 (psi : SpecUniversal[l].Over[A,setA,Loc,set,f,el,M,X].Mp.Ringed) {
 module ZA = ZariskiLattice[l].Over[A] ;
 module UA = SpecUniversal[l].Over[A,setA,Loc,set,f,el,M,X] ;
 module UA2 = SpecUniversal[l].Over[A,setA,Loc,set,f,el,M2,X2] ;
 module MO2 = DL.Order[M2] ;
 module GO2 = RingedLattice[l].On[M2].Of[X2.sheaf] ;
 module RL = DL.JoinMaps[M,M2,rho.lat] ;
 module C = Compose[l].Maps[ZA.lattice,M,M2,UA.Sh.structure,X.sheaf,X2.sheaf].Of[rho,psi] ;
 -- Gamma(rho) : O_X(top) -> O_X2(top)
 module GR = Compose[l].Gamma[M,M2,X.sheaf,X2.sheaf,rho] ;
 top-le : MO2.Le M2.top (DL.hmap rho.lat M.top) = GR.top-le ;
 gamma : RH.Hom (X.sheaf.ring M.top) (X2.sheaf.ring M2.top) = GR.gamma ;
 mono : MO2.Le (DL.hmap rho.lat M.top) (DL.hmap rho.lat (DL.hmap psi.lat ZA.lattice.top)) =
  RL.monotone M.top (DL.hmap psi.lat ZA.lattice.top) (UA.psi-top psi) ;
 top-p : MO2.Le M2.top (DL.hmap rho.lat (DL.hmap psi.lat ZA.lattice.top)) =
  MO2.le-trans M2.top (DL.hmap rho.lat M.top) (DL.hmap rho.lat (DL.hmap psi.lat ZA.lattice.top)) top-le mono ;
 component (a : A.R) : Id (X2.sheaf.ring M2.top).R (map (UA2.component C.composite) a) (map gamma (map (UA.component psi) a)) =
  calc (X2.sheaf.ring M2.top).R {
   map (UA2.component C.composite) a
    =< UA2.component-map C.composite a
     > GO2.restrict M2.top (DL.hmap C.lat ZA.lattice.top) (UA2.psi-top C.composite)
        (map (C.composite.sharp ZA.lattice.top) (map UA.Gb.global a))
    =< C.restrict-composite M2.top ZA.lattice.top (UA2.psi-top C.composite) top-p (map UA.Gb.global a)
     > GO2.restrict M2.top (DL.hmap rho.lat (DL.hmap psi.lat ZA.lattice.top)) top-p
        (map (rho.sharp (DL.hmap psi.lat ZA.lattice.top)) (map (psi.sharp ZA.lattice.top) (map UA.Gb.global a)))
    =< sym (X2.sheaf.res-comp M2.top (DL.hmap rho.lat M.top) (DL.hmap rho.lat (DL.hmap psi.lat ZA.lattice.top)) top-le mono top-p
         (map (rho.sharp (DL.hmap psi.lat ZA.lattice.top)) (map (psi.sharp ZA.lattice.top) (map UA.Gb.global a))))
     > GO2.restrict M2.top (DL.hmap rho.lat M.top) top-le
        (GO2.restrict (DL.hmap rho.lat M.top) (DL.hmap rho.lat (DL.hmap psi.lat ZA.lattice.top)) mono
          (map (rho.sharp (DL.hmap psi.lat ZA.lattice.top)) (map (psi.sharp ZA.lattice.top) (map UA.Gb.global a))))
    =< ap (GO2.restrict M2.top (DL.hmap rho.lat M.top) top-le)
        (rho.natural M.top (DL.hmap psi.lat ZA.lattice.top) (UA.psi-top psi) (map (psi.sharp ZA.lattice.top) (map UA.Gb.global a)))
     > GO2.restrict M2.top (DL.hmap rho.lat M.top) top-le
        (map (rho.sharp M.top) (map (X.sheaf.res M.top (DL.hmap psi.lat ZA.lattice.top) (UA.psi-top psi))
          (map (psi.sharp ZA.lattice.top) (map UA.Gb.global a))))
    =< refl (map gamma (map (UA.component psi) a)) > map gamma (map (UA.component psi) a) } ;
} ;
