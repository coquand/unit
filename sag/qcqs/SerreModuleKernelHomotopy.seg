-- Kernels of pointwise equal module maps are canonically isomorphic.
-- Keep the underlying section fixed and change only its proposition-valued
-- membership equation. Both inverse laws follow by subtype extensionality;
-- all module operations have the same underlying values.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module Over (A : CRing) (B C : SM.Over[A].Module)
 (q r : MM.Between[A,A,RingHom[l].identity A,B,C].Hom)
 (h : (x : B.M) -> Id C.M (MM.Between[A,A,RingHom[l].identity A,B,C].map q x)
  (MM.Between[A,A,RingHom[l].identity A,B,C].map r x)) {
 module S = SerreModuleKernelAlgebra[l].Over[A,B,C,q] ;
 module T = SerreModuleKernelAlgebra[l].Over[A,B,C,r] ;
 forward (x : S.Carrier) : T.Carrier = (S.value x,trans (sym (h (S.value x))) (S.member x)) ;
 backward (x : T.Carrier) : S.Carrier = (T.value x,trans (h (T.value x)) (T.member x)) ;
 forward-value (x : S.Carrier) : Id B.M (T.value (forward x)) (S.value x) = refl (S.value x) ;
 backward-value (x : T.Carrier) : Id B.M (S.value (backward x)) (T.value x) = refl (T.value x) ;
 right (x : T.Carrier) : Id T.Carrier (forward (backward x)) x =
  T.ext (forward (backward x)) x (trans (forward-value (backward x)) (backward-value x)) ;
 left (x : S.Carrier) : Id S.Carrier (backward (forward x)) x =
  S.ext (backward (forward x)) x (trans (backward-value (forward x)) (forward-value x)) ;
 equivalence : Pr.isEquiv S.Carrier T.Carrier forward = Pr.qinv S.Carrier T.Carrier forward backward right left ;
 module Maps = MM.Between[A,A,RingHom[l].identity A,S.kernel,T.kernel] ;
 comparison : Maps.Hom = new Maps.Hom[forward,
  \ x y -> T.ext _ _ (refl (B.madd (S.value x) (S.value y))),
  \ a x -> T.ext _ _ (refl (B.sm a (S.value x)))] ;
 comparison-at (x : S.Carrier) : Id T.Carrier (Maps.map comparison x) (forward x) = refl (forward x) ;
 opaque forward ; opaque backward ; opaque comparison ;
} ;
