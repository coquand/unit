-- Transport and pair equality over a set (relative-totalisation.tex §1).
-- Equality of pairs yields a fibre equation over any specified base
-- path: Sigma-path extraction gives one base path, and sethood identifies
-- it with the specified one.  Hence pairing at a fixed base is injective.
-- Rebase a value backwards along a path; the resulting pair is the
-- original pair, by path induction.  Fibre sets make the total a set.
level l ; open Base ; open Prelude[l] ;
module Over (A : U l) (P : A -> U l) (setA : isSet A) {
 Total : U l = (a : A) * P a ;
 move {a b : A} (p : Id A a b) (x : P a) : P b = subst A P a b p x ;
 move-refl (a : A) (x : P a) : Id (P a) (move (refl a) x) x = refl x ;
 move-compose {a b c : A} (p : Id A a b) (q : Id A b c) (x : P a) :
  Id (P c) (move q (move p x)) (move (trans A a b c p q) x) =
  idJ A b (\ c1 q1 -> Id (P c1) (move q1 (move p x)) (move (trans A a b c1 p q1) x)) (refl (move p x)) c q ;
 inverse {a b : A} (p : Id A a b) (y : P b) : Id (P b) (move p (move (sym A a b p) y)) y =
  idJ A a (\ b1 p1 -> (y : P b1) -> Id (P b1) (move p1 (move (sym A a b1 p1) y)) y) (\ y -> refl y) b p y ;
 pair-equality {a b : A} (x : P a) (y : P b) (p : Id A a b)
  (q : Id (P b) (move p x) y) : Id Total (a,x) (b,y) = Sigma-path A P a b x y p q ;
 fibre-equality {a b : A} (x : P a) (y : P b) (p : Id A a b)
  (q : Id Total (a,x) (b,y)) : Id (P b) (move p x) y =
  subst (Id A a b) (\ r -> Id (P b) (move r x) y)
   (sPath A P (a,x) (b,y) q).1 p (setA a b (sPath A P (a,x) (b,y) q).1 p) (sPath A P (a,x) (b,y) q).2 ;
 injective (a : A) (x y : P a) (q : Id Total (a,x) (a,y)) : Id (P a) x y = fibre-equality x y (refl a) q ;
 rebase {a b : A} (p : Id A a b) (y : P b) : P a = move (sym A a b p) y ;
 rebase-pair {a b : A} (p : Id A a b) (y : P b) : Id Total (a,rebase p y) (b,y) = pair-equality (rebase p y) y p (inverse p y) ;
} ;
