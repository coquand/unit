-- A compact open is determined by the ring maps along which it becomes
-- the whole open. To compare u and v, test on the principal opens of u.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module RH = RingHom[l] ;
module T = AffineTests[l] ;
module ZF = ZariskiFunctor[l] ;
module Over (A : T.Test) {
 module Z = T.At[A].Z ;
 module Rad = Radical[l].Over[A.ring] ;
 Whole (B : T.Test) (h : RH.Hom A.ring B.ring) (u : Z.lattice.L) : U l =
  Id T.At[B].Z.lattice.L (ZF.functor.reindex A B h u) T.At[B].Z.lattice.top ;
 Implies (u v : Z.lattice.L) : U l+ = (B : T.Test) (h : RH.Hom A.ring B.ring) -> Whole B h u -> Whole B h v ;
 below (u v : Z.lattice.L) (tests : Implies u v) : Z.O.Le u v =
  Tr.Trunc[Z.Presentation u].induction @l (\ p -> Z.O.Le u v) (\ p -> Z.O.le-prop u v)
   (\ p -> let {
    gen (i : Fin (Rad.size (Z.generators p))) : A.ring.R = Rad.gen (Z.generators p) i ;
    piece (i : Fin (Rad.size (Z.generators p))) : Z.O.Le (Z.D (gen i)) v =
     LocalisationTests[l].At[A,gen i].backward v
      (tests (T.localised A (gen i)) (T.At[A].A.inclusion (gen i))
       (LocalisationTests[l].At[A,gen i].forward u (Z.gen-below p i))) ;
   } in Z.O.le-trans u _ v (Z.O.le-of-eq _ _ (Z.presents p)) (Z.J.least (Rad.size (Z.generators p)) (\ i -> Z.D (gen i)) v piece))
   (Z.presented u) ;
 equal (u v : Z.lattice.L) (forward : Implies u v) (backward : Implies v u) : Id Z.lattice.L u v =
  Z.O.le-antisym u v (below u v forward) (below v u backward) ;
} ;
