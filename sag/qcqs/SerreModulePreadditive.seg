-- The category Mod(A) of small A-modules is additive (CategoryPreadditive),
-- for the copy Modules of SerreQCohEquivalence (objects (M, tt)).
--
-- Preadditive: Hom(M, N) is the abelian group of SerreBilinear.Hom[M,N]
-- (pointwise zero-map, add-map, neg-map); the group laws hold pointwise,
-- by the module laws of N, and a linear map is determined by its
-- underlying function (ext). Composition is additive in each variable:
-- ((g + g') f)(m) = g(f m) + g'(f m) by definition, and
-- (g (f + f'))(m) = g(f m + f' m) = g(f m) + g(f' m) as g is additive.
-- Biproducts: the pair module M x N (SerreModuleAbelian.Pairs) with
-- injections m |-> (m, 0), n |-> (0, n) and the two projections; the four
-- composites p_j i_k are 1 or 0 by definition, and
-- (i1 p1 + i2 p2)(m, n) = (m + 0, 0 + n) = (m, n) (Pairs.decompose).
-- Zero object: the module on Top (SerreModuleAbelian.zero).
level l ; open Base ; open Ring[l] ;
module Pr = Prelude[l] ;
module CP = CategoryPreadditive[l+] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module E = SerreQCohEquivalence[l].Over[A,setA] ;
 module MA = SerreModuleAbelian[l].Over[A,setA] ;
 module MC = SerreModuleCategory[l].Over[A] ;
 module Bl = SerreBilinear[l].Over[A] ;
 preadditive : CP.Preadditive[E.Modules.category] = new CP.Preadditive[E.Modules.category,
  \ x y -> Bl.Hom[x.1,y.1].zero-map,
  \ x y -> Bl.Hom[x.1,y.1].add-map,
  \ x y -> Bl.Hom[x.1,y.1].neg-map,
  \ x y f g h -> Bl.Hom[x.1,y.1].ext _ _ (\ m -> y.1.maddA (f.fn m) (g.fn m) (h.fn m)),
  \ x y f g -> Bl.Hom[x.1,y.1].ext _ _ (\ m -> y.1.maddC (f.fn m) (g.fn m)),
  \ x y f -> Bl.Hom[x.1,y.1].ext _ _ (\ m -> y.1.maddZ (f.fn m)),
  \ x y f -> Bl.Hom[x.1,y.1].ext _ _ (\ m -> y.1.maddN (f.fn m)),
  \ x y z g g' f -> Bl.Hom[x.1,z.1].ext _ _ (\ m -> refl (z.1.madd (g.fn (f.fn m)) (g'.fn (f.fn m)))),
  \ x y z g f f' -> Bl.Hom[x.1,z.1].ext _ _ (\ m -> g.additive (f.fn m) (f'.fn m))] ;
 -- biproducts: the pair module
 module Bi (x y : E.Mod) {
  module Q = MA.Pairs[x,y] ;
  biproduct : CP.Biproduct[E.Modules.category,preadditive,x,y] =
   new CP.Biproduct[E.Modules.category,preadditive,x,y,Q.object,Q.first-in,Q.second-in,Q.Pa.first,Q.Pa.second,
    Bl.Hom[x.1,x.1].ext _ _ (\ m -> refl m),
    Bl.Hom[y.1,y.1].ext _ _ (\ n -> refl n),
    Bl.Hom[x.1,y.1].ext _ _ (\ m -> refl y.1.mz),
    Bl.Hom[y.1,x.1].ext _ _ (\ n -> refl x.1.mz),
    Bl.Hom[Q.Pa.product,Q.Pa.product].ext _ _ Q.decompose] ;
 } ;
 additive : CP.Additive[E.Modules.category] =
  new CP.Additive[E.Modules.category,preadditive,MA.zero,\ x y -> Bi[x,y].biproduct] ;
} ;
