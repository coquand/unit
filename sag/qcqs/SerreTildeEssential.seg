-- A quasi-coherent module sheaf on Spec A is the associated sheaf of its
-- global sections (PLAN-QCOH-UA, step 5; Serre note, Corollary 4.6).
-- Let F be a quasi-coherent module sheaf on Spec A, Gamma = F(top) as an
-- A-module along a |-> a|top (Global), and Gamma~ its associated sheaf.
-- Theorem. There is a natural linear map Gamma~ -> F which is an
-- equivalence on every open (SerreModuleSheafIso.Equivalence); it is
-- constructed from F alone, without choice.
-- Proof, after SerreLambdaCriterion, with the chart the identity.
--  On D s (s in A). F(D s) is an A-module along psi_s(a) = (a|top)|D s, and
--   psi_s(s) = extend_s(s/1) (Global.extend-global) is a unit, so s acts
--   invertibly. Restriction u_s : Gamma -> F(D s) is A-linear; let
--   k_s : Gamma_s -> F(D s) be its extension (SerreLambdaElementary.Lift).
--   k_s is bijective: lambda_(top,s|top) : Gamma_(s|top) -> F(D_top(s|top))
--   is (SerreAffineLocalisation, F quasi-coherent and Spec A affine), so
--   restriction to D_top(s|top) clears and kills at s|top, hence at s over
--   A (SerreLambdaClearing.Along); D_top(s|top) = D s (Global.d-global),
--   so u_s is that restriction followed by a bijective A-linear
--   restriction, and clears and kills at s (AfterEquivalence).
--   The component is k_s after evaluation at s, M~(D s) ~ Gamma_s
--   (AssociatedBasicOpen). It is linear over O(D s): k_s(b z) = psi_s(b) k_s(z)
--   with psi_s(b) = extend_s(b/1), so k_s is semilinear over
--   extend_s : A_s -> O(D s) (SerreLambdaLocalLinear.Semilinear), and
--   evaluation is semilinear over its inverse.
--  Naturality for D h <= D s: both composites Gamma_s -> F(D h) are
--   A-linear, s acts invertibly on F(D h), and both send x/1 to x|D h; so
--   they agree (SerreLambdaElementary.Agree).
--  Extension. The basis-map theorem (SerreModuleSheafBasisMap) extends the
--   components to a natural linear map; it is an equivalence since its
--   components on the basic opens of a finite presentation are
--   (SerreModuleSheafLocalEquivalence).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module DL = DistLattice[l] ;
module RH = RingHom[l] ; module RM = RingMaps[l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ; module MS = SerreModuleSheaf[l] ;
module EL = SerreLambdaElementary[l] ; module EO = SerreLambdaElementaryOps[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R)
 (F : MS.On[ZariskiLattice[l].Over[A].lattice,Affine[l].Over[A].spec.sheaf].ModuleSheaf)
 (qc : SerreQuasiCoherent[l].On[ZariskiLattice[l].Over[A].lattice,Affine[l].Over[A].spec,F].IsQuasiCoherent) {
 module AF = Affine[l].Over[A] ; module Z = ZariskiLattice[l].Over[A] ; module O = Z.O ;
 module Glo = Global[l].Over[A,setA,AF.Loc,AF.set,AF.inclusion,AF.elementary] ;
 module FO = MS.On[Z.lattice,AF.spec.sheaf].Of[F.presheaf] ;
 -- the global sections, as an A-module
 Gamma : SM.Over[A].Module =
  MM.RestrictScalars[A,AF.spec.sheaf.ring Z.lattice.top,Glo.global].Of[F.presheaf.module-at Z.lattice.top].restricted ;
 module GM = SerreTildeGlobal[l].Over[A,setA,Gamma] ;
 module Ev = GM.Ev ; module RingBasic = Ev.RingBasic ; module Rings = GM.Rings ;
 affine : AffineCriterion[l].Over[Z.lattice,AF.spec].IsAffine = AffineQcqs[l].TestSpace[new AffineTests[l].Test[A,setA]].affine ;
 Target (s : A.R) : SM.Over[AF.spec.sheaf.ring (Z.D s)].Module = F.presheaf.module-at (Z.D s) ;
 module At (s : A.R) {
  le : O.Le (Z.D s) Z.lattice.top = O.le-top (Z.D s) ;
  -- F(D s) as an A-module, on which s acts invertibly
  psi : RH.Hom A (AF.spec.sheaf.ring (Z.D s)) =
   RH.compose A (AF.spec.sheaf.ring Z.lattice.top) (AF.spec.sheaf.ring (Z.D s)) (AF.spec.sheaf.res (Z.D s) Z.lattice.top le) Glo.global ;
  Q : SM.Over[A].Module = MM.RestrictScalars[A,AF.spec.sheaf.ring (Z.D s),psi].Of[Target s].restricted ;
  -- psi_s(b) = extend_s(b/1)
  psi-extend (b : A.R) : Id (Rings.Section (Z.D s)) (RM.map psi b) (RM.map RingBasic.At[s].extension (RM.map (AF.inclusion s) b)) =
   sym (Glo.extend-global s b) ;
  unit : RL[AF.spec.sheaf.ring (Z.D s)].unit (RM.map psi s) =
   Pr.subst (Rings.Section (Z.D s)) (\ r -> RL[AF.spec.sheaf.ring (Z.D s)].unit r)
    (RM.map RingBasic.At[s].extension (RM.map (AF.inclusion s) s)) (RM.map psi s) (sym (psi-extend s))
    (AffineRing[l].unit-map (AF.Loc s) (AF.spec.sheaf.ring (Z.D s)) RingBasic.At[s].extension (RM.map (AF.inclusion s) s)
     (Bridge[l].Over[A,s].At[AF.Loc s,AF.set s,AF.inclusion s,AF.elementary s,s].le-invertible (O.le-refl (Z.D s)))) ;
  module Act = SerreModuleBasicRestrictions[l].UnitAction[AF.spec.sheaf.ring (Z.D s),Target s,RM.map psi s,unit] ;
  invertible : Pr.isEquiv Q.M Q.M (Q.sm s) = Act.equiv ;
  -- restriction Gamma -> F(D s), and its extension k_s
  module UM = MM.Between[A,A,RH.identity A,Gamma,Q] ;
  u : UM.Hom = new UM.Hom[FO.restrict (Z.D s) Z.lattice.top le,FO.res-add (Z.D s) Z.lattice.top le,
   \ a x -> FO.res-scale (Z.D s) Z.lattice.top le (RM.map Glo.global a) x] ;
  u-at (x : Gamma.M) : Id Q.M (UM.map u x) (FO.restrict (Z.D s) Z.lattice.top le x) = refl (FO.restrict (Z.D s) Z.lattice.top le x) ;
  module K = EL.Lift[A,Gamma,Q,u,s,invertible] ;
  k (z : GM.Local s) : Q.M = K.map z ;
  k-original (x : Gamma.M) : Id Q.M (k (GM.fraction s x)) (FO.restrict (Z.D s) Z.lattice.top le x) =
   trans (K.E.extends x) (u-at x) ;
  -- k_s is bijective, by lambda at top
  module Cl = SerreLambdaClearing[l].On[Z.lattice,AF.spec,F,Z.lattice.top,RM.map Glo.global s] ;
  module Al = Cl.Along[A,Glo.global,s,refl (RM.map Glo.global s)] ;
  module Lam = Al.Restricted[SerreAffineLocalisation[l].On[Z.lattice,AF.spec,affine,F].lambda qc (RM.map Glo.global s)] ;
  open-g : Z.lattice.L = Cl.Lam.open-g ;
  to-s : O.Le (Z.D s) open-g = O.le-of-eq _ _ (sym (Glo.d-global s)) ;
  from-s : O.Le open-g (Z.D s) = O.le-of-eq _ _ (Glo.d-global s) ;
  module E = MM.Between[A,A,RH.identity A,Al.R.RNd.restricted,Q] ;
  move (y : (F.presheaf.module-at open-g).M) : Q.M = FO.restrict (Z.D s) open-g to-s y ;
  move-scale (b : A.R) (y : (F.presheaf.module-at open-g).M) : Id Q.M (move (Al.R.RNd.restricted.sm b y)) (Q.sm b (move y)) =
   trans (FO.res-scale (Z.D s) open-g to-s (RM.map Cl.C.ring-map (RM.map Glo.global b)) y)
    (ap (\ c -> (Target s).sm c (move y))
     (AF.spec.sheaf.res-comp (Z.D s) open-g Z.lattice.top to-s Cl.Lam.below le (RM.map Glo.global b))) ;
  e : E.Hom = new E.Hom[move,FO.res-add (Z.D s) open-g to-s,move-scale] ;
  e-equiv : Pr.isEquiv (F.presheaf.module-at open-g).M Q.M (E.map e) =
   Pr.qinv (F.presheaf.module-at open-g).M Q.M (E.map e) (FO.restrict open-g (Z.D s) from-s)
    (\ y -> trans (F.presheaf.res-comp (Z.D s) open-g (Z.D s) to-s from-s (O.le-refl (Z.D s)) y)
     (F.presheaf.res-id (Z.D s) (O.le-refl (Z.D s)) y))
    (\ y -> trans (F.presheaf.res-comp open-g (Z.D s) open-g from-s to-s (O.le-refl open-g) y)
     (F.presheaf.res-id open-g (O.le-refl open-g) y)) ;
  agree (x : Gamma.M) : Id Q.M (UM.map u x)
   (E.map e (MM.Between[A,A,RH.identity A,Gamma,Al.R.RNd.restricted].map Al.R.restricted x)) =
   sym (trans (ap move (Cl.C.original-at x))
    (F.presheaf.res-comp (Z.D s) open-g Z.lattice.top to-s Cl.Lam.below le x)) ;
  module After = EO.AfterEquivalence[A,Gamma,Al.R.RNd.restricted,Q,Al.R.restricted,e,e-equiv,u,agree,s] ;
  k-equiv : Pr.isEquiv (GM.Local s) Q.M k = K.equivalence (After.clear Lam.clear) (After.kill Lam.kill) ;
  -- k_s is semilinear over extend_s
  module LL = SerreLambdaLocalLinear[l].Over[A,setA,Gamma,s] ;
  k-scale (b : A.R) (z : GM.Local s) : Id Q.M (k (GM.BR.Local[s].Native.localised.sm b z))
   ((Target s).sm (RM.map RingBasic.At[s].extension (RM.map (AF.inclusion s) b)) (k z)) =
   trans (K.E.To.map-scale K.lift b z) (ap (\ c -> (Target s).sm c (k z)) (psi-extend b)) ;
  module Semi = LL.Semilinear[AF.spec.sheaf.ring (Z.D s),Target s,RingBasic.At[s].extension,k,k-scale] ;
  -- the component on D s
  Source : U l = (GM.Sh.associated.presheaf.module-at (Z.D s)).M ;
  evaluate (x : Source) : GM.Local s = Ev.At[s].Maps.map Ev.At[s].evaluation x ;
  forward (x : Source) : Q.M = k (evaluate x) ;
  forward-equiv : Pr.isEquiv Source Q.M forward =
   Iso[l].equiv-compose Source (GM.Local s) Q.M k evaluate k-equiv Ev.At[s].equivalence ;
  additive (x y : Source) : Id Q.M (forward ((GM.Sh.associated.presheaf.module-at (Z.D s)).madd x y))
   (Q.madd (forward x) (forward y)) =
   trans (ap k (Ev.At[s].Maps.map-add Ev.At[s].evaluation x y)) (K.E.To.map-add K.lift (evaluate x) (evaluate y)) ;
  extend-evaluate (r : (AF.spec.sheaf.ring (Z.D s)).R) :
   Id (Rings.Section (Z.D s)) (RM.map RingBasic.At[s].extension (RM.map RingBasic.At[s].evaluation r)) r =
   trans (ap RingBasic.At[s].extend (RingBasic.At[s].evaluation-map r)) (RingBasic.At[s].extend-eval r) ;
  scalar (r : (AF.spec.sheaf.ring (Z.D s)).R) (x : Source) :
   Id Q.M (forward ((GM.Sh.associated.presheaf.module-at (Z.D s)).sm r x)) ((Target s).sm r (forward x)) =
   calc Q.M {
    forward ((GM.Sh.associated.presheaf.module-at (Z.D s)).sm r x)
     =< ap k (Ev.At[s].Maps.map-scale Ev.At[s].evaluation r x)
      > k (LL.Sc.localised.sm (RM.map RingBasic.At[s].evaluation r) (evaluate x))
     =< Semi.scale (RM.map RingBasic.At[s].evaluation r) (evaluate x)
      > (Target s).sm (RM.map RingBasic.At[s].extension (RM.map RingBasic.At[s].evaluation r)) (forward x)
     =< ap (\ c -> (Target s).sm c (forward x)) (extend-evaluate r) > (Target s).sm r (forward x) } ;
  module Maps = MM.Between[AF.spec.sheaf.ring (Z.D s),AF.spec.sheaf.ring (Z.D s),RH.identity (AF.spec.sheaf.ring (Z.D s)),
   GM.Sh.associated.presheaf.module-at (Z.D s),Target s] ;
  component : Maps.Hom = new Maps.Hom[forward,additive,scalar] ;
  component-at (x : Source) : Id Q.M (Maps.map component x) (forward x) = refl (forward x) ;
  equivalence : Pr.isEquiv Source Q.M (Maps.map component) =
   Iso[l].equiv-homotopy Source Q.M forward (Maps.map component) (\ x -> sym (component-at x)) forward-equiv ;
  opaque component ;
 } ;
 -- naturality for D h <= D s
 module Natural (h s : A.R) (le : O.Le (Z.D h) (Z.D s)) {
  module Ph = At[h] ; module Ps = At[s] ;
  restrict (y : (Target s).M) : (Target h).M = FO.restrict (Z.D h) (Z.D s) le y ;
  -- psi_h(b) = psi_s(b)|D h
  psi-restrict (b : A.R) : Id (Rings.Section (Z.D h)) (RM.map (AF.spec.sheaf.res (Z.D h) (Z.D s) le) (RM.map Ps.psi b)) (RM.map Ph.psi b) =
   AF.spec.sheaf.res-comp (Z.D h) (Z.D s) Z.lattice.top le Ps.le Ph.le (RM.map Glo.global b) ;
  unit : RL[AF.spec.sheaf.ring (Z.D h)].unit (RM.map Ph.psi s) =
   Pr.subst (Rings.Section (Z.D h)) (\ r -> RL[AF.spec.sheaf.ring (Z.D h)].unit r)
    (RM.map (AF.spec.sheaf.res (Z.D h) (Z.D s) le) (RM.map Ps.psi s)) (RM.map Ph.psi s) (psi-restrict s)
    (AffineRing[l].unit-map (AF.spec.sheaf.ring (Z.D s)) (AF.spec.sheaf.ring (Z.D h)) (AF.spec.sheaf.res (Z.D h) (Z.D s) le)
     (RM.map Ps.psi s) Ps.unit) ;
  module Act = SerreModuleBasicRestrictions[l].UnitAction[AF.spec.sheaf.ring (Z.D h),Target h,RM.map Ph.psi s,unit] ;
  invertible : Pr.isEquiv Ph.Q.M Ph.Q.M (Ph.Q.sm s) = Act.equiv ;
  module NR = GM.BR.At[s,h,le] ;
  left (z : GM.Local s) : Ph.Q.M = Ph.k (NR.map z) ;
  right (z : GM.Local s) : Ph.Q.M = restrict (Ps.k z) ;
  left-scale (b : A.R) (z : GM.Local s) : Id Ph.Q.M (left (GM.BR.Local[s].Native.localised.sm b z)) (Ph.Q.sm b (left z)) =
   trans (ap Ph.k (NR.map-scale b z)) (Ph.K.E.To.map-scale Ph.K.lift b (NR.map z)) ;
  right-scale (b : A.R) (z : GM.Local s) : Id Ph.Q.M (right (GM.BR.Local[s].Native.localised.sm b z)) (Ph.Q.sm b (right z)) =
   trans (ap restrict (Ps.K.E.To.map-scale Ps.K.lift b z))
    (trans (FO.res-scale (Z.D h) (Z.D s) le (RM.map Ps.psi b) (Ps.k z))
     (ap (\ c -> (Target h).sm c (right z)) (psi-restrict b))) ;
  -- both send x/1 to x|D h
  value (x : Gamma.M) : Ph.Q.M = FO.restrict (Z.D h) Z.lattice.top Ph.le x ;
  left-value (x : Gamma.M) : Id Ph.Q.M (left (GM.fraction s x)) (value x) =
   trans (ap Ph.k (NR.on-original x)) (Ph.k-original x) ;
  right-value (x : Gamma.M) : Id Ph.Q.M (right (GM.fraction s x)) (value x) =
   trans (ap restrict (Ps.k-original x)) (F.presheaf.res-comp (Z.D h) (Z.D s) Z.lattice.top le Ps.le Ph.le x) ;
  module LeftClears = Ps.LL.Clears[Ph.Q,left,left-scale] ;
  module RightClears = Ps.LL.Clears[Ph.Q,right,right-scale] ;
  module Same = EL.Agree[A,Gamma,Ph.Q,s,invertible,value,left,right,
   \ x p -> trans (LeftClears.clears x p) (left-value x),
   \ x p -> trans (RightClears.clears x p) (right-value x)] ;
  module SO = MS.On[Z.lattice,AF.spec.sheaf].Of[GM.Sh.associated.presheaf] ;
  evaluate-natural (x : Ps.Source) : Id (GM.Local h)
   (Ph.evaluate (SO.restrict (Z.D h) (Z.D s) le x)) (NR.map (Ps.evaluate x)) =
   trans (Ev.At[h].evaluation-at (SO.restrict (Z.D h) (Z.D s) le x))
    (trans (ap Ev.At[h].eval (GM.S.restriction-map (Z.D h) (Z.D s) le x))
     (trans (Ev.natural s h le x)
      (trans (GM.AM.component-restriction s h le (Ev.At[s].eval x))
       (ap NR.map (sym (Ev.At[s].evaluation-at x)))))) ;
  equation (x : Ps.Source) :
   Id (Target h).M (restrict (Ps.Maps.map Ps.component x)) (Ph.Maps.map Ph.component (SO.restrict (Z.D h) (Z.D s) le x)) =
   calc (Target h).M {
    restrict (Ps.Maps.map Ps.component x)
     =< ap restrict (Ps.component-at x) > right (Ps.evaluate x)
     =< sym (Same.same (Ps.evaluate x)) > left (Ps.evaluate x)
     =< ap Ph.k (sym (evaluate-natural x)) > Ph.forward (SO.restrict (Z.D h) (Z.D s) le x)
     =< sym (Ph.component-at (SO.restrict (Z.D h) (Z.D s) le x))
      > Ph.Maps.map Ph.component (SO.restrict (Z.D h) (Z.D s) le x) } ;
 } ;
 -- extension from the basis of basic opens
 module Basis = SerreModuleSheafBasisMap[l].On[Z.lattice,AF.spec.sheaf,GM.Sh.associated,F,A.R,Z.D] ;
 module Families = Radical[l].Over[A] ;
 module Presented (u : Z.lattice.L) (p : Z.Presentation u) {
  cover : Basis.BasisCover[u] = new Basis.BasisCover[u,Families.size (Z.generators p),
   \ i -> Families.gen (Z.generators p) i,\ i -> Z.gen-below p i,O.le-of-eq _ _ (Z.presents p)] ;
 } ;
 basis (u : Z.lattice.L) : Tr.Trunc[Basis.BasisCover[u]].carrier =
  Tr.Trunc[Z.Presentation u].induction @l (\ p -> Tr.Trunc[Basis.BasisCover[u]].carrier)
   (\ p -> Tr.Trunc[Basis.BasisCover[u]].proposition)
   (\ p -> Tr.Trunc[Basis.BasisCover[u]].inc Presented[u,p].cover) (Z.presented u) ;
 local-maps : Basis.BasisMaps = new Basis.BasisMaps[\ s -> At[s].component,\ h s le x -> Natural[h,s,le].equation x] ;
 module Extended = Basis.Over[basis,local-maps] ;
 module Transforms = MS.On[Z.lattice,AF.spec.sheaf].Transform[GM.Sh.associated.presheaf,F.presheaf] ;
 morphism : Transforms.Hom = Extended.morphism ;
 basic-equivalence (s : A.R) : Pr.isEquiv At[s].Source (Target s).M (Transforms.at morphism (Z.D s)) =
  Iso[l].equiv-homotopy _ _ (At[s].Maps.map At[s].component) (Transforms.at morphism (Z.D s))
   (\ x -> sym (Extended.on-basis s x)) At[s].equivalence ;
 module Local = SerreModuleSheafLocalEquivalence[l].Over[Z.lattice,AF.spec.sheaf,GM.Sh.associated,F,morphism] ;
 module Covered (u : Z.lattice.L) (c : Basis.BasisCover[u]) {
  cover : Local.GoodCover[u] = new Local.GoodCover[u,c.count,\ i -> Z.D (c.generators i),
   c.below,c.covers,\ i -> basic-equivalence (c.generators i)] ;
 } ;
 covering (u : Z.lattice.L) : Tr.Trunc[Local.GoodCover[u]].carrier =
  Tr.Trunc[Basis.BasisCover[u]].induction @l (\ c -> Tr.Trunc[Local.GoodCover[u]].carrier)
   (\ c -> Tr.Trunc[Local.GoodCover[u]].proposition)
   (\ c -> Tr.Trunc[Local.GoodCover[u]].inc Covered[u,c].cover) (basis u) ;
 -- Gamma~ ~ F
 equivalence : SerreModuleSheafIso[l].On[Z.lattice,AF.spec.sheaf].Equivalence GM.Sh.associated.presheaf F.presheaf =
  Local.With[covering].equivalence ;
 opaque morphism ;
} ;
