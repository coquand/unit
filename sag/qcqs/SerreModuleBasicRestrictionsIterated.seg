-- Iterated scalar localisation agrees with the actual overlap module.
-- Localise the A_g-module M_g at the image of h. Restriction lands in
-- M_(hg), viewed as an A_g-module along the existing ring restriction.
-- The image of h acts invertibly there. The checked overlap clearing
-- and power-killing equations are exactly the elementary localisation
-- property, after the named changes of scalars and powers. The generic
-- comparison theorem therefore gives the canonical equivalence.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module RH = RingHom[l] ; module RM = RingMaps[l] ;
module LC = SerreModuleLocalisation[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (Md : SM.Over[A].Module) {
 module R = SerreModuleBasicRestrictions[l].Over[A,setA,Md] ;
 module SR = SerreModuleBasicRestrictionsScalar[l].Over[A,setA,Md] ;
 module OV = SerreModuleBasicRestrictionsOverlap[l].Over[A,setA,Md] ;
 module AF = R.AF ; module AP = AffinePowers[l].Over[A] ;
 module At (g h : A.R) {
  module OL = OV.At[h,g] ;
  module P = OL.P ;
  module Source = R.Local[g].Scalars ;
  module Destination = R.Local[OL.gh].Scalars ;
  module Target = MM.RestrictScalars[AF.Loc g,AF.Loc OL.gh,R.R.rho g OL.gh OL.below].Of[Destination.localised] ;
  coefficient : (AF.Loc g).R = RM.map (AF.inclusion g) h ;
  module CP = AffinePowers[l].Over[AF.Loc g] ;
  module H = MM.Between[AF.Loc g,AF.Loc g,RH.identity (AF.Loc g),Source.localised,Target.restricted] ;
  restriction : H.Hom = new H.Hom[P.map,P.map-add,SR.At[g,OL.gh,OL.below].scale] ;
  restriction-at (x : Source.localised.M) : Id Target.restricted.M (H.map restriction x) (P.map x) = refl (P.map x) ;
  source-action (a : A.R) (x : Source.localised.M) :
   Id Source.localised.M (Source.localised.sm (RM.map (AF.inclusion g) a) x) (R.Local[g].Native.localised.sm a x) =
   Source.ER.original-action a x ;
  target-action (a : A.R) (x : Target.restricted.M) :
   Id Target.restricted.M (Target.restricted.sm (RM.map (AF.inclusion g) a) x) (R.Local[OL.gh].Native.localised.sm a x) =
   trans (ap (\ r -> Destination.localised.sm r x) (R.R.rho-on g OL.gh OL.below a)) (Destination.ER.original-action a x) ;
  module SourcePower = LC.At[AF.Loc g,Source.localised,coefficient] ;
  module SourceNativePower = LC.At[A,R.Local[g].Native.localised,h] ;
  module TargetPower = LC.At[AF.Loc g,Target.restricted,coefficient] ;
  module TargetNativePower = LC.At[A,R.Local[OL.gh].Native.localised,h] ;
  source-power : (r : Nat) (x : Source.localised.M) ->
   Id Source.localised.M (SourcePower.power r x) (SourceNativePower.power r x) = split {
   zero -> \ x -> trans (SourcePower.power-at-zero x) (sym (SourceNativePower.power-at-zero x)) ;
   suc r | ih -> \ x -> trans (SourcePower.power-at-suc r x)
    (trans (ap (Source.localised.sm coefficient) (ih x))
     (trans (source-action h (SourceNativePower.power r x)) (sym (SourceNativePower.power-at-suc r x)))) } ;
  target-power : (r : Nat) (x : Target.restricted.M) ->
   Id Target.restricted.M (TargetPower.power r x) (TargetNativePower.power r x) = split {
   zero -> \ x -> trans (TargetPower.power-at-zero x) (sym (TargetNativePower.power-at-zero x)) ;
   suc r | ih -> \ x -> trans (TargetPower.power-at-suc r x)
    (trans (ap (Target.restricted.sm coefficient) (ih x))
     (trans (target-action h (TargetNativePower.power r x)) (sym (TargetNativePower.power-at-suc r x)))) } ;
  source-power-action (r : Nat) (x : Source.localised.M) :
   Id Source.localised.M (Source.localised.sm (CP.power coefficient r) x) (R.Local[g].Native.localised.sm (AP.power h r) x) =
   trans (sym (SourcePower.power-scalar r x)) (trans (source-power r x) (SourceNativePower.power-scalar r x)) ;
  target-power-action (r : Nat) (x : Target.restricted.M) :
   Id Target.restricted.M (Target.restricted.sm (CP.power coefficient r) x) (R.Local[OL.gh].Native.localised.sm (AP.power h r) x) =
   trans (sym (TargetPower.power-scalar r x)) (trans (target-power r x) (TargetNativePower.power-scalar r x)) ;
  Clear (y : Target.restricted.M) : U l = (r : Nat) * (x : Source.localised.M) *
   Id Target.restricted.M (H.map restriction x) (Target.restricted.sm (CP.power coefficient r) y) ;
  clear (y : Target.restricted.M) : Tr.Trunc[Clear y].carrier =
   Tr.Trunc[OL.Clear y].induction @l (\ w -> Tr.Trunc[Clear y].carrier) (\ w -> Tr.Trunc[Clear y].proposition)
    (\ w -> Tr.Trunc[Clear y].inc (w.1,w.2.1,
     trans (restriction-at w.2.1) (trans w.2.2 (sym (target-power-action w.1 y))))) (OL.clear y) ;
  Kill (x : Source.localised.M) : U l = (r : Nat) * Id Source.localised.M
   (Source.localised.sm (CP.power coefficient r) x) Source.localised.mz ;
  kill (x : Source.localised.M) (e : Id Target.restricted.M (H.map restriction x) Target.restricted.mz) :
   Tr.Trunc[Kill x].carrier =
   Tr.Trunc[OL.Kill x].induction @l (\ w -> Tr.Trunc[Kill x].carrier) (\ w -> Tr.Trunc[Kill x].proposition)
    (\ w -> Tr.Trunc[Kill x].inc (w.1,trans (source-power-action w.1 x) w.2))
    (OL.kill x (trans (sym (restriction-at x)) e)) ;
  module InvertibleTarget = R.At[h,OL.gh,OV.Sp.scaled h g] ;
  invertible : Pr.isEquiv Target.restricted.M Target.restricted.M (Target.restricted.sm coefficient) =
   Iso[l].equiv-homotopy Target.restricted.M Target.restricted.M
    (R.Local[OL.gh].Native.localised.sm h) (Target.restricted.sm coefficient)
    (\ x -> sym (target-action h x)) InvertibleTarget.invertible ;
  module Comparison = SerreModuleBasicRestrictionsComparison[l].Over[
   AF.Loc g,Source.localised,Target.restricted,coefficient,restriction,invertible,clear,kill] ;
  canonical-equation (x : Source.localised.M) : Id Target.restricted.M
   (Comparison.forward (SourcePower.fraction x zero)) (P.map x) =
   trans (Comparison.on-original x) (restriction-at x) ;
  opaque restriction ;
  opaque invertible ;
 } ;
} ;
