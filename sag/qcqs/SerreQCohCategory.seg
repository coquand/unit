-- QCoh(X): the univalent category of quasi-coherent module sheaves on a
-- locally ringed lattice X (PLAN-QCOH-UA, step 2).
-- Informal proof.  Quasi-coherence (SerreQuasiCoherent.IsQuasiCoherent)
-- is a truncation, hence a proposition (is-qc-prop), at level l+.  The
-- full subcategory of the univalent category of module sheaves on
-- (L, X.sheaf) (SerreModuleSheafCategory) on this property is univalent
-- (FullSubcategory).  Its arrows and isos are those of module sheaves.
level l ;
module DL = DistLattice[l] ;
module On (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged) {
 module Sheaves = SerreModuleSheafCategory[l].On[L,X.sheaf] ;
 quasi-coherent (M : Sheaves.precategory.ob) : U l+ = SerreQuasiCoherent[l].On[L,X,M].IsQuasiCoherent ;
 module Sub = FullSubcategory[l+,l].Over[Sheaves.category,quasi-coherent,\ M -> SerreQuasiCoherent[l].On[L,X,M].is-qc-prop] ;
 precategory : Category[l+,l+].Precategory = Sub.precategory ;
 univalent : Category[l+,l+].Univalent precategory = Sub.univalent ;
 category : Category[l+,l+].Category = Sub.category ;
} ;
