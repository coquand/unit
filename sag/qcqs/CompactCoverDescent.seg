-- Descent of natural maps along a finite compact-open cover.
-- Let U_i cover an arbitrary functor F, let H be a Zariski sheaf, and let
-- alpha_i:|U_i|->H agree on intersections (the same x with both membership
-- proofs).  No sheaf condition on F is required.
--
-- At x in F(B), a candidate y in H(B) FITS if for every h:B->C and i,
-- whenever F(h)x belongs to U_i its image alpha_i equals H(h)y.
-- This is a proposition: choose, merely, a finite basic refinement of
-- the cover U_i(x).  The fitting equations give equality of candidates
-- on that basic cover, and sheaf separation gives equality in H(B).
-- Matching equations are propositions, so the full candidate type is one.
--
-- For existence take such a refinement a_k tagged by i(k).  Membership
-- of F(beta_k)x follows from D(a_k)<=U_i(k)(x).  Apply alpha_i(k) to these
-- points.  Their images agree on pairwise overlaps by naturality, the
-- functor laws, and the assumed overlap agreement.  Glue in H(B).
-- To check fitting after any h:B->C, use the cover h(a_k) of C.  The
-- localisation base-change square compares both restrictions with the
-- given alpha_i(k) value.  Overlap agreement compares it with alpha_i
-- on the chosen U_i.  Separation in H(C) proves the fitting equation.
-- Eliminate the merely existing refinement only into the proposition of
-- fitting candidates.  Fitting is stable under change of B, so uniqueness
-- proves naturality.  At an actual member of U_i, the fitting equation at
-- the identity gives the required extension equation.  Any other natural
-- extension fits, by its naturality and local equation, hence is equal.
-- All transformation and fitting types are in U(l+1); values stay in U l.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Hi = Prelude[l+] ;
module Tr = Truncation[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module BigFE = Axioms[l+].FunExtLemmas[fe @l+] ;
module DL = DistLattice[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module CO = CompactOpens[l] ;
module TS = TestSheaves[l] ;
module ZF = ZariskiFunctor[l] ;
module Over (F H : SF.SetFunctor) (sheaf : TS.IsSheaf H) (n : Nat) (us : Fin n -> CO.Over[F].Open)
 (covers : (B : T.Test) (x : F.obj B) -> Id T.At[B].Z.lattice.L
  (T.At[B].Z.J.bigJ n (\ i -> CO.Over[F].value (us i) B x)) T.At[B].Z.lattice.top) {
 module C = CO.Over[F] ;
 module Piece (i : Fin n) {
  module R = OpenRealisation[l].Over[F,us i] ;
  module N = SF.Transform[R.functor,H] ;
  module M = CompactMembership[l].Over[F,us i] ;
 } ;
 module Family (alphas : (i : Fin n) -> Piece[i].N.Nat) {
  value (B : T.Test) (x : F.obj B) (i : Fin n) (m : Piece[i].R.Member B x) : H.obj B = Piece[i].N.at (alphas i) B (x,m) ;
  value-eq (B : T.Test) (x y : F.obj B) (e : Id (F.obj B) x y) (i : Fin n)
   (m : Piece[i].R.Member B x) (m' : Piece[i].R.Member B y) : Id (H.obj B) (value B x i m) (value B y i m') =
   ap (Piece[i].N.at (alphas i) B) (Piece[i].R.point-ext B (x,m) (y,m') e) ;
  value-natural (B D : T.Test) (h : RH.Hom B.ring D.ring) (x : F.obj B) (i : Fin n) (m : Piece[i].R.Member B x) :
   Id (H.obj D) (H.reindex B D h (value B x i m))
    (value D (F.reindex B D h x) i (Piece[i].R.member {D} (Piece[i].R.reindex B D h (x,m)))) =
   sym (Piece[i].N.natural (alphas i) B D h (x,m)) ;
  Compatible : U l+ = (B : T.Test) (x : F.obj B) (i j : Fin n) (mi : Piece[i].R.Member B x) (mj : Piece[j].R.Member B x) ->
   Id (H.obj B) (value B x i mi) (value B x j mj) ;
  module Glue (compatible : Compatible) {
   agree-eq (B : T.Test) (x y : F.obj B) (e : Id (F.obj B) x y) (i j : Fin n)
    (mi : Piece[i].R.Member B x) (mj : Piece[j].R.Member B y) : Id (H.obj B) (value B x i mi) (value B y j mj) =
    idJ (F.obj B) x (\ z eq -> (m : Piece[j].R.Member B z) -> Id (H.obj B) (value B x i mi) (value B z j m))
     (\ m -> compatible B x i j mi m) y e mj ;
   module At (B : T.Test) (x : F.obj B) {
    module Z = T.At[B].Z ;
    Fits (y : H.obj B) : U l+ = (D : T.Test) (h : RH.Hom B.ring D.ring) (i : Fin n)
     (m : Piece[i].R.Member D (F.reindex B D h x)) ->
     Id (H.obj D) (H.reindex B D h y) (value D (F.reindex B D h x) i m) ;
    fits-prop (y : H.obj B) : Hi.isProp (Fits y) =
     BigFE.isProp-Pi T.Test (\ D -> (h : RH.Hom B.ring D.ring) (i : Fin n) (m : Piece[i].R.Member D (F.reindex B D h x)) ->
      Id (H.obj D) (H.reindex B D h y) (value D (F.reindex B D h x) i m)) (\ D ->
      BigFE.isProp-Pi (RH.Hom B.ring D.ring) (\ h -> (i : Fin n) (m : Piece[i].R.Member D (F.reindex B D h x)) ->
       Id (H.obj D) (H.reindex B D h y) (value D (F.reindex B D h x) i m)) (\ h ->
       BigFE.isProp-Pi (Fin n) (\ i -> (m : Piece[i].R.Member D (F.reindex B D h x)) ->
        Id (H.obj D) (H.reindex B D h y) (value D (F.reindex B D h x) i m)) (\ i ->
        BigFE.isProp-Pi (Piece[i].R.Member D (F.reindex B D h x)) (\ m ->
         Id (H.obj D) (H.reindex B D h y) (value D (F.reindex B D h x) i m)) (\ m -> H.set D _ _)))) ;
    Candidates : U l+ = (y : H.obj B) * Fits y ;
    module Refined (r : Z.Refinement n (\ i -> C.value (us i) B x)) {
     generators (k : Fin (Z.count r)) : B.ring.R = Z.piece r k ;
     covers-basic : Id Z.lattice.L (Z.J.bigJ (Z.count r) (\ k -> Z.D (generators k))) Z.lattice.top =
      trans (sym (Z.refines r)) (covers B x) ;
     cover : TS.CoverData = (B,Z.count r,generators,covers-basic) ;
     module D = TS.OnCover[H,cover].D ;
     module CH = D.For[H] ;
     module CF = D.For[F] ;
     module Local (k : Fin (Z.count r)) {
      module M = Piece[Z.tag r k].M.Basic[B,x,generators k,Z.tag-below r k] ;
     } ;
     values : CH.Values = \ k -> value (D.basic k) (CF.restrictions x k) (Z.tag r k) Local[k].M.member ;
     compatible-values : CH.Compatible values = \ k k' ->
      trans (value-natural (D.basic k) (D.double k k') (D.left k k') (CF.restrictions x k) (Z.tag r k) Local[k].M.member)
       (trans (agree-eq (D.double k k') _ _ (CF.compatible x k k') (Z.tag r k) (Z.tag r k')
         (Piece[Z.tag r k].R.member {D.double k k'} (Piece[Z.tag r k].R.reindex (D.basic k) (D.double k k') (D.left k k')
          (CF.restrictions x k,Local[k].M.member)))
         (Piece[Z.tag r k'].R.member {D.double k k'} (Piece[Z.tag r k'].R.reindex (D.basic k') (D.double k k') (D.right k k')
          (CF.restrictions x k',Local[k'].M.member))))
        (sym (value-natural (D.basic k') (D.double k k') (D.right k k') (CF.restrictions x k') (Z.tag r k') Local[k'].M.member))) ;
     amalgams : Localisation[l].isContr (CH.Amalgam values) = sheaf cover values compatible-values ;
     glued : H.obj B = amalgams.1.1 ;
     matches (k : Fin (Z.count r)) : Id (H.obj (D.basic k)) (CH.restrictions glued k) (values k) = amalgams.1.2 k ;
     equal (y z : Candidates) : Id (H.obj B) y.1 z.1 =
      TS.SheafProperties[H,sheaf].On[cover].separated y.1 z.1 (\ k ->
       trans (y.2 (D.basic k) (D.AB.inclusion (generators k)) (Z.tag r k) Local[k].M.member)
        (sym (z.2 (D.basic k) (D.AB.inclusion (generators k)) (Z.tag r k) Local[k].M.member))) ;
     module Fitting (C' : T.Test) (h : RH.Hom B.ring C'.ring) (i : Fin n) (m : Piece[i].R.Member C' (F.reindex B C' h x)) {
      module ZC = T.At[C'].Z ;
      module HM = ZF.OnMap[B,C',h] ;
      covers-pulled : Id ZC.lattice.L (ZC.J.bigJ (Z.count r) (\ k -> ZC.D (map h (generators k)))) ZC.lattice.top =
       trans (ap (ZC.J.bigJ (Z.count r)) (FE.funext (Fin (Z.count r)) (\ k -> ZC.lattice.L)
         (\ k -> ZC.D (map h (generators k))) (\ k -> DL.hmap HM.lattice-map (Z.D (generators k)))
         (\ k -> sym (HM.on-D (generators k)))))
        (trans (sym (DL.JoinMaps[Z.lattice,ZC.lattice,HM.lattice-map].preserves (Z.count r) (\ k -> Z.D (generators k))))
         (trans (ap (DL.hmap HM.lattice-map) covers-basic) (DL.hmap-top HM.lattice-map))) ;
      pulled : TS.CoverData = (C',Z.count r,\ k -> map h (generators k),covers-pulled) ;
      module DC = TS.OnCover[H,pulled].D ;
      module HC = DC.For[H] ;
      module AtLocal (k : Fin (Z.count r)) {
       module BC = LocalisationTests[l].BaseChange[B,C',h,generators k] ;
       module FH = BC.Functor[H] ;
       module FF = BC.Functor[F] ;
       left-member : Piece[Z.tag r k].R.Member (DC.basic k)
        (F.reindex (D.basic k) (DC.basic k) BC.map-local (CF.restrictions x k)) =
        Piece[Z.tag r k].R.member {DC.basic k}
         (Piece[Z.tag r k].R.reindex (D.basic k) (DC.basic k) BC.map-local (CF.restrictions x k,Local[k].M.member)) ;
       right-member : Piece[i].R.Member (DC.basic k)
        (F.reindex C' (DC.basic k) (DC.AB.inclusion (map h (generators k))) (F.reindex B C' h x)) =
        Piece[i].R.member {DC.basic k} (Piece[i].R.reindex C' (DC.basic k) (DC.AB.inclusion (map h (generators k))) (F.reindex B C' h x,m)) ;
       equation : Id (H.obj (DC.basic k)) (HC.restrictions (H.reindex B C' h glued) k)
        (HC.restrictions (value C' (F.reindex B C' h x) i m) k) =
        trans (FH.equation glued)
         (trans (ap (H.reindex (D.basic k) (DC.basic k) BC.map-local) (matches k))
          (trans (value-natural (D.basic k) (DC.basic k) BC.map-local (CF.restrictions x k) (Z.tag r k) Local[k].M.member)
           (trans (agree-eq (DC.basic k) _ _ (sym (FF.equation x)) (Z.tag r k) i left-member right-member)
            (sym (value-natural C' (DC.basic k) (DC.AB.inclusion (map h (generators k))) (F.reindex B C' h x) i m))))) ;
      } ;
      fits : Id (H.obj C') (H.reindex B C' h glued) (value C' (F.reindex B C' h x) i m) =
       TS.SheafProperties[H,sheaf].On[pulled].separated (H.reindex B C' h glued) (value C' (F.reindex B C' h x) i m)
        (\ k -> AtLocal[k].equation) ;
     } ;
     candidate : Candidates = (glued,\ C' h i m -> Fitting[C',h,i,m].fits) ;
    } ;
    candidates-prop : Hi.isProp Candidates = \ y z -> Hi.Sigma-eq (H.obj B) Fits y.1 z.1 y.2 z.2
     (Tr.Trunc[Z.Refinement n (\ i -> C.value (us i) B x)].induction @l (\ r -> Id (H.obj B) y.1 z.1)
      (\ r -> H.set B y.1 z.1) (\ r -> Refined[r].equal y z) (Z.refined n (\ i -> C.value (us i) B x))) (fits-prop z.1) ;
    candidate : Candidates = Tr.Trunc[Z.Refinement n (\ i -> C.value (us i) B x)].induction @(l+)
     (\ r -> Candidates) (\ r -> candidates-prop) (\ r -> Refined[r].candidate) (Z.refined n (\ i -> C.value (us i) B x)) ;
    result : H.obj B = candidate.1 ;
    fits : Fits result = candidate.2 ;
    opaque candidate ;
   } ;
   module Natural (B C' : T.Test) (h : RH.Hom B.ring C'.ring) (x : F.obj B) {
    module A = At[B,x] ;
    module AC = At[C',F.reindex B C' h x] ;
    module FitsAfter (D : T.Test) (k : RH.Hom C'.ring D.ring) (i : Fin n)
     (m : Piece[i].R.Member D (F.reindex C' D k (F.reindex B C' h x))) {
     direct : Piece[i].R.Member D (F.reindex B D (RH.compose B.ring C'.ring D.ring k h) x) =
      Pr.subst (F.obj D) (Piece[i].R.Member D) _ _ (sym (F.composition B C' D h k x)) m ;
     equation : Id (H.obj D) (H.reindex C' D k (H.reindex B C' h A.result))
      (value D (F.reindex C' D k (F.reindex B C' h x)) i m) =
      trans (sym (H.composition B C' D h k A.result))
       (trans (A.fits D (RH.compose B.ring C'.ring D.ring k h) i direct)
        (value-eq D _ _ (F.composition B C' D h k x) i direct m)) ;
    } ;
    candidate : AC.Candidates = (H.reindex B C' h A.result,\ D k i m -> FitsAfter[D,k,i,m].equation) ;
    equation : Id (H.obj C') AC.result (H.reindex B C' h A.result) =
     Hi.ap AC.Candidates (H.obj C') (\ z -> z.1) AC.candidate candidate (AC.candidates-prop AC.candidate candidate) ;
   } ;
   module N = SF.Transform[F,H] ;
   extension : N.Nat = (\ B x -> At[B,x].result,\ B C' h x -> Natural[B,C',h,x].equation) ;
   module LocalEquation (B : T.Test) (x : F.obj B) (i : Fin n) (m : Piece[i].R.Member B x) {
    at-identity : Piece[i].R.Member B (F.reindex B B (RH.identity B.ring) x) =
     Pr.subst (F.obj B) (Piece[i].R.Member B) x (F.reindex B B (RH.identity B.ring) x) (sym (F.identity B x)) m ;
    equation : Id (H.obj B) (N.at extension B x) (value B x i m) =
     trans (sym (H.identity B At[B,x].result))
      (trans (At[B,x].fits B (RH.identity B.ring) i at-identity) (value-eq B _ _ (F.identity B x) i at-identity m)) ;
   } ;
   Matches (beta : N.Nat) : U l+ = (i : Fin n) -> Id Piece[i].N.Nat
    SF.Composite[Piece[i].R.functor,F,H,beta,Piece[i].R.inclusion].composite (alphas i) ;
   matches : Matches extension = \ i -> Piece[i].N.ext
    SF.Composite[Piece[i].R.functor,F,H,extension,Piece[i].R.inclusion].composite (alphas i)
    (\ B p -> LocalEquation[B,Piece[i].R.point {B} p,i,Piece[i].R.member {B} p].equation) ;
   module Other (beta : N.Nat) (on : Matches beta) {
    module Point (B : T.Test) (x : F.obj B) {
     fitting : At[B,x].Fits (N.at beta B x) = \ D h i m ->
      trans (sym (N.natural beta B D h x))
       (Hi.ap Piece[i].N.Nat (H.obj D) (\ a -> Piece[i].N.at a D (F.reindex B D h x,m))
        SF.Composite[Piece[i].R.functor,F,H,beta,Piece[i].R.inclusion].composite (alphas i) (on i)) ;
     equation : Id (H.obj B) (N.at extension B x) (N.at beta B x) =
      Hi.ap At[B,x].Candidates (H.obj B) (\ a -> a.1) At[B,x].candidate (N.at beta B x,fitting)
       (At[B,x].candidates-prop At[B,x].candidate (N.at beta B x,fitting)) ;
    } ;
    unique : Id N.Nat extension beta = N.ext extension beta (\ B x -> Point[B,x].equation) ;
   } ;
   Extensions : U l+ = (beta : N.Nat) * Matches beta ;
   matches-prop (beta : N.Nat) : Hi.isProp (Matches beta) =
    BigFE.isProp-Pi (Fin n) (\ i -> Id Piece[i].N.Nat SF.Composite[Piece[i].R.functor,F,H,beta,Piece[i].R.inclusion].composite (alphas i))
     (\ i -> Piece[i].N.set _ _) ;
   contract (b : Extensions) : Id Extensions (extension,matches) b =
    Hi.Sigma-eq N.Nat Matches extension b.1 matches b.2 Other[b.1,b.2].unique (matches-prop b.1) ;
   universal : Localisation[l+].isContr Extensions = ((extension,matches),contract) ;
  } ;
 } ;
} ;
