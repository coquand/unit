-- A quasi-coherent module is lambda-local on every open (Serre note,
-- Corollary 4.7): for every open w of X and every g in O(w),
-- lambda_(w,g) : M(w)_g -> M(D_w g) is an equivalence.
-- Proof. Say M is good at w when all lambda_(w,g) are equivalences.
--  (1) Chart opens. Let w be an affine chart with a model and h in
--   B = O(w); put v = D_w(h). Every c in O(v) is e (x|v) with e a unit:
--   lambda for O at (w,h) is bijective (SerreLambdaChart), so c is the
--   image of some x/h^p, and h^p c = x|v with h|v a unit. M is good at
--   (v, x|v) by the lambda-criterion (SerreLambdaModel.Principal), hence at
--   (v, c) (SerreLambdaUnit).
--  (2) Opens u below a chart w. The preimage of u in Zar(B) is merely
--   D(h_1) \/ .. \/ D(h_n); so u is covered by the chart opens D_w(h_i),
--   whose meets D_w(h_i h_k) are chart opens. Pure descent on the slice
--   X|u (SerreLocalisationDescent), with members and overlaps read on X
--   (SerreLambdaNested), gives goodness at u.
--  (3) Any open w. For an atlas w_1, .., w_m the w /\ w_j cover w, and
--   they and their meets lie below the charts w_j: descent on X|w by (2).
-- Hence on an affine open w the lambda-criterion gives a model of M at w,
-- and every M-torsor merely has a section over w (SerreTorsorChart).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module BigTr = Truncation[l+] ;
module DL = DistLattice[l] ; module RH = RingHom[l] ; module RM = RingMaps[l] ;
module MS = SerreModuleSheaf[l] ; module IT = IdentityTools[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module On (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged) (M : MS.On[L,X.sheaf].ModuleSheaf) {
 module QC = SerreQuasiCoherent[l].On[L,X,M] ;
 module Q = Qcqs[l].Over[L,X] ;
 module O = DL.Order[L] ; module J = DL.Joins[L] ;
 module GO = RingedLattice[l].On[L].Of[X.sheaf] ;
 module LX = LocallyRinged[l].On[L].Laws[X.sheaf,X.inv] ;
 module IX = InvOpen[l].On[L].Of[X.sheaf] ;
 module ST = SerreModuleSheafStructure[l].On[L,X.sheaf,X.is-sheaf] ;
 -- M is good at a
 module Lam (a : L.L) (c : (X.sheaf.ring a).R) {
  module L0 = SerreLambda[l].On[L,X,M,a].At[c] ;
  prop : Pr.isProp L0.IsEquivalence =
   IT.Equivalence[L0.Source,(M.presheaf.module-at L0.open-g).M,L0.C.E.S.carrier-set,
    (M.presheaf.module-at L0.open-g).setM,L0.map].equal ;
 } ;
 Good (a : L.L) : U l = (c : (X.sheaf.ring a).R) -> SerreLambda[l].On[L,X,M,a].At[c].IsEquivalence ;
 good-prop (a : L.L) : Pr.isProp (Good a) =
  FE.isProp-Pi (X.sheaf.ring a).R (\ c -> SerreLambda[l].On[L,X,M,a].At[c].IsEquivalence) (\ c -> Lam[a,c].prop) ;
 -- (1) chart opens
 module ChartOpens (w : L.L) (affine : Q.AffineOpen w) (model : QC.At[w].Model) (h : (X.sheaf.ring w).R) {
  module LM = SerreLambdaModel[l].On[L,X,M,w,model] ;
  v : L.L = LX.d w h ;
  le : O.Le v w = IX.below (LX.d-open w h) ;
  v-eq : Id L.L (LM.S.inc (LM.chart-open h)) v = ap LM.S.inc (LM.CanonicalMap.pi-D h) ;
  module Ch = SerreLambdaChart[l].On[L,X,w,affine].At[h] ;
  module ClO = SerreLambdaClearing[l].On[L,X,ST.structure,w,h] ;
  module AP = AffinePowers[l].Over[X.sheaf.ring v] ;
  module APw = AffinePowers[l].Over[X.sheaf.ring w] ;
  A : CRing = X.sheaf.ring v ;
  module Fraction (c : A.R) (x : (X.sheaf.ring w).R) (p : Nat) (e : Id A.R (Ch.Lam.map (ClO.E.S.fraction x p)) c) {
   q : A.R = RM.map ClO.C.ring-map (APw.power h p) ;
   q-power : Id A.R q (AP.power (RM.map ClO.C.ring-map h) p) =
    AffinePowers[l].power-map (X.sheaf.ring w) A ClO.C.ring-map h p ;
   q-unit : RL[A].unit q =
    Pr.subst A.R (\ t -> RL[A].unit t) _ _ (sym q-power) (AP.Units[X.sheaf.ring-set v].power-unit (RM.map ClO.C.ring-map h) ClO.C.unit p) ;
   a : A.R = GO.restrict v w le x ;
   -- h^p c = x|v
   z : A.R = Ch.Lam.map (ClO.E.S.fraction x p) ;
   scaled : Id A.R (A.mul q z) (ClO.E.T.power p z) = sym (ClO.E.T.power-scalar p z) ;
   cleared : Id A.R (A.mul q c) a = calc A.R {
    A.mul q c
     =< ap (A.mul q) (sym e) > A.mul q z
     =< scaled > ClO.E.T.power p z
     =< ClO.clears x p > ClO.E.H.map ClO.C.original x
     =< ClO.C.original-at x > GO.restrict v w ClO.Lam.below x
     =< GO.res-irr v w ClO.Lam.below le x > a } ;
   inverse : A.R = q-unit.1 ;
   inverse-unit : RL[A].unit inverse = (q,trans (A.mulC inverse q) q-unit.2) ;
   form : Id A.R (A.mul inverse a) c = calc A.R {
    A.mul inverse a
     =< ap (A.mul inverse) (sym cleared) > A.mul inverse (A.mul q c)
     =< A.mulA inverse q c > A.mul (A.mul inverse q) c
     =< ap (\ t -> A.mul t c) inverse-unit.2 > A.mul A.o c
     =< A.mulC A.o c > A.mul c A.o
     =< A.mulO c > c } ;
   module P0 = LM.Principal[h,x,v,le,v-eq] ;
   module U0 = SerreLambdaUnit[l].On[L,X,M,v,a,inverse,inverse-unit,P0.equivalence] ;
   good : SerreLambda[l].On[L,X,M,v].At[c].IsEquivalence =
    Pr.subst A.R (\ t -> SerreLambda[l].On[L,X,M,v].At[t].IsEquivalence) _ _ form U0.equivalence ;
  } ;
  at (c : A.R) : SerreLambda[l].On[L,X,M,v].At[c].IsEquivalence =
   ClO.E.S.induction @l (\ z -> Id A.R (Ch.Lam.map z) c -> SerreLambda[l].On[L,X,M,v].At[c].IsEquivalence)
    (\ z -> FE.isProp-Pi (Id A.R (Ch.Lam.map z) c) (\ t -> SerreLambda[l].On[L,X,M,v].At[c].IsEquivalence) (\ t -> Lam[v,c].prop))
    (\ x p e -> Fraction[c,x,p,e].good)
    (Ch.equivalence.sec c) (Ch.equivalence.sec-eq c) ;
  good : Good v = at ;
 } ;
 -- (2) opens below a chart
 module Below (w : L.L) (affine : Q.AffineOpen w) (model : QC.At[w].Model) (u : L.L) (u-le : O.Le u w) {
  module LM = SerreLambdaModel[l].On[L,X,M,w,model] ;
  module AC = LM.AC ; module Z = AC.ZG ; module ZJ = DL.Joins[Z.lattice] ;
  module P = DL.JoinMaps[Z.lattice,LM.S.lattice,AC.canonical.lat] ;
  module Families = Radical[l].Over[X.sheaf.ring w] ;
  module Su = Slice[l].Over[L,X,u] ;
  module Ru = SerreModuleSheafRestriction[l].On[L,X,u,M] ;
  equiv : Pr.isEquiv Z.lattice.L LM.S.Opens (DL.hmap AC.canonical.lat) = AC.I.lat-equiv {AC.canonical} affine ;
  u-open : LM.S.Opens = (u,u-le) ;
  preimage : Z.lattice.L = equiv.sec u-open ;
  preimage-eq : Id L.L (LM.S.inc (DL.hmap AC.canonical.lat preimage)) u = ap LM.S.inc (equiv.sec-eq u-open) ;
  chart-d (g : (X.sheaf.ring w).R) : Id L.L (LM.S.inc (LM.chart-open g)) (LX.d w g) = ap LM.S.inc (LM.CanonicalMap.pi-D g) ;
  module Presented (p : Z.Presentation preimage) {
   n : Nat = Families.size (Z.generators p) ;
   h (i : Fin n) : (X.sheaf.ring w).R = Families.gen (Z.generators p) i ;
   member (i : Fin n) : L.L = LX.d w (h i) ;
   member-le (i : Fin n) : O.Le (member i) u =
    O.le-trans (member i) (LM.S.inc (DL.hmap AC.canonical.lat preimage)) u
     (O.le-trans (member i) (LM.S.inc (LM.chart-open (h i))) (LM.S.inc (DL.hmap AC.canonical.lat preimage))
      (O.le-of-eq _ _ (sym (chart-d (h i))))
      (LM.S.le-inc _ _ (P.monotone (Z.D (h i)) preimage (Z.gen-below p i))))
     (O.le-of-eq _ _ preimage-eq) ;
   us (i : Fin n) : Su.Opens = (member i,member-le i) ;
   joins : Id L.L u (J.bigJ n member) = calc L.L {
    u
     =< sym preimage-eq > LM.S.inc (DL.hmap AC.canonical.lat preimage)
     =< ap (\ t -> LM.S.inc (DL.hmap AC.canonical.lat t)) (Z.presents p)
      > LM.S.inc (DL.hmap AC.canonical.lat (ZJ.bigJ n (\ i -> Z.D (h i))))
     =< ap LM.S.inc (P.preserves n (\ i -> Z.D (h i))) > LM.S.inc (LM.S.JS.bigJ n (\ i -> LM.chart-open (h i)))
     =< LM.S.join-inc n (\ i -> LM.chart-open (h i)) > J.bigJ n (\ i -> LM.S.inc (LM.chart-open (h i)))
     =< ap (J.bigJ n) (FE.funext (Fin n) (\ i -> L.L) (\ i -> LM.S.inc (LM.chart-open (h i))) member (\ i -> chart-d (h i)))
      > J.bigJ n member } ;
   covers : Su.OS.Le Su.lattice.top (Su.JS.bigJ n us) =
    Su.le-in Su.lattice.top (Su.JS.bigJ n us) (O.le-trans u (J.bigJ n member) (Su.inc (Su.JS.bigJ n us))
     (O.le-of-eq _ _ joins) (O.le-of-eq _ _ (sym (Su.join-inc n us)))) ;
   -- meets of chart opens are chart opens
   overlap-eq (i k : Fin n) : Id L.L (LX.d w ((X.sheaf.ring w).mul (h i) (h k))) (L.meet (member i) (member k)) =
    LX.mul-law w (h i) (h k) ;
   overlap-good (i k : Fin n) : Good (L.meet (member i) (member k)) =
    Pr.subst L.L Good _ _ (overlap-eq i k) ChartOpens[w,affine,model,(X.sheaf.ring w).mul (h i) (h k)].good ;
   module Fix (g : (X.sheaf.ring u).R) {
    member-lambda (i : Fin n) : SerreLambda[l].On[Su.lattice,Su.restricted,Ru.restricted,us i].At[
      RM.map (Su.sheaf.res (us i) Su.lattice.top (Su.OS.le-top (us i))) g].IsEquivalence =
     SerreLambdaNested[l].On[L,X,M,u,us i,RM.map (Su.sheaf.res (us i) Su.lattice.top (Su.OS.le-top (us i))) g,
      ChartOpens[w,affine,model,h i].good (RM.map (Su.sheaf.res (us i) Su.lattice.top (Su.OS.le-top (us i))) g)].equivalence ;
    overlap-lambda (i k : Fin n) : SerreLambda[l].On[Su.lattice,Su.restricted,Ru.restricted,Su.lattice.meet (us i) (us k)].At[
      RM.map (Su.sheaf.res (Su.lattice.meet (us i) (us k)) Su.lattice.top (Su.OS.le-top (Su.lattice.meet (us i) (us k)))) g].IsEquivalence =
     SerreLambdaNested[l].On[L,X,M,u,Su.lattice.meet (us i) (us k),
      RM.map (Su.sheaf.res (Su.lattice.meet (us i) (us k)) Su.lattice.top (Su.OS.le-top (Su.lattice.meet (us i) (us k)))) g,
      overlap-good i k (RM.map (Su.sheaf.res (Su.lattice.meet (us i) (us k)) Su.lattice.top (Su.OS.le-top (Su.lattice.meet (us i) (us k)))) g)].equivalence ;
    module Descent = SerreLocalisationDescent[l].Over[Su.lattice,Su.restricted,Ru.restricted,n,us,covers,g,member-lambda,overlap-lambda] ;
    lambda : SerreLambda[l].On[L,X,M,u].At[g].IsEquivalence = Descent.equivalence ;
   } ;
   good : Good u = \ g -> Fix[g].lambda ;
  } ;
  good : Good u = Tr.Trunc[Z.Presentation preimage].induction @l (\ t -> Good u) (\ t -> good-prop u)
   (\ p -> Presented[p].good) (Z.presented preimage) ;
 } ;
 -- (3) every open, from an atlas
 module At (w : L.L) {
  module Sw = Slice[l].Over[L,X,w] ;
  module Rw = SerreModuleSheafRestriction[l].On[L,X,w,M] ;
  module FromAtlas (atlas : QC.Atlas) {
   m : Nat = atlas.cover.count ;
   chart (j : Fin m) : L.L = atlas.cover.opens j ;
   member (j : Fin m) : L.L = L.meet w (chart j) ;
   us (j : Fin m) : Sw.Opens = (member j,O.meet-left w (chart j)) ;
   covers : Sw.OS.Le Sw.lattice.top (Sw.JS.bigJ m us) =
    Sw.le-in Sw.lattice.top (Sw.JS.bigJ m us) (O.le-trans w (J.bigJ m member) (Sw.inc (Sw.JS.bigJ m us))
     (J.meet-cover w m chart (O.le-trans w L.top (J.bigJ m chart) (O.le-top w) (O.le-of-eq _ _ (sym atlas.cover.covers))))
     (O.le-of-eq _ _ (sym (Sw.join-inc m us)))) ;
   member-good (j : Fin m) : Good (member j) =
    Below[chart j,atlas.cover.affine j,atlas.models j,member j,O.meet-right w (chart j)].good ;
   overlap-good (j k : Fin m) : Good (L.meet (member j) (member k)) =
    Below[chart j,atlas.cover.affine j,atlas.models j,L.meet (member j) (member k),
     O.le-trans _ (member j) _ (O.meet-left (member j) (member k)) (O.meet-right w (chart j))].good ;
   module Fix (g : (X.sheaf.ring w).R) {
    member-lambda (j : Fin m) : SerreLambda[l].On[Sw.lattice,Sw.restricted,Rw.restricted,us j].At[
      RM.map (Sw.sheaf.res (us j) Sw.lattice.top (Sw.OS.le-top (us j))) g].IsEquivalence =
     SerreLambdaNested[l].On[L,X,M,w,us j,RM.map (Sw.sheaf.res (us j) Sw.lattice.top (Sw.OS.le-top (us j))) g,
      member-good j (RM.map (Sw.sheaf.res (us j) Sw.lattice.top (Sw.OS.le-top (us j))) g)].equivalence ;
    overlap-lambda (j k : Fin m) : SerreLambda[l].On[Sw.lattice,Sw.restricted,Rw.restricted,Sw.lattice.meet (us j) (us k)].At[
      RM.map (Sw.sheaf.res (Sw.lattice.meet (us j) (us k)) Sw.lattice.top (Sw.OS.le-top (Sw.lattice.meet (us j) (us k)))) g].IsEquivalence =
     SerreLambdaNested[l].On[L,X,M,w,Sw.lattice.meet (us j) (us k),
      RM.map (Sw.sheaf.res (Sw.lattice.meet (us j) (us k)) Sw.lattice.top (Sw.OS.le-top (Sw.lattice.meet (us j) (us k)))) g,
      overlap-good j k (RM.map (Sw.sheaf.res (Sw.lattice.meet (us j) (us k)) Sw.lattice.top (Sw.OS.le-top (Sw.lattice.meet (us j) (us k)))) g)].equivalence ;
    module Descent = SerreLocalisationDescent[l].Over[Sw.lattice,Sw.restricted,Rw.restricted,m,us,covers,g,member-lambda,overlap-lambda] ;
    lambda : SerreLambda[l].On[L,X,M,w].At[g].IsEquivalence = Descent.equivalence ;
   } ;
   good : Good w = \ g -> Fix[g].lambda ;
  } ;
  good (qc : QC.IsQuasiCoherent) : Good w =
   BigTr.Trunc[QC.Atlas].induction @l (\ a -> Good w) (\ a -> good-prop w) (\ a -> FromAtlas[a].good) qc ;
 } ;
 -- Corollary 4.7, and torsors on affine opens
 module Of (qc : QC.IsQuasiCoherent) {
  lambda (w : L.L) : Good w = At[w].good qc ;
  model (w : L.L) (affine : Q.AffineOpen w) : QC.At[w].Model =
   SerreLambdaCriterion[l].On[L,X,M,w,affine,lambda w].model ;
  section (w : L.L) (affine : Q.AffineOpen w) (T : SerreTorsor[l].On[L,X.sheaf].Over[M].Torsor) :
   Tr.Trunc[T.presheaf.obj w].carrier = SerreTorsorChart[l].On[L,X,M,w,affine,model w affine,T].section ;
 } ;
} ;
