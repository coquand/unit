-- Abelian categories without Ab-enrichment (Elinder, Investigating
-- abelian categories in univalent type theory, §4.3-4.4; by Freyd the
-- enrichment follows from the rest).
--
-- In a precategory C: z is a zero object when it is initial and
-- terminal (contractible hom types). Given a zero object, the zero arrow
-- x -> y is x -> z -> y. A kernel of f : x -> y is i : k -> x with
-- f i = 0 through which every g with f g = 0 factors uniquely (the type of
-- factorisations is contractible); a cokernel is dual. A binary product
-- has contractible types of pairings, a coproduct of copairings. An arrow
-- m is monic when m g = m h implies g = h; epic dually. C is abelian when
-- it has a zero object, binary products and coproducts, kernels and
-- cokernels, every monic is merely a kernel (of some arrow) and every epic
-- merely a cokernel. These are structures (with chosen data); a property
-- of a category of the form IsX C transports along any C = D in
-- Category[k,k] by one subst.
--
-- Helpers. A factorisation through i is (h, i h = g); given one, c, and
-- that every factorisation has first component c.1, the type is
-- contractible (the second component lives in a hom set). If i is monic,
-- every factorisation has first component c.1. Dually for cofactorisations.
level k ; open Base ;
module P = Prelude[k] ; module Tr = Truncation[k] ;
module K = Category[k,k] ;
isContr (T : U k) : U k = FunExtUA[k].isContr T ;
module On (C : K.Precategory) {
 IsInitial (z : C.ob) : U k = (y : C.ob) -> isContr (C.hom z y) ;
 IsTerminal (z : C.ob) : U k = (x : C.ob) -> isContr (C.hom x z) ;
 IsZero (z : C.ob) : U k = IsInitial z * IsTerminal z ;
 Zero : U k = (z : C.ob) * IsZero z ;
 Monic (x y : C.ob) (m : C.hom x y) : U k = (w : C.ob) (g h : C.hom w x) ->
  Id (C.hom w y) (C.comp w x y m g) (C.comp w x y m h) -> Id (C.hom w x) g h ;
 Epic (x y : C.ob) (e : C.hom x y) : U k = (w : C.ob) (g h : C.hom y w) ->
  Id (C.hom x w) (C.comp x y w g e) (C.comp x y w h e) -> Id (C.hom y w) g h ;
 -- factorisations of g : w -> x through i : q -> x
 Factors (w q x : C.ob) (i : C.hom q x) (g : C.hom w x) : U k =
  (h : C.hom w q) * Id (C.hom w x) (C.comp w q x i h) g ;
 factors-contr (w q x : C.ob) (i : C.hom q x) (g : C.hom w x) (c : Factors w q x i g)
  (u : (v : Factors w q x i g) -> Id (C.hom w q) c.1 v.1) : isContr (Factors w q x i g) =
  (c,\ v -> P.Sigma-eq (C.hom w q) (\ h -> Id (C.hom w x) (C.comp w q x i h) g) c.1 v.1 c.2 v.2 (u v)
   (C.hom-set w x (C.comp w q x i v.1) g)) ;
 monic-factors (w q x : C.ob) (i : C.hom q x) (mono : Monic q x i) (g : C.hom w x) (c : Factors w q x i g)
  (v : Factors w q x i g) : Id (C.hom w q) c.1 v.1 =
  mono w c.1 v.1 (P.trans (C.hom w x) (C.comp w q x i c.1) g (C.comp w q x i v.1) c.2
   (P.sym (C.hom w x) (C.comp w q x i v.1) g v.2)) ;
 -- cofactorisations of g : y -> w through p : y -> c
 Cofactors (y c w : C.ob) (p : C.hom y c) (g : C.hom y w) : U k =
  (h : C.hom c w) * Id (C.hom y w) (C.comp y c w h p) g ;
 cofactors-contr (y c w : C.ob) (p : C.hom y c) (g : C.hom y w) (d : Cofactors y c w p g)
  (u : (v : Cofactors y c w p g) -> Id (C.hom c w) d.1 v.1) : isContr (Cofactors y c w p g) =
  (d,\ v -> P.Sigma-eq (C.hom c w) (\ h -> Id (C.hom y w) (C.comp y c w h p) g) d.1 v.1 d.2 v.2 (u v)
   (C.hom-set y w (C.comp y c w v.1 p) g)) ;
 epic-cofactors (y c w : C.ob) (p : C.hom y c) (epi : Epic y c p) (g : C.hom y w) (d : Cofactors y c w p g)
  (v : Cofactors y c w p g) : Id (C.hom c w) d.1 v.1 =
  epi w d.1 v.1 (P.trans (C.hom y w) (C.comp y c w d.1 p) g (C.comp y c w v.1 p) d.2
   (P.sym (C.hom y w) (C.comp y c w v.1 p) g v.2)) ;
 -- binary products and coproducts
 Pairings (w p x y : C.ob) (p1 : C.hom p x) (p2 : C.hom p y) (f : C.hom w x) (g : C.hom w y) : U k =
  (h : C.hom w p) * Id (C.hom w x) (C.comp w p x p1 h) f * Id (C.hom w y) (C.comp w p y p2 h) g ;
 IsProduct (x y p : C.ob) (p1 : C.hom p x) (p2 : C.hom p y) : U k =
  (w : C.ob) (f : C.hom w x) (g : C.hom w y) -> isContr (Pairings w p x y p1 p2 f g) ;
 Product (x y : C.ob) : U k = (p : C.ob) * (p1 : C.hom p x) * (p2 : C.hom p y) * IsProduct x y p p1 p2 ;
 HasProducts : U k = (x y : C.ob) -> Product x y ;
 Copairings (x y s w : C.ob) (i1 : C.hom x s) (i2 : C.hom y s) (f : C.hom x w) (g : C.hom y w) : U k =
  (h : C.hom s w) * Id (C.hom x w) (C.comp x s w h i1) f * Id (C.hom y w) (C.comp y s w h i2) g ;
 IsCoproduct (x y s : C.ob) (i1 : C.hom x s) (i2 : C.hom y s) : U k =
  (w : C.ob) (f : C.hom x w) (g : C.hom y w) -> isContr (Copairings x y s w i1 i2 f g) ;
 Coproduct (x y : C.ob) : U k = (s : C.ob) * (i1 : C.hom x s) * (i2 : C.hom y s) * IsCoproduct x y s i1 i2 ;
 HasCoproducts : U k = (x y : C.ob) -> Coproduct x y ;
 -- a pairing type is contractible once every pairing has the given first component
 pairings-contr (w p x y : C.ob) (p1 : C.hom p x) (p2 : C.hom p y) (f : C.hom w x) (g : C.hom w y)
  (c : Pairings w p x y p1 p2 f g) (u : (v : Pairings w p x y p1 p2 f g) -> Id (C.hom w p) c.1 v.1) :
  isContr (Pairings w p x y p1 p2 f g) =
  (c,\ v -> P.Sigma-eq (C.hom w p) (\ h -> Id (C.hom w x) (C.comp w p x p1 h) f * Id (C.hom w y) (C.comp w p y p2 h) g)
   c.1 v.1 c.2 v.2 (u v)
   (P.isProp-Sigma (Id (C.hom w x) (C.comp w p x p1 v.1) f) (\ e -> Id (C.hom w y) (C.comp w p y p2 v.1) g)
    (C.hom-set w x (C.comp w p x p1 v.1) f) (\ e -> C.hom-set w y (C.comp w p y p2 v.1) g))) ;
 copairings-contr (x y s w : C.ob) (i1 : C.hom x s) (i2 : C.hom y s) (f : C.hom x w) (g : C.hom y w)
  (c : Copairings x y s w i1 i2 f g) (u : (v : Copairings x y s w i1 i2 f g) -> Id (C.hom s w) c.1 v.1) :
  isContr (Copairings x y s w i1 i2 f g) =
  (c,\ v -> P.Sigma-eq (C.hom s w) (\ h -> Id (C.hom x w) (C.comp x s w h i1) f * Id (C.hom y w) (C.comp y s w h i2) g)
   c.1 v.1 c.2 v.2 (u v)
   (P.isProp-Sigma (Id (C.hom x w) (C.comp x s w v.1 i1) f) (\ e -> Id (C.hom y w) (C.comp y s w v.1 i2) g)
    (C.hom-set x w (C.comp x s w v.1 i1) f) (\ e -> C.hom-set y w (C.comp y s w v.1 i2) g))) ;
 -- kernels and cokernels, relative to a zero object
 module Zeros (z : Zero) {
  zero (x y : C.ob) : C.hom x y = C.comp x z.1 y ((z.2.1 y).1) ((z.2.2 x).1) ;
  IsKernel (x y : C.ob) (f : C.hom x y) (q : C.ob) (i : C.hom q x) : U k =
   Id (C.hom q y) (C.comp q x y f i) (zero q y) *
   ((w : C.ob) (g : C.hom w x) -> Id (C.hom w y) (C.comp w x y f g) (zero w y) -> isContr (Factors w q x i g)) ;
  Kernel (x y : C.ob) (f : C.hom x y) : U k = (q : C.ob) * (i : C.hom q x) * IsKernel x y f q i ;
  HasKernels : U k = (x y : C.ob) (f : C.hom x y) -> Kernel x y f ;
  IsCokernel (x y : C.ob) (f : C.hom x y) (c : C.ob) (p : C.hom y c) : U k =
   Id (C.hom x c) (C.comp x y c p f) (zero x c) *
   ((w : C.ob) (g : C.hom y w) -> Id (C.hom x w) (C.comp x y w g f) (zero x w) -> isContr (Cofactors y c w p g)) ;
  Cokernel (x y : C.ob) (f : C.hom x y) : U k = (c : C.ob) * (p : C.hom y c) * IsCokernel x y f c p ;
  HasCokernels : U k = (x y : C.ob) (f : C.hom x y) -> Cokernel x y f ;
  -- m : s -> a monic is merely the kernel of some f : a -> b
  MonicsAreKernels : U k = (s a : C.ob) (m : C.hom s a) -> Monic s a m ->
   Tr.Trunc[(b : C.ob) * (f : C.hom a b) * IsKernel a b f s m].carrier ;
  -- e : b -> s epic is merely the cokernel of some f : a -> b
  EpicsAreCokernels : U k = (b s : C.ob) (e : C.hom b s) -> Epic b s e ->
   Tr.Trunc[(a : C.ob) * (f : C.hom a b) * IsCokernel a b f s e].carrier ;
 } ;
 record Abelian {
  zero : Zero ;
  products : HasProducts ;
  coproducts : HasCoproducts ;
  kernels : Zeros[zero].HasKernels ;
  cokernels : Zeros[zero].HasCokernels ;
  monics : Zeros[zero].MonicsAreKernels ;
  epics : Zeros[zero].EpicsAreCokernels ;
 } ;
} ;
-- the notions as families over univalent categories, for transport
HasZero (C : K.Category) : U k = On[C.pre].Zero ;
HasKernels (C : K.Category) : U k = (z : On[C.pre].Zero) * On[C.pre].Zeros[z].HasKernels ;
HasCokernels (C : K.Category) : U k = (z : On[C.pre].Zero) * On[C.pre].Zeros[z].HasCokernels ;
HasProducts (C : K.Category) : U k = On[C.pre].HasProducts ;
HasCoproducts (C : K.Category) : U k = On[C.pre].HasCoproducts ;
IsAbelian (C : K.Category) : U k = On[C.pre].Abelian ;
-- transport along an identification of categories
module Transport (C D : K.Category) (e : Id K.Category C D) {
 move (F : K.Category -> U k) (x : F C) : F D = Prelude[k+].subst K.Category (\ X -> F X) C D e x ;
} ;
