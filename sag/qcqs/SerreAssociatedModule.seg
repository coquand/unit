-- The actual associated-module presheaf (Serre, Section 4).
-- Use the native localised module M_g with its checked A_g-action and
-- the actual semilinear restrictions of BasicRestrictionsScalar. Their
-- identity and composition equations instantiate the generic compatible
-- basic-family construction. Sheafhood is proved separately using the
-- degree-zero theorem; it is not an assumption of this construction.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module SM = SerreModule[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (Md : SM.Over[A].Module) {
 module AF = Affine[l].Over[A] ;
 module R = SerreModuleBasicRestrictions[l].Over[A,setA,Md] ;
 module SR = SerreModuleBasicRestrictionsScalar[l].Over[A,setA,Md] ;
 module G = SerreAssociatedSections[l].Over[A,AF.Loc,AF.set,AF.inclusion,AF.elementary] ;
 module Z = R.Z ; module O = Z.O ;
 system : G.System = new G.System[
  \ g -> R.Local[g].Scalars.localised,
  \ g h le -> SR.At[g,h,le].restriction,
  \ g le x -> trans (SR.At[g,g,le].restriction-at x) (R.rho-id g le x),
  \ g h k hg kh kg x -> trans (SR.At[h,k,kh].restriction-at
   (SR.At[g,h,hg].Maps.map SR.At[g,h,hg].restriction x))
   (trans (ap R.At[h,k,kh].map (SR.At[g,h,hg].restriction-at x))
    (trans (R.rho-comp g h k hg kh kg x) (sym (SR.At[g,k,kg].restriction-at x))))] ;
 module N = G.Of[system] ;
 component-restriction (g h : A.R) (le : O.Le (Z.D h) (Z.D g)) (x : R.Local[g].Native.L.Carrier) :
  Id R.Local[h].Native.L.Carrier (N.rho g h le x) (R.At[g,h,le].map x) =
  SR.At[g,h,le].restriction-at x ;
 -- The system record remains transparent for the dependent local modules;
 -- restriction constructions themselves are opaque behind their equations.
} ;
