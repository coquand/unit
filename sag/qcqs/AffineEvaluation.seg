-- Yoneda for affine sources, using all small test rings.
-- For alpha : h_(Spec A) -> h_Y, evaluate at 1_(Spec A).  A map y gives
-- the natural family p |-> y p (FunctorPoints.induced).  Evaluation of
-- this family is y by the right unit law.
-- Conversely, for p : Spec B -> Spec A, AffineTests.MapsEquivalence gives
-- a ring map beta : A -> B with Spec beta = p.  Naturality at beta and
-- the identity gives alpha_B(p) = alpha_A(1) p, by the left unit law.
-- Extensionality of natural families gives the other inverse law.
-- The equivalence is at level l+1: the family ranges over all small rings,
-- although Hom(Spec A,Y) itself is in U l.  No resizing is used.
level l ; open Ring[l] ;
module Hi = Prelude[l+] ;
module Sp = Spaces[l] ;
module T = AffineTests[l] ;
module FP = FunctorPoints[l] ;
module Over (A : T.Test) (Y : Sp.Space) {
 module N = FP.Maps[T.space A,Y] ;
 eval (alpha : N.Nat) : Sp.Hom (T.space A) Y = N.at alpha A Sp.Identity[T.space A].identity ;
 eval-induced (f : Sp.Hom (T.space A) Y) : Id (Sp.Hom (T.space A) Y) (eval (N.induced f)) f = Sp.Laws[T.space A,Y,f].right ;
 module At (alpha : N.Nat) (B : T.Test) (p : Sp.Hom (T.space B) (T.space A)) {
  module E = T.MapsEquivalence[A,B] ;
  at : Id (Sp.Hom (T.space B) Y) (N.at (N.induced (eval alpha)) B p) (N.at alpha B p) =
   calc (Sp.Hom (T.space B) Y) {
    Sp.compose (T.space B) (T.space A) Y (eval alpha) p
     =< ap (Sp.compose (T.space B) (T.space A) Y (eval alpha)) (sym (E.rebuild p))
      > Sp.compose (T.space B) (T.space A) Y (eval alpha) T.Map[A,B,E.extract p].morphism
     =< sym (N.natural alpha A B (E.extract p) Sp.Identity[T.space A].identity)
      > N.at alpha B (Sp.compose (T.space B) (T.space A) (T.space A) Sp.Identity[T.space A].identity T.Map[A,B,E.extract p].morphism)
     =< ap (N.at alpha B) Sp.Laws[T.space B,T.space A,T.Map[A,B,E.extract p].morphism].left
      > N.at alpha B T.Map[A,B,E.extract p].morphism
     =< ap (N.at alpha B) (E.rebuild p) > N.at alpha B p } ;
 } ;
 induced-eval (alpha : N.Nat) : Id N.Nat (N.induced (eval alpha)) alpha = N.ext (N.induced (eval alpha)) alpha (\ B p -> At[alpha,B,p].at) ;
 equivalence : Hi.isEquiv (Sp.Hom (T.space A) Y) N.Nat N.induced =
  Hi.qinv (Sp.Hom (T.space A) Y) N.Nat N.induced eval induced-eval eval-induced ;
} ;
