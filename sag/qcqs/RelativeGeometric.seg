-- The existing relative geometric point functor in the native interface.
-- Its values, reindexing, and laws are BasePoints.On, without a second
-- notion of point or map.  Totalising it forgets the unique base lift of
-- an ordinary affine point.  BasePoints' canonical lift is the inverse;
-- its total-ext proves uniqueness.  Naturality keeps the underlying
-- ordinary point and its defining precomposition unchanged (note §5).
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module T = AffineTests[l] ;
module SP = Spaces[l] ;
module SF = TestFunctors[l] ;
module TE = TestEquivalences[l] ;
module Over (K : T.Test) (X : SP.Space) (s : SP.Hom X (T.space K)) {
 module R = RelativeFunctors[l].Over[K] ;
 module BP = R.BP ;
 module P = BP.On[X,s] ;
 functor : R.SetFunctor = new R.SetFunctor[P.Points,P.set,\ A B h p -> P.Reindex[A,B,h,p].reindex,P.identity,P.composition] ;
 module TF = RelativeTotal[l].Over[K,functor] ;
 module G = SF.Geometric[X] ;
 transformation : SF.Transform[TF.functor,G.functor].Nat = (\ B p -> P.At[B].forget p,\ B C h p -> refl
  (G.functor.reindex B C h (P.At[B].forget p))) ;
 equivalence : TE.NaturalEquivalence TF.functor G.functor = (transformation,\ B -> P.At[B].forget-equivalence) ;
 opaque equivalence ;
} ;
