-- A local frame can be chosen with a global numerator. Every original
-- vector is a multiple of this numerator after multiplying by a power
-- of the chart element. A coefficient annihilating the numerator is
-- itself killed by a power, by injectivity of the local coordinate map.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module SM = SerreModule[l] ; module RM = RingMaps[l] ;
module LF = SerreLocalFrame[l] ; module CLE = SerreModuleClearErrors[l] ;
module At (A : CRing) (setA : Pr.isSet A.R) (M : SM.Over[A].Module) (f : A.R) {
 module G = LF.Over[A,setA] ; module F = G.At[M,f] ;
 LA : SM.Over[F.B].Module = F.LS.localised ; module B0 = RL[F.B] ;
 module Same = SerreModuleBasicRestrictionsScalar[l].Over[A,setA,M].At[f,f,G.O.le-refl (G.Z.D f)] ;
 module Br = Bridge[l].Over[A,f] ; module P = F.Powers ;
 Numerator : U l = (x : M.M) * F.Coord[F.F.fraction x zero].Basis ;
 module Frame (w : F.Frame) {
  module Read = F.With[w] ;
  lifted (x : M.M) (p : Nat) (q : Id F.F.Carrier (F.F.fraction x p) w.1) : Numerator =
   (x,EquivalenceLemmas[l].homotopy F.B.R F.F.Carrier
    (\ a -> LA.sm (F.h (P.power f p)) (Read.C.mul a)) F.Coord[F.F.fraction x zero].mul
    (\ a -> calc F.F.Carrier {
     LA.sm (F.h (P.power f p)) (Read.C.mul a)
      =< SM.Over[F.B].Laws[LA].sm-swap (F.h (P.power f p)) a w.1 > LA.sm a (LA.sm (F.h (P.power f p)) w.1)
      =< ap (LA.sm a) (trans (F.LS.ER.original-action (P.power f p) w.1)
       (trans (ap (F.N.localised.sm (P.power f p)) (sym q)) (F.Clear.clears x p))) > LA.sm a (F.F.fraction x zero) })
    (EquivalenceLemmas[l].compose F.B.R F.F.Carrier F.F.Carrier (LA.sm (F.h (P.power f p))) Read.C.mul
     SerreModuleBasicRestrictions[l].UnitAction[F.B,LA,F.h (P.power f p),
      Br.LocH.inverts (G.AF.elementary f) (P.power f p) (p,refl (P.power f p))].equiv w.2)) ;
  numerator : Tr.Trunc[Numerator].carrier =
   Tr.Trunc[(x : M.M) * (p : Nat) * Id F.F.Carrier (F.F.fraction x p) w.1].induction @l
    (\ r -> Tr.Trunc[Numerator].carrier) (\ r -> Tr.Trunc[Numerator].proposition)
    (\ r -> Tr.Trunc[Numerator].inc (lifted r.1 r.2.1 r.2.2)) (F.F.represented w.1) ;
 } ;
 module Generated (w : Numerator) {
  x : M.M = w.1 ;
  module Read = F.With[(F.F.fraction x zero,w.2)] ;
  Witness (y : M.M) : U l = (k : Nat) * (a : A.R) * Id M.M (M.sm (P.power f k) y) (M.sm a x) ;
  module AtVector (y : M.M) {
   loc : F.F.Carrier = F.F.fraction y zero ;
   coordinate : F.B.R = Read.read loc ;
   module Rep (r : Br.LocH.Fraction F.B (G.AF.inclusion f) coordinate) {
    k : Nat = Br.index (Br.LocH.den-in r) ;
    a : A.R = Br.LocH.num r ;
    denom : Id A.R (P.power f k) (Br.LocH.den r) = Br.index-eq (Br.LocH.den-in r) ;
    locally : Id F.F.Carrier (F.F.fraction (M.sm (P.power f k) y) zero) (F.F.fraction (M.sm a x) zero) = calc F.F.Carrier {
     F.F.fraction (M.sm (P.power f k) y) zero
      =< sym (F.N.Action.scale-at (P.power f k) y zero) > F.N.localised.sm (P.power f k) loc
      =< ap (\ b -> F.N.localised.sm b loc) denom > F.N.localised.sm (Br.LocH.den r) loc
      =< ap (F.N.localised.sm (Br.LocH.den r)) (sym (Read.expansion loc)) >
       F.N.localised.sm (Br.LocH.den r) (LA.sm coordinate (F.F.fraction x zero))
      =< Same.source-clears coordinate r (F.F.fraction x zero) > F.N.localised.sm a (F.F.fraction x zero)
      =< F.N.Action.scale-at a x zero > F.F.fraction (M.sm a x) zero } ;
    module AtWitness (v : F.F.Witness (M.sm (P.power f k) y,zero) (M.sm a x,zero)) {
     e : Nat = plus v.1 zero ;
     total : Witness y = (plus e k,A.mul (P.power f e) a,calc M.M {
      M.sm (P.power f (plus e k)) y
       =< ap (\ b -> M.sm b y) (P.power-add f e k) > M.sm (A.mul (P.power f e) (P.power f k)) y
       =< sym (M.smA (P.power f e) (P.power f k) y) > M.sm (P.power f e) (M.sm (P.power f k) y)
       =< sym (F.F.power-scalar e (M.sm (P.power f k) y)) > F.F.power e (M.sm (P.power f k) y)
       =< v.2 > F.F.power e (M.sm a x)
       =< F.F.power-scalar e (M.sm a x) > M.sm (P.power f e) (M.sm a x)
       =< M.smA (P.power f e) a x > M.sm (A.mul (P.power f e) a) x }) ;
    } ;
    witness : Tr.Trunc[Witness y].carrier =
     Tr.Trunc[F.F.Witness (M.sm (P.power f k) y,zero) (M.sm a x,zero)].induction @l
      (\ v -> Tr.Trunc[Witness y].carrier) (\ v -> Tr.Trunc[Witness y].proposition)
      (\ v -> Tr.Trunc[Witness y].inc AtWitness[v].total)
      (F.F.detect (M.sm (P.power f k) y) (M.sm a x) zero zero locally) ;
   } ;
   witness : Tr.Trunc[Witness y].carrier =
    Tr.Trunc[Br.LocH.Fraction F.B (G.AF.inclusion f) coordinate].induction @l
     (\ r -> Tr.Trunc[Witness y].carrier) (\ r -> Tr.Trunc[Witness y].proposition) (\ r -> Rep[r].witness)
     (Br.LocH.fractions (G.AF.elementary f) coordinate) ;
  } ;
  annihilator-local (a : A.R) (ann : Id M.M (M.sm a x) M.mz) : Id F.B.R (F.h a) F.B.z =
   Iso[l].injective F.B.R F.F.Carrier Read.C.mul w.2 (F.h a) F.B.z (calc F.F.Carrier {
    LA.sm (F.h a) (F.F.fraction x zero)
     =< F.LS.ER.original-action a (F.F.fraction x zero) > F.N.localised.sm a (F.F.fraction x zero)
     =< F.N.Action.scale-at a x zero > F.F.fraction (M.sm a x) zero
     =< ap (\ y -> F.F.fraction y zero) ann > F.F.fraction M.mz zero
     =< sym (SM.Over[F.B].Laws[LA].zero-sm (F.F.fraction x zero)) > LA.sm F.B.z (F.F.fraction x zero) }) ;
  annihilator (a : A.R) (ann : Id M.M (M.sm a x) M.mz) : Tr.Trunc[CLE.Over[A].At[G.R,f,a].Witness].carrier =
   Tr.Trunc[Br.LocH.Killer a].induction @l
    (\ k -> Tr.Trunc[CLE.Over[A].At[G.R,f,a].Witness].carrier)
    (\ k -> Tr.Trunc[CLE.Over[A].At[G.R,f,a].Witness].proposition)
    (\ k -> Tr.Trunc[CLE.Over[A].At[G.R,f,a].Witness].inc (Br.index (Br.LocH.kill-in k),
     trans (ap (\ b -> A.mul b a) (Br.index-eq (Br.LocH.kill-in k))) (Br.LocH.kill-eq k)))
    (Br.LocH.kernel (G.AF.elementary f) a (annihilator-local a ann)) ;

 } ;
} ;
