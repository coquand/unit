-- QCoh(Spec A) is abelian, by transport along Mod(A) = QCoh(Spec A)
-- (SerreQCohEquivalence.equality) of the abelian structure of Mod(A)
-- (SerreModuleAbelian). Each notion of CategoryAbelian is a family over
-- univalent categories, so one subst moves it. In particular
-- quasi-coherent sheaves on Spec A have cokernels in QCoh(Spec A) itself:
-- no sheafification is involved (the cokernel transported is the module
-- cokernel, the object (coker)~ under the equivalence).
level l ; open Base ; open Ring[l] ;
module Pr = Prelude[l] ;
module CA = CategoryAbelian[l+] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module E = SerreQCohEquivalence[l].Over[A,setA] ;
 module M = SerreModuleAbelian[l].Over[A,setA] ;
 module T = CA.Transport[E.Modules.category,E.QCoh.category,E.equality] ;
 qcoh-abelian : CA.IsAbelian E.QCoh.category = T.move CA.IsAbelian M.abelian ;
 qcoh-zero : CA.HasZero E.QCoh.category = T.move CA.HasZero M.zero ;
 qcoh-kernels : CA.HasKernels E.QCoh.category = T.move CA.HasKernels (M.zero,M.kernels) ;
 qcoh-cokernels : CA.HasCokernels E.QCoh.category = T.move CA.HasCokernels (M.zero,M.cokernels) ;
 qcoh-products : CA.HasProducts E.QCoh.category = T.move CA.HasProducts M.products ;
 qcoh-coproducts : CA.HasCoproducts E.QCoh.category = T.move CA.HasCoproducts M.coproducts ;
} ;
