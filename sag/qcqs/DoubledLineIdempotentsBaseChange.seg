-- Base change of the idempotent form of the points of the doubled-origin
-- line (DESIGN.md, Next 4, milestone 2).
--
-- Let h : B -> B2 be a map of k-algebras.  It induces hbar : B/(t) ->
-- B2/(h t), q(b) |-> q(h b) (if x = y + t w then h x = h y + (h t)(h w)).
-- Theorem.  For an idempotent e of B/(t), the point of (t, e) followed by
--  Spec h is the point of (h t, hbar e).
-- Proof.  By naturality of the coordinates (DoubledLineBaseChange) it is
--  enough that the coordinates of (h t, hbar e) are (h t, Zar(h) u0,
--  Zar(h) u1) for those (t, u0, u1) of (t, e).  This is a proposition, so
--  take e = q(b): then (u0, u1) = (D t \/ D b, D t \/ D(1 - b))
--  (ZariskiQuotient.Formula), hbar e = q(h b), and
--  Zar(h)(D t \/ D b) = D(h t) \/ D(h b), Zar(h)(D t \/ D(1 - b)) =
--  D(h t) \/ D(1 - h b).  Points are determined by their coordinates.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;

-- hbar : B/(t) -> B2/(h t)
module QuotientMap (B B2 : CRing) (setB : Pr.isSet B.R) (setB2 : Pr.isSet B2.R) (h : RH.Hom B B2) (t : B.R) {
 module Q1 = PrincipalQuotient[l].Over[B,setB,t] ;
 module Q2 = PrincipalQuotient[l].Over[B2,setB2,map h t] ;
 certificate (x y : B.R) (w : Q1.C.Certificate x y) : Q2.C.Certificate (map h x) (map h y) =
  (map h w.1,trans (ap (map h) w.2) (trans (map-add h y (B.mul t w.1)) (ap (B2.add (map h y)) (map-mul h t w.1)))) ;
 respects (x y : B.R) (r : Q1.Relation x y) : Id Q2.Carrier (Q2.include (map h x)) (Q2.include (map h y)) =
  Q2.Q.relates (map h x) (map h y)
   (Tr.Trunc[Q1.C.Certificate x y].induction @l (\ w -> Q2.Relation (map h x) (map h y)) (\ w -> Q2.prop (map h x) (map h y))
    (\ w -> Tr.Trunc[Q2.C.Certificate (map h x) (map h y)].inc (certificate x y w)) r) ;
 module DM = Q1.Q.Descend[Q2.Carrier,Q2.set,\ x -> Q2.include (map h x),respects] ;
 preserves-add : (x y : Q1.Carrier) -> Id Q2.Carrier (DM.map (Q1.addQ x y)) (Q2.addQ (DM.map x) (DM.map y)) =
  Q1.forall2 (\ x y -> Id Q2.Carrier (DM.map (Q1.addQ x y)) (Q2.addQ (DM.map x) (DM.map y))) (\ x y -> Q2.set _ _)
   (\ x y -> calc Q2.Carrier {
     DM.map (Q1.addQ (Q1.include x) (Q1.include y)) =< ap DM.map (Q1.Add.beta x y) > DM.map (Q1.include (B.add x y))
      =< DM.beta (B.add x y) > Q2.include (map h (B.add x y))
      =< ap Q2.include (map-add h x y) > Q2.include (B2.add (map h x) (map h y))
      =< sym (Q2.Add.beta (map h x) (map h y)) > Q2.addQ (Q2.include (map h x)) (Q2.include (map h y))
      =< sym (cong2 Q2.Carrier Q2.addQ _ _ _ _ (DM.beta x) (DM.beta y)) > Q2.addQ (DM.map (Q1.include x)) (DM.map (Q1.include y)) }) ;
 preserves-mul : (x y : Q1.Carrier) -> Id Q2.Carrier (DM.map (Q1.mulQ x y)) (Q2.mulQ (DM.map x) (DM.map y)) =
  Q1.forall2 (\ x y -> Id Q2.Carrier (DM.map (Q1.mulQ x y)) (Q2.mulQ (DM.map x) (DM.map y))) (\ x y -> Q2.set _ _)
   (\ x y -> calc Q2.Carrier {
     DM.map (Q1.mulQ (Q1.include x) (Q1.include y)) =< ap DM.map (Q1.Mult.beta x y) > DM.map (Q1.include (B.mul x y))
      =< DM.beta (B.mul x y) > Q2.include (map h (B.mul x y))
      =< ap Q2.include (map-mul h x y) > Q2.include (B2.mul (map h x) (map h y))
      =< sym (Q2.Mult.beta (map h x) (map h y)) > Q2.mulQ (Q2.include (map h x)) (Q2.include (map h y))
      =< sym (cong2 Q2.Carrier Q2.mulQ _ _ _ _ (DM.beta x) (DM.beta y)) > Q2.mulQ (DM.map (Q1.include x)) (DM.map (Q1.include y)) }) ;
 hom : RH.Hom Q1.ring Q2.ring = (DM.map,trans (DM.beta B.o) (ap Q2.include (map-one h)),preserves-add,preserves-mul) ;
 on-include (x : B.R) : Id Q2.Carrier (map hom (Q1.include x)) (Q2.include (map h x)) = DM.beta x ;
} ;

module Over (k : CRing) (setk : Pr.isSet k.R) (B : CRing) (setB : Pr.isSet B.R) (iota : RH.Hom k B)
 (B2 : CRing) (setB2 : Pr.isSet B2.R) (iota2 : RH.Hom k B2) (h : RH.Hom B B2)
 (over : (a : k.R) -> Id B2.R (map h (map iota a)) (map iota2 a)) {
 module BC = DoubledLineBaseChange[l].Over[k,setk,B,setB,iota,B2,setB2,iota2,h,over] ;
 module D1 = DoubledLineIdempotents[l].Over[k,setk,B,setB,iota] ;
 module D2 = DoubledLineIdempotents[l].Over[k,setk,B2,setB2,iota2] ;
 module At (t : B.R) {
  module M = QuotientMap[B,B2,setB,setB2,h,t] ;
  module Z1 = D1.At[t].Z ;
  module Z2 = D2.At[map h t].Z ;
  module MI = Idempotents[l].Map[Z1.PQ.ring,Z2.PQ.ring,M.hom] ;
  module L1 = Idempotents[l].Laws[Z1.PQ.ring] ;
  -- hbar on idempotents
  idem (e : Z1.TQ.IA.Idem) : Z2.TQ.IA.Idem = (map M.hom e.1,MI.idem-map e.1 e.2) ;
  -- Zar(h)(D t \/ D b) = D(h t) \/ D(h b)
  zar-join (b : B.R) : Id BC.P2.ZB.lattice.L (DL.hmap BC.SH.morphism.lat (BC.P1.ZB.lattice.join (BC.P1.ZB.D t) (BC.P1.ZB.D b)))
   (BC.P2.ZB.lattice.join (BC.P2.ZB.D (map h t)) (BC.P2.ZB.D (map h b))) =
   trans (DL.hmap-join BC.SH.morphism.lat (BC.P1.ZB.D t) (BC.P1.ZB.D b))
    (cong2 BC.P2.ZB.lattice.L BC.P2.ZB.lattice.join _ _ _ _ (BC.zar-D t) (BC.zar-D b)) ;
  -- the idempotent q(h b) of B2/(h t)
  module On (b : B.R) (hb : L1.IsIdem (Z1.PQ.include b)) {
   module F1 = Z1.Formula[b,hb] ;
   hb2 : Idempotents[l].Laws[Z2.PQ.ring].IsIdem (Z2.PQ.include (map h b)) =
    Pr.subst Z2.PQ.Carrier (Idempotents[l].Laws[Z2.PQ.ring].IsIdem) (map M.hom (Z1.PQ.include b)) (Z2.PQ.include (map h b))
     (M.on-include b) (MI.idem-map (Z1.PQ.include b) hb) ;
   module F2 = Z2.Formula[map h b,hb2] ;
   idem-eq : Id Z2.TQ.IA.Idem (idem (Z1.PQ.include b,hb)) (Z2.PQ.include (map h b),hb2) =
    Z2.TQ.IA.idem-ext (idem (Z1.PQ.include b,hb)) (Z2.PQ.include (map h b),hb2) (M.on-include b) ;
   -- 1 - h b = h (1 - b)
   comp-eq : Id B2.R (Idempotents[l].Laws[B2].comp (map h b)) (map h (Idempotents[l].Laws[B].comp b)) =
    sym (Idempotents[l].Map[B,B2,h].comp-map b) ;
   first : Id BC.P2.ZB.lattice.L (Z2.splitting-of (idem (Z1.PQ.include b,hb))).1.1
    (DL.hmap BC.SH.morphism.lat (Z1.splitting-of (Z1.PQ.include b,hb)).1.1) = calc BC.P2.ZB.lattice.L {
    (Z2.splitting-of (idem (Z1.PQ.include b,hb))).1.1 =< ap (\ e -> (Z2.splitting-of e).1.1) idem-eq
     > (Z2.splitting-of (Z2.PQ.include (map h b),hb2)).1.1
     =< F2.first > BC.P2.ZB.lattice.join (BC.P2.ZB.D (map h t)) (BC.P2.ZB.D (map h b))
     =< sym (zar-join b) > DL.hmap BC.SH.morphism.lat (BC.P1.ZB.lattice.join (BC.P1.ZB.D t) (BC.P1.ZB.D b))
     =< ap (DL.hmap BC.SH.morphism.lat) (sym F1.first) > DL.hmap BC.SH.morphism.lat (Z1.splitting-of (Z1.PQ.include b,hb)).1.1 } ;
   second : Id BC.P2.ZB.lattice.L (Z2.splitting-of (idem (Z1.PQ.include b,hb))).1.2
    (DL.hmap BC.SH.morphism.lat (Z1.splitting-of (Z1.PQ.include b,hb)).1.2) = calc BC.P2.ZB.lattice.L {
    (Z2.splitting-of (idem (Z1.PQ.include b,hb))).1.2 =< ap (\ e -> (Z2.splitting-of e).1.2) idem-eq
     > (Z2.splitting-of (Z2.PQ.include (map h b),hb2)).1.2
     =< F2.second > BC.P2.ZB.lattice.join (BC.P2.ZB.D (map h t)) (BC.P2.ZB.D (Idempotents[l].Laws[B2].comp (map h b)))
     =< ap (\ x -> BC.P2.ZB.lattice.join (BC.P2.ZB.D (map h t)) (BC.P2.ZB.D x)) comp-eq
     > BC.P2.ZB.lattice.join (BC.P2.ZB.D (map h t)) (BC.P2.ZB.D (map h (Idempotents[l].Laws[B].comp b)))
     =< sym (zar-join (Idempotents[l].Laws[B].comp b))
     > DL.hmap BC.SH.morphism.lat (BC.P1.ZB.lattice.join (BC.P1.ZB.D t) (BC.P1.ZB.D (Idempotents[l].Laws[B].comp b)))
     =< ap (DL.hmap BC.SH.morphism.lat) (sym F1.second) > DL.hmap BC.SH.morphism.lat (Z1.splitting-of (Z1.PQ.include b,hb)).1.2 } ;
  } ;
  -- for every idempotent: a proposition, so q(b) is enough
  Agrees (e : Z1.TQ.IA.Idem) : U l =
   Id BC.P2.ZB.lattice.L (Z2.splitting-of (idem e)).1.1 (DL.hmap BC.SH.morphism.lat (Z1.splitting-of e).1.1)
   * Id BC.P2.ZB.lattice.L (Z2.splitting-of (idem e)).1.2 (DL.hmap BC.SH.morphism.lat (Z1.splitting-of e).1.2) ;
  agrees-prop (e : Z1.TQ.IA.Idem) : Pr.isProp (Agrees e) =
   Pr.isProp-Sigma (Id BC.P2.ZB.lattice.L (Z2.splitting-of (idem e)).1.1 (DL.hmap BC.SH.morphism.lat (Z1.splitting-of e).1.1))
    (\ a -> Id BC.P2.ZB.lattice.L (Z2.splitting-of (idem e)).1.2 (DL.hmap BC.SH.morphism.lat (Z1.splitting-of e).1.2))
    (BC.P2.ZB.lattice.setL _ _) (\ a -> BC.P2.ZB.lattice.setL _ _) ;
  agrees (e : Z1.TQ.IA.Idem) : Agrees e =
   Z1.PQ.Q.induction @l (\ x -> (hx : L1.IsIdem x) -> Agrees (x,hx))
    (\ x -> F.isProp-Pi (L1.IsIdem x) (\ hx -> Agrees (x,hx)) (\ hx -> agrees-prop (x,hx)))
    (\ b hb -> (On[b,hb].first,On[b,hb].second)) e.1 e.2 ;
 } ;
 -- (t, e) |-> (h t, hbar e)
 image (q : D1.Data) : D2.Data = (map h q.1,At[q.1].idem q.2) ;
 -- its coordinates are the image of the coordinates of (t, e)
 coordinates-of-image (q : D1.Data) :
  Id BC.P2.Coordinates (D2.coordinates (image q)) (D2.regroup (map h q.1) (At[q.1].Z2.splitting-of (At[q.1].idem q.2))) =
  refl (D2.coordinates (image q)) ;
 triple-eq (q : D1.Data) :
  Id (B2.R * BC.P2.ZB.lattice.L * BC.P2.ZB.lattice.L) (D2.regroup (map h q.1) (At[q.1].Z2.splitting-of (At[q.1].idem q.2))).1
   BC.Image[D1.coordinates q].image.1 = calc (B2.R * BC.P2.ZB.lattice.L * BC.P2.ZB.lattice.L) {
   (map h q.1,(At[q.1].Z2.splitting-of (At[q.1].idem q.2)).1.1,(At[q.1].Z2.splitting-of (At[q.1].idem q.2)).1.2)
    =< ap (\ u -> (map h q.1,u,(At[q.1].Z2.splitting-of (At[q.1].idem q.2)).1.2)) (At[q.1].agrees q.2).1
    > (map h q.1,DL.hmap BC.SH.morphism.lat (At[q.1].Z1.splitting-of q.2).1.1,(At[q.1].Z2.splitting-of (At[q.1].idem q.2)).1.2)
    =< ap (\ v -> (map h q.1,DL.hmap BC.SH.morphism.lat (At[q.1].Z1.splitting-of q.2).1.1,v)) (At[q.1].agrees q.2).2
    > (map h q.1,DL.hmap BC.SH.morphism.lat (At[q.1].Z1.splitting-of q.2).1.1,DL.hmap BC.SH.morphism.lat (At[q.1].Z1.splitting-of q.2).1.2) } ;
 coordinates-image (q : D1.Data) : Id BC.P2.Coordinates (D2.coordinates (image q)) BC.Image[D1.coordinates q].image =
  trans (coordinates-of-image q)
   (Pr.Sigma-eq (B2.R * BC.P2.ZB.lattice.L * BC.P2.ZB.lattice.L) BC.P2.Conditions
    (D2.regroup (map h q.1) (At[q.1].Z2.splitting-of (At[q.1].idem q.2))).1 BC.Image[D1.coordinates q].image.1
    (D2.regroup (map h q.1) (At[q.1].Z2.splitting-of (At[q.1].idem q.2))).2 BC.Image[D1.coordinates q].image.2
    (triple-eq q) (BC.P2.conditions-prop BC.Image[D1.coordinates q].image.1)) ;
 -- the point of (t, e) followed by Spec h is the point of (h t, hbar e)
 natural (q : D1.Data) : Id BC.P2.Points BC.Pull[D1.point q].point (D2.point (image q)) =
  Iso[l].injective BC.P2.Points BC.P2.Coordinates BC.P2.forth BC.P2.equivalence BC.Pull[D1.point q].point (D2.point (image q))
   (calc BC.P2.Coordinates {
     BC.P2.forth BC.Pull[D1.point q].point =< BC.natural (D1.point q) > BC.Image[BC.P1.forth (D1.point q)].image
      =< ap (\ c -> BC.Image[c].image) (BC.P1.ForthBack[D1.coordinates q].law) > BC.Image[D1.coordinates q].image
      =< sym (coordinates-image q) > D2.coordinates (image q)
      =< sym (BC.P2.ForthBack[D2.coordinates (image q)].law) > BC.P2.forth (D2.point (image q)) }) ;
} ;
