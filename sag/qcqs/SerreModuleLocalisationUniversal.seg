-- Universal property of module localisation (Serre note, Section 3).
-- If f acts invertibly on P, a map M -> P extends by x/f^p |-> f^-p u(x).
-- Powers of the inverse action are additive and commute with scalars,
-- since applying the injective forward power checks both equations.
-- Fraction equality respects this formula by applying a common forward
-- power.  The same argument proves uniqueness for linear extensions.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module RH = RingHom[l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module LC = SerreModuleLocalisation[l] ; module LM = SerreModuleLocalisationMaps[l] ;
module LS = SerreModuleLocalisationStructure[l] ;
module NB = NatBound[l] ;
module Inverse (A : CRing) (Nd : SM.Over[A].Module) (f : A.R)
 (invertible : Pr.isEquiv Nd.M Nd.M (Nd.sm f)) {
 module T = LC.At[A,Nd,f] ;
 inv (x : Nd.M) : Nd.M = invertible.sec x ;
 forward-inverse (x : Nd.M) : Id Nd.M (Nd.sm f (inv x)) x = invertible.sec-eq x ;
 inverse-forward (x : Nd.M) : Id Nd.M (inv (Nd.sm f x)) x = Pr.sec-ret Nd.M Nd.M (Nd.sm f) invertible x ;
 injective (x y : Nd.M) (e : Id Nd.M (Nd.sm f x) (Nd.sm f y)) : Id Nd.M x y =
  trans (sym (inverse-forward x)) (trans (ap inv e) (inverse-forward y)) ;
 power-injective : (n : Nat) (x y : Nd.M) -> Id Nd.M (T.power n x) (T.power n y) -> Id Nd.M x y = split {
  zero -> \ x y e -> trans (sym (T.power-at-zero x)) (trans e (T.power-at-zero y)) ;
  suc n | ih -> \ x y e -> ih x y (injective (T.power n x) (T.power n y)
   (trans (sym (T.power-at-suc n x)) (trans e (T.power-at-suc n y)))) } ;
 inv-commute (x : Nd.M) : Id Nd.M (Nd.sm f (inv x)) (inv (Nd.sm f x)) =
  trans (forward-inverse x) (sym (inverse-forward x)) ;
 power-inv : (n : Nat) (x : Nd.M) -> Id Nd.M (T.power n (inv x)) (inv (T.power n x)) = split {
  zero -> \ x -> trans (T.power-at-zero (inv x)) (sym (ap inv (T.power-at-zero x))) ;
  suc n | ih -> \ x -> trans (T.power-at-suc n (inv x))
   (trans (ap (Nd.sm f) (ih x))
    (trans (inv-commute (T.power n x)) (sym (ap inv (T.power-at-suc n x))))) } ;
 back : Nat -> Nd.M -> Nd.M = split { zero -> \ x -> x ; suc n | ih -> \ x -> inv (ih x) } ;
 power-back : (n : Nat) (x : Nd.M) -> Id Nd.M (T.power n (back n x)) x = split {
  zero -> \ x -> T.power-at-zero x ;
  suc n | ih -> \ x -> trans (T.power-at-suc n (inv (back n x)))
   (trans (ap (Nd.sm f) (power-inv n (back n x)))
    (trans (ap (\ z -> Nd.sm f (inv z)) (ih x)) (forward-inverse x))) } ;
 back-add (n : Nat) (x y : Nd.M) : Id Nd.M (back n (Nd.madd x y)) (Nd.madd (back n x) (back n y)) =
  power-injective n _ _ (trans (power-back n (Nd.madd x y))
   (sym (trans (T.power-additive n (back n x) (back n y))
    (cong2 Nd.M Nd.madd _ _ _ _ (power-back n x) (power-back n y))))) ;
 back-scale (n : Nat) (a : A.R) (x : Nd.M) : Id Nd.M (back n (Nd.sm a x)) (Nd.sm a (back n x)) =
  power-injective n _ _ (trans (power-back n (Nd.sm a x))
   (sym (trans (T.power-scale n a (back n x)) (ap (Nd.sm a) (power-back n x))))) ;
 back-zero (x : Nd.M) : Id Nd.M (back zero x) x = refl x ;
 back-suc (p : Nat) (x : Nd.M) : Id Nd.M (back (suc p) x) (inv (back p x)) = refl (inv (back p x)) ;
 back-compose : (p q : Nat) (x : Nd.M) -> Id Nd.M (back p (back q x)) (back (plus p q) x) = split {
  zero -> \ q x -> refl (back q x) ;
  suc p | ih -> \ q x -> ap inv (ih q x) } ;
 opaque back ;
} ;
module Extend (A : CRing) (Md Nd : SM.Over[A].Module) (f : A.R)
 (u : MM.Between[A,A,RH.identity A,Md,Nd].Hom)
 (invertible : Pr.isEquiv Nd.M Nd.M (Nd.sm f)) {
 module H = MM.Between[A,A,RH.identity A,Md,Nd] ;
 module S = LC.At[A,Md,f] ; module T = LC.At[A,Nd,f] ;
 module Source = LS.At[A,Md,f] ;
 module To = MM.Between[A,A,RH.identity A,Source.localised,Nd] ;
 module UM = LM.Along[A,A,RH.identity A,Md,Nd,u,f] ;
 module InverseAction = Inverse[A,Nd,f,invertible] ;
 open InverseAction ;
 swap-exponent (e p q : Nat) : Id Nat (plus (plus e p) q) (plus (plus e q) p) =
  trans (NB.plus-assoc e p q) (trans (ap (plus e) (plus-comm p q)) (sym (NB.plus-assoc e q p))) ;
 left-clear (e p q : Nat) (x : Nd.M) :
  Id Nd.M (T.power (plus (plus e p) q) (back p x)) (T.power (plus e q) x) =
  trans (ap (\ n -> T.power n (back p x)) (swap-exponent e p q))
   (trans (T.power-add (plus e q) p (back p x)) (ap (T.power (plus e q)) (power-back p x))) ;
 right-clear (e p q : Nat) (x : Nd.M) :
  Id Nd.M (T.power (plus (plus e p) q) (back q x)) (T.power (plus e p) x) =
  trans (T.power-add (plus e p) q (back q x)) (ap (T.power (plus e p)) (power-back q x)) ;
 value (x : Md.M) (p : Nat) : Nd.M = back p (H.map u x) ;
 respect-witness (x y : Md.M) (p q : Nat) (w : S.Witness (x,p) (y,q)) : Id Nd.M (value x p) (value y q) =
  power-injective (plus (plus w.1 p) q) _ _
   (trans (left-clear w.1 p q (H.map u x))
    (trans (UM.witness x y p q w).2 (sym (right-clear w.1 p q (H.map u y))))) ;
 respects (x y : Md.M) (p q : Nat) : S.Relation (x,p) (y,q) -> Id Nd.M (value x p) (value y q) =
  Truncation[l].Trunc[S.Witness (x,p) (y,q)].induction @l
   (\ w -> Id Nd.M (value x p) (value y q)) (\ w -> Nd.setM _ _) (respect-witness x y p q) ;
 module D = S.Descend[Nd.M,Nd.setM,value,respects] ;
 lift-map (q : S.Carrier) : Nd.M = D.map q ;
 lift-at (x : Md.M) (p : Nat) : Id Nd.M (lift-map (S.fraction x p)) (back p (H.map u x)) = D.beta x p ;
 lift-add (a b : S.Carrier) : Id Nd.M (lift-map (Source.add a b)) (Nd.madd (lift-map a) (lift-map b)) =
  S.pair-induction (\ a b -> Id Nd.M (lift-map (Source.add a b)) (Nd.madd (lift-map a) (lift-map b)))
   (\ a b -> Nd.setM _ _)
   (\ x y p -> trans (ap lift-map (Source.add-at x y p))
    (trans (lift-at (Md.madd x y) p)
     (trans (ap (back p) (H.map-add u x y))
      (trans (back-add p (H.map u x) (H.map u y))
       (cong2 Nd.M Nd.madd _ _ _ _ (sym (lift-at x p)) (sym (lift-at y p))))))) a b ;
 lift-scale (a : A.R) (q : S.Carrier) : Id Nd.M (lift-map (Source.localised.sm a q)) (Nd.sm a (lift-map q)) =
  S.induction @l (\ q -> Id Nd.M (lift-map (Source.localised.sm a q)) (Nd.sm a (lift-map q))) (\ q -> Nd.setM _ _)
   (\ x p -> trans (ap lift-map (Source.Action.scale-at a x p))
    (trans (lift-at (Md.sm a x) p)
     (trans (ap (back p) (H.map-scale u a x))
      (trans (back-scale p a (H.map u x)) (ap (Nd.sm a) (sym (lift-at x p))))))) q ;
 lift : To.Hom = new To.Hom[lift-map,lift-add,lift-scale] ;
 lift-map-at (q : S.Carrier) : Id Nd.M (To.map lift q) (lift-map q) = refl (lift-map q) ;
 extends (x : Md.M) : Id Nd.M (To.map lift (S.fraction x zero)) (H.map u x) = trans (lift-at x zero) (back-zero (H.map u x)) ;
 opaque lift ;
 module SP = LC.At[A,Source.localised,f] ;
 module AP = AffinePowers[l].Over[A] ;
 diagonal (x : Md.M) (p : Nat) : Id S.Carrier (SP.power p (S.fraction x p)) (S.fraction x zero) =
  trans (SP.power-scalar p (S.fraction x p))
   (trans (Source.Action.scale-at (AP.power f p) x p)
    (trans (ap (\ y -> S.fraction y p) (sym (S.power-scalar p x)))
     (trans (ap (S.fraction (S.power p x)) (sym (plus-zero p))) (S.raise x zero p)))) ;
 module Other (k : To.Hom) (extends-k : (x : Md.M) -> Id Nd.M (To.map k (S.fraction x zero)) (H.map u x)) {
  module K = LM.Along[A,A,RH.identity A,Source.localised,Nd,k,f] ;
  unique (q : S.Carrier) : Id Nd.M (To.map k q) (To.map lift q) =
   S.induction @l (\ q -> Id Nd.M (To.map k q) (To.map lift q)) (\ q -> Nd.setM _ _)
    (\ x p -> trans (power-injective p _ _
     (trans (sym (K.power-map p (S.fraction x p)))
      (trans (ap (To.map k) (diagonal x p)) (trans (extends-k x) (sym (power-back p (H.map u x)))))))
      (trans (sym (lift-at x p)) (sym (lift-map-at (S.fraction x p))))) q ;
 } ;
 opaque lift-map ;
} ;
