-- Absolute qcqs totalisation gives native relative qcqs (§4).
-- Restrict each absolute compact open to pairs (iota,x).  Realisations
-- commute with totalisation; the pointwise identity of membership also
-- identifies the original absolute open with its reconstructed total open.
-- An ordinary affine witness for that realisation therefore represents
-- the total native realisation.  RelativeAffineOfTotal extracts its
-- generic algebra structure and a native relative affine witness.
-- Covers restrict pointwise.  Eliminate witnesses and atlas only into
-- affineness and HasAtlas.  RelativeSheafOfTotal supplies sheafhood.
level l ; open Ring[l] ; open Presentations[l] ;
module Tr = Truncation[l+] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module TE = TestEquivalences[l] ;
module CO = CompactOpens[l] ;
module QF = FunctorialQcqs[l] ;
module Over (K : T.Test) (F : RelativeFunctors[l].Over[K].SetFunctor) {
 module TF = RelativeTotal[l].Over[K,F] ;
 module RQ = RelativeQcqs[l].Over[K] ;
 module Q = RQ.At[F] ;
 module AQ = QF.Over[TF.functor] ;
 module FromCover (c : AQ.AffineCover) {
  opens (i : Fin c.count) : Q.O.Open = Q.O.from-total (c.opens i) ;
  module Part (i : Fin c.count) {
   module RR = RelativeRealisationTotal[l].Over[K,F,opens i] ;
   module V = OpenRealisation[l].Over[TF.functor,c.opens i] ;
   module Transfer = RealisationTransfer[l].Over[TF.functor,TF.functor,Q.O.to-total (opens i),c.opens i,TE.identity TF.functor].Given[
    \ B x m -> m,\ B x m -> m] ;
   module First = TE.Composite[RR.TR.functor,RR.R.functor,V.functor,RR.equivalence,Transfer.equivalence] ;
   module I = TE.Inverse[RR.TR.functor,V.functor,First.equivalence] ;
   module Actual (w : QF.AffineWitness V.functor) {
    equivalence : TE.NaturalEquivalence SF.Representable[w.1].functor RR.TR.functor =
     TE.Composite[SF.Representable[w.1].functor,V.functor,RR.TR.functor,w.2,I.inverse-equiv].equivalence ;
    module A = RelativeAffineOfTotal[l].Over[K,RR.RO.functor,w.1,equivalence] ;
    witness : RQ.AffineWitness RR.RO.functor = (A.algebra,A.equivalence) ;
   } ;
   affine : RQ.IsAffine RR.RO.functor = Tr.Trunc[QF.AffineWitness V.functor].induction @(l+)
    (\ t -> RQ.IsAffine RR.RO.functor) (\ t -> Tr.Trunc[RQ.AffineWitness RR.RO.functor].proposition)
    (\ w -> Tr.Trunc[RQ.AffineWitness RR.RO.functor].inc Actual[w].witness) (c.affine i) ;
  } ;
  cover : Q.AffineCover = struct {
   count = c.count ; opens = opens ;
   covers = \ A x -> c.covers (RQ.R.BP.test A) (TF.At[RQ.R.BP.test A].pair (RQ.R.BP.iota A) x) ;
   affine = \ i -> Part[i].affine } ;
 } ;
 has-atlas (a : AQ.HasAtlas) : Q.HasAtlas = Tr.Trunc[AQ.AffineCover].induction @(l+)
  (\ t -> Q.HasAtlas) (\ t -> Tr.Trunc[Q.AffineCover].proposition) (\ c -> Tr.Trunc[Q.AffineCover].inc FromCover[c].cover) a ;
 qcqs (q : AQ.IsQcqs) : Q.IsQcqs = (RelativeSheafOfTotal[l].Over[K,F,q.1].is-sheaf,has-atlas q.2) ;
} ;
