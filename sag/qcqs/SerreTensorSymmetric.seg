-- The tensor product makes Mod(A) a symmetric monoidal category
-- (MonoidalCategory.Symmetric), extending SerreTensorMonoidal.monoidal.
--
-- Braiding: SerreTensorMaps.Swap, x (x) y |-> y (x) x, with its inverse.
-- Laws on pure tensors (SerreTensorUniversal.Equal, SerreTensorAssociativity
-- .EqualLeft): naturality, both sides send x (x) y to g y (x) f x;
-- symmetry, x (x) y |-> y (x) x |-> x (x) y; hexagon, both sides send
-- (x (x) y) (x) z to y (x) (z (x) x).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module MCat = MonoidalCategory[l+] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module Mo = SerreTensorMonoidal[l].Over[A,setA] ;
 module QE = Mo.QE ; module MC = Mo.MC ; module L = Mo.L ; module TM = Mo.TM ; module As = Mo.As ;
 module Pm = Mo.Pm ;
 -- the braiding
 braiding (M N : QE.Mod) : Pm.precategory.Iso (Mo.tensor M N) (Mo.tensor N M) =
  (TM.Swap[M.1,N.1].To.lift,TM.Swap[M.1,N.1].Back.lift,
   L.Hom[(Mo.tensor M N).1,(Mo.tensor M N).1].ext _ _ TM.Swap[M.1,N.1].left,
   L.Hom[(Mo.tensor N M).1,(Mo.tensor N M).1].ext _ _ TM.Swap[M.1,N.1].right) ;

 module BraidNatural (M M' N N' : QE.Mod) (f : MC.Hom M.1 M'.1) (g : MC.Hom N.1 N'.1) {
  module B0 = TM.Swap[M.1,N.1] ; module B1 = TM.Swap[M'.1,N'.1] ;
  module Mf = TM.Map[M.1,N.1,M'.1,N'.1,f,g] ; module Mg = TM.Map[N.1,M.1,N'.1,M'.1,g,f] ;
  first : MC.Hom B0.MN.T.tensor B1.NM.T.tensor = MC.comp B0.MN.T.tensor B1.MN.T.tensor B1.NM.T.tensor B1.To.lift Mf.map ;
  second : MC.Hom B0.MN.T.tensor B1.NM.T.tensor = MC.comp B0.MN.T.tensor B0.NM.T.tensor B1.NM.T.tensor Mg.map B0.To.lift ;
  pure (x : M.1.M) (y : N.1.M) : Id B1.NM.T.tensor.M (first.fn (B0.MN.T.pure x y)) (second.fn (B0.MN.T.pure x y)) =
   calc B1.NM.T.tensor.M {
   first.fn (B0.MN.T.pure x y)
    =< ap B1.To.lift.fn (Mf.beta x y) > B1.To.lift.fn (B1.MN.T.pure (f.fn x) (g.fn y))
    =< B1.To.beta (f.fn x) (g.fn y) > B1.NM.T.pure (g.fn y) (f.fn x)
    =< sym (Mg.beta y x) > Mg.map.fn (B0.NM.T.pure y x)
    =< sym (ap Mg.map.fn (B0.To.beta x y)) > second.fn (B0.MN.T.pure x y) } ;
  natural : Id (MC.Hom B0.MN.T.tensor B1.NM.T.tensor) first second = B0.MN.Equal[B1.NM.T.tensor,first,second,pure].equal ;
 } ;
 module Symmetry (M N : QE.Mod) {
  module B0 = TM.Swap[M.1,N.1] ; module B1 = TM.Swap[N.1,M.1] ;
  both : MC.Hom B0.MN.T.tensor B0.MN.T.tensor = MC.comp B0.MN.T.tensor B0.NM.T.tensor B0.MN.T.tensor B1.To.lift B0.To.lift ;
  pure (x : M.1.M) (y : N.1.M) : Id B0.MN.T.tensor.M (both.fn (B0.MN.T.pure x y)) (B0.MN.T.pure x y) =
   trans (ap B1.To.lift.fn (B0.To.beta x y)) (B1.To.beta y x) ;
  law : Id (MC.Hom B0.MN.T.tensor B0.MN.T.tensor) both (L.identity B0.MN.T.tensor) =
   B0.MN.Equal[B0.MN.T.tensor,both,L.identity B0.MN.T.tensor,pure].equal ;
 } ;
 module Hexagon (M N P : QE.Mod) {
  module S0 = As.At[M.1,N.1,P.1] ; module S1 = As.At[N.1,P.1,M.1] ; module S2 = As.At[N.1,M.1,P.1] ;
  module B0 = TM.Swap[M.1,(Mo.tensor N P).1] ; module B1 = TM.Swap[M.1,N.1] ; module B2 = TM.Swap[M.1,P.1] ;
  module M1 = TM.Map[(Mo.tensor M N).1,P.1,(Mo.tensor N M).1,P.1,B1.To.lift,L.identity P.1] ;
  module M2 = TM.Map[N.1,(Mo.tensor M P).1,N.1,(Mo.tensor P M).1,L.identity N.1,B2.To.lift] ;
  first : MC.Hom S0.Lhs S1.Rhs = MC.comp S0.Lhs S1.Lhs S1.Rhs S1.To.lift (MC.comp S0.Lhs S0.Rhs S1.Lhs B0.To.lift S0.To.lift) ;
  second : MC.Hom S0.Lhs S1.Rhs = MC.comp S0.Lhs S2.Rhs S1.Rhs M2.map (MC.comp S0.Lhs S2.Lhs S2.Rhs S2.To.lift M1.map) ;
  pure (x : M.1.M) (y : N.1.M) (z : P.1.M) :
   Id S1.Rhs.M (first.fn (S0.A0.T.pure (S0.MN.T.pure x y) z)) (second.fn (S0.A0.T.pure (S0.MN.T.pure x y) z)) = calc S1.Rhs.M {
   first.fn (S0.A0.T.pure (S0.MN.T.pure x y) z)
    =< ap (\ u -> S1.To.lift.fn (B0.To.lift.fn u)) (S0.to-beta x y z) >
     S1.To.lift.fn (B0.To.lift.fn (S0.A1.T.pure x (S0.NP.T.pure y z)))
    =< ap S1.To.lift.fn (B0.To.beta x (S0.NP.T.pure y z)) > S1.To.lift.fn (S1.A0.T.pure (S1.MN.T.pure y z) x)
    =< S1.to-beta y z x > S1.A1.T.pure y (S1.NP.T.pure z x)
    =< sym (ap (S1.A1.T.pure y) (B2.To.beta x z)) > S1.A1.T.pure y (B2.To.lift.fn (B2.MN.T.pure x z))
    =< sym (M2.beta y (B2.MN.T.pure x z)) > M2.map.fn (S2.A1.T.pure y (S2.NP.T.pure x z))
    =< sym (ap M2.map.fn (S2.to-beta y x z)) > M2.map.fn (S2.To.lift.fn (S2.A0.T.pure (S2.MN.T.pure y x) z))
    =< sym (ap (\ u -> M2.map.fn (S2.To.lift.fn (S2.A0.T.pure u z))) (B1.To.beta x y)) >
     M2.map.fn (S2.To.lift.fn (S2.A0.T.pure (B1.To.lift.fn (B1.MN.T.pure x y)) z))
    =< sym (ap (\ u -> M2.map.fn (S2.To.lift.fn u)) (M1.beta (S0.MN.T.pure x y) z)) >
     second.fn (S0.A0.T.pure (S0.MN.T.pure x y) z) } ;
  law : Id (MC.Hom S0.Lhs S1.Rhs) first second = S0.EqualLeft[S1.Rhs,first,second,pure].equal ;
 } ;

 symmetric : MCat.Symmetric[Pm.category] = new MCat.Symmetric[Pm.category,Mo.monoidal,braiding,
  \ M M' N N' f g -> BraidNatural[M,M',N,N',f,g].natural,
  \ M N -> Symmetry[M,N].law,\ M N P -> Hexagon[M,N,P].law] ;
} ;
