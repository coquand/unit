-- Elementary module localisation implies the native comparison is an iso.
-- A linear map u:M->N with invertible f-action on N is elementary when
-- denominators clear and its kernel is killed by powers of f. Its unique
-- extension M_f->N is injective: common-denominator equality reduces to
-- equal numerator images, hence a killed difference. It is surjective:
-- a cleared numerator supplies a fraction with the desired image.
-- Fibres are propositions, so mere representatives determine the inverse.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module RH = RingHom[l] ; module UP = SerreModuleLocalisationUniversal[l] ;
module Over (A : CRing) (Md Nd : SM.Over[A].Module) (f : A.R)
 (u : MM.Between[A,A,RH.identity A,Md,Nd].Hom)
 (invertible : Pr.isEquiv Nd.M Nd.M (Nd.sm f))
 (clear : (y : Nd.M) -> Tr.Trunc[(r : Nat) * (x : Md.M) *
  Id Nd.M (MM.Between[A,A,RH.identity A,Md,Nd].map u x) (Nd.sm (AffinePowers[l].Over[A].power f r) y)].carrier)
 (kill : (x : Md.M) -> Id Nd.M (MM.Between[A,A,RH.identity A,Md,Nd].map u x) Nd.mz ->
  Tr.Trunc[(r : Nat) * Id Md.M (Md.sm (AffinePowers[l].Over[A].power f r) x) Md.mz].carrier) {
 module H = MM.Between[A,A,RH.identity A,Md,Nd] ;
 module E = UP.Extend[A,Md,Nd,f,u,invertible] ;
 module S = E.S ; module ML = SM.Over[A].Laws[Md] ;
 module AP = AffinePowers[l].Over[A] ;
 forward (z : S.Carrier) : Nd.M = E.To.map E.lift z ;
 linear-map-at (z : S.Carrier) : Id Nd.M (E.To.map E.lift z) (forward z) = refl (forward z) ;
 clears (x : Md.M) (p : Nat) : Id Nd.M (E.T.power p (forward (S.fraction x p))) (H.map u x) =
  trans (ap (E.T.power p) (trans (E.lift-map-at (S.fraction x p)) (E.lift-at x p))) (E.InverseAction.power-back p (H.map u x)) ;
 difference-zero (x y : Md.M) (e : Id Nd.M (H.map u x) (H.map u y)) : Id Nd.M (H.map u (ML.sub x y)) Nd.mz =
  trans (ap (H.map u) (ML.sub-at x y))
   (trans (H.map-add u x (Md.mneg y))
    (trans (ap (Nd.madd (H.map u x)) (H.map-neg u y))
     (trans (ap (\ z -> Nd.madd z (Nd.mneg (H.map u y))) e) (Nd.maddN (H.map u y))))) ;
 power-sub (r : Nat) (x y : Md.M) :
  Id Md.M (Md.sm (AP.power f r) (ML.sub x y)) (ML.sub (S.power r x) (S.power r y)) =
  trans (ML.sm-sub (AP.power f r) x y)
   (cong2 Md.M ML.sub _ _ _ _ (sym (S.power-scalar r x)) (sym (S.power-scalar r y))) ;
 equal-after-power (x y : Md.M) (p e : Nat) (eq : Id Md.M (S.power e x) (S.power e y)) :
  Id S.Carrier (S.fraction x p) (S.fraction y p) =
  S.equal x y p p (Tr.Trunc[S.Witness (x,p) (y,p)].inc
   (e,trans (ap (\ n -> S.power n x) (plus-comm e p))
    (trans (S.power-add p e x)
     (trans (ap (S.power p) eq)
      (trans (sym (S.power-add p e y)) (ap (\ n -> S.power n y) (plus-comm p e))))))) ;
 same-fractions (x y : Md.M) (p : Nat)
  (eq : Id Nd.M (forward (S.fraction x p)) (forward (S.fraction y p))) : Id S.Carrier (S.fraction x p) (S.fraction y p) =
  Tr.Trunc[(r : Nat) * Id Md.M (Md.sm (AP.power f r) (ML.sub x y)) Md.mz].induction @l
   (\ w -> Id S.Carrier (S.fraction x p) (S.fraction y p)) (\ w -> S.carrier-set _ _)
   (\ w -> equal-after-power x y p w.1 (ML.sub-zero _ _ (trans (sym (power-sub w.1 x y)) w.2)))
   (kill (ML.sub x y) (difference-zero x y
    (trans (sym (clears x p)) (trans (ap (E.T.power p) eq) (clears y p))))) ;
 injective (x y : S.Carrier) : Id Nd.M (forward x) (forward y) -> Id S.Carrier x y =
  S.pair-induction (\ x y -> Id Nd.M (forward x) (forward y) -> Id S.Carrier x y)
   (\ x y -> Axioms[l].FunExtLemmas[fe @l].isProp-Pi (Id Nd.M (forward x) (forward y))
    (\ e -> Id S.Carrier x y) (\ e -> S.carrier-set _ _)) same-fractions x y ;
 Fibre (y : Nd.M) : U l = (x : S.Carrier) * Id Nd.M (forward x) y ;
 fibre-prop (y : Nd.M) : Pr.isProp (Fibre y) = \ a b ->
  Pr.Sigma-eq S.Carrier (\ x -> Id Nd.M (forward x) y) a.1 b.1 a.2 b.2
   (injective a.1 b.1 (trans a.2 (sym b.2))) (Nd.setM _ _) ;
 preimage (y : Nd.M) : Fibre y =
  Tr.Trunc[(r : Nat) * (x : Md.M) * Id Nd.M (H.map u x) (Nd.sm (AP.power f r) y)].induction @l
   (\ w -> Fibre y) (\ w -> fibre-prop y)
   (\ w -> (S.fraction w.2.1 w.1,E.InverseAction.power-injective w.1 _ _
    (trans (clears w.2.1 w.1) (trans w.2.2 (sym (E.T.power-scalar w.1 y)))))) (clear y) ;
 backward (y : Nd.M) : S.Carrier = (preimage y).1 ;
 forward-backward (y : Nd.M) : Id Nd.M (forward (backward y)) y = (preimage y).2 ;
 backward-forward (x : S.Carrier) : Id S.Carrier (backward (forward x)) x = injective _ _ (forward-backward (forward x)) ;
 equivalence : Pr.isEquiv S.Carrier Nd.M forward = Pr.qinv S.Carrier Nd.M forward backward forward-backward backward-forward ;
 on-original (x : Md.M) : Id Nd.M (forward (S.fraction x zero)) (H.map u x) = E.extends x ;
 opaque forward ;
 opaque preimage ;
 opaque backward ;
} ;
