-- Degree-one module gluing (Serre note, Section 3).
-- Clear the f_k denominators of c_ki to one exponent r and a_ki in M_fi.
-- On M_(fi fj), the error a_kj|fi-a_ki|fj-f_k^r c_ij vanishes after
-- restriction to M_(fk(fi fj)), by the actual cocycle equation and
-- composition of restrictions. Overlap kernel detection and finite cube
-- choice give one exponent e killing all errors. Multiply a_ki by f_k^e;
-- the resulting exact equations have exponent r+e. A partition of one
-- by these powers gives b_j-b_i=c_ij. Every witness is eliminated into
-- mere boundary existence, including for an empty principal cover.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module CF = SerreModuleClearFinite[l] ; module CE = SerreModuleClearErrors[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (Md : SM.Over[A].Module) {
 module Data = SerreModuleCechGluingData[l].Over[A,setA,Md] ;
 module R = Data.R ; module P = AffinePowers[l].Over[A] ;
 module Overlap = SerreModuleBasicRestrictionsOverlap[l].Over[A,setA,Md] ;
 module Cover (n : Nat) (fs : Fin n -> A.R)
  (covers : Data.O.Le Data.Z.lattice.top (Data.Z.J.bigJ n (\ i -> Data.Z.D (fs i)))) {
  module D = Data.Cover[n,fs,covers] ; module C = D.C ;
  module Partition = SerreModuleCechGluingPartition[l].Over[A,setA,Md].Cover[n,fs,covers] ;
  module AtCocycle (c : D.Cochain) (cocycle : D.CocycleLaw c) {
   module FirstClear = CF.Over[A].Matrix[n,n,
    \ k i -> C.Index[i].P.Native.localised,\ k i -> C.Pair[k,i].P.Native.localised,
    \ k i -> Overlap.At[fs k,fs i].P.native,\ k i -> fs k,c] ;
   first-clearing : Tr.Trunc[FirstClear.Common].carrier =
    FirstClear.common (\ k i -> Overlap.At[fs k,fs i].clear (c k i)) ;
   module Initial (r : Nat) (as : (k i : Fin n) -> C.Index[i].P.L.Carrier)
    (initial : (k i : Fin n) -> Id C.Pair[k,i].P.L.Carrier
     (Overlap.At[fs k,fs i].P.map (as k i))
     (C.Pair[k,i].P.Native.localised.sm (P.power (fs k) r) (c k i))) {
    initial-exact (k i : Fin n) : Id C.Pair[k,i].P.L.Carrier
     (C.Pair[k,i].Rho.map (as k i)) (C.Pair[k,i].P.Native.localised.sm (P.power (fs k) r) (c k i)) =
     trans (R.rho-irr (fs i) C.Pair[k,i].overlap (Data.Data.right (fs k) (fs i))
      Overlap.At[fs k,fs i].below (as k i)) (initial k i) ;
    module Error (k i j : Fin n) {
     module Q = C.Pair[i,j] ; module N = Q.P.Native ; module ML = Q.P.Laws ;
     module T = D.Triple[k,i,j] ;
     module TL = SM.Over[A].Laws[T.P.Native.localised] ;
     module Group = SerreCechAlgebra[l].Over[A,T.P.Native.localised] ;
     module Sub = CE.Over[A].Along[N.localised,T.P.Native.localised,T.IJ.native] ;
     right : N.L.Carrier = Q.Rho.map (as k j) ;
     left : N.L.Carrier = Q.L.map (as k i) ;
     target : N.L.Carrier = N.localised.sm (P.power (fs k) r) (c i j) ;
     error : N.L.Carrier = ML.sub (ML.sub right left) target ;
     error-at : Id N.L.Carrier error (ML.sub (ML.sub right left) target) = refl error ;
     image-right : Id T.P.L.Carrier (T.IJ.map right)
      (T.P.Native.localised.sm (P.power (fs k) r) (T.KJ.map (c k j))) =
      trans (T.through-j (as k j))
       (trans (ap T.KJ.map (initial-exact k j)) (T.KJ.map-scale (P.power (fs k) r) (c k j))) ;
     image-left : Id T.P.L.Carrier (T.IJ.map left)
      (T.P.Native.localised.sm (P.power (fs k) r) (T.KI.map (c k i))) =
      trans (T.through-i (as k i))
       (trans (ap T.KI.map (initial-exact k i)) (T.KI.map-scale (P.power (fs k) r) (c k i))) ;
     cocycle-difference : Id T.P.L.Carrier
      (TL.sub (T.KJ.map (c k j)) (T.KI.map (c k i))) (T.IJ.map (c i j)) =
      trans (ap (\ x -> TL.sub x (T.KI.map (c k i))) (sym (cocycle k i j)))
       (trans (ap (\ x -> TL.sub x (T.KI.map (c k i)))
        (T.P.Native.localised.maddC (T.KI.map (c k i)) (T.IJ.map (c i j))))
        (Group.sub-cancel-right (T.IJ.map (c i j)) (T.KI.map (c k i)))) ;
     image-difference : Id T.P.L.Carrier (T.IJ.map (ML.sub right left))
      (T.P.Native.localised.sm (P.power (fs k) r) (T.IJ.map (c i j))) =
      trans (Sub.map-sub right left)
       (trans (cong2 T.P.L.Carrier TL.sub _ _ _ _ image-right image-left)
        (trans (sym (TL.sm-sub (P.power (fs k) r) (T.KJ.map (c k j)) (T.KI.map (c k i))))
         (ap (T.P.Native.localised.sm (P.power (fs k) r)) cocycle-difference))) ;
     image-target : Id T.P.L.Carrier (T.IJ.map target)
      (T.P.Native.localised.sm (P.power (fs k) r) (T.IJ.map (c i j))) = T.IJ.map-scale (P.power (fs k) r) (c i j) ;
     vanishes : Id T.P.L.Carrier (T.IJ.map error) T.P.Native.Action.mz =
      trans (Sub.map-sub (ML.sub right left) target)
       (trans (cong2 T.P.L.Carrier TL.sub _ _ _ _ image-difference image-target)
        (TL.sub-self (T.P.Native.localised.sm (P.power (fs k) r) (T.IJ.map (c i j))))) ;
     killed : Tr.Trunc[T.Step.Kill error].carrier = T.Step.kill error vanishes ;
     opaque error ;
    } ;
    module Errors = CE.Over[A].Cube[n,n,n,
     \ k i j -> C.Pair[i,j].P.Native.localised,\ k i j -> fs k,\ k i j -> Error[k,i,j].error] ;
    common-errors : Tr.Trunc[Errors.Common].carrier = Errors.common (\ k i j -> Error[k,i,j].killed) ;
    module Correct (e : Nat)
     (kills : (k i j : Fin n) -> Id C.Pair[i,j].P.L.Carrier
      (C.Pair[i,j].P.Native.localised.sm (P.power (fs k) e) Error[k,i,j].error) C.Pair[i,j].P.Native.Action.mz) {
     numerators (k i : Fin n) : C.Index[i].P.L.Carrier =
      C.Index[i].P.Native.localised.sm (P.power (fs k) e) (as k i) ;
     module AtTriple (k i j : Fin n) {
      module Q = C.Pair[i,j] ; module N = Q.P.Native ; module ML = Q.P.Laws ; module E = Error[k,i,j] ;
      killed-equality : Id N.L.Carrier
       (N.localised.sm (P.power (fs k) e) (ML.sub E.right E.left))
       (N.localised.sm (P.power (fs k) e) E.target) =
       ML.sub-zero _ _
        (trans (sym (ML.sm-sub (P.power (fs k) e) (ML.sub E.right E.left) E.target))
         (trans (sym (ap (N.localised.sm (P.power (fs k) e)) E.error-at)) (kills k i j))) ;
      exact : Id N.L.Carrier (ML.sub (Q.Rho.map (numerators k j)) (Q.L.map (numerators k i)))
       (N.localised.sm (P.power (fs k) (plus r e)) (c i j)) =
       trans (cong2 N.L.Carrier ML.sub _ _ _ _
        (Q.Rho.map-scale (P.power (fs k) e) (as k j)) (Q.L.map-scale (P.power (fs k) e) (as k i)))
        (trans (sym (ML.sm-sub (P.power (fs k) e) E.right E.left))
         (trans killed-equality
          (CF.Over[A].Action[N.localised].raise (fs k) r (plus r e) (e,refl (plus r e)) (c i j)))) ;
     } ;
     boundary : D.IsBoundary c = Partition.Exact[c,plus r e,numerators,\ k i j -> AtTriple[k,i,j].exact].boundary ;
    } ;
    boundary : D.IsBoundary c = Tr.Trunc[Errors.Common].induction @l
     (\ w -> D.IsBoundary c) (\ w -> Tr.Trunc[(bs : C.Families) * D.Boundary c bs].proposition)
     (\ w -> Correct[w.1,w.2].boundary) common-errors ;
   } ;
   boundary : D.IsBoundary c = Tr.Trunc[FirstClear.Common].induction @l
    (\ w -> D.IsBoundary c) (\ w -> Tr.Trunc[(bs : C.Families) * D.Boundary c bs].proposition)
    (\ w -> Initial[w.1,w.2.1,w.2.2].boundary) first-clearing ;
  } ;
  vanishing (c : D.Cochain) (cocycle : D.CocycleLaw c) : D.IsBoundary c = AtCocycle[c,cocycle].boundary ;
 } ;
} ;
