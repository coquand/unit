-- Equality of maps of ringed lattices (review of Next 4 (a)).
--
-- Fix (L, F) and (M, G).  A map is a lattice map pi, ring maps
-- pi#_u : F(u) -> G(pi u) and naturality; as a type it is a retract of
-- the Sigma type of these parts (the record has no eta; split gives it in
-- Id).
-- Lemma (set).  Maps form a set: lattice maps and ring maps into sets form
--  sets (funext), and naturality is a proposition.
-- Lemma (ext).  If pi u = pi2 u for all u, and pi#_u followed by the
--  restriction along pi2 u <= pi u is pi2#_u, then pi = pi2.  The lattice
--  maps are equal (pointwise, DistLattice.HomProperties); by path
--  induction on that equality one may take them identical, and then the
--  restriction is along v <= v, the identity (res-id): the ring maps are
--  equal pointwise, hence equal, and naturality is a proposition.  Any
--  witness of the inequality will do (res-irr).
-- Lemma (local).  Locality is a proposition (a family of inequalities), so
--  local maps form a set, and two are equal when their maps are.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module Maps (L M : DL.DLat) (F : RingedLattice[l].On[L].Presheaf) (G : RingedLattice[l].On[M].Presheaf) {
 module OL = DL.Order[L] ;
 module OM = DL.Order[M] ;
 module GO = RingedLattice[l].On[M].Of[G] ;
 module HP = DL.HomProperties[L,M] ;
 module Mp = LocallyRinged[l].Maps[L,M,F,G] ;

 -- the parts of a map
 Sharp (lat : DL.Hom L M) : U l = (u : L.L) -> RH.Hom (F.ring u) (G.ring (DL.hmap lat u)) ;
 Natural (lat : DL.Hom L M) (sharp : Sharp lat) : U l =
  (u v : L.L) (k : OL.Le u v) (x : (F.ring v).R) ->
   Id (G.ring (DL.hmap lat u)).R
    (map (G.res (DL.hmap lat u) (DL.hmap lat v) (DL.JoinMaps[L,M,lat].monotone u v k)) (map (sharp v) x))
    (map (sharp u) (map (F.res u v k) x)) ;
 Parts (lat : DL.Hom L M) : U l = (sharp : Sharp lat) * Natural lat sharp ;
 Total : U l = (lat : DL.Hom L M) * Parts lat ;
 to-total (pi : Mp.Ringed) : Total = (pi.lat,pi.sharp,pi.natural) ;
 from-total (t : Total) : Mp.Ringed = new Mp.Ringed[t.1,t.2.1,t.2.2] ;
 from-to : (pi : Mp.Ringed) -> Id Mp.Ringed (from-total (to-total pi)) pi =
  split { Ringed lat sharp natural -> refl (new Mp.Ringed[lat,sharp,natural]) } ;

 -- (set)
 natural-prop (lat : DL.Hom L M) (sharp : Sharp lat) : Pr.isProp (Natural lat sharp) =
  FE.isProp-Pi L.L (\ u -> (v : L.L) (k : OL.Le u v) (x : (F.ring v).R) ->
    Id (G.ring (DL.hmap lat u)).R
     (map (G.res (DL.hmap lat u) (DL.hmap lat v) (DL.JoinMaps[L,M,lat].monotone u v k)) (map (sharp v) x))
     (map (sharp u) (map (F.res u v k) x))) (\ u ->
   FE.isProp-Pi L.L (\ v -> (k : OL.Le u v) (x : (F.ring v).R) ->
     Id (G.ring (DL.hmap lat u)).R
      (map (G.res (DL.hmap lat u) (DL.hmap lat v) (DL.JoinMaps[L,M,lat].monotone u v k)) (map (sharp v) x))
      (map (sharp u) (map (F.res u v k) x))) (\ v ->
    FE.isProp-Pi (OL.Le u v) (\ k -> (x : (F.ring v).R) ->
      Id (G.ring (DL.hmap lat u)).R
       (map (G.res (DL.hmap lat u) (DL.hmap lat v) (DL.JoinMaps[L,M,lat].monotone u v k)) (map (sharp v) x))
       (map (sharp u) (map (F.res u v k) x))) (\ k ->
     FE.isProp-Pi (F.ring v).R (\ x ->
       Id (G.ring (DL.hmap lat u)).R
        (map (G.res (DL.hmap lat u) (DL.hmap lat v) (DL.JoinMaps[L,M,lat].monotone u v k)) (map (sharp v) x))
        (map (sharp u) (map (F.res u v k) x))) (\ x ->
      G.ring-set (DL.hmap lat u)
       (map (G.res (DL.hmap lat u) (DL.hmap lat v) (DL.JoinMaps[L,M,lat].monotone u v k)) (map (sharp v) x))
       (map (sharp u) (map (F.res u v k) x)))))) ;
 sharp-set (lat : DL.Hom L M) : Pr.isSet (Sharp lat) =
  FE.isSet-Pi L.L (\ u -> RH.Hom (F.ring u) (G.ring (DL.hmap lat u))) (\ u ->
   RH.Properties[F.ring u,G.ring (DL.hmap lat u),G.ring-set (DL.hmap lat u)].set) ;
 parts-set (lat : DL.Hom L M) : Pr.isSet (Parts lat) =
  Pr.isSet-Sigma (Sharp lat) (Natural lat) (sharp-set lat) (\ sharp -> Pr.prop-to-set (Natural lat sharp) (natural-prop lat sharp)) ;
 set : Pr.isSet Mp.Ringed =
  Pr.isSet-retract Mp.Ringed Total to-total from-total from-to (Pr.isSet-Sigma (DL.Hom L M) Parts HP.set parts-set) ;

 -- (ext)
 -- the ring maps of pi, restricted along le, are those of pi2
 SharpEq (lat lat2 : DL.Hom L M) (le : (u : L.L) -> OM.Le (DL.hmap lat2 u) (DL.hmap lat u)) (sharp : Sharp lat) (sharp2 : Sharp lat2) : U l =
  (u : L.L) (x : (F.ring u).R) ->
   Id (G.ring (DL.hmap lat2 u)).R (GO.restrict (DL.hmap lat2 u) (DL.hmap lat u) (le u) (map (sharp u) x)) (map (sharp2 u) x) ;
 -- the inequality given by an equality of lattice maps
 le-of (lat lat2 : DL.Hom L M) (P : Id (DL.Hom L M) lat lat2) (u : L.L) : OM.Le (DL.hmap lat2 u) (DL.hmap lat u) =
  OM.le-of-eq (DL.hmap lat2 u) (DL.hmap lat u) (ap (\ h -> DL.hmap h u) (sym P)) ;
 -- by path induction on the lattice maps; for identical ones the
 -- restriction is the identity
 total-ext (lat : DL.Hom L M) (p : Parts lat) : (lat2 : DL.Hom L M) (P : Id (DL.Hom L M) lat lat2) (p2 : Parts lat2)
  (h : SharpEq lat lat2 (le-of lat lat2 P) p.1 p2.1) -> Id Total (lat,p) (lat2,p2) =
  \ lat2 P -> idJ (DL.Hom L M) lat
   (\ lat3 P3 -> (p3 : Parts lat3) -> SharpEq lat lat3 (le-of lat lat3 P3) p.1 p3.1 -> Id Total (lat,p) (lat3,p3))
   (\ p3 h3 -> ap (\ q -> (lat,q))
     (Pr.Sigma-eq (Sharp lat) (Natural lat) p.1 p3.1 p.2 p3.2
      (FE.funext L.L (\ u -> RH.Hom (F.ring u) (G.ring (DL.hmap lat u))) p.1 p3.1 (\ u ->
        RH.Properties[F.ring u,G.ring (DL.hmap lat u),G.ring-set (DL.hmap lat u)].ext (p.1 u) (p3.1 u) (\ x ->
         trans (sym (G.res-id (DL.hmap lat u) (le-of lat lat (refl lat) u) (map (p.1 u) x))) (h3 u x))))
      (natural-prop lat p3.1)))
   lat2 P ;
 ext (pi pi2 : Mp.Ringed) (lat-eq : (u : L.L) -> Id M.L (DL.hmap pi.lat u) (DL.hmap pi2.lat u))
  (le : (u : L.L) -> OM.Le (DL.hmap pi2.lat u) (DL.hmap pi.lat u)) (sharp-eq : SharpEq pi.lat pi2.lat le pi.sharp pi2.sharp) :
  Id Mp.Ringed pi pi2 = calc Mp.Ringed {
  pi =< sym (from-to pi) > from-total (to-total pi)
   =< ap from-total (total-ext pi.lat (pi.sharp,pi.natural) pi2.lat (HP.ext pi.lat pi2.lat lat-eq) (pi2.sharp,pi2.natural) (\ u x ->
       trans (GO.res-irr (DL.hmap pi2.lat u) (DL.hmap pi.lat u) (le-of pi.lat pi2.lat (HP.ext pi.lat pi2.lat lat-eq) u) (le u)
         (map (pi.sharp u) x)) (sharp-eq u x)))
   > from-total (to-total pi2)
   =< from-to pi2 > pi2 } ;

 -- (local)
 module Local (DF : InvOpen[l].On[L].Of[F].InvMap) (DG : InvOpen[l].On[M].Of[G].InvMap) {
  module LF = LocallyRinged[l].On[L].Laws[F,DF] ;
  module LG = LocallyRinged[l].On[M].Laws[G,DG] ;
  local-prop (pi : Mp.Ringed) : Pr.isProp (Mp.Of[pi,DF,DG].IsLocal) =
   FE.isProp-Pi L.L (\ u -> (s : (F.ring u).R) -> OM.Le (LG.d (DL.hmap pi.lat u) (map (pi.sharp u) s)) (DL.hmap pi.lat (LF.d u s))) (\ u ->
    FE.isProp-Pi (F.ring u).R (\ s -> OM.Le (LG.d (DL.hmap pi.lat u) (map (pi.sharp u) s)) (DL.hmap pi.lat (LF.d u s))) (\ s ->
     OM.le-prop (LG.d (DL.hmap pi.lat u) (map (pi.sharp u) s)) (DL.hmap pi.lat (LF.d u s)))) ;
  LocalMap : U l = (pi : Mp.Ringed) * Mp.Of[pi,DF,DG].IsLocal ;
  local-set : Pr.isSet LocalMap =
   Pr.isSet-Sigma Mp.Ringed (\ pi -> Mp.Of[pi,DF,DG].IsLocal) set (\ pi -> Pr.prop-to-set (Mp.Of[pi,DF,DG].IsLocal) (local-prop pi)) ;
  local-ext (a b : LocalMap) (e : Id Mp.Ringed a.1 b.1) : Id LocalMap a b =
   Pr.Sigma-eq Mp.Ringed (\ pi -> Mp.Of[pi,DF,DG].IsLocal) a.1 b.1 a.2 b.2 e (local-prop b.1) ;
 } ;
} ;
