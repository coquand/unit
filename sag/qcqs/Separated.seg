-- Separation on arbitrary opens (DESIGN.md, step 3, item 2).
-- For s in O(u) and s' in O(u'), say that s and s' agree on an open v
-- when s_h = s'_h for every h with D h <= v, D h <= u and D h <= u'.
--
-- (i) If v = D c_1 \/ .. \/ D c_n and s, s' agree on each D c_j, they
--  agree on v.  For D h <= v, D h is covered by the D(h c_j)
--  (BasicCover), and rho_j(s_h) = s_{h c_j} = s'_{h c_j} = rho_j(s'_h)
--  by compatibility, since D(h c_j) <= D c_j.  Hence s_h = s'_h
--  (Separation).
-- (ii) Agreement on v and on w gives agreement on v \/ w.  The claim
--  s_h = s'_h is a proposition, so presentations of v and w may be used;
--  v \/ w is presented by both families, each generator of which lies
--  below v or below w.
-- (iii) Agreement on bottom, by (i) with no generators; by induction,
--  agreement on each u_i gives agreement on u_1 \/ .. \/ u_n.
--
-- Theorem.  If u_i <= u, u <= u_1 \/ .. \/ u_n and s|u_i = s'|u_i for all i,
--  then s = s'.  Every D g <= u lies below the join, and the components of
--  s|u_i are those of s.
-- Corollary.  Given sections x_i of O(u_i), the type of amalgams
--  (s in O(u) with s|u_i = x_i for all i) is a proposition.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (A : CRing) (Loc : A.R -> CRing) (set : (g : A.R) -> Pr.isSet (Loc g).R)
 (f : (g : A.R) -> RH.Hom A (Loc g))
 (el : (g : A.R) -> Bridge[l].Over[A,g].LocH.Elementary (Loc g) (f g)) {
 open A ;
 open Radical[l].Over[A] ; open FamilyLattice[l].Over[A] ;
 open ZariskiLattice[l].Over[A] ;
 module S = Sections[l].Over[A,Loc,set,f,el] ;
 module Sep = Separation[l].Over[A,Loc,set,f,el] ;

 -- s in O(u) and s2 in O(u2) agree on v
 module Pair (u u2 : lattice.L) (s : S.Section u) (s2 : S.Section u2) {
  Agree (v : lattice.L) : U l =
   (h : R) (hv : O.Le (D h) v) (hu : O.Le (D h) u) (hu2 : O.Le (D h) u2) -> Id (Loc h).R (S.at s h hu) (S.at s2 h hu2) ;
  agree-prop (v : lattice.L) : Pr.isProp (Agree v) =
   F.isProp-Pi R (\ h -> (hv : O.Le (D h) v) (hu : O.Le (D h) u) (hu2 : O.Le (D h) u2) -> Id (Loc h).R (S.at s h hu) (S.at s2 h hu2)) (\ h ->
   F.isProp-Pi (O.Le (D h) v) (\ hv -> (hu : O.Le (D h) u) (hu2 : O.Le (D h) u2) -> Id (Loc h).R (S.at s h hu) (S.at s2 h hu2)) (\ hv ->
   F.isProp-Pi (O.Le (D h) u) (\ hu -> (hu2 : O.Le (D h) u2) -> Id (Loc h).R (S.at s h hu) (S.at s2 h hu2)) (\ hu ->
   F.isProp-Pi (O.Le (D h) u2) (\ hu2 -> Id (Loc h).R (S.at s h hu) (S.at s2 h hu2)) (\ hu2 ->
   set h _ _)))) ;

  -- (i) agreement on the generators of a presentation
  module Local (v : lattice.L) (a : Fam) (e : Id lattice.L v (J.bigJ (size a) (\ j -> D (gen a j))))
   (ag : (j : Fin (size a)) -> Agree (D (gen a j))) {
   module At (h : R) (hv : O.Le (D h) v) (hu : O.Le (D h) u) (hu2 : O.Le (D h) u2) {
    le : O.Le (D h) (J.bigJ (size a) (\ j -> D (gen a j))) =
     Pr.subst lattice.L (\ x -> O.Le (D h) x) v (J.bigJ (size a) (\ j -> D (gen a j))) e hv ;
    module BC = BasicCover[h,size a,gen a,le] ;
    module SC = Sep.Cover[h,size a,\ j -> mul h (gen a j),BC.below,BC.covers] ;
    hu-j (j : Fin (size a)) : O.Le (D (mul h (gen a j))) u = O.le-trans (D (mul h (gen a j))) (D h) u (BC.below j) hu ;
    hu2-j (j : Fin (size a)) : O.Le (D (mul h (gen a j))) u2 = O.le-trans (D (mul h (gen a j))) (D h) u2 (BC.below j) hu2 ;
    agree : Id (Loc h).R (S.at s h hu) (S.at s2 h hu2) =
     SC.injective (S.at s h hu) (S.at s2 h hu2) (\ j -> calc (Loc (mul h (gen a j))).R {
      map (SC.rho-i j) (S.at s h hu)
       =< S.compat s h (mul h (gen a j)) hu (BC.below j) > S.at s (mul h (gen a j)) (hu-j j)
       =< ag j (mul h (gen a j)) (BC.below-gen j) (hu-j j) (hu2-j j) > S.at s2 (mul h (gen a j)) (hu2-j j)
       =< sym (S.compat s2 h (mul h (gen a j)) hu2 (BC.below j)) > map (SC.rho-i j) (S.at s2 h hu2) }) ;
   } ;
   agree : Agree v = \ h hv hu hu2 -> At[h,hv,hu,hu2].agree ;
  } ;
  -- below an open on which s and s2 agree
  agree-below (v w : lattice.L) (vw : O.Le v w) (ag : Agree w) : Agree v =
   \ h hv hu hu2 -> ag h (O.le-trans (D h) v w hv vw) hu hu2 ;

  -- (ii) binary joins
  module Join (v w : lattice.L) (av : Agree v) (aw : Agree w) {
   module Both (p : Presentation v) (q : Presentation w) {
    agree : Agree (lattice.join v w) =
     Local[lattice.join v w,cat (generators p) (generators q),join-presents p q,
      cat-all (generators p) (generators q) (\ x -> Agree (D x))
       (\ i -> agree-below (D (gen (generators p) i)) v (gen-below p i) av)
       (\ j -> agree-below (D (gen (generators q) j)) w (gen-below q j) aw)].agree ;
   } ;
   agree : Agree (lattice.join v w) = \ h hv hu hu2 ->
    Tr.Trunc[Presentation v].induction @l (\ x -> Id (Loc h).R (S.at s h hu) (S.at s2 h hu2)) (\ x -> set h _ _)
     (\ p -> Tr.Trunc[Presentation w].induction @l (\ x -> Id (Loc h).R (S.at s h hu) (S.at s2 h hu2)) (\ x -> set h _ _)
       (\ q -> Both[p,q].agree h hv hu hu2)
       (presented w))
     (presented v) ;
  } ;

  -- (iii) bottom, finite joins, covers
  agree-bot : Agree lattice.bot =
   Local[lattice.bot,empty,bot-presents,AffineFinite[l].empty-section (\ j -> Agree (D (gen empty j)))].agree ;
  agree-joins : (n : Nat) (us : Fin n -> lattice.L) -> ((i : Fin n) -> Agree (us i)) -> Agree (J.bigJ n us) = split {
   zero -> \ us ag -> agree-bot ;
   suc n | r -> \ us ag -> Join[us (inr tt),J.bigJ n (\ i -> us (inl i)),ag (inr tt),r (\ i -> us (inl i)) (\ i -> ag (inl i))].agree } ;
  agree-cover (v : lattice.L) (n : Nat) (ws : Fin n -> lattice.L) (cov : O.Le v (J.bigJ n ws))
   (ag : (i : Fin n) -> Agree (ws i)) : Agree v =
   agree-below v (J.bigJ n ws) cov (agree-joins n ws ag) ;

  -- restrictions to v that are equal agree on v
  agree-restrict (v : lattice.L) (vu : O.Le v u) (vu2 : O.Le v u2)
   (e : Id (S.Section v) (S.restrict v u vu s) (S.restrict v u2 vu2 s2)) : Agree v =
   \ h hv hu hu2 -> calc (Loc h).R {
    S.at s h hu
     =< S.component-irr u s h hu (O.le-trans (D h) v u hv vu) > S.at s h (O.le-trans (D h) v u hv vu)
     =< sym (S.restrict-at v u vu s h hv) > S.at (S.restrict v u vu s) h hv
     =< ap (\ x -> S.at x h hv) e > S.at (S.restrict v u2 vu2 s2) h hv
     =< S.restrict-at v u2 vu2 s2 h hv > S.at s2 h (O.le-trans (D h) v u2 hv vu2)
     =< S.component-irr u2 s2 h (O.le-trans (D h) v u2 hv vu2) hu2 > S.at s2 h hu2 } ;
 } ;
 -- two sections of O(u) that agree on u are equal
 equal (u : lattice.L) (s s2 : S.Section u) (ag : Pair[u,u,s,s2].Agree u) : Id (S.Section u) s s2 =
  S.section-ext u s s2 (\ g k -> ag g k k k) ;

 -- a cover of u: u_i <= u and u <= u_1 \/ .. \/ u_n
 module Cover (u : lattice.L) (n : Nat) (us : Fin n -> lattice.L) (le : (i : Fin n) -> O.Le (us i) u)
  (covers : O.Le u (J.bigJ n us)) {
  separated (s s2 : S.Section u) (e : (i : Fin n) -> Id (S.Section (us i)) (S.restrict (us i) u (le i) s) (S.restrict (us i) u (le i) s2)) :
   Id (S.Section u) s s2 =
   equal u s s2 (Pair[u,u,s,s2].agree-cover u n us covers (\ i -> Pair[u,u,s,s2].agree-restrict (us i) (le i) (le i) (e i))) ;

  -- amalgams of a family x_i of sections of the O(u_i)
  Matches (xs : (i : Fin n) -> S.Section (us i)) (s : S.Section u) : U l =
   (i : Fin n) -> Id (S.Section (us i)) (S.restrict (us i) u (le i) s) (xs i) ;
  Amalgam (xs : (i : Fin n) -> S.Section (us i)) : U l = (s : S.Section u) * Matches xs s ;
  amalgam {xs : (i : Fin n) -> S.Section (us i)} (a : Amalgam xs) : S.Section u = a.1 ;
  matches {xs : (i : Fin n) -> S.Section (us i)} (a : Amalgam xs) : Matches xs (amalgam a) = a.2 ;
  matches-prop (xs : (i : Fin n) -> S.Section (us i)) (s : S.Section u) : Pr.isProp (Matches xs s) =
   F.isProp-Pi (Fin n) (\ i -> Id (S.Section (us i)) (S.restrict (us i) u (le i) s) (xs i))
    (\ i -> S.section-set (us i) _ _) ;
  amalgam-prop (xs : (i : Fin n) -> S.Section (us i)) : Pr.isProp (Amalgam xs) = \ a b ->
   Pr.Sigma-eq (S.Section u) (Matches xs) (amalgam a) (amalgam b) (matches a) (matches b)
    (separated (amalgam a) (amalgam b) (\ i -> trans (matches a i) (sym (matches b i))))
    (matches-prop xs (amalgam b)) ;
 } ;
} ;
