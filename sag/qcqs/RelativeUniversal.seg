-- Full faithfulness over an arbitrary commutative base ring K.
-- Extend a relative natural family to ordinary rings (RelativeFamilies),
-- and recover its geometric map f by PointsUniversal.  For every affine
-- point p, the ordinary inverse law and the output base equation give
-- s_Y f p = s_X p.  ProbeSeparation makes f a map over K.
-- On a relative point, the ordinary inverse law and on-relative identify
-- the underlying points; point-ext identifies the relative points.
-- This gives induced(recover alpha) = alpha.  Relative faithfulness follows
-- by evaluating equality on canonical lifts of every ordinary affine
-- probe, forgetting base equations, and using ProbeSeparation.  It gives
-- recover(induced f) = f, including the base condition, a proposition.
-- The map type lies in U l, natural transformations in U (l+1); the
-- equivalence is stated in U (l+1), without propositional resizing.
level l ; open Ring[l] ;
module Hi = Prelude[l+] ;
module Sp = Spaces[l] ;
module T = AffineTests[l] ;
module Over (K : T.Test) (X Y : Sp.Space) (sx : Sp.Hom X (T.space K)) (sy : Sp.Hom Y (T.space K))
 (qcqs : Qcqs[l].Over[X.lattice,X.structure].IsQcqs) {
 module R = RelativeFamilies[l].Over[K,X,Y,sx,sy] ;
 module AU = PointsUniversal[l].Over[X,Y,qcqs] ;
 module PS = ProbeSeparation[l].Over[X,T.space K] ;
 module ForFamily (alpha : R.Nat) {
  module E = R.OrdinaryExtension[alpha] ;
  morphism : Sp.Hom X Y = AU.recover E.extend ;
  equation (B : T.Test) (p : Sp.Hom (T.space B) X) : Id (Sp.Hom (T.space B) Y)
   (Sp.compose (T.space B) X Y morphism p) (R.Ordinary.at E.extend B p) =
   Hi.ap R.Ordinary.Nat (Sp.Hom (T.space B) Y) (\ a -> R.Ordinary.at a B p) (R.Ordinary.induced morphism) E.extend (AU.induced-recover E.extend) ;
  base-equation (B : T.Test) (p : Sp.Hom (T.space B) X) : Id (Sp.Hom (T.space B) (T.space K))
   (Sp.compose (T.space B) X (T.space K) (Sp.compose X Y (T.space K) sy morphism) p)
   (Sp.compose (T.space B) X (T.space K) sx p) =
   trans (sym Sp.Associativity[T.space B,X,Y,T.space K,sy,morphism,p].assoc)
    (trans (ap (Sp.compose (T.space B) Y (T.space K) sy) (equation B p)) (E.base-output B p)) ;
  over-base : Id (Sp.Hom X (T.space K)) (Sp.compose X Y (T.space K) sy morphism) sx =
   PS.Compare[Sp.compose X Y (T.space K) sy morphism,sx,base-equation].separated qcqs ;
  over-map : R.OverMap = (morphism,over-base) ;
  induced : Id R.Nat (R.induced over-map) alpha =
   R.ext (R.induced over-map) alpha (\ A p -> R.PY.point-ext A (R.at (R.induced over-map) A p) (R.at alpha A p)
    (trans (equation (R.BP.test A) (R.PX.point p)) (E.on-relative A p))) ;
 } ;
 module Compare (f g : R.OverMap) (e : Id R.Nat (R.induced f) (R.induced g)) {
  module At (B : T.Test) (p : Sp.Hom (T.space B) X) {
   algebra : R.BP.Algebra = R.BP.algebra B (R.PX.At[B].lift p).1 ;
   values : Id (R.PY.Points algebra)
    (R.at (R.induced f) algebra (R.PX.At[B].lift p).2) (R.at (R.induced g) algebra (R.PX.At[B].lift p).2) =
    Hi.ap R.Nat (R.PY.Points algebra) (\ a -> R.at a algebra (R.PX.At[B].lift p).2) (R.induced f) (R.induced g) e ;
   equation : Id (Sp.Hom (T.space B) Y) (Sp.compose (T.space B) X Y f.1 p) (Sp.compose (T.space B) X Y g.1 p) =
    ap (R.PY.point {algebra}) values ;
  } ;
  faithful : Id R.OverMap f g = R.map-ext f g
   (ProbeSeparation[l].Over[X,Y].Compare[f.1,g.1,\ B p -> At[B,p].equation].separated qcqs) ;
 } ;
 recover (alpha : R.Nat) : R.OverMap = ForFamily[alpha].over-map ;
 induced-recover (alpha : R.Nat) : Id R.Nat (R.induced (recover alpha)) alpha = ForFamily[alpha].induced ;
 recover-induced (f : R.OverMap) : Id R.OverMap (recover (R.induced f)) f = Compare[recover (R.induced f),f,induced-recover (R.induced f)].faithful ;
 equivalence : Hi.isEquiv R.OverMap R.Nat R.induced = Hi.qinv R.OverMap R.Nat R.induced recover induced-recover recover-induced ;
} ;
