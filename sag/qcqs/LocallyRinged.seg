-- Locally ringed lattices and their morphisms (DESIGN.md, step 4, stage 3;
-- zeuner1 Def. 3.4 and Remark 3.6).
--
-- Let G be a presheaf of rings on M with an invertibility map, D_u(s) the
-- invertibility open of s in G(u) (InvOpen).  D_u is a support when
--  D_u(1) = u,  D_u(0) = bot,  D_u(s t) = D_u(s) /\ D_u(t),
--  D_u(s + t) <= D_u(s) \/ D_u(t).
-- Lemma (one, mul).  The first and third laws hold for every invertibility
--  map.  1 is a unit, so u is its invertibility open (InvOpen.whole).
--  For w <= u, (s t)|w = s|w t|w is a unit iff s|w and t|w are, iff
--  w <= D_u(s) /\ D_u(t); so D_u(s) /\ D_u(t) is an invertibility open of s t,
--  and equal to D_u(s t) by uniqueness.  Hence locality asks only the laws
--  for 0 and +.
-- A locally ringed lattice: a sheaf of rings with an invertibility map that
--  is a support.  The invertibility map is unique (InvOpen.inv-map-prop) and
--  the laws are equations in sets, so over a fixed ringed lattice locality
--  is a proposition.  The record LocallyRinged packages the sheaf data too,
--  which varies.
--
-- Morphisms.  A map of ringed lattices (L, F) -> (M, G): a lattice map
--  pi : L -> M and ring maps pi#_u : F(u) -> G(pi u) commuting with
--  restriction.  Remark 3.6: pi(D_u s) <= D_(pi u)(pi# s), since
--  (pi# s)|pi(D_u s) = pi#(s|D_u s) and ring maps carry units to units.
--  The map is local when the converse holds; then the two are equal.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;
module On (M : DL.DLat) {
 module O = DL.Order[M] ;
 module RG = RingedLattice[l].On[M] ;
 module Laws (G : RG.Presheaf) (inv : InvOpen[l].On[M].Of[G].InvMap) {
  module GO = RG.Of[G] ;
  module IO = InvOpen[l].On[M].Of[G] ;
  -- D_u(s)
  d (u : M.L) (s : (G.ring u).R) : M.L = IO.open-of (inv u s) ;
  d-open (u : M.L) (s : (G.ring u).R) : IO.IsInvOpen u s (d u s) = IO.is-inv-open (inv u s) ;

  -- D_u(1) = u
  one-law (u : M.L) : Id M.L (d u (G.ring u).o) u =
   IO.unique (d-open u (G.ring u).o) (IO.whole u (G.ring u).o ((G.ring u).o,(G.ring u).mulO (G.ring u).o)) ;

  -- D_u(s t) = D_u(s) /\ D_u(t)
  module Product (u : M.L) (s t : (G.ring u).R) {
   v : M.L = M.meet (d u s) (d u t) ;
   -- (s t)|w = s|w t|w
   res-mul (w : M.L) (k : O.Le w u) :
    Id (G.ring w).R (GO.restrict w u k ((G.ring u).mul s t)) ((G.ring w).mul (GO.restrict w u k s) (GO.restrict w u k t)) =
    map-mul (G.res w u k) s t ;
   forward (w : M.L) (k : O.Le w u) (h : O.Le w v) : IO.Unit w (GO.restrict w u k ((G.ring u).mul s t)) =
    Pr.subst (G.ring w).R (IO.Unit w) _ _ (sym (res-mul w k))
     (AffineRing[l].Laws[G.ring w,G.ring-set w].unit-product (GO.restrict w u k s) (GO.restrict w u k t)
      (IO.to-unit (d-open u s) w k (O.le-trans w v (d u s) h (O.meet-left (d u s) (d u t))))
      (IO.to-unit (d-open u t) w k (O.le-trans w v (d u t) h (O.meet-right (d u s) (d u t))))) ;
   backward (w : M.L) (k : O.Le w u) (e : IO.Unit w (GO.restrict w u k ((G.ring u).mul s t))) : O.Le w v =
    O.meet-glb (d u s) (d u t) w
     (IO.from-unit (d-open u s) w k (AffineRing[l].Laws[G.ring w,G.ring-set w].unit-left
       (GO.restrict w u k s) (GO.restrict w u k t) (Pr.subst (G.ring w).R (IO.Unit w) _ _ (res-mul w k) e)))
     (IO.from-unit (d-open u t) w k (AffineRing[l].Laws[G.ring w,G.ring-set w].unit-right
       (GO.restrict w u k s) (GO.restrict w u k t) (Pr.subst (G.ring w).R (IO.Unit w) _ _ (res-mul w k) e))) ;
   is-open : IO.IsInvOpen u ((G.ring u).mul s t) v =
    (O.le-trans v (d u s) u (O.meet-left (d u s) (d u t)) (IO.below (d-open u s)),forward,backward) ;
  } ;
  mul-law (u : M.L) (s t : (G.ring u).R) : Id M.L (d u ((G.ring u).mul s t)) (M.meet (d u s) (d u t)) =
   IO.unique (d-open u ((G.ring u).mul s t)) Product[u,s,t].is-open ;

  -- the two laws that are conditions
  ZeroLaw : U l = (u : M.L) -> Id M.L (d u (G.ring u).z) M.bot ;
  AddLaw : U l = (u : M.L) (s t : (G.ring u).R) -> O.Le (d u ((G.ring u).add s t)) (M.join (d u s) (d u t)) ;
  -- Def. 3.4: every D_u is a support
  IsSupport : U l =
   ((u : M.L) -> Id M.L (d u (G.ring u).o) u) * ZeroLaw
   * ((u : M.L) (s t : (G.ring u).R) -> Id M.L (d u ((G.ring u).mul s t)) (M.meet (d u s) (d u t))) * AddLaw ;
  support (zero-law : ZeroLaw) (add-law : AddLaw) : IsSupport = (one-law,zero-law,mul-law,add-law) ;
 } ;

 record LocallyRinged {
  sheaf : RG.Presheaf ;
  is-sheaf : RG.Of[sheaf].IsSheaf ;
  inv : InvOpen[l].On[M].Of[sheaf].InvMap ;
  is-support : Laws[sheaf,inv].IsSupport ;
 } ;
} ;

-- maps of ringed lattices (L, F) -> (M, G)
module Maps (L M : DL.DLat) (F : RingedLattice[l].On[L].Presheaf) (G : RingedLattice[l].On[M].Presheaf) {
 module OL = DL.Order[L] ;
 module OM = DL.Order[M] ;
 record Ringed {
  lat : DL.Hom L M ;
  sharp (u : L.L) : RH.Hom (F.ring u) (G.ring (DL.hmap lat u)) ;
  natural (u v : L.L) (k : OL.Le u v) (x : (F.ring v).R) :
   Id (G.ring (DL.hmap lat u)).R
    (map (G.res (DL.hmap lat u) (DL.hmap lat v) (DL.JoinMaps[L,M,lat].monotone u v k)) (map (sharp v) x))
    (map (sharp u) (map (F.res u v k) x)) ;
 } ;

 module Of (pi : Ringed) (DF : InvOpen[l].On[L].Of[F].InvMap) (DG : InvOpen[l].On[M].Of[G].InvMap) {
  module IF = InvOpen[l].On[L].Of[F] ;
  module IG = InvOpen[l].On[M].Of[G] ;
  module LF = On[L].Laws[F,DF] ;
  module LG = On[M].Laws[G,DG] ;
  p (u : L.L) : M.L = DL.hmap pi.lat u ;
  -- Remark 3.6: pi(D_u s) <= D_(pi u)(pi# s)
  image-le (u : L.L) (s : (F.ring u).R) : OM.Le (p (LF.d u s)) (LG.d (p u) (map (pi.sharp u) s)) =
   IG.from-unit (LG.d-open (p u) (map (pi.sharp u) s)) (p (LF.d u s))
    (DL.JoinMaps[L,M,pi.lat].monotone (LF.d u s) u (IF.below (LF.d-open u s)))
    (Pr.subst (G.ring (p (LF.d u s))).R (IG.Unit (p (LF.d u s)))
      (map (pi.sharp (LF.d u s)) (map (F.res (LF.d u s) u (IF.below (LF.d-open u s))) s))
      (map (G.res (p (LF.d u s)) (p u) (DL.JoinMaps[L,M,pi.lat].monotone (LF.d u s) u (IF.below (LF.d-open u s)))) (map (pi.sharp u) s))
      (sym (pi.natural (LF.d u s) u (IF.below (LF.d-open u s)) s))
      (AffineRing[l].unit-map (F.ring (LF.d u s)) (G.ring (p (LF.d u s))) (pi.sharp (LF.d u s))
        (map (F.res (LF.d u s) u (IF.below (LF.d-open u s))) s) (IF.unit-on (LF.d-open u s)))) ;
  -- local maps: the converse inequality, hence equality
  IsLocal : U l = (u : L.L) (s : (F.ring u).R) -> OM.Le (LG.d (p u) (map (pi.sharp u) s)) (p (LF.d u s)) ;
  local-eq (loc : IsLocal) (u : L.L) (s : (F.ring u).R) : Id M.L (p (LF.d u s)) (LG.d (p u) (map (pi.sharp u) s)) =
   OM.le-antisym (p (LF.d u s)) (LG.d (p u) (map (pi.sharp u) s)) (image-le u s) (loc u s) ;
 } ;
} ;
