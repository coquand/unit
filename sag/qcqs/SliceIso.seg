-- An isomorphism restricts to an isomorphism on inverse-image opens.
-- For pi : X -> Y an isomorphism and e open in Y, SliceMap gives
-- X|pi(e) -> Y|e.  On opens v <= e its map is pi(v) /\ pi(e) = pi(v).
-- The inverse lattice function sends w <= pi(e) to the inverse image of
-- w under the lattice equivalence; its bound by e follows by injectivity
-- and preservation of meet.  The two inverse laws follow from those of
-- pi.  Its section map is pi# followed by restriction between equal opens;
-- both factors are bijective.  These are exactly Iso.IsIso's two clauses.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module DL = DistLattice[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module Over (L M : DL.DLat) (Y : LocallyRinged[l].On[L].LocallyRinged)
 (X : LocallyRinged[l].On[M].LocallyRinged)
 (pi : LocallyRinged[l].Maps[L,M,Y.sheaf,X.sheaf].Ringed)
 (iso : Iso[l].Maps[L,M,Y.sheaf,X.sheaf].IsIso pi) (e : L.L) {
 module OL = DL.Order[L] ;
 module OM = DL.Order[M] ;
 module P = DL.JoinMaps[L,M,pi.lat] ;
 module I = Iso[l].Maps[L,M,Y.sheaf,X.sheaf] ;
 module S = SliceMap[l].Over[L,M,Y,X,pi,e] ;
 module SY = S.SY ;
 module SX = S.SX ;
 image-inc (v : SY.Opens) : Id M.L (SX.inc (DL.hmap S.morphism.lat v)) (DL.hmap pi.lat (SY.inc v)) =
  P.monotone (SY.inc v) e (SY.below v) ;
 inverse-bound (w : SX.Opens) : OL.Le ((I.lat-equiv iso).sec (SX.inc w)) e =
  Iso[l].injective L.L M.L (DL.hmap pi.lat) (I.lat-equiv iso)
   (L.meet ((I.lat-equiv iso).sec (SX.inc w)) e) ((I.lat-equiv iso).sec (SX.inc w))
   (calc M.L {
    DL.hmap pi.lat (L.meet ((I.lat-equiv iso).sec (SX.inc w)) e)
     =< DL.hmap-meet pi.lat ((I.lat-equiv iso).sec (SX.inc w)) e
      > M.meet (DL.hmap pi.lat ((I.lat-equiv iso).sec (SX.inc w))) (DL.hmap pi.lat e)
     =< ap (\ z -> M.meet z (DL.hmap pi.lat e)) ((I.lat-equiv iso).sec-eq (SX.inc w))
      > M.meet (SX.inc w) (DL.hmap pi.lat e)
     =< SX.below w > SX.inc w
     =< sym ((I.lat-equiv iso).sec-eq (SX.inc w)) > DL.hmap pi.lat ((I.lat-equiv iso).sec (SX.inc w)) }) ;
 inverse (w : SX.Opens) : SY.Opens = ((I.lat-equiv iso).sec (SX.inc w),inverse-bound w) ;
 inverse-left (v : SY.Opens) : Id SY.Opens (inverse (DL.hmap S.morphism.lat v)) v =
  SY.ext (inverse (DL.hmap S.morphism.lat v)) v
   (trans (ap (I.lat-equiv iso).sec (image-inc v)) (Pr.sec-ret L.L M.L (DL.hmap pi.lat) (I.lat-equiv iso) (SY.inc v))) ;
 inverse-right (w : SX.Opens) : Id SX.Opens (DL.hmap S.morphism.lat (inverse w)) w =
  SX.ext (DL.hmap S.morphism.lat (inverse w)) w
   (trans (image-inc (inverse w)) ((I.lat-equiv iso).sec-eq (SX.inc w))) ;
 forward-le (v : SY.Opens) : OM.Le (DL.hmap pi.lat (SY.inc v)) (SX.inc (DL.hmap S.morphism.lat v)) =
  OM.le-of-eq (DL.hmap pi.lat (SY.inc v)) (SX.inc (DL.hmap S.morphism.lat v)) (sym (image-inc v)) ;
 module RingAt (v : SY.Opens) {
  module R = Iso[l].EqualOpens[M,X.sheaf,SX.inc (DL.hmap S.morphism.lat v),DL.hmap pi.lat (SY.inc v),
   OM.meet-left (DL.hmap pi.lat (SY.inc v)) (DL.hmap pi.lat e),forward-le v] ;
  equiv : Pr.isEquiv (SY.sheaf.ring v).R (SX.sheaf.ring (DL.hmap S.morphism.lat v)).R (map (S.morphism.sharp v)) =
   Iso[l].equiv-compose (Y.sheaf.ring (SY.inc v)).R (X.sheaf.ring (DL.hmap pi.lat (SY.inc v))).R
    (X.sheaf.ring (SX.inc (DL.hmap S.morphism.lat v))).R
    (map (X.sheaf.res (SX.inc (DL.hmap S.morphism.lat v)) (DL.hmap pi.lat (SY.inc v))
      (OM.meet-left (DL.hmap pi.lat (SY.inc v)) (DL.hmap pi.lat e)))) (map (pi.sharp (SY.inc v)))
    R.equiv (I.sharp-equiv iso (SY.inc v)) ;
 } ;
 restricted-iso : Iso[l].Maps[SY.lattice,SX.lattice,SY.sheaf,SX.sheaf].IsIso S.morphism =
  (Pr.qinv SY.Opens SX.Opens (DL.hmap S.morphism.lat) inverse inverse-right inverse-left,\ v -> RingAt[v].equiv) ;
} ;
