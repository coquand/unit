-- Relative categorical comparison (relative-totalisation.tex §6).
-- The geometric category is the univalent slice of geometric qcqs over
-- the affine object Spec k.  The native functorial category is the full
-- subcategory of RelativeFunctorCategory defined by intrinsic qcqs.
-- Use the existing BasePoints and RelativeFamilies induced maps for the
-- functor of points.  Unit/composition are geometric laws on underlying
-- points, followed by relative point-ext.  RelativeUniversal supplies
-- full faithfulness on precisely these native natural transformations.
-- RelativeEssentialImage supplies mere essential surjectivity, inverting
-- its representing equivalence.  The checked general categorical theorem
-- gives the object equivalence and explicit categorical quasi-inverse.
level l ; open Ring[l] ;
module Hi = Prelude[l+] ;
module Tr = Truncation[l+] ;
module T = AffineTests[l] ;
module SP = Spaces[l] ;
module QC = QcqsCategories[l] ;
module FC = Functor[l+,l+,l+,l+] ;
module Over (K : T.Test) {
 module R = RelativeFunctors[l].Over[K] ;
 module E = RelativeEquivalences[l].Over[K] ;
 module RQ = RelativeQcqs[l].Over[K] ;
 module BP = R.BP ;
 module Native = RelativeFunctorCategory[l].Over[K] ;
 base-object : QC.Geometric.precategory.ob = (T.space K,AffineQcqs[l].TestSpace[K].qcqs) ;
 module Geometric = SliceCategory[l+].Over[QC.Geometric.category,base-object] ;
 module Functorial = FullSubcategory[l+,l+].Over[Native.category,\ F -> RQ.At[F].IsQcqs,\ F -> RQ.At[F].proposition] ;
 module At (X : Geometric.precategory.ob) {
  space : SP.Space = X.1.1 ;
  qcqs : Qcqs[l].Over[space.lattice,space.structure].IsQcqs = X.1.2 ;
  structure-map : SP.Hom space (T.space K) = X.2 ;
  module G = RelativeGeometric[l].Over[K,space,structure-map] ;
 } ;
 on-objects (X : Geometric.precategory.ob) : Functorial.precategory.ob =
  (At[X].G.functor,RelativeGeometricQcqs[l].Over[K,At[X].space,At[X].structure-map,At[X].qcqs].qcqs) ;
 module Between (X Y : Geometric.precategory.ob) {
  module Maps = RelativeFamilies[l].Over[K,At[X].space,At[Y].space,At[X].structure-map,At[Y].structure-map] ;
 } ;
 on-arrows (X Y : Geometric.precategory.ob) (f : Geometric.precategory.hom X Y) :
  R.Transform[At[X].G.functor,At[Y].G.functor].Nat = Between[X,Y].Maps.induced f ;
 functor : FC.Functor[Geometric.precategory,Functorial.precategory] = new FC.Functor[Geometric.precategory,Functorial.precategory,on-objects,on-arrows,
  \ X -> R.Transform[At[X].G.functor,At[X].G.functor].ext _ _ (\ A p -> At[X].G.P.point-ext A _ _
   SP.Laws[T.space (BP.test A),At[X].space,At[X].G.P.point p].left),
  \ X Y Z g f -> R.Transform[At[X].G.functor,At[Z].G.functor].ext _ _ (\ A p -> At[Z].G.P.point-ext A _ _
   (sym SP.Associativity[T.space (BP.test A),At[X].space,At[Y].space,At[Z].space,g.1,f.1,At[X].G.P.point p].assoc))] ;
 fully-faithful : FC.FullyFaithful Geometric.precategory Functorial.precategory functor =
  \ X Y -> RelativeUniversal[l].Over[K,At[X].space,At[Y].space,At[X].structure-map,At[Y].structure-map,At[X].qcqs].equivalence ;
 module ForFunctor (F : Functorial.precategory.ob) {
  module EI = RelativeEssentialImage[l].Over[K,F.1] ;
  Preimage : U l+ = (X : Geometric.precategory.ob) * Functorial.precategory.Iso (on-objects X) F ;
  actual (r : EI.Representation) : Preimage = (((EI.space r,EI.geometric-qcqs r),EI.structure-map r),
   Native.ToIso[RelativeGeometric[l].Over[K,EI.space r,EI.structure-map r].functor,F.1,
    E.Inverse[F.1,RelativeGeometric[l].Over[K,EI.space r,EI.structure-map r].functor,EI.comparison r].inverse-equiv].categorical) ;
  merely : Tr.Trunc[Preimage].carrier = Tr.Trunc[EI.Representation].induction @(l+)
   (\ t -> Tr.Trunc[Preimage].carrier) (\ t -> Tr.Trunc[Preimage].proposition)
   (\ r -> Tr.Trunc[Preimage].inc (actual r)) (EI.reconstruct F.2) ;
 } ;
 essentially-surjective : FC.EssSurj Geometric.precategory Functorial.precategory functor = \ F -> ForFunctor[F].merely ;
 module Comparison = WeakCategoryEquivalence[l+].Over[Geometric.category,Functorial.category,functor,fully-faithful,essentially-surjective] ;
 object-equivalence : Hi.isEquiv Geometric.precategory.ob Functorial.precategory.ob on-objects = Comparison.object-equivalence ;
 module Inverse = CategoryQuasiInverse[l+].Over[Geometric.category,Functorial.category,functor,fully-faithful,essentially-surjective] ;
 equivalence : CategoryQuasiInverse[l+].Equivalence[Geometric.category,Functorial.category,functor] = Inverse.equivalence ;
} ;
