-- The whole-fibre operator commutes with base change and cancels pullback
-- along a split finite free cover. Applying these facts to the two Cech
-- projections descends compatible opens. The cover gluing theorem then
-- descends points of every functorial qcqs scheme.
level l ; open Ring[l] ; open Presentations[l] ;
module RH = RingHom[l] ;
module T = AffineTests[l] ;
module L = MonicAlgebra ;
module EQ = AffineCoverEqualiser[l] ;
module CF = AffineCoverFamily[l] ;
module SF = TestFunctors[l] ;
module Q = FunctorialQcqs[l] ;
module Over (K : T.Test) (S : Algebras[l].Over[K.ring,K.carrier-set].Algebra)
 (n : Nat) (basis : L.TraceBasis[l].Over[K.ring,K.carrier-set,S].Basis[n])
 (chosen : Fin n) (unit-coordinate : Id K.ring.R (basis.coordinate S.ring.o chosen) K.ring.o) {
 module FO = FiniteFreeFibreOpen[l].Over[K,S,n,basis,chosen,unit-coordinate] ;
 module C = FO.C ; module BP = C.BP ; module Context = CF.Context[K] ;
 module At (a : BP.Algebra) {
  module X = C.Cover.At[a] ; module O = FO.At[a] ;
  Bbase : BP.Algebra = Context.along a X.B X.inclusion ;
  beta : BP.Hom a Bbase = Context.arrow a X.B X.inclusion ;
  module H = C.Change[a,Bbase,beta] ; module Y = H.Y ;
  overlap : T.Test = Y.B ;
  scalar (b : X.B.ring.R) (e : Id overlap.ring.R (H.hom.1 b) (Y.inclusion.1 b)) :
   (r : X.A.ring.R) * Id X.B.ring.R (X.inclusion.1 r) b =
   (b chosen,trans (ap (\ v -> v chosen) e) (Y.coordinate-scalar b)) ;
  diagram : EQ.Diagram[X.A] = new EQ.Diagram[X.A,X.B,overlap,X.inclusion,H.hom,Y.inclusion,H.square,X.injective,scalar] ;
  module Opens = EQ.On[X.A,diagram] ;
  module Descent (v : O.ZB.lattice.L) (e : Id Opens.ZC.lattice.L (Opens.left v) (Opens.right v)) {
   u : O.ZA.lattice.L = (O.forall-open v).1 ;
   pull : Id O.ZB.lattice.L (Opens.pull u) v = calc O.ZB.lattice.L {
    Opens.pull u =< FO.Change[a,Bbase,beta,v].natural > (FO.At[Bbase].forall-open (Opens.left v)).1
     =< ap (\ w -> (FO.At[Bbase].forall-open w).1) e > (FO.At[Bbase].forall-open (Opens.right v)).1
     =< FO.Pullback[Bbase,v].result > v } ;
  } ;
  opens : Opens.Opens = new Opens.Opens[O.reflect-top,\ v e -> (Descent[v,e].u,Descent[v,e].pull)] ;
  module Cocone (D : T.Test) (p q : RH.Hom X.B.ring D.ring)
   (p-q : Id (RH.Hom X.A.ring D.ring) (CF.Comp X.A X.B D p X.inclusion) (CF.Comp X.A X.B D q X.inclusion)) {
   module Factor = H.Factor[D,p,q,p-q] ;
   unique (k : RH.Hom overlap.ring D.ring)
    (on-left : Id (RH.Hom X.B.ring D.ring) (CF.Comp X.B overlap D k H.hom) p)
    (on-right : Id (RH.Hom X.B.ring D.ring) (CF.Comp X.B overlap D k Y.inclusion) q) :
    Id (RH.Hom overlap.ring D.ring) k Factor.map-out = Y.Maps[D,k,Factor.map-out,
     (\ b -> ap (\ f -> f.1 b) (trans on-right (sym Factor.right))),
     (\ i -> trans (ap k.1 (sym (H.on-unit i)))
      (trans (ap (\ f -> f.1 (X.X.V.unit i)) (trans on-left (sym Factor.left))) (ap Factor.map-out.1 (H.on-unit i))))].equal ;
  } ;
 } ;
 family : CF.Family[K] = new CF.Family[K,\ a -> At[a].diagram,\ a -> At[a].opens,
  \ a d h -> C.Change[a,d,h].hom,\ a d h -> C.Change[a,d,h].square,
  \ a d D h p q eq -> (C.Change[a,d,h].Factor[D,p,q,eq].map-out,
   C.Change[a,d,h].Factor[D,p,q,eq].left,C.Change[a,d,h].Factor[D,p,q,eq].right)] ;
 module Scheme (F : SF.SetFunctor) (qcqs : Q.Over[F].IsQcqs) (a : BP.Algebra) {
  module A = At[a] ;
  module Glue = QcqsCoverDescent[l].Over[K,F,family,qcqs.1] ;
  module DD = Glue.D.At[a] ;
  module E = DD.E ;
  module On (y : F.obj A.X.B) (e : E.Compatible y) {
   module To (D : T.Test) (p q : RH.Hom A.X.B.ring D.ring)
    (pq : Id (RH.Hom A.X.A.ring D.ring) (CF.Comp A.X.A A.X.B D p A.X.inclusion) (CF.Comp A.X.A A.X.B D q A.X.inclusion)) {
    module G = A.Cocone[D,p,q,pq].Factor ;
    compare : Id (F.obj D) (F.reindex A.X.B D p y) (F.reindex A.X.B D q y) = calc (F.obj D) {
     F.reindex A.X.B D p y
      =< ap (\ f -> F.reindex A.X.B D f y) (sym G.left) > F.reindex A.X.B D (CF.Comp A.X.B A.overlap D G.map-out A.H.hom) y
      =< F.composition A.X.B A.overlap D A.H.hom G.map-out y
      > F.reindex A.overlap D G.map-out (F.reindex A.X.B A.overlap A.H.hom y)
      =< ap (F.reindex A.overlap D G.map-out) e > F.reindex A.overlap D G.map-out (F.reindex A.X.B A.overlap A.Y.inclusion y)
      =< sym (F.composition A.X.B A.overlap D A.Y.inclusion G.map-out y)
      > F.reindex A.X.B D (CF.Comp A.X.B A.overlap D G.map-out A.Y.inclusion) y
      =< ap (\ f -> F.reindex A.X.B D f y) G.right > F.reindex A.X.B D q y } ;
   } ;
   match : DD.Matching y = \ D p q pq -> To[D,p,q,pq].compare ;
   descend : Localisation[l].isContr (E.Lifts y) = Glue.On[qcqs.2,a].descend y match ;
  } ;
 } ;
} ;
