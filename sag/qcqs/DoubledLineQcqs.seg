-- The affine line with doubled origin is a qcqs scheme (DESIGN.md, Next 2).
-- Its two charts e = (top, D(X)) and e2 = (D(X), top) are affine: each
-- X2|e is isomorphic to Spec k[X] (ChartIso), so the affine criterion
-- applies.  They cover: e \/ e2 = (top \/ D(X), D(X) \/ top) = (top, top).
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module DL = DistLattice[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) {
 module DLn = DoubledLine[l].Over[k,setk] ;
 module AF = Affine[l].Over[DLn.P.ring] ;
 module CI = ChartIso[l].Over[DLn.Z.lattice,DLn.line,DLn.punctured] ;
 module O = DL.Order[DLn.Z.lattice] ;
 module Q = Qcqs[l].Over[CI.DD.lattice,CI.Dbl.doubled] ;
 -- both charts are affine
 affine1 : Q.AffineOpen CI.Ch.e =
  AffineCriterion[l].Over[CI.S1.lattice,CI.S1.restricted].Criterion[DLn.P.ring,DLn.P.set,AF.Loc,AF.set,AF.inclusion,AF.elementary,
   CI.chart1,CI.iso1].affine ;
 affine2 : Q.AffineOpen CI.Ch.e2 =
  AffineCriterion[l].Over[CI.S2.lattice,CI.S2.restricted].Criterion[DLn.P.ring,DLn.P.set,AF.Loc,AF.set,AF.inclusion,AF.elementary,
   CI.chart2,CI.iso2].affine ;
 -- e \/ e2 = top
 covers : Id CI.DD.lattice.L (CI.DD.lattice.join CI.Ch.e CI.Ch.e2) CI.DD.lattice.top =
  CI.DD.ext (CI.DD.lattice.join CI.Ch.e CI.Ch.e2) CI.DD.lattice.top
   (O.le-antisym (DLn.Z.lattice.join DLn.Z.lattice.top DLn.punctured) DLn.Z.lattice.top
     (O.le-top (DLn.Z.lattice.join DLn.Z.lattice.top DLn.punctured)) (O.join-left DLn.Z.lattice.top DLn.punctured))
   (O.le-antisym (DLn.Z.lattice.join DLn.punctured DLn.Z.lattice.top) DLn.Z.lattice.top
     (O.le-top (DLn.Z.lattice.join DLn.punctured DLn.Z.lattice.top)) (O.join-right DLn.punctured DLn.Z.lattice.top)) ;
 qcqs : Q.IsQcqs = Q.Two[CI.Ch.e,CI.Ch.e2,covers,affine1,affine2].qcqs ;
} ;
