-- From the quasi-inverse equivalence of CategoryQuasiInverse to the
-- equivalence record of CategoryEquivalence (FibreCategoryEquivalence).
-- CategoryQuasiInverse gives H, its quasi-inverse K, isomorphisms
-- unit_x : K(H x) ~= x and counit_y : H(K y) ~= y, natural in the form
--   a o unit_x = unit_y o K(H a)       (unit-natural),
--   counit_z o H(K a) = a o counit_y   (counit-natural).
-- The equivalence record wants isomorphisms x ~= K(H x) and y ~= H(K y):
-- take the inverse isomorphisms (Arrows.iso-inv).  Their naturality is
-- Arrows.square-inv (h o a = b o k with a, b isos gives
-- k o a^-1 = b^-1 o h): from unit-natural with a = unit_x, b = unit_y,
-- K(H a) o unit_x^-1 = unit_y^-1 o a; from counit-natural reversed with
-- a = counit_y, b = counit_z, H(K a) o counit_y^-1 = counit_z^-1 o a.
level l ; open Base ;
module K = Category[l,l] ;
module F = Functor[l,l,l,l] ;
module CQ = CategoryQuasiInverse[l] ;
module CE = FibreCategoryEquivalence[l] ;

module Over (X Y : K.Category) (H : F.Functor[X.pre,Y.pre]) (q : CQ.Equivalence[X,Y,H]) {
 module AX = Arrows[l,l].Arrows[X.pre] ;
 module AY = Arrows[l,l].Arrows[Y.pre] ;
 unit-source (x : X.pre.ob) : X.pre.Iso x (q.inverse.obj (H.obj x)) = AX.iso-inv (q.unit x) ;
 source-natural (x y : X.pre.ob) (a : X.pre.hom x y) :
  Id (X.pre.hom x (q.inverse.obj (H.obj y)))
   (AX.cmp (q.inverse.map (H.obj x) (H.obj y) (H.map x y a)) (AX.arr (unit-source x)))
   (AX.cmp (AX.arr (unit-source y)) a) =
  AX.square-inv (q.unit x) (q.unit y) (q.unit-natural x y a) ;
 unit-target (y : Y.pre.ob) : Y.pre.Iso y (H.obj (q.inverse.obj y)) = AY.iso-inv (q.counit y) ;
 target-natural (y z : Y.pre.ob) (a : Y.pre.hom y z) :
  Id (Y.pre.hom y (H.obj (q.inverse.obj z)))
   (AY.cmp (H.map (q.inverse.obj y) (q.inverse.obj z) (q.inverse.map y z a)) (AY.arr (unit-target y)))
   (AY.cmp (AY.arr (unit-target z)) a) =
  AY.square-inv (q.counit y) (q.counit z) (Paths[l].symH (q.counit-natural y z a)) ;
 equivalence : CE.Equivalence[X,Y] =
  new CE.Equivalence[X,Y,H,q.inverse,unit-source,source-natural,unit-target,target-natural] ;
} ;
