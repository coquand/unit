-- Kernels of linear maps (Serre note, Section 3, finite exactness).
-- The kernel is the subtype q(x)=0. Additivity and linearity preserve
-- membership. Since membership is a proposition, all module equations
-- and the universal factorisation follow from their underlying equations.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module Over (A : CRing) (Md Nd : SM.Over[A].Module)
 (q : MM.Between[A,A,RingHom[l].identity A,Md,Nd].Hom) {
 module Q = MM.Between[A,A,RingHom[l].identity A,Md,Nd] ;
 module ML = SM.Over[A].Laws[Nd] ;
 Member (x : Md.M) : U l = Id Nd.M (Q.map q x) Nd.mz ;
 member-prop (x : Md.M) : Pr.isProp (Member x) = Nd.setM _ _ ;
 Carrier : U l = (x : Md.M) * Member x ;
 value (x : Carrier) : Md.M = x.1 ;
 member (x : Carrier) : Member (value x) = x.2 ;
 ext (x y : Carrier) (e : Id Md.M (value x) (value y)) : Id Carrier x y =
  Pr.Sigma-eq Md.M Member (value x) (value y) (member x) (member y) e (member-prop (value y)) ;
 set : Pr.isSet Carrier = Pr.isSet-Sigma Md.M Member Md.setM (\ x -> Pr.prop-to-set (Member x) (member-prop x)) ;
 zero : Carrier = (Md.mz,Q.map-zero q) ;
 add (x y : Carrier) : Carrier = (Md.madd (value x) (value y),
  trans (Q.map-add q (value x) (value y))
   (trans (cong2 Nd.M Nd.madd _ _ _ _ (member x) (member y)) (Nd.maddZ Nd.mz))) ;
 negative (x : Carrier) : Carrier = (Md.mneg (value x),
  trans (Q.map-neg q (value x)) (trans (ap Nd.mneg (member x)) ML.neg-zero)) ;
 scale (a : A.R) (x : Carrier) : Carrier = (Md.sm a (value x),
  trans (Q.map-scale q a (value x)) (trans (ap (Nd.sm a) (member x)) (ML.sm-zero a))) ;
 kernel : SM.Over[A].Module = new SM.Over[A].Module[
  Carrier,set,zero,add,negative,
  \ x y z -> ext _ _ (Md.maddA (value x) (value y) (value z)),
  \ x y -> ext _ _ (Md.maddC (value x) (value y)),
  \ x -> ext _ _ (Md.maddZ (value x)),
  \ x -> ext _ _ (Md.maddN (value x)),scale,
  \ a b x -> ext _ _ (Md.smA a b (value x)),
  \ x -> ext _ _ (Md.smO (value x)),
  \ a x y -> ext _ _ (Md.smD a (value x) (value y)),
  \ a b x -> ext _ _ (Md.smE a b (value x))] ;
 zero-value : Id Md.M (value zero) Md.mz = refl Md.mz ;
 add-value (x y : Carrier) : Id Md.M (value (add x y)) (Md.madd (value x) (value y)) = refl (Md.madd (value x) (value y)) ;
 negative-value (x : Carrier) : Id Md.M (value (negative x)) (Md.mneg (value x)) = refl (Md.mneg (value x)) ;
 scale-value (a : A.R) (x : Carrier) : Id Md.M (value (scale a x)) (Md.sm a (value x)) = refl (Md.sm a (value x)) ;
 module Inc = MM.Between[A,A,RingHom[l].identity A,kernel,Md] ;
 inclusion : Inc.Hom = new Inc.Hom[value,add-value,scale-value] ;
 inclusion-at (x : Carrier) : Id Md.M (Inc.map inclusion x) (value x) = refl (value x) ;
 module Lift (Pd : SM.Over[A].Module)
  (h : MM.Between[A,A,RingHom[l].identity A,Pd,Md].Hom)
  (killed : (x : Pd.M) -> Member (MM.Between[A,A,RingHom[l].identity A,Pd,Md].map h x)) {
  module H = MM.Between[A,A,RingHom[l].identity A,Pd,Md] ;
  module K = MM.Between[A,A,RingHom[l].identity A,Pd,kernel] ;
  at (x : Pd.M) : Carrier = (H.map h x,killed x) ;
  lift : K.Hom = new K.Hom[at,
   \ x y -> ext _ _ (H.map-add h x y),\ a x -> ext _ _ (H.map-scale h a x)] ;
  lift-at (x : Pd.M) : Id Md.M (value (K.map lift x)) (H.map h x) = refl (H.map h x) ;
  unique-at (v : K.Hom) (e : (x : Pd.M) -> Id Md.M (value (K.map v x)) (H.map h x))
   (x : Pd.M) : Id Carrier (K.map v x) (K.map lift x) = ext _ _ (trans (e x) (sym (lift-at x))) ;
  opaque lift ;
 } ;
 opaque inclusion ;
} ;
