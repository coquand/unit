-- Set identity: equivalences of carriers are the identity system on sets.
-- Induct on a carrier equivalence using univalence.  At the identity
-- only a sethood proof varies; sethood is a proposition, so this total
-- space contracts to the original set and identity equivalence.
level l ; open Base ;
module Pr = Prelude[l] ;
module Hi = Prelude[l+] ;
module IT = IdentityTools[l] ;
module G = SipGeneric[l] ;
SmallSet : U l+ = (A : U l) * Pr.isSet A ;
Equivalence (A B : SmallSet) : U l = Pr.Equiv A.1 B.1 ;
identity (A : SmallSet) : Equivalence A A = Pr.idEquiv A.1 ;
Total (A : SmallSet) : U l+ = (B : SmallSet) * Equivalence A B ;
module At (A : SmallSet) {
 Mot (B : U l) (e : Pr.Equiv A.1 B) : U l+ = (sB : Pr.isSet B) -> Id (Total A) (A,identity A) ((B,sB),e) ;
 base : Mot A.1 (Pr.idEquiv A.1) = \ sB ->
  Hi.ap (Pr.isSet A.1) (Total A) (\ s -> ((A.1,s),Pr.idEquiv A.1)) A.2 sB (IT.set-prop A.1 A.2 sB) ;
 induction (B : U l) (e : Pr.Equiv A.1 B) : Mot B e = G.eqind A.1 Mot base B e ;
} ;
total-contr (A : SmallSet) : FunExtUA[l+].isContr (Total A) =
 ((A,identity A),\ w -> At[A].induction w.1.1 w.2 w.1.2) ;
opaque total-contr ;
module Fd = G.Fundamental[SmallSet,Equivalence,identity,total-contr] ;
