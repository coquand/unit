-- Clearing and killing pass back along a square of equivalences.
-- Let u : M -> N and v : M' -> N' be linear over A, and i : M -> M',
-- j : N -> N' bijective linear maps with j . u = v . i. If v clears and
-- kills at f, so does u.
-- Clear: for y in N, v clears j(y): v(x') = f^r j(y). Put x = i^-1(x');
--  then j(u x) = v(i x) = v(x') = f^r j(y) = j(f^r y), and j is injective.
-- Kill: if u(x) = 0 then v(i x) = j(u x) = j(0) = 0, so merely
--  f^r i(x) = 0; then i(f^r x) = 0 = i(0), and i is injective.
-- Unrestrict: along phi : A -> B with phi(f) = b, clearing and killing at
-- f of the restriction of scalars of u give them at b for u.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module RH = RingHom[l] ; module EL = SerreLambdaElementary[l] ;
module Square (A : CRing) (Md Nd Md2 Nd2 : SM.Over[A].Module)
 (u : MM.Between[A,A,RH.identity A,Md,Nd].Hom) (v : MM.Between[A,A,RH.identity A,Md2,Nd2].Hom)
 (i : MM.Between[A,A,RH.identity A,Md,Md2].Hom)
 (i-equiv : Pr.isEquiv Md.M Md2.M (MM.Between[A,A,RH.identity A,Md,Md2].map i))
 (j : MM.Between[A,A,RH.identity A,Nd,Nd2].Hom)
 (j-equiv : Pr.isEquiv Nd.M Nd2.M (MM.Between[A,A,RH.identity A,Nd,Nd2].map j))
 (commutes : (x : Md.M) -> Id Nd2.M (MM.Between[A,A,RH.identity A,Nd,Nd2].map j (MM.Between[A,A,RH.identity A,Md,Nd].map u x))
  (MM.Between[A,A,RH.identity A,Md2,Nd2].map v (MM.Between[A,A,RH.identity A,Md,Md2].map i x)))
 (f : A.R) {
 module HU = MM.Between[A,A,RH.identity A,Md,Nd] ; module HV = MM.Between[A,A,RH.identity A,Md2,Nd2] ;
 module HI = MM.Between[A,A,RH.identity A,Md,Md2] ; module HJ = MM.Between[A,A,RH.identity A,Nd,Nd2] ;
 module EU = EL.Over[A,Md,Nd,u,f] ; module EV = EL.Over[A,Md2,Nd2,v,f] ;
 module Clearing (y : Nd.M) (c : EV.Clearing (HJ.map j y)) {
  x : Md.M = i-equiv.sec c.2.1 ;
  equation : Id Nd.M (HU.map u x) (Nd.sm (EU.AP.power f c.1) y) =
   Iso[l].injective Nd.M Nd2.M (HJ.map j) j-equiv _ _ (calc Nd2.M {
    HJ.map j (HU.map u x)
     =< commutes x > HV.map v (HI.map i x)
     =< ap (HV.map v) (i-equiv.sec-eq c.2.1) > HV.map v c.2.1
     =< c.2.2 > Nd2.sm (EU.AP.power f c.1) (HJ.map j y)
     =< sym (HJ.map-scale j (EU.AP.power f c.1) y) > HJ.map j (Nd.sm (EU.AP.power f c.1) y) }) ;
  clearing : EU.Clearing y = (c.1,x,equation) ;
 } ;
 clear (h : EV.Clear) : EU.Clear = \ y -> Tr.Trunc[EV.Clearing (HJ.map j y)].induction @l
  (\ t -> Tr.Trunc[EU.Clearing y].carrier) (\ t -> Tr.Trunc[EU.Clearing y].proposition)
  (\ c -> Tr.Trunc[EU.Clearing y].inc Clearing[y,c].clearing) (h (HJ.map j y)) ;
 killing (x : Md.M) (k : EV.Killing (HI.map i x)) : EU.Killing x =
  (k.1,Iso[l].injective Md.M Md2.M (HI.map i) i-equiv _ _
   (trans (HI.map-scale i (EU.AP.power f k.1) x) (trans k.2 (sym (HI.map-zero i))))) ;
 kill (h : EV.Kill) : EU.Kill = \ x e -> Tr.Trunc[EV.Killing (HI.map i x)].induction @l
  (\ t -> Tr.Trunc[EU.Killing x].carrier) (\ t -> Tr.Trunc[EU.Killing x].proposition)
  (\ k -> Tr.Trunc[EU.Killing x].inc (killing x k))
  (h (HI.map i x) (trans (sym (commutes x)) (trans (ap (HJ.map j) e) (HJ.map-zero j)))) ;
} ;
-- Conversely to SerreLambdaElementaryOps.RestrictScalars: along phi : A -> B
-- with phi(f) = b, if the restriction of scalars of a B-linear u clears
-- and kills at f, then u clears and kills at b, since f^r acts as b^r.
module Unrestrict (A B : CRing) (phi : RH.Hom A B) (Md Nd : SM.Over[B].Module)
 (u : MM.Between[B,B,RH.identity B,Md,Nd].Hom) (f : A.R) (b : B.R) (image : Id B.R (RingMaps[l].map phi f) b) {
 module R = SerreLambdaElementaryOps[l].RestrictScalars[A,B,phi,Md,Nd,u,f,b,image] ;
 clearing (y : Nd.M) (c : R.EA.Clearing y) : R.EB.Clearing y =
  (c.1,c.2.1,trans c.2.2 (ap (\ a -> Nd.sm a y) (R.power c.1))) ;
 clear (h : R.EA.Clear) : R.EB.Clear = \ y -> Tr.Trunc[R.EA.Clearing y].induction @l
  (\ t -> Tr.Trunc[R.EB.Clearing y].carrier) (\ t -> Tr.Trunc[R.EB.Clearing y].proposition)
  (\ c -> Tr.Trunc[R.EB.Clearing y].inc (clearing y c)) (h y) ;
 killing (x : Md.M) (k : R.EA.Killing x) : R.EB.Killing x =
  (k.1,trans (ap (\ a -> Md.sm a x) (sym (R.power k.1))) k.2) ;
 kill (h : R.EA.Kill) : R.EB.Kill = \ x e -> Tr.Trunc[R.EA.Killing x].induction @l
  (\ t -> Tr.Trunc[R.EB.Killing x].carrier) (\ t -> Tr.Trunc[R.EB.Killing x].proposition)
  (\ k -> Tr.Trunc[R.EB.Killing x].inc (killing x k)) (h x e) ;
} ;
