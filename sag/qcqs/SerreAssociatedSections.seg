-- Compatible basic module families (Serre, Section 4).
-- This is a generic limit construction for a supplied system of modules
-- over the existing affine basic section rings, with actual semilinear
-- restrictions satisfying identity and composition. It does not assert
-- that module localisation supplies this data, or that the result is a
-- sheaf: those require the later localisation and degree-zero proofs.
-- Sections over u are compatible families on all D(g)<=u. Operations and
-- the O(u)-action are componentwise. Restriction forgets components and
-- is semilinear over the existing restriction of affine ring sections.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module RH = RingHom[l] ; module RM = RingMaps[l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module Over (A : CRing) (Loc : A.R -> CRing) (set : (g : A.R) -> Pr.isSet (Loc g).R)
 (f : (g : A.R) -> RH.Hom A (Loc g))
 (el : (g : A.R) -> Bridge[l].Over[A,g].LocH.Elementary (Loc g) (f g)) {
 module Z = ZariskiLattice[l].Over[A] ;
 module O = Z.O ;
 module S = Sections[l].Over[A,Loc,set,f,el] ;
 module SH = Sheaf[l].Over[A,Loc,set,f,el] ;
 record System {
  module-at : (g : A.R) -> SM.Over[Loc g].Module ;
  res (g h : A.R) (k : O.Le (Z.D h) (Z.D g)) :
   MM.Between[Loc g,Loc h,S.rho g h k,module-at g,module-at h].Hom ;
  res-id (g : A.R) (k : O.Le (Z.D g) (Z.D g)) (x : (module-at g).M) :
   Id (module-at g).M (MM.Between[Loc g,Loc g,S.rho g g k,module-at g,module-at g].map (res g g k) x) x ;
  res-comp (g h j : A.R) (hg : O.Le (Z.D h) (Z.D g)) (jh : O.Le (Z.D j) (Z.D h))
   (jg : O.Le (Z.D j) (Z.D g)) (x : (module-at g).M) :
   Id (module-at j).M
    (MM.Between[Loc h,Loc j,S.rho h j jh,module-at h,module-at j].map (res h j jh)
     (MM.Between[Loc g,Loc h,S.rho g h hg,module-at g,module-at h].map (res g h hg) x))
    (MM.Between[Loc g,Loc j,S.rho g j jg,module-at g,module-at j].map (res g j jg) x) ;
 } ;
 module Of (B : System) {
  rho (g h : A.R) (k : O.Le (Z.D h) (Z.D g)) (x : (B.module-at g).M) : (B.module-at h).M =
   MM.Between[Loc g,Loc h,S.rho g h k,B.module-at g,B.module-at h].map (B.res g h k) x ;
  rho-irr (g h : A.R) (k t : O.Le (Z.D h) (Z.D g)) (x : (B.module-at g).M) :
   Id (B.module-at h).M (rho g h k x) (rho g h t x) = ap (\ v -> rho g h v x) (O.le-prop (Z.D h) (Z.D g) k t) ;
  rho-add (g h : A.R) (k : O.Le (Z.D h) (Z.D g)) (x y : (B.module-at g).M) :
   Id (B.module-at h).M (rho g h k ((B.module-at g).madd x y))
    ((B.module-at h).madd (rho g h k x) (rho g h k y)) =
   MM.Between[Loc g,Loc h,S.rho g h k,B.module-at g,B.module-at h].map-add (B.res g h k) x y ;
  rho-scale (g h : A.R) (k : O.Le (Z.D h) (Z.D g)) (r : (Loc g).R) (x : (B.module-at g).M) :
   Id (B.module-at h).M (rho g h k ((B.module-at g).sm r x))
    ((B.module-at h).sm (RM.map (S.rho g h k) r) (rho g h k x)) =
   MM.Between[Loc g,Loc h,S.rho g h k,B.module-at g,B.module-at h].map-scale (B.res g h k) r x ;
  Family (u : Z.lattice.L) : U l = (g : A.R) -> O.Le (Z.D g) u -> (B.module-at g).M ;
  Compatible (u : Z.lattice.L) (s : Family u) : U l =
   (g h : A.R) (kg : O.Le (Z.D g) u) (hg : O.Le (Z.D h) (Z.D g)) ->
    Id (B.module-at h).M (rho g h hg (s g kg)) (s h (O.le-trans (Z.D h) (Z.D g) u hg kg)) ;
  Section (u : Z.lattice.L) : U l = (s : Family u) * Compatible u s ;
  at {u : Z.lattice.L} (s : Section u) (g : A.R) (k : O.Le (Z.D g) u) : (B.module-at g).M = s.1 g k ;
  compat {u : Z.lattice.L} (s : Section u) (g h : A.R)
   (kg : O.Le (Z.D g) u) (hg : O.Le (Z.D h) (Z.D g)) :
   Id (B.module-at h).M (rho g h hg (at s g kg)) (at s h (O.le-trans (Z.D h) (Z.D g) u hg kg)) = s.2 g h kg hg ;
  component-irr (u : Z.lattice.L) (s : Section u) (g : A.R) (k t : O.Le (Z.D g) u) :
   Id (B.module-at g).M (at s g k) (at s g t) = ap (\ v -> at s g v) (O.le-prop (Z.D g) u k t) ;
  compatible-prop (u : Z.lattice.L) (s : Family u) : Pr.isProp (Compatible u s) =
   FE.isProp-Pi A.R (\ g -> (h : A.R) (kg : O.Le (Z.D g) u) (hg : O.Le (Z.D h) (Z.D g)) ->
    Id (B.module-at h).M (rho g h hg (s g kg)) (s h (O.le-trans (Z.D h) (Z.D g) u hg kg))) (\ g ->
   FE.isProp-Pi A.R (\ h -> (kg : O.Le (Z.D g) u) (hg : O.Le (Z.D h) (Z.D g)) ->
    Id (B.module-at h).M (rho g h hg (s g kg)) (s h (O.le-trans (Z.D h) (Z.D g) u hg kg))) (\ h ->
   FE.isProp-Pi (O.Le (Z.D g) u) (\ kg -> (hg : O.Le (Z.D h) (Z.D g)) ->
    Id (B.module-at h).M (rho g h hg (s g kg)) (s h (O.le-trans (Z.D h) (Z.D g) u hg kg))) (\ kg ->
   FE.isProp-Pi (O.Le (Z.D h) (Z.D g)) (\ hg ->
    Id (B.module-at h).M (rho g h hg (s g kg)) (s h (O.le-trans (Z.D h) (Z.D g) u hg kg))) (\ hg -> (B.module-at h).setM _ _)))) ;
  family-ext (u : Z.lattice.L) (s t : Family u)
   (e : (g : A.R) (k : O.Le (Z.D g) u) -> Id (B.module-at g).M (s g k) (t g k)) : Id (Family u) s t =
   FE.funext A.R (\ g -> O.Le (Z.D g) u -> (B.module-at g).M) s t
    (\ g -> FE.funext (O.Le (Z.D g) u) (\ k -> (B.module-at g).M) (s g) (t g) (e g)) ;
  section-ext (u : Z.lattice.L) (s t : Section u)
   (e : (g : A.R) (k : O.Le (Z.D g) u) -> Id (B.module-at g).M (at s g k) (at t g k)) : Id (Section u) s t =
   Pr.Sigma-eq (Family u) (Compatible u) s.1 t.1 s.2 t.2 (family-ext u s.1 t.1 e) (compatible-prop u t.1) ;
  section-set (u : Z.lattice.L) : Pr.isSet (Section u) = Pr.isSet-Sigma (Family u) (Compatible u)
   (FE.isSet-Pi A.R (\ g -> O.Le (Z.D g) u -> (B.module-at g).M)
    (\ g -> FE.isSet-Pi (O.Le (Z.D g) u) (\ k -> (B.module-at g).M) (\ k -> (B.module-at g).setM)))
   (\ s -> Pr.prop-to-set (Compatible u s) (compatible-prop u s)) ;
  restrict (u v : Z.lattice.L) (uv : O.Le u v) (s : Section v) : Section u =
   (\ g k -> at s g (O.le-trans (Z.D g) u v k uv),
    \ g h kg hg -> trans (compat s g h (O.le-trans (Z.D g) u v kg uv) hg)
     (component-irr v s h (O.le-trans (Z.D h) (Z.D g) v hg (O.le-trans (Z.D g) u v kg uv))
      (O.le-trans (Z.D h) u v (O.le-trans (Z.D h) (Z.D g) u hg kg) uv))) ;
  restrict-at (u v : Z.lattice.L) (uv : O.Le u v) (s : Section v) (g : A.R) (k : O.Le (Z.D g) u) :
   Id (B.module-at g).M (at (restrict u v uv s) g k) (at s g (O.le-trans (Z.D g) u v k uv)) =
   refl (at s g (O.le-trans (Z.D g) u v k uv)) ;
  restrict-id (u : Z.lattice.L) (uu : O.Le u u) (s : Section u) : Id (Section u) (restrict u u uu s) s =
   section-ext u (restrict u u uu s) s
    (\ g k -> trans (restrict-at u u uu s g k) (component-irr u s g (O.le-trans (Z.D g) u u k uu) k)) ;
  restrict-comp (u v w : Z.lattice.L) (uv : O.Le u v) (vw : O.Le v w) (uw : O.Le u w) (s : Section w) :
   Id (Section u) (restrict u v uv (restrict v w vw s)) (restrict u w uw s) =
   section-ext u (restrict u v uv (restrict v w vw s)) (restrict u w uw s)
    (\ g k -> component-irr w s g (O.le-trans (Z.D g) v w (O.le-trans (Z.D g) u v k uv) vw)
     (O.le-trans (Z.D g) u w k uw)) ;
  module Ops (u : Z.lattice.L) {
   zero : Section u = (\ g k -> (B.module-at g).mz,\ g h kg hg ->
    MM.Between[Loc g,Loc h,S.rho g h hg,B.module-at g,B.module-at h].map-zero (B.res g h hg)) ;
   add (s t : Section u) : Section u =
    (\ g k -> (B.module-at g).madd (at s g k) (at t g k),\ g h kg hg ->
     trans (rho-add g h hg (at s g kg) (at t g kg))
      (cong2 (B.module-at h).M (B.module-at h).madd _ _ _ _ (compat s g h kg hg) (compat t g h kg hg))) ;
   negative (s : Section u) : Section u =
    (\ g k -> (B.module-at g).mneg (at s g k),\ g h kg hg ->
     trans (MM.Between[Loc g,Loc h,S.rho g h hg,B.module-at g,B.module-at h].map-neg (B.res g h hg) (at s g kg))
      (ap (B.module-at h).mneg (compat s g h kg hg))) ;
   scale (r : (S.ring u).R) (s : Section u) : Section u =
    (\ g k -> (B.module-at g).sm (S.at r g k) (at s g k),\ g h kg hg ->
     trans (rho-scale g h hg (S.at r g kg) (at s g kg))
      (trans (ap (\ a -> (B.module-at h).sm a (rho g h hg (at s g kg))) (S.compat r g h kg hg))
       (ap ((B.module-at h).sm (S.at r h (O.le-trans (Z.D h) (Z.D g) u hg kg))) (compat s g h kg hg)))) ;
   zero-at (g : A.R) (k : O.Le (Z.D g) u) :
    Id (B.module-at g).M (at zero g k) (B.module-at g).mz = refl (B.module-at g).mz ;
   add-at (s t : Section u) (g : A.R) (k : O.Le (Z.D g) u) :
    Id (B.module-at g).M (at (add s t) g k) ((B.module-at g).madd (at s g k) (at t g k)) =
    refl ((B.module-at g).madd (at s g k) (at t g k)) ;
   negative-at (s : Section u) (g : A.R) (k : O.Le (Z.D g) u) :
    Id (B.module-at g).M (at (negative s) g k) ((B.module-at g).mneg (at s g k)) = refl ((B.module-at g).mneg (at s g k)) ;
   scale-at (r : (S.ring u).R) (s : Section u) (g : A.R) (k : O.Le (Z.D g) u) :
    Id (B.module-at g).M (at (scale r s) g k) ((B.module-at g).sm (S.at r g k) (at s g k)) =
    refl ((B.module-at g).sm (S.at r g k) (at s g k)) ;
   scalar-one-at (g : A.R) (k : O.Le (Z.D g) u) :
    Id (Loc g).R (S.at (S.ring u).o g k) (Loc g).o =
    trans (sym (S.component-map u g k (S.ring u).o)) (RM.map-one (S.component u g k)) ;
   section-module : SM.Over[S.ring u].Module = new SM.Over[S.ring u].Module[
    Section u,section-set u,zero,add,negative,
    \ s t v -> section-ext u (add s (add t v)) (add (add s t) v)
     (\ g k -> (B.module-at g).maddA (at s g k) (at t g k) (at v g k)),
    \ s t -> section-ext u (add s t) (add t s) (\ g k -> (B.module-at g).maddC (at s g k) (at t g k)),
    \ s -> section-ext u (add s zero) s (\ g k -> (B.module-at g).maddZ (at s g k)),
    \ s -> section-ext u (add s (negative s)) zero (\ g k -> (B.module-at g).maddN (at s g k)),scale,
    \ r t s -> section-ext u (scale r (scale t s)) (scale ((S.ring u).mul r t) s) (\ g k ->
     trans ((B.module-at g).smA (S.at r g k) (S.at t g k) (at s g k))
      (ap (\ a -> (B.module-at g).sm a (at s g k)) (sym (S.Ops[u].mul-at r t g k)))),
    \ s -> section-ext u (scale (S.ring u).o s) s (\ g k ->
     trans (ap (\ a -> (B.module-at g).sm a (at s g k)) (scalar-one-at g k)) ((B.module-at g).smO (at s g k))),
    \ r s t -> section-ext u (scale r (add s t)) (add (scale r s) (scale r t))
     (\ g k -> (B.module-at g).smD (S.at r g k) (at s g k) (at t g k)),
    \ r t s -> section-ext u (scale ((S.ring u).add r t) s) (add (scale r s) (scale t s)) (\ g k ->
     trans (ap (\ a -> (B.module-at g).sm a (at s g k)) (S.Ops[u].add-at r t g k))
      ((B.module-at g).smE (S.at r g k) (S.at t g k) (at s g k)))] ;
   -- Keep the record transparent to expose the dependent section carrier.
  } ;
  restriction (u v : Z.lattice.L) (uv : O.Le u v) :
   MM.Between[S.ring v,S.ring u,S.restriction u v uv,Ops[v].section-module,Ops[u].section-module].Hom =
   new MM.Between[S.ring v,S.ring u,S.restriction u v uv,Ops[v].section-module,Ops[u].section-module].Hom[
    restrict u v uv,
    \ s t -> section-ext u (restrict u v uv (Ops[v].add s t)) (Ops[u].add (restrict u v uv s) (restrict u v uv t))
     (\ g k -> refl ((B.module-at g).madd (at s g (O.le-trans (Z.D g) u v k uv)) (at t g (O.le-trans (Z.D g) u v k uv)))),
    \ r s -> section-ext u (restrict u v uv (Ops[v].scale r s))
     (Ops[u].scale (RM.map (S.restriction u v uv) r) (restrict u v uv s)) (\ g k ->
      ap (\ a -> (B.module-at g).sm a (at s g (O.le-trans (Z.D g) u v k uv)))
       (sym (trans (ap (\ t -> S.at t g k) (S.restriction-map u v uv r)) (S.restrict-at u v uv r g k))))] ;
  presheaf : SerreModuleSheaf[l].On[Z.lattice,SH.structure].Presheaf =
   new SerreModuleSheaf[l].On[Z.lattice,SH.structure].Presheaf[
    \ u -> Ops[u].section-module,restriction,restrict-id,restrict-comp] ;
  restriction-map (u v : Z.lattice.L) (uv : O.Le u v) (s : Section v) :
   Id (Section u)
    (MM.Between[S.ring v,S.ring u,S.restriction u v uv,Ops[v].section-module,Ops[u].section-module].map
     (restriction u v uv) s) (restrict u v uv s) = refl (restrict u v uv s) ;
  opaque section-ext ;
  opaque family-ext ;
  opaque compatible-prop ;
  opaque section-set ;
  opaque restriction ;
 } ;
} ;
