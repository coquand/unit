-- Native module fractions agree with the existing ring localisation.
-- The regular A-module localised at f maps linearly to any elementary
-- ring localisation B of A at f. The module universal property defines
-- the comparison. Multiplying a fraction by f^p recovers its numerator.
-- For injectivity, equal common-denominator fractions have equal
-- numerator images; ring kernel detection gives a killing power and
-- hence equality of native fractions. Every ring fraction gives a
-- preimage. Injectivity makes each fibre a proposition, so mere
-- representative existence determines an inverse without choice.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module RH = RingHom[l] ; module RM = RingMaps[l] ;
module LC = SerreModuleLocalisation[l] ;
module LS = SerreModuleLocalisationStructure[l] ;
module UP = SerreModuleLocalisationUniversal[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (f : A.R)
 (B : CRing) (setB : Pr.isSet B.R) (phi : RH.Hom A B)
 (elementary : Bridge[l].Over[A,f].LocH.Elementary B phi) {
 module Br = Bridge[l].Over[A,f] ;
 module AP = AffinePowers[l].Over[A] ;
 module BP = AffinePowers[l].Over[B] ;
 module BL = RL[B] ;
 module Reg = Regularity[l].Over[A] ;
 module Native = LS.At[A,SM.Over[A].regular setA,f] ;
 module S = Native.L ;
 module Scalars = MM.RestrictScalars[A,B,phi].Of[SM.Over[B].regular setB] ;
 module H = MM.Between[A,A,RH.identity A,SM.Over[A].regular setA,Scalars.restricted] ;
 inclusion : H.Hom = new H.Hom[RM.map phi,RM.map-add phi,RM.map-mul phi] ;
 unit : BL.unit (RM.map phi f) = Br.LocH.inverts elementary f (suc zero,A.mulO f) ;
 inverse-action (x : B.R) : B.R = B.mul unit.1 x ;
 forward-inverse (x : B.R) : Id B.R (Scalars.restricted.sm f (inverse-action x)) x =
  trans (B.mulA (RM.map phi f) unit.1 x)
   (trans (ap (\ b -> B.mul b x) unit.2) (BL.one-left x)) ;
 inverse-forward (x : B.R) : Id B.R (inverse-action (Scalars.restricted.sm f x)) x =
  trans (B.mulA unit.1 (RM.map phi f) x)
   (trans (ap (\ b -> B.mul b x) (trans (B.mulC unit.1 (RM.map phi f)) unit.2)) (BL.one-left x)) ;
 invertible : Pr.isEquiv B.R B.R (Scalars.restricted.sm f) =
  Pr.qinv B.R B.R (Scalars.restricted.sm f) inverse-action forward-inverse inverse-forward ;
 module UE = UP.Extend[A,SM.Over[A].regular setA,Scalars.restricted,f,inclusion,invertible] ;
 module I = UE.InverseAction ;
 module T = UE.T ;
 module Maps = MM.Between[A,A,RH.identity A,Native.localised,Scalars.restricted] ;
 forward (q : S.Carrier) : B.R = Maps.map UE.lift q ;
 forward-add (q r : S.Carrier) : Id B.R (forward (Native.add q r)) (B.add (forward q) (forward r)) =
  Maps.map-add UE.lift q r ;
 forward-original (a : A.R) : Id B.R (forward (S.fraction a zero)) (RM.map phi a) = UE.extends a ;
 target-power (p : Nat) (x : B.R) : Id B.R (T.power p x) (B.mul (RM.map phi (AP.power f p)) x) =
  T.power-scalar p x ;
 forward-clears (a : A.R) (p : Nat) :
  Id B.R (T.power p (forward (S.fraction a p))) (RM.map phi a) =
  trans (ap (T.power p) (trans (UE.lift-map-at (S.fraction a p)) (UE.lift-at a p)))
   (I.power-back p (RM.map phi a)) ;
 same-numerators (x y : A.R) (p : Nat)
  (e : Id B.R (forward (S.fraction x p)) (forward (S.fraction y p))) : Id B.R (RM.map phi x) (RM.map phi y) =
  trans (sym (forward-clears x p)) (trans (ap (T.power p) e) (forward-clears y p)) ;
 difference-zero (x y : A.R) (e : Id B.R (RM.map phi x) (RM.map phi y)) :
  Id B.R (RM.map phi (A.add x (A.neg y))) B.z =
  trans (RM.map-add phi x (A.neg y))
   (trans (ap (B.add (RM.map phi x)) (RM.map-neg phi y))
    (trans (ap (\ z -> B.add z (B.neg (RM.map phi y))) e) (B.addN (RM.map phi y)))) ;
 killed-numerators (x y : A.R) (k : Br.LocH.Killer (A.add x (A.neg y))) :
  Id A.R (S.power (Br.index (Br.LocH.kill-in k)) x) (S.power (Br.index (Br.LocH.kill-in k)) y) =
  trans (S.power-scalar (Br.index (Br.LocH.kill-in k)) x)
   (trans (Reg.difference _ _
    (trans (sym (Br.times-difference (AP.power f (Br.index (Br.LocH.kill-in k))) x y))
     (trans (ap (\ z -> A.mul z (A.add x (A.neg y))) (Br.index-eq (Br.LocH.kill-in k))) (Br.LocH.kill-eq k))))
    (sym (S.power-scalar (Br.index (Br.LocH.kill-in k)) y))) ;
 same-fractions (x y : A.R) (p : Nat)
  (e : Id B.R (forward (S.fraction x p)) (forward (S.fraction y p))) : Id S.Carrier (S.fraction x p) (S.fraction y p) =
  Tr.Trunc[Br.LocH.Killer (A.add x (A.neg y))].induction @l
   (\ w -> Id S.Carrier (S.fraction x p) (S.fraction y p)) (\ w -> S.carrier-set _ _)
   (\ k -> S.equal x y p p (Tr.Trunc[S.Witness (x,p) (y,p)].inc
    (Br.index (Br.LocH.kill-in k),
     trans (ap (\ n -> S.power n x) (plus-comm (Br.index (Br.LocH.kill-in k)) p))
      (trans (S.power-add p (Br.index (Br.LocH.kill-in k)) x)
       (trans (ap (S.power p) (killed-numerators x y k))
        (trans (sym (S.power-add p (Br.index (Br.LocH.kill-in k)) y))
         (ap (\ n -> S.power n y) (plus-comm p (Br.index (Br.LocH.kill-in k))))))))))
   (Br.LocH.kernel elementary (A.add x (A.neg y)) (difference-zero x y (same-numerators x y p e))) ;
 injective (q r : S.Carrier) : Id B.R (forward q) (forward r) -> Id S.Carrier q r =
  S.pair-induction (\ q r -> Id B.R (forward q) (forward r) -> Id S.Carrier q r)
   (\ q r -> Axioms[l].FunExtLemmas[fe @l].isProp-Pi (Id B.R (forward q) (forward r))
    (\ e -> Id S.Carrier q r) (\ e -> S.carrier-set q r))
   same-fractions q r ;
 Fibre (b : B.R) : U l = (q : S.Carrier) * Id B.R (forward q) b ;
 fibre-prop (b : B.R) : Pr.isProp (Fibre b) = \ x y ->
  Pr.Sigma-eq S.Carrier (\ q -> Id B.R (forward q) b) x.1 y.1 x.2 y.2
   (injective x.1 y.1 (trans x.2 (sym y.2))) (setB (forward y.1) b) ;
 fraction-preimage (b : B.R) (r : Br.LocH.Fraction B phi b) : Fibre b =
  (S.fraction (Br.LocH.num r) (Br.index (Br.LocH.den-in r)),
   I.power-injective (Br.index (Br.LocH.den-in r)) _ _
    (trans (forward-clears (Br.LocH.num r) (Br.index (Br.LocH.den-in r)))
     (sym (trans (target-power (Br.index (Br.LocH.den-in r)) b)
      (trans (ap (\ a -> B.mul (RM.map phi a) b) (Br.index-eq (Br.LocH.den-in r))) (Br.LocH.eqn r)))))) ;
 preimage (b : B.R) : Fibre b = Tr.Trunc[Br.LocH.Fraction B phi b].induction @l
  (\ w -> Fibre b) (\ w -> fibre-prop b) (fraction-preimage b) (Br.LocH.fractions elementary b) ;
 backward (b : B.R) : S.Carrier = (preimage b).1 ;
 forward-backward (b : B.R) : Id B.R (forward (backward b)) b = (preimage b).2 ;
 backward-forward (q : S.Carrier) : Id S.Carrier (backward (forward q)) q =
  injective (backward (forward q)) q (forward-backward (forward q)) ;
 equivalence : Pr.isEquiv S.Carrier B.R forward =
  Pr.qinv S.Carrier B.R forward backward forward-backward backward-forward ;
 backward-original (a : A.R) : Id S.Carrier (backward (RM.map phi a)) (S.fraction a zero) =
  injective (backward (RM.map phi a)) (S.fraction a zero) (trans (forward-backward (RM.map phi a)) (sym (forward-original a))) ;
 backward-add (x y : B.R) : Id S.Carrier (backward (B.add x y)) (Native.add (backward x) (backward y)) =
  injective _ _ (trans (forward-backward (B.add x y))
   (sym (trans (forward-add (backward x) (backward y))
    (cong2 B.R B.add _ _ _ _ (forward-backward x) (forward-backward y))))) ;
 backward-one : Id S.Carrier (backward B.o) (S.fraction A.o zero) =
  trans (ap backward (sym (RM.map-one phi))) (backward-original A.o) ;
 inverse-power-formula : (p : Nat) (a : A.R) ->
  Id B.R (I.back p (RM.map phi a)) (B.mul (BP.power unit.1 p) (RM.map phi a)) = split {
  zero -> \ a -> trans (I.back-zero (RM.map phi a)) (sym (BL.one-left (RM.map phi a))) ;
  suc p | ih -> \ a -> trans (I.back-suc p (RM.map phi a))
   (trans (ap inverse-action (ih a)) (B.mulA unit.1 (BP.power unit.1 p) (RM.map phi a))) } ;
 forward-fraction (a : A.R) (p : Nat) :
  Id B.R (forward (S.fraction a p)) (B.mul (BP.power unit.1 p) (RM.map phi a)) =
  trans (UE.lift-map-at (S.fraction a p)) (trans (UE.lift-at a p) (inverse-power-formula p a)) ;
 forward-product-fractions (a b : A.R) (p q : Nat) :
  Id B.R (B.mul (forward (S.fraction a p)) (forward (S.fraction b q)))
   (forward (S.fraction (A.mul a b) (plus p q))) =
  sym (trans (forward-fraction (A.mul a b) (plus p q))
   (trans (cong2 B.R B.mul _ _ _ _ (BP.power-add unit.1 p q) (RM.map-mul phi a b))
    (trans (BL.mul-four (BP.power unit.1 p) (BP.power unit.1 q) (RM.map phi a) (RM.map phi b))
     (cong2 B.R B.mul _ _ _ _ (sym (forward-fraction a p)) (sym (forward-fraction b q)))))) ;
 backward-product-fractions (a b : A.R) (p q : Nat) :
  Id S.Carrier (backward (B.mul (forward (S.fraction a p)) (forward (S.fraction b q))))
   (S.fraction (A.mul a b) (plus p q)) =
  injective _ _ (trans (forward-backward (B.mul (forward (S.fraction a p)) (forward (S.fraction b q))))
   (forward-product-fractions a b p q)) ;
 opaque inclusion ;
 opaque invertible ;
 opaque forward ;
 opaque preimage ;
 opaque backward ;
} ;
