-- The restriction maps rho_{h,g} : R_g -> R_h for D h <= D g (DESIGN.md,
-- step 2).  For each g in A let f_g : A -> R_g be a localisation at the
-- powers of g (elementary form), R_g a set.
--
-- If D h <= D g then f_h(g) is invertible (Bridge), hence so is every
-- f_h(g^n) = f_h(g)^n: f_h inverts the powers of g, and the universal
-- property of f_g gives a unique ring map rho_{h,g} with
-- rho_{h,g} . f_g = f_h.  Then rho_{g,g} = id and
-- rho_{k,h} . rho_{h,g} = rho_{k,g}: in each case both sides are maps out
-- of R_g that agree on A (Localisation, Agree).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module Over (A : CRing) (Loc : A.R -> CRing) (set : (g : A.R) -> Pr.isSet (Loc g).R)
 (f : (g : A.R) -> RH.Hom A (Loc g))
 (el : (g : A.R) -> Bridge[l].Over[A,g].LocH.Elementary (Loc g) (f g)) {
 open A ;
 open ZariskiLattice[l].Over[A] ;

 module Pair (g h : R) (le : O.Le (D h) (D g)) {
  module BG = Bridge[l].Over[A,g] ;
  module Pw = AffinePowers[l].Over[Loc h] ;
  module PA = AffinePowers[l].Over[A] ;
  unit-g : RL[Loc h].unit (map (f h) g) = Bridge[l].Over[A,h].At[Loc h,set h,f h,el h,g].le-invertible le ;
  -- f_h(g^n) = f_h(g)^n is a unit
  unit-power (n : Nat) : RL[Loc h].unit (map (f h) (PA.power g n)) =
   Pr.subst (Loc h).R (\ t -> RL[Loc h].unit t) (Pw.power (map (f h) g) n) (map (f h) (PA.power g n))
    (sym (AffinePowers[l].power-map A (Loc h) (f h) g n)) (Pw.Units[set h].power-unit (map (f h) g) unit-g n) ;
  inverts : BG.LocH.Inverts (Loc h) (f h) = \ s p ->
   Pr.subst R (\ t -> RL[Loc h].unit (map (f h) t)) (PA.power g (BG.index p)) s (BG.index-eq p) (unit-power (BG.index p)) ;
  extensions : Localisation[l].isContr (BG.LocH.Extension (Loc g) (Loc h) (f g) (f h)) =
   BG.LocH.universal (Loc g) (f g) (el g) (Loc h) (set h) (f h) inverts ;
  rho : RH.Hom (Loc g) (Loc h) = extensions.1.1 ;
  -- rho . f_g = f_h
  rho-on (a : R) : Id (Loc h).R (map rho (map (f g) a)) (map (f h) a) =
   Pr.happly R (\ x -> (Loc h).R) (\ x -> map rho (map (f g) x)) (map (f h)) (ap (\ phi -> map phi) extensions.1.2) a ;
 } ;
 loc (g : R) : Bridge[l].Over[A,g].LocH.IsLoc (Loc g) (f g) = Bridge[l].Over[A,g].LocH.is-loc (Loc g) (f g) (el g) ;

 rho-id (g : R) (le : O.Le (D g) (D g)) : Id (RH.Hom (Loc g) (Loc g)) Pair[g,g,le].rho (RH.identity (Loc g)) =
  Bridge[l].Over[A,g].LocH.Agree[Loc g,f g,loc g,Loc g,set g,Pair[g,g,le].rho,RH.identity (Loc g),Pair[g,g,le].rho-on].equal ;
 rho-comp (g h k : R) (hg : O.Le (D h) (D g)) (kh : O.Le (D k) (D h)) (kg : O.Le (D k) (D g)) :
  Id (RH.Hom (Loc g) (Loc k)) (RH.compose (Loc g) (Loc h) (Loc k) Pair[h,k,kh].rho Pair[g,h,hg].rho) Pair[g,k,kg].rho =
  Bridge[l].Over[A,g].LocH.Agree[Loc g,f g,loc g,Loc k,set k,
    RH.compose (Loc g) (Loc h) (Loc k) Pair[h,k,kh].rho Pair[g,h,hg].rho,Pair[g,k,kg].rho,
    \ a -> trans (ap (map Pair[h,k,kh].rho) (Pair[g,h,hg].rho-on a))
      (trans (Pair[h,k,kh].rho-on a) (sym (Pair[g,k,kg].rho-on a)))].equal ;
} ;
