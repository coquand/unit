-- Separation of module localisations on an arbitrary principal cover.
-- For D(g)<=join D(h_i), a numerator vanishing in every M_(h_i) has
-- killing powers t_i=h_i^e_i. The same cover by D(t_i), and the formal
-- Nullstellensatz, express a power of g as sum t_i*c_i. This power kills
-- the numerator. A fraction over g vanishing on the cover has such a
-- numerator, by multiplying its images by its g-denominator.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (Md : SM.Over[A].Module) {
 module R = SerreModuleBasicRestrictions[l].Over[A,setA,Md] ;
 module Z = R.Z ; module O = Z.O ;
 module Rad = Radical[l].Over[A] ; module FL = FamilyLattice[l].Over[A] ;
 module SP = Z.Sup.Of[Z.D,Z.support] ;
 module AP = AffinePowers[l].Over[A] ;
 module Sums = SerreModuleSums[l].Over[A,Md] ;
 module RSums = FiniteIdeal[l].Sums[A] ;
 module ML = SM.Over[A].Laws[Md] ;
 module Cover (g : A.R) (n : Nat) (hs : Fin n -> A.R)
  (below : (i : Fin n) -> O.Le (Z.D (hs i)) (Z.D g))
  (covers : O.Le (Z.D g) (Z.J.bigJ n (\ i -> Z.D (hs i)))) {
  module G = R.Local[g].Native ;
  module Index (i : Fin n) { module H = R.Local[hs i].Native ; module P = R.At[g,hs i,below i] ; } ;
  rho-i (i : Fin n) : G.L.Carrier -> Index[i].H.L.Carrier = Index[i].P.map ;
  module Numerator (x : Md.M)
   (vanishes : (i : Fin n) -> Id Index[i].H.L.Carrier (Index[i].H.L.fraction x zero) Index[i].H.Action.mz) {
   Killers : U l = (i : Fin n) -> Index[i].H.L.Killed x ;
   killers : Tr.Trunc[Killers].carrier = AffineFinite[l].choice n
    (\ i -> Index[i].H.L.Killed x) (\ i -> Index[i].H.L.zero-killed x (vanishes i)) ;
   module Chosen (ks : Killers) {
    ts (i : Fin n) : A.R = AP.power (hs i) (ks i).1 ;
    above (i : Fin n) : O.Le (Z.D (hs i)) (Z.D (ts i)) = SP.power-above (hs i) (ks i).1 ;
    power-kill (i : Fin n) : Id Md.M (Md.sm (ts i) x) Md.mz = trans (sym (Index[i].H.L.power-scalar (ks i).1 x)) (ks i).2 ;
    radical : Rad.InRad (n,ts) g = Z.reflect (FL.single g) (n,ts)
     (O.le-trans (Z.D g) (Z.J.bigJ n (\ i -> Z.D (hs i))) (Z.cls (n,ts)) covers
      (O.le-trans (Z.J.bigJ n (\ i -> Z.D (hs i))) (Z.J.bigJ n (\ i -> Z.D (ts i))) (Z.cls (n,ts))
       (Z.J.least n (\ i -> Z.D (hs i)) (Z.J.bigJ n (\ i -> Z.D (ts i)))
        (\ i -> O.le-trans (Z.D (hs i)) (Z.D (ts i)) (Z.J.bigJ n (\ j -> Z.D (ts j))) (above i) (Z.J.below n (\ j -> Z.D (ts j)) i)))
       (O.le-of-eq (Z.J.bigJ n (\ i -> Z.D (ts i))) (Z.cls (n,ts)) (sym (Z.generated (n,ts)))))) (inr tt) ;
    module Partition (d : Rad.RadData (n,ts) g) {
     weights (i : Fin n) : A.R = A.mul (ts i) (Rad.rad-coefficients d i) ;
     term (i : Fin n) : Id Md.M (Md.sm (weights i) x) Md.mz =
      trans (sym (Md.smA (ts i) (Rad.rad-coefficients d i) x))
       (trans (ML.sm-swap (ts i) (Rad.rad-coefficients d i) x)
        (trans (ap (Md.sm (Rad.rad-coefficients d i)) (power-kill i)) (ML.sm-zero (Rad.rad-coefficients d i)))) ;
     kills : Id Md.M (G.L.power (Rad.rad-power d) x) Md.mz =
      trans (G.L.power-scalar (Rad.rad-power d) x)
       (trans (ap (\ a -> Md.sm a x) (sym (Rad.rad-equation d)))
        (trans (sym (Sums.sum-scalars n weights x))
         (trans (Sums.sum-cong n (\ i -> Md.sm (weights i) x) (\ i -> Md.mz) term) (Sums.sum-zero n)))) ;
    } ;
    killed : Tr.Trunc[G.L.Killed x].carrier = Tr.Trunc[Rad.RadData (n,ts) g].induction @l
     (\ t -> Tr.Trunc[G.L.Killed x].carrier) (\ t -> Tr.Trunc[G.L.Killed x].proposition)
     (\ d -> Tr.Trunc[G.L.Killed x].inc (Rad.rad-power d,Partition[d].kills)) radical ;
   } ;
   killed : Tr.Trunc[G.L.Killed x].carrier = Tr.Trunc[Killers].induction @l
    (\ t -> Tr.Trunc[G.L.Killed x].carrier) (\ t -> Tr.Trunc[G.L.Killed x].proposition)
    (\ ks -> Chosen[ks].killed) killers ;
  } ;
  module Fraction (x : Md.M) (p : Nat)
   (vanishes : (i : Fin n) -> Id Index[i].H.L.Carrier (rho-i i (G.L.fraction x p)) Index[i].H.Action.mz) {
   numerator-zero (i : Fin n) : Id Index[i].H.L.Carrier (Index[i].H.L.fraction x zero) Index[i].H.Action.mz =
    trans (sym (Index[i].P.clears x p))
     (trans (ap (Index[i].P.E.T.power p) (vanishes i)) (Index[i].P.E.T.power-zero p)) ;
   zero : Id G.L.Carrier (G.L.fraction x p) G.Action.mz =
    Tr.Trunc[G.L.Killed x].induction @l
     (\ t -> Id G.L.Carrier (G.L.fraction x p) G.Action.mz) (\ t -> G.L.carrier-set _ _)
     (\ w -> G.L.equal x Md.mz p zero (Tr.Trunc[G.L.Witness (x,p) (Md.mz,zero)].inc
      (w.1,trans (ap (\ r -> G.L.power r x) (plus-zero w.1))
       (trans w.2 (sym (G.L.power-zero (plus w.1 p))))))) Numerator[x,numerator-zero].killed ;
  } ;
  separated (x : G.L.Carrier) : ((i : Fin n) -> Id Index[i].H.L.Carrier (rho-i i x) Index[i].H.Action.mz) -> Id G.L.Carrier x G.Action.mz =
   G.L.induction @l
    (\ x -> ((i : Fin n) -> Id Index[i].H.L.Carrier (rho-i i x) Index[i].H.Action.mz) -> Id G.L.Carrier x G.Action.mz)
    (\ x -> FE.isProp-Pi ((i : Fin n) -> Id Index[i].H.L.Carrier (rho-i i x) Index[i].H.Action.mz)
     (\ h -> Id G.L.Carrier x G.Action.mz) (\ h -> G.L.carrier-set _ _))
    (\ a p h -> Fraction[a,p,h].zero) x ;
  injective (x y : G.L.Carrier) (e : (i : Fin n) -> Id Index[i].H.L.Carrier (rho-i i x) (rho-i i y)) : Id G.L.Carrier x y =
   SM.Over[A].Laws[G.localised].sub-zero x y
    (separated (SM.Over[A].Laws[G.localised].sub x y) (\ i ->
     trans (SerreModuleClearErrors[l].Over[A].Along[G.localised,Index[i].H.localised,Index[i].P.native].map-sub x y)
      (trans (ap (\ z -> SM.Over[A].Laws[Index[i].H.localised].sub z (rho-i i y)) (e i))
       (SM.Over[A].Laws[Index[i].H.localised].sub-self (rho-i i y))))) ;
 } ;
} ;
