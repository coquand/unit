-- The chart theorem for the lattice of a finite gluing.
-- A transition is expressed as restriction-and-transport r_ij : L_i ->
-- (L_j)|d_ji.  Write t_ij for its underlying map into L_j.  Besides
-- t_ii(u)=u assume the domain-sensitive cocycle equation
--   t_jk(t_ij(u)) = d_kj /\ t_ik(u).
-- For geometric transition isomorphisms this says both that the triple
-- overlap domains agree and that transport agrees on them.  It implies
-- t_ji(t_ij(u))=d_ij /\ u; no representatives are chosen.
--
-- The compatible-tuple lattice uses r_ij and the cut L_j -> L_j|d_ji.
-- Extend u in chart i by the tuple (t_ij(u))_j.  Its compatibility is
-- exactly the displayed cocycle equation.  The chart e_i is extension
-- of top; its j-th coordinate is d_ji, and its i-th coordinate is top.
-- Thus the charts cover.  Below e_i every compatible tuple v equals the
-- extension of v_i: its matching equation says t_ij(v_i)=v_j /\ d_ji,
-- and v_j<=d_ji simplifies that meet.  Projection therefore identifies
-- the lower interval of e_i with L_i, with extension as inverse.
-- This proves the lattice chart theorem only; the section-ring chart
-- theorem additionally needs the cocycle laws for transition ring maps.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module DL = DistLattice[l] ;
module SP = Spaces[l] ;
module Over (n : Nat) (X : Fin n -> SP.Space) (d : (i j : Fin n) -> (X i).lattice.L) {
 module Patch (i j : Fin n) { module S = Slice[l].Over[(X i).lattice,(X i).structure,d i j] ; } ;
 module Data (r : (i j : Fin n) -> DL.Hom (X i).lattice Patch[j,i].S.lattice) {
  transport (i j : Fin n) (u : (X i).lattice.L) : (X j).lattice.L = Patch[j,i].S.inc (DL.hmap (r i j) u) ;
  Identity : U l = (i : Fin n) (u : (X i).lattice.L) -> Id (X i).lattice.L (transport i i u) u ;
  Cocycle : U l = (i j k : Fin n) (u : (X i).lattice.L) ->
   Id (X k).lattice.L (transport j k (transport i j u)) ((X k).lattice.meet (d k j) (transport i k u)) ;
  module Laws (identity : Identity) (cocycle : Cocycle) {
   module FL = FiniteLatticeGlue[l].Over[n,\ i -> (X i).lattice,\ i j -> Patch[j,i].S.lattice,r,\ i j -> Patch[j,i].S.cut-map] ;
   top (i j : Fin n) : Id (X j).lattice.L (transport i j (X i).lattice.top) (d j i) =
    ap Patch[j,i].S.inc (DL.hmap-top (r i j)) ;
   diagonal-top (i : Fin n) : Id (X i).lattice.L (d i i) (X i).lattice.top =
    trans (sym (top i i)) (identity i (X i).lattice.top) ;
   monotone (i j : Fin n) (u v : (X i).lattice.L) (h : DL.Order[(X i).lattice].Le u v) :
    DL.Order[(X j).lattice].Le (transport i j u) (transport i j v) =
    Patch[j,i].S.le-inc (DL.hmap (r i j) u) (DL.hmap (r i j) v)
     (DL.JoinMaps[(X i).lattice,Patch[j,i].S.lattice,r i j].monotone u v h) ;
   extension (i : Fin n) (u : (X i).lattice.L) : FL.Opens =
    (\ j -> transport i j u,\ j k -> Patch[k,j].S.ext
     (DL.hmap (r j k) (transport i j u)) (Patch[k,j].S.cut (transport i k u))
     (trans (cocycle i j k u) ((X k).lattice.meetC (d k j) (transport i k u)))) ;
   extension-at (i j : Fin n) (u : (X i).lattice.L) : Id (X j).lattice.L
    (FL.coordinate (extension i u) j) (transport i j u) = refl (transport i j u) ;
   chart (i : Fin n) : FL.Opens = extension i (X i).lattice.top ;
   chart-at (i j : Fin n) : Id (X j).lattice.L (FL.coordinate (chart i) j) (d j i) =
    trans (extension-at i j (X i).lattice.top) (top i j) ;
   chart-self (i : Fin n) : Id (X i).lattice.L (FL.coordinate (chart i) i) (X i).lattice.top =
    trans (chart-at i i) (diagonal-top i) ;
   covers : FL.O.Le FL.whole (FL.J.bigJ n chart) = FL.le-tuple FL.whole (FL.J.bigJ n chart) (\ i ->
    DL.Order[(X i).lattice].le-trans _ _ _
     (DL.Order[(X i).lattice].le-of-eq _ _ (sym (chart-self i)))
     (DL.Order[(X i).lattice].le-trans _ _ _
      (DL.Joins[(X i).lattice].below n (\ j -> FL.coordinate (chart j) i) i)
      (DL.Order[(X i).lattice].le-of-eq _ _ (sym (FL.coordinate-joins n chart i))))) ;
   module AtChart (i : Fin n) {
    Opens : U l = (v : FL.Opens) * FL.O.Le v (chart i) ;
    ext (v w : Opens) (e : Id FL.Opens v.1 w.1) : Id Opens v w =
     Pr.Sigma-eq FL.Opens (\ z -> FL.O.Le z (chart i)) v.1 w.1 v.2 w.2 e (FL.O.le-prop w.1 (chart i)) ;
    projection (v : Opens) : (X i).lattice.L = FL.coordinate v.1 i ;
    extend (u : (X i).lattice.L) : Opens = (extension i u,FL.le-tuple (extension i u) (chart i)
     (\ j -> monotone i j u (X i).lattice.top (DL.Order[(X i).lattice].le-top u))) ;
    project-extend (u : (X i).lattice.L) : Id (X i).lattice.L (projection (extend u)) u =
     trans (extension-at i i u) (identity i u) ;
    below (v : Opens) (j : Fin n) : DL.Order[(X j).lattice].Le (FL.coordinate v.1 j) (d j i) =
     DL.Order[(X j).lattice].le-trans _ _ _ (FL.le-coordinate v.1 (chart i) v.2 j)
      (DL.Order[(X j).lattice].le-of-eq _ _ (chart-at i j)) ;
    extend-project (v : Opens) : Id Opens (extend (projection v)) v =
     ext (extend (projection v)) v (FL.ext (extension i (projection v)) v.1 (\ j ->
      trans (extension-at i j (projection v)) (trans (ap Patch[j,i].S.inc (FL.match v.1 i j)) (below v j)))) ;
    equivalence : Pr.isEquiv Opens (X i).lattice.L projection =
     Pr.qinv Opens (X i).lattice.L projection extend project-extend extend-project ;
   } ;
  } ;
 } ;
} ;
