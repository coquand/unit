-- The map of SpecMap is the only local map with global component phi
-- (DESIGN.md, step 5, item 3; zeuner1 Thm 3.12).  Same data as SpecMap,
-- and psi : Spec A -> X a local map of ringed lattices (lattice map
-- L_A -> M, ring maps O(u) -> O_X(psi u)) whose global component is phi:
-- (psi#(a|top))|top = phi a for every a, the restriction along
-- top <= psi top.
--
-- Lattice.  D_top(a|top) = D a (Global.d-global).  By locality, and since
--  D_top(t|top) = top /\ D_(psi top)(t) (InvOpen.Restrict),
--   psi(D a) = psi(D_top(a|top)) = D_(psi top)(psi#(a|top))
--            = D_top((psi#(a|top))|top) = D_top(phi a) = pi(D a),
--  so psi = pi pointwise (ZariskiUniversal.unique).
-- Sheaf.  chi_u = (restriction to pi u <= psi u) . psi#_u : O(u) -> O_X(pi u)
--  commutes with restriction (that of psi#, and res-comp).  On D g it is
--  phi_g . eval: as ring maps of x in R_g, chi(extend x) and phi_g(x) agree
--  on f_g(a) (Localisation.Agree), since extend(f_g a) = (a|top)|D g and
--   chi((a|top)|D g) = (chi(a|top))|pi(D g) = (psi#(a|top))|pi(D g)
--                    = ((psi#(a|top))|top)|pi(D g) = (phi a)|pi(D g)
--                    = phi_g(f_g a);
--  and s = extend(eval s).  Hence chi_u = pi#_u (Extension.Unique).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (Loc : A.R -> CRing) (set : (g : A.R) -> Pr.isSet (Loc g).R)
 (f : (g : A.R) -> RH.Hom A (Loc g))
 (el : (g : A.R) -> Bridge[l].Over[A,g].LocH.Elementary (Loc g) (f g))
 (M : DL.DLat) (X : LocallyRinged[l].On[M].LocallyRinged) (phi : RH.Hom A (X.sheaf.ring M.top))
 (psi : SpecMap[l].Over[A,setA,Loc,set,f,el,M,X,phi].Mp.Ringed)
 (loc : SpecMap[l].Over[A,setA,Loc,set,f,el,M,X,phi].Mp.Of[psi,SpecInv[l].Over[A,Loc,set,f,el].inv-map,X.inv].IsLocal)
 (component : (a : A.R) -> Id (X.sheaf.ring M.top).R
   (RingedLattice[l].On[M].Of[X.sheaf].restrict M.top (DL.hmap psi.lat ZariskiLattice[l].Over[A].lattice.top)
     (DL.Order[M].le-of-eq M.top (DL.hmap psi.lat ZariskiLattice[l].Over[A].lattice.top) (sym (DL.hmap-top psi.lat)))
     (map (psi.sharp ZariskiLattice[l].Over[A].lattice.top) (map Global[l].Over[A,setA,Loc,set,f,el].global a)))
   (map phi a)) {
 open A ;
 open ZariskiLattice[l].Over[A] ;
 module SM = SpecMap[l].Over[A,setA,Loc,set,f,el,M,X,phi] ;
 module S = SM.S ;
 module B = SM.B ;
 module Gb = SM.Gb ;
 module MO = SM.MO ;
 module GO = SM.GO ;
 module PM = SM.PM ;
 module LX = SM.LX ;
 module LA = SM.LA ;
 module PL = DL.JoinMaps[lattice,M,psi.lat] ;
 psi-top : MO.Le M.top (DL.hmap psi.lat lattice.top) =
  MO.le-of-eq M.top (DL.hmap psi.lat lattice.top) (sym (DL.hmap-top psi.lat)) ;

 -- D_top(a|top) = D a
 -- psi = pi
 lat-D (a : R) : Id M.L (DL.hmap psi.lat (D a)) (SM.d a) = calc M.L {
  DL.hmap psi.lat (D a) =< ap (DL.hmap psi.lat) (sym (Gb.d-global a)) > DL.hmap psi.lat (LA.d lattice.top (map Gb.global a))
   =< SM.Mp.Of[psi,SM.SI.inv-map,X.inv].local-eq loc lattice.top (map Gb.global a)
    > LX.d (DL.hmap psi.lat lattice.top) (map (psi.sharp lattice.top) (map Gb.global a))
   =< sym (MO.top-meet (LX.d (DL.hmap psi.lat lattice.top) (map (psi.sharp lattice.top) (map Gb.global a))))
    > M.meet M.top (LX.d (DL.hmap psi.lat lattice.top) (map (psi.sharp lattice.top) (map Gb.global a)))
   =< sym (SM.IG.Restrict[DL.hmap psi.lat lattice.top,M.top,psi-top,map (psi.sharp lattice.top) (map Gb.global a),
        LX.d (DL.hmap psi.lat lattice.top) (map (psi.sharp lattice.top) (map Gb.global a)),
        LX.d-open (DL.hmap psi.lat lattice.top) (map (psi.sharp lattice.top) (map Gb.global a))].restrict-eq
       (LX.d M.top (GO.restrict M.top (DL.hmap psi.lat lattice.top) psi-top (map (psi.sharp lattice.top) (map Gb.global a))))
       (LX.d-open M.top (GO.restrict M.top (DL.hmap psi.lat lattice.top) psi-top (map (psi.sharp lattice.top) (map Gb.global a)))))
    > LX.d M.top (GO.restrict M.top (DL.hmap psi.lat lattice.top) psi-top (map (psi.sharp lattice.top) (map Gb.global a)))
   =< ap (LX.d M.top) (component a) > SM.d a } ;
 lat-eq (y : lattice.L) : Id M.L (DL.hmap psi.lat y) (DL.hmap SM.pi y) =
  ZariskiUniversal[l].Over[A,M,SM.d,SM.d-support].unique psi.lat lat-D y ;

 -- chi_u = (restriction to pi u) . psi#_u
 le-pi (u : lattice.L) : MO.Le (DL.hmap SM.pi u) (DL.hmap psi.lat u) =
  MO.le-of-eq (DL.hmap SM.pi u) (DL.hmap psi.lat u) (sym (lat-eq u)) ;
 chi (u : lattice.L) : RH.Hom (S.ring u) (X.sheaf.ring (DL.hmap SM.pi u)) =
  RH.compose (S.ring u) (X.sheaf.ring (DL.hmap psi.lat u)) (X.sheaf.ring (DL.hmap SM.pi u))
   (X.sheaf.res (DL.hmap SM.pi u) (DL.hmap psi.lat u) (le-pi u)) (psi.sharp u) ;
 chi-map (u : lattice.L) (s : S.Section u) : Id (X.sheaf.ring (DL.hmap SM.pi u)).R (map (chi u) s)
  (GO.restrict (DL.hmap SM.pi u) (DL.hmap psi.lat u) (le-pi u) (map (psi.sharp u) s)) =
  map-compose (X.sheaf.res (DL.hmap SM.pi u) (DL.hmap psi.lat u) (le-pi u)) (psi.sharp u) s ;
 -- by definition, the structure sheaf restricts sections
 res-map (v u : lattice.L) (vu : O.Le v u) (s : S.Section u) :
  Id (S.Section v) (map (SM.Sh.structure.res v u vu) s) (S.restrict v u vu s) = refl (S.restrict v u vu s) ;
 chi-natural (v u : lattice.L) (vu : O.Le v u) (s : S.Section u) :
  Id (X.sheaf.ring (DL.hmap SM.pi v)).R
   (GO.restrict (DL.hmap SM.pi v) (DL.hmap SM.pi u) (PM.monotone v u vu) (map (chi u) s))
   (map (chi v) (S.restrict v u vu s)) = calc (X.sheaf.ring (DL.hmap SM.pi v)).R {
  GO.restrict (DL.hmap SM.pi v) (DL.hmap SM.pi u) (PM.monotone v u vu) (map (chi u) s)
   =< ap (GO.restrict (DL.hmap SM.pi v) (DL.hmap SM.pi u) (PM.monotone v u vu)) (chi-map u s)
    > GO.restrict (DL.hmap SM.pi v) (DL.hmap SM.pi u) (PM.monotone v u vu)
       (GO.restrict (DL.hmap SM.pi u) (DL.hmap psi.lat u) (le-pi u) (map (psi.sharp u) s))
   =< X.sheaf.res-comp (DL.hmap SM.pi v) (DL.hmap SM.pi u) (DL.hmap psi.lat u) (PM.monotone v u vu) (le-pi u)
       (MO.le-trans (DL.hmap SM.pi v) (DL.hmap SM.pi u) (DL.hmap psi.lat u) (PM.monotone v u vu) (le-pi u)) (map (psi.sharp u) s)
    > GO.restrict (DL.hmap SM.pi v) (DL.hmap psi.lat u)
       (MO.le-trans (DL.hmap SM.pi v) (DL.hmap SM.pi u) (DL.hmap psi.lat u) (PM.monotone v u vu) (le-pi u)) (map (psi.sharp u) s)
   =< sym (X.sheaf.res-comp (DL.hmap SM.pi v) (DL.hmap psi.lat v) (DL.hmap psi.lat u) (le-pi v) (PL.monotone v u vu)
       (MO.le-trans (DL.hmap SM.pi v) (DL.hmap SM.pi u) (DL.hmap psi.lat u) (PM.monotone v u vu) (le-pi u)) (map (psi.sharp u) s))
    > GO.restrict (DL.hmap SM.pi v) (DL.hmap psi.lat v) (le-pi v)
       (GO.restrict (DL.hmap psi.lat v) (DL.hmap psi.lat u) (PL.monotone v u vu) (map (psi.sharp u) s))
   =< ap (GO.restrict (DL.hmap SM.pi v) (DL.hmap psi.lat v) (le-pi v)) (psi.natural v u vu s)
    > GO.restrict (DL.hmap SM.pi v) (DL.hmap psi.lat v) (le-pi v) (map (psi.sharp v) (map (SM.Sh.structure.res v u vu) s))
   =< ap (\ e -> GO.restrict (DL.hmap SM.pi v) (DL.hmap psi.lat v) (le-pi v) (map (psi.sharp v) e)) (res-map v u vu s)
    > GO.restrict (DL.hmap SM.pi v) (DL.hmap psi.lat v) (le-pi v) (map (psi.sharp v) (S.restrict v u vu s))
   =< sym (chi-map v (S.restrict v u vu s)) > map (chi v) (S.restrict v u vu s) } ;

 -- on D g, chi is phi_g after evaluation
 module Basic (g : R) {
  module LH = Bridge[l].Over[A,g].LocH ;
  kg : O.Le (D g) lattice.top = O.le-top (D g) ;
  through : RH.Hom (Loc g) (X.sheaf.ring (DL.hmap SM.pi (D g))) =
   RH.compose (Loc g) (S.ring (D g)) (X.sheaf.ring (DL.hmap SM.pi (D g))) (chi (D g)) B.At[g].extension ;
  -- the global section psi#(a|top), and the inequalities it is restricted along
  t (a : R) : (X.sheaf.ring (DL.hmap psi.lat lattice.top)).R = map (psi.sharp lattice.top) (map Gb.global a) ;
  c1 : MO.Le (DL.hmap SM.pi (D g)) (DL.hmap psi.lat lattice.top) =
   MO.le-trans (DL.hmap SM.pi (D g)) (DL.hmap SM.pi lattice.top) (DL.hmap psi.lat lattice.top)
    (PM.monotone (D g) lattice.top kg) (le-pi lattice.top) ;
  on-A (a : R) : Id (X.sheaf.ring (DL.hmap SM.pi (D g))).R (map through (map (f g) a)) (map SM.Basic[g].phi-g (map (f g) a)) =
   calc (X.sheaf.ring (DL.hmap SM.pi (D g))).R {
    map through (map (f g) a)
     =< map-compose (chi (D g)) B.At[g].extension (map (f g) a) > map (chi (D g)) (map B.At[g].extension (map (f g) a))
     =< ap (map (chi (D g))) (trans (B.At[g].extension-map (map (f g) a)) (Gb.extend-global g a))
      > map (chi (D g)) (S.restrict (D g) lattice.top kg (map Gb.global a))
     =< sym (chi-natural (D g) lattice.top kg (map Gb.global a))
      > GO.restrict (DL.hmap SM.pi (D g)) (DL.hmap SM.pi lattice.top) (PM.monotone (D g) lattice.top kg)
         (map (chi lattice.top) (map Gb.global a))
     =< ap (GO.restrict (DL.hmap SM.pi (D g)) (DL.hmap SM.pi lattice.top) (PM.monotone (D g) lattice.top kg))
         (chi-map lattice.top (map Gb.global a))
      > GO.restrict (DL.hmap SM.pi (D g)) (DL.hmap SM.pi lattice.top) (PM.monotone (D g) lattice.top kg)
         (GO.restrict (DL.hmap SM.pi lattice.top) (DL.hmap psi.lat lattice.top) (le-pi lattice.top) (t a))
     =< X.sheaf.res-comp (DL.hmap SM.pi (D g)) (DL.hmap SM.pi lattice.top) (DL.hmap psi.lat lattice.top)
         (PM.monotone (D g) lattice.top kg) (le-pi lattice.top) c1 (t a)
      > GO.restrict (DL.hmap SM.pi (D g)) (DL.hmap psi.lat lattice.top) c1 (t a)
     =< sym (X.sheaf.res-comp (DL.hmap SM.pi (D g)) M.top (DL.hmap psi.lat lattice.top) SM.Basic[g].le-top psi-top c1 (t a))
      > GO.restrict (DL.hmap SM.pi (D g)) M.top SM.Basic[g].le-top
         (GO.restrict M.top (DL.hmap psi.lat lattice.top) psi-top (t a))
     =< ap (GO.restrict (DL.hmap SM.pi (D g)) M.top SM.Basic[g].le-top) (component a)
      > GO.restrict (DL.hmap SM.pi (D g)) M.top SM.Basic[g].le-top (map phi a)
     =< sym (map-compose (X.sheaf.res (DL.hmap SM.pi (D g)) M.top SM.Basic[g].le-top) phi a) > map SM.Basic[g].on-A a
     =< sym (SM.Basic[g].phi-g-on a) > map SM.Basic[g].phi-g (map (f g) a) } ;
  equal : Id (RH.Hom (Loc g) (X.sheaf.ring (DL.hmap SM.pi (D g)))) through SM.Basic[g].phi-g =
   LH.Agree[Loc g,f g,LH.is-loc (Loc g) (f g) (el g),X.sheaf.ring (DL.hmap SM.pi (D g)),X.sheaf.ring-set (DL.hmap SM.pi (D g)),
    through,SM.Basic[g].phi-g,on-A].equal ;
  basic (s : S.Section (D g)) : Id (X.sheaf.ring (DL.hmap SM.pi (D g))).R (map (chi (D g)) s) (map SM.Basic[g].phi-g (B.At[g].eval s)) =
   calc (X.sheaf.ring (DL.hmap SM.pi (D g))).R {
    map (chi (D g)) s =< sym (ap (map (chi (D g))) (B.At[g].extend-eval s)) > map (chi (D g)) (B.At[g].extend (B.At[g].eval s))
     =< sym (ap (map (chi (D g))) (B.At[g].extension-map (B.At[g].eval s)))
      > map (chi (D g)) (map B.At[g].extension (B.At[g].eval s))
     =< sym (map-compose (chi (D g)) B.At[g].extension (B.At[g].eval s)) > map through (B.At[g].eval s)
     =< ap (\ k -> map k (B.At[g].eval s)) equal > map SM.Basic[g].phi-g (B.At[g].eval s) } ;
 } ;

 -- psi# = pi#, through psi = pi
 sharp-eq (u : lattice.L) (s : S.Section u) :
  Id (X.sheaf.ring (DL.hmap SM.pi u)).R (GO.restrict (DL.hmap SM.pi u) (DL.hmap psi.lat u) (le-pi u) (map (psi.sharp u) s))
   (map (SM.morphism.sharp u) s) =
  trans (sym (chi-map u s))
   (trans (SM.E.Unique[chi,chi-natural,\ g s2 -> Basic[g].basic s2].agrees u s) (sym (SM.E.extension-map-at u s))) ;
} ;
