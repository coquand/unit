-- The points of the doubled-origin line (DESIGN.md, Next 4, milestone 1).
--
-- Let S be the line with doubled origin over k (DoubledLine): Spec k[X]
-- doubled along D(X).  Let B be a k-algebra, iota : k -> B, and write
-- Gamma = O(top) of Spec B, iota' = (b |-> b|top) . iota : k -> Gamma.
-- A k-point of S over B is a local map psi : Spec B -> S whose composite
-- f = fold . psi : Spec B -> Spec k[X] is over k: the global component
-- phi of f, restricted along k -> k[X], is iota' (SpecUniversal).
-- Theorem.  k-points  ~=  { (t, u0, u1) | t in B, u0 \/ u1 = top,
--                                       u0 /\ u1 = D(t) }.
-- Forward.  t = phi(X), read in B (Global: Gamma = B); u0 = psi*(e),
--  u1 = psi*(e2), the inverse images of the charts.  Then u0 \/ u1 = top
--  and u0 /\ u1 = f*(D X) (DoublingUniversal), and f*(D X) = D_top(phi X)
--  (f local: SpecUniversal (2), SpecMap.pi-D) = D_top(t|top) = D t
--  (Global.d-global).
-- Backward.  phi = the k-algebra map k[X] -> Gamma with X |-> t|top
--  (Universal), f = the local map of phi (SpecUniversal (1)), whose
--  f*(D X) is D_top(phi X) = D t by definition of SpecMap; psi = the map of
--  the triple (f, u0, u1) (IntoDoubling), local as f is.  fold . psi = f
--  (DoublingUniversal), and f is over k: its component is phi
--  (SpecUniversal), and phi restricts to iota' (Universal).
-- Laws.  The coordinate of the point of (t, u0, u1) is phi(X) = t|top, read
--  in B: t; its charts' inverse images are u0, u1 (DoublingUniversal).
--  Conversely the map phi2 of the coordinates of psi is the k-algebra map
--  with restriction iota' = restriction of phi (psi over k) and value
--  (phi X read in B)|top = phi X, so phi2 = phi (Universal); then f2 = f
--  (SpecUniversal (2)), the triple of psi is recovered, and so is psi
--  (DoublingUniversal).  Over k and the conditions are propositions.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) (B : CRing) (setB : Pr.isSet B.R) (iota : RH.Hom k B) {
 module DLn = DoubledLine[l].Over[k,setk] ;
 module AK = Affine[l].Over[DLn.P.ring] ;
 module AB = Affine[l].Over[B] ;
 module ZB = ZariskiLattice[l].Over[B] ;
 module DU = DoublingUniversal[l].Over[DLn.Z.lattice,DLn.line,DLn.punctured,ZB.lattice,AB.spec] ;
 module SU = SpecUniversal[l].Over[DLn.P.ring,DLn.P.set,AK.Loc,AK.set,AK.inclusion,AK.elementary,ZB.lattice,AB.spec] ;
 module GB = Global[l].Over[B,setB,AB.Loc,AB.set,AB.inclusion,AB.elementary] ;
 module UP = Universal[l].Property[k,AB.spec.sheaf.ring ZB.lattice.top,setk,AB.spec.sheaf.ring-set ZB.lattice.top] ;
 module HK = RH.Properties[k,AB.spec.sheaf.ring ZB.lattice.top,AB.spec.sheaf.ring-set ZB.lattice.top] ;
 module LB = LocallyRinged[l].On[ZB.lattice].Laws[AB.spec.sheaf,AB.spec.inv] ;

 -- k -> B -> Gamma
 iota-top : RH.Hom k (AB.spec.sheaf.ring ZB.lattice.top) =
  RH.compose k B (AB.spec.sheaf.ring ZB.lattice.top) GB.global iota ;
 -- f is over k
 OverK (f : DU.Mf.Ringed) : U l = Id (RH.Hom k (AB.spec.sheaf.ring ZB.lattice.top)) (UP.restrict (SU.component f)) iota-top ;
 Points : U l = (a : DU.ELP.LocalMap) * OverK (DU.Of[a.1].C.composite) ;
 Conditions (q : B.R * ZB.lattice.L * ZB.lattice.L) : U l =
  Id ZB.lattice.L (ZB.lattice.join q.2.1 q.2.2) ZB.lattice.top * Id ZB.lattice.L (ZB.lattice.meet q.2.1 q.2.2) (ZB.D q.1) ;
 Coordinates : U l = (q : B.R * ZB.lattice.L * ZB.lattice.L) * Conditions q ;
 conditions-prop (q : B.R * ZB.lattice.L * ZB.lattice.L) : Pr.isProp (Conditions q) =
  Pr.isProp-Sigma (Id ZB.lattice.L (ZB.lattice.join q.2.1 q.2.2) ZB.lattice.top)
   (\ c -> Id ZB.lattice.L (ZB.lattice.meet q.2.1 q.2.2) (ZB.D q.1))
   (ZB.lattice.setL (ZB.lattice.join q.2.1 q.2.2) ZB.lattice.top) (\ c -> ZB.lattice.setL (ZB.lattice.meet q.2.1 q.2.2) (ZB.D q.1)) ;

 -- f*(D X) = D_top(phi X) for f local with component phi
 support (f : DU.Mf.Ringed) (loc : SU.Mp.Of[f,SU.SI.inv-map,AB.spec.inv].IsLocal) :
  Id ZB.lattice.L (DL.hmap f.lat DLn.punctured) (LB.d ZB.lattice.top (map (SU.component f) DLn.P.variable)) =
  trans (SU.Local[f,loc].lattice-eq DLn.punctured) (SU.Of[SU.component f].SM.pi-D DLn.P.variable) ;

 -- forward
 module Forth (p : Points) {
  -- the coordinate t
  coordinate : B.R = GB.evaluate (map (SU.component (DU.Of[p.1.1].C.composite)) DLn.P.variable) ;
  meet-eq : Id ZB.lattice.L (ZB.lattice.meet (DL.hmap p.1.1.lat DU.Ch.e) (DL.hmap p.1.1.lat DU.Ch.e2)) (ZB.D coordinate) =
   calc ZB.lattice.L {
    ZB.lattice.meet (DL.hmap p.1.1.lat DU.Ch.e) (DL.hmap p.1.1.lat DU.Ch.e2)
     =< DU.Of[p.1.1].overlap > DL.hmap DU.Of[p.1.1].C.composite.lat DLn.punctured
     =< support DU.Of[p.1.1].C.composite (DU.Of[p.1.1].local p.1.2)
     > LB.d ZB.lattice.top (map (SU.component (DU.Of[p.1.1].C.composite)) DLn.P.variable)
     =< ap (LB.d ZB.lattice.top) (sym (GB.global-evaluate (map (SU.component (DU.Of[p.1.1].C.composite)) DLn.P.variable)))
     > LB.d ZB.lattice.top (map GB.global coordinate)
     =< GB.d-global coordinate > ZB.D coordinate } ;
  coordinates : Coordinates =
   ((coordinate,DL.hmap p.1.1.lat DU.Ch.e,DL.hmap p.1.1.lat DU.Ch.e2),DU.Of[p.1.1].covers,meet-eq) ;
 } ;
 forth (p : Points) : Coordinates = Forth[p].coordinates ;

 -- backward
 module Back (c : Coordinates) {
  -- X |-> t|top
  phi : RH.Hom DLn.P.ring (AB.spec.sheaf.ring ZB.lattice.top) = UP.backward (iota-top,map GB.global c.1.1) ;
  overlap : Id ZB.lattice.L (ZB.lattice.meet c.1.2.1 c.1.2.2) (DL.hmap SU.Of[phi].morphism.lat DLn.punctured) = calc ZB.lattice.L {
   ZB.lattice.meet c.1.2.1 c.1.2.2 =< c.2.2 > ZB.D c.1.1
    =< sym (GB.d-global c.1.1) > LB.d ZB.lattice.top (map GB.global c.1.1)
    =< ap (LB.d ZB.lattice.top) (sym (UP.variable-beta (iota-top,map GB.global c.1.1))) > LB.d ZB.lattice.top (map phi DLn.P.variable)
    =< sym (SU.Of[phi].SM.pi-D DLn.P.variable) > DL.hmap SU.Of[phi].morphism.lat DLn.punctured } ;
  triple : DU.Triple = ((SU.Of[phi].morphism,c.1.2.1,c.1.2.2),c.2.1,overlap) ;
  local-map : DU.ELP.LocalMap = DU.local-map-of (triple,SU.Of[phi].local) ;
  -- f is over k
  over-k : OverK SU.Of[phi].morphism =
   trans (HK.ext (UP.restrict (SU.component SU.Of[phi].morphism)) (UP.restrict phi) (\ a -> SU.Of[phi].component-of (DLn.P.constant a)))
    (UP.restriction-beta (iota-top,map GB.global c.1.1)) ;
  point : Points =
   (local-map,Pr.subst DU.Mf.Ringed OverK SU.Of[phi].morphism (DU.Of[local-map.1].C.composite) (sym DU.Back[triple].fold-eq) over-k) ;
 } ;
 back (c : Coordinates) : Points = Back[c].point ;

 -- the coordinates of the point of c are c
 module ForthBack (c : Coordinates) {
  coordinate-eq : Id B.R (Forth[back c].coordinate) c.1.1 = calc B.R {
   Forth[back c].coordinate
    =< ap (\ g -> GB.evaluate (map (SU.component g) DLn.P.variable)) DU.Back[Back[c].triple].fold-eq
    > GB.evaluate (map (SU.component SU.Of[Back[c].phi].morphism) DLn.P.variable)
    =< ap GB.evaluate (trans (SU.Of[Back[c].phi].component-of DLn.P.variable) (UP.variable-beta (iota-top,map GB.global c.1.1)))
    > GB.evaluate (map GB.global c.1.1)
    =< GB.evaluate-global c.1.1 > c.1.1 } ;
  parts : Id (B.R * ZB.lattice.L * ZB.lattice.L) (forth (back c)).1 c.1 = calc (B.R * ZB.lattice.L * ZB.lattice.L) {
   (forth (back c)).1
    =< ap (\ t -> (t,(forth (back c)).1.2.1,(forth (back c)).1.2.2)) coordinate-eq
    > (c.1.1,(forth (back c)).1.2.1,(forth (back c)).1.2.2)
    =< ap (\ v -> (c.1.1,v,(forth (back c)).1.2.2)) DU.Back[Back[c].triple].Fr.chart0 > (c.1.1,c.1.2.1,(forth (back c)).1.2.2)
    =< ap (\ v -> (c.1.1,c.1.2.1,v)) DU.Back[Back[c].triple].Fr.chart1 > c.1 } ;
  law : Id Coordinates (forth (back c)) c =
   Pr.Sigma-eq (B.R * ZB.lattice.L * ZB.lattice.L) Conditions (forth (back c)).1 c.1 (forth (back c)).2 c.2 parts (conditions-prop c.1) ;
 } ;

 -- the point of the coordinates of p is p
 module BackForth (p : Points) {
  -- phi2 = phi
  phi-eq : Id (RH.Hom DLn.P.ring (AB.spec.sheaf.ring ZB.lattice.top)) Back[forth p].phi (SU.component (DU.Of[p.1.1].C.composite)) =
   calc (RH.Hom DLn.P.ring (AB.spec.sheaf.ring ZB.lattice.top)) {
    Back[forth p].phi
     =< ap UP.backward (UP.data-path (iota-top,map GB.global (Forth[p].coordinate)) (UP.forward (SU.component (DU.Of[p.1.1].C.composite)))
         (sym p.2) (GB.global-evaluate (map (SU.component (DU.Of[p.1.1].C.composite)) DLn.P.variable)))
     > UP.backward (UP.forward (SU.component (DU.Of[p.1.1].C.composite)))
     =< UP.bf (SU.component (DU.Of[p.1.1].C.composite)) > SU.component (DU.Of[p.1.1].C.composite) } ;
  -- f2 = f
  f-eq : Id DU.Mf.Ringed SU.Of[Back[forth p].phi].morphism (DU.Of[p.1.1].C.composite) =
   trans (ap (\ h -> SU.Of[h].morphism) phi-eq)
    (SU.morphism-component (DU.Of[p.1.1].C.composite) (DU.Of[p.1.1].local p.1.2)) ;
  triple-eq : Id DU.Triple Back[forth p].triple (DU.triple p.1.1) =
   Pr.Sigma-eq (DU.Mf.Ringed * ZB.lattice.L * ZB.lattice.L)
    (\ q -> Id ZB.lattice.L (ZB.lattice.join q.2.1 q.2.2) ZB.lattice.top * Id ZB.lattice.L (ZB.lattice.meet q.2.1 q.2.2) (DL.hmap q.1.lat DLn.punctured))
    Back[forth p].triple.1 (DU.triple p.1.1).1 Back[forth p].triple.2 (DU.triple p.1.1).2
    (ap (\ g -> (g,DL.hmap p.1.1.lat DU.Ch.e,DL.hmap p.1.1.lat DU.Ch.e2)) f-eq) (DU.conditions-prop (DU.triple p.1.1).1) ;
  map-eq : Id DU.Mp.Ringed (DU.map-of Back[forth p].triple) p.1.1 = trans (ap DU.map-of triple-eq) (DU.law1 p.1.1) ;
  law : Id Points (back (forth p)) p =
   Pr.Sigma-eq DU.ELP.LocalMap (\ a -> OverK (DU.Of[a.1].C.composite)) (back (forth p)).1 p.1 (back (forth p)).2 p.2
    (DU.ELP.local-ext (back (forth p)).1 p.1 map-eq)
    (HK.set (UP.restrict (SU.component (DU.Of[p.1.1].C.composite))) iota-top) ;
 } ;

 -- k-points of S over B are the triples (t, u0, u1)
 equivalence : Pr.isEquiv Points Coordinates forth =
  Pr.qinv Points Coordinates forth back (\ c -> ForthBack[c].law) (\ p -> BackForth[p].law) ;
} ;
