-- The restriction X|e of a locally ringed lattice X on L to the opens below
-- e (DESIGN.md, Next 1).
--
-- The lattice.  The opens of X|e are the u <= e, with the joins and meets
--  of L, bottom bot and top e; the inclusion into L preserves them, except
--  the top.  Its laws are those of L (the second component is a
--  proposition).
-- The sheaf.  X|e keeps the section rings and restrictions of X.  A cover
--  of u in X|e is one in X, since the inclusion preserves finite joins, and
--  compatibility does not depend on the witnesses of the inequalities.
-- Locality.  The invertibility open of s in O(u) is still D_u(s): it lies
--  below u <= e, and the clauses of IsInvOpen only mention w <= u.  The zero
--  and sum laws are those of X.
-- The inclusion.  The map X|e -> X has inverse image u |-> u /\ e (a
--  lattice map L -> X|e) and ring maps O(u) -> O(u /\ e), restriction.  It is
--  local: D_(u /\ e)(s|(u /\ e)) = (u /\ e) /\ D_u(s) (InvOpen.Restrict),
--  which is below D_u(s) /\ e.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;
module Over (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged) (e : L.L) {
 module O = DL.Order[L] ;
 module J = DL.Joins[L] ;
 module GO = RingedLattice[l].On[L].Of[X.sheaf] ;
 module IX = InvOpen[l].On[L].Of[X.sheaf] ;
 module LX = LocallyRinged[l].On[L].Laws[X.sheaf,X.inv] ;

 -- the opens below e
 Opens : U l = (u : L.L) * O.Le u e ;
 inc (x : Opens) : L.L = x.1 ;
 below (x : Opens) : O.Le (inc x) e = x.2 ;
 ext (x y : Opens) (p : Id L.L (inc x) (inc y)) : Id Opens x y =
  Pr.Sigma-eq L.L (\ u -> O.Le u e) (inc x) (inc y) (below x) (below y) p (O.le-prop (inc y) e) ;
 opens-set : Pr.isSet Opens =
  Pr.isSet-Sigma L.L (\ u -> O.Le u e) L.setL (\ u -> Pr.prop-to-set (O.Le u e) (O.le-prop u e)) ;
 botS : Opens = (L.bot,O.bot-le e) ;
 topS : Opens = (e,O.le-refl e) ;
 joinS (x y : Opens) : Opens = (L.join (inc x) (inc y),O.join-lub (inc x) (inc y) e (below x) (below y)) ;
 meetS (x y : Opens) : Opens =
  (L.meet (inc x) (inc y),O.le-trans (L.meet (inc x) (inc y)) (inc x) e (O.meet-left (inc x) (inc y)) (below x)) ;
 lattice : DL.DLat = new DL.DLat[Opens,opens-set,botS,topS,joinS,meetS,
  \ x y w -> ext (joinS x (joinS y w)) (joinS (joinS x y) w) (L.joinA (inc x) (inc y) (inc w)),
  \ x y -> ext (joinS x y) (joinS y x) (L.joinC (inc x) (inc y)),
  \ x -> ext (joinS x botS) x (L.joinB (inc x)),
  \ x y w -> ext (meetS x (meetS y w)) (meetS (meetS x y) w) (L.meetA (inc x) (inc y) (inc w)),
  \ x y -> ext (meetS x y) (meetS y x) (L.meetC (inc x) (inc y)),
  \ x -> ext (meetS x topS) x (below x),
  \ x y -> ext (meetS x (joinS x y)) x (L.absorb-meet (inc x) (inc y)),
  \ x y -> ext (joinS x (meetS x y)) x (L.absorb-join (inc x) (inc y)),
  \ x y w -> ext (meetS x (joinS y w)) (joinS (meetS x y) (meetS x w)) (L.dist (inc x) (inc y) (inc w))] ;
 module OS = DL.Order[lattice] ;
 module JS = DL.Joins[lattice] ;
 le-inc (x y : Opens) (k : OS.Le x y) : O.Le (inc x) (inc y) = ap inc k ;
 le-in (x y : Opens) (k : O.Le (inc x) (inc y)) : OS.Le x y = ext (meetS x y) x k ;
 join-inc : (n : Nat) (f : Fin n -> Opens) -> Id L.L (inc (JS.bigJ n f)) (J.bigJ n (\ i -> inc (f i))) = split {
  zero -> \ f -> refl L.bot ;
  suc n | r -> \ f -> ap (L.join (inc (f (inr tt)))) (r (\ i -> f (inl i))) } ;

 -- the sheaf
 module RS = RingedLattice[l].On[lattice] ;
 sheaf : RS.Presheaf = new RS.Presheaf[\ x -> X.sheaf.ring (inc x),\ x -> X.sheaf.ring-set (inc x),
  \ x y k -> X.sheaf.res (inc x) (inc y) (le-inc x y k),
  \ x k s -> X.sheaf.res-id (inc x) (le-inc x x k) s,
  \ x y w a b c s -> X.sheaf.res-comp (inc x) (inc y) (inc w) (le-inc x y a) (le-inc y w b) (le-inc x w c) s] ;
 module SO = RS.Of[sheaf] ;
 -- restriction in X|e is that of X, by definition
 res-inc (x y : Opens) (k : OS.Le x y) (s : (X.sheaf.ring (inc y)).R) :
  Id (X.sheaf.ring (inc x)).R (SO.restrict x y k s) (GO.restrict (inc x) (inc y) (le-inc x y k) s) =
  refl (GO.restrict (inc x) (inc y) (le-inc x y k) s) ;
 module Glue (m : Opens) (n : Nat) (ms : Fin n -> Opens) (le : (i : Fin n) -> OS.Le (ms i) m) (covers : OS.Le m (JS.bigJ n ms)) {
  covers-X : O.Le (inc m) (J.bigJ n (\ i -> inc (ms i))) =
   O.le-trans (inc m) (inc (JS.bigJ n ms)) (J.bigJ n (\ i -> inc (ms i))) (le-inc m (JS.bigJ n ms) covers)
    (O.le-of-eq (inc (JS.bigJ n ms)) (J.bigJ n (\ i -> inc (ms i))) (join-inc n ms)) ;
  module C = SO.Cover[m,n,ms,le,covers] ;
  module CX = GO.Cover[inc m,n,\ i -> inc (ms i),\ i -> le-inc (ms i) m (le i),covers-X] ;
  compatible (xs : (i : Fin n) -> (X.sheaf.ring (inc (ms i))).R) (c : C.Compatible xs) : CX.Compatible xs = \ i j ->
   trans (GO.res-irr (L.meet (inc (ms i)) (inc (ms j))) (inc (ms i))
     (O.meet-left (inc (ms i)) (inc (ms j))) (le-inc (meetS (ms i) (ms j)) (ms i) (OS.meet-left (ms i) (ms j))) (xs i))
    (trans (c i j)
     (GO.res-irr (L.meet (inc (ms i)) (inc (ms j))) (inc (ms j))
       (le-inc (meetS (ms i) (ms j)) (ms j) (OS.meet-right (ms i) (ms j))) (O.meet-right (inc (ms i)) (inc (ms j))) (xs j))) ;
  glue (xs : (i : Fin n) -> (X.sheaf.ring (inc (ms i))).R) (c : C.Compatible xs) : Localisation[l].isContr (C.Amalgam xs) =
   X.is-sheaf (inc m) n (\ i -> inc (ms i)) (\ i -> le-inc (ms i) m (le i)) covers-X xs (compatible xs c) ;
 } ;
 is-sheaf : SO.IsSheaf = \ m n ms le covers xs c -> Glue[m,n,ms,le,covers].glue xs c ;

 -- the invertibility opens are those of X
 module IS = InvOpen[l].On[lattice].Of[sheaf] ;
 module Inv (u : Opens) (s : (X.sheaf.ring (inc u)).R) {
  v : Opens = (LX.d (inc u) s,O.le-trans (LX.d (inc u) s) (inc u) e (IX.below (LX.d-open (inc u) s)) (below u)) ;
  is-open : IS.IsInvOpen u s v =
   (le-in v u (IX.below (LX.d-open (inc u) s)),
    \ w k h -> IX.to-unit (LX.d-open (inc u) s) (inc w) (le-inc w u k) (le-inc w v h),
    \ w k t -> le-in w v (IX.from-unit {inc u} {s} {LX.d (inc u) s} (LX.d-open (inc u) s) (inc w) (le-inc w u k) t)) ;
 } ;
 inv : IS.InvMap = \ u s -> (Inv[u,s].v,Inv[u,s].is-open) ;
 module LS = LocallyRinged[l].On[lattice].Laws[sheaf,inv] ;
 d-inc (u : Opens) (s : (X.sheaf.ring (inc u)).R) : Id L.L (inc (LS.d u s)) (LX.d (inc u) s) = refl (LX.d (inc u) s) ;
 zero-law : LS.ZeroLaw = \ u -> ext (LS.d u (X.sheaf.ring (inc u)).z) botS (X.is-support.2.1 (inc u)) ;
 add-law : LS.AddLaw = \ u s t ->
  le-in (LS.d u ((X.sheaf.ring (inc u)).add s t)) (joinS (LS.d u s) (LS.d u t)) (X.is-support.2.2.2 (inc u) s t) ;
 restricted : LocallyRinged[l].On[lattice].LocallyRinged =
  new LocallyRinged[l].On[lattice].LocallyRinged[sheaf,is-sheaf,inv,LS.support zero-law add-law] ;

 -- the inclusion X|e -> X: inverse image u |-> u /\ e
 cut (u : L.L) : Opens = (L.meet u e,O.meet-right u e) ;
 module DE = DoubleLattice[l].Over[L,e] ;
 cut-map : DL.Hom L lattice =
  (cut,ext (cut L.bot) botS (O.bot-le e),ext (cut L.top) topS (O.top-meet e),
   \ u v -> ext (cut (L.join u v)) (joinS (cut u) (cut v)) (DE.join-d u v),
   \ u v -> ext (cut (L.meet u v)) (meetS (cut u) (cut v)) (DE.meet-d u v)) ;
 module Mp = LocallyRinged[l].Maps[L,lattice,X.sheaf,sheaf] ;
 down (u : L.L) : RH.Hom (X.sheaf.ring u) (X.sheaf.ring (L.meet u e)) = X.sheaf.res (L.meet u e) u (O.meet-left u e) ;
 natural (u v : L.L) (k : O.Le u v) (s : (X.sheaf.ring v).R) :
  Id (X.sheaf.ring (L.meet u e)).R
   (GO.restrict (L.meet u e) (L.meet v e) (le-inc (cut u) (cut v) (DL.JoinMaps[L,lattice,cut-map].monotone u v k)) (map (down v) s))
   (map (down u) (GO.restrict u v k s)) =
  trans (X.sheaf.res-comp (L.meet u e) (L.meet v e) v
     (le-inc (cut u) (cut v) (DL.JoinMaps[L,lattice,cut-map].monotone u v k)) (O.meet-left v e)
     (O.le-trans (L.meet u e) u v (O.meet-left u e) k) s)
   (sym (X.sheaf.res-comp (L.meet u e) u v (O.meet-left u e) k (O.le-trans (L.meet u e) u v (O.meet-left u e) k) s)) ;
 inclusion : Mp.Ringed = new Mp.Ringed[cut-map,down,natural] ;
 -- locality: D_(u /\ e)(s|(u /\ e)) <= D_u(s) /\ e
 local-le (u : L.L) (s : (X.sheaf.ring u).R) :
  O.Le (LX.d (L.meet u e) (GO.restrict (L.meet u e) u (O.meet-left u e) s)) (L.meet (LX.d u s) e) =
  Pr.subst L.L (\ t -> O.Le t (L.meet (LX.d u s) e)) (L.meet (L.meet u e) (LX.d u s))
   (LX.d (L.meet u e) (GO.restrict (L.meet u e) u (O.meet-left u e) s))
   (sym (IX.Restrict[u,L.meet u e,O.meet-left u e,s,LX.d u s,LX.d-open u s].restrict-eq
     (LX.d (L.meet u e) (GO.restrict (L.meet u e) u (O.meet-left u e) s))
     (LX.d-open (L.meet u e) (GO.restrict (L.meet u e) u (O.meet-left u e) s))))
   (O.meet-glb (LX.d u s) e (L.meet (L.meet u e) (LX.d u s))
     (O.meet-right (L.meet u e) (LX.d u s))
     (O.le-trans (L.meet (L.meet u e) (LX.d u s)) (L.meet u e) e (O.meet-left (L.meet u e) (LX.d u s)) (O.meet-right u e))) ;
 inclusion-local : Mp.Of[inclusion,X.inv,inv].IsLocal = \ u s ->
  le-in (LS.d (cut u) (map (down u) s)) (cut (LX.d u s)) (local-le u s) ;
} ;
