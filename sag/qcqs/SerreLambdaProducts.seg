-- lambda of a finite product of module sheaves is coordinatewise, so a
-- finite product of sheaves whose lambda_(a,g) are equivalences has one
-- (Serre note, Lemma 4.3: finite sums are finite products).
-- Proof. lambda_(a,g) is an equivalence iff restriction M(a) -> M(D_a g)
-- clears and kills at g (SerreLambdaClearing). Restriction for the
-- product sheaf is the product of the coordinate restrictions; the
-- product of restricted-scalar modules is the restricted-scalar product
-- module by the identity map. Clearing and killing pass to finite products
-- (SerreLambdaElementaryOps.Product) and along that identity
-- (AfterEquivalence). The empty product is included.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module DL = DistLattice[l] ;
module RH = RingHom[l] ; module MM = SerreModuleMaps[l] ;
module MS = SerreModuleSheaf[l] ; module Ops = SerreLambdaElementaryOps[l] ;
module On (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged) (n : Nat)
 (Ms : Fin n -> MS.On[L,X.sheaf].ModuleSheaf) (a : L.L) {
 module P = SerreModuleSheafProducts[l].On[L,X.sheaf,Fin n,Ms] ;
 module At (g : (X.sheaf.ring a).R) {
  module Coordinate (i : Fin n) {
   module Cl = SerreLambdaClearing[l].On[L,X,Ms i,a,g] ;
   module On = SerreLambda[l].On[L,X,Ms i,a] ;
  } ;
  module Whole = SerreLambdaClearing[l].On[L,X,P.product,a,g] ;
  module WholeOn = SerreLambda[l].On[L,X,P.product,a] ;
  open-g : L.L = Whole.Lam.open-g ;
  R : CRing = X.sheaf.ring a ;
  module Prod = Ops.Product[R,Fin n,\ i -> (Ms i).presheaf.module-at a,\ i -> Coordinate[i].Cl.C.Scalars.restricted,
   \ i -> Coordinate[i].Cl.C.original,g,Ops.FinIndex[n].choose,Ops.FinIndex[n].bound,Ops.FinIndex[n].above] ;
  -- the product of restricted modules is the restricted product, by the identity
  module IdentityMap = MM.Between[R,R,RH.identity R,Prod.PM.T.product,Whole.C.Scalars.restricted] ;
  identity : IdentityMap.Hom = new IdentityMap.Hom[\ x -> x,
   \ x y -> refl (Prod.PM.T.product.madd x y),\ r x -> refl (Prod.PM.T.product.sm r x)] ;
  identity-at (x : Prod.PM.T.Carrier) : Id Prod.PM.T.Carrier (IdentityMap.map identity x) x = refl x ;
  identity-component (x : Prod.PM.T.Carrier) (i : Fin n) :
   Id ((Ms i).presheaf.module-at open-g).M (IdentityMap.map identity x i) (x i) = ap (\ z -> z i) (identity-at x) ;
  identity-equiv : Pr.isEquiv Prod.PM.T.Carrier Prod.PM.T.Carrier (IdentityMap.map identity) =
   Pr.qinv Prod.PM.T.Carrier Prod.PM.T.Carrier (IdentityMap.map identity) (\ x -> x) (\ x -> refl x) (\ x -> refl x) ;
  -- restriction of the product is the product of the restrictions
  -- both are the coordinate restrictions, by definition
  whole-at (x : Prod.PM.S.Carrier) (i : Fin n) :
   Id ((Ms i).presheaf.module-at open-g).M (Whole.E.H.map Whole.C.original x i)
    (Coordinate[i].Cl.E.H.map Coordinate[i].Cl.C.original (x i)) =
   calc ((Ms i).presheaf.module-at open-g).M {
    Whole.E.H.map Whole.C.original x i
     =< ap (\ z -> z i) (Whole.C.original-at x)
      > WholeOn.R.RO.restrict Whole.C.open-f WholeOn.S.lattice.top Whole.C.below x i
     =< P.restrict-at open-g a Whole.Lam.below x i
      > Coordinate[i].On.MO.restrict open-g a Whole.Lam.below (x i)
     =< sym (Coordinate[i].Cl.C.original-at (x i))
      > Coordinate[i].Cl.E.H.map Coordinate[i].Cl.C.original (x i) } ;
  agree-at (x : Prod.PM.S.Carrier) (i : Fin n) :
   Id ((Ms i).presheaf.module-at open-g).M (Whole.E.H.map Whole.C.original x i)
    (IdentityMap.map identity (Prod.EP.H.map Prod.PM.induced x) i) =
   trans (whole-at x i) (trans (sym (Prod.PM.induced-at x i)) (sym (identity-component (Prod.EP.H.map Prod.PM.induced x) i))) ;
  agree (x : Prod.PM.S.Carrier) :
   Id Prod.PM.T.Carrier (Whole.E.H.map Whole.C.original x) (IdentityMap.map identity (Prod.EP.H.map Prod.PM.induced x)) =
   Prod.PM.T.ext _ _ (agree-at x) ;
  module After = Ops.AfterEquivalence[R,Prod.PM.S.product,Prod.PM.T.product,Whole.C.Scalars.restricted,
   Prod.PM.induced,identity,identity-equiv,Whole.C.original,agree,g] ;
  equivalence (each : (i : Fin n) -> SerreLambda[l].On[L,X,Ms i,a].At[g].IsEquivalence) :
   SerreLambda[l].On[L,X,P.product,a].At[g].IsEquivalence =
   Whole.equivalence
    (After.clear (Prod.clear (\ i -> Coordinate[i].Cl.Elementary[each i].clear)))
    (After.kill (Prod.kill (\ i -> Coordinate[i].Cl.Elementary[each i].kill))) ;
 } ;
} ;
