-- The canonical map over a principal affine open (serre-affineness.tex,
-- Section 9, the comparison before Lemma lem:localiso).  X is a locally
-- ringed lattice on M, A = O_X(top), gamma : X -> Spec A the canonical map
-- (AffineCriterion.canonical; as a map of ringed lattices L_A -> M, with
-- gamma(D_A f) = D(f) = D_top(f), SpecMap.pi-D).
--
-- Lemma (recognise).  Let Y be affine, B a ring and c : Spec B <- Y a local
--  map (L_B -> L_Y) whose global component psi : B -> O_Y(top) is bijective.
--  Then c is an isomorphism.  Proof: Spec psi is an isomorphism (SpecHom,
--  psi has an inverse ring map, Iso.Inverse), so is canonical_Y . Spec psi
--  (Compose, Y affine).  That composite is local with global component
--  (global component of canonical_Y) . psi = psi (SpecHom.Then); c is local
--  with the same component, so c is that composite (SpecUniversal.unique).
--
-- Theorem (over D(f)).  Let f in A with D(f) affine, and suppose a ring map
--  lambda : A_f -> O(D(f)) with lambda(a/1) = a|D(f) is bijective.  Then the
--  restriction m : X|gamma(D_A f) -> (Spec A)|D_A(f) of gamma (SliceMap) is
--  an isomorphism.
--  Let k : (Spec A)|D_A(f) -> Spec(A_f) and j be the inverse isomorphisms of
--  SpecBasicOpen, and c = m . k (as maps of ringed lattices: k first).
--  (1) Y = X|gamma(D_A f) is affine: gamma(D_A f) = D(f).
--  (2) c is local (Compose: k and m are, SliceMap.local).
--  (3) The global component psi of c sends a/1 to a|gamma(D_A f):
--   psi(a/1) = Gamma(m)(Gamma(k)(a/1))                (SpecHom.Precompose)
--            = Gamma(m)((a|top)|D_A f)                 (SpecBasicOpen: Gamma(k)
--               is extend, and the global component of cut_A is a |-> (a|top)|D_A f)
--            = (global component of m . cut_A)(a)      (Precompose)
--            = (global component of cut_X . gamma)(a)  (SliceMap.triangle)
--            = Gamma(cut_X)(a)                         (Precompose; gamma has
--               global component the identity)
--            = a|gamma(D_A f)                          (res-comp).
--  (4) psi = r . lambda, r the restriction from D(f) to the equal open
--   gamma(D_A f): both are ring maps out of A_f with the same values on a/1
--   (Localisation.Agree; res-comp).  r is bijective (Iso.EqualOpens), so psi is.
--  (5) c is an isomorphism (recognise), and so is c . j (Compose; j is).
--  (6) c . j = (m . k) . j = m . (k . j) = m . 1 = m (Compose.Assoc,
--   SpecBasicOpen.kj, MapLaws).  So m is an isomorphism.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;

-- a local map from an affine scheme with bijective global component
module Recognise (N : DL.DLat) (Y : LocallyRinged[l].On[N].LocallyRinged)
 (affine : AffineCriterion[l].Over[N,Y].IsAffine)
 (B : CRing) (setB : Pr.isSet B.R) (LocB : B.R -> CRing) (setLB : (g : B.R) -> Pr.isSet (LocB g).R)
 (fB : (g : B.R) -> RH.Hom B (LocB g))
 (elB : (g : B.R) -> Bridge[l].Over[B,g].LocH.Elementary (LocB g) (fB g))
 (c : SpecUniversal[l].Over[B,setB,LocB,setLB,fB,elB,N,Y].Mp.Ringed)
 (loc : SpecUniversal[l].Over[B,setB,LocB,setLB,fB,elB,N,Y].Mp.Of[c,SpecInv[l].Over[B,LocB,setLB,fB,elB].inv-map,Y.inv].IsLocal)
 (equiv : Pr.isEquiv B.R (Y.sheaf.ring N.top).R (map (SpecUniversal[l].Over[B,setB,LocB,setLB,fB,elB,N,Y].component c))) {
 module UB = SpecUniversal[l].Over[B,setB,LocB,setLB,fB,elB,N,Y] ;
 module AY = AffineCriterion[l].Over[N,Y] ;
 module I = Iso[l].Maps[ZariskiLattice[l].Over[B].lattice,N,UB.Sh.structure,Y.sheaf] ;
 module Inv = Iso[l].Inverse[B,Y.sheaf.ring N.top,UB.component c,equiv] ;
 -- Spec of the global component is an isomorphism
 module SH = SpecHom[l].Isomorphism[B,setB,LocB,setLB,fB,elB,
  Y.sheaf.ring N.top,Y.sheaf.ring-set N.top,AY.GX.Loc,AY.GX.set,AY.GX.inclusion,AY.GX.elementary,
  UB.component c,Inv.inverse,Inv.left,Inv.right] ;
 -- the candidate canonical_Y . Spec psi
 module T = SH.R1.Fw.Then[N,Y,AY.canonical] ;
 candidate-iso : I.IsIso T.C.composite = T.C.iso SH.iso affine ;
 candidate-local : UB.Mp.Of[T.C.composite,UB.SI.inv-map,Y.inv].IsLocal =
  T.C.Local[UB.SI.inv-map,SH.R1.Fw.SA.spec.inv,Y.inv,SH.R1.Fw.local,AY.Can.Of[RH.identity (Y.sheaf.ring N.top)].local].local ;
 component (b : B.R) : Id (Y.sheaf.ring N.top).R (map (UB.component T.C.composite) b) (map (UB.component c) b) =
  calc (Y.sheaf.ring N.top).R {
   map (UB.component T.C.composite) b =< T.component b > map (T.UA.component AY.canonical) (map (UB.component c) b)
    =< AY.Can.Of[RH.identity (Y.sheaf.ring N.top)].component-of (map (UB.component c) b)
     > map (RH.identity (Y.sheaf.ring N.top)) (map (UB.component c) b)
    =< refl (map (UB.component c) b) > map (UB.component c) b } ;
 same : Id UB.Mp.Ringed c T.C.composite =
  UB.unique c T.C.composite loc candidate-local (\ b -> sym (component b)) ;
 iso : I.IsIso c = Pr.subst UB.Mp.Ringed (\ q -> I.IsIso q) T.C.composite c (sym same) candidate-iso ;
} ;

-- the restriction of the canonical map over D_A(f)
module Over (M : DL.DLat) (X : LocallyRinged[l].On[M].LocallyRinged) (f : (X.sheaf.ring M.top).R)
 (affine : Qcqs[l].Over[M,X].AffineOpen (LocallyRinged[l].On[M].Laws[X.sheaf,X.inv].d M.top f))
 (lam : RH.Hom (Affine[l].Over[X.sheaf.ring M.top].Loc f) (X.sheaf.ring (LocallyRinged[l].On[M].Laws[X.sheaf,X.inv].d M.top f)))
 (lam-on : (a : (X.sheaf.ring M.top).R) -> Id (X.sheaf.ring (LocallyRinged[l].On[M].Laws[X.sheaf,X.inv].d M.top f)).R
   (map lam (map (Affine[l].Over[X.sheaf.ring M.top].inclusion f) a))
   (RingedLattice[l].On[M].Of[X.sheaf].restrict (LocallyRinged[l].On[M].Laws[X.sheaf,X.inv].d M.top f) M.top
     (DL.Order[M].le-top (LocallyRinged[l].On[M].Laws[X.sheaf,X.inv].d M.top f)) a))
 (lam-equiv : Pr.isEquiv (Affine[l].Over[X.sheaf.ring M.top].Loc f).R
   (X.sheaf.ring (LocallyRinged[l].On[M].Laws[X.sheaf,X.inv].d M.top f)).R (map lam)) {
 module MO = DL.Order[M] ;
 module GO = RingedLattice[l].On[M].Of[X.sheaf] ;
 module LX = LocallyRinged[l].On[M].Laws[X.sheaf,X.inv] ;
 module AC = AffineCriterion[l].Over[M,X] ;
 module SM = SliceMap[l].Over[AC.ZG.lattice,M,AC.GX.spec,X,AC.canonical,AC.ZG.D f] ;
 module SB = SpecBasicOpen[l].Over[X.sheaf.ring M.top,X.sheaf.ring-set M.top,f] ;
 module CanId = AC.Can.Of[RH.identity (X.sheaf.ring M.top)] ;

 -- (1) gamma(D_A f) = D(f), so the slice there is affine
 image-eq : Id M.L (DL.hmap AC.canonical.lat (AC.ZG.D f)) (LX.d M.top f) = CanId.SM.pi-D f ;
 slice-affine : AffineCriterion[l].Over[SM.SX.lattice,SM.SX.restricted].IsAffine =
  Pr.subst M.L (\ u -> Qcqs[l].Over[M,X].AffineOpen u) (LX.d M.top f) (DL.hmap AC.canonical.lat (AC.ZG.D f))
   (sym image-eq) affine ;

 -- (2) c = m . k is local
 module PC = SpecHom[l].Precompose[AC.GX.Loc f,AC.GX.set f,SB.SG.Loc,SB.SG.set,SB.SG.inclusion,SB.SG.elementary,
  SB.Sl.lattice,SB.Sl.restricted,SM.SX.lattice,SM.SX.restricted,SM.morphism,SB.KM.morphism] ;
 m-local : LocallyRinged[l].Maps[SM.SY.lattice,SM.SX.lattice,SM.SY.sheaf,SM.SX.sheaf].Of[SM.morphism,SM.SY.inv,SM.SX.inv].IsLocal =
  SM.local CanId.local ;
 c-local : PC.UA2.Mp.Of[PC.C.composite,SB.K.SI.inv-map,SM.SX.inv].IsLocal =
  PC.C.Local[SB.K.SI.inv-map,SB.Sl.inv,SM.SX.inv,SB.KM.local,m-local].local ;

 -- (3) the global component of c on a/1
 module PQ = SpecHom[l].Precompose[X.sheaf.ring M.top,X.sheaf.ring-set M.top,AC.GX.Loc,AC.GX.set,AC.GX.inclusion,AC.GX.elementary,
  SB.Sl.lattice,SB.Sl.restricted,SM.SX.lattice,SM.SX.restricted,SM.morphism,SB.Sl.inclusion] ;
 module PX = SpecHom[l].Precompose[X.sheaf.ring M.top,X.sheaf.ring-set M.top,AC.GX.Loc,AC.GX.set,AC.GX.inclusion,AC.GX.elementary,
  M,X,SM.SX.lattice,SM.SX.restricted,SM.SX.inclusion,AC.canonical] ;
 -- Gamma(cut_X) is restriction, by definition
 cut-gamma (a : (X.sheaf.ring M.top).R) : Id (X.sheaf.ring (DL.hmap AC.canonical.lat (AC.ZG.D f))).R (map PX.gamma a)
  (GO.restrict (DL.hmap AC.canonical.lat (AC.ZG.D f)) (M.meet M.top (DL.hmap AC.canonical.lat (AC.ZG.D f)))
    (SM.SX.le-inc SM.SX.topS (SM.SX.cut M.top) PX.top-le)
    (GO.restrict (M.meet M.top (DL.hmap AC.canonical.lat (AC.ZG.D f))) M.top
      (MO.meet-left M.top (DL.hmap AC.canonical.lat (AC.ZG.D f))) a)) =
  refl (GO.restrict (DL.hmap AC.canonical.lat (AC.ZG.D f)) (M.meet M.top (DL.hmap AC.canonical.lat (AC.ZG.D f)))
    (SM.SX.le-inc SM.SX.topS (SM.SX.cut M.top) PX.top-le)
    (GO.restrict (M.meet M.top (DL.hmap AC.canonical.lat (AC.ZG.D f))) M.top
      (MO.meet-left M.top (DL.hmap AC.canonical.lat (AC.ZG.D f))) a)) ;
 -- psi(a/1) = Gamma(m)(global component of cut_A at a)
 through-k (a : (X.sheaf.ring M.top).R) :
  Id (X.sheaf.ring (DL.hmap AC.canonical.lat (AC.ZG.D f))).R
   (map (PC.UA2.component PC.C.composite) (map (AC.GX.inclusion f) a)) (map PC.gamma (map (SB.UA.component SB.Sl.inclusion) a)) =
  calc (X.sheaf.ring (DL.hmap AC.canonical.lat (AC.ZG.D f))).R {
   map (PC.UA2.component PC.C.composite) (map (AC.GX.inclusion f) a)
    =< PC.component (map (AC.GX.inclusion f) a)
     > map PC.gamma (map (SB.K.component SB.KM.morphism) (map (AC.GX.inclusion f) a))
    =< ap (map PC.gamma) (SB.KM.component-of (map (AC.GX.inclusion f) a))
     > map PC.gamma (map SB.phi (map (AC.GX.inclusion f) a))
    =< ap (map PC.gamma) (sym (SB.cut-component a)) > map PC.gamma (map (SB.UA.component SB.Sl.inclusion) a) } ;
 -- Gamma(m)(global component of cut_A at a) = (global component of cut_X . gamma)(a)
 through-triangle (a : (X.sheaf.ring M.top).R) :
  Id (X.sheaf.ring (DL.hmap AC.canonical.lat (AC.ZG.D f))).R
   (map PC.gamma (map (SB.UA.component SB.Sl.inclusion) a)) (map (PQ.UA2.component PX.C.composite) a) =
  calc (X.sheaf.ring (DL.hmap AC.canonical.lat (AC.ZG.D f))).R {
   map PC.gamma (map (SB.UA.component SB.Sl.inclusion) a)
    =< sym (PQ.component a) > map (PQ.UA2.component PQ.C.composite) a
    =< ap (\ q -> map (PQ.UA2.component q) a) SM.triangle > map (PQ.UA2.component PX.C.composite) a } ;
 -- (global component of cut_X . gamma)(a) = a|gamma(D_A f)
 through-gamma (a : (X.sheaf.ring M.top).R) :
  Id (X.sheaf.ring (DL.hmap AC.canonical.lat (AC.ZG.D f))).R
   (map (PQ.UA2.component PX.C.composite) a)
   (GO.restrict (DL.hmap AC.canonical.lat (AC.ZG.D f)) M.top (MO.le-top (DL.hmap AC.canonical.lat (AC.ZG.D f))) a) =
  calc (X.sheaf.ring (DL.hmap AC.canonical.lat (AC.ZG.D f))).R {
   map (PQ.UA2.component PX.C.composite) a
    =< PX.component a > map PX.gamma (map (PX.UA.component AC.canonical) a)
    =< ap (map PX.gamma) (CanId.component-of a) > map PX.gamma a
    =< cut-gamma a
     > GO.restrict (DL.hmap AC.canonical.lat (AC.ZG.D f)) (M.meet M.top (DL.hmap AC.canonical.lat (AC.ZG.D f)))
        (SM.SX.le-inc SM.SX.topS (SM.SX.cut M.top) PX.top-le)
        (GO.restrict (M.meet M.top (DL.hmap AC.canonical.lat (AC.ZG.D f))) M.top
          (MO.meet-left M.top (DL.hmap AC.canonical.lat (AC.ZG.D f))) a)
    =< X.sheaf.res-comp (DL.hmap AC.canonical.lat (AC.ZG.D f)) (M.meet M.top (DL.hmap AC.canonical.lat (AC.ZG.D f))) M.top
        (SM.SX.le-inc SM.SX.topS (SM.SX.cut M.top) PX.top-le) (MO.meet-left M.top (DL.hmap AC.canonical.lat (AC.ZG.D f)))
        (MO.le-top (DL.hmap AC.canonical.lat (AC.ZG.D f))) a
     > GO.restrict (DL.hmap AC.canonical.lat (AC.ZG.D f)) M.top (MO.le-top (DL.hmap AC.canonical.lat (AC.ZG.D f))) a } ;
 component-on (a : (X.sheaf.ring M.top).R) :
  Id (X.sheaf.ring (DL.hmap AC.canonical.lat (AC.ZG.D f))).R
   (map (PC.UA2.component PC.C.composite) (map (AC.GX.inclusion f) a))
   (GO.restrict (DL.hmap AC.canonical.lat (AC.ZG.D f)) M.top (MO.le-top (DL.hmap AC.canonical.lat (AC.ZG.D f))) a) =
  trans (through-k a) (trans (through-triangle a) (through-gamma a)) ;

 -- (4) psi = r . lambda, so psi is bijective
 to-image : MO.Le (DL.hmap AC.canonical.lat (AC.ZG.D f)) (LX.d M.top f) =
  MO.le-of-eq (DL.hmap AC.canonical.lat (AC.ZG.D f)) (LX.d M.top f) image-eq ;
 r : RH.Hom (X.sheaf.ring (LX.d M.top f)) (X.sheaf.ring (DL.hmap AC.canonical.lat (AC.ZG.D f))) =
  X.sheaf.res (DL.hmap AC.canonical.lat (AC.ZG.D f)) (LX.d M.top f) to-image ;
 r-lam : RH.Hom (AC.GX.Loc f) (X.sheaf.ring (DL.hmap AC.canonical.lat (AC.ZG.D f))) =
  RH.compose (AC.GX.Loc f) (X.sheaf.ring (LX.d M.top f)) (X.sheaf.ring (DL.hmap AC.canonical.lat (AC.ZG.D f))) r lam ;
 r-lam-on (a : (X.sheaf.ring M.top).R) :
  Id (X.sheaf.ring (DL.hmap AC.canonical.lat (AC.ZG.D f))).R (map r-lam (map (AC.GX.inclusion f) a))
   (GO.restrict (DL.hmap AC.canonical.lat (AC.ZG.D f)) M.top (MO.le-top (DL.hmap AC.canonical.lat (AC.ZG.D f))) a) =
  calc (X.sheaf.ring (DL.hmap AC.canonical.lat (AC.ZG.D f))).R {
   map r-lam (map (AC.GX.inclusion f) a)
    =< map-compose r lam (map (AC.GX.inclusion f) a) > map r (map lam (map (AC.GX.inclusion f) a))
    =< ap (map r) (lam-on a)
     > GO.restrict (DL.hmap AC.canonical.lat (AC.ZG.D f)) (LX.d M.top f) to-image
        (GO.restrict (LX.d M.top f) M.top (MO.le-top (LX.d M.top f)) a)
    =< X.sheaf.res-comp (DL.hmap AC.canonical.lat (AC.ZG.D f)) (LX.d M.top f) M.top to-image (MO.le-top (LX.d M.top f))
        (MO.le-top (DL.hmap AC.canonical.lat (AC.ZG.D f))) a
     > GO.restrict (DL.hmap AC.canonical.lat (AC.ZG.D f)) M.top (MO.le-top (DL.hmap AC.canonical.lat (AC.ZG.D f))) a } ;
 module LH = Bridge[l].Over[X.sheaf.ring M.top,f].LocH ;
 psi-eq : Id (RH.Hom (AC.GX.Loc f) (X.sheaf.ring (DL.hmap AC.canonical.lat (AC.ZG.D f)))) r-lam (PC.UA2.component PC.C.composite) =
  LH.Agree[AC.GX.Loc f,AC.GX.inclusion f,LH.is-loc (AC.GX.Loc f) (AC.GX.inclusion f) (AC.GX.elementary f),
   X.sheaf.ring (DL.hmap AC.canonical.lat (AC.ZG.D f)),X.sheaf.ring-set (DL.hmap AC.canonical.lat (AC.ZG.D f)),
   r-lam,PC.UA2.component PC.C.composite,\ a -> trans (r-lam-on a) (sym (component-on a))].equal ;
 module EO = Iso[l].EqualOpens[M,X.sheaf,DL.hmap AC.canonical.lat (AC.ZG.D f),LX.d M.top f,to-image,
  MO.le-of-eq (LX.d M.top f) (DL.hmap AC.canonical.lat (AC.ZG.D f)) (sym image-eq)] ;
 psi-equiv : Pr.isEquiv (AC.GX.Loc f).R (X.sheaf.ring (DL.hmap AC.canonical.lat (AC.ZG.D f))).R
  (map (PC.UA2.component PC.C.composite)) =
  Iso[l].equiv-homotopy (AC.GX.Loc f).R (X.sheaf.ring (DL.hmap AC.canonical.lat (AC.ZG.D f))).R
   (\ x -> map r (map lam x)) (map (PC.UA2.component PC.C.composite))
   (\ x -> ap (\ h -> map h x) psi-eq)
   (Iso[l].equiv-compose (AC.GX.Loc f).R (X.sheaf.ring (LX.d M.top f)).R (X.sheaf.ring (DL.hmap AC.canonical.lat (AC.ZG.D f))).R
     (map r) (map lam) EO.equiv lam-equiv) ;

 -- (5) c and c . j are isomorphisms
 module RC = Recognise[SM.SX.lattice,SM.SX.restricted,slice-affine,AC.GX.Loc f,AC.GX.set f,SB.SG.Loc,SB.SG.set,SB.SG.inclusion,
  SB.SG.elementary,PC.C.composite,c-local,psi-equiv] ;
 module CJ = Compose[l].Maps[SB.Sl.lattice,SB.ZG.lattice,SM.SX.lattice,SB.Sl.sheaf,SB.SG.spec.sheaf,SM.SX.sheaf].Of[PC.C.composite,SB.JB.factor] ;
 cj-iso : Iso[l].Maps[SB.Sl.lattice,SM.SX.lattice,SB.Sl.sheaf,SM.SX.sheaf].IsIso CJ.composite = CJ.iso SB.j-iso RC.iso ;

 -- (6) c . j = m
 module As = Compose[l].Assoc[SB.Sl.lattice,SB.ZG.lattice,SB.Sl.lattice,SM.SX.lattice,SB.Sl.sheaf,SB.SG.spec.sheaf,SB.Sl.sheaf,
  SM.SX.sheaf,SB.JB.factor,SB.KM.morphism,SM.morphism] ;
 module MS = Compose[l].Maps[SB.Sl.lattice,SB.Sl.lattice,SM.SX.lattice,SB.Sl.sheaf,SB.Sl.sheaf,SM.SX.sheaf] ;
 module ML = MapLaws[l].Units[SB.Sl.lattice,SM.SX.lattice,SB.Sl.sheaf,SM.SX.sheaf,SM.morphism] ;
 cj-eq : Id (LocallyRinged[l].Maps[SB.Sl.lattice,SM.SX.lattice,SB.Sl.sheaf,SM.SX.sheaf].Ringed) CJ.composite SM.morphism =
  calc (LocallyRinged[l].Maps[SB.Sl.lattice,SM.SX.lattice,SB.Sl.sheaf,SM.SX.sheaf].Ringed) {
   CJ.composite =< sym As.assoc > As.Left.composite
    =< ap (\ q -> MS.Of[SM.morphism,q].composite) SB.kj > MS.Of[SM.morphism,SB.IdS.identity].composite
    =< ML.right > SM.morphism } ;
 iso : SerreLocalIso[l].Restricted[AC.ZG.lattice,M,AC.GX.spec,X,AC.canonical,AC.ZG.D f].IsIso =
  Pr.subst (LocallyRinged[l].Maps[SB.Sl.lattice,SM.SX.lattice,SB.Sl.sheaf,SM.SX.sheaf].Ringed)
   (\ q -> Iso[l].Maps[SB.Sl.lattice,SM.SX.lattice,SB.Sl.sheaf,SM.SX.sheaf].IsIso q) CJ.composite SM.morphism cj-eq cj-iso ;
} ;
