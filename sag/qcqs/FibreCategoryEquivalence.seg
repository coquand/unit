-- A categorical equivalence of univalent categories C, D with objects
-- and arrows in U l: two functors (the library Functor record) and two
-- natural isomorphisms x ~= G(F x), y ~= F(G y).  Triangle identities are
-- not required (quasi-inverse equivalence).  Port of
-- ~/DOMAIN/UNIT/CategoryEquivalence.seg with the levels generalised and
-- the library functors in place of a second functor record.
-- Naturality is stated on the underlying arrows of the isomorphisms:
--   G(F f) o u_x = u_y o f   and   F(G g) o v_x = v_y o g.
level l ; open Base ;
module K = Category[l,l] ;
module F = Functor[l,l,l,l] ;

record Equivalence (C D : K.Category) {
 forward : F.Functor[C.pre,D.pre] ;
 backward : F.Functor[D.pre,C.pre] ;
 unit-source (x : C.pre.ob) : C.pre.Iso x (backward.obj (forward.obj x)) ;
 source-natural (x y : C.pre.ob) (f : C.pre.hom x y) :
  Id (C.pre.hom x (backward.obj (forward.obj y)))
   (C.pre.comp x (backward.obj (forward.obj x)) (backward.obj (forward.obj y))
     (backward.map (forward.obj x) (forward.obj y) (forward.map x y f)) (unit-source x).1)
   (C.pre.comp x y (backward.obj (forward.obj y)) (unit-source y).1 f) ;
 unit-target (x : D.pre.ob) : D.pre.Iso x (forward.obj (backward.obj x)) ;
 target-natural (x y : D.pre.ob) (f : D.pre.hom x y) :
  Id (D.pre.hom x (forward.obj (backward.obj y)))
   (D.pre.comp x (forward.obj (backward.obj x)) (forward.obj (backward.obj y))
     (forward.map (backward.obj x) (backward.obj y) (backward.map x y f)) (unit-target x).1)
   (D.pre.comp x y (forward.obj (backward.obj y)) (unit-target y).1 f) ;
} ;
