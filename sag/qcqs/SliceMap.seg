-- Restrict a local geometric map X -> Y to the inverse image of an open e.
-- First restrict its source to X|pi(e) (MapSeparation.Cut).  The inverse
-- image of e there is pi(e) /\ pi(e) = pi(e), the top of this source.
-- SliceUniversal.Back therefore factors it through Y|e.  It is local by
-- locality of restriction and of Back.  The triangle with Y|e -> Y is
-- Back.factor-cut; uniqueness of this factorisation is SliceUniversal.cancel.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module DL = DistLattice[l] ;
module Over (L M : DL.DLat) (Y : LocallyRinged[l].On[L].LocallyRinged)
 (X : LocallyRinged[l].On[M].LocallyRinged)
 (pi : LocallyRinged[l].Maps[L,M,Y.sheaf,X.sheaf].Ringed) (e : L.L) {
 module O = DL.Order[M] ;
 module SY = Slice[l].Over[L,Y,e] ;
 module SX = Slice[l].Over[M,X,DL.hmap pi.lat e] ;
 module Cut = MapSeparation[l].Maps[L,M,Y.sheaf,X].Cut[DL.hmap pi.lat e] ;
 module UP = SliceUniversal[l].Over[L,Y,e,SX.lattice,SX.sheaf] ;
 top-e : Id SX.Opens (DL.hmap (Cut.restrict pi).lat e) SX.topS =
  SX.ext (DL.hmap (Cut.restrict pi).lat e) SX.topS (O.meet-idem (DL.hmap pi.lat e)) ;
 module B = UP.Back[Cut.restrict pi,top-e] ;
 morphism : LocallyRinged[l].Maps[SY.lattice,SX.lattice,SY.sheaf,SX.sheaf].Ringed = B.factor ;
 triangle : Id UP.MX.Ringed UP.C.Of[morphism,SY.inclusion].composite (Cut.restrict pi) = B.factor-cut ;
 unique (rho : UP.MS.Ringed) (h : Id UP.MX.Ringed UP.C.Of[rho,SY.inclusion].composite (Cut.restrict pi)) :
  Id UP.MS.Ringed rho morphism = UP.cancel rho morphism (trans h (sym triangle)) ;
 local (loc : LocallyRinged[l].Maps[L,M,Y.sheaf,X.sheaf].Of[pi,Y.inv,X.inv].IsLocal) :
  LocallyRinged[l].Maps[SY.lattice,SX.lattice,SY.sheaf,SX.sheaf].Of[morphism,SY.inv,SX.inv].IsLocal =
  B.local SX.inv (Cut.local Y.inv pi loc) ;
} ;
