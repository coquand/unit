-- Additive identities for Cech coboundaries, proved by group laws.
-- Four terms can be rearranged using associativity and commutativity.
-- This proves preservation of addition by negatives and differences.
-- A telescoping sum (b-a)+(c-b)=c-a cancels the repeated b.
level l ; open Ring[l] ; open Presentations[l] ;
module SM = SerreModule[l] ;
module Over (A : CRing) (Md : SM.Over[A].Module) {
 open Md ;
 module Laws = SM.Over[A].Laws[Md] ;
 swap-middle (x y z : M) : Id M (madd x (madd y z)) (madd y (madd x z)) =
  trans (maddA x y z) (trans (ap (\ w -> madd w z) (maddC x y)) (sym (maddA y x z))) ;
 swap-four (a b c d : M) : Id M (madd (madd a b) (madd c d)) (madd (madd a c) (madd b d)) =
  trans (sym (maddA a b (madd c d)))
   (trans (ap (madd a) (swap-middle b c d)) (maddA a c (madd b d))) ;
 neg-add (x y : M) : Id M (mneg (madd x y)) (madd (mneg x) (mneg y)) =
  sym (Laws.neg-unique (madd x y) (madd (mneg x) (mneg y))
   (trans (swap-four x y (mneg x) (mneg y))
    (trans (cong2 M madd _ _ _ _ (maddN x) (maddN y)) (maddZ mz)))) ;
 neg-neg (x : M) : Id M (mneg (mneg x)) x =
  sym (Laws.neg-unique (mneg x) x (trans (maddC (mneg x) x) (maddN x))) ;
 sub-add (a b c d : M) : Id M (Laws.sub (madd a b) (madd c d)) (madd (Laws.sub a c) (Laws.sub b d)) =
  trans (Laws.sub-at (madd a b) (madd c d))
   (trans (ap (madd (madd a b)) (neg-add c d))
    (trans (swap-four a b (mneg c) (mneg d))
     (cong2 M madd _ _ _ _ (sym (Laws.sub-at a c)) (sym (Laws.sub-at b d))))) ;
 telescope (a b c : M) : Id M (madd (Laws.sub b a) (Laws.sub c b)) (Laws.sub c a) =
  trans (cong2 M madd _ _ _ _ (Laws.sub-at b a) (Laws.sub-at c b))
   (trans (sym (maddA b (mneg a) (madd c (mneg b))))
    (trans (ap (madd b) (swap-middle (mneg a) c (mneg b)))
     (trans (swap-middle b c (madd (mneg a) (mneg b)))
      (trans (ap (madd c) (swap-middle b (mneg a) (mneg b)))
       (trans (ap (\ w -> madd c (madd (mneg a) w)) (maddN b))
        (trans (ap (madd c) (maddZ (mneg a))) (sym (Laws.sub-at c a)))))))) ;
 sub-plus-right (x y : M) : Id M (madd (Laws.sub x y) y) x =
  trans (ap (\ z -> madd z y) (Laws.sub-at x y))
   (trans (sym (maddA x (mneg y) y))
    (trans (ap (madd x) (trans (maddC (mneg y) y) (maddN y))) (maddZ x))) ;
 sub-cancel-right (x y : M) : Id M (Laws.sub (madd x y) y) x =
  trans (Laws.sub-at (madd x y) y)
   (trans (sym (maddA x y (mneg y))) (trans (ap (madd x) (maddN y)) (maddZ x))) ;
 sub-add-same (x y z : M) : Id M (Laws.sub (madd x z) (madd y z)) (Laws.sub x y) =
  trans (sub-add x z y z)
   (trans (ap (madd (Laws.sub x y)) (Laws.sub-self z)) (maddZ (Laws.sub x y))) ;
 parallel (a b c d : M) (h : Id M (Laws.sub a b) (Laws.sub c d)) : Id M (Laws.sub a c) (Laws.sub b d) =
  trans (cong2 M Laws.sub _ _ _ _ (sym (sub-plus-right a b)) (sym (sub-plus-right c d)))
   (trans (sub-add (Laws.sub a b) b (Laws.sub c d) d)
    (trans (ap (\ z -> madd (Laws.sub z (Laws.sub c d)) (Laws.sub b d)) h)
     (trans (ap (\ z -> madd z (Laws.sub b d)) (Laws.sub-self (Laws.sub c d))) (Laws.zero-left (Laws.sub b d))))) ;
 opaque neg-add ; opaque neg-neg ; opaque sub-add ; opaque telescope ;
 opaque sub-plus-right ; opaque sub-cancel-right ;
 opaque sub-add-same ; opaque parallel ;
} ;
