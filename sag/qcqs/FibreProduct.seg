-- The fibre product of rings (DESIGN.md, step 4, Next 1: the sections of a
-- doubled lattice are pairs agreeing on the overlap).
--
-- For ring maps f : A -> C and g : B -> C (A, B, C sets), A x_C B is the
-- ring of pairs (a, b) with f a = g b, with componentwise operations: the
-- pair of two sums agrees since f and g are ring maps.  Agreement is a
-- proposition, so two pairs with equal components are equal (ext), and
-- the ring laws hold componentwise.
-- Universal property (Lift).  For ring maps p : T -> A, q : T -> B with
--  f (p t) = g (q t), t |-> (p t, q t) is a ring map, by ext; its
--  components are p and q by definition, and it is the only such map.
-- Lemma (units).  (a, b) is a unit iff a and b are.  The components of an
--  inverse are inverses.  Conversely, if a a2 = 1 and b b2 = 1, then f a2
--  and g b2 are both inverses of f a = g b, hence equal, and (a2, b2) is
--  an inverse of (a, b).
-- Lemma (projections).  If g is bijective, the first projection is: its
--  inverse is a |-> (a, g^-1 (f a)), and b = g^-1 (g b) = g^-1 (f a) for a
--  pair (a, b).  Likewise for f and the second projection.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module Over (A B C : CRing) (setA : Pr.isSet A.R) (setB : Pr.isSet B.R) (setC : Pr.isSet C.R)
 (f : RH.Hom A C) (g : RH.Hom B C) {
 Agree (a : A.R) (b : B.R) : U l = Id C.R (map f a) (map g b) ;
 Pair : U l = (p : A.R * B.R) * Agree p.1 p.2 ;
 pair (a : A.R) (b : B.R) (e : Agree a b) : Pair = ((a,b),e) ;
 left (x : Pair) : A.R = x.1.1 ;
 right (x : Pair) : B.R = x.1.2 ;
 agree (x : Pair) : Agree (left x) (right x) = x.2 ;
 ext (x y : Pair) (e1 : Id A.R (left x) (left y)) (e2 : Id B.R (right x) (right y)) : Id Pair x y =
  Pr.Sigma-eq (A.R * B.R) (\ p -> Agree p.1 p.2) x.1 y.1 x.2 y.2
   (trans (Pr.ap A.R (A.R * B.R) (\ a -> (a,right x)) (left x) (left y) e1)
     (Pr.ap B.R (A.R * B.R) (\ b -> (left y,b)) (right x) (right y) e2))
   (setC (map f (left y)) (map g (right y))) ;
 pair-set : Pr.isSet Pair =
  Pr.isSet-Sigma (A.R * B.R) (\ p -> Agree p.1 p.2)
   (Pr.isSet-Sigma A.R (\ a -> B.R) setA (\ a -> setB))
   (\ p -> Pr.prop-to-set (Agree p.1 p.2) (setC (map f p.1) (map g p.2))) ;

 -- the operations, componentwise
 zeroP : Pair = pair A.z B.z (trans (map-zero f) (sym (map-zero g))) ;
 oneP : Pair = pair A.o B.o (trans (map-one f) (sym (map-one g))) ;
 addP (x y : Pair) : Pair = pair (A.add (left x) (left y)) (B.add (right x) (right y)) (calc C.R {
  map f (A.add (left x) (left y)) =< map-add f (left x) (left y) > C.add (map f (left x)) (map f (left y))
   =< cong2 C.R C.add _ _ _ _ (agree x) (agree y) > C.add (map g (right x)) (map g (right y))
   =< sym (map-add g (right x) (right y)) > map g (B.add (right x) (right y)) }) ;
 mulP (x y : Pair) : Pair = pair (A.mul (left x) (left y)) (B.mul (right x) (right y)) (calc C.R {
  map f (A.mul (left x) (left y)) =< map-mul f (left x) (left y) > C.mul (map f (left x)) (map f (left y))
   =< cong2 C.R C.mul _ _ _ _ (agree x) (agree y) > C.mul (map g (right x)) (map g (right y))
   =< sym (map-mul g (right x) (right y)) > map g (B.mul (right x) (right y)) }) ;
 negP (x : Pair) : Pair = pair (A.neg (left x)) (B.neg (right x))
  (trans (map-neg f (left x)) (trans (ap C.neg (agree x)) (sym (map-neg g (right x))))) ;
 ring : CRing = mkCRing Pair zeroP oneP addP mulP negP
  (\ x y w -> ext (addP x (addP y w)) (addP (addP x y) w) (A.addA (left x) (left y) (left w)) (B.addA (right x) (right y) (right w)))
  (\ x y -> ext (addP x y) (addP y x) (A.addC (left x) (left y)) (B.addC (right x) (right y)))
  (\ x -> ext (addP x zeroP) x (A.addZ (left x)) (B.addZ (right x)))
  (\ x -> ext (addP x (negP x)) zeroP (A.addN (left x)) (B.addN (right x)))
  (\ x y w -> ext (mulP x (mulP y w)) (mulP (mulP x y) w) (A.mulA (left x) (left y) (left w)) (B.mulA (right x) (right y) (right w)))
  (\ x y -> ext (mulP x y) (mulP y x) (A.mulC (left x) (left y)) (B.mulC (right x) (right y)))
  (\ x -> ext (mulP x oneP) x (A.mulO (left x)) (B.mulO (right x)))
  (\ x y w -> ext (mulP x (addP y w)) (addP (mulP x y) (mulP x w)) (A.dist (left x) (left y) (left w)) (B.dist (right x) (right y) (right w))) ;

 -- the projections are ring maps, by definition
 proj-left : RH.Hom ring A =
  (left,refl A.o,\ x y -> refl (A.add (left x) (left y)),\ x y -> refl (A.mul (left x) (left y))) ;
 proj-right : RH.Hom ring B =
  (right,refl B.o,\ x y -> refl (B.add (right x) (right y)),\ x y -> refl (B.mul (right x) (right y))) ;

 -- the universal property
 module Lift (T : CRing) (p : RH.Hom T A) (q : RH.Hom T B) (e : (t : T.R) -> Agree (map p t) (map q t)) {
  lift-map (t : T.R) : Pair = pair (map p t) (map q t) (e t) ;
  lift : RH.Hom T ring =
   (lift-map,
    ext (lift-map T.o) oneP (map-one p) (map-one q),
    (\ t t2 -> ext (lift-map (T.add t t2)) (addP (lift-map t) (lift-map t2)) (map-add p t t2) (map-add q t t2)),
    (\ t t2 -> ext (lift-map (T.mul t t2)) (mulP (lift-map t) (lift-map t2)) (map-mul p t t2) (map-mul q t t2))) ;
  -- its components, by definition
  left-lift (t : T.R) : Id A.R (left (map lift t)) (map p t) = refl (map p t) ;
  right-lift (t : T.R) : Id B.R (right (map lift t)) (map q t) = refl (map q t) ;
  unique (h : RH.Hom T ring) (hl : (t : T.R) -> Id A.R (left (map h t)) (map p t))
   (hr : (t : T.R) -> Id B.R (right (map h t)) (map q t)) (t : T.R) : Id Pair (map h t) (map lift t) =
   ext (map h t) (map lift t) (hl t) (hr t) ;
 } ;

 -- units
 unit-left (x : Pair) (u : RL[ring].unit x) : RL[A].unit (left x) = (left u.1,ap left u.2) ;
 unit-right (x : Pair) (u : RL[ring].unit x) : RL[B].unit (right x) = (right u.1,ap right u.2) ;
 -- f a2 = g b2 for inverses a2 of a and b2 of b
 inverse-agree (x : Pair) (ua : RL[A].unit (left x)) (ub : RL[B].unit (right x)) : Agree ua.1 ub.1 =
  AffineRing[l].Laws[C,setC].inverse-unique (map f (left x)) (map f ua.1) (map g ub.1)
   (AffineRing[l].unit-map A C f (left x) ua).2
   (trans (ap (\ c -> C.mul c (map g ub.1)) (agree x)) (AffineRing[l].unit-map B C g (right x) ub).2) ;
 unit-pair (x : Pair) (ua : RL[A].unit (left x)) (ub : RL[B].unit (right x)) : RL[ring].unit x =
  (pair ua.1 ub.1 (inverse-agree x ua ub),
   ext (mulP x (pair ua.1 ub.1 (inverse-agree x ua ub))) oneP ua.2 ub.2) ;

 -- if g is bijective, so is the first projection: back a = (a, g^-1 (f a))
 module LeftEquiv (eg : Pr.isEquiv B.R C.R (map g)) {
  back (a : A.R) : Pair = pair a (eg.sec (map f a)) (sym (eg.sec-eq (map f a))) ;
  -- g^-1 (f (left x)) = g^-1 (g (right x)) = right x
  right-back (x : Pair) : Id B.R (right (back (left x))) (right x) =
   trans (ap eg.sec (agree x)) (Pr.sec-ret B.R C.R (map g) eg (right x)) ;
  equiv : Pr.isEquiv Pair A.R left =
   Pr.qinv Pair A.R left back (\ a -> refl a) (\ x -> ext (back (left x)) x (refl (left x)) (right-back x)) ;
 } ;
 -- if f is bijective, so is the second projection: back b = (f^-1 (g b), b)
 module RightEquiv (ef : Pr.isEquiv A.R C.R (map f)) {
  back (b : B.R) : Pair = pair (ef.sec (map g b)) b (ef.sec-eq (map g b)) ;
  left-back (x : Pair) : Id A.R (left (back (right x))) (left x) =
   trans (ap ef.sec (sym (agree x))) (Pr.sec-ret A.R C.R (map f) ef (left x)) ;
  equiv : Pr.isEquiv Pair B.R right =
   Pr.qinv Pair B.R right back (\ b -> refl b) (\ x -> ext (back (right x)) x (left-back x) (refl (right x))) ;
 } ;
} ;
