-- The constructive Serre criterion, direct implication (serre-affineness.tex,
-- Theorem thm:serre and Section 9).  X is a qcqs locally ringed lattice on L,
-- A = O_X(top), gamma : X -> Spec A the canonical map (AffineCriterion).
--
-- Lemma (covers).  If f_1 + .. + f_n = 1 in A, then the D_A(f_i) cover
--  Spec A and the D(f_i) = D_top(f_i) cover X: both D_A and D_top are
--  supports on A (ZariskiLattice; SpecMap for the identity of A), so
--  top = D(1) = D(f_1 1 + .. + f_n 1) <= D(f_1) \/ .. \/ D(f_n)
--  (DistLattice.Supports.lin-below).
-- Theorem (principal).  If moreover every D(f_i) is affine and the canonical
--  ring maps lambda_i : A_(f_i) -> O(D(f_i)) are bijective, X is affine:
--  over every member D_A(f_i) of the cover of Spec A the canonical map
--  restricts to an isomorphism (SerreCanonicalMap), so it is one
--  (SerreLocalIso).  An empty family is included: then 0 = 1 in A, the
--  cover of Spec A is empty, and SerreLocalIso covers that case.
-- Lemma (proposition).  Affineness of X is a proposition: it is
--  bijectivity of a lattice map and of ring maps between sets.
-- Theorem (Serre).  Suppose every torsor under every small quasi-coherent
--  module merely has a global section.  X merely has a finite affine cover;
--  for such a cover the partition-of-unity proposition (prop:principalcover)
--  merely gives f_i with sum 1, D(f_i) <= u_i and D(f_i) affine, and the
--  ring lemma (lem:principal-ring-localisation) gives the bijective lambda_i.
--  By (principal) X is affine; this is a proposition, so the two mere
--  existences are eliminated into it.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;
module IT = IdentityTools[l] ;

-- the two covers of a partition of unity
module Covers (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged) (n : Nat) (fs : Fin n -> (X.sheaf.ring L.top).R)
 (unit : Id (X.sheaf.ring L.top).R (FiniteIdeal[l].Sums[X.sheaf.ring L.top].sum n fs) (X.sheaf.ring L.top).o) {
 module SA = FiniteIdeal[l].Sums[X.sheaf.ring L.top] ;
 module AC = AffineCriterion[l].Over[L,X] ;
 module LX = LocallyRinged[l].On[L].Laws[X.sheaf,X.inv] ;
 module CanId = AC.Can.Of[RH.identity (X.sheaf.ring L.top)] ;
 -- f_1 1 + .. + f_n 1 = 1
 unit-lin : Id (X.sheaf.ring L.top).R (SA.lin n fs (\ i -> (X.sheaf.ring L.top).o)) (X.sheaf.ring L.top).o =
  trans (SA.sum-cong n (\ i -> (X.sheaf.ring L.top).mul (fs i) (X.sheaf.ring L.top).o) fs (\ i -> (X.sheaf.ring L.top).mulO (fs i)))
   unit ;
 module SZ = DL.Supports[X.sheaf.ring L.top,AC.ZG.lattice].Of[AC.ZG.D,AC.ZG.support] ;
 zariski-covers : DL.Order[AC.ZG.lattice].Le AC.ZG.lattice.top (DL.Joins[AC.ZG.lattice].bigJ n (\ i -> AC.ZG.D (fs i))) =
  Pr.subst AC.ZG.lattice.L (\ t -> DL.Order[AC.ZG.lattice].Le t (DL.Joins[AC.ZG.lattice].bigJ n (\ i -> AC.ZG.D (fs i))))
   (AC.ZG.D (SA.lin n fs (\ i -> (X.sheaf.ring L.top).o))) AC.ZG.lattice.top
   (trans (ap AC.ZG.D unit-lin) SZ.at-one) (SZ.lin-below n fs (\ i -> (X.sheaf.ring L.top).o)) ;
 module SX = DL.Supports[X.sheaf.ring L.top,L].Of[CanId.SM.d,CanId.SM.d-support] ;
 covers : DL.Order[L].Le L.top (DL.Joins[L].bigJ n (\ i -> LX.d L.top (fs i))) =
  Pr.subst L.L (\ t -> DL.Order[L].Le t (DL.Joins[L].bigJ n (\ i -> LX.d L.top (fs i))))
   (CanId.SM.d (SA.lin n fs (\ i -> (X.sheaf.ring L.top).o))) L.top
   (trans (ap CanId.SM.d unit-lin) SX.at-one) (SX.lin-below n fs (\ i -> (X.sheaf.ring L.top).o)) ;
} ;

-- X is affine on a principal affine cover with bijective ring maps
module Principal (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged) (n : Nat) (fs : Fin n -> (X.sheaf.ring L.top).R)
 (unit : Id (X.sheaf.ring L.top).R (FiniteIdeal[l].Sums[X.sheaf.ring L.top].sum n fs) (X.sheaf.ring L.top).o)
 (affine : (i : Fin n) -> Qcqs[l].Over[L,X].AffineOpen (LocallyRinged[l].On[L].Laws[X.sheaf,X.inv].d L.top (fs i)))
 (lam : (k : Fin n) -> RH.Hom (Affine[l].Over[X.sheaf.ring L.top].Loc (fs k))
   (X.sheaf.ring (LocallyRinged[l].On[L].Laws[X.sheaf,X.inv].d L.top (fs k))))
 (lam-on : (k : Fin n) (a : (X.sheaf.ring L.top).R) -> Id (X.sheaf.ring (LocallyRinged[l].On[L].Laws[X.sheaf,X.inv].d L.top (fs k))).R
   (map (lam k) (map (Affine[l].Over[X.sheaf.ring L.top].inclusion (fs k)) a))
   (RingedLattice[l].On[L].Of[X.sheaf].restrict (LocallyRinged[l].On[L].Laws[X.sheaf,X.inv].d L.top (fs k)) L.top
     (DL.Order[L].le-top (LocallyRinged[l].On[L].Laws[X.sheaf,X.inv].d L.top (fs k))) a))
 (lam-equiv : (k : Fin n) -> Pr.isEquiv (Affine[l].Over[X.sheaf.ring L.top].Loc (fs k)).R
   (X.sheaf.ring (LocallyRinged[l].On[L].Laws[X.sheaf,X.inv].d L.top (fs k))).R (map (lam k))) {
 module C = Covers[L,X,n,fs,unit] ;
 module AC = C.AC ;
 module LI = SerreLocalIso[l].Over[AC.ZG.lattice,L,AC.GX.spec,X,AC.canonical,n,\ i -> AC.ZG.D (fs i),C.zariski-covers,
  \ i -> SerreCanonicalMap[l].Over[L,X,fs i,affine i,lam i,lam-on i,lam-equiv i].iso] ;
 affine-canonical : AC.IsAffine = LI.iso ;
} ;

-- affineness is a proposition
module AffineProp (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged) {
 module AC = AffineCriterion[l].Over[L,X] ;
 is-affine-prop : Pr.isProp AC.IsAffine =
  IT.both (Pr.isEquiv AC.ZG.lattice.L L.L (DL.hmap AC.canonical.lat))
   ((u : AC.ZG.lattice.L) -> Pr.isEquiv (AC.Can.Sh.structure.ring u).R (X.sheaf.ring (DL.hmap AC.canonical.lat u)).R
     (map (AC.canonical.sharp u)))
   (IT.Equivalence[AC.ZG.lattice.L,L.L,AC.ZG.lattice.setL,L.setL,DL.hmap AC.canonical.lat].equal)
   (IT.FE.isProp-Pi AC.ZG.lattice.L (\ u -> Pr.isEquiv (AC.Can.Sh.structure.ring u).R (X.sheaf.ring (DL.hmap AC.canonical.lat u)).R
      (map (AC.canonical.sharp u)))
    (\ u -> IT.Equivalence[(AC.Can.Sh.structure.ring u).R,(X.sheaf.ring (DL.hmap AC.canonical.lat u)).R,
      AC.Can.Sh.structure.ring-set u,X.sheaf.ring-set (DL.hmap AC.canonical.lat u),map (AC.canonical.sharp u)].equal)) ;
} ;

-- From a principal cover subordinate to an affine cover, X is affine:
-- the ring lemma lem:principal-ring-localisation (SerreRingLocalisation)
-- gives the data of Principal.  The ring lemma states its value on original
-- elements with the restriction witness of the canonical map, so res-irr
-- passes to the witness le-top used by Principal.
module FromCover (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged)
 (cover : Qcqs[l].Over[L,X].AffineCover) (P : SerrePartitionCover[l].On[L,X].Cover[cover].PrincipalCover) {
 module AC = AffineCriterion[l].Over[L,X] ;
 module LX = LocallyRinged[l].On[L].Laws[X.sheaf,X.inv] ;
 module GO = RingedLattice[l].On[L].Of[X.sheaf] ;
 module C = Covers[L,X,cover.count,P.units,P.sum-one] ;
 module R (k : Fin cover.count) {
  module RL = SerreRingLocalisation[l].Over[L,X,cover.count,P.units,C.covers,P.affine,k] ;
  on (a : (X.sheaf.ring L.top).R) : Id (X.sheaf.ring (LX.d L.top (P.units k))).R
   (map RL.ring-map (map (Affine[l].Over[X.sheaf.ring L.top].inclusion (P.units k)) a))
   (GO.restrict (LX.d L.top (P.units k)) L.top (DL.Order[L].le-top (LX.d L.top (P.units k))) a) =
   trans (RL.ring-map-on a) (GO.res-irr (LX.d L.top (P.units k)) L.top RL.C.below (DL.Order[L].le-top (LX.d L.top (P.units k))) a) ;
 } ;
 module PR = Principal[L,X,cover.count,P.units,P.sum-one,P.affine,\ k -> R[k].RL.ring-map,\ k -> R[k].on,\ k -> R[k].RL.iso] ;
 affine : AC.IsAffine = PR.affine-canonical ;
} ;

-- Theorem thm:serre.  The hypothesis is that of the partition of unity
-- (SerrePartitionCover.Hypothesis); its proposition prop:principalcover
-- gives the principal cover of FromCover.
module Serre (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged)
 (qcqs : Qcqs[l].Over[L,X].IsQcqs) (hypothesis : SerrePartitionCover[l].On[L,X].Hypothesis) {
 module PC = SerrePartitionCover[l].On[L,X] ;
 module AC = AffineCriterion[l].Over[L,X] ;
 module AP = AffineProp[L,X] ;
 from-cover (cover : Qcqs[l].Over[L,X].AffineCover) : AC.IsAffine =
  Tr.Trunc[PC.Cover[cover].PrincipalCover].induction @l (\ x -> AC.IsAffine) (\ x -> AP.is-affine-prop)
   (\ P -> FromCover[L,X,cover,P].affine) (PC.Cover[cover].principal-cover hypothesis) ;
 -- X is affine
 affine : AC.IsAffine =
  Tr.Trunc[Qcqs[l].Over[L,X].AffineCover].induction @l (\ x -> AC.IsAffine) (\ x -> AP.is-affine-prop) from-cover qcqs ;
} ;
