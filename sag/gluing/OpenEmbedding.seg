-- Open embeddings: embeddings whose image is an open subtype.  They are
-- closed under composition (into a set); openness of the composite image
-- is 4.2.9: it is the image of h, then the image of e over that point.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module M = SchemeMaps[l] ;
iff-equiv (A B : U l) (pA : Pr.isProp A) (pB : Pr.isProp B) (to : A -> B) (from : B -> A) : Pr.Equiv A B =
 (to,Pr.qinv A B to from (\ b -> pB (to (from b)) b) (\ a -> pA (from (to a)) a)) ;
module Over (R : CRing) (setR : Pr.isSet R.R) (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module OP = OpenProp[l].Over[R,setR] ;
 module T = Transitivity[l].Over[R,setR,axioms] ;
 OpenImage (A X : U l) (f : A -> X) : U l = (x : X) -> OP.Open (M.Image A X f x) ;
 module Compose (A B C : U l) (sC : Pr.isSet C)
  (e : A -> B) (ee : M.Embedding A B e) (oe : OpenImage A B e)
  (h : B -> C) (eh : M.Embedding B C h) (oh : OpenImage B C h) {
  comp (a : A) : C = h (e a) ;
  embedding : M.Embedding A C comp = M.injective-embedding A C sC comp (\ a b p ->
   GluePushout[l].injective A B e ee a b (GluePushout[l].injective B C h eh (e a) (e b) p)) ;
  module Hc = M.Embedded[B,C,h,eh] ;
  -- the point of B over c, and the image of e over it
  Above (c : C) (s : M.Image B C h c) : U l = M.Image A B e (Hc.choose c s).1 ;
  above-prop (c : C) (s : M.Image B C h c) : Pr.isProp (Above c s) = M.image-prop A B e (Hc.choose c s).1 ;
  Two (c : C) : U l = (s : M.Image B C h c) * Above c s ;
  two-prop (c : C) : Pr.isProp (Two c) =
   Pr.isProp-Sigma (M.Image B C h c) (Above c) (M.image-prop B C h c) (above-prop c) ;
  to-two (c : C) (v : M.Fiber A C comp c) : Two c =
   (Tr.Trunc[M.Fiber B C h c].inc (e v.1,v.2),
    subst (M.Image A B e)
     (ap (\ w -> w.1) (eh c (e v.1,v.2) (Hc.choose c (Tr.Trunc[M.Fiber B C h c].inc (e v.1,v.2)))))
     (Tr.Trunc[M.Fiber A B e (e v.1)].inc (v.1,refl (e v.1)))) ;
  from-two (c : C) (t : Two c) : M.Image A C comp c =
   Tr.Trunc[M.Fiber A B e (Hc.choose c t.1).1].induction @l (\ u -> M.Image A C comp c)
    (\ u -> M.image-prop A C comp c)
    (\ w -> Tr.Trunc[M.Fiber A C comp c].inc
     (w.1,trans (ap h w.2) (Hc.choose c t.1).2)) t.2 ;
  image-two (c : C) : Pr.Equiv (M.Image A C comp c) (Two c) =
   iff-equiv (M.Image A C comp c) (Two c) (M.image-prop A C comp c) (two-prop c)
    (Tr.Trunc[M.Fiber A C comp c].induction @l (\ u -> Two c) (\ u -> two-prop c) (to-two c))
    (from-two c) ;
  open-image : OpenImage A C comp = \ c ->
   OP.along (M.Image A C comp c) (Two c) (image-two c)
    (T.sigma (M.Image B C h c) (oh c) (Above c) (\ s -> oe (Hc.choose c s).1)) ;
 } ;
} ;
