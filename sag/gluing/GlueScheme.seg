-- SAG 5.3.1 (Loc, SQC, Z-choice): if X, Y are schemes and f : V -> X,
-- g : V -> Y are embeddings with open images, the pushout of f and g is a
-- scheme.  The inclusions of X and Y are open embeddings; composing the
-- charts of X and of Y with them gives a finite cover of the pushout.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module M = SchemeMaps[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module OP = OpenProp[l].Over[R,setR] ;
 module OO = OpenOps[l].Over[R,setR] ;
 module S = Schemes[l].Over[R,setR] ;
 module SA = SmallAffine[l].Over[R,setR] ;
 module OE = OpenEmbedding[l].Over[R,setR,axioms] ;
 module Gluing (X Y V : U l) (schX : S.Scheme X) (schY : S.Scheme Y) (f : V -> X) (g : V -> Y)
  (ef : M.Embedding V X f) (eg : M.Embedding V Y g)
  (of : OE.OpenImage V X f) (og : OE.OpenImage V Y g) {
  module G = GluePushout[l].Glue[X,Y,V,S.set X schX,S.set Y schY,f,g,ef,eg] ;
  P : U l = G.P ;
  -- X is open in P: on X its image is everything, on Y it is the image of g
  from-g (y : Y) (u : M.Image V Y g y) : M.Image X P G.il (G.ir y) =
   Tr.Trunc[M.Fiber V Y g y].induction @l (\ t -> M.Image X P G.il (G.ir y)) (\ t -> M.image-prop X P G.il (G.ir y))
    (\ w -> Tr.Trunc[M.Fiber X P G.il (G.ir y)].inc (f w.1,trans (G.glue w.1) (ap G.ir w.2))) u ;
  to-g (y : Y) (u : M.Image X P G.il (G.ir y)) : M.Image V Y g y =
   Tr.Trunc[M.Fiber X P G.il (G.ir y)].induction @l (\ t -> M.Image V Y g y) (\ t -> M.image-prop V Y g y)
    (\ w -> Tr.Trunc[M.Fiber V Y g y].inc ((G.meets w.1 y w.2).1.1,(G.meets w.1 y w.2).2)) u ;
  il-at : (a : Plus X Y) -> OP.Open (M.Image X P G.il (G.Q.inc a)) = split {
   inl x -> OP.along (M.Image X P G.il (G.il x)) Top
    (OpenEmbedding[l].iff-equiv _ Top (M.image-prop X P G.il (G.il x)) FinSum[l].top-prop (\ t -> tt)
     (\ t -> Tr.Trunc[M.Fiber X P G.il (G.il x)].inc (x,refl (G.il x)))) OO.open-top ;
   inr y -> OP.along (M.Image X P G.il (G.ir y)) (M.Image V Y g y)
    (OpenEmbedding[l].iff-equiv _ _ (M.image-prop X P G.il (G.ir y)) (M.image-prop V Y g y) (to-g y) (from-g y)) (og y) } ;
  il-open : OE.OpenImage X P G.il = G.Q.induction @l (\ q -> OP.Open (M.Image X P G.il q))
   (\ q -> Tr.Trunc[OP.Witness (M.Image X P G.il q)].proposition) il-at ;
  -- symmetrically for Y
  from-f (x : X) (u : M.Image V X f x) : M.Image Y P G.ir (G.il x) =
   Tr.Trunc[M.Fiber V X f x].induction @l (\ t -> M.Image Y P G.ir (G.il x)) (\ t -> M.image-prop Y P G.ir (G.il x))
    (\ w -> Tr.Trunc[M.Fiber Y P G.ir (G.il x)].inc (g w.1,trans (sym (G.glue w.1)) (ap G.il w.2))) u ;
  to-f (x : X) (u : M.Image Y P G.ir (G.il x)) : M.Image V X f x =
   Tr.Trunc[M.Fiber Y P G.ir (G.il x)].induction @l (\ t -> M.Image V X f x) (\ t -> M.image-prop V X f x)
    (\ w -> Tr.Trunc[M.Fiber V X f x].inc (G.meets x w.1 (sym w.2)).1) u ;
  ir-at : (a : Plus X Y) -> OP.Open (M.Image Y P G.ir (G.Q.inc a)) = split {
   inl x -> OP.along (M.Image Y P G.ir (G.il x)) (M.Image V X f x)
    (OpenEmbedding[l].iff-equiv _ _ (M.image-prop Y P G.ir (G.il x)) (M.image-prop V X f x) (to-f x) (from-f x)) (of x) ;
   inr y -> OP.along (M.Image Y P G.ir (G.ir y)) Top
    (OpenEmbedding[l].iff-equiv _ Top (M.image-prop Y P G.ir (G.ir y)) FinSum[l].top-prop (\ t -> tt)
     (\ t -> Tr.Trunc[M.Fiber Y P G.ir (G.ir y)].inc (y,refl (G.ir y)))) OO.open-top } ;
  ir-open : OE.OpenImage Y P G.ir = G.Q.induction @l (\ q -> OP.Open (M.Image Y P G.ir q))
   (\ q -> Tr.Trunc[OP.Witness (M.Image Y P G.ir q)].proposition) ir-at ;
  ------------------------------------------------------------------
  -- charts of X and Y, moved to P
  module Lift (Z : U l) (h : Z -> P) (eh : M.Embedding Z P h) (oh : OE.OpenImage Z P h) (c : S.Chart[Z]) {
   module K = OE.Compose[S.Domain Z c,Z,P,G.set,c.map,c.embedding,c.open-image,h,eh,oh] ;
   chart : S.Chart[P] = new S.Chart[P,c.presentation,K.comp,K.embedding,K.open-image] ;
   image (z : Z) (u : S.Image Z c z) : S.Image P chart (h z) =
    Tr.Trunc[M.Fiber (S.Domain Z c) Z c.map z].induction @l (\ t -> S.Image P chart (h z))
     (\ t -> M.image-prop (S.Domain Z c) P K.comp (h z))
     (\ w -> Tr.Trunc[M.Fiber (S.Domain Z c) P K.comp (h z)].inc (w.1,ap h w.2)) u ;
  } ;
  lift-x (c : S.Chart[X]) : S.Chart[P] = Lift[X,G.il,G.il-embedding,il-open,c].chart ;
  lift-y (c : S.Chart[Y]) : S.Chart[P] = Lift[Y,G.ir,G.ir-embedding,ir-open,c].chart ;
  module Covers (cx : S.Cover[X]) (cy : S.Cover[Y]) {
   n : Nat = cx.size ; m : Nat = cy.size ;
   charts : Fin (plus m n) -> S.Chart[P] =
    FinSum[l].cases n S.Chart[P] (\ i -> lift-x (cx.charts i)) m (\ j -> lift-y (cy.charts j)) ;
   Some (q : P) : U l = Tr.Trunc[(k : Fin (plus m n)) * S.Image P (charts k) q].carrier ;
   some-prop (q : P) : Pr.isProp (Some q) = Tr.Trunc[(k : Fin (plus m n)) * S.Image P (charts k) q].proposition ;
   at-x (x : X) : Some (G.il x) =
    Tr.Trunc[(i : Fin n) * S.Image X (cx.charts i) x].induction @l (\ t -> Some (G.il x)) (\ t -> some-prop (G.il x))
     (\ w -> Tr.Trunc[(k : Fin (plus m n)) * S.Image P (charts k) (G.il x)].inc
      (FinSum[l].left n m w.1,
       subst (\ c -> S.Image P c (G.il x))
        (sym (FinSum[l].cases-left n S.Chart[P] (\ i -> lift-x (cx.charts i)) m (\ j -> lift-y (cy.charts j)) w.1))
        (Lift[X,G.il,G.il-embedding,il-open,cx.charts w.1].image x w.2))) (cx.covers x) ;
   at-y (y : Y) : Some (G.ir y) =
    Tr.Trunc[(j : Fin m) * S.Image Y (cy.charts j) y].induction @l (\ t -> Some (G.ir y)) (\ t -> some-prop (G.ir y))
     (\ w -> Tr.Trunc[(k : Fin (plus m n)) * S.Image P (charts k) (G.ir y)].inc
      (FinSum[l].right n m w.1,
       subst (\ c -> S.Image P c (G.ir y))
        (sym (FinSum[l].cases-right n S.Chart[P] (\ i -> lift-x (cx.charts i)) m (\ j -> lift-y (cy.charts j)) w.1))
        (Lift[Y,G.ir,G.ir-embedding,ir-open,cy.charts w.1].image y w.2))) (cy.covers y) ;
   at : (a : Plus X Y) -> Some (G.Q.inc a) = split { inl x -> at-x x ; inr y -> at-y y } ;
   cover : S.Cover[P] = new S.Cover[P,plus m n,charts,G.Q.induction @l Some some-prop at] ;
  } ;
  -- 5.3.1
  scheme : S.Scheme P =
   Tr.Trunc[S.Cover[X]].induction @l (\ t -> S.Scheme P) (\ t -> S.proposition P)
    (\ cx -> Tr.Trunc[S.Cover[Y]].induction @l (\ t -> S.Scheme P) (\ t -> S.proposition P)
     (\ cy -> S.from-cover P Covers[cx,cy].cover) schY) schX ;
 } ;
} ;
