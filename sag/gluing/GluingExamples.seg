-- Uses of 5.3.1.  Gluing along the empty type: the disjoint union X + Y
-- of two schemes is a scheme.  The two inclusions are only propositionally
-- related to the quotient: il x = ir y has no proof without a point of V.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module M = SchemeMaps[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module OP = OpenProp[l].Over[R,setR] ;
 module OO = OpenOps[l].Over[R,setR] ;
 module S = Schemes[l].Over[R,setR] ;
 module GS = GlueScheme[l].Over[R,setR,axioms] ;
 module Disjoint (X Y : U l) (schX : S.Scheme X) (schY : S.Scheme Y) {
  empty-prop : Pr.isProp Empty = \ a b -> efq a ;
  from-empty (Z : U l) (e : Empty) : Z = efq e ;
  empty-embedding (Z : U l) : M.Embedding Empty Z (from-empty Z) = \ z w -> efq w.1 ;
  empty-image (Z : U l) (z : Z) : Pr.Equiv (M.Image Empty Z (from-empty Z) z) Empty =
   OpenEmbedding[l].iff-equiv _ Empty (M.image-prop Empty Z (from-empty Z) z) empty-prop
    (Tr.Trunc[M.Fiber Empty Z (from-empty Z) z].induction @l (\ t -> Empty) (\ t -> empty-prop) (\ w -> w.1))
    (\ e -> efq e) ;
  empty-open (Z : U l) : GS.OE.OpenImage Empty Z (from-empty Z) = \ z ->
   OP.along _ Empty (empty-image Z z) OO.open-empty ;
  module G = GS.Gluing[X,Y,Empty,schX,schY,from-empty X,from-empty Y,
   empty-embedding X,empty-embedding Y,empty-open X,empty-open Y] ;
  sum : S.Scheme G.P = G.scheme ;
  -- the two pieces are disjoint
  apart (x : X) (y : Y) (p : Id G.P (G.G.il x) (G.G.ir y)) : Empty = (G.G.meets x y p).1.1 ;
 } ;
 #fails {
  false-glue (X Y : U l) (schX : S.Scheme X) (schY : S.Scheme Y) (x : X) (y : Y) :
   Id Disjoint[X,Y,schX,schY].G.P (Disjoint[X,Y,schX,schY].G.G.il x) (Disjoint[X,Y,schX,schY].G.G.ir y) =
   refl (Disjoint[X,Y,schX,schY].G.G.il x) ;
 } ;
} ;
