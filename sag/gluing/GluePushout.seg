-- The pushout of two embeddings f : V -> X, g : V -> Y of sets, as the
-- quotient of X + Y identifying f v with g v (Quotient.Quot).  Because f
-- and g are embeddings the relation is propositional and has a direct
-- description.  Result: both inclusions are embeddings, the square
-- commutes, and the quotient is a pushout for maps into sets.
-- No geometric axiom.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module M = SchemeMaps[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
injective (A X : U l) (f : A -> X) (e : M.Embedding A X f) (a b : A) (p : Id X (f a) (f b)) : Id A a b =
 ap (\ w -> w.1) (e (f b) (a,p) (b,refl (f b))) ;
pair-eq (A B : U l) (a a' : A) (b b' : B) (p : Id A a a') (q : Id B b b') : Id (A * B) (a,b) (a',b') =
 Pr.trans (A * B) (a,b) (a',b) (a',b')
  (Pr.ap A (A * B) (\ z -> (z,b)) a a' p) (Pr.ap B (A * B) (\ z -> (a',z)) b b' q) ;
module Glue (X Y V : U l) (sX : Pr.isSet X) (sY : Pr.isSet Y) (f : V -> X) (g : V -> Y)
 (ef : M.Embedding V X f) (eg : M.Embedding V Y g) {
 -- x and y come from the same point of V
 Both (x : X) (y : Y) : U l = (w : M.Fiber V X f x) * Id Y (g w.1) y ;
 both-prop (x : X) (y : Y) : Pr.isProp (Both x y) =
  Pr.isProp-Sigma (M.Fiber V X f x) (\ w -> Id Y (g w.1) y) (ef x) (\ w -> sY (g w.1) y) ;
 rel : Plus X Y -> Plus X Y -> U l = split {
  inl x -> split { inl x' -> Id X x x' ; inr y -> Both x y } ;
  inr y -> split { inl x -> Both x y ; inr y' -> Id Y y y' } } ;
 prop : (a b : Plus X Y) -> Pr.isProp (rel a b) = split {
  inl x -> split { inl x' -> sX x x' ; inr y -> both-prop x y } ;
  inr y -> split { inl x -> both-prop x y ; inr y' -> sY y y' } } ;
 rr : (a : Plus X Y) -> rel a a = split { inl x -> refl x ; inr y -> refl y } ;
 rs : (a b : Plus X Y) -> rel a b -> rel b a = split {
  inl x -> split { inl x' -> \ p -> sym p ; inr y -> \ w -> w } ;
  inr y -> split { inl x -> \ w -> w ; inr y' -> \ p -> sym p } } ;
 -- the two points of V over y, resp. over x, agree
 meet-y (x x' : X) (y : Y) (w : Both x y) (w' : Both x' y) : Id X x x' =
  trans (sym w.1.2) (trans (ap f (injective V Y g eg w.1.1 w'.1.1 (trans w.2 (sym w'.2)))) w'.1.2) ;
 meet-x (x : X) (y y' : Y) (w : Both x y) (w' : Both x y') : Id Y y y' =
  trans (sym w.2) (trans (ap g (injective V X f ef w.1.1 w'.1.1 (trans w.1.2 (sym w'.1.2)))) w'.2) ;
 rt : (a b c : Plus X Y) -> rel a b -> rel b c -> rel a c = split {
  inl x -> split {
   inl x' -> split {
    inl x'' -> \ p q -> trans p q ;
    inr y -> \ p w -> ((w.1.1,trans w.1.2 (sym p)),w.2) } ;
   inr y -> split {
    inl x'' -> \ w w' -> meet-y x x'' y w w' ;
    inr y' -> \ w q -> (w.1,trans w.2 q) } } ;
  inr y -> split {
   inl x -> split {
    inl x' -> \ w p -> ((w.1.1,trans w.1.2 p),w.2) ;
    inr y' -> \ w w' -> meet-x x y y' w w' } ;
   inr y' -> split {
    inl x -> \ q w -> (w.1,trans w.2 (sym q)) ;
    inr y'' -> \ p q -> trans p q } } } ;
 module Q = Quotient[l].Quot[Plus X Y,rel,prop,rr,rs,rt] ;
 P : U l = Q.Q ;
 set : Pr.isSet P = Q.set ;
 il (x : X) : P = Q.inc (inl x) ;
 ir (y : Y) : P = Q.inc (inr y) ;
 glue (v : V) : Id P (il (f v)) (ir (g v)) =
  Q.relates (inl (f v)) (inr (g v)) ((v,refl (f v)),refl (g v)) ;
 il-embedding : M.Embedding X P il =
  M.injective-embedding X P set il (\ x x' p -> Q.effective (inl x) (inl x') p) ;
 ir-embedding : M.Embedding Y P ir =
  M.injective-embedding Y P set ir (\ y y' p -> Q.effective (inr y) (inr y') p) ;
 -- il x = ir y exactly when x and y come from the same point of V
 meets (x : X) (y : Y) (p : Id P (il x) (ir y)) : Both x y = Q.effective (inl x) (inr y) p ;
 ------------------------------------------------------------------
 -- The universal property for maps into sets.
 Cocone (B : U l) : U l = (hk : (X -> B) * (Y -> B)) * ((v : V) -> Id B (hk.1 (f v)) (hk.2 (g v))) ;
 restrict (B : U l) (m : P -> B) : Cocone B =
  ((\ x -> m (il x),\ y -> m (ir y)),\ v -> ap m (glue v)) ;
 module Extend (B : U l) (sB : Pr.isSet B) (c : Cocone B) {
  value : Plus X Y -> B = split { inl x -> c.1.1 x ; inr y -> c.1.2 y } ;
  across (x : X) (y : Y) (w : Both x y) : Id B (c.1.1 x) (c.1.2 y) =
   trans (ap c.1.1 (sym w.1.2)) (trans (c.2 w.1.1) (ap c.1.2 w.2)) ;
  respect : (a b : Plus X Y) -> rel a b -> Id B (value a) (value b) = split {
   inl x -> split { inl x' -> \ p -> ap c.1.1 p ; inr y -> \ w -> across x y w } ;
   inr y -> split { inl x -> \ w -> sym (across x y w) ; inr y' -> \ p -> ap c.1.2 p } } ;
  module D = Q.Descend[B,sB,value,respect] ;
  map : P -> B = D.map ;
  restricts : Id (Cocone B) (restrict B map) c =
   Pr.Sigma-eq ((X -> B) * (Y -> B)) (\ hk -> (v : V) -> Id B (hk.1 (f v)) (hk.2 (g v)))
    (restrict B map).1 c.1 (restrict B map).2 c.2
    (pair-eq (X -> B) (Y -> B) _ _ _ _
     (F.funext X (\ x -> B) _ _ (\ x -> D.beta (inl x)))
     (F.funext Y (\ y -> B) _ _ (\ y -> D.beta (inr y))))
    (F.isProp-Pi V (\ v -> Id B (c.1.1 (f v)) (c.1.2 (g v))) (\ v -> sB _ _)) ;
 } ;
 -- a map out of P is determined by its restriction
 module Unique (B : U l) (sB : Pr.isSet B) (m : P -> B) {
  module E = Extend[B,sB,restrict B m] ;
  at : (a : Plus X Y) -> Id B (E.map (Q.inc a)) (m (Q.inc a)) = split {
   inl x -> E.D.beta (inl x) ; inr y -> E.D.beta (inr y) } ;
  agree : Id (P -> B) E.map m =
   F.funext P (\ q -> B) E.map m (Q.induction @l (\ q -> Id B (E.map q) (m q)) (\ q -> sB _ _) at) ;
 } ;
 pushout (B : U l) (sB : Pr.isSet B) : Pr.isEquiv (P -> B) (Cocone B) (restrict B) =
  Pr.qinv (P -> B) (Cocone B) (restrict B) (\ c -> Extend[B,sB,c].map)
   (\ c -> Extend[B,sB,c].restricts) (\ m -> Unique[B,sB,m].agree) ;
} ;
