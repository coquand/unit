-- (H4), part II: every class is a diagonal (doc/h4.pdf, Section 4, Theorem A).
--   Section     the section of DW1 Lemma 9 written out:
--                 sec (F, w) a = (F a, Kf F a, cell F w a),  cell by J from w,
--               with a retraction ret (kf-ev, as in Lemma 9), ret (sec u) = u;
--               so sec is injective
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ; open HLevels[l] ; open Connected[l] ;
open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ; open Retracts[l] ; open Torsor[l] ; open LoopCalc[l] ;
open EMMaps[l] ; open AbHom[l] ; open HomotopyClasses[l] ; open SphereUniversal[l] ; open PostnikovRealization[l] ; open KZ2Cohomology[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module N = NatArith[l] ;
module CP = CircleProperty[l] ;

module Section (A : U l) (a0 : A) (B : U l) (b0 : B) (f : Maps[A, a0, B, b0].PMO) {
  module MA = Maps[A, a0, B, b0] ;
  module O = MA.Over[f] ;
  -- the cell of a delooping, by J from its value at (a0, refl)
  cell (u : O.Unloop) (a : A) (p : Id A a a0) : Id MA.PMO f (MA.D a (u.1.1 a) (MA.Kf u.1.1 u.1.2 a) p) =
    idJR A a0 (\ a1 p1 -> Id MA.PMO f (MA.D a1 (u.1.1 a1) (MA.Kf u.1.1 u.1.2 a1) p1)) u.2 a p ;
  sec (u : O.Unloop) : O.Rel = \ a -> (u.1.1 a, (MA.Kf u.1.1 u.1.2 a, cell u a)) ;
  -- the retraction: evaluate the cell at (a0, refl), after Kf (ev H) = H
  ret (rho : O.Rel) : O.Unloop =
    (((\ a -> (rho a).1), O.Fixed[\ a -> (rho a).1].ev (\ a -> (rho a).2.1)),
     trans MA.PMO f (MA.D a0 (rho a0).1 ((rho a0).2.1) (refl a0))
       (MA.D a0 (rho a0).1 (MA.Kf (\ a -> (rho a).1) (O.Fixed[\ a -> (rho a).1].ev (\ a -> (rho a).2.1)) a0) (refl a0))
       ((rho a0).2.2 (refl a0))
       (ap (Id A a0 a0 -> Id B (rho a0).1 b0) MA.PMO (\ h -> MA.D a0 (rho a0).1 h (refl a0))
          ((rho a0).2.1) (MA.Kf (\ a -> (rho a).1) (O.Fixed[\ a -> (rho a).1].ev (\ a -> (rho a).2.1)) a0)
          (sym (Id A a0 a0 -> Id B (rho a0).1 b0)
             (MA.Kf (\ a -> (rho a).1) (O.Fixed[\ a -> (rho a).1].ev (\ a -> (rho a).2.1)) a0) ((rho a0).2.1)
             (happly A (\ a -> Id A a a0 -> Id B (rho a).1 b0)
                (MA.Kf (\ a -> (rho a).1) (O.Fixed[\ a -> (rho a).1].ev (\ a -> (rho a).2.1))) (\ a -> (rho a).2.1)
                (O.Fixed[\ a -> (rho a).1].kf-ev (\ a -> (rho a).2.1)) a0)))) ;
  -- kf-ev at a J-generated H is refl: pointwise by J, then funext of refl
  kf-ev-pt (F : A -> B) (pF : Id B (F a0) b0) (a : A) (p : Id A a a0) :
    Id (Id (Id B (F a) b0) (MA.Kf F pF a p) (MA.Kf F pF a p)) (idJR A a0 (\ a1 p1 -> Id (Id B (F a1) b0) (MA.Kf F pF a1 p1) (MA.Kf F pF a1 p1)) (refl pF) a p) (refl (MA.Kf F pF a p)) =
    idJR A a0 (\ a1 p1 -> Id (Id (Id B (F a1) b0) (MA.Kf F pF a1 p1) (MA.Kf F pF a1 p1)) (idJR A a0 (\ a2 p2 -> Id (Id B (F a2) b0) (MA.Kf F pF a2 p2) (MA.Kf F pF a2 p2)) (refl pF) a1 p1) (refl (MA.Kf F pF a1 p1)))
      (refl (refl pF)) a p ;
  funext-refl (X : U l) (P : X -> U l) (g : (x : X) -> P x) :
    Id (Id ((x : X) -> P x) g g) (FL.funext X P g g (\ x -> refl (g x))) (refl g) =
    FL.funext-happly X P g g (refl g) ;
  kf-ev-refl (F : A -> B) (pF : Id B (F a0) b0) :
    Id (Id (O.Fixed[F].Ys) (MA.Kf F pF) (MA.Kf F pF)) (O.Fixed[F].kf-ev (MA.Kf F pF)) (refl (MA.Kf F pF)) =
    transH (apH (FL.funext A O.Fixed[F].Hom (MA.Kf F pF) (MA.Kf F pF))
              (FL.funext A (\ a -> Id (O.Fixed[F].Hom a) (MA.Kf F pF a) (MA.Kf F pF a)) (\ a -> FL.funext (Id A a a0) (\ p -> Id B (F a) b0) (MA.Kf F pF a) (MA.Kf F pF a)
                   (\ p -> idJR A a0 (\ a1 p1 -> Id (Id B (F a1) b0) (MA.Kf F pF a1 p1) (MA.Kf F pF a1 p1)) (refl pF) a p))
                 (\ a -> refl (MA.Kf F pF a))
                 (\ a -> transH (apH (FL.funext (Id A a a0) (\ p -> Id B (F a) b0) (MA.Kf F pF a) (MA.Kf F pF a))
                                   (FL.funext (Id A a a0) (\ p -> Id (Id B (F a) b0) (MA.Kf F pF a p) (MA.Kf F pF a p))
                                      (\ p -> idJR A a0 (\ a1 p1 -> Id (Id B (F a1) b0) (MA.Kf F pF a1 p1) (MA.Kf F pF a1 p1)) (refl pF) a p)
                                      (\ p -> refl (MA.Kf F pF a p)) (kf-ev-pt F pF a)))
                                (funext-refl (Id A a a0) (\ p -> Id B (F a) b0) (MA.Kf F pF a)))))
           (funext-refl A O.Fixed[F].Hom (MA.Kf F pF)) ;
  ret-sec (u : O.Unloop) : Id O.Unloop (ret (sec u)) u =
    apH (\ e -> ((u.1.1, u.1.2), trans MA.PMO f (MA.D a0 (u.1.1 a0) (MA.Kf u.1.1 u.1.2 a0) (refl a0)) (MA.loop u.1) u.2
                   (ap (Id A a0 a0 -> Id B (u.1.1 a0) b0) MA.PMO (\ h -> MA.D a0 (u.1.1 a0) h (refl a0)) (MA.Kf u.1.1 u.1.2 a0) (MA.Kf u.1.1 u.1.2 a0)
                      (sym (Id A a0 a0 -> Id B (u.1.1 a0) b0) (MA.Kf u.1.1 u.1.2 a0) (MA.Kf u.1.1 u.1.2 a0)
                         (happly A (\ a -> Id A a a0 -> Id B (u.1.1 a) b0) (MA.Kf u.1.1 u.1.2) (MA.Kf u.1.1 u.1.2) e a0)))))
      (kf-ev-refl u.1.1 u.1.2) ;
  sec-inj (u u' : O.Unloop) (e : Id O.Rel (sec u) (sec u')) : Id O.Unloop u u' =
    transH (symH (ret-sec u)) (transH (apH ret e) (ret-sec u')) ;
} ;

-- evaluation at a0 is injective on Rel: its components are sets (Levels.cell,
-- t = 2) and A is connected
module RelEval (A : U l) (a0 : A) (B : U l) (b0 : B) (f : Maps[A, a0, B, b0].PMO) (c : Nat)
  (cA : isConn (suc (suc c)) A) (tB : isTrunc (N.plus (suc c) (N.plus (suc c) two)) B) {
  module MA = Maps[A, a0, B, b0] ;
  module O = MA.Over[f] ;
  module LV = O.Levels[c, two, cA, tB] ;
  ev-inj (rho rho' : O.Rel) (e : Id ((b : B) * O.C a0 b) (rho a0) (rho' a0)) : Id O.Rel rho rho' =
    FL.funext A (\ a -> (b : B) * O.C a b) rho rho'
      (conn-elim c A a0 cA (\ a -> Id ((b : B) * O.C a b) (rho a) (rho' a))
         (\ a -> trunc-set ((b : B) * O.C a b) (LV.cell a) (rho a) (rho' a)) e) ;
} ;

-- a Sigma over a contractible type: transport to the centre, injective
module ToCentre (S : U l) (cS : isContr S) (G : S -> U l) {
  toC (x : (s : S) * G s) : G cS.1 = subst S G x.1 cS.1 (sym S cS.1 x.1 (cS.2 x.1)) x.2 ;
  at-centre (x : (s : S) * G s) : Id ((s : S) * G s) x (cS.1, toC x) =
    Sigma-path S G x.1 cS.1 x.2 (toC x) (sym S cS.1 x.1 (cS.2 x.1)) (refl (toC x)) ;
  toC-inj (x x' : (s : S) * G s) (e : Id (G cS.1) (toC x) (toC x')) : Id ((s : S) * G s) x x' =
    transH (at-centre x) (transH (apH (\ y -> (cS.1, y)) e) (symH (at-centre x'))) ;
} ;

-- the invariant before forgetting the pointing, and the action of defects
-- (doc/h4.pdf, "The invariant", "The action of defects", Lemma 8), over
-- f0 = 0 : PMO, for which D a0 b0 f0 p is f0 by definition
module Defect (A : U l) (a0 : A) (B : U l) (b0 : B) (c : Nat)
  (cA : isConn (suc (suc c)) A) (tB : isTrunc (N.plus (suc c) (N.plus (suc c) two)) B) {
  module MA = Maps[A, a0, B, b0] ;
  f0 : MA.PMO = ptconst (Id A a0 a0) (refl a0) (Id B b0 b0) (refl b0) ;
  module O = MA.Over[f0] ;
  module LV = O.Levels[c, two, cA, tB] ;
  d0 (p : Id A a0 a0) : Id (U l) (Id MA.PMO f0 (MA.D a0 b0 f0.1 p)) (Id MA.PMO f0 f0) = refl (Id MA.PMO f0 f0) ;
  -- defects and their action on cells
  Df : U l = (p : Id A a0 a0) -> Id MA.PMO f0 f0 ;
  act (phi : Df) (v : (b : B) * O.C a0 b) : (b : B) * O.C a0 b =
    (v.1, (v.2.1, \ p -> trans MA.PMO f0 f0 (MA.D a0 v.1 v.2.1 p) (phi p) (v.2.2 p))) ;
  G1-act (phi : Df) (bq : LV.Sing) (y : LV.G1 bq) : LV.G1 bq =
    (y.1, (y.2.1, \ p -> trans MA.PMO f0 f0 (MA.D a0 bq.1 y.1 p) (phi p) (y.2.2 p))) ;
  subst-act (phi : Df) (bq : LV.Sing) (y : LV.G1 bq) : (bq' : LV.Sing) (e : Id LV.Sing bq bq') ->
    Id (LV.G1 bq') (subst LV.Sing LV.G1 bq bq' e (G1-act phi bq y)) (G1-act phi bq' (subst LV.Sing LV.G1 bq bq' e y)) =
    \ bq' e -> idJ LV.Sing bq (\ bq1 e1 -> Id (LV.G1 bq1) (subst LV.Sing LV.G1 bq bq1 e1 (G1-act phi bq y)) (G1-act phi bq1 (subst LV.Sing LV.G1 bq bq1 e1 y)))
      (refl (G1-act phi bq y)) bq' e ;
  module T1 = ToCentre[LV.Sing, sing B b0, LV.G1] ;
  module T2 = ToCentre[LV.Sing2, singL MA.PMO f0, LV.G2] ;
  X1-act (phi : Df) (x : LV.X1) : LV.X1 = (x.1, \ p -> trans MA.PMO f0 f0 (MA.D a0 b0 x.1.1 p) (phi p) (x.2 p)) ;
  -- the cells after the two contractions, as defects (the pointing forgotten)
  pre (x : LV.X1) : Df = \ p -> (T2.toC (LV.s3 x)).1 p ;
  inv (v : (b : B) * O.C a0 b) : Df = pre (LV.s2 (T1.toC (LV.s1 v))) ;
  -- the path of the contraction of Sing2
  omega (x : LV.X1) : Id MA.PMO f0 x.1 =
    trans MA.PMO f0 (MA.D a0 b0 x.1.1 (refl a0)) x.1 (x.2 (refl a0)) (sym MA.PMO x.1 (MA.D a0 b0 x.1.1 (refl a0)) (MA.E x.1)) ;
  pre-gen (p : Id A a0 a0) (hs : MA.PMO) (w : Id MA.PMO f0 hs) : (y : LV.G2 (hs, w)) ->
    Id (Id MA.PMO f0 f0) ((T2.toC ((hs, w), y)).1 p)
      (trans MA.PMO f0 (MA.D a0 b0 hs.1 p) f0 (y.1 p) (sym MA.PMO f0 (MA.D a0 b0 hs.1 p) (ap MA.PMO MA.PMO (\ h -> MA.D a0 b0 h.1 p) f0 hs w))) =
    idJ MA.PMO f0 (\ hs1 w1 -> (y : LV.G2 (hs1, w1)) ->
        Id (Id MA.PMO f0 f0) ((T2.toC ((hs1, w1), y)).1 p)
          (trans MA.PMO f0 (MA.D a0 b0 hs1.1 p) f0 (y.1 p) (sym MA.PMO f0 (MA.D a0 b0 hs1.1 p) (ap MA.PMO MA.PMO (\ h -> MA.D a0 b0 h.1 p) f0 hs1 w1))))
      (\ y -> refl (y.1 p)) hs w ;
  pre-formula (x : LV.X1) (p : Id A a0 a0) :
    Id (Id MA.PMO f0 f0) (pre x p)
      (trans MA.PMO f0 (MA.D a0 b0 x.1.1 p) f0 (x.2 p) (sym MA.PMO f0 (MA.D a0 b0 x.1.1 p) (ap MA.PMO MA.PMO (\ h -> MA.D a0 b0 h.1 p) f0 x.1 (omega x)))) =
    pre-gen p x.1 (omega x) (LV.s3 x).2 ;
  -- Lemma 8 (equivariance), for a defect with phi refl = refl
  omega-act (phi : Df) (pr : Id (Id MA.PMO f0 f0) (phi (refl a0)) (refl f0)) (x : LV.X1) :
    Id (Id MA.PMO f0 x.1) (omega (X1-act phi x)) (omega x) =
    transH (apH (\ z -> trans MA.PMO f0 (MA.D a0 b0 x.1.1 (refl a0)) x.1 (trans MA.PMO f0 f0 (MA.D a0 b0 x.1.1 (refl a0)) z (x.2 (refl a0)))
                          (sym MA.PMO x.1 (MA.D a0 b0 x.1.1 (refl a0)) (MA.E x.1))) pr)
           (apH (\ z -> trans MA.PMO f0 (MA.D a0 b0 x.1.1 (refl a0)) x.1 z (sym MA.PMO x.1 (MA.D a0 b0 x.1.1 (refl a0)) (MA.E x.1)))
              (trans-refl-l MA.PMO f0 (MA.D a0 b0 x.1.1 (refl a0)) (x.2 (refl a0)))) ;
  pre-act (phi : Df) (pr : Id (Id MA.PMO f0 f0) (phi (refl a0)) (refl f0)) (x : LV.X1) (p : Id A a0 a0) :
    Id (Id MA.PMO f0 f0) (pre (X1-act phi x) p) (trans MA.PMO f0 f0 f0 (phi p) (pre x p)) = calc (Id MA.PMO f0 f0) {
    pre (X1-act phi x) p
      =< pre-formula (X1-act phi x) p >
    trans MA.PMO f0 (MA.D a0 b0 x.1.1 p) f0 (trans MA.PMO f0 f0 (MA.D a0 b0 x.1.1 p) (phi p) (x.2 p))
      (sym MA.PMO f0 (MA.D a0 b0 x.1.1 p) (ap MA.PMO MA.PMO (\ h -> MA.D a0 b0 h.1 p) f0 x.1 (omega (X1-act phi x))))
      =< apH (\ z -> trans MA.PMO f0 (MA.D a0 b0 x.1.1 p) f0 (trans MA.PMO f0 f0 (MA.D a0 b0 x.1.1 p) (phi p) (x.2 p))
                       (sym MA.PMO f0 (MA.D a0 b0 x.1.1 p) (ap MA.PMO MA.PMO (\ h -> MA.D a0 b0 h.1 p) f0 x.1 z))) (omega-act phi pr x) >
    trans MA.PMO f0 (MA.D a0 b0 x.1.1 p) f0 (trans MA.PMO f0 f0 (MA.D a0 b0 x.1.1 p) (phi p) (x.2 p))
      (sym MA.PMO f0 (MA.D a0 b0 x.1.1 p) (ap MA.PMO MA.PMO (\ h -> MA.D a0 b0 h.1 p) f0 x.1 (omega x)))
      =< Groupoid[l].tassoc MA.PMO f0 f0 (MA.D a0 b0 x.1.1 p) (phi p) (x.2 p) f0
           (sym MA.PMO f0 (MA.D a0 b0 x.1.1 p) (ap MA.PMO MA.PMO (\ h -> MA.D a0 b0 h.1 p) f0 x.1 (omega x))) >
    trans MA.PMO f0 f0 f0 (phi p) (trans MA.PMO f0 (MA.D a0 b0 x.1.1 p) f0 (x.2 p)
      (sym MA.PMO f0 (MA.D a0 b0 x.1.1 p) (ap MA.PMO MA.PMO (\ h -> MA.D a0 b0 h.1 p) f0 x.1 (omega x))))
      =< apH (trans MA.PMO f0 f0 f0 (phi p)) (symH (pre-formula x p)) >
    trans MA.PMO f0 f0 f0 (phi p) (pre x p) } ;
  inv-act (phi : Df) (pr : Id (Id MA.PMO f0 f0) (phi (refl a0)) (refl f0)) (v : (b : B) * O.C a0 b) (p : Id A a0 a0) :
    Id (Id MA.PMO f0 f0) (inv (act phi v) p) (trans MA.PMO f0 f0 f0 (phi p) (inv v p)) =
    transH (apH (\ z -> pre (LV.s2 z) p)
              (subst-act phi (LV.s1 v).1 (LV.s1 v).2 (sing B b0).1 (sym LV.Sing (sing B b0).1 (LV.s1 v).1 ((sing B b0).2 (LV.s1 v).1))))
           (pre-act phi pr (LV.s2 (T1.toC (LV.s1 v))) p) ;
} ;

-- the defect of a diagonal (doc/h4.pdf, Lemma 9, Construction 10, Proposition 11)
module Diag (A : U l) (a0 : A) (B : U l) (b0 : B) (n : Nat)
  (cA : isConn (suc (suc n)) A) (tB : isTrunc (N.plus (suc n) (N.plus (suc n) two)) B) {
  module DF = Defect[A, a0, B, b0, n, cA, tB] ;
  module MA = DF.MA ;
  module SE = Section[A, a0, B, b0, DF.f0] ;
  M : U l = PtMap A a0 B b0 ;
  m0 : M = ptconst A a0 B b0 ;
  module MC = Maps[A, a0, M, m0] ;
  lam0 : Id MA.PMO (MA.loop m0) DF.f0 = loop-const A a0 B b0 ;
  -- the diagonal of a bipointed map, pointed by the pointing of c a0
  diag (c : PtMap A a0 M m0) : M = (\ x -> (c.1 x).1 x, (c.1 a0).2) ;
  -- Lemma 9: Kf of the diagonal is Kf of c a, by J (the map c a varies in the motive)
  kf-diag (c : PtMap A a0 M m0) (a : A) (p : Id A a a0) :
    Id (Id B ((c.1 a).1 a) b0) (MA.Kf (diag c).1 (diag c).2 a p) (MA.Kf (c.1 a).1 (c.1 a).2 a p) =
    idJR A a0 (\ a1 p1 -> Id (Id B ((c.1 a1).1 a1) b0) (MA.Kf (diag c).1 (diag c).2 a1 p1) (MA.Kf (c.1 a1).1 (c.1 a1).2 a1 p1))
      (refl (c.1 a0).2) a p ;
  kd (c : PtMap A a0 M m0) (a : A) : Id (Id A a a0 -> Id B ((c.1 a).1 a) b0) (MA.Kf (diag c).1 (diag c).2 a) (MA.Kf (c.1 a).1 (c.1 a).2 a) =
    FL.funext (Id A a a0) (\ p -> Id B ((c.1 a).1 a) b0) (MA.Kf (diag c).1 (diag c).2 a) (MA.Kf (c.1 a).1 (c.1 a).2 a) (kf-diag c a) ;
  -- the canonical multiplicativity of loop m
  mu (m : M) (a : A) (p : Id A a a0) : Id MA.PMO (MA.loop m) (MA.D a (m.1 a) (MA.Kf m.1 m.2 a) p) =
    idJR A a0 (\ a1 p1 -> Id MA.PMO (MA.loop m) (MA.D a1 (m.1 a1) (MA.Kf m.1 m.2 a1) p1)) (refl (MA.loop m)) a p ;
  cell-mu (m : M) (w : Id MA.PMO DF.f0 (MA.loop m)) (a : A) (p : Id A a a0) :
    Id (Id MA.PMO DF.f0 (MA.D a (m.1 a) (MA.Kf m.1 m.2 a) p)) (SE.cell (m, w) a p) (trans MA.PMO DF.f0 (MA.loop m) (MA.D a (m.1 a) (MA.Kf m.1 m.2 a) p) w (mu m a p)) =
    idJR A a0 (\ a1 p1 -> Id (Id MA.PMO DF.f0 (MA.D a1 (m.1 a1) (MA.Kf m.1 m.2 a1) p1)) (SE.cell (m, w) a1 p1) (trans MA.PMO DF.f0 (MA.loop m) (MA.D a1 (m.1 a1) (MA.Kf m.1 m.2 a1) p1) w (mu m a1 p1)))
      (refl w) a p ;
  -- the trivialisation of loop m by a path m = 0
  triv (m : M) (e : Id M m m0) : Id MA.PMO (MA.loop m) DF.f0 = trans MA.PMO (MA.loop m) (MA.loop m0) DF.f0 (ap M MA.PMO MA.loop m m0 e) lam0 ;
  -- Construction 10
  R (c : PtMap A a0 M m0) (a : A) (p : Id A a a0) : Id MA.PMO DF.f0 (MA.D a ((c.1 a).1 a) (MA.Kf (diag c).1 (diag c).2 a) p) =
    trans MA.PMO DF.f0 (MA.loop (c.1 a)) (MA.D a ((c.1 a).1 a) (MA.Kf (diag c).1 (diag c).2 a) p)
      (sym MA.PMO (MA.loop (c.1 a)) DF.f0 (triv (c.1 a) (MC.Kf c.1 c.2 a p)))
      (trans MA.PMO (MA.loop (c.1 a)) (MA.D a ((c.1 a).1 a) (MA.Kf (c.1 a).1 (c.1 a).2 a) p) (MA.D a ((c.1 a).1 a) (MA.Kf (diag c).1 (diag c).2 a) p)
         (mu (c.1 a) a p)
         (ap (Id A a a0 -> Id B ((c.1 a).1 a) b0) MA.PMO (\ h -> MA.D a ((c.1 a).1 a) h p)
            (MA.Kf (c.1 a).1 (c.1 a).2 a) (MA.Kf (diag c).1 (diag c).2 a)
            (sym (Id A a a0 -> Id B ((c.1 a).1 a) b0) (MA.Kf (diag c).1 (diag c).2 a) (MA.Kf (c.1 a).1 (c.1 a).2 a) (kd c a)))) ;
  wc (c : PtMap A a0 M m0) : Id MA.PMO DF.f0 (MA.loop (diag c)) = R c a0 (refl a0) ;
  dprime (c : PtMap A a0 M m0) : DF.O.Unloop = (diag c, wc c) ;
  -- Proposition 11 (i): the cell of the diagonal is R, by J
  cell-R (c : PtMap A a0 M m0) (a : A) (p : Id A a a0) :
    Id (Id MA.PMO DF.f0 (MA.D a ((c.1 a).1 a) (MA.Kf (diag c).1 (diag c).2 a) p)) (SE.cell (dprime c) a p) (R c a p) =
    idJR A a0 (\ a1 p1 -> Id (Id MA.PMO DF.f0 (MA.D a1 ((c.1 a1).1 a1) (MA.Kf (diag c).1 (diag c).2 a1) p1)) (SE.cell (dprime c) a1 p1) (R c a1 p1))
      (refl (wc c)) a p ;
  -- Proposition 11 (ii)-(iv)
  phi-c (c : PtMap A a0 M m0) : DF.Df = \ p ->
    trans MA.PMO DF.f0 (MA.loop (c.1 a0)) DF.f0 (sym MA.PMO (MA.loop (c.1 a0)) DF.f0 (triv (c.1 a0) (MC.Kf c.1 c.2 a0 p))) (triv (c.1 a0) c.2) ;
  phi-c-refl (c : PtMap A a0 M m0) : Id (Id MA.PMO DF.f0 DF.f0) (phi-c c (refl a0)) (refl DF.f0) =
    trans-sym-l MA.PMO (MA.loop (c.1 a0)) DF.f0 (triv (c.1 a0) c.2) ;
  wm (c : PtMap A a0 M m0) : Id MA.PMO DF.f0 (MA.loop (c.1 a0)) = sym MA.PMO (MA.loop (c.1 a0)) DF.f0 (triv (c.1 a0) c.2) ;
  v00 : (b : B) * DF.O.C a0 b = SE.sec (m0, sym MA.PMO (MA.loop m0) DF.f0 (triv m0 (refl m0))) a0 ;
  v-m (m : M) (e : Id M m m0) : Id ((b : B) * DF.O.C a0 b) (SE.sec (m, sym MA.PMO (MA.loop m) DF.f0 (triv m e)) a0) v00 =
    idJR M m0 (\ m1 e1 -> Id ((b : B) * DF.O.C a0 b) (SE.sec (m1, sym MA.PMO (MA.loop m1) DF.f0 (triv m1 e1)) a0) v00) (refl v00) m e ;
  -- transport of cells along a path of h
  subst-cells (b : B) (h : Id A a0 a0 -> Id B b b0) : (h' : Id A a0 a0 -> Id B b b0) (e : Id (Id A a0 a0 -> Id B b b0) h h')
    (k : (p : Id A a0 a0) -> Id MA.PMO DF.f0 (MA.D a0 b h p)) ->
    Id ((p : Id A a0 a0) -> Id MA.PMO DF.f0 (MA.D a0 b h' p))
      (subst (Id A a0 a0 -> Id B b b0) (\ h1 -> (p : Id A a0 a0) -> Id MA.PMO DF.f0 (MA.D a0 b h1 p)) h h' e k)
      (\ p -> trans MA.PMO DF.f0 (MA.D a0 b h p) (MA.D a0 b h' p) (k p) (ap (Id A a0 a0 -> Id B b b0) MA.PMO (\ h1 -> MA.D a0 b h1 p) h h' e)) =
    \ h' e k -> idJ (Id A a0 a0 -> Id B b b0) h (\ h1 e1 ->
        Id ((p : Id A a0 a0) -> Id MA.PMO DF.f0 (MA.D a0 b h1 p))
          (subst (Id A a0 a0 -> Id B b b0) (\ h2 -> (p : Id A a0 a0) -> Id MA.PMO DF.f0 (MA.D a0 b h2 p)) h h1 e1 k)
          (\ p -> trans MA.PMO DF.f0 (MA.D a0 b h p) (MA.D a0 b h1 p) (k p) (ap (Id A a0 a0 -> Id B b b0) MA.PMO (\ h2 -> MA.D a0 b h2 p) h h1 e1)))
      (refl k) h' e ;
  -- two cancellations
  cancel-uv (X : U l) (x y z w : X) (s : Id X x y) (m : Id X y z) (u : Id X z w) (v : Id X w z) (uv : Id (Id X z z) (trans X z w z u v) (refl z)) :
    Id (Id X x z) (trans X x w z (trans X x y w s (trans X y z w m u)) v) (trans X x y z s m) =
    transH (Groupoid[l].tassoc X x y w s (trans X y z w m u) z v)
      (apH (trans X x y z s) (transH (Groupoid[l].tassoc X y z w m u z v) (apH (trans X y z z m) uv))) ;
  cancel-Y (X : U l) (x y w z : X) (s : Id X x y) (t : Id X y w) (m : Id X y z) :
    Id (Id X x z) (trans X x w z (trans X x y w s t) (trans X w y z (sym X y w t) m)) (trans X x y z s m) =
    transH (Groupoid[l].tassoc X x y w s t z (trans X w y z (sym X y w t) m)) (apH (trans X x y z s) (Fibres[l].trans-cancel' X y w z t m)) ;
  ap-sym-cancel (X Y : U l) (g : X -> Y) (x : X) : (y : X) (e : Id X x y) ->
    Id (Id Y (g y) (g y)) (trans Y (g y) (g x) (g y) (ap X Y g y x (sym X x y e)) (ap X Y g x y e)) (refl (g y)) =
    \ y e -> idJ X x (\ y1 e1 -> Id (Id Y (g y1) (g y1)) (trans Y (g y1) (g x) (g y1) (ap X Y g y1 x (sym X x y1 e1)) (ap X Y g x y1 e1)) (refl (g y1)))
      (refl (refl (g x))) y e ;
  ev-diag (c : PtMap A a0 M m0) :
    Id ((b : B) * DF.O.C a0 b) (SE.sec (dprime c) a0) (DF.act (phi-c c) (SE.sec (c.1 a0, wm c) a0)) =
    apH (\ y -> ((c.1 a0).1 a0, y))
      (Sigma-path (Id A a0 a0 -> Id B ((c.1 a0).1 a0) b0) (\ h -> (p : Id A a0 a0) -> Id MA.PMO DF.f0 (MA.D a0 ((c.1 a0).1 a0) h p))
         (MA.Kf (diag c).1 (diag c).2 a0) (MA.Kf (c.1 a0).1 (c.1 a0).2 a0)
         (SE.cell (dprime c) a0) (\ p -> trans MA.PMO DF.f0 DF.f0 (MA.D a0 ((c.1 a0).1 a0) (MA.Kf (c.1 a0).1 (c.1 a0).2 a0) p) (phi-c c p) (SE.cell (c.1 a0, wm c) a0 p))
         (kd c a0)
         (transH (subst-cells ((c.1 a0).1 a0) (MA.Kf (diag c).1 (diag c).2 a0) (MA.Kf (c.1 a0).1 (c.1 a0).2 a0) (kd c a0) (SE.cell (dprime c) a0))
            (FL.funext (Id A a0 a0) (\ p -> Id MA.PMO DF.f0 (MA.D a0 ((c.1 a0).1 a0) (MA.Kf (c.1 a0).1 (c.1 a0).2 a0) p))
               (\ p -> trans MA.PMO DF.f0 (MA.D a0 ((c.1 a0).1 a0) (MA.Kf (diag c).1 (diag c).2 a0) p) (MA.D a0 ((c.1 a0).1 a0) (MA.Kf (c.1 a0).1 (c.1 a0).2 a0) p)
                          (SE.cell (dprime c) a0 p)
                          (ap (Id A a0 a0 -> Id B ((c.1 a0).1 a0) b0) MA.PMO (\ h1 -> MA.D a0 ((c.1 a0).1 a0) h1 p) (MA.Kf (diag c).1 (diag c).2 a0) (MA.Kf (c.1 a0).1 (c.1 a0).2 a0) (kd c a0)))
               (\ p -> trans MA.PMO DF.f0 DF.f0 (MA.D a0 ((c.1 a0).1 a0) (MA.Kf (c.1 a0).1 (c.1 a0).2 a0) p) (phi-c c p) (SE.cell (c.1 a0, wm c) a0 p))
               (\ p -> calc (Id MA.PMO DF.f0 (MA.D a0 ((c.1 a0).1 a0) (MA.Kf (c.1 a0).1 (c.1 a0).2 a0) p)) {
                  trans MA.PMO DF.f0 (MA.D a0 ((c.1 a0).1 a0) (MA.Kf (diag c).1 (diag c).2 a0) p) (MA.D a0 ((c.1 a0).1 a0) (MA.Kf (c.1 a0).1 (c.1 a0).2 a0) p)
                    (SE.cell (dprime c) a0 p)
                    (ap (Id A a0 a0 -> Id B ((c.1 a0).1 a0) b0) MA.PMO (\ h1 -> MA.D a0 ((c.1 a0).1 a0) h1 p) (MA.Kf (diag c).1 (diag c).2 a0) (MA.Kf (c.1 a0).1 (c.1 a0).2 a0) (kd c a0))
                    =< apH (\ z -> trans MA.PMO DF.f0 (MA.D a0 ((c.1 a0).1 a0) (MA.Kf (diag c).1 (diag c).2 a0) p) (MA.D a0 ((c.1 a0).1 a0) (MA.Kf (c.1 a0).1 (c.1 a0).2 a0) p) z
                              (ap (Id A a0 a0 -> Id B ((c.1 a0).1 a0) b0) MA.PMO (\ h1 -> MA.D a0 ((c.1 a0).1 a0) h1 p) (MA.Kf (diag c).1 (diag c).2 a0) (MA.Kf (c.1 a0).1 (c.1 a0).2 a0) (kd c a0)))
                           (cell-R c a0 p) >
                  trans MA.PMO DF.f0 (MA.D a0 ((c.1 a0).1 a0) (MA.Kf (diag c).1 (diag c).2 a0) p) (MA.D a0 ((c.1 a0).1 a0) (MA.Kf (c.1 a0).1 (c.1 a0).2 a0) p)
                    (R c a0 p)
                    (ap (Id A a0 a0 -> Id B ((c.1 a0).1 a0) b0) MA.PMO (\ h1 -> MA.D a0 ((c.1 a0).1 a0) h1 p) (MA.Kf (diag c).1 (diag c).2 a0) (MA.Kf (c.1 a0).1 (c.1 a0).2 a0) (kd c a0))
                    =< cancel-uv MA.PMO DF.f0 (MA.loop (c.1 a0)) (MA.D a0 ((c.1 a0).1 a0) (MA.Kf (c.1 a0).1 (c.1 a0).2 a0) p) (MA.D a0 ((c.1 a0).1 a0) (MA.Kf (diag c).1 (diag c).2 a0) p)
                         (sym MA.PMO (MA.loop (c.1 a0)) DF.f0 (triv (c.1 a0) (MC.Kf c.1 c.2 a0 p)))
                         (mu (c.1 a0) a0 p)
                         (ap (Id A a0 a0 -> Id B ((c.1 a0).1 a0) b0) MA.PMO (\ h1 -> MA.D a0 ((c.1 a0).1 a0) h1 p) (MA.Kf (c.1 a0).1 (c.1 a0).2 a0) (MA.Kf (diag c).1 (diag c).2 a0)
                            (sym (Id A a0 a0 -> Id B ((c.1 a0).1 a0) b0) (MA.Kf (diag c).1 (diag c).2 a0) (MA.Kf (c.1 a0).1 (c.1 a0).2 a0) (kd c a0)))
                         (ap (Id A a0 a0 -> Id B ((c.1 a0).1 a0) b0) MA.PMO (\ h1 -> MA.D a0 ((c.1 a0).1 a0) h1 p) (MA.Kf (diag c).1 (diag c).2 a0) (MA.Kf (c.1 a0).1 (c.1 a0).2 a0) (kd c a0))
                         (ap-sym-cancel (Id A a0 a0 -> Id B ((c.1 a0).1 a0) b0) MA.PMO (\ h1 -> MA.D a0 ((c.1 a0).1 a0) h1 p) (MA.Kf (diag c).1 (diag c).2 a0) (MA.Kf (c.1 a0).1 (c.1 a0).2 a0) (kd c a0)) >
                  trans MA.PMO DF.f0 (MA.loop (c.1 a0)) (MA.D a0 ((c.1 a0).1 a0) (MA.Kf (c.1 a0).1 (c.1 a0).2 a0) p)
                    (sym MA.PMO (MA.loop (c.1 a0)) DF.f0 (triv (c.1 a0) (MC.Kf c.1 c.2 a0 p))) (mu (c.1 a0) a0 p)
                    =< symH (cancel-Y MA.PMO DF.f0 (MA.loop (c.1 a0)) DF.f0 (MA.D a0 ((c.1 a0).1 a0) (MA.Kf (c.1 a0).1 (c.1 a0).2 a0) p)
                              (sym MA.PMO (MA.loop (c.1 a0)) DF.f0 (triv (c.1 a0) (MC.Kf c.1 c.2 a0 p))) (triv (c.1 a0) c.2) (mu (c.1 a0) a0 p)) >
                  trans MA.PMO DF.f0 DF.f0 (MA.D a0 ((c.1 a0).1 a0) (MA.Kf (c.1 a0).1 (c.1 a0).2 a0) p) (phi-c c p)
                    (trans MA.PMO DF.f0 (MA.loop (c.1 a0)) (MA.D a0 ((c.1 a0).1 a0) (MA.Kf (c.1 a0).1 (c.1 a0).2 a0) p) (wm c) (mu (c.1 a0) a0 p))
                    =< apH (trans MA.PMO DF.f0 DF.f0 (MA.D a0 ((c.1 a0).1 a0) (MA.Kf (c.1 a0).1 (c.1 a0).2 a0) p) (phi-c c p)) (symH (cell-mu (c.1 a0) (wm c) a0 p)) >
                  trans MA.PMO DF.f0 DF.f0 (MA.D a0 ((c.1 a0).1 a0) (MA.Kf (c.1 a0).1 (c.1 a0).2 a0) p) (phi-c c p) (SE.cell (c.1 a0, wm c) a0 p) })))) ;
  -- Proposition 11: the invariant of a diagonal is its defect times a constant
  ev-diag-v00 (c : PtMap A a0 M m0) : Id ((b : B) * DF.O.C a0 b) (SE.sec (dprime c) a0) (DF.act (phi-c c) v00) =
    transH (ev-diag c) (apH (DF.act (phi-c c)) (v-m (c.1 a0) c.2)) ;
  inv-diag (c : PtMap A a0 M m0) (p : Id A a0 a0) :
    Id (Id MA.PMO DF.f0 DF.f0) (DF.inv (SE.sec (dprime c) a0) p) (trans MA.PMO DF.f0 DF.f0 DF.f0 (phi-c c p) (DF.inv v00 p)) =
    transH (apH (\ v -> DF.inv v p) (ev-diag-v00 c)) (DF.inv-act (phi-c c) (phi-c-refl c) v00 p) ;
} ;

-- Lemma 2: pointing irrelevance for maps out of K(Z,1), and out of Omega K(Z,2),
-- into a pointed type whose loops commute (conjugation is then trivial)
module PICircle (W : U l) (w0 : W)
  (comm : (u v : Id W w0 w0) -> Id (Id W w0 w0) (trans W w0 w0 w0 u v) (trans W w0 w0 w0 v u)) {
  module C = CP.Circle[W] ;
  module LC = LoopConj[l] ;
  conj-ab (d u : Id W w0 w0) : Id (Id W w0 w0) (LC.conj W w0 w0 d u) u =
    transH (apH (trans W w0 w0 w0 (sym W w0 w0 d)) (comm u d)) (trans-cancel W w0 w0 w0 d u) ;
  pi-k1 (k : C.Z1.K1 -> W) (z z' : Id W (k C.Z1.k0) w0) : Id (PtMap C.Z1.K1 C.Z1.k0 W w0) (k, z) (k, z') =
    transH (symH ((C.pointed-equiv w0).2.ret-eq (k, z)))
      (transH (apH (C.pointed-equiv w0).2.ret
         (transH (C.evPt-conj w0 (k, z)) (symH (transH (C.evPt-conj w0 (k, z'))
           (transH (apH (\ r -> LC.conj W (k C.Z1.k0) w0 r (ap C.Z1.K1 W k C.Z1.k0 C.Z1.k0 C.g))
                       (symH (Fibres[l].trans-cancel' W (k C.Z1.k0) w0 w0 z z')))
             (transH (LC.conj-trans W (k C.Z1.k0) w0 z (ap C.Z1.K1 W k C.Z1.k0 C.Z1.k0 C.g) w0 (trans W w0 (k C.Z1.k0) w0 (sym W (k C.Z1.k0) w0 z) z'))
                     (conj-ab (trans W w0 (k C.Z1.k0) w0 (sym W (k C.Z1.k0) w0 z) z') (LC.conj W (k C.Z1.k0) w0 z (ap C.Z1.K1 W k C.Z1.k0 C.Z1.k0 C.g)))))))))
         ((C.pointed-equiv w0).2.ret-eq (k, z'))) ;
  -- through e1 : Omega K(Z,2) ~pt K(Z,1)
  OK : U l = Id KZ2 kz2 kz2 ;
  back (F : PtMap OK (refl kz2) W w0) : Id (PtMap OK (refl kz2) W w0) F
      (ptcomp OK (refl kz2) C.Z1.K1 C.Z1.k0 W w0 CupSquare[l].e1.1 (ptcomp C.Z1.K1 C.Z1.k0 OK (refl kz2) W w0 CupSquare[l].e1inv F)) =
    transH (symH (Fibres[l].ptcomp-idl OK (refl kz2) W w0 F))
      (transH (apH (\ H -> ptcomp OK (refl kz2) OK (refl kz2) W w0 H F) (symH (pt-inv-l OK (refl kz2) C.Z1.K1 C.Z1.k0 CupSquare[l].e1)))
         (ptcomp-assoc OK (refl kz2) C.Z1.K1 C.Z1.k0 OK (refl kz2) W w0 CupSquare[l].e1.1 CupSquare[l].e1inv F)) ;
  pi-omega (k : OK -> W) (z z' : Id W (k (refl kz2)) w0) : Id (PtMap OK (refl kz2) W w0) (k, z) (k, z') =
    transH (back (k, z))
      (transH (apH (ptcomp OK (refl kz2) C.Z1.K1 C.Z1.k0 W w0 CupSquare[l].e1.1)
                 (pi-k1 (\ x -> k (CupSquare[l].e1inv.1 x))
                    (trans W (k (CupSquare[l].e1inv.1 C.Z1.k0)) (k (refl kz2)) w0 (ap OK W k (CupSquare[l].e1inv.1 C.Z1.k0) (refl kz2) CupSquare[l].e1inv.2) z)
                    (trans W (k (CupSquare[l].e1inv.1 C.Z1.k0)) (k (refl kz2)) w0 (ap OK W k (CupSquare[l].e1inv.1 C.Z1.k0) (refl kz2) CupSquare[l].e1inv.2) z')))
         (symH (back (k, z')))) ;
  -- pointed maps with pointwise equal underlying maps are equal
  pi-omega-fun (k : OK -> W) (z : Id W (k (refl kz2)) w0) : (k' : OK -> W) (e : Id (OK -> W) k k') (z' : Id W (k' (refl kz2)) w0) ->
    Id (PtMap OK (refl kz2) W w0) (k, z) (k', z') =
    \ k' e -> idJ (OK -> W) k (\ k1 e1 -> (z' : Id W (k1 (refl kz2)) w0) -> Id (PtMap OK (refl kz2) W w0) (k, z) (k1, z')) (pi-omega k z) k' e ;
} ;

-- re-pointing a loop space: (Omega Z, refl) ~pt (z0 = z0, s), q |-> q . s
repoint (Z : U l) (z0 : Z) (s : Id Z z0 z0) : PtEquiv (Id Z z0 z0) (refl z0) (Id Z z0 z0) s =
  ((\ q -> trans Z z0 z0 z0 q s, trans-refl-l Z z0 z0 s),
   qinv (Id Z z0 z0) (Id Z z0 z0) (\ q -> trans Z z0 z0 z0 q s) (\ q -> trans Z z0 z0 z0 q (sym Z z0 z0 s))
     (\ q -> Groupoid[l].cancel-r' Z z0 z0 z0 q s)
     (\ q -> transH (Groupoid[l].tassoc Z z0 z0 z0 q s z0 (sym Z z0 z0 s))
               (apH (trans Z z0 z0 z0 q) (Groupoid[l].trans-sym-r Z z0 z0 s)))) ;

-- Theorem A for Y = K(B,4): the invariant Theta is injective
module DiagAt (Gb : Ab) {
  module A = KK[Zab] ;
  module B = KK[Gb] ;
  module DG = Diag[KZ2, kz2, B.K four, B.pt four, suc zero, A.conn (suc zero), B.trunc three] ;
  module DF = DG.DF ;
  module SE = DG.SE ;
  module LV = DF.LV ;
  module RE = RelEval[KZ2, kz2, B.K four, B.pt four, DF.f0, suc zero, A.conn (suc zero), B.trunc three] ;
  PMO : U l = DF.MA.PMO ;
  -- the base point of the pointed sections
  pt0 : Id PMO DF.f0 DF.f0 = trans PMO DF.f0 DF.f0 DF.f0 (refl DF.f0) (DF.MA.E DF.f0) ;
  module AB = EH[l].Abelian[PMO, DF.f0, Id PMO DF.f0 DF.f0, pt0, repoint PMO DF.f0 pt0] ;
  module PI = PICircle[Id PMO DF.f0 DF.f0, pt0, AB.comm] ;
  Theta (u : DF.O.Unloop) : DF.Df = DF.inv (SE.sec u kz2) ;
  pre-inj (x x' : LV.X1) (e : (p : Id KZ2 kz2 kz2) -> Id (Id PMO DF.f0 DF.f0) (DF.pre x p) (DF.pre x' p)) : Id LV.X1 x x' =
    apH LV.r3 (DF.T2.toC-inj (LV.s3 x) (LV.s3 x')
      (PI.pi-omega-fun (DF.T2.toC (LV.s3 x)).1 (DF.T2.toC (LV.s3 x)).2 (DF.T2.toC (LV.s3 x')).1
         (FL.funext (Id KZ2 kz2 kz2) (\ p -> Id PMO DF.f0 DF.f0) (DF.T2.toC (LV.s3 x)).1 (DF.T2.toC (LV.s3 x')).1 e)
         (DF.T2.toC (LV.s3 x')).2)) ;
  inv-inj (v v' : (b : B.K four) * DF.O.C kz2 b) (e : (p : Id KZ2 kz2 kz2) -> Id (Id PMO DF.f0 DF.f0) (DF.inv v p) (DF.inv v' p)) :
    Id ((b : B.K four) * DF.O.C kz2 b) v v' =
    apH LV.r1 (DF.T1.toC-inj (LV.s1 v) (LV.s1 v') (apH LV.r2 (pre-inj (LV.s2 (DF.T1.toC (LV.s1 v))) (LV.s2 (DF.T1.toC (LV.s1 v'))) e))) ;
  theta-inj (u u' : DF.O.Unloop) (e : (p : Id KZ2 kz2 kz2) -> Id (Id PMO DF.f0 DF.f0) (Theta u p) (Theta u' p)) : Id DF.O.Unloop u u' =
    SE.sec-inj u u' (RE.ev-inj (SE.sec u) (SE.sec u') (inv-inj (SE.sec u kz2) (SE.sec u' kz2) e)) ;
  ------------------------------------------------------------------
  -- Lemma 3 (lifting along L^ = (loop, lam0) : M ->pt PMO, whose fibres are sets)
  M : U l = DG.M ;
  m0 : M = DG.m0 ;
  Lh : PtMap M m0 PMO DF.f0 = (DF.MA.loop, DG.lam0) ;
  Gc (c : PtMap KZ2 kz2 M m0) : PtMap KZ2 kz2 PMO DF.f0 = ptcomp KZ2 kz2 M m0 PMO DF.f0 c Lh ;
  module CL = H4Classes[l].ClassesAt[Gb] ;
  fib-set (g : PMO) : isTrunc two ((m : M) * Id PMO (DF.MA.loop m) g) =
    retract-trunc two ((m : M) * Id PMO (DF.MA.loop m) g) (DF.MA.Over[g].Unloop)
      (\ w -> (w.1, sym PMO (DF.MA.loop w.1) g w.2)) (\ w -> (w.1, sym PMO g (DF.MA.loop w.1) w.2))
      (\ w -> apH (\ q -> (w.1, q)) (Groupoid[l].sym-sym PMO (DF.MA.loop w.1) g w.2))
      (set-trunc DF.MA.Over[g].Unloop (CL.unloop-set g)) ;
  -- in a fibre of loop, the second component along a path
  fibpt (g : PMO) (u : (m : M) * Id PMO (DF.MA.loop m) g) : (v : (m : M) * Id PMO (DF.MA.loop m) g) (w : Id ((m : M) * Id PMO (DF.MA.loop m) g) u v) ->
    Id (Id PMO (DF.MA.loop u.1) g) u.2
      (trans PMO (DF.MA.loop u.1) (DF.MA.loop v.1) g (ap M PMO DF.MA.loop u.1 v.1 (ap ((m : M) * Id PMO (DF.MA.loop m) g) M (\ y -> y.1) u v w)) v.2) =
    \ v w -> idJ ((m : M) * Id PMO (DF.MA.loop m) g) u (\ v1 w1 -> Id (Id PMO (DF.MA.loop u.1) g) u.2
        (trans PMO (DF.MA.loop u.1) (DF.MA.loop v1.1) g (ap M PMO DF.MA.loop u.1 v1.1 (ap ((m : M) * Id PMO (DF.MA.loop m) g) M (\ y -> y.1) u v1 w1)) v1.2))
      (sym (Id PMO (DF.MA.loop u.1) g) (trans PMO (DF.MA.loop u.1) (DF.MA.loop u.1) g (refl (DF.MA.loop u.1)) u.2) u.2 (trans-refl-l PMO (DF.MA.loop u.1) g u.2)) v w ;
  module Lift (G : PtMap KZ2 kz2 PMO DF.f0) {
    P (x : KZ2) : U l = (m : M) * Id PMO (DF.MA.loop m) (G.1 x) ;
    ppt : P kz2 = (m0, trans PMO (DF.MA.loop m0) DF.f0 (G.1 kz2) DG.lam0 (sym PMO (G.1 kz2) DF.f0 G.2)) ;
    contr : isContr (PtSec KZ2 kz2 P ppt) =
      lemma4 zero (suc (suc zero)) KZ2 kz2 (A.conn (suc zero)) P (\ x -> fib-set (G.1 x)) ppt ;
    back (s : PtSec KZ2 kz2 P ppt) : PtMap KZ2 kz2 M m0 = (\ x -> (s.1 x).1, ap (P kz2) M (\ y -> y.1) (s.1 kz2) ppt s.2) ;
    back-lifts (s : PtSec KZ2 kz2 P ppt) : Id (PtMap KZ2 kz2 PMO DF.f0) (Gc (back s)) G =
      ptmap-path KZ2 kz2 PMO DF.f0 (\ x -> DF.MA.loop (s.1 x).1) G.1 (Gc (back s)).2 G.2 (\ x -> (s.1 x).2)
        (symH (transH (apH (\ h -> trans PMO (DF.MA.loop (s.1 kz2).1) (G.1 kz2) DF.f0 h G.2) (fibpt (G.1 kz2) (s.1 kz2) ppt s.2))
          (transH (Groupoid[l].tassoc PMO (DF.MA.loop (s.1 kz2).1) (DF.MA.loop m0) (G.1 kz2)
                     (ap M PMO DF.MA.loop (s.1 kz2).1 m0 (ap (P kz2) M (\ y -> y.1) (s.1 kz2) ppt s.2)) ppt.2 DF.f0 G.2)
                  (apH (trans PMO (DF.MA.loop (s.1 kz2).1) (DF.MA.loop m0) DF.f0 (ap M PMO DF.MA.loop (s.1 kz2).1 m0 (ap (P kz2) M (\ y -> y.1) (s.1 kz2) ppt s.2)))
                     (Groupoid[l].cancel-r' PMO (DF.MA.loop m0) (G.1 kz2) DF.f0 DG.lam0 G.2))))) ;
    lift : PtMap KZ2 kz2 M m0 = back contr.1 ;
  } ;
  -- the canonical section of a lift
  sub-eq (m : M) (e : Id M m m0) :
    Id (Id PMO (DF.MA.loop m0) (DF.MA.loop m)) (subst M (\ m1 -> Id PMO (DF.MA.loop m1) (DF.MA.loop m)) m m0 e (refl (DF.MA.loop m)))
      (trans PMO (DF.MA.loop m0) DF.f0 (DF.MA.loop m) DG.lam0 (sym PMO (DF.MA.loop m) DF.f0 (DG.triv m e))) =
    idJR M m0 (\ m1 e1 -> Id (Id PMO (DF.MA.loop m0) (DF.MA.loop m1)) (subst M (\ m2 -> Id PMO (DF.MA.loop m2) (DF.MA.loop m1)) m1 m0 e1 (refl (DF.MA.loop m1)))
        (trans PMO (DF.MA.loop m0) DF.f0 (DF.MA.loop m1) DG.lam0 (sym PMO (DF.MA.loop m1) DF.f0 (DG.triv m1 e1))))
      (symH (transH (apH (\ z -> trans PMO (DF.MA.loop m0) DF.f0 (DF.MA.loop m0) DG.lam0 (sym PMO (DF.MA.loop m0) DF.f0 z))
                       (trans-refl-l PMO (DF.MA.loop m0) DF.f0 DG.lam0))
                    (Groupoid[l].trans-sym-r PMO (DF.MA.loop m0) DF.f0 DG.lam0))) m e ;
  sc (c : PtMap KZ2 kz2 M m0) : PtSec KZ2 kz2 Lift[Gc c].P Lift[Gc c].ppt =
    (\ x -> (c.1 x, refl (DF.MA.loop (c.1 x))),
     Sigma-path M (\ m -> Id PMO (DF.MA.loop m) (DF.MA.loop (c.1 kz2))) (c.1 kz2) m0 (refl (DF.MA.loop (c.1 kz2))) Lift[Gc c].ppt.2 c.2 (sub-eq (c.1 kz2) c.2)) ;
  back-sc (c : PtMap KZ2 kz2 M m0) : Id (PtMap KZ2 kz2 M m0) (Lift[Gc c].back (sc c)) c =
    apH (\ e -> (c.1, e)) (Fibres[l].fst-Sigma-path M (\ m -> Id PMO (DF.MA.loop m) (DF.MA.loop (c.1 kz2))) (c.1 kz2) m0
      (refl (DF.MA.loop (c.1 kz2))) Lift[Gc c].ppt.2 c.2 (sub-eq (c.1 kz2) c.2)) ;
  back-tr (G : PtMap KZ2 kz2 PMO DF.f0) (s : PtSec KZ2 kz2 Lift[G].P Lift[G].ppt) : (G' : PtMap KZ2 kz2 PMO DF.f0) (e : Id (PtMap KZ2 kz2 PMO DF.f0) G G') ->
    Id (PtMap KZ2 kz2 M m0) (Lift[G'].back (subst (PtMap KZ2 kz2 PMO DF.f0) (\ G1 -> PtSec KZ2 kz2 Lift[G1].P Lift[G1].ppt) G G' e s)) (Lift[G].back s) =
    \ G' e -> idJ (PtMap KZ2 kz2 PMO DF.f0) G (\ G1 e1 ->
        Id (PtMap KZ2 kz2 M m0) (Lift[G1].back (subst (PtMap KZ2 kz2 PMO DF.f0) (\ G2 -> PtSec KZ2 kz2 Lift[G2].P Lift[G2].ppt) G G1 e1 s)) (Lift[G].back s))
      (refl (Lift[G].back s)) G' e ;
  lift-unique (c c' : PtMap KZ2 kz2 M m0) (e : Id (PtMap KZ2 kz2 PMO DF.f0) (Gc c') (Gc c)) : Id (PtMap KZ2 kz2 M m0) c c' =
    transH (symH (back-sc c))
      (transH (apH Lift[Gc c].back (pathC (PtSec KZ2 kz2 Lift[Gc c].P Lift[Gc c].ppt) Lift[Gc c].contr (sc c)
                  (subst (PtMap KZ2 kz2 PMO DF.f0) (\ G1 -> PtSec KZ2 kz2 Lift[G1].P Lift[G1].ppt) (Gc c') (Gc c) e (sc c'))))
         (transH (back-tr (Gc c') (sc c') (Gc c) e) (back-sc c'))) ;
  ------------------------------------------------------------------
  -- Lemma 12: the defect of c is the inverse of the looping of c ; L^
  module MP = Maps[KZ2, kz2, PMO, DF.f0] ;
  OK : U l = Id KZ2 kz2 kz2 ;
  kf-comp (c : PtMap KZ2 kz2 M m0) (a : KZ2) (q : Id KZ2 a kz2) :
    Id (Id PMO (DF.MA.loop (c.1 a)) DF.f0) (MP.Kf (Gc c).1 (Gc c).2 a q) (DG.triv (c.1 a) (DG.MC.Kf c.1 c.2 a q)) =
    idJR KZ2 kz2 (\ a1 q1 -> Id (Id PMO (DF.MA.loop (c.1 a1)) DF.f0) (MP.Kf (Gc c).1 (Gc c).2 a1 q1) (DG.triv (c.1 a1) (DG.MC.Kf c.1 c.2 a1 q1)))
      (refl (Gc c).2) a q ;
  phi-loop (c : PtMap KZ2 kz2 M m0) (p : OK) :
    Id (Id PMO DF.f0 DF.f0) (DG.phi-c c p) (sym PMO DF.f0 DF.f0 ((MP.loop (Gc c)).1 p)) =
    symH (transH (apH (sym PMO DF.f0 DF.f0)
                   (apH (trans PMO DF.f0 (DF.MA.loop (c.1 kz2)) DF.f0 (sym PMO (DF.MA.loop (c.1 kz2)) DF.f0 (Gc c).2))
                      (transH (apH (MP.Kf (Gc c).1 (Gc c).2 kz2) (trans-refl-l KZ2 kz2 kz2 p)) (kf-comp c kz2 p))))
            (transH (Groupoid[l].sym-trans PMO DF.f0 (DF.MA.loop (c.1 kz2)) DF.f0 (sym PMO (DF.MA.loop (c.1 kz2)) DF.f0 (Gc c).2)
                        (DG.triv (c.1 kz2) (DG.MC.Kf c.1 c.2 kz2 p)))
                    (apH (trans PMO DF.f0 (DF.MA.loop (c.1 kz2)) DF.f0 (sym PMO (DF.MA.loop (c.1 kz2)) DF.f0 (DG.triv (c.1 kz2) (DG.MC.Kf c.1 c.2 kz2 p))))
                       (Groupoid[l].sym-sym PMO (DF.MA.loop (c.1 kz2)) DF.f0 (Gc c).2)))) ;
  ------------------------------------------------------------------
  -- Theorem A
  zz : DF.Df = DF.inv DG.v00 ;
  theta-diag (c : PtMap KZ2 kz2 M m0) (p : OK) :
    Id (Id PMO DF.f0 DF.f0) (Theta (DG.dprime c) p) (trans PMO DF.f0 DF.f0 DF.f0 (DG.phi-c c p) (zz p)) = DG.inv-diag c p ;
  module EHP = EH[l].EH[PMO, DF.f0] ;
  module PI0 = PICircle[Id PMO DF.f0 DF.f0, refl DF.f0, EHP.eh] ;
  tPMO : isTrunc four PMO = LV.tPMO ;
  rcancel (X : U l) (x y z : X) (k : Id X x y) (q : Id X y z) : Id (Id X x y) (trans X x z y (trans X x y z k q) (sym X y z q)) k =
    transH (Groupoid[l].tassoc X x y z k q y (sym X y z q)) (apH (trans X x y y k) (Groupoid[l].trans-sym-r X y z q)) ;
  phi-eq (c c' : PtMap KZ2 kz2 M m0) (e : Id DF.O.Unloop (DG.dprime c) (DG.dprime c')) (p : OK) :
    Id (Id PMO DF.f0 DF.f0) (DG.phi-c c p) (DG.phi-c c' p) =
    transH (symH (rcancel PMO DF.f0 DF.f0 DF.f0 (DG.phi-c c p) (zz p)))
      (transH (apH (\ t -> trans PMO DF.f0 DF.f0 DF.f0 t (sym PMO DF.f0 DF.f0 (zz p)))
                 (transH (symH (theta-diag c p)) (transH (apH (\ u -> Theta u p) e) (theta-diag c' p))))
         (rcancel PMO DF.f0 DF.f0 DF.f0 (DG.phi-c c' p) (zz p))) ;
  loop-eq (c c' : PtMap KZ2 kz2 M m0) (e : (p : OK) -> Id (Id PMO DF.f0 DF.f0) (DG.phi-c c p) (DG.phi-c c' p)) (p : OK) :
    Id (Id PMO DF.f0 DF.f0) ((MP.loop (Gc c)).1 p) ((MP.loop (Gc c')).1 p) =
    transH (symH (Groupoid[l].sym-sym PMO DF.f0 DF.f0 ((MP.loop (Gc c)).1 p)))
      (transH (apH (sym PMO DF.f0 DF.f0) (transH (symH (phi-loop c p)) (transH (e p) (phi-loop c' p))))
         (Groupoid[l].sym-sym PMO DF.f0 DF.f0 ((MP.loop (Gc c')).1 p))) ;
  -- c is determined by its defect
  phi-inj (c c' : PtMap KZ2 kz2 M m0) (e : (p : OK) -> Id (Id PMO DF.f0 DF.f0) (DG.phi-c c p) (DG.phi-c c' p)) : Id (PtMap KZ2 kz2 M m0) c c' =
    lift-unique c c' (symH (unique-loop (suc zero) KZ2 kz2 PMO DF.f0 (A.conn (suc zero)) tPMO (Gc c) (Gc c')
      (PI0.pi-omega-fun (MP.loop (Gc c)).1 (MP.loop (Gc c)).2 (MP.loop (Gc c')).1
         (FL.funext OK (\ p -> Id PMO DF.f0 DF.f0) (MP.loop (Gc c)).1 (MP.loop (Gc c')).1 (loop-eq c c' e))
         (MP.loop (Gc c')).2))) ;
  diag-inj (c c' : PtMap KZ2 kz2 M m0) (e : Id DF.O.Unloop (DG.dprime c) (DG.dprime c')) : Id (PtMap KZ2 kz2 M m0) c c' =
    phi-inj c c' (phi-eq c c' e) ;
  -- every delooping of zero is a diagonal
  theta-pt (u : DF.O.Unloop) : Id (Id PMO DF.f0 DF.f0) (Theta u (refl kz2)) pt0 =
    (DF.T2.toC (LV.s3 (LV.s2 (DF.T1.toC (LV.s1 (SE.sec u kz2)))))).2 ;
  zz-pt : Id (Id PMO DF.f0 DF.f0) (zz (refl kz2)) pt0 = (DF.T2.toC (LV.s3 (LV.s2 (DF.T1.toC (LV.s1 DG.v00))))).2 ;
  psi (u : DF.O.Unloop) : MP.PMO =
    (\ p -> sym PMO DF.f0 DF.f0 (trans PMO DF.f0 DF.f0 DF.f0 (Theta u p) (sym PMO DF.f0 DF.f0 (zz p))),
     transH (apH (\ t -> sym PMO DF.f0 DF.f0 (trans PMO DF.f0 DF.f0 DF.f0 t (sym PMO DF.f0 DF.f0 (zz (refl kz2))))) (theta-pt u))
       (transH (apH (\ t -> sym PMO DF.f0 DF.f0 (trans PMO DF.f0 DF.f0 DF.f0 pt0 (sym PMO DF.f0 DF.f0 t))) zz-pt)
          (apH (sym PMO DF.f0 DF.f0) (Groupoid[l].trans-sym-r PMO DF.f0 DF.f0 pt0)))) ;
  deloop (u : DF.O.Unloop) : MP.Over[psi u].Unloop = (MP.Over[psi u].cor11 (suc zero) (A.conn (suc zero)) tPMO).1 ;
  undiag (u : DF.O.Unloop) : PtMap KZ2 kz2 M m0 = Lift[(deloop u).1].lift ;
  undiag-loop (u : DF.O.Unloop) (p : OK) : Id (Id PMO DF.f0 DF.f0) ((MP.loop (Gc (undiag u))).1 p) ((psi u).1 p) =
    transH (apH (\ H -> (MP.loop H).1 p) (Lift[(deloop u).1].back-lifts Lift[(deloop u).1].contr.1))
      (apH (\ H -> H.1 p) (symH (deloop u).2)) ;
  diag-surj (u : DF.O.Unloop) : Id DF.O.Unloop (DG.dprime (undiag u)) u =
    theta-inj (DG.dprime (undiag u)) u (\ p -> transH (theta-diag (undiag u) p)
      (transH (apH (\ t -> trans PMO DF.f0 DF.f0 DF.f0 t (zz p))
                 (transH (phi-loop (undiag u) p)
                    (transH (apH (sym PMO DF.f0 DF.f0) (undiag-loop u p))
                       (Groupoid[l].sym-sym PMO DF.f0 DF.f0 (trans PMO DF.f0 DF.f0 DF.f0 (Theta u p) (sym PMO DF.f0 DF.f0 (zz p)))))))
         (Groupoid[l].cancel-r' PMO DF.f0 DF.f0 DF.f0 (Theta u p) (zz p)))) ;
} ;
