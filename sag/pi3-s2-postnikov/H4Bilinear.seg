-- (H4), part III: the bilinear classification (doc/h4.pdf, Section 5, Theorem B).
--   Lev        e_m, j = e_2 o Omega e_3 and K(h, m) at the types of the text,
--              locked after their "by definition" lemmas and loopK, so that
--              no later step opens the constructions of K(h, m) or e_m
--   H2         Lemma 16: g |-> K(g,1) and g |-> K(g,2) are bijections
--              Hom(A, B) -> Map_*(K(A,1), K(B,1)), Map_*(K(A,2), K(B,2)):
--              level 1 by the band (inverse F |-> band o loop F o unband, a
--              homomorphism by loop-mult), level 2 by loopK 1 and unique-loop
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ; open HLevels[l] ; open Connected[l] ;
open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ; open Retracts[l] ; open Torsor[l] ; open LoopCalc[l] ;
open EMMaps[l] ; open HomotopyClasses[l] ; open SphereUniversal[l] ; open PostnikovRealization[l] ; open KZ2Cohomology[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module CP = CircleProperty[l] ;

-- The constructions of e_m and K(h, m) at the types of the text, locked after
-- their characterising equations (doc/h4.pdf, Section 5):
--   eA m, eB m : Omega K(-, m+1) ~pt K(-, m)   (KK.e; e_0 is the band);
--   jA, jB = e_2 o Omega e_3 : Omega^2 K(-,4) ~pt K(-,2)  (CupSquare.iota-eq is jA, iota its inverse);
--   conj m F = e_A ; F ; e_B^-1                  (KMap.conj, by definition);
--   K h m = K(h, m),  K h 0 = h,  loop K(h, m+1) = conj m (K h m)  (KMap.loopK).
-- e is only used as a pointed equivalence (pt-inv-l / pt-inv-r) and K(h, m)
-- only through loopK, so both are locked.
module Lev (Ga Gb : Ab) {
  module A = KK[Ga] ;
  module B = KK[Gb] ;
  eA (m : Nat) : PtEquiv (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (A.K m) (A.pt m) = A.e m ;
  eB (m : Nat) : PtEquiv (Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m))) (refl (B.pt (suc m))) (B.K m) (B.pt m) = B.e m ;
  eAi (m : Nat) : PtMap (A.K m) (A.pt m) (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) =
    (pt-inv (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (A.K m) (A.pt m) (eA m)).1 ;
  eBi (m : Nat) : PtMap (B.K m) (B.pt m) (Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m))) (refl (B.pt (suc m))) =
    (pt-inv (Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m))) (refl (B.pt (suc m))) (B.K m) (B.pt m) (eB m)).1 ;
  jA : PtEquiv (Id (Id (A.K four) (A.pt four) (A.pt four)) (refl (A.pt four)) (refl (A.pt four))) (refl (refl (A.pt four))) (A.K two) (A.pt two) =
    pt-comp (Id (Id (A.K four) (A.pt four) (A.pt four)) (refl (A.pt four)) (refl (A.pt four))) (refl (refl (A.pt four))) (Id (A.K three) (A.pt three) (A.pt three)) (refl (A.pt three)) (A.K two) (A.pt two)
      (LoopIso[l].loopPE (Id (A.K four) (A.pt four) (A.pt four)) (refl (A.pt four)) (A.K three) (A.pt three) (eA three)) (eA two) ;
  jB : PtEquiv (Id (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)) (refl (B.pt four))) (refl (refl (B.pt four))) (B.K two) (B.pt two) =
    pt-comp (Id (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)) (refl (B.pt four))) (refl (refl (B.pt four))) (Id (B.K three) (B.pt three) (B.pt three)) (refl (B.pt three)) (B.K two) (B.pt two)
      (LoopIso[l].loopPE (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)) (B.K three) (B.pt three) (eB three)) (eB two) ;
  -- the composite as written in CupSquare.iota-eq (for Ga = Z)
  jA-def : Id (PtEquiv (Id (Id (A.K four) (A.pt four) (A.pt four)) (refl (A.pt four)) (refl (A.pt four))) (refl (refl (A.pt four))) (A.K two) (A.pt two))
      (pt-comp (Id (Id (A.K four) (A.pt four) (A.pt four)) (refl (A.pt four)) (refl (A.pt four))) (refl (refl (A.pt four))) (Id (A.K three) (A.pt three) (A.pt three)) (refl (A.pt three)) (A.K two) (A.pt two)
        (LoopIso[l].loopPE (Id (A.K four) (A.pt four) (A.pt four)) (refl (A.pt four)) (A.K three) (A.pt three) (A.e three)) (A.e two)) jA =
    refl jA ;
  conj (m : Nat) (F : PtMap (A.K m) (A.pt m) (B.K m) (B.pt m)) : Maps[A.K (suc m), A.pt (suc m), B.K (suc m), B.pt (suc m)].PMO =
    ptcomp (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (B.K m) (B.pt m) (Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m))) (refl (B.pt (suc m)))
      (ptcomp (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (A.K m) (A.pt m) (B.K m) (B.pt m) (eA m).1 F)
      (eBi m) ;
  -- conjugation by e_0 is unband o - o band, by definition (e_0 is the band)
  conj-zero (F : PtMap Ga.A Ga.o Gb.A Gb.o) (p : Id A.E1.K1 A.E1.k0 A.E1.k0) :
    Id (Id B.E1.K1 B.E1.k0 B.E1.k0) ((conj zero F).1 p) (B.E1.unband B.E1.k0 (F.1 (A.E1.band A.E1.k0 p))) =
    refl ((conj zero F).1 p) ;
  -- conj is KMap.conj, by definition
  conj-def (h : Hom Ga Gb) (m : Nat) (F : PtMap (A.K m) (A.pt m) (B.K m) (B.pt m)) :
    Id (Maps[A.K (suc m), A.pt (suc m), B.K (suc m), B.pt (suc m)].PMO) (KMap[Ga, Gb, h].conj m F) (conj m F) =
    calc (Maps[A.K (suc m), A.pt (suc m), B.K (suc m), B.pt (suc m)].PMO) {
      KMap[Ga, Gb, h].conj m F
        =< refl (KMap[Ga, Gb, h].conj m F) >
      ptcomp (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (B.K m) (B.pt m) (Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m))) (refl (B.pt (suc m)))
        (ptcomp (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (A.K m) (A.pt m) (B.K m) (B.pt m) (eA m).1 F)
        (pt-inv (Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m))) (refl (B.pt (suc m))) (B.K m) (B.pt m) (eB m)).1
        =< refl (conj m F) >
      conj m F } ;
  K (h : Hom Ga Gb) (m : Nat) : PtMap (A.K m) (A.pt m) (B.K m) (B.pt m) = KMap[Ga, Gb, h].K m ;
  K-def (h : Hom Ga Gb) (m : Nat) : Id (PtMap (A.K m) (A.pt m) (B.K m) (B.pt m)) (KMap[Ga, Gb, h].K m) (K h m) = refl (K h m) ;
  K-zero (h : Hom Ga Gb) : Id (PtMap Ga.A Ga.o Gb.A Gb.o) (K h zero) (h.1, hom-unit Ga Gb h) = refl (K h zero) ;
  loopK (h : Hom Ga Gb) (m : Nat) : Id (Maps[A.K (suc m), A.pt (suc m), B.K (suc m), B.pt (suc m)].PMO)
      (Maps[A.K (suc m), A.pt (suc m), B.K (suc m), B.pt (suc m)].loop (K h (suc m))) (conj m (K h m)) =
    transH (KMap[Ga, Gb, h].loopK m) (conj-def h m (K h m)) ;
  -- eA, eB are the e_m of KK, by definition
  eA-def (m : Nat) : Id (PtEquiv (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (A.K m) (A.pt m)) (A.e m) (eA m) = refl (eA m) ;
  eB-def (m : Nat) : Id (PtEquiv (Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m))) (refl (B.pt (suc m))) (B.K m) (B.pt m)) (B.e m) (eB m) = refl (eB m) ;
  opaque eA ; opaque eB ; opaque K ;
} ;

-- the named bridge between two locked e_m of the same group C (both are KK[C].e m):
-- e_m of the target of Lev[A,C] is e_m of the source of Lev[C,B]
module Bridge (Ga Gc Gb : Ab) {
  eB-eA (m : Nat) : Id (PtEquiv (Id (KK[Gc].K (suc m)) (KK[Gc].pt (suc m)) (KK[Gc].pt (suc m))) (refl (KK[Gc].pt (suc m))) (KK[Gc].K m) (KK[Gc].pt m))
      (Lev[Ga, Gc].eB m) (Lev[Gc, Gb].eA m) =
    transH (symH (Lev[Ga, Gc].eB-def m)) (Lev[Gc, Gb].eA-def m) ;
} ;

module H2 (Ga Gb : Ab) {
  module A = KK[Ga] ;
  module B = KK[Gb] ;
  module M1 = Maps[A.K (suc zero), A.pt (suc zero), B.K (suc zero), B.pt (suc zero)] ;
  module M2 = Maps[A.K two, A.pt two, B.K two, B.pt two] ;
  module L = Lev[Ga, Gb] ;
  -- level 1
  unband-hom (x y : Ga.A) : Id (Id A.E1.K1 A.E1.k0 A.E1.k0) (A.E1.unband A.E1.k0 (Ga.add x y))
      (trans A.E1.K1 A.E1.k0 A.E1.k0 A.E1.k0 (A.E1.unband A.E1.k0 x) (A.E1.unband A.E1.k0 y)) =
    A.E1.band-inj A.E1.k0 (A.E1.unband A.E1.k0 (Ga.add x y)) (trans A.E1.K1 A.E1.k0 A.E1.k0 A.E1.k0 (A.E1.unband A.E1.k0 x) (A.E1.unband A.E1.k0 y))
      (transH (A.E1.band-unband A.E1.k0 (Ga.add x y))
        (symH (transH (A.E1.band-hom A.E1.k0 (A.E1.unband A.E1.k0 x) (A.E1.unband A.E1.k0 y))
           (transH (apH (\ a -> Ga.add a (A.E1.band A.E1.k0 (A.E1.unband A.E1.k0 y))) (A.E1.band-unband A.E1.k0 x))
                   (apH (Ga.add x) (A.E1.band-unband A.E1.k0 y)))))) ;
  L1 (F : PtMap (A.K (suc zero)) (A.pt (suc zero)) (B.K (suc zero)) (B.pt (suc zero))) (p : Id A.E1.K1 A.E1.k0 A.E1.k0) : Id B.E1.K1 B.E1.k0 B.E1.k0 = (M1.loop F).1 p ;
  hom-of (F : PtMap (A.K (suc zero)) (A.pt (suc zero)) (B.K (suc zero)) (B.pt (suc zero))) : Hom Ga Gb =
    (\ a -> B.E1.band B.E1.k0 (L1 F (A.E1.unband A.E1.k0 a)), \ x y ->
      transH (apH (\ q -> B.E1.band B.E1.k0 (L1 F q)) (unband-hom x y))
        (transH (apH (B.E1.band B.E1.k0) (PiOne[l].Induced[(A.K (suc zero)), A.pt (suc zero), (B.K (suc zero)), B.pt (suc zero), F].loop-mult (A.E1.unband A.E1.k0 x) (A.E1.unband A.E1.k0 y)))
           (B.E1.band-hom B.E1.k0 (L1 F (A.E1.unband A.E1.k0 x)) (L1 F (A.E1.unband A.E1.k0 y))))) ;
  hom-prop (h : Ga.A -> Gb.A) : isProp ((x y : Ga.A) -> Id Gb.A (h (Ga.add x y)) (Gb.add (h x) (h y))) =
    FL.isProp-Pi Ga.A (\ x -> (y : Ga.A) -> Id Gb.A (h (Ga.add x y)) (Gb.add (h x) (h y))) (\ x ->
      FL.isProp-Pi Ga.A (\ y -> Id Gb.A (h (Ga.add x y)) (Gb.add (h x) (h y))) (\ y -> Gb.setA (h (Ga.add x y)) (Gb.add (h x) (h y)))) ;
  -- the looping of K(g,1) is unband o g o band, pointwise
  loop1 (g : Hom Ga Gb) (p : Id A.E1.K1 A.E1.k0 A.E1.k0) : Id (Id B.E1.K1 B.E1.k0 B.E1.k0) (L1 (L.K g (suc zero)) p) (KMap[Ga, Gb, g].c0 p) =
    transH (apH (\ H -> H.1 p) (L.loopK g zero))
      (transH (L.conj-zero (L.K g zero) p) (apH (\ F -> B.E1.unband B.E1.k0 (F.1 (A.E1.band A.E1.k0 p))) (L.K-zero g))) ;
  k1-inj (g g' : Hom Ga Gb) (e : Id (PtMap (A.K (suc zero)) (A.pt (suc zero)) (B.K (suc zero)) (B.pt (suc zero))) (L.K g (suc zero)) (L.K g' (suc zero))) : Id (Hom Ga Gb) g g' =
    Sigma-eq (Ga.A -> Gb.A) (\ h -> (x y : Ga.A) -> Id Gb.A (h (Ga.add x y)) (Gb.add (h x) (h y))) g.1 g'.1 g.2 g'.2
      (FL.funext Ga.A (\ a -> Gb.A) g.1 g'.1 (\ a ->
         transH (apH g.1 (symH (A.E1.band-unband A.E1.k0 a)))
           (transH (symH (B.E1.band-unband B.E1.k0 (g.1 (A.E1.band A.E1.k0 (A.E1.unband A.E1.k0 a)))))
              (transH (apH (B.E1.band B.E1.k0)
                         (transH (symH (loop1 g (A.E1.unband A.E1.k0 a)))
                            (transH (apH (\ F -> L1 F (A.E1.unband A.E1.k0 a)) e) (loop1 g' (A.E1.unband A.E1.k0 a)))))
                 (transH (B.E1.band-unband B.E1.k0 (g'.1 (A.E1.band A.E1.k0 (A.E1.unband A.E1.k0 a))))
                    (apH g'.1 (A.E1.band-unband A.E1.k0 a)))))))
      (hom-prop g'.1) ;
  h1 (F : PtMap (A.K (suc zero)) (A.pt (suc zero)) (B.K (suc zero)) (B.pt (suc zero))) (p : Id A.E1.K1 A.E1.k0 A.E1.k0) :
    Id (Id B.E1.K1 B.E1.k0 B.E1.k0) ((L.conj zero (L.K (hom-of F) zero)).1 p) (L1 F p) =
    transH (L.conj-zero (L.K (hom-of F) zero) p)
    (transH (apH (\ F0 -> B.E1.unband B.E1.k0 (F0.1 (A.E1.band A.E1.k0 p))) (L.K-zero (hom-of F)))
    (transH (B.E1.unband-band B.E1.k0 (L1 F (A.E1.unband A.E1.k0 (A.E1.band A.E1.k0 p))))
      (apH (L1 F) (A.E1.unband-band A.E1.k0 p)))) ;
  k1-surj (F : PtMap (A.K (suc zero)) (A.pt (suc zero)) (B.K (suc zero)) (B.pt (suc zero))) : Id (PtMap (A.K (suc zero)) (A.pt (suc zero)) (B.K (suc zero)) (B.pt (suc zero))) (L.K (hom-of F) (suc zero)) F =
    unique-loop1 zero (A.K (suc zero)) (A.pt (suc zero)) (B.K (suc zero)) (B.pt (suc zero)) (A.conn zero) (B.trunc zero) (L.K (hom-of F) (suc zero)) F
      (transH (L.loopK (hom-of F) zero)
        (ptmap-path (Id A.E1.K1 A.E1.k0 A.E1.k0) (refl A.E1.k0) (Id B.E1.K1 B.E1.k0 B.E1.k0) (refl B.E1.k0)
           (L.conj zero (L.K (hom-of F) zero)).1 (M1.loop F).1
           (L.conj zero (L.K (hom-of F) zero)).2 (M1.loop F).2
           (h1 F)
           (trunc-one-prop (Id (Id B.E1.K1 B.E1.k0 B.E1.k0) ((L.conj zero (L.K (hom-of F) zero)).1 (refl A.E1.k0)) (refl B.E1.k0))
              ((B.trunc zero) B.E1.k0 B.E1.k0 ((L.conj zero (L.K (hom-of F) zero)).1 (refl A.E1.k0)) (refl B.E1.k0))
              (L.conj zero (L.K (hom-of F) zero)).2
              (trans (Id B.E1.K1 B.E1.k0 B.E1.k0) ((L.conj zero (L.K (hom-of F) zero)).1 (refl A.E1.k0)) (L1 F (refl A.E1.k0)) (refl B.E1.k0)
                 (h1 F (refl A.E1.k0)) (M1.loop F).2)))) ;
  -- level 2: conjugation by e_1 is invertible
  unconj (H : M2.PMO) : PtMap (A.K (suc zero)) (A.pt (suc zero)) (B.K (suc zero)) (B.pt (suc zero)) =
    ptcomp (A.K (suc zero)) (A.pt (suc zero)) (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (B.K (suc zero)) (B.pt (suc zero)) (L.eAi (suc zero)) (ptcomp (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (Id (B.K two) (B.pt two) (B.pt two)) (refl (B.pt two)) (B.K (suc zero)) (B.pt (suc zero)) H (L.eB (suc zero)).1) ;
  unconj-conj (F : PtMap (A.K (suc zero)) (A.pt (suc zero)) (B.K (suc zero)) (B.pt (suc zero))) : Id (PtMap (A.K (suc zero)) (A.pt (suc zero)) (B.K (suc zero)) (B.pt (suc zero))) (unconj ((L.conj (suc zero)) F)) F = calc (PtMap (A.K (suc zero)) (A.pt (suc zero)) (B.K (suc zero)) (B.pt (suc zero))) {
    unconj ((L.conj (suc zero)) F)
      =< apH (ptcomp (A.K (suc zero)) (A.pt (suc zero)) (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (B.K (suc zero)) (B.pt (suc zero)) (L.eAi (suc zero)))
           (ptcomp-assoc (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (B.K (suc zero)) (B.pt (suc zero)) (Id (B.K two) (B.pt two) (B.pt two)) (refl (B.pt two)) (B.K (suc zero)) (B.pt (suc zero))
              (ptcomp (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (A.K (suc zero)) (A.pt (suc zero)) (B.K (suc zero)) (B.pt (suc zero)) (L.eA (suc zero)).1 F) (L.eBi (suc zero)) (L.eB (suc zero)).1) >
    ptcomp (A.K (suc zero)) (A.pt (suc zero)) (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (B.K (suc zero)) (B.pt (suc zero)) (L.eAi (suc zero))
      (ptcomp (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (B.K (suc zero)) (B.pt (suc zero)) (B.K (suc zero)) (B.pt (suc zero)) (ptcomp (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (A.K (suc zero)) (A.pt (suc zero)) (B.K (suc zero)) (B.pt (suc zero)) (L.eA (suc zero)).1 F)
         (ptcomp (B.K (suc zero)) (B.pt (suc zero)) (Id (B.K two) (B.pt two) (B.pt two)) (refl (B.pt two)) (B.K (suc zero)) (B.pt (suc zero)) (L.eBi (suc zero)) (L.eB (suc zero)).1))
      =< apH (\ H -> ptcomp (A.K (suc zero)) (A.pt (suc zero)) (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (B.K (suc zero)) (B.pt (suc zero)) (L.eAi (suc zero))
                      (ptcomp (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (B.K (suc zero)) (B.pt (suc zero)) (B.K (suc zero)) (B.pt (suc zero)) (ptcomp (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (A.K (suc zero)) (A.pt (suc zero)) (B.K (suc zero)) (B.pt (suc zero)) (L.eA (suc zero)).1 F) H))
           (pt-inv-r (Id (B.K two) (B.pt two) (B.pt two)) (refl (B.pt two)) (B.K (suc zero)) (B.pt (suc zero)) (L.eB (suc zero))) >
    ptcomp (A.K (suc zero)) (A.pt (suc zero)) (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (B.K (suc zero)) (B.pt (suc zero)) (L.eAi (suc zero))
      (ptcomp (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (B.K (suc zero)) (B.pt (suc zero)) (B.K (suc zero)) (B.pt (suc zero)) (ptcomp (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (A.K (suc zero)) (A.pt (suc zero)) (B.K (suc zero)) (B.pt (suc zero)) (L.eA (suc zero)).1 F)
         (ptid (B.K (suc zero)) (B.pt (suc zero))))
      =< apH (ptcomp (A.K (suc zero)) (A.pt (suc zero)) (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (B.K (suc zero)) (B.pt (suc zero)) (L.eAi (suc zero)))
           (Fibres[l].ptcomp-idr (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (B.K (suc zero)) (B.pt (suc zero)) (ptcomp (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (A.K (suc zero)) (A.pt (suc zero)) (B.K (suc zero)) (B.pt (suc zero)) (L.eA (suc zero)).1 F)) >
    ptcomp (A.K (suc zero)) (A.pt (suc zero)) (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (B.K (suc zero)) (B.pt (suc zero)) (L.eAi (suc zero)) (ptcomp (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (A.K (suc zero)) (A.pt (suc zero)) (B.K (suc zero)) (B.pt (suc zero)) (L.eA (suc zero)).1 F)
      =< symH (ptcomp-assoc (A.K (suc zero)) (A.pt (suc zero)) (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (A.K (suc zero)) (A.pt (suc zero)) (B.K (suc zero)) (B.pt (suc zero)) (L.eAi (suc zero)) (L.eA (suc zero)).1 F) >
    ptcomp (A.K (suc zero)) (A.pt (suc zero)) (A.K (suc zero)) (A.pt (suc zero)) (B.K (suc zero)) (B.pt (suc zero)) (ptcomp (A.K (suc zero)) (A.pt (suc zero)) (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (A.K (suc zero)) (A.pt (suc zero)) (L.eAi (suc zero)) (L.eA (suc zero)).1) F
      =< apH (\ H -> ptcomp (A.K (suc zero)) (A.pt (suc zero)) (A.K (suc zero)) (A.pt (suc zero)) (B.K (suc zero)) (B.pt (suc zero)) H F) (pt-inv-r (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (A.K (suc zero)) (A.pt (suc zero)) (L.eA (suc zero))) >
    ptcomp (A.K (suc zero)) (A.pt (suc zero)) (A.K (suc zero)) (A.pt (suc zero)) (B.K (suc zero)) (B.pt (suc zero)) (ptid (A.K (suc zero)) (A.pt (suc zero))) F
      =< Fibres[l].ptcomp-idl (A.K (suc zero)) (A.pt (suc zero)) (B.K (suc zero)) (B.pt (suc zero)) F >
    F } ;
  conj-unconj (H : M2.PMO) : Id M2.PMO ((L.conj (suc zero)) (unconj H)) H = calc M2.PMO {
    (L.conj (suc zero)) (unconj H)
      =< apH (\ X -> ptcomp (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (B.K (suc zero)) (B.pt (suc zero)) (Id (B.K two) (B.pt two) (B.pt two)) (refl (B.pt two)) X (L.eBi (suc zero)))
           (transH (symH (ptcomp-assoc (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (A.K (suc zero)) (A.pt (suc zero)) (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (B.K (suc zero)) (B.pt (suc zero)) (L.eA (suc zero)).1 (L.eAi (suc zero))
                            (ptcomp (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (Id (B.K two) (B.pt two) (B.pt two)) (refl (B.pt two)) (B.K (suc zero)) (B.pt (suc zero)) H (L.eB (suc zero)).1)))
              (transH (apH (\ X -> ptcomp (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (B.K (suc zero)) (B.pt (suc zero)) X (ptcomp (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (Id (B.K two) (B.pt two) (B.pt two)) (refl (B.pt two)) (B.K (suc zero)) (B.pt (suc zero)) H (L.eB (suc zero)).1))
                         (pt-inv-l (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (A.K (suc zero)) (A.pt (suc zero)) (L.eA (suc zero))))
                 (Fibres[l].ptcomp-idl (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (B.K (suc zero)) (B.pt (suc zero)) (ptcomp (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (Id (B.K two) (B.pt two) (B.pt two)) (refl (B.pt two)) (B.K (suc zero)) (B.pt (suc zero)) H (L.eB (suc zero)).1)))) >
    ptcomp (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (B.K (suc zero)) (B.pt (suc zero)) (Id (B.K two) (B.pt two) (B.pt two)) (refl (B.pt two)) (ptcomp (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (Id (B.K two) (B.pt two) (B.pt two)) (refl (B.pt two)) (B.K (suc zero)) (B.pt (suc zero)) H (L.eB (suc zero)).1) (L.eBi (suc zero))
      =< ptcomp-assoc (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (Id (B.K two) (B.pt two) (B.pt two)) (refl (B.pt two)) (B.K (suc zero)) (B.pt (suc zero)) (Id (B.K two) (B.pt two) (B.pt two)) (refl (B.pt two)) H (L.eB (suc zero)).1 (L.eBi (suc zero)) >
    ptcomp (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (Id (B.K two) (B.pt two) (B.pt two)) (refl (B.pt two)) (Id (B.K two) (B.pt two) (B.pt two)) (refl (B.pt two)) H (ptcomp (Id (B.K two) (B.pt two) (B.pt two)) (refl (B.pt two)) (B.K (suc zero)) (B.pt (suc zero)) (Id (B.K two) (B.pt two) (B.pt two)) (refl (B.pt two)) (L.eB (suc zero)).1 (L.eBi (suc zero)))
      =< apH (ptcomp (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (Id (B.K two) (B.pt two) (B.pt two)) (refl (B.pt two)) (Id (B.K two) (B.pt two) (B.pt two)) (refl (B.pt two)) H) (pt-inv-l (Id (B.K two) (B.pt two) (B.pt two)) (refl (B.pt two)) (B.K (suc zero)) (B.pt (suc zero)) (L.eB (suc zero))) >
    ptcomp (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (Id (B.K two) (B.pt two) (B.pt two)) (refl (B.pt two)) (Id (B.K two) (B.pt two) (B.pt two)) (refl (B.pt two)) H (ptid (Id (B.K two) (B.pt two) (B.pt two)) (refl (B.pt two)))
      =< Fibres[l].ptcomp-idr (Id (A.K two) (A.pt two) (A.pt two)) (refl (A.pt two)) (Id (B.K two) (B.pt two) (B.pt two)) (refl (B.pt two)) H >
    H } ;
  k2-inj (g g' : Hom Ga Gb) (e : Id (PtMap (A.K two) (A.pt two) (B.K two) (B.pt two)) ((L.K g two)) ((L.K g' two))) : Id (Hom Ga Gb) g g' =
    k1-inj g g' (transH (symH (unconj-conj (L.K g (suc zero))))
      (transH (apH unconj (transH (symH (L.loopK g (suc zero))) (transH (apH M2.loop e) (L.loopK g' (suc zero)))))
         (unconj-conj (L.K g' (suc zero))))) ;
  inv2 (F : PtMap (A.K two) (A.pt two) (B.K two) (B.pt two)) : Hom Ga Gb = hom-of (unconj (M2.loop F)) ;
  k2-surj (F : PtMap (A.K two) (A.pt two) (B.K two) (B.pt two)) : Id (PtMap (A.K two) (A.pt two) (B.K two) (B.pt two)) ((L.K (inv2 F) two)) F =
    unique-loop (suc zero) (A.K two) (A.pt two) (B.K two) (B.pt two) (A.conn (suc zero)) (B.trunc (suc zero)) ((L.K (inv2 F) two)) F
      (transH (L.loopK (inv2 F) (suc zero))
         (transH (apH (L.conj (suc zero)) (k1-surj (unconj (M2.loop F)))) (conj-unconj (M2.loop F)))) ;
} ;

-- ap of a conjugate, and ap of evaluation is happly (J)
ap-conj (X Z : U l) (f : X -> Z) (a : X) (u : Id X a a) : (b : X) (p : Id X a b) ->
  Id (Id Z (f b) (f b)) (ap X Z f b b (LoopConj[l].conj X a b p u)) (LoopConj[l].conj Z (f a) (f b) (ap X Z f a b p) (ap X Z f a a u)) =
  \ b p -> idJ X a (\ b1 p1 -> Id (Id Z (f b1) (f b1)) (ap X Z f b1 b1 (LoopConj[l].conj X a b1 p1 u)) (LoopConj[l].conj Z (f a) (f b1) (ap X Z f a b1 p1) (ap X Z f a a u)))
    (transH (apH (ap X Z f a a) (trans-refl-l X a a u)) (symH (trans-refl-l Z (f a) (f a) (ap X Z f a a u)))) b p ;
ap-happly (A : U l) (B : A -> U l) (f : (x : A) -> B x) (x : A) : (g : (x1 : A) -> B x1) (p : Id ((x1 : A) -> B x1) f g) ->
  Id (Id (B x) (f x) (g x)) (ap ((x1 : A) -> B x1) (B x) (\ h -> h x) f g p) (happly A B f g p x) =
  \ g p -> idJ ((x1 : A) -> B x1) f (\ g1 p1 -> Id (Id (B x) (f x) (g1 x)) (ap ((x1 : A) -> B x1) (B x) (\ h -> h x) f g1 p1) (happly A B f g1 p1 x))
    (refl (refl (f x))) g p ;

-- ap of evaluation on a path built by ptmap-path is the homotopy
ap-sigma-path (X : U l) (x0 : X) (Y : U l) (y0 : Y) (k k' : X -> Y) (w : Id Y (k x0) y0) (w' : Id Y (k' x0) y0)
  (H : (x : X) -> Id Y (k x) (k' x)) (q : Id (Id Y (k' x0) y0) (subst (X -> Y) (\ g -> Id Y (g x0) y0) k k' (FL.funext X (\ x -> Y) k k' H) w) w') (x : X) :
  Id (Id Y (k x) (k' x)) (ap (PtMap X x0 Y y0) Y (\ F -> F.1 x) (k, w) (k', w') (Sigma-path (X -> Y) (\ g -> Id Y (g x0) y0) k k' w w' (FL.funext X (\ x1 -> Y) k k' H) q)) (H x) =
  transH (symH (ap-ap (PtMap X x0 Y y0) (X -> Y) Y (\ F -> F.1) (\ h -> h x) (k, w) (k', w') (Sigma-path (X -> Y) (\ g -> Id Y (g x0) y0) k k' w w' (FL.funext X (\ x1 -> Y) k k' H) q)))
    (transH (apH (ap (X -> Y) Y (\ h -> h x) k k')
               (Fibres[l].fst-Sigma-path (X -> Y) (\ g -> Id Y (g x0) y0) k k' w w' (FL.funext X (\ x1 -> Y) k k' H) q))
       (transH (ap-happly X (\ x1 -> Y) k x k' (FL.funext X (\ x1 -> Y) k k' H))
          (apH (\ h -> h x) (FL.happly-funext X (\ x1 -> Y) k k' H)))) ;
ap-ptmap-path (X : U l) (x0 : X) (Y : U l) (y0 : Y) (k k' : X -> Y) (w : Id Y (k x0) y0) (w' : Id Y (k' x0) y0)
  (H : (x : X) -> Id Y (k x) (k' x)) (c : Id (Id Y (k x0) y0) w (trans Y (k x0) (k' x0) y0 (H x0) w')) (x : X) :
  Id (Id Y (k x) (k' x)) (ap (PtMap X x0 Y y0) Y (\ F -> F.1 x) (k, w) (k', w') (ptmap-path X x0 Y y0 k k' w w' H c)) (H x) =
  ap-sigma-path X x0 Y y0 k k' w w' H
    (calc (Id Y (k' x0) y0) {
      subst (X -> Y) (\ g -> Id Y (g x0) y0) k k' (FL.funext X (\ x1 -> Y) k k' H) w
        =< subst-pt X x0 Y y0 k k' (FL.funext X (\ x1 -> Y) k k' H) w >
      trans Y (k' x0) (k x0) y0 (sym Y (k x0) (k' x0) (happly X (\ x1 -> Y) k k' (FL.funext X (\ x1 -> Y) k k' H) x0)) w
        =< ap (Id Y (k x0) (k' x0)) (Id Y (k' x0) y0) (\ e -> trans Y (k' x0) (k x0) y0 (sym Y (k x0) (k' x0) e) w)
             (happly X (\ x1 -> Y) k k' (FL.funext X (\ x1 -> Y) k k' H) x0) (H x0)
             (happly X (\ x1 -> Id Y (k x1) (k' x1)) (happly X (\ x1 -> Y) k k' (FL.funext X (\ x1 -> Y) k k' H)) H
                (FL.happly-funext X (\ x1 -> Y) k k' H) x0) >
      trans Y (k' x0) (k x0) y0 (sym Y (k x0) (k' x0) (H x0)) w
        =< ap (Id Y (k x0) y0) (Id Y (k' x0) y0) (trans Y (k' x0) (k x0) y0 (sym Y (k x0) (k' x0) (H x0)))
             w (trans Y (k x0) (k' x0) y0 (H x0) w') c >
      trans Y (k' x0) (k x0) y0 (sym Y (k x0) (k' x0) (H x0)) (trans Y (k x0) (k' x0) y0 (H x0) w')
        =< trans-cancel Y (k x0) (k' x0) y0 (H x0) w' >
      w' }) x ;

-- the operator E of Theorem B, for one target Y (bracketed as CupSquare.c1bar)
module EDef (Y : U l) (y0 : Y) {
  module CS = CupSquare[l] ;
  module L4 = CS.PtMapLoops[KZ2, kz2, Y, y0] ;
  module LO = CS.PtMapLoops[KZ2, kz2, Id Y y0 y0, refl y0] ;
  module C = CP.Circle[PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)] ;
  module MM = Maps[KZ2, kz2, PtMap KZ2 kz2 Y y0, L4.pt0] ;
  phi (c : PtMap KZ2 kz2 (PtMap KZ2 kz2 Y y0) L4.pt0) : PtMap C.Z1.K1 C.Z1.k0 (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) LO.pt0 =
    ptcomp C.Z1.K1 C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) LO.pt0 CS.e1inv
      (ptcomp (Id KZ2 kz2 kz2) (refl kz2) (Id (PtMap KZ2 kz2 Y y0) L4.pt0 L4.pt0) (refl L4.pt0) (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) LO.pt0 (MM.loop c) L4.ev-pt.1) ;
  E (c : PtMap KZ2 kz2 (PtMap KZ2 kz2 Y y0) L4.pt0) : PtMap KZ2 kz2 (Id (Id Y y0 y0) (refl y0) (refl y0)) (refl (refl y0)) =
    LO.ev (C.evPt LO.pt0 (phi c)) ;
} ;

-- Lemma 15 (naturality of E), pointwise
module ENat (Y : U l) (y0 : Y) (Y' : U l) (y0' : Y') (G : PtMap Y y0 Y' y0') {
  module CS = CupSquare[l] ;
  module L4 = CS.PtMapLoops[KZ2, kz2, Y, y0] ;
  module L4' = CS.PtMapLoops[KZ2, kz2, Y', y0'] ;
  module LO = CS.PtMapLoops[KZ2, kz2, Id Y y0 y0, refl y0] ;
  module LO' = CS.PtMapLoops[KZ2, kz2, Id Y' y0' y0', refl y0'] ;
  module C = CP.Circle[PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)] ;
  module C' = CP.Circle[PtMap KZ2 kz2 (Id Y' y0' y0') (refl y0')] ;
  module LC = LoopConj[l] ;
  OK : U l = Id KZ2 kz2 kz2 ;
  K1 : U l = C.Z1.K1 ;
  k0 : K1 = C.Z1.k0 ;
  M : U l = PtMap KZ2 kz2 Y y0 ;
  M' : U l = PtMap KZ2 kz2 Y' y0' ;
  N : U l = PtMap KZ2 kz2 (Id Y y0 y0) (refl y0) ;
  N' : U l = PtMap KZ2 kz2 (Id Y' y0' y0') (refl y0') ;
  module MM = Maps[KZ2, kz2, M, L4.pt0] ;
  module MM' = Maps[KZ2, kz2, M', L4'.pt0] ;
  module MY = Maps[Y, y0, Y', y0'] ;
  module MO = Maps[Id Y y0 y0, refl y0, Id Y' y0' y0', refl y0'] ;
  -- E, as in EDef for Y and Y'
  phi (c : PtMap KZ2 kz2 M L4.pt0) : PtMap K1 k0 N LO.pt0 = EDef[Y, y0].phi c ;
  phi' (c : PtMap KZ2 kz2 M' L4'.pt0) : PtMap K1 k0 N' LO'.pt0 = EDef[Y', y0'].phi c ;
  E (c : PtMap KZ2 kz2 M L4.pt0) : PtMap KZ2 kz2 (Id (Id Y y0 y0) (refl y0) (refl y0)) (refl (refl y0)) = EDef[Y, y0].E c ;
  E' (c : PtMap KZ2 kz2 M' L4'.pt0) : PtMap KZ2 kz2 (Id (Id Y' y0' y0') (refl y0') (refl y0')) (refl (refl y0')) = EDef[Y', y0'].E c ;
  -- postcomposition with G
  Gs : PtMap M L4.pt0 M' L4'.pt0 = (\ m -> ptcomp KZ2 kz2 Y y0 Y' y0' m G, comp-const-l KZ2 kz2 Y y0 Y' y0' G) ;
  lG : PtMap (Id Y y0 y0) (refl y0) (Id Y' y0' y0') (refl y0') = MY.loop G ;
  -- evaluation at x
  Ex (x : KZ2) : PtMap N LO.pt0 (Id Y y0 y0) (refl y0) = (\ F -> F.1 x, refl (refl y0)) ;
  Ex' (x : KZ2) : PtMap N' LO'.pt0 (Id Y' y0' y0') (refl y0') = (\ F -> F.1 x, refl (refl y0')) ;
  ev-x' (x : KZ2) (P : Id M' L4'.pt0 L4'.pt0) : Id M' L4'.pt0 L4'.pt0 -> Id Y' y0' y0' = \ Q -> ap M' Y' (\ F -> F.1 x) L4'.pt0 L4'.pt0 Q ;
  -- the pointing of Gs, evaluated at x
  gs-x (x : KZ2) : Id (Id Y' (G.1 y0) y0') (ap M' Y' (\ F -> F.1 x) (Gs.1 L4.pt0) L4'.pt0 Gs.2) (trans Y' (G.1 y0) (G.1 y0) y0' (refl (G.1 y0)) G.2) =
    ap-ptmap-path KZ2 kz2 Y' y0' (\ a -> G.1 y0) (\ a -> y0') (trans Y' (G.1 y0) (G.1 y0) y0' (refl (G.1 y0)) G.2) (refl y0')
      (\ a -> trans Y' (G.1 y0) (G.1 y0) y0' (refl (G.1 y0)) G.2) (refl (trans Y' (G.1 y0) (G.1 y0) y0' (refl (G.1 y0)) G.2)) x ;
  module MG = Maps[M, L4.pt0, M', L4'.pt0] ;
  -- looping commutes with postcomposition, pointwise
  nat-pt (P : Id M L4.pt0 L4.pt0) (x : KZ2) :
    Id (Id Y' y0' y0') (ap M' Y' (\ F -> F.1 x) L4'.pt0 L4'.pt0 ((MG.loop Gs).1 P)) (lG.1 (ap M Y (\ F -> F.1 x) L4.pt0 L4.pt0 P)) =
    transH (apH (ap M' Y' (\ F -> F.1 x) L4'.pt0 L4'.pt0) (MG.loop-ap Gs P))
      (transH (ap-conj M' Y' (\ F -> F.1 x) (Gs.1 L4.pt0) (ap M M' Gs.1 L4.pt0 L4.pt0 P) L4'.pt0 Gs.2)
        (transH (apH (\ e -> LC.conj Y' (G.1 y0) y0' e (ap M' Y' (\ F -> F.1 x) (Gs.1 L4.pt0) (Gs.1 L4.pt0) (ap M M' Gs.1 L4.pt0 L4.pt0 P))) (gs-x x))
          (transH (apH (LC.conj Y' (G.1 y0) y0' (trans Y' (G.1 y0) (G.1 y0) y0' (refl (G.1 y0)) G.2))
                     (transH (ap-ap M M' Y' Gs.1 (\ F -> F.1 x) L4.pt0 L4.pt0 P) (symH (ap-ap M Y Y' (\ F -> F.1 x) G.1 L4.pt0 L4.pt0 P))))
            (transH (apH (\ e -> LC.conj Y' (G.1 y0) y0' e (ap Y Y' G.1 y0 y0 (ap M Y (\ F -> F.1 x) L4.pt0 L4.pt0 P))) (trans-refl-l Y' (G.1 y0) y0' G.2))
               (symH (MY.loop-ap G (ap M Y (\ F -> F.1 x) L4.pt0 L4.pt0 P))))))) ;
  A1 (c : PtMap KZ2 kz2 M L4.pt0) (x : KZ2) : PtMap K1 k0 (Id Y' y0' y0') (refl y0') =
    ptcomp K1 k0 N' LO'.pt0 (Id Y' y0' y0') (refl y0') (phi' (ptcomp KZ2 kz2 M L4.pt0 M' L4'.pt0 c Gs)) (Ex' x) ;
  A2 (c : PtMap KZ2 kz2 M L4.pt0) (x : KZ2) : PtMap K1 k0 (Id Y' y0' y0') (refl y0') =
    ptcomp K1 k0 (Id Y y0 y0) (refl y0) (Id Y' y0' y0') (refl y0') (ptcomp K1 k0 N LO.pt0 (Id Y y0 y0) (refl y0) (phi c) (Ex x)) lG ;
  hh (c : PtMap KZ2 kz2 M L4.pt0) (x : KZ2) (k : K1) : Id (Id Y' y0' y0') ((A1 c x).1 k) ((A2 c x).1 k) =
    transH (L4'.ev-ap L4'.pt0 ((MM'.loop (ptcomp KZ2 kz2 M L4.pt0 M' L4'.pt0 c Gs)).1 (CS.e1inv.1 k)) x)
      (transH (apH (ap M' Y' (\ F -> F.1 x) L4'.pt0 L4'.pt0) (apH (\ H -> H.1 (CS.e1inv.1 k)) (loop-comp KZ2 kz2 M L4.pt0 M' L4'.pt0 c Gs)))
        (transH (nat-pt ((MM.loop c).1 (CS.e1inv.1 k)) x)
          (apH lG.1 (symH (L4.ev-ap L4.pt0 ((MM.loop c).1 (CS.e1inv.1 k)) x))))) ;
  module MN = Maps[N, LO.pt0, Id Y y0 y0, refl y0] ;
  module MN' = Maps[N', LO'.pt0, Id Y' y0' y0', refl y0'] ;
  module MK = Maps[K1, k0, N, LO.pt0] ;
  module MK' = Maps[K1, k0, N', LO'.pt0] ;
  module MKY = Maps[K1, k0, Id Y y0 y0, refl y0] ;
  module MKY' = Maps[K1, k0, Id Y' y0' y0', refl y0'] ;
  -- E c at x as a looping
  E-loop (c : PtMap KZ2 kz2 M L4.pt0) (x : KZ2) :
    Id (Id (Id Y y0 y0) (refl y0) (refl y0)) ((E c).1 x) ((MKY.loop (ptcomp K1 k0 N LO.pt0 (Id Y y0 y0) (refl y0) (phi c) (Ex x))).1 C.g) =
    transH (LO.ev-ap LO.pt0 (C.evPt LO.pt0 (phi c)) x)
      (transH (symH (transH (MN.loop-ap (Ex x) (C.evPt LO.pt0 (phi c))) (trans-refl-l (Id Y y0 y0) (refl y0) (refl y0) (ap N (Id Y y0 y0) (\ F -> F.1 x) LO.pt0 LO.pt0 (C.evPt LO.pt0 (phi c))))))
        (transH (apH (MN.loop (Ex x)).1 (C.evPt-loop LO.pt0 (phi c)))
           (symH (apH (\ H -> H.1 C.g) (loop-comp K1 k0 N LO.pt0 (Id Y y0 y0) (refl y0) (phi c) (Ex x)))))) ;
  E'-loop (c : PtMap KZ2 kz2 M' L4'.pt0) (x : KZ2) :
    Id (Id (Id Y' y0' y0') (refl y0') (refl y0')) ((E' c).1 x) ((MKY'.loop (ptcomp K1 k0 N' LO'.pt0 (Id Y' y0' y0') (refl y0') (phi' c) (Ex' x))).1 C'.g) =
    transH (LO'.ev-ap LO'.pt0 (C'.evPt LO'.pt0 (phi' c)) x)
      (transH (symH (transH (MN'.loop-ap (Ex' x) (C'.evPt LO'.pt0 (phi' c))) (trans-refl-l (Id Y' y0' y0') (refl y0') (refl y0') (ap N' (Id Y' y0' y0') (\ F -> F.1 x) LO'.pt0 LO'.pt0 (C'.evPt LO'.pt0 (phi' c))))))
        (transH (apH (MN'.loop (Ex' x)).1 (C'.evPt-loop LO'.pt0 (phi' c)))
           (symH (apH (\ H -> H.1 C'.g) (loop-comp K1 k0 N' LO'.pt0 (Id Y' y0' y0') (refl y0') (phi' c) (Ex' x)))))) ;
  module EHY = EH[l].EH[Y', y0'] ;
  -- the two generators (locked separately) agree
  g-eq : Id (Id K1 k0 k0) C'.g C.g =
    C.Z1.band-inj k0 C'.g C.g (transH (C'.band-g (refl k0)) (symH (C.band-g (refl k0)))) ;
  -- Lemma 15, pointwise: E (c ; Gs) x = loop^2 G (E c x)
  e-nat (c : PtMap KZ2 kz2 M L4.pt0) (x : KZ2) :
    Id (Id (Id Y' y0' y0') (refl y0') (refl y0')) ((E' (ptcomp KZ2 kz2 M L4.pt0 M' L4'.pt0 c Gs)).1 x) ((MO.loop lG).1 ((E c).1 x)) =
    transH (E'-loop (ptcomp KZ2 kz2 M L4.pt0 M' L4'.pt0 c Gs) x)
      (transH (symH (transH (apH (\ u -> LC.conj (Id Y' y0' y0') (refl y0') (refl y0') (LoopConj[l].LoopHomotopy[K1, k0, Id Y' y0' y0', refl y0', A1 c x, A2 c x, hh c x].c) u)
                               (refl ((MKY'.loop (A1 c x)).1 C'.g)))
                 (transH (apH (trans (Id Y' y0' y0') (refl y0') (refl y0') (refl y0') (sym (Id Y' y0' y0') (refl y0') (refl y0') (LoopConj[l].LoopHomotopy[K1, k0, Id Y' y0' y0', refl y0', A1 c x, A2 c x, hh c x].c)))
                            (EHY.eh ((MKY'.loop (A1 c x)).1 C'.g) (LoopConj[l].LoopHomotopy[K1, k0, Id Y' y0' y0', refl y0', A1 c x, A2 c x, hh c x].c)))
                    (trans-cancel (Id Y' y0' y0') (refl y0') (refl y0') (refl y0') (LoopConj[l].LoopHomotopy[K1, k0, Id Y' y0' y0', refl y0', A1 c x, A2 c x, hh c x].c) ((MKY'.loop (A1 c x)).1 C'.g)))))
        (transH (symH (LoopConj[l].LoopHomotopy[K1, k0, Id Y' y0' y0', refl y0', A1 c x, A2 c x, hh c x].loop-homotopy C'.g))
           (transH (apH (MKY'.loop (A2 c x)).1 g-eq)
           (transH (apH (\ H -> H.1 C.g) (loop-comp K1 k0 (Id Y y0 y0) (refl y0) (Id Y' y0' y0') (refl y0') (ptcomp K1 k0 N LO.pt0 (Id Y y0 y0) (refl y0) (phi c) (Ex x)) lG))
              (apH (MO.loop lG).1 (symH (E-loop c x))))))) ;
} ;

-- composition with a pointed equivalence is injective
post-inj (A : U l) (a0 : A) (B : U l) (b0 : B) (C : U l) (c0 : C) (e : PtEquiv B b0 C c0) (F F' : PtMap A a0 B b0)
  (h : Id (PtMap A a0 C c0) (ptcomp A a0 B b0 C c0 F e.1) (ptcomp A a0 B b0 C c0 F' e.1)) : Id (PtMap A a0 B b0) F F' =
  transH (symH (transH (ptcomp-assoc A a0 B b0 C c0 B b0 F e.1 (pt-inv B b0 C c0 e).1)
                  (transH (apH (ptcomp A a0 B b0 B b0 F) (pt-inv-l B b0 C c0 e)) (Fibres[l].ptcomp-idr A a0 B b0 F))))
    (transH (apH (\ H -> ptcomp A a0 C c0 B b0 H (pt-inv B b0 C c0 e).1) h)
       (transH (ptcomp-assoc A a0 B b0 C c0 B b0 F' e.1 (pt-inv B b0 C c0 e).1)
          (transH (apH (ptcomp A a0 B b0 B b0 F') (pt-inv-l B b0 C c0 e)) (Fibres[l].ptcomp-idr A a0 B b0 F')))) ;
pre-inj (A : U l) (a0 : A) (B : U l) (b0 : B) (C : U l) (c0 : C) (e : PtEquiv A a0 B b0) (F F' : PtMap A a0 C c0)
  (h : Id (PtMap B b0 C c0) (ptcomp B b0 A a0 C c0 (pt-inv A a0 B b0 e).1 F) (ptcomp B b0 A a0 C c0 (pt-inv A a0 B b0 e).1 F')) : Id (PtMap A a0 C c0) F F' =
  transH (symH (transH (symH (ptcomp-assoc A a0 B b0 A a0 C c0 e.1 (pt-inv A a0 B b0 e).1 F))
                  (transH (apH (\ H -> ptcomp A a0 A a0 C c0 H F) (pt-inv-l A a0 B b0 e)) (Fibres[l].ptcomp-idl A a0 C c0 F))))
    (transH (apH (ptcomp A a0 B b0 C c0 e.1) h)
       (transH (symH (ptcomp-assoc A a0 B b0 A a0 C c0 e.1 (pt-inv A a0 B b0 e).1 F'))
          (transH (apH (\ H -> ptcomp A a0 A a0 C c0 H F') (pt-inv-l A a0 B b0 e)) (Fibres[l].ptcomp-idl A a0 C c0 F')))) ;

-- Theorem B for Y = K(Z,4), Y' = K(B,4), G = K(g,4)
module BilAt (Gb : Ab) {
  module A = KK[Zab] ;
  module B = KK[Gb] ;
  module CS = CupSquare[l] ;
  module H = H2[Zab, Gb] ;
  module L = Lev[Zab, Gb] ;
  module ED = EDef[B.K four, B.pt four] ;
  M' : U l = PtMap KZ2 kz2 (B.K four) (B.pt four) ;
  c2g (g : Hom Zab Gb) : PtMap KZ2 kz2 M' ED.L4.pt0 = ptcomp KZ2 kz2 (PtMap KZ2 kz2 KZ4 kz4) CS.L4.pt0 M' ED.L4.pt0 CS.c2 ENat[KZ4, kz4, B.K four, B.pt four, L.K g four].Gs ;
  -- the diagonal of c2 ; K(g,4)_* is kappa ; K(g,4), by definition
  diag-c2g (g : Hom Zab Gb) : Id M' (\ x -> ((c2g g).1 x).1 x, ((c2g g).1 kz2).2) (ptcomp KZ2 kz2 KZ4 kz4 (B.K four) (B.pt four) CS.kappa (L.K g four)) =
    refl (ptcomp KZ2 kz2 KZ4 kz4 (B.K four) (B.pt four) CS.kappa (L.K g four)) ;
  -- j_B : Omega^2 K(B,4) -> K(B,2)
  O2B : U l = Id (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)) (refl (B.pt four)) ;
  Theta (c : PtMap KZ2 kz2 M' ED.L4.pt0) : PtMap KZ2 kz2 (B.K two) (B.pt two) =
    ptcomp KZ2 kz2 O2B (refl (refl (B.pt four))) (B.K two) (B.pt two) (ED.E c) L.jB.1 ;
  tM' : isTrunc four M' = cor5-map four two KZ2 kz2 (A.conn (suc zero)) (B.K four) (B.pt four) (B.trunc three) ;
  -- Theta is injective
  theta-inj (c c' : PtMap KZ2 kz2 M' ED.L4.pt0) (e : Id (PtMap KZ2 kz2 (B.K two) (B.pt two)) (Theta c) (Theta c')) :
    Id (PtMap KZ2 kz2 M' ED.L4.pt0) c c' =
    unique-loop (suc zero) KZ2 kz2 M' ED.L4.pt0 (A.conn (suc zero)) tM' c c'
      (post-inj (Id KZ2 kz2 kz2) (refl kz2) (Id M' ED.L4.pt0 ED.L4.pt0) (refl ED.L4.pt0) (PtMap KZ2 kz2 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four))) ED.LO.pt0 ED.L4.ev-pt
         (ED.MM.loop c) (ED.MM.loop c')
         (pre-inj (Id KZ2 kz2 kz2) (refl kz2) ED.C.Z1.K1 ED.C.Z1.k0 (PtMap KZ2 kz2 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four))) ED.LO.pt0 CS.e1
            (ptcomp (Id KZ2 kz2 kz2) (refl kz2) (Id M' ED.L4.pt0 ED.L4.pt0) (refl ED.L4.pt0) (PtMap KZ2 kz2 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four))) ED.LO.pt0 (ED.MM.loop c) ED.L4.ev-pt.1)
            (ptcomp (Id KZ2 kz2 kz2) (refl kz2) (Id M' ED.L4.pt0 ED.L4.pt0) (refl ED.L4.pt0) (PtMap KZ2 kz2 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four))) ED.LO.pt0 (ED.MM.loop c') ED.L4.ev-pt.1)
            (transH (symH ((ED.C.pointed-equiv ED.LO.pt0).2.ret-eq (ED.phi c)))
               (transH (apH (ED.C.pointed-equiv ED.LO.pt0).2.ret
                          (transH (symH (ED.LO.ev-pt.2.ret-eq (ED.C.evPt ED.LO.pt0 (ED.phi c))))
                             (transH (apH ED.LO.ev-pt.2.ret
                                        (post-inj KZ2 kz2 O2B (refl (refl (B.pt four))) (B.K two) (B.pt two) L.jB (ED.E c) (ED.E c') e))
                                (ED.LO.ev-pt.2.ret-eq (ED.C.evPt ED.LO.pt0 (ED.phi c'))))))
                  ((ED.C.pointed-equiv ED.LO.pt0).2.ret-eq (ED.phi c')))))) ;
  -- Lemma 17: Omega^2 K(g,4) followed by j_B is K(g,2) after j_Z, pointwise
  O4Z : U l = Id KZ4 kz4 kz4 ;
  O4B : U l = Id (B.K four) (B.pt four) (B.pt four) ;
  module M3Z = Maps[O4Z, refl kz4, A.K three, A.pt three] ;
  module M3B = Maps[O4B, refl (B.pt four), B.K three, B.pt three] ;
  module M3B' = Maps[B.K three, B.pt three, O4B, refl (B.pt four)] ;
  module M33 = Maps[A.K three, A.pt three, B.K three, B.pt three] ;
  module MO = Maps[O4Z, refl kz4, O4B, refl (B.pt four)] ;
  lG (g : Hom Zab Gb) : PtMap O4Z (refl kz4) O4B (refl (B.pt four)) = Maps[KZ4, kz4, B.K four, B.pt four].loop (L.K g four) ;
  l2G-pt (g : Hom Zab Gb) (y : Id O4Z (refl kz4) (refl kz4)) :
    Id (Id O4B (refl (B.pt four)) (refl (B.pt four))) ((MO.loop (lG g)).1 y)
      ((M3B'.loop (L.eBi three)).1 ((M33.loop (L.K g three)).1 ((M3Z.loop (L.eA three).1).1 y))) =
    transH (apH (\ H -> (MO.loop H).1 y) (L.loopK g three))
      (transH (apH (\ H -> H.1 y) (loop-comp O4Z (refl kz4) (B.K three) (B.pt three) O4B (refl (B.pt four))
                  (ptcomp O4Z (refl kz4) (A.K three) (A.pt three) (B.K three) (B.pt three) (L.eA three).1 (L.K g three)) (L.eBi three)))
         (apH (M3B'.loop (L.eBi three)).1 (apH (\ H -> H.1 y) (loop-comp O4Z (refl kz4) (A.K three) (A.pt three) (B.K three) (B.pt three) (L.eA three).1 (L.K g three))))) ;
  j-pt (g : Hom Zab Gb) (y : Id O4Z (refl kz4) (refl kz4)) :
    Id (B.K two) (L.jB.1.1 ((MO.loop (lG g)).1 y)) ((L.K g two).1 (L.jA.1.1 y)) =
    transH (apH L.jB.1.1 (l2G-pt g y))
      (transH (apH (L.eB two).1.1
                 (transH (symH (apH (\ H1 -> H1.1 ((M33.loop (L.K g three)).1 ((M3Z.loop (L.eA three).1).1 y)))
                                  (loop-comp (B.K three) (B.pt three) O4B (refl (B.pt four)) (B.K three) (B.pt three) (L.eBi three) (L.eB three).1)))
                    (transH (apH (\ H1 -> (Maps[B.K three, B.pt three, B.K three, B.pt three].loop H1).1 ((M33.loop (L.K g three)).1 ((M3Z.loop (L.eA three).1).1 y)))
                               (pt-inv-r O4B (refl (B.pt four)) (B.K three) (B.pt three) (L.eB three)))
                       (transH (Puppe[l].loop-id (B.K three) (B.pt three) ((M33.loop (L.K g three)).1 ((M3Z.loop (L.eA three).1).1 y)))
                          (apH (\ H1 -> H1.1 ((M3Z.loop (L.eA three).1).1 y)) (L.loopK g two))))))
         (apH (\ H1 -> H1.1 ((L.K g two).1 ((L.eA two).1.1 ((M3Z.loop (L.eA three).1).1 y))))
            (pt-inv-r (Id (B.K three) (B.pt three) (B.pt three)) (refl (B.pt three)) (B.K two) (B.pt two) (L.eB two)))) ;
  -- CupSquare.iota-eq is j_Z, by definition
  iota-eq-j : Id (PtEquiv (Id O4Z (refl kz4) (refl kz4)) (refl (refl kz4)) KZ2 kz2) CS.iota-eq L.jA = L.jA-def ;
  iota-back (x : KZ2) : Id KZ2 (L.jA.1.1 (CS.iota.1 x)) x =
    transH (apH (\ E -> E.1.1 (CS.iota.1 x)) (symH iota-eq-j))
      (calc KZ2 {
        CS.iota-eq.1.1 (CS.iota.1 x)
          =< refl (CS.iota-eq.1.1 (CS.iota.1 x)) >
        (ptcomp KZ2 kz2 (Id O4Z (refl kz4) (refl kz4)) (refl (refl kz4)) KZ2 kz2 CS.iota CS.iota-eq.1).1 x
          =< apH (\ H1 -> H1.1 x) (pt-inv-r (Id O4Z (refl kz4) (refl kz4)) (refl (refl kz4)) KZ2 kz2 CS.iota-eq) >
        x }) ;
  -- the key equation: Theta (c2 ; K(g,4)_*) = K(g,2)
  key-pt (g : Hom Zab Gb) (x : KZ2) : Id (B.K two) ((Theta (c2g g)).1 x) ((L.K g two).1 x) =
    transH (apH L.jB.1.1 (ENat[KZ4, kz4, B.K four, B.pt four, L.K g four].e-nat CS.c2 x))
      (transH (apH (\ z -> L.jB.1.1 ((MO.loop (lG g)).1 z)) (apH (\ H1 -> H1.1 x) CS.cup-norm))
         (transH (j-pt g (CS.iota.1 x)) (apH (L.K g two).1 (iota-back x)))) ;
  sK2 : isSet (PtMap KZ2 kz2 (B.K two) (B.pt two)) =
    trunc-set (PtMap KZ2 kz2 (B.K two) (B.pt two)) (cor5-map two two KZ2 kz2 (A.conn (suc zero)) (B.K two) (B.pt two) (B.trunc (suc zero))) ;
  cK2 : isConn two (Id (B.K two) (B.pt two) (B.pt two)) = conn-id two (B.K two) (B.conn (suc zero)) (B.pt two) (B.pt two) ;
  key (g : Hom Zab Gb) : Id (PtMap KZ2 kz2 (B.K two) (B.pt two)) (Theta (c2g g)) (L.K g two) =
    idJ (KZ2 -> B.K two) (Theta (c2g g)).1 (\ k e -> (z : Id (B.K two) (k kz2) (B.pt two)) -> Id (PtMap KZ2 kz2 (B.K two) (B.pt two)) (Theta (c2g g)) (k, z))
      (H4Classes[l].pi-set KZ2 kz2 (B.K two) (B.pt two) sK2 cK2 (Theta (c2g g)).1 (Theta (c2g g)).2)
      (L.K g two).1 (FL.funext KZ2 (\ x -> B.K two) (Theta (c2g g)).1 (L.K g two).1 (key-pt g)) (L.K g two).2 ;
  -- Theorem B
  c2g-inj (g g' : Hom Zab Gb) (e : Id (PtMap KZ2 kz2 M' ED.L4.pt0) (c2g g) (c2g g')) : Id (Hom Zab Gb) g g' =
    H.k2-inj g g' (transH (symH (key g)) (transH (apH Theta e) (key g'))) ;
  c2g-surj (c : PtMap KZ2 kz2 M' ED.L4.pt0) : Id (PtMap KZ2 kz2 M' ED.L4.pt0) (c2g (H.inv2 (Theta c))) c =
    theta-inj (c2g (H.inv2 (Theta c))) c (transH (key (H.inv2 (Theta c))) (H.k2-surj (Theta c))) ;
} ;
