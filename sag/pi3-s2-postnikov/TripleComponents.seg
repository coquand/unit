-- The components of the compatible homotopies (doc/postnikov-morphisms.pdf,
-- Section 4).  Informal proof: the note.
--   PtTransl[X, Z, G]   Lemma translation: in M = Map_*(X, Omega Z), tr F = F . G^-1
--                pointwise (pointing psi), an equivalence (Sigma of the right
--                multiplications: sigma-base after a fibrewise equivalence); tr G is
--                merely 0 (pi-mere, trans-sym-r)
--   Unique[X, Z, h]     with h: every pointed map X -> Omega^2 Z is merely constant:
--                loop0 (loops at 0 are merely refl: ev is an equivalence, ev refl = r),
--                at0, near0 (two paths into a point merely equal to 0), unique (two
--                paths f = g are merely equal: ap tr is an equivalence)
--   unique-pt    Lemma components, along a pointed equivalence Omega Z ~pt Y (ptEqInd)
--   const-pt     every map is merely constant, along a pointed equivalence (ptEqInd)
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ; open HLevels[l] ; open Connected[l] ; open Lemma4[l] ;
open DeloopMaps[l] ; open LoopCalc[l] ; open PtEquivOps[l] ; open SphereUniversal[l] ; open PostnikovRealization[l] ; open TripleMaps[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module E = Equivalences[l] ; module Fb = Fibres[l] ; module CM = ConnectedMaps[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module FH = FibreH3[l] ; module Gp = Groupoid[l] ; module CB = ClassBase[l] ; module CS = CupSquare[l] ;

------------------------------------------------------------------------
-- Lemma translation

module PtTransl (X : U l) (x0 : X) (Z : U l) (z0 : Z) (G : PtMap X x0 (Id Z z0 z0) (refl z0)) {
  OZ : U l = Id Z z0 z0 ;
  M : U l = PtMap X x0 OZ (refl z0) ;
  post (F1 : X -> OZ) (x : X) : OZ = trans Z z0 z0 z0 (F1 x) (sym Z z0 z0 (G.1 x)) ;
  post-equiv : isEquiv (X -> OZ) (X -> OZ) post =
    CM.pi-equiv X (\ x -> OZ) (\ x -> OZ) (\ x u -> trans Z z0 z0 z0 u (sym Z z0 z0 (G.1 x))) (\ x -> rmul-equiv Z z0 z0 z0 (sym Z z0 z0 (G.1 x))) ;
  -- refl . G(x0)^-1 = refl
  K0 : Id OZ (trans Z z0 z0 z0 (refl z0) (sym Z z0 z0 (G.1 x0))) (refl z0) =
    transH (trans-refl-l Z z0 z0 (sym Z z0 z0 (G.1 x0))) (apH (sym Z z0 z0) G.2) ;
  psi (F1 : X -> OZ) (F0 : Id OZ (F1 x0) (refl z0)) : Id OZ (post F1 x0) (refl z0) =
    trans OZ (post F1 x0) (trans Z z0 z0 z0 (refl z0) (sym Z z0 z0 (G.1 x0))) (refl z0)
      (ap OZ OZ (\ u -> trans Z z0 z0 z0 u (sym Z z0 z0 (G.1 x0))) (F1 x0) (refl z0) F0) K0 ;
  psi-equiv (F1 : X -> OZ) : isEquiv (Id OZ (F1 x0) (refl z0)) (Id OZ (post F1 x0) (refl z0)) (psi F1) =
    (E.compose (Id OZ (F1 x0) (refl z0)) (Id OZ (post F1 x0) (trans Z z0 z0 z0 (refl z0) (sym Z z0 z0 (G.1 x0)))) (Id OZ (post F1 x0) (refl z0))
      (ap OZ OZ (\ u -> trans Z z0 z0 z0 u (sym Z z0 z0 (G.1 x0))) (F1 x0) (refl z0),
       CB.ap-equiv OZ OZ (\ u -> trans Z z0 z0 z0 u (sym Z z0 z0 (G.1 x0)), rmul-equiv Z z0 z0 z0 (sym Z z0 z0 (G.1 x0))) (F1 x0) (refl z0))
      (\ u -> trans OZ (post F1 x0) (trans Z z0 z0 z0 (refl z0) (sym Z z0 z0 (G.1 x0))) (refl z0) u K0,
       rmul-equiv OZ (post F1 x0) (trans Z z0 z0 z0 (refl z0) (sym Z z0 z0 (G.1 x0))) (refl z0) K0)).2 ;
  -- the translation by G^-1
  tr (F : M) : M = (post F.1, psi F.1 F.2) ;
  tr-equiv : isEquiv M M tr =
    E.homotopy M M
      (E.compose M ((F1 : X -> OZ) * Id OZ (post F1 x0) (refl z0)) M
         (Fb.sigma-equiv (X -> OZ) (\ F1 -> Id OZ (F1 x0) (refl z0)) (\ F1 -> Id OZ (post F1 x0) (refl z0)) (\ F1 -> (psi F1, psi-equiv F1)))
         (\ w -> (post w.1, w.2), SphereAxiom[l].sigma-base (X -> OZ) (X -> OZ) (post, post-equiv) (\ F1 -> Id OZ (F1 x0) (refl z0))))
      tr (\ F -> refl (tr F)) ;
  -- tr G is merely the constant map
  tr-G (cOO : isConn two (Id OZ (refl z0) (refl z0))) : Tr.Trunc[Id M (tr G) (\ x -> refl z0, refl (refl z0))].carrier =
    FH.pi-mere X x0 OZ (refl z0) cOO (post G.1) (\ x -> refl z0)
      (FL.funext X (\ x -> OZ) (post G.1) (\ x -> refl z0) (\ x -> Gp.trans-sym-r Z z0 z0 (G.1 x))) (psi G.1 G.2) (refl (refl z0)) ;
} ;

------------------------------------------------------------------------
-- Lemma components, for the target Omega Z

module Unique (X : U l) (x0 : X) (Z : U l) (z0 : Z) (cOO : isConn two (Id (Id Z z0 z0) (refl z0) (refl z0)))
  (h : (m : PtMap X x0 (Id (Id Z z0 z0) (refl z0) (refl z0)) (refl (refl z0))) ->
       Tr.Trunc[Id (PtMap X x0 (Id (Id Z z0 z0) (refl z0) (refl z0)) (refl (refl z0))) m CS.PtMapLoops[X, x0, Id Z z0 z0, refl z0].r].carrier) {
  OZ : U l = Id Z z0 z0 ;
  M : U l = PtMap X x0 OZ (refl z0) ;
  module PML = CS.PtMapLoops[X, x0, OZ, refl z0] ;
  -- loops at the base point are merely refl
  loop0 (L : Id M PML.pt0 PML.pt0) : Tr.Trunc[Id (Id M PML.pt0 PML.pt0) L (refl PML.pt0)].carrier =
    TC.map (Id (PtMap X x0 (Id OZ (refl z0) (refl z0)) (refl (refl z0))) (PML.ev L) PML.r) (Id (Id M PML.pt0 PML.pt0) L (refl PML.pt0))
      (\ e -> E.injective (Id M PML.pt0 PML.pt0) (PtMap X x0 (Id OZ (refl z0) (refl z0)) (refl (refl z0))) PML.ev (PML.FT.equiv PML.pt0) L (refl PML.pt0) e)
      (h (PML.ev L)) ;
  -- two paths into the base point
  at0 (u : M) (r r' : Id M u PML.pt0) : Tr.Trunc[Id (Id M u PML.pt0) r r'].carrier =
    TC.map (Id (Id M PML.pt0 PML.pt0) (trans M PML.pt0 u PML.pt0 (sym M u PML.pt0 r) r') (refl PML.pt0)) (Id (Id M u PML.pt0) r r')
      (\ e -> MapFib[l].cancel-snd M u PML.pt0 r r' (symH e)) (loop0 (trans M PML.pt0 u PML.pt0 (sym M u PML.pt0 r) r')) ;
  -- two paths into a point merely equal to the base point
  near0 (u v : M) (q : Tr.Trunc[Id M v PML.pt0].carrier) (r r' : Id M u v) : Tr.Trunc[Id (Id M u v) r r'].carrier =
    Tr.Trunc[Id M v PML.pt0].induction @l (\ q1 -> Tr.Trunc[Id (Id M u v) r r'].carrier) (\ q1 -> Tr.Trunc[Id (Id M u v) r r'].proposition)
      (\ q1 -> idJR M PML.pt0 (\ v1 q2 -> (r1 r1' : Id M u v1) -> Tr.Trunc[Id (Id M u v1) r1 r1'].carrier) (at0 u) v q1 r r') q ;
  -- Lemma components
  unique (f g : M) (H H' : Id M f g) : Tr.Trunc[Id (Id M f g) H H'].carrier =
    TC.map (Id (Id M (PtTransl[X, x0, Z, z0, g].tr f) (PtTransl[X, x0, Z, z0, g].tr g)) (ap M M PtTransl[X, x0, Z, z0, g].tr f g H) (ap M M PtTransl[X, x0, Z, z0, g].tr f g H'))
      (Id (Id M f g) H H')
      (\ e -> E.injective (Id M f g) (Id M (PtTransl[X, x0, Z, z0, g].tr f) (PtTransl[X, x0, Z, z0, g].tr g)) (ap M M PtTransl[X, x0, Z, z0, g].tr f g)
                (CB.ap-equiv M M (PtTransl[X, x0, Z, z0, g].tr, PtTransl[X, x0, Z, z0, g].tr-equiv) f g) H H' e)
      (near0 (PtTransl[X, x0, Z, z0, g].tr f) (PtTransl[X, x0, Z, z0, g].tr g) (PtTransl[X, x0, Z, z0, g].tr-G cOO)
         (ap M M PtTransl[X, x0, Z, z0, g].tr f g H) (ap M M PtTransl[X, x0, Z, z0, g].tr f g H')) ;
} ;

-- Lemma components, along a pointed equivalence Omega Z ~pt Y
unique-pt (X : U l) (x0 : X) (Z : U l) (z0 : Z) (cOO : isConn two (Id (Id Z z0 z0) (refl z0) (refl z0)))
  (h : (m : PtMap X x0 (Id (Id Z z0 z0) (refl z0) (refl z0)) (refl (refl z0))) ->
       Tr.Trunc[Id (PtMap X x0 (Id (Id Z z0 z0) (refl z0) (refl z0)) (refl (refl z0))) m CS.PtMapLoops[X, x0, Id Z z0 z0, refl z0].r].carrier)
  (Y : U l) (y : Y) (e : PtEquiv (Id Z z0 z0) (refl z0) Y y) :
  (f g : PtMap X x0 Y y) (H H' : Id (PtMap X x0 Y y) f g) -> Tr.Trunc[Id (Id (PtMap X x0 Y y) f g) H H'].carrier =
  ptEqInd (Id Z z0 z0) (refl z0)
    (\ Y1 y1 e1 -> (f g : PtMap X x0 Y1 y1) (H H' : Id (PtMap X x0 Y1 y1) f g) -> Tr.Trunc[Id (Id (PtMap X x0 Y1 y1) f g) H H'].carrier)
    (Unique[X, x0, Z, z0, cOO, h].unique) Y y e ;

-- every pointed map is merely constant, along a pointed equivalence
const-pt (X : U l) (x0 : X) (A : U l) (a0 : A)
  (h : (m : PtMap X x0 A a0) -> Tr.Trunc[Id (PtMap X x0 A a0) m (\ x -> a0, refl a0)].carrier)
  (B : U l) (b0 : B) (e : PtEquiv A a0 B b0) : (m : PtMap X x0 B b0) -> Tr.Trunc[Id (PtMap X x0 B b0) m (\ x -> b0, refl b0)].carrier =
  ptEqInd A a0 (\ B1 b1 e1 -> (m : PtMap X x0 B1 b1) -> Tr.Trunc[Id (PtMap X x0 B1 b1) m (\ x -> b1, refl b1)].carrier) h B b0 e ;
