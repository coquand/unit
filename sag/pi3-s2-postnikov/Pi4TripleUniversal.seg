-- pi_4(S^3) = Z/2 through maps of triples and the looping embedding
-- (doc/postnikov-morphisms.pdf, Section 6).  Informal proof: the note.
-- tbar = (Z, Z/2, kbar), R = Fib kbar; t' = (A', B', k') deloopable.
--   Theta4[t', dl]  Proposition theta4: hom(tbar, t') -> Hom(Z, A') is a bijection:
--                (ex) h = Phi^-1 [K(a,2) ; k'] (H4), 2 h(1) = 0 (Statement T at
--                G = K(a,2): the only use of deloopability), h = rho ; g (Factor),
--                [kbar ; K(g,4)] = [K(a,2) ; k'] (Psi); (bi) Psi injective;
--                then Pi3TripleUniversal.ThetaGen (H3 through Lemma components)
--   Final4[S3,..].At[t', dl]   r^* : [R, Fib k']_* -> [Omega S3, Fib k']_* bijective:
--                ExS4: (E) at the source Omega S3 WITHOUT MarkDirect.ExR: [F] = r ; [c]
--                (rA), c = [p ; K(a,2)] (PStar, k2-surj), (ex) of theta4 and FibP.fseq
--                give F ; k' merely 0; (U) is MarkDirect.Direct.un-S; qS4 (Lifting);
--                square (fm-over), rr-equiv (KCls, PStar, rA), classes-equiv of
--                Theorem 1, 2-out-of-3
--   AtU, marked  statement M at every u : SC4 (the triple of Omega u, transfer along
--                eps^-1, Proposition L), as MarkDirect.AtU with rFt for rF
--   Assemble, Pi4S3   both instances sP (u = BR) and sT (u = ||S3||_4) from marked;
--                Pi4Sphere.Two4, Pi4Sphere.pi4-BR.
-- Not used: MarkDirect.Direct.rF, marked, qS, ExS, MarkDirect.ExR, qR, MapBR.ur,
-- DeloopEmbedding.Mark.marked, SourceS3.Final.rep-fib, Presentation4.
-- Used: the classes SourceS3.Final.s, MarkLoop.LMark.r; MarkDirect.Direct.rA,
-- un-S, transfer, RStar.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ; open HLevels[l] ; open Connected[l] ;
open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ; open Torsor[l] ; open LoopCalc[l] ; open Group[l] ;
open EMMaps[l] ; open AbHom[l] ; open HomotopyClasses[l] ; open HomotopyGroups[l] ; open SphereUniversal[l] ; open PostnikovRealization[l] ; open KZ2Cohomology[l] ;
open Z2[l] ; open Sphere3Axiom[l] ; open TripleMaps[l] ; open TripleMapsEquiv[l] ; open Pi3TripleUniversal[l] ;
module P1 = Prelude[l+] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module E = Equivalences[l] ; module W = Whitehead[l] ; module Bj = Bijection[l] ;
module Fb = Fibres[l] ; module CS = CupSquare[l] ; module CT = CrossTerm[l] ; module HB = H4Bilinear[l] ; module FM = FibMap[l] ;
module NC = Necessity[l] ; module MF = MapFib[l] ; module S3S = SourceS3[l] ; module S3T = Sphere3Trunc[l] ;
module DE = DeloopEmbedding[l] ; module CP = ClassPost[l] ; module PC = PostnikovClassification[l] ;
module DR = DeloopR[l] ; module TT = TwoTorsion[l] ; module ML = MarkLoop[l] ; module MD = MarkDirect[l] ; module PS4 = Pi4Sphere[l] ;

------------------------------------------------------------------------
-- Proposition theta4

module Theta4 (Ga' Gb' : Ab) (k' : PtMap (KK[Ga'].K two) (KK[Ga'].pt two) (KK[Gb'].K four) (KK[Gb'].pt four)) (dl : DE.Deloopable (Ga', Gb', k')) {
  module M2 = Maps2[Zab, Z2ab, CT.kbar, Ga', Gb', k'] ;
  module KB' = KK[Gb'] ;
  module C = KK[Z2ab] ;
  module SK = STr[PtMap KZ2 kz2 (KB'.K four) (KB'.pt four)] ;
  -- h = Phi^-1 [K(a,2) ; k']
  h (a : Hom Zab Ga') : Hom Zab Gb' = (H4Proof[l].h4 Gb').sec (hcl KZ2 kz2 (KB'.K four) (KB'.pt four) (M2.ck a)) ;
  eh (a : Hom Zab Ga') : Id (HC KZ2 kz2 (KB'.K four) (KB'.pt four)) (Phi CS.kappa Gb' (h a)) (hcl KZ2 kz2 (KB'.K four) (KB'.pt four) (M2.ck a)) =
    (H4Proof[l].h4 Gb').sec-eq (hcl KZ2 kz2 (KB'.K four) (KB'.pt four) (M2.ck a)) ;
  -- 2 h(1) = 0 (Statement T at G = K(a,2)), h = rho ; g
  g (a : Hom Zab Ga') : Hom Z2ab Gb' = NC.Factor[Gb', h a, TT.TwoTors[Ga', Gb', k', dl, M2.LA.K a two].Two[h a, eh a].two-tors].g ;
  factor (a : Hom Zab Ga') : Id (Hom Zab Gb') (KFun[l].hcomp Zab Z2ab Gb' rho (g a)) (h a) =
    NC.Factor[Gb', h a, TT.TwoTors[Ga', Gb', k', dl, M2.LA.K a two].Two[h a, eh a].two-tors].factor ;
  -- Psi b is the class of kbar ; K(b,4)
  psi-kc (b : Hom Z2ab Gb') : Id (HC KZ2 kz2 (KB'.K four) (KB'.pt four)) (NC.Psi[Gb'].psi b) (hcl KZ2 kz2 (KB'.K four) (KB'.pt four) (M2.kc b)) =
    apH (\ G -> hcl KZ2 kz2 (KB'.K four) (KB'.pt four) (ptcomp KZ2 kz2 (C.K four) (C.pt four) (KB'.K four) (KB'.pt four) CT.kbar G)) (M2.LB.K-def b four) ;
  cls (a : Hom Zab Ga') : Id (HC KZ2 kz2 (KB'.K four) (KB'.pt four)) (hcl KZ2 kz2 (KB'.K four) (KB'.pt four) (M2.kc (g a))) (hcl KZ2 kz2 (KB'.K four) (KB'.pt four) (M2.ck a)) =
    calc (HC KZ2 kz2 (KB'.K four) (KB'.pt four)) {
      hcl KZ2 kz2 (KB'.K four) (KB'.pt four) (M2.kc (g a))
        =< symH (psi-kc (g a)) >
      NC.Psi[Gb'].psi (g a)
        =< NC.Psi[Gb'].psi-phi (g a) >
      Phi CS.kappa Gb' (KFun[l].hcomp Zab Z2ab Gb' rho (g a))
        =< apH (Phi CS.kappa Gb') (factor a) >
      Phi CS.kappa Gb' (h a)
        =< eh a >
      hcl KZ2 kz2 (KB'.K four) (KB'.pt four) (M2.ck a) } ;
  ex (a : Hom Zab Ga') : Tr.Trunc[(b : Hom Z2ab Gb') * Id (PtMap KZ2 kz2 (KB'.K four) (KB'.pt four)) (M2.kc b) (M2.ck a)].carrier =
    TC.map (Id (PtMap KZ2 kz2 (KB'.K four) (KB'.pt four)) (M2.kc (g a)) (M2.ck a)) ((b : Hom Z2ab Gb') * Id (PtMap KZ2 kz2 (KB'.K four) (KB'.pt four)) (M2.kc b) (M2.ck a))
      (\ H -> (g a, H)) (SK.effective (M2.kc (g a)) (M2.ck a) (cls a)) ;
  -- Psi is injective
  b-eq (a : Hom Zab Ga') (b b' : Hom Z2ab Gb') (H : Id (PtMap KZ2 kz2 (KB'.K four) (KB'.pt four)) (M2.ck a) (M2.kc b))
    (H' : Id (PtMap KZ2 kz2 (KB'.K four) (KB'.pt four)) (M2.ck a) (M2.kc b')) : Id (Hom Z2ab Gb') b b' =
    NC.Psi[Gb'].Inj[b, b', transH (psi-kc b) (transH (SK.inc-eq (M2.kc b) (M2.ck a) (symH H)) (transH (SK.inc-eq (M2.ck a) (M2.kc b') H') (symH (psi-kc b'))))].psi-inj ;
  module TG = ThetaGen[Z2ab, CT.kbar, Ga', Gb', k', ex, b-eq] ;
} ;

------------------------------------------------------------------------
-- statement M for every pointed 2-connected 4-type

module Final4 (S3 : U l) (base : S3) (surf : O3 S3 base)
  (ump3 : (X : U l) -> isEquiv (S3 -> X) ((x : X) * O3 X x) (ev3 S3 base surf X)) {
  module LM = ML.LMark[S3, base, surf, ump3] ;
  module MK = DE.Mark[S3, base, surf, ump3] ;
  module MDD = MD.Direct[S3, base, surf, ump3] ;
  module FS = S3S.Final[S3, base, surf, ump3] ;

  module At (Ga' Gb' : Ab) (k' : PtMap (KK[Ga'].K two) (KK[Ga'].pt two) (KK[Gb'].K four) (KK[Gb'].pt four)) (dl : DE.Deloopable (Ga', Gb', k')) {
    module TH = Theta4[Ga', Gb', k', dl] ;
    module M2 = TH.M2 ;
    module KA = KK[Ga'] ;
    module KB = KK[Gb'] ;
    module C = KK[Z2ab] ;
    module R' = Triple[Ga', Gb', k'] ;
    module KC = KCls[Ga'] ;
    module PS = MF.FibP[Zab, Z2ab, CT.kbar].PStar[Ga'] ;
    module LF = MF.Lifting[(Id S3 base base), (refl base), Ga', Gb', k'] ;
    -- F1 ; k' = 0 from F1 = p ; K(a,2) and K(a,2) ; k' = kbar ; K(b,4)
    chain (F1 : PtMap DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two)) (a : Hom Zab Ga') (b : Hom Z2ab Gb')
      (e1 : Id (PtMap DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two)) (ptcomp DR.TR.F DR.TR.f0 KZ2 kz2 (KA.K two) (KA.pt two) (Fb.fpr KZ2 kz2 (C.K four) (C.pt four) CT.kbar) (M2.LA.K a two)) F1)
      (e2 : Id (PtMap KZ2 kz2 (KB.K four) (KB.pt four)) (M2.kc b) (M2.ck a))
      (e3 : Id (PtMap DR.TR.F DR.TR.f0 (C.K four) (C.pt four)) (ptcomp DR.TR.F DR.TR.f0 KZ2 kz2 (C.K four) (C.pt four) (Fb.fpr KZ2 kz2 (C.K four) (C.pt four) CT.kbar) CT.kbar) (ptconst DR.TR.F DR.TR.f0 (C.K four) (C.pt four))) :
      Id (PtMap DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four)) (ptcomp DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) F1 k') (ptconst DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four)) =
      calc (PtMap DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four)) {
        ptcomp DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) F1 k'
          =< apH (\ M -> ptcomp DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) M k') (symH e1) >
        ptcomp DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) (ptcomp DR.TR.F DR.TR.f0 KZ2 kz2 (KA.K two) (KA.pt two) (Fb.fpr KZ2 kz2 (C.K four) (C.pt four) CT.kbar) (M2.LA.K a two)) k'
          =< ptcomp-assoc DR.TR.F DR.TR.f0 KZ2 kz2 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) (Fb.fpr KZ2 kz2 (C.K four) (C.pt four) CT.kbar) (M2.LA.K a two) k' >
        ptcomp DR.TR.F DR.TR.f0 KZ2 kz2 (KB.K four) (KB.pt four) (Fb.fpr KZ2 kz2 (C.K four) (C.pt four) CT.kbar) (M2.ck a)
          =< apH (ptcomp DR.TR.F DR.TR.f0 KZ2 kz2 (KB.K four) (KB.pt four) (Fb.fpr KZ2 kz2 (C.K four) (C.pt four) CT.kbar)) (symH e2) >
        ptcomp DR.TR.F DR.TR.f0 KZ2 kz2 (KB.K four) (KB.pt four) (Fb.fpr KZ2 kz2 (C.K four) (C.pt four) CT.kbar) (M2.kc b)
          =< symH (ptcomp-assoc DR.TR.F DR.TR.f0 KZ2 kz2 (C.K four) (C.pt four) (KB.K four) (KB.pt four) (Fb.fpr KZ2 kz2 (C.K four) (C.pt four) CT.kbar) CT.kbar (M2.LB.K b four)) >
        ptcomp DR.TR.F DR.TR.f0 (C.K four) (C.pt four) (KB.K four) (KB.pt four) (ptcomp DR.TR.F DR.TR.f0 KZ2 kz2 (C.K four) (C.pt four) (Fb.fpr KZ2 kz2 (C.K four) (C.pt four) CT.kbar) CT.kbar) (M2.LB.K b four)
          =< apH (\ M -> ptcomp DR.TR.F DR.TR.f0 (C.K four) (C.pt four) (KB.K four) (KB.pt four) M (M2.LB.K b four)) e3 >
        ptcomp DR.TR.F DR.TR.f0 (C.K four) (C.pt four) (KB.K four) (KB.pt four) (ptconst DR.TR.F DR.TR.f0 (C.K four) (C.pt four)) (M2.LB.K b four)
          =< comp-const-l DR.TR.F DR.TR.f0 (C.K four) (C.pt four) (KB.K four) (KB.pt four) (M2.LB.K b four) >
        ptconst DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four) } ;
    -- (E) at the source R, from theta4 (ex)
    aF (F1 : PtMap DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two)) : Hom Zab Ga' = KC.H2.inv2 (PS.ext-pt F1) ;
    null1 (F1 : PtMap DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two)) :
      Tr.Trunc[Id (PtMap DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four)) (ptcomp DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) F1 k') (ptconst DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four))].carrier =
      TC.bind (Id (PtMap DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two)) (ptcomp DR.TR.F DR.TR.f0 KZ2 kz2 (KA.K two) (KA.pt two) (Fb.fpr KZ2 kz2 (C.K four) (C.pt four) CT.kbar) (PS.ext-pt F1)) F1)
        (Id (PtMap DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four)) (ptcomp DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) F1 k') (ptconst DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four)))
        (\ e1 -> TC.map2 ((b : Hom Z2ab Gb') * Id (PtMap KZ2 kz2 (KB.K four) (KB.pt four)) (M2.kc b) (M2.ck (aF F1)))
                   (Id (PtMap DR.TR.F DR.TR.f0 (C.K four) (C.pt four)) (ptcomp DR.TR.F DR.TR.f0 KZ2 kz2 (C.K four) (C.pt four) (Fb.fpr KZ2 kz2 (C.K four) (C.pt four) CT.kbar) CT.kbar) (ptconst DR.TR.F DR.TR.f0 (C.K four) (C.pt four)))
                   (Id (PtMap DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four)) (ptcomp DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) F1 k') (ptconst DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four)))
                   (\ w e3 -> chain F1 (aF F1) w.1
                                (transH (apH (ptcomp DR.TR.F DR.TR.f0 KZ2 kz2 (KA.K two) (KA.pt two) (Fb.fpr KZ2 kz2 (C.K four) (C.pt four) CT.kbar)) (KC.H2.k2-surj (PS.ext-pt F1))) e1)
                                w.2 e3)
                   (TH.ex (aF F1)) MF.FibP[Zab, Z2ab, CT.kbar].fseq)
        (PS.ext-eq F1) ;
    -- (E) at the source Omega S3 (the steps of MarkDirect.Direct.ExS, with null1 for ExR)
    module ExS4 (F : PtMap (Id S3 base base) (refl base) (KA.K two) (KA.pt two)) {
      c : HC DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) = (MDD.rA Ga').sec (hcl (Id S3 base base) (refl base) (KA.K two) (KA.pt two) F) ;
      c-eq : Id (HC (Id S3 base base) (refl base) (KA.K two) (KA.pt two)) (compC (Id S3 base base) (refl base) DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) LM.r c) (hcl (Id S3 base base) (refl base) (KA.K two) (KA.pt two) F) = (MDD.rA Ga').sec-eq (hcl (Id S3 base base) (refl base) (KA.K two) (KA.pt two) F) ;
      ck (b : HC DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two)) :
        Id (HC DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four)) (compC DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) b (hcl (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) k')) (hcl DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four) (ptconst DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four))) =
        STr[PtMap DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two)].ind @l
          (\ b1 -> Id (HC DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four)) (compC DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) b1 (hcl (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) k')) (hcl DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four) (ptconst DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four))))
          (\ b1 -> hc-set DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four) (compC DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) b1 (hcl (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) k')) (hcl DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four) (ptconst DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four))))
          (\ F1 -> transH (comp-beta DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) F1 k')
                     (TC.rec (Id (PtMap DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four)) (ptcomp DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) F1 k') (ptconst DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four))) @l
                        (Id (HC DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four)) (hcl DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four) (ptcomp DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) F1 k')) (hcl DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four) (ptconst DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four))))
                        (hc-set DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four) (hcl DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four) (ptcomp DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) F1 k')) (hcl DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four) (ptconst DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four))))
                        (apH (hcl DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four))) (null1 F1)))
          b ;
      cls : Id (HC (Id S3 base base) (refl base) (KB.K four) (KB.pt four)) (hcl (Id S3 base base) (refl base) (KB.K four) (KB.pt four) (ptcomp (Id S3 base base) (refl base) (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) F k')) (hcl (Id S3 base base) (refl base) (KB.K four) (KB.pt four) (ptconst (Id S3 base base) (refl base) (KB.K four) (KB.pt four))) =
        calc (HC (Id S3 base base) (refl base) (KB.K four) (KB.pt four)) {
          hcl (Id S3 base base) (refl base) (KB.K four) (KB.pt four) (ptcomp (Id S3 base base) (refl base) (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) F k')
            =< symH (comp-beta (Id S3 base base) (refl base) (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) F k') >
          compC (Id S3 base base) (refl base) (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) (hcl (Id S3 base base) (refl base) (KA.K two) (KA.pt two) F) (hcl (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) k')
            =< apH (\ a -> compC (Id S3 base base) (refl base) (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) a (hcl (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) k')) (symH c-eq) >
          compC (Id S3 base base) (refl base) (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) (compC (Id S3 base base) (refl base) DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) LM.r c) (hcl (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) k')
            =< comp-assoc (Id S3 base base) (refl base) DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) LM.r c (hcl (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) k') >
          compC (Id S3 base base) (refl base) DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four) LM.r (compC DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) c (hcl (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) k'))
            =< apH (compC (Id S3 base base) (refl base) DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four) LM.r) (ck c) >
          compC (Id S3 base base) (refl base) DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four) LM.r (hcl DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four) (ptconst DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four)))
            =< MD.comp-zero-r (Id S3 base base) (refl base) DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four) LM.r >
          hcl (Id S3 base base) (refl base) (KB.K four) (KB.pt four) (ptconst (Id S3 base base) (refl base) (KB.K four) (KB.pt four)) } ;
      null : Tr.Trunc[Id (PtMap (Id S3 base base) (refl base) (KB.K four) (KB.pt four)) (ptcomp (Id S3 base base) (refl base) (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) F k') (ptconst (Id S3 base base) (refl base) (KB.K four) (KB.pt four))].carrier =
        STr[PtMap (Id S3 base base) (refl base) (KB.K four) (KB.pt four)].effective (ptcomp (Id S3 base base) (refl base) (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) F k') (ptconst (Id S3 base base) (refl base) (KB.K four) (KB.pt four)) cls ;
    } ;
    ex-S4 : LF.Ex = \ F -> ExS4[F].null ;
    -- the lifting lemma at the source Omega S3
    qS4 : isEquiv (HC (Id S3 base base) (refl base) R'.F R'.f0) (HC (Id S3 base base) (refl base) (KA.K two) (KA.pt two)) LF.qs =
      LF.Main[ex-S4, MDD.un-S Ga' Gb' k'].equiv ;
    -- a |-> r ; [p ; K(a,2)] is a bijection
    rr (a : Hom Zab Ga') : HC (Id S3 base base) (refl base) (KA.K two) (KA.pt two) =
      compC (Id S3 base base) (refl base) DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) LM.r (PS.pstar (KC.hk a)) ;
    rr-equiv : isEquiv (Hom Zab Ga') (HC (Id S3 base base) (refl base) (KA.K two) (KA.pt two)) rr =
      (E.compose (Hom Zab Ga') (HC DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two)) (HC (Id S3 base base) (refl base) (KA.K two) (KA.pt two))
         (E.compose (Hom Zab Ga') (HC KZ2 kz2 (KA.K two) (KA.pt two)) (HC DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two)) (KC.hk, KC.hk-equiv) (PS.pstar, PS.equiv))
         (\ c -> compC (Id S3 base base) (refl base) DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) LM.r c, MDD.rA Ga')).2 ;
    -- the class of realise-map, and r^*
    module SR = STrMap[M2.Mor, PtMap DR.TR.F DR.TR.f0 R'.F R'.f0, M2.realise-map] ;
    f1-equiv : isEquiv TH.TG.hom (HC DR.TR.F DR.TR.f0 R'.F R'.f0) SR.map = classes-equiv M2.Mor (PtMap DR.TR.F DR.TR.f0 R'.F R'.f0) M2.realise-map M2.realise-map-equiv ;
    rs (c : HC DR.TR.F DR.TR.f0 R'.F R'.f0) : HC (Id S3 base base) (refl base) R'.F R'.f0 = compC (Id S3 base base) (refl base) DR.TR.F DR.TR.f0 R'.F R'.f0 LM.r c ;
    sq-at (m : M2.Mor) : Id (HC (Id S3 base base) (refl base) (KA.K two) (KA.pt two)) (LF.qs (rs (hcl DR.TR.F DR.TR.f0 R'.F R'.f0 (M2.realise-map m)))) (rr (M2.mor-a m)) =
      calc (HC (Id S3 base base) (refl base) (KA.K two) (KA.pt two)) {
        compC (Id S3 base base) (refl base) R'.F R'.f0 (KA.K two) (KA.pt two) (compC (Id S3 base base) (refl base) DR.TR.F DR.TR.f0 R'.F R'.f0 LM.r (hcl DR.TR.F DR.TR.f0 R'.F R'.f0 (M2.realise-map m)))
          (hcl R'.F R'.f0 (KA.K two) (KA.pt two) (Fb.fpr (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) k'))
          =< comp-assoc (Id S3 base base) (refl base) DR.TR.F DR.TR.f0 R'.F R'.f0 (KA.K two) (KA.pt two) LM.r (hcl DR.TR.F DR.TR.f0 R'.F R'.f0 (M2.realise-map m))
               (hcl R'.F R'.f0 (KA.K two) (KA.pt two) (Fb.fpr (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) k')) >
        compC (Id S3 base base) (refl base) DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) LM.r
          (compC DR.TR.F DR.TR.f0 R'.F R'.f0 (KA.K two) (KA.pt two) (hcl DR.TR.F DR.TR.f0 R'.F R'.f0 (M2.realise-map m)) (hcl R'.F R'.f0 (KA.K two) (KA.pt two) (Fb.fpr (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) k')))
          =< apH (compC (Id S3 base base) (refl base) DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) LM.r)
               (transH (comp-beta DR.TR.F DR.TR.f0 R'.F R'.f0 (KA.K two) (KA.pt two) (M2.realise-map m) (Fb.fpr (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) k'))
                 (transH (apH (hcl DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two))
                            FM.FibMap[KZ2, kz2, C.K four, C.pt four, KA.K two, KA.pt two, KB.K four, KB.pt four, CT.kbar, k', M2.LA.K (M2.mor-a m) two, M2.LB.K (M2.mor-b m) four, M2.mor-H m].fm-over)
                   (symH (comp-beta DR.TR.F DR.TR.f0 KZ2 kz2 (KA.K two) (KA.pt two) (Fb.fpr KZ2 kz2 (C.K four) (C.pt four) CT.kbar) (M2.LA.K (M2.mor-a m) two))))) >
        rr (M2.mor-a m) } ;
    square (c : TH.TG.hom) : Id (HC (Id S3 base base) (refl base) (KA.K two) (KA.pt two)) (LF.qs (rs (SR.map c))) (rr (TH.TG.theta c)) =
      TH.TG.SM.ind @l (\ c1 -> Id (HC (Id S3 base base) (refl base) (KA.K two) (KA.pt two)) (LF.qs (rs (SR.map c1))) (rr (TH.TG.theta c1)))
        (\ c1 -> hc-set (Id S3 base base) (refl base) (KA.K two) (KA.pt two) _ _)
        (\ m -> transH (apH (\ u -> LF.qs (rs u)) (SR.beta m)) (transH (sq-at m) (apH rr (symH (TH.TG.LT.beta m))))) c ;
    -- r^* is bijective into Fib k'
    rFt : MDD.RStar R'.F R'.f0 =
      W.cancel-equiv (HC DR.TR.F DR.TR.f0 R'.F R'.f0) (HC (Id S3 base base) (refl base) R'.F R'.f0) (HC (Id S3 base base) (refl base) (KA.K two) (KA.pt two)) rs
        LF.qs qS4
        (MF.cancel-r TH.TG.hom (HC DR.TR.F DR.TR.f0 R'.F R'.f0) (HC (Id S3 base base) (refl base) (KA.K two) (KA.pt two)) SR.map (\ c -> LF.qs (rs c)) f1-equiv
           (E.homotopy TH.TG.hom (HC (Id S3 base base) (refl base) (KA.K two) (KA.pt two))
              (E.compose TH.TG.hom (Hom Zab Ga') (HC (Id S3 base base) (refl base) (KA.K two) (KA.pt two)) (TH.TG.theta, TH.TG.theta-equiv) (rr, rr-equiv))
              (\ c -> LF.qs (rs (SR.map c))) square)) ;
  } ;

  -- statement M at every u : SC4 (MarkDirect.Direct.AtU, with rFt)
  module AtU (u : DE.SC4) {
    module A = DE.Acs[u] ;
    t : PC.Triples = PC.realise-equiv.sec (DE.Omega u) ;
    t-eq : Id CP.SC3 (PC.realise t) (DE.Omega u) = PC.realise-equiv.sec-eq (DE.Omega u) ;
    opaque t ;
    dl : DE.Deloopable (t.1, t.2.1, t.2.2) = (u, P1.sym CP.SC3 (PC.realise t) (DE.Omega u) t-eq) ;
    module LP = TT.Loop[t.1, t.2.1, t.2.2, dl] ;
    lmarked : LM.At[u].LMarked =
      MDD.transfer Triple[t.1, t.2.1, t.2.2].F Triple[t.1, t.2.1, t.2.2].f0 (Id A.Y A.y A.y) (refl A.y)
        (pt-inv (Id A.Y A.y A.y) (refl A.y) Triple[t.1, t.2.1, t.2.2].F Triple[t.1, t.2.1, t.2.2].f0 LP.eps)
        (At[t.1, t.2.1, t.2.2, dl].rFt) ;
    marked : MK.Marked u = LM.At[u].from-loop lmarked ;
  } ;
  marked (u : DE.SC4) : MK.Marked u = AtU[u].marked ;

  -- pi_4(S^3) = Z/2: both instances of M from marked
  module Assemble (TR : S3T.Interfaces4[S3, base].Trunc4) {
    uT : DE.SC4 = (TR.T, TR.t0, (TR.connT, TR.truncT)) ;
    uBR : DE.SC4 = (DR.BR, DR.br0, (DR.BR-conn, DR.BR-trunc)) ;
    sT : isEquiv (HC DR.BR DR.br0 TR.T TR.t0) (HC S3 base TR.T TR.t0) (\ c -> compC S3 base DR.BR DR.br0 TR.T TR.t0 FS.s c) = marked uT ;
    sP : isEquiv (HC DR.BR DR.br0 DR.BR DR.br0) (HC S3 base DR.BR DR.br0) (\ b -> compC S3 base DR.BR DR.br0 DR.BR DR.br0 FS.s b) = marked uBR ;
    module A2 = PS4.Two4[S3, base, TR, DR.BR, DR.br0, DR.BR-trunc, FS.s, sP, sT] ;
    pi4-S3 : GIso[S3T.pi4 S3 base, ab-grp Z2ab] =
      gi-comp (S3T.pi4 S3 base) (S3T.pi4 DR.BR DR.br0) (ab-grp Z2ab) A2.iso-S3-P PS4.pi4-BR ;
  } ;
  pi4-S3 : GIso[S3T.pi4 S3 base, ab-grp Z2ab] = Assemble[S3T.Sphere3Trunc[S3, base, surf, ump3].trunc4].pi4-S3 ;
} ;
