-- The cup square kappa : K(Z,2) ->pt K(Z,4) by delooping (doc/cup-square.pdf).
--   contr-at      a contractible type with a chosen centre
--   PtMapLoops    Lemma 1: for M = Map_*(X, Y) pointed by pt0 = (\ _ -> y0, refl),
--                 ev : Omega M ~pt Map_*(X, Omega Y), ev refl = r by definition:
--                 transport of r along P, with R G = (H : Pi x, y0 = G x) * (H x0 . G.2 = refl)
--                 (R pt0 is Map_*(X, Omega Y) by definition), the total space T being
--                 contractible: T <| (s : S) * W s, S <| Pi x (y : Y) * (y0 = y) (wfe),
--                 recentred at s0 = (\ _ -> y0, \ _ -> refl), W s0 <| a singleton
--                 (trans-equiv along refl . w = w); ev-ap: ev evaluates pointwise;
--                 ev-unev: ev o unev = id (then unev is locked)
--   iota          Construction 2: the inverse of Omega^2 K(Z,4) ~ Omega K(Z,3) ~ K(Z,2)
--   c1            Construction 3: ev_o^-1 (ev^-1 iota), by the circle property; c1-ev
--   c2            Construction 4: the delooping (Cor. 11, c = 1) of f = e1 ; c1 ; ev^-1,
--                 c2-loop : f = loop c2 (c1, c2 locked after c1-ev, c2-loop)
--   cup-norm      Theorem 6: ev (ev_o (e1^-1 ; loop c2 ; ev)) = iota (homotopic maps
--                 have conjugate loopings; loops of M(Omega K4) ~ Omega M(K4) commute)
--   kappa         Definition 5: kappa x = (c2 x) x, pointed by the pointing of c2 x0
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ; open HLevels[l] ;
open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ; open Retracts[l] ; open LoopCalc[l] ;
open EMMaps[l] ; open AbHom[l] ; open SphereUniversal[l] ; open PostnikovRealization[l] ; open KZ2Cohomology[l] ;
module CP = CircleProperty[l] ;

contr-at (A : U l) (c : isContr A) (a : A) : isContr A = (a, \ z -> pathC A c a z) ;

------------------------------------------------------------------------
-- Lemma 1: loops of a pointed mapping type

module PtMapLoops (X : U l) (x0 : X) (Y : U l) (y0 : Y) {
  pt0 : PtMap X x0 Y y0 = (\ x -> y0, refl y0) ;
  R (G : PtMap X x0 Y y0) : U l =
    (H : (x : X) -> Id Y y0 (G.1 x)) * Id (Id Y y0 y0) (trans Y y0 (G.1 x0) y0 (H x0) G.2) (refl y0) ;
  r : PtMap X x0 (Id Y y0 y0) (refl y0) = (\ x -> refl y0, refl (refl y0)) ;
  -- by definition (trans p refl is p)
  R-pt0 : Id (U l) (R pt0) (PtMap X x0 (Id Y y0 y0) (refl y0)) = refl (R pt0) ;

  S : U l = (k : X -> Y) * ((x : X) -> Id Y y0 (k x)) ;
  s0 : S = (\ x -> y0, \ x -> refl y0) ;
  W (s : S) : U l = (w : Id Y (s.1 x0) y0) * Id (Id Y y0 y0) (trans Y y0 (s.1 x0) y0 (s.2 x0) w) (refl y0) ;
  S-rt : Retract[S, (x : X) -> (y : Y) * Id Y y0 y] =
    new Retract[S, (x : X) -> (y : Y) * Id Y y0 y, \ s x -> (s.1 x, s.2 x), \ v -> (\ x -> (v x).1, \ x -> (v x).2), \ s -> refl s] ;
  S-contr : isContr S =
    contr-at S (rt-trunc zero S ((x : X) -> (y : Y) * Id Y y0 y) S-rt
                  (FE[univ @l].wfe X (\ x -> (y : Y) * Id Y y0 y) (\ x -> singL Y y0))) s0 ;
  W0-rt : Retract[W s0, (w : Id Y y0 y0) * Id (Id Y y0 y0) w (refl y0)] =
    rt-Sigma (Id Y y0 y0) (\ w -> Id (Id Y y0 y0) (trans Y y0 y0 y0 (refl y0) w) (refl y0)) (\ w -> Id (Id Y y0 y0) w (refl y0))
      (\ w -> CP.rt-equiv (Id (Id Y y0 y0) (trans Y y0 y0 y0 (refl y0) w) (refl y0)) (Id (Id Y y0 y0) w (refl y0))
                 (Fibres[l].trans-equiv (Id Y y0 y0) w (trans Y y0 y0 y0 (refl y0) w) (refl y0)
                    (sym (Id Y y0 y0) (trans Y y0 y0 y0 (refl y0) w) w (trans-refl-l Y y0 y0 w)))) ;
  T-rt : Retract[(G : PtMap X x0 Y y0) * R G, (s : S) * W s] =
    new Retract[(G : PtMap X x0 Y y0) * R G, (s : S) * W s,
      \ v -> ((v.1.1, v.2.1), (v.1.2, v.2.2)), \ u -> ((u.1.1, u.2.1), (u.1.2, u.2.2)), \ v -> refl v] ;
  T-contr : isContr ((G : PtMap X x0 Y y0) * R G) =
    rt-trunc zero ((G : PtMap X x0 Y y0) * R G) ((s : S) * W s) T-rt
      (trunc-Sigma-contr zero S W S-contr
         (rt-trunc zero (W s0) ((w : Id Y y0 y0) * Id (Id Y y0 y0) w (refl y0)) W0-rt (sing (Id Y y0 y0) (refl y0)))) ;

  module FT = FundThm[l].FT[PtMap X x0 Y y0, pt0, R, r, T-contr] ;
  ev (P : Id (PtMap X x0 Y y0) pt0 pt0) : PtMap X x0 (Id Y y0 y0) (refl y0) = FT.tr pt0 P ;
  -- ev evaluates a path of pointed maps pointwise
  ev-ap (G : PtMap X x0 Y y0) (P : Id (PtMap X x0 Y y0) pt0 G) (x : X) :
    Id (Id Y y0 (G.1 x)) ((FT.tr G P).1 x) (ap (PtMap X x0 Y y0) Y (\ F -> F.1 x) pt0 G P) =
    idJ (PtMap X x0 Y y0) pt0 (\ G1 P1 -> Id (Id Y y0 (G1.1 x)) ((FT.tr G1 P1).1 x) (ap (PtMap X x0 Y y0) Y (\ F -> F.1 x) pt0 G1 P1))
      (refl (refl y0)) G P ;
  ev-pt : PtEquiv (Id (PtMap X x0 Y y0) pt0 pt0) (refl pt0) (PtMap X x0 (Id Y y0 y0) (refl y0)) r =
    ((ev, refl r), FT.equiv pt0) ;
  unev : PtMap (PtMap X x0 (Id Y y0 y0) (refl y0)) r (Id (PtMap X x0 Y y0) pt0 pt0) (refl pt0) =
    (pt-inv (Id (PtMap X x0 Y y0) pt0 pt0) (refl pt0) (PtMap X x0 (Id Y y0 y0) (refl y0)) r ev-pt).1 ;
  -- by definition of pt-inv, Acc and ev-pt
  unev-un (m : PtMap X x0 (Id Y y0 y0) (refl y0)) : Id (Id (PtMap X x0 Y y0) pt0 pt0) (unev.1 m) (FT.un pt0 m) =
    calc (Id (PtMap X x0 Y y0) pt0 pt0) {
      unev.1 m =< refl (unev.1 m) >
      Acc[Id (PtMap X x0 Y y0) pt0 pt0, refl pt0, PtMap X x0 (Id Y y0 y0) (refl y0), r, ev-pt].inv m
        =< refl (Acc[Id (PtMap X x0 Y y0) pt0 pt0, refl pt0, PtMap X x0 (Id Y y0 y0) (refl y0), r, ev-pt].inv m) >
      ev-pt.2.sec m =< refl (ev-pt.2.sec m) >
      FT.un pt0 m } ;
  ev-unev (m : PtMap X x0 (Id Y y0 y0) (refl y0)) : Id (PtMap X x0 (Id Y y0 y0) (refl y0)) (ev (unev.1 m)) m =
    transH (apH ev (unev-un m)) (FT.tr-un pt0 m) ;
  -- locked after its characterising lemmas
  opaque unev ;
} ;

------------------------------------------------------------------------
-- Constructions 2-4 and Definition 5, for X = K(Z,2)

module KZ = KK[Zab] ;
module LO = PtMapLoops[KZ2, kz2, Id KZ4 kz4 kz4, refl kz4] ;
module L4 = PtMapLoops[KZ2, kz2, KZ4, kz4] ;
module C = CP.Circle[PtMap KZ2 kz2 (Id KZ4 kz4 kz4) (refl kz4)] ;

-- Construction 2: the fundamental class
iota-eq : PtEquiv (Id (Id KZ4 kz4 kz4) (refl kz4) (refl kz4)) (refl (refl kz4)) KZ2 kz2 =
  pt-comp (Id (Id KZ4 kz4 kz4) (refl kz4) (refl kz4)) (refl (refl kz4)) (Id (KZ.K three) (KZ.pt three) (KZ.pt three)) (refl (KZ.pt three)) KZ2 kz2
    (LoopIso[l].loopPE (Id KZ4 kz4 kz4) (refl kz4) (KZ.K three) (KZ.pt three) (KZ.e three)) (KZ.e two) ;
iota : PtMap KZ2 kz2 (Id (Id KZ4 kz4 kz4) (refl kz4) (refl kz4)) (refl (refl kz4)) =
  (pt-inv (Id (Id KZ4 kz4 kz4) (refl kz4) (refl kz4)) (refl (refl kz4)) KZ2 kz2 iota-eq).1 ;

-- Construction 3: level one, by the circle property
ell : Id (PtMap KZ2 kz2 (Id KZ4 kz4 kz4) (refl kz4)) LO.pt0 LO.pt0 = LO.unev.1 iota ;
ell-ev : Id (PtMap KZ2 kz2 (Id (Id KZ4 kz4 kz4) (refl kz4) (refl kz4)) (refl (refl kz4))) (LO.ev ell) iota =
  LO.ev-unev iota ;
c1 : PtMap C.Z1.K1 C.Z1.k0 (PtMap KZ2 kz2 (Id KZ4 kz4 kz4) (refl kz4)) LO.pt0 = (C.pointed-equiv LO.pt0).2.sec ell ;
c1-ev : Id (Id (PtMap KZ2 kz2 (Id KZ4 kz4 kz4) (refl kz4)) LO.pt0 LO.pt0) (C.evPt LO.pt0 c1) ell =
  (C.pointed-equiv LO.pt0).2.sec-eq ell ;
opaque c1 ;

-- Construction 4: level two, by delooping
-- e_1 at the types of the text; only used as a pointed equivalence, so locked
e1 : PtEquiv (Id KZ2 kz2 kz2) (refl kz2) C.Z1.K1 C.Z1.k0 = KZ.e (suc zero) ;
-- by definition (doc/cross-term.pdf, Lemma E2): e_1 is KK.e 1, stated before the lock
e1-def : Id (PtEquiv (Id KZ2 kz2 kz2) (refl kz2) C.Z1.K1 C.Z1.k0) e1 (KZ.e (suc zero)) = refl e1 ;
opaque e1 ;
f : Maps[KZ2, kz2, PtMap KZ2 kz2 KZ4 kz4, L4.pt0].PMO =
  ptcomp (Id KZ2 kz2 kz2) (refl kz2) (PtMap KZ2 kz2 (Id KZ4 kz4 kz4) (refl kz4)) LO.pt0 (Id (PtMap KZ2 kz2 KZ4 kz4) L4.pt0 L4.pt0) (refl L4.pt0)
    (ptcomp (Id KZ2 kz2 kz2) (refl kz2) C.Z1.K1 C.Z1.k0 (PtMap KZ2 kz2 (Id KZ4 kz4 kz4) (refl kz4)) LO.pt0 e1.1 c1)
    L4.unev ;
tM4 : isTrunc four (PtMap KZ2 kz2 KZ4 kz4) = cor5-map four two KZ2 kz2 (KZ.conn (suc zero)) KZ4 kz4 (KZ.trunc three) ;
module MO = Maps[KZ2, kz2, PtMap KZ2 kz2 KZ4 kz4, L4.pt0].Over[f] ;
cell : isContr MO.Unloop = MO.cor11 (suc zero) (KZ.conn (suc zero)) tM4 ;
c2 : PtMap KZ2 kz2 (PtMap KZ2 kz2 KZ4 kz4) L4.pt0 = cell.1.1 ;
c2-loop : Id (Maps[KZ2, kz2, PtMap KZ2 kz2 KZ4 kz4, L4.pt0].PMO) f (Maps[KZ2, kz2, PtMap KZ2 kz2 KZ4 kz4, L4.pt0].loop c2) = cell.1.2 ;
opaque c2 ;

-- Definition 5: the cup square
kappa : PtMap KZ2 kz2 KZ4 kz4 = (\ x -> (c2.1 x).1 x, (c2.1 kz2).2) ;

------------------------------------------------------------------------
-- Theorem 6: the normalisation of c2

e1inv : PtMap C.Z1.K1 C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) =
  (pt-inv (Id KZ2 kz2 kz2) (refl kz2) C.Z1.K1 C.Z1.k0 e1).1 ;
-- by definition of pt-inv and Acc, e1inv is the section of e1
e1-back (k : C.Z1.K1) : Id C.Z1.K1 (e1.1.1 (e1inv.1 k)) k =
  calc C.Z1.K1 {
    e1.1.1 (e1inv.1 k) =< refl (e1.1.1 (e1inv.1 k)) >
    e1.1.1 (e1.2.sec k) =< e1.2.sec-eq k >
    k } ;
-- c2 looped and read through e1 and ev
c1bar : PtMap C.Z1.K1 C.Z1.k0 (PtMap KZ2 kz2 (Id KZ4 kz4 kz4) (refl kz4)) LO.pt0 =
  ptcomp C.Z1.K1 C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) (PtMap KZ2 kz2 (Id KZ4 kz4 kz4) (refl kz4)) LO.pt0 e1inv
    (ptcomp (Id KZ2 kz2 kz2) (refl kz2) (Id (PtMap KZ2 kz2 KZ4 kz4) L4.pt0 L4.pt0) (refl L4.pt0) (PtMap KZ2 kz2 (Id KZ4 kz4 kz4) (refl kz4)) LO.pt0
       (Maps[KZ2, kz2, PtMap KZ2 kz2 KZ4 kz4, L4.pt0].loop c2) L4.ev-pt.1) ;
-- c1bar and c1 are homotopic (unpointed)
c1bar-hom (k : C.Z1.K1) : Id (PtMap KZ2 kz2 (Id KZ4 kz4 kz4) (refl kz4)) (c1bar.1 k) (c1.1 k) =
  calc (PtMap KZ2 kz2 (Id KZ4 kz4 kz4) (refl kz4)) {
    c1bar.1 k
      =< refl (c1bar.1 k) >
    L4.ev ((Maps[KZ2, kz2, PtMap KZ2 kz2 KZ4 kz4, L4.pt0].loop c2).1 (e1inv.1 k))
      =< apH L4.ev (symH (Puppe[l].pt-happly (Id KZ2 kz2 kz2) (refl kz2) (Id (PtMap KZ2 kz2 KZ4 kz4) L4.pt0 L4.pt0) (refl L4.pt0)
            f (Maps[KZ2, kz2, PtMap KZ2 kz2 KZ4 kz4, L4.pt0].loop c2) c2-loop (e1inv.1 k))) >
    L4.ev (f.1 (e1inv.1 k))
      =< refl (L4.ev (f.1 (e1inv.1 k))) >
    L4.ev (L4.unev.1 (c1.1 (e1.1.1 (e1inv.1 k))))
      =< L4.ev-unev (c1.1 (e1.1.1 (e1inv.1 k))) >
    c1.1 (e1.1.1 (e1inv.1 k))
      =< apH c1.1 (e1-back k) >
    c1.1 k } ;
-- loops of M(Omega K4) ~pt Omega M(K4) commute, so conjugation is trivial
module AB = EH[l].Abelian[PtMap KZ2 kz2 KZ4 kz4, L4.pt0, PtMap KZ2 kz2 (Id KZ4 kz4 kz4) (refl kz4), LO.pt0, L4.ev-pt] ;
conj-triv (c u : Id (PtMap KZ2 kz2 (Id KZ4 kz4 kz4) (refl kz4)) LO.pt0 LO.pt0) :
  Id (Id (PtMap KZ2 kz2 (Id KZ4 kz4 kz4) (refl kz4)) LO.pt0 LO.pt0) (LoopConj[l].conj (PtMap KZ2 kz2 (Id KZ4 kz4 kz4) (refl kz4)) LO.pt0 LO.pt0 c u) u =
  calc (Id (PtMap KZ2 kz2 (Id KZ4 kz4 kz4) (refl kz4)) LO.pt0 LO.pt0) {
    LoopConj[l].conj (PtMap KZ2 kz2 (Id KZ4 kz4 kz4) (refl kz4)) LO.pt0 LO.pt0 c u
      =< refl (LoopConj[l].conj (PtMap KZ2 kz2 (Id KZ4 kz4 kz4) (refl kz4)) LO.pt0 LO.pt0 c u) >
    AB.PY.comp (AB.PY.rev c) (AB.PY.comp u c)
      =< apH (AB.PY.comp (AB.PY.rev c)) (AB.comm u c) >
    AB.PY.comp (AB.PY.rev c) (AB.PY.comp c u)
      =< trans-cancel (PtMap KZ2 kz2 (Id KZ4 kz4 kz4) (refl kz4)) LO.pt0 LO.pt0 LO.pt0 c u >
    u } ;
module LH = LoopConj[l].LoopHomotopy[C.Z1.K1, C.Z1.k0, PtMap KZ2 kz2 (Id KZ4 kz4 kz4) (refl kz4), LO.pt0, c1, c1bar,
  \ k -> symH (c1bar-hom k)] ;
-- looping c2, applying the mapping-loop equivalences, evaluating at g gives iota
cup-norm : Id (PtMap KZ2 kz2 (Id (Id KZ4 kz4 kz4) (refl kz4) (refl kz4)) (refl (refl kz4))) (LO.ev (C.evPt LO.pt0 c1bar)) iota =
  calc (PtMap KZ2 kz2 (Id (Id KZ4 kz4 kz4) (refl kz4) (refl kz4)) (refl (refl kz4))) {
    LO.ev (C.evPt LO.pt0 c1bar)
      =< apH LO.ev (C.evPt-loop LO.pt0 c1bar) >
    LO.ev ((Maps[C.Z1.K1, C.Z1.k0, PtMap KZ2 kz2 (Id KZ4 kz4 kz4) (refl kz4), LO.pt0].loop c1bar).1 C.g)
      =< apH LO.ev (LH.loop-homotopy C.g) >
    LO.ev (LoopConj[l].conj (PtMap KZ2 kz2 (Id KZ4 kz4 kz4) (refl kz4)) LO.pt0 LO.pt0 LH.c
             ((Maps[C.Z1.K1, C.Z1.k0, PtMap KZ2 kz2 (Id KZ4 kz4 kz4) (refl kz4), LO.pt0].loop c1).1 C.g))
      =< apH LO.ev (conj-triv LH.c ((Maps[C.Z1.K1, C.Z1.k0, PtMap KZ2 kz2 (Id KZ4 kz4 kz4) (refl kz4), LO.pt0].loop c1).1 C.g)) >
    LO.ev ((Maps[C.Z1.K1, C.Z1.k0, PtMap KZ2 kz2 (Id KZ4 kz4 kz4) (refl kz4), LO.pt0].loop c1).1 C.g)
      =< apH LO.ev (symH (C.evPt-loop LO.pt0 c1)) >
    LO.ev (C.evPt LO.pt0 c1)
      =< apH LO.ev c1-ev >
    LO.ev ell
      =< ell-ev >
    iota } ;
