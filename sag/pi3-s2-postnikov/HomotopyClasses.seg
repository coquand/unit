-- Pointed homotopy classes [X, Y]_* (milestone A): the SET truncation of
-- the type of pointed maps, i.e. its quotient (Quotient, by replacement)
-- by mere equality.  Not the type of pointed maps, nor its propositional
-- truncation.  Pointed paths (paths in PtMap, which carry the coherence
-- at the base point) are the identifications used throughout.
--   STr A          the set truncation of A: inc, set, lift into sets,
--                  equality of classes is mere equality (effective)
--   HC X Y         [X, Y]_* = STr (PtMap X Y)
--   compC          composition of classes, by descent in both arguments;
--                  comp-beta  [F] ; [G] = [F ; G]
--   idC, comp-assoc, comp-idl, comp-idr     the category laws on classes
--                  (from LoopCalc.ptcomp-assoc, Fibres.ptcomp-idl/-idr)
--   classes-equiv  an equivalence of mapping types gives one of classes
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Lemma4[l] ; open LoopCalc[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;

module STr (A : U l) {
  Same (a b : A) : U l = Tr.Trunc[Id A a b].carrier ;
  same-prop (a b : A) : isProp (Same a b) = Tr.Trunc[Id A a b].proposition ;
  same-refl (a : A) : Same a a = Tr.Trunc[Id A a a].inc (refl a) ;
  same-sym (a b : A) (h : Same a b) : Same b a = TC.map (Id A a b) (Id A b a) (sym A a b) h ;
  same-trans (a b c : A) (h : Same a b) (k : Same b c) : Same a c = TC.map2 (Id A a b) (Id A b c) (Id A a c) (trans A a b c) h k ;
  module Q = Quotient[l].Quot[A, Same, same-prop, same-refl, same-sym, same-trans] ;
  C : U l = Q.Q ;
  inc (a : A) : C = Q.inc a ;
  set : isSet C = Q.set ;
  inc-eq (a b : A) (p : Id A a b) : Id C (inc a) (inc b) = Q.relates a b (Tr.Trunc[Id A a b].inc p) ;
  effective (a b : A) (p : Id C (inc a) (inc b)) : Same a b = Q.effective a b p ;
  ind : [j] (P : C -> U j) -> ((c : C) -> Prelude[j].isProp (P c)) -> ((a : A) -> P (inc a)) -> (c : C) -> P c =
    <j> \ P p b -> Q.induction @j P p b ;
  -- maps into sets descend
  module Lift (B : U l) (sB : isSet B) (f : A -> B) {
    respect (a b : A) (h : Same a b) : Id B (f a) (f b) =
      Tr.Trunc[Id A a b].induction @l (\ t -> Id B (f a) (f b)) (\ t -> sB (f a) (f b)) (ap A B f a b) h ;
    module D = Q.Descend[B, sB, f, respect] ;
    map (c : C) : B = D.map c ;
    beta (a : A) : Id B (map (inc a)) (f a) = D.beta a ;
  } ;
  -- two maps out of the classes into a set agreeing on representatives
  ext (B : U l) (sB : isSet B) (g h : C -> B) (e : (a : A) -> Id B (g (inc a)) (h (inc a))) (c : C) : Id B (g c) (h c) =
    ind @l (\ c1 -> Id B (g c1) (h c1)) (\ c1 -> sB (g c1) (h c1)) e c ;
} ;

-- the map of set truncations
module STrMap (A B : U l) (f : A -> B) {
  module SA = STr[A] ; module SB = STr[B] ;
  module L = SA.Lift[SB.C, SB.set, \ a -> SB.inc (f a)] ;
  map (c : SA.C) : SB.C = L.map c ;
  beta (a : A) : Id SB.C (map (SA.inc a)) (SB.inc (f a)) = L.beta a ;
} ;

-- an equivalence induces an equivalence of set truncations
classes-equiv (A B : U l) (f : A -> B) (e : isEquiv A B f) : isEquiv STr[A].C STr[B].C STrMap[A, B, f].map =
  qinv STr[A].C STr[B].C STrMap[A, B, f].map STrMap[B, A, e.sec].map
    (STr[B].ext STr[B].C STr[B].set (\ c -> STrMap[A, B, f].map (STrMap[B, A, e.sec].map c)) (\ c -> c) (\ b ->
       transH (apH STrMap[A, B, f].map (STrMap[B, A, e.sec].beta b))
         (transH (STrMap[A, B, f].beta (e.sec b)) (STr[B].inc-eq (f (e.sec b)) b (e.sec-eq b)))))
    (STr[A].ext STr[A].C STr[A].set (\ c -> STrMap[B, A, e.sec].map (STrMap[A, B, f].map c)) (\ c -> c) (\ a ->
       transH (apH STrMap[B, A, e.sec].map (STrMap[A, B, f].beta a))
         (transH (STrMap[B, A, e.sec].beta (f a)) (STr[A].inc-eq (e.sec (f a)) a (sec-ret A B f e a))))) ;

-- an equivalence of sets is injective
equiv-inj (A B : U l) (f : A -> B) (e : isEquiv A B f) (a b : A) (p : Id B (f a) (f b)) : Id A a b =
  Equivalences[l].injective A B f e a b p ;

------------------------------------------------------------------------
-- [X, Y]_*

HC (X : U l) (x0 : X) (Y : U l) (y0 : Y) : U l = STr[PtMap X x0 Y y0].C ;
hcl (X : U l) (x0 : X) (Y : U l) (y0 : Y) (F : PtMap X x0 Y y0) : HC X x0 Y y0 = STr[PtMap X x0 Y y0].inc F ;
hc-set (X : U l) (x0 : X) (Y : U l) (y0 : Y) : isSet (HC X x0 Y y0) = STr[PtMap X x0 Y y0].set ;

module Comp (X : U l) (x0 : X) (Y : U l) (y0 : Y) (Z : U l) (z0 : Z) {
  module SXY = STr[PtMap X x0 Y y0] ; module SYZ = STr[PtMap Y y0 Z z0] ; module SXZ = STr[PtMap X x0 Z z0] ;
  -- precomposition by a class, for a fixed second map
  module Pre (G : PtMap Y y0 Z z0) {
    module L = SXY.Lift[SXZ.C, SXZ.set, \ F -> SXZ.inc (ptcomp X x0 Y y0 Z z0 F G)] ;
    map (c : SXY.C) : SXZ.C = L.map c ;
    beta (F : PtMap X x0 Y y0) : Id SXZ.C (map (SXY.inc F)) (SXZ.inc (ptcomp X x0 Y y0 Z z0 F G)) = L.beta F ;
  } ;
  FS : U l = SXY.C -> SXZ.C ;
  fs-set : isSet FS = FL.isSet-Pi SXY.C (\ c -> SXZ.C) (\ c -> SXZ.set) ;
  module Post = SYZ.Lift[FS, fs-set, \ G -> Pre[G].map] ;
  compC (a : SXY.C) (b : SYZ.C) : SXZ.C = Post.map b a ;
  comp-beta (F : PtMap X x0 Y y0) (G : PtMap Y y0 Z z0) :
    Id SXZ.C (compC (SXY.inc F) (SYZ.inc G)) (SXZ.inc (ptcomp X x0 Y y0 Z z0 F G)) =
    transH (happly SXY.C (\ c -> SXZ.C) (Post.map (SYZ.inc G)) Pre[G].map (Post.beta G) (SXY.inc F)) (Pre[G].beta F) ;
} ;

compC (X : U l) (x0 : X) (Y : U l) (y0 : Y) (Z : U l) (z0 : Z) (a : HC X x0 Y y0) (b : HC Y y0 Z z0) : HC X x0 Z z0 =
  Comp[X, x0, Y, y0, Z, z0].compC a b ;
comp-beta (X : U l) (x0 : X) (Y : U l) (y0 : Y) (Z : U l) (z0 : Z) (F : PtMap X x0 Y y0) (G : PtMap Y y0 Z z0) :
  Id (HC X x0 Z z0) (compC X x0 Y y0 Z z0 (hcl X x0 Y y0 F) (hcl Y y0 Z z0 G)) (hcl X x0 Z z0 (ptcomp X x0 Y y0 Z z0 F G)) =
  Comp[X, x0, Y, y0, Z, z0].comp-beta F G ;

-- locked after its characterising lemma comp-beta
opaque compC ;

idC (X : U l) (x0 : X) : HC X x0 X x0 = hcl X x0 X x0 (ptid X x0) ;

comp-assoc (X : U l) (x0 : X) (Y : U l) (y0 : Y) (Z : U l) (z0 : Z) (W : U l) (w0 : W)
  (a : HC X x0 Y y0) (b : HC Y y0 Z z0) (c : HC Z z0 W w0) :
  Id (HC X x0 W w0) (compC X x0 Z z0 W w0 (compC X x0 Y y0 Z z0 a b) c) (compC X x0 Y y0 W w0 a (compC Y y0 Z z0 W w0 b c)) =
  STr[PtMap X x0 Y y0].ind @l (\ a1 -> Id (HC X x0 W w0) (compC X x0 Z z0 W w0 (compC X x0 Y y0 Z z0 a1 b) c) (compC X x0 Y y0 W w0 a1 (compC Y y0 Z z0 W w0 b c)))
    (\ a1 -> hc-set X x0 W w0 _ _) (\ F ->
  STr[PtMap Y y0 Z z0].ind @l (\ b1 -> Id (HC X x0 W w0) (compC X x0 Z z0 W w0 (compC X x0 Y y0 Z z0 (hcl X x0 Y y0 F) b1) c) (compC X x0 Y y0 W w0 (hcl X x0 Y y0 F) (compC Y y0 Z z0 W w0 b1 c)))
    (\ b1 -> hc-set X x0 W w0 _ _) (\ G ->
  STr[PtMap Z z0 W w0].ind @l (\ c1 -> Id (HC X x0 W w0) (compC X x0 Z z0 W w0 (compC X x0 Y y0 Z z0 (hcl X x0 Y y0 F) (hcl Y y0 Z z0 G)) c1) (compC X x0 Y y0 W w0 (hcl X x0 Y y0 F) (compC Y y0 Z z0 W w0 (hcl Y y0 Z z0 G) c1)))
    (\ c1 -> hc-set X x0 W w0 _ _) (\ H -> calc (HC X x0 W w0) {
      compC X x0 Z z0 W w0 (compC X x0 Y y0 Z z0 (hcl X x0 Y y0 F) (hcl Y y0 Z z0 G)) (hcl Z z0 W w0 H)
        =< apH (\ u -> compC X x0 Z z0 W w0 u (hcl Z z0 W w0 H)) (comp-beta X x0 Y y0 Z z0 F G) >
      compC X x0 Z z0 W w0 (hcl X x0 Z z0 (ptcomp X x0 Y y0 Z z0 F G)) (hcl Z z0 W w0 H)
        =< comp-beta X x0 Z z0 W w0 (ptcomp X x0 Y y0 Z z0 F G) H >
      hcl X x0 W w0 (ptcomp X x0 Z z0 W w0 (ptcomp X x0 Y y0 Z z0 F G) H)
        =< apH (hcl X x0 W w0) (ptcomp-assoc X x0 Y y0 Z z0 W w0 F G H) >
      hcl X x0 W w0 (ptcomp X x0 Y y0 W w0 F (ptcomp Y y0 Z z0 W w0 G H))
        =< symH (comp-beta X x0 Y y0 W w0 F (ptcomp Y y0 Z z0 W w0 G H)) >
      compC X x0 Y y0 W w0 (hcl X x0 Y y0 F) (hcl Y y0 W w0 (ptcomp Y y0 Z z0 W w0 G H))
        =< symH (apH (compC X x0 Y y0 W w0 (hcl X x0 Y y0 F)) (comp-beta Y y0 Z z0 W w0 G H)) >
      compC X x0 Y y0 W w0 (hcl X x0 Y y0 F) (compC Y y0 Z z0 W w0 (hcl Y y0 Z z0 G) (hcl Z z0 W w0 H)) }) c) b) a ;

comp-idl (X : U l) (x0 : X) (Y : U l) (y0 : Y) (a : HC X x0 Y y0) :
  Id (HC X x0 Y y0) (compC X x0 X x0 Y y0 (idC X x0) a) a =
  STr[PtMap X x0 Y y0].ind @l (\ a1 -> Id (HC X x0 Y y0) (compC X x0 X x0 Y y0 (idC X x0) a1) a1) (\ a1 -> hc-set X x0 Y y0 _ _)
    (\ F -> transH (comp-beta X x0 X x0 Y y0 (ptid X x0) F) (apH (hcl X x0 Y y0) (Fibres[l].ptcomp-idl X x0 Y y0 F))) a ;

comp-idr (X : U l) (x0 : X) (Y : U l) (y0 : Y) (a : HC X x0 Y y0) :
  Id (HC X x0 Y y0) (compC X x0 Y y0 Y y0 a (idC Y y0)) a =
  STr[PtMap X x0 Y y0].ind @l (\ a1 -> Id (HC X x0 Y y0) (compC X x0 Y y0 Y y0 a1 (idC Y y0)) a1) (\ a1 -> hc-set X x0 Y y0 _ _)
    (\ F -> transH (comp-beta X x0 Y y0 Y y0 F (ptid Y y0)) (apH (hcl X x0 Y y0) (Fibres[l].ptcomp-idr X x0 Y y0 F))) a ;

-- precomposition by a map, on classes, is the map of set truncations of
-- precomposition on pointed maps
pre-cls (X : U l) (x0 : X) (Y : U l) (y0 : Y) (Z : U l) (z0 : Z) (F : PtMap X x0 Y y0) (b : HC Y y0 Z z0) :
  Id (HC X x0 Z z0) (compC X x0 Y y0 Z z0 (hcl X x0 Y y0 F) b)
    (STrMap[PtMap Y y0 Z z0, PtMap X x0 Z z0, \ G -> ptcomp X x0 Y y0 Z z0 F G].map b) =
  STr[PtMap Y y0 Z z0].ext (HC X x0 Z z0) (hc-set X x0 Z z0)
    (\ b1 -> compC X x0 Y y0 Z z0 (hcl X x0 Y y0 F) b1)
    (STrMap[PtMap Y y0 Z z0, PtMap X x0 Z z0, \ G -> ptcomp X x0 Y y0 Z z0 F G].map)
    (\ G -> transH (comp-beta X x0 Y y0 Z z0 F G) (symH (STrMap[PtMap Y y0 Z z0, PtMap X x0 Z z0, \ G1 -> ptcomp X x0 Y y0 Z z0 F G1].beta G))) b ;

-- if precomposition by F is an equivalence of mapping types, precomposition
-- by [F] is an equivalence of classes
pre-equiv (X : U l) (x0 : X) (Y : U l) (y0 : Y) (Z : U l) (z0 : Z) (F : PtMap X x0 Y y0)
  (e : isEquiv (PtMap Y y0 Z z0) (PtMap X x0 Z z0) (\ G -> ptcomp X x0 Y y0 Z z0 F G)) :
  isEquiv (HC Y y0 Z z0) (HC X x0 Z z0) (\ b -> compC X x0 Y y0 Z z0 (hcl X x0 Y y0 F) b) =
  Equivalences[l].homotopy (HC Y y0 Z z0) (HC X x0 Z z0)
    (STrMap[PtMap Y y0 Z z0, PtMap X x0 Z z0, \ G -> ptcomp X x0 Y y0 Z z0 F G].map,
     classes-equiv (PtMap Y y0 Z z0) (PtMap X x0 Z z0) (\ G -> ptcomp X x0 Y y0 Z z0 F G) e)
    (\ b -> compC X x0 Y y0 Z z0 (hcl X x0 Y y0 F) b) (pre-cls X x0 Y y0 Z z0 F) ;
