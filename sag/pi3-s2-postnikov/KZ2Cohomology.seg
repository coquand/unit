-- Milestone D: the cohomology input, as STATEMENTS only (records).  Nothing
-- here is assumed by the Theory; these are the open obligations, stated
-- precisely so that a construction can be checked against them.
--   kappa : K(Z,2) ->pt K(Z,4) is CONSTRUCTED: CupSquare.kappa, the cup
--     square (doc/cup-square.pdf; normalised by CupSquare.cup-norm);
--   H4 kappa : for every abelian group B,
--       Phi_B : Hom_Ab(Z, B) -> [K(Z,2), K(B,4)]_*,   g |-> [kappa ; K(g,4)]
--     is an equivalence (for THIS kappa and the coefficient changes K(g,4));
--   H3 : for every abelian group B, [K(Z,2), K(B,3)]_* is contractible.
-- H3 = 0 does NOT make the type of pointed homotopies contractible; it
-- only makes the SET of classes a point.  Status: H3 is PROVED in
-- H3Proof.h3 (doc/circle-torsors.pdf: the circle property of K(Z,1));
-- H4 CupSquare.kappa is PROVED in H4Proof.h4 (doc/h4.pdf; every abelian B,
-- B = Z/2 included).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Lemma4[l] ; open LoopCalc[l] ;
open Torsor[l] ; open HomotopyClasses[l] ; open SphereUniversal[l] ; open PostnikovRealization[l] ;
open EMMaps[l] ; open AbHom[l] ;
module ZZ = Integers[l] ;

Zab : Ab = ZZ.intAb ;

KZ2 : U l = KK[Zab].K two ;
kz2 : KZ2 = KK[Zab].pt two ;
KZ4 : U l = KK[Zab].K four ;
kz4 : KZ4 = KK[Zab].pt four ;

Phi (kappa : PtMap KZ2 kz2 KZ4 kz4) (Gb : Ab) (g : Hom Zab Gb) : HC KZ2 kz2 (KK[Gb].K four) (KK[Gb].pt four) =
  hcl KZ2 kz2 (KK[Gb].K four) (KK[Gb].pt four) (ptcomp KZ2 kz2 KZ4 kz4 (KK[Gb].K four) (KK[Gb].pt four) kappa (KMap[Zab, Gb, g].K four)) ;

H4 (kappa : PtMap KZ2 kz2 KZ4 kz4) : U l+ =
  (Gb : Ab) -> isEquiv (Hom Zab Gb) (HC KZ2 kz2 (KK[Gb].K four) (KK[Gb].pt four)) (Phi kappa Gb) ;

H3 : U l+ = (Gb : Ab) -> FunExtUA[l].isContr (HC KZ2 kz2 (KK[Gb].K three) (KK[Gb].pt three)) ;
