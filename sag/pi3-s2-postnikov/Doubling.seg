-- Doubling on Eilenberg-MacLane loop spaces (doc/cross-term.pdf, Section 3).
--   conj-comm   conjugation by a loop is trivial when loops commute
--   Pi1.pi1     Lemma 3 (pointing irrelevance, 1-types): P 0-connected, Q a
--               1-type with commuting loops; (g, z) = (g, z') by unique-loop1
--               (c = 0), the loopings being conjugate by z^-1 . z' (loop-ap,
--               conj-trans, trans-cancel') and their pointings lying in the
--               set Omega Q
--   conj-const  conj_m 0 = 0 (composition with a constant map, both sides)
--   K0          Lemma 4: K(0, m) = 0, by induction on m: at m = 0 both maps
--               are constant o and the pointings lie in a set; at m + 1 the
--               loopings agree, loop K(0, m+1) = conj_m K(0, m) = conj_m 0 = 0
--               = loop 0 (loopK, induction, conj-const, loop-const), and
--               KFun.Unloop.unloop concludes.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open HLevels[l] ; open Connected[l] ;
open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ; open LoopCalc[l] ;
open Torsor[l] ; open EMMaps[l] ; open Z2[l] ;
module LC = LoopConj[l] ;

conj-comm (X : U l) (x : X) (comm : (u v : Id X x x) -> Id (Id X x x) (trans X x x x u v) (trans X x x x v u))
  (d v : Id X x x) : Id (Id X x x) (LC.conj X x x d v) v =
  transH (apH (trans X x x x (sym X x x d)) (comm v d)) (trans-cancel X x x x d v) ;

-- Lemma 3
module Pi1 (P : U l) (p0 : P) (Q : U l) (q0 : Q) (cP : isConn (suc (suc zero)) P) (tQ : isTrunc (suc (suc (suc zero))) Q)
  (comm : (u v : Id Q q0 q0) -> Id (Id Q q0 q0) (trans Q q0 q0 q0 u v) (trans Q q0 q0 q0 v u)) {
  module M = Maps[P, p0, Q, q0] ;
  loop-pt (g : P -> Q) (z z' : Id Q (g p0) q0) (q : Id P p0 p0) :
    Id (Id Q q0 q0) ((M.loop (g, z)).1 q) ((M.loop (g, z')).1 q) = calc (Id Q q0 q0) {
    (M.loop (g, z)).1 q =< M.loop-ap (g, z) q > LC.conj Q (g p0) q0 z (ap P Q g p0 p0 q)
      =< symH (conj-comm Q q0 comm (trans Q q0 (g p0) q0 (sym Q (g p0) q0 z) z') (LC.conj Q (g p0) q0 z (ap P Q g p0 p0 q))) >
    LC.conj Q q0 q0 (trans Q q0 (g p0) q0 (sym Q (g p0) q0 z) z') (LC.conj Q (g p0) q0 z (ap P Q g p0 p0 q))
      =< symH (LC.conj-trans Q (g p0) q0 z (ap P Q g p0 p0 q) q0 (trans Q q0 (g p0) q0 (sym Q (g p0) q0 z) z')) >
    LC.conj Q (g p0) q0 (trans Q (g p0) q0 q0 z (trans Q q0 (g p0) q0 (sym Q (g p0) q0 z) z')) (ap P Q g p0 p0 q)
      =< apH (\ r -> LC.conj Q (g p0) q0 r (ap P Q g p0 p0 q)) (Fibres[l].trans-cancel' Q (g p0) q0 q0 z z') >
    LC.conj Q (g p0) q0 z' (ap P Q g p0 p0 q)
      =< symH (M.loop-ap (g, z') q) > (M.loop (g, z')).1 q } ;
  pi1 (g : P -> Q) (z z' : Id Q (g p0) q0) : Id (PtMap P p0 Q q0) (g, z) (g, z') =
    unique-loop1 zero P p0 Q q0 cP tQ (g, z) (g, z')
      (ptmap-path (Id P p0 p0) (refl p0) (Id Q q0 q0) (refl q0) (M.loop (g, z)).1 (M.loop (g, z')).1 (M.loop (g, z)).2 (M.loop (g, z')).2
         (loop-pt g z z')
         (trunc-one-prop (Id (Id Q q0 q0) ((M.loop (g, z)).1 (refl p0)) (refl q0))
            (tQ q0 q0 ((M.loop (g, z)).1 (refl p0)) (refl q0)) (M.loop (g, z)).2
            (trans (Id Q q0 q0) ((M.loop (g, z)).1 (refl p0)) ((M.loop (g, z')).1 (refl p0)) (refl q0) (loop-pt g z z' (refl p0)) (M.loop (g, z')).2))) ;
} ;

module Zero (Ga Gb : Ab) {
  module A = KK[Ga] ;
  module B = KK[Gb] ;
  module KZ = KMap[Ga, Gb, zeroH Ga Gb] ;

  conj-const (m : Nat) : Id (Maps[A.K (suc m), A.pt (suc m), B.K (suc m), B.pt (suc m)].PMO)
      (KZ.conj m (ptconst (A.K m) (A.pt m) (B.K m) (B.pt m))) (ptconst (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m))) (refl (B.pt (suc m)))) =
    transH (apH (\ G -> ptcomp (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (B.K m) (B.pt m) (Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m))) (refl (B.pt (suc m))) G
                          (pt-inv (Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m))) (refl (B.pt (suc m))) (B.K m) (B.pt m) (B.e m)).1)
              (comp-const-r (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (A.K m) (A.pt m) (B.K m) (B.pt m) (A.e m).1))
      (comp-const-l (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (B.K m) (B.pt m) (Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m))) (refl (B.pt (suc m)))
         (pt-inv (Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m))) (refl (B.pt (suc m))) (B.K m) (B.pt m) (B.e m)).1) ;

  -- Lemma 4
  K0 : (m : Nat) -> Id (PtMap (A.K m) (A.pt m) (B.K m) (B.pt m)) (KZ.K m) (ptconst (A.K m) (A.pt m) (B.K m) (B.pt m)) = split {
    zero -> ptmap-path Ga.A Ga.o Gb.A Gb.o (KZ.K zero).1 (\ a -> Gb.o) (KZ.K zero).2 (refl Gb.o) (\ a -> refl Gb.o)
              (Gb.setA Gb.o Gb.o (KZ.K zero).2 (trans Gb.A Gb.o Gb.o Gb.o (refl Gb.o) (refl Gb.o))) ;
    suc m | r -> KFun[l].Unloop[Ga, Gb].unloop m (KZ.K (suc m)) (ptconst (A.K (suc m)) (A.pt (suc m)) (B.K (suc m)) (B.pt (suc m)))
      (calc (Maps[A.K (suc m), A.pt (suc m), B.K (suc m), B.pt (suc m)].PMO) {
        Maps[A.K (suc m), A.pt (suc m), B.K (suc m), B.pt (suc m)].loop (KZ.K (suc m))
          =< KZ.loopK m > KZ.conj m (KZ.K m)
          =< apH (KZ.conj m) r > KZ.conj m (ptconst (A.K m) (A.pt m) (B.K m) (B.pt m))
          =< conj-const m > ptconst (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m))) (refl (B.pt (suc m)))
          =< symH (loop-const (A.K (suc m)) (A.pt (suc m)) (B.K (suc m)) (B.pt (suc m))) >
        Maps[A.K (suc m), A.pt (suc m), B.K (suc m), B.pt (suc m)].loop (ptconst (A.K (suc m)) (A.pt (suc m)) (B.K (suc m)) (B.pt (suc m))) }) } ;
} ;

-- Lemma 5 (pointing irrelevance on PMO_m = Map_*(Omega K(A,m+1), Omega K(A,m+1)))
module Pmo (Ga : Ab) {
  module A = KK[Ga] ;
  module N = NatArith[l] ;
  plus-two : (n : Nat) -> Id Nat (N.plus n (suc (suc zero))) (suc (suc n)) = split {
    zero -> refl (suc (suc zero)) ; suc n | r -> apH (\ k -> suc k) r } ;
  -- levels at m = n + 2
  cOK (n : Nat) : isConn (suc (suc (suc n))) (Id (A.K (suc (suc (suc n)))) (A.pt (suc (suc (suc n)))) (A.pt (suc (suc (suc n))))) =
    conn-id (suc (suc (suc n))) (A.K (suc (suc (suc n)))) (A.conn (suc (suc n))) (A.pt (suc (suc (suc n)))) (A.pt (suc (suc (suc n)))) ;
  pmo-set (n : Nat) : isSet (Maps[A.K (suc (suc (suc n))), A.pt (suc (suc (suc n))), A.K (suc (suc (suc n))), A.pt (suc (suc (suc n)))].PMO) =
    trunc-set (Maps[A.K (suc (suc (suc n))), A.pt (suc (suc (suc n))), A.K (suc (suc (suc n))), A.pt (suc (suc (suc n)))].PMO)
      (cor5-map (suc (suc zero)) (suc (suc n)) (Id (A.K (suc (suc (suc n)))) (A.pt (suc (suc (suc n)))) (A.pt (suc (suc (suc n))))) (refl (A.pt (suc (suc (suc n))))) (cOK n)
         (Id (A.K (suc (suc (suc n)))) (A.pt (suc (suc (suc n)))) (A.pt (suc (suc (suc n))))) (refl (A.pt (suc (suc (suc n)))))
         (trunc-index (Id (A.K (suc (suc (suc n)))) (A.pt (suc (suc (suc n)))) (A.pt (suc (suc (suc n))))) (suc (suc (suc (suc n)))) (N.plus (suc (suc n)) (suc (suc zero)))
            (symH (apH (\ k -> suc (suc k)) (plus-two n))) (A.trunc (suc (suc n)) (A.pt (suc (suc (suc n)))) (A.pt (suc (suc (suc n))))))) ;
  Stmt (m : Nat) : U l =
    (g : Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)) -> Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)))
    (z z' : Id (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (g (refl (A.pt (suc m)))) (refl (A.pt (suc m)))) ->
    Id (Maps[A.K (suc m), A.pt (suc m), A.K (suc m), A.pt (suc m)].PMO) (g, z) (g, z') ;
  pmo-pi0 : Stmt zero = \ g z z' -> apH (\ w -> (g, w))
    (trunc-one-prop (Id (Id (A.K (suc zero)) (A.pt (suc zero)) (A.pt (suc zero))) (g (refl (A.pt (suc zero)))) (refl (A.pt (suc zero))))
       (A.trunc zero (A.pt (suc zero)) (A.pt (suc zero)) (g (refl (A.pt (suc zero)))) (refl (A.pt (suc zero)))) z z') ;
  pmo-pi1 : Stmt (suc zero) = \ g z z' ->
    Pi1[Id (A.K (suc (suc zero))) (A.pt (suc (suc zero))) (A.pt (suc (suc zero))), refl (A.pt (suc (suc zero))), Id (A.K (suc (suc zero))) (A.pt (suc (suc zero))) (A.pt (suc (suc zero))), refl (A.pt (suc (suc zero))),
        conn-id (suc (suc zero)) (A.K (suc (suc zero))) (A.conn (suc zero)) (A.pt (suc (suc zero))) (A.pt (suc (suc zero))),
        A.trunc (suc zero) (A.pt (suc (suc zero))) (A.pt (suc (suc zero))), EH[l].EH[A.K (suc (suc zero)), A.pt (suc (suc zero))].eh].pi1 g z z' ;
  pmo-pi2 (n : Nat) : Stmt (suc (suc n)) = \ g z z' ->
    H4Classes[l].pi-set (Id (A.K (suc (suc (suc n)))) (A.pt (suc (suc (suc n)))) (A.pt (suc (suc (suc n))))) (refl (A.pt (suc (suc (suc n)))))
      (Id (A.K (suc (suc (suc n)))) (A.pt (suc (suc (suc n)))) (A.pt (suc (suc (suc n))))) (refl (A.pt (suc (suc (suc n))))) (pmo-set n)
      (conn-zero n (Id (Id (A.K (suc (suc (suc n)))) (A.pt (suc (suc (suc n)))) (A.pt (suc (suc (suc n))))) (refl (A.pt (suc (suc (suc n))))) (refl (A.pt (suc (suc (suc n))))))
         (conn-id (suc (suc n)) (Id (A.K (suc (suc (suc n)))) (A.pt (suc (suc (suc n)))) (A.pt (suc (suc (suc n))))) (cOK n) (refl (A.pt (suc (suc (suc n))))) (refl (A.pt (suc (suc (suc n)))))))
      g z z' ;
  pmo-piS : (n : Nat) -> Stmt (suc n) = split { zero -> pmo-pi1 ; suc n -> pmo-pi2 n } ;
  pmo-pi : (m : Nat) -> Stmt m = split { zero -> pmo-pi0 ; suc m -> pmo-piS m } ;
  -- maps of PMO_m with pointwise equal underlying maps are equal
  pmo-eq (m : Nat) (F F' : Maps[A.K (suc m), A.pt (suc m), A.K (suc m), A.pt (suc m)].PMO)
    (h : (q : Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) -> Id (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (F.1 q) (F'.1 q)) :
    Id (Maps[A.K (suc m), A.pt (suc m), A.K (suc m), A.pt (suc m)].PMO) F F' =
    transH (ptmap-path (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m)))
              F.1 F'.1 F.2 (trans (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (F'.1 (refl (A.pt (suc m)))) (F.1 (refl (A.pt (suc m)))) (refl (A.pt (suc m)))
                              (sym (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (F.1 (refl (A.pt (suc m)))) (F'.1 (refl (A.pt (suc m)))) (h (refl (A.pt (suc m))))) F.2)
              h (symH (Fibres[l].trans-cancel' (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (F.1 (refl (A.pt (suc m)))) (F'.1 (refl (A.pt (suc m)))) (refl (A.pt (suc m))) (h (refl (A.pt (suc m)))) F.2)))
      (pmo-pi m F'.1 (trans (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (F'.1 (refl (A.pt (suc m)))) (F.1 (refl (A.pt (suc m)))) (refl (A.pt (suc m)))
                       (sym (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (F.1 (refl (A.pt (suc m)))) (F'.1 (refl (A.pt (suc m)))) (h (refl (A.pt (suc m))))) F.2) F'.2) ;
} ;

-- doubling on a loop space, pointed by refl (refl . refl is refl by definition)
sq (Z : U l) (z0 : Z) : PtMap (Id Z z0 z0) (refl z0) (Id Z z0 z0) (refl z0) = (\ q -> trans Z z0 z0 z0 q q, refl (refl z0)) ;

-- ap of q |-> q . q along a : p = p'
ap-diag (Z : U l) (z0 : Z) (p : Id Z z0 z0) : (p' : Id Z z0 z0) (a : Id (Id Z z0 z0) p p') ->
  Id (Id (Id Z z0 z0) (trans Z z0 z0 z0 p p) (trans Z z0 z0 z0 p' p'))
    (ap (Id Z z0 z0) (Id Z z0 z0) (\ q -> trans Z z0 z0 z0 q q) p p' a)
    (trans (Id Z z0 z0) (trans Z z0 z0 z0 p p) (trans Z z0 z0 z0 p' p) (trans Z z0 z0 z0 p' p')
       (ap (Id Z z0 z0) (Id Z z0 z0) (\ x -> trans Z z0 z0 z0 x p) p p' a) (ap (Id Z z0 z0) (Id Z z0 z0) (trans Z z0 z0 z0 p') p p' a)) =
  \ p' a -> idJ (Id Z z0 z0) p (\ p1 a1 -> Id (Id (Id Z z0 z0) (trans Z z0 z0 z0 p p) (trans Z z0 z0 z0 p1 p1))
      (ap (Id Z z0 z0) (Id Z z0 z0) (\ q -> trans Z z0 z0 z0 q q) p p1 a1)
      (trans (Id Z z0 z0) (trans Z z0 z0 z0 p p) (trans Z z0 z0 z0 p1 p) (trans Z z0 z0 z0 p1 p1)
         (ap (Id Z z0 z0) (Id Z z0 z0) (\ x -> trans Z z0 z0 z0 x p) p p1 a1) (ap (Id Z z0 z0) (Id Z z0 z0) (trans Z z0 z0 z0 p1) p p1 a1)))
    (refl (refl (trans Z z0 z0 z0 p p))) p' a ;

-- the looping of sq is sq, pointwise (step (a))
loop-sq (Z : U l) (z0 : Z) (a : Id (Id Z z0 z0) (refl z0) (refl z0)) :
  Id (Id (Id Z z0 z0) (refl z0) (refl z0)) ((Maps[Id Z z0 z0, refl z0, Id Z z0 z0, refl z0].loop (sq Z z0)).1 a)
    (trans (Id Z z0 z0) (refl z0) (refl z0) (refl z0) a a) =
  transH (Maps[Id Z z0 z0, refl z0, Id Z z0 z0, refl z0].loop-ap (sq Z z0) a)
    (transH (trans-refl-l (Id Z z0 z0) (refl z0) (refl z0) (ap (Id Z z0 z0) (Id Z z0 z0) (\ q -> trans Z z0 z0 z0 q q) (refl z0) (refl z0) a))
      (transH (ap-diag Z z0 (refl z0) (refl z0) a)
        (transH (apH (\ u -> trans (Id Z z0 z0) (refl z0) (refl z0) (refl z0) u (ap (Id Z z0 z0) (Id Z z0 z0) (trans Z z0 z0 z0 (refl z0)) (refl z0) (refl z0) a))
                   (EH[l].EH[Z, z0].whisk-r a))
           (apH (trans (Id Z z0 z0) (refl z0) (refl z0) (refl z0) a) (EH[l].EH[Z, z0].whisk-l a))))) ;

-- sq conjugated by a pointed equivalence e : Omega Y ~pt X loops to sq (step (b))
module SqConj (Y : U l) (y0 : Y) (X : U l) (x0 : X) (e : PtEquiv (Id Y y0 y0) (refl y0) X x0) {
  module MX = Maps[X, x0, X, x0] ;
  module MXY = Maps[X, x0, Id Y y0 y0, refl y0] ;
  module MYX = Maps[Id Y y0 y0, refl y0, X, x0] ;
  module MYY = Maps[Id Y y0 y0, refl y0, Id Y y0 y0, refl y0] ;
  einv : PtMap X x0 (Id Y y0 y0) (refl y0) = (pt-inv (Id Y y0 y0) (refl y0) X x0 e).1 ;
  G : PtMap X x0 X x0 = ptcomp X x0 (Id Y y0 y0) (refl y0) X x0 einv (ptcomp (Id Y y0 y0) (refl y0) (Id Y y0 y0) (refl y0) X x0 (sq Y y0) e.1) ;
  back (b : Id X x0 x0) : Id (Id X x0 x0) ((MYX.loop e.1).1 ((MXY.loop einv).1 b)) b =
    transH (symH (Puppe[l].pt-happly (Id X x0 x0) (refl x0) (Id X x0 x0) (refl x0)
                    (MX.loop (ptcomp X x0 (Id Y y0 y0) (refl y0) X x0 einv e.1))
                    (ptcomp (Id X x0 x0) (refl x0) (Id (Id Y y0 y0) (refl y0) (refl y0)) (refl (refl y0)) (Id X x0 x0) (refl x0) (MXY.loop einv) (MYX.loop e.1))
                    (loop-comp X x0 (Id Y y0 y0) (refl y0) X x0 einv e.1) b))
      (transH (apH (\ H -> (MX.loop H).1 b) (pt-inv-r (Id Y y0 y0) (refl y0) X x0 e)) (Puppe[l].loop-id X x0 b)) ;
  -- the four steps of loop-G, each with its common point written (rule 4)
  -- by definition of G
  G-def : Id (PtMap X x0 X x0) G (ptcomp X x0 (Id Y y0 y0) (refl y0) X x0 einv (ptcomp (Id Y y0 y0) (refl y0) (Id Y y0 y0) (refl y0) X x0 (sq Y y0) e.1)) =
    refl G ;
  lg1 (b : Id X x0 x0) : Id (Id X x0 x0) ((MX.loop (ptcomp X x0 (Id Y y0 y0) (refl y0) X x0 einv (ptcomp (Id Y y0 y0) (refl y0) (Id Y y0 y0) (refl y0) X x0 (sq Y y0) e.1))).1 b)
      ((ptcomp (Id X x0 x0) (refl x0) (Id (Id Y y0 y0) (refl y0) (refl y0)) (refl (refl y0)) (Id X x0 x0) (refl x0) (MXY.loop einv)
         (MYX.loop (ptcomp (Id Y y0 y0) (refl y0) (Id Y y0 y0) (refl y0) X x0 (sq Y y0) e.1))).1 b) =
    Puppe[l].pt-happly (Id X x0 x0) (refl x0) (Id X x0 x0) (refl x0)
      (MX.loop (ptcomp X x0 (Id Y y0 y0) (refl y0) X x0 einv (ptcomp (Id Y y0 y0) (refl y0) (Id Y y0 y0) (refl y0) X x0 (sq Y y0) e.1)))
      (ptcomp (Id X x0 x0) (refl x0) (Id (Id Y y0 y0) (refl y0) (refl y0)) (refl (refl y0)) (Id X x0 x0) (refl x0) (MXY.loop einv)
         (MYX.loop (ptcomp (Id Y y0 y0) (refl y0) (Id Y y0 y0) (refl y0) X x0 (sq Y y0) e.1)))
      (loop-comp X x0 (Id Y y0 y0) (refl y0) X x0 einv (ptcomp (Id Y y0 y0) (refl y0) (Id Y y0 y0) (refl y0) X x0 (sq Y y0) e.1)) b ;
  lg2 (u : Id (Id Y y0 y0) (refl y0) (refl y0)) : Id (Id X x0 x0)
      ((MYX.loop (ptcomp (Id Y y0 y0) (refl y0) (Id Y y0 y0) (refl y0) X x0 (sq Y y0) e.1)).1 u) ((MYX.loop e.1).1 ((MYY.loop (sq Y y0)).1 u)) =
    Puppe[l].pt-happly (Id (Id Y y0 y0) (refl y0) (refl y0)) (refl (refl y0)) (Id X x0 x0) (refl x0)
      (MYX.loop (ptcomp (Id Y y0 y0) (refl y0) (Id Y y0 y0) (refl y0) X x0 (sq Y y0) e.1))
      (ptcomp (Id (Id Y y0 y0) (refl y0) (refl y0)) (refl (refl y0)) (Id (Id Y y0 y0) (refl y0) (refl y0)) (refl (refl y0)) (Id X x0 x0) (refl x0) (MYY.loop (sq Y y0)) (MYX.loop e.1))
      (loop-comp (Id Y y0 y0) (refl y0) (Id Y y0 y0) (refl y0) X x0 (sq Y y0) e.1) u ;
  module IE = PiOne[l].Induced[Id Y y0 y0, refl y0, X, x0, e.1] ;
  -- by definition of Induced.L and PiOne.comp
  L-def (u : Id (Id Y y0 y0) (refl y0) (refl y0)) : Id (Id X x0 x0) (IE.L u) ((MYX.loop e.1).1 u) = refl (IE.L u) ;
  comp-def (u v : Id (Id Y y0 y0) (refl y0) (refl y0)) :
    Id (Id (Id Y y0 y0) (refl y0) (refl y0)) (IE.PY.comp u v) (trans (Id Y y0 y0) (refl y0) (refl y0) (refl y0) u v) = refl (IE.PY.comp u v) ;
  lg3 (u : Id (Id Y y0 y0) (refl y0) (refl y0)) : Id (Id X x0 x0) (IE.L (IE.PY.comp u u)) (IE.PZ.comp (IE.L u) (IE.L u)) =
    IE.loop-mult u u ;
  loop-G (b : Id X x0 x0) : Id (Id X x0 x0) ((MX.loop G).1 b) (trans X x0 x0 x0 b b) = calc (Id X x0 x0) {
    (MX.loop G).1 b
      =< apH (\ H -> (MX.loop H).1 b) G-def >
    (MX.loop (ptcomp X x0 (Id Y y0 y0) (refl y0) X x0 einv (ptcomp (Id Y y0 y0) (refl y0) (Id Y y0 y0) (refl y0) X x0 (sq Y y0) e.1))).1 b =< lg1 b >
    (ptcomp (Id X x0 x0) (refl x0) (Id (Id Y y0 y0) (refl y0) (refl y0)) (refl (refl y0)) (Id X x0 x0) (refl x0) (MXY.loop einv)
       (MYX.loop (ptcomp (Id Y y0 y0) (refl y0) (Id Y y0 y0) (refl y0) X x0 (sq Y y0) e.1))).1 b
      =< refl ((MYX.loop (ptcomp (Id Y y0 y0) (refl y0) (Id Y y0 y0) (refl y0) X x0 (sq Y y0) e.1)).1 ((MXY.loop einv).1 b)) >
    (MYX.loop (ptcomp (Id Y y0 y0) (refl y0) (Id Y y0 y0) (refl y0) X x0 (sq Y y0) e.1)).1 ((MXY.loop einv).1 b) =< lg2 ((MXY.loop einv).1 b) >
    (MYX.loop e.1).1 ((MYY.loop (sq Y y0)).1 ((MXY.loop einv).1 b)) =< apH (MYX.loop e.1).1 (loop-sq Y y0 ((MXY.loop einv).1 b)) >
    (MYX.loop e.1).1 (trans (Id Y y0 y0) (refl y0) (refl y0) (refl y0) ((MXY.loop einv).1 b) ((MXY.loop einv).1 b))
      =< symH (transH (apH IE.L (comp-def ((MXY.loop einv).1 b) ((MXY.loop einv).1 b))) (L-def (trans (Id Y y0 y0) (refl y0) (refl y0) (refl y0) ((MXY.loop einv).1 b) ((MXY.loop einv).1 b)))) >
    IE.L (IE.PY.comp ((MXY.loop einv).1 b) ((MXY.loop einv).1 b)) =< lg3 ((MXY.loop einv).1 b) >
    IE.PZ.comp (IE.L ((MXY.loop einv).1 b)) (IE.L ((MXY.loop einv).1 b))
      =< transH (apH (\ w -> trans X x0 x0 x0 w (IE.L ((MXY.loop einv).1 b))) (L-def ((MXY.loop einv).1 b))) (apH (trans X x0 x0 x0 ((MYX.loop e.1).1 ((MXY.loop einv).1 b))) (L-def ((MXY.loop einv).1 b))) >
    trans X x0 x0 x0 ((MYX.loop e.1).1 ((MXY.loop einv).1 b)) ((MYX.loop e.1).1 ((MXY.loop einv).1 b))
      =< apH (\ u -> trans X x0 x0 x0 u ((MYX.loop e.1).1 ((MXY.loop einv).1 b))) (back b) >
    trans X x0 x0 x0 b ((MYX.loop e.1).1 ((MXY.loop einv).1 b))
      =< apH (trans X x0 x0 x0 b) (back b) > trans X x0 x0 x0 b b } ;
} ;

-- Lemma 6 (doubling): sq = conj_m K(2, m) in PMO_m, for every m
module Dbl (Ga : Ab) {
  module A = KK[Ga] ;
  module KT = KMap[Ga, Ga, twoH Ga] ;
  module PM = Pmo[Ga] ;
  Stmt (m : Nat) : U l = Id (Maps[A.K (suc m), A.pt (suc m), A.K (suc m), A.pt (suc m)].PMO) (sq (A.K (suc m)) (A.pt (suc m))) (KT.conj m (KT.K m)) ;
  -- m = 0: the band
  h0 (p : Id KT.A.E1.K1 KT.A.E1.k0 KT.A.E1.k0) :
    Id (Id KT.A.E1.K1 KT.A.E1.k0 KT.A.E1.k0) (trans KT.A.E1.K1 KT.A.E1.k0 KT.A.E1.k0 KT.A.E1.k0 p p) (KT.c0 p) =
    symH (KT.B.E1.band-inj KT.B.E1.k0 (KT.c0 p) (trans KT.A.E1.K1 KT.A.E1.k0 KT.A.E1.k0 KT.A.E1.k0 p p)
      (transH (KT.B.E1.band-unband KT.B.E1.k0 (Ga.add (KT.A.E1.band KT.A.E1.k0 p) (KT.A.E1.band KT.A.E1.k0 p)))
         (symH (KT.A.E1.band-hom KT.A.E1.k0 p p)))) ;
  h0' (p : Id (A.K (suc zero)) (A.pt (suc zero)) (A.pt (suc zero))) :
    Id (Id (A.K (suc zero)) (A.pt (suc zero)) (A.pt (suc zero))) (trans (A.K (suc zero)) (A.pt (suc zero)) (A.pt (suc zero)) (A.pt (suc zero)) p p) ((KT.conj zero (KT.K zero)).1 p) =
    transH (h0 p) (symH (KT.c0-conj p)) ;
  base : Stmt zero = PM.pmo-eq zero (sq (A.K (suc zero)) (A.pt (suc zero))) (KT.conj zero (KT.K zero)) h0' ;
  module Step (m : Nat) (ih : Stmt m) {
    module SC = SqConj[A.K (suc (suc m)), A.pt (suc (suc m)), A.K (suc m), A.pt (suc m), A.e (suc m)] ;
    G-eq : Id (PtMap (A.K (suc m)) (A.pt (suc m)) (A.K (suc m)) (A.pt (suc m))) SC.G (KT.K (suc m)) =
      KFun[l].Unloop[Ga, Ga].unloop m SC.G (KT.K (suc m)) (calc (Maps[A.K (suc m), A.pt (suc m), A.K (suc m), A.pt (suc m)].PMO) {
        SC.MX.loop SC.G =< PM.pmo-eq m (SC.MX.loop SC.G) (sq (A.K (suc m)) (A.pt (suc m))) SC.loop-G >
        sq (A.K (suc m)) (A.pt (suc m)) =< ih > KT.conj m (KT.K m)
          =< symH (KT.loopK m) > Maps[A.K (suc m), A.pt (suc m), A.K (suc m), A.pt (suc m)].loop (KT.K (suc m)) }) ;
    h (p : Id (A.K (suc (suc m))) (A.pt (suc (suc m))) (A.pt (suc (suc m)))) :
      Id (Id (A.K (suc (suc m))) (A.pt (suc (suc m))) (A.pt (suc (suc m)))) (trans (A.K (suc (suc m))) (A.pt (suc (suc m))) (A.pt (suc (suc m))) (A.pt (suc (suc m))) p p)
        ((KT.conj (suc m) (KT.K (suc m))).1 p) = symH (calc (Id (A.K (suc (suc m))) (A.pt (suc (suc m))) (A.pt (suc (suc m)))) {
      (KT.conj (suc m) (KT.K (suc m))).1 p
        =< apH SC.einv.1 (Puppe[l].pt-happly (A.K (suc m)) (A.pt (suc m)) (A.K (suc m)) (A.pt (suc m)) (KT.K (suc m)) SC.G (symH G-eq) ((A.e (suc m)).1.1 p)) >
      SC.einv.1 ((A.e (suc m)).1.1 (trans (A.K (suc (suc m))) (A.pt (suc (suc m))) (A.pt (suc (suc m))) (A.pt (suc (suc m))) (SC.einv.1 ((A.e (suc m)).1.1 p)) (SC.einv.1 ((A.e (suc m)).1.1 p))))
        =< sec-ret (Id (A.K (suc (suc m))) (A.pt (suc (suc m))) (A.pt (suc (suc m)))) (A.K (suc m)) (A.e (suc m)).1.1 (A.e (suc m)).2
             (trans (A.K (suc (suc m))) (A.pt (suc (suc m))) (A.pt (suc (suc m))) (A.pt (suc (suc m))) (SC.einv.1 ((A.e (suc m)).1.1 p)) (SC.einv.1 ((A.e (suc m)).1.1 p))) >
      trans (A.K (suc (suc m))) (A.pt (suc (suc m))) (A.pt (suc (suc m))) (A.pt (suc (suc m))) (SC.einv.1 ((A.e (suc m)).1.1 p)) (SC.einv.1 ((A.e (suc m)).1.1 p))
        =< apH (\ u -> trans (A.K (suc (suc m))) (A.pt (suc (suc m))) (A.pt (suc (suc m))) (A.pt (suc (suc m))) u u)
             (sec-ret (Id (A.K (suc (suc m))) (A.pt (suc (suc m))) (A.pt (suc (suc m)))) (A.K (suc m)) (A.e (suc m)).1.1 (A.e (suc m)).2 p) >
      trans (A.K (suc (suc m))) (A.pt (suc (suc m))) (A.pt (suc (suc m))) (A.pt (suc (suc m))) p p }) ;
    result : Stmt (suc m) = PM.pmo-eq (suc m) (sq (A.K (suc (suc m))) (A.pt (suc (suc m)))) (KT.conj (suc m) (KT.K (suc m))) h ;
  } ;
  dbl : (m : Nat) -> Stmt m = split { zero -> base ; suc m | r -> Step[m, r].result } ;
} ;

-- Corollary 7: over Z/2, doubling on Omega K(Z/2, m+1) is the constant map
module Sq0 {
  module A = KK[Z2ab] ;
  module KT = KMap[Z2ab, Z2ab, twoH Z2ab] ;
  module Z0 = Zero[Z2ab, Z2ab] ;
  sq0 (m : Nat) : Id (Maps[A.K (suc m), A.pt (suc m), A.K (suc m), A.pt (suc m)].PMO) (sq (A.K (suc m)) (A.pt (suc m)))
      (ptconst (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m)))) =
    transH (Dbl[Z2ab].dbl m)
      (transH (apH (KT.conj m) (KFun[l].k-resp Z2ab Z2ab (twoH Z2ab) (zeroH Z2ab Z2ab) xor-invr m))
         (transH (apH (KT.conj m) (Z0.K0 m)) (Z0.conj-const m))) ;
  s (m : Nat) (p : Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) :
    Id (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (trans (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)) (A.pt (suc m)) p p) (refl (A.pt (suc m))) =
    Puppe[l].pt-happly (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m)))
      (sq (A.K (suc m)) (A.pt (suc m))) (ptconst (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m)))) (sq0 m) p ;
} ;
