-- pi_4(S^3) = Z/2 through the delooping embedding (doc/delooping-direct.pdf,
-- Section 4): the assembly of Pi4Sphere with statement M at T = ||S3||_4 given by
-- MarkDirect (Statement T and the S^3 axiom) instead of Presentation4.  The
-- reference endpoint Pi4Sphere.Pi4S3 is unchanged.
--
-- Informal proof.
--   Assemble   for a level-4 truncation TR of S3: uT = (T, t0, connT, truncT) is a
--              pointed 2-connected 4-type, so s^* : [BR, T]_* -> [S3, T]_* is
--              bijective (sT: MarkDirect.Direct.marked at uT); s^* at BR is
--              SourceS3.Final.rep-fib at (Z, Z/2, Fhat) (sP); Pi4Sphere.Two4 gives
--              pi4 S3 ~ pi4 BR, and Pi4Sphere.pi4-BR gives pi4 BR ~ Z/2
--   Pi4S3      Assemble at the constructed truncation Sphere3Trunc.trunc4
-- Dependencies: neither Presentation4 nor DeloopEmbedding.Mark.marked is used
-- (MarkDirect: Statement T, TwoTorsion; Proposition L, MarkLoop).
level l ;
open Base ; open Prelude[l] ; open HLevels[l] ; open Connected[l] ; open Lemma4[l] ;
open Torsor[l] ; open SphereUniversal[l] ; open PostnikovRealization[l] ; open KZ2Cohomology[l] ; open Z2[l] ;
open Group[l] ; open HomotopyClasses[l] ; open HomotopyGroups[l] ;
module S3A = Sphere3Axiom[l] ;
module DR = DeloopR[l] ; module S3S = SourceS3[l] ; module S3T = Sphere3Trunc[l] ;
module DE = DeloopEmbedding[l] ; module MD = MarkDirect[l] ; module PS = Pi4Sphere[l] ;

module Assemble (S3 : U l) (base : S3) (surf : S3A.O3 S3 base)
  (ump3 : (X : U l) -> isEquiv (S3 -> X) ((x : X) * S3A.O3 X x) (S3A.ev3 S3 base surf X)) (TR : S3T.Interfaces4[S3, base].Trunc4) {
  module FS = S3S.Final[S3, base, surf, ump3] ;
  -- the truncation as a pointed 2-connected 4-type
  uT : DE.SC4 = (TR.T, TR.t0, (TR.connT, TR.truncT)) ;
  -- M at T, without a presentation
  sT : isEquiv (HC DR.BR DR.br0 TR.T TR.t0) (HC S3 base TR.T TR.t0) (\ c -> compC S3 base DR.BR DR.br0 TR.T TR.t0 FS.s c) =
    MD.Direct[S3, base, surf, ump3].marked uT ;
  -- M at BR: Theorem main at the triple (Z, Z/2, Fhat)
  sP : isEquiv (HC DR.BR DR.br0 DR.BR DR.br0) (HC S3 base DR.BR DR.br0) (\ b -> compC S3 base DR.BR DR.br0 DR.BR DR.br0 FS.s b) =
    FS.rep-fib Zab Z2ab DR.Fhat ;
  module A2 = PS.Two4[S3, base, TR, DR.BR, DR.br0, DR.BR-trunc, FS.s, sP, sT] ;
  pi4-S3 : GIso[S3T.pi4 S3 base, ab-grp Z2ab] =
    gi-comp (S3T.pi4 S3 base) (S3T.pi4 DR.BR DR.br0) (ab-grp Z2ab) A2.iso-S3-P PS.pi4-BR ;
} ;

-- pi_4(S^3) = Z/2, from the S^3 axiom alone, through the delooping embedding
module Pi4S3 (S3 : U l) (base : S3) (surf : S3A.O3 S3 base)
  (ump3 : (X : U l) -> isEquiv (S3 -> X) ((x : X) * S3A.O3 X x) (S3A.ev3 S3 base surf X)) {
  pi4-S3 : GIso[S3T.pi4 S3 base, ab-grp Z2ab] =
    Assemble[S3, base, surf, ump3, S3T.Sphere3Trunc[S3, base, surf, ump3].trunc4].pi4-S3 ;
} ;
