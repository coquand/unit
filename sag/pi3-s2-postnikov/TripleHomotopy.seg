-- Identities, composition and the homotopy category of triples
-- (doc/postnikov-morphisms.pdf, Section 3).  Informal proof: the note.
--   hp, hp-trans, hp-sym, hp-pre, hp-post, hp-assoc, hp-pair
--                the underlying homotopy of a path of pointed maps (happly o ap)
--                of a composite, an inverse, a whiskering, ptcomp-assoc (refl),
--                ptcomp-idl/idr (refl)
--   Bridge       fm along paths U : u2 = u, W : v2 = v of pointed maps is pointwise fm of
--                the square (J on U and W)
--   Paste        fm of the pasted square is pointwise the composite of the fm's
--                (hs-paste, eq2: ap-trans, ap-ap, grp4)
--   FmId         fm of the identity square is pointwise the identity
--   KId[A]       K(1, m) = id for m = 2, 4 (K(-,m) surjective, k-comp, 1 ; h = h)
--   Maps3[t, t', t'']   mcomp (the intrinsic composition: k-comp, paste, k-comp^-1),
--                rmap-comp-pt (pointwise), rmap-comp (in [Fib k, Fib k'']_*, pi-mere)
--   Maps1[t]     mid (the intrinsic identity), rmap-id-pt, rmap-id
--   Cat          homT = ||Mor||_0; R the classes of realise-map (a bijection);
--                compT, idT transported; compT-rep, idT-rep (agreement with mcomp,
--                mid on representatives); the category laws; with classification:
--                an equivalence of homotopy categories (on classes; no coherent
--                pointed path for rmap-comp is claimed)
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ; open HLevels[l] ; open Connected[l] ; open Lemma4[l] ;
open DeloopMaps[l] ; open LoopCalc[l] ; open PtEquivOps[l] ; open EMMaps[l] ; open Group[l] ; open Torsor[l] ;
open HomotopyClasses[l] ; open SphereUniversal[l] ; open PostnikovRealization[l] ;
open TripleMaps[l] ; open TripleMapsEquiv[l] ;
module P1 = Prelude[l+] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module E = Equivalences[l] ; module W = Whitehead[l] ; module Fb = Fibres[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Gp = Groupoid[l] ; module HB = H4Bilinear[l] ; module FM = FibMap[l] ; module FH = FibreH3[l] ; module PC = PostnikovClassification[l] ;

------------------------------------------------------------------------
-- the underlying homotopy of a path of pointed maps

hp (X : U l) (x0 : X) (Y : U l) (y0 : Y) (c g : PtMap X x0 Y y0) (r : Id (PtMap X x0 Y y0) c g) (x : X) : Id Y (c.1 x) (g.1 x) =
  happly X (\ x1 -> Y) c.1 g.1 (ap (PtMap X x0 Y y0) (X -> Y) (\ R -> R.1) c g r) x ;

hp-trans (X : U l) (x0 : X) (Y : U l) (y0 : Y) (c g : PtMap X x0 Y y0) (r : Id (PtMap X x0 Y y0) c g) (x : X) :
  (h : PtMap X x0 Y y0) (s : Id (PtMap X x0 Y y0) g h) ->
  Id (Id Y (c.1 x) (h.1 x)) (hp X x0 Y y0 c h (trans (PtMap X x0 Y y0) c g h r s) x) (trans Y (c.1 x) (g.1 x) (h.1 x) (hp X x0 Y y0 c g r x) (hp X x0 Y y0 g h s x)) =
  \ h s -> idJ (PtMap X x0 Y y0) g (\ h1 s1 -> Id (Id Y (c.1 x) (h1.1 x)) (hp X x0 Y y0 c h1 (trans (PtMap X x0 Y y0) c g h1 r s1) x) (trans Y (c.1 x) (g.1 x) (h1.1 x) (hp X x0 Y y0 c g r x) (hp X x0 Y y0 g h1 s1 x)))
    (refl (hp X x0 Y y0 c g r x)) h s ;

hp-sym (X : U l) (x0 : X) (Y : U l) (y0 : Y) (c : PtMap X x0 Y y0) (x : X) : (g : PtMap X x0 Y y0) (r : Id (PtMap X x0 Y y0) c g) ->
  Id (Id Y (g.1 x) (c.1 x)) (hp X x0 Y y0 g c (sym (PtMap X x0 Y y0) c g r) x) (sym Y (c.1 x) (g.1 x) (hp X x0 Y y0 c g r x)) =
  \ g r -> idJ (PtMap X x0 Y y0) c (\ g1 r1 -> Id (Id Y (g1.1 x) (c.1 x)) (hp X x0 Y y0 g1 c (sym (PtMap X x0 Y y0) c g1 r1) x) (sym Y (c.1 x) (g1.1 x) (hp X x0 Y y0 c g1 r1 x)))
    (refl (refl (c.1 x))) g r ;

-- whiskering on the left: hp (u ; s) x = hp s (u x)
hp-pre (X : U l) (x0 : X) (X' : U l) (x0' : X') (Y : U l) (y0 : Y) (u : PtMap X x0 X' x0') (c : PtMap X' x0' Y y0) (x : X) :
  (g : PtMap X' x0' Y y0) (s : Id (PtMap X' x0' Y y0) c g) ->
  Id (Id Y (c.1 (u.1 x)) (g.1 (u.1 x))) (hp X x0 Y y0 (ptcomp X x0 X' x0' Y y0 u c) (ptcomp X x0 X' x0' Y y0 u g) (ap (PtMap X' x0' Y y0) (PtMap X x0 Y y0) (ptcomp X x0 X' x0' Y y0 u) c g s) x)
    (hp X' x0' Y y0 c g s (u.1 x)) =
  \ g s -> idJ (PtMap X' x0' Y y0) c (\ g1 s1 -> Id (Id Y (c.1 (u.1 x)) (g1.1 (u.1 x))) (hp X x0 Y y0 (ptcomp X x0 X' x0' Y y0 u c) (ptcomp X x0 X' x0' Y y0 u g1) (ap (PtMap X' x0' Y y0) (PtMap X x0 Y y0) (ptcomp X x0 X' x0' Y y0 u) c g1 s1) x)
      (hp X' x0' Y y0 c g1 s1 (u.1 x)))
    (refl (refl (c.1 (u.1 x)))) g s ;

-- whiskering on the right: hp (s ; v) x = ap v (hp s x)
hp-post (X : U l) (x0 : X) (Y : U l) (y0 : Y) (Y' : U l) (y0' : Y') (v : PtMap Y y0 Y' y0') (c : PtMap X x0 Y y0) (x : X) :
  (g : PtMap X x0 Y y0) (s : Id (PtMap X x0 Y y0) c g) ->
  Id (Id Y' (v.1 (c.1 x)) (v.1 (g.1 x))) (hp X x0 Y' y0' (ptcomp X x0 Y y0 Y' y0' c v) (ptcomp X x0 Y y0 Y' y0' g v) (ap (PtMap X x0 Y y0) (PtMap X x0 Y' y0') (\ M -> ptcomp X x0 Y y0 Y' y0' M v) c g s) x)
    (ap Y Y' v.1 (c.1 x) (g.1 x) (hp X x0 Y y0 c g s x)) =
  \ g s -> idJ (PtMap X x0 Y y0) c (\ g1 s1 -> Id (Id Y' (v.1 (c.1 x)) (v.1 (g1.1 x))) (hp X x0 Y' y0' (ptcomp X x0 Y y0 Y' y0' c v) (ptcomp X x0 Y y0 Y' y0' g1 v) (ap (PtMap X x0 Y y0) (PtMap X x0 Y' y0') (\ M -> ptcomp X x0 Y y0 Y' y0' M v) c g1 s1) x)
      (ap Y Y' v.1 (c.1 x) (g1.1 x) (hp X x0 Y y0 c g1 s1 x)))
    (refl (refl (v.1 (c.1 x)))) g s ;

-- the homotopy of ptcomp-assoc is refl (J on the three pointings, as ptcomp-assoc)
hp-assoc (A : U l) (a0 : A) (B : U l) (b0 : B) (C : U l) (c0 : C) (D : U l) (d0 : D)
  (F : PtMap A a0 B b0) (G : PtMap B b0 C c0) (H : PtMap C c0 D d0) (x : A) :
  Id (Id D (H.1 (G.1 (F.1 x))) (H.1 (G.1 (F.1 x))))
    (hp A a0 D d0 (ptcomp A a0 C c0 D d0 (ptcomp A a0 B b0 C c0 F G) H) (ptcomp A a0 B b0 D d0 F (ptcomp B b0 C c0 D d0 G H)) (ptcomp-assoc A a0 B b0 C c0 D d0 F G H) x)
    (refl (H.1 (G.1 (F.1 x)))) =
  idJ B (F.1 a0) (\ b1 p1 -> (c1 : C) (G1 : PtMap B b1 C c1) (d1 : D) (H1 : PtMap C c1 D d1) ->
      Id (Id D (H1.1 (G1.1 (F.1 x))) (H1.1 (G1.1 (F.1 x))))
        (hp A a0 D d1 (ptcomp A a0 C c1 D d1 (ptcomp A a0 B b1 C c1 (F.1, p1) G1) H1) (ptcomp A a0 B b1 D d1 (F.1, p1) (ptcomp B b1 C c1 D d1 G1 H1)) (ptcomp-assoc A a0 B b1 C c1 D d1 (F.1, p1) G1 H1) x)
        (refl (H1.1 (G1.1 (F.1 x)))))
    (\ c1 G1 -> idJ C (G1.1 (F.1 a0)) (\ c2 p2 -> (d1 : D) (H1 : PtMap C c2 D d1) ->
        Id (Id D (H1.1 (G1.1 (F.1 x))) (H1.1 (G1.1 (F.1 x))))
          (hp A a0 D d1 (ptcomp A a0 C c2 D d1 (ptcomp A a0 B (F.1 a0) C c2 (F.1, refl (F.1 a0)) (G1.1, p2)) H1) (ptcomp A a0 B (F.1 a0) D d1 (F.1, refl (F.1 a0)) (ptcomp B (F.1 a0) C c2 D d1 (G1.1, p2) H1)) (ptcomp-assoc A a0 B (F.1 a0) C c2 D d1 (F.1, refl (F.1 a0)) (G1.1, p2) H1) x)
          (refl (H1.1 (G1.1 (F.1 x)))))
      (\ d1 H1 -> idJ D (H1.1 (G1.1 (F.1 a0))) (\ d2 p3 ->
          Id (Id D (H1.1 (G1.1 (F.1 x))) (H1.1 (G1.1 (F.1 x))))
            (hp A a0 D d2 (ptcomp A a0 C (G1.1 (F.1 a0)) D d2 (ptcomp A a0 B (F.1 a0) C (G1.1 (F.1 a0)) (F.1, refl (F.1 a0)) (G1.1, refl (G1.1 (F.1 a0)))) (H1.1, p3)) (ptcomp A a0 B (F.1 a0) D d2 (F.1, refl (F.1 a0)) (ptcomp B (F.1 a0) C (G1.1 (F.1 a0)) D d2 (G1.1, refl (G1.1 (F.1 a0))) (H1.1, p3))) (ptcomp-assoc A a0 B (F.1 a0) C (G1.1 (F.1 a0)) D d2 (F.1, refl (F.1 a0)) (G1.1, refl (G1.1 (F.1 a0))) (H1.1, p3)) x)
            (refl (H1.1 (G1.1 (F.1 x)))))
          (refl (refl (H1.1 (G1.1 (F.1 x))))) d1 H1.2)
      c1 G1.2)
    b0 F.2 c0 G d0 H ;

-- a path changing only the pointing has trivial homotopy (ptcomp-idl, ptcomp-idr)
hp-pair (X : U l) (x0 : X) (Y : U l) (y0 : Y) (F1 : X -> Y) (p : Id Y (F1 x0) y0) (x : X) : (q : Id Y (F1 x0) y0) (r : Id (Id Y (F1 x0) y0) p q) ->
  Id (Id Y (F1 x) (F1 x)) (hp X x0 Y y0 (F1, p) (F1, q) (ap (Id Y (F1 x0) y0) (PtMap X x0 Y y0) (\ e -> (F1, e)) p q r) x) (refl (F1 x)) =
  \ q r -> idJ (Id Y (F1 x0) y0) p (\ q1 r1 -> Id (Id Y (F1 x) (F1 x)) (hp X x0 Y y0 (F1, p) (F1, q1) (ap (Id Y (F1 x0) y0) (PtMap X x0 Y y0) (\ e -> (F1, e)) p q1 r1) x) (refl (F1 x)))
    (refl (refl (F1 x))) q r ;

------------------------------------------------------------------------
-- fm along paths of pointed maps

module Bridge (E : U l) (e0 : E) (B : U l) (b0 : B) (E' : U l) (e0' : E') (B' : U l) (b0' : B')
  (f : PtMap E e0 B b0) (f' : PtMap E' e0' B' b0') (u : PtMap E e0 E' e0') (v : PtMap B b0 B' b0')
  (s : Id (PtMap E e0 B' b0') (ptcomp E e0 E' e0' B' b0' u f') (ptcomp E e0 B b0 B' b0' f v)) {
  -- the square for (u2, v2), along U : u2 = u and W : v2 = v
  bridge (u2 : PtMap E e0 E' e0') (pU : Id (PtMap E e0 E' e0') u2 u) (v2 : PtMap B b0 B' b0') (pW : Id (PtMap B b0 B' b0') v2 v) :
    Id (PtMap E e0 B' b0') (ptcomp E e0 E' e0' B' b0' u2 f') (ptcomp E e0 B b0 B' b0' f v2) =
    trans (PtMap E e0 B' b0') (ptcomp E e0 E' e0' B' b0' u2 f') (ptcomp E e0 E' e0' B' b0' u f') (ptcomp E e0 B b0 B' b0' f v2)
      (ap (PtMap E e0 E' e0') (PtMap E e0 B' b0') (\ M -> ptcomp E e0 E' e0' B' b0' M f') u2 u pU)
      (trans (PtMap E e0 B' b0') (ptcomp E e0 E' e0' B' b0' u f') (ptcomp E e0 B b0 B' b0' f v) (ptcomp E e0 B b0 B' b0' f v2) s
         (sym (PtMap E e0 B' b0') (ptcomp E e0 B b0 B' b0' f v2) (ptcomp E e0 B b0 B' b0' f v) (ap (PtMap B b0 B' b0') (PtMap E e0 B' b0') (ptcomp E e0 B b0 B' b0' f) v2 v pW))) ;
  fm-bridge (u2 : PtMap E e0 E' e0') (pU : Id (PtMap E e0 E' e0') u2 u) (v2 : PtMap B b0 B' b0') (pW : Id (PtMap B b0 B' b0') v2 v) (z : Fb.Fib E e0 B b0 f) :
    Id (Fb.Fib E' e0' B' b0' f') (FM.FibMap[E, e0, B, b0, E', e0', B', b0', f, f', u2, v2, bridge u2 pU v2 pW].fm-fun z) (FM.FibMap[E, e0, B, b0, E', e0', B', b0', f, f', u, v, s].fm-fun z) =
    idJR (PtMap E e0 E' e0') u (\ u3 pU3 -> Id (Fb.Fib E' e0' B' b0' f') (FM.FibMap[E, e0, B, b0, E', e0', B', b0', f, f', u3, v2, bridge u3 pU3 v2 pW].fm-fun z) (FM.FibMap[E, e0, B, b0, E', e0', B', b0', f, f', u, v, s].fm-fun z))
      (idJR (PtMap B b0 B' b0') v (\ v3 pW3 -> Id (Fb.Fib E' e0' B' b0' f') (FM.FibMap[E, e0, B, b0, E', e0', B', b0', f, f', u, v3, bridge u (refl u) v3 pW3].fm-fun z) (FM.FibMap[E, e0, B, b0, E', e0', B', b0', f, f', u, v, s].fm-fun z))
         (ap (Id (PtMap E e0 B' b0') (ptcomp E e0 E' e0' B' b0' u f') (ptcomp E e0 B b0 B' b0' f v)) (Fb.Fib E' e0' B' b0' f')
            (\ s1 -> FM.FibMap[E, e0, B, b0, E', e0', B', b0', f, f', u, v, s1].fm-fun z)
            (bridge u (refl u) v (refl v)) s (trans-refl-l (PtMap E e0 B' b0') (ptcomp E e0 E' e0' B' b0' u f') (ptcomp E e0 B b0 B' b0' f v) s))
         v2 pW)
      u2 pU ;
} ;

------------------------------------------------------------------------
-- fm of a pasted square

-- (A . B) . (C . (D . e)) = A . ((B . (C . D)) . e)
grp4 (X : U l) (x1 x2 x3 x4 x5 : X) (A : Id X x1 x2) (B : Id X x2 x3) (C : Id X x3 x4) (D : Id X x4 x5) : (x6 : X) (e : Id X x5 x6) ->
  Id (Id X x1 x6) (trans X x1 x3 x6 (trans X x1 x2 x3 A B) (trans X x3 x4 x6 C (trans X x4 x5 x6 D e)))
    (trans X x1 x2 x6 A (trans X x2 x5 x6 (trans X x2 x3 x5 B (trans X x3 x4 x5 C D)) e)) =
  \ x6 e -> idJ X x5 (\ x7 e1 -> Id (Id X x1 x7) (trans X x1 x3 x7 (trans X x1 x2 x3 A B) (trans X x3 x4 x7 C (trans X x4 x5 x7 D e1)))
      (trans X x1 x2 x7 A (trans X x2 x5 x7 (trans X x2 x3 x5 B (trans X x3 x4 x5 C D)) e1)))
    (Gp.tassoc X x1 x2 x3 A B x5 (trans X x3 x4 x5 C D)) x6 e ;

module Paste (E : U l) (e0 : E) (B : U l) (b0 : B) (E' : U l) (e0' : E') (B' : U l) (b0' : B') (E'' : U l) (e0'' : E'') (B'' : U l) (b0'' : B'')
  (f : PtMap E e0 B b0) (f' : PtMap E' e0' B' b0') (f'' : PtMap E'' e0'' B'' b0'')
  (u : PtMap E e0 E' e0') (v : PtMap B b0 B' b0') (u' : PtMap E' e0' E'' e0'') (v' : PtMap B' b0' B'' b0'')
  (sq : Id (PtMap E e0 B' b0') (ptcomp E e0 E' e0' B' b0' u f') (ptcomp E e0 B b0 B' b0' f v))
  (sq' : Id (PtMap E' e0' B'' b0'') (ptcomp E' e0' E'' e0'' B'' b0'' u' f'') (ptcomp E' e0' B' b0' B'' b0'' f' v')) {
  W2 : PtMap E e0 E'' e0'' = ptcomp E e0 E' e0' E'' e0'' u u' ;
  V2 : PtMap B b0 B'' b0'' = ptcomp B b0 B' b0' B'' b0'' v v' ;
  -- the five steps of the pasting, with their points
  PP0 : PtMap E e0 B'' b0'' = ptcomp E e0 E'' e0'' B'' b0'' W2 f'' ;
  PP1 : PtMap E e0 B'' b0'' = ptcomp E e0 E' e0' B'' b0'' u (ptcomp E' e0' E'' e0'' B'' b0'' u' f'') ;
  PP2 : PtMap E e0 B'' b0'' = ptcomp E e0 E' e0' B'' b0'' u (ptcomp E' e0' B' b0' B'' b0'' f' v') ;
  PP3 : PtMap E e0 B'' b0'' = ptcomp E e0 B' b0' B'' b0'' (ptcomp E e0 E' e0' B' b0' u f') v' ;
  PP4 : PtMap E e0 B'' b0'' = ptcomp E e0 B' b0' B'' b0'' (ptcomp E e0 B b0 B' b0' f v) v' ;
  PP5 : PtMap E e0 B'' b0'' = ptcomp E e0 B b0 B'' b0'' f V2 ;
  a1 : Id (PtMap E e0 B'' b0'') PP0 PP1 = ptcomp-assoc E e0 E' e0' E'' e0'' B'' b0'' u u' f'' ;
  a2 : Id (PtMap E e0 B'' b0'') PP1 PP2 =
    ap (PtMap E' e0' B'' b0'') (PtMap E e0 B'' b0'') (ptcomp E e0 E' e0' B'' b0'' u) (ptcomp E' e0' E'' e0'' B'' b0'' u' f'') (ptcomp E' e0' B' b0' B'' b0'' f' v') sq' ;
  a3 : Id (PtMap E e0 B'' b0'') PP2 PP3 = sym (PtMap E e0 B'' b0'') PP3 PP2 (ptcomp-assoc E e0 E' e0' B' b0' B'' b0'' u f' v') ;
  a4 : Id (PtMap E e0 B'' b0'') PP3 PP4 =
    ap (PtMap E e0 B' b0') (PtMap E e0 B'' b0'') (\ M -> ptcomp E e0 B' b0' B'' b0'' M v') (ptcomp E e0 E' e0' B' b0' u f') (ptcomp E e0 B b0 B' b0' f v) sq ;
  a5 : Id (PtMap E e0 B'' b0'') PP4 PP5 = ptcomp-assoc E e0 B b0 B' b0' B'' b0'' f v v' ;
  p45 : Id (PtMap E e0 B'' b0'') PP3 PP5 = trans (PtMap E e0 B'' b0'') PP3 PP4 PP5 a4 a5 ;
  p35 : Id (PtMap E e0 B'' b0'') PP2 PP5 = trans (PtMap E e0 B'' b0'') PP2 PP3 PP5 a3 p45 ;
  p25 : Id (PtMap E e0 B'' b0'') PP1 PP5 = trans (PtMap E e0 B'' b0'') PP1 PP2 PP5 a2 p35 ;
  -- the intrinsic pasting: assoc, u ; H', assoc^-1, H ; v', assoc
  paste : Id (PtMap E e0 B'' b0'') PP0 PP5 = trans (PtMap E e0 B'' b0'') PP0 PP1 PP5 a1 p25 ;
  module F0 = FM.FibMap[E, e0, B, b0, E', e0', B', b0', f, f', u, v, sq] ;
  module F1 = FM.FibMap[E', e0', B', b0', E'', e0'', B'', b0'', f', f'', u', v', sq'] ;
  module F2 = FM.FibMap[E, e0, B, b0, E'', e0'', B'', b0'', f, f'', W2, V2, paste] ;
  -- its homotopy: hs'(u x) . ap v' (hs x)
  hs-paste (x : E) : Id (Id B'' (f''.1 (u'.1 (u.1 x))) (v'.1 (v.1 (f.1 x)))) (F2.hs x)
      (trans B'' (f''.1 (u'.1 (u.1 x))) (v'.1 (f'.1 (u.1 x))) (v'.1 (v.1 (f.1 x))) (F1.hs (u.1 x)) (ap B' B'' v'.1 (f'.1 (u.1 x)) (v.1 (f.1 x)) (F0.hs x))) =
    calc (Id B'' (f''.1 (u'.1 (u.1 x))) (v'.1 (v.1 (f.1 x)))) {
      hp E e0 B'' b0'' PP0 PP5 paste x
        =< hp-trans E e0 B'' b0'' PP0 PP1 a1 x PP5 p25 >
      trans B'' (f''.1 (u'.1 (u.1 x))) (f''.1 (u'.1 (u.1 x))) (v'.1 (v.1 (f.1 x))) (hp E e0 B'' b0'' PP0 PP1 a1 x) (hp E e0 B'' b0'' PP1 PP5 p25 x)
        =< apH (\ e -> trans B'' (f''.1 (u'.1 (u.1 x))) (f''.1 (u'.1 (u.1 x))) (v'.1 (v.1 (f.1 x))) e (hp E e0 B'' b0'' PP1 PP5 p25 x)) (hp-assoc E e0 E' e0' E'' e0'' B'' b0'' u u' f'' x) >
      trans B'' (f''.1 (u'.1 (u.1 x))) (f''.1 (u'.1 (u.1 x))) (v'.1 (v.1 (f.1 x))) (refl (f''.1 (u'.1 (u.1 x)))) (hp E e0 B'' b0'' PP1 PP5 p25 x)
        =< trans-refl-l B'' (f''.1 (u'.1 (u.1 x))) (v'.1 (v.1 (f.1 x))) (hp E e0 B'' b0'' PP1 PP5 p25 x) >
      hp E e0 B'' b0'' PP1 PP5 p25 x
        =< hp-trans E e0 B'' b0'' PP1 PP2 a2 x PP5 p35 >
      trans B'' (f''.1 (u'.1 (u.1 x))) (v'.1 (f'.1 (u.1 x))) (v'.1 (v.1 (f.1 x))) (hp E e0 B'' b0'' PP1 PP2 a2 x) (hp E e0 B'' b0'' PP2 PP5 p35 x)
        =< apH (\ e -> trans B'' (f''.1 (u'.1 (u.1 x))) (v'.1 (f'.1 (u.1 x))) (v'.1 (v.1 (f.1 x))) e (hp E e0 B'' b0'' PP2 PP5 p35 x))
             (hp-pre E e0 E' e0' B'' b0'' u (ptcomp E' e0' E'' e0'' B'' b0'' u' f'') x (ptcomp E' e0' B' b0' B'' b0'' f' v') sq') >
      trans B'' (f''.1 (u'.1 (u.1 x))) (v'.1 (f'.1 (u.1 x))) (v'.1 (v.1 (f.1 x))) (F1.hs (u.1 x)) (hp E e0 B'' b0'' PP2 PP5 p35 x)
        =< apH (trans B'' (f''.1 (u'.1 (u.1 x))) (v'.1 (f'.1 (u.1 x))) (v'.1 (v.1 (f.1 x))) (F1.hs (u.1 x))) (calc (Id B'' (v'.1 (f'.1 (u.1 x))) (v'.1 (v.1 (f.1 x)))) {
          hp E e0 B'' b0'' PP2 PP5 p35 x
            =< hp-trans E e0 B'' b0'' PP2 PP3 a3 x PP5 p45 >
          trans B'' (v'.1 (f'.1 (u.1 x))) (v'.1 (f'.1 (u.1 x))) (v'.1 (v.1 (f.1 x))) (hp E e0 B'' b0'' PP2 PP3 a3 x) (hp E e0 B'' b0'' PP3 PP5 p45 x)
            =< apH (\ e -> trans B'' (v'.1 (f'.1 (u.1 x))) (v'.1 (f'.1 (u.1 x))) (v'.1 (v.1 (f.1 x))) e (hp E e0 B'' b0'' PP3 PP5 p45 x))
                 (transH (hp-sym E e0 B'' b0'' PP3 x PP2 (ptcomp-assoc E e0 E' e0' B' b0' B'' b0'' u f' v'))
                    (apH (sym B'' (v'.1 (f'.1 (u.1 x))) (v'.1 (f'.1 (u.1 x)))) (hp-assoc E e0 E' e0' B' b0' B'' b0'' u f' v' x))) >
          trans B'' (v'.1 (f'.1 (u.1 x))) (v'.1 (f'.1 (u.1 x))) (v'.1 (v.1 (f.1 x))) (refl (v'.1 (f'.1 (u.1 x)))) (hp E e0 B'' b0'' PP3 PP5 p45 x)
            =< trans-refl-l B'' (v'.1 (f'.1 (u.1 x))) (v'.1 (v.1 (f.1 x))) (hp E e0 B'' b0'' PP3 PP5 p45 x) >
          hp E e0 B'' b0'' PP3 PP5 p45 x
            =< hp-trans E e0 B'' b0'' PP3 PP4 a4 x PP5 a5 >
          trans B'' (v'.1 (f'.1 (u.1 x))) (v'.1 (v.1 (f.1 x))) (v'.1 (v.1 (f.1 x))) (hp E e0 B'' b0'' PP3 PP4 a4 x) (hp E e0 B'' b0'' PP4 PP5 a5 x)
            =< apH (trans B'' (v'.1 (f'.1 (u.1 x))) (v'.1 (v.1 (f.1 x))) (v'.1 (v.1 (f.1 x))) (hp E e0 B'' b0'' PP3 PP4 a4 x)) (hp-assoc E e0 B b0 B' b0' B'' b0'' f v v' x) >
          hp E e0 B'' b0'' PP3 PP4 a4 x
            =< hp-post E e0 B' b0' B'' b0'' v' (ptcomp E e0 E' e0' B' b0' u f') x (ptcomp E e0 B b0 B' b0' f v) sq >
          ap B' B'' v'.1 (f'.1 (u.1 x)) (v.1 (f.1 x)) (F0.hs x) }) >
      trans B'' (f''.1 (u'.1 (u.1 x))) (v'.1 (f'.1 (u.1 x))) (v'.1 (v.1 (f.1 x))) (F1.hs (u.1 x)) (ap B' B'' v'.1 (f'.1 (u.1 x)) (v.1 (f.1 x)) (F0.hs x)) } ;
  -- the second components agree
  eq2 (x : E) (q : Id B (f.1 x) b0) : Id (Id B'' (f''.1 (u'.1 (u.1 x))) b0'') (F2.fm-fun (x, q)).2 (F1.fm-fun (F0.fm-fun (x, q))).2 =
    calc (Id B'' (f''.1 (u'.1 (u.1 x))) b0'') {
      trans B'' (f''.1 (u'.1 (u.1 x))) (v'.1 (v.1 (f.1 x))) b0'' (F2.hs x)
        (trans B'' (v'.1 (v.1 (f.1 x))) (v'.1 (v.1 b0)) b0'' (ap B B'' (\ b -> v'.1 (v.1 b)) (f.1 x) b0 q) (trans B'' (v'.1 (v.1 b0)) (v'.1 b0') b0'' (ap B' B'' v'.1 (v.1 b0) b0' v.2) v'.2))
        =< apH (\ e -> trans B'' (f''.1 (u'.1 (u.1 x))) (v'.1 (v.1 (f.1 x))) b0'' e
                 (trans B'' (v'.1 (v.1 (f.1 x))) (v'.1 (v.1 b0)) b0'' (ap B B'' (\ b -> v'.1 (v.1 b)) (f.1 x) b0 q) (trans B'' (v'.1 (v.1 b0)) (v'.1 b0') b0'' (ap B' B'' v'.1 (v.1 b0) b0' v.2) v'.2)))
             (hs-paste x) >
      trans B'' (f''.1 (u'.1 (u.1 x))) (v'.1 (v.1 (f.1 x))) b0'' (trans B'' (f''.1 (u'.1 (u.1 x))) (v'.1 (f'.1 (u.1 x))) (v'.1 (v.1 (f.1 x))) (F1.hs (u.1 x)) (ap B' B'' v'.1 (f'.1 (u.1 x)) (v.1 (f.1 x)) (F0.hs x)))
        (trans B'' (v'.1 (v.1 (f.1 x))) (v'.1 (v.1 b0)) b0'' (ap B B'' (\ b -> v'.1 (v.1 b)) (f.1 x) b0 q) (trans B'' (v'.1 (v.1 b0)) (v'.1 b0') b0'' (ap B' B'' v'.1 (v.1 b0) b0' v.2) v'.2))
        =< grp4 B'' (f''.1 (u'.1 (u.1 x))) (v'.1 (f'.1 (u.1 x))) (v'.1 (v.1 (f.1 x))) (v'.1 (v.1 b0)) (v'.1 b0') (F1.hs (u.1 x)) (ap B' B'' v'.1 (f'.1 (u.1 x)) (v.1 (f.1 x)) (F0.hs x))
             (ap B B'' (\ b -> v'.1 (v.1 b)) (f.1 x) b0 q) (ap B' B'' v'.1 (v.1 b0) b0' v.2) b0'' v'.2 >
      trans B'' (f''.1 (u'.1 (u.1 x))) (v'.1 (f'.1 (u.1 x))) b0'' (F1.hs (u.1 x))
        (trans B'' (v'.1 (f'.1 (u.1 x))) (v'.1 b0') b0''
           (trans B'' (v'.1 (f'.1 (u.1 x))) (v'.1 (v.1 (f.1 x))) (v'.1 b0') (ap B' B'' v'.1 (f'.1 (u.1 x)) (v.1 (f.1 x)) (F0.hs x))
              (trans B'' (v'.1 (v.1 (f.1 x))) (v'.1 (v.1 b0)) (v'.1 b0') (ap B B'' (\ b -> v'.1 (v.1 b)) (f.1 x) b0 q) (ap B' B'' v'.1 (v.1 b0) b0' v.2)))
           v'.2)
        =< apH (\ e -> trans B'' (f''.1 (u'.1 (u.1 x))) (v'.1 (f'.1 (u.1 x))) b0'' (F1.hs (u.1 x)) (trans B'' (v'.1 (f'.1 (u.1 x))) (v'.1 b0') b0'' e v'.2))
             (symH (calc (Id B'' (v'.1 (f'.1 (u.1 x))) (v'.1 b0')) {
               ap B' B'' v'.1 (f'.1 (u.1 x)) b0' (trans B' (f'.1 (u.1 x)) (v.1 (f.1 x)) b0' (F0.hs x) (trans B' (v.1 (f.1 x)) (v.1 b0) b0' (ap B B' v.1 (f.1 x) b0 q) v.2))
                 =< Gp.ap-trans B' B'' v'.1 (f'.1 (u.1 x)) (v.1 (f.1 x)) b0' (F0.hs x) (trans B' (v.1 (f.1 x)) (v.1 b0) b0' (ap B B' v.1 (f.1 x) b0 q) v.2) >
               trans B'' (v'.1 (f'.1 (u.1 x))) (v'.1 (v.1 (f.1 x))) (v'.1 b0') (ap B' B'' v'.1 (f'.1 (u.1 x)) (v.1 (f.1 x)) (F0.hs x))
                 (ap B' B'' v'.1 (v.1 (f.1 x)) b0' (trans B' (v.1 (f.1 x)) (v.1 b0) b0' (ap B B' v.1 (f.1 x) b0 q) v.2))
                 =< apH (trans B'' (v'.1 (f'.1 (u.1 x))) (v'.1 (v.1 (f.1 x))) (v'.1 b0') (ap B' B'' v'.1 (f'.1 (u.1 x)) (v.1 (f.1 x)) (F0.hs x)))
                      (transH (Gp.ap-trans B' B'' v'.1 (v.1 (f.1 x)) (v.1 b0) b0' (ap B B' v.1 (f.1 x) b0 q) v.2)
                         (apH (\ e -> trans B'' (v'.1 (v.1 (f.1 x))) (v'.1 (v.1 b0)) (v'.1 b0') e (ap B' B'' v'.1 (v.1 b0) b0' v.2))
                            (ap-ap B B' B'' v.1 v'.1 (f.1 x) b0 q))) >
               trans B'' (v'.1 (f'.1 (u.1 x))) (v'.1 (v.1 (f.1 x))) (v'.1 b0') (ap B' B'' v'.1 (f'.1 (u.1 x)) (v.1 (f.1 x)) (F0.hs x))
                 (trans B'' (v'.1 (v.1 (f.1 x))) (v'.1 (v.1 b0)) (v'.1 b0') (ap B B'' (\ b -> v'.1 (v.1 b)) (f.1 x) b0 q) (ap B' B'' v'.1 (v.1 b0) b0' v.2)) })) >
      trans B'' (f''.1 (u'.1 (u.1 x))) (v'.1 (f'.1 (u.1 x))) b0'' (F1.hs (u.1 x))
        (trans B'' (v'.1 (f'.1 (u.1 x))) (v'.1 b0') b0''
           (ap B' B'' v'.1 (f'.1 (u.1 x)) b0' (trans B' (f'.1 (u.1 x)) (v.1 (f.1 x)) b0' (F0.hs x) (trans B' (v.1 (f.1 x)) (v.1 b0) b0' (ap B B' v.1 (f.1 x) b0 q) v.2)))
           v'.2) } ;
  -- Proposition funct (composition), pointwise
  fm-paste (z : Fb.Fib E e0 B b0 f) : Id (Fb.Fib E'' e0'' B'' b0'' f'') (F2.fm-fun z) (F1.fm-fun (F0.fm-fun z)) =
    ap (Id B'' (f''.1 (u'.1 (u.1 z.1))) b0'') (Fb.Fib E'' e0'' B'' b0'' f'') (\ w -> (u'.1 (u.1 z.1), w)) (F2.fm-fun z).2 (F1.fm-fun (F0.fm-fun z)).2 (eq2 z.1 z.2) ;
} ;

------------------------------------------------------------------------
-- fm of the identity square

module FmId (E : U l) (e0 : E) (B : U l) (b0 : B) (f : PtMap E e0 B b0) {
  idsq : Id (PtMap E e0 B b0) (ptcomp E e0 E e0 B b0 (ptid E e0) f) (ptcomp E e0 B b0 B b0 f (ptid B b0)) =
    trans (PtMap E e0 B b0) (ptcomp E e0 E e0 B b0 (ptid E e0) f) f (ptcomp E e0 B b0 B b0 f (ptid B b0))
      (Fb.ptcomp-idl E e0 B b0 f) (sym (PtMap E e0 B b0) (ptcomp E e0 B b0 B b0 f (ptid B b0)) f (Fb.ptcomp-idr E e0 B b0 f)) ;
  module F = FM.FibMap[E, e0, B, b0, E, e0, B, b0, f, f, ptid E e0, ptid B b0, idsq] ;
  hs-id (x : E) : Id (Id B (f.1 x) (f.1 x)) (F.hs x) (refl (f.1 x)) =
    calc (Id B (f.1 x) (f.1 x)) {
      hp E e0 B b0 (ptcomp E e0 E e0 B b0 (ptid E e0) f) (ptcomp E e0 B b0 B b0 f (ptid B b0)) idsq x
        =< hp-trans E e0 B b0 (ptcomp E e0 E e0 B b0 (ptid E e0) f) f (Fb.ptcomp-idl E e0 B b0 f) x (ptcomp E e0 B b0 B b0 f (ptid B b0)) (sym (PtMap E e0 B b0) (ptcomp E e0 B b0 B b0 f (ptid B b0)) f (Fb.ptcomp-idr E e0 B b0 f)) >
      trans B (f.1 x) (f.1 x) (f.1 x) (hp E e0 B b0 (ptcomp E e0 E e0 B b0 (ptid E e0) f) f (Fb.ptcomp-idl E e0 B b0 f) x)
        (hp E e0 B b0 f (ptcomp E e0 B b0 B b0 f (ptid B b0)) (sym (PtMap E e0 B b0) (ptcomp E e0 B b0 B b0 f (ptid B b0)) f (Fb.ptcomp-idr E e0 B b0 f)) x)
        =< apH (\ e -> trans B (f.1 x) (f.1 x) (f.1 x) e (hp E e0 B b0 f (ptcomp E e0 B b0 B b0 f (ptid B b0)) (sym (PtMap E e0 B b0) (ptcomp E e0 B b0 B b0 f (ptid B b0)) f (Fb.ptcomp-idr E e0 B b0 f)) x))
             (hp-pair E e0 B b0 f.1 (trans B (f.1 e0) (f.1 e0) b0 (refl (f.1 e0)) f.2) x f.2 (trans-refl-l B (f.1 e0) b0 f.2)) >
      trans B (f.1 x) (f.1 x) (f.1 x) (refl (f.1 x))
        (hp E e0 B b0 f (ptcomp E e0 B b0 B b0 f (ptid B b0)) (sym (PtMap E e0 B b0) (ptcomp E e0 B b0 B b0 f (ptid B b0)) f (Fb.ptcomp-idr E e0 B b0 f)) x)
        =< apH (trans B (f.1 x) (f.1 x) (f.1 x) (refl (f.1 x)))
             (transH (hp-sym E e0 B b0 (ptcomp E e0 B b0 B b0 f (ptid B b0)) x f (Fb.ptcomp-idr E e0 B b0 f))
                (apH (sym B (f.1 x) (f.1 x)) (hp-pair E e0 B b0 f.1 (ap B B (\ b -> b) (f.1 e0) b0 f.2) x f.2 (Fb.ap-id B (f.1 e0) b0 f.2)))) >
      refl (f.1 x) } ;
  fm-id (z : Fb.Fib E e0 B b0 f) : Id (Fb.Fib E e0 B b0 f) (F.fm-fun z) z =
    ap (Id B (f.1 z.1) b0) (Fb.Fib E e0 B b0 f) (\ w -> (z.1, w)) (F.fm-fun z).2 z.2
      (transH (apH (\ e -> trans B (f.1 z.1) (f.1 z.1) b0 e (ap B B (\ b -> b) (f.1 z.1) b0 z.2)) (hs-id z.1))
         (transH (trans-refl-l B (f.1 z.1) b0 (ap B B (\ b -> b) (f.1 z.1) b0 z.2)) (Fb.ap-id B (f.1 z.1) b0 z.2))) ;
} ;

------------------------------------------------------------------------
-- K(g ; h, m) = K(g, m) ; K(h, m) and K(1, m) = id with the locked K

kc-lev (Ga Gb Gc : Ab) (g : Hom Ga Gb) (h : Hom Gb Gc) (m : Nat) :
  Id (PtMap (KK[Ga].K m) (KK[Ga].pt m) (KK[Gc].K m) (KK[Gc].pt m)) (HB.Lev[Ga, Gc].K (KFun[l].hcomp Ga Gb Gc g h) m)
    (ptcomp (KK[Ga].K m) (KK[Ga].pt m) (KK[Gb].K m) (KK[Gb].pt m) (KK[Gc].K m) (KK[Gc].pt m) (HB.Lev[Ga, Gb].K g m) (HB.Lev[Gb, Gc].K h m)) =
  calc (PtMap (KK[Ga].K m) (KK[Ga].pt m) (KK[Gc].K m) (KK[Gc].pt m)) {
    HB.Lev[Ga, Gc].K (KFun[l].hcomp Ga Gb Gc g h) m
      =< symH (HB.Lev[Ga, Gc].K-def (KFun[l].hcomp Ga Gb Gc g h) m) >
    KMap[Ga, Gc, KFun[l].hcomp Ga Gb Gc g h].K m
      =< KFun[l].Comp[Ga, Gb, Gc, g, h].k-comp m >
    ptcomp (KK[Ga].K m) (KK[Ga].pt m) (KK[Gb].K m) (KK[Gb].pt m) (KK[Gc].K m) (KK[Gc].pt m) (KMap[Ga, Gb, g].K m) (KMap[Gb, Gc, h].K m)
      =< apH (\ M -> ptcomp (KK[Ga].K m) (KK[Ga].pt m) (KK[Gb].K m) (KK[Gb].pt m) (KK[Gc].K m) (KK[Gc].pt m) M (KMap[Gb, Gc, h].K m)) (HB.Lev[Ga, Gb].K-def g m) >
    ptcomp (KK[Ga].K m) (KK[Ga].pt m) (KK[Gb].K m) (KK[Gb].pt m) (KK[Gc].K m) (KK[Gc].pt m) (HB.Lev[Ga, Gb].K g m) (KMap[Gb, Gc, h].K m)
      =< apH (ptcomp (KK[Ga].K m) (KK[Ga].pt m) (KK[Gb].K m) (KK[Gb].pt m) (KK[Gc].K m) (KK[Gc].pt m) (HB.Lev[Ga, Gb].K g m)) (HB.Lev[Gb, Gc].K-def h m) >
    ptcomp (KK[Ga].K m) (KK[Ga].pt m) (KK[Gb].K m) (KK[Gb].pt m) (KK[Gc].K m) (KK[Gc].pt m) (HB.Lev[Ga, Gb].K g m) (HB.Lev[Gb, Gc].K h m) } ;

module KId (Ga : Ab) {
  module A = KK[Ga] ;
  module L = HB.Lev[Ga, Ga] ;
  idh : Hom Ga Ga = (\ a -> a, \ x y -> refl (Ga.add x y)) ;
  -- 1 ; h = h
  comp-id (h : Hom Ga Ga) : Id (Hom Ga Ga) (KFun[l].hcomp Ga Ga Ga idh h) h = KFun[l].hom-path Ga Ga (KFun[l].hcomp Ga Ga Ga idh h) h (\ a -> refl (h.1 a)) ;
  -- if K(h, m) = id then K(1, m) = K(1 ; h, m) = K(h, m) = id
  kid (m : Nat) (h : Hom Ga Ga) (eh : Id (PtMap (A.K m) (A.pt m) (A.K m) (A.pt m)) (L.K h m) (ptid (A.K m) (A.pt m))) :
    Id (PtMap (A.K m) (A.pt m) (A.K m) (A.pt m)) (L.K idh m) (ptid (A.K m) (A.pt m)) =
    calc (PtMap (A.K m) (A.pt m) (A.K m) (A.pt m)) {
      L.K idh m
        =< symH (Fb.ptcomp-idr (A.K m) (A.pt m) (A.K m) (A.pt m) (L.K idh m)) >
      ptcomp (A.K m) (A.pt m) (A.K m) (A.pt m) (A.K m) (A.pt m) (L.K idh m) (ptid (A.K m) (A.pt m))
        =< apH (ptcomp (A.K m) (A.pt m) (A.K m) (A.pt m) (A.K m) (A.pt m) (L.K idh m)) (symH eh) >
      ptcomp (A.K m) (A.pt m) (A.K m) (A.pt m) (A.K m) (A.pt m) (L.K idh m) (L.K h m)
        =< symH (kc-lev Ga Ga Ga idh h m) >
      L.K (KFun[l].hcomp Ga Ga Ga idh h) m
        =< apH (\ g -> L.K g m) (comp-id h) >
      L.K h m
        =< eh >
      ptid (A.K m) (A.pt m) } ;
  k2-id : Id (PtMap (A.K two) (A.pt two) (A.K two) (A.pt two)) (L.K idh two) (ptid (A.K two) (A.pt two)) =
    kid two (HB.H2[Ga, Ga].inv2 (ptid (A.K two) (A.pt two))) (HB.H2[Ga, Ga].k2-surj (ptid (A.K two) (A.pt two))) ;
  k4-id : Id (PtMap (A.K four) (A.pt four) (A.K four) (A.pt four)) (L.K idh four) (ptid (A.K four) (A.pt four)) =
    kid four (FH.Climb[Ga, Ga].inv4 (ptid (A.K four) (A.pt four))) (FH.Climb[Ga, Ga].surj4 (ptid (A.K four) (A.pt four))) ;
} ;

------------------------------------------------------------------------
-- intrinsic composition and identity, and realise-map

module Maps3 (Ga Gb : Ab) (k : PtMap (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four))
  (Ga' Gb' : Ab) (k' : PtMap (KK[Ga'].K two) (KK[Ga'].pt two) (KK[Gb'].K four) (KK[Gb'].pt four))
  (Ga'' Gb'' : Ab) (k'' : PtMap (KK[Ga''].K two) (KK[Ga''].pt two) (KK[Gb''].K four) (KK[Gb''].pt four)) {
  module MS = Maps2[Ga, Gb, k, Ga', Gb', k'] ;
  module MT = Maps2[Ga', Gb', k', Ga'', Gb'', k''] ;
  module MU = Maps2[Ga, Gb, k, Ga'', Gb'', k''] ;
  module KA = KK[Ga] ; module KB = KK[Gb] ; module KA' = KK[Ga'] ; module KB' = KK[Gb'] ; module KA'' = KK[Ga''] ; module KB'' = KK[Gb''] ;
  -- the pasting of H and H'
  paste-mm (m : MS.Mor) (m' : MT.Mor) :
    Id (PtMap (KA.K two) (KA.pt two) (KB''.K four) (KB''.pt four))
      (ptcomp (KA.K two) (KA.pt two) (KA''.K two) (KA''.pt two) (KB''.K four) (KB''.pt four) (ptcomp (KA.K two) (KA.pt two) (KA'.K two) (KA'.pt two) (KA''.K two) (KA''.pt two) (MS.LA.K (MS.mor-a m) two) (MT.LA.K (MT.mor-a m') two)) k'')
      (ptcomp (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) (KB''.K four) (KB''.pt four) k (ptcomp (KB.K four) (KB.pt four) (KB'.K four) (KB'.pt four) (KB''.K four) (KB''.pt four) (MS.LB.K (MS.mor-b m) four) (MT.LB.K (MT.mor-b m') four))) =
    Paste[KA.K two, KA.pt two, KB.K four, KB.pt four, KA'.K two, KA'.pt two, KB'.K four, KB'.pt four, KA''.K two, KA''.pt two, KB''.K four, KB''.pt four,
          k, k', k'', MS.LA.K (MS.mor-a m) two, MS.LB.K (MS.mor-b m) four, MT.LA.K (MT.mor-a m') two, MT.LB.K (MT.mor-b m') four, MS.mor-H m, MT.mor-H m'].paste ;
  -- Definition: m ; m' = (a ; a', b ; b', k-comp, paste, k-comp^-1)
  mcomp (m : MS.Mor) (m' : MT.Mor) : MU.Mor =
    (KFun[l].hcomp Ga Ga' Ga'' (MS.mor-a m) (MT.mor-a m'), KFun[l].hcomp Gb Gb' Gb'' (MS.mor-b m) (MT.mor-b m'),
     Bridge[KA.K two, KA.pt two, KB.K four, KB.pt four, KA''.K two, KA''.pt two, KB''.K four, KB''.pt four, k, k'',
            ptcomp (KA.K two) (KA.pt two) (KA'.K two) (KA'.pt two) (KA''.K two) (KA''.pt two) (MS.LA.K (MS.mor-a m) two) (MT.LA.K (MT.mor-a m') two),
            ptcomp (KB.K four) (KB.pt four) (KB'.K four) (KB'.pt four) (KB''.K four) (KB''.pt four) (MS.LB.K (MS.mor-b m) four) (MT.LB.K (MT.mor-b m') four),
            paste-mm m m'].bridge
       (MU.LA.K (KFun[l].hcomp Ga Ga' Ga'' (MS.mor-a m) (MT.mor-a m')) two) (kc-lev Ga Ga' Ga'' (MS.mor-a m) (MT.mor-a m') two)
       (MU.LB.K (KFun[l].hcomp Gb Gb' Gb'' (MS.mor-b m) (MT.mor-b m')) four) (kc-lev Gb Gb' Gb'' (MS.mor-b m) (MT.mor-b m') four)) ;
  -- Proposition funct (composition), pointwise
  rmap-comp-pt (m : MS.Mor) (m' : MT.Mor) (z : MS.R.F) :
    Id MU.R'.F ((MU.realise-map (mcomp m m')).1 z) ((ptcomp MS.R.F MS.R.f0 MS.R'.F MS.R'.f0 MU.R'.F MU.R'.f0 (MS.realise-map m) (MT.realise-map m')).1 z) =
    transH
      (Bridge[KA.K two, KA.pt two, KB.K four, KB.pt four, KA''.K two, KA''.pt two, KB''.K four, KB''.pt four, k, k'',
              ptcomp (KA.K two) (KA.pt two) (KA'.K two) (KA'.pt two) (KA''.K two) (KA''.pt two) (MS.LA.K (MS.mor-a m) two) (MT.LA.K (MT.mor-a m') two),
              ptcomp (KB.K four) (KB.pt four) (KB'.K four) (KB'.pt four) (KB''.K four) (KB''.pt four) (MS.LB.K (MS.mor-b m) four) (MT.LB.K (MT.mor-b m') four),
              paste-mm m m'].fm-bridge
         (MU.LA.K (KFun[l].hcomp Ga Ga' Ga'' (MS.mor-a m) (MT.mor-a m')) two) (kc-lev Ga Ga' Ga'' (MS.mor-a m) (MT.mor-a m') two)
         (MU.LB.K (KFun[l].hcomp Gb Gb' Gb'' (MS.mor-b m) (MT.mor-b m')) four) (kc-lev Gb Gb' Gb'' (MS.mor-b m) (MT.mor-b m') four) z)
      (Paste[KA.K two, KA.pt two, KB.K four, KB.pt four, KA'.K two, KA'.pt two, KB'.K four, KB'.pt four, KA''.K two, KA''.pt two, KB''.K four, KB''.pt four,
             k, k', k'', MS.LA.K (MS.mor-a m) two, MS.LB.K (MS.mor-b m) four, MT.LA.K (MT.mor-a m') two, MT.LB.K (MT.mor-b m') four, MS.mor-H m, MT.mor-H m'].fm-paste z) ;
  -- in [Fib k, Fib k'']_* (pi-mere: Omega Fib k'' is connected)
  rmap-comp (m : MS.Mor) (m' : MT.Mor) :
    Id (HC MS.R.F MS.R.f0 MU.R'.F MU.R'.f0) (hcl MS.R.F MS.R.f0 MU.R'.F MU.R'.f0 (MU.realise-map (mcomp m m')))
      (hcl MS.R.F MS.R.f0 MU.R'.F MU.R'.f0 (ptcomp MS.R.F MS.R.f0 MS.R'.F MS.R'.f0 MU.R'.F MU.R'.f0 (MS.realise-map m) (MT.realise-map m'))) =
    STr[PtMap MS.R.F MS.R.f0 MU.R'.F MU.R'.f0].Q.relates (MU.realise-map (mcomp m m')) (ptcomp MS.R.F MS.R.f0 MS.R'.F MS.R'.f0 MU.R'.F MU.R'.f0 (MS.realise-map m) (MT.realise-map m'))
      (FH.pi-mere MS.R.F MS.R.f0 MU.R'.F MU.R'.f0 MU.R'.conn-loops (MU.realise-map (mcomp m m')).1 (ptcomp MS.R.F MS.R.f0 MS.R'.F MS.R'.f0 MU.R'.F MU.R'.f0 (MS.realise-map m) (MT.realise-map m')).1
         (FL.funext MS.R.F (\ z -> MU.R'.F) (MU.realise-map (mcomp m m')).1 (ptcomp MS.R.F MS.R.f0 MS.R'.F MS.R'.f0 MU.R'.F MU.R'.f0 (MS.realise-map m) (MT.realise-map m')).1 (rmap-comp-pt m m'))
         (MU.realise-map (mcomp m m')).2 (ptcomp MS.R.F MS.R.f0 MS.R'.F MS.R'.f0 MU.R'.F MU.R'.f0 (MS.realise-map m) (MT.realise-map m')).2) ;
} ;

module Maps1 (Ga Gb : Ab) (k : PtMap (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four)) {
  module M = Maps2[Ga, Gb, k, Ga, Gb, k] ;
  module KA = KK[Ga] ; module KB = KK[Gb] ;
  -- Definition: id_t = (1, 1, k-id, ptcomp-idl, ptcomp-idr^-1, k-id^-1)
  mid : M.Mor =
    (KId[Ga].idh, KId[Gb].idh,
     Bridge[KA.K two, KA.pt two, KB.K four, KB.pt four, KA.K two, KA.pt two, KB.K four, KB.pt four, k, k, ptid (KA.K two) (KA.pt two), ptid (KB.K four) (KB.pt four),
            FmId[KA.K two, KA.pt two, KB.K four, KB.pt four, k].idsq].bridge
       (M.LA.K KId[Ga].idh two) KId[Ga].k2-id (M.LB.K KId[Gb].idh four) KId[Gb].k4-id) ;
  -- Proposition funct (identity), pointwise
  rmap-id-pt (z : M.R.F) : Id M.R.F ((M.realise-map mid).1 z) z =
    transH
      (Bridge[KA.K two, KA.pt two, KB.K four, KB.pt four, KA.K two, KA.pt two, KB.K four, KB.pt four, k, k, ptid (KA.K two) (KA.pt two), ptid (KB.K four) (KB.pt four),
              FmId[KA.K two, KA.pt two, KB.K four, KB.pt four, k].idsq].fm-bridge
         (M.LA.K KId[Ga].idh two) KId[Ga].k2-id (M.LB.K KId[Gb].idh four) KId[Gb].k4-id z)
      (FmId[KA.K two, KA.pt two, KB.K four, KB.pt four, k].fm-id z) ;
  rmap-id : Id (HC M.R.F M.R.f0 M.R.F M.R.f0) (hcl M.R.F M.R.f0 M.R.F M.R.f0 (M.realise-map mid)) (idC M.R.F M.R.f0) =
    STr[PtMap M.R.F M.R.f0 M.R.F M.R.f0].Q.relates (M.realise-map mid) (ptid M.R.F M.R.f0)
      (FH.pi-mere M.R.F M.R.f0 M.R.F M.R.f0 M.R.conn-loops (M.realise-map mid).1 (\ z -> z)
         (FL.funext M.R.F (\ z -> M.R.F) (M.realise-map mid).1 (\ z -> z) rmap-id-pt) (M.realise-map mid).2 (refl M.R.f0)) ;
} ;

------------------------------------------------------------------------
-- Theorem hocat: the homotopy category of triples

module Cat {
  -- the triples as data
  Hm (t t' : PC.Triples) : U l = Maps2[t.1, t.2.1, t.2.2, t'.1, t'.2.1, t'.2.2].Mor ;
  Fk (t : PC.Triples) : U l = Triple[t.1, t.2.1, t.2.2].F ;
  fk (t : PC.Triples) : Fk t = Triple[t.1, t.2.1, t.2.2].f0 ;
  -- hom(t, t') = ||Mor t t'||_0 and [realise t, realise t']_*
  homT (t t' : PC.Triples) : U l = STr[Hm t t'].C ;
  HCr (t t' : PC.Triples) : U l = HC (Fk t) (fk t) (Fk t') (fk t') ;
  -- the classes of realise-map: a bijection (Theorem 1)
  R (t t' : PC.Triples) (c : homT t t') : HCr t t' = STrMap[Hm t t', PtMap (Fk t) (fk t) (Fk t') (fk t'), Maps2[t.1, t.2.1, t.2.2, t'.1, t'.2.1, t'.2.2].realise-map].map c ;
  R-inc (t t' : PC.Triples) (m : Hm t t') : Id (HCr t t') (R t t' (STr[Hm t t'].inc m)) (hcl (Fk t) (fk t) (Fk t') (fk t') (Maps2[t.1, t.2.1, t.2.2, t'.1, t'.2.1, t'.2.2].realise-map m)) =
    STrMap[Hm t t', PtMap (Fk t) (fk t) (Fk t') (fk t'), Maps2[t.1, t.2.1, t.2.2, t'.1, t'.2.1, t'.2.2].realise-map].beta m ;
  R-equiv (t t' : PC.Triples) : isEquiv (homT t t') (HCr t t') (R t t') =
    classes-equiv (Hm t t') (PtMap (Fk t) (fk t) (Fk t') (fk t')) Maps2[t.1, t.2.1, t.2.2, t'.1, t'.2.1, t'.2.2].realise-map Maps2[t.1, t.2.1, t.2.2, t'.1, t'.2.1, t'.2.2].realise-map-equiv ;
  -- composition and identities, transported
  compT (t t' t'' : PC.Triples) (c : homT t t') (c' : homT t' t'') : homT t t'' =
    (R-equiv t t'').sec (compC (Fk t) (fk t) (Fk t') (fk t') (Fk t'') (fk t'') (R t t' c) (R t' t'' c')) ;
  idT (t : PC.Triples) : homT t t = (R-equiv t t).sec (idC (Fk t) (fk t)) ;
  R-comp (t t' t'' : PC.Triples) (c : homT t t') (c' : homT t' t'') :
    Id (HCr t t'') (R t t'' (compT t t' t'' c c')) (compC (Fk t) (fk t) (Fk t') (fk t') (Fk t'') (fk t'') (R t t' c) (R t' t'' c')) =
    (R-equiv t t'').sec-eq (compC (Fk t) (fk t) (Fk t') (fk t') (Fk t'') (fk t'') (R t t' c) (R t' t'' c')) ;
  R-id (t : PC.Triples) : Id (HCr t t) (R t t (idT t)) (idC (Fk t) (fk t)) = (R-equiv t t).sec-eq (idC (Fk t) (fk t)) ;
  -- they are the intrinsic pasting and identity on representatives
  compT-rep (t t' t'' : PC.Triples) (m : Hm t t') (m' : Hm t' t'') :
    Id (homT t t'') (compT t t' t'' (STr[Hm t t'].inc m) (STr[Hm t' t''].inc m'))
      (STr[Hm t t''].inc (Maps3[t.1, t.2.1, t.2.2, t'.1, t'.2.1, t'.2.2, t''.1, t''.2.1, t''.2.2].mcomp m m')) =
    E.injective (homT t t'') (HCr t t'') (R t t'') (R-equiv t t'') (compT t t' t'' (STr[Hm t t'].inc m) (STr[Hm t' t''].inc m'))
      (STr[Hm t t''].inc (Maps3[t.1, t.2.1, t.2.2, t'.1, t'.2.1, t'.2.2, t''.1, t''.2.1, t''.2.2].mcomp m m'))
      (calc (HCr t t'') {
        R t t'' (compT t t' t'' (STr[Hm t t'].inc m) (STr[Hm t' t''].inc m'))
          =< R-comp t t' t'' (STr[Hm t t'].inc m) (STr[Hm t' t''].inc m') >
        compC (Fk t) (fk t) (Fk t') (fk t') (Fk t'') (fk t'') (R t t' (STr[Hm t t'].inc m)) (R t' t'' (STr[Hm t' t''].inc m'))
          =< apH (\ a -> compC (Fk t) (fk t) (Fk t') (fk t') (Fk t'') (fk t'') a (R t' t'' (STr[Hm t' t''].inc m'))) (R-inc t t' m) >
        compC (Fk t) (fk t) (Fk t') (fk t') (Fk t'') (fk t'') (hcl (Fk t) (fk t) (Fk t') (fk t') (Maps2[t.1, t.2.1, t.2.2, t'.1, t'.2.1, t'.2.2].realise-map m)) (R t' t'' (STr[Hm t' t''].inc m'))
          =< apH (compC (Fk t) (fk t) (Fk t') (fk t') (Fk t'') (fk t'') (hcl (Fk t) (fk t) (Fk t') (fk t') (Maps2[t.1, t.2.1, t.2.2, t'.1, t'.2.1, t'.2.2].realise-map m))) (R-inc t' t'' m') >
        compC (Fk t) (fk t) (Fk t') (fk t') (Fk t'') (fk t'') (hcl (Fk t) (fk t) (Fk t') (fk t') (Maps2[t.1, t.2.1, t.2.2, t'.1, t'.2.1, t'.2.2].realise-map m))
          (hcl (Fk t') (fk t') (Fk t'') (fk t'') (Maps2[t'.1, t'.2.1, t'.2.2, t''.1, t''.2.1, t''.2.2].realise-map m'))
          =< comp-beta (Fk t) (fk t) (Fk t') (fk t') (Fk t'') (fk t'') (Maps2[t.1, t.2.1, t.2.2, t'.1, t'.2.1, t'.2.2].realise-map m) (Maps2[t'.1, t'.2.1, t'.2.2, t''.1, t''.2.1, t''.2.2].realise-map m') >
        hcl (Fk t) (fk t) (Fk t'') (fk t'') (ptcomp (Fk t) (fk t) (Fk t') (fk t') (Fk t'') (fk t'') (Maps2[t.1, t.2.1, t.2.2, t'.1, t'.2.1, t'.2.2].realise-map m) (Maps2[t'.1, t'.2.1, t'.2.2, t''.1, t''.2.1, t''.2.2].realise-map m'))
          =< symH (Maps3[t.1, t.2.1, t.2.2, t'.1, t'.2.1, t'.2.2, t''.1, t''.2.1, t''.2.2].rmap-comp m m') >
        hcl (Fk t) (fk t) (Fk t'') (fk t'') (Maps2[t.1, t.2.1, t.2.2, t''.1, t''.2.1, t''.2.2].realise-map (Maps3[t.1, t.2.1, t.2.2, t'.1, t'.2.1, t'.2.2, t''.1, t''.2.1, t''.2.2].mcomp m m'))
          =< symH (R-inc t t'' (Maps3[t.1, t.2.1, t.2.2, t'.1, t'.2.1, t'.2.2, t''.1, t''.2.1, t''.2.2].mcomp m m')) >
        R t t'' (STr[Hm t t''].inc (Maps3[t.1, t.2.1, t.2.2, t'.1, t'.2.1, t'.2.2, t''.1, t''.2.1, t''.2.2].mcomp m m')) }) ;
  idT-rep (t : PC.Triples) : Id (homT t t) (idT t) (STr[Hm t t].inc Maps1[t.1, t.2.1, t.2.2].mid) =
    E.injective (homT t t) (HCr t t) (R t t) (R-equiv t t) (idT t) (STr[Hm t t].inc Maps1[t.1, t.2.1, t.2.2].mid)
      (transH (R-id t) (transH (symH Maps1[t.1, t.2.1, t.2.2].rmap-id) (symH (R-inc t t Maps1[t.1, t.2.1, t.2.2].mid)))) ;
  -- the category laws
  compT-assoc (t t' t'' t''' : PC.Triples) (c : homT t t') (c' : homT t' t'') (c'' : homT t'' t''') :
    Id (homT t t''') (compT t t'' t''' (compT t t' t'' c c') c'') (compT t t' t''' c (compT t' t'' t''' c' c'')) =
    E.injective (homT t t''') (HCr t t''') (R t t''') (R-equiv t t''') (compT t t'' t''' (compT t t' t'' c c') c'') (compT t t' t''' c (compT t' t'' t''' c' c''))
      (calc (HCr t t''') {
        R t t''' (compT t t'' t''' (compT t t' t'' c c') c'')
          =< R-comp t t'' t''' (compT t t' t'' c c') c'' >
        compC (Fk t) (fk t) (Fk t'') (fk t'') (Fk t''') (fk t''') (R t t'' (compT t t' t'' c c')) (R t'' t''' c'')
          =< apH (\ a -> compC (Fk t) (fk t) (Fk t'') (fk t'') (Fk t''') (fk t''') a (R t'' t''' c'')) (R-comp t t' t'' c c') >
        compC (Fk t) (fk t) (Fk t'') (fk t'') (Fk t''') (fk t''') (compC (Fk t) (fk t) (Fk t') (fk t') (Fk t'') (fk t'') (R t t' c) (R t' t'' c')) (R t'' t''' c'')
          =< comp-assoc (Fk t) (fk t) (Fk t') (fk t') (Fk t'') (fk t'') (Fk t''') (fk t''') (R t t' c) (R t' t'' c') (R t'' t''' c'') >
        compC (Fk t) (fk t) (Fk t') (fk t') (Fk t''') (fk t''') (R t t' c) (compC (Fk t') (fk t') (Fk t'') (fk t'') (Fk t''') (fk t''') (R t' t'' c') (R t'' t''' c''))
          =< apH (compC (Fk t) (fk t) (Fk t') (fk t') (Fk t''') (fk t''') (R t t' c)) (symH (R-comp t' t'' t''' c' c'')) >
        compC (Fk t) (fk t) (Fk t') (fk t') (Fk t''') (fk t''') (R t t' c) (R t' t''' (compT t' t'' t''' c' c''))
          =< symH (R-comp t t' t''' c (compT t' t'' t''' c' c'')) >
        R t t''' (compT t t' t''' c (compT t' t'' t''' c' c'')) }) ;
  compT-idl (t t' : PC.Triples) (c : homT t t') : Id (homT t t') (compT t t t' (idT t) c) c =
    E.injective (homT t t') (HCr t t') (R t t') (R-equiv t t') (compT t t t' (idT t) c) c
      (transH (R-comp t t t' (idT t) c)
         (transH (apH (\ a -> compC (Fk t) (fk t) (Fk t) (fk t) (Fk t') (fk t') a (R t t' c)) (R-id t))
            (comp-idl (Fk t) (fk t) (Fk t') (fk t') (R t t' c)))) ;
  compT-idr (t t' : PC.Triples) (c : homT t t') : Id (homT t t') (compT t t' t' c (idT t')) c =
    E.injective (homT t t') (HCr t t') (R t t') (R-equiv t t') (compT t t' t' c (idT t')) c
      (transH (R-comp t t' t' c (idT t'))
         (transH (apH (compC (Fk t) (fk t) (Fk t') (fk t') (Fk t') (fk t') (R t t' c)) (R-id t'))
            (comp-idr (Fk t) (fk t) (Fk t') (fk t') (R t t' c)))) ;
} ;
