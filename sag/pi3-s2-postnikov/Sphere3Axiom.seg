-- The sphere S^3 (doc/br-universal.pdf, Axiom S3 and Lemma ev3): the S^3 axiom,
-- as a segment parameter telescope (S3, base, surf, ump3) of the module Sphere3,
-- exactly as SphereAxiom.Sphere for S^2; not a Theory parameter.
--
-- Axiom.  For every X of the universe of S3, the canonical map
--     ev3 : (S3 -> X) -> (x : X) * Omega^3 (X, x),   ev3 f = (f base, ap^3 f surf)
-- is an equivalence (recursion with its uniqueness, stated as one map).
--
-- Informal proof of Lemma ev3, as SphereAxiom with one more looping:
--   loop-refl    for a map pointed by refl, loop (f, refl) = (ap f, refl) as pointed
--                maps (loop-ap; the pointing parts agree by computation); so
--                loop^3 (f, refl) is ap^3 f, by loop-refl three times
--   evPt         Map_*(S3, X) -> Omega^3 X, F |-> (loop^3 F) surf
--   evPt-subst   evPt (f, p) = p_* (ap^3 f surf)   (J on p, then Refl.eq)
--   pointed-up   evPt is an equivalence: up to evPt-subst it is the Sigma of ump3
--                over the base (the pointing is the fibre of evaluation at base)
--                followed by the contraction of the singleton (x, p : x = x0)
--                (ContractP: SphereAxiom.Contract for any family)
--   evPt-nat     evPt (F ; G) = (loop^3 G) (evPt F)   (loop3-comp: loop-comp three times)
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Lemma4[l] ; open DeloopMaps[l] ; open LoopCalc[l] ;
open SphereAxiom[l] ;

-- Omega^3 (X, x)
O3 (X : U l) (x : X) : U l = Id (O2 X x) (refl (refl x)) (refl (refl x)) ;

-- ap three times, on 3-loops
ap3 (A : U l) (a0 : A) (B : U l) (f : A -> B) (s : O3 A a0) : O3 B (f a0) =
  ap (O2 A a0) (O2 B (f a0)) (ap (Id A a0 a0) (Id B (f a0) (f a0)) (ap A B f a0 a0) (refl a0) (refl a0))
    (refl (refl a0)) (refl (refl a0)) s ;

ev3 (S3 : U l) (base : S3) (surf : O3 S3 base) (X : U l) (f : S3 -> X) : (x : X) * O3 X x =
  (f base, ap3 S3 base X f surf) ;

-- the triple looping of a pointed map, a pointed map of 3-loop spaces
loop3 (A : U l) (a0 : A) (B : U l) (b0 : B) (F : PtMap A a0 B b0) :
  PtMap (O3 A a0) (refl (refl (refl a0))) (O3 B b0) (refl (refl (refl b0))) =
  loop2 (Id A a0 a0) (refl a0) (Id B b0 b0) (refl b0) (Maps[A, a0, B, b0].loop F) ;

-- loop (f, refl) = (ap f, refl)
loop-refl (A : U l) (a0 : A) (B : U l) (f : A -> B) :
  Id (Maps[A, a0, B, f a0].PMO) (Maps[A, a0, B, f a0].loop (f, refl (f a0))) (ap A B f a0 a0, refl (refl (f a0))) =
  ptmap-path (Id A a0 a0) (refl a0) (Id B (f a0) (f a0)) (refl (f a0))
    (Maps[A, a0, B, f a0].loop (f, refl (f a0))).1 (ap A B f a0 a0)
    (Maps[A, a0, B, f a0].loop (f, refl (f a0))).2 (refl (refl (f a0)))
    (\ q -> transH (Maps[A, a0, B, f a0].loop-ap (f, refl (f a0)) q) (trans-refl-l B (f a0) (f a0) (ap A B f a0 a0 q)))
    (refl (refl (refl (f a0)))) ;

-- loop^2 and loop^3 of a composite (loop-comp at each level)
loop2-comp (A : U l) (a0 : A) (B : U l) (b0 : B) (C : U l) (c0 : C) (F : PtMap A a0 B b0) (G : PtMap B b0 C c0) :
  Id (PtMap (O2 A a0) (refl (refl a0)) (O2 C c0) (refl (refl c0))) (loop2 A a0 C c0 (ptcomp A a0 B b0 C c0 F G))
    (ptcomp (O2 A a0) (refl (refl a0)) (O2 B b0) (refl (refl b0)) (O2 C c0) (refl (refl c0)) (loop2 A a0 B b0 F) (loop2 B b0 C c0 G)) =
  transH (apH (Maps[Id A a0 a0, refl a0, Id C c0 c0, refl c0].loop) (loop-comp A a0 B b0 C c0 F G))
    (loop-comp (Id A a0 a0) (refl a0) (Id B b0 b0) (refl b0) (Id C c0 c0) (refl c0) (Maps[A, a0, B, b0].loop F) (Maps[B, b0, C, c0].loop G)) ;
loop3-comp (A : U l) (a0 : A) (B : U l) (b0 : B) (C : U l) (c0 : C) (F : PtMap A a0 B b0) (G : PtMap B b0 C c0) :
  Id (PtMap (O3 A a0) (refl (refl (refl a0))) (O3 C c0) (refl (refl (refl c0)))) (loop3 A a0 C c0 (ptcomp A a0 B b0 C c0 F G))
    (ptcomp (O3 A a0) (refl (refl (refl a0))) (O3 B b0) (refl (refl (refl b0))) (O3 C c0) (refl (refl (refl c0))) (loop3 A a0 B b0 F) (loop3 B b0 C c0 G)) =
  transH (apH (loop2 (Id A a0 a0) (refl a0) (Id C c0 c0) (refl c0)) (loop-comp A a0 B b0 C c0 F G))
    (loop2-comp (Id A a0 a0) (refl a0) (Id B b0 b0) (refl b0) (Id C c0 c0) (refl c0) (Maps[A, a0, B, b0].loop F) (Maps[B, b0, C, c0].loop G)) ;

-- transport along a path, an equivalence on the total space of any family
-- (SphereAxiom.Contract is the instance P = O2 X)
module ContractP (X : U l) (P : X -> U l) (x0 : X) {
  Tot : U l = (w : (x : X) * P x) * Id X w.1 x0 ;
  g (t : Tot) : P x0 = subst X P t.1.1 x0 t.2 t.1.2 ;
  h (a : P x0) : Tot = ((x0, a), refl x0) ;
  gh (a : P x0) : Id (P x0) (g (h a)) a = refl a ;
  hg-gen (x : X) (a : P x) : (y : X) (p : Id X x y) ->
    Id ((w : (z : X) * P z) * Id X w.1 y) ((y, subst X P x y p a), refl y) ((x, a), p) =
    \ y p -> idJ X x (\ y1 p1 -> Id ((w : (z : X) * P z) * Id X w.1 y1) ((y1, subst X P x y1 p1 a), refl y1) ((x, a), p1))
      (refl ((x, a), refl x)) y p ;
  hg (t : Tot) : Id Tot (h (g t)) t = hg-gen t.1.1 t.1.2 x0 t.2 ;
  equiv : isEquiv Tot (P x0) g = qinv Tot (P x0) g h gh hg ;
} ;

module Sphere3 (S3 : U l) (base : S3) (surf : O3 S3 base)
  (ump3 : (X : U l) -> isEquiv (S3 -> X) ((x : X) * O3 X x) (ev3 S3 base surf X)) {

  evPt (X : U l) (x0 : X) (F : PtMap S3 base X x0) : O3 X x0 = (loop3 S3 base X x0 F).1 surf ;

  -- for a map pointed by refl, evPt is ap^3 (loop-refl at the three levels)
  module Refl (X : U l) (f : S3 -> X) {
    f1 (q : Id S3 base base) : Id X (f base) (f base) = ap S3 X f base base q ;
    f2 (r : O2 S3 base) : O2 X (f base) = ap (Id S3 base base) (Id X (f base) (f base)) f1 (refl base) (refl base) r ;
    eq : Id (O3 X (f base)) (evPt X (f base) (f, refl (f base))) (ap3 S3 base X f surf) =
      calc (O3 X (f base)) {
        evPt X (f base) (f, refl (f base))
          =< refl (evPt X (f base) (f, refl (f base))) >
        (loop2 (Id S3 base base) (refl base) (Id X (f base) (f base)) (refl (f base)) (Maps[S3, base, X, f base].loop (f, refl (f base)))).1 surf
          =< apH (\ N -> (loop2 (Id S3 base base) (refl base) (Id X (f base) (f base)) (refl (f base)) N).1 surf) (loop-refl S3 base X f) >
        (loop2 (Id S3 base base) (refl base) (Id X (f base) (f base)) (refl (f base)) (f1, refl (refl (f base)))).1 surf
          =< refl ((Maps[O2 S3 base, refl (refl base), O2 X (f base), refl (refl (f base))].loop
                      (Maps[Id S3 base base, refl base, Id X (f base) (f base), f1 (refl base)].loop (f1, refl (f1 (refl base))))).1 surf) >
        (Maps[O2 S3 base, refl (refl base), O2 X (f base), refl (refl (f base))].loop
           (Maps[Id S3 base base, refl base, Id X (f base) (f base), f1 (refl base)].loop (f1, refl (f1 (refl base))))).1 surf
          =< apH (\ N -> (Maps[O2 S3 base, refl (refl base), O2 X (f base), refl (refl (f base))].loop N).1 surf)
               (loop-refl (Id S3 base base) (refl base) (Id X (f base) (f base)) f1) >
        (Maps[O2 S3 base, refl (refl base), O2 X (f base), refl (refl (f base))].loop (f2, refl (refl (refl (f base))))).1 surf
          =< apH (\ N -> N.1 surf) (loop-refl (O2 S3 base) (refl (refl base)) (O2 X (f base)) f2) >
        ap3 S3 base X f surf } ;
  } ;

  evPt-subst (X : U l) (f : S3 -> X) : (x0 : X) (p : Id X (f base) x0) ->
    Id (O3 X x0) (evPt X x0 (f, p)) (subst X (\ x -> O3 X x) (f base) x0 p (ev3 S3 base surf X f).2) =
    \ x0 p -> idJ X (f base) (\ x1 p1 -> Id (O3 X x1) (evPt X x1 (f, p1)) (subst X (\ x -> O3 X x) (f base) x1 p1 (ev3 S3 base surf X f).2))
      Refl[X, f].eq x0 p ;

  -- the universal property for pointed maps
  pointed-up (X : U l) (x0 : X) : isEquiv (PtMap S3 base X x0) (O3 X x0) (evPt X x0) =
    Equivalences[l].homotopy (PtMap S3 base X x0) (O3 X x0)
      (Equivalences[l].compose (PtMap S3 base X x0) ContractP[X, \ x -> O3 X x, x0].Tot (O3 X x0)
        (\ w -> (ev3 S3 base surf X w.1, w.2),
         sigma-base (S3 -> X) ((x : X) * O3 X x) (ev3 S3 base surf X, ump3 X) (\ w -> Id X w.1 x0))
        (ContractP[X, \ x -> O3 X x, x0].g, ContractP[X, \ x -> O3 X x, x0].equiv))
      (evPt X x0) (\ F -> evPt-subst X F.1 x0 F.2) ;

  pointed-equiv (X : U l) (x0 : X) : Equiv (PtMap S3 base X x0) (O3 X x0) = (evPt X x0, pointed-up X x0) ;

  -- naturality in X
  evPt-nat (X : U l) (x0 : X) (Y : U l) (y0 : Y) (F : PtMap S3 base X x0) (G : PtMap X x0 Y y0) :
    Id (O3 Y y0) (evPt Y y0 (ptcomp S3 base X x0 Y y0 F G)) ((loop3 X x0 Y y0 G).1 (evPt X x0 F)) =
    calc (O3 Y y0) {
      evPt Y y0 (ptcomp S3 base X x0 Y y0 F G)
        =< apH (\ M -> M.1 surf) (loop3-comp S3 base X x0 Y y0 F G) >
      (ptcomp (O3 S3 base) (refl (refl (refl base))) (O3 X x0) (refl (refl (refl x0))) (O3 Y y0) (refl (refl (refl y0))) (loop3 S3 base X x0 F) (loop3 X x0 Y y0 G)).1 surf
        =< refl ((loop3 X x0 Y y0 G).1 ((loop3 S3 base X x0 F).1 surf)) >
      (loop3 X x0 Y y0 G).1 ((loop3 S3 base X x0 F).1 surf)
        =< refl ((loop3 X x0 Y y0 G).1 (evPt X x0 F)) >
      (loop3 X x0 Y y0 G).1 (evPt X x0 F) } ;
} ;
