-- Theorem 38 of Hart-Milner at n = 2, 3 (doc/postnikov-classification.pdf,
-- Theorem 6): K(-,2) : Ab -> Stage[0] and K(-,3) : Ab -> Stage[1] are
-- equivalences, with inverses pi2, pi3.
--   O2ab        pi2 V = Omega^2 V as an abelian group (the text of
--               Presentation.O3 at V; EH at V)
--   Rec2        a pointed 1-connected 2-type V is K(pi2 V, 2): the steps G1,
--               G2 of Presentation.Rec with Omega F replaced by V
--               (Presentation.Rec.G2 is Rec2 at (Omega F, refl))
--   k2-pi2, k3-pi3   K_n (pi_n V) = V: ClassBase.StageId.I.path of Rec2.G2,
--               Presentation.Rec.e3
--   Band2, Band3     the additive bijections Omega^n K(B,n) ~ B: looping of
--               the pointed equivalences KK.e (LoopIso.loopPE), multiplicative
--               by PiOne.Induced.loop-mult, then the band (loop0-hom)
--   pi2-k2, pi3-k3   pi_n (K_n B) = B by ClassAb.ab-path
--   k2-equiv, k3-equiv  bi-invertible (only the paths are used)
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ; open HLevels[l] ; open Connected[l] ;
open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ; open LoopCalc[l] ;
open Torsor[l] ; open EMMaps[l] ; open AbHom[l] ; open SphereAxiom[l] ; open SphereUniversal[l] ; open PostnikovRealization[l] ; open LoopIso[l] ;
module EMf = EM[l] ; module CB = ClassBase[l] ; module CA = ClassAb[l] ; module PR = Presentation[l] ;
module G = Groupoid[l] ; module Eq = Equivalences[l] ; module P1 = Prelude[l+] ;

------------------------------------------------------------------------
-- pi2 and the recognition of K(B,2)

module O2ab (V : U l) (v0 : V) (tV : isTrunc four V) {
  X1 : U l = Id V v0 v0 ;
  x1 : X1 = refl v0 ;
  A2 : U l = O2 V v0 ;
  add (x y : A2) : A2 = trans X1 x1 x1 x1 x y ;
  set : isSet A2 = \ x y -> trunc-one-prop (Id A2 x y) (tV v0 v0 x1 x1 x y) ;
  ab : Ab = new Ab[A2, set, refl x1, add, sym X1 x1 x1,
    \ x y w -> G.tassoc X1 x1 x1 x1 x y x1 w,
    EH[l].EH[V, v0].eh,
    \ x -> refl x,
    G.trans-sym-r X1 x1 x1] ;
} ;

module Rec2 (V : U l) (v0 : V) (cV : isConn three V) (tV : isTrunc four V) {
  module O = O2ab[V, v0, tV] ;
  module KB = KK[O.ab] ;
  cX1 : isConn two O.X1 = conn-id two V cV v0 v0 ;
  tX1 : isTrunc three O.X1 = tV v0 v0 ;
  -- step 1: the band of K(B,1), Corollary 12
  f1 : Maps[KB.E1.K1, KB.E1.k0, O.X1, O.x1].PMO = (KB.E1.band KB.E1.k0, KB.E1.band-unit KB.E1.k0) ;
  cell1 : isContr Maps[KB.E1.K1, KB.E1.k0, O.X1, O.x1].Over[f1].Unloop =
    Maps[KB.E1.K1, KB.E1.k0, O.X1, O.x1].Over[f1].Mult[KB.E1.conn1, tX1, KB.E1.band-hom KB.E1.k0].cor12 ;
  G1 : PtEquiv KB.E1.K1 KB.E1.k0 O.X1 O.x1 =
    PR.deloop-equiv KB.E1.K1 KB.E1.k0 O.X1 O.x1 KB.E1.conn1 cX1 f1 (KB.E1.band-equiv KB.E1.k0).2 cell1 ;
  -- step 2: Corollary 11, c = 1
  f2 : Maps[KB.K two, KB.pt two, V, v0].PMO =
    ptcomp (Id (KB.K two) (KB.pt two) (KB.pt two)) (refl (KB.pt two)) KB.E1.K1 KB.E1.k0 O.X1 O.x1 (KB.e (suc zero)).1 G1.1 ;
  cell2 : isContr Maps[KB.K two, KB.pt two, V, v0].Over[f2].Unloop =
    Maps[KB.K two, KB.pt two, V, v0].Over[f2].cor11 (suc zero) (KB.conn (suc zero)) tV ;
  G2 : PtEquiv (KB.K two) (KB.pt two) V v0 =
    PR.deloop-equiv (KB.K two) (KB.pt two) V v0 (conn-zero (suc zero) (KB.K two) (KB.conn (suc zero)))
      (conn-zero (suc zero) V cV) f2
      (Eq.compose (Id (KB.K two) (KB.pt two) (KB.pt two)) KB.E1.K1 O.X1
         ((KB.e (suc zero)).1.1, (KB.e (suc zero)).2) (G1.1.1, G1.2)).2 cell2 ;
} ;

------------------------------------------------------------------------
-- the maps

K2 (A : Ab) : EMf.Stage[zero] = EMf.EMn[A].Kstage zero ;
K3 (B : Ab) : EMf.Stage[suc zero] = EMf.EMn[B].Kstage (suc zero) ;
pi2 (V : EMf.Stage[zero]) : Ab = O2ab[V.X, V.pt, V.trunc].ab ;
pi3 (W : EMf.Stage[suc zero]) : Ab = PR.O3[W.X, W.pt, W.trunc].ab ;

k2-pi2 (V : EMf.Stage[zero]) : Id EMf.Stage[zero] (K2 (pi2 V)) V =
  CB.StageId[zero].I[K2 (pi2 V)].path V Rec2[V.X, V.pt, V.conn, V.trunc].G2 ;
k3-pi3 (W : EMf.Stage[suc zero]) : Id EMf.Stage[suc zero] (K3 (pi3 W)) W =
  CB.StageId[suc zero].I[K3 (pi3 W)].path W PR.Rec[W.X, W.pt, W.conn, W.trunc].e3 ;

------------------------------------------------------------------------
-- Omega^n K(B,n) = B

module Band2 (B : Ab) {
  module KB = KK[B] ;
  K2X : U l = KB.K two ;
  p2 : K2X = KB.pt two ;
  K1X : U l = KB.K (suc zero) ;
  p1 : K1X = KB.pt (suc zero) ;
  -- Omega e_1 : Omega^2 K(B,2) ~pt Omega K(B,1)
  E1 : PtEquiv (O2 K2X p2) (refl (refl p2)) (Id K1X p1 p1) (refl p1) =
    loopPE (Id K2X p2 p2) (refl p2) K1X p1 (KB.e (suc zero)) ;
  E0 : PtEquiv (Id K1X p1 p1) (refl p1) B.A B.o = KB.e zero ;
  fun (x : O2 K2X p2) : B.A = Acc[Id K1X p1 p1, refl p1, B.A, B.o, E0].fun (Acc[O2 K2X p2, refl (refl p2), Id K1X p1 p1, refl p1, E1].fun x) ;
  module I1 = PiOne[l].Induced[Id K2X p2 p2, refl p2, K1X, p1, (KB.e (suc zero)).1] ;
  -- the band is a homomorphism (EM.EMSpace.loop0-hom), written at K1X
  loop0-hom (p q : Id K1X p1 p1) : Id B.A (KB.ES.loop0.1 (trans K1X p1 p1 p1 p q)) (B.add (KB.ES.loop0.1 p) (KB.ES.loop0.1 q)) =
    KB.ES.loop0-hom p q ;
  -- by definition
  fun-def (x : O2 K2X p2) : Id B.A (fun x) (KB.ES.loop0.1 (I1.L x)) = refl (fun x) ;
  add-hom (x y : O2 K2X p2) : Id B.A (fun (trans (Id K2X p2 p2) (refl p2) (refl p2) (refl p2) x y)) (B.add (fun x) (fun y)) = calc B.A {
    fun (trans (Id K2X p2 p2) (refl p2) (refl p2) (refl p2) x y)
      =< fun-def (trans (Id K2X p2 p2) (refl p2) (refl p2) (refl p2) x y) >
    KB.ES.loop0.1 (I1.L (trans (Id K2X p2 p2) (refl p2) (refl p2) (refl p2) x y))
      =< apH (KB.ES.loop0.1) (I1.loop-mult x y) >
    KB.ES.loop0.1 (trans K1X p1 p1 p1 (I1.L x) (I1.L y))
      =< loop0-hom (I1.L x) (I1.L y) >
    B.add (KB.ES.loop0.1 (I1.L x)) (KB.ES.loop0.1 (I1.L y))
      =< symH (apH (\ a -> B.add a (KB.ES.loop0.1 (I1.L y))) (fun-def x)) >
    B.add (fun x) (KB.ES.loop0.1 (I1.L y))
      =< symH (apH (B.add (fun x)) (fun-def y)) >
    B.add (fun x) (fun y) } ;
  hom : Hom (pi2 (K2 B)) B = (fun, add-hom) ;
  equiv : isEquiv (O2 K2X p2) B.A fun =
    (Eq.compose (O2 K2X p2) (Id K1X p1 p1) B.A
       Acc[O2 K2X p2, refl (refl p2), Id K1X p1 p1, refl p1, E1].equiv Acc[Id K1X p1 p1, refl p1, B.A, B.o, E0].equiv).2 ;
} ;

module Band3 (B : Ab) {
  module KB = KK[B] ;
  K3X : U l = KB.K three ;
  p3 : K3X = KB.pt three ;
  module B2 = Band2[B] ;
  -- Omega e_2 and Omega^2 e_2 : Omega^3 K(B,3) ~pt Omega^2 K(B,2)
  E2 : PtEquiv (O2 K3X p3) (refl (refl p3)) (Id B2.K2X B2.p2 B2.p2) (refl B2.p2) =
    loopPE (Id K3X p3 p3) (refl p3) B2.K2X B2.p2 (KB.e two) ;
  E2' : PtEquiv (Id (O2 K3X p3) (refl (refl p3)) (refl (refl p3))) (refl (refl (refl p3))) (O2 B2.K2X B2.p2) (refl (refl B2.p2)) =
    loopPE (O2 K3X p3) (refl (refl p3)) (Id B2.K2X B2.p2 B2.p2) (refl B2.p2) E2 ;
  fun (x : Id (O2 K3X p3) (refl (refl p3)) (refl (refl p3))) : B.A =
    B2.fun (Acc[Id (O2 K3X p3) (refl (refl p3)) (refl (refl p3)), refl (refl (refl p3)), O2 B2.K2X B2.p2, refl (refl B2.p2), E2'].fun x) ;
  module I2 = PiOne[l].Induced[O2 K3X p3, refl (refl p3), Id B2.K2X B2.p2 B2.p2, refl B2.p2, E2.1] ;
  -- by definition
  fun-def (x : Id (O2 K3X p3) (refl (refl p3)) (refl (refl p3))) : Id B.A (fun x) (B2.fun (I2.L x)) = refl (fun x) ;
  add-hom (x y : Id (O2 K3X p3) (refl (refl p3)) (refl (refl p3))) :
    Id B.A (fun (trans (O2 K3X p3) (refl (refl p3)) (refl (refl p3)) (refl (refl p3)) x y)) (B.add (fun x) (fun y)) = calc B.A {
    fun (trans (O2 K3X p3) (refl (refl p3)) (refl (refl p3)) (refl (refl p3)) x y)
      =< fun-def (trans (O2 K3X p3) (refl (refl p3)) (refl (refl p3)) (refl (refl p3)) x y) >
    B2.fun (I2.L (trans (O2 K3X p3) (refl (refl p3)) (refl (refl p3)) (refl (refl p3)) x y))
      =< apH B2.fun (I2.loop-mult x y) >
    B2.fun (trans (Id B2.K2X B2.p2 B2.p2) (refl B2.p2) (refl B2.p2) (refl B2.p2) (I2.L x) (I2.L y))
      =< B2.add-hom (I2.L x) (I2.L y) >
    B.add (B2.fun (I2.L x)) (B2.fun (I2.L y))
      =< symH (apH (\ a -> B.add a (B2.fun (I2.L y))) (fun-def x)) >
    B.add (fun x) (B2.fun (I2.L y))
      =< symH (apH (B.add (fun x)) (fun-def y)) >
    B.add (fun x) (fun y) } ;
  hom : Hom (pi3 (K3 B)) B = (fun, add-hom) ;
  equiv : isEquiv (Id (O2 K3X p3) (refl (refl p3)) (refl (refl p3))) B.A fun =
    (Eq.compose (Id (O2 K3X p3) (refl (refl p3)) (refl (refl p3))) (O2 B2.K2X B2.p2) B.A
       Acc[Id (O2 K3X p3) (refl (refl p3)) (refl (refl p3)), refl (refl (refl p3)), O2 B2.K2X B2.p2, refl (refl B2.p2), E2'].equiv
       (B2.fun, B2.equiv)).2 ;
} ;

pi2-k2 (A : Ab) : Id Ab (pi2 (K2 A)) A = CA.ab-path (pi2 (K2 A)) A Band2[A].hom Band2[A].equiv ;
pi3-k3 (B : Ab) : Id Ab (pi3 (K3 B)) B = CA.ab-path (pi3 (K3 B)) B Band3[B].hom Band3[B].equiv ;

------------------------------------------------------------------------
-- Theorem 6

k2-equiv : P1.isEquiv Ab EMf.Stage[zero] K2 = P1.qinv Ab EMf.Stage[zero] K2 pi2 k2-pi2 pi2-k2 ;
k3-equiv : P1.isEquiv Ab EMf.Stage[suc zero] K3 = P1.qinv Ab EMf.Stage[suc zero] K3 pi3 k3-pi3 pi3-k3 ;
