-- Lemma 40 of Hart-Milner for simply connected 3-types
-- (doc/postnikov-classification.pdf, section 6):
--     alpha : (V : Stage[0]) * Fam V  ~  SC3,
--     alpha (V, F, f, c) = (Sigma F, (v0, f), ..),
-- with inverse delta X = (||X||_2, fib eta, (x, refl), ..).
--   SC3          pointed 1-connected 3-types (Definition 1), ClassBase.PtProp
--   alpha-delta  Sigma_z fib eta z ~ X, w |-> w.2.1 (tot-equiv, the text of
--                Presentation.Pres.tot-fib), pointed by refl
--   DA[u]        delta (alpha u) = u: ehat : ||E||_2 -> V extends pr1
--                (Elim.ext, beta = ext-beta); its inverse g v is the constant
--                value of y |-> eta (v, y) on the 2-connected F v
--                (ConnectedMaps.null); t z (w, q) = transport_F (beta w ^-1 .
--                ap ehat q) w.2 (three equivalences); coh: transport along
--                beta e0 of t (e0, refl) is f (subst-cancel)
--   fam-path, sip   paths in Fam V from fibrewise equivalences (funext, ua,
--                ua-beta), and in (V : Stage[0]) * Fam V from a pointed
--                equivalence of the bases (ClassBase.StageId.J)
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ; open HLevels[l] ; open Connected[l] ;
open Lemma4[l] ; open PtEquivOps[l] ; open SphereUniversal[l] ; open PostnikovRealization[l] ;
module EMf = EM[l] ; module CB = ClassBase[l] ; module CF = ClassFib[l] ; module CM = ConnectedMaps[l] ;
module TS = Truncations[l] ; module W = Whitehead[l] ; module Fb = Fibres[l] ;
module P1 = Prelude[l+] ; module Eq = Equivalences[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ; module FL1 = Axioms[l+].FunExtLemmas[fe @(l+)] ;
module UL = Axioms[l].UnivalenceLemmas[univ @l] ;

St0 : U l+ = EMf.Stage[zero] ;

-- Definition 1
P3 (X : U l) : U l = isConn three X * isTrunc five X ;
p3-prop (X : U l) : isProp (P3 X) = isProp-Sigma (isConn three X) (\ c -> isTrunc five X) (conn-prop three X) (\ c -> trunc-prop five X) ;
module PS = CB.PtProp[P3, p3-prop] ;
SC3 : U l+ = PS.PP ;

SigFam : U l+ = (V : St0) * CF.Fam V ;

-- accessors
module Acs (u : SigFam) {
  X : U l = u.1.X ;
  v0 : X = u.1.pt ;
  F (v : X) : U l = u.2.1 v ;
  f : F v0 = u.2.2.1 ;
  c (v : X) : CF.C (F v) = u.2.2.2 v ;
  E : U l = (v : X) * F v ;
  e0 : E = (v0, f) ;
} ;

alpha (u : SigFam) : SC3 =
  (Acs[u].E, Acs[u].e0,
   (CB.total-conn three Acs[u].X Acs[u].F u.1.conn (\ v -> conn-down three (Acs[u].F v) (Acs[u].c v).1),
    trunc-Sigma five Acs[u].X Acs[u].F (trunc-suc four Acs[u].X u.1.trunc) (\ v -> (Acs[u].c v).2))) ;

module Dl (s : SC3) {
  X : U l = s.1 ;
  x : X = s.2.1 ;
  T : U l = (TS.TO three).T X ;
  eta (a : X) : T = (TS.TO three).unit X a ;
  connT : isConn three T = CM.conn-up three X T eta (\ z -> conn-down three (W.fib X T eta z) ((TS.TO three).conn X z)) s.2.2.1 ;
  V : St0 = new EMf.Stage[zero, T, eta x, connT, (TS.TO three).trunc X] ;
  F (z : T) : U l = W.fib X T eta z ;
  c (z : T) : CF.C (F z) =
    ((TS.TO three).conn X z,
     trunc-Sigma five X (\ a -> Id T (eta a) z) s.2.2.2
       (\ a -> trunc-suc four (Id T (eta a) z) (trunc-suc three (Id T (eta a) z) ((TS.TO three).trunc X (eta a) z)))) ;
  delta : SigFam = (V, F, (x, refl (eta x)), c) ;
  -- Sigma_z fib eta z ~ X
  tot-ret (t : X) (z : T) (p : Id T (eta t) z) : Id ((z1 : T) * F z1) (eta t, (t, refl (eta t))) (z, (t, p)) =
    idJ T (eta t) (\ z1 p1 -> Id ((z2 : T) * F z2) (eta t, (t, refl (eta t))) (z1, (t, p1))) (refl (eta t, (t, refl (eta t)))) z p ;
  tot-equiv : isEquiv ((z : T) * F z) X (\ w -> w.2.1) =
    qinv ((z : T) * F z) X (\ w -> w.2.1) (\ t -> (eta t, (t, refl (eta t)))) (\ t -> refl t) (\ w -> tot-ret w.2.1 w.1 w.2.2) ;
} ;

delta (s : SC3) : SigFam = Dl[s].delta ;

alpha-delta (s : SC3) : Id SC3 (alpha (delta s)) s =
  PS.I[alpha (delta s)].path s ((\ w -> w.2.1, refl s.2.1), Dl[s].tot-equiv) ;

------------------------------------------------------------------------
-- paths in (V : Stage[0]) * Fam V

PiC (S : St0) (F : S.X -> U l) : U l = (v : S.X) -> CF.C (F v) ;
piC-prop (S : St0) (F : S.X -> U l) : isProp (PiC S F) = FL.isProp-Pi S.X (\ v -> CF.C (F v)) (\ v -> CF.c-prop (F v)) ;

-- transport in Fam along a path of families
subst-fam (S : St0) (F1 F2 : S.X -> U l) (P : Id (S.X -> U l) F1 F2) (f1 : F1 S.pt) (c1 : PiC S F1) :
  Id (F2 S.pt * PiC S F2) (P1.subst (S.X -> U l) (\ F -> F S.pt * PiC S F) F1 F2 P (f1, c1))
    (coe (F1 S.pt) (F2 S.pt) (P1.happly S.X (\ v -> U l) F1 F2 P S.pt) f1, P1.subst (S.X -> U l) (\ F -> PiC S F) F1 F2 P c1) =
  idJ (S.X -> U l) F1 (\ F3 P3 -> Id (F3 S.pt * PiC S F3) (P1.subst (S.X -> U l) (\ F -> F S.pt * PiC S F) F1 F3 P3 (f1, c1))
      (coe (F1 S.pt) (F3 S.pt) (P1.happly S.X (\ v -> U l) F1 F3 P3 S.pt) f1, P1.subst (S.X -> U l) (\ F -> PiC S F) F1 F3 P3 c1))
    (refl (f1, c1)) F2 P ;

fam-ua (S : St0) (F1 F2 : S.X -> U l) (t : (v : S.X) -> Equiv (F1 v) (F2 v)) (v : S.X) : Id (U l) (F1 v) (F2 v) =
  UL.ua (F1 v) (F2 v) (t v) ;
fam-P (S : St0) (F1 F2 : S.X -> U l) (t : (v : S.X) -> Equiv (F1 v) (F2 v)) : Id (S.X -> U l) F1 F2 =
  FL1.funext S.X (\ v -> U l) F1 F2 (fam-ua S F1 F2 t) ;

fam-path (S : St0) (F1 F2 : S.X -> U l) (t : (v : S.X) -> Equiv (F1 v) (F2 v)) (f1 : F1 S.pt) (f2 : F2 S.pt)
  (coh : Id (F2 S.pt) ((t S.pt).1 f1) f2) (c1 : PiC S F1) (c2 : PiC S F2) : Id (CF.Fam S) (F1, f1, c1) (F2, f2, c2) =
  P1.Sigma-path (S.X -> U l) (\ F -> F S.pt * PiC S F) F1 F2 (f1, c1) (f2, c2) (fam-P S F1 F2 t)
    (P1.trans (F2 S.pt * PiC S F2) (P1.subst (S.X -> U l) (\ F -> F S.pt * PiC S F) F1 F2 (fam-P S F1 F2 t) (f1, c1))
       (coe (F1 S.pt) (F2 S.pt) (P1.happly S.X (\ v -> U l) F1 F2 (fam-P S F1 F2 t) S.pt) f1, P1.subst (S.X -> U l) (\ F -> PiC S F) F1 F2 (fam-P S F1 F2 t) c1)
       (f2, c2)
       (subst-fam S F1 F2 (fam-P S F1 F2 t) f1 c1)
       (CB.pair-path (F2 S.pt) (PiC S F2) (coe (F1 S.pt) (F2 S.pt) (P1.happly S.X (\ v -> U l) F1 F2 (fam-P S F1 F2 t) S.pt) f1) f2
          (P1.subst (S.X -> U l) (\ F -> PiC S F) F1 F2 (fam-P S F1 F2 t) c1) c2
          (calc (F2 S.pt) {
             coe (F1 S.pt) (F2 S.pt) (P1.happly S.X (\ v -> U l) F1 F2 (fam-P S F1 F2 t) S.pt) f1
               =< P1.ap (Id (U l) (F1 S.pt) (F2 S.pt)) (F2 S.pt) (\ p -> coe (F1 S.pt) (F2 S.pt) p f1)
                    (P1.happly S.X (\ v -> U l) F1 F2 (fam-P S F1 F2 t) S.pt) (fam-ua S F1 F2 t S.pt)
                    (P1.happly S.X (\ v -> Id (U l) (F1 v) (F2 v))
                       (P1.happly S.X (\ v -> U l) F1 F2 (fam-P S F1 F2 t)) (fam-ua S F1 F2 t)
                       (FL1.happly-funext S.X (\ v -> U l) F1 F2 (fam-ua S F1 F2 t)) S.pt) >
             coe (F1 S.pt) (F2 S.pt) (fam-ua S F1 F2 t S.pt) f1
               =< UL.ua-beta (F1 S.pt) (F2 S.pt) (t S.pt) f1 >
             (t S.pt).1 f1
               =< coh >
             f2 })
          (piC-prop S F2 (P1.subst (S.X -> U l) (\ F -> PiC S F) F1 F2 (fam-P S F1 F2 t) c1) c2))) ;

-- the data of a path, over a pointed equivalence e of the bases
Coh (S : St0) (F1 : S.X -> U l) (f1 : F1 S.pt) (T : St0) (e : PtEquiv S.X S.pt T.X T.pt) (F2 : T.X -> U l) (f2 : F2 T.pt)
  (t : (v : S.X) -> Equiv (F1 v) (F2 (e.1.1 v))) : U l =
  Id (F2 T.pt) (subst T.X F2 (e.1.1 S.pt) T.pt e.1.2 ((t S.pt).1 f1)) f2 ;

SipM (S : St0) (F1 : S.X -> U l) (f1 : F1 S.pt) (c1 : PiC S F1) (T : St0) (e : PtEquiv S.X S.pt T.X T.pt) : U l+ =
  (F2 : T.X -> U l) (f2 : F2 T.pt) (c2 : PiC T F2) (t : (v : S.X) -> Equiv (F1 v) (F2 (e.1.1 v))) ->
  Coh S F1 f1 T e F2 f2 t -> Id SigFam (S, F1, f1, c1) (T, F2, f2, c2) ;

sip (S : St0) (F1 : S.X -> U l) (f1 : F1 S.pt) (c1 : PiC S F1) (T : St0) (e : PtEquiv S.X S.pt T.X T.pt) : SipM S F1 f1 c1 T e =
  CB.StageId[zero].J S (\ T1 e1 -> SipM S F1 f1 c1 T1 e1)
    (\ F2 f2 c2 t coh -> P1.ap (CF.Fam S) SigFam (\ w -> (S, w)) (F1, f1, c1) (F2, f2, c2) (fam-path S F1 F2 t f1 f2 coh c1 c2))
    T e ;

------------------------------------------------------------------------
-- delta (alpha u) = u

module DA (u : SigFam) {
  module A = Acs[u] ;
  module D = Dl[alpha u] ;
  module EL = CM.Elim[four, A.E, D.T, D.eta, (TS.TO three).conn A.E, \ z -> A.X, \ z -> u.1.trunc] ;
  ehat (z : D.T) : A.X = EL.ext (\ w -> w.1) z ;
  beta (w : A.E) : Id A.X (ehat (D.eta w)) w.1 = EL.ext-beta (\ w1 -> w1.1) w ;
  -- the inverse
  nullv (v : A.X) : isEquiv D.T (A.F v -> D.T) (\ d y -> d) = CM.null four (A.F v) D.T (A.c v).1 ((TS.TO three).trunc A.E) ;
  g (v : A.X) : D.T = (nullv v).sec (\ y -> D.eta (v, y)) ;
  g-beta (v : A.X) (y : A.F v) : Id D.T (g v) (D.eta (v, y)) =
    happly (A.F v) (\ y1 -> D.T) (\ y1 -> g v) (\ y1 -> D.eta (v, y1)) ((nullv v).sec-eq (\ y1 -> D.eta (v, y1))) y ;
  eg (v : A.X) : Id A.X (ehat (g v)) v =
    (CM.null four (A.F v) (Id A.X (ehat (g v)) v) (A.c v).1 (trunc-suc three (Id A.X (ehat (g v)) v) (u.1.trunc (ehat (g v)) v))).sec
      (\ y -> transH (apH ehat (g-beta v y)) (beta (v, y))) ;
  module EL2 = CM.Elim[four, A.E, D.T, D.eta, (TS.TO three).conn A.E, \ z -> Id D.T (g (ehat z)) z,
    \ z -> trunc-suc three (Id D.T (g (ehat z)) z) ((TS.TO three).trunc A.E (g (ehat z)) z)] ;
  ge (z : D.T) : Id D.T (g (ehat z)) z = EL2.ext (\ w -> transH (apH g (beta w)) (g-beta w.1 w.2)) z ;
  ehat-equiv : isEquiv D.T A.X ehat = qinv D.T A.X ehat g eg ge ;
  e : PtEquiv D.T (D.eta A.e0) A.X A.v0 = ((ehat, beta A.e0), ehat-equiv) ;
  -- the fibres
  t (z : D.T) : Equiv (D.F z) (A.F (ehat z)) =
    Eq.compose (D.F z) ((w : A.E) * Id A.X (ehat (D.eta w)) (ehat z)) (A.F (ehat z))
      (Fb.sigma-equiv A.E (\ w -> Id D.T (D.eta w) z) (\ w -> Id A.X (ehat (D.eta w)) (ehat z))
         (\ w -> (ap D.T A.X ehat (D.eta w) z, CB.ap-equiv D.T A.X (ehat, ehat-equiv) (D.eta w) z)))
      (Eq.compose ((w : A.E) * Id A.X (ehat (D.eta w)) (ehat z)) ((w : A.E) * Id A.X w.1 (ehat z)) (A.F (ehat z))
         (Fb.sigma-equiv A.E (\ w -> Id A.X (ehat (D.eta w)) (ehat z)) (\ w -> Id A.X w.1 (ehat z))
            (\ w -> Fb.trans-equiv A.X w.1 (ehat (D.eta w)) (ehat z) (sym A.X (ehat (D.eta w)) w.1 (beta w))))
         (CB.fib-pr1 A.X A.F (ehat z))) ;
  -- by definition, t at the base point is transport along beta e0 ^-1
  t-pt : Id (A.F (ehat (D.eta A.e0))) ((t (D.eta A.e0)).1 (A.e0, refl (D.eta A.e0)))
           (subst A.X A.F A.v0 (ehat (D.eta A.e0)) (sym A.X (ehat (D.eta A.e0)) A.v0 (beta A.e0)) A.f) =
    refl ((t (D.eta A.e0)).1 (A.e0, refl (D.eta A.e0))) ;
  coh : Coh D.V D.F (A.e0, refl (D.eta A.e0)) u.1 e A.F A.f t =
    transH (apH (subst A.X A.F (ehat (D.eta A.e0)) A.v0 (beta A.e0)) t-pt)
      (CB.subst-cancel A.X A.F (ehat (D.eta A.e0)) A.v0 (beta A.e0) A.f) ;
  path : Id SigFam (delta (alpha u)) u = sip D.V D.F (A.e0, refl (D.eta A.e0)) D.c u.1 e A.F A.f u.2.2.2 t coh ;
} ;

delta-alpha (u : SigFam) : Id SigFam (delta (alpha u)) u = DA[u].path ;

-- Lemma 40
post-equiv : P1.Equiv SigFam SC3 = (alpha, P1.qinv SigFam SC3 alpha delta alpha-delta delta-alpha) ;
