-- Conjugation by two arbitrary pointed equivalences (doc/br-universal.pdf,
-- Conventions): for eA : OA ~pt A and eB : OB ~pt B,
--   conj F   = eA ; F ; eB^-1   : OA ->pt OB    for F : A ->pt B
--   unconj f = eA^-1 ; f ; eB   : A ->pt B      for f : OA ->pt OB
-- with conj (unconj f) = f and unconj (conj F) = F (associativity, pt-inv-l
-- / pt-inv-r, unit laws; the proofs of FibreH3.Climb.conj-unconj).  The
-- degrees and groups on the two sides are independent: the instances used
-- are e_2 of Z with e_4 of B (cj F = e_2 ; F ; e_4^-1 : Omega K(Z,3) ->
-- Omega K(B,5)), which the single-degree Lev.conj, Climb.unconj and
-- H2.unconj-conj do not cover.  Composition is KFun.conj-comp (already
-- stated for three arbitrary pointed equivalences).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ;
open Lemma4[l] ; open PtEquivOps[l] ; open LoopCalc[l] ; open Fibres[l] ;

module Conj (OA : U l) (oa : OA) (A : U l) (a : A) (OB : U l) (ob : OB) (B : U l) (b : B)
  (eA : PtEquiv OA oa A a) (eB : PtEquiv OB ob B b) {
  eAi : PtMap A a OA oa = (pt-inv OA oa A a eA).1 ;
  eBi : PtMap B b OB ob = (pt-inv OB ob B b eB).1 ;
  conj (F : PtMap A a B b) : PtMap OA oa OB ob =
    ptcomp OA oa B b OB ob (ptcomp OA oa A a B b eA.1 F) eBi ;
  unconj (f : PtMap OA oa OB ob) : PtMap A a B b =
    ptcomp A a OA oa B b eAi (ptcomp OA oa OB ob B b f eB.1) ;
  conj-unconj (f : PtMap OA oa OB ob) : Id (PtMap OA oa OB ob) (conj (unconj f)) f =
    calc (PtMap OA oa OB ob) {
      conj (unconj f)
        =< apH (\ X -> ptcomp OA oa B b OB ob X eBi)
             (transH (symH (ptcomp-assoc OA oa A a OA oa B b eA.1 eAi (ptcomp OA oa OB ob B b f eB.1)))
               (transH (apH (\ X -> ptcomp OA oa OA oa B b X (ptcomp OA oa OB ob B b f eB.1)) (pt-inv-l OA oa A a eA))
                 (ptcomp-idl OA oa B b (ptcomp OA oa OB ob B b f eB.1)))) >
      ptcomp OA oa B b OB ob (ptcomp OA oa OB ob B b f eB.1) eBi
        =< ptcomp-assoc OA oa OB ob B b OB ob f eB.1 eBi >
      ptcomp OA oa OB ob OB ob f (ptcomp OB ob B b OB ob eB.1 eBi)
        =< apH (ptcomp OA oa OB ob OB ob f) (pt-inv-l OB ob B b eB) >
      ptcomp OA oa OB ob OB ob f (ptid OB ob)
        =< ptcomp-idr OA oa OB ob f >
      f } ;
  unconj-conj (F : PtMap A a B b) : Id (PtMap A a B b) (unconj (conj F)) F =
    calc (PtMap A a B b) {
      unconj (conj F)
        =< apH (ptcomp A a OA oa B b eAi)
             (transH (ptcomp-assoc OA oa B b OB ob B b (ptcomp OA oa A a B b eA.1 F) eBi eB.1)
               (transH (apH (ptcomp OA oa B b B b (ptcomp OA oa A a B b eA.1 F)) (pt-inv-r OB ob B b eB))
                 (ptcomp-idr OA oa B b (ptcomp OA oa A a B b eA.1 F)))) >
      ptcomp A a OA oa B b eAi (ptcomp OA oa A a B b eA.1 F)
        =< symH (ptcomp-assoc A a OA oa A a B b eAi eA.1 F) >
      ptcomp A a A a B b (ptcomp A a OA oa A a eAi eA.1) F
        =< apH (\ X -> ptcomp A a A a B b X F) (pt-inv-r OA oa A a eA) >
      ptcomp A a A a B b (ptid A a) F
        =< ptcomp-idl A a B b F >
      F } ;
} ;
