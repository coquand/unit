-- Statement M for every pointed 2-connected 4-type, without a presentation
-- (doc/delooping-direct.pdf, Section 3).  R = Fib kbar, r = loop s ; [omega-BR]
-- in [Omega S3, R]_* (MarkLoop.LMark.r), q_X = - ; [fpr] : [X, Fib k]_* ->
-- [X, K(A,2)]_*.  Informal proof:
--   comp-zero-r  c ; [0] = [0] (classes; comp-beta, comp-const-r)
--   ExR[t, dl, F]  (E) at the source R for a deloopable triple t = (A, B, k):
--               F = p_R ; G_F merely (FibP[Z, Z/2, kbar].PStar, Lemma 7 at R); h
--               with Phi_B(h) = [G_F ; k] (H4Proof.h4); 2 h(1) = 0 (Statement T,
--               TwoTorsion.TwoTors.Two.two-tors: this is where deloopability is
--               used); h = rho ; g (Necessity.Factor); [kbar ; K(g,4)] = Phi_B(rho ;
--               g) = [G_F ; k] (Psi.psi-phi, cls); p_R ; kbar merely 0 (FibP.fseq);
--               so F ; k = p_R ; (kbar ; K(g,4)) = 0 ; K(g,4) = 0 merely (chain, null)
--   ex-R, un-R, qR  q_R bijective (MapFib.Lifting at R; (U) is MapBR.SourceBR.ur:
--               [R, K(B,3)]_* = 0)
--   Direct[S3,..]  under the S^3 axiom:
--     RStar Z   r^* : [R, Z]_* -> [Omega S3, Z]_* bijective; transfer: along a
--               pointed equivalence (ptEqInd, as SourceS3.Final.rep-pteq)
--     uA, rA    r^* bijective into K(A,2): M holds at K(A,3) : SC4
--               (SourceS3.Final.right), so r^* is bijective into Omega K(A,3)
--               (Proposition L, LMark.At.to-loop), then along e_2
--     ExS, UnS, qS  q_{Omega S3} bijective: (E) every class [F] is r ; c (rA), and
--               [F ; k] = r ; (c ; [k]) = r ; [0] = [0] (ck: ExR on representatives);
--               (U) d : Omega S3 ->pt Omega K(B,4) is loop D (Lemma 1 at (S3,
--               K(B,4)): LoopEquiv.cell), D is merely 0 (s3-paths: Omega^3 K(B,4)
--               is connected), so d is merely 0 (loop-const)
--     rF        Theorem: r^* bijective into Fib k for every deloopable triple:
--               q_{Omega S3} (r ; c) = r ; q_R (c) (comp-assoc), rA, qR, qS and
--               2-out-of-3 (Whitehead.cancel-equiv)
--     AtU[u]    for u : SC4: t = realise^-1 (Omega u), deloopable by u (dl); r^*
--               bijective into Omega Y (transfer along eps^-1, TwoTorsion.Loop.eps)
--               and Proposition L (LMark.At.from-loop): marked u = M(u).
--               Neither Presentation4 nor DeloopEmbedding.Mark.marked is used.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ; open HLevels[l] ; open Connected[l] ;
open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ; open Torsor[l] ; open LoopCalc[l] ;
open EMMaps[l] ; open AbHom[l] ; open HomotopyClasses[l] ; open SphereUniversal[l] ; open PostnikovRealization[l] ; open KZ2Cohomology[l] ;
open Z2[l] ; open Sphere3Axiom[l] ;
module P1 = Prelude[l+] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module E = Equivalences[l] ; module W = Whitehead[l] ;
module Fb = Fibres[l] ; module CS = CupSquare[l] ; module CT = CrossTerm[l] ; module HB = H4Bilinear[l] ;
module NC = Necessity[l] ; module MF = MapFib[l] ; module MB = MapBR[l] ; module S3S = SourceS3[l] ;
module DE = DeloopEmbedding[l] ; module CP = ClassPost[l] ; module PC = PostnikovClassification[l] ;
module DR = DeloopR[l] ; module TT = TwoTorsion[l] ; module ML = MarkLoop[l] ;

-- c ; [0] = [0]
comp-zero-r (X : U l) (x0 : X) (Y : U l) (y0 : Y) (Z : U l) (z0 : Z) (a : HC X x0 Y y0) :
  Id (HC X x0 Z z0) (compC X x0 Y y0 Z z0 a (hcl Y y0 Z z0 (ptconst Y y0 Z z0))) (hcl X x0 Z z0 (ptconst X x0 Z z0)) =
  STr[PtMap X x0 Y y0].ind @l (\ a1 -> Id (HC X x0 Z z0) (compC X x0 Y y0 Z z0 a1 (hcl Y y0 Z z0 (ptconst Y y0 Z z0))) (hcl X x0 Z z0 (ptconst X x0 Z z0)))
    (\ a1 -> hc-set X x0 Z z0 (compC X x0 Y y0 Z z0 a1 (hcl Y y0 Z z0 (ptconst Y y0 Z z0))) (hcl X x0 Z z0 (ptconst X x0 Z z0)))
    (\ F -> transH (comp-beta X x0 Y y0 Z z0 F (ptconst Y y0 Z z0)) (apH (hcl X x0 Z z0) (comp-const-r X x0 Y y0 Z z0 F)))
    a ;

------------------------------------------------------------------------
-- (E) at the source R, for a deloopable triple

module ExR (Ga Gb : Ab) (k : PtMap (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four))
  (dl : DE.Deloopable (Ga, Gb, k)) (F : PtMap DR.TR.F DR.TR.f0 (KK[Ga].K two) (KK[Ga].pt two)) {
  module KA = KK[Ga] ;
  module KB = KK[Gb] ;
  module C = KK[Z2ab] ;
  module L3 = HB.Lev[Z2ab, Gb] ;
  module PS = MF.FibP[Zab, Z2ab, CT.kbar].PStar[Ga] ;
  -- G_F, with F = p_R ; G_F merely
  G : PtMap KZ2 kz2 (KA.K two) (KA.pt two) = PS.ext-pt F ;
  -- h = Phi^-1 [G ; k] (h4); 2 h(1) = 0 (Statement T); h = rho ; g
  h : Hom Zab Gb = (H4Proof[l].h4 Gb).sec (hcl KZ2 kz2 (KB.K four) (KB.pt four) (ptcomp KZ2 kz2 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) G k)) ;
  eh : Id (HC KZ2 kz2 (KB.K four) (KB.pt four)) (Phi CS.kappa Gb h) (hcl KZ2 kz2 (KB.K four) (KB.pt four) (ptcomp KZ2 kz2 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) G k)) =
    (H4Proof[l].h4 Gb).sec-eq (hcl KZ2 kz2 (KB.K four) (KB.pt four) (ptcomp KZ2 kz2 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) G k)) ;
  module FC = NC.Factor[Gb, h, TT.TwoTors[Ga, Gb, k, dl, G].Two[h, eh].two-tors] ;
  -- [kbar ; K(g,4)] = [G ; k] (Proposition Psi)
  cls : Id (HC KZ2 kz2 (KB.K four) (KB.pt four)) (hcl KZ2 kz2 (KB.K four) (KB.pt four) (ptcomp KZ2 kz2 (C.K four) (C.pt four) (KB.K four) (KB.pt four) CT.kbar (L3.K FC.g four))) (hcl KZ2 kz2 (KB.K four) (KB.pt four) (ptcomp KZ2 kz2 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) G k)) =
    calc (HC KZ2 kz2 (KB.K four) (KB.pt four)) {
      hcl KZ2 kz2 (KB.K four) (KB.pt four) (ptcomp KZ2 kz2 (C.K four) (C.pt four) (KB.K four) (KB.pt four) CT.kbar (L3.K FC.g four))
        =< apH (\ M -> hcl KZ2 kz2 (KB.K four) (KB.pt four) (ptcomp KZ2 kz2 (C.K four) (C.pt four) (KB.K four) (KB.pt four) CT.kbar M)) (symH (L3.K-def FC.g four)) >
      NC.Psi[Gb].psi FC.g
        =< NC.Psi[Gb].psi-phi FC.g >
      Phi CS.kappa Gb (KFun[l].hcomp Zab Z2ab Gb rho FC.g)
        =< apH (Phi CS.kappa Gb) FC.factor >
      Phi CS.kappa Gb h
        =< eh >
      hcl KZ2 kz2 (KB.K four) (KB.pt four) (ptcomp KZ2 kz2 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) G k) } ;
  gk-mere : Tr.Trunc[Id (PtMap KZ2 kz2 (KB.K four) (KB.pt four)) (ptcomp KZ2 kz2 (C.K four) (C.pt four) (KB.K four) (KB.pt four) CT.kbar (L3.K FC.g four)) (ptcomp KZ2 kz2 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) G k)].carrier =
    STr[PtMap KZ2 kz2 (KB.K four) (KB.pt four)].effective (ptcomp KZ2 kz2 (C.K four) (C.pt four) (KB.K four) (KB.pt four) CT.kbar (L3.K FC.g four)) (ptcomp KZ2 kz2 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) G k) cls ;
  -- F ; k = p_R ; (kbar ; K(g,4)) = 0
  chain (e1 : Id (PtMap DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two)) (ptcomp DR.TR.F DR.TR.f0 KZ2 kz2 (KA.K two) (KA.pt two) (Fb.fpr KZ2 kz2 (C.K four) (C.pt four) CT.kbar) G) F)
    (e2 : Id (PtMap KZ2 kz2 (KB.K four) (KB.pt four)) (ptcomp KZ2 kz2 (C.K four) (C.pt four) (KB.K four) (KB.pt four) CT.kbar (L3.K FC.g four)) (ptcomp KZ2 kz2 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) G k))
    (e3 : Id (PtMap DR.TR.F DR.TR.f0 (C.K four) (C.pt four)) (ptcomp DR.TR.F DR.TR.f0 KZ2 kz2 (C.K four) (C.pt four) (Fb.fpr KZ2 kz2 (C.K four) (C.pt four) CT.kbar) CT.kbar) (ptconst DR.TR.F DR.TR.f0 (C.K four) (C.pt four))) :
    Id (PtMap DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four)) (ptcomp DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) F k) (ptconst DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four)) =
    calc (PtMap DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four)) {
      ptcomp DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) F k
        =< apH (\ M -> ptcomp DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) M k) (symH e1) >
      ptcomp DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) (ptcomp DR.TR.F DR.TR.f0 KZ2 kz2 (KA.K two) (KA.pt two) (Fb.fpr KZ2 kz2 (C.K four) (C.pt four) CT.kbar) G) k
        =< ptcomp-assoc DR.TR.F DR.TR.f0 KZ2 kz2 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) (Fb.fpr KZ2 kz2 (C.K four) (C.pt four) CT.kbar) G k >
      ptcomp DR.TR.F DR.TR.f0 KZ2 kz2 (KB.K four) (KB.pt four) (Fb.fpr KZ2 kz2 (C.K four) (C.pt four) CT.kbar) (ptcomp KZ2 kz2 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) G k)
        =< apH (ptcomp DR.TR.F DR.TR.f0 KZ2 kz2 (KB.K four) (KB.pt four) (Fb.fpr KZ2 kz2 (C.K four) (C.pt four) CT.kbar)) (symH e2) >
      ptcomp DR.TR.F DR.TR.f0 KZ2 kz2 (KB.K four) (KB.pt four) (Fb.fpr KZ2 kz2 (C.K four) (C.pt four) CT.kbar) (ptcomp KZ2 kz2 (C.K four) (C.pt four) (KB.K four) (KB.pt four) CT.kbar (L3.K FC.g four))
        =< symH (ptcomp-assoc DR.TR.F DR.TR.f0 KZ2 kz2 (C.K four) (C.pt four) (KB.K four) (KB.pt four) (Fb.fpr KZ2 kz2 (C.K four) (C.pt four) CT.kbar) CT.kbar (L3.K FC.g four)) >
      ptcomp DR.TR.F DR.TR.f0 (C.K four) (C.pt four) (KB.K four) (KB.pt four) (ptcomp DR.TR.F DR.TR.f0 KZ2 kz2 (C.K four) (C.pt four) (Fb.fpr KZ2 kz2 (C.K four) (C.pt four) CT.kbar) CT.kbar) (L3.K FC.g four)
        =< apH (\ M -> ptcomp DR.TR.F DR.TR.f0 (C.K four) (C.pt four) (KB.K four) (KB.pt four) M (L3.K FC.g four)) e3 >
      ptcomp DR.TR.F DR.TR.f0 (C.K four) (C.pt four) (KB.K four) (KB.pt four) (ptconst DR.TR.F DR.TR.f0 (C.K four) (C.pt four)) (L3.K FC.g four)
        =< comp-const-l DR.TR.F DR.TR.f0 (C.K four) (C.pt four) (KB.K four) (KB.pt four) (L3.K FC.g four) >
      ptconst DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four) } ;
  null : Tr.Trunc[Id (PtMap DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four)) (ptcomp DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) F k) (ptconst DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four))].carrier =
    TC.bind (Id (PtMap DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two)) (ptcomp DR.TR.F DR.TR.f0 KZ2 kz2 (KA.K two) (KA.pt two) (Fb.fpr KZ2 kz2 (C.K four) (C.pt four) CT.kbar) G) F)
      (Id (PtMap DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four)) (ptcomp DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) F k) (ptconst DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four)))
      (\ e1 -> TC.map2 (Id (PtMap KZ2 kz2 (KB.K four) (KB.pt four)) (ptcomp KZ2 kz2 (C.K four) (C.pt four) (KB.K four) (KB.pt four) CT.kbar (L3.K FC.g four)) (ptcomp KZ2 kz2 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) G k))
                 (Id (PtMap DR.TR.F DR.TR.f0 (C.K four) (C.pt four)) (ptcomp DR.TR.F DR.TR.f0 KZ2 kz2 (C.K four) (C.pt four) (Fb.fpr KZ2 kz2 (C.K four) (C.pt four) CT.kbar) CT.kbar) (ptconst DR.TR.F DR.TR.f0 (C.K four) (C.pt four)))
                 (Id (PtMap DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four)) (ptcomp DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) F k) (ptconst DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four)))
                 (chain e1) gk-mere MF.FibP[Zab, Z2ab, CT.kbar].fseq)
      (PS.ext-eq F) ;
} ;

ex-R (Ga Gb : Ab) (k : PtMap (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four)) (dl : DE.Deloopable (Ga, Gb, k)) :
  MF.Lifting[DR.TR.F, DR.TR.f0, Ga, Gb, k].Ex = \ F -> ExR[Ga, Gb, k, dl, F].null ;
un-R (Ga Gb : Ab) (k : PtMap (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four)) :
  MF.Lifting[DR.TR.F, DR.TR.f0, Ga, Gb, k].Un = \ d -> MB.SourceBR.ur Gb d ;
-- q_R is a bijection
qR (Ga Gb : Ab) (k : PtMap (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four)) (dl : DE.Deloopable (Ga, Gb, k)) :
  isEquiv (HC DR.TR.F DR.TR.f0 Triple[Ga, Gb, k].F Triple[Ga, Gb, k].f0) (HC DR.TR.F DR.TR.f0 (KK[Ga].K two) (KK[Ga].pt two)) MF.Lifting[DR.TR.F, DR.TR.f0, Ga, Gb, k].qs =
  MF.Lifting[DR.TR.F, DR.TR.f0, Ga, Gb, k].Main[ex-R Ga Gb k dl, un-R Ga Gb k].equiv ;

------------------------------------------------------------------------
-- under the S^3 axiom

module Direct (S3 : U l) (base : S3) (surf : O3 S3 base)
  (ump3 : (X : U l) -> isEquiv (S3 -> X) ((x : X) * O3 X x) (ev3 S3 base surf X)) {
  module LM = ML.LMark[S3, base, surf, ump3] ;
  module MK = DE.Mark[S3, base, surf, ump3] ;
  module SS = S3S.SourceS3[S3, base, surf, ump3] ;
  module FS = S3S.Final[S3, base, surf, ump3] ;
  -- r^* bijective into Z
  RStar (Z : U l) (z0 : Z) : U l = isEquiv (HC DR.TR.F DR.TR.f0 Z z0) (HC (Id S3 base base) (refl base) Z z0) (\ c -> compC (Id S3 base base) (refl base) DR.TR.F DR.TR.f0 Z z0 LM.r c) ;
  transfer (X : U l) (x0 : X) (Z : U l) (z0 : Z) (e : PtEquiv X x0 Z z0) (m : RStar X x0) : RStar Z z0 =
    ptEqInd X x0 (\ Z1 z1 e1 -> RStar Z1 z1) m Z z0 e ;

  -- r^* is bijective into K(A,2): M at K(A,3), Proposition L, e_2
  uA (Ga : Ab) : DE.SC4 = (KK[Ga].K three, KK[Ga].pt three, (KK[Ga].conn two, trunc-suc five (KK[Ga].K three) (KK[Ga].trunc two))) ;
  markedA (Ga : Ab) : MK.Marked (uA Ga) = FS.right Ga ;
  rA (Ga : Ab) : RStar (KK[Ga].K two) (KK[Ga].pt two) =
    transfer (Id (KK[Ga].K three) (KK[Ga].pt three) (KK[Ga].pt three)) (refl (KK[Ga].pt three)) (KK[Ga].K two) (KK[Ga].pt two) (HB.Lev[Ga, Ga].eA two)
      (LM.At[uA Ga].to-loop (markedA Ga)) ;

  -- (E) at the source Omega S3
  module ExS (Ga Gb : Ab) (k : PtMap (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four))
    (dl : DE.Deloopable (Ga, Gb, k)) (F : PtMap (Id S3 base base) (refl base) (KK[Ga].K two) (KK[Ga].pt two)) {
    module KA = KK[Ga] ;
    module KB = KK[Gb] ;
    -- [F] = r ; c
    c : HC DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) = (rA Ga).sec (hcl (Id S3 base base) (refl base) (KA.K two) (KA.pt two) F) ;
    c-eq : Id (HC (Id S3 base base) (refl base) (KA.K two) (KA.pt two)) (compC (Id S3 base base) (refl base) DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) LM.r c) (hcl (Id S3 base base) (refl base) (KA.K two) (KA.pt two) F) = (rA Ga).sec-eq (hcl (Id S3 base base) (refl base) (KA.K two) (KA.pt two) F) ;
    -- c ; [k] = [0] (ExR on representatives)
    ck (b : HC DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two)) :
      Id (HC DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four)) (compC DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) b (hcl (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) k)) (hcl DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four) (ptconst DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four))) =
      STr[PtMap DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two)].ind @l
        (\ b1 -> Id (HC DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four)) (compC DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) b1 (hcl (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) k)) (hcl DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four) (ptconst DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four))))
        (\ b1 -> hc-set DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four) (compC DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) b1 (hcl (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) k)) (hcl DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four) (ptconst DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four))))
        (\ F1 -> transH (comp-beta DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) F1 k)
                   (TC.rec (Id (PtMap DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four)) (ptcomp DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) F1 k) (ptconst DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four))) @l
                      (Id (HC DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four)) (hcl DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four) (ptcomp DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) F1 k)) (hcl DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four) (ptconst DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four))))
                      (hc-set DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four) (hcl DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four) (ptcomp DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) F1 k)) (hcl DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four) (ptconst DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four))))
                      (apH (hcl DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four))) (ex-R Ga Gb k dl F1)))
        b ;
    cls : Id (HC (Id S3 base base) (refl base) (KB.K four) (KB.pt four)) (hcl (Id S3 base base) (refl base) (KB.K four) (KB.pt four) (ptcomp (Id S3 base base) (refl base) (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) F k)) (hcl (Id S3 base base) (refl base) (KB.K four) (KB.pt four) (ptconst (Id S3 base base) (refl base) (KB.K four) (KB.pt four))) =
      calc (HC (Id S3 base base) (refl base) (KB.K four) (KB.pt four)) {
        hcl (Id S3 base base) (refl base) (KB.K four) (KB.pt four) (ptcomp (Id S3 base base) (refl base) (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) F k)
          =< symH (comp-beta (Id S3 base base) (refl base) (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) F k) >
        compC (Id S3 base base) (refl base) (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) (hcl (Id S3 base base) (refl base) (KA.K two) (KA.pt two) F) (hcl (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) k)
          =< apH (\ a -> compC (Id S3 base base) (refl base) (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) a (hcl (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) k)) (symH c-eq) >
        compC (Id S3 base base) (refl base) (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) (compC (Id S3 base base) (refl base) DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) LM.r c) (hcl (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) k)
          =< comp-assoc (Id S3 base base) (refl base) DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) LM.r c (hcl (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) k) >
        compC (Id S3 base base) (refl base) DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four) LM.r (compC DR.TR.F DR.TR.f0 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) c (hcl (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) k))
          =< apH (compC (Id S3 base base) (refl base) DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four) LM.r) (ck c) >
        compC (Id S3 base base) (refl base) DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four) LM.r (hcl DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four) (ptconst DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four)))
          =< comp-zero-r (Id S3 base base) (refl base) DR.TR.F DR.TR.f0 (KB.K four) (KB.pt four) LM.r >
        hcl (Id S3 base base) (refl base) (KB.K four) (KB.pt four) (ptconst (Id S3 base base) (refl base) (KB.K four) (KB.pt four)) } ;
    null : Tr.Trunc[Id (PtMap (Id S3 base base) (refl base) (KB.K four) (KB.pt four)) (ptcomp (Id S3 base base) (refl base) (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) F k) (ptconst (Id S3 base base) (refl base) (KB.K four) (KB.pt four))].carrier =
      STr[PtMap (Id S3 base base) (refl base) (KB.K four) (KB.pt four)].effective (ptcomp (Id S3 base base) (refl base) (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) F k) (ptconst (Id S3 base base) (refl base) (KB.K four) (KB.pt four)) cls ;
  } ;
  -- (U) at the source Omega S3
  module UnS (Gb : Ab) (d : PtMap (Id S3 base base) (refl base) (Id (KK[Gb].K four) (KK[Gb].pt four) (KK[Gb].pt four)) (refl (KK[Gb].pt four))) {
    module KB = KK[Gb] ;
    module LE = S3S.LoopEquiv[S3, base, (KB.K four), (KB.pt four), two, LM.s3-conn, KB.trunc three] ;
    -- d = loop D (Lemma 1)
    D : PtMap S3 base (KB.K four) (KB.pt four) = (LE.cell d).1.1 ;
    eD : Id LE.M.PMO d (LE.M.loop D) = (LE.cell d).1.2 ;
    null : Tr.Trunc[Id (PtMap (Id S3 base base) (refl base) (Id (KB.K four) (KB.pt four) (KB.pt four)) (refl (KB.pt four))) (ptconst (Id S3 base base) (refl base) (Id (KB.K four) (KB.pt four) (KB.pt four)) (refl (KB.pt four))) d].carrier =
      TC.map (Id (PtMap S3 base (KB.K four) (KB.pt four)) (ptconst S3 base (KB.K four) (KB.pt four)) D) (Id (PtMap (Id S3 base base) (refl base) (Id (KB.K four) (KB.pt four) (KB.pt four)) (refl (KB.pt four))) (ptconst (Id S3 base base) (refl base) (Id (KB.K four) (KB.pt four) (KB.pt four)) (refl (KB.pt four))) d)
        (\ e -> transH (symH (loop-const S3 base (KB.K four) (KB.pt four))) (transH (apH LE.M.loop e) (symH eD)))
        (SS.s3-paths (KB.K four) (KB.pt four) MF.LevW[Gb].cOOOW (ptconst S3 base (KB.K four) (KB.pt four)) D) ;
  } ;
  ex-S (Ga Gb : Ab) (k : PtMap (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four)) (dl : DE.Deloopable (Ga, Gb, k)) :
    MF.Lifting[(Id S3 base base), (refl base), Ga, Gb, k].Ex = \ F -> ExS[Ga, Gb, k, dl, F].null ;
  un-S (Ga Gb : Ab) (k : PtMap (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four)) :
    MF.Lifting[(Id S3 base base), (refl base), Ga, Gb, k].Un = \ d -> UnS[Gb, d].null ;
  qS (Ga Gb : Ab) (k : PtMap (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four)) (dl : DE.Deloopable (Ga, Gb, k)) :
    isEquiv (HC (Id S3 base base) (refl base) Triple[Ga, Gb, k].F Triple[Ga, Gb, k].f0) (HC (Id S3 base base) (refl base) (KK[Ga].K two) (KK[Ga].pt two)) MF.Lifting[(Id S3 base base), (refl base), Ga, Gb, k].qs =
    MF.Lifting[(Id S3 base base), (refl base), Ga, Gb, k].Main[ex-S Ga Gb k dl, un-S Ga Gb k].equiv ;

  -- Theorem: r^* is bijective into Fib k for every deloopable triple
  rF (Ga Gb : Ab) (k : PtMap (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four)) (dl : DE.Deloopable (Ga, Gb, k)) :
    RStar Triple[Ga, Gb, k].F Triple[Ga, Gb, k].f0 =
    W.cancel-equiv (HC DR.TR.F DR.TR.f0 Triple[Ga, Gb, k].F Triple[Ga, Gb, k].f0) (HC (Id S3 base base) (refl base) Triple[Ga, Gb, k].F Triple[Ga, Gb, k].f0) (HC (Id S3 base base) (refl base) (KK[Ga].K two) (KK[Ga].pt two))
      (\ c -> compC (Id S3 base base) (refl base) DR.TR.F DR.TR.f0 Triple[Ga, Gb, k].F Triple[Ga, Gb, k].f0 LM.r c) MF.Lifting[(Id S3 base base), (refl base), Ga, Gb, k].qs (qS Ga Gb k dl)
      (E.homotopy (HC DR.TR.F DR.TR.f0 Triple[Ga, Gb, k].F Triple[Ga, Gb, k].f0) (HC (Id S3 base base) (refl base) (KK[Ga].K two) (KK[Ga].pt two))
         (E.compose (HC DR.TR.F DR.TR.f0 Triple[Ga, Gb, k].F Triple[Ga, Gb, k].f0) (HC DR.TR.F DR.TR.f0 (KK[Ga].K two) (KK[Ga].pt two)) (HC (Id S3 base base) (refl base) (KK[Ga].K two) (KK[Ga].pt two))
            (MF.Lifting[DR.TR.F, DR.TR.f0, Ga, Gb, k].qs, qR Ga Gb k dl)
            (\ c -> compC (Id S3 base base) (refl base) DR.TR.F DR.TR.f0 (KK[Ga].K two) (KK[Ga].pt two) LM.r c, rA Ga))
         (\ c -> MF.Lifting[(Id S3 base base), (refl base), Ga, Gb, k].qs (compC (Id S3 base base) (refl base) DR.TR.F DR.TR.f0 Triple[Ga, Gb, k].F Triple[Ga, Gb, k].f0 LM.r c))
         (\ c -> comp-assoc (Id S3 base base) (refl base) DR.TR.F DR.TR.f0 Triple[Ga, Gb, k].F Triple[Ga, Gb, k].f0 (KK[Ga].K two) (KK[Ga].pt two) LM.r c
                   (hcl Triple[Ga, Gb, k].F Triple[Ga, Gb, k].f0 (KK[Ga].K two) (KK[Ga].pt two) (Fb.fpr (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four) k)))) ;

  -- statement M for every u : SC4
  module AtU (u : DE.SC4) {
    module A = DE.Acs[u] ;
    -- the triple of Omega u, deloopable by u
    t : PC.Triples = PC.realise-equiv.sec (DE.Omega u) ;
    -- realise t = Omega u (the section of the classification)
    t-eq : Id CP.SC3 (PC.realise t) (DE.Omega u) = PC.realise-equiv.sec-eq (DE.Omega u) ;
    -- only its components and t-eq are used: locked
    opaque t ;
    dl : DE.Deloopable (t.1, t.2.1, t.2.2) = (u, P1.sym CP.SC3 (PC.realise t) (DE.Omega u) t-eq) ;
    module LP = TT.Loop[t.1, t.2.1, t.2.2, dl] ;
    lmarked : LM.At[u].LMarked =
      transfer Triple[t.1, t.2.1, t.2.2].F Triple[t.1, t.2.1, t.2.2].f0 (Id A.Y A.y A.y) (refl A.y)
        (pt-inv (Id A.Y A.y A.y) (refl A.y) Triple[t.1, t.2.1, t.2.2].F Triple[t.1, t.2.1, t.2.2].f0 LP.eps)
        (rF t.1 t.2.1 t.2.2 dl) ;
    marked : MK.Marked u = LM.At[u].from-loop lmarked ;
  } ;
  marked (u : DE.SC4) : MK.Marked u = AtU[u].marked ;
} ;
