-- (H3) of KZ2Cohomology: [K(Z,2), K(B,3)]_* is contractible
-- (doc/circle-torsors.pdf, Theorem 6).
--   unloop-prop   the looping M.loop : Map_*(K(Z,2), K(B,3)) -> Map_*(Omega, Omega) has
--                 propositional fibres Unloop (DeloopMaps Corollary 10, c = t = 1)
--   pmo-conn      its target is connected: it is a retract of Map_*(K(Z,1), K(B,2))
--                 (rt-ptmap, the pointed equivalences KK.e), connected by the circle
--                 property (CircleProperty.Circle.ptmap-conn), Omega K(B,2) ~ K(B,1)
--   merely-zero   so every f is merely the zero map: (f, refl) = (0, q) in Unloop (loop f)
--   h3            the set of classes is the class of 0
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ; open HLevels[l] ; open Connected[l] ;
open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ; open Retracts[l] ; open Torsor[l] ;
open EMMaps[l] ; open HomotopyClasses[l] ; open SphereUniversal[l] ; open PostnikovRealization[l] ; open KZ2Cohomology[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module CP = CircleProperty[l] ;

-- pointed equivalences of source and target give a retract of pointed maps
rt-ptmap (A : U l) (a0 : A) (B : U l) (b0 : B) (A' : U l) (a0' : A') (e : PtEquiv A a0 A' a0') (B' : U l) (b0' : B') (d : PtEquiv B b0 B' b0') :
  Retract[PtMap A a0 B b0, PtMap A' a0' B' b0'] =
  ptEqInd A a0 (\ A1 a1 e1 -> Retract[PtMap A a0 B b0, PtMap A1 a1 B' b0'])
    (ptEqInd B b0 (\ B1 b1 d1 -> Retract[PtMap A a0 B b0, PtMap A a0 B1 b1]) (rt-id (PtMap A a0 B b0)) B' b0' d)
    A' a0' e ;

module H3At (Gb : Ab) {
  module A = KK[Zab] ;
  module B = KK[Gb] ;
  module M = Maps[KZ2, kz2, B.K three, B.pt three] ;
  zero-map : PtMap KZ2 kz2 (B.K three) (B.pt three) = (\ x -> B.pt three, refl (B.pt three)) ;
  -- Corollary 10 with c = t = 1
  unloop-prop (phi : M.PMO) : isProp M.Over[phi].Unloop =
    trunc-one-prop M.Over[phi].Unloop M.Over[phi].Levels[suc zero, suc zero, A.conn (suc zero), B.trunc two].cor10 ;
  -- the target of the looping
  pmo-rt : Retract[M.PMO, PtMap (A.K (suc zero)) (A.pt (suc zero)) (B.K two) (B.pt two)] =
    rt-ptmap (Id KZ2 kz2 kz2) (refl kz2) (Id (B.K three) (B.pt three) (B.pt three)) (refl (B.pt three))
      (A.K (suc zero)) (A.pt (suc zero)) (A.e (suc zero)) (B.K two) (B.pt two) (B.e two) ;
  target-conn : isConn (suc (suc zero)) (PtMap (A.K (suc zero)) (A.pt (suc zero)) (B.K two) (B.pt two)) =
    CP.Circle[B.K two].ptmap-conn (B.pt two)
      (Deloop[l].equiv-conn (suc (suc zero)) (Id (B.K two) (B.pt two) (B.pt two)) (B.K (suc zero)) ((B.e (suc zero)).1.1, (B.e (suc zero)).2) (B.conn zero)) ;
  pmo-conn : isConn (suc (suc zero)) M.PMO =
    CP.conn-rt M.PMO (PtMap (A.K (suc zero)) (A.pt (suc zero)) (B.K two) (B.pt two)) pmo-rt target-conn ;
  -- every pointed map is merely 0
  to-zero (f : PtMap KZ2 kz2 (B.K three) (B.pt three)) (q : Id M.PMO (M.loop f) (M.loop zero-map)) :
    Id (PtMap KZ2 kz2 (B.K three) (B.pt three)) f zero-map =
    ap M.Over[M.loop f].Unloop (PtMap KZ2 kz2 (B.K three) (B.pt three)) (\ w -> w.1) (f, refl (M.loop f)) (zero-map, q)
      (unloop-prop (M.loop f) (f, refl (M.loop f)) (zero-map, q)) ;
  merely-zero (f : PtMap KZ2 kz2 (B.K three) (B.pt three)) : Tr.Trunc[Id (PtMap KZ2 kz2 (B.K three) (B.pt three)) zero-map f].carrier =
    TC.map (Id M.PMO (M.loop f) (M.loop zero-map)) (Id (PtMap KZ2 kz2 (B.K three) (B.pt three)) zero-map f)
      (\ q -> sym (PtMap KZ2 kz2 (B.K three) (B.pt three)) f zero-map (to-zero f q))
      (pmo-conn.2 (M.loop f) (M.loop zero-map)).1 ;
  -- the set of classes is a point
  h3 : isContr (HC KZ2 kz2 (B.K three) (B.pt three)) =
    (hcl KZ2 kz2 (B.K three) (B.pt three) zero-map,
     STr[PtMap KZ2 kz2 (B.K three) (B.pt three)].ind @l
       (\ c -> Id (HC KZ2 kz2 (B.K three) (B.pt three)) (hcl KZ2 kz2 (B.K three) (B.pt three) zero-map) c)
       (\ c -> hc-set KZ2 kz2 (B.K three) (B.pt three) (hcl KZ2 kz2 (B.K three) (B.pt three) zero-map) c)
       (\ f -> STr[PtMap KZ2 kz2 (B.K three) (B.pt three)].Q.relates zero-map f (merely-zero f))) ;
} ;

-- (H3)
h3 : H3 = \ Gb -> H3At[Gb].h3 ;
