-- The circle property of K(Z, 1) (doc/circle-torsors.pdf).
--   NatRec        Lemma 1: Sigma (u : N -> W) (u 0 = w) * Pi n, u (n+1) = psi (u n)
--                 is contractible: centre the recursion r, and for (u, e0, e)
--                 the homotopy H : r ~ u (H 0 = e0^-1, H (n+1) = ap psi (H n) . (e n)^-1);
--                 the transports along a path r = u are computed by J (tr),
--                 then at funext H (happly-funext)
--   IntRec        Lemma 2: the same on Z for an equivalence phi; C1 is a retract of
--                 C0(phi, w) * B, B a retract of C0(phi^-1, phi^-1 (h+ 0)):
--                 (x = phi y) <| (y = phi^-1 x) by induction on phi (equiv-rt)
--   Circle        for K = K(Z,1) (EM1[intAb]), g = unband 1, E F = (F k0, ap F g):
--     band-g      (*) band (g . p) = suc (band p)
--     Pt.Q-contr  Lemma 3: Q k = (y' : Y) * (h : (k0 = k) -> (y = y')) * Pi p, h (g.p) = l.h p
--                 is contractible (at k0: Lemma 2 through band; connectedness)
--     Pt.fib-contr  Theorem 4: fib E (y, l) <| X1 <| X2 = Pi k, Q k, with
--                 X1 = (F, e : y = F k0, e . ap F g = l . e) (paths in L Y, lp-rt),
--                 X1 <| (F, H, Pi k p, H k (g.p) = l . H k p) (yon-rt, then j : e |-> e . ap F -)
--     E-equiv     E is an equivalence
--     evPt        Corollary 5: the canonical pointed evaluation
--                 Map_*(K, Y) -> Omega Y, F |-> (loop F) g, is an equivalence;
--     evPt-conj   evPt (F, pF) = pF^-1 . ap F g . pF   (DeloopMaps.Maps.loop-ap;
--                 evPt is locked after evPt-loop and evPt-conj);
--     pointed-up  evPt is, up to subst-conj (p_* u = p^-1 . u . p, J on p), the
--                 composite sub-equiv of fib-up (the fibre of F |-> F k0 is that of
--                 the first projection of L Y along E; induction on E) and
--                 omega-up (that fibre is Omega Y; both round trips by J); hence
--     ptmap-conn  PtMap K k0 Y y0 is connected when (y0 = y0) is (conn-rt)
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ; open HLevels[l] ; open Connected[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module G = Groupoid[l] ;
open Retracts[l] ; open Integers[l] ; open Lemma4[l] ;
module W = Whitehead[l] ;
module LC = LoopConj[l] ;

------------------------------------------------------------------------
-- Lemma 1: recursion on N

-- paths in a product
pair-eq (X Y : U l) (a a' : X) (b b' : Y) (p : Id X a a') (q : Id Y b b') : Id (X * Y) (a, b) (a', b') =
  idJ X a (\ a1 p1 -> Id (X * Y) (a, b) (a1, b')) (ap Y (X * Y) (\ y -> (a, y)) b b' q) a' p ;

-- (a . c^-1)^-1 . a = c
cancel-step (W : U l) (x y z : W) (a : Id W x y) (c : Id W z y) :
  Id (Id W z y) (trans W z x y (sym W x z (trans W x y z a (sym W z y c))) a) c =
  idJR W y (\ z1 c1 -> Id (Id W z1 y) (trans W z1 x y (sym W x z1 (trans W x y z1 a (sym W z1 y c1))) a) c1)
    (trans-sym-l W x y a) z c ;

module NatRec (W : U l) (psi : W -> W) (w : W) {
  Steps (u : Nat -> W) : U l = (n : Nat) -> Id W (u (suc n)) (psi (u n)) ;
  Data (u : Nat -> W) : U l = Id W (u zero) w * Steps u ;
  C0 : U l = (u : Nat -> W) * Data u ;
  r : Nat -> W = split { zero -> w ; suc n | x -> psi x } ;
  centre : C0 = (r, refl w, \ n -> refl (psi (r n))) ;

  -- the data transported along a path Q : r = u
  trd (u : Nat -> W) (K : (n : Nat) -> Id W (r n) (u n)) : Data u =
    (sym W (r zero) (u zero) (K zero), \ n -> trans W (u (suc n)) (psi (r n)) (psi (u n)) (sym W (r (suc n)) (u (suc n)) (K (suc n))) (ap W W psi (r n) (u n) (K n))) ;
  tr (u : Nat -> W) (Q : Id (Nat -> W) r u) :
    Id (Data u) (subst (Nat -> W) Data r u Q centre.2) (trd u (happly Nat (\ n -> W) r u Q)) =
    idJ (Nat -> W) r (\ u1 Q1 -> Id (Data u1) (subst (Nat -> W) Data r u1 Q1 centre.2) (trd u1 (happly Nat (\ n -> W) r u1 Q1)))
      (refl centre.2) u Q ;

  module Contract (u : Nat -> W) (d : Data u) {
    H : (n : Nat) -> Id W (r n) (u n) = split {
      zero -> sym W (u zero) w d.1 ;
      suc n | h -> trans W (psi (r n)) (psi (u n)) (u (suc n)) (ap W W psi (r n) (u n) h) (sym W (u (suc n)) (psi (u n)) (d.2 n)) } ;
    -- by definition of trd and H
    trd-H-def : Id (Data u) (trd u H)
        (sym W w (u zero) (sym W (u zero) w d.1),
         \ n -> trans W (u (suc n)) (psi (r n)) (psi (u n))
                  (sym W (psi (r n)) (u (suc n)) (trans W (psi (r n)) (psi (u n)) (u (suc n)) (ap W W psi (r n) (u n) (H n)) (sym W (u (suc n)) (psi (u n)) (d.2 n))))
                  (ap W W psi (r n) (u n) (H n))) =
      refl (trd u H) ;
    -- the data transported along funext H is d
    trd-H : Id (Data u) (trd u H) d =
      trans (Data u) (trd u H)
        (sym W w (u zero) (sym W (u zero) w d.1),
         \ n -> trans W (u (suc n)) (psi (r n)) (psi (u n))
                  (sym W (psi (r n)) (u (suc n)) (trans W (psi (r n)) (psi (u n)) (u (suc n)) (ap W W psi (r n) (u n) (H n)) (sym W (u (suc n)) (psi (u n)) (d.2 n))))
                  (ap W W psi (r n) (u n) (H n))) d
        trd-H-def
        (pair-eq (Id W (u zero) w) (Steps u) (sym W w (u zero) (sym W (u zero) w d.1)) d.1
           (\ n -> trans W (u (suc n)) (psi (r n)) (psi (u n))
                  (sym W (psi (r n)) (u (suc n)) (trans W (psi (r n)) (psi (u n)) (u (suc n)) (ap W W psi (r n) (u n) (H n)) (sym W (u (suc n)) (psi (u n)) (d.2 n))))
                  (ap W W psi (r n) (u n) (H n))) d.2
           (G.sym-sym W (u zero) w d.1)
           (FL.funext Nat (\ n -> Id W (u (suc n)) (psi (u n)))
              (\ n -> trans W (u (suc n)) (psi (r n)) (psi (u n))
                  (sym W (psi (r n)) (u (suc n)) (trans W (psi (r n)) (psi (u n)) (u (suc n)) (ap W W psi (r n) (u n) (H n)) (sym W (u (suc n)) (psi (u n)) (d.2 n))))
                  (ap W W psi (r n) (u n) (H n))) d.2 (\ n ->
              cancel-step W (psi (r n)) (psi (u n)) (u (suc n)) (ap W W psi (r n) (u n) (H n)) (d.2 n)))) ;
    path : Id C0 centre (u, d) =
      Sigma-path (Nat -> W) Data r u centre.2 d (FL.funext Nat (\ n -> W) r u H)
        (trans (Data u) (subst (Nat -> W) Data r u (FL.funext Nat (\ n -> W) r u H) centre.2) (trd u H) d
           (trans (Data u) (subst (Nat -> W) Data r u (FL.funext Nat (\ n -> W) r u H) centre.2)
              (trd u (happly Nat (\ n -> W) r u (FL.funext Nat (\ n -> W) r u H))) (trd u H)
              (tr u (FL.funext Nat (\ n -> W) r u H))
              (ap ((n : Nat) -> Id W (r n) (u n)) (Data u) (trd u) (happly Nat (\ n -> W) r u (FL.funext Nat (\ n -> W) r u H)) H
                 (FL.happly-funext Nat (\ n -> W) r u H)))
           trd-H) ;
  } ;

  contr : isContr C0 = (centre, \ c -> Contract[c.1, c.2].path) ;
} ;

------------------------------------------------------------------------
-- Lemma 2: recursion on Z

-- products and Pi of retracts
rt-prod (A B C D : U l) (R1 : Retract[A, C]) (R2 : Retract[B, D]) : Retract[A * B, C * D] =
  new Retract[A * B, C * D, \ v -> (R1.s v.1, R2.s v.2), \ v -> (R1.r v.1, R2.r v.2),
    \ v -> pair-eq A B (R1.r (R1.s v.1)) v.1 (R2.r (R2.s v.2)) v.2 (R1.h v.1) (R2.h v.2)] ;
rt-Pi (X : U l) (P Q : X -> U l) (R : (x : X) -> Retract[P x, Q x]) : Retract[(x : X) -> P x, (x : X) -> Q x] =
  new Retract[(x : X) -> P x, (x : X) -> Q x, \ f x -> (R x).s (f x), \ f x -> (R x).r (f x),
    \ f -> FL.funext X P (\ x -> (R x).r ((R x).s (f x))) f (\ x -> (R x).h (f x))] ;

-- (x = e y) <| (y = e^-1 x), by induction on e
equiv-rt (W W' : U l) (e : Equiv W W') : (x : W') (y : W) -> Retract[Id W' x (e.1 y), Id W y (e.2.sec x)] =
  Axioms[l].UnivalenceLemmas[univ @l].eqind W (\ W1 e1 -> (x : W1) (y : W) -> Retract[Id W1 x (e1.1 y), Id W y (e1.2.sec x)])
    (\ x y -> new Retract[Id W x y, Id W y x, sym W x y, sym W y x, G.sym-sym W x y]) W' e ;

module IntRec (W : U l) (phi : Equiv W W) (w : W) {
  Steps (h : Int -> W) : U l = (n : Int) -> Id W (h (sucZ n)) (phi.1 (h n)) ;
  Data (h : Int -> W) : U l = Id W (h zeroZ) w * Steps h ;
  C1 : U l = (h : Int -> W) * Data h ;

  -- the conditions, by cases on Z
  Data' (h : Int -> W) : U l =
    Id W (h zeroZ) w * ((n : Nat) -> Id W (h (pos (suc n))) (phi.1 (h (pos n)))) *
    Id W (h zeroZ) (phi.1 (h (negsuc zero))) * ((m : Nat) -> Id W (h (negsuc m)) (phi.1 (h (negsuc (suc m))))) ;
  negE (h : Int -> W) (c0 : Id W (h zeroZ) (phi.1 (h (negsuc zero)))) (cn : (m : Nat) -> Id W (h (negsuc m)) (phi.1 (h (negsuc (suc m))))) :
    (m : Nat) -> Id W (h (sucZ (negsuc m))) (phi.1 (h (negsuc m))) = split { zero -> c0 ; suc m -> cn m } ;
  allE (h : Int -> W) (d : Data' h) : Steps h = split { pos n -> d.2.1 n ; negsuc m -> negE h d.2.2.1 d.2.2.2 m } ;
  split-d (h : Int -> W) (d : Data h) : Data' h = (d.1, \ n -> d.2 (pos n), d.2 (negsuc zero), \ m -> d.2 (negsuc (suc m))) ;
  neg-eta (h : Int -> W) (e : Steps h) : (m : Nat) -> Id (Id W (h (sucZ (negsuc m))) (phi.1 (h (negsuc m))))
      (negE h (e (negsuc zero)) (\ m1 -> e (negsuc (suc m1))) m) (e (negsuc m)) =
    split { zero -> refl (e (negsuc zero)) ; suc m -> refl (e (negsuc (suc m))) } ;
  all-eta (h : Int -> W) (d : Data h) : (n : Int) -> Id (Id W (h (sucZ n)) (phi.1 (h n))) (allE h (split-d h d) n) (d.2 n) =
    split { pos n -> refl (d.2 (pos n)) ; negsuc m -> neg-eta h d.2 m } ;
  rt-data (h : Int -> W) : Retract[Data h, Data' h] =
    new Retract[Data h, Data' h, split-d h, \ d -> (d.1, allE h d),
      \ d -> pair-eq (Id W (h zeroZ) w) (Steps h) d.1 d.1 (allE h (split-d h d)) d.2 (refl d.1)
                (FL.funext Int (\ n -> Id W (h (sucZ n)) (phi.1 (h n))) (allE h (split-d h d)) d.2 (all-eta h d))] ;

  -- functions on Z are pairs of functions on N
  NN : U l = (Nat -> W) * (Nat -> W) ;
  res (h : Int -> W) : NN = (\ n -> h (pos n), \ m -> h (negsuc m)) ;
  glue (x : NN) : Int -> W = split { pos n -> x.1 n ; negsuc m -> x.2 m } ;
  glue-res-at (h : Int -> W) : (n : Int) -> Id W (glue (res h) n) (h n) =
    split { pos n -> refl (h (pos n)) ; negsuc m -> refl (h (negsuc m)) } ;
  glue-res (h : Int -> W) : Id (Int -> W) (glue (res h)) h = FL.funext Int (\ n -> W) (glue (res h)) h (glue-res-at h) ;
  res-equiv : Equiv (Int -> W) NN = (res, qinv (Int -> W) NN res glue (\ x -> refl x) glue-res) ;
  Phi (x : NN) : U l =
    Id W (x.1 zero) w * ((n : Nat) -> Id W (x.1 (suc n)) (phi.1 (x.1 n))) *
    Id W (x.1 zero) (phi.1 (x.2 zero)) * ((m : Nat) -> Id W (x.2 m) (phi.1 (x.2 (suc m)))) ;

  -- the negative half
  module NR = NatRec[W, phi.1, w] ;
  B (a : NR.C0) : U l = (b : Nat -> W) * Id W (a.1 zero) (phi.1 (b zero)) * ((m : Nat) -> Id W (b m) (phi.1 (b (suc m)))) ;
  rt-B (a : NR.C0) : Retract[B a, NatRec[W, phi.2.sec, phi.2.sec (a.1 zero)].C0] =
    rt-Sigma (Nat -> W) (\ b -> Id W (a.1 zero) (phi.1 (b zero)) * ((m : Nat) -> Id W (b m) (phi.1 (b (suc m)))))
      (NatRec[W, phi.2.sec, phi.2.sec (a.1 zero)].Data)
      (\ b -> rt-prod (Id W (a.1 zero) (phi.1 (b zero))) ((m : Nat) -> Id W (b m) (phi.1 (b (suc m))))
                 (Id W (b zero) (phi.2.sec (a.1 zero))) ((m : Nat) -> Id W (b (suc m)) (phi.2.sec (b m)))
                 (equiv-rt W W phi (a.1 zero) (b zero))
                 (rt-Pi Nat (\ m -> Id W (b m) (phi.1 (b (suc m)))) (\ m -> Id W (b (suc m)) (phi.2.sec (b m)))
                    (\ m -> equiv-rt W W phi (b m) (b (suc m))))) ;
  B-contr (a : NR.C0) : isContr (B a) =
    rt-trunc zero (B a) (NatRec[W, phi.2.sec, phi.2.sec (a.1 zero)].C0) (rt-B a) NatRec[W, phi.2.sec, phi.2.sec (a.1 zero)].contr ;

  -- C1 <| Sigma h Data' h <| Sigma x Phi x <| Sigma a B a
  rt-split : Retract[(x : NN) * Phi x, (a : NR.C0) * B a] =
    new Retract[(x : NN) * Phi x, (a : NR.C0) * B a,
      \ v -> ((v.1.1, v.2.1, v.2.2.1), (v.1.2, v.2.2.2.1, v.2.2.2.2)),
      \ v -> ((v.1.1, v.2.1), (v.1.2.1, v.1.2.2, v.2.2.1, v.2.2.2)), \ v -> refl v] ;
  rt-C1 : Retract[C1, (a : NR.C0) * B a] =
    rt-comp C1 ((h : Int -> W) * Data' h) ((a : NR.C0) * B a)
      (rt-Sigma (Int -> W) Data Data' rt-data)
      (rt-comp ((h : Int -> W) * Data' h) ((x : NN) * Phi x) ((a : NR.C0) * B a)
         (rt-base (Int -> W) NN res-equiv Phi) rt-split) ;
  contr : isContr C1 =
    rt-trunc zero C1 ((a : NR.C0) * B a) rt-C1
      (trunc-Sigma-contr zero NR.C0 B NR.contr (B-contr NR.contr.1)) ;
} ;

------------------------------------------------------------------------
-- Lemma 3 and Theorem 4: the circle property

-- a retract from an equivalence; based path induction as a retract
rt-equiv (A B : U l) (e : Equiv A B) : Retract[A, B] = new Retract[A, B, e.1, e.2.ret, e.2.ret-eq] ;
yon-rt (K : U l) (k0 : K) (D : (k : K) -> Id K k0 k -> U l) : Retract[D k0 (refl k0), (k : K) (p : Id K k0 k) -> D k p] =
  new Retract[D k0 (refl k0), (k : K) (p : Id K k0 k) -> D k p, \ d k p -> idJ K k0 D d k p, \ f -> f k0 (refl k0), \ d -> refl d] ;
-- Sigma and Pi over an equivalence, by induction on it
rt-base' (X Z : U l) (K : Equiv X Z) (Phi : X -> U l) : Retract[(x : X) * Phi x, (z : Z) * Phi (K.2.sec z)] =
  Axioms[l].UnivalenceLemmas[univ @l].eqind X (\ Z1 K1 -> Retract[(x : X) * Phi x, (z : Z1) * Phi (K1.2.sec z)]) (rt-id ((x : X) * Phi x)) Z K ;
pi-rt (X Z : U l) (K : Equiv X Z) (Gf : Z -> U l) : Retract[(x : X) -> Gf (K.1 x), (z : Z) -> Gf z] =
  Axioms[l].UnivalenceLemmas[univ @l].eqind X (\ Z1 K1 -> (G1 : Z1 -> U l) -> Retract[(x : X) -> G1 (K1.1 x), (z : Z1) -> G1 z])
    (\ G1 -> rt-id ((x : X) -> G1 x)) Z K Gf ;

-- the loops at a point; the free loop type and its paths
Lp (Y : U l) (y : Y) : U l = Id Y y y ;
LY (Y : U l) : U l = (y : Y) * Id Y y y ;
LPath (Y : U l) (a : Y) (u : Id Y a a) (w : LY Y) : U l =
  (e : Id Y w.1 a) * Id (Id Y w.1 a) (trans Y w.1 a a e u) (trans Y w.1 w.1 a w.2 e) ;
lp-s (Y : U l) (a : Y) (u : Id Y a a) (w : LY Y) (P : Id (LY Y) (a, u) w) : LPath Y a u w =
  idJ (LY Y) (a, u) (\ w1 P1 -> LPath Y a u w1) (refl a, trans-refl-l Y a a u) w P ;
lp-r (Y : U l) (a : Y) (u : Id Y a a) (b : Y) (e : Id Y b a) : (v : Id Y b b) -> Id (Id Y b a) (trans Y b a a e u) (trans Y b b a v e) -> Id (LY Y) (a, u) (b, v) =
  idJR Y a (\ b1 e1 -> (v1 : Id Y b1 b1) -> Id (Id Y b1 a) (trans Y b1 a a e1 u) (trans Y b1 b1 a v1 e1) -> Id (LY Y) (a, u) (b1, v1))
    (\ v1 c1 -> ap (Id Y a a) (LY Y) (\ z -> (a, z)) u v1
       (trans (Id Y a a) u (trans Y a a a (refl a) u) v1 (sym (Id Y a a) (trans Y a a a (refl a) u) u (trans-refl-l Y a a u)) c1)) b e ;
lp-rt (Y : U l) (a : Y) (u : Id Y a a) (w : LY Y) : Retract[Id (LY Y) (a, u) w, LPath Y a u w] =
  new Retract[Id (LY Y) (a, u) w, LPath Y a u w, lp-s Y a u w, \ v -> lp-r Y a u w.1 v.1 w.2 v.2,
    \ P -> idJ (LY Y) (a, u) (\ w1 P1 -> Id (Id (LY Y) (a, u) w1) (lp-r Y a u w1.1 (lp-s Y a u w1 P1).1 w1.2 (lp-s Y a u w1 P1).2) P1)
      (ap (Id (Id Y a a) u u) (Id (LY Y) (a, u) (a, u)) (\ q -> ap (Id Y a a) (LY Y) (\ z -> (a, z)) u u q)
         (trans (Id Y a a) u (trans Y a a a (refl a) u) u (sym (Id Y a a) (trans Y a a a (refl a) u) u (trans-refl-l Y a a u)) (trans-refl-l Y a a u))
         (refl u) (trans-sym-l (Id Y a a) (trans Y a a a (refl a) u) u (trans-refl-l Y a a u)))
      w P] ;

-- fibres along an equivalence: (a, p) |-> (E a, p) is an equivalence, by induction on E
fib-up (A B : U l) (E : Equiv A B) (C : U l) (pi : B -> C) (c : C) :
  isEquiv (W.fib A C (\ a -> pi (E.1 a)) c) (W.fib B C pi c) (\ w -> (E.1 w.1, w.2)) =
  Axioms[l].UnivalenceLemmas[univ @l].eqind A (\ B1 E1 -> (pi1 : B1 -> C) -> isEquiv (W.fib A C (\ a -> pi1 (E1.1 a)) c) (W.fib B1 C pi1 c) (\ w -> (E1.1 w.1, w.2)))
    (\ pi1 -> (idEquiv (W.fib A C pi1 c)).2) B E pi ;
-- the fibre of the first projection of L Y is the loop space
omega-h (Y : U l) (y0 : Y) (y : Y) (q : Id Y y y) (p : Id Y y y0) :
  Id (W.fib (LY Y) Y (\ v -> v.1) y0) ((y0, subst Y (Lp Y) y y0 p q), refl y0) ((y, q), p) =
  idJR Y y0 (\ y1 p1 -> (q1 : Id Y y1 y1) -> Id (W.fib (LY Y) Y (\ v -> v.1) y0) ((y0, subst Y (Lp Y) y1 y0 p1 q1), refl y0) ((y1, q1), p1))
    (\ q1 -> refl ((y0, q1), refl y0)) y p q ;
omega-map (Y : U l) (y0 : Y) (w : W.fib (LY Y) Y (\ v -> v.1) y0) : Id Y y0 y0 = subst Y (Lp Y) w.1.1 y0 w.2 w.1.2 ;
omega-up (Y : U l) (y0 : Y) : isEquiv (W.fib (LY Y) Y (\ v -> v.1) y0) (Id Y y0 y0) (omega-map Y y0) =
  qinv (W.fib (LY Y) Y (\ v -> v.1) y0) (Id Y y0 y0) (omega-map Y y0) (\ q -> ((y0, q), refl y0)) (\ q -> refl q)
    (\ w -> omega-h Y y0 w.1.1 w.1.2 w.2) ;
-- transport of a loop is conjugation, by J on p
subst-conj (Y : U l) (y : Y) (q : Id Y y y) : (y0 : Y) (p : Id Y y y0) ->
  Id (Id Y y0 y0) (subst Y (Lp Y) y y0 p q) (LC.conj Y y y0 p q) =
  \ y0 p -> idJ Y y (\ y1 p1 -> Id (Id Y y1 y1) (subst Y (Lp Y) y y1 p1 q) (LC.conj Y y y1 p1 q))
    (symH (LC.conj-refl-loop Y y q)) y0 p ;
-- a retract of a connected type is connected
conn-rt (A B : U l) (R : Retract[A, B]) (c : isConn (suc (suc zero)) B) : isConn (suc (suc zero)) A =
  (TruncationCombinators[l].map B A R.r c.1, \ a a' ->
    (TruncationCombinators[l].map (Id B (R.s a) (R.s a')) (Id A a a')
       (\ q -> trans A a (R.r (R.s a)) a' (sym A (R.r (R.s a)) a (R.h a))
                  (trans A (R.r (R.s a)) (R.r (R.s a')) a' (ap B A R.r (R.s a) (R.s a') q) (R.h a')))
       (c.2 (R.s a) (R.s a')).1,
     \ x y -> tt)) ;

module Circle (Y : U l) {
  module Z1 = EM[l].EM1[intAb] ;
  g : Id Z1.K1 Z1.k0 Z1.k0 = Z1.unband Z1.k0 (pos (suc zero)) ;
  -- (*)
  band-g (p : Id Z1.K1 Z1.k0 Z1.k0) : Id Int (Z1.band Z1.k0 (trans Z1.K1 Z1.k0 Z1.k0 Z1.k0 g p)) (sucZ (Z1.band Z1.k0 p)) =
    trans Int (Z1.band Z1.k0 (trans Z1.K1 Z1.k0 Z1.k0 Z1.k0 g p)) (add (pos (suc zero)) (Z1.band Z1.k0 p)) (sucZ (Z1.band Z1.k0 p))
      (trans Int (Z1.band Z1.k0 (trans Z1.K1 Z1.k0 Z1.k0 Z1.k0 g p)) (add (Z1.band Z1.k0 g) (Z1.band Z1.k0 p)) (add (pos (suc zero)) (Z1.band Z1.k0 p))
         (Z1.band-hom Z1.k0 g p)
         (ap Int Int (\ c -> add c (Z1.band Z1.k0 p)) (Z1.band Z1.k0 g) (pos (suc zero)) (Z1.band-unband Z1.k0 (pos (suc zero)))))
      (comm (pos (suc zero)) (Z1.band Z1.k0 p)) ;
  -- locked after its characterising lemma band-g
  opaque g ;
  E (F : Z1.K1 -> Y) : LY Y = (F Z1.k0, ap Z1.K1 Y F Z1.k0 Z1.k0 g) ;

  module Pt (y : Y) (lp : Id Y y y) {
    Cond (k : Z1.K1) (y' : Y) (h : Id Z1.K1 Z1.k0 k -> Id Y y y') : U l =
      (p : Id Z1.K1 Z1.k0 k) -> Id (Id Y y y') (h (trans Z1.K1 Z1.k0 Z1.k0 k g p)) (trans Y y y y' lp (h p)) ;
    Q (k : Z1.K1) : U l = (y' : Y) * (h : Id Z1.K1 Z1.k0 k -> Id Y y y') * Cond k y' h ;

    -- Lemma 3 at k0: through the band, Lemma 2
    phi (y' : Y) : Equiv (Id Y y y') (Id Y y y') = Fibres[l].trans-equiv Y y y y' lp ;
    pre (y' : Y) : Equiv (Id Z1.K1 Z1.k0 Z1.k0 -> Id Y y y') (Int -> Id Y y y') =
      (\ h n -> h (Z1.unband Z1.k0 n),
       qinv (Id Z1.K1 Z1.k0 Z1.k0 -> Id Y y y') (Int -> Id Y y y') (\ h n -> h (Z1.unband Z1.k0 n)) (\ hz p -> hz (Z1.band Z1.k0 p))
         (\ hz -> FL.funext Int (\ n -> Id Y y y') (\ n -> hz (Z1.band Z1.k0 (Z1.unband Z1.k0 n))) hz
                     (\ n -> ap Int (Id Y y y') hz (Z1.band Z1.k0 (Z1.unband Z1.k0 n)) n (Z1.band-unband Z1.k0 n)))
         (\ h -> FL.funext (Id Z1.K1 Z1.k0 Z1.k0) (\ p -> Id Y y y') (\ p -> h (Z1.unband Z1.k0 (Z1.band Z1.k0 p))) h
                     (\ p -> ap (Id Z1.K1 Z1.k0 Z1.k0) (Id Y y y') h (Z1.unband Z1.k0 (Z1.band Z1.k0 p)) p (Z1.unband-band Z1.k0 p)))) ;
    Gs (y' : Y) (hz : Int -> Id Y y y') (n : Int) : U l = Id (Id Y y y') (hz (sucZ n)) (trans Y y y y' lp (hz n)) ;
    -- moving along (*)
    tr-equiv (y' : Y) (hz : Int -> Id Y y y') (p : Id Z1.K1 Z1.k0 Z1.k0) :
      Equiv (Id (Id Y y y') (hz (Z1.band Z1.k0 (trans Z1.K1 Z1.k0 Z1.k0 Z1.k0 g p))) (trans Y y y y' lp (hz (Z1.band Z1.k0 p)))) (Gs y' hz (Z1.band Z1.k0 p)) =
      Fibres[l].trans-equiv (Id Y y y') (hz (sucZ (Z1.band Z1.k0 p))) (hz (Z1.band Z1.k0 (trans Z1.K1 Z1.k0 Z1.k0 Z1.k0 g p))) (trans Y y y y' lp (hz (Z1.band Z1.k0 p)))
        (sym (Id Y y y') (hz (Z1.band Z1.k0 (trans Z1.K1 Z1.k0 Z1.k0 Z1.k0 g p))) (hz (sucZ (Z1.band Z1.k0 p)))
           (ap Int (Id Y y y') hz (Z1.band Z1.k0 (trans Z1.K1 Z1.k0 Z1.k0 Z1.k0 g p)) (sucZ (Z1.band Z1.k0 p)) (band-g p))) ;
    cond-rt (y' : Y) (hz : Int -> Id Y y y') : Retract[Cond Z1.k0 y' (\ p -> hz (Z1.band Z1.k0 p)), (n : Int) -> Gs y' hz n] =
      rt-comp (Cond Z1.k0 y' (\ p -> hz (Z1.band Z1.k0 p))) ((p : Id Z1.K1 Z1.k0 Z1.k0) -> Gs y' hz (Z1.band Z1.k0 p)) ((n : Int) -> Gs y' hz n)
        (rt-Pi (Id Z1.K1 Z1.k0 Z1.k0)
           (\ p -> Id (Id Y y y') (hz (Z1.band Z1.k0 (trans Z1.K1 Z1.k0 Z1.k0 Z1.k0 g p))) (trans Y y y y' lp (hz (Z1.band Z1.k0 p))))
           (\ p -> Gs y' hz (Z1.band Z1.k0 p))
           (\ p -> rt-equiv (Id (Id Y y y') (hz (Z1.band Z1.k0 (trans Z1.K1 Z1.k0 Z1.k0 Z1.k0 g p))) (trans Y y y y' lp (hz (Z1.band Z1.k0 p))))
                      (Gs y' hz (Z1.band Z1.k0 p)) (tr-equiv y' hz p)))
        (pi-rt (Id Z1.K1 Z1.k0 Z1.k0) Int (Z1.band-equiv Z1.k0) (Gs y' hz)) ;
    Q0-rt : Retract[Q Z1.k0, (v : (y' : Y) * Id Y y y') * IntRec[Id Y y v.1, phi v.1, v.2].C1] =
      rt-comp (Q Z1.k0) ((y' : Y) * (hz : Int -> Id Y y y') * ((n : Int) -> Gs y' hz n)) ((v : (y' : Y) * Id Y y y') * IntRec[Id Y y v.1, phi v.1, v.2].C1)
        (rt-Sigma Y (\ y' -> (h : Id Z1.K1 Z1.k0 Z1.k0 -> Id Y y y') * Cond Z1.k0 y' h) (\ y' -> (hz : Int -> Id Y y y') * ((n : Int) -> Gs y' hz n))
           (\ y' -> rt-comp ((h : Id Z1.K1 Z1.k0 Z1.k0 -> Id Y y y') * Cond Z1.k0 y' h)
                      ((hz : Int -> Id Y y y') * Cond Z1.k0 y' (\ p -> hz (Z1.band Z1.k0 p))) ((hz : Int -> Id Y y y') * ((n : Int) -> Gs y' hz n))
                      (rt-base' (Id Z1.K1 Z1.k0 Z1.k0 -> Id Y y y') (Int -> Id Y y y') (pre y') (Cond Z1.k0 y'))
                      (rt-Sigma (Int -> Id Y y y') (\ hz -> Cond Z1.k0 y' (\ p -> hz (Z1.band Z1.k0 p))) (\ hz -> (n : Int) -> Gs y' hz n) (cond-rt y'))))
        (new Retract[(y' : Y) * (hz : Int -> Id Y y y') * ((n : Int) -> Gs y' hz n), (v : (y' : Y) * Id Y y y') * IntRec[Id Y y v.1, phi v.1, v.2].C1,
           \ v -> ((v.1, v.2.1 zeroZ), (v.2.1, refl (v.2.1 zeroZ), v.2.2)), \ v -> (v.1.1, v.2.1, v.2.2.2), \ v -> refl v]) ;
    Q0-contr : isContr (Q Z1.k0) =
      rt-trunc zero (Q Z1.k0) ((v : (y' : Y) * Id Y y y') * IntRec[Id Y y v.1, phi v.1, v.2].C1) Q0-rt
        (trunc-Sigma-contr zero ((y' : Y) * Id Y y y') (\ v -> IntRec[Id Y y v.1, phi v.1, v.2].C1) (DeloopMaps[l].singL Y y)
           IntRec[Id Y y y, phi y, refl y].contr) ;
    -- Lemma 3
    Q-contr (k : Z1.K1) : isContr (Q k) =
      conn-elim zero Z1.K1 Z1.k0 Z1.conn1 (\ k1 -> isContr (Q k1)) (\ k1 -> Torsor[l].isProp-isContr (Q k1)) Q0-contr k ;
    PiQ-contr : isContr ((k : Z1.K1) -> Q k) = FunExtUA[l].FE[univ @l].wfe Z1.K1 Q Q-contr ;

    -- Theorem 4: the fibre of E is a retract of Pi Q
    D (F : Z1.K1 -> Y) (e : Id Y y (F Z1.k0)) (k : Z1.K1) (p : Id Z1.K1 Z1.k0 k) : U l =
      Id (Id Y y (F k)) (trans Y y (F Z1.k0) (F k) e (ap Z1.K1 Y F Z1.k0 k (trans Z1.K1 Z1.k0 Z1.k0 k g p)))
        (trans Y y y (F k) lp (trans Y y (F Z1.k0) (F k) e (ap Z1.K1 Y F Z1.k0 k p))) ;
    X1 : U l = (F : Z1.K1 -> Y) * (e : Id Y y (F Z1.k0)) * D F e Z1.k0 (refl Z1.k0) ;
    Hm (F : Z1.K1 -> Y) : U l = (k : Z1.K1) -> Id Z1.K1 Z1.k0 k -> Id Y y (F k) ;
    CondH (F : Z1.K1 -> Y) (H : Hm F) : U l =
      (k : Z1.K1) (p : Id Z1.K1 Z1.k0 k) -> Id (Id Y y (F k)) (H k (trans Z1.K1 Z1.k0 Z1.k0 k g p)) (trans Y y y (F k) lp (H k p)) ;
    X2 : U l = (F : Z1.K1 -> Y) * (H : Hm F) * CondH F H ;
    j (F : Z1.K1 -> Y) (e : Id Y y (F Z1.k0)) : Hm F = \ k p -> trans Y y (F Z1.k0) (F k) e (ap Z1.K1 Y F Z1.k0 k p) ;
    j-ev (F : Z1.K1 -> Y) (H : Hm F) : Id (Hm F) (j F (H Z1.k0 (refl Z1.k0))) H =
      FL.funext Z1.K1 (\ k -> Id Z1.K1 Z1.k0 k -> Id Y y (F k)) (j F (H Z1.k0 (refl Z1.k0))) H (\ k ->
        FL.funext (Id Z1.K1 Z1.k0 k) (\ p -> Id Y y (F k)) (j F (H Z1.k0 (refl Z1.k0)) k) (H k) (\ p ->
          idJ Z1.K1 Z1.k0 (\ k1 p1 -> Id (Id Y y (F k1)) (j F (H Z1.k0 (refl Z1.k0)) k1 p1) (H k1 p1)) (refl (H Z1.k0 (refl Z1.k0))) k p)) ;
    j-equiv (F : Z1.K1 -> Y) : Equiv (Id Y y (F Z1.k0)) (Hm F) =
      (j F, qinv (Id Y y (F Z1.k0)) (Hm F) (j F) (\ H -> H Z1.k0 (refl Z1.k0)) (j-ev F) (\ e -> refl e)) ;
    -- (1) paths in L Y
    fib-rt : Retract[W.fib (Z1.K1 -> Y) (LY Y) E (y, lp), X1] =
      rt-Sigma (Z1.K1 -> Y) (\ F -> Id (LY Y) (E F) (y, lp)) (\ F -> (e : Id Y y (F Z1.k0)) * D F e Z1.k0 (refl Z1.k0))
        (\ F -> lp-rt Y (F Z1.k0) (ap Z1.K1 Y F Z1.k0 Z1.k0 g) (y, lp)) ;
    -- (4), then (3)
    X1-rt : Retract[X1, X2] =
      rt-Sigma (Z1.K1 -> Y) (\ F -> (e : Id Y y (F Z1.k0)) * D F e Z1.k0 (refl Z1.k0)) (\ F -> (H : Hm F) * CondH F H) (\ F ->
        rt-comp ((e : Id Y y (F Z1.k0)) * D F e Z1.k0 (refl Z1.k0)) ((e : Id Y y (F Z1.k0)) * ((k : Z1.K1) (p : Id Z1.K1 Z1.k0 k) -> D F e k p))
          ((H : Hm F) * CondH F H)
          (rt-Sigma (Id Y y (F Z1.k0)) (\ e -> D F e Z1.k0 (refl Z1.k0)) (\ e -> (k : Z1.K1) (p : Id Z1.K1 Z1.k0 k) -> D F e k p)
             (\ e -> yon-rt Z1.K1 Z1.k0 (D F e)))
          (rt-base (Id Y y (F Z1.k0)) (Hm F) (j-equiv F) (CondH F))) ;
    -- (2) distributivity
    X2-rt : Retract[X2, (k : Z1.K1) -> Q k] =
      new Retract[X2, (k : Z1.K1) -> Q k, \ v k -> (v.1 k, v.2.1 k, v.2.2 k),
        \ f -> (\ k -> (f k).1, \ k -> (f k).2.1, \ k -> (f k).2.2), \ v -> refl v] ;
    fib-contr : isContr (W.fib (Z1.K1 -> Y) (LY Y) E (y, lp)) =
      rt-trunc zero (W.fib (Z1.K1 -> Y) (LY Y) E (y, lp)) ((k : Z1.K1) -> Q k)
        (rt-comp (W.fib (Z1.K1 -> Y) (LY Y) E (y, lp)) X1 ((k : Z1.K1) -> Q k) fib-rt
           (rt-comp X1 X2 ((k : Z1.K1) -> Q k) X1-rt X2-rt))
        PiQ-contr ;
  } ;

  -- Theorem 4
  E-equiv : isEquiv (Z1.K1 -> Y) (LY Y) E = W.contr-equiv (Z1.K1 -> Y) (LY Y) E (\ v -> Pt[v.1, v.2].fib-contr) ;

  -- Corollary 5: the canonical pointed evaluation  Map_*(K, Y) -> Omega Y,  F |-> (loop F) g
  evPt (y0 : Y) (F : PtMap Z1.K1 Z1.k0 Y y0) : Id Y y0 y0 = (DeloopMaps[l].Maps[Z1.K1, Z1.k0, Y, y0].loop F).1 g ;
  evPt-loop (y0 : Y) (F : PtMap Z1.K1 Z1.k0 Y y0) :
    Id (Id Y y0 y0) (evPt y0 F) ((DeloopMaps[l].Maps[Z1.K1, Z1.k0, Y, y0].loop F).1 g) = refl (evPt y0 F) ;
  -- the evaluation formula  evPt (F, pF) = pF^-1 . ap F g . pF
  evPt-conj (y0 : Y) (F : PtMap Z1.K1 Z1.k0 Y y0) :
    Id (Id Y y0 y0) (evPt y0 F) (LC.conj Y (F.1 Z1.k0) y0 F.2 (ap Z1.K1 Y F.1 Z1.k0 Z1.k0 g)) =
    transH (evPt-loop y0 F) (DeloopMaps[l].Maps[Z1.K1, Z1.k0, Y, y0].loop-ap F g) ;
  -- locked after its characterising lemmas evPt-loop, evPt-conj
  opaque evPt ;
  -- the composite of fib-up along E and omega-up
  sub-equiv (y0 : Y) : Equiv (PtMap Z1.K1 Z1.k0 Y y0) (Id Y y0 y0) =
    Equivalences[l].compose (PtMap Z1.K1 Z1.k0 Y y0) (W.fib (LY Y) Y (\ v -> v.1) y0) (Id Y y0 y0)
      (\ w -> (E w.1, w.2), fib-up (Z1.K1 -> Y) (LY Y) (E, E-equiv) Y (\ v -> v.1) y0)
      (omega-map Y y0, omega-up Y y0) ;
  -- by definition of compose, E and omega-map
  sub-equiv-def (y0 : Y) (F : PtMap Z1.K1 Z1.k0 Y y0) :
    Id (Id Y y0 y0) ((sub-equiv y0).1 F) (subst Y (Lp Y) (F.1 Z1.k0) y0 F.2 (ap Z1.K1 Y F.1 Z1.k0 Z1.k0 g)) =
    calc (Id Y y0 y0) {
      (sub-equiv y0).1 F =< refl ((sub-equiv y0).1 F) >
      omega-map Y y0 (E F.1, F.2) =< refl (omega-map Y y0 (E F.1, F.2)) >
      subst Y (Lp Y) (E F.1).1 y0 F.2 (E F.1).2 =< refl (subst Y (Lp Y) (E F.1).1 y0 F.2 (E F.1).2) >
      subst Y (Lp Y) (F.1 Z1.k0) y0 F.2 (ap Z1.K1 Y F.1 Z1.k0 Z1.k0 g) } ;
  -- evPt F = conj F.2 (ap F g) = subst F.2 (ap F g) = (sub-equiv y0).1 F
  pointed-up (y0 : Y) : isEquiv (PtMap Z1.K1 Z1.k0 Y y0) (Id Y y0 y0) (evPt y0) =
    Equivalences[l].homotopy (PtMap Z1.K1 Z1.k0 Y y0) (Id Y y0 y0) (sub-equiv y0) (evPt y0) (\ F ->
      transH (evPt-conj y0 F)
        (transH (symH (subst-conj Y (F.1 Z1.k0) (ap Z1.K1 Y F.1 Z1.k0 Z1.k0 g) y0 F.2)) (symH (sub-equiv-def y0 F)))) ;
  pointed-equiv (y0 : Y) : Equiv (PtMap Z1.K1 Z1.k0 Y y0) (Id Y y0 y0) = (evPt y0, pointed-up y0) ;
  ptmap-conn (y0 : Y) (c : isConn (suc (suc zero)) (Id Y y0 y0)) : isConn (suc (suc zero)) (PtMap Z1.K1 Z1.k0 Y y0) =
    conn-rt (PtMap Z1.K1 Z1.k0 Y y0) (Id Y y0 y0) (rt-equiv (PtMap Z1.K1 Z1.k0 Y y0) (Id Y y0 y0) (pointed-equiv y0)) c ;
} ;
