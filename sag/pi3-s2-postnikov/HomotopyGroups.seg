-- Higher homotopy groups as groups, functorial on pointed maps and on
-- pointed homotopy classes (milestone A).
--   pi3 X     = pi_1 (Omega^2 X, refl refl) (PiOne): the third homotopy
--               group with the composition of the outer loop
--   pi3-map F = pi_1 (loop2 F), a homomorphism (PiOne.Induced)
--   ind-comp, ind-id    pi_1 is a functor on pointed maps (LoopCalc.loop-comp,
--               Puppe.loop-id)
--   pi3-comp, pi3-id    hence so is pi3 (loop2 (F ; G) = loop2 F ; loop2 G)
--   pi3C      pi3 on CLASSES [X, Y]_*: homomorphisms form a set, so pi3-map
--             descends to the set truncation; no representative of a class
--             is ever chosen
--   GIso      isomorphisms of groups; gi-of-equiv (a bijective homomorphism),
--             gi-comp, gi-inv
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Lemma4[l] ; open DeloopMaps[l] ; open LoopCalc[l] ;
open Group[l] ; open SphereAxiom[l] ; open HomotopyClasses[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module QG = QGrp[l] ;

------------------------------------------------------------------------
-- homomorphisms and isomorphisms

ghom-set (H K : Grp) : isSet (QG.GHom H K) =
  isSet-Sigma (H.G -> K.G) (\ f -> (x y : H.G) -> Id K.G (f (H.mul x y)) (K.mul (f x) (f y)))
    (FL.isSet-Pi H.G (\ x -> K.G) (\ x -> K.setG))
    (\ f -> prop-to-set ((x y : H.G) -> Id K.G (f (H.mul x y)) (K.mul (f x) (f y)))
       (FL.isProp-Pi H.G (\ x -> (y : H.G) -> Id K.G (f (H.mul x y)) (K.mul (f x) (f y))) (\ x ->
          FL.isProp-Pi H.G (\ y -> Id K.G (f (H.mul x y)) (K.mul (f x) (f y))) (\ y -> K.setG (f (H.mul x y)) (K.mul (f x) (f y)))))) ;

record GIso (H K : Grp) {
  fun : QG.GHom H K ;
  inv : QG.GHom K H ;
  inv-fun (x : H.G) : Id H.G (inv.1 (fun.1 x)) x ;
  fun-inv (y : K.G) : Id K.G (fun.1 (inv.1 y)) y ;
} ;

-- a bijective homomorphism is an isomorphism: its inverse is multiplicative
module OfEquiv (H K : Grp) (f : QG.GHom H K) (e : isEquiv H.G K.G f.1) {
  inv-mult (x y : K.G) : Id H.G (e.sec (K.mul x y)) (H.mul (e.sec x) (e.sec y)) =
    Equivalences[l].injective H.G K.G f.1 e (e.sec (K.mul x y)) (H.mul (e.sec x) (e.sec y))
      (calc K.G {
         f.1 (e.sec (K.mul x y)) =< e.sec-eq (K.mul x y) > K.mul x y
           =< symH (transH (apH (\ u -> K.mul u (f.1 (e.sec y))) (e.sec-eq x)) (apH (K.mul x) (e.sec-eq y))) >
         K.mul (f.1 (e.sec x)) (f.1 (e.sec y))
           =< symH (f.2 (e.sec x) (e.sec y)) >
         f.1 (H.mul (e.sec x) (e.sec y)) }) ;
  iso : GIso[H, K] = new GIso[H, K, f, (e.sec, inv-mult), sec-ret H.G K.G f.1 e, e.sec-eq] ;
} ;
gi-of-equiv (H K : Grp) (f : QG.GHom H K) (e : isEquiv H.G K.G f.1) : GIso[H, K] = OfEquiv[H, K, f, e].iso ;

gi-comp (H K L : Grp) (a : GIso[H, K]) (b : GIso[K, L]) : GIso[H, L] =
  new GIso[H, L,
    (\ x -> b.fun.1 (a.fun.1 x), \ x y -> transH (apH b.fun.1 (a.fun.2 x y)) (b.fun.2 (a.fun.1 x) (a.fun.1 y))),
    (\ z -> a.inv.1 (b.inv.1 z), \ x y -> transH (apH a.inv.1 (b.inv.2 x y)) (a.inv.2 (b.inv.1 x) (b.inv.1 y))),
    \ x -> transH (apH a.inv.1 (b.inv-fun (a.fun.1 x))) (a.inv-fun x),
    \ z -> transH (apH b.fun.1 (a.fun-inv (b.inv.1 z))) (b.fun-inv z)] ;

gi-inv (H K : Grp) (a : GIso[H, K]) : GIso[K, H] = new GIso[K, H, a.inv, a.fun, a.fun-inv, a.inv-fun] ;

------------------------------------------------------------------------
-- pi_1 is a functor on pointed maps

ind-comp (Y : U l) (y0 : Y) (Z : U l) (z0 : Z) (W : U l) (w0 : W) (F : PtMap Y y0 Z z0) (G : PtMap Z z0 W w0)
  (x : PiOne[l].PiOne[Y, y0].grp.G) :
  Id PiOne[l].PiOne[W, w0].grp.G (PiOne[l].Induced[Y, y0, W, w0, ptcomp Y y0 Z z0 W w0 F G].map x)
    (PiOne[l].Induced[Z, z0, W, w0, G].map (PiOne[l].Induced[Y, y0, Z, z0, F].map x)) =
  PiOne[l].PiOne[Y, y0].P.ind @l
    (\ x1 -> Id PiOne[l].PiOne[W, w0].grp.G (PiOne[l].Induced[Y, y0, W, w0, ptcomp Y y0 Z z0 W w0 F G].map x1)
               (PiOne[l].Induced[Z, z0, W, w0, G].map (PiOne[l].Induced[Y, y0, Z, z0, F].map x1)))
    (\ x1 -> PiOne[l].PiOne[W, w0].grp.setG _ _)
    (\ q -> calc PiOne[l].PiOne[W, w0].grp.G {
       PiOne[l].Induced[Y, y0, W, w0, ptcomp Y y0 Z z0 W w0 F G].map (PiOne[l].PiOne[Y, y0].cls q)
         =< PiOne[l].Induced[Y, y0, W, w0, ptcomp Y y0 Z z0 W w0 F G].map-cls q >
       PiOne[l].PiOne[W, w0].cls ((Maps[Y, y0, W, w0].loop (ptcomp Y y0 Z z0 W w0 F G)).1 q)
         =< apH (\ M -> PiOne[l].PiOne[W, w0].cls (M.1 q)) (loop-comp Y y0 Z z0 W w0 F G) >
       PiOne[l].PiOne[W, w0].cls ((Maps[Z, z0, W, w0].loop G).1 ((Maps[Y, y0, Z, z0].loop F).1 q))
         =< symH (PiOne[l].Induced[Z, z0, W, w0, G].map-cls ((Maps[Y, y0, Z, z0].loop F).1 q)) >
       PiOne[l].Induced[Z, z0, W, w0, G].map (PiOne[l].PiOne[Z, z0].cls ((Maps[Y, y0, Z, z0].loop F).1 q))
         =< symH (apH (PiOne[l].Induced[Z, z0, W, w0, G].map) (PiOne[l].Induced[Y, y0, Z, z0, F].map-cls q)) >
       PiOne[l].Induced[Z, z0, W, w0, G].map (PiOne[l].Induced[Y, y0, Z, z0, F].map (PiOne[l].PiOne[Y, y0].cls q)) }) x ;

ind-id (Y : U l) (y0 : Y) (x : PiOne[l].PiOne[Y, y0].grp.G) :
  Id PiOne[l].PiOne[Y, y0].grp.G (PiOne[l].Induced[Y, y0, Y, y0, ptid Y y0].map x) x =
  PiOne[l].PiOne[Y, y0].P.ind @l
    (\ x1 -> Id PiOne[l].PiOne[Y, y0].grp.G (PiOne[l].Induced[Y, y0, Y, y0, ptid Y y0].map x1) x1)
    (\ x1 -> PiOne[l].PiOne[Y, y0].grp.setG _ _)
    (\ q -> transH (PiOne[l].Induced[Y, y0, Y, y0, ptid Y y0].map-cls q)
              (apH (PiOne[l].PiOne[Y, y0].cls) (Puppe[l].loop-id Y y0 q))) x ;

-- equal pointed maps induce equal maps
ind-eq (Y : U l) (y0 : Y) (Z : U l) (z0 : Z) (F F' : PtMap Y y0 Z z0) (e : Id (PtMap Y y0 Z z0) F F')
  (x : PiOne[l].PiOne[Y, y0].grp.G) :
  Id PiOne[l].PiOne[Z, z0].grp.G (PiOne[l].Induced[Y, y0, Z, z0, F].map x) (PiOne[l].Induced[Y, y0, Z, z0, F'].map x) =
  apH (\ M -> PiOne[l].Induced[Y, y0, Z, z0, M].map x) e ;

------------------------------------------------------------------------
-- pi3

pi3 (X : U l) (x0 : X) : Grp = PiOne[l].PiOne[O2 X x0, refl (refl x0)].grp ;

pi3-map (X : U l) (x0 : X) (Y : U l) (y0 : Y) (F : PtMap X x0 Y y0) : QG.GHom (pi3 X x0) (pi3 Y y0) =
  PiOne[l].Induced[O2 X x0, refl (refl x0), O2 Y y0, refl (refl y0), loop2 X x0 Y y0 F].hom ;

loop2-comp (X : U l) (x0 : X) (Y : U l) (y0 : Y) (Z : U l) (z0 : Z) (F : PtMap X x0 Y y0) (G : PtMap Y y0 Z z0) :
  Id (PtMap (O2 X x0) (refl (refl x0)) (O2 Z z0) (refl (refl z0))) (loop2 X x0 Z z0 (ptcomp X x0 Y y0 Z z0 F G))
    (ptcomp (O2 X x0) (refl (refl x0)) (O2 Y y0) (refl (refl y0)) (O2 Z z0) (refl (refl z0)) (loop2 X x0 Y y0 F) (loop2 Y y0 Z z0 G)) =
  transH (apH (Maps[Id X x0 x0, refl x0, Id Z z0 z0, refl z0].loop) (loop-comp X x0 Y y0 Z z0 F G))
    (loop-comp (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0) (Id Z z0 z0) (refl z0) (Maps[X, x0, Y, y0].loop F) (Maps[Y, y0, Z, z0].loop G)) ;

pi3-comp (X : U l) (x0 : X) (Y : U l) (y0 : Y) (Z : U l) (z0 : Z) (F : PtMap X x0 Y y0) (G : PtMap Y y0 Z z0) (x : (pi3 X x0).G) :
  Id (pi3 Z z0).G ((pi3-map X x0 Z z0 (ptcomp X x0 Y y0 Z z0 F G)).1 x) ((pi3-map Y y0 Z z0 G).1 ((pi3-map X x0 Y y0 F).1 x)) =
  transH (ind-eq (O2 X x0) (refl (refl x0)) (O2 Z z0) (refl (refl z0)) _ _ (loop2-comp X x0 Y y0 Z z0 F G) x)
    (ind-comp (O2 X x0) (refl (refl x0)) (O2 Y y0) (refl (refl y0)) (O2 Z z0) (refl (refl z0)) (loop2 X x0 Y y0 F) (loop2 Y y0 Z z0 G) x) ;

-- the double looping of the identity is the identity
loop-ptid (A : U l) (a0 : A) : Id (Maps[A, a0, A, a0].PMO) (Maps[A, a0, A, a0].loop (ptid A a0)) (ptid (Id A a0 a0) (refl a0)) =
  ptmap-path (Id A a0 a0) (refl a0) (Id A a0 a0) (refl a0) (Maps[A, a0, A, a0].loop (ptid A a0)).1 (\ q -> q)
    (Maps[A, a0, A, a0].loop (ptid A a0)).2 (refl (refl a0)) (Puppe[l].loop-id A a0) (refl (refl (refl a0))) ;

loop2-id (X : U l) (x0 : X) :
  Id (PtMap (O2 X x0) (refl (refl x0)) (O2 X x0) (refl (refl x0))) (loop2 X x0 X x0 (ptid X x0)) (ptid (O2 X x0) (refl (refl x0))) =
  transH (apH (Maps[Id X x0 x0, refl x0, Id X x0 x0, refl x0].loop) (loop-ptid X x0)) (loop-ptid (Id X x0 x0) (refl x0)) ;

pi3-id (X : U l) (x0 : X) (x : (pi3 X x0).G) : Id (pi3 X x0).G ((pi3-map X x0 X x0 (ptid X x0)).1 x) x =
  transH (ind-eq (O2 X x0) (refl (refl x0)) (O2 X x0) (refl (refl x0)) _ _ (loop2-id X x0) x)
    (ind-id (O2 X x0) (refl (refl x0)) x) ;

------------------------------------------------------------------------
-- pi3 on homotopy classes

module Pi3C (X : U l) (x0 : X) (Y : U l) (y0 : Y) {
  module L = STr[PtMap X x0 Y y0].Lift[QG.GHom (pi3 X x0) (pi3 Y y0), ghom-set (pi3 X x0) (pi3 Y y0), pi3-map X x0 Y y0] ;
  map (a : HC X x0 Y y0) : QG.GHom (pi3 X x0) (pi3 Y y0) = L.map a ;
  beta (F : PtMap X x0 Y y0) : Id (QG.GHom (pi3 X x0) (pi3 Y y0)) (map (hcl X x0 Y y0 F)) (pi3-map X x0 Y y0 F) = L.beta F ;
  beta-at (F : PtMap X x0 Y y0) (x : (pi3 X x0).G) : Id (pi3 Y y0).G ((map (hcl X x0 Y y0 F)).1 x) ((pi3-map X x0 Y y0 F).1 x) =
    apH (\ h -> h.1 x) (beta F) ;
} ;

pi3C (X : U l) (x0 : X) (Y : U l) (y0 : Y) (a : HC X x0 Y y0) : QG.GHom (pi3 X x0) (pi3 Y y0) = Pi3C[X, x0, Y, y0].map a ;
pi3C-beta-at (X : U l) (x0 : X) (Y : U l) (y0 : Y) (F : PtMap X x0 Y y0) (x : (pi3 X x0).G) :
  Id (pi3 Y y0).G ((pi3C X x0 Y y0 (hcl X x0 Y y0 F)).1 x) ((pi3-map X x0 Y y0 F).1 x) = Pi3C[X, x0, Y, y0].beta-at F x ;
-- locked after its characterising lemma pi3C-beta-at
opaque pi3C ;

pi3C-comp (X : U l) (x0 : X) (Y : U l) (y0 : Y) (Z : U l) (z0 : Z) (a : HC X x0 Y y0) (b : HC Y y0 Z z0) (x : (pi3 X x0).G) :
  Id (pi3 Z z0).G ((pi3C X x0 Z z0 (compC X x0 Y y0 Z z0 a b)).1 x) ((pi3C Y y0 Z z0 b).1 ((pi3C X x0 Y y0 a).1 x)) =
  STr[PtMap X x0 Y y0].ind @l
    (\ a1 -> Id (pi3 Z z0).G ((pi3C X x0 Z z0 (compC X x0 Y y0 Z z0 a1 b)).1 x) ((pi3C Y y0 Z z0 b).1 ((pi3C X x0 Y y0 a1).1 x)))
    (\ a1 -> (pi3 Z z0).setG _ _) (\ F ->
  STr[PtMap Y y0 Z z0].ind @l
    (\ b1 -> Id (pi3 Z z0).G ((pi3C X x0 Z z0 (compC X x0 Y y0 Z z0 (hcl X x0 Y y0 F) b1)).1 x) ((pi3C Y y0 Z z0 b1).1 ((pi3C X x0 Y y0 (hcl X x0 Y y0 F)).1 x)))
    (\ b1 -> (pi3 Z z0).setG _ _) (\ G -> calc (pi3 Z z0).G {
      (pi3C X x0 Z z0 (compC X x0 Y y0 Z z0 (hcl X x0 Y y0 F) (hcl Y y0 Z z0 G))).1 x
        =< apH (\ c -> (pi3C X x0 Z z0 c).1 x) (comp-beta X x0 Y y0 Z z0 F G) >
      (pi3C X x0 Z z0 (hcl X x0 Z z0 (ptcomp X x0 Y y0 Z z0 F G))).1 x
        =< pi3C-beta-at X x0 Z z0 (ptcomp X x0 Y y0 Z z0 F G) x >
      (pi3-map X x0 Z z0 (ptcomp X x0 Y y0 Z z0 F G)).1 x
        =< pi3-comp X x0 Y y0 Z z0 F G x >
      (pi3-map Y y0 Z z0 G).1 ((pi3-map X x0 Y y0 F).1 x)
        =< symH (transH (apH ((pi3C Y y0 Z z0 (hcl Y y0 Z z0 G)).1) (pi3C-beta-at X x0 Y y0 F x))
                        (pi3C-beta-at Y y0 Z z0 G ((pi3-map X x0 Y y0 F).1 x))) >
      (pi3C Y y0 Z z0 (hcl Y y0 Z z0 G)).1 ((pi3C X x0 Y y0 (hcl X x0 Y y0 F)).1 x) }) b) a ;

pi3C-id (X : U l) (x0 : X) (x : (pi3 X x0).G) : Id (pi3 X x0).G ((pi3C X x0 X x0 (idC X x0)).1 x) x =
  transH (pi3C-beta-at X x0 X x0 (ptid X x0) x) (pi3-id X x0 x) ;
