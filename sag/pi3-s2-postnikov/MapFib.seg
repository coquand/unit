-- The mapping theorem for targets Fib k (doc/mapping-fib.pdf), for
-- P = Fib kappa with any kappa satisfying (H4).
--   fib-fst          Lemma 6: the fibre of a first projection is the family
--   cancel-snd       a . refl is a; if a^-1 . h = refl then a = h
--   LevW             Omega W, Omega^2 W, Omega^3 W connected (W = K(B,4))
--   Lifting          section 2, for a source Q and a triple (A, B, k):
--     Ex, Un         hypotheses (E), (U); u0 Lemma 4; uniq0 Lemma 3;
--     uniq           Lemma 5; Main.surj, inj, equiv Theorem 1: q_* bijective
--   SourceP          section 3: cp (fibres of p 2-connected), PStar (Lemma 7:
--                    p^* bijective on classes into K(A,2), G_F = ext-pt F),
--                    fseq (Lemma 8), ex-P, un-P (Props 9, 10), qP (Cor. 11)
--   pre-pteq         Lemma 15: precomposition by a pointed equivalence
--   SourceS          section 4: s2-paths (Lemma 12), ex-S, un-S, qS (Cor. 13);
--                    loop-equiv (Lemma 14); gen-c, sigma (Def. 16); Psi,
--                    sigma-nat, sigma-star (Prop. 17), sigma-cls
--   cancel-r         2-out-of-3 on the right
--   Final            section 5: s, s-eq (Def. 19), right (Prop. 20),
--                    rep-fib (Theorem 21), rep-pteq (Cor. 22)
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ; open HLevels[l] ; open Connected[l] ;
open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ; open LoopCalc[l] ; open Torsor[l] ;
open EMMaps[l] ; open HomotopyClasses[l] ; open SphereAxiom[l] ; open SphereUniversal[l] ; open PostnikovRealization[l] ; open KZ2Cohomology[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module E = Equivalences[l] ; module W = Whitehead[l] ; module Fb = Fibres[l] ; module Bj = Bijection[l] ;
module CS = CupSquare[l] ; module CP = CircleProperty[l] ; module FH = FibreH3[l] ;

------------------------------------------------------------------------
-- generic lemmas

-- Lemma 6
fib-fst-ret (A : U l) (B : A -> U l) (a' : A) (b : B a') (a : A) (pi : Id A a' a) :
  Id (W.fib ((x : A) * B x) A (\ w -> w.1) a) ((a, subst A B a' a pi b), refl a) ((a', b), pi) =
  idJ A a' (\ a1 pi1 -> Id (W.fib ((x : A) * B x) A (\ w -> w.1) a1) ((a1, subst A B a' a1 pi1 b), refl a1) ((a', b), pi1))
    (refl ((a', b), refl a')) a pi ;
fib-fst (A : U l) (B : A -> U l) (a : A) : Equiv (W.fib ((x : A) * B x) A (\ w -> w.1) a) (B a) =
  (\ v -> subst A B v.1.1 a v.2 v.1.2,
   qinv (W.fib ((x : A) * B x) A (\ w -> w.1) a) (B a) (\ v -> subst A B v.1.1 a v.2 v.1.2) (\ b -> ((a, b), refl a))
     (\ b -> refl b) (\ v -> fib-fst-ret A B v.1.1 v.1.2 a v.2)) ;

-- if a^-1 . h = refl then a = h (a . refl is a)
cancel-snd (Y : U l) (y y0 : Y) (a h : Id Y y y0) (z : Id (Id Y y0 y0) (refl y0) (trans Y y0 y y0 (sym Y y y0 a) h)) : Id (Id Y y y0) a h =
  transH (apH (trans Y y y0 y0 a) z) (Fb.trans-cancel' Y y y0 y0 a h) ;

-- 2-out-of-3: if g o f and f are equivalences, so is g
cancel-r (X Y Z : U l) (f : X -> Y) (g : Y -> Z) (ef : isEquiv X Y f) (egf : isEquiv X Z (\ x -> g (f x))) : isEquiv Y Z g =
  E.homotopy Y Z (E.compose Y X Z (ef.sec, W.inv-equiv X Y f ef) ((\ x -> g (f x)), egf)) g
    (\ y -> apH g (symH (ef.sec-eq y))) ;

-- levels of W = K(B,4)
module LevW (Gb : Ab) {
  cOW : isConn two (Id (KK[Gb].K four) (KK[Gb].pt four) (KK[Gb].pt four)) =
    conn-down two (Id (KK[Gb].K four) (KK[Gb].pt four) (KK[Gb].pt four)) (conn-down three (Id (KK[Gb].K four) (KK[Gb].pt four) (KK[Gb].pt four))
      (conn-id four (KK[Gb].K four) (KK[Gb].conn three) (KK[Gb].pt four) (KK[Gb].pt four))) ;
  cOOW : isConn two (O2 (KK[Gb].K four) (KK[Gb].pt four)) =
    conn-down two (O2 (KK[Gb].K four) (KK[Gb].pt four))
      (conn-id three (Id (KK[Gb].K four) (KK[Gb].pt four) (KK[Gb].pt four)) (conn-id four (KK[Gb].K four) (KK[Gb].conn three) (KK[Gb].pt four) (KK[Gb].pt four))
         (refl (KK[Gb].pt four)) (refl (KK[Gb].pt four))) ;
  cOOOW : isConn two (O2 (Id (KK[Gb].K four) (KK[Gb].pt four) (KK[Gb].pt four)) (refl (KK[Gb].pt four))) =
    conn-id two (O2 (KK[Gb].K four) (KK[Gb].pt four))
      (conn-id three (Id (KK[Gb].K four) (KK[Gb].pt four) (KK[Gb].pt four)) (conn-id four (KK[Gb].K four) (KK[Gb].conn three) (KK[Gb].pt four) (KK[Gb].pt four))
         (refl (KK[Gb].pt four)) (refl (KK[Gb].pt four)))
      (refl (refl (KK[Gb].pt four))) (refl (refl (KK[Gb].pt four))) ;
} ;

------------------------------------------------------------------------
-- section 2: the lifting lemma

module Lifting (Q : U l) (q0 : Q) (Ga Gb : Ab) (k : PtMap (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four)) {
  module R = Triple[Ga, Gb, k] ;
  module LW = LevW[Gb] ;
  -- (E) and (U)
  Ex : U l = (F : PtMap Q q0 (KK[Ga].K two) (KK[Ga].pt two)) ->
    Tr.Trunc[Id (PtMap Q q0 (KK[Gb].K four) (KK[Gb].pt four)) (ptcomp Q q0 (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four) F k)
      (ptconst Q q0 (KK[Gb].K four) (KK[Gb].pt four))].carrier ;
  Un : U l = (d : PtMap Q q0 (Id (KK[Gb].K four) (KK[Gb].pt four) (KK[Gb].pt four)) (refl (KK[Gb].pt four))) ->
    Tr.Trunc[Id (PtMap Q q0 (Id (KK[Gb].K four) (KK[Gb].pt four) (KK[Gb].pt four)) (refl (KK[Gb].pt four)))
      (ptconst Q q0 (Id (KK[Gb].K four) (KK[Gb].pt four) (KK[Gb].pt four)) (refl (KK[Gb].pt four))) d].carrier ;
  -- (U0)
  U0 : U l = (d : Q -> Id (KK[Gb].K four) (KK[Gb].pt four) (KK[Gb].pt four)) ->
    Tr.Trunc[Id (Q -> Id (KK[Gb].K four) (KK[Gb].pt four) (KK[Gb].pt four)) (\ x -> refl (KK[Gb].pt four)) d].carrier ;
  -- q_* = - ; [q]
  qs (c : HC Q q0 R.F R.f0) : HC Q q0 (KK[Ga].K two) (KK[Ga].pt two) =
    compC Q q0 R.F R.f0 (KK[Ga].K two) (KK[Ga].pt two) c
      (hcl R.F R.f0 (KK[Ga].K two) (KK[Ga].pt two) (Fb.fpr (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four) k)) ;
  -- Omega X is connected
  cOF : isConn two (Id R.F R.f0 R.f0) = conn-id two R.F R.conn3 R.f0 R.f0 ;

  -- Lemma 4
  u0 (un : Un) : U0 = \ d ->
    TC.bind (Id (Id (KK[Gb].K four) (KK[Gb].pt four) (KK[Gb].pt four)) (d q0) (refl (KK[Gb].pt four)))
      (Id (Q -> Id (KK[Gb].K four) (KK[Gb].pt four) (KK[Gb].pt four)) (\ x -> refl (KK[Gb].pt four)) d)
      (\ r -> TC.map (Id (PtMap Q q0 (Id (KK[Gb].K four) (KK[Gb].pt four) (KK[Gb].pt four)) (refl (KK[Gb].pt four)))
                        (ptconst Q q0 (Id (KK[Gb].K four) (KK[Gb].pt four) (KK[Gb].pt four)) (refl (KK[Gb].pt four))) (d, r))
                (Id (Q -> Id (KK[Gb].K four) (KK[Gb].pt four) (KK[Gb].pt four)) (\ x -> refl (KK[Gb].pt four)) d)
                (\ e -> apH (\ M -> M.1) e) (un (d, r)))
      (conn-path zero (Id (KK[Gb].K four) (KK[Gb].pt four) (KK[Gb].pt four)) LW.cOW (d q0) (refl (KK[Gb].pt four))) ;

  -- Lemma 3
  uniq0 (v : U0) (u : Q -> R.F) (g' : Q -> KK[Ga].K two) (e : Id (Q -> KK[Ga].K two) (\ x -> (u x).1) g')
    (h' : (x : Q) -> Id (KK[Gb].K four) (k.1 (g' x)) (KK[Gb].pt four)) :
    Tr.Trunc[Id (Q -> R.F) u (\ x -> (g' x, h' x))].carrier =
    idJ (Q -> KK[Ga].K two) (\ x -> (u x).1)
      (\ g1 e1 -> (h1 : (x : Q) -> Id (KK[Gb].K four) (k.1 (g1 x)) (KK[Gb].pt four)) -> Tr.Trunc[Id (Q -> R.F) u (\ x -> (g1 x, h1 x))].carrier)
      (\ h1 -> TC.map (Id (Q -> Id (KK[Gb].K four) (KK[Gb].pt four) (KK[Gb].pt four)) (\ x -> refl (KK[Gb].pt four))
                         (\ x -> trans (KK[Gb].K four) (KK[Gb].pt four) (k.1 (u x).1) (KK[Gb].pt four) (sym (KK[Gb].K four) (k.1 (u x).1) (KK[Gb].pt four) (u x).2) (h1 x)))
                 (Id (Q -> R.F) u (\ x -> ((u x).1, h1 x)))
                 (\ z -> FL.funext Q (\ x -> R.F) u (\ x -> ((u x).1, h1 x)) (\ x ->
                    apH (\ w -> ((u x).1, w))
                      (cancel-snd (KK[Gb].K four) (k.1 (u x).1) (KK[Gb].pt four) (u x).2 (h1 x)
                         (happly Q (\ x1 -> Id (KK[Gb].K four) (KK[Gb].pt four) (KK[Gb].pt four)) (\ x1 -> refl (KK[Gb].pt four))
                            (\ x1 -> trans (KK[Gb].K four) (KK[Gb].pt four) (k.1 (u x1).1) (KK[Gb].pt four) (sym (KK[Gb].K four) (k.1 (u x1).1) (KK[Gb].pt four) (u x1).2) (h1 x1))
                            z x))))
                 (v (\ x -> trans (KK[Gb].K four) (KK[Gb].pt four) (k.1 (u x).1) (KK[Gb].pt four) (sym (KK[Gb].K four) (k.1 (u x).1) (KK[Gb].pt four) (u x).2) (h1 x))))
      g' e h' ;

  -- Lemma 5
  uniq (un : Un) (L L' : PtMap Q q0 R.F R.f0)
    (e : Id (PtMap Q q0 (KK[Ga].K two) (KK[Ga].pt two))
       (ptcomp Q q0 R.F R.f0 (KK[Ga].K two) (KK[Ga].pt two) L (Fb.fpr (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four) k))
       (ptcomp Q q0 R.F R.f0 (KK[Ga].K two) (KK[Ga].pt two) L' (Fb.fpr (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four) k))) :
    Tr.Trunc[Id (PtMap Q q0 R.F R.f0) L L'].carrier =
    TC.bind (Id (Q -> R.F) L.1 (\ x -> ((L'.1 x).1, (L'.1 x).2))) (Id (PtMap Q q0 R.F R.f0) L L')
      (\ e1 -> FH.pi-mere Q q0 R.F R.f0 cOF L.1 L'.1 e1 L.2 L'.2)
      (uniq0 (u0 un) L.1 (\ x -> (L'.1 x).1) (apH (\ M -> M.1) e) (\ x -> (L'.1 x).2)) ;

  -- Theorem 1
  module Main (ex : Ex) (un : Un) {
    surj (b : HC Q q0 (KK[Ga].K two) (KK[Ga].pt two)) : Tr.Trunc[Bj.Fibre qs b].carrier =
      STr[PtMap Q q0 (KK[Ga].K two) (KK[Ga].pt two)].ind @l (\ b1 -> Tr.Trunc[Bj.Fibre qs b1].carrier) (\ b1 -> Tr.Trunc[Bj.Fibre qs b1].proposition)
        (\ F -> TC.map (Id (PtMap Q q0 (KK[Gb].K four) (KK[Gb].pt four)) (ptcomp Q q0 (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four) F k)
                          (ptconst Q q0 (KK[Gb].K four) (KK[Gb].pt four)))
                  (Bj.Fibre qs (hcl Q q0 (KK[Ga].K two) (KK[Ga].pt two) F))
                  (\ th -> (hcl Q q0 R.F R.f0 Fb.Lift[Q, q0, KK[Ga].K two, KK[Ga].pt two, KK[Gb].K four, KK[Gb].pt four, k, F, th].lift,
                            transH (comp-beta Q q0 R.F R.f0 (KK[Ga].K two) (KK[Ga].pt two) Fb.Lift[Q, q0, KK[Ga].K two, KK[Ga].pt two, KK[Gb].K four, KK[Gb].pt four, k, F, th].lift
                                      (Fb.fpr (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four) k))
                              (apH (hcl Q q0 (KK[Ga].K two) (KK[Ga].pt two)) Fb.Lift[Q, q0, KK[Ga].K two, KK[Ga].pt two, KK[Gb].K four, KK[Gb].pt four, k, F, th].lift-fst)))
                  (ex F)) b ;
    inj-at (L L' : PtMap Q q0 R.F R.f0) (h : Id (HC Q q0 (KK[Ga].K two) (KK[Ga].pt two)) (qs (hcl Q q0 R.F R.f0 L)) (qs (hcl Q q0 R.F R.f0 L'))) :
      Id (HC Q q0 R.F R.f0) (hcl Q q0 R.F R.f0 L) (hcl Q q0 R.F R.f0 L') =
      STr[PtMap Q q0 R.F R.f0].Q.relates L L'
        (TC.bind (Id (PtMap Q q0 (KK[Ga].K two) (KK[Ga].pt two))
                    (ptcomp Q q0 R.F R.f0 (KK[Ga].K two) (KK[Ga].pt two) L (Fb.fpr (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four) k))
                    (ptcomp Q q0 R.F R.f0 (KK[Ga].K two) (KK[Ga].pt two) L' (Fb.fpr (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four) k)))
           (Id (PtMap Q q0 R.F R.f0) L L') (uniq un L L')
           (STr[PtMap Q q0 (KK[Ga].K two) (KK[Ga].pt two)].effective
              (ptcomp Q q0 R.F R.f0 (KK[Ga].K two) (KK[Ga].pt two) L (Fb.fpr (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four) k))
              (ptcomp Q q0 R.F R.f0 (KK[Ga].K two) (KK[Ga].pt two) L' (Fb.fpr (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four) k))
              (transH (symH (comp-beta Q q0 R.F R.f0 (KK[Ga].K two) (KK[Ga].pt two) L (Fb.fpr (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four) k)))
                 (transH h (comp-beta Q q0 R.F R.f0 (KK[Ga].K two) (KK[Ga].pt two) L' (Fb.fpr (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four) k)))))) ;
    inj (c c' : HC Q q0 R.F R.f0) (h : Id (HC Q q0 (KK[Ga].K two) (KK[Ga].pt two)) (qs c) (qs c')) : Id (HC Q q0 R.F R.f0) c c' =
      STr[PtMap Q q0 R.F R.f0].ind @l
        (\ c1 -> (c2 : HC Q q0 R.F R.f0) -> Id (HC Q q0 (KK[Ga].K two) (KK[Ga].pt two)) (qs c1) (qs c2) -> Id (HC Q q0 R.F R.f0) c1 c2)
        (\ c1 -> FL.isProp-Pi (HC Q q0 R.F R.f0) (\ c2 -> Id (HC Q q0 (KK[Ga].K two) (KK[Ga].pt two)) (qs c1) (qs c2) -> Id (HC Q q0 R.F R.f0) c1 c2)
           (\ c2 -> FL.isProp-Pi (Id (HC Q q0 (KK[Ga].K two) (KK[Ga].pt two)) (qs c1) (qs c2)) (\ h1 -> Id (HC Q q0 R.F R.f0) c1 c2)
              (\ h1 -> hc-set Q q0 R.F R.f0 c1 c2)))
        (\ L c2 -> STr[PtMap Q q0 R.F R.f0].ind @l
           (\ c3 -> Id (HC Q q0 (KK[Ga].K two) (KK[Ga].pt two)) (qs (hcl Q q0 R.F R.f0 L)) (qs c3) -> Id (HC Q q0 R.F R.f0) (hcl Q q0 R.F R.f0 L) c3)
           (\ c3 -> FL.isProp-Pi (Id (HC Q q0 (KK[Ga].K two) (KK[Ga].pt two)) (qs (hcl Q q0 R.F R.f0 L)) (qs c3)) (\ h1 -> Id (HC Q q0 R.F R.f0) (hcl Q q0 R.F R.f0 L) c3)
              (\ h1 -> hc-set Q q0 R.F R.f0 (hcl Q q0 R.F R.f0 L) c3))
           (\ L' -> inj-at L L') c2)
        c c' h ;
    equiv : isEquiv (HC Q q0 R.F R.f0) (HC Q q0 (KK[Ga].K two) (KK[Ga].pt two)) qs =
      Bj.Bij[HC Q q0 R.F R.f0, HC Q q0 (KK[Ga].K two) (KK[Ga].pt two), hc-set Q q0 (KK[Ga].K two) (KK[Ga].pt two), qs, inj, surj].equiv ;
  } ;
} ;

------------------------------------------------------------------------
-- section 3: the source P

module SourceP (kappa : PtMap KZ2 kz2 KZ4 kz4) (h4k : H4 kappa) {
  module RP = Triple[Zab, Zab, kappa] ;
  -- Lemma 6: the fibres of p are 2-connected
  cp (x : KZ2) : isConn four (W.fib RP.F KZ2 (\ w -> w.1) x) =
    Deloop[l].equiv-conn four (W.fib RP.F KZ2 (\ w -> w.1) x) (Id KZ4 (kappa.1 x) kz4)
      (fib-fst KZ2 (\ x1 -> Id KZ4 (kappa.1 x1) kz4) x) (conn-id four KZ4 (KK[Zab].conn three) (kappa.1 x) kz4) ;

  -- Lemma 7
  module PStar (Ga : Ab) {
    module EA = ConnectedMaps[l].Elim[four, RP.F, KZ2, \ w -> w.1, cp, \ x -> KK[Ga].K two, \ x -> KK[Ga].trunc (suc zero)] ;
    cOA : isConn two (Id (KK[Ga].K two) (KK[Ga].pt two) (KK[Ga].pt two)) = conn-id two (KK[Ga].K two) (KK[Ga].conn (suc zero)) (KK[Ga].pt two) (KK[Ga].pt two) ;
    -- G_F
    ext-pt (F : PtMap RP.F RP.f0 (KK[Ga].K two) (KK[Ga].pt two)) : PtMap KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) =
      (EA.ext F.1, transH (EA.ext-beta F.1 RP.f0) F.2) ;
    ext-eq (F : PtMap RP.F RP.f0 (KK[Ga].K two) (KK[Ga].pt two)) :
      Tr.Trunc[Id (PtMap RP.F RP.f0 (KK[Ga].K two) (KK[Ga].pt two)) (ptcomp RP.F RP.f0 KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) (Fb.fpr KZ2 kz2 KZ4 kz4 kappa) (ext-pt F)) F].carrier =
      FH.pi-mere RP.F RP.f0 (KK[Ga].K two) (KK[Ga].pt two) cOA (\ w -> EA.ext F.1 w.1) F.1
        (FL.funext RP.F (\ w -> KK[Ga].K two) (\ w -> EA.ext F.1 w.1) F.1 (EA.ext-beta F.1))
        (ptcomp RP.F RP.f0 KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) (Fb.fpr KZ2 kz2 KZ4 kz4 kappa) (ext-pt F)).2 F.2 ;
    pstar (c : HC KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two)) : HC RP.F RP.f0 (KK[Ga].K two) (KK[Ga].pt two) =
      compC RP.F RP.f0 KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) (hcl RP.F RP.f0 KZ2 kz2 (Fb.fpr KZ2 kz2 KZ4 kz4 kappa)) c ;
    surj (b : HC RP.F RP.f0 (KK[Ga].K two) (KK[Ga].pt two)) : Tr.Trunc[Bj.Fibre pstar b].carrier =
      STr[PtMap RP.F RP.f0 (KK[Ga].K two) (KK[Ga].pt two)].ind @l (\ b1 -> Tr.Trunc[Bj.Fibre pstar b1].carrier) (\ b1 -> Tr.Trunc[Bj.Fibre pstar b1].proposition)
        (\ F -> TC.map (Id (PtMap RP.F RP.f0 (KK[Ga].K two) (KK[Ga].pt two)) (ptcomp RP.F RP.f0 KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) (Fb.fpr KZ2 kz2 KZ4 kz4 kappa) (ext-pt F)) F)
                  (Bj.Fibre pstar (hcl RP.F RP.f0 (KK[Ga].K two) (KK[Ga].pt two) F))
                  (\ e -> (hcl KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) (ext-pt F),
                           transH (comp-beta RP.F RP.f0 KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) (Fb.fpr KZ2 kz2 KZ4 kz4 kappa) (ext-pt F))
                             (apH (hcl RP.F RP.f0 (KK[Ga].K two) (KK[Ga].pt two)) e)))
                  (ext-eq F)) b ;
    inj-at (G G' : PtMap KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two))
      (h : Id (HC RP.F RP.f0 (KK[Ga].K two) (KK[Ga].pt two)) (pstar (hcl KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) G)) (pstar (hcl KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) G'))) :
      Id (HC KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two)) (hcl KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) G) (hcl KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) G') =
      STr[PtMap KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two)].Q.relates G G'
        (TC.bind (Id (PtMap RP.F RP.f0 (KK[Ga].K two) (KK[Ga].pt two))
                    (ptcomp RP.F RP.f0 KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) (Fb.fpr KZ2 kz2 KZ4 kz4 kappa) G)
                    (ptcomp RP.F RP.f0 KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) (Fb.fpr KZ2 kz2 KZ4 kz4 kappa) G'))
           (Id (PtMap KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two)) G G')
           (\ e -> FH.pi-mere KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) cOA G.1 G'.1
                     (EA.unique G.1 G'.1 (\ w -> happly RP.F (\ w1 -> KK[Ga].K two) (\ w1 -> G.1 w1.1) (\ w1 -> G'.1 w1.1) (apH (\ M -> M.1) e) w))
                     G.2 G'.2)
           (STr[PtMap RP.F RP.f0 (KK[Ga].K two) (KK[Ga].pt two)].effective
              (ptcomp RP.F RP.f0 KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) (Fb.fpr KZ2 kz2 KZ4 kz4 kappa) G)
              (ptcomp RP.F RP.f0 KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) (Fb.fpr KZ2 kz2 KZ4 kz4 kappa) G')
              (transH (symH (comp-beta RP.F RP.f0 KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) (Fb.fpr KZ2 kz2 KZ4 kz4 kappa) G))
                 (transH h (comp-beta RP.F RP.f0 KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) (Fb.fpr KZ2 kz2 KZ4 kz4 kappa) G'))))) ;
    inj (c c' : HC KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two)) (h : Id (HC RP.F RP.f0 (KK[Ga].K two) (KK[Ga].pt two)) (pstar c) (pstar c')) :
      Id (HC KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two)) c c' =
      STr[PtMap KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two)].ind @l
        (\ c1 -> (c2 : HC KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two)) -> Id (HC RP.F RP.f0 (KK[Ga].K two) (KK[Ga].pt two)) (pstar c1) (pstar c2) -> Id (HC KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two)) c1 c2)
        (\ c1 -> FL.isProp-Pi (HC KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two)) (\ c2 -> Id (HC RP.F RP.f0 (KK[Ga].K two) (KK[Ga].pt two)) (pstar c1) (pstar c2) -> Id (HC KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two)) c1 c2)
           (\ c2 -> FL.isProp-Pi (Id (HC RP.F RP.f0 (KK[Ga].K two) (KK[Ga].pt two)) (pstar c1) (pstar c2)) (\ h1 -> Id (HC KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two)) c1 c2)
              (\ h1 -> hc-set KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) c1 c2)))
        (\ G c2 -> STr[PtMap KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two)].ind @l
           (\ c3 -> Id (HC RP.F RP.f0 (KK[Ga].K two) (KK[Ga].pt two)) (pstar (hcl KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) G)) (pstar c3) -> Id (HC KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two)) (hcl KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) G) c3)
           (\ c3 -> FL.isProp-Pi (Id (HC RP.F RP.f0 (KK[Ga].K two) (KK[Ga].pt two)) (pstar (hcl KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) G)) (pstar c3))
                      (\ h1 -> Id (HC KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two)) (hcl KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) G) c3)
              (\ h1 -> hc-set KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) (hcl KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) G) c3))
           (\ G' -> inj-at G G') c2)
        c c' h ;
    equiv : isEquiv (HC KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two)) (HC RP.F RP.f0 (KK[Ga].K two) (KK[Ga].pt two)) pstar =
      Bj.Bij[HC KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two), HC RP.F RP.f0 (KK[Ga].K two) (KK[Ga].pt two), hc-set RP.F RP.f0 (KK[Ga].K two) (KK[Ga].pt two), pstar, inj, surj].equiv ;
  } ;

  -- Lemma 8: p ; kappa is merely 0
  cOK4 : isConn two (Id KZ4 kz4 kz4) =
    conn-down two (Id KZ4 kz4 kz4) (conn-down three (Id KZ4 kz4 kz4) (conn-id four KZ4 (KK[Zab].conn three) kz4 kz4)) ;
  fseq : Tr.Trunc[Id (PtMap RP.F RP.f0 KZ4 kz4) (ptcomp RP.F RP.f0 KZ2 kz2 KZ4 kz4 (Fb.fpr KZ2 kz2 KZ4 kz4 kappa) kappa) (ptconst RP.F RP.f0 KZ4 kz4)].carrier =
    FH.pi-mere RP.F RP.f0 KZ4 kz4 cOK4 (\ w -> kappa.1 w.1) (\ w -> kz4)
      (FL.funext RP.F (\ w -> KZ4) (\ w -> kappa.1 w.1) (\ w -> kz4) (\ w -> w.2))
      (ptcomp RP.F RP.f0 KZ2 kz2 KZ4 kz4 (Fb.fpr KZ2 kz2 KZ4 kz4 kappa) kappa).2 (refl kz4) ;

  -- Proposition 9: (E) for P
  module ExP (Ga Gb : Ab) (k : PtMap (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four))
    (F : PtMap RP.F RP.f0 (KK[Ga].K two) (KK[Ga].pt two)) {
    module PS = PStar[Ga] ;
    g : Hom Zab Gb = (h4k Gb).sec (hcl KZ2 kz2 (KK[Gb].K four) (KK[Gb].pt four) (ptcomp KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four) (PS.ext-pt F) k)) ;
    g-eq : Tr.Trunc[Id (PtMap KZ2 kz2 (KK[Gb].K four) (KK[Gb].pt four)) (ptcomp KZ2 kz2 KZ4 kz4 (KK[Gb].K four) (KK[Gb].pt four) kappa (KMap[Zab, Gb, g].K four))
        (ptcomp KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four) (PS.ext-pt F) k)].carrier =
      STr[PtMap KZ2 kz2 (KK[Gb].K four) (KK[Gb].pt four)].effective
        (ptcomp KZ2 kz2 KZ4 kz4 (KK[Gb].K four) (KK[Gb].pt four) kappa (KMap[Zab, Gb, g].K four))
        (ptcomp KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four) (PS.ext-pt F) k)
        ((h4k Gb).sec-eq (hcl KZ2 kz2 (KK[Gb].K four) (KK[Gb].pt four) (ptcomp KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four) (PS.ext-pt F) k))) ;
    chain (e1 : Id (PtMap RP.F RP.f0 (KK[Ga].K two) (KK[Ga].pt two)) (ptcomp RP.F RP.f0 KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) (Fb.fpr KZ2 kz2 KZ4 kz4 kappa) (PS.ext-pt F)) F)
      (e2 : Id (PtMap KZ2 kz2 (KK[Gb].K four) (KK[Gb].pt four)) (ptcomp KZ2 kz2 KZ4 kz4 (KK[Gb].K four) (KK[Gb].pt four) kappa (KMap[Zab, Gb, g].K four))
        (ptcomp KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four) (PS.ext-pt F) k))
      (e3 : Id (PtMap RP.F RP.f0 KZ4 kz4) (ptcomp RP.F RP.f0 KZ2 kz2 KZ4 kz4 (Fb.fpr KZ2 kz2 KZ4 kz4 kappa) kappa) (ptconst RP.F RP.f0 KZ4 kz4)) :
      Id (PtMap RP.F RP.f0 (KK[Gb].K four) (KK[Gb].pt four)) (ptcomp RP.F RP.f0 (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four) F k)
        (ptconst RP.F RP.f0 (KK[Gb].K four) (KK[Gb].pt four)) =
      calc (PtMap RP.F RP.f0 (KK[Gb].K four) (KK[Gb].pt four)) {
        ptcomp RP.F RP.f0 (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four) F k
          =< apH (\ M -> ptcomp RP.F RP.f0 (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four) M k) (symH e1) >
        ptcomp RP.F RP.f0 (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four)
          (ptcomp RP.F RP.f0 KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) (Fb.fpr KZ2 kz2 KZ4 kz4 kappa) (PS.ext-pt F)) k
          =< ptcomp-assoc RP.F RP.f0 KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four) (Fb.fpr KZ2 kz2 KZ4 kz4 kappa) (PS.ext-pt F) k >
        ptcomp RP.F RP.f0 KZ2 kz2 (KK[Gb].K four) (KK[Gb].pt four) (Fb.fpr KZ2 kz2 KZ4 kz4 kappa)
          (ptcomp KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four) (PS.ext-pt F) k)
          =< apH (ptcomp RP.F RP.f0 KZ2 kz2 (KK[Gb].K four) (KK[Gb].pt four) (Fb.fpr KZ2 kz2 KZ4 kz4 kappa)) (symH e2) >
        ptcomp RP.F RP.f0 KZ2 kz2 (KK[Gb].K four) (KK[Gb].pt four) (Fb.fpr KZ2 kz2 KZ4 kz4 kappa)
          (ptcomp KZ2 kz2 KZ4 kz4 (KK[Gb].K four) (KK[Gb].pt four) kappa (KMap[Zab, Gb, g].K four))
          =< symH (ptcomp-assoc RP.F RP.f0 KZ2 kz2 KZ4 kz4 (KK[Gb].K four) (KK[Gb].pt four) (Fb.fpr KZ2 kz2 KZ4 kz4 kappa) kappa (KMap[Zab, Gb, g].K four)) >
        ptcomp RP.F RP.f0 KZ4 kz4 (KK[Gb].K four) (KK[Gb].pt four) (ptcomp RP.F RP.f0 KZ2 kz2 KZ4 kz4 (Fb.fpr KZ2 kz2 KZ4 kz4 kappa) kappa) (KMap[Zab, Gb, g].K four)
          =< apH (\ M -> ptcomp RP.F RP.f0 KZ4 kz4 (KK[Gb].K four) (KK[Gb].pt four) M (KMap[Zab, Gb, g].K four)) e3 >
        ptcomp RP.F RP.f0 KZ4 kz4 (KK[Gb].K four) (KK[Gb].pt four) (ptconst RP.F RP.f0 KZ4 kz4) (KMap[Zab, Gb, g].K four)
          =< comp-const-l RP.F RP.f0 KZ4 kz4 (KK[Gb].K four) (KK[Gb].pt four) (KMap[Zab, Gb, g].K four) >
        ptconst RP.F RP.f0 (KK[Gb].K four) (KK[Gb].pt four) } ;
    null : Tr.Trunc[Id (PtMap RP.F RP.f0 (KK[Gb].K four) (KK[Gb].pt four)) (ptcomp RP.F RP.f0 (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four) F k)
        (ptconst RP.F RP.f0 (KK[Gb].K four) (KK[Gb].pt four))].carrier =
      TC.bind (Id (PtMap RP.F RP.f0 (KK[Ga].K two) (KK[Ga].pt two)) (ptcomp RP.F RP.f0 KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) (Fb.fpr KZ2 kz2 KZ4 kz4 kappa) (PS.ext-pt F)) F)
        (Id (PtMap RP.F RP.f0 (KK[Gb].K four) (KK[Gb].pt four)) (ptcomp RP.F RP.f0 (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four) F k)
          (ptconst RP.F RP.f0 (KK[Gb].K four) (KK[Gb].pt four)))
        (\ e1 -> TC.map2 (Id (PtMap KZ2 kz2 (KK[Gb].K four) (KK[Gb].pt four)) (ptcomp KZ2 kz2 KZ4 kz4 (KK[Gb].K four) (KK[Gb].pt four) kappa (KMap[Zab, Gb, g].K four))
                            (ptcomp KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four) (PS.ext-pt F) k))
                   (Id (PtMap RP.F RP.f0 KZ4 kz4) (ptcomp RP.F RP.f0 KZ2 kz2 KZ4 kz4 (Fb.fpr KZ2 kz2 KZ4 kz4 kappa) kappa) (ptconst RP.F RP.f0 KZ4 kz4))
                   (Id (PtMap RP.F RP.f0 (KK[Gb].K four) (KK[Gb].pt four)) (ptcomp RP.F RP.f0 (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four) F k)
                     (ptconst RP.F RP.f0 (KK[Gb].K four) (KK[Gb].pt four)))
                   (chain e1) g-eq fseq)
        (PS.ext-eq F) ;
  } ;
  ex-P (Ga Gb : Ab) (k : PtMap (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four)) : Lifting[RP.F, RP.f0, Ga, Gb, k].Ex =
    \ F -> ExP[Ga, Gb, k, F].null ;

    un-P (Ga Gb : Ab) (k : PtMap (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four)) : Lifting[RP.F, RP.f0, Ga, Gb, k].Un =
    \ d -> FH.FibAt[kappa, h4k, Gb].merely-zero d ;

  -- Corollary 11
  qP (Ga Gb : Ab) (k : PtMap (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four)) :
    isEquiv (HC RP.F RP.f0 Triple[Ga, Gb, k].F Triple[Ga, Gb, k].f0) (HC RP.F RP.f0 (KK[Ga].K two) (KK[Ga].pt two)) Lifting[RP.F, RP.f0, Ga, Gb, k].qs =
    Lifting[RP.F, RP.f0, Ga, Gb, k].Main[ex-P Ga Gb k, un-P Ga Gb k].equiv ;
} ;

------------------------------------------------------------------------
-- Lemma 15: precomposition by a pointed equivalence

pre-pteq (X' : U l) (x0' : X') (Y : U l) (y0 : Y) (Z : U l) (z0 : Z) (e : PtEquiv X' x0' Z z0) :
  isEquiv (PtMap Z z0 Y y0) (PtMap X' x0' Y y0) (\ G -> ptcomp X' x0' Z z0 Y y0 e.1 G) =
  ptEqInd X' x0' (\ Z1 z1 e1 -> isEquiv (PtMap Z1 z1 Y y0) (PtMap X' x0' Y y0) (\ G -> ptcomp X' x0' Z1 z1 Y y0 e1.1 G))
    (E.homotopy (PtMap X' x0' Y y0) (PtMap X' x0' Y y0) (idEquiv (PtMap X' x0' Y y0)) (\ G -> ptcomp X' x0' X' x0' Y y0 (idPt X' x0').1 G)
       (\ G -> Fb.ptcomp-idl X' x0' Y y0 G))
    Z z0 e ;

------------------------------------------------------------------------
-- section 4: the source S2

module SourceS (S2 : U l) (base : S2) (surf : O2 S2 base)
  (ump : (X : U l) -> isEquiv (S2 -> X) ((x : X) * O2 X x) (ev2 S2 base surf X)) {
  module SA = Sphere[S2, base, surf, ump] ;

  -- Lemma 12
  s2-paths (Z : U l) (z0 : Z) (c : isConn two (O2 Z z0)) (F F' : PtMap S2 base Z z0) : Tr.Trunc[Id (PtMap S2 base Z z0) F F'].carrier =
    TC.map (Id (O2 Z z0) (SA.evPt Z z0 F) (SA.evPt Z z0 F')) (Id (PtMap S2 base Z z0) F F')
      (E.injective (PtMap S2 base Z z0) (O2 Z z0) (SA.evPt Z z0) (SA.pointed-up Z z0) F F')
      (conn-path zero (O2 Z z0) c (SA.evPt Z z0 F) (SA.evPt Z z0 F')) ;

  -- Corollary 13
  ex-S (Ga Gb : Ab) (k : PtMap (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four)) : Lifting[S2, base, Ga, Gb, k].Ex =
    \ F -> s2-paths (KK[Gb].K four) (KK[Gb].pt four) LevW[Gb].cOOW
             (ptcomp S2 base (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four) F k) (ptconst S2 base (KK[Gb].K four) (KK[Gb].pt four)) ;
  un-S (Ga Gb : Ab) (k : PtMap (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four)) : Lifting[S2, base, Ga, Gb, k].Un =
    \ d -> s2-paths (Id (KK[Gb].K four) (KK[Gb].pt four) (KK[Gb].pt four)) (refl (KK[Gb].pt four)) LevW[Gb].cOOOW
             (ptconst S2 base (Id (KK[Gb].K four) (KK[Gb].pt four) (KK[Gb].pt four)) (refl (KK[Gb].pt four))) d ;
  qS (Ga Gb : Ab) (k : PtMap (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four)) :
    isEquiv (HC S2 base Triple[Ga, Gb, k].F Triple[Ga, Gb, k].f0) (HC S2 base (KK[Ga].K two) (KK[Ga].pt two)) Lifting[S2, base, Ga, Gb, k].qs =
    Lifting[S2, base, Ga, Gb, k].Main[ex-S Ga Gb k, un-S Ga Gb k].equiv ;

  -- Lemma 14: looping K(Z,2) -> Y, Y a 2-type, is an equivalence (Corollary 11, c = 1)
  module LoopEq (Y : U l) (y0 : Y) (tY : isTrunc four Y) {
    module M = Maps[KZ2, kz2, Y, y0] ;
    cell (f : M.PMO) : isContr M.Over[f].Unloop = M.Over[f].cor11 (suc zero) (KK[Zab].conn (suc zero)) tY ;
    equiv : isEquiv (PtMap KZ2 kz2 Y y0) M.PMO M.loop =
      qinv (PtMap KZ2 kz2 Y y0) M.PMO M.loop (\ f -> (cell f).1.1) (\ f -> symH (cell f).1.2)
        (\ G -> apH (\ w -> w.1) (contr-prop M.Over[M.loop G].Unloop (cell (M.loop G)) (cell (M.loop G)).1 (G, refl (M.loop G)))) ;
  } ;

  -- Definition 16: the generator c of Omega^2 K(Z,2), and sigma with ev sigma = c
  gen-c : O2 KZ2 kz2 = (Maps[CS.C.Z1.K1, CS.C.Z1.k0, Id KZ2 kz2 kz2, refl kz2].loop CS.e1inv).1 CS.C.g ;
  sigma : PtMap S2 base KZ2 kz2 = (SA.pointed-up KZ2 kz2).sec gen-c ;
  sigma-ev : Id (O2 KZ2 kz2) (SA.evPt KZ2 kz2 sigma) gen-c = (SA.pointed-up KZ2 kz2).sec-eq gen-c ;
  -- the generator g of Circle does not depend on its parameter (g is locked:
  -- both have band g = band (g . refl) = suc (band refl), band-g; band-inj)
  g-def (Y : U l) : Id (Id CS.C.Z1.K1 CS.C.Z1.k0 CS.C.Z1.k0) CP.Circle[Y].g CS.C.g =
    CS.C.Z1.band-inj CS.C.Z1.k0 CP.Circle[Y].g CS.C.g
      (transH (CP.Circle[Y].band-g (refl CS.C.Z1.k0)) (symH (CS.C.band-g (refl CS.C.Z1.k0)))) ;

  -- Proposition 17
  module Sig (Y : U l) (y0 : Y) (tY : isTrunc four Y) {
    module CY = CP.Circle[Id Y y0 y0] ;
    Psi (G : PtMap KZ2 kz2 Y y0) : O2 Y y0 =
      CY.evPt (refl y0) (ptcomp CS.C.Z1.K1 CS.C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) (Id Y y0 y0) (refl y0) CS.e1inv (Maps[KZ2, kz2, Y, y0].loop G)) ;
    psi-equiv : isEquiv (PtMap KZ2 kz2 Y y0) (O2 Y y0) Psi =
      (E.compose (PtMap KZ2 kz2 Y y0) (PtMap CS.C.Z1.K1 CS.C.Z1.k0 (Id Y y0 y0) (refl y0)) (O2 Y y0)
         (E.compose (PtMap KZ2 kz2 Y y0) (Maps[KZ2, kz2, Y, y0].PMO) (PtMap CS.C.Z1.K1 CS.C.Z1.k0 (Id Y y0 y0) (refl y0))
            (Maps[KZ2, kz2, Y, y0].loop, LoopEq[Y, y0, tY].equiv)
            (\ H -> ptcomp CS.C.Z1.K1 CS.C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) (Id Y y0 y0) (refl y0) CS.e1inv H,
             pre-pteq CS.C.Z1.K1 CS.C.Z1.k0 (Id Y y0 y0) (refl y0) (Id KZ2 kz2 kz2) (refl kz2)
               (pt-inv (Id KZ2 kz2 kz2) (refl kz2) CS.C.Z1.K1 CS.C.Z1.k0 CS.e1)))
         (CY.evPt (refl y0), CY.pointed-up (refl y0))).2 ;
    -- ev (sigma ; G) = Psi G
    sigma-nat (G : PtMap KZ2 kz2 Y y0) : Id (O2 Y y0) (SA.evPt Y y0 (ptcomp S2 base KZ2 kz2 Y y0 sigma G)) (Psi G) =
      calc (O2 Y y0) {
        SA.evPt Y y0 (ptcomp S2 base KZ2 kz2 Y y0 sigma G)
          =< SA.evPt-nat KZ2 kz2 Y y0 sigma G >
        (loop2 KZ2 kz2 Y y0 G).1 (SA.evPt KZ2 kz2 sigma)
          =< apH (loop2 KZ2 kz2 Y y0 G).1 sigma-ev >
        (loop2 KZ2 kz2 Y y0 G).1 gen-c
          =< refl ((loop2 KZ2 kz2 Y y0 G).1 gen-c) >
        (ptcomp (Id CS.C.Z1.K1 CS.C.Z1.k0 CS.C.Z1.k0) (refl CS.C.Z1.k0) (O2 KZ2 kz2) (refl (refl kz2)) (O2 Y y0) (refl (refl y0))
           (Maps[CS.C.Z1.K1, CS.C.Z1.k0, Id KZ2 kz2 kz2, refl kz2].loop CS.e1inv) (loop2 KZ2 kz2 Y y0 G)).1 CS.C.g
          =< apH (\ M -> M.1 CS.C.g)
               (symH (loop-comp CS.C.Z1.K1 CS.C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) (Id Y y0 y0) (refl y0) CS.e1inv (Maps[KZ2, kz2, Y, y0].loop G))) >
        (Maps[CS.C.Z1.K1, CS.C.Z1.k0, Id Y y0 y0, refl y0].loop
           (ptcomp CS.C.Z1.K1 CS.C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) (Id Y y0 y0) (refl y0) CS.e1inv (Maps[KZ2, kz2, Y, y0].loop G))).1 CS.C.g
          =< apH (\ g1 -> (Maps[CS.C.Z1.K1, CS.C.Z1.k0, Id Y y0 y0, refl y0].loop
                (ptcomp CS.C.Z1.K1 CS.C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) (Id Y y0 y0) (refl y0) CS.e1inv (Maps[KZ2, kz2, Y, y0].loop G))).1 g1)
               (symH (g-def (Id Y y0 y0))) >
        (Maps[CS.C.Z1.K1, CS.C.Z1.k0, Id Y y0 y0, refl y0].loop
           (ptcomp CS.C.Z1.K1 CS.C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) (Id Y y0 y0) (refl y0) CS.e1inv (Maps[KZ2, kz2, Y, y0].loop G))).1 CY.g
          =< symH (CY.evPt-loop (refl y0) (ptcomp CS.C.Z1.K1 CS.C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) (Id Y y0 y0) (refl y0) CS.e1inv (Maps[KZ2, kz2, Y, y0].loop G))) >
        Psi G } ;
    sigma-star : isEquiv (PtMap KZ2 kz2 Y y0) (PtMap S2 base Y y0) (\ G -> ptcomp S2 base KZ2 kz2 Y y0 sigma G) =
      W.cancel-equiv (PtMap KZ2 kz2 Y y0) (PtMap S2 base Y y0) (O2 Y y0) (\ G -> ptcomp S2 base KZ2 kz2 Y y0 sigma G) (SA.evPt Y y0) (SA.pointed-up Y y0)
        (E.homotopy (PtMap KZ2 kz2 Y y0) (O2 Y y0) (Psi, psi-equiv) (\ G -> SA.evPt Y y0 (ptcomp S2 base KZ2 kz2 Y y0 sigma G)) sigma-nat) ;
    sigma-cls : isEquiv (HC KZ2 kz2 Y y0) (HC S2 base Y y0) (\ b -> compC S2 base KZ2 kz2 Y y0 (hcl S2 base KZ2 kz2 sigma) b) =
      pre-equiv S2 base KZ2 kz2 Y y0 sigma sigma-star ;
  } ;
} ;

------------------------------------------------------------------------
-- section 5: the mapping theorem for targets Fib k

module Final (S2 : U l) (base : S2) (surf : O2 S2 base)
  (ump : (X : U l) -> isEquiv (S2 -> X) ((x : X) * O2 X x) (ev2 S2 base surf X))
  (kappa : PtMap KZ2 kz2 KZ4 kz4) (h4k : H4 kappa) {
  module SP = SourceP[kappa, h4k] ;
  module SS = SourceS[S2, base, surf, ump] ;

  -- Definition 19: s = p_*^-1 [sigma]
  s : HC S2 base SP.RP.F SP.RP.f0 = (SS.qS Zab Zab kappa).sec (hcl S2 base KZ2 kz2 SS.sigma) ;
  s-eq : Id (HC S2 base KZ2 kz2) (compC S2 base SP.RP.F SP.RP.f0 KZ2 kz2 s (hcl SP.RP.F SP.RP.f0 KZ2 kz2 (Fb.fpr KZ2 kz2 KZ4 kz4 kappa)))
      (hcl S2 base KZ2 kz2 SS.sigma) =
    (SS.qS Zab Zab kappa).sec-eq (hcl S2 base KZ2 kz2 SS.sigma) ;

  -- Proposition 20
  right (Ga : Ab) : isEquiv (HC SP.RP.F SP.RP.f0 (KK[Ga].K two) (KK[Ga].pt two)) (HC S2 base (KK[Ga].K two) (KK[Ga].pt two))
      (\ c -> compC S2 base SP.RP.F SP.RP.f0 (KK[Ga].K two) (KK[Ga].pt two) s c) =
    cancel-r (HC KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two)) (HC SP.RP.F SP.RP.f0 (KK[Ga].K two) (KK[Ga].pt two)) (HC S2 base (KK[Ga].K two) (KK[Ga].pt two))
      SP.PStar[Ga].pstar (\ c -> compC S2 base SP.RP.F SP.RP.f0 (KK[Ga].K two) (KK[Ga].pt two) s c) SP.PStar[Ga].equiv
      (E.homotopy (HC KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two)) (HC S2 base (KK[Ga].K two) (KK[Ga].pt two))
         (\ d -> compC S2 base KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) (hcl S2 base KZ2 kz2 SS.sigma) d,
          SS.Sig[KK[Ga].K two, KK[Ga].pt two, KK[Ga].trunc (suc zero)].sigma-cls)
         (\ d -> compC S2 base SP.RP.F SP.RP.f0 (KK[Ga].K two) (KK[Ga].pt two) s (SP.PStar[Ga].pstar d))
         (\ d -> transH (symH (comp-assoc S2 base SP.RP.F SP.RP.f0 KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) s (hcl SP.RP.F SP.RP.f0 KZ2 kz2 (Fb.fpr KZ2 kz2 KZ4 kz4 kappa)) d))
                   (apH (\ c -> compC S2 base KZ2 kz2 (KK[Ga].K two) (KK[Ga].pt two) c d) s-eq))) ;

  -- Theorem 21
  rep-fib (Ga Gb : Ab) (k : PtMap (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four)) :
    isEquiv (HC SP.RP.F SP.RP.f0 Triple[Ga, Gb, k].F Triple[Ga, Gb, k].f0) (HC S2 base Triple[Ga, Gb, k].F Triple[Ga, Gb, k].f0)
      (\ c -> compC S2 base SP.RP.F SP.RP.f0 Triple[Ga, Gb, k].F Triple[Ga, Gb, k].f0 s c) =
    W.cancel-equiv (HC SP.RP.F SP.RP.f0 Triple[Ga, Gb, k].F Triple[Ga, Gb, k].f0) (HC S2 base Triple[Ga, Gb, k].F Triple[Ga, Gb, k].f0)
      (HC S2 base (KK[Ga].K two) (KK[Ga].pt two))
      (\ c -> compC S2 base SP.RP.F SP.RP.f0 Triple[Ga, Gb, k].F Triple[Ga, Gb, k].f0 s c) Lifting[S2, base, Ga, Gb, k].qs (SS.qS Ga Gb k)
      (E.homotopy (HC SP.RP.F SP.RP.f0 Triple[Ga, Gb, k].F Triple[Ga, Gb, k].f0) (HC S2 base (KK[Ga].K two) (KK[Ga].pt two))
         (E.compose (HC SP.RP.F SP.RP.f0 Triple[Ga, Gb, k].F Triple[Ga, Gb, k].f0) (HC SP.RP.F SP.RP.f0 (KK[Ga].K two) (KK[Ga].pt two)) (HC S2 base (KK[Ga].K two) (KK[Ga].pt two))
            (Lifting[SP.RP.F, SP.RP.f0, Ga, Gb, k].qs, SP.qP Ga Gb k)
            (\ c -> compC S2 base SP.RP.F SP.RP.f0 (KK[Ga].K two) (KK[Ga].pt two) s c, right Ga))
         (\ c -> Lifting[S2, base, Ga, Gb, k].qs (compC S2 base SP.RP.F SP.RP.f0 Triple[Ga, Gb, k].F Triple[Ga, Gb, k].f0 s c))
         (\ c -> comp-assoc S2 base SP.RP.F SP.RP.f0 Triple[Ga, Gb, k].F Triple[Ga, Gb, k].f0 (KK[Ga].K two) (KK[Ga].pt two) s c
                   (hcl Triple[Ga, Gb, k].F Triple[Ga, Gb, k].f0 (KK[Ga].K two) (KK[Ga].pt two) (Fb.fpr (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four) k)))) ;

  -- Corollary 22: transfer along a pointed equivalence
  rep-pteq (Ga Gb : Ab) (k : PtMap (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four))
    (X : U l) (x0 : X) (e : PtEquiv Triple[Ga, Gb, k].F Triple[Ga, Gb, k].f0 X x0) :
    isEquiv (HC SP.RP.F SP.RP.f0 X x0) (HC S2 base X x0) (\ c -> compC S2 base SP.RP.F SP.RP.f0 X x0 s c) =
    ptEqInd Triple[Ga, Gb, k].F Triple[Ga, Gb, k].f0
      (\ X1 x1 e1 -> isEquiv (HC SP.RP.F SP.RP.f0 X1 x1) (HC S2 base X1 x1) (\ c -> compC S2 base SP.RP.F SP.RP.f0 X1 x1 s c))
      (rep-fib Ga Gb k) X x0 e ;
} ;

-- for the cup square
rep-cup (S2 : U l) (base : S2) (surf : O2 S2 base)
  (ump : (X : U l) -> isEquiv (S2 -> X) ((x : X) * O2 X x) (ev2 S2 base surf X))
  (Ga Gb : Ab) (k : PtMap (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four)) :
  isEquiv (HC Triple[Zab, Zab, CS.kappa].F Triple[Zab, Zab, CS.kappa].f0 Triple[Ga, Gb, k].F Triple[Ga, Gb, k].f0)
    (HC S2 base Triple[Ga, Gb, k].F Triple[Ga, Gb, k].f0)
    (\ c -> compC S2 base Triple[Zab, Zab, CS.kappa].F Triple[Zab, Zab, CS.kappa].f0 Triple[Ga, Gb, k].F Triple[Ga, Gb, k].f0
              Final[S2, base, surf, ump, CS.kappa, H4Proof[l].h4].s c) =
  Final[S2, base, surf, ump, CS.kappa, H4Proof[l].h4].rep-fib Ga Gb k ;
