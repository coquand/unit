-- Postnikov presentation of pointed 2-connected 4-types (doc/br-universal.pdf,
-- Theorem pres4), and the mapping theorem at T = ||S^3||_4 (rep-T).  The text of
-- Presentation (doc/postnikov-presentation.pdf, sections 3-6) with the indices
-- raised, except for the base, which is recognised (Presentation.Rec) instead of
-- compared with a sphere.
--
-- Informal proof.  Let (Y, y0) be pointed, isConn 4 and isTrunc 6.
--   Rec4        a type F isConn 5 and isTrunc 6 is K(B,4), B = Omega^3 (Omega F):
--               Rec for Omega F gives G3 : K(B,3) ~pt Omega F; f4 = e_3 ; G3 :
--               Omega K(B,4) ->pt Omega F, an equivalence (a composite); its space of
--               deloopings is contractible (Cor. 11 at c = 3: K(B,4) isConn 5, F
--               isTrunc 6, hence isTrunc 8), so deloop-equiv gives e4 : K(B,4) ~pt F
--   Classify    the level-n stage of the torsor identification, any n (Presentation
--               section 5, generic): tau (pt = t) ~ el t, Lemma 11 (tor-fib, tor,
--               tor-el: a merely inhabited Y with a homogeneous structure is a torsor
--               with underlying type Y); used at n = 2: K(B,5) = K(B,4)-torsors
--   Pres4       1. V = ||Y||_3 (TO four, isTrunc 5), u the unit, E z the fibres of u
--                  (isConn 5 by TruncOp.conn, isTrunc 6); V isConn 4 (conn-up)
--               2. base: Rec gives e_V : K(A,3) ~pt V, A = Omega^3 V
--               3. fibre: Rec4 at F0 = E v0 gives e4 : K(B,4) ~pt F0, B = Omega^3
--                  (Omega F0), an ARBITRARY abelian group: it is not identified here
--               4. homogeneity: Q y = (K(B,4) ~pt (E (u y), (y, refl))) is a set
--                  (cor5-equiv, t = 1, c = 4); a section through Q y0 containing e4
--                  exists (lemma4, t = 0; Y isConn 3); moved along paths, mu z
--               5. classifying map: k1 z = <E z, mu z> (Classify at n = 2, K5-def,
--                  pt5-def), kp : V ->pt K(B,5), Fib kp ~ Y (tot, as Prop. 13);
--                  K = e_V ; kp, Fib K ~ Y (sigma-base, fib-K); pointed merely
--                  (Y connected: pres-pt), pres
--   Final4      rep-T: s^* : [BR, T]_* -> [S3, T]_* is a bijection, for a level-4
--               truncation TR of S3 (Sphere3Trunc.Trunc4; used at trunc4): the proposition is eliminated from the mere
--               pointing pres-pt, each pointed presentation giving it by
--               SourceS3.Final.rep-pteq (Cor. transfer) at the triple (A, B, K)
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ; open HLevels[l] ; open Connected[l] ;
open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ; open LoopCalc[l] ; open Torsor[l] ;
open EMMaps[l] ; open SphereUniversal[l] ; open PostnikovRealization[l] ; open HomotopyClasses[l] ;
open Sphere3Axiom[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Eq = Equivalences[l] ; module W = Whitehead[l] ; module Fb = Fibres[l] ; module CM = ConnectedMaps[l] ;
module TS = Truncations[l] ; module P1 = Prelude[l+] ; module EMf = EM[l] ; module PS = Presentation[l] ;
module SA = SphereAxiom[l] ; module MB = MapBR[l] ; module DR = DeloopR[l] ; module S3S = SourceS3[l] ; module S3T = Sphere3Trunc[l] ;

------------------------------------------------------------------------
-- recognising K(B,4)

module Rec4 (F : U l) (f0 : F) (cF : isConn five F) (tF : isTrunc (suc five) F) {
  -- G3 : K(B,3) ~pt Omega F, B = Omega^3 (Omega F) (Proposition 7)
  module R = PS.Rec[Id F f0 f0, refl f0, conn-id four F cF f0 f0, tF f0 f0] ;
  module KB = R.KB ;
  -- Corollary 11, c = 3
  f4 : Maps[KB.K four, KB.pt four, F, f0].PMO =
    ptcomp (Id (KB.K four) (KB.pt four) (KB.pt four)) (refl (KB.pt four)) (KB.K three) (KB.pt three) (Id F f0 f0) (refl f0) (KB.e three).1 R.e3.1 ;
  cell4 : isContr Maps[KB.K four, KB.pt four, F, f0].Over[f4].Unloop =
    Maps[KB.K four, KB.pt four, F, f0].Over[f4].cor11 three (KB.conn three) (trunc-suc (suc (suc five)) F (trunc-suc (suc five) F tF)) ;
  e4 : PtEquiv (KB.K four) (KB.pt four) F f0 =
    PS.deloop-equiv (KB.K four) (KB.pt four) F f0 (conn-zero three (KB.K four) (KB.conn three)) (conn-zero three F cF) f4
      (Eq.compose (Id (KB.K four) (KB.pt four) (KB.pt four)) (KB.K three) (Id F f0 f0)
         ((KB.e three).1.1, (KB.e three).2) (R.e3.1.1, R.e3.2)).2 cell4 ;
} ;

------------------------------------------------------------------------
-- the torsor identification at a stage n (Presentation, section 5)

module Classify (n : Nat) (S : EMf.Stage[n]) {
  module DS = EMf.Step[n, S] ;
  -- (pt = t) ~ el t (the fundamental theorem of Deloop)
  tau (t : DS.T.Tor) : Equiv (Id DS.T.Tor DS.D.ptT t) (DS.T.el t.1) = (DS.D.F.tr t, DS.D.F.equiv t) ;
  -- Lemma 11
  tor-fib (Y : U l) (inh : Tr.Trunc[Y].carrier) (m : DS.T.Mu Y) : DS.T.Fib Y =
    TC.rec Y @(l+) (DS.T.Fib Y) (DS.T.fib-prop Y) (\ y -> (DS.T.fib-contr Y (inh, m, y)).1) inh ;
  tor (Y : U l) (inh : Tr.Trunc[Y].carrier) (m : DS.T.Mu Y) : DS.T.Tor =
    ((tor-fib Y inh m).1,
     P1.subst (U l) (\ Z -> Tr.Trunc[Z].carrier * DS.T.Mu Z) Y (DS.T.el (tor-fib Y inh m).1)
       (P1.sym (U l) (DS.T.el (tor-fib Y inh m).1) Y (tor-fib Y inh m).2) (inh, m)) ;
  tor-el (Y : U l) (inh : Tr.Trunc[Y].carrier) (m : DS.T.Mu Y) : Id (U l) (DS.T.el (tor Y inh m).1) Y = (tor-fib Y inh m).2 ;
} ;

------------------------------------------------------------------------
-- Theorem pres4

module Pres4 (Y : U l) (y0 : Y) (cY : isConn four Y) (tY : isTrunc (suc five) Y) {
  -- 1. the 3-truncation of Y and the fibres of its unit
  V : U l = (TS.TO four).T Y ;
  v0 : V = (TS.TO four).unit Y y0 ;
  tV : isTrunc five V = (TS.TO four).trunc Y ;
  E (z : V) : U l = W.fib Y V ((TS.TO four).unit Y) z ;
  e-conn (z : V) : isConn five (E z) = (TS.TO four).conn Y z ;
  e-trunc (z : V) : isTrunc (suc five) (E z) =
    trunc-Sigma (suc five) Y (\ y -> Id V ((TS.TO four).unit Y y) z) tY
      (\ y -> trunc-suc five (Id V ((TS.TO four).unit Y y) z) (trunc-suc four (Id V ((TS.TO four).unit Y y) z) (tV ((TS.TO four).unit Y y) z))) ;
  cV : isConn four V =
    CM.conn-up four Y V ((TS.TO four).unit Y) (\ z -> conn-down four (E z) (e-conn z)) cY ;
  -- 2. the base: e_V : K(A,3) ~pt V, A = Omega^3 V
  module RV = PS.Rec[V, v0, cV, tV] ;
  module KA = RV.KB ;
  -- 3. the fibre: e4 : K(B,4) ~pt F0, B = Omega^3 (Omega F0)
  f0 : E v0 = (y0, refl v0) ;
  module RF = Rec4[E v0, f0, e-conn v0, e-trunc v0] ;
  module KB = RF.KB ;
  -- 4. homogeneity
  Q (y : Y) : U l = PtEquiv (KB.K four) (KB.pt four) (E ((TS.TO four).unit Y y)) (y, refl ((TS.TO four).unit Y y)) ;
  -- Lemma 9
  q-set (y : Y) : isTrunc two (Q y) =
    cor5-equiv (suc zero) four (KB.K four) (KB.pt four) (KB.conn three) (E ((TS.TO four).unit Y y)) (y, refl ((TS.TO four).unit Y y))
      (e-trunc ((TS.TO four).unit Y y)) ;
  -- Lemma 8
  ext : isContr (PtSec Y y0 Q RF.e4) = lemma4 zero two Y y0 (conn-down three Y cY) Q q-set RF.e4 ;
  -- Definition 10
  mu' (y : Y) : Q y = ext.1.1 y ;
  mu (z : V) (w : E z) : PtEquiv (KB.K four) (KB.pt four) (E z) w =
    idJ V ((TS.TO four).unit Y w.1) (\ z1 p1 -> PtEquiv (KB.K four) (KB.pt four) (E z1) (w.1, p1)) (mu' w.1) z w.2 ;

  -- 5. the classifying map: K(B,5) is the type of K(B,4)-torsors, by definition
  module CL = Classify[two, EMf.EMn[RF.R.O.ab].Kstage two] ;
  K5-def : Id (U l) (KB.K five) CL.DS.T.Tor = refl (KB.K five) ;
  pt5-def : Id CL.DS.T.Tor (KB.pt five) CL.DS.D.ptT = refl (KB.pt five) ;
  K4-def : Id (U l) (KB.K four) (EMf.EMn[RF.R.O.ab].Kstage two).X = refl (KB.K four) ;
  -- Definition 12
  k1 (z : V) : CL.DS.T.Tor = CL.tor (E z) (conn-inh four (E z) (e-conn z)) (mu z) ;
  c (z : V) : Equiv (CL.DS.T.el (k1 z).1) (E z) =
    Axioms[l].idtoeqv (CL.DS.T.el (k1 z).1) (E z) (CL.tor-el (E z) (conn-inh four (E z) (e-conn z)) (mu z)) ;
  kp : PtMap V v0 (KB.K five) (KB.pt five) =
    (k1, sym CL.DS.T.Tor CL.DS.D.ptT (k1 v0) ((CL.tau (k1 v0)).2.sec ((c v0).2.sec f0))) ;
  -- Proposition 13
  tot-ret (y : Y) (z : V) (p : Id V ((TS.TO four).unit Y y) z) :
    Id ((z1 : V) * E z1) ((TS.TO four).unit Y y, (y, refl ((TS.TO four).unit Y y))) (z, (y, p)) =
    idJ V ((TS.TO four).unit Y y) (\ z1 p1 -> Id ((z2 : V) * E z2) ((TS.TO four).unit Y y, (y, refl ((TS.TO four).unit Y y))) (z1, (y, p1)))
      (refl ((TS.TO four).unit Y y, (y, refl ((TS.TO four).unit Y y)))) z p ;
  tot-fib : Equiv ((z : V) * E z) Y =
    (\ w -> w.2.1, qinv ((z : V) * E z) Y (\ w -> w.2.1) (\ y -> ((TS.TO four).unit Y y, (y, refl ((TS.TO four).unit Y y))))
       (\ y -> refl y) (\ w -> tot-ret w.2.1 w.1 w.2.2)) ;
  tot : Equiv (Fb.Fib V v0 (KB.K five) (KB.pt five) kp) Y =
    Eq.compose (Fb.Fib V v0 (KB.K five) (KB.pt five) kp) ((z : V) * Id CL.DS.T.Tor CL.DS.D.ptT (k1 z)) Y
      (Fb.sigma-equiv V (\ z -> Id CL.DS.T.Tor (k1 z) CL.DS.D.ptT) (\ z -> Id CL.DS.T.Tor CL.DS.D.ptT (k1 z)) (\ z -> CM.sym-equiv CL.DS.T.Tor (k1 z) CL.DS.D.ptT))
      (Eq.compose ((z : V) * Id CL.DS.T.Tor CL.DS.D.ptT (k1 z)) ((z : V) * CL.DS.T.el (k1 z).1) Y
         (Fb.sigma-equiv V (\ z -> Id CL.DS.T.Tor CL.DS.D.ptT (k1 z)) (\ z -> CL.DS.T.el (k1 z).1) (\ z -> CL.tau (k1 z)))
         (Eq.compose ((z : V) * CL.DS.T.el (k1 z).1) ((z : V) * E z) Y
            (Fb.sigma-equiv V (\ z -> CL.DS.T.el (k1 z).1) E c) tot-fib)) ;

  -- 6. the presentation: K = e_V ; kp
  K : PtMap (KA.K three) (KA.pt three) (KB.K five) (KB.pt five) = ptcomp (KA.K three) (KA.pt three) V v0 (KB.K five) (KB.pt five) RV.e3.1 kp ;
  fib-K : Equiv MB.Triple3[RV.O.ab, RF.R.O.ab, K].F Y =
    Eq.compose MB.Triple3[RV.O.ab, RF.R.O.ab, K].F (Fb.Fib V v0 (KB.K five) (KB.pt five) kp) Y
      ((\ w -> (RV.e3.1.1 w.1, w.2)), SA.sigma-base (KA.K three) V (RV.e3.1.1, RV.e3.2) (\ z -> Id (KB.K five) (k1 z) (KB.pt five))) tot ;
  -- the pointing, merely (Y is connected)
  pres-pt : Tr.Trunc[Id Y (fib-K.1 MB.Triple3[RV.O.ab, RF.R.O.ab, K].f0) y0].carrier =
    conn-path two Y cY (fib-K.1 MB.Triple3[RV.O.ab, RF.R.O.ab, K].f0) y0 ;
  pres (a : Id Y (fib-K.1 MB.Triple3[RV.O.ab, RF.R.O.ab, K].f0) y0) : PtEquiv MB.Triple3[RV.O.ab, RF.R.O.ab, K].F MB.Triple3[RV.O.ab, RF.R.O.ab, K].f0 Y y0 =
    ((fib-K.1, a), fib-K.2) ;
} ;

------------------------------------------------------------------------
-- the mapping theorem at T = ||S^3||_4

module Final4 (S3 : U l) (base : S3) (surf : O3 S3 base)
  (ump3 : (X : U l) -> isEquiv (S3 -> X) ((x : X) * O3 X x) (ev3 S3 base surf X)) (TR : S3T.Interfaces4[S3, base].Trunc4) {
  module PR = Pres4[TR.T, TR.t0, TR.connT, TR.truncT] ;
  module FS = S3S.Final[S3, base, surf, ump3] ;
  rep-T : isEquiv (HC DR.BR DR.br0 TR.T TR.t0) (HC S3 base TR.T TR.t0) (\ c -> compC S3 base DR.BR DR.br0 TR.T TR.t0 FS.s c) =
    TC.rec (Id TR.T (PR.fib-K.1 MB.Triple3[PR.RV.O.ab, PR.RF.R.O.ab, PR.K].f0) TR.t0) @l
      (isEquiv (HC DR.BR DR.br0 TR.T TR.t0) (HC S3 base TR.T TR.t0) (\ c -> compC S3 base DR.BR DR.br0 TR.T TR.t0 FS.s c))
      (EquivProp[l].isEquiv-prop (HC DR.BR DR.br0 TR.T TR.t0) (HC S3 base TR.T TR.t0) (\ c -> compC S3 base DR.BR DR.br0 TR.T TR.t0 FS.s c))
      (\ a -> FS.rep-pteq PR.RV.O.ab PR.RF.R.O.ab PR.K TR.T TR.t0 (PR.pres a))
      PR.pres-pt ;
} ;
