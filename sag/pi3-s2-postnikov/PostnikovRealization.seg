-- Postnikov triples and their realization (milestone C, objects).
-- A triple (A, B, k) has abelian groups A, B and a pointed map
--     k : K(A,2) ->pt K(B,4)
-- (EMMaps.KK: K m is K(-, m), K 0 the group; so no index offset here).
-- Its realization is the pointed fibre  Fib k = (x : K(A,2)) * (k x = pt).
--   trunc5      Fib k is a 3-type (isTrunc 5): Sigma of a 2-type and the
--               identity types of a 4-type
--   conn3       Fib k is simply connected (isConn 3): 0-connected
--               (Fibres.FibConn: loops of K(B,4) are merely refl) and its
--               loop space Omega Fib k = Fib (Omega k) is 0-connected
--               (omega-fib, FibConn again)
--   pi3-iso     pi3 (Fib k) = B as GROUPS, by the chain
--     pi_1 Omega^2 Fib k  = pi_1 Omega Fib (Omega k)     (Omega of omega-fib)
--                         = pi_1 Fib (Omega^2 k)          (omega-fib)
--                         = pi_1 Fib (fpr (Omega^2 k))     (ProjIso: Omega^2 K(A,2) is a set)
--                         = pi_1 Omega^3 K(B,4)            (Puppe.puppe1)
--                         = pi_1 K(B,1)                    (loops of KK.e)
--                         = B                              (the band, LoopsSetIso)
--     each an isomorphism induced by a pointed map (LoopIso); no choice.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Lemma4[l] ; open DeloopMaps[l] ; open LoopCalc[l] ; open PtEquivOps[l] ;
open HLevels[l] ; open Connected[l] ;
open Group[l] ; open Torsor[l] ; open SphereAxiom[l] ; open HomotopyGroups[l] ; open LoopIso[l] ; open SphereUniversal[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Fb = Fibres[l] ;

two : Nat = suc (suc zero) ;
four : Nat = suc three ;

-- in a 1-connected type every loop is merely refl
loop-triv (Y : U l) (c : isConn three Y) (y : Y) (u : Id Y y y) : Tr.Trunc[Id (Id Y y y) (refl y) u].carrier =
  ((c.2 y y).2 (refl y) u).1 ;

-- every loop of a 1-connected codomain is merely ap f of a loop (namely refl)
surj-triv (X : U l) (x0 : X) (Y : U l) (y0 : Y) (f : PtMap X x0 Y y0) (cY : isConn three Y) (u : Id Y (f.1 x0) (f.1 x0)) :
  Tr.Trunc[(q : Id X x0 x0) * Id (Id Y (f.1 x0) (f.1 x0)) (ap X Y f.1 x0 x0 q) u].carrier =
  TC.map (Id (Id Y (f.1 x0) (f.1 x0)) (refl (f.1 x0)) u) ((q : Id X x0 x0) * Id (Id Y (f.1 x0) (f.1 x0)) (ap X Y f.1 x0 x0 q) u)
    (\ r -> (refl x0, r)) (loop-triv Y cY (f.1 x0) u) ;

module Triple (Ga Gb : Ab) (k : PtMap (EMMaps[l].KK[Ga].K two) (EMMaps[l].KK[Ga].pt two) (EMMaps[l].KK[Gb].K four) (EMMaps[l].KK[Gb].pt four)) {
  module KA = EMMaps[l].KK[Ga] ; module KB = EMMaps[l].KK[Gb] ;
  -- the realization
  F : U l = Fb.Fib (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) k ;
  f0 : F = Fb.fpt (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) k ;

  ----------------------------------------------------------------------
  -- levels

  trunc5 : isTrunc five F =
    trunc-Sigma five (KA.K two) (\ x -> Id (KB.K four) (k.1 x) (KB.pt four))
      (trunc-suc four (KA.K two) (KA.trunc (suc zero))) (\ x -> KB.trunc three (k.1 x) (KB.pt four)) ;

  -- K(B,4) and its loop space are 1-connected
  cY : isConn three (KB.K four) = conn-down three (KB.K four) (conn-down four (KB.K four) (KB.conn three)) ;
  cOY : isConn three (Id (KB.K four) (KB.pt four) (KB.pt four)) =
    conn-down three (Id (KB.K four) (KB.pt four) (KB.pt four)) ((KB.conn three).2 (KB.pt four) (KB.pt four)) ;

  -- Omega k
  Ok : PtMap (Id (KA.K two) (KA.pt two) (KA.pt two)) (refl (KA.pt two)) (Id (KB.K four) (KB.pt four) (KB.pt four)) (refl (KB.pt four)) =
    Maps[KA.K two, KA.pt two, KB.K four, KB.pt four].loop k ;
  -- Omega F = Fib (Omega k), over the projections
  OF1 : Fb.OF (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) k = Fb.omega-fib (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) k ;
  -- Fib (Omega k)
  FOk : U l = Fb.Fib (Id (KA.K two) (KA.pt two) (KA.pt two)) (refl (KA.pt two)) (Id (KB.K four) (KB.pt four) (KB.pt four)) (refl (KB.pt four)) Ok ;
  fOk : FOk = Fb.fpt (Id (KA.K two) (KA.pt two) (KA.pt two)) (refl (KA.pt two)) (Id (KB.K four) (KB.pt four) (KB.pt four)) (refl (KB.pt four)) Ok ;

  paths0 (w w' : F) : Tr.Trunc[Id F w w'].carrier =
    Fb.FibConn[KA.K two, KA.pt two, KB.K four, KB.pt four, k, conn-zero (suc zero) (KA.K two) (KA.conn (suc zero)),
      surj-triv (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) k cY].paths w w' ;
  conn-FOk : isConn two FOk =
    Fb.FibConn[Id (KA.K two) (KA.pt two) (KA.pt two), refl (KA.pt two), Id (KB.K four) (KB.pt four) (KB.pt four), refl (KB.pt four), Ok,
      (KA.conn (suc zero)).2 (KA.pt two) (KA.pt two),
      surj-triv (Id (KA.K two) (KA.pt two) (KA.pt two)) (refl (KA.pt two)) (Id (KB.K four) (KB.pt four) (KB.pt four)) (refl (KB.pt four)) Ok cOY].conn ;
  conn-loops : isConn two (Id F f0 f0) =
    Deloop[l].equiv-conn two (Id F f0 f0) FOk Acc[Id F f0 f0, refl f0, FOk, fOk, OF1.1].equiv conn-FOk ;
  conn3 : isConn three F = conn-from-point (suc zero) F f0 paths0 conn-loops ;

  ----------------------------------------------------------------------
  -- pi3 (Fib k) = B

  -- Omega^2 k
  g : PtMap (O2 (KA.K two) (KA.pt two)) (refl (refl (KA.pt two))) (O2 (KB.K four) (KB.pt four)) (refl (refl (KB.pt four))) =
    Maps[Id (KA.K two) (KA.pt two) (KA.pt two), refl (KA.pt two), Id (KB.K four) (KB.pt four) (KB.pt four), refl (KB.pt four)].loop Ok ;
  OF2 : Fb.OF (Id (KA.K two) (KA.pt two) (KA.pt two)) (refl (KA.pt two)) (Id (KB.K four) (KB.pt four) (KB.pt four)) (refl (KB.pt four)) Ok =
    Fb.omega-fib (Id (KA.K two) (KA.pt two) (KA.pt two)) (refl (KA.pt two)) (Id (KB.K four) (KB.pt four) (KB.pt four)) (refl (KB.pt four)) Ok ;
  -- Fib (Omega^2 k)
  Fg : U l = Fb.Fib (O2 (KA.K two) (KA.pt two)) (refl (refl (KA.pt two))) (O2 (KB.K four) (KB.pt four)) (refl (refl (KB.pt four))) g ;
  fg : Fg = Fb.fpt (O2 (KA.K two) (KA.pt two)) (refl (refl (KA.pt two))) (O2 (KB.K four) (KB.pt four)) (refl (refl (KB.pt four))) g ;
  -- Omega^3 K(B,4), pointed
  O3Y : U l = Id (O2 (KB.K four) (KB.pt four)) (refl (refl (KB.pt four))) (refl (refl (KB.pt four))) ;
  o3y : O3Y = refl (refl (refl (KB.pt four))) ;

  -- step 1: Omega of the equivalence Omega F = Fib (Omega k)
  s1 : GIso[pi3 F f0, PiOne[l].PiOne[Id FOk fOk fOk, refl fOk].grp] =
    pi1-pe (O2 F f0) (refl (refl f0)) (Id FOk fOk fOk) (refl fOk) (loopPE (Id F f0 f0) (refl f0) FOk fOk OF1.1) ;
  -- step 2: Omega Fib (Omega k) = Fib (Omega^2 k)
  s2 : GIso[PiOne[l].PiOne[Id FOk fOk fOk, refl fOk].grp, PiOne[l].PiOne[Fg, fg].grp] =
    pi1-pe (Id FOk fOk fOk) (refl fOk) Fg fg OF2.1 ;
  -- step 3: Omega^3 K(B,4) = Fib (fpr g) (Puppe) and Omega^2 K(A,2) is a set (ProjIso)
  sO2X : isSet (O2 (KA.K two) (KA.pt two)) =
    trunc-set (O2 (KA.K two) (KA.pt two)) (KA.trunc (suc zero) (KA.pt two) (KA.pt two) (refl (KA.pt two)) (refl (KA.pt two))) ;
  module PJ = ProjIso[Fg, fg, O2 (KA.K two) (KA.pt two), refl (refl (KA.pt two)),
    Fb.fpr (O2 (KA.K two) (KA.pt two)) (refl (refl (KA.pt two))) (O2 (KB.K four) (KB.pt four)) (refl (refl (KB.pt four))) g, sO2X] ;
  module PU = Puppe[l].Puppe[O2 (KA.K two) (KA.pt two), refl (refl (KA.pt two)), O2 (KB.K four) (KB.pt four), refl (refl (KB.pt four)), g] ;
  s3 : GIso[PiOne[l].PiOne[O3Y, o3y].grp, PiOne[l].PiOne[Fg, fg].grp] =
    gi-comp PiOne[l].PiOne[O3Y, o3y].grp
      PiOne[l].PiOne[Fb.Fib Fg fg (O2 (KA.K two) (KA.pt two)) (refl (refl (KA.pt two))) (Fb.fpr (O2 (KA.K two) (KA.pt two)) (refl (refl (KA.pt two))) (O2 (KB.K four) (KB.pt four)) (refl (refl (KB.pt four))) g),
                     Fb.fpt Fg fg (O2 (KA.K two) (KA.pt two)) (refl (refl (KA.pt two))) (Fb.fpr (O2 (KA.K two) (KA.pt two)) (refl (refl (KA.pt two))) (O2 (KB.K four) (KB.pt four)) (refl (refl (KB.pt four))) g)].grp
      PiOne[l].PiOne[Fg, fg].grp
      (pi1-pe O3Y o3y
         (Fb.Fib Fg fg (O2 (KA.K two) (KA.pt two)) (refl (refl (KA.pt two))) (Fb.fpr (O2 (KA.K two) (KA.pt two)) (refl (refl (KA.pt two))) (O2 (KB.K four) (KB.pt four)) (refl (refl (KB.pt four))) g))
         (Fb.fpt Fg fg (O2 (KA.K two) (KA.pt two)) (refl (refl (KA.pt two))) (Fb.fpr (O2 (KA.K two) (KA.pt two)) (refl (refl (KA.pt two))) (O2 (KB.K four) (KB.pt four)) (refl (refl (KB.pt four))) g))
         PU.puppe1)
      PJ.iso ;
  -- step 4: Omega^2 K(B,4) = K(B,2) and Omega^3 K(B,4) = K(B,1)
  E2 : PtEquiv (O2 (KB.K four) (KB.pt four)) (refl (refl (KB.pt four))) (KB.K two) (KB.pt two) =
    pt-comp (O2 (KB.K four) (KB.pt four)) (refl (refl (KB.pt four))) (Id (KB.K three) (KB.pt three) (KB.pt three)) (refl (KB.pt three)) (KB.K two) (KB.pt two)
      (loopPE (Id (KB.K four) (KB.pt four) (KB.pt four)) (refl (KB.pt four)) (KB.K three) (KB.pt three) (KB.e three)) (KB.e two) ;
  E1 : PtEquiv O3Y o3y (KB.K (suc zero)) (KB.pt (suc zero)) =
    pt-comp O3Y o3y (Id (KB.K two) (KB.pt two) (KB.pt two)) (refl (KB.pt two)) (KB.K (suc zero)) (KB.pt (suc zero))
      (loopPE (O2 (KB.K four) (KB.pt four)) (refl (refl (KB.pt four))) (KB.K two) (KB.pt two) E2) (KB.e (suc zero)) ;
  s4 : GIso[PiOne[l].PiOne[O3Y, o3y].grp, PiOne[l].PiOne[KB.K (suc zero), KB.pt (suc zero)].grp] =
    pi1-pe O3Y o3y (KB.K (suc zero)) (KB.pt (suc zero)) E1 ;
  -- step 5: the band
  s5 : GIso[PiOne[l].PiOne[KB.K (suc zero), KB.pt (suc zero)].grp, ab-grp Gb] =
    LoopsSetIso[KB.K (suc zero), KB.pt (suc zero), ab-grp Gb, KB.ES.loop0.1, KB.ES.loop0.2, KB.ES.loop0-hom].iso ;

  pi3-iso : GIso[pi3 F f0, ab-grp Gb] =
    gi-comp (pi3 F f0) PiOne[l].PiOne[Fg, fg].grp (ab-grp Gb)
      (gi-comp (pi3 F f0) PiOne[l].PiOne[Id FOk fOk fOk, refl fOk].grp PiOne[l].PiOne[Fg, fg].grp s1 s2)
      (gi-comp PiOne[l].PiOne[Fg, fg].grp PiOne[l].PiOne[O3Y, o3y].grp (ab-grp Gb)
         (gi-inv PiOne[l].PiOne[O3Y, o3y].grp PiOne[l].PiOne[Fg, fg].grp s3)
         (gi-comp PiOne[l].PiOne[O3Y, o3y].grp PiOne[l].PiOne[KB.K (suc zero), KB.pt (suc zero)].grp (ab-grp Gb) s4 s5)) ;
} ;
