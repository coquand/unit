-- (H4) for the cup square (doc/h4.pdf, Section 6, Theorem 19):
--   h4 : KZ2Cohomology.H4 CupSquare.kappa.
-- Phi_B g = [kappa ; K(g,4)] is, by definition, the class of the diagonal of
-- c2 ; K(g,4)_*, so Phi_B = cls o Delta' o (g |-> c2 ; K(g,4)_*), a composite of
-- bijections: Theorem B (H4Bilinear.BilAt), Theorem A (H4Diagonal.DiagAt),
-- Proposition 5 (H4Classes.ClassesAt).  Bijection.Bij gives the inverse and
-- both equations.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Lemma4[l] ; open LoopCalc[l] ; open Torsor[l] ;
open EMMaps[l] ; open HomotopyClasses[l] ; open SphereUniversal[l] ; open PostnikovRealization[l] ; open KZ2Cohomology[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;

module H4At (Gb : Ab) {
  module B = KK[Gb] ;
  module CL = H4Classes[l].ClassesAt[Gb] ;
  module DA = H4Diagonal[l].DiagAt[Gb] ;
  module BA = H4Bilinear[l].BilAt[Gb] ;
  module L = H4Bilinear[l].Lev[Zab, Gb] ;
  -- Phi is, by definition, the class of the diagonal of c2 ; K(g,4)_*, once
  -- KMap.K four is read as the locked K(g,4) (Lev.K-def)
  phi-diag (g : Hom Zab Gb) : Id (HC KZ2 kz2 (B.K four) (B.pt four)) (Phi CupSquare[l].kappa Gb g) (CL.cls (DA.DG.dprime (BA.c2g g))) =
    calc (HC KZ2 kz2 (B.K four) (B.pt four)) {
      Phi CupSquare[l].kappa Gb g
        =< refl (Phi CupSquare[l].kappa Gb g) >
      hcl KZ2 kz2 (B.K four) (B.pt four) (ptcomp KZ2 kz2 KZ4 kz4 (B.K four) (B.pt four) CupSquare[l].kappa (KMap[Zab, Gb, g].K four))
        =< apH (\ G -> hcl KZ2 kz2 (B.K four) (B.pt four) (ptcomp KZ2 kz2 KZ4 kz4 (B.K four) (B.pt four) CupSquare[l].kappa G)) (L.K-def g four) >
      hcl KZ2 kz2 (B.K four) (B.pt four) (ptcomp KZ2 kz2 KZ4 kz4 (B.K four) (B.pt four) CupSquare[l].kappa (L.K g four))
        =< refl (hcl KZ2 kz2 (B.K four) (B.pt four) (ptcomp KZ2 kz2 KZ4 kz4 (B.K four) (B.pt four) CupSquare[l].kappa (L.K g four))) >
      CL.cls (DA.DG.dprime (BA.c2g g)) } ;
  inj (g g' : Hom Zab Gb) (e : Id (HC KZ2 kz2 (B.K four) (B.pt four)) (Phi CupSquare[l].kappa Gb g) (Phi CupSquare[l].kappa Gb g')) : Id (Hom Zab Gb) g g' =
    BA.c2g-inj g g' (DA.diag-inj (BA.c2g g) (BA.c2g g') (CL.cls-inj (DA.DG.dprime (BA.c2g g)) (DA.DG.dprime (BA.c2g g'))
      (transH (symH (phi-diag g)) (transH e (phi-diag g'))))) ;
  surj (z : HC KZ2 kz2 (B.K four) (B.pt four)) : Tr.Trunc[Bijection[l].Fibre (Phi CupSquare[l].kappa Gb) z].carrier =
    TC.map (Bijection[l].Fibre CL.cls z) (Bijection[l].Fibre (Phi CupSquare[l].kappa Gb) z)
      (\ w -> (H4Bilinear[l].H2[Zab, Gb].inv2 (BA.Theta (DA.undiag w.1)),
               transH (phi-diag (H4Bilinear[l].H2[Zab, Gb].inv2 (BA.Theta (DA.undiag w.1))))
                 (transH (apH (\ c -> CL.cls (DA.DG.dprime c)) (BA.c2g-surj (DA.undiag w.1)))
                   (transH (apH CL.cls (DA.diag-surj w.1)) w.2))))
      (CL.cls-surj z) ;
  equiv : isEquiv (Hom Zab Gb) (HC KZ2 kz2 (B.K four) (B.pt four)) (Phi CupSquare[l].kappa Gb) =
    Bijection[l].Bij[Hom Zab Gb, HC KZ2 kz2 (B.K four) (B.pt four), hc-set KZ2 kz2 (B.K four) (B.pt four),
      Phi CupSquare[l].kappa Gb, inj, surj].equiv ;
} ;

h4 : H4 CupSquare[l].kappa = \ Gb -> H4At[Gb].equiv ;
