-- The sphere S^2: the only axiom of the development (milestone A).
--
-- The authorised interface is the universal property of the higher
-- inductive type S^2 = (base, surf : refl base = refl base) for types of
-- the universe of S2: for every X the canonical map
--     ev2 : (S2 -> X) -> (x : X) * Omega^2 (X, x),
--     ev2 f = (f base, ap (ap f) surf)
-- is an equivalence.  (ap f (refl base) is refl (f base) by the
-- computation rule of J, so ap (ap f) surf is a 2-loop at f base.)  This
-- is the non-dependent elimination with its uniqueness, i.e. recursion
-- and the propositional computation rules, stated as one map; it fixes
-- the role of surf and is natural in X by construction (ev2 (g o f) is
-- (g (f base), ap (ap g) (ap (ap f) surf)) up to ap-ap).  It contains no
-- homotopy group of S2.
--
-- Derived here:
--   evPt         the canonical pointed evaluation  Map_*(S2, X) -> Omega^2 X,
--                F |-> (Omega^2 F) surf  (DeloopMaps.Maps.loop twice)
--   evPt-subst   evPt (f, p) = p_* (ap (ap f) surf)   (J on p; then the
--                loopings of a map pointed by refl are ap, LoopConj)
--   pointed-up   evPt is an equivalence: it is, up to evPt-subst, the
--                composite of the Sigma of ump over the base (the pointing
--                is the fibre of evaluation at base) and the contraction
--                of the singleton (x, p : x = x0)
--   evPt-nat     evPt (F ; G) = (Omega^2 G) (evPt F): naturality in X
--                (LoopCalc.loop-comp twice)
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Lemma4[l] ; open DeloopMaps[l] ; open LoopCalc[l] ;
module P1 = Prelude[l+] ;

-- Omega^2 (X, x)
O2 (X : U l) (x : X) : U l = Id (Id X x x) (refl x) (refl x) ;

ev2 (S2 : U l) (base : S2) (surf : O2 S2 base) (X : U l) (f : S2 -> X) : (x : X) * O2 X x =
  (f base, ap (Id S2 base base) (Id X (f base) (f base)) (ap S2 X f base base) (refl base) (refl base) surf) ;

-- the double looping of a pointed map, a pointed map of 2-loop spaces
loop2 (A : U l) (a0 : A) (B : U l) (b0 : B) (F : PtMap A a0 B b0) :
  PtMap (O2 A a0) (refl (refl a0)) (O2 B b0) (refl (refl b0)) =
  Maps[Id A a0 a0, refl a0, Id B b0 b0, refl b0].loop (Maps[A, a0, B, b0].loop F) ;

-- Sigma over an equivalence of bases (induction on the equivalence)
sigma-base (X Y : U l) (K : Equiv X Y) (Phi : Y -> U l) :
  isEquiv ((x : X) * Phi (K.1 x)) ((y : Y) * Phi y) (\ w -> (K.1 w.1, w.2)) =
  Axioms[l].UnivalenceLemmas[univ @l].eqind X (\ Y1 K1 -> (Phi1 : Y1 -> U l) ->
      isEquiv ((x : X) * Phi1 (K1.1 x)) ((y : Y1) * Phi1 y) (\ w -> (K1.1 w.1, w.2)))
    (\ Phi1 -> (idEquiv ((x : X) * Phi1 x)).2) Y K Phi ;

-- transport of 2-loops along a path, an equivalence on the total space
module Contract (X : U l) (x0 : X) {
  Tot : U l = (w : (x : X) * O2 X x) * Id X w.1 x0 ;
  g (t : Tot) : O2 X x0 = subst X (\ x -> O2 X x) t.1.1 x0 t.2 t.1.2 ;
  h (a : O2 X x0) : Tot = ((x0, a), refl x0) ;
  gh (a : O2 X x0) : Id (O2 X x0) (g (h a)) a = refl a ;
  hg-gen (x : X) (a : O2 X x) : (y : X) (p : Id X x y) ->
    Id ((w : (z : X) * O2 X z) * Id X w.1 y) ((y, subst X (\ z -> O2 X z) x y p a), refl y) ((x, a), p) =
    \ y p -> idJ X x (\ y1 p1 -> Id ((w : (z : X) * O2 X z) * Id X w.1 y1) ((y1, subst X (\ z -> O2 X z) x y1 p1 a), refl y1) ((x, a), p1))
      (refl ((x, a), refl x)) y p ;
  hg (t : Tot) : Id Tot (h (g t)) t = hg-gen t.1.1 t.1.2 x0 t.2 ;
  equiv : isEquiv Tot (O2 X x0) g = qinv Tot (O2 X x0) g h gh hg ;
} ;

module Sphere (S2 : U l) (base : S2) (surf : O2 S2 base)
  (ump : (X : U l) -> isEquiv (S2 -> X) ((x : X) * O2 X x) (ev2 S2 base surf X)) {

  evPt (X : U l) (x0 : X) (F : PtMap S2 base X x0) : O2 X x0 = (loop2 S2 base X x0 F).1 surf ;

  -- for a map pointed by refl, the looping is ap (up to refl . -)
  module Refl (X : U l) (f : S2 -> X) {
    F : PtMap S2 base X (f base) = (f, refl (f base)) ;
    J : PtMap (Id S2 base base) (refl base) (Id X (f base) (f base)) (refl (f base)) = Maps[S2, base, X, (f base)].loop F ;
    K : PtMap (Id S2 base base) (refl base) (Id X (f base) (f base)) (refl (f base)) = (ap S2 X f base base, refl (refl (f base))) ;
    H (q : Id S2 base base) : Id (Id X (f base) (f base)) (J.1 q) (K.1 q) =
      transH (Maps[S2, base, X, (f base)].loop-ap F q) (trans-refl-l X (f base) (f base) (ap S2 X f base base q)) ;
    module LH = LoopConj[l].LoopHomotopy[Id S2 base base, refl base, Id X (f base) (f base), refl (f base), J, K, H] ;
    -- the conjugating 2-loop is refl by computation
    c-refl : Id (O2 X (f base)) LH.c (refl (refl (f base))) = refl (refl (refl (f base))) ;
    -- loop K at surf is ap (ap f) surf
    loopK : Id (O2 X (f base)) ((Maps[Id S2 base base, refl base, Id X (f base) (f base), refl (f base)].loop K).1 surf)
        (ap (Id S2 base base) (Id X (f base) (f base)) (ap S2 X f base base) (refl base) (refl base) surf) =
      transH (Maps[Id S2 base base, refl base, Id X (f base) (f base), refl (f base)].loop-ap K surf)
        (trans-refl-l (Id X (f base) (f base)) (refl (f base)) (refl (f base)) (ap (Id S2 base base) (Id X (f base) (f base)) (ap S2 X f base base) (refl base) (refl base) surf)) ;
    -- evPt F = conj refl (evPt F) = conj c (evPt F) = loop K surf = ap (ap f) surf
    eq : Id (O2 X (f base)) (evPt X (f base) F) (ap (Id S2 base base) (Id X (f base) (f base)) (ap S2 X f base base) (refl base) (refl base) surf) =
      calc (O2 X (f base)) {
        evPt X (f base) F
          =< symH (LoopConj[l].conj-refl-loop (Id X (f base) (f base)) (refl (f base)) (evPt X (f base) F)) >
        LoopConj[l].conj (Id X (f base) (f base)) (refl (f base)) (refl (f base)) (refl (refl (f base))) (evPt X (f base) F)
          =< apH (\ c -> LoopConj[l].conj (Id X (f base) (f base)) (refl (f base)) (refl (f base)) c (evPt X (f base) F)) (symH c-refl) >
        LoopConj[l].conj (Id X (f base) (f base)) (refl (f base)) (refl (f base)) LH.c (evPt X (f base) F)
          =< symH (LH.loop-homotopy surf) >
        (Maps[Id S2 base base, refl base, Id X (f base) (f base), refl (f base)].loop K).1 surf
          =< loopK >
        ap (Id S2 base base) (Id X (f base) (f base)) (ap S2 X f base base) (refl base) (refl base) surf } ;
  } ;

  evPt-subst (X : U l) (f : S2 -> X) : (x0 : X) (p : Id X (f base) x0) ->
    Id (O2 X x0) (evPt X x0 (f, p)) (subst X (\ x -> O2 X x) (f base) x0 p (ev2 S2 base surf X f).2) =
    \ x0 p -> idJ X (f base) (\ x1 p1 -> Id (O2 X x1) (evPt X x1 (f, p1)) (subst X (\ x -> O2 X x) (f base) x1 p1 (ev2 S2 base surf X f).2))
      Refl[X, f].eq x0 p ;

  -- the universal property for pointed maps
  pointed-up (X : U l) (x0 : X) : isEquiv (PtMap S2 base X x0) (O2 X x0) (evPt X x0) =
    Equivalences[l].homotopy (PtMap S2 base X x0) (O2 X x0)
      (Equivalences[l].compose (PtMap S2 base X x0) Contract[X, x0].Tot (O2 X x0)
        (\ w -> (ev2 S2 base surf X w.1, w.2),
         sigma-base (S2 -> X) ((x : X) * O2 X x) (ev2 S2 base surf X, ump X) (\ w -> Id X w.1 x0))
        (Contract[X, x0].g, Contract[X, x0].equiv))
      (evPt X x0) (\ F -> evPt-subst X F.1 x0 F.2) ;

  pointed-equiv (X : U l) (x0 : X) : Equiv (PtMap S2 base X x0) (O2 X x0) = (evPt X x0, pointed-up X x0) ;

  -- naturality in X
  evPt-nat (X : U l) (x0 : X) (Y : U l) (y0 : Y) (F : PtMap S2 base X x0) (G : PtMap X x0 Y y0) :
    Id (O2 Y y0) (evPt Y y0 (ptcomp S2 base X x0 Y y0 F G)) ((loop2 X x0 Y y0 G).1 (evPt X x0 F)) =
    transH
      (pt-happly-l (Maps[S2, base, Y, y0].loop (ptcomp S2 base X x0 Y y0 F G))
         (ptcomp (Id S2 base base) (refl base) (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0) (Maps[S2, base, X, x0].loop F) (Maps[X, x0, Y, y0].loop G))
         (loop-comp S2 base X x0 Y y0 F G))
      (apH (\ M -> M.1 surf)
         (loop-comp (Id S2 base base) (refl base) (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0) (Maps[S2, base, X, x0].loop F) (Maps[X, x0, Y, y0].loop G)))
  where {
    pt-happly-l (M M' : PtMap (Id S2 base base) (refl base) (Id Y y0 y0) (refl y0)) (e : Id (PtMap (Id S2 base base) (refl base) (Id Y y0 y0) (refl y0)) M M') :
      Id (O2 Y y0) ((Maps[Id S2 base base, refl base, Id Y y0 y0, refl y0].loop M).1 surf) ((Maps[Id S2 base base, refl base, Id Y y0 y0, refl y0].loop M').1 surf) =
      apH (\ N -> (Maps[Id S2 base base, refl base, Id Y y0 y0, refl y0].loop N).1 surf) e ;
  } ;
} ;
