-- Paths in Ab (doc/postnikov-classification.pdf, Lemma 5): an additive
-- bijection h : G.A ~ H.A gives G = H in Ab.
--   R A ad      the rest of an abelian group structure with addition ad,
--               in an order where it is a proposition (rest-prop): the
--               set, assoc and comm are propositions, then a unit is unique
--               (unit-prop, by comm), then an inverse is unique (inv-prop)
--   mk, ab-eta  Ab from (A, ad, r); G = mk G.A G.add (rest G) (split)
--   ab-path     induction on the equivalence (Torsor.eqind): at the
--               identity, G.add = ad' pointwise, so the structures agree
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Torsor[l] ; open EMMaps[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module P1 = Prelude[l+] ;

-- the rest of the structure, for a given addition
UnitP (A : U l) (ad : A -> A -> A) (o : A) : U l = (x : A) -> Id A (ad x o) x ;
Unit (A : U l) (ad : A -> A -> A) : U l = (o : A) * UnitP A ad o ;
InvP (A : U l) (ad : A -> A -> A) (o : A) (i : A -> A) : U l = (x : A) -> Id A (ad x (i x)) o ;
Inv (A : U l) (ad : A -> A -> A) (o : A) : U l = (i : A -> A) * InvP A ad o i ;
AssocP (A : U l) (ad : A -> A -> A) : U l = (x y w : A) -> Id A (ad (ad x y) w) (ad x (ad y w)) ;
CommP (A : U l) (ad : A -> A -> A) : U l = (x y : A) -> Id A (ad x y) (ad y x) ;
R4 (A : U l) (ad : A -> A -> A) : U l = (u : Unit A ad) * Inv A ad u.1 ;
R3 (A : U l) (ad : A -> A -> A) : U l = (c : CommP A ad) * R4 A ad ;
R2 (A : U l) (ad : A -> A -> A) : U l = (as : AssocP A ad) * R3 A ad ;
R (A : U l) (ad : A -> A -> A) : U l = (s : isSet A) * R2 A ad ;

-- accessors
r-set (A : U l) (ad : A -> A -> A) (r : R A ad) : isSet A = r.1 ;
r-assoc (A : U l) (ad : A -> A -> A) (r : R A ad) : AssocP A ad = r.2.1 ;
r-comm (A : U l) (ad : A -> A -> A) (r : R A ad) : CommP A ad = r.2.2.1 ;
r-unit (A : U l) (ad : A -> A -> A) (r : R A ad) : Unit A ad = r.2.2.2.1 ;
r-inv (A : U l) (ad : A -> A -> A) (r : R A ad) : Inv A ad (r-unit A ad r).1 = r.2.2.2.2 ;

mk (A : U l) (ad : A -> A -> A) (r : R A ad) : Ab =
  new Ab[A, r-set A ad r, (r-unit A ad r).1, ad, (r-inv A ad r).1, r-assoc A ad r, r-comm A ad r,
    (r-unit A ad r).2, (r-inv A ad r).2] ;

rest (G : Ab) : R G.A G.add = (G.setA, G.assoc, G.comm, (G.o, G.unitr), (G.inv, G.invr)) ;

ab-eta : (G : Ab) -> Id Ab (mk G.A G.add (rest G)) G = split {
  Ab a s o ad i as c u iv -> refl (new Ab[a, s, o, ad, i, as, c, u, iv]) } ;

------------------------------------------------------------------------
-- R A ad is a proposition

module Props (A : U l) (ad : A -> A -> A) (s : isSet A) {
  assoc-prop : isProp (AssocP A ad) =
    FL.isProp-Pi A (\ x -> (y w : A) -> Id A (ad (ad x y) w) (ad x (ad y w))) (\ x ->
    FL.isProp-Pi A (\ y -> (w : A) -> Id A (ad (ad x y) w) (ad x (ad y w))) (\ y ->
    FL.isProp-Pi A (\ w -> Id A (ad (ad x y) w) (ad x (ad y w))) (\ w -> s (ad (ad x y) w) (ad x (ad y w))))) ;
  comm-prop : isProp (CommP A ad) =
    FL.isProp-Pi A (\ x -> (y : A) -> Id A (ad x y) (ad y x)) (\ x ->
    FL.isProp-Pi A (\ y -> Id A (ad x y) (ad y x)) (\ y -> s (ad x y) (ad y x))) ;
  unitP-prop (o : A) : isProp (UnitP A ad o) = FL.isProp-Pi A (\ x -> Id A (ad x o) x) (\ x -> s (ad x o) x) ;
  invP-prop (o : A) (i : A -> A) : isProp (InvP A ad o i) = FL.isProp-Pi A (\ x -> Id A (ad x (i x)) o) (\ x -> s (ad x (i x)) o) ;

  -- a unit is unique
  unit-prop (c : CommP A ad) : isProp (Unit A ad) = \ u u' ->
    Sigma-eq A (UnitP A ad) u.1 u'.1 u.2 u'.2 (calc A {
        u.1 =< symH (u'.2 u.1) > ad u.1 u'.1
          =< c u.1 u'.1 > ad u'.1 u.1
          =< u.2 u'.1 > u'.1 })
      (unitP-prop u'.1) ;

  -- an inverse is unique
  inv-prop (as : AssocP A ad) (c : CommP A ad) (u : Unit A ad) : isProp (Inv A ad u.1) = \ v v' ->
    Sigma-eq (A -> A) (InvP A ad u.1) v.1 v'.1 v.2 v'.2
      (FL.funext A (\ x -> A) v.1 v'.1 (\ x -> calc A {
        v.1 x =< symH (u.2 (v.1 x)) > ad (v.1 x) u.1
          =< apH (ad (v.1 x)) (symH (v'.2 x)) > ad (v.1 x) (ad x (v'.1 x))
          =< symH (as (v.1 x) x (v'.1 x)) > ad (ad (v.1 x) x) (v'.1 x)
          =< apH (\ z -> ad z (v'.1 x)) (c (v.1 x) x) > ad (ad x (v.1 x)) (v'.1 x)
          =< apH (\ z -> ad z (v'.1 x)) (v.2 x) > ad u.1 (v'.1 x)
          =< c u.1 (v'.1 x) > ad (v'.1 x) u.1
          =< u.2 (v'.1 x) > v'.1 x }))
      (invP-prop u.1 v'.1) ;

  r4-prop (as : AssocP A ad) (c : CommP A ad) : isProp (R4 A ad) =
    isProp-Sigma (Unit A ad) (\ u -> Inv A ad u.1) (unit-prop c) (\ u -> inv-prop as c u) ;
  r2-prop : isProp (R2 A ad) =
    isProp-Sigma (AssocP A ad) (\ as -> R3 A ad) assoc-prop (\ as ->
      isProp-Sigma (CommP A ad) (\ c -> R4 A ad) comm-prop (\ c -> r4-prop as c)) ;
} ;

rest-prop (A : U l) (ad : A -> A -> A) : isProp (R A ad) =
  isProp-Sigma (isSet A) (\ s -> R2 A ad) (isProp-isSet A) (\ s -> Props[A, ad, s].r2-prop) ;

------------------------------------------------------------------------
-- Lemma 5

-- structures with pointwise equal additions are equal
mk-eq (A : U l) (ad ad' : A -> A -> A) (h : (x y : A) -> Id A (ad x y) (ad' x y)) (r : R A ad) (r' : R A ad')
  : Id Ab (mk A ad r) (mk A ad' r') =
  P1.ap ((a : A -> A -> A) * R A a) Ab (\ w -> mk A w.1 w.2) (ad, r) (ad', r')
    (Sigma-eq (A -> A -> A) (R A) ad ad' r r'
      (FL.funext A (\ x -> A -> A) ad ad' (\ x -> FL.funext A (\ y -> A) (ad x) (ad' x) (\ y -> h x y)))
      (rest-prop A ad')) ;

AddEq (G : Ab) (T : U l) (e : Equiv G.A T) (ad : T -> T -> T) : U l =
  (x y : G.A) -> Id T (e.1 (G.add x y)) (ad (e.1 x) (e.1 y)) ;

Mot (G : Ab) (T : U l) (e : Equiv G.A T) : U l+ =
  (ad : T -> T -> T) (r : R T ad) -> AddEq G T e ad -> Id Ab G (mk T ad r) ;

mot-id (G : Ab) : Mot G G.A (idEquiv G.A) = \ ad r h ->
  P1.trans Ab G (mk G.A G.add (rest G)) (mk G.A ad r)
    (P1.sym Ab (mk G.A G.add (rest G)) G (ab-eta G))
    (mk-eq G.A G.add ad h (rest G) r) ;

ab-path (G H : Ab) (h : Hom G H) (eh : isEquiv G.A H.A h.1) : Id Ab G H =
  P1.trans Ab G (mk H.A H.add (rest H)) H
    (eqind G.A (Mot G) (mot-id G) H.A (h.1, eh) H.add (rest H) h.2)
    (ab-eta H) ;
