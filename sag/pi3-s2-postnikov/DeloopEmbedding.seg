-- Delooping is an embedding (doc/delooping-embedding.pdf; the idea is David
-- Wärn's): Omega : SC4 -> SC3 from pointed 2-connected 4-types to pointed
-- 1-connected 3-types, and the deloopable triples.
--   SC4, Omega    Definition: SC4 = (Y : U) * (y : Y) * isConn 4 Y * isTrunc 6 Y
--                 (ClassBase.PtProp), Omega (Y, y) = (y = y, refl, ..)
--   LoopEq[u,v]   Lemma 2: om = LoopIso.loopPE on pointed equivalences has the
--                 section delta g = (dl g, Whitehead): dl = the inverse of looping
--                 on pointed maps (Lemma 1 = SourceS3.LoopEquiv at c = 2, Cor. 11),
--                 loop (dl f) = f (dl-eq), so loop (dl g) is an equivalence (el)
--   E[u]          Theorem E: T1 = (v) * u ~pt v is contractible (PtProp.contr);
--                 T2 = (v) * Omega u ~pt Omega v is a retract of T1 (delta, om,
--                 loop-delta); T3 = (v) * (Omega u = Omega v) a retract of T2
--                 (PtProp at SC3: tr, un, un-tr)
--   Emb[u]        the fundamental theorem at T3: transport of refl is an
--                 equivalence, and it is ap Omega (J: tr-ap), so ap Omega is one
--                 (emb); fib-prop: the fibres of Omega are propositions
--   Deloopable    Corollary C: Deloopable t = fib Omega (realise t), a proposition;
--                 tot-equiv ((w : SC3) * fib Omega w ~ SC4, (w, (v, p)) |-> v),
--                 sc4-equiv ((t : Triples) * Deloopable t ~ SC4: sigma-base along
--                 the classification, then tot-equiv)
--   deloop-R      step 1: (Z, Z/2, kbar) is deloopable, by BR (omega-BR, BR-conn,
--                 BR-trunc); BR-Tor: BR ~pt Tor_R, the two deloopings of R agree
--   Mark          step 2 (statement M): Marked u = s^* : [BR, Y]_* -> [S3, Y]_*
--                 bijective; marked: M for every Y : SC4, under the S^3 axiom, by
--                 Presentation4.Pres4 (merely pointed; M is a proposition) and
--                 SourceS3.Final.rep-pteq.  The Crux (doc, section 5: every
--                 deloopable triple is a looping) is not formalised.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ; open HLevels[l] ; open Connected[l] ;
open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ; open SphereUniversal[l] ; open PostnikovRealization[l] ;
open EMMaps[l] ; open HomotopyClasses[l] ; open Sphere3Axiom[l] ; open KZ2Cohomology[l] ; open Z2[l] ; open CrossTerm[l] ;
module P1 = Prelude[l+] ; module H1 = HLevels[l+] ; module FU1 = FunExtUA[l+] ; module E1 = Equivalences[l+] ;
module CB = ClassBase[l] ; module CP = ClassPost[l] ; module PC = PostnikovClassification[l] ;
module W = Whitehead[l] ; module LI = LoopIso[l] ; module S3S = SourceS3[l] ; module DR = DeloopR[l] ;
module Pr4 = Presentation4[l] ; module MB = MapBR[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;

------------------------------------------------------------------------
-- Definition: SC4 and Omega

P4 (Y : U l) : U l = isConn four Y * isTrunc (suc five) Y ;
p4-prop (Y : U l) : isProp (P4 Y) =
  isProp-Sigma (isConn four Y) (\ c -> isTrunc (suc five) Y) (conn-prop four Y) (\ c -> trunc-prop (suc five) Y) ;
module PS4 = CB.PtProp[P4, p4-prop] ;
SC4 : U l+ = PS4.PP ;

-- accessors
module Acs (u : SC4) {
  Y : U l = u.1 ;
  y : Y = u.2.1 ;
  conn : isConn four Y = u.2.2.1 ;
  trunc : isTrunc (suc five) Y = u.2.2.2 ;
  -- Y is connected
  conn2 : isConn two Y = conn-down two Y (conn-down three Y conn) ;
} ;

Omega (u : SC4) : CP.SC3 =
  (Id Acs[u].Y Acs[u].y Acs[u].y, refl Acs[u].y,
   (conn-id three Acs[u].Y Acs[u].conn Acs[u].y Acs[u].y, Acs[u].trunc Acs[u].y Acs[u].y)) ;

------------------------------------------------------------------------
-- Lemma 2: looping of pointed equivalences has a section

module LoopEq (u v : SC4) {
  module A = Acs[u] ; module B = Acs[v] ;
  -- Lemma 1 (Corollary 11 at c = 2)
  module LE = S3S.LoopEquiv[A.Y, A.y, B.Y, B.y, two, A.conn, B.trunc] ;
  OEq : U l = PtEquiv (Id A.Y A.y A.y) (refl A.y) (Id B.Y B.y B.y) (refl B.y) ;
  om (F : PtEquiv A.Y A.y B.Y B.y) : OEq = LI.loopPE A.Y A.y B.Y B.y F ;
  -- the delooping of a map of loop spaces
  dl (f : LE.M.PMO) : PtMap A.Y A.y B.Y B.y = LE.equiv.sec f ;
  dl-eq (f : LE.M.PMO) : Id LE.M.PMO (LE.M.loop (dl f)) f = LE.equiv.sec-eq f ;
  IsE (f : LE.M.PMO) : U l = isEquiv (Id A.Y A.y A.y) (Id B.Y B.y B.y) f.1 ;
  el (g : OEq) : IsE (LE.M.loop (dl g.1)) =
    subst LE.M.PMO IsE g.1 (LE.M.loop (dl g.1)) (sym LE.M.PMO (LE.M.loop (dl g.1)) g.1 (dl-eq g.1)) g.2 ;
  delta (g : OEq) : PtEquiv A.Y A.y B.Y B.y = (dl g.1, W.Pointed[A.Y, A.y, B.Y, B.y, dl g.1, A.conn2, el g].equiv B.conn2) ;
  -- by definition, the looping of delta g is loop (dl g)
  om-delta (g : OEq) : Id LE.M.PMO (om (delta g)).1 (LE.M.loop (dl g.1)) = refl (LE.M.loop (dl g.1)) ;
  -- the first components agree (om-delta, dl-eq); the second ones lie in a proposition
  fst-eq (g : OEq) : Id LE.M.PMO (om (delta g)).1 g.1 =
    trans LE.M.PMO (om (delta g)).1 (LE.M.loop (dl g.1)) g.1 (om-delta g) (dl-eq g.1) ;
  loop-delta (g : OEq) : Id OEq (om (delta g)) g =
    Sigma-path LE.M.PMO IsE (om (delta g)).1 g.1 (om (delta g)).2 g.2 (fst-eq g)
      (EquivProp[l].isEquiv-prop (Id A.Y A.y A.y) (Id B.Y B.y B.y) g.1.1
         (subst LE.M.PMO IsE (om (delta g)).1 g.1 (fst-eq g) (om (delta g)).2) g.2) ;
} ;

------------------------------------------------------------------------
-- Theorem E

module E (u : SC4) {
  T1 : U l+ = (v : SC4) * PS4.R u v ;
  T2 : U l+ = (v : SC4) * LoopEq[u, v].OEq ;
  T3 : U l+ = (v : SC4) * Id CP.SC3 (Omega u) (Omega v) ;
  -- by definition, the pointed equivalences of SC3 between loop spaces are OEq
  r-def (v : SC4) : Id (U l) (CP.PS.R (Omega u) (Omega v)) LoopEq[u, v].OEq = refl LoopEq[u, v].OEq ;
  contr1 : FU1.isContr T1 = PS4.contr u ;
  contr2 : FU1.isContr T2 =
    H1.retract-contr T2 T1 (\ a -> (a.1, LoopEq[u, a.1].delta a.2)) (\ b -> (b.1, LoopEq[u, b.1].om b.2))
      (\ a -> P1.ap LoopEq[u, a.1].OEq T2 (\ g -> (a.1, g)) (LoopEq[u, a.1].om (LoopEq[u, a.1].delta a.2)) a.2
                (LoopEq[u, a.1].loop-delta a.2))
      contr1 ;
  module I3 = CP.PS.I[Omega u] ;
  contr3 : FU1.isContr T3 =
    H1.retract-contr T3 T2 (\ a -> (a.1, I3.F.tr (Omega a.1) a.2)) (\ b -> (b.1, I3.F.un (Omega b.1) b.2))
      (\ a -> P1.ap (Id CP.SC3 (Omega u) (Omega a.1)) T3 (\ p -> (a.1, p))
                (I3.F.un (Omega a.1) (I3.F.tr (Omega a.1) a.2)) a.2 (I3.F.un-tr (Omega a.1) a.2))
      contr2 ;
} ;

module Emb (u : SC4) {
  module F = FundThm[l+].FT[SC4, u, \ v -> Id CP.SC3 (Omega u) (Omega v), refl (Omega u), E[u].contr3] ;
  -- transport of refl is ap Omega
  tr-ap (v : SC4) (p : Id SC4 u v) : Id (Id CP.SC3 (Omega u) (Omega v)) (P1.ap SC4 CP.SC3 Omega u v p) (F.tr v p) =
    idJ SC4 u (\ v1 p1 -> Id (Id CP.SC3 (Omega u) (Omega v1)) (P1.ap SC4 CP.SC3 Omega u v1 p1) (F.tr v1 p1))
      (refl (refl (Omega u))) v p ;
  emb (v : SC4) : P1.isEquiv (Id SC4 u v) (Id CP.SC3 (Omega u) (Omega v)) (P1.ap SC4 CP.SC3 Omega u v) =
    E1.homotopy (Id SC4 u v) (Id CP.SC3 (Omega u) (Omega v)) (F.tr v, F.equiv v) (P1.ap SC4 CP.SC3 Omega u v) (tr-ap v) ;
} ;

-- the fibres of Omega
fibO (w : CP.SC3) : U l+ = (v : SC4) * Id CP.SC3 (Omega v) w ;
fib-prop (w : CP.SC3) : P1.isProp (fibO w) = Groupoid[l+].emb-fib-prop SC4 CP.SC3 Omega (\ u v -> Emb[u].emb v) w ;

------------------------------------------------------------------------
-- Corollary C

Deloopable (t : PC.Triples) : U l+ = fibO (PC.realise t) ;
deloopable-prop (t : PC.Triples) : P1.isProp (Deloopable t) = fib-prop (PC.realise t) ;

-- the total space of the fibres of Omega is SC4
tot-ret (v : SC4) (w : CP.SC3) (p : Id CP.SC3 (Omega v) w) :
  Id ((w1 : CP.SC3) * fibO w1) (Omega v, (v, refl (Omega v))) (w, (v, p)) =
  idJ CP.SC3 (Omega v) (\ w1 p1 -> Id ((w2 : CP.SC3) * fibO w2) (Omega v, (v, refl (Omega v))) (w1, (v, p1)))
    (refl (Omega v, (v, refl (Omega v)))) w p ;
tot-equiv : P1.isEquiv ((w : CP.SC3) * fibO w) SC4 (\ z -> z.2.1) =
  P1.qinv ((w : CP.SC3) * fibO w) SC4 (\ z -> z.2.1) (\ v -> (Omega v, (v, refl (Omega v))))
    (\ v -> refl v) (\ z -> tot-ret z.2.1 z.1 z.2.2) ;

sc4-equiv : P1.Equiv ((t : PC.Triples) * Deloopable t) SC4 =
  E1.compose ((t : PC.Triples) * Deloopable t) ((w : CP.SC3) * fibO w) SC4
    ((\ z -> (PC.realise z.1, z.2)), SphereAxiom[l+].sigma-base PC.Triples CP.SC3 PC.classification fibO)
    ((\ z -> z.2.1), tot-equiv) ;

------------------------------------------------------------------------
-- step 1: R = Fib kbar deloops

tbar : PC.Triples = (Zab, Z2ab, kbar) ;
BR-pt : SC4 = (DR.BR, DR.br0, (DR.BR-conn, DR.BR-trunc)) ;
deloop-R : Deloopable tbar = (BR-pt, CP.PS.I[Omega BR-pt].path (PC.realise tbar) DR.omega-BR) ;

-- the torsor delooping of R
Tor-pt : SC4 = (DR.T.Tor, DR.DT.ptT, (DR.tor-conn, DR.tor-trunc)) ;
deloop-Tor : Deloopable tbar = (Tor-pt, CP.PS.I[Omega Tor-pt].path (PC.realise tbar) DR.tor-loops) ;

-- uniqueness of the delooping
BR-Tor : PtEquiv DR.BR DR.br0 DR.T.Tor DR.DT.ptT =
  (PS4.I[BR-pt].equiv Tor-pt).1
    (P1.ap (Deloopable tbar) SC4 (\ z -> z.1) deloop-R deloop-Tor (deloopable-prop tbar deloop-R deloop-Tor)) ;

------------------------------------------------------------------------
-- step 2: the marked universal property of BR, statement M

module Mark (S3 : U l) (base : S3) (surf : O3 S3 base)
  (ump3 : (X : U l) -> isEquiv (S3 -> X) ((x : X) * O3 X x) (ev3 S3 base surf X)) {
  module FS = S3S.Final[S3, base, surf, ump3] ;
  Marked (u : SC4) : U l =
    isEquiv (HC DR.BR DR.br0 Acs[u].Y Acs[u].y) (HC S3 base Acs[u].Y Acs[u].y) (\ c -> compC S3 base DR.BR DR.br0 Acs[u].Y Acs[u].y FS.s c) ;
  -- M for every pointed 2-connected 4-type, through its presentation (pointed merely)
  module At (u : SC4) {
    module PR = Pr4.Pres4[Acs[u].Y, Acs[u].y, Acs[u].conn, Acs[u].trunc] ;
    module T3 = MB.Triple3[PR.RV.O.ab, PR.RF.R.O.ab, PR.K] ;
    marked : Marked u =
      TC.rec (Id Acs[u].Y (PR.fib-K.1 T3.f0) Acs[u].y) @l (Marked u)
        (EquivProp[l].isEquiv-prop (HC DR.BR DR.br0 Acs[u].Y Acs[u].y) (HC S3 base Acs[u].Y Acs[u].y) (\ c -> compC S3 base DR.BR DR.br0 Acs[u].Y Acs[u].y FS.s c))
        (\ a -> FS.rep-pteq PR.RV.O.ab PR.RF.R.O.ab PR.K Acs[u].Y Acs[u].y (PR.pres a))
        PR.pres-pt ;
  } ;
  marked (u : SC4) : Marked u = At[u].marked ;
} ;
