-- pi_3(S^2) = Z through maps of triples (doc/postnikov-morphisms.pdf, Section 5).
-- Informal proof: the note.  t0 = (Z, Z, kappa), t' = (A', B', k') arbitrary.
--   Theta[t']    Proposition theta: hom(t0, t') = ||Mor t0 t'||_0 -> Hom(Z, A'),
--                [m] |-> mor-a m, is a bijection: surj by (H4) (b = Phi^-1 [K(a,2) ; k']),
--                inj by (H4) on b (inj-at) and Lemma components with (H3) on the
--                homotopies (unique-H; h3c: every map K(Z,2) -> Omega^2 K(B',5) is merely
--                constant, from H3 along K(B',3) ~pt Omega^2 K(B',5))
--   Final[S2,..].At[t']   Proposition mark3: s^* : [P, Fib k']_* -> [S2, Fib k']_* is a
--                bijection: square (q'_* (s ; [realise-map m]) = [sigma ; K(a,2)]:
--                fm-over, comp-assoc, comp-beta, s-eq), sgm-equiv (hk-equiv, sigma-cls),
--                classes-equiv of Theorem 1, MapFib.SourceS.qS (the source S2), 2-out-of-3
--   Final.rep, map-thm, pi3-S2    for every X : SC3 by the classification;
--                Pi3Sphere.Conditional.pi3-S2-T.
-- Not used: MapFib.Final.rep-fib, Lifting at the source P, FibreH3.fib-h3, Presentation.
-- Used: the marked class MapFib.Final.s (qS at S2 and sigma).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ; open HLevels[l] ; open Connected[l] ; open Lemma4[l] ;
open DeloopMaps[l] ; open LoopCalc[l] ; open PtEquivOps[l] ; open EMMaps[l] ; open Group[l] ; open Torsor[l] ;
open HomotopyClasses[l] ; open HomotopyGroups[l] ; open SphereAxiom[l] ; open SphereUniversal[l] ; open PostnikovRealization[l] ; open KZ2Cohomology[l] ;
open LoopIso[l] ; open TripleMaps[l] ; open TripleMapsEquiv[l] ; open TripleComponents[l] ;
module P1 = Prelude[l+] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module E = Equivalences[l] ; module W = Whitehead[l] ; module Fb = Fibres[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Bj = Bijection[l] ; module HB = H4Bilinear[l] ; module CS = CupSquare[l] ; module MF = MapFib[l] ; module FM = FibMap[l] ;
module PC = PostnikovClassification[l] ; module CP = ClassPost[l] ;

-- homomorphisms of abelian groups form a set
hom-set (Ga Gb : Ab) : isSet (Hom Ga Gb) =
  isSet-Sigma (Ga.A -> Gb.A) (\ h -> (x y : Ga.A) -> Id Gb.A (h (Ga.add x y)) (Gb.add (h x) (h y)))
    (FL.isSet-Pi Ga.A (\ x -> Gb.A) (\ x -> Gb.setA))
    (\ h -> prop-to-set ((x y : Ga.A) -> Id Gb.A (h (Ga.add x y)) (Gb.add (h x) (h y))) (HB.H2[Ga, Gb].hom-prop h)) ;

------------------------------------------------------------------------
-- Proposition theta

-- (H3) for the compatible homotopies: two paths between pointed maps
-- K(Z,2) -> K(B',4) are merely equal (Lemma components, along
-- K(B',3) ~pt Omega^2 K(B',5) and Omega K(B',5) ~pt K(B',4))
module H3U (Gb' : Ab) {
  module KB' = KK[Gb'] ;
  O2K5 : U l = Id (Id (KB'.K five) (KB'.pt five) (KB'.pt five)) (refl (KB'.pt five)) (refl (KB'.pt five)) ;
  cOO : isConn two O2K5 =
    conn-down two O2K5 (conn-down three O2K5 (conn-id four (Id (KB'.K five) (KB'.pt five) (KB'.pt five))
      (conn-id five (KB'.K five) (KB'.conn four) (KB'.pt five) (KB'.pt five)) (refl (KB'.pt five)) (refl (KB'.pt five)))) ;
  e2 : PtEquiv O2K5 (refl (refl (KB'.pt five))) (KB'.K three) (KB'.pt three) =
    pt-comp O2K5 (refl (refl (KB'.pt five))) (Id (KB'.K four) (KB'.pt four) (KB'.pt four)) (refl (KB'.pt four)) (KB'.K three) (KB'.pt three)
      (loopPE (Id (KB'.K five) (KB'.pt five) (KB'.pt five)) (refl (KB'.pt five)) (KB'.K four) (KB'.pt four) (HB.Lev[Gb', Gb'].eB four))
      (HB.Lev[Gb', Gb'].eB three) ;
  h3m (m : PtMap KZ2 kz2 (KB'.K three) (KB'.pt three)) : Tr.Trunc[Id (PtMap KZ2 kz2 (KB'.K three) (KB'.pt three)) m (\ x -> KB'.pt three, refl (KB'.pt three))].carrier =
    STr[PtMap KZ2 kz2 (KB'.K three) (KB'.pt three)].effective m (\ x -> KB'.pt three, refl (KB'.pt three))
      (pathC (HC KZ2 kz2 (KB'.K three) (KB'.pt three)) (H3Proof[l].h3 Gb') (hcl KZ2 kz2 (KB'.K three) (KB'.pt three) m)
         (hcl KZ2 kz2 (KB'.K three) (KB'.pt three) (\ x -> KB'.pt three, refl (KB'.pt three)))) ;
  h3c : (m : PtMap KZ2 kz2 O2K5 (refl (refl (KB'.pt five)))) -> Tr.Trunc[Id (PtMap KZ2 kz2 O2K5 (refl (refl (KB'.pt five)))) m (\ x -> refl (refl (KB'.pt five)), refl (refl (refl (KB'.pt five))))].carrier =
    const-pt KZ2 kz2 (KB'.K three) (KB'.pt three) h3m O2K5 (refl (refl (KB'.pt five)))
      (pt-inv O2K5 (refl (refl (KB'.pt five))) (KB'.K three) (KB'.pt three) e2) ;
  unique-H (f g : PtMap KZ2 kz2 (KB'.K four) (KB'.pt four)) (H H' : Id (PtMap KZ2 kz2 (KB'.K four) (KB'.pt four)) f g) :
    Tr.Trunc[Id (Id (PtMap KZ2 kz2 (KB'.K four) (KB'.pt four)) f g) H H'].carrier =
    unique-pt KZ2 kz2 (KB'.K five) (KB'.pt five) cOO h3c (KB'.K four) (KB'.pt four) (HB.Lev[Gb', Gb'].eB four) f g H H' ;
} ;

-- a |-> [K(a,2)] is a bijection Hom(Z, A') -> [K(Z,2), K(A',2)]_*
module KCls (Ga' : Ab) {
  module KA' = KK[Ga'] ;
  module LA = HB.Lev[Zab, Ga'] ;
  module H2 = HB.H2[Zab, Ga'] ;
  module SV = STr[PtMap KZ2 kz2 (KA'.K two) (KA'.pt two)] ;
  hk (a : Hom Zab Ga') : HC KZ2 kz2 (KA'.K two) (KA'.pt two) = hcl KZ2 kz2 (KA'.K two) (KA'.pt two) (LA.K a two) ;
  hk-inj (a a' : Hom Zab Ga') (e : Id (HC KZ2 kz2 (KA'.K two) (KA'.pt two)) (hk a) (hk a')) : Id (Hom Zab Ga') a a' =
    Tr.Trunc[Id (PtMap KZ2 kz2 (KA'.K two) (KA'.pt two)) (LA.K a two) (LA.K a' two)].induction @l (\ t -> Id (Hom Zab Ga') a a')
      (\ t -> hom-set Zab Ga' a a') (\ p -> H2.k2-inj a a' p) (SV.effective (LA.K a two) (LA.K a' two) e) ;
  hk-surj (c : HC KZ2 kz2 (KA'.K two) (KA'.pt two)) : Tr.Trunc[Bj.Fibre hk c].carrier =
    SV.ind @l (\ c1 -> Tr.Trunc[Bj.Fibre hk c1].carrier) (\ c1 -> Tr.Trunc[Bj.Fibre hk c1].proposition)
      (\ F -> Tr.Trunc[Bj.Fibre hk (SV.inc F)].inc (H2.inv2 F, apH (hcl KZ2 kz2 (KA'.K two) (KA'.pt two)) (H2.k2-surj F))) c ;
  hk-equiv : isEquiv (Hom Zab Ga') (HC KZ2 kz2 (KA'.K two) (KA'.pt two)) hk =
    Bj.Bij[Hom Zab Ga', HC KZ2 kz2 (KA'.K two) (KA'.pt two), hc-set KZ2 kz2 (KA'.K two) (KA'.pt two), hk, hk-inj, hk-surj].equiv ;
} ;

-- Proposition theta for a source triple (Z, C, ks), from (ex) the existence and
-- (bi) the uniqueness of the coefficient b over each a
module ThetaGen (Gt : Ab) (ks : PtMap KZ2 kz2 (KK[Gt].K four) (KK[Gt].pt four))
  (Ga' Gb' : Ab) (k' : PtMap (KK[Ga'].K two) (KK[Ga'].pt two) (KK[Gb'].K four) (KK[Gb'].pt four))
  (ex : (a : Hom Zab Ga') -> Tr.Trunc[(b : Hom Gt Gb') * Id (PtMap KZ2 kz2 (KK[Gb'].K four) (KK[Gb'].pt four)) (Maps2[Zab, Gt, ks, Ga', Gb', k'].kc b) (Maps2[Zab, Gt, ks, Ga', Gb', k'].ck a)].carrier)
  (bi : (a : Hom Zab Ga') (b b' : Hom Gt Gb') (H : Id (PtMap KZ2 kz2 (KK[Gb'].K four) (KK[Gb'].pt four)) (Maps2[Zab, Gt, ks, Ga', Gb', k'].ck a) (Maps2[Zab, Gt, ks, Ga', Gb', k'].kc b))
        (H' : Id (PtMap KZ2 kz2 (KK[Gb'].K four) (KK[Gb'].pt four)) (Maps2[Zab, Gt, ks, Ga', Gb', k'].ck a) (Maps2[Zab, Gt, ks, Ga', Gb', k'].kc b')) -> Id (Hom Gt Gb') b b') {
  module M2 = Maps2[Zab, Gt, ks, Ga', Gb', k'] ;
  module KB' = KK[Gb'] ;
  module SM = STr[M2.Mor] ;
  hom : U l = SM.C ;
  module LT = SM.Lift[Hom Zab Ga', hom-set Zab Ga', M2.mor-a] ;
  theta (c : hom) : Hom Zab Ga' = LT.map c ;
  surj (a : Hom Zab Ga') : Tr.Trunc[Bj.Fibre theta a].carrier =
    TC.map ((b : Hom Gt Gb') * Id (PtMap KZ2 kz2 (KB'.K four) (KB'.pt four)) (M2.kc b) (M2.ck a)) (Bj.Fibre theta a)
      (\ w -> (SM.inc (a, w.1, symH w.2), LT.beta (a, w.1, symH w.2))) (ex a) ;
  inj-at (a : Hom Zab Ga') (b b' : Hom Gt Gb') (H : Id (PtMap KZ2 kz2 (KB'.K four) (KB'.pt four)) (M2.ck a) (M2.kc b))
    (H' : Id (PtMap KZ2 kz2 (KB'.K four) (KB'.pt four)) (M2.ck a) (M2.kc b')) : Tr.Trunc[Id M2.Mor (a, b, H) (a, b', H')].carrier =
    idJ (Hom Gt Gb') b (\ b1 q1 -> (H1 : Id (PtMap KZ2 kz2 (KB'.K four) (KB'.pt four)) (M2.ck a) (M2.kc b1)) -> Tr.Trunc[Id M2.Mor (a, b, H) (a, b1, H1)].carrier)
      (\ H1 -> TC.map (Id (Id (PtMap KZ2 kz2 (KB'.K four) (KB'.pt four)) (M2.ck a) (M2.kc b)) H H1) (Id M2.Mor (a, b, H) (a, b, H1))
                 (\ e -> apH (\ X -> (a, b, X)) e) (H3U[Gb'].unique-H (M2.ck a) (M2.kc b) H H1))
      b' (bi a b b' H H') H' ;
  inj-mm (m m' : M2.Mor) (p : Id (Hom Zab Ga') (M2.mor-a m) (M2.mor-a m')) : Tr.Trunc[Id M2.Mor m m'].carrier =
    idJ (Hom Zab Ga') m.1 (\ a1 p1 -> (b1 : Hom Gt Gb') (H1 : Id (PtMap KZ2 kz2 (KB'.K four) (KB'.pt four)) (M2.ck a1) (M2.kc b1)) -> Tr.Trunc[Id M2.Mor m (a1, b1, H1)].carrier)
      (\ b1 H1 -> inj-at m.1 m.2.1 b1 m.2.2 H1) m'.1 p m'.2.1 m'.2.2 ;
  inj (c c' : hom) (e : Id (Hom Zab Ga') (theta c) (theta c')) : Id hom c c' =
    SM.ind @l (\ c1 -> (c2 : hom) -> Id (Hom Zab Ga') (theta c1) (theta c2) -> Id hom c1 c2)
      (\ c1 -> FL.isProp-Pi hom (\ c2 -> Id (Hom Zab Ga') (theta c1) (theta c2) -> Id hom c1 c2)
         (\ c2 -> FL.isProp-Pi (Id (Hom Zab Ga') (theta c1) (theta c2)) (\ e1 -> Id hom c1 c2) (\ e1 -> SM.set c1 c2)))
      (\ m c2 -> SM.ind @l (\ c3 -> Id (Hom Zab Ga') (theta (SM.inc m)) (theta c3) -> Id hom (SM.inc m) c3)
         (\ c3 -> FL.isProp-Pi (Id (Hom Zab Ga') (theta (SM.inc m)) (theta c3)) (\ e1 -> Id hom (SM.inc m) c3) (\ e1 -> SM.set (SM.inc m) c3))
         (\ m' e1 -> SM.Q.relates m m' (inj-mm m m' (transH (symH (LT.beta m)) (transH e1 (LT.beta m'))))) c2)
      c c' e ;
  theta-equiv : isEquiv hom (Hom Zab Ga') theta = Bj.Bij[hom, Hom Zab Ga', hom-set Zab Ga', theta, inj, surj].equiv ;
} ;

-- at t0 = (Z, Z, kappa): (H4) gives (ex) and (bi)
module Theta (Ga' Gb' : Ab) (k' : PtMap (KK[Ga'].K two) (KK[Ga'].pt two) (KK[Gb'].K four) (KK[Gb'].pt four)) {
  module M2 = Maps2[Zab, Zab, CS.kappa, Ga', Gb', k'] ;
  module KB' = KK[Gb'] ;
  module SK = STr[PtMap KZ2 kz2 (KB'.K four) (KB'.pt four)] ;
  -- Phi b is the class of kappa ; K(b,4)
  phi-kc (b : Hom Zab Gb') : Id (HC KZ2 kz2 (KB'.K four) (KB'.pt four)) (Phi CS.kappa Gb' b) (hcl KZ2 kz2 (KB'.K four) (KB'.pt four) (M2.kc b)) =
    apH (\ G -> hcl KZ2 kz2 (KB'.K four) (KB'.pt four) (ptcomp KZ2 kz2 KZ4 kz4 (KB'.K four) (KB'.pt four) CS.kappa G)) (M2.LB.K-def b four) ;
  bs (a : Hom Zab Ga') : Hom Zab Gb' = (H4Proof[l].h4 Gb').sec (hcl KZ2 kz2 (KB'.K four) (KB'.pt four) (M2.ck a)) ;
  bs-eq (a : Hom Zab Ga') : Id (HC KZ2 kz2 (KB'.K four) (KB'.pt four)) (hcl KZ2 kz2 (KB'.K four) (KB'.pt four) (M2.kc (bs a))) (hcl KZ2 kz2 (KB'.K four) (KB'.pt four) (M2.ck a)) =
    transH (symH (phi-kc (bs a))) ((H4Proof[l].h4 Gb').sec-eq (hcl KZ2 kz2 (KB'.K four) (KB'.pt four) (M2.ck a))) ;
  ex (a : Hom Zab Ga') : Tr.Trunc[(b : Hom Zab Gb') * Id (PtMap KZ2 kz2 (KB'.K four) (KB'.pt four)) (M2.kc b) (M2.ck a)].carrier =
    TC.map (Id (PtMap KZ2 kz2 (KB'.K four) (KB'.pt four)) (M2.kc (bs a)) (M2.ck a)) ((b : Hom Zab Gb') * Id (PtMap KZ2 kz2 (KB'.K four) (KB'.pt four)) (M2.kc b) (M2.ck a))
      (\ H -> (bs a, H)) (SK.effective (M2.kc (bs a)) (M2.ck a) (bs-eq a)) ;
  b-eq (a : Hom Zab Ga') (b b' : Hom Zab Gb') (H : Id (PtMap KZ2 kz2 (KB'.K four) (KB'.pt four)) (M2.ck a) (M2.kc b))
    (H' : Id (PtMap KZ2 kz2 (KB'.K four) (KB'.pt four)) (M2.ck a) (M2.kc b')) : Id (Hom Zab Gb') b b' =
    E.injective (Hom Zab Gb') (HC KZ2 kz2 (KB'.K four) (KB'.pt four)) (Phi CS.kappa Gb') (H4Proof[l].h4 Gb') b b'
      (transH (phi-kc b) (transH (SK.inc-eq (M2.kc b) (M2.ck a) (symH H)) (transH (SK.inc-eq (M2.ck a) (M2.kc b') H') (symH (phi-kc b'))))) ;
  module TG = ThetaGen[Zab, CS.kappa, Ga', Gb', k', ex, b-eq] ;
} ;

------------------------------------------------------------------------
-- Proposition mark3 and the assembly

module Final (S2 : U l) (base : S2) (surf : O2 S2 base)
  (ump : (X : U l) -> isEquiv (S2 -> X) ((x : X) * O2 X x) (ev2 S2 base surf X)) {
  module MFF = MF.Final[S2, base, surf, ump, CS.kappa, H4Proof[l].h4] ;
  module SS = MF.SourceS[S2, base, surf, ump] ;
  module RP = Triple[Zab, Zab, CS.kappa] ;
  module C = Pi3Sphere[l].Conditional[S2, base, surf, ump, CS.kappa] ;

  module At (Ga' Gb' : Ab) (k' : PtMap (KK[Ga'].K two) (KK[Ga'].pt two) (KK[Gb'].K four) (KK[Gb'].pt four)) {
    module TH = Theta[Ga', Gb', k'] ;
    module M2 = TH.M2 ;
    module KA' = KK[Ga'] ;
    module R' = Triple[Ga', Gb', k'] ;
    -- the class of realise-map
    module SR = STrMap[M2.Mor, PtMap RP.F RP.f0 R'.F R'.f0, M2.realise-map] ;
    f1-equiv : isEquiv TH.TG.hom (HC RP.F RP.f0 R'.F R'.f0) SR.map = classes-equiv M2.Mor (PtMap RP.F RP.f0 R'.F R'.f0) M2.realise-map M2.realise-map-equiv ;
    sst (c : HC RP.F RP.f0 R'.F R'.f0) : HC S2 base R'.F R'.f0 = compC S2 base RP.F RP.f0 R'.F R'.f0 MFF.s c ;
    module KC = KCls[Ga'] ;
    sgm (a : Hom Zab Ga') : HC S2 base (KA'.K two) (KA'.pt two) = compC S2 base KZ2 kz2 (KA'.K two) (KA'.pt two) (hcl S2 base KZ2 kz2 SS.sigma) (KC.hk a) ;
    sgm-equiv : isEquiv (Hom Zab Ga') (HC S2 base (KA'.K two) (KA'.pt two)) sgm =
      (E.compose (Hom Zab Ga') (HC KZ2 kz2 (KA'.K two) (KA'.pt two)) (HC S2 base (KA'.K two) (KA'.pt two)) (KC.hk, KC.hk-equiv)
         (\ d -> compC S2 base KZ2 kz2 (KA'.K two) (KA'.pt two) (hcl S2 base KZ2 kz2 SS.sigma) d, SS.Sig[KA'.K two, KA'.pt two, KA'.trunc (suc zero)].sigma-cls)).2 ;
    -- the square
    sq-at (m : M2.Mor) : Id (HC S2 base (KA'.K two) (KA'.pt two)) (MF.Lifting[S2, base, Ga', Gb', k'].qs (sst (hcl RP.F RP.f0 R'.F R'.f0 (M2.realise-map m)))) (sgm (M2.mor-a m)) =
      calc (HC S2 base (KA'.K two) (KA'.pt two)) {
        compC S2 base R'.F R'.f0 (KA'.K two) (KA'.pt two) (compC S2 base RP.F RP.f0 R'.F R'.f0 MFF.s (hcl RP.F RP.f0 R'.F R'.f0 (M2.realise-map m)))
          (hcl R'.F R'.f0 (KA'.K two) (KA'.pt two) (Fb.fpr (KA'.K two) (KA'.pt two) (KK[Gb'].K four) (KK[Gb'].pt four) k'))
          =< comp-assoc S2 base RP.F RP.f0 R'.F R'.f0 (KA'.K two) (KA'.pt two) MFF.s (hcl RP.F RP.f0 R'.F R'.f0 (M2.realise-map m))
               (hcl R'.F R'.f0 (KA'.K two) (KA'.pt two) (Fb.fpr (KA'.K two) (KA'.pt two) (KK[Gb'].K four) (KK[Gb'].pt four) k')) >
        compC S2 base RP.F RP.f0 (KA'.K two) (KA'.pt two) MFF.s
          (compC RP.F RP.f0 R'.F R'.f0 (KA'.K two) (KA'.pt two) (hcl RP.F RP.f0 R'.F R'.f0 (M2.realise-map m)) (hcl R'.F R'.f0 (KA'.K two) (KA'.pt two) (Fb.fpr (KA'.K two) (KA'.pt two) (KK[Gb'].K four) (KK[Gb'].pt four) k')))
          =< apH (compC S2 base RP.F RP.f0 (KA'.K two) (KA'.pt two) MFF.s)
               (transH (comp-beta RP.F RP.f0 R'.F R'.f0 (KA'.K two) (KA'.pt two) (M2.realise-map m) (Fb.fpr (KA'.K two) (KA'.pt two) (KK[Gb'].K four) (KK[Gb'].pt four) k'))
                 (transH (apH (hcl RP.F RP.f0 (KA'.K two) (KA'.pt two))
                            FM.FibMap[KZ2, kz2, KZ4, kz4, KA'.K two, KA'.pt two, KK[Gb'].K four, KK[Gb'].pt four, CS.kappa, k', M2.LA.K (M2.mor-a m) two, M2.LB.K (M2.mor-b m) four, M2.mor-H m].fm-over)
                   (symH (comp-beta RP.F RP.f0 KZ2 kz2 (KA'.K two) (KA'.pt two) (Fb.fpr KZ2 kz2 KZ4 kz4 CS.kappa) (M2.LA.K (M2.mor-a m) two))))) >
        compC S2 base RP.F RP.f0 (KA'.K two) (KA'.pt two) MFF.s (compC RP.F RP.f0 KZ2 kz2 (KA'.K two) (KA'.pt two) (hcl RP.F RP.f0 KZ2 kz2 (Fb.fpr KZ2 kz2 KZ4 kz4 CS.kappa)) (KC.hk (M2.mor-a m)))
          =< symH (comp-assoc S2 base RP.F RP.f0 KZ2 kz2 (KA'.K two) (KA'.pt two) MFF.s (hcl RP.F RP.f0 KZ2 kz2 (Fb.fpr KZ2 kz2 KZ4 kz4 CS.kappa)) (KC.hk (M2.mor-a m))) >
        compC S2 base KZ2 kz2 (KA'.K two) (KA'.pt two) (compC S2 base RP.F RP.f0 KZ2 kz2 MFF.s (hcl RP.F RP.f0 KZ2 kz2 (Fb.fpr KZ2 kz2 KZ4 kz4 CS.kappa))) (KC.hk (M2.mor-a m))
          =< apH (\ u -> compC S2 base KZ2 kz2 (KA'.K two) (KA'.pt two) u (KC.hk (M2.mor-a m))) MFF.s-eq >
        sgm (M2.mor-a m) } ;
    square (c : TH.TG.hom) : Id (HC S2 base (KA'.K two) (KA'.pt two)) (MF.Lifting[S2, base, Ga', Gb', k'].qs (sst (SR.map c))) (sgm (TH.TG.theta c)) =
      TH.TG.SM.ind @l (\ c1 -> Id (HC S2 base (KA'.K two) (KA'.pt two)) (MF.Lifting[S2, base, Ga', Gb', k'].qs (sst (SR.map c1))) (sgm (TH.TG.theta c1)))
        (\ c1 -> hc-set S2 base (KA'.K two) (KA'.pt two) _ _)
        (\ m -> transH (apH (\ u -> MF.Lifting[S2, base, Ga', Gb', k'].qs (sst u)) (SR.beta m)) (transH (sq-at m) (apH sgm (symH (TH.TG.LT.beta m))))) c ;
    -- Proposition mark3
    marked : isEquiv (HC RP.F RP.f0 R'.F R'.f0) (HC S2 base R'.F R'.f0) sst =
      W.cancel-equiv (HC RP.F RP.f0 R'.F R'.f0) (HC S2 base R'.F R'.f0) (HC S2 base (KA'.K two) (KA'.pt two)) sst
        MF.Lifting[S2, base, Ga', Gb', k'].qs (SS.qS Ga' Gb' k')
        (MF.cancel-r TH.TG.hom (HC RP.F RP.f0 R'.F R'.f0) (HC S2 base (KA'.K two) (KA'.pt two)) SR.map (\ c -> MF.Lifting[S2, base, Ga', Gb', k'].qs (sst c)) f1-equiv
           (E.homotopy TH.TG.hom (HC S2 base (KA'.K two) (KA'.pt two))
              (E.compose TH.TG.hom (Hom Zab Ga') (HC S2 base (KA'.K two) (KA'.pt two)) (TH.TG.theta, TH.TG.theta-equiv) (sgm, sgm-equiv))
              (\ c -> MF.Lifting[S2, base, Ga', Gb', k'].qs (sst (SR.map c))) square)) ;
  } ;

  -- the statement, for a pointed type in SC3
  Rep (v : CP.SC3) : U l =
    isEquiv (HC RP.F RP.f0 v.1 v.2.1) (HC S2 base v.1 v.2.1) (\ b -> compC S2 base RP.F RP.f0 v.1 v.2.1 MFF.s b) ;
  rep (X : U l) (x0 : X) (tX : isTrunc five X) (cX : isConn three X) : Rep (X, x0, (cX, tX)) =
    P1.subst CP.SC3 (\ v -> Rep v) (PC.realise (PC.realise-equiv.sec (X, x0, (cX, tX)))) (X, x0, (cX, tX))
      (PC.realise-equiv.sec-eq (X, x0, (cX, tX)))
      (At[(PC.realise-equiv.sec (X, x0, (cX, tX))).1, (PC.realise-equiv.sec (X, x0, (cX, tX))).2.1, (PC.realise-equiv.sec (X, x0, (cX, tX))).2.2].marked) ;
  map-thm : C.MapThm = new C.MapThm[MFF.s, rep] ;
  pi3-S2 : GIso[pi3 S2 base, ab-grp Zab] = C.pi3-S2-T map-thm ;
} ;
