      pt-inv (Id (Id (B.K five) (B.pt five) (B.pt five)) (refl (B.pt five)) (refl (B.pt five))) (refl (refl (B.pt five)))
        (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four))
