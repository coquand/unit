-- The lifting lemma one level up and the source BR (doc/br-universal.pdf,
-- Sections 4 and 6).  No S^3 axiom is used in this file.
--   LiftG       Theorem lift, for any pointed k : Y0 ->pt W with Omega W and
--               Omega (Fib k) connected (the only levels the proof of
--               MapFib.Lifting uses): (E) and (U) for a source Q give q_*
--               bijective on classes (Lemmas 3, 4, 5 and Theorem 1 of
--               doc/mapping-fib.pdf, text unchanged)
--   Triple3     a level-3 triple (A, B, K), K : K(A,3) ->pt K(B,5): F = Fib K,
--               trunc6, cOW (Omega K(B,5) connected), cOF (Omega F connected:
--               Omega F = Fib (Omega K), FibConn with surj-triv)
--   cancel-mid  e^-1 ; e cancels in the middle of a composite
--   SourceBR    p = fpr : BR ->pt K(Z,3) (named once: BR is spelled with suc two /
--               suc four in DeloopR, K(Z,3) with three here)
--     cp, PStar Lemma pstar: the fibres of p are 3-connected, p^* bijective on
--               classes into K(A,3), G_F = ext-pt F (ConnectedMaps.Elim, m = 5)
--     fseq      Lemma fseq: p ; Fhat merely 0 (w |-> w.2)
--     inj-R, ur Proposition UR: FibreH3.FibAtC at (Z/2, kbar), inj from Necessity.Psi.Inj
--     UBR       Proposition UBR: d : BR ->pt Omega K(B,5) is merely 0: UR transported
--               along e5 = (loop e_4)^-1 (ptEqInd), precomposition by phi injective
--               (pre-pteq), loop-const, unique-loop at c = 2
--     ExBR      Proposition EBR: M = G_F ; K, H = Nec.H, h = Phi^-1 [H] (h4), two-tors
--               (Lemma N), h = rho ; g (Factor), [kbar ; K(g,4)] = [H] (psi-phi), merely
--               kbar ; K(g,4) = H (effective); loop-eq: loop (Fhat ; K(g,5)) = loop M
--               (loop-comp, gamma, loopK, the definitions of Cross.f and Lev.conj, the
--               named bridge Bridge.eB-eA four, cancel-mid, conj-bridge = eB-def at e_2
--               and e_4 with the common points written, H-eq, conj-unconj); M-eq by
--               unique-loop1 (c = 2: Unloop is a proposition); null-at: F ; K = (p ;
--               G_F) ; K = p ; M = (p ; Fhat) ; K(g,5) = 0
--     ex-BR, un-BR, qBR  Corollary qBR: q_* bijective for every level-3 triple (LiftG.Main)
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ; open HLevels[l] ; open Connected[l] ;
open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ; open LoopCalc[l] ; open Torsor[l] ;
open EMMaps[l] ; open HomotopyClasses[l] ; open SphereUniversal[l] ; open PostnikovRealization[l] ; open KZ2Cohomology[l] ; open Z2[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module E = Equivalences[l] ; module W = Whitehead[l] ; module Fb = Fibres[l] ; module Bj = Bijection[l] ;
module MF = MapFib[l] ; module FH = FibreH3[l] ;

------------------------------------------------------------------------
-- Theorem lift, for any k with Omega W and Omega (Fib k) connected

module LiftG (Q : U l) (q0 : Q) (Y0 : U l) (y0 : Y0) (W : U l) (w0 : W) (k : PtMap Y0 y0 W w0)
  (cOW : isConn two (Id W w0 w0)) (cOF : isConn two (Id (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k))) {
  -- (E) and (U)
  Ex : U l = (F : PtMap Q q0 Y0 y0) ->
    Tr.Trunc[Id (PtMap Q q0 W w0) (ptcomp Q q0 Y0 y0 W w0 F k)
      (ptconst Q q0 W w0)].carrier ;
  Un : U l = (d : PtMap Q q0 (Id W w0 w0) (refl w0)) ->
    Tr.Trunc[Id (PtMap Q q0 (Id W w0 w0) (refl w0))
      (ptconst Q q0 (Id W w0 w0) (refl w0)) d].carrier ;
  -- (U0)
  U0 : U l = (d : Q -> Id W w0 w0) ->
    Tr.Trunc[Id (Q -> Id W w0 w0) (\ x -> refl w0) d].carrier ;
  -- q_* = - ; [q]
  qs (c : HC Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k)) : HC Q q0 Y0 y0 =
    compC Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k) Y0 y0 c
      (hcl (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k) Y0 y0 (Fb.fpr Y0 y0 W w0 k)) ;

  -- Lemma 4
  u0 (un : Un) : U0 = \ d ->
    TC.bind (Id (Id W w0 w0) (d q0) (refl w0))
      (Id (Q -> Id W w0 w0) (\ x -> refl w0) d)
      (\ r -> TC.map (Id (PtMap Q q0 (Id W w0 w0) (refl w0))
                        (ptconst Q q0 (Id W w0 w0) (refl w0)) (d, r))
                (Id (Q -> Id W w0 w0) (\ x -> refl w0) d)
                (\ e -> apH (\ M -> M.1) e) (un (d, r)))
      (conn-path zero (Id W w0 w0) cOW (d q0) (refl w0)) ;

  -- Lemma 3
  uniq0 (v : U0) (u : Q -> (Fb.Fib Y0 y0 W w0 k)) (g' : Q -> Y0) (e : Id (Q -> Y0) (\ x -> (u x).1) g')
    (h' : (x : Q) -> Id W (k.1 (g' x)) w0) :
    Tr.Trunc[Id (Q -> (Fb.Fib Y0 y0 W w0 k)) u (\ x -> (g' x, h' x))].carrier =
    idJ (Q -> Y0) (\ x -> (u x).1)
      (\ g1 e1 -> (h1 : (x : Q) -> Id W (k.1 (g1 x)) w0) -> Tr.Trunc[Id (Q -> (Fb.Fib Y0 y0 W w0 k)) u (\ x -> (g1 x, h1 x))].carrier)
      (\ h1 -> TC.map (Id (Q -> Id W w0 w0) (\ x -> refl w0)
                         (\ x -> trans W w0 (k.1 (u x).1) w0 (sym W (k.1 (u x).1) w0 (u x).2) (h1 x)))
                 (Id (Q -> (Fb.Fib Y0 y0 W w0 k)) u (\ x -> ((u x).1, h1 x)))
                 (\ z -> FL.funext Q (\ x -> (Fb.Fib Y0 y0 W w0 k)) u (\ x -> ((u x).1, h1 x)) (\ x ->
                    apH (\ w -> ((u x).1, w))
                      (MF.cancel-snd W (k.1 (u x).1) w0 (u x).2 (h1 x)
                         (happly Q (\ x1 -> Id W w0 w0) (\ x1 -> refl w0)
                            (\ x1 -> trans W w0 (k.1 (u x1).1) w0 (sym W (k.1 (u x1).1) w0 (u x1).2) (h1 x1))
                            z x))))
                 (v (\ x -> trans W w0 (k.1 (u x).1) w0 (sym W (k.1 (u x).1) w0 (u x).2) (h1 x))))
      g' e h' ;

  -- Lemma 5
  uniq (un : Un) (L L' : PtMap Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k))
    (e : Id (PtMap Q q0 Y0 y0)
       (ptcomp Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k) Y0 y0 L (Fb.fpr Y0 y0 W w0 k))
       (ptcomp Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k) Y0 y0 L' (Fb.fpr Y0 y0 W w0 k))) :
    Tr.Trunc[Id (PtMap Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k)) L L'].carrier =
    TC.bind (Id (Q -> (Fb.Fib Y0 y0 W w0 k)) L.1 (\ x -> ((L'.1 x).1, (L'.1 x).2))) (Id (PtMap Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k)) L L')
      (\ e1 -> FH.pi-mere Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k) cOF L.1 L'.1 e1 L.2 L'.2)
      (uniq0 (u0 un) L.1 (\ x -> (L'.1 x).1) (apH (\ M -> M.1) e) (\ x -> (L'.1 x).2)) ;

  -- Theorem 1
  module Main (ex : Ex) (un : Un) {
    surj (b : HC Q q0 Y0 y0) : Tr.Trunc[Bj.Fibre qs b].carrier =
      STr[PtMap Q q0 Y0 y0].ind @l (\ b1 -> Tr.Trunc[Bj.Fibre qs b1].carrier) (\ b1 -> Tr.Trunc[Bj.Fibre qs b1].proposition)
        (\ F -> TC.map (Id (PtMap Q q0 W w0) (ptcomp Q q0 Y0 y0 W w0 F k)
                          (ptconst Q q0 W w0))
                  (Bj.Fibre qs (hcl Q q0 Y0 y0 F))
                  (\ th -> (hcl Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k) Fb.Lift[Q, q0, Y0, y0, W, w0, k, F, th].lift,
                            transH (comp-beta Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k) Y0 y0 Fb.Lift[Q, q0, Y0, y0, W, w0, k, F, th].lift
                                      (Fb.fpr Y0 y0 W w0 k))
                              (apH (hcl Q q0 Y0 y0) Fb.Lift[Q, q0, Y0, y0, W, w0, k, F, th].lift-fst)))
                  (ex F)) b ;
    inj-at (L L' : PtMap Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k)) (h : Id (HC Q q0 Y0 y0) (qs (hcl Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k) L)) (qs (hcl Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k) L'))) :
      Id (HC Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k)) (hcl Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k) L) (hcl Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k) L') =
      STr[PtMap Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k)].Q.relates L L'
        (TC.bind (Id (PtMap Q q0 Y0 y0)
                    (ptcomp Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k) Y0 y0 L (Fb.fpr Y0 y0 W w0 k))
                    (ptcomp Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k) Y0 y0 L' (Fb.fpr Y0 y0 W w0 k)))
           (Id (PtMap Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k)) L L') (uniq un L L')
           (STr[PtMap Q q0 Y0 y0].effective
              (ptcomp Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k) Y0 y0 L (Fb.fpr Y0 y0 W w0 k))
              (ptcomp Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k) Y0 y0 L' (Fb.fpr Y0 y0 W w0 k))
              (transH (symH (comp-beta Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k) Y0 y0 L (Fb.fpr Y0 y0 W w0 k)))
                 (transH h (comp-beta Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k) Y0 y0 L' (Fb.fpr Y0 y0 W w0 k)))))) ;
    inj (c c' : HC Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k)) (h : Id (HC Q q0 Y0 y0) (qs c) (qs c')) : Id (HC Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k)) c c' =
      STr[PtMap Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k)].ind @l
        (\ c1 -> (c2 : HC Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k)) -> Id (HC Q q0 Y0 y0) (qs c1) (qs c2) -> Id (HC Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k)) c1 c2)
        (\ c1 -> FL.isProp-Pi (HC Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k)) (\ c2 -> Id (HC Q q0 Y0 y0) (qs c1) (qs c2) -> Id (HC Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k)) c1 c2)
           (\ c2 -> FL.isProp-Pi (Id (HC Q q0 Y0 y0) (qs c1) (qs c2)) (\ h1 -> Id (HC Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k)) c1 c2)
              (\ h1 -> hc-set Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k) c1 c2)))
        (\ L c2 -> STr[PtMap Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k)].ind @l
           (\ c3 -> Id (HC Q q0 Y0 y0) (qs (hcl Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k) L)) (qs c3) -> Id (HC Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k)) (hcl Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k) L) c3)
           (\ c3 -> FL.isProp-Pi (Id (HC Q q0 Y0 y0) (qs (hcl Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k) L)) (qs c3)) (\ h1 -> Id (HC Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k)) (hcl Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k) L) c3)
              (\ h1 -> hc-set Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k) (hcl Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k) L) c3))
           (\ L' -> inj-at L L') c2)
        c c' h ;
    equiv : isEquiv (HC Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k)) (HC Q q0 Y0 y0) qs =
      Bj.Bij[HC Q q0 (Fb.Fib Y0 y0 W w0 k) (Fb.fpt Y0 y0 W w0 k), HC Q q0 Y0 y0, hc-set Q q0 Y0 y0, qs, inj, surj].equiv ;
  } ;
} ;

------------------------------------------------------------------------
-- level-3 triples

module Triple3 (Ga Gb : Ab) (K : PtMap (KK[Ga].K three) (KK[Ga].pt three) (KK[Gb].K five) (KK[Gb].pt five)) {
  module KA = KK[Ga] ; module KB = KK[Gb] ;
  F : U l = Fb.Fib (KA.K three) (KA.pt three) (KB.K five) (KB.pt five) K ;
  f0 : F = Fb.fpt (KA.K three) (KA.pt three) (KB.K five) (KB.pt five) K ;
  trunc6 : isTrunc (suc five) F =
    trunc-Sigma (suc five) (KA.K three) (\ x -> Id (KB.K five) (K.1 x) (KB.pt five))
      (trunc-suc five (KA.K three) (KA.trunc two)) (\ x -> KB.trunc four (K.1 x) (KB.pt five)) ;
  -- Omega K(B,5) is 1-connected, in particular connected
  cOOW : isConn three (Id (KB.K five) (KB.pt five) (KB.pt five)) =
    conn-down three (Id (KB.K five) (KB.pt five) (KB.pt five)) (conn-down four (Id (KB.K five) (KB.pt five) (KB.pt five))
      (conn-id five (KB.K five) (KB.conn four) (KB.pt five) (KB.pt five))) ;
  cOW : isConn two (Id (KB.K five) (KB.pt five) (KB.pt five)) = conn-down two (Id (KB.K five) (KB.pt five) (KB.pt five)) cOOW ;
  -- Omega F = Fib (Omega K) is connected
  Ok : Maps[KA.K three, KA.pt three, KB.K five, KB.pt five].PMO = Maps[KA.K three, KA.pt three, KB.K five, KB.pt five].loop K ;
  conn-FOk : isConn two (Fb.Fib (Id (KA.K three) (KA.pt three) (KA.pt three)) (refl (KA.pt three)) (Id (KB.K five) (KB.pt five) (KB.pt five)) (refl (KB.pt five)) Ok) =
    Fb.FibConn[Id (KA.K three) (KA.pt three) (KA.pt three), refl (KA.pt three), Id (KB.K five) (KB.pt five) (KB.pt five), refl (KB.pt five), Ok,
      conn-down two (Id (KA.K three) (KA.pt three) (KA.pt three)) (conn-id three (KA.K three) (KA.conn two) (KA.pt three) (KA.pt three)),
      surj-triv (Id (KA.K three) (KA.pt three) (KA.pt three)) (refl (KA.pt three)) (Id (KB.K five) (KB.pt five) (KB.pt five)) (refl (KB.pt five)) Ok cOOW].conn ;
  cOF : isConn two (Id F f0 f0) =
    Deloop[l].equiv-conn two (Id F f0 f0) (Fb.Fib (Id (KA.K three) (KA.pt three) (KA.pt three)) (refl (KA.pt three)) (Id (KB.K five) (KB.pt five) (KB.pt five)) (refl (KB.pt five)) Ok)
      Acc[Id F f0 f0, refl f0, Fb.Fib (Id (KA.K three) (KA.pt three) (KA.pt three)) (refl (KA.pt three)) (Id (KB.K five) (KB.pt five) (KB.pt five)) (refl (KB.pt five)) Ok,
          Fb.fpt (Id (KA.K three) (KA.pt three) (KA.pt three)) (refl (KA.pt three)) (Id (KB.K five) (KB.pt five) (KB.pt five)) (refl (KB.pt five)) Ok,
          (Fb.omega-fib (KA.K three) (KA.pt three) (KB.K five) (KB.pt five) K).1].equiv
      conn-FOk ;
} ;

------------------------------------------------------------------------
-- e^-1 ; e cancels in the middle of a composite (associativity, pt-inv-r, unit)
cancel-mid (X : U l) (x0 : X) (OY : U l) (oy : OY) (Y : U l) (y0 : Y) (Z : U l) (z0 : Z) (V : U l) (v0 : V)
  (a : PtMap X x0 Y y0) (e : PtEquiv OY oy Y y0) (b : PtMap Y y0 Z z0) (c : PtMap Z z0 V v0) :
  Id (PtMap X x0 V v0) (ptcomp X x0 OY oy V v0 (ptcomp X x0 Y y0 OY oy a (pt-inv OY oy Y y0 e).1) (ptcomp OY oy Z z0 V v0 (ptcomp OY oy Y y0 Z z0 e.1 b) c))
    (ptcomp X x0 Z z0 V v0 (ptcomp X x0 Y y0 Z z0 a b) c) =
  calc (PtMap X x0 V v0) {
    ptcomp X x0 OY oy V v0 (ptcomp X x0 Y y0 OY oy a (pt-inv OY oy Y y0 e).1) (ptcomp OY oy Z z0 V v0 (ptcomp OY oy Y y0 Z z0 e.1 b) c)
      =< ptcomp-assoc X x0 Y y0 OY oy V v0 a (pt-inv OY oy Y y0 e).1 (ptcomp OY oy Z z0 V v0 (ptcomp OY oy Y y0 Z z0 e.1 b) c) >
    ptcomp X x0 Y y0 V v0 a (ptcomp Y y0 OY oy V v0 (pt-inv OY oy Y y0 e).1 (ptcomp OY oy Z z0 V v0 (ptcomp OY oy Y y0 Z z0 e.1 b) c))
      =< apH (\ T -> ptcomp X x0 Y y0 V v0 a (ptcomp Y y0 OY oy V v0 (pt-inv OY oy Y y0 e).1 T)) (ptcomp-assoc OY oy Y y0 Z z0 V v0 e.1 b c) >
    ptcomp X x0 Y y0 V v0 a (ptcomp Y y0 OY oy V v0 (pt-inv OY oy Y y0 e).1 (ptcomp OY oy Y y0 V v0 e.1 (ptcomp Y y0 Z z0 V v0 b c)))
      =< apH (ptcomp X x0 Y y0 V v0 a) (symH (ptcomp-assoc Y y0 OY oy Y y0 V v0 (pt-inv OY oy Y y0 e).1 e.1 (ptcomp Y y0 Z z0 V v0 b c))) >
    ptcomp X x0 Y y0 V v0 a (ptcomp Y y0 Y y0 V v0 (ptcomp Y y0 OY oy Y y0 (pt-inv OY oy Y y0 e).1 e.1) (ptcomp Y y0 Z z0 V v0 b c))
      =< apH (\ T -> ptcomp X x0 Y y0 V v0 a (ptcomp Y y0 Y y0 V v0 T (ptcomp Y y0 Z z0 V v0 b c))) (pt-inv-r OY oy Y y0 e) >
    ptcomp X x0 Y y0 V v0 a (ptcomp Y y0 Y y0 V v0 (ptid Y y0) (ptcomp Y y0 Z z0 V v0 b c))
      =< apH (ptcomp X x0 Y y0 V v0 a) (Fb.ptcomp-idl Y y0 V v0 (ptcomp Y y0 Z z0 V v0 b c)) >
    ptcomp X x0 Y y0 V v0 a (ptcomp Y y0 Z z0 V v0 b c)
      =< symH (ptcomp-assoc X x0 Y y0 Z z0 V v0 a b c) >
    ptcomp X x0 Z z0 V v0 (ptcomp X x0 Y y0 Z z0 a b) c } ;

------------------------------------------------------------------------
-- the source BR = Fib Fhat, p = fpr : BR ->pt K(Z,3)

module SourceBR {
  module DR = DeloopR[l] ;
  -- the projection
  p : PtMap DR.BR DR.br0 (KK[Zab].K three) (KK[Zab].pt three) =
    Fb.fpr (KK[Zab].K (suc two)) (KK[Zab].pt (suc two)) (KK[Z2ab].K (suc four)) (KK[Z2ab].pt (suc four)) DR.Fhat ;
  -- Lemma pstar: the fibres of p are 3-connected (K(Z/2,5) is 4-connected)
  cp (x : KK[Zab].K three) : isConn five (W.fib DR.BR (KK[Zab].K three) (\ w -> w.1) x) =
    Deloop[l].equiv-conn five (W.fib DR.BR (KK[Zab].K three) (\ w -> w.1) x) (Id (KK[Z2ab].K five) (DR.Fhat.1 x) (KK[Z2ab].pt five))
      (MF.fib-fst (KK[Zab].K three) (\ x1 -> Id (KK[Z2ab].K five) (DR.Fhat.1 x1) (KK[Z2ab].pt five)) x)
      (conn-id five (KK[Z2ab].K five) (KK[Z2ab].conn four) (DR.Fhat.1 x) (KK[Z2ab].pt five)) ;

  module PStar (Ga : Ab) {
    module EA = ConnectedMaps[l].Elim[five, DR.BR, KK[Zab].K three, \ w -> w.1, cp, \ x -> KK[Ga].K three, \ x -> KK[Ga].trunc two] ;
    cOA : isConn two (Id (KK[Ga].K three) (KK[Ga].pt three) (KK[Ga].pt three)) =
      conn-down two (Id (KK[Ga].K three) (KK[Ga].pt three) (KK[Ga].pt three)) (conn-id three (KK[Ga].K three) (KK[Ga].conn two) (KK[Ga].pt three) (KK[Ga].pt three)) ;
    -- G_F
    ext-pt (F : PtMap DR.BR DR.br0 (KK[Ga].K three) (KK[Ga].pt three)) : PtMap (KK[Zab].K three) (KK[Zab].pt three) (KK[Ga].K three) (KK[Ga].pt three) =
      (EA.ext F.1, transH (EA.ext-beta F.1 DR.br0) F.2) ;
    ext-eq (F : PtMap DR.BR DR.br0 (KK[Ga].K three) (KK[Ga].pt three)) :
      Tr.Trunc[Id (PtMap DR.BR DR.br0 (KK[Ga].K three) (KK[Ga].pt three)) (ptcomp DR.BR DR.br0 (KK[Zab].K three) (KK[Zab].pt three) (KK[Ga].K three) (KK[Ga].pt three) (p) (ext-pt F)) F].carrier =
      FH.pi-mere DR.BR DR.br0 (KK[Ga].K three) (KK[Ga].pt three) cOA (\ w -> EA.ext F.1 w.1) F.1
