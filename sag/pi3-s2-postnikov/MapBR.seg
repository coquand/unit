        Tr.Trunc[Id (PtMap DR.TR.F DR.TR.f0 (Id (Id (B.K five) (B.pt five) (B.pt five)) (refl (B.pt five)) (refl (B.pt five))) (refl (refl (B.pt five))))
          (ptconst DR.TR.F DR.TR.f0 (Id (Id (B.K five) (B.pt five) (B.pt five)) (refl (B.pt five)) (refl (B.pt five))) (refl (refl (B.pt five)))) d].carrier =
      ptEqInd (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four))
        (\ Z z e -> (d : PtMap DR.TR.F DR.TR.f0 Z z) -> Tr.Trunc[Id (PtMap DR.TR.F DR.TR.f0 Z z) (ptconst DR.TR.F DR.TR.f0 Z z) d].carrier)
        (ur Gb) (Id (Id (B.K five) (B.pt five) (B.pt five)) (refl (B.pt five)) (refl (B.pt five))) (refl (refl (B.pt five))) e5 ;
