         (ptcomp DR.TR.F DR.TR.f0 (Id DR.BR DR.br0 DR.br0) (refl DR.br0) (Id (Id (B.K five) (B.pt five) (B.pt five)) (refl (B.pt five)) (refl (B.pt five))) (refl (refl (B.pt five))) DR.phi.1 (MO.loop d))) :
