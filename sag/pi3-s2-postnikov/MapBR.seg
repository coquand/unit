  -- Proposition EBR: (E) for BR, for every level-3 triple
  module ExBR (Ga Gb : Ab) (K : PtMap (KK[Ga].K three) (KK[Ga].pt three) (KK[Gb].K five) (KK[Gb].pt five)) (F : PtMap DR.BR DR.br0 (KK[Ga].K three) (KK[Ga].pt three)) {
    module A = KK[Zab] ; module B = KK[Gb] ; module C = KK[Z2ab] ;
    module L = H4Bilinear[l].Lev[Zab, Zab] ;
    module L2 = H4Bilinear[l].Lev[Zab, Z2ab] ;
    module L3 = H4Bilinear[l].Lev[Z2ab, Gb] ;
    module MX = Maps[A.K three, A.pt three, B.K five, B.pt five] ;
    module PS = PStar[Ga] ;
    -- M = G_F ; K
    M : PtMap (A.K three) (A.pt three) (B.K five) (B.pt five) = ptcomp (A.K three) (A.pt three) (KK[Ga].K three) (KK[Ga].pt three) (B.K five) (B.pt five) (PS.ext-pt F) K ;
    module NM = Necessity[l].Nec[Gb, M] ;
    -- h = Phi^-1 [H] (h4 surjective), 2-torsion (Lemma N), h = rho ; g (Lemma factor)
    h : Hom Zab Gb = (H4Proof[l].h4 Gb).sec (hcl KZ2 kz2 (B.K four) (B.pt four) NM.H) ;
    eh : Id (HC KZ2 kz2 (B.K four) (B.pt four)) (Phi CupSquare[l].kappa Gb h) (hcl KZ2 kz2 (B.K four) (B.pt four) NM.H) = (H4Proof[l].h4 Gb).sec-eq (hcl KZ2 kz2 (B.K four) (B.pt four) NM.H) ;
    module FC = Necessity[l].Factor[Gb, h, NM.Two[h, eh].two-tors] ;
    -- [kbar ; K(g,4)] = [H] (Proposition Psi), so merely kbar ; K(g,4) = H
    cls : Id (HC KZ2 kz2 (B.K four) (B.pt four)) (hcl KZ2 kz2 (B.K four) (B.pt four) (ptcomp KZ2 kz2 (C.K four) (C.pt four) (B.K four) (B.pt four) CrossTerm[l].kbar (L3.K FC.g four))) (hcl KZ2 kz2 (B.K four) (B.pt four) NM.H) =
      calc (HC KZ2 kz2 (B.K four) (B.pt four)) {
        hcl KZ2 kz2 (B.K four) (B.pt four) (ptcomp KZ2 kz2 (C.K four) (C.pt four) (B.K four) (B.pt four) CrossTerm[l].kbar (L3.K FC.g four))
          =< apH (\ G -> hcl KZ2 kz2 (B.K four) (B.pt four) (ptcomp KZ2 kz2 (C.K four) (C.pt four) (B.K four) (B.pt four) CrossTerm[l].kbar G)) (symH (L3.K-def FC.g four)) >
        Necessity[l].Psi[Gb].psi FC.g
          =< Necessity[l].Psi[Gb].psi-phi FC.g >
        Phi CupSquare[l].kappa Gb (KFun[l].hcomp Zab Z2ab Gb rho FC.g)
          =< apH (Phi CupSquare[l].kappa Gb) FC.factor >
        Phi CupSquare[l].kappa Gb h
          =< eh >
        hcl KZ2 kz2 (B.K four) (B.pt four) NM.H } ;
    H-mere : Tr.Trunc[Id (PtMap KZ2 kz2 (B.K four) (B.pt four)) (ptcomp KZ2 kz2 (C.K four) (C.pt four) (B.K four) (B.pt four) CrossTerm[l].kbar (L3.K FC.g four)) NM.H].carrier =
      STr[PtMap KZ2 kz2 (B.K four) (B.pt four)].effective (ptcomp KZ2 kz2 (C.K four) (C.pt four) (B.K four) (B.pt four) CrossTerm[l].kbar (L3.K FC.g four)) NM.H cls ;
    -- e_2 and e_4^-1 of the Lev locks are those of Conj (eB-def)
    eBi-def : Id (PtMap (B.K four) (B.pt four) (Id (B.K five) (B.pt five) (B.pt five)) (refl (B.pt five))) (L3.eBi four) NM.CJ.eBi =
      calc (PtMap (B.K four) (B.pt four) (Id (B.K five) (B.pt five) (B.pt five)) (refl (B.pt five))) {
        L3.eBi four
          =< refl (L3.eBi four) >
        (pt-inv (Id (B.K five) (B.pt five) (B.pt five)) (refl (B.pt five)) (B.K four) (B.pt four) (L3.eB four)).1
          =< apH (\ e2 -> (pt-inv (Id (B.K five) (B.pt five) (B.pt five)) (refl (B.pt five)) (B.K four) (B.pt four) e2).1) (symH (L3.eB-def four)) >
        (pt-inv (Id (B.K five) (B.pt five) (B.pt five)) (refl (B.pt five)) (B.K four) (B.pt four) (B.e four)).1
          =< refl NM.CJ.eBi >
        NM.CJ.eBi } ;
    conj-bridge : Id (PtMap (Id (A.K three) (A.pt three) (A.pt three)) (refl (A.pt three)) (Id (B.K five) (B.pt five) (B.pt five)) (refl (B.pt five))) (ptcomp (Id (A.K three) (A.pt three) (A.pt three)) (refl (A.pt three)) (B.K four) (B.pt four) (Id (B.K five) (B.pt five) (B.pt five)) (refl (B.pt five)) (ptcomp (Id (A.K three) (A.pt three) (A.pt three)) (refl (A.pt three)) KZ2 kz2 (B.K four) (B.pt four) (L.eB two).1 NM.H) (L3.eBi four)) (NM.CJ.conj NM.H) =
