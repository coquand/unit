        =< apH (\ u -> (ED.LO.ev u).1 x)
             (transH (ED.C.evPt-loop ED.LO.pt0 (ptcomp ED.C.Z1.K1 ED.C.Z1.k0 ED.C.Z1.K1 ED.C.Z1.k0 (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 k21 (ED.phi c)))
                (Puppe[l].pt-happly (Id ED.C.Z1.K1 ED.C.Z1.k0 ED.C.Z1.k0) (refl ED.C.Z1.k0) (Id (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 ED.LO.pt0) (refl ED.LO.pt0)
                   (Maps[ED.C.Z1.K1, ED.C.Z1.k0, (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)), ED.LO.pt0].loop (ptcomp ED.C.Z1.K1 ED.C.Z1.k0 ED.C.Z1.K1 ED.C.Z1.k0 (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 k21 (ED.phi c)))
                   (ptcomp (Id ED.C.Z1.K1 ED.C.Z1.k0 ED.C.Z1.k0) (refl ED.C.Z1.k0) (Id ED.C.Z1.K1 ED.C.Z1.k0 ED.C.Z1.k0) (refl ED.C.Z1.k0) (Id (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 ED.LO.pt0) (refl ED.LO.pt0) (Maps[ED.C.Z1.K1, ED.C.Z1.k0, ED.C.Z1.K1, ED.C.Z1.k0].loop k21) (Maps[ED.C.Z1.K1, ED.C.Z1.k0, (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)), ED.LO.pt0].loop (ED.phi c)))
                   (loop-comp ED.C.Z1.K1 ED.C.Z1.k0 ED.C.Z1.K1 ED.C.Z1.k0 (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 k21 (ED.phi c)) ED.C.g)) >
      (ED.LO.ev ((Maps[ED.C.Z1.K1, ED.C.Z1.k0, (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)), ED.LO.pt0].loop (ED.phi c)).1 ((Maps[ED.C.Z1.K1, ED.C.Z1.k0, ED.C.Z1.K1, ED.C.Z1.k0].loop k21).1 ED.C.g))).1 x
        =< apH (\ v -> (ED.LO.ev ((Maps[ED.C.Z1.K1, ED.C.Z1.k0, (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)), ED.LO.pt0].loop (ED.phi c)).1 v)).1 x) (k21-sq ED.C.g) >
      (ED.LO.ev ((Maps[ED.C.Z1.K1, ED.C.Z1.k0, (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)), ED.LO.pt0].loop (ED.phi c)).1 (trans ED.C.Z1.K1 ED.C.Z1.k0 ED.C.Z1.k0 ED.C.Z1.k0 ED.C.g ED.C.g))).1 x
        =< apH (\ u -> (ED.LO.ev u).1 x) (LMult[ED.C.Z1.K1, ED.C.Z1.k0, (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)), ED.LO.pt0, ED.phi c].lmult ED.C.g ED.C.g) >
      (ED.LO.ev (trans (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 ED.LO.pt0 ED.LO.pt0 ((Maps[ED.C.Z1.K1, ED.C.Z1.k0, (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)), ED.LO.pt0].loop (ED.phi c)).1 ED.C.g) ((Maps[ED.C.Z1.K1, ED.C.Z1.k0, (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)), ED.LO.pt0].loop (ED.phi c)).1 ED.C.g))).1 x
        =< apH (\ u -> (ED.LO.ev (trans (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 ED.LO.pt0 ED.LO.pt0 u u)).1 x) (symH (ED.C.evPt-loop ED.LO.pt0 (ED.phi c))) >
      (ED.LO.ev (trans (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 ED.LO.pt0 ED.LO.pt0 (ED.C.evPt ED.LO.pt0 (ED.phi c)) (ED.C.evPt ED.LO.pt0 (ED.phi c)))).1 x
        =< ED.LO.ev-ap ED.LO.pt0 (trans (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 ED.LO.pt0 ED.LO.pt0 (ED.C.evPt ED.LO.pt0 (ED.phi c)) (ED.C.evPt ED.LO.pt0 (ED.phi c))) x >
      ap (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) (Id Y y0 y0) (\ F -> F.1 x) ED.LO.pt0 ED.LO.pt0 (trans (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 ED.LO.pt0 ED.LO.pt0 (ED.C.evPt ED.LO.pt0 (ED.phi c)) (ED.C.evPt ED.LO.pt0 (ED.phi c)))
        =< Groupoid[l].ap-trans (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) (Id Y y0 y0) (\ F -> F.1 x) ED.LO.pt0 ED.LO.pt0 ED.LO.pt0 (ED.C.evPt ED.LO.pt0 (ED.phi c)) (ED.C.evPt ED.LO.pt0 (ED.phi c)) >
      trans (Id Y y0 y0) (refl y0) (refl y0) (refl y0) (ap (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) (Id Y y0 y0) (\ F -> F.1 x) ED.LO.pt0 ED.LO.pt0 (ED.C.evPt ED.LO.pt0 (ED.phi c))) (ap (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) (Id Y y0 y0) (\ F -> F.1 x) ED.LO.pt0 ED.LO.pt0 (ED.C.evPt ED.LO.pt0 (ED.phi c)))
        =< apH (\ u -> trans (Id Y y0 y0) (refl y0) (refl y0) (refl y0) u u) (symH (ED.LO.ev-ap ED.LO.pt0 (ED.C.evPt ED.LO.pt0 (ED.phi c)) x)) >
      trans (Id Y y0 y0) (refl y0) (refl y0) (refl y0) ((ED.LO.ev (ED.C.evPt ED.LO.pt0 (ED.phi c))).1 x) ((ED.LO.ev (ED.C.evPt ED.LO.pt0 (ED.phi c))).1 x)
        =< refl (trans (Id Y y0 y0) (refl y0) (refl y0) (refl y0) ((ED.E c).1 x) ((ED.E c).1 x)) >
      trans (Id Y y0 y0) (refl y0) (refl y0) (refl y0) ((ED.E c).1 x) ((ED.E c).1 x) } ;
  -- E 0 is pointwise refl
  phi-zero : Id (PtMap ED.C.Z1.K1 ED.C.Z1.k0 (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0) (ED.phi (ptconst KZ2 kz2 (PtMap KZ2 kz2 Y y0) ED.L4.pt0)) (ptconst ED.C.Z1.K1 ED.C.Z1.k0 (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0) =
    calc (PtMap ED.C.Z1.K1 ED.C.Z1.k0 (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0) {
