-- The cross term of the reduced cup square vanishes (doc/cross-term.pdf,
-- Sections 3 (end) to 5).
--   LMult       loop-mult with its statement written (Induced.L, PiOne.comp by
--               definition: L-def, comp-def): loop F is multiplicative
--   S'.s'       Corollary 7 (end): w . w = refl on Omega^2 K(Z/2,4), through the
--               equivalence loop e_3 (LoopIso.loop-pe-equiv) and Sq0.s at m = 2
--   k21         K(2,1) at the types of the circle; K(Z,1) of the circle is
--               identified with KK.K 1 only here, in loop-k22 (loop K(2,2) =
--               e_1 ; K(2,1) ; e_1^-1: KMap.loopK 1 with the raw KK.e 1, and
--               CupSquare.e1-def) and in k21-sq ((loop K(2,1)) p = p . p: Lemma 6
--               at m = 0 for A = Z, with loopK 0); then k21 is locked
--   ETwo        Lemma 8 (E2): E (K(2,2) ; c) is pointwise E c . E c.  With
--               L = phi c the argument of evPt is K(2,1) ; L (phi-two: loop-comp,
--               loop-k22, ptcomp-assoc, pt-inv-r, ptcomp-idl); at the generator g
--               of the instance Circle[N] used by E, (loop (K(2,1) ; L)) g =
--               (loop L) (g . g) (evPt-loop, loop-comp, k21-sq); then loop-mult and
--               ev-ap / ap-trans.  e-zero: E 0 is pointwise refl (loop-const,
--               comp-const-l/r, evPt-loop, the pointing of ev).
--   l2-mult     Lemma 9: loop^2 G is multiplicative (LMult at loop G)
--   kbar        kappa ; K(rho,4), with K(rho,4) the LOCKED Lev.K rho four (as in
--               BilAt.c2g), here and in K(rho,4)_* (Kill): the same map in both,
--               so that N-def holds by definition; with the raw KMap.K four,
--               N-def unfolded the construction of K(rho,4) (four is a numeral)
--   Kill        Theorem 10: c'' = K(2,2) ; c2 ; K(rho,4)_* is 0 (Theta is
--               injective; Theta c'' and Theta 0 are pointwise j_B refl:
--               ENat.e-nat, ETwo.e-two, l2-mult, s'; ETwo.e-zero); N: the
--               homotopy kbar (K(2,2) x) = * (c'' x at K(2,2) x is kbar (K(2,2) x)
--               by definition, N-def); N-lev: the same for the locked K(2,2)
--               (Lev.K-def).  K(2,2) in c'' is the raw KMap.K two of Lemma 8.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ; open HLevels[l] ; open Connected[l] ;
open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ; open Torsor[l] ; open LoopCalc[l] ;
open EMMaps[l] ; open HomotopyClasses[l] ; open SphereUniversal[l] ; open PostnikovRealization[l] ; open KZ2Cohomology[l] ;
open Z2[l] ; open Doubling[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module CS = CupSquare[l] ;

-- loop F is multiplicative: PiOne.Induced.loop-mult, with Induced.L and
-- PiOne.comp stated by definition (L-def, comp-def)
module LMult (Y : U l) (y0 : Y) (Z : U l) (z0 : Z) (F : PtMap Y y0 Z z0) {
  module IE = PiOne[l].Induced[Y, y0, Z, z0, F] ;
  L-def (u : Id Y y0 y0) : Id (Id Z z0 z0) (IE.L u) ((Maps[Y, y0, Z, z0].loop F).1 u) = refl (IE.L u) ;
  comp-def (u v : Id Y y0 y0) : Id (Id Y y0 y0) (IE.PY.comp u v) (trans Y y0 y0 y0 u v) = refl (IE.PY.comp u v) ;
  lmult (p q : Id Y y0 y0) :
    Id (Id Z z0 z0) ((Maps[Y, y0, Z, z0].loop F).1 (trans Y y0 y0 y0 p q))
      (trans Z z0 z0 z0 ((Maps[Y, y0, Z, z0].loop F).1 p) ((Maps[Y, y0, Z, z0].loop F).1 q)) =
    calc (Id Z z0 z0) {
      (Maps[Y, y0, Z, z0].loop F).1 (trans Y y0 y0 y0 p q)
        =< symH (transH (apH IE.L (comp-def p q)) (L-def (trans Y y0 y0 y0 p q))) >
      IE.L (IE.PY.comp p q)
        =< IE.loop-mult p q >
      IE.PZ.comp (IE.L p) (IE.L q)
        =< transH (apH (\ w -> trans Z z0 z0 z0 w (IE.L q)) (L-def p)) (apH (trans Z z0 z0 z0 ((Maps[Y, y0, Z, z0].loop F).1 p)) (L-def q)) >
      trans Z z0 z0 z0 ((Maps[Y, y0, Z, z0].loop F).1 p) ((Maps[Y, y0, Z, z0].loop F).1 q) } ;
} ;

-- Corollary 7 (end): over Z/2, w . w = refl for w in Omega^2 K(Z/2,4)
module S' {
  module B = KK[Z2ab] ;
  s' (w : (Id (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)) (refl (B.pt four)))) : Id (Id (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)) (refl (B.pt four))) (trans (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)) (refl (B.pt four)) (refl (B.pt four)) w w) (refl (refl (B.pt four))) =
    equiv-inj (Id (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)) (refl (B.pt four))) (Id (B.K three) (B.pt three) (B.pt three)) (Maps[(Id (B.K four) (B.pt four) (B.pt four)), refl (B.pt four), B.K three, B.pt three].loop (B.e three).1).1 (LoopIso[l].loop-pe-equiv (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)) (B.K three) (B.pt three) (B.e three))
      (trans (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)) (refl (B.pt four)) (refl (B.pt four)) w w) (refl (refl (B.pt four)))
      (calc (Id (B.K three) (B.pt three) (B.pt three)) {
        (Maps[(Id (B.K four) (B.pt four) (B.pt four)), refl (B.pt four), B.K three, B.pt three].loop (B.e three).1).1 (trans (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)) (refl (B.pt four)) (refl (B.pt four)) w w)
          =< LMult[(Id (B.K four) (B.pt four) (B.pt four)), refl (B.pt four), B.K three, B.pt three, (B.e three).1].lmult w w >
        trans (B.K three) (B.pt three) (B.pt three) (B.pt three) ((Maps[(Id (B.K four) (B.pt four) (B.pt four)), refl (B.pt four), B.K three, B.pt three].loop (B.e three).1).1 w) ((Maps[(Id (B.K four) (B.pt four) (B.pt four)), refl (B.pt four), B.K three, B.pt three].loop (B.e three).1).1 w)
          =< Sq0.s two ((Maps[(Id (B.K four) (B.pt four) (B.pt four)), refl (B.pt four), B.K three, B.pt three].loop (B.e three).1).1 w) >
        refl (B.pt three)
          =< symH (Maps[(Id (B.K four) (B.pt four) (B.pt four)), refl (B.pt four), B.K three, B.pt three].loop (B.e three).1).2 >
        (Maps[(Id (B.K four) (B.pt four) (B.pt four)), refl (B.pt four), B.K three, B.pt three].loop (B.e three).1).1 (refl (refl (B.pt four))) }) ;
} ;

-- K(2,1) at the types of the circle: K(Z,1) of the circle is identified with
-- KK.K 1 here, in loop-k22 and in k21-sq (as in CupSquare.e1), and k21 is then
-- locked
k21 : PtMap CS.C.Z1.K1 CS.C.Z1.k0 CS.C.Z1.K1 CS.C.Z1.k0 = KMap[Zab, Zab, twoH Zab].K (suc zero) ;
-- loop K(2,2) = e_1 ; K(2,1) ; e_1^-1 (KMap.loopK 1, with the raw KK.e 1, and CupSquare.e1-def)
loop-k22 : Id (Maps[KZ2, kz2, KZ2, kz2].PMO) (Maps[KZ2, kz2, KZ2, kz2].loop (KMap[Zab, Zab, twoH Zab].K two))
    (ptcomp (Id KZ2 kz2 kz2) (refl kz2) CS.C.Z1.K1 CS.C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) (ptcomp (Id KZ2 kz2 kz2) (refl kz2) CS.C.Z1.K1 CS.C.Z1.k0 CS.C.Z1.K1 CS.C.Z1.k0 CS.e1.1 k21) CS.e1inv) =
  transH (KMap[Zab, Zab, twoH Zab].loopK (suc zero))
    (apH (\ E -> ptcomp (Id KZ2 kz2 kz2) (refl kz2) CS.C.Z1.K1 CS.C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) (ptcomp (Id KZ2 kz2 kz2) (refl kz2) CS.C.Z1.K1 CS.C.Z1.k0 CS.C.Z1.K1 CS.C.Z1.k0 E.1 k21) (pt-inv (Id KZ2 kz2 kz2) (refl kz2) CS.C.Z1.K1 CS.C.Z1.k0 E).1)
       (symH CS.e1-def)) ;
-- (loop K(2,1)) p = p . p: Lemma 6 at m = 0 for A = Z (with loopK 0)
k21-sq (p : Id CS.C.Z1.K1 CS.C.Z1.k0 CS.C.Z1.k0) : Id (Id CS.C.Z1.K1 CS.C.Z1.k0 CS.C.Z1.k0) ((Maps[CS.C.Z1.K1, CS.C.Z1.k0, CS.C.Z1.K1, CS.C.Z1.k0].loop k21).1 p) (trans CS.C.Z1.K1 CS.C.Z1.k0 CS.C.Z1.k0 CS.C.Z1.k0 p p) =
  Puppe[l].pt-happly (Id CS.C.Z1.K1 CS.C.Z1.k0 CS.C.Z1.k0) (refl CS.C.Z1.k0) (Id CS.C.Z1.K1 CS.C.Z1.k0 CS.C.Z1.k0) (refl CS.C.Z1.k0) (Maps[CS.C.Z1.K1, CS.C.Z1.k0, CS.C.Z1.K1, CS.C.Z1.k0].loop k21) (sq CS.C.Z1.K1 CS.C.Z1.k0)
    (transH (KMap[Zab, Zab, twoH Zab].loopK zero) (symH (Dbl[Zab].dbl zero))) p ;
opaque k21 ;

-- Lemma 8 (E2), for one target Y; and E 0 is pointwise refl
module ETwo (Y : U l) (y0 : Y) {
  module ED = H4Bilinear[l].EDef[Y, y0] ;
  module KT = KMap[Zab, Zab, twoH Zab] ;
  -- the argument of evPt in E (K(2,2) ; c) is K(2,1) ; phi c
  phi-two (c : PtMap KZ2 kz2 (PtMap KZ2 kz2 Y y0) ED.L4.pt0) : Id (PtMap ED.C.Z1.K1 ED.C.Z1.k0 (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0) (ED.phi (ptcomp KZ2 kz2 KZ2 kz2 (PtMap KZ2 kz2 Y y0) ED.L4.pt0 (KT.K two) c)) (ptcomp ED.C.Z1.K1 ED.C.Z1.k0 ED.C.Z1.K1 ED.C.Z1.k0 (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 k21 (ED.phi c)) =
    calc (PtMap ED.C.Z1.K1 ED.C.Z1.k0 (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0) {
      ED.phi (ptcomp KZ2 kz2 KZ2 kz2 (PtMap KZ2 kz2 Y y0) ED.L4.pt0 (KT.K two) c)
        =< refl (ED.phi (ptcomp KZ2 kz2 KZ2 kz2 (PtMap KZ2 kz2 Y y0) ED.L4.pt0 (KT.K two) c)) >
      ptcomp ED.C.Z1.K1 ED.C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 CS.e1inv (ptcomp (Id KZ2 kz2 kz2) (refl kz2) (Id (PtMap KZ2 kz2 Y y0) ED.L4.pt0 ED.L4.pt0) (refl ED.L4.pt0) (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 (ED.MM.loop (ptcomp KZ2 kz2 KZ2 kz2 (PtMap KZ2 kz2 Y y0) ED.L4.pt0 (KT.K two) c)) ED.L4.ev-pt.1)
        =< apH (\ H -> ptcomp ED.C.Z1.K1 ED.C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 CS.e1inv (ptcomp (Id KZ2 kz2 kz2) (refl kz2) (Id (PtMap KZ2 kz2 Y y0) ED.L4.pt0 ED.L4.pt0) (refl ED.L4.pt0) (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 H ED.L4.ev-pt.1))
             (loop-comp KZ2 kz2 KZ2 kz2 (PtMap KZ2 kz2 Y y0) ED.L4.pt0 (KT.K two) c) >
      ptcomp ED.C.Z1.K1 ED.C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 CS.e1inv (ptcomp (Id KZ2 kz2 kz2) (refl kz2) (Id (PtMap KZ2 kz2 Y y0) ED.L4.pt0 ED.L4.pt0) (refl ED.L4.pt0) (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0
        (ptcomp (Id KZ2 kz2 kz2) (refl kz2) (Id KZ2 kz2 kz2) (refl kz2) (Id (PtMap KZ2 kz2 Y y0) ED.L4.pt0 ED.L4.pt0) (refl ED.L4.pt0) (Maps[KZ2, kz2, KZ2, kz2].loop (KT.K two)) (ED.MM.loop c)) ED.L4.ev-pt.1)
        =< apH (\ H -> ptcomp ED.C.Z1.K1 ED.C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 CS.e1inv (ptcomp (Id KZ2 kz2 kz2) (refl kz2) (Id (PtMap KZ2 kz2 Y y0) ED.L4.pt0 ED.L4.pt0) (refl ED.L4.pt0) (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 (ptcomp (Id KZ2 kz2 kz2) (refl kz2) (Id KZ2 kz2 kz2) (refl kz2) (Id (PtMap KZ2 kz2 Y y0) ED.L4.pt0 ED.L4.pt0) (refl ED.L4.pt0) H (ED.MM.loop c)) ED.L4.ev-pt.1))
             loop-k22 >
      ptcomp ED.C.Z1.K1 ED.C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 CS.e1inv (ptcomp (Id KZ2 kz2 kz2) (refl kz2) (Id (PtMap KZ2 kz2 Y y0) ED.L4.pt0 ED.L4.pt0) (refl ED.L4.pt0) (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0
        (ptcomp (Id KZ2 kz2 kz2) (refl kz2) (Id KZ2 kz2 kz2) (refl kz2) (Id (PtMap KZ2 kz2 Y y0) ED.L4.pt0 ED.L4.pt0) (refl ED.L4.pt0)
           (ptcomp (Id KZ2 kz2 kz2) (refl kz2) ED.C.Z1.K1 ED.C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) (ptcomp (Id KZ2 kz2 kz2) (refl kz2) ED.C.Z1.K1 ED.C.Z1.k0 ED.C.Z1.K1 ED.C.Z1.k0 CS.e1.1 k21) CS.e1inv)
           (ED.MM.loop c)) ED.L4.ev-pt.1)
        =< apH (ptcomp ED.C.Z1.K1 ED.C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 CS.e1inv)
             (ptcomp-assoc (Id KZ2 kz2 kz2) (refl kz2) (Id KZ2 kz2 kz2) (refl kz2) (Id (PtMap KZ2 kz2 Y y0) ED.L4.pt0 ED.L4.pt0) (refl ED.L4.pt0) (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0
                (ptcomp (Id KZ2 kz2 kz2) (refl kz2) ED.C.Z1.K1 ED.C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) (ptcomp (Id KZ2 kz2 kz2) (refl kz2) ED.C.Z1.K1 ED.C.Z1.k0 ED.C.Z1.K1 ED.C.Z1.k0 CS.e1.1 k21) CS.e1inv) (ED.MM.loop c) ED.L4.ev-pt.1) >
      ptcomp ED.C.Z1.K1 ED.C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 CS.e1inv (ptcomp (Id KZ2 kz2 kz2) (refl kz2) (Id KZ2 kz2 kz2) (refl kz2) (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0
        (ptcomp (Id KZ2 kz2 kz2) (refl kz2) ED.C.Z1.K1 ED.C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) (ptcomp (Id KZ2 kz2 kz2) (refl kz2) ED.C.Z1.K1 ED.C.Z1.k0 ED.C.Z1.K1 ED.C.Z1.k0 CS.e1.1 k21) CS.e1inv)
        (ptcomp (Id KZ2 kz2 kz2) (refl kz2) (Id (PtMap KZ2 kz2 Y y0) ED.L4.pt0 ED.L4.pt0) (refl ED.L4.pt0) (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 (ED.MM.loop c) ED.L4.ev-pt.1))
        =< apH (ptcomp ED.C.Z1.K1 ED.C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 CS.e1inv)
             (ptcomp-assoc (Id KZ2 kz2 kz2) (refl kz2) ED.C.Z1.K1 ED.C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0
                (ptcomp (Id KZ2 kz2 kz2) (refl kz2) ED.C.Z1.K1 ED.C.Z1.k0 ED.C.Z1.K1 ED.C.Z1.k0 CS.e1.1 k21) CS.e1inv (ptcomp (Id KZ2 kz2 kz2) (refl kz2) (Id (PtMap KZ2 kz2 Y y0) ED.L4.pt0 ED.L4.pt0) (refl ED.L4.pt0) (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 (ED.MM.loop c) ED.L4.ev-pt.1)) >
      ptcomp ED.C.Z1.K1 ED.C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 CS.e1inv (ptcomp (Id KZ2 kz2 kz2) (refl kz2) ED.C.Z1.K1 ED.C.Z1.k0 (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0
        (ptcomp (Id KZ2 kz2 kz2) (refl kz2) ED.C.Z1.K1 ED.C.Z1.k0 ED.C.Z1.K1 ED.C.Z1.k0 CS.e1.1 k21) (ED.phi c))
        =< apH (ptcomp ED.C.Z1.K1 ED.C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 CS.e1inv)
             (ptcomp-assoc (Id KZ2 kz2 kz2) (refl kz2) ED.C.Z1.K1 ED.C.Z1.k0 ED.C.Z1.K1 ED.C.Z1.k0 (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 CS.e1.1 k21 (ED.phi c)) >
      ptcomp ED.C.Z1.K1 ED.C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 CS.e1inv (ptcomp (Id KZ2 kz2 kz2) (refl kz2) ED.C.Z1.K1 ED.C.Z1.k0 (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 CS.e1.1 (ptcomp ED.C.Z1.K1 ED.C.Z1.k0 ED.C.Z1.K1 ED.C.Z1.k0 (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 k21 (ED.phi c)))
        =< symH (ptcomp-assoc ED.C.Z1.K1 ED.C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) ED.C.Z1.K1 ED.C.Z1.k0 (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 CS.e1inv CS.e1.1 (ptcomp ED.C.Z1.K1 ED.C.Z1.k0 ED.C.Z1.K1 ED.C.Z1.k0 (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 k21 (ED.phi c))) >
      ptcomp ED.C.Z1.K1 ED.C.Z1.k0 ED.C.Z1.K1 ED.C.Z1.k0 (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 (ptcomp ED.C.Z1.K1 ED.C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) ED.C.Z1.K1 ED.C.Z1.k0 CS.e1inv CS.e1.1) (ptcomp ED.C.Z1.K1 ED.C.Z1.k0 ED.C.Z1.K1 ED.C.Z1.k0 (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 k21 (ED.phi c))
        =< apH (\ H -> ptcomp ED.C.Z1.K1 ED.C.Z1.k0 ED.C.Z1.K1 ED.C.Z1.k0 (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 H (ptcomp ED.C.Z1.K1 ED.C.Z1.k0 ED.C.Z1.K1 ED.C.Z1.k0 (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 k21 (ED.phi c)))
             (pt-inv-r (Id KZ2 kz2 kz2) (refl kz2) ED.C.Z1.K1 ED.C.Z1.k0 CS.e1) >
      ptcomp ED.C.Z1.K1 ED.C.Z1.k0 ED.C.Z1.K1 ED.C.Z1.k0 (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 (ptid ED.C.Z1.K1 ED.C.Z1.k0) (ptcomp ED.C.Z1.K1 ED.C.Z1.k0 ED.C.Z1.K1 ED.C.Z1.k0 (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 k21 (ED.phi c))
        =< Fibres[l].ptcomp-idl ED.C.Z1.K1 ED.C.Z1.k0 (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 (ptcomp ED.C.Z1.K1 ED.C.Z1.k0 ED.C.Z1.K1 ED.C.Z1.k0 (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 k21 (ED.phi c)) >
      ptcomp ED.C.Z1.K1 ED.C.Z1.k0 ED.C.Z1.K1 ED.C.Z1.k0 (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 k21 (ED.phi c) } ;
  -- Lemma 8
  e-two (c : PtMap KZ2 kz2 (PtMap KZ2 kz2 Y y0) ED.L4.pt0) (x : KZ2) : Id (Id (Id Y y0 y0) (refl y0) (refl y0)) ((ED.E (ptcomp KZ2 kz2 KZ2 kz2 (PtMap KZ2 kz2 Y y0) ED.L4.pt0 (KT.K two) c)).1 x) (trans (Id Y y0 y0) (refl y0) (refl y0) (refl y0) ((ED.E c).1 x) ((ED.E c).1 x)) =
    calc (Id (Id Y y0 y0) (refl y0) (refl y0)) {
      (ED.E (ptcomp KZ2 kz2 KZ2 kz2 (PtMap KZ2 kz2 Y y0) ED.L4.pt0 (KT.K two) c)).1 x
        =< refl ((ED.E (ptcomp KZ2 kz2 KZ2 kz2 (PtMap KZ2 kz2 Y y0) ED.L4.pt0 (KT.K two) c)).1 x) >
