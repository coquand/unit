        =< apH (\ F -> (ED.LO.ev (ED.C.evPt ED.LO.pt0 F)).1 x) phi-zero >
      (ED.LO.ev (ED.C.evPt ED.LO.pt0 (ptconst ED.C.Z1.K1 ED.C.Z1.k0 (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0))).1 x
        =< apH (\ u -> (ED.LO.ev u).1 x)
             (transH (ED.C.evPt-loop ED.LO.pt0 (ptconst ED.C.Z1.K1 ED.C.Z1.k0 (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0))
                (Puppe[l].pt-happly (Id ED.C.Z1.K1 ED.C.Z1.k0 ED.C.Z1.k0) (refl ED.C.Z1.k0) (Id (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 ED.LO.pt0) (refl ED.LO.pt0) (Maps[ED.C.Z1.K1, ED.C.Z1.k0, (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)), ED.LO.pt0].loop (ptconst ED.C.Z1.K1 ED.C.Z1.k0 (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0))
