} ;

-- Lemma 9
l2-mult (Y : U l) (y0 : Y) (Y' : U l) (y0' : Y') (G : PtMap Y y0 Y' y0') (a b : Id (Id Y y0 y0) (refl y0) (refl y0)) :
  Id (Id (Id Y' y0' y0') (refl y0') (refl y0'))
    ((Maps[Id Y y0 y0, refl y0, Id Y' y0' y0', refl y0'].loop (Maps[Y, y0, Y', y0'].loop G)).1 (trans (Id Y y0 y0) (refl y0) (refl y0) (refl y0) a b))
    (trans (Id Y' y0' y0') (refl y0') (refl y0') (refl y0')
       ((Maps[Id Y y0 y0, refl y0, Id Y' y0' y0', refl y0'].loop (Maps[Y, y0, Y', y0'].loop G)).1 a)
       ((Maps[Id Y y0 y0, refl y0, Id Y' y0' y0', refl y0'].loop (Maps[Y, y0, Y', y0'].loop G)).1 b)) =
  LMult[Id Y y0 y0, refl y0, Id Y' y0' y0', refl y0', Maps[Y, y0, Y', y0'].loop G].lmult a b ;

-- the reduced cup square
kbar : PtMap KZ2 kz2 (KK[Z2ab].K four) (KK[Z2ab].pt four) =
  ptcomp KZ2 kz2 KZ4 kz4 (KK[Z2ab].K four) (KK[Z2ab].pt four) CS.kappa (H4Bilinear[l].Lev[Zab, Z2ab].K rho four) ;

-- Theorem 10
module Kill {
  module B = KK[Z2ab] ;
  module KT = KMap[Zab, Zab, twoH Zab] ;
  module BL = H4Bilinear[l].BilAt[Z2ab] ;
  module EN = H4Bilinear[l].ENat[KZ4, kz4, B.K four, B.pt four, H4Bilinear[l].Lev[Zab, Z2ab].K rho four] ;
  -- E c'' is pointwise refl
  e-c'' (x : KZ2) : Id (Id (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)) (refl (B.pt four))) ((BL.ED.E (ptcomp KZ2 kz2 (PtMap KZ2 kz2 KZ4 kz4) CS.L4.pt0 BL.M' BL.ED.L4.pt0 (ptcomp KZ2 kz2 KZ2 kz2 (PtMap KZ2 kz2 KZ4 kz4) CS.L4.pt0 (KT.K two) CS.c2) EN.Gs)).1 x) (refl (refl (B.pt four))) =
    calc (Id (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)) (refl (B.pt four))) {
      (BL.ED.E (ptcomp KZ2 kz2 (PtMap KZ2 kz2 KZ4 kz4) CS.L4.pt0 BL.M' BL.ED.L4.pt0 (ptcomp KZ2 kz2 KZ2 kz2 (PtMap KZ2 kz2 KZ4 kz4) CS.L4.pt0 (KT.K two) CS.c2) EN.Gs)).1 x
        =< EN.e-nat (ptcomp KZ2 kz2 KZ2 kz2 (PtMap KZ2 kz2 KZ4 kz4) CS.L4.pt0 (KT.K two) CS.c2) x >
      (EN.MO.loop EN.lG).1 ((EN.E (ptcomp KZ2 kz2 KZ2 kz2 (PtMap KZ2 kz2 KZ4 kz4) CS.L4.pt0 (KT.K two) CS.c2)).1 x)
        =< apH (EN.MO.loop EN.lG).1 (ETwo[KZ4, kz4].e-two CS.c2 x) >
      (EN.MO.loop EN.lG).1 (trans (Id KZ4 kz4 kz4) (refl kz4) (refl kz4) (refl kz4) ((EN.E CS.c2).1 x) ((EN.E CS.c2).1 x))
        =< l2-mult KZ4 kz4 (B.K four) (B.pt four) (H4Bilinear[l].Lev[Zab, Z2ab].K rho four) ((EN.E CS.c2).1 x) ((EN.E CS.c2).1 x) >
      trans (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)) (refl (B.pt four)) (refl (B.pt four)) ((EN.MO.loop EN.lG).1 ((EN.E CS.c2).1 x)) ((EN.MO.loop EN.lG).1 ((EN.E CS.c2).1 x))
        =< S'.s' ((EN.MO.loop EN.lG).1 ((EN.E CS.c2).1 x)) >
      refl (refl (B.pt four)) } ;
  theta-pt (x : KZ2) : Id (B.K two) ((BL.Theta (ptcomp KZ2 kz2 (PtMap KZ2 kz2 KZ4 kz4) CS.L4.pt0 BL.M' BL.ED.L4.pt0 (ptcomp KZ2 kz2 KZ2 kz2 (PtMap KZ2 kz2 KZ4 kz4) CS.L4.pt0 (KT.K two) CS.c2) EN.Gs)).1 x) ((BL.Theta (ptconst KZ2 kz2 BL.M' BL.ED.L4.pt0)).1 x) =
    apH BL.L.jB.1.1 (transH (e-c'' x) (symH (ETwo[B.K four, B.pt four].e-zero x))) ;
  kill : Id (PtMap KZ2 kz2 BL.M' BL.ED.L4.pt0) (ptcomp KZ2 kz2 (PtMap KZ2 kz2 KZ4 kz4) CS.L4.pt0 BL.M' BL.ED.L4.pt0 (ptcomp KZ2 kz2 KZ2 kz2 (PtMap KZ2 kz2 KZ4 kz4) CS.L4.pt0 (KT.K two) CS.c2) EN.Gs) (ptconst KZ2 kz2 BL.M' BL.ED.L4.pt0) =
    BL.theta-inj (ptcomp KZ2 kz2 (PtMap KZ2 kz2 KZ4 kz4) CS.L4.pt0 BL.M' BL.ED.L4.pt0 (ptcomp KZ2 kz2 KZ2 kz2 (PtMap KZ2 kz2 KZ4 kz4) CS.L4.pt0 (KT.K two) CS.c2) EN.Gs) (ptconst KZ2 kz2 BL.M' BL.ED.L4.pt0)
      (idJ (KZ2 -> B.K two) (BL.Theta (ptcomp KZ2 kz2 (PtMap KZ2 kz2 KZ4 kz4) CS.L4.pt0 BL.M' BL.ED.L4.pt0 (ptcomp KZ2 kz2 KZ2 kz2 (PtMap KZ2 kz2 KZ4 kz4) CS.L4.pt0 (KT.K two) CS.c2) EN.Gs)).1 (\ k e -> (z : Id (B.K two) (k kz2) (B.pt two)) -> Id (PtMap KZ2 kz2 (B.K two) (B.pt two)) (BL.Theta (ptcomp KZ2 kz2 (PtMap KZ2 kz2 KZ4 kz4) CS.L4.pt0 BL.M' BL.ED.L4.pt0 (ptcomp KZ2 kz2 KZ2 kz2 (PtMap KZ2 kz2 KZ4 kz4) CS.L4.pt0 (KT.K two) CS.c2) EN.Gs)) (k, z))
         (H4Classes[l].pi-set KZ2 kz2 (B.K two) (B.pt two) BL.sK2 BL.cK2 (BL.Theta (ptcomp KZ2 kz2 (PtMap KZ2 kz2 KZ4 kz4) CS.L4.pt0 BL.M' BL.ED.L4.pt0 (ptcomp KZ2 kz2 KZ2 kz2 (PtMap KZ2 kz2 KZ4 kz4) CS.L4.pt0 (KT.K two) CS.c2) EN.Gs)).1 (BL.Theta (ptcomp KZ2 kz2 (PtMap KZ2 kz2 KZ4 kz4) CS.L4.pt0 BL.M' BL.ED.L4.pt0 (ptcomp KZ2 kz2 KZ2 kz2 (PtMap KZ2 kz2 KZ4 kz4) CS.L4.pt0 (KT.K two) CS.c2) EN.Gs)).2)
         (BL.Theta (ptconst KZ2 kz2 BL.M' BL.ED.L4.pt0)).1 (FL.funext KZ2 (\ x -> B.K two) (BL.Theta (ptcomp KZ2 kz2 (PtMap KZ2 kz2 KZ4 kz4) CS.L4.pt0 BL.M' BL.ED.L4.pt0 (ptcomp KZ2 kz2 KZ2 kz2 (PtMap KZ2 kz2 KZ4 kz4) CS.L4.pt0 (KT.K two) CS.c2) EN.Gs)).1 (BL.Theta (ptconst KZ2 kz2 BL.M' BL.ED.L4.pt0)).1 theta-pt) (BL.Theta (ptconst KZ2 kz2 BL.M' BL.ED.L4.pt0)).2) ;
  -- by definition, c'' x at K(2,2) x is kbar (K(2,2) x)
  N-def (x : KZ2) : Id (B.K four) (((ptcomp KZ2 kz2 (PtMap KZ2 kz2 KZ4 kz4) CS.L4.pt0 BL.M' BL.ED.L4.pt0 (ptcomp KZ2 kz2 KZ2 kz2 (PtMap KZ2 kz2 KZ4 kz4) CS.L4.pt0 (KT.K two) CS.c2) EN.Gs).1 x).1 ((KT.K two).1 x)) (kbar.1 ((KT.K two).1 x)) = refl (kbar.1 ((KT.K two).1 x)) ;
  N (x : KZ2) : Id (B.K four) (kbar.1 ((KT.K two).1 x)) (B.pt four) =
    transH (symH (N-def x)) (ap (PtMap KZ2 kz2 BL.M' BL.ED.L4.pt0) (B.K four) (\ c -> (c.1 x).1 ((KT.K two).1 x)) (ptcomp KZ2 kz2 (PtMap KZ2 kz2 KZ4 kz4) CS.L4.pt0 BL.M' BL.ED.L4.pt0 (ptcomp KZ2 kz2 KZ2 kz2 (PtMap KZ2 kz2 KZ4 kz4) CS.L4.pt0 (KT.K two) CS.c2) EN.Gs) (ptconst KZ2 kz2 BL.M' BL.ED.L4.pt0) kill) ;
  -- the same, for the locked K(2,2) (Lev.K-def)
  N-lev (x : KZ2) : Id (B.K four) (kbar.1 ((H4Bilinear[l].Lev[Zab, Zab].K (twoH Zab) two).1 x)) (B.pt four) =
    transH (apH (\ F -> kbar.1 (F.1 x)) (symH (H4Bilinear[l].Lev[Zab, Zab].K-def (twoH Zab) two))) (N x) ;
} ;

-- Section 5: the cross term.  X = K(Z,3), W = K(Z/2,5);
-- f = e_2 ; kbar ; e_4^-1 : Omega X ->pt Omega W, D_p (q) = (f p)^-1 . f (p . q).
-- e_2 = Lev[Z,Z].eB 2 (the e_2 by which conj_2 conjugates on the target side)
-- and e_4 = Lev[Z,Z/2].eB 4 are the LOCKED ones, and Lemma 6 at m = 2 is read
-- through Lev.conj-def and Lev.K-def (f-sq): with the raw KK.e 2 and KMap.K 2,
-- the by-definition step of f-sq unfolded their constructions (two is a numeral).
--   Dhat        p |-> D_p, pointed by (E f)^-1
--   tau         Lemma 11: h |-> ev (unev h . l^-1), l = unev f (PtMapLoops at
--               Omega X, W), a pointed equivalence (PMO, f) ~ (PMO, 0) with
--               inverse k |-> ev (unev k . l) (unev-ev: ev is an equivalence);
--               pointwise (tau h) q = h q . (f q)^-1 (tau-formula: ev-ap,
--               ap-trans, ap-sym, ev-unev)
--   Cj          h |-> e_2^-1 ; h ; e_4, injective (pre-inj, post-inj)
--   delta       Definition 12: e_2^-1 ; Dhat ; tau ; Cj : K(Z,2) ->pt M_{K(Z/2,4)}
--   cell-of     Lemma 13: delta = 0 gives f = D_p for every p (Cj and tau are
--               injective, sec-ret of e_2)
--   diag-null   Lemma 14: the diagonal of delta is pointwise *: by tau-formula
--               (not by unfolding tau: tau-fun is locked after tau-def), the
--               definition of D, f (p . p) = refl (f-sq: Lemma 6 at A = Z, m = 2,
--               the sec-eq of e_2, Kill.N-lev and the pointing of e_4^-1), and s at
--               m = 4; delta-def, parts-def: delta x is Cj (tau (D_{e_2^-1 x})) by
--               definition; diag-cls: its class is
--               [0] (ptmap-path, and a loop of K(Z/2,4) is merely refl)
--   cross       Theorem 15: delta = 0, by Theorem A (DiagAt.diag-inj,
--               ClassesAt.cls-inj; cls (dprime c) is [diag c] by definition,
--               diag 0 is 0 by definition); cross-cell: f = D_p.
--               diag-cls is an equality of classes; cross upgrades it to an
--               equality of bipointed maps; no representative is chosen.
module Cross {
  module A = KK[Zab] ;
  module B = KK[Z2ab] ;
  module KT = KMap[Zab, Zab, twoH Zab] ;
  module L = H4Bilinear[l].Lev[Zab, Zab] ;
  module L2 = H4Bilinear[l].Lev[Zab, Z2ab] ;
  module MX = Maps[(A.K (suc two)), (A.pt (suc two)), (B.K (suc four)), (B.pt (suc four))] ;
  module LP = CS.PtMapLoops[(Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))), (refl (A.pt (suc two))), (B.K (suc four)), (B.pt (suc four))] ;
  module DA = H4Diagonal[l].DiagAt[Z2ab] ;
  module CL = H4Classes[l].ClassesAt[Z2ab] ;
  module TC = TruncationCombinators[l] ;
  -- the setting
  f : MX.PMO = ptcomp (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K four) (B.pt four) (Id (B.K (suc four)) (B.pt (suc four)) (B.pt (suc four))) (refl (B.pt (suc four))) (ptcomp (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) KZ2 kz2 (B.K four) (B.pt four) (L.eB two).1 kbar) (pt-inv (Id (B.K (suc four)) (B.pt (suc four)) (B.pt (suc four))) (refl (B.pt (suc four))) (B.K four) (B.pt four) (L2.eB four)).1 ;
  Dp (p : (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two)))) : MX.PMO = MX.D (A.pt (suc two)) (B.pt (suc four)) f.1 p ;
  Dhat : PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) MX.PMO f = (Dp, sym MX.PMO f (Dp (refl (A.pt (suc two)))) (MX.E f)) ;

  -- Lemma 11
  tau-fun (h : MX.PMO) : MX.PMO = LP.ev (trans (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 LP.pt0 (LP.unev.1 h) (sym (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 (LP.unev.1 f))) ;
  tau-inv (k : MX.PMO) : MX.PMO = LP.ev (trans (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 LP.pt0 (LP.unev.1 k) (LP.unev.1 f)) ;
  -- by definition
  tau-def (h : MX.PMO) : Id MX.PMO (tau-fun h) (LP.ev (trans (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 LP.pt0 (LP.unev.1 h) (sym (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 (LP.unev.1 f)))) = refl (tau-fun h) ;
  tau-inv-def (k : MX.PMO) : Id MX.PMO (tau-inv k) (LP.ev (trans (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 LP.pt0 (LP.unev.1 k) (LP.unev.1 f))) = refl (tau-inv k) ;
  -- locked after their "by definition" lemmas
  opaque tau-fun ; opaque tau-inv ;
  unev-ev (P : (Id (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0)) : Id (Id (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0) (LP.unev.1 (LP.ev P)) P =
    equiv-inj (Id (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0) MX.PMO LP.ev LP.ev-pt.2 (LP.unev.1 (LP.ev P)) P (LP.ev-unev (LP.ev P)) ;
  tau-sec (k : MX.PMO) : Id MX.PMO (tau-fun (tau-inv k)) k = calc MX.PMO {
    tau-fun (tau-inv k)
      =< transH (tau-def (tau-inv k)) (apH (\ g -> LP.ev (trans (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 LP.pt0 (LP.unev.1 g) (sym (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 (LP.unev.1 f)))) (tau-inv-def k)) >
    LP.ev (trans (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 LP.pt0 (LP.unev.1 (LP.ev (trans (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 LP.pt0 (LP.unev.1 k) (LP.unev.1 f)))) (sym (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 (LP.unev.1 f)))
      =< apH (\ P -> LP.ev (trans (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 LP.pt0 P (sym (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 (LP.unev.1 f)))) (unev-ev (trans (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 LP.pt0 (LP.unev.1 k) (LP.unev.1 f))) >
    LP.ev (trans (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 LP.pt0 (trans (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 LP.pt0 (LP.unev.1 k) (LP.unev.1 f)) (sym (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 (LP.unev.1 f)))
      =< apH LP.ev (Groupoid[l].cancel-r (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 LP.pt0 (LP.unev.1 k) (LP.unev.1 f)) >
    LP.ev (LP.unev.1 k)
      =< LP.ev-unev k >
    k } ;
  tau-ret (h : MX.PMO) : Id MX.PMO (tau-inv (tau-fun h)) h = calc MX.PMO {
    tau-inv (tau-fun h)
      =< transH (tau-inv-def (tau-fun h)) (apH (\ g -> LP.ev (trans (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 LP.pt0 (LP.unev.1 g) (LP.unev.1 f))) (tau-def h)) >
    LP.ev (trans (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 LP.pt0 (LP.unev.1 (LP.ev (trans (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 LP.pt0 (LP.unev.1 h) (sym (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 (LP.unev.1 f))))) (LP.unev.1 f))
      =< apH (\ P -> LP.ev (trans (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 LP.pt0 P (LP.unev.1 f))) (unev-ev (trans (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 LP.pt0 (LP.unev.1 h) (sym (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 (LP.unev.1 f)))) >
    LP.ev (trans (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 LP.pt0 (trans (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 LP.pt0 (LP.unev.1 h) (sym (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 (LP.unev.1 f))) (LP.unev.1 f))
      =< apH LP.ev (Groupoid[l].cancel-r' (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 LP.pt0 (LP.unev.1 h) (LP.unev.1 f)) >
    LP.ev (LP.unev.1 h)
      =< LP.ev-unev h >
    h } ;
  -- the pointing: tau f = ev refl = 0
  tau-pt : Id MX.PMO (tau-fun f) (ptconst (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (Id (B.K (suc four)) (B.pt (suc four)) (B.pt (suc four))) (refl (B.pt (suc four)))) = calc MX.PMO {
    tau-fun f
      =< tau-def f >
    LP.ev (trans (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 LP.pt0 (LP.unev.1 f) (sym (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 (LP.unev.1 f)))
      =< apH LP.ev (Groupoid[l].trans-sym-r (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 (LP.unev.1 f)) >
    LP.ev (refl LP.pt0)
      =< LP.ev-pt.1.2 >
    LP.r
      =< refl LP.r >
    (ptconst (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (Id (B.K (suc four)) (B.pt (suc four)) (B.pt (suc four))) (refl (B.pt (suc four)))) } ;
  tau : PtEquiv MX.PMO f MX.PMO (ptconst (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (Id (B.K (suc four)) (B.pt (suc four)) (B.pt (suc four))) (refl (B.pt (suc four)))) = ((tau-fun, tau-pt), qinv MX.PMO MX.PMO tau-fun tau-inv tau-sec tau-ret) ;
  -- pointwise formula
  tau-formula (h : MX.PMO) (q : (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two)))) : Id (Id (B.K (suc four)) (B.pt (suc four)) (B.pt (suc four))) ((tau-fun h).1 q) (trans (B.K (suc four)) (B.pt (suc four)) (B.pt (suc four)) (B.pt (suc four)) (h.1 q) (sym (B.K (suc four)) (B.pt (suc four)) (B.pt (suc four)) (f.1 q))) =
    calc (Id (B.K (suc four)) (B.pt (suc four)) (B.pt (suc four))) {
      (tau-fun h).1 q
        =< apH (\ g -> g.1 q) (tau-def h) >
      (LP.ev (trans (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 LP.pt0 (LP.unev.1 h) (sym (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 (LP.unev.1 f)))).1 q
        =< LP.ev-ap LP.pt0 (trans (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 LP.pt0 (LP.unev.1 h) (sym (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 (LP.unev.1 f))) q >
      ap (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) (B.K (suc four)) (\ F -> F.1 q) LP.pt0 LP.pt0 (trans (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 LP.pt0 (LP.unev.1 h) (sym (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 (LP.unev.1 f)))
        =< Groupoid[l].ap-trans (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) (B.K (suc four)) (\ F -> F.1 q) LP.pt0 LP.pt0 LP.pt0 (LP.unev.1 h) (sym (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 (LP.unev.1 f)) >
      trans (B.K (suc four)) (B.pt (suc four)) (B.pt (suc four)) (B.pt (suc four)) (ap (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) (B.K (suc four)) (\ F -> F.1 q) LP.pt0 LP.pt0 (LP.unev.1 h)) (ap (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) (B.K (suc four)) (\ F -> F.1 q) LP.pt0 LP.pt0 (sym (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K (suc four)) (B.pt (suc four))) LP.pt0 LP.pt0 (LP.unev.1 f)))
