        =< refl (ED.phi (ptconst KZ2 kz2 (PtMap KZ2 kz2 Y y0) ED.L4.pt0)) >
      ptcomp ED.C.Z1.K1 ED.C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 CS.e1inv (ptcomp (Id KZ2 kz2 kz2) (refl kz2) (Id (PtMap KZ2 kz2 Y y0) ED.L4.pt0 ED.L4.pt0) (refl ED.L4.pt0) (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 (ED.MM.loop (ptconst KZ2 kz2 (PtMap KZ2 kz2 Y y0) ED.L4.pt0)) ED.L4.ev-pt.1)
        =< apH (\ H -> ptcomp ED.C.Z1.K1 ED.C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 CS.e1inv (ptcomp (Id KZ2 kz2 kz2) (refl kz2) (Id (PtMap KZ2 kz2 Y y0) ED.L4.pt0 ED.L4.pt0) (refl ED.L4.pt0) (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 H ED.L4.ev-pt.1)) (loop-const KZ2 kz2 (PtMap KZ2 kz2 Y y0) ED.L4.pt0) >
      ptcomp ED.C.Z1.K1 ED.C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 CS.e1inv (ptcomp (Id KZ2 kz2 kz2) (refl kz2) (Id (PtMap KZ2 kz2 Y y0) ED.L4.pt0 ED.L4.pt0) (refl ED.L4.pt0) (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 (ptconst (Id KZ2 kz2 kz2) (refl kz2) (Id (PtMap KZ2 kz2 Y y0) ED.L4.pt0 ED.L4.pt0) (refl ED.L4.pt0)) ED.L4.ev-pt.1)
        =< apH (ptcomp ED.C.Z1.K1 ED.C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 CS.e1inv) (comp-const-l (Id KZ2 kz2 kz2) (refl kz2) (Id (PtMap KZ2 kz2 Y y0) ED.L4.pt0 ED.L4.pt0) (refl ED.L4.pt0) (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 ED.L4.ev-pt.1) >
      ptcomp ED.C.Z1.K1 ED.C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 CS.e1inv (ptconst (Id KZ2 kz2 kz2) (refl kz2) (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0)
        =< comp-const-r ED.C.Z1.K1 ED.C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 CS.e1inv >
      ptconst ED.C.Z1.K1 ED.C.Z1.k0 (PtMap KZ2 kz2 (Id Y y0 y0) (refl y0)) ED.LO.pt0 } ;
  e-zero (x : KZ2) : Id (Id (Id Y y0 y0) (refl y0) (refl y0)) ((ED.E (ptconst KZ2 kz2 (PtMap KZ2 kz2 Y y0) ED.L4.pt0)).1 x) (refl (refl y0)) =
    calc (Id (Id Y y0 y0) (refl y0) (refl y0)) {
      (ED.E (ptconst KZ2 kz2 (PtMap KZ2 kz2 Y y0) ED.L4.pt0)).1 x
