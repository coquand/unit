-- The pointed universal property of a truncation and its effect on
-- homotopy groups (doc/finite-truncation.pdf, §4).
--   PtUP.up        Proposition 12: eta^* : Map_*(T X, Y) -> Map_*(X, Y) is an
--                  equivalence for isTrunc m Y (Sigma over the equivalence
--                  of Lemma 2 on the bases; the pointing of ptcomp eta G is
--                  refl . G0 = G0)
--   fib-htpy       fibres of homotopic maps are equivalent
--   loop-conn      Lemma 13: if the fibres of F are isConn (n+1), those of
--                  loop F are isConn n (J on the pointing; then loop F is ap
--                  up to refl . -, and Lemma 3)
--   ConnPi1        a pointed map whose looping has isConn 2 fibres (merely
--                  inhabited, any two points merely equal) induces a
--                  bijection on pi_1: surjective and injective on classes,
--                  so its fibres are contractible (no choice)
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ; open HLevels[l] ; open Connected[l] ;
open Lemma4[l] ; open DeloopMaps[l] ; open LoopCalc[l] ;
open ConnectedMaps[l] ; open Truncations[l] ; open SphereAxiom[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module W = Whitehead[l] ; module E = Equivalences[l] ;

------------------------------------------------------------------------
-- Proposition 12

module PtUP (m : Nat) (TO : TruncOp[m]) (X : U l) (x0 : X) {
  eta : PtMap X x0 (TO.T X) (TO.unit X x0) = (TO.unit X, refl (TO.unit X x0)) ;
  module EY (Y : U l) (tY : isTrunc m Y) {
    module EL = Elim[m, X, TO.T X, TO.unit X, TO.conn X, \ z -> Y, \ z -> tY] ;
    -- the pointing of eta ; G is refl . G0
    pt-eq (y0 : Y) (G : PtMap (TO.T X) (TO.unit X x0) Y y0) :
      Id (PtMap X x0 Y y0) (ptcomp X x0 (TO.T X) (TO.unit X x0) Y y0 eta G) (EL.precomp G.1, G.2) =
      ap (Id Y (G.1 (TO.unit X x0)) y0) (PtMap X x0 Y y0) (\ e -> (EL.precomp G.1, e))
        (trans Y (G.1 (TO.unit X x0)) (G.1 (TO.unit X x0)) y0 (refl (G.1 (TO.unit X x0))) G.2) G.2
        (trans-refl-l Y (G.1 (TO.unit X x0)) y0 G.2) ;
  } ;
  up (Y : U l) (y0 : Y) (tY : isTrunc m Y) :
    isEquiv (PtMap (TO.T X) (TO.unit X x0) Y y0) (PtMap X x0 Y y0) (\ G -> ptcomp X x0 (TO.T X) (TO.unit X x0) Y y0 eta G) =
    E.homotopy (PtMap (TO.T X) (TO.unit X x0) Y y0) (PtMap X x0 Y y0)
      (\ w -> (EY[Y, tY].EL.precomp w.1, w.2),
       sigma-base (TO.T X -> Y) (X -> Y) (EY[Y, tY].EL.precomp, EY[Y, tY].EL.equiv) (\ h -> Id Y (h x0) y0))
      (\ G -> ptcomp X x0 (TO.T X) (TO.unit X x0) Y y0 eta G) (EY[Y, tY].pt-eq y0) ;
} ;

------------------------------------------------------------------------
-- Lemma 13

fib-htpy (A B : U l) (g h : A -> B) (H : (a : A) -> Id B (g a) (h a)) (b : B) : Equiv (W.fib A B g b) (W.fib A B h b) =
  Fibres[l].sigma-equiv A (\ a -> Id B (g a) b) (\ a -> Id B (h a) b)
    (\ a -> Fibres[l].trans-equiv B (h a) (g a) b (sym B (g a) (h a) (H a))) ;

-- for a map pointed by refl, loop F is ap F up to refl . -
loop-refl (Y : U l) (y0 : Y) (Z : U l) (f : Y -> Z) (q : Id Y y0 y0) :
  Id (Id Z (f y0) (f y0)) ((Maps[Y, y0, Z, f y0].loop (f, refl (f y0))).1 q) (ap Y Z f y0 y0 q) =
  transH (Maps[Y, y0, Z, f y0].loop-ap (f, refl (f y0)) q) (trans-refl-l Z (f y0) (f y0) (ap Y Z f y0 y0 q)) ;

loop-conn (n : Nat) (Y : U l) (y0 : Y) (Z : U l) (f : Y -> Z) (cf : (z : Z) -> isConn (suc n) (W.fib Y Z f z)) :
  (z0 : Z) (p : Id Z (f y0) z0) (v : Id Z z0 z0) -> isConn n (W.fib (Id Y y0 y0) (Id Z z0 z0) (Maps[Y, y0, Z, z0].loop (f, p)).1 v) =
  \ z0 p -> idJ Z (f y0) (\ z1 p1 -> (v : Id Z z1 z1) -> isConn n (W.fib (Id Y y0 y0) (Id Z z1 z1) (Maps[Y, y0, Z, z1].loop (f, p1)).1 v))
    (\ v -> Deloop[l].equiv-conn n (W.fib (Id Y y0 y0) (Id Z (f y0) (f y0)) (Maps[Y, y0, Z, f y0].loop (f, refl (f y0))).1 v)
              (W.fib (Id Y y0 y0) (Id Z (f y0) (f y0)) (ap Y Z f y0 y0) v)
              (fib-htpy (Id Y y0 y0) (Id Z (f y0) (f y0)) (Maps[Y, y0, Z, f y0].loop (f, refl (f y0))).1 (ap Y Z f y0 y0) (loop-refl Y y0 Z f) v)
              (fib-ap-conn n Y Z f cf y0 y0 v))
    z0 p ;

------------------------------------------------------------------------
-- bijection on pi_1

module ConnPi1 (Y : U l) (y0 : Y) (Z : U l) (z0 : Z) (F : PtMap Y y0 Z z0)
  (c : (v : Id Z z0 z0) -> isConn (suc (suc zero)) (W.fib (Id Y y0 y0) (Id Z z0 z0) (Maps[Y, y0, Z, z0].loop F).1 v)) {
  module PY = PiOne[l].PiOne[Y, y0] ; module PZ = PiOne[l].PiOne[Z, z0] ;
  module I = PiOne[l].Induced[Y, y0, Z, z0, F] ;
  -- injective on classes
  inj-cls (q q' : PY.O) (e : Id PZ.grp.G (I.map (PY.cls q)) (I.map (PY.cls q'))) : Id PY.grp.G (PY.cls q) (PY.cls q') =
    Tr.Trunc[Id PZ.O ((Maps[Y, y0, Z, z0].loop F).1 q) ((Maps[Y, y0, Z, z0].loop F).1 q')].induction @l
      (\ t -> Id PY.grp.G (PY.cls q) (PY.cls q')) (\ t -> PY.grp.setG _ _)
      (\ r -> Tr.Trunc[Id (W.fib PY.O PZ.O (Maps[Y, y0, Z, z0].loop F).1 ((Maps[Y, y0, Z, z0].loop F).1 q'))
                (q, r) (q', refl ((Maps[Y, y0, Z, z0].loop F).1 q'))].induction @l
           (\ t -> Id PY.grp.G (PY.cls q) (PY.cls q')) (\ t -> PY.grp.setG _ _)
           (\ s -> apH PY.cls (ap (W.fib PY.O PZ.O (Maps[Y, y0, Z, z0].loop F).1 ((Maps[Y, y0, Z, z0].loop F).1 q')) PY.O (\ w -> w.1)
                     (q, r) (q', refl ((Maps[Y, y0, Z, z0].loop F).1 q')) s))
           (((c ((Maps[Y, y0, Z, z0].loop F).1 q')).2 (q, r) (q', refl ((Maps[Y, y0, Z, z0].loop F).1 q'))).1))
      (PZ.P.Q.effective ((Maps[Y, y0, Z, z0].loop F).1 q) ((Maps[Y, y0, Z, z0].loop F).1 q') (transH (symH (I.map-cls q)) (transH e (I.map-cls q')))) ;
  inj (x x' : PY.grp.G) (e : Id PZ.grp.G (I.map x) (I.map x')) : Id PY.grp.G x x' =
    PY.P.ind @l (\ x1 -> Id PZ.grp.G (I.map x1) (I.map x') -> Id PY.grp.G x1 x')
      (\ x1 -> Axioms[l].FunExtLemmas[fe @l].isProp-Pi (Id PZ.grp.G (I.map x1) (I.map x')) (\ e1 -> Id PY.grp.G x1 x') (\ e1 -> PY.grp.setG _ _))
      (\ q -> PY.P.ind @l (\ x2 -> Id PZ.grp.G (I.map (PY.cls q)) (I.map x2) -> Id PY.grp.G (PY.cls q) x2)
         (\ x2 -> Axioms[l].FunExtLemmas[fe @l].isProp-Pi (Id PZ.grp.G (I.map (PY.cls q)) (I.map x2)) (\ e1 -> Id PY.grp.G (PY.cls q) x2) (\ e1 -> PY.grp.setG _ _))
         (\ q' -> inj-cls q q') x')
      x e ;
  fib-prop (y : PZ.grp.G) : isProp (W.fib PY.grp.G PZ.grp.G I.map y) = \ w w' ->
    Sigma-eq PY.grp.G (\ x -> Id PZ.grp.G (I.map x) y) w.1 w'.1 w.2 w'.2 (inj w.1 w'.1 (transH w.2 (symH w'.2))) (PZ.grp.setG _ y) ;
  -- surjective
  fib-inh (y : PZ.grp.G) : Tr.Trunc[W.fib PY.grp.G PZ.grp.G I.map y].carrier =
    PZ.P.ind @l (\ y1 -> Tr.Trunc[W.fib PY.grp.G PZ.grp.G I.map y1].carrier) (\ y1 -> Tr.Trunc[W.fib PY.grp.G PZ.grp.G I.map y1].proposition)
      (\ v -> TC.map (W.fib PY.O PZ.O (Maps[Y, y0, Z, z0].loop F).1 v) (W.fib PY.grp.G PZ.grp.G I.map (PZ.cls v))
         (\ w -> (PY.cls w.1, transH (I.map-cls w.1) (apH PZ.cls w.2))) (c v).1) y ;
  equiv : isEquiv PY.grp.G PZ.grp.G I.map =
    W.contr-equiv PY.grp.G PZ.grp.G I.map (\ y ->
      Tr.Trunc[W.fib PY.grp.G PZ.grp.G I.map y].induction @l (\ t -> isContr (W.fib PY.grp.G PZ.grp.G I.map y))
        (\ t -> Torsor[l].isProp-isContr (W.fib PY.grp.G PZ.grp.G I.map y))
        (\ w -> (w, fib-prop y w)) (fib-inh y)) ;
} ;
