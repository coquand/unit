-- Doubling detects the coefficient (doc/br-universal.pdf, Section 5).
--   EPre        precomposition in the second variable, Gs : m |-> G ; m on
--               M_Y = Map_*(K(Z,2), Y), pointed by comp-const-r
--     ccr-def   Gs.2 is, by definition of comp-const-r, ap of e |-> (const, e)
--     ccr-ev    Lemma ccr: evaluating the pointing of Gs at x gives refl
--               (ap-ap, ap-const)
--     nat-pt    looping Gs, evaluated at x, is evaluation at G x (loop-ap,
--               ap-conj, ccr-ev, ap-ap, conj-refl-loop)
--     At.e-pre  Lemma Epre: E (c ; Gs) x = E c (G x).  The pattern of
--               ENat.e-nat: E-loop on both sides; an unpointed homotopy hh
--               between A1 = phi (c ; Gs) ; Ex x and A2 = phi c ; Ex (G x)
--               (ev-ap, loop-comp, nat-pt); LoopHomotopy and Eckmann-Hilton
--               remove the conjugating 2-loop.  One target Y, one circle
--               instance: no g-eq.
--   DblE.dbl-e  Lemma 6 pointwise through e_m: e_m (p . p) = K(2,m) (e_m p)
--               (Dbl.dbl, pt-inv-r)
--   ThetaEq     theta-pt: pointwise equal E gives Theta c = Theta c' (pi-set); theta-eq:
--               two bipointed maps with pointwise equal E are equal (Theorem B:
--               theta-inj, pi-set, as Kill.kill)
--   Quad        Proposition Q, (2x)^2 = 4x^2.  iota-dbl (Lemma iota2:
--               injectivity of iota-eq, iota-eq-fun by definition, loop-mult of
--               loop e_3, dbl-e at m = 2); e-c2 (cup-norm); l2-two, l2-four
--               (loop^2 K(2,4) is squaring: loopK, dbl at m = 3, loop-sq; K(4,4) =
--               K(2,4) ; K(2,4) by k-comp, K-def, loop-comp twice); cL = K(2,2) ;
--               c2 ; Gs (e-two, e-pre, e-c2, iota-dbl) and cR = c2g 4 (e-nat, e-c2,
--               l2-four) have pointwise equal E, so quad : cL = cR; kappa-dbl: the
--               diagonals, kappa (K(2,2) x) = K(4,4) (kappa x), by definition of
--               cL, cR and kappa; kappa-cls: the classes (pi-mere, relates,
--               comp-beta).
--   Nec         Lemma N (necessity), for G^ : K(Z,3) ->pt K(B,5) and
--               H = unconj (loop G^) (Conj with e_2 of Z and e_4 of B; locked
--               after H-def, H-eq):
--               sq-inv (e_2^-1 (K(2,2) y) = p . p: dbl-e, injectivity of e_2);
--               N-pt: H (K(2,2) y) = K(2_B,4) (H y) (H-def, sq-inv, loop-mult of
--               G^, dbl-e at m = 4); N-lev: the same for the locked K(2,2),
--               K(2_B,4) (Lev.K-def); N-cls: the classes (pi-mere, relates), stated
--               with the locked maps (with the raw KMap.K four, pi-mere's types put
--               it in whnf and opened its construction, Kmap / cellS).
--     Two       for h with Phi h = [H]: left, right (the two classes as
--               Phi (h o 4), Phi (2_B o h): comp-beta, comp-assoc, kappa-cls,
--               ptcomp-assoc, K-def, k-comp); hom-eq (h4 injective); two-tors:
--               h 1 + h 1 = 0 (at one, the homomorphism law, AbL.solve, invr).
--   ZExt.z-ext  homomorphisms out of Z are equal when they agree at 1 (pos n by
--               induction, pos (n+1) = pos n + 1 by definition of add; negsuc n
--               = neg (pos (n+1)) and hom-neg)
--   Factor      Lemma factor: if h 1 + h 1 = 0 then h = rho ; g, g false = 0,
--               g true = h 1 (g-hom by cases; z-ext at 1)
--   Psi         Proposition Psi: Psi g = [kbar ; K(g,4)] = Phi (rho ; g)
--               (psi-phi: comp-beta... ptcomp-assoc, K-def, k-comp); psi-inj
--               (h4 injective, then the values at true and false)
--   Conv        Corollary conv: an inhabitant (G^, pi) of Unloop (cj (kappa ;
--               K(h,4))) gives 2 h = 0 (unconj-conj, Nec.Two.two-tors)
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ; open HLevels[l] ; open Connected[l] ;
open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ; open Torsor[l] ; open LoopCalc[l] ;
open EMMaps[l] ; open HomotopyClasses[l] ; open SphereUniversal[l] ; open PostnikovRealization[l] ; open KZ2Cohomology[l] ;
open Z2[l] ; open Doubling[l] ;
module CS = CupSquare[l] ;
module LC = LoopConj[l] ;
module E = Equivalences[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module ZZ = Integers[l] ;

-- Lemmas ccr and Epre, for one target Y and G : K(Z,2) ->pt K(Z,2)
module EPre (Y : U l) (y0 : Y) (G : PtMap KZ2 kz2 KZ2 kz2) {
  module EN = H4Bilinear[l].ENat[Y, y0, Y, y0, ptid Y y0] ;
  module ED = H4Bilinear[l].EDef[Y, y0] ;
  module MG = Maps[EN.M, EN.L4.pt0, EN.M, EN.L4.pt0] ;
  module EHY = EH[l].EH[Y, y0] ;
  Gs : PtMap EN.M EN.L4.pt0 EN.M EN.L4.pt0 = (\ m -> ptcomp KZ2 kz2 KZ2 kz2 Y y0 G m, comp-const-r KZ2 kz2 KZ2 kz2 Y y0 G) ;
  -- by definition of comp-const-r
  ccr-def : Id (Id EN.M (Gs.1 EN.L4.pt0) EN.L4.pt0) Gs.2
      (ap (Id Y y0 y0) EN.M (\ e -> (\ a -> y0, e)) (ap KZ2 Y (\ b -> y0) (G.1 kz2) kz2 G.2) (refl y0) (ap-const KZ2 Y y0 (G.1 kz2) kz2 G.2)) =
    refl Gs.2 ;
  -- Lemma ccr
  ccr-ev (x : KZ2) : Id (Id Y y0 y0) (ap EN.M Y (\ F -> F.1 x) (Gs.1 EN.L4.pt0) EN.L4.pt0 Gs.2) (refl y0) =
    transH (apH (ap EN.M Y (\ F -> F.1 x) (Gs.1 EN.L4.pt0) EN.L4.pt0) ccr-def)
      (transH (ap-ap (Id Y y0 y0) EN.M Y (\ e -> (\ a -> y0, e)) (\ F -> F.1 x) (ap KZ2 Y (\ b -> y0) (G.1 kz2) kz2 G.2) (refl y0) (ap-const KZ2 Y y0 (G.1 kz2) kz2 G.2))
        (ap-const (Id Y y0 y0) Y y0 (ap KZ2 Y (\ b -> y0) (G.1 kz2) kz2 G.2) (refl y0) (ap-const KZ2 Y y0 (G.1 kz2) kz2 G.2))) ;
  -- looping Gs, evaluated at x, is evaluation at G x
  nat-pt (P : Id EN.M EN.L4.pt0 EN.L4.pt0) (x : KZ2) :
    Id (Id Y y0 y0) (ap EN.M Y (\ F -> F.1 x) EN.L4.pt0 EN.L4.pt0 ((MG.loop Gs).1 P)) (ap EN.M Y (\ F -> F.1 (G.1 x)) EN.L4.pt0 EN.L4.pt0 P) =
    transH (apH (ap EN.M Y (\ F -> F.1 x) EN.L4.pt0 EN.L4.pt0) (MG.loop-ap Gs P))
      (transH (H4Bilinear[l].ap-conj EN.M Y (\ F -> F.1 x) (Gs.1 EN.L4.pt0) (ap EN.M EN.M Gs.1 EN.L4.pt0 EN.L4.pt0 P) EN.L4.pt0 Gs.2)
        (transH (apH (\ e -> LC.conj Y y0 y0 e (ap EN.M Y (\ F -> F.1 x) (Gs.1 EN.L4.pt0) (Gs.1 EN.L4.pt0) (ap EN.M EN.M Gs.1 EN.L4.pt0 EN.L4.pt0 P))) (ccr-ev x))
          (transH (apH (LC.conj Y y0 y0 (refl y0)) (ap-ap EN.M EN.M Y Gs.1 (\ F -> F.1 x) EN.L4.pt0 EN.L4.pt0 P))
            (LC.conj-refl-loop Y y0 (ap EN.M Y (\ F -> F.1 (G.1 x)) EN.L4.pt0 EN.L4.pt0 P))))) ;
  module At (c : PtMap KZ2 kz2 EN.M EN.L4.pt0) (x : KZ2) {
    A1 : PtMap EN.K1 EN.k0 (Id Y y0 y0) (refl y0) =
      ptcomp EN.K1 EN.k0 EN.N EN.LO.pt0 (Id Y y0 y0) (refl y0) (EN.phi (ptcomp KZ2 kz2 EN.M EN.L4.pt0 EN.M EN.L4.pt0 c Gs)) (EN.Ex x) ;
    A2 : PtMap EN.K1 EN.k0 (Id Y y0 y0) (refl y0) =
      ptcomp EN.K1 EN.k0 EN.N EN.LO.pt0 (Id Y y0 y0) (refl y0) (EN.phi c) (EN.Ex (G.1 x)) ;
    -- an unpointed homotopy A1 = A2
    hh (k : EN.K1) : Id (Id Y y0 y0) (A1.1 k) (A2.1 k) =
      transH (EN.L4.ev-ap EN.L4.pt0 ((EN.MM.loop (ptcomp KZ2 kz2 EN.M EN.L4.pt0 EN.M EN.L4.pt0 c Gs)).1 (CS.e1inv.1 k)) x)
        (transH (apH (ap EN.M Y (\ F -> F.1 x) EN.L4.pt0 EN.L4.pt0) (apH (\ H -> H.1 (CS.e1inv.1 k)) (loop-comp KZ2 kz2 EN.M EN.L4.pt0 EN.M EN.L4.pt0 c Gs)))
          (transH (nat-pt ((EN.MM.loop c).1 (CS.e1inv.1 k)) x)
            (symH (EN.L4.ev-ap EN.L4.pt0 ((EN.MM.loop c).1 (CS.e1inv.1 k)) (G.1 x))))) ;
    module LH = LC.LoopHomotopy[EN.K1, EN.k0, Id Y y0 y0, refl y0, A1, A2, hh] ;
    -- Lemma Epre
    e-pre : Id (Id (Id Y y0 y0) (refl y0) (refl y0)) ((ED.E (ptcomp KZ2 kz2 EN.M EN.L4.pt0 EN.M EN.L4.pt0 c Gs)).1 x) ((ED.E c).1 (G.1 x)) =
      transH (EN.E-loop (ptcomp KZ2 kz2 EN.M EN.L4.pt0 EN.M EN.L4.pt0 c Gs) x)
        (transH (symH (transH (apH (\ u -> LC.conj (Id Y y0 y0) (refl y0) (refl y0) LH.c u) (refl ((EN.MKY.loop A1).1 EN.C.g)))
                   (transH (apH (trans (Id Y y0 y0) (refl y0) (refl y0) (refl y0) (sym (Id Y y0 y0) (refl y0) (refl y0) LH.c))
                              (EHY.eh ((EN.MKY.loop A1).1 EN.C.g) LH.c))
                      (trans-cancel (Id Y y0 y0) (refl y0) (refl y0) (refl y0) LH.c ((EN.MKY.loop A1).1 EN.C.g)))))
          (transH (symH (LH.loop-homotopy EN.C.g))
             (symH (EN.E-loop c (G.1 x))))) ;
  } ;
} ;

-- an equivalence after its inverse, pointwise; the map of a composite, by
-- definition (stated at a generic pointed equivalence, so that instances at
-- KK.e two do not put the equivalence in whnf)
sec-pt (X : U l) (x : X) (Y : U l) (y : Y) (e : PtEquiv X x Y y) (z : Y) : Id Y (e.1.1 ((pt-inv X x Y y e).1.1 z)) z =
  apH (\ F -> F.1 z) (pt-inv-r X x Y y e) ;
pt-comp-fun (X : U l) (x : X) (Y : U l) (y : Y) (Z : U l) (z : Z) (e : PtEquiv X x Y y) (d : PtEquiv Y y Z z) (w : X) :
  Id Z ((pt-comp X x Y y Z z e d).1.1 w) (d.1.1 (e.1.1 w)) = refl (d.1.1 (e.1.1 w)) ;

-- Lemma 6 pointwise, through e_m
module DblE (Ga : Ab) {
  module A = KK[Ga] ;
  module KT = KMap[Ga, Ga, twoH Ga] ;
  dbl-e (m : Nat) (p : Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) :
    Id (A.K m) ((A.e m).1.1 (trans (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m)) (A.pt (suc m)) p p)) ((KT.K m).1 ((A.e m).1.1 p)) =
    transH (apH (A.e m).1.1 (apH (\ F -> F.1 p) (Dbl[Ga].dbl m)))
      (apH (\ F -> F.1 ((KT.K m).1 ((A.e m).1.1 p))) (pt-inv-r (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (A.K m) (A.pt m) (A.e m))) ;
} ;

-- Theorem B: bipointed maps with pointwise equal E are equal
module ThetaEq (Gb : Ab) {
  module B = KK[Gb] ;
  module BL = H4Bilinear[l].BilAt[Gb] ;
  -- Theta c = Theta c', an equality in the set Map_*(K(Z,2), K(B,2)) (pi-set)
  theta-pt (c c' : PtMap KZ2 kz2 BL.M' BL.ED.L4.pt0)
    (h : (x : KZ2) -> Id (Id (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)) (refl (B.pt four))) ((BL.ED.E c).1 x) ((BL.ED.E c').1 x)) :
    Id (PtMap KZ2 kz2 (B.K two) (B.pt two)) (BL.Theta c) (BL.Theta c') =
    idJ (KZ2 -> B.K two) (BL.Theta c).1 (\ k e -> (z : Id (B.K two) (k kz2) (B.pt two)) -> Id (PtMap KZ2 kz2 (B.K two) (B.pt two)) (BL.Theta c) (k, z))
      (H4Classes[l].pi-set KZ2 kz2 (B.K two) (B.pt two) BL.sK2 BL.cK2 (BL.Theta c).1 (BL.Theta c).2)
      (BL.Theta c').1 (FL.funext KZ2 (\ x -> B.K two) (BL.Theta c).1 (BL.Theta c').1 (\ x -> apH BL.L.jB.1.1 (h x))) (BL.Theta c').2 ;
  theta-eq (c c' : PtMap KZ2 kz2 BL.M' BL.ED.L4.pt0)
    (h : (x : KZ2) -> Id (Id (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)) (refl (B.pt four))) ((BL.ED.E c).1 x) ((BL.ED.E c').1 x)) :
    Id (PtMap KZ2 kz2 BL.M' BL.ED.L4.pt0) c c' =
    BL.theta-inj c c' (theta-pt c c' h) ;
} ;

-- Proposition Q
module Quad {
  module A = KK[Zab] ;
  module KT = KMap[Zab, Zab, twoH Zab] ;
  module BL = H4Bilinear[l].BilAt[Zab] ;
  module EP = EPre[KZ4, kz4, KT.K two] ;
  fourH : Hom Zab Zab = KFun[l].hcomp Zab Zab Zab (twoH Zab) (twoH Zab) ;
  module EN4 = H4Bilinear[l].ENat[KZ4, kz4, A.K four, A.pt four, BL.L.K fourH four] ;
  -- the underlying map of iota-eq, by definition (pt-comp, loopPE)
  iota-eq-fun (w : Id (Id KZ4 kz4 kz4) (refl kz4) (refl kz4)) :
    Id KZ2 (CS.iota-eq.1.1 w) ((A.e two).1.1 ((Maps[Id KZ4 kz4 kz4, refl kz4, A.K three, A.pt three].loop (A.e three).1).1 w)) =
    pt-comp-fun (Id (Id KZ4 kz4 kz4) (refl kz4) (refl kz4)) (refl (refl kz4)) (Id (A.K three) (A.pt three) (A.pt three)) (refl (A.pt three)) KZ2 kz2
      (LoopIso[l].loopPE (Id KZ4 kz4 kz4) (refl kz4) (A.K three) (A.pt three) (A.e three)) (A.e two) w ;
  -- iota is a section of iota-eq
  iota-sec (z : KZ2) : Id KZ2 (CS.iota-eq.1.1 (CS.iota.1 z)) z =
    sec-pt (Id (Id KZ4 kz4 kz4) (refl kz4) (refl kz4)) (refl (refl kz4)) KZ2 kz2 CS.iota-eq z ;
  -- Lemma iota2
  iota-dbl (y : KZ2) : Id (Id (Id KZ4 kz4 kz4) (refl kz4) (refl kz4)) (CS.iota.1 ((KT.K two).1 y))
      (trans (Id KZ4 kz4 kz4) (refl kz4) (refl kz4) (refl kz4) (CS.iota.1 y) (CS.iota.1 y)) =
    E.injective (Id (Id KZ4 kz4 kz4) (refl kz4) (refl kz4)) KZ2 CS.iota-eq.1.1 CS.iota-eq.2
      (CS.iota.1 ((KT.K two).1 y)) (trans (Id KZ4 kz4 kz4) (refl kz4) (refl kz4) (refl kz4) (CS.iota.1 y) (CS.iota.1 y))
      (transH (iota-sec ((KT.K two).1 y))
        (symH (calc KZ2 {
          CS.iota-eq.1.1 (trans (Id KZ4 kz4 kz4) (refl kz4) (refl kz4) (refl kz4) (CS.iota.1 y) (CS.iota.1 y))
            =< iota-eq-fun (trans (Id KZ4 kz4 kz4) (refl kz4) (refl kz4) (refl kz4) (CS.iota.1 y) (CS.iota.1 y)) >
          (A.e two).1.1 ((Maps[Id KZ4 kz4 kz4, refl kz4, A.K three, A.pt three].loop (A.e three).1).1 (trans (Id KZ4 kz4 kz4) (refl kz4) (refl kz4) (refl kz4) (CS.iota.1 y) (CS.iota.1 y)))
            =< apH (A.e two).1.1 (CrossTerm[l].LMult[Id KZ4 kz4 kz4, refl kz4, A.K three, A.pt three, (A.e three).1].lmult (CS.iota.1 y) (CS.iota.1 y)) >
          (A.e two).1.1 (trans (A.K three) (A.pt three) (A.pt three) (A.pt three)
             ((Maps[Id KZ4 kz4 kz4, refl kz4, A.K three, A.pt three].loop (A.e three).1).1 (CS.iota.1 y))
             ((Maps[Id KZ4 kz4 kz4, refl kz4, A.K three, A.pt three].loop (A.e three).1).1 (CS.iota.1 y)))
            =< DblE[Zab].dbl-e two ((Maps[Id KZ4 kz4 kz4, refl kz4, A.K three, A.pt three].loop (A.e three).1).1 (CS.iota.1 y)) >
          (KT.K two).1 ((A.e two).1.1 ((Maps[Id KZ4 kz4 kz4, refl kz4, A.K three, A.pt three].loop (A.e three).1).1 (CS.iota.1 y)))
            =< apH (KT.K two).1 (symH (iota-eq-fun (CS.iota.1 y))) >
          (KT.K two).1 (CS.iota-eq.1.1 (CS.iota.1 y))
            =< apH (KT.K two).1 (iota-sec y) >
          (KT.K two).1 y }))) ;
  -- E c2 is iota (cup-norm)
  e-c2 (x : KZ2) : Id (Id (Id KZ4 kz4 kz4) (refl kz4) (refl kz4)) ((BL.ED.E CS.c2).1 x) (CS.iota.1 x) =
    apH (\ H -> H.1 x) CS.cup-norm ;
  -- loop^2 K(2,4) is squaring
  l2-two (w : Id (Id KZ4 kz4 kz4) (refl kz4) (refl kz4)) :
    Id (Id (Id KZ4 kz4 kz4) (refl kz4) (refl kz4))
      ((Maps[Id KZ4 kz4 kz4, refl kz4, Id KZ4 kz4 kz4, refl kz4].loop (Maps[KZ4, kz4, KZ4, kz4].loop (KT.K four))).1 w)
      (trans (Id KZ4 kz4 kz4) (refl kz4) (refl kz4) (refl kz4) w w) =
    transH (apH (\ F -> (Maps[Id KZ4 kz4 kz4, refl kz4, Id KZ4 kz4 kz4, refl kz4].loop F).1 w) (transH (KT.loopK three) (symH (Dbl[Zab].dbl three))))
      (loop-sq KZ4 kz4 w) ;
  -- K(4,4) = K(2,4) ; K(2,4)
  k44 : Id (PtMap KZ4 kz4 KZ4 kz4) (BL.L.K fourH four) (ptcomp KZ4 kz4 KZ4 kz4 KZ4 kz4 (KT.K four) (KT.K four)) =
    transH (symH (BL.L.K-def fourH four)) (KFun[l].Comp[Zab, Zab, Zab, twoH Zab, twoH Zab].k-comp four) ;
  -- loop^2 K(4,4) is the fourth power
  l2-four (w : Id (Id KZ4 kz4 kz4) (refl kz4) (refl kz4)) :
    Id (Id (Id KZ4 kz4 kz4) (refl kz4) (refl kz4))
      ((Maps[Id KZ4 kz4 kz4, refl kz4, Id KZ4 kz4 kz4, refl kz4].loop (Maps[KZ4, kz4, KZ4, kz4].loop (BL.L.K fourH four))).1 w)
      (trans (Id KZ4 kz4 kz4) (refl kz4) (refl kz4) (refl kz4) (trans (Id KZ4 kz4 kz4) (refl kz4) (refl kz4) (refl kz4) w w) (trans (Id KZ4 kz4 kz4) (refl kz4) (refl kz4) (refl kz4) w w)) =
    calc (Id (Id KZ4 kz4 kz4) (refl kz4) (refl kz4)) {
      (Maps[Id KZ4 kz4 kz4, refl kz4, Id KZ4 kz4 kz4, refl kz4].loop (Maps[KZ4, kz4, KZ4, kz4].loop (BL.L.K fourH four))).1 w
        =< apH (\ F -> (Maps[Id KZ4 kz4 kz4, refl kz4, Id KZ4 kz4 kz4, refl kz4].loop (Maps[KZ4, kz4, KZ4, kz4].loop F)).1 w) k44 >
      (Maps[Id KZ4 kz4 kz4, refl kz4, Id KZ4 kz4 kz4, refl kz4].loop (Maps[KZ4, kz4, KZ4, kz4].loop (ptcomp KZ4 kz4 KZ4 kz4 KZ4 kz4 (KT.K four) (KT.K four)))).1 w
        =< apH (\ F -> (Maps[Id KZ4 kz4 kz4, refl kz4, Id KZ4 kz4 kz4, refl kz4].loop F).1 w) (loop-comp KZ4 kz4 KZ4 kz4 KZ4 kz4 (KT.K four) (KT.K four)) >
      (Maps[Id KZ4 kz4 kz4, refl kz4, Id KZ4 kz4 kz4, refl kz4].loop (ptcomp (Id KZ4 kz4 kz4) (refl kz4) (Id KZ4 kz4 kz4) (refl kz4) (Id KZ4 kz4 kz4) (refl kz4) (Maps[KZ4, kz4, KZ4, kz4].loop (KT.K four)) (Maps[KZ4, kz4, KZ4, kz4].loop (KT.K four)))).1 w
        =< apH (\ F -> F.1 w) (loop-comp (Id KZ4 kz4 kz4) (refl kz4) (Id KZ4 kz4 kz4) (refl kz4) (Id KZ4 kz4 kz4) (refl kz4) (Maps[KZ4, kz4, KZ4, kz4].loop (KT.K four)) (Maps[KZ4, kz4, KZ4, kz4].loop (KT.K four))) >
      (Maps[Id KZ4 kz4 kz4, refl kz4, Id KZ4 kz4 kz4, refl kz4].loop (Maps[KZ4, kz4, KZ4, kz4].loop (KT.K four))).1 ((Maps[Id KZ4 kz4 kz4, refl kz4, Id KZ4 kz4 kz4, refl kz4].loop (Maps[KZ4, kz4, KZ4, kz4].loop (KT.K four))).1 w)
        =< apH (Maps[Id KZ4 kz4 kz4, refl kz4, Id KZ4 kz4 kz4, refl kz4].loop (Maps[KZ4, kz4, KZ4, kz4].loop (KT.K four))).1 (l2-two w) >
      (Maps[Id KZ4 kz4 kz4, refl kz4, Id KZ4 kz4 kz4, refl kz4].loop (Maps[KZ4, kz4, KZ4, kz4].loop (KT.K four))).1 (trans (Id KZ4 kz4 kz4) (refl kz4) (refl kz4) (refl kz4) w w)
        =< l2-two (trans (Id KZ4 kz4 kz4) (refl kz4) (refl kz4) (refl kz4) w w) >
      trans (Id KZ4 kz4 kz4) (refl kz4) (refl kz4) (refl kz4) (trans (Id KZ4 kz4 kz4) (refl kz4) (refl kz4) (refl kz4) w w) (trans (Id KZ4 kz4 kz4) (refl kz4) (refl kz4) (refl kz4) w w) } ;
  -- the two bipointed maps
  cL : PtMap KZ2 kz2 BL.M' BL.ED.L4.pt0 =
    ptcomp KZ2 kz2 KZ2 kz2 (PtMap KZ2 kz2 KZ4 kz4) CS.L4.pt0 (KT.K two) (ptcomp KZ2 kz2 (PtMap KZ2 kz2 KZ4 kz4) CS.L4.pt0 (PtMap KZ2 kz2 KZ4 kz4) CS.L4.pt0 CS.c2 EP.Gs) ;
  cR : PtMap KZ2 kz2 BL.M' BL.ED.L4.pt0 = BL.c2g fourH ;
  e-L (x : KZ2) : Id (Id (Id KZ4 kz4 kz4) (refl kz4) (refl kz4)) ((BL.ED.E cL).1 x)
      (trans (Id KZ4 kz4 kz4) (refl kz4) (refl kz4) (refl kz4) (trans (Id KZ4 kz4 kz4) (refl kz4) (refl kz4) (refl kz4) (CS.iota.1 x) (CS.iota.1 x)) (trans (Id KZ4 kz4 kz4) (refl kz4) (refl kz4) (refl kz4) (CS.iota.1 x) (CS.iota.1 x))) =
    transH (CrossTerm[l].ETwo[KZ4, kz4].e-two (ptcomp KZ2 kz2 (PtMap KZ2 kz2 KZ4 kz4) CS.L4.pt0 (PtMap KZ2 kz2 KZ4 kz4) CS.L4.pt0 CS.c2 EP.Gs) x)
      (apH (\ u -> trans (Id KZ4 kz4 kz4) (refl kz4) (refl kz4) (refl kz4) u u)
         (transH (EP.At[CS.c2, x].e-pre) (transH (e-c2 ((KT.K two).1 x)) (iota-dbl x)))) ;
  e-R (x : KZ2) : Id (Id (Id KZ4 kz4 kz4) (refl kz4) (refl kz4)) ((BL.ED.E cR).1 x)
      (trans (Id KZ4 kz4 kz4) (refl kz4) (refl kz4) (refl kz4) (trans (Id KZ4 kz4 kz4) (refl kz4) (refl kz4) (refl kz4) (CS.iota.1 x) (CS.iota.1 x)) (trans (Id KZ4 kz4 kz4) (refl kz4) (refl kz4) (refl kz4) (CS.iota.1 x) (CS.iota.1 x))) =
    transH (EN4.e-nat CS.c2 x) (transH (apH (EN4.MO.loop EN4.lG).1 (e-c2 x)) (l2-four (CS.iota.1 x))) ;
  quad : Id (PtMap KZ2 kz2 BL.M' BL.ED.L4.pt0) cL cR = ThetaEq[Zab].theta-eq cL cR (\ x -> transH (e-L x) (symH (e-R x))) ;
  -- the diagonals
  kappa-dbl (x : KZ2) : Id KZ4 (CS.kappa.1 ((KT.K two).1 x)) ((BL.L.K fourH four).1 (CS.kappa.1 x)) =
    apH (\ c -> (c.1 x).1 x) quad ;
  cOK4 : isConn two (Id KZ4 kz4 kz4) =
    conn-down two (Id KZ4 kz4 kz4) (conn-down three (Id KZ4 kz4 kz4) (conn-id four KZ4 (KK[Zab].conn three) kz4 kz4)) ;
  -- the classes (pointings into K(Z,4) are merely irrelevant)
  kappa-cls : Id (HC KZ2 kz2 KZ4 kz4) (hcl KZ2 kz2 KZ4 kz4 (ptcomp KZ2 kz2 KZ2 kz2 KZ4 kz4 (KT.K two) CS.kappa))
      (hcl KZ2 kz2 KZ4 kz4 (ptcomp KZ2 kz2 KZ4 kz4 KZ4 kz4 CS.kappa (BL.L.K fourH four))) =
    STr[PtMap KZ2 kz2 KZ4 kz4].Q.relates (ptcomp KZ2 kz2 KZ2 kz2 KZ4 kz4 (KT.K two) CS.kappa) (ptcomp KZ2 kz2 KZ4 kz4 KZ4 kz4 CS.kappa (BL.L.K fourH four))
      (FibreH3[l].pi-mere KZ2 kz2 KZ4 kz4 cOK4 (\ x -> CS.kappa.1 ((KT.K two).1 x)) (\ x -> (BL.L.K fourH four).1 (CS.kappa.1 x))
         (FL.funext KZ2 (\ x -> KZ4) (\ x -> CS.kappa.1 ((KT.K two).1 x)) (\ x -> (BL.L.K fourH four).1 (CS.kappa.1 x)) kappa-dbl)
         (ptcomp KZ2 kz2 KZ2 kz2 KZ4 kz4 (KT.K two) CS.kappa).2 (ptcomp KZ2 kz2 KZ4 kz4 KZ4 kz4 CS.kappa (BL.L.K fourH four)).2) ;
} ;

-- Lemma N
module Nec (Gb : Ab) (Ghat : PtMap (KK[Zab].K three) (KK[Zab].pt three) (KK[Gb].K five) (KK[Gb].pt five)) {
  module A = KK[Zab] ;
  module B = KK[Gb] ;
  module KT = KMap[Zab, Zab, twoH Zab] ;
  module KTB = KMap[Gb, Gb, twoH Gb] ;
  module LZ = H4Bilinear[l].Lev[Zab, Zab] ;
  module LB = H4Bilinear[l].Lev[Gb, Gb] ;
  module CJ = Conj[l].Conj[Id (A.K three) (A.pt three) (A.pt three), refl (A.pt three), A.K two, A.pt two,
                           Id (B.K five) (B.pt five) (B.pt five), refl (B.pt five), B.K four, B.pt four, A.e two, B.e four] ;
  module MG = Maps[A.K three, A.pt three, B.K five, B.pt five] ;
  H : PtMap (A.K two) (A.pt two) (B.K four) (B.pt four) = CJ.unconj (MG.loop Ghat) ;
  -- by definition of unconj
  H-def (z : A.K two) : Id (B.K four) (H.1 z) ((B.e four).1.1 ((MG.loop Ghat).1 (CJ.eAi.1 z))) = refl (H.1 z) ;
  H-eq : Id (PtMap (A.K two) (A.pt two) (B.K four) (B.pt four)) H (CJ.unconj (MG.loop Ghat)) = refl H ;
  -- locked after its by-definition lemmas H-def, H-eq
  opaque H ;
  e2-sec (z : A.K two) : Id (A.K two) ((A.e two).1.1 (CJ.eAi.1 z)) z =
    sec-pt (Id (A.K three) (A.pt three) (A.pt three)) (refl (A.pt three)) (A.K two) (A.pt two) (A.e two) z ;
  -- e_2^-1 (K(2,2) y) = p . p, p = e_2^-1 y
  sq-inv (y : A.K two) : Id (Id (A.K three) (A.pt three) (A.pt three)) (CJ.eAi.1 ((KT.K two).1 y))
      (trans (A.K three) (A.pt three) (A.pt three) (A.pt three) (CJ.eAi.1 y) (CJ.eAi.1 y)) =
    E.injective (Id (A.K three) (A.pt three) (A.pt three)) (A.K two) (A.e two).1.1 (A.e two).2
      (CJ.eAi.1 ((KT.K two).1 y)) (trans (A.K three) (A.pt three) (A.pt three) (A.pt three) (CJ.eAi.1 y) (CJ.eAi.1 y))
      (transH (e2-sec ((KT.K two).1 y))
        (symH (transH (DblE[Zab].dbl-e two (CJ.eAi.1 y)) (apH (KT.K two).1 (e2-sec y))))) ;
  -- (i) pointwise
  N-pt (y : A.K two) : Id (B.K four) (H.1 ((KT.K two).1 y)) ((KTB.K four).1 (H.1 y)) =
    calc (B.K four) {
      H.1 ((KT.K two).1 y)
        =< H-def ((KT.K two).1 y) >
      (B.e four).1.1 ((MG.loop Ghat).1 (CJ.eAi.1 ((KT.K two).1 y)))
        =< apH (\ q -> (B.e four).1.1 ((MG.loop Ghat).1 q)) (sq-inv y) >
      (B.e four).1.1 ((MG.loop Ghat).1 (trans (A.K three) (A.pt three) (A.pt three) (A.pt three) (CJ.eAi.1 y) (CJ.eAi.1 y)))
        =< apH (B.e four).1.1 (CrossTerm[l].LMult[A.K three, A.pt three, B.K five, B.pt five, Ghat].lmult (CJ.eAi.1 y) (CJ.eAi.1 y)) >
      (B.e four).1.1 (trans (B.K five) (B.pt five) (B.pt five) (B.pt five) ((MG.loop Ghat).1 (CJ.eAi.1 y)) ((MG.loop Ghat).1 (CJ.eAi.1 y)))
        =< DblE[Gb].dbl-e four ((MG.loop Ghat).1 (CJ.eAi.1 y)) >
      (KTB.K four).1 ((B.e four).1.1 ((MG.loop Ghat).1 (CJ.eAi.1 y)))
        =< apH (KTB.K four).1 (symH (H-def y)) >
      (KTB.K four).1 (H.1 y) } ;
  cOB4 : isConn two (Id (B.K four) (B.pt four) (B.pt four)) =
    conn-down two (Id (B.K four) (B.pt four) (B.pt four)) (conn-down three (Id (B.K four) (B.pt four) (B.pt four)) (conn-id four (B.K four) (B.conn three) (B.pt four) (B.pt four))) ;
  -- N-pt for the locked K(2,2), K(2_B,4) (Lev.K-def)
  N-lev (y : A.K two) : Id (B.K four) (H.1 ((LZ.K (twoH Zab) two).1 y)) ((LB.K (twoH Gb) four).1 (H.1 y)) =
    transH (apH (\ F -> H.1 (F.1 y)) (symH (LZ.K-def (twoH Zab) two)))
      (transH (N-pt y) (apH (\ F -> F.1 (H.1 y)) (LB.K-def (twoH Gb) four))) ;
  N-cls : Id (HC (A.K two) (A.pt two) (B.K four) (B.pt four)) (hcl (A.K two) (A.pt two) (B.K four) (B.pt four) (ptcomp (A.K two) (A.pt two) (A.K two) (A.pt two) (B.K four) (B.pt four) (LZ.K (twoH Zab) two) H))
      (hcl (A.K two) (A.pt two) (B.K four) (B.pt four) (ptcomp (A.K two) (A.pt two) (B.K four) (B.pt four) (B.K four) (B.pt four) H (LB.K (twoH Gb) four))) =
    STr[PtMap (A.K two) (A.pt two) (B.K four) (B.pt four)].Q.relates
      (ptcomp (A.K two) (A.pt two) (A.K two) (A.pt two) (B.K four) (B.pt four) (LZ.K (twoH Zab) two) H) (ptcomp (A.K two) (A.pt two) (B.K four) (B.pt four) (B.K four) (B.pt four) H (LB.K (twoH Gb) four))
      (FibreH3[l].pi-mere (A.K two) (A.pt two) (B.K four) (B.pt four) cOB4 (\ y -> H.1 ((LZ.K (twoH Zab) two).1 y)) (\ y -> (LB.K (twoH Gb) four).1 (H.1 y))
         (FL.funext (A.K two) (\ y -> B.K four) (\ y -> H.1 ((LZ.K (twoH Zab) two).1 y)) (\ y -> (LB.K (twoH Gb) four).1 (H.1 y)) N-lev)
         (ptcomp (A.K two) (A.pt two) (A.K two) (A.pt two) (B.K four) (B.pt four) (LZ.K (twoH Zab) two) H).2 (ptcomp (A.K two) (A.pt two) (B.K four) (B.pt four) (B.K four) (B.pt four) H (LB.K (twoH Gb) four)).2) ;
  -- (ii) classes
  module Two (h : Hom Zab Gb) (eh : Id (HC KZ2 kz2 (B.K four) (B.pt four)) (Phi CS.kappa Gb h) (hcl KZ2 kz2 (B.K four) (B.pt four) H)) {
    module Q = Quad ;
    left : Id (HC KZ2 kz2 (B.K four) (B.pt four)) (compC KZ2 kz2 KZ2 kz2 (B.K four) (B.pt four) (hcl KZ2 kz2 KZ2 kz2 (KT.K two)) (hcl KZ2 kz2 (B.K four) (B.pt four) H))
        (Phi CS.kappa Gb (KFun[l].hcomp Zab Zab Gb Q.fourH h)) =
      calc (HC KZ2 kz2 (B.K four) (B.pt four)) {
        compC KZ2 kz2 KZ2 kz2 (B.K four) (B.pt four) (hcl KZ2 kz2 KZ2 kz2 (KT.K two)) (hcl KZ2 kz2 (B.K four) (B.pt four) H)
          =< apH (compC KZ2 kz2 KZ2 kz2 (B.K four) (B.pt four) (hcl KZ2 kz2 KZ2 kz2 (KT.K two))) (symH eh) >
        compC KZ2 kz2 KZ2 kz2 (B.K four) (B.pt four) (hcl KZ2 kz2 KZ2 kz2 (KT.K two)) (hcl KZ2 kz2 (B.K four) (B.pt four) (ptcomp KZ2 kz2 KZ4 kz4 (B.K four) (B.pt four) CS.kappa (KMap[Zab, Gb, h].K four)))
          =< apH (compC KZ2 kz2 KZ2 kz2 (B.K four) (B.pt four) (hcl KZ2 kz2 KZ2 kz2 (KT.K two))) (symH (comp-beta KZ2 kz2 KZ4 kz4 (B.K four) (B.pt four) CS.kappa (KMap[Zab, Gb, h].K four))) >
        compC KZ2 kz2 KZ2 kz2 (B.K four) (B.pt four) (hcl KZ2 kz2 KZ2 kz2 (KT.K two)) (compC KZ2 kz2 KZ4 kz4 (B.K four) (B.pt four) (hcl KZ2 kz2 KZ4 kz4 CS.kappa) (hcl KZ4 kz4 (B.K four) (B.pt four) (KMap[Zab, Gb, h].K four)))
          =< symH (comp-assoc KZ2 kz2 KZ2 kz2 KZ4 kz4 (B.K four) (B.pt four) (hcl KZ2 kz2 KZ2 kz2 (KT.K two)) (hcl KZ2 kz2 KZ4 kz4 CS.kappa) (hcl KZ4 kz4 (B.K four) (B.pt four) (KMap[Zab, Gb, h].K four))) >
        compC KZ2 kz2 KZ4 kz4 (B.K four) (B.pt four) (compC KZ2 kz2 KZ2 kz2 KZ4 kz4 (hcl KZ2 kz2 KZ2 kz2 (KT.K two)) (hcl KZ2 kz2 KZ4 kz4 CS.kappa)) (hcl KZ4 kz4 (B.K four) (B.pt four) (KMap[Zab, Gb, h].K four))
          =< apH (\ c -> compC KZ2 kz2 KZ4 kz4 (B.K four) (B.pt four) c (hcl KZ4 kz4 (B.K four) (B.pt four) (KMap[Zab, Gb, h].K four)))
               (transH (comp-beta KZ2 kz2 KZ2 kz2 KZ4 kz4 (KT.K two) CS.kappa) Q.kappa-cls) >
        compC KZ2 kz2 KZ4 kz4 (B.K four) (B.pt four) (hcl KZ2 kz2 KZ4 kz4 (ptcomp KZ2 kz2 KZ4 kz4 KZ4 kz4 CS.kappa (Q.BL.L.K Q.fourH four))) (hcl KZ4 kz4 (B.K four) (B.pt four) (KMap[Zab, Gb, h].K four))
          =< comp-beta KZ2 kz2 KZ4 kz4 (B.K four) (B.pt four) (ptcomp KZ2 kz2 KZ4 kz4 KZ4 kz4 CS.kappa (Q.BL.L.K Q.fourH four)) (KMap[Zab, Gb, h].K four) >
        hcl KZ2 kz2 (B.K four) (B.pt four) (ptcomp KZ2 kz2 KZ4 kz4 (B.K four) (B.pt four) (ptcomp KZ2 kz2 KZ4 kz4 KZ4 kz4 CS.kappa (Q.BL.L.K Q.fourH four)) (KMap[Zab, Gb, h].K four))
          =< apH (hcl KZ2 kz2 (B.K four) (B.pt four))
               (transH (ptcomp-assoc KZ2 kz2 KZ4 kz4 KZ4 kz4 (B.K four) (B.pt four) CS.kappa (Q.BL.L.K Q.fourH four) (KMap[Zab, Gb, h].K four))
                 (apH (\ F -> ptcomp KZ2 kz2 KZ4 kz4 (B.K four) (B.pt four) CS.kappa (ptcomp KZ4 kz4 KZ4 kz4 (B.K four) (B.pt four) F (KMap[Zab, Gb, h].K four)))
                    (symH (Q.BL.L.K-def Q.fourH four)))) >
        hcl KZ2 kz2 (B.K four) (B.pt four) (ptcomp KZ2 kz2 KZ4 kz4 (B.K four) (B.pt four) CS.kappa (ptcomp KZ4 kz4 KZ4 kz4 (B.K four) (B.pt four) (KMap[Zab, Zab, Q.fourH].K four) (KMap[Zab, Gb, h].K four)))
          =< apH (\ F -> hcl KZ2 kz2 (B.K four) (B.pt four) (ptcomp KZ2 kz2 KZ4 kz4 (B.K four) (B.pt four) CS.kappa F))
               (symH (KFun[l].Comp[Zab, Zab, Gb, Q.fourH, h].k-comp four)) >
        Phi CS.kappa Gb (KFun[l].hcomp Zab Zab Gb Q.fourH h) } ;
    right : Id (HC KZ2 kz2 (B.K four) (B.pt four)) (compC KZ2 kz2 (B.K four) (B.pt four) (B.K four) (B.pt four) (hcl KZ2 kz2 (B.K four) (B.pt four) H) (hcl (B.K four) (B.pt four) (B.K four) (B.pt four) (KTB.K four)))
        (Phi CS.kappa Gb (KFun[l].hcomp Zab Gb Gb h (twoH Gb))) =
      calc (HC KZ2 kz2 (B.K four) (B.pt four)) {
        compC KZ2 kz2 (B.K four) (B.pt four) (B.K four) (B.pt four) (hcl KZ2 kz2 (B.K four) (B.pt four) H) (hcl (B.K four) (B.pt four) (B.K four) (B.pt four) (KTB.K four))
          =< apH (\ c -> compC KZ2 kz2 (B.K four) (B.pt four) (B.K four) (B.pt four) c (hcl (B.K four) (B.pt four) (B.K four) (B.pt four) (KTB.K four))) (symH eh) >
        compC KZ2 kz2 (B.K four) (B.pt four) (B.K four) (B.pt four) (hcl KZ2 kz2 (B.K four) (B.pt four) (ptcomp KZ2 kz2 KZ4 kz4 (B.K four) (B.pt four) CS.kappa (KMap[Zab, Gb, h].K four))) (hcl (B.K four) (B.pt four) (B.K four) (B.pt four) (KTB.K four))
          =< comp-beta KZ2 kz2 (B.K four) (B.pt four) (B.K four) (B.pt four) (ptcomp KZ2 kz2 KZ4 kz4 (B.K four) (B.pt four) CS.kappa (KMap[Zab, Gb, h].K four)) (KTB.K four) >
        hcl KZ2 kz2 (B.K four) (B.pt four) (ptcomp KZ2 kz2 (B.K four) (B.pt four) (B.K four) (B.pt four) (ptcomp KZ2 kz2 KZ4 kz4 (B.K four) (B.pt four) CS.kappa (KMap[Zab, Gb, h].K four)) (KTB.K four))
          =< apH (hcl KZ2 kz2 (B.K four) (B.pt four)) (ptcomp-assoc KZ2 kz2 KZ4 kz4 (B.K four) (B.pt four) (B.K four) (B.pt four) CS.kappa (KMap[Zab, Gb, h].K four) (KTB.K four)) >
        hcl KZ2 kz2 (B.K four) (B.pt four) (ptcomp KZ2 kz2 KZ4 kz4 (B.K four) (B.pt four) CS.kappa (ptcomp KZ4 kz4 (B.K four) (B.pt four) (B.K four) (B.pt four) (KMap[Zab, Gb, h].K four) (KTB.K four)))
          =< apH (\ F -> hcl KZ2 kz2 (B.K four) (B.pt four) (ptcomp KZ2 kz2 KZ4 kz4 (B.K four) (B.pt four) CS.kappa F))
               (symH (KFun[l].Comp[Zab, Gb, Gb, h, twoH Gb].k-comp four)) >
        Phi CS.kappa Gb (KFun[l].hcomp Zab Gb Gb h (twoH Gb)) } ;
    hom-eq : Id (Hom Zab Gb) (KFun[l].hcomp Zab Zab Gb Q.fourH h) (KFun[l].hcomp Zab Gb Gb h (twoH Gb)) =
      E.injective (Hom Zab Gb) (HC KZ2 kz2 (B.K four) (B.pt four)) (Phi CS.kappa Gb) (H4Proof[l].h4 Gb) _ _
        (transH (symH left)
          (transH (comp-beta KZ2 kz2 KZ2 kz2 (B.K four) (B.pt four) (KT.K two) H)
            (transH (apH (\ F -> hcl KZ2 kz2 (B.K four) (B.pt four) (ptcomp KZ2 kz2 KZ2 kz2 (B.K four) (B.pt four) F H)) (LZ.K-def (twoH Zab) two))
              (transH N-cls
                (transH (apH (\ F -> hcl KZ2 kz2 (B.K four) (B.pt four) (ptcomp KZ2 kz2 (B.K four) (B.pt four) (B.K four) (B.pt four) H F)) (symH (LB.K-def (twoH Gb) four)))
                  (transH (symH (comp-beta KZ2 kz2 (B.K four) (B.pt four) (B.K four) (B.pt four) H (KTB.K four))) right)))))) ;
    one : Zab.A = ZZ.sucZ ZZ.zeroZ ;
    -- h ((1 + 1) + (1 + 1)) = (h 1 + h 1) + (h 1 + h 1)
    h-four : Id Gb.A (h.1 (Zab.add (Zab.add one one) (Zab.add one one))) (Gb.add (Gb.add (h.1 one) (h.1 one)) (Gb.add (h.1 one) (h.1 one))) =
      transH (h.2 (Zab.add one one) (Zab.add one one))
        (transH (apH (\ u -> Gb.add u (h.1 (Zab.add one one))) (h.2 one one)) (apH (Gb.add (Gb.add (h.1 one) (h.1 one))) (h.2 one one))) ;
    -- Lemma N
    two-tors : Id Gb.A (Gb.add (h.1 one) (h.1 one)) Gb.o =
      transH (AbL[Gb].solve (Gb.add (h.1 one) (h.1 one)) (Gb.add (h.1 one) (h.1 one)) (Gb.add (h.1 one) (h.1 one))
                (transH (symH h-four) (apH (\ g -> g.1 one) hom-eq)))
        (Gb.invr (Gb.add (h.1 one) (h.1 one))) ;
  } ;
} ;

-- homomorphisms out of Z are determined at 1
module ZExt (Gb : Ab) {
  open Integers[l] ;
  hom-neg (f : Hom Zab Gb) (x : Int) : Id Gb.A (f.1 (neg x)) (Gb.inv (f.1 x)) =
    transH (AbL[Gb].solve (f.1 (neg x)) (f.1 x) Gb.o
              (transH (symH (f.2 (neg x) x)) (transH (apH f.1 (transH (comm (neg x) x) (invr x))) (hom-unit Zab Gb f))))
      (AbL[Gb].unitl (Gb.inv (f.1 x))) ;
  module At (f g : Hom Zab Gb) (e1 : Id Gb.A (f.1 (pos (suc zero))) (g.1 (pos (suc zero)))) {
    ptP : (n : Nat) -> Id Gb.A (f.1 (pos n)) (g.1 (pos n)) = split {
      zero -> transH (hom-unit Zab Gb f) (symH (hom-unit Zab Gb g)) ;
      suc n | r -> transH (f.2 (pos n) (pos (suc zero)))
                    (transH (apH (\ u -> Gb.add u (f.1 (pos (suc zero)))) r)
                      (transH (apH (Gb.add (g.1 (pos n))) e1) (symH (g.2 (pos n) (pos (suc zero)))))) } ;
    pt : (x : Int) -> Id Gb.A (f.1 x) (g.1 x) = split {
      pos n -> ptP n ;
      negsuc n -> transH (hom-neg f (pos (suc n))) (transH (apH Gb.inv (ptP (suc n))) (symH (hom-neg g (pos (suc n))))) } ;
    z-ext : Id (Hom Zab Gb) f g = KFun[l].hom-path Zab Gb f g pt ;
  } ;
} ;

-- Lemma factor
module Factor (Gb : Ab) (h : Hom Zab Gb) (t : Id Gb.A (Gb.add (h.1 (ZZ.sucZ ZZ.zeroZ)) (h.1 (ZZ.sucZ ZZ.zeroZ))) Gb.o) {
  g1 : Bool -> Gb.A = split { true -> h.1 (ZZ.sucZ ZZ.zeroZ) ; false -> Gb.o } ;
  g-hom : (x y : Bool) -> Id Gb.A (g1 (xor x y)) (Gb.add (g1 x) (g1 y)) = split {
    true -> split { true -> symH t ; false -> symH (Gb.unitr (h.1 (ZZ.sucZ ZZ.zeroZ))) } ;
    false -> split { true -> symH (AbL[Gb].unitl (h.1 (ZZ.sucZ ZZ.zeroZ))) ; false -> symH (Gb.unitr Gb.o) } } ;
  g : Hom Z2ab Gb = (g1, g-hom) ;
  factor : Id (Hom Zab Gb) (KFun[l].hcomp Zab Z2ab Gb rho g) h =
    ZExt[Gb].At[KFun[l].hcomp Zab Z2ab Gb rho g, h, refl (h.1 (ZZ.sucZ ZZ.zeroZ))].z-ext ;
} ;

-- Proposition Psi: the restricted coefficient map
module Psi (Gb : Ab) {
  module B = KK[Gb] ;
  module L2 = H4Bilinear[l].Lev[Zab, Z2ab] ;
  psi (g : Hom Z2ab Gb) : HC KZ2 kz2 (B.K four) (B.pt four) =
    hcl KZ2 kz2 (B.K four) (B.pt four) (ptcomp KZ2 kz2 (KK[Z2ab].K four) (KK[Z2ab].pt four) (B.K four) (B.pt four) CrossTerm[l].kbar (KMap[Z2ab, Gb, g].K four)) ;
  -- kbar ; K(g,4) = kappa ; K(rho ; g, 4)
  psi-map (g : Hom Z2ab Gb) :
    Id (PtMap KZ2 kz2 (B.K four) (B.pt four)) (ptcomp KZ2 kz2 (KK[Z2ab].K four) (KK[Z2ab].pt four) (B.K four) (B.pt four) CrossTerm[l].kbar (KMap[Z2ab, Gb, g].K four))
      (ptcomp KZ2 kz2 KZ4 kz4 (B.K four) (B.pt four) CS.kappa (KMap[Zab, Gb, KFun[l].hcomp Zab Z2ab Gb rho g].K four)) =
    transH (ptcomp-assoc KZ2 kz2 KZ4 kz4 (KK[Z2ab].K four) (KK[Z2ab].pt four) (B.K four) (B.pt four) CS.kappa (L2.K rho four) (KMap[Z2ab, Gb, g].K four))
      (apH (\ F -> ptcomp KZ2 kz2 KZ4 kz4 (B.K four) (B.pt four) CS.kappa F)
         (transH (apH (\ F -> ptcomp KZ4 kz4 (KK[Z2ab].K four) (KK[Z2ab].pt four) (B.K four) (B.pt four) F (KMap[Z2ab, Gb, g].K four)) (symH (L2.K-def rho four)))
           (symH (KFun[l].Comp[Zab, Z2ab, Gb, rho, g].k-comp four)))) ;
  psi-phi (g : Hom Z2ab Gb) : Id (HC KZ2 kz2 (B.K four) (B.pt four)) (psi g) (Phi CS.kappa Gb (KFun[l].hcomp Zab Z2ab Gb rho g)) =
    apH (hcl KZ2 kz2 (B.K four) (B.pt four)) (psi-map g) ;
  module Inj (g g' : Hom Z2ab Gb) (e : Id (HC KZ2 kz2 (B.K four) (B.pt four)) (psi g) (psi g')) {
    rho-eq : Id (Hom Zab Gb) (KFun[l].hcomp Zab Z2ab Gb rho g) (KFun[l].hcomp Zab Z2ab Gb rho g') =
      E.injective (Hom Zab Gb) (HC KZ2 kz2 (B.K four) (B.pt four)) (Phi CS.kappa Gb) (H4Proof[l].h4 Gb)
        (KFun[l].hcomp Zab Z2ab Gb rho g) (KFun[l].hcomp Zab Z2ab Gb rho g') (transH (symH (psi-phi g)) (transH e (psi-phi g'))) ;
    pt : (b : Bool) -> Id Gb.A (g.1 b) (g'.1 b) = split {
      true -> apH (\ k -> k.1 (ZZ.sucZ ZZ.zeroZ)) rho-eq ;
      false -> transH (hom-unit Z2ab Gb g) (symH (hom-unit Z2ab Gb g')) } ;
    psi-inj : Id (Hom Z2ab Gb) g g' = KFun[l].hom-path Z2ab Gb g g' pt ;
  } ;
} ;

-- Corollary conv: the numerical converse
module Conv (Gb : Ab) (h : Hom Zab Gb) {
  module A = KK[Zab] ;
  module B = KK[Gb] ;
  module CJ = Conj[l].Conj[Id (A.K three) (A.pt three) (A.pt three), refl (A.pt three), A.K two, A.pt two,
                           Id (B.K five) (B.pt five) (B.pt five), refl (B.pt five), B.K four, B.pt four, A.e two, B.e four] ;
  module MX = Maps[A.K three, A.pt three, B.K five, B.pt five] ;
  F : PtMap KZ2 kz2 (B.K four) (B.pt four) = ptcomp KZ2 kz2 KZ4 kz4 (B.K four) (B.pt four) CS.kappa (KMap[Zab, Gb, h].K four) ;
  module OF = MX.Over[CJ.conj F] ;
  converse (u : OF.Unloop) : Id Gb.A (Gb.add (h.1 (ZZ.sucZ ZZ.zeroZ)) (h.1 (ZZ.sucZ ZZ.zeroZ))) Gb.o =
    Nec[Gb, u.1].Two[h, apH (hcl KZ2 kz2 (B.K four) (B.pt four))
                            (symH (transH (Nec[Gb, u.1].H-eq) (transH (apH CJ.unconj (symH u.2)) (CJ.unconj-conj F))))].two-tors ;
} ;
