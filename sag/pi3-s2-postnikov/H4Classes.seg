-- (H4), part I: classes as deloopings of zero (doc/h4.pdf, Sections 2-3).
--   conn-rt-n     a retract of an (n-2)-connected type is (n-2)-connected
--                 (by induction on n; identity types of a retract are
--                 retracts, HLevels.id-r, id-rs)
--   pi-set        Lemma 1: pointing irrelevance into Map_*(X, Z) a set
--                 when Omega Z is connected
--   ClassesAt[B]  for Y = K(B,4): PMO = Map_*(Omega K2, Omega Y) is
--                 1-connected (Lemma 4: a retract of Map_*(K1, K(B,3)) ~
--                 Omega K(B,3) ~ K(B,2)); Unloop f is a set (Cor. 10,
--                 c = 1, t = 2); Proposition 5: (F, w) |-> [F] is a
--                 bijection Unloop f0 -> [K2, Y]_*.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ; open HLevels[l] ; open Connected[l] ;
open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ; open Retracts[l] ; open Torsor[l] ; open LoopCalc[l] ;
open EMMaps[l] ; open AbHom[l] ; open HomotopyClasses[l] ; open SphereUniversal[l] ; open PostnikovRealization[l] ; open KZ2Cohomology[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module CP = CircleProperty[l] ;

-- the identity types of a retract, as a retract
rt-ap (A B : U l) (R : Retract[A, B]) (a a' : A) : Retract[Id A a a', Id B (R.s a) (R.s a')] =
  new Retract[Id A a a', Id B (R.s a) (R.s a'), ap A B R.s a a', id-r A B R.s R.r R.h a a', id-rs A B R.s R.r R.h a a'] ;

-- a retract of an (n-2)-connected type is (n-2)-connected
conn-rt-n : (n : Nat) (A B : U l) (R : Retract[A, B]) -> isConn n B -> isConn n A = split {
  zero -> \ A B R c -> tt ;
  suc n | r -> \ A B R c ->
    (TC.map B A R.r c.1, \ a a' -> r (Id A a a') (Id B (R.s a) (R.s a')) (rt-ap A B R a a') (c.2 (R.s a) (R.s a'))) } ;

-- Lemma 1: if Map_*(X, Z) is a set and Omega Z is connected, the pointing
-- of a pointed map is irrelevant: z' = z . (z^-1 . z'), and z^-1 . z' is
-- merely refl
pi-set (X : U l) (x0 : X) (Z : U l) (z0 : Z) (sM : isSet (PtMap X x0 Z z0)) (cO : isConn (suc (suc zero)) (Id Z z0 z0))
  (k : X -> Z) (z z' : Id Z (k x0) z0) : Id (PtMap X x0 Z z0) (k, z) (k, z') =
  TC.rec (Id (Id Z z0 z0) (trans Z z0 (k x0) z0 (sym Z (k x0) z0 z) z') (refl z0)) @l
    (Id (PtMap X x0 Z z0) (k, z) (k, z')) (sM (k, z) (k, z'))
    (\ e -> apH (\ w -> (k, w)) (transH (symH (apH (trans Z (k x0) z0 z0 z) e)) (Fibres[l].trans-cancel' Z (k x0) z0 z0 z z')))
    (conn-path zero (Id Z z0 z0) cO (trans Z z0 (k x0) z0 (sym Z (k x0) z0 z) z') (refl z0)) ;

module ClassesAt (Gb : Ab) {
  module A = KK[Zab] ;
  module B = KK[Gb] ;
  module MX = Maps[KZ2, kz2, B.K four, B.pt four] ;
  f0 : MX.PMO = ptconst (Id KZ2 kz2 kz2) (refl kz2) (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)) ;
  -- Lemma 4: PMO is a retract of Map_*(K1, K(B,3)), which is Omega K(B,3) ~ K(B,2)
  pmo-rt : Retract[MX.PMO, PtMap (A.K (suc zero)) (A.pt (suc zero)) (B.K three) (B.pt three)] =
    H3Proof[l].rt-ptmap (Id KZ2 kz2 kz2) (refl kz2) (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four))
      (A.K (suc zero)) (A.pt (suc zero)) (A.e (suc zero)) (B.K three) (B.pt three) (B.e three) ;
  target-conn : isConn three (PtMap (A.K (suc zero)) (A.pt (suc zero)) (B.K three) (B.pt three)) =
    Deloop[l].equiv-conn three (PtMap (A.K (suc zero)) (A.pt (suc zero)) (B.K three) (B.pt three)) (Id (B.K three) (B.pt three) (B.pt three))
      (CP.Circle[B.K three].pointed-equiv (B.pt three))
      (Deloop[l].equiv-conn three (Id (B.K three) (B.pt three) (B.pt three)) (B.K two) ((B.e two).1.1, (B.e two).2) (B.conn (suc zero))) ;
  pmo-conn : isConn three MX.PMO = conn-rt-n three MX.PMO (PtMap (A.K (suc zero)) (A.pt (suc zero)) (B.K three) (B.pt three)) pmo-rt target-conn ;
  -- Corollary 10 with c = 1, t = 2: the deloopings of a map form a set
  unloop-set (phi : MX.PMO) : isSet MX.Over[phi].Unloop =
    trunc-set MX.Over[phi].Unloop MX.Over[phi].Levels[suc zero, two, A.conn (suc zero), B.trunc three].cor10 ;
  -- Proposition 5
  cls (u : MX.Over[f0].Unloop) : HC KZ2 kz2 (B.K four) (B.pt four) = hcl KZ2 kz2 (B.K four) (B.pt four) u.1 ;
  cls-surj (z : HC KZ2 kz2 (B.K four) (B.pt four)) : Tr.Trunc[Bijection[l].Fibre cls z].carrier =
    STr[PtMap KZ2 kz2 (B.K four) (B.pt four)].ind @l (\ z1 -> Tr.Trunc[Bijection[l].Fibre cls z1].carrier)
      (\ z1 -> Tr.Trunc[Bijection[l].Fibre cls z1].proposition)
      (\ F -> TC.map (Id MX.PMO f0 (MX.loop F)) (Bijection[l].Fibre cls (hcl KZ2 kz2 (B.K four) (B.pt four) F))
         (\ w -> ((F, w), refl (hcl KZ2 kz2 (B.K four) (B.pt four) F)))
         (conn-path (suc zero) MX.PMO pmo-conn f0 (MX.loop F))) z ;
  -- two deloopings of zero with equal underlying maps are equal: the path
  -- type f0 = loop F is connected
  same-map (F : PtMap KZ2 kz2 (B.K four) (B.pt four)) (w w' : Id MX.PMO f0 (MX.loop F)) : Id MX.Over[f0].Unloop (F, w) (F, w') =
    TC.rec (Id (Id MX.PMO f0 (MX.loop F)) w w') @l (Id MX.Over[f0].Unloop (F, w) (F, w')) (unloop-set f0 (F, w) (F, w'))
      (\ e -> apH (\ v -> (F, v)) e)
      (conn-path zero (Id MX.PMO f0 (MX.loop F)) (conn-id (suc (suc zero)) MX.PMO pmo-conn f0 (MX.loop F)) w w') ;
  cls-inj (u u' : MX.Over[f0].Unloop) (e : Id (HC KZ2 kz2 (B.K four) (B.pt four)) (cls u) (cls u')) : Id MX.Over[f0].Unloop u u' =
    TC.rec (Id (PtMap KZ2 kz2 (B.K four) (B.pt four)) u.1 u'.1) @l (Id MX.Over[f0].Unloop u u') (unloop-set f0 u u')
      (\ p -> transH
         (idJ (PtMap KZ2 kz2 (B.K four) (B.pt four)) u.1 (\ G1 p1 -> Id MX.Over[f0].Unloop u (G1, subst (PtMap KZ2 kz2 (B.K four) (B.pt four)) (\ G -> Id MX.PMO f0 (MX.loop G)) u.1 G1 p1 u.2))
            (refl u) u'.1 p)
         (same-map u'.1 (subst (PtMap KZ2 kz2 (B.K four) (B.pt four)) (\ G -> Id MX.PMO f0 (MX.loop G)) u.1 u'.1 p u.2) u'.2))
      (STr[PtMap KZ2 kz2 (B.K four) (B.pt four)].effective u.1 u'.1 e) ;
  cls-equiv : isEquiv MX.Over[f0].Unloop (HC KZ2 kz2 (B.K four) (B.pt four)) cls =
    Bijection[l].Bij[MX.Over[f0].Unloop, HC KZ2 kz2 (B.K four) (B.pt four), hc-set KZ2 kz2 (B.K four) (B.pt four), cls, cls-inj, cls-surj].equiv ;
} ;
