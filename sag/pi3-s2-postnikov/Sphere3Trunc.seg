-- The 4-truncation of S^3 (doc/br-universal.pdf, Lemma s3conn and Proposition
-- trunc4), under the S^3 axiom only (segment parameters S3, base, surf, ump3 of
-- Sphere3Axiom.Sphere3); and pi_4 on pointed maps and on classes.  The text of
-- SphereTruncation (doc/finite-truncation.pdf, §5) with one more looping.
--
-- Informal proof.
--   pi4         pi_4 (X, x0) = pi_3 (Omega X, refl) by definition, pi4-map F =
--               pi3-map (loop F) = pi_1 (loop^2 (loop F))
--   loopC       looping on classes: [F] |-> [loop F] (the target HC is a set);
--               loopC-comp, loopC-id (LoopCalc.loop-comp, HomotopyGroups.loop-ptid)
--   pi4C        pi_4 of a class a is pi3C (loopC a); pi4C-beta-at, pi4C-comp,
--               pi4C-id from those of loopC and pi3C.  No representative is chosen
--   Trunc4      the level-4 interface (Interfaces.Trunc3 one level up): a pointed
--               eta : S3 -> T into a 2-connected 4-type, eta^* an equivalence on
--               pointed maps into 4-types, pi4 eta bijective
--   o3-contr    Omega^3 of a 2-type is contractible
--   (a) ev-base-equiv   into a 2-type Y, evaluation at base is an equivalence: ev3
--               followed by the first projection, whose fibres Omega^3 (Y, y) are
--               contractible
--   (b) V-contr V = ||S3||_2 is contractible: id and const |base| agree after |-|^*,
--               since |-| and const |base| agree at base
--   (c) s3-conn Lemma s3conn: S3 is 2-connected, as the fibre of |-| over |base|
--   trunc4      Proposition trunc4: T = ||S3||_4 with eta = (|-|, refl); T is
--               2-connected by conn-up (fibres of the unit and s3-conn); the fibres
--               of loop^k eta are isConn (6-k) (loop-conn, k = 1..4); ConnPi1 for
--               loop^2 (loop eta) takes the fibres of its looping (isConn 2) and
--               makes pi_1 (loop^2 (loop eta)) = pi4 eta bijective
-- (b), (c) are proved for any truncation structure at level 4 (Simply) and the
-- proposition for any one at level 6 (Truncate), given (c); trunc4 instantiates them
-- at TO three and TO five.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ; open HLevels[l] ; open Connected[l] ;
open Lemma4[l] ; open DeloopMaps[l] ; open LoopCalc[l] ;
open ConnectedMaps[l] ; open Truncations[l] ; open HomotopyClasses[l] ; open SphereAxiom[l] ; open Sphere3Axiom[l] ;
open Group[l] ; open SphereUniversal[l] ; open PostnikovRealization[l] ;
module W = Whitehead[l] ; module E = Equivalences[l] ; module QG = QGrp[l] ;
module TP = TruncationProps[l] ; module HG = HomotopyGroups[l] ; module ST = SphereTruncation[l] ;

------------------------------------------------------------------------
-- pi4 on pointed maps

pi4 (X : U l) (x0 : X) : Grp = HG.pi3 (Id X x0 x0) (refl x0) ;

pi4-map (X : U l) (x0 : X) (Y : U l) (y0 : Y) (F : PtMap X x0 Y y0) : QG.GHom (pi4 X x0) (pi4 Y y0) =
  HG.pi3-map (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0) (Maps[X, x0, Y, y0].loop F) ;

------------------------------------------------------------------------
-- looping on classes

module LoopC (X : U l) (x0 : X) (Y : U l) (y0 : Y) {
  module L = STr[PtMap X x0 Y y0].Lift[HC (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0), hc-set (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0),
    \ F -> hcl (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0) (Maps[X, x0, Y, y0].loop F)] ;
  map (a : HC X x0 Y y0) : HC (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0) = L.map a ;
  beta (F : PtMap X x0 Y y0) :
    Id (HC (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0)) (map (hcl X x0 Y y0 F)) (hcl (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0) (Maps[X, x0, Y, y0].loop F)) =
    L.beta F ;
} ;

loopC (X : U l) (x0 : X) (Y : U l) (y0 : Y) (a : HC X x0 Y y0) : HC (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0) = LoopC[X, x0, Y, y0].map a ;
loopC-beta (X : U l) (x0 : X) (Y : U l) (y0 : Y) (F : PtMap X x0 Y y0) :
  Id (HC (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0)) (loopC X x0 Y y0 (hcl X x0 Y y0 F)) (hcl (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0) (Maps[X, x0, Y, y0].loop F)) =
  LoopC[X, x0, Y, y0].beta F ;
-- locked after its characterising lemma loopC-beta
opaque loopC ;

loopC-comp (X : U l) (x0 : X) (Y : U l) (y0 : Y) (Z : U l) (z0 : Z) (a : HC X x0 Y y0) (b : HC Y y0 Z z0) :
  Id (HC (Id X x0 x0) (refl x0) (Id Z z0 z0) (refl z0)) (loopC X x0 Z z0 (compC X x0 Y y0 Z z0 a b))
    (compC (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0) (Id Z z0 z0) (refl z0) (loopC X x0 Y y0 a) (loopC Y y0 Z z0 b)) =
  STr[PtMap X x0 Y y0].ind @l
    (\ a1 -> Id (HC (Id X x0 x0) (refl x0) (Id Z z0 z0) (refl z0)) (loopC X x0 Z z0 (compC X x0 Y y0 Z z0 a1 b))
               (compC (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0) (Id Z z0 z0) (refl z0) (loopC X x0 Y y0 a1) (loopC Y y0 Z z0 b)))
    (\ a1 -> hc-set (Id X x0 x0) (refl x0) (Id Z z0 z0) (refl z0) _ _) (\ F ->
  STr[PtMap Y y0 Z z0].ind @l
    (\ b1 -> Id (HC (Id X x0 x0) (refl x0) (Id Z z0 z0) (refl z0)) (loopC X x0 Z z0 (compC X x0 Y y0 Z z0 (hcl X x0 Y y0 F) b1))
               (compC (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0) (Id Z z0 z0) (refl z0) (loopC X x0 Y y0 (hcl X x0 Y y0 F)) (loopC Y y0 Z z0 b1)))
    (\ b1 -> hc-set (Id X x0 x0) (refl x0) (Id Z z0 z0) (refl z0) _ _) (\ G -> calc (HC (Id X x0 x0) (refl x0) (Id Z z0 z0) (refl z0)) {
      loopC X x0 Z z0 (compC X x0 Y y0 Z z0 (hcl X x0 Y y0 F) (hcl Y y0 Z z0 G))
        =< apH (loopC X x0 Z z0) (comp-beta X x0 Y y0 Z z0 F G) >
      loopC X x0 Z z0 (hcl X x0 Z z0 (ptcomp X x0 Y y0 Z z0 F G))
        =< loopC-beta X x0 Z z0 (ptcomp X x0 Y y0 Z z0 F G) >
      hcl (Id X x0 x0) (refl x0) (Id Z z0 z0) (refl z0) (Maps[X, x0, Z, z0].loop (ptcomp X x0 Y y0 Z z0 F G))
        =< apH (hcl (Id X x0 x0) (refl x0) (Id Z z0 z0) (refl z0)) (loop-comp X x0 Y y0 Z z0 F G) >
      hcl (Id X x0 x0) (refl x0) (Id Z z0 z0) (refl z0)
        (ptcomp (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0) (Id Z z0 z0) (refl z0) (Maps[X, x0, Y, y0].loop F) (Maps[Y, y0, Z, z0].loop G))
        =< symH (comp-beta (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0) (Id Z z0 z0) (refl z0) (Maps[X, x0, Y, y0].loop F) (Maps[Y, y0, Z, z0].loop G)) >
      compC (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0) (Id Z z0 z0) (refl z0)
        (hcl (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0) (Maps[X, x0, Y, y0].loop F)) (hcl (Id Y y0 y0) (refl y0) (Id Z z0 z0) (refl z0) (Maps[Y, y0, Z, z0].loop G))
        =< symH (transH (apH (\ c -> compC (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0) (Id Z z0 z0) (refl z0) c (loopC Y y0 Z z0 (hcl Y y0 Z z0 G))) (loopC-beta X x0 Y y0 F))
                        (apH (compC (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0) (Id Z z0 z0) (refl z0) (hcl (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0) (Maps[X, x0, Y, y0].loop F))) (loopC-beta Y y0 Z z0 G))) >
      compC (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0) (Id Z z0 z0) (refl z0) (loopC X x0 Y y0 (hcl X x0 Y y0 F)) (loopC Y y0 Z z0 (hcl Y y0 Z z0 G)) }) b) a ;

loopC-id (X : U l) (x0 : X) : Id (HC (Id X x0 x0) (refl x0) (Id X x0 x0) (refl x0)) (loopC X x0 X x0 (idC X x0)) (idC (Id X x0 x0) (refl x0)) =
  transH (loopC-beta X x0 X x0 (ptid X x0)) (apH (hcl (Id X x0 x0) (refl x0) (Id X x0 x0) (refl x0)) (HG.loop-ptid X x0)) ;

------------------------------------------------------------------------
-- pi4 on classes

pi4C (X : U l) (x0 : X) (Y : U l) (y0 : Y) (a : HC X x0 Y y0) : QG.GHom (pi4 X x0) (pi4 Y y0) =
  HG.pi3C (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0) (loopC X x0 Y y0 a) ;
pi4C-def (X : U l) (x0 : X) (Y : U l) (y0 : Y) (a : HC X x0 Y y0) :
  Id (QG.GHom (pi4 X x0) (pi4 Y y0)) (pi4C X x0 Y y0 a) (HG.pi3C (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0) (loopC X x0 Y y0 a)) =
  refl (pi4C X x0 Y y0 a) ;
-- locked after its definition pi4C-def
opaque pi4C ;

pi4C-beta-at (X : U l) (x0 : X) (Y : U l) (y0 : Y) (F : PtMap X x0 Y y0) (x : (pi4 X x0).G) :
  Id (pi4 Y y0).G ((pi4C X x0 Y y0 (hcl X x0 Y y0 F)).1 x) ((pi4-map X x0 Y y0 F).1 x) =
  calc (pi4 Y y0).G {
    (pi4C X x0 Y y0 (hcl X x0 Y y0 F)).1 x
      =< apH (\ h -> h.1 x) (pi4C-def X x0 Y y0 (hcl X x0 Y y0 F)) >
    (HG.pi3C (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0) (loopC X x0 Y y0 (hcl X x0 Y y0 F))).1 x
      =< apH (\ c -> (HG.pi3C (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0) c).1 x) (loopC-beta X x0 Y y0 F) >
    (HG.pi3C (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0) (hcl (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0) (Maps[X, x0, Y, y0].loop F))).1 x
      =< HG.pi3C-beta-at (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0) (Maps[X, x0, Y, y0].loop F) x >
    (pi4-map X x0 Y y0 F).1 x } ;

pi4C-comp (X : U l) (x0 : X) (Y : U l) (y0 : Y) (Z : U l) (z0 : Z) (a : HC X x0 Y y0) (b : HC Y y0 Z z0) (x : (pi4 X x0).G) :
  Id (pi4 Z z0).G ((pi4C X x0 Z z0 (compC X x0 Y y0 Z z0 a b)).1 x) ((pi4C Y y0 Z z0 b).1 ((pi4C X x0 Y y0 a).1 x)) =
  calc (pi4 Z z0).G {
    (pi4C X x0 Z z0 (compC X x0 Y y0 Z z0 a b)).1 x
      =< apH (\ h -> h.1 x) (pi4C-def X x0 Z z0 (compC X x0 Y y0 Z z0 a b)) >
    (HG.pi3C (Id X x0 x0) (refl x0) (Id Z z0 z0) (refl z0) (loopC X x0 Z z0 (compC X x0 Y y0 Z z0 a b))).1 x
      =< apH (\ c -> (HG.pi3C (Id X x0 x0) (refl x0) (Id Z z0 z0) (refl z0) c).1 x) (loopC-comp X x0 Y y0 Z z0 a b) >
    (HG.pi3C (Id X x0 x0) (refl x0) (Id Z z0 z0) (refl z0)
       (compC (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0) (Id Z z0 z0) (refl z0) (loopC X x0 Y y0 a) (loopC Y y0 Z z0 b))).1 x
      =< HG.pi3C-comp (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0) (Id Z z0 z0) (refl z0) (loopC X x0 Y y0 a) (loopC Y y0 Z z0 b) x >
    (HG.pi3C (Id Y y0 y0) (refl y0) (Id Z z0 z0) (refl z0) (loopC Y y0 Z z0 b)).1 ((HG.pi3C (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0) (loopC X x0 Y y0 a)).1 x)
      =< apH (\ h -> (HG.pi3C (Id Y y0 y0) (refl y0) (Id Z z0 z0) (refl z0) (loopC Y y0 Z z0 b)).1 (h.1 x)) (symH (pi4C-def X x0 Y y0 a)) >
    (HG.pi3C (Id Y y0 y0) (refl y0) (Id Z z0 z0) (refl z0) (loopC Y y0 Z z0 b)).1 ((pi4C X x0 Y y0 a).1 x)
      =< apH (\ h -> h.1 ((pi4C X x0 Y y0 a).1 x)) (symH (pi4C-def Y y0 Z z0 b)) >
    (pi4C Y y0 Z z0 b).1 ((pi4C X x0 Y y0 a).1 x) } ;

pi4C-id (X : U l) (x0 : X) (x : (pi4 X x0).G) : Id (pi4 X x0).G ((pi4C X x0 X x0 (idC X x0)).1 x) x =
  calc (pi4 X x0).G {
    (pi4C X x0 X x0 (idC X x0)).1 x
      =< apH (\ h -> h.1 x) (pi4C-def X x0 X x0 (idC X x0)) >
    (HG.pi3C (Id X x0 x0) (refl x0) (Id X x0 x0) (refl x0) (loopC X x0 X x0 (idC X x0))).1 x
      =< apH (\ c -> (HG.pi3C (Id X x0 x0) (refl x0) (Id X x0 x0) (refl x0) c).1 x) (loopC-id X x0) >
    (HG.pi3C (Id X x0 x0) (refl x0) (Id X x0 x0) (refl x0) (idC (Id X x0 x0) (refl x0))).1 x
      =< HG.pi3C-id (Id X x0 x0) (refl x0) x >
    x } ;

------------------------------------------------------------------------
-- the level-4 interface

module Interfaces4 (S3 : U l) (base : S3) {
  record Trunc4 {
    T : U l ;
    t0 : T ;
    eta : PtMap S3 base T t0 ;
    truncT : isTrunc (suc five) T ;
    connT : isConn four T ;
    up (Y : U l) (y0 : Y) (tY : isTrunc (suc five) Y) :
      isEquiv (PtMap T t0 Y y0) (PtMap S3 base Y y0) (\ G -> ptcomp S3 base T t0 Y y0 eta G) ;
    pi4-eta : isEquiv (pi4 S3 base).G (pi4 T t0).G (pi4-map S3 base T t0 eta).1 ;
  } ;
} ;

------------------------------------------------------------------------

-- the 3-loops of a 2-type are contractible
o3-contr (Y : U l) (tY : isTrunc four Y) (y : Y) : isContr (O3 Y y) =
  (refl (refl (refl y)), \ a -> trunc-one-prop (O3 Y y) (tY y y (refl y) (refl y) (refl (refl y)) (refl (refl y))) (refl (refl (refl y))) a) ;

module Sphere3Trunc (S3 : U l) (base : S3) (surf : O3 S3 base)
  (ump3 : (X : U l) -> isEquiv (S3 -> X) ((x : X) * O3 X x) (ev3 S3 base surf X)) {

  -- (a)
  ev-base-equiv (Y : U l) (tY : isTrunc four Y) : isEquiv (S3 -> Y) Y (\ g -> g base) =
    (E.compose (S3 -> Y) ((y : Y) * O3 Y y) Y (ev3 S3 base surf Y, ump3 Y) (\ w -> w.1, ST.fst-equiv Y (\ y -> O3 Y y) (o3-contr Y tY))).2 ;

  -- (b), (c)
  module Simply (T4 : TruncOp[four]) {
    module EV = Elim[four, S3, T4.T S3, T4.unit S3, T4.conn S3, \ z -> T4.T S3, \ z -> T4.trunc S3] ;
    -- |-| and const |base| agree, since they agree at base
    unit-const : Id (S3 -> T4.T S3) (T4.unit S3) (\ s -> T4.unit S3 base) =
      E.injective (S3 -> T4.T S3) (T4.T S3) (\ g -> g base) (ev-base-equiv (T4.T S3) (T4.trunc S3))
        (T4.unit S3) (\ s -> T4.unit S3 base) (refl (T4.unit S3 base)) ;
    -- hence id and const |base| agree after |-|^*
    id-const : Id (T4.T S3 -> T4.T S3) (\ z -> z) (\ z -> T4.unit S3 base) =
      EV.unique (\ z -> z) (\ z -> T4.unit S3 base) (happly S3 (\ s -> T4.T S3) (T4.unit S3) (\ s -> T4.unit S3 base) unit-const) ;
    V-contr : isContr (T4.T S3) =
      (T4.unit S3 base, \ z -> sym (T4.T S3) z (T4.unit S3 base) (happly (T4.T S3) (\ z1 -> T4.T S3) (\ z1 -> z1) (\ z1 -> T4.unit S3 base) id-const z)) ;
    -- (c) Lemma s3conn: S3 is the fibre of |-| over |base|
    to-fib (s : S3) : W.fib S3 (T4.T S3) (T4.unit S3) (T4.unit S3 base) = (s, contr-prop (T4.T S3) V-contr (T4.unit S3 s) (T4.unit S3 base)) ;
    fib-equiv : Equiv S3 (W.fib S3 (T4.T S3) (T4.unit S3) (T4.unit S3 base)) =
      (to-fib, qinv S3 (W.fib S3 (T4.T S3) (T4.unit S3) (T4.unit S3 base)) to-fib (\ w -> w.1)
         (\ w -> Sigma-eq S3 (\ s -> Id (T4.T S3) (T4.unit S3 s) (T4.unit S3 base)) w.1 w.1 (to-fib w.1).2 w.2 (refl w.1)
                   (contr-prop (Id (T4.T S3) (T4.unit S3 w.1) (T4.unit S3 base)) (contr-paths (T4.T S3) V-contr (T4.unit S3 w.1) (T4.unit S3 base))))
         (\ s -> refl s)) ;
    s3-conn : isConn four S3 = Deloop[l].equiv-conn four S3 (W.fib S3 (T4.T S3) (T4.unit S3) (T4.unit S3 base)) fib-equiv (T4.conn S3 (T4.unit S3 base)) ;
  } ;

  -- Proposition trunc4
  module Truncate (T6 : TruncOp[suc five]) (s3-conn : isConn four S3) {
    module UP = TP.PtUP[suc five, T6, S3, base] ;
    connT : isConn four (T6.T S3) =
      conn-up four S3 (T6.T S3) (T6.unit S3)
        (\ z -> conn-down four (W.fib S3 (T6.T S3) (T6.unit S3) z) (conn-down five (W.fib S3 (T6.T S3) (T6.unit S3) z) (T6.conn S3 z))) s3-conn ;
    -- the loopings of eta: fibres isConn 5, 4, 3, 2 (pi4 eta = pi_1 (loop^2 (loop eta)))
    c5 (v : Id (T6.T S3) (T6.unit S3 base) (T6.unit S3 base)) :
      isConn five (W.fib (Id S3 base base) (Id (T6.T S3) (T6.unit S3 base) (T6.unit S3 base)) (Maps[S3, base, T6.T S3, T6.unit S3 base].loop UP.eta).1 v) =
      TP.loop-conn five S3 base (T6.T S3) (T6.unit S3) (T6.conn S3) (T6.unit S3 base) (refl (T6.unit S3 base)) v ;
    c4 (v : Id (Id (T6.T S3) (T6.unit S3 base) (T6.unit S3 base)) (refl (T6.unit S3 base)) (refl (T6.unit S3 base))) :
      isConn four (W.fib (Id (Id S3 base base) (refl base) (refl base)) (Id (Id (T6.T S3) (T6.unit S3 base) (T6.unit S3 base)) (refl (T6.unit S3 base)) (refl (T6.unit S3 base))) (Maps[Id S3 base base, refl base, Id (T6.T S3) (T6.unit S3 base) (T6.unit S3 base), refl (T6.unit S3 base)].loop (Maps[S3, base, T6.T S3, T6.unit S3 base].loop UP.eta)).1 v) =
      TP.loop-conn four (Id S3 base base) (refl base) (Id (T6.T S3) (T6.unit S3 base) (T6.unit S3 base)) (Maps[S3, base, T6.T S3, T6.unit S3 base].loop UP.eta).1 c5 (refl (T6.unit S3 base)) (Maps[S3, base, T6.T S3, T6.unit S3 base].loop UP.eta).2 v ;
    c3 (v : O2 (Id (T6.T S3) (T6.unit S3 base) (T6.unit S3 base)) (refl (T6.unit S3 base))) :
      isConn three (W.fib (O2 (Id S3 base base) (refl base)) (O2 (Id (T6.T S3) (T6.unit S3 base) (T6.unit S3 base)) (refl (T6.unit S3 base))) (loop2 (Id S3 base base) (refl base) (Id (T6.T S3) (T6.unit S3 base) (T6.unit S3 base)) (refl (T6.unit S3 base)) (Maps[S3, base, T6.T S3, T6.unit S3 base].loop UP.eta)).1 v) =
      TP.loop-conn three (Id (Id S3 base base) (refl base) (refl base)) (refl (refl base)) (Id (Id (T6.T S3) (T6.unit S3 base) (T6.unit S3 base)) (refl (T6.unit S3 base)) (refl (T6.unit S3 base))) (Maps[Id S3 base base, refl base, Id (T6.T S3) (T6.unit S3 base) (T6.unit S3 base), refl (T6.unit S3 base)].loop (Maps[S3, base, T6.T S3, T6.unit S3 base].loop UP.eta)).1 c4
        (refl (refl (T6.unit S3 base))) (Maps[Id S3 base base, refl base, Id (T6.T S3) (T6.unit S3 base) (T6.unit S3 base), refl (T6.unit S3 base)].loop (Maps[S3, base, T6.T S3, T6.unit S3 base].loop UP.eta)).2 v ;
    c2 (v : Id (O2 (Id (T6.T S3) (T6.unit S3 base) (T6.unit S3 base)) (refl (T6.unit S3 base))) (refl (refl (refl (T6.unit S3 base)))) (refl (refl (refl (T6.unit S3 base))))) :
