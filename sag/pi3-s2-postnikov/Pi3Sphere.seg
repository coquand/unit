-- Milestone E, CONDITIONAL form: pi3 S2 = Z as groups.
--
-- The segment takes the sphere axiom (SphereAxiom: S2, base, surf, ump)
-- and, as EXPLICIT parameters which are open obligations (not Theory
-- assumptions):
--   kappa : K(Z,2) ->pt K(Z,4)            (milestone D: to be constructed)
--   TR    : a 3-truncation of S2          (SphereUniversal.Interfaces.Trunc3);
--           CONSTRUCTED in SphereTruncation, used by pi3-S2-T
--   MT    : the mapping theorem for P = Fib kappa: a class s : [S2, P]_*
--           with s^* : [P, X]_* = [S2, X]_* for every simply connected
--           3-type X                       (milestones C, D)
-- Checked: Assemble (milestone B) and the realization Triple (milestone C,
-- objects) give
--   pi3-S2 : GIso[pi3 S2 base, ab-grp Integers.intAb].
-- The universal property ump of S2 is not used by this conditional
-- composition; it is what the open obligations need (s comes from a
-- generator of pi_2 P through SphereAxiom.pointed-equiv, and Trunc3.up is
-- the universal property of the truncation composed with it).
level l ;
open Base ; open Prelude[l] ; open HLevels[l] ; open Connected[l] ; open Paths[l] ; open Lemma4[l] ; open LoopCalc[l] ;
open Group[l] ; open Torsor[l] ; open SphereAxiom[l] ; open HomotopyClasses[l] ; open HomotopyGroups[l] ;
open SphereUniversal[l] ; open PostnikovRealization[l] ; open KZ2Cohomology[l] ; open SphereTruncation[l] ;

module Conditional (S2 : U l) (base : S2) (surf : O2 S2 base)
  (ump : (X : U l) -> isEquiv (S2 -> X) ((x : X) * O2 X x) (ev2 S2 base surf X))
  (kappa : PtMap KZ2 kz2 KZ4 kz4) {
  module R = Triple[Zab, Zab, kappa] ;

  record MapThm {
    s : HC S2 base R.F R.f0 ;
    rep (X : U l) (x0 : X) (tX : isTrunc five X) (cX : isConn three X) :
      isEquiv (HC R.F R.f0 X x0) (HC S2 base X x0) (\ b -> compC S2 base R.F R.f0 X x0 s b) ;
  } ;

  module Final (TR : Interfaces[S2, base].Trunc3) (MT : MapThm) {
    RP : Interfaces[S2, base].Rep = new Interfaces[S2, base].Rep[R.F, R.f0, R.trunc5, R.conn3, MT.s, MT.rep] ;
    module AS = Assemble[S2, base, TR, RP] ;
    pi3-S2 : GIso[pi3 S2 base, ab-grp Zab] =
      gi-comp (pi3 S2 base) (pi3 R.F R.f0) (ab-grp Zab) AS.iso-S2-P R.pi3-iso ;
  } ;

  -- with the constructed 3-truncation (SphereTruncation): only kappa and
  -- the mapping theorem remain as parameters
  pi3-S2-T (MT : MapThm) : GIso[pi3 S2 base, ab-grp Zab] = Final[SphereTrunc[S2, base, surf, ump].trunc3, MT].pi3-S2 ;
} ;
