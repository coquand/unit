-- Maps of Postnikov triples (doc/postnikov-morphisms.pdf, Sections 1-2).
-- Informal proof (the note, written first).  For t = (A, B, k), t' = (A', B', k'):
--   Mor t t' = (a : Hom A A') * (b : Hom B B') * (K(a,2) ; k' = k ; K(b,4))
--   realise-map (a, b, H) = FibMap.fm at the square (k, k', K(a,2), K(b,4), H).
-- Generic lemmas, at any pointed V, Y, Y' with the bounds of the text:
--   PtPath.equiv   Lemma ptpath: (c = g) ~ (h : c ~ g) * (c0 = h x0 . g0), by
--                  (happly o ap, FibMap.pt-coh) (fundamental theorem; the total
--                  space is the singleton of c.1, then of c.2)
--   rmul-equiv     right multiplication by a path is an equivalence
--   Transl         Lemma transl: z |-> (q |-> z . G q) is an equivalence
--                  Z ~ (F : P -> Q) * Tl F, and Tl F is a proposition (tau is the
--                  constant embedding FibreH3.const-emb followed by an equivalence)
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ; open HLevels[l] ; open Connected[l] ; open Lemma4[l] ;
open DeloopMaps[l] ; open LoopCalc[l] ; open SphereUniversal[l] ; open PostnikovRealization[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module E = Equivalences[l] ; module W = Whitehead[l] ; module Fb = Fibres[l] ; module CM = ConnectedMaps[l] ;
module FH = FibreH3[l] ; module Gp = Groupoid[l] ; module Tr = Truncation[l] ; module CB = ClassBase[l] ; module FM = FibMap[l] ;

------------------------------------------------------------------------
-- Lemma ptpath: paths of pointed maps

-- a homotopy and its coherence at the point
PtR (X : U l) (x0 : X) (Y : U l) (y0 : Y) (c g : PtMap X x0 Y y0) : U l =
  (h : (x : X) -> Id Y (c.1 x) (g.1 x)) * Id (Id Y (c.1 x0) y0) c.2 (trans Y (c.1 x0) (g.1 x0) y0 (h x0) g.2) ;

ptpath (X : U l) (x0 : X) (Y : U l) (y0 : Y) (c g : PtMap X x0 Y y0) (s : Id (PtMap X x0 Y y0) c g) : PtR X x0 Y y0 c g =
  (happly X (\ x -> Y) c.1 g.1 (ap (PtMap X x0 Y y0) (X -> Y) (\ R -> R.1) c g s), FM.pt-coh X x0 Y y0 c g s) ;

-- (e . t) . t^-1 = e
rcancel (A : U l) (w x : A) (e : Id A w x) : (y : A) (t : Id A x y) -> Id (Id A w x) (trans A w y x (trans A w x y e t) (sym A x y t)) e =
  \ y t -> idJ A x (\ y1 t1 -> Id (Id A w x) (trans A w y1 x (trans A w x y1 e t1) (sym A x y1 t1)) e) (refl e) y t ;

module PtPath (X : U l) (x0 : X) (Y : U l) (y0 : Y) (c : PtMap X x0 Y y0) {
  R (g : PtMap X x0 Y y0) : U l = PtR X x0 Y y0 c g ;
  r0 : R c = ptpath X x0 Y y0 c c (refl c) ;
  -- the homotopies out of c.1 form a singleton
  Hs : U l = (g1 : X -> Y) * ((x : X) -> Id Y (c.1 x) (g1 x)) ;
  hs-contr0 : isContr Hs =
    retract-contr Hs ((g1 : X -> Y) * Id (X -> Y) c.1 g1)
      (\ u -> (u.1, FL.funext X (\ x -> Y) c.1 u.1 u.2))
      (\ v -> (v.1, happly X (\ x -> Y) c.1 v.1 v.2))
      (\ u -> ap ((x : X) -> Id Y (c.1 x) (u.1 x)) Hs (\ h -> (u.1, h)) (happly X (\ x -> Y) c.1 u.1 (FL.funext X (\ x -> Y) c.1 u.1 u.2)) u.2
                (FL.happly-funext X (\ x -> Y) c.1 u.1 u.2))
      (singL (X -> Y) c.1) ;
  -- with the centre (c.1, refl)
  hs-contr : isContr Hs = CupSquare[l].contr-at Hs hs-contr0 (c.1, \ x -> refl (c.1 x)) ;
  -- the pointings over a homotopy
  Fw (u : Hs) : U l = (g0 : Id Y (u.1 x0) y0) * Id (Id Y (c.1 x0) y0) c.2 (trans Y (c.1 x0) (u.1 x0) y0 (u.2 x0) g0) ;
  fw-contr : isContr (Fw (c.1, \ x -> refl (c.1 x))) =
    retract-contr (Fw (c.1, \ x -> refl (c.1 x))) ((g0 : Id Y (c.1 x0) y0) * Id (Id Y (c.1 x0) y0) c.2 g0)
      (\ w -> (w.1, transH w.2 (trans-refl-l Y (c.1 x0) y0 w.1)))
      (\ v -> (v.1, transH v.2 (symH (trans-refl-l Y (c.1 x0) y0 v.1))))
      (\ w -> ap (Id (Id Y (c.1 x0) y0) c.2 (trans Y (c.1 x0) (c.1 x0) y0 (refl (c.1 x0)) w.1)) (Fw (c.1, \ x -> refl (c.1 x))) (\ e -> (w.1, e))
                (transH (transH w.2 (trans-refl-l Y (c.1 x0) y0 w.1)) (symH (trans-refl-l Y (c.1 x0) y0 w.1))) w.2
                (rcancel (Id Y (c.1 x0) y0) c.2 (trans Y (c.1 x0) (c.1 x0) y0 (refl (c.1 x0)) w.1) w.2 w.1 (trans-refl-l Y (c.1 x0) y0 w.1)))
      (singL (Id Y (c.1 x0) y0) c.2) ;
  tot-contr : isContr ((g : PtMap X x0 Y y0) * R g) =
    retract-contr ((g : PtMap X x0 Y y0) * R g) ((u : Hs) * Fw u)
      (\ w -> ((w.1.1, w.2.1), (w.1.2, w.2.2))) (\ v -> ((v.1.1, v.2.1), (v.1.2, v.2.2))) (\ w -> refl w)
      (trunc-Sigma-contr zero Hs Fw hs-contr fw-contr) ;
  module F = FundThm[l].FT[PtMap X x0 Y y0, c, R, r0, tot-contr] ;
  -- the map of the fundamental theorem is (happly o ap, pt-coh)
  tr-ptpath (g : PtMap X x0 Y y0) (s : Id (PtMap X x0 Y y0) c g) : Id (R g) (ptpath X x0 Y y0 c g s) (F.tr g s) =
    idJ (PtMap X x0 Y y0) c (\ g1 s1 -> Id (R g1) (ptpath X x0 Y y0 c g1 s1) (F.tr g1 s1)) (refl r0) g s ;
  equiv (g : PtMap X x0 Y y0) : isEquiv (Id (PtMap X x0 Y y0) c g) (R g) (ptpath X x0 Y y0 c g) =
    E.homotopy (Id (PtMap X x0 Y y0) c g) (R g) (F.tr g, F.equiv g) (ptpath X x0 Y y0 c g) (tr-ptpath g) ;
} ;

------------------------------------------------------------------------
-- Lemma transl: translates of a fixed family of paths

-- right multiplication by a path
rmul-equiv (Y : U l) (a b : Y) : (d : Y) (r : Id Y b d) -> isEquiv (Id Y a b) (Id Y a d) (\ u -> trans Y a b d u r) =
  \ d r -> qinv (Id Y a b) (Id Y a d) (\ u -> trans Y a b d u r) (\ v -> trans Y a d b v (sym Y b d r))
    (\ v -> idJ Y b (\ d1 r1 -> (v1 : Id Y a d1) -> Id (Id Y a d1) (trans Y a b d1 (trans Y a d1 b v1 (sym Y b d1 r1)) r1) v1) (\ v1 -> refl v1) d r v)
    (\ u -> rcancel Y a b u d r) ;

module Transl (Y : U l) (a b d : Y) (P : U l) (G : P -> Id Y b d) {
  tau (z : Id Y a b) (q : P) : Id Y a d = trans Y a b d z (G q) ;
  -- F is the translate of G by a constant
  Tl (F : P -> Id Y a d) : U l = (z : Id Y a b) * Id (P -> Id Y a d) (tau z) F ;
  TT : U l = (F : P -> Id Y a d) * Tl F ;
  to (z : Id Y a b) : TT = (tau z, (z, refl (tau z))) ;
  equiv : isEquiv (Id Y a b) TT to =
    qinv (Id Y a b) TT to (\ w -> w.2.1)
      (\ w -> idJ (P -> Id Y a d) (tau w.2.1) (\ F1 E1 -> Id TT (to w.2.1) (F1, (w.2.1, E1))) (refl (to w.2.1)) w.1 w.2.2)
      (\ z -> refl z) ;
  -- postcomposition with the right multiplications
  post (h : P -> Id Y a b) (q : P) : Id Y a d = trans Y a b d (h q) (G q) ;
  post-equiv : isEquiv (P -> Id Y a b) (P -> Id Y a d) post =
    CM.pi-equiv P (\ q -> Id Y a b) (\ q -> Id Y a d) (\ q u -> trans Y a b d u (G q)) (\ q -> rmul-equiv Y a b d (G q)) ;
  tau-emb (cP : isConn four P) (tY : isTrunc (suc five) Y) (z z' : Id Y a b) :
    isEquiv (Id (Id Y a b) z z') (Id (P -> Id Y a d) (tau z) (tau z')) (ap (Id Y a b) (P -> Id Y a d) tau z z') =
    E.homotopy (Id (Id Y a b) z z') (Id (P -> Id Y a d) (tau z) (tau z'))
      (E.compose (Id (Id Y a b) z z') (Id (P -> Id Y a b) (\ q -> z) (\ q -> z')) (Id (P -> Id Y a d) (tau z) (tau z'))
         (ap (Id Y a b) (P -> Id Y a b) (\ y q -> y) z z', FH.const-emb P (Id Y a b) cP (tY a b) z z')
         (ap (P -> Id Y a b) (P -> Id Y a d) post (\ q -> z) (\ q -> z'), CB.ap-equiv (P -> Id Y a b) (P -> Id Y a d) (post, post-equiv) (\ q -> z) (\ q -> z')))
      (ap (Id Y a b) (P -> Id Y a d) tau z z')
      (\ p -> symH (ap-ap (Id Y a b) (P -> Id Y a b) (P -> Id Y a d) (\ y q -> y) post z z' p)) ;
  prop (cP : isConn four P) (tY : isTrunc (suc five) Y) (F : P -> Id Y a d) : isProp (Tl F) =
    Gp.emb-fib-prop (Id Y a b) (P -> Id Y a d) tau (tau-emb cP tY) F ;
} ;

------------------------------------------------------------------------
-- groupoid identities for Lemma at-point

-- (z . A)^-1 . (z . B) = A^-1 . B
grp1 (X : U l) (m d : X) (A B : Id X m d) : (a : X) (z : Id X a m) ->
  Id (Id X d d) (trans X d a d (sym X a d (trans X a m d z A)) (trans X a m d z B)) (trans X d m d (sym X m d A) B) =
  \ a z -> idJR X m (\ a1 z1 -> Id (Id X d d) (trans X d a1 d (sym X a1 d (trans X a1 m d z1 A)) (trans X a1 m d z1 B)) (trans X d m d (sym X m d A) B))
    (transH (apH (trans X d m d (sym X m d (trans X m m d (refl m) A))) (trans-refl-l X m d B))
            (apH (\ e -> trans X d m d (sym X m d e) B) (trans-refl-l X m d A))) a z ;

-- (A . b0)^-1 . ((A . M) . b0) = b0^-1 . (M . b0)
grp3 (X : U l) (u v : X) (A : Id X u v) (M : Id X v v) : (w : X) (b0 : Id X v w) ->
  Id (Id X w w) (trans X w u w (sym X u w (trans X u v w A b0)) (trans X u v w (trans X u v v A M) b0)) (trans X w v w (sym X v w b0) (trans X v v w M b0)) =
  \ w b0 -> idJ X v (\ w1 b1 -> Id (Id X w1 w1) (trans X w1 u w1 (sym X u w1 (trans X u v w1 A b1)) (trans X u v w1 (trans X u v v A M) b1)) (trans X w1 v w1 (sym X v w1 b1) (trans X v v w1 M b1)))
    (transH (trans-cancel X u v v A M) (symH (trans-refl-l X v v M))) w b0 ;

------------------------------------------------------------------------
-- pointed null-homotopies of p ; c, in fibrewise form: T(c) of the text
Tc (V : U l) (v0 : V) (Y : U l) (y0 : Y) (Y' : U l) (y0' : Y') (k : PtMap V v0 Y y0) (c : PtMap V v0 Y' y0') : U l =
  (F : (x : V) -> Id Y (k.1 x) y0 -> Id Y' (c.1 x) y0') * Id (Id Y' (c.1 v0) y0') (F v0 k.2) c.2 ;

------------------------------------------------------------------------
-- The key lemma: null-homotopies of p ; c are factorisations of c through k

module Key (V : U l) (v0 : V) (cV : isConn two V) (Y : U l) (y0 : Y) (cY : isConn five Y)
  (Y' : U l) (y0' : Y') (cY' : isConn four Y') (tY' : isTrunc (suc five) Y')
  (k : PtMap V v0 Y y0) (c : PtMap V v0 Y' y0') {
  -- the fibres of k and of c
  P (x : V) : U l = Id Y (k.1 x) y0 ;
  Q (x : V) : U l = Id Y' (c.1 x) y0' ;
  Fam : U l = (x : V) -> P x -> Q x ;
  -- pointed null-homotopies of p ; c, fibrewise
  T : U l = Tc V v0 Y y0 Y' y0' k c ;
  MY : U l = PtMap Y y0 Y' y0' ;
  kb (be : MY) : PtMap V v0 Y' y0' = ptcomp V v0 Y y0 Y' y0' k be ;
  -- factorisations of c through k
  S : U l = (be : MY) * Id (PtMap V v0 Y' y0') c (kb be) ;
  -- the canonical null-homotopy of p ; k ; be on the fibre over y
  G (be : MY) (y : Y) (q : Id Y y y0) : Id Y' (be.1 y) y0' = trans Y' (be.1 y) (be.1 y0) y0' (ap Y Y' be.1 y y0 q) be.2 ;
  Z (be : MY) (x : V) : U l = Id Y' (c.1 x) (be.1 (k.1 x)) ;
  -- the homotopy of a factorisation
  hs (w : S) (x : V) : Z w.1 x = (ptpath V v0 Y' y0' c (kb w.1) w.2).1 x ;
  -- Definition Phi
  Phi (w : S) : T =
    (\ x q -> trans Y' (c.1 x) (w.1.1 (k.1 x)) y0' (hs w x) (G w.1 (k.1 x) q), symH (ptpath V v0 Y' y0' c (kb w.1) w.2).2) ;

  -- translates of G be on the fibre over x
  Tl (be : MY) (x : V) (Fx : P x -> Q x) : U l = Transl[Y', c.1 x, be.1 (k.1 x), y0', P x, G be (k.1 x)].Tl Fx ;
  tl-prop (be : MY) (x : V) (Fx : P x -> Q x) : isProp (Tl be x Fx) =
    Transl[Y', c.1 x, be.1 (k.1 x), y0', P x, G be (k.1 x)].prop (conn-id four Y cY (k.1 x) y0) tY' Fx ;

  ----------------------------------------------------------------------
  -- Lemma fac

  Dist (be : MY) : U l = (F : Fam) * ((x : V) -> Tl be x (F x)) ;
  m2 (be : MY) (h : (x : V) -> Z be x) : Dist be =
    (\ x q -> trans Y' (c.1 x) (be.1 (k.1 x)) y0' (h x) (G be (k.1 x) q), \ x -> (h x, refl (\ q -> trans Y' (c.1 x) (be.1 (k.1 x)) y0' (h x) (G be (k.1 x) q)))) ;
  m2-equiv (be : MY) : Equiv ((x : V) -> Z be x) (Dist be) =
    (m2 be, E.homotopy ((x : V) -> Z be x) (Dist be)
      (E.compose ((x : V) -> Z be x) ((x : V) -> Transl[Y', c.1 x, be.1 (k.1 x), y0', P x, G be (k.1 x)].TT) (Dist be)
         (\ h x -> Transl[Y', c.1 x, be.1 (k.1 x), y0', P x, G be (k.1 x)].to (h x),
          CM.pi-equiv V (Z be) (\ x -> Transl[Y', c.1 x, be.1 (k.1 x), y0', P x, G be (k.1 x)].TT)
            (\ x -> Transl[Y', c.1 x, be.1 (k.1 x), y0', P x, G be (k.1 x)].to) (\ x -> Transl[Y', c.1 x, be.1 (k.1 x), y0', P x, G be (k.1 x)].equiv))
         (\ u -> (\ x -> (u x).1, \ x -> (u x).2),
          qinv ((x : V) -> Transl[Y', c.1 x, be.1 (k.1 x), y0', P x, G be (k.1 x)].TT) (Dist be) (\ u -> (\ x -> (u x).1, \ x -> (u x).2))
            (\ v x -> (v.1 x, v.2 x)) (\ v -> refl v) (\ u -> refl u)))
      (m2 be) (\ h -> refl (m2 be h))) ;
  -- the pointing condition, carried along m2
  Pt (be : MY) (u : Dist be) : U l = Id (Q v0) c.2 (u.1 v0 k.2) ;
  Fac (be : MY) : U l = (t : T) * ((x : V) -> Tl be x (t.1 x)) ;
  fac-map (be : MY) (s : Id (PtMap V v0 Y' y0') c (kb be)) : Fac be =
    (Phi (be, s), \ x -> (hs (be, s) x, refl (\ q -> trans Y' (c.1 x) (be.1 (k.1 x)) y0' (hs (be, s) x) (G be (k.1 x) q)))) ;
  fac-equiv (be : MY) : isEquiv (Id (PtMap V v0 Y' y0') c (kb be)) (Fac be) (fac-map be) =
    E.homotopy (Id (PtMap V v0 Y' y0') c (kb be)) (Fac be)
      (E.compose (Id (PtMap V v0 Y' y0') c (kb be)) (PtR V v0 Y' y0' c (kb be)) (Fac be)
         (ptpath V v0 Y' y0' c (kb be), PtPath[V, v0, Y', y0', c].equiv (kb be))
         (E.compose (PtR V v0 Y' y0' c (kb be)) ((u : Dist be) * Pt be u) (Fac be)
            (\ w -> (m2 be w.1, w.2), SphereAxiom[l].sigma-base ((x : V) -> Z be x) (Dist be) (m2-equiv be) (Pt be))
            (E.compose ((u : Dist be) * Pt be u) ((u : Dist be) * Id (Q v0) (u.1 v0 k.2) c.2) (Fac be)
               (Fb.sigma-equiv (Dist be) (Pt be) (\ u -> Id (Q v0) (u.1 v0 k.2) c.2) (\ u -> CM.sym-equiv (Q v0) c.2 (u.1 v0 k.2)))
               (\ w -> ((w.1.1, w.2), w.1.2),
                qinv ((u : Dist be) * Id (Q v0) (u.1 v0 k.2) c.2) (Fac be) (\ w -> ((w.1.1, w.2), w.1.2)) (\ v -> ((v.1.1, v.2), v.1.2))
                  (\ v -> refl v) (\ w -> refl w)))))
      (fac-map be) (\ s -> refl (fac-map be s)) ;

  ----------------------------------------------------------------------
  -- Lemmas at-point and unique-fac

  module MW = Maps[Y, y0, Y', y0'] ;
  -- the restriction to the fibre over the point, conjugated by c0
  res (t : T) : MW.PMO =
    (\ q -> trans Y' y0' (c.1 v0) y0' (sym Y' (c.1 v0) y0' c.2) (t.1 v0 (trans Y (k.1 v0) y0 y0 k.2 q)),
     transH (apH (trans Y' y0' (c.1 v0) y0' (sym Y' (c.1 v0) y0' c.2)) t.2) (trans-sym-l Y' (c.1 v0) y0' c.2)) ;
  pmo-trunc : isTrunc two MW.PMO =
    cor5-map two three (Id Y y0 y0) (refl y0) (conn-id four Y cY y0 y0) (Id Y' y0' y0') (refl y0') (tY' y0' y0') ;
  cOOY' : isConn two (Id (Id Y' y0' y0') (refl y0') (refl y0')) =
    conn-id two (Id Y' y0' y0') (conn-id three Y' cY' y0' y0') (refl y0') (refl y0') ;

  -- (=>)
  to-loop-at (t : T) (be : MY) (u : Tl be v0 (t.1 v0)) (q : Id Y y0 y0) : Id (Id Y' y0' y0') ((res t).1 q) ((MW.loop be).1 q) =
    calc (Id Y' y0' y0') {
      trans Y' y0' (c.1 v0) y0' (sym Y' (c.1 v0) y0' c.2) (t.1 v0 (trans Y (k.1 v0) y0 y0 k.2 q))
        =< apH (trans Y' y0' (c.1 v0) y0' (sym Y' (c.1 v0) y0' c.2))
             (symH (happly (P v0) (\ w -> Q v0) (\ w -> trans Y' (c.1 v0) (be.1 (k.1 v0)) y0' u.1 (G be (k.1 v0) w)) (t.1 v0) u.2 (trans Y (k.1 v0) y0 y0 k.2 q))) >
      trans Y' y0' (c.1 v0) y0' (sym Y' (c.1 v0) y0' c.2) (trans Y' (c.1 v0) (be.1 (k.1 v0)) y0' u.1 (G be (k.1 v0) (trans Y (k.1 v0) y0 y0 k.2 q)))
        =< apH (\ e -> trans Y' y0' (c.1 v0) y0' (sym Y' (c.1 v0) y0' e) (trans Y' (c.1 v0) (be.1 (k.1 v0)) y0' u.1 (G be (k.1 v0) (trans Y (k.1 v0) y0 y0 k.2 q))))
             (transH (symH t.2) (symH (happly (P v0) (\ w -> Q v0) (\ w -> trans Y' (c.1 v0) (be.1 (k.1 v0)) y0' u.1 (G be (k.1 v0) w)) (t.1 v0) u.2 k.2))) >
      trans Y' y0' (c.1 v0) y0' (sym Y' (c.1 v0) y0' (trans Y' (c.1 v0) (be.1 (k.1 v0)) y0' u.1 (G be (k.1 v0) k.2)))
        (trans Y' (c.1 v0) (be.1 (k.1 v0)) y0' u.1 (G be (k.1 v0) (trans Y (k.1 v0) y0 y0 k.2 q)))
        =< grp1 Y' (be.1 (k.1 v0)) y0' (G be (k.1 v0) k.2) (G be (k.1 v0) (trans Y (k.1 v0) y0 y0 k.2 q)) (c.1 v0) u.1 >
      trans Y' y0' (be.1 (k.1 v0)) y0' (sym Y' (be.1 (k.1 v0)) y0' (G be (k.1 v0) k.2)) (G be (k.1 v0) (trans Y (k.1 v0) y0 y0 k.2 q))
        =< apH (\ a -> trans Y' y0' (be.1 (k.1 v0)) y0' (sym Y' (be.1 (k.1 v0)) y0' (G be (k.1 v0) k.2)) (trans Y' (be.1 (k.1 v0)) (be.1 y0) y0' a be.2))
             (Gp.ap-trans Y Y' be.1 (k.1 v0) y0 y0 k.2 q) >
      trans Y' y0' (be.1 (k.1 v0)) y0' (sym Y' (be.1 (k.1 v0)) y0' (G be (k.1 v0) k.2))
        (trans Y' (be.1 (k.1 v0)) (be.1 y0) y0' (trans Y' (be.1 (k.1 v0)) (be.1 y0) (be.1 y0) (ap Y Y' be.1 (k.1 v0) y0 k.2) (ap Y Y' be.1 y0 y0 q)) be.2)
        =< grp3 Y' (be.1 (k.1 v0)) (be.1 y0) (ap Y Y' be.1 (k.1 v0) y0 k.2) (ap Y Y' be.1 y0 y0 q) y0' be.2 >
      trans Y' y0' (be.1 y0) y0' (sym Y' (be.1 y0) y0' be.2) (trans Y' (be.1 y0) (be.1 y0) y0' (ap Y Y' be.1 y0 y0 q) be.2)
        =< symH (MW.loop-ap be q) >
      (MW.loop be).1 q } ;
  to-loop (t : T) (be : MY) (u : Tl be v0 (t.1 v0)) : Id MW.PMO (res t) (MW.loop be) =
    Tr.Trunc[Id MW.PMO (res t) (MW.loop be)].induction @l (\ h -> Id MW.PMO (res t) (MW.loop be))
      (\ h -> trunc-one-prop (Id MW.PMO (res t) (MW.loop be)) (pmo-trunc (res t) (MW.loop be))) (\ h -> h)
      (FH.pi-mere (Id Y y0 y0) (refl y0) (Id Y' y0' y0') (refl y0') cOOY' (res t).1 (MW.loop be).1
         (FL.funext (Id Y y0 y0) (\ q -> Id Y' y0' y0') (res t).1 (MW.loop be).1 (to-loop-at t be u)) (res t).2 (MW.loop be).2) ;

  -- the restriction of Phi (be, s) to the fibre over the point is loop be (the coefficient b on pi_3)
  res-phi (w : S) : Id MW.PMO (res (Phi w)) (MW.loop w.1) = to-loop (Phi w) w.1 ((fac-map w.1 w.2).2 v0) ;

  -- (<=)
  zt (t : T) (be : MY) : Z be v0 =
    trans Y' (c.1 v0) y0' (be.1 (k.1 v0)) (t.1 v0 k.2) (sym Y' (be.1 (k.1 v0)) y0' (G be (k.1 v0) k.2)) ;
  Goal (t : T) (be : MY) (w : P v0) : U l = Id (Q v0) (trans Y' (c.1 v0) (be.1 (k.1 v0)) y0' (zt t be) (G be (k.1 v0) w)) (t.1 v0 w) ;
  goal-at (t : T) (be : MY) (r : Id MW.PMO (res t) (MW.loop be)) (q : Id Y y0 y0) : Goal t be (trans Y (k.1 v0) y0 y0 k.2 q) =
    calc (Q v0) {
      trans Y' (c.1 v0) (be.1 (k.1 v0)) y0' (zt t be) (G be (k.1 v0) (trans Y (k.1 v0) y0 y0 k.2 q))
        =< apH (\ a -> trans Y' (c.1 v0) (be.1 (k.1 v0)) y0' (zt t be) (trans Y' (be.1 (k.1 v0)) (be.1 y0) y0' a be.2))
             (Gp.ap-trans Y Y' be.1 (k.1 v0) y0 y0 k.2 q) >
      trans Y' (c.1 v0) (be.1 (k.1 v0)) y0' (zt t be)
        (trans Y' (be.1 (k.1 v0)) (be.1 y0) y0' (trans Y' (be.1 (k.1 v0)) (be.1 y0) (be.1 y0) (ap Y Y' be.1 (k.1 v0) y0 k.2) (ap Y Y' be.1 y0 y0 q)) be.2)
        =< apH (\ e -> trans Y' (c.1 v0) (be.1 (k.1 v0)) y0' (trans Y' (c.1 v0) y0' (be.1 (k.1 v0)) e (sym Y' (be.1 (k.1 v0)) y0' (G be (k.1 v0) k.2)))
                 (trans Y' (be.1 (k.1 v0)) (be.1 y0) y0' (trans Y' (be.1 (k.1 v0)) (be.1 y0) (be.1 y0) (ap Y Y' be.1 (k.1 v0) y0 k.2) (ap Y Y' be.1 y0 y0 q)) be.2)) t.2 >
      trans Y' (c.1 v0) (be.1 (k.1 v0)) y0' (trans Y' (c.1 v0) y0' (be.1 (k.1 v0)) c.2 (sym Y' (be.1 (k.1 v0)) y0' (G be (k.1 v0) k.2)))
        (trans Y' (be.1 (k.1 v0)) (be.1 y0) y0' (trans Y' (be.1 (k.1 v0)) (be.1 y0) (be.1 y0) (ap Y Y' be.1 (k.1 v0) y0 k.2) (ap Y Y' be.1 y0 y0 q)) be.2)
        =< Gp.tassoc Y' (c.1 v0) y0' (be.1 (k.1 v0)) c.2 (sym Y' (be.1 (k.1 v0)) y0' (G be (k.1 v0) k.2)) y0'
             (trans Y' (be.1 (k.1 v0)) (be.1 y0) y0' (trans Y' (be.1 (k.1 v0)) (be.1 y0) (be.1 y0) (ap Y Y' be.1 (k.1 v0) y0 k.2) (ap Y Y' be.1 y0 y0 q)) be.2) >
      trans Y' (c.1 v0) y0' y0' c.2 (trans Y' y0' (be.1 (k.1 v0)) y0' (sym Y' (be.1 (k.1 v0)) y0' (G be (k.1 v0) k.2))
        (trans Y' (be.1 (k.1 v0)) (be.1 y0) y0' (trans Y' (be.1 (k.1 v0)) (be.1 y0) (be.1 y0) (ap Y Y' be.1 (k.1 v0) y0 k.2) (ap Y Y' be.1 y0 y0 q)) be.2))
        =< apH (trans Y' (c.1 v0) y0' y0' c.2) (grp3 Y' (be.1 (k.1 v0)) (be.1 y0) (ap Y Y' be.1 (k.1 v0) y0 k.2) (ap Y Y' be.1 y0 y0 q) y0' be.2) >
      trans Y' (c.1 v0) y0' y0' c.2 (trans Y' y0' (be.1 y0) y0' (sym Y' (be.1 y0) y0' be.2) (trans Y' (be.1 y0) (be.1 y0) y0' (ap Y Y' be.1 y0 y0 q) be.2))
        =< apH (trans Y' (c.1 v0) y0' y0' c.2)
             (symH (transH (happly (Id Y y0 y0) (\ q1 -> Id Y' y0' y0') (res t).1 (MW.loop be).1 (ap MW.PMO (Id Y y0 y0 -> Id Y' y0' y0') (\ R -> R.1) (res t) (MW.loop be) r) q)
                           (MW.loop-ap be q))) >
      trans Y' (c.1 v0) y0' y0' c.2 (trans Y' y0' (c.1 v0) y0' (sym Y' (c.1 v0) y0' c.2) (t.1 v0 (trans Y (k.1 v0) y0 y0 k.2 q)))
        =< Fb.trans-cancel' Y' (c.1 v0) y0' y0' c.2 (t.1 v0 (trans Y (k.1 v0) y0 y0 k.2 q)) >
      t.1 v0 (trans Y (k.1 v0) y0 y0 k.2 q) } ;
  from-loop (t : T) (be : MY) (r : Id MW.PMO (res t) (MW.loop be)) : Tl be v0 (t.1 v0) =
    (zt t be, FL.funext (P v0) (\ w -> Q v0) (\ w -> trans Y' (c.1 v0) (be.1 (k.1 v0)) y0' (zt t be) (G be (k.1 v0) w)) (t.1 v0)
       (\ w -> subst (P v0) (Goal t be) (trans Y (k.1 v0) y0 y0 k.2 (trans Y y0 (k.1 v0) y0 (sym Y (k.1 v0) y0 k.2) w)) w
                 (Fb.trans-cancel' Y (k.1 v0) y0 y0 k.2 w) (goal-at t be r (trans Y y0 (k.1 v0) y0 (sym Y (k.1 v0) y0 k.2) w)))) ;

  -- Lemma unique-fac
  Unl (t : T) : U l = (be : MY) * Id MW.PMO (res t) (MW.loop be) ;
  unique-fac (t : T) : isContr ((be : MY) * ((x : V) -> Tl be x (t.1 x))) =
    retract-contr ((be : MY) * ((x : V) -> Tl be x (t.1 x))) (Unl t)
      (Logic[l].sigma-equiv MY MY (idEquiv MY) (\ be -> (x : V) -> Tl be x (t.1 x)) (\ be -> Id MW.PMO (res t) (MW.loop be))
         (\ be -> FL.isProp-Pi V (\ x -> Tl be x (t.1 x)) (\ x -> tl-prop be x (t.1 x)))
         (\ be -> trunc-one-prop (Id MW.PMO (res t) (MW.loop be)) (pmo-trunc (res t) (MW.loop be)))
         (\ be u -> to-loop t be (u v0))
         (\ be r x -> conn-elim zero V v0 cV (\ x1 -> Tl be x1 (t.1 x1)) (\ x1 -> tl-prop be x1 (t.1 x1)) (from-loop t be r) x)).1
      (Logic[l].sigma-equiv MY MY (idEquiv MY) (\ be -> (x : V) -> Tl be x (t.1 x)) (\ be -> Id MW.PMO (res t) (MW.loop be))
         (\ be -> FL.isProp-Pi V (\ x -> Tl be x (t.1 x)) (\ x -> tl-prop be x (t.1 x)))
         (\ be -> trunc-one-prop (Id MW.PMO (res t) (MW.loop be)) (pmo-trunc (res t) (MW.loop be)))
         (\ be u -> to-loop t be (u v0))
         (\ be r x -> conn-elim zero V v0 cV (\ x1 -> Tl be x1 (t.1 x1)) (\ x1 -> tl-prop be x1 (t.1 x1)) (from-loop t be r) x)).2.sec
      (sec-ret ((be : MY) * ((x : V) -> Tl be x (t.1 x))) (Unl t)
         (Logic[l].sigma-equiv MY MY (idEquiv MY) (\ be -> (x : V) -> Tl be x (t.1 x)) (\ be -> Id MW.PMO (res t) (MW.loop be))
            (\ be -> FL.isProp-Pi V (\ x -> Tl be x (t.1 x)) (\ x -> tl-prop be x (t.1 x)))
            (\ be -> trunc-one-prop (Id MW.PMO (res t) (MW.loop be)) (pmo-trunc (res t) (MW.loop be)))
            (\ be u -> to-loop t be (u v0))
            (\ be r x -> conn-elim zero V v0 cV (\ x1 -> Tl be x1 (t.1 x1)) (\ x1 -> tl-prop be x1 (t.1 x1)) (from-loop t be r) x)).1
         (Logic[l].sigma-equiv MY MY (idEquiv MY) (\ be -> (x : V) -> Tl be x (t.1 x)) (\ be -> Id MW.PMO (res t) (MW.loop be))
            (\ be -> FL.isProp-Pi V (\ x -> Tl be x (t.1 x)) (\ x -> tl-prop be x (t.1 x)))
            (\ be -> trunc-one-prop (Id MW.PMO (res t) (MW.loop be)) (pmo-trunc (res t) (MW.loop be)))
            (\ be u -> to-loop t be (u v0))
            (\ be r x -> conn-elim zero V v0 cV (\ x1 -> Tl be x1 (t.1 x1)) (\ x1 -> tl-prop be x1 (t.1 x1)) (from-loop t be r) x)).2)
      (MW.Over[res t].cor11 two (conn-down four Y cY) tY') ;

  ----------------------------------------------------------------------
  -- Lemma key

  key : isEquiv S T Phi =
    E.homotopy S T
      (E.compose S ((be : MY) * Fac be) T
         (Fb.sigma-equiv MY (\ be -> Id (PtMap V v0 Y' y0') c (kb be)) Fac (\ be -> (fac-map be, fac-equiv be)))
         (E.compose ((be : MY) * Fac be) ((t : T) * ((be : MY) * ((x : V) -> Tl be x (t.1 x)))) T
            (\ w -> (w.2.1, (w.1, w.2.2)),
             qinv ((be : MY) * Fac be) ((t : T) * ((be : MY) * ((x : V) -> Tl be x (t.1 x)))) (\ w -> (w.2.1, (w.1, w.2.2))) (\ v -> (v.2.1, (v.1, v.2.2)))
               (\ v -> refl v) (\ w -> refl w))
            (\ v -> v.1, SphereTruncation[l].fst-equiv T (\ t -> (be : MY) * ((x : V) -> Tl be x (t.1 x))) unique-fac)))
      Phi (\ w -> refl (Phi w)) ;
} ;
