-- The source S^3 (doc/br-universal.pdf, Section 3: K(Z,3) is the 3-truncation of
-- S^3).  The S^3 axiom is a segment parameter telescope (S3, base, surf, ump3) of
-- the module SourceS3 (Sphere3Axiom.Sphere3); the S^2 axiom is not used.
--
-- Informal proof.
--   LoopEquiv   Lemma loopeq3: for X isConn (c+2) and Y isTrunc (2c+2), looping
--               Map_*(X, Y) -> Map_*(Omega X, Omega Y) is an equivalence: its fibres
--               Unloop f are contractible (Over.cor11); used at c = 2 (X = K(Z,3))
--               and c = 1 (X = K(Z,2)).  (MapFib.SourceS.LoopEq is the instance c = 1.)
--   g-def       the generator g of CircleProperty.Circle does not depend on the
--               parameter (MapFib.SourceS.g-def, without the S^2 parameters)
--   c3, sigma3  Definition sigma3: c3 = (loop^2 e_2^-1) ((loop e_1^-1) g) in
--               Omega^3 K(Z,3), sigma3 = ev^-1 c3 : S3 ->pt K(Z,3) (e_2 the locked
--               Lev[Z,Z].eA two, e_1 = CupSquare.e1)
--   Sig3        Proposition sigma3, for a 3-type (Z, z0):
--               Psi3 G = ev° (e_1^-1 ; loop (e_2^-1 ; loop G)), ev° the circle
--               property at Omega^2 Z, is a composite of five equivalences (loop at
--               c = 2, e_2^-1 ; -, loop at c = 1, e_1^-1 ; -, ev°); sigma3-nat:
--                 ev (sigma3 ; G) = (loop^3 G) c3                  (evPt-nat, sigma3-ev)
--                                 = (loop^2 (e_2^-1 ; loop G)) ((loop e_1^-1) g)
--                                                                  (loop2-comp)
--                                 = (loop (e_1^-1 ; loop (e_2^-1 ; loop G))) g
--                                                                  (loop-comp, g-def)
--                                 = Psi3 G                          (evPt-loop);
--               so sigma3^* is an equivalence (cancel-equiv), and on classes (pre-equiv)
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ; open HLevels[l] ; open Connected[l] ;
open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ; open LoopCalc[l] ; open Torsor[l] ; open Z2[l] ;
open EMMaps[l] ; open HomotopyClasses[l] ; open SphereUniversal[l] ; open PostnikovRealization[l] ; open KZ2Cohomology[l] ;
open SphereAxiom[l] ; open Sphere3Axiom[l] ;
module N = NatArith[l] ;
module E = Equivalences[l] ; module W = Whitehead[l] ;
module CS = CupSquare[l] ; module CP = CircleProperty[l] ; module MF = MapFib[l] ; module MB = MapBR[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ; module Fb = Fibres[l] ; module DR = DeloopR[l] ;
module L = H4Bilinear[l].Lev[Zab, Zab] ;

------------------------------------------------------------------------
-- Lemma loopeq3

module LoopEquiv (X : U l) (x0 : X) (Y : U l) (y0 : Y) (c : Nat) (cX : isConn (suc (suc c)) X)
  (tY : isTrunc (N.plus (suc c) (N.plus (suc c) zero)) Y) {
  module M = Maps[X, x0, Y, y0] ;
  cell (f : M.PMO) : isContr M.Over[f].Unloop = M.Over[f].cor11 c cX tY ;
  equiv : isEquiv (PtMap X x0 Y y0) M.PMO M.loop =
    qinv (PtMap X x0 Y y0) M.PMO M.loop (\ f -> (cell f).1.1) (\ f -> symH (cell f).1.2)
      (\ G -> apH (\ w -> w.1) (contr-prop M.Over[M.loop G].Unloop (cell (M.loop G)) (cell (M.loop G)).1 (G, refl (M.loop G)))) ;
} ;

-- the generator g of Circle does not depend on its parameter (g is locked:
-- both have band g = band (g . refl) = suc (band refl), band-g; band-inj)
g-def (Y : U l) : Id (Id CS.C.Z1.K1 CS.C.Z1.k0 CS.C.Z1.k0) CP.Circle[Y].g CS.C.g =
  CS.C.Z1.band-inj CS.C.Z1.k0 CP.Circle[Y].g CS.C.g
    (transH (CP.Circle[Y].band-g (refl CS.C.Z1.k0)) (symH (CS.C.band-g (refl CS.C.Z1.k0)))) ;

-- levels of K(B,5): Omega^3 and Omega^4 are connected
module LevW5 (Gb : Ab) {
  cO3W : isConn two (O3 (KK[Gb].K five) (KK[Gb].pt five)) =
    conn-down two (O3 (KK[Gb].K five) (KK[Gb].pt five))
      (conn-id three (O2 (KK[Gb].K five) (KK[Gb].pt five))
         (conn-id four (Id (KK[Gb].K five) (KK[Gb].pt five) (KK[Gb].pt five)) (conn-id five (KK[Gb].K five) (KK[Gb].conn four) (KK[Gb].pt five) (KK[Gb].pt five))
            (refl (KK[Gb].pt five)) (refl (KK[Gb].pt five)))
         (refl (refl (KK[Gb].pt five))) (refl (refl (KK[Gb].pt five)))) ;
  cO4W : isConn two (O3 (Id (KK[Gb].K five) (KK[Gb].pt five) (KK[Gb].pt five)) (refl (KK[Gb].pt five))) =
    conn-id two (O3 (KK[Gb].K five) (KK[Gb].pt five))
      (conn-id three (O2 (KK[Gb].K five) (KK[Gb].pt five))
         (conn-id four (Id (KK[Gb].K five) (KK[Gb].pt five) (KK[Gb].pt five)) (conn-id five (KK[Gb].K five) (KK[Gb].conn four) (KK[Gb].pt five) (KK[Gb].pt five))
            (refl (KK[Gb].pt five)) (refl (KK[Gb].pt five)))
         (refl (refl (KK[Gb].pt five))) (refl (refl (KK[Gb].pt five))))
      (refl (refl (refl (KK[Gb].pt five)))) (refl (refl (refl (KK[Gb].pt five)))) ;
} ;

------------------------------------------------------------------------

module SourceS3 (S3 : U l) (base : S3) (surf : O3 S3 base)
  (ump3 : (X : U l) -> isEquiv (S3 -> X) ((x : X) * O3 X x) (ev3 S3 base surf X)) {
  module SA = Sphere3[S3, base, surf, ump3] ;

  -- Lemma s3paths: if Omega^3 Z is connected, any two pointed maps S3 -> Z are merely equal
  s3-paths (Z : U l) (z0 : Z) (c : isConn two (O3 Z z0)) (F F' : PtMap S3 base Z z0) : Tr.Trunc[Id (PtMap S3 base Z z0) F F'].carrier =
    TC.map (Id (O3 Z z0) (SA.evPt Z z0 F) (SA.evPt Z z0 F')) (Id (PtMap S3 base Z z0) F F')
      (E.injective (PtMap S3 base Z z0) (O3 Z z0) (SA.evPt Z z0) (SA.pointed-up Z z0) F F')
      (conn-path zero (O3 Z z0) c (SA.evPt Z z0 F) (SA.evPt Z z0 F')) ;

  -- Corollary qS: (E) and (U) for the source S3, every level-3 triple
  ex-S3 (Ga Gb : Ab) (K : PtMap (KK[Ga].K three) (KK[Ga].pt three) (KK[Gb].K five) (KK[Gb].pt five)) : MB.LiftG[S3, base, KK[Ga].K three, KK[Ga].pt three, KK[Gb].K five, KK[Gb].pt five, K, MB.Triple3[Ga, Gb, K].cOW, MB.Triple3[Ga, Gb, K].cOF].Ex =
    \ F -> s3-paths (KK[Gb].K five) (KK[Gb].pt five) LevW5[Gb].cO3W
             (ptcomp S3 base (KK[Ga].K three) (KK[Ga].pt three) (KK[Gb].K five) (KK[Gb].pt five) F K) (ptconst S3 base (KK[Gb].K five) (KK[Gb].pt five)) ;
  un-S3 (Ga Gb : Ab) (K : PtMap (KK[Ga].K three) (KK[Ga].pt three) (KK[Gb].K five) (KK[Gb].pt five)) : MB.LiftG[S3, base, KK[Ga].K three, KK[Ga].pt three, KK[Gb].K five, KK[Gb].pt five, K, MB.Triple3[Ga, Gb, K].cOW, MB.Triple3[Ga, Gb, K].cOF].Un =
    \ d -> s3-paths (Id (KK[Gb].K five) (KK[Gb].pt five) (KK[Gb].pt five)) (refl (KK[Gb].pt five)) LevW5[Gb].cO4W
             (ptconst S3 base (Id (KK[Gb].K five) (KK[Gb].pt five) (KK[Gb].pt five)) (refl (KK[Gb].pt five))) d ;
  qS3 (Ga Gb : Ab) (K : PtMap (KK[Ga].K three) (KK[Ga].pt three) (KK[Gb].K five) (KK[Gb].pt five)) :
    isEquiv (HC S3 base MB.Triple3[Ga, Gb, K].F MB.Triple3[Ga, Gb, K].f0) (HC S3 base (KK[Ga].K three) (KK[Ga].pt three)) MB.LiftG[S3, base, KK[Ga].K three, KK[Ga].pt three, KK[Gb].K five, KK[Gb].pt five, K, MB.Triple3[Ga, Gb, K].cOW, MB.Triple3[Ga, Gb, K].cOF].qs =
    MB.LiftG[S3, base, KK[Ga].K three, KK[Ga].pt three, KK[Gb].K five, KK[Gb].pt five, K, MB.Triple3[Ga, Gb, K].cOW, MB.Triple3[Ga, Gb, K].cOF].Main[ex-S3 Ga Gb K, un-S3 Ga Gb K].equiv ;

  -- e_2 = Lev[Z,Z].eA two at the spelling K(Z,3) = KK.K three (the numerals are
  -- compared once, here), and its inverse
  e2 : PtEquiv (Id (KK[Zab].K three) (KK[Zab].pt three) (KK[Zab].pt three)) (refl (KK[Zab].pt three)) KZ2 kz2 = L.eA two ;
  e2i : PtMap KZ2 kz2 (Id (KK[Zab].K three) (KK[Zab].pt three) (KK[Zab].pt three)) (refl (KK[Zab].pt three)) =
    (pt-inv (Id (KK[Zab].K three) (KK[Zab].pt three) (KK[Zab].pt three)) (refl (KK[Zab].pt three)) KZ2 kz2 e2).1 ;

  -- Definition sigma3
  c3 : O3 (KK[Zab].K three) (KK[Zab].pt three) =
    (loop2 KZ2 kz2 (Id (KK[Zab].K three) (KK[Zab].pt three) (KK[Zab].pt three)) (refl (KK[Zab].pt three)) e2i).1
      ((Maps[CS.C.Z1.K1, CS.C.Z1.k0, Id KZ2 kz2 kz2, refl kz2].loop CS.e1inv).1 CS.C.g) ;
  sigma3 : PtMap S3 base (KK[Zab].K three) (KK[Zab].pt three) = (SA.pointed-up (KK[Zab].K three) (KK[Zab].pt three)).sec c3 ;
  sigma3-ev : Id (O3 (KK[Zab].K three) (KK[Zab].pt three)) (SA.evPt (KK[Zab].K three) (KK[Zab].pt three) sigma3) c3 =
    (SA.pointed-up (KK[Zab].K three) (KK[Zab].pt three)).sec-eq c3 ;

  -- Proposition sigma3
  module Sig3 (Z : U l) (z0 : Z) (tZ : isTrunc five Z) {
    module CY = CP.Circle[O2 Z z0] ;
    module M3 = Maps[KK[Zab].K three, KK[Zab].pt three, Z, z0] ;
    module M2 = Maps[KZ2, kz2, Id Z z0 z0, refl z0] ;
    -- e_2^-1 ; loop G
    N2 (G : PtMap (KK[Zab].K three) (KK[Zab].pt three) Z z0) : PtMap KZ2 kz2 (Id Z z0 z0) (refl z0) =
      ptcomp KZ2 kz2 (Id (KK[Zab].K three) (KK[Zab].pt three) (KK[Zab].pt three)) (refl (KK[Zab].pt three)) (Id Z z0 z0) (refl z0)
        e2i (M3.loop G) ;
    -- e_1^-1 ; loop (e_2^-1 ; loop G)
    N1 (G : PtMap (KK[Zab].K three) (KK[Zab].pt three) Z z0) : PtMap CS.C.Z1.K1 CS.C.Z1.k0 (O2 Z z0) (refl (refl z0)) =
      ptcomp CS.C.Z1.K1 CS.C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) (O2 Z z0) (refl (refl z0)) CS.e1inv (M2.loop (N2 G)) ;
    Psi3 (G : PtMap (KK[Zab].K three) (KK[Zab].pt three) Z z0) : O3 Z z0 = CY.evPt (refl (refl z0)) (N1 G) ;

    -- the five equivalences
    e-loop3 : Equiv (PtMap (KK[Zab].K three) (KK[Zab].pt three) Z z0) M3.PMO =
      (M3.loop, LoopEquiv[KK[Zab].K three, KK[Zab].pt three, Z, z0, two, KK[Zab].conn two, trunc-suc five Z tZ].equiv) ;
    e-pre2 : Equiv M3.PMO (PtMap KZ2 kz2 (Id Z z0 z0) (refl z0)) =
      (\ H -> ptcomp KZ2 kz2 (Id (KK[Zab].K three) (KK[Zab].pt three) (KK[Zab].pt three)) (refl (KK[Zab].pt three)) (Id Z z0 z0) (refl z0) e2i H,
       MF.pre-pteq KZ2 kz2 (Id Z z0 z0) (refl z0) (Id (KK[Zab].K three) (KK[Zab].pt three) (KK[Zab].pt three)) (refl (KK[Zab].pt three))
         (pt-inv (Id (KK[Zab].K three) (KK[Zab].pt three) (KK[Zab].pt three)) (refl (KK[Zab].pt three)) KZ2 kz2 e2)) ;
    e-loop2 : Equiv (PtMap KZ2 kz2 (Id Z z0 z0) (refl z0)) M2.PMO =
      (M2.loop, LoopEquiv[KZ2, kz2, Id Z z0 z0, refl z0, suc zero, KK[Zab].conn (suc zero), tZ z0 z0].equiv) ;
    e-pre1 : Equiv M2.PMO (PtMap CS.C.Z1.K1 CS.C.Z1.k0 (O2 Z z0) (refl (refl z0))) =
      (\ H -> ptcomp CS.C.Z1.K1 CS.C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) (O2 Z z0) (refl (refl z0)) CS.e1inv H,
       MF.pre-pteq CS.C.Z1.K1 CS.C.Z1.k0 (O2 Z z0) (refl (refl z0)) (Id KZ2 kz2 kz2) (refl kz2)
         (pt-inv (Id KZ2 kz2 kz2) (refl kz2) CS.C.Z1.K1 CS.C.Z1.k0 CS.e1)) ;
    -- the composites of the first two, three and four, and the value N1 of the
    -- last (by definition of compose, one level per step)
    comp2 : Equiv (PtMap (KK[Zab].K three) (KK[Zab].pt three) Z z0) (PtMap KZ2 kz2 (Id Z z0 z0) (refl z0)) = E.compose (PtMap (KK[Zab].K three) (KK[Zab].pt three) Z z0) M3.PMO (PtMap KZ2 kz2 (Id Z z0 z0) (refl z0)) e-loop3 e-pre2 ;
    comp3 : Equiv (PtMap (KK[Zab].K three) (KK[Zab].pt three) Z z0) M2.PMO = E.compose (PtMap (KK[Zab].K three) (KK[Zab].pt three) Z z0) (PtMap KZ2 kz2 (Id Z z0 z0) (refl z0)) M2.PMO comp2 e-loop2 ;
    comp4 : Equiv (PtMap (KK[Zab].K three) (KK[Zab].pt three) Z z0) (PtMap CS.C.Z1.K1 CS.C.Z1.k0 (O2 Z z0) (refl (refl z0))) = E.compose (PtMap (KK[Zab].K three) (KK[Zab].pt three) Z z0) M2.PMO (PtMap CS.C.Z1.K1 CS.C.Z1.k0 (O2 Z z0) (refl (refl z0))) comp3 e-pre1 ;
    comp2-def (G : PtMap (KK[Zab].K three) (KK[Zab].pt three) Z z0) : Id (PtMap KZ2 kz2 (Id Z z0 z0) (refl z0)) (comp2.1 G) (N2 G) =
      calc (PtMap KZ2 kz2 (Id Z z0 z0) (refl z0)) {
        comp2.1 G =< refl (comp2.1 G) > e-pre2.1 (e-loop3.1 G)
          =< refl (e-pre2.1 (e-loop3.1 G)) > ptcomp KZ2 kz2 (Id (KK[Zab].K three) (KK[Zab].pt three) (KK[Zab].pt three)) (refl (KK[Zab].pt three)) (Id Z z0 z0) (refl z0) e2i (M3.loop G)
          =< refl (N2 G) > N2 G } ;
    comp3-def (G : PtMap (KK[Zab].K three) (KK[Zab].pt three) Z z0) : Id M2.PMO (comp3.1 G) (M2.loop (N2 G)) =
      calc M2.PMO {
        comp3.1 G =< refl (comp3.1 G) > e-loop2.1 (comp2.1 G)
          =< apH e-loop2.1 (comp2-def G) > e-loop2.1 (N2 G)
          =< refl (M2.loop (N2 G)) > M2.loop (N2 G) } ;
    comp4-def (G : PtMap (KK[Zab].K three) (KK[Zab].pt three) Z z0) : Id (PtMap CS.C.Z1.K1 CS.C.Z1.k0 (O2 Z z0) (refl (refl z0))) (comp4.1 G) (N1 G) =
      calc (PtMap CS.C.Z1.K1 CS.C.Z1.k0 (O2 Z z0) (refl (refl z0))) {
        comp4.1 G =< refl (comp4.1 G) > e-pre1.1 (comp3.1 G)
          =< apH e-pre1.1 (comp3-def G) > e-pre1.1 (M2.loop (N2 G))
          =< refl (N1 G) > N1 G } ;
    psi3-equiv : isEquiv (PtMap (KK[Zab].K three) (KK[Zab].pt three) Z z0) (O3 Z z0) Psi3 =
      E.homotopy (PtMap (KK[Zab].K three) (KK[Zab].pt three) Z z0) (O3 Z z0)
        (E.compose (PtMap (KK[Zab].K three) (KK[Zab].pt three) Z z0) (PtMap CS.C.Z1.K1 CS.C.Z1.k0 (O2 Z z0) (refl (refl z0))) (O3 Z z0)
           comp4 (CY.pointed-equiv (refl (refl z0))))
        Psi3 (\ G -> symH (apH (CY.evPt (refl (refl z0))) (comp4-def G))) ;

    -- ev (sigma3 ; G) = Psi3 G
    sigma3-nat (G : PtMap (KK[Zab].K three) (KK[Zab].pt three) Z z0) :
      Id (O3 Z z0) (SA.evPt Z z0 (ptcomp S3 base (KK[Zab].K three) (KK[Zab].pt three) Z z0 sigma3 G)) (Psi3 G) =
      calc (O3 Z z0) {
        SA.evPt Z z0 (ptcomp S3 base (KK[Zab].K three) (KK[Zab].pt three) Z z0 sigma3 G)
          =< SA.evPt-nat (KK[Zab].K three) (KK[Zab].pt three) Z z0 sigma3 G >
        (loop3 (KK[Zab].K three) (KK[Zab].pt three) Z z0 G).1 (SA.evPt (KK[Zab].K three) (KK[Zab].pt three) sigma3)
          =< apH (loop3 (KK[Zab].K three) (KK[Zab].pt three) Z z0 G).1 sigma3-ev >
        (loop3 (KK[Zab].K three) (KK[Zab].pt three) Z z0 G).1 c3
          =< refl ((loop3 (KK[Zab].K three) (KK[Zab].pt three) Z z0 G).1 c3) >
        (ptcomp (O2 KZ2 kz2) (refl (refl kz2))
           (O2 (Id (KK[Zab].K three) (KK[Zab].pt three) (KK[Zab].pt three)) (refl (KK[Zab].pt three))) (refl (refl (refl (KK[Zab].pt three))))
           (O2 (Id Z z0 z0) (refl z0)) (refl (refl (refl z0)))
           (loop2 KZ2 kz2 (Id (KK[Zab].K three) (KK[Zab].pt three) (KK[Zab].pt three)) (refl (KK[Zab].pt three)) e2i)
           (loop2 (Id (KK[Zab].K three) (KK[Zab].pt three) (KK[Zab].pt three)) (refl (KK[Zab].pt three)) (Id Z z0 z0) (refl z0) (M3.loop G))).1
          ((Maps[CS.C.Z1.K1, CS.C.Z1.k0, Id KZ2 kz2 kz2, refl kz2].loop CS.e1inv).1 CS.C.g)
          =< apH (\ M -> M.1 ((Maps[CS.C.Z1.K1, CS.C.Z1.k0, Id KZ2 kz2 kz2, refl kz2].loop CS.e1inv).1 CS.C.g))
               (symH (loop2-comp KZ2 kz2 (Id (KK[Zab].K three) (KK[Zab].pt three) (KK[Zab].pt three)) (refl (KK[Zab].pt three)) (Id Z z0 z0) (refl z0)
                        e2i (M3.loop G))) >
        (loop2 KZ2 kz2 (Id Z z0 z0) (refl z0) (N2 G)).1 ((Maps[CS.C.Z1.K1, CS.C.Z1.k0, Id KZ2 kz2 kz2, refl kz2].loop CS.e1inv).1 CS.C.g)
          =< refl ((loop2 KZ2 kz2 (Id Z z0 z0) (refl z0) (N2 G)).1 ((Maps[CS.C.Z1.K1, CS.C.Z1.k0, Id KZ2 kz2 kz2, refl kz2].loop CS.e1inv).1 CS.C.g)) >
        (ptcomp (Id CS.C.Z1.K1 CS.C.Z1.k0 CS.C.Z1.k0) (refl CS.C.Z1.k0) (O2 KZ2 kz2) (refl (refl kz2)) (O3 Z z0) (refl (refl (refl z0)))
           (Maps[CS.C.Z1.K1, CS.C.Z1.k0, Id KZ2 kz2 kz2, refl kz2].loop CS.e1inv)
           (Maps[Id KZ2 kz2 kz2, refl kz2, O2 Z z0, refl (refl z0)].loop (M2.loop (N2 G)))).1 CS.C.g
          =< apH (\ M -> M.1 CS.C.g)
               (symH (loop-comp CS.C.Z1.K1 CS.C.Z1.k0 (Id KZ2 kz2 kz2) (refl kz2) (O2 Z z0) (refl (refl z0)) CS.e1inv (M2.loop (N2 G)))) >
        (Maps[CS.C.Z1.K1, CS.C.Z1.k0, O2 Z z0, refl (refl z0)].loop (N1 G)).1 CS.C.g
          =< apH (\ g1 -> (Maps[CS.C.Z1.K1, CS.C.Z1.k0, O2 Z z0, refl (refl z0)].loop (N1 G)).1 g1) (symH (g-def (O2 Z z0))) >
        (Maps[CS.C.Z1.K1, CS.C.Z1.k0, O2 Z z0, refl (refl z0)].loop (N1 G)).1 CY.g
          =< symH (CY.evPt-loop (refl (refl z0)) (N1 G)) >
        Psi3 G } ;

    sigma3-star : isEquiv (PtMap (KK[Zab].K three) (KK[Zab].pt three) Z z0) (PtMap S3 base Z z0)
        (\ G -> ptcomp S3 base (KK[Zab].K three) (KK[Zab].pt three) Z z0 sigma3 G) =
      W.cancel-equiv (PtMap (KK[Zab].K three) (KK[Zab].pt three) Z z0) (PtMap S3 base Z z0) (O3 Z z0)
        (\ G -> ptcomp S3 base (KK[Zab].K three) (KK[Zab].pt three) Z z0 sigma3 G) (SA.evPt Z z0) (SA.pointed-up Z z0)
        (E.homotopy (PtMap (KK[Zab].K three) (KK[Zab].pt three) Z z0) (O3 Z z0) (Psi3, psi3-equiv)
           (\ G -> SA.evPt Z z0 (ptcomp S3 base (KK[Zab].K three) (KK[Zab].pt three) Z z0 sigma3 G)) sigma3-nat) ;
    sigma3-cls : isEquiv (HC (KK[Zab].K three) (KK[Zab].pt three) Z z0) (HC S3 base Z z0)
        (\ b -> compC S3 base (KK[Zab].K three) (KK[Zab].pt three) Z z0 (hcl S3 base (KK[Zab].K three) (KK[Zab].pt three) sigma3) b) =
      pre-equiv S3 base (KK[Zab].K three) (KK[Zab].pt three) Z z0 sigma3 sigma3-star ;
  } ;
} ;

------------------------------------------------------------------------
-- Sections 6-7: the marked class s and the mapping theorem for presented targets

module Final (S3 : U l) (base : S3) (surf : O3 S3 base)
  (ump3 : (X : U l) -> isEquiv (S3 -> X) ((x : X) * O3 X x) (ev3 S3 base surf X)) {
  module SS = SourceS3[S3, base, surf, ump3] ;
  module SB = MB.SourceBR ;

  -- Definition s: s = p_*^-1 [sigma3], a class (BR = Fib Fhat is Triple3[Z, Z/2, Fhat].F)
  s : HC S3 base DR.BR DR.br0 = (SS.qS3 Zab Z2ab DR.Fhat).sec (hcl S3 base (KK[Zab].K three) (KK[Zab].pt three) SS.sigma3) ;
  s-eq : Id (HC S3 base (KK[Zab].K three) (KK[Zab].pt three)) (compC S3 base DR.BR DR.br0 (KK[Zab].K three) (KK[Zab].pt three) s (hcl DR.BR DR.br0 (KK[Zab].K three) (KK[Zab].pt three) SB.p)) (hcl S3 base (KK[Zab].K three) (KK[Zab].pt three) SS.sigma3) =
    (SS.qS3 Zab Z2ab DR.Fhat).sec-eq (hcl S3 base (KK[Zab].K three) (KK[Zab].pt three) SS.sigma3) ;

  -- Proposition right: s^* = - o [sigma3] after p^*, both bijective
  right (Ga : Ab) : isEquiv (HC DR.BR DR.br0 (KK[Ga].K three) (KK[Ga].pt three)) (HC S3 base (KK[Ga].K three) (KK[Ga].pt three)) (\ c -> compC S3 base DR.BR DR.br0 (KK[Ga].K three) (KK[Ga].pt three) s c) =
    MF.cancel-r (HC (KK[Zab].K three) (KK[Zab].pt three) (KK[Ga].K three) (KK[Ga].pt three)) (HC DR.BR DR.br0 (KK[Ga].K three) (KK[Ga].pt three)) (HC S3 base (KK[Ga].K three) (KK[Ga].pt three))
      SB.PStar[Ga].pstar (\ c -> compC S3 base DR.BR DR.br0 (KK[Ga].K three) (KK[Ga].pt three) s c) SB.PStar[Ga].equiv
      (E.homotopy (HC (KK[Zab].K three) (KK[Zab].pt three) (KK[Ga].K three) (KK[Ga].pt three)) (HC S3 base (KK[Ga].K three) (KK[Ga].pt three))
         (\ d -> compC S3 base (KK[Zab].K three) (KK[Zab].pt three) (KK[Ga].K three) (KK[Ga].pt three) (hcl S3 base (KK[Zab].K three) (KK[Zab].pt three) SS.sigma3) d,
          SS.Sig3[KK[Ga].K three, KK[Ga].pt three, KK[Ga].trunc two].sigma3-cls)
         (\ d -> compC S3 base DR.BR DR.br0 (KK[Ga].K three) (KK[Ga].pt three) s (SB.PStar[Ga].pstar d))
         (\ d -> transH (symH (comp-assoc S3 base DR.BR DR.br0 (KK[Zab].K three) (KK[Zab].pt three) (KK[Ga].K three) (KK[Ga].pt three) s (hcl DR.BR DR.br0 (KK[Zab].K three) (KK[Zab].pt three) SB.p) d))
                   (apH (\ c -> compC S3 base (KK[Zab].K three) (KK[Zab].pt three) (KK[Ga].K three) (KK[Ga].pt three) c d) s-eq))) ;

  -- Theorem main: s^* : [BR, Fib K]_* -> [S3, Fib K]_* is a bijection, every level-3 triple
  rep-fib (Ga Gb : Ab) (K : PtMap (KK[Ga].K three) (KK[Ga].pt three) (KK[Gb].K five) (KK[Gb].pt five)) :
    isEquiv (HC DR.BR DR.br0 MB.Triple3[Ga, Gb, K].F MB.Triple3[Ga, Gb, K].f0) (HC S3 base MB.Triple3[Ga, Gb, K].F MB.Triple3[Ga, Gb, K].f0) (\ c -> compC S3 base DR.BR DR.br0 MB.Triple3[Ga, Gb, K].F MB.Triple3[Ga, Gb, K].f0 s c) =
    W.cancel-equiv (HC DR.BR DR.br0 MB.Triple3[Ga, Gb, K].F MB.Triple3[Ga, Gb, K].f0) (HC S3 base MB.Triple3[Ga, Gb, K].F MB.Triple3[Ga, Gb, K].f0) (HC S3 base (KK[Ga].K three) (KK[Ga].pt three))
      (\ c -> compC S3 base DR.BR DR.br0 MB.Triple3[Ga, Gb, K].F MB.Triple3[Ga, Gb, K].f0 s c) MB.LiftG[S3, base, KK[Ga].K three, KK[Ga].pt three, KK[Gb].K five, KK[Gb].pt five, K, MB.Triple3[Ga, Gb, K].cOW, MB.Triple3[Ga, Gb, K].cOF].qs (SS.qS3 Ga Gb K)
      (E.homotopy (HC DR.BR DR.br0 MB.Triple3[Ga, Gb, K].F MB.Triple3[Ga, Gb, K].f0) (HC S3 base (KK[Ga].K three) (KK[Ga].pt three))
         (E.compose (HC DR.BR DR.br0 MB.Triple3[Ga, Gb, K].F MB.Triple3[Ga, Gb, K].f0) (HC DR.BR DR.br0 (KK[Ga].K three) (KK[Ga].pt three)) (HC S3 base (KK[Ga].K three) (KK[Ga].pt three))
            (MB.LiftG[DR.BR, DR.br0, KK[Ga].K three, KK[Ga].pt three, KK[Gb].K five, KK[Gb].pt five, K, MB.Triple3[Ga, Gb, K].cOW, MB.Triple3[Ga, Gb, K].cOF].qs, SB.qBR Ga Gb K)
            (\ c -> compC S3 base DR.BR DR.br0 (KK[Ga].K three) (KK[Ga].pt three) s c, right Ga))
         (\ c -> MB.LiftG[S3, base, KK[Ga].K three, KK[Ga].pt three, KK[Gb].K five, KK[Gb].pt five, K, MB.Triple3[Ga, Gb, K].cOW, MB.Triple3[Ga, Gb, K].cOF].qs (compC S3 base DR.BR DR.br0 MB.Triple3[Ga, Gb, K].F MB.Triple3[Ga, Gb, K].f0 s c))
         (\ c -> comp-assoc S3 base DR.BR DR.br0 MB.Triple3[Ga, Gb, K].F MB.Triple3[Ga, Gb, K].f0 (KK[Ga].K three) (KK[Ga].pt three) s c
                   (hcl MB.Triple3[Ga, Gb, K].F MB.Triple3[Ga, Gb, K].f0 (KK[Ga].K three) (KK[Ga].pt three) (Fb.fpr (KK[Ga].K three) (KK[Ga].pt three) (KK[Gb].K five) (KK[Gb].pt five) K)))) ;

  -- Corollary transfer: along a pointed equivalence Fib K ~ Y
  rep-pteq (Ga Gb : Ab) (K : PtMap (KK[Ga].K three) (KK[Ga].pt three) (KK[Gb].K five) (KK[Gb].pt five)) (X : U l) (x0 : X) (e : PtEquiv MB.Triple3[Ga, Gb, K].F MB.Triple3[Ga, Gb, K].f0 X x0) :
    isEquiv (HC DR.BR DR.br0 X x0) (HC S3 base X x0) (\ c -> compC S3 base DR.BR DR.br0 X x0 s c) =
    ptEqInd MB.Triple3[Ga, Gb, K].F MB.Triple3[Ga, Gb, K].f0
      (\ X1 x1 e1 -> isEquiv (HC DR.BR DR.br0 X1 x1) (HC S3 base X1 x1) (\ c -> compC S3 base DR.BR DR.br0 X1 x1 s c))
      (rep-fib Ga Gb K) X x0 e ;
} ;
