-- Statement T, the restricted 2-torsion lemma (doc/delooping-direct.pdf,
-- Section 2.3, Steps 1-6).  Let t = (A, B, k) be a deloopable triple, eps :
-- Omega Y ~pt Fib k the pointed equivalence of the delooping, G : K(Z,2) ->pt
-- K(A,2), f_F = e_2 ; F ; e_4^-1 for F : K(Z,2) ->pt K(B,4).  Then the cross
-- term of f' = f_{G;k} vanishes, so Unloop f' (conclusion 1); and if
-- [G ; k] = Phi_B(h), then 2 h(1) = 0 (conclusion 2).  No sphere axiom, no
-- presentation.  Informal proof:
--   cancel-inv  (F ; e^-1) ; ((e ; G) ; H) = (F ; G) ; H (associativity, e^-1 ; e = id)
--   loop2-id, loop2-sec, loop2-ret  loop^2 id = id, loop^2 e o loop^2 e^-1 = id,
--               loop^2 e^-1 o loop^2 e = id (loop2-comp, pt-inv-r / pt-inv-l)
--   Loop[t, dl] Steps 1-2, no G.  pi = eps ; (fpr ; e_2^-1) : Omega Y ->pt
--               Omega K(A,3).  Step 1: pi = loop P (Lemma 1, SourceS3.LoopEquiv
--               at c = 2, its cell: P, pi-loop), so pi is multiplicative (pi-mult:
--               LMult.lmult along pi-loop).  f_k = (e_2 ; k) ; e_4^-1.  Step 2:
--               given n : fpr ; k = 0 (merely, FibP.fseq), N n : pi ; f_k = 0
--               (associativity, cancel-inv, comp-const-l, comp-const-r).
--               pi-sec: pi (eps^-1 w) = e_2^-1 (w.1) (by definition, sec-pt).
--   TwoTors[t, dl, G]  Steps 3-6.  Step 3: G = K(a,2) (H2.k2-surj), Ghat =
--               e_2 ; G ; e_2^-1 = loop K(a,3) (ghat-loop: loopK), so Ghat is
--               multiplicative (ghat-mult); f'-eq: f' = Ghat ; f_k (the bridge
--               e_2 of Lev[Z,Z] = e_2 of Lev[Z,A], associativity, cancel-inv).
--               Step 4: tgt = loop^2 Ghat (gamma^0), xA = loop^2 e_2 (tgt); the goal
--               Theta delta_{f'} = Theta 0 lies in a set (BL.sK2), so we eliminate
--               into it n (FibP.fseq) and (w, ew) with loop^2 fpr w = xA
--               (FibP.surj2, (F1)).
--     Elim[n, w, ew]  Step 5: gamma' = loop^2 eps^-1 (w); eg: loop^2 pi
--               gamma' = tgt (loop2-comp, loop2-sec, ew, loop2-ret).  phi z =
--               lambda_{gamma'} (pi ; Delta^{f_k}_z).  phi-pi: phi (pi b) = refl
--               ((lambda0) with (Delta1) at L = pi; N; (lambda0) with (Delta0);
--               (lambda2)).  phi-refl: phi z = refl for every z ((F2)
--               FibP.const-ext along e_2, pi-sec, phi-pi).  lam-fp:
--               lambda_{gamma^0} (Delta^{f'}_q) = refl (f'-eq; (lambda0) with
--               (Delta1) at L = Ghat; (lambda1); eg; (lambda1); phi-refl).
--               h-cell: (delta_{f'} y)(x) = e_4 (Delta^{f'}_q (e_2^-1 y)), q =
--               e_2^-1 x (delta-def, parts-def, Cj by definition, tau-formula, D and
--               Delta by definition).  e-zero: (E delta)(x) = (E 0)(x)
--               ((lambda3) EDelta.e-delta, lam-fp, the pointing of loop^2 e_4,
--               ETwo.e-zero).  theta: Theta delta = Theta 0 (ThetaEq.theta-pt).
--     theta, cross, unloop   Step 6: theta after the eliminations; delta = 0
--               (theta-inj); Unloop f' (DeloopR.UnloopGen, (delta2)).
--     Two[h, eh]  conclusion 2: eBi-def and conj-bridge (f_F is Conv's CJ.conj F:
--               Lev.eB-def), conv-u (Unloop f' moved along a path kappa ; K(h,4) =
--               G ; k), two-tors (effectiveness of [G ; k] = Phi_B(h); the goal is a
--               proposition; Necessity.Conv.converse).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ; open HLevels[l] ; open Connected[l] ;
open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ; open Torsor[l] ; open LoopCalc[l] ;
open EMMaps[l] ; open AbHom[l] ; open HomotopyClasses[l] ; open SphereUniversal[l] ; open PostnikovRealization[l] ; open KZ2Cohomology[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Fb = Fibres[l] ; module CS = CupSquare[l] ; module CT = CrossTerm[l] ; module CD = CrossDeloop[l] ;
module HB = H4Bilinear[l] ; module NC = Necessity[l] ; module MF = MapFib[l] ; module S3S = SourceS3[l] ;
module DE = DeloopEmbedding[l] ; module CP = ClassPost[l] ; module PC = PostnikovClassification[l] ;
module DR = DeloopR[l] ; module ZZ = Integers[l] ;

-- (F ; e^-1) ; ((e ; G) ; H) = (F ; G) ; H
cancel-inv (A : U l) (a0 : A) (O : U l) (o0 : O) (C : U l) (c0 : C) (D : U l) (d0 : D) (E : U l) (e0 : E)
  (F : PtMap A a0 C c0) (e : PtEquiv O o0 C c0) (G : PtMap C c0 D d0) (H : PtMap D d0 E e0) :
  Id (PtMap A a0 E e0)
    (ptcomp A a0 O o0 E e0 (ptcomp A a0 C c0 O o0 F (pt-inv O o0 C c0 e).1) (ptcomp O o0 D d0 E e0 (ptcomp O o0 C c0 D d0 e.1 G) H))
    (ptcomp A a0 D d0 E e0 (ptcomp A a0 C c0 D d0 F G) H) =
  calc (PtMap A a0 E e0) {
    ptcomp A a0 O o0 E e0 (ptcomp A a0 C c0 O o0 F (pt-inv O o0 C c0 e).1) (ptcomp O o0 D d0 E e0 (ptcomp O o0 C c0 D d0 e.1 G) H)
      =< ptcomp-assoc A a0 C c0 O o0 E e0 F (pt-inv O o0 C c0 e).1 (ptcomp O o0 D d0 E e0 (ptcomp O o0 C c0 D d0 e.1 G) H) >
    ptcomp A a0 C c0 E e0 F (ptcomp C c0 O o0 E e0 (pt-inv O o0 C c0 e).1 (ptcomp O o0 D d0 E e0 (ptcomp O o0 C c0 D d0 e.1 G) H))
      =< apH (ptcomp A a0 C c0 E e0 F) (symH (ptcomp-assoc C c0 O o0 D d0 E e0 (pt-inv O o0 C c0 e).1 (ptcomp O o0 C c0 D d0 e.1 G) H)) >
    ptcomp A a0 C c0 E e0 F (ptcomp C c0 D d0 E e0 (ptcomp C c0 O o0 D d0 (pt-inv O o0 C c0 e).1 (ptcomp O o0 C c0 D d0 e.1 G)) H)
      =< apH (\ M -> ptcomp A a0 C c0 E e0 F (ptcomp C c0 D d0 E e0 M H)) (symH (ptcomp-assoc C c0 O o0 C c0 D d0 (pt-inv O o0 C c0 e).1 e.1 G)) >
    ptcomp A a0 C c0 E e0 F (ptcomp C c0 D d0 E e0 (ptcomp C c0 C c0 D d0 (ptcomp C c0 O o0 C c0 (pt-inv O o0 C c0 e).1 e.1) G) H)
      =< apH (\ M -> ptcomp A a0 C c0 E e0 F (ptcomp C c0 D d0 E e0 (ptcomp C c0 C c0 D d0 M G) H)) (pt-inv-r O o0 C c0 e) >
    ptcomp A a0 C c0 E e0 F (ptcomp C c0 D d0 E e0 (ptcomp C c0 C c0 D d0 (ptid C c0) G) H)
      =< apH (\ M -> ptcomp A a0 C c0 E e0 F (ptcomp C c0 D d0 E e0 M H)) (Fb.ptcomp-idl C c0 D d0 G) >
    ptcomp A a0 C c0 E e0 F (ptcomp C c0 D d0 E e0 G H)
      =< symH (ptcomp-assoc A a0 C c0 D d0 E e0 F G H) >
    ptcomp A a0 D d0 E e0 (ptcomp A a0 C c0 D d0 F G) H } ;

-- loop^2 of the identity, of e ; e^-1 and of e^-1 ; e
loop2-id (A : U l) (a0 : A) (z : (Id (Id A a0 a0) (refl a0) (refl a0))) : Id (Id (Id A a0 a0) (refl a0) (refl a0)) ((Maps[(Id A a0 a0), (refl a0), (Id A a0 a0), (refl a0)].loop (Maps[A, a0, A, a0].loop (ptid A a0))).1 z) z =
  transH (apH (\ H -> (Maps[(Id A a0 a0), (refl a0), (Id A a0 a0), (refl a0)].loop H).1 z) (HomotopyGroups[l].loop-ptid A a0))
    (Puppe[l].loop-id (Id A a0 a0) (refl a0) z) ;
loop2-sec (A : U l) (a0 : A) (B : U l) (b0 : B) (e : PtEquiv A a0 B b0) (z : (Id (Id B b0 b0) (refl b0) (refl b0))) :
  Id (Id (Id B b0 b0) (refl b0) (refl b0)) ((Maps[(Id A a0 a0), (refl a0), (Id B b0 b0), (refl b0)].loop (Maps[A, a0, B, b0].loop e.1)).1 ((Maps[(Id B b0 b0), (refl b0), (Id A a0 a0), (refl a0)].loop (Maps[B, b0, A, a0].loop (pt-inv A a0 B b0 e).1)).1 z)) z =
  transH (symH (CD.loop2-comp B b0 A a0 B b0 (pt-inv A a0 B b0 e).1 e.1 z))
    (transH (apH (\ H -> (Maps[(Id B b0 b0), (refl b0), (Id B b0 b0), (refl b0)].loop (Maps[B, b0, B, b0].loop H)).1 z) (pt-inv-r A a0 B b0 e)) (loop2-id B b0 z)) ;
loop2-ret (A : U l) (a0 : A) (B : U l) (b0 : B) (e : PtEquiv A a0 B b0) (z : (Id (Id A a0 a0) (refl a0) (refl a0))) :
  Id (Id (Id A a0 a0) (refl a0) (refl a0)) ((Maps[(Id B b0 b0), (refl b0), (Id A a0 a0), (refl a0)].loop (Maps[B, b0, A, a0].loop (pt-inv A a0 B b0 e).1)).1 ((Maps[(Id A a0 a0), (refl a0), (Id B b0 b0), (refl b0)].loop (Maps[A, a0, B, b0].loop e.1)).1 z)) z =
  transH (symH (CD.loop2-comp A a0 B b0 A a0 e.1 (pt-inv A a0 B b0 e).1 z))
    (transH (apH (\ H -> (Maps[(Id A a0 a0), (refl a0), (Id A a0 a0), (refl a0)].loop (Maps[A, a0, A, a0].loop H)).1 z) (pt-inv-l A a0 B b0 e)) (loop2-id A a0 z)) ;

------------------------------------------------------------------------
-- Steps 1-2: the loop map pi, for a deloopable triple

module Loop (Ga Gb : Ab) (k : PtMap (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four))
  (dl : DE.Deloopable (Ga, Gb, k)) {
  module KA = KK[Ga] ;
  module KB = KK[Gb] ;
  module LA = HB.Lev[Zab, Ga] ;
  module L2 = HB.Lev[Zab, Gb] ;
  module TR = Triple[Ga, Gb, k] ;
  module UY = DE.Acs[dl.1] ;
  -- the pointed equivalence of the delooping
  eps : PtEquiv (Id UY.Y UY.y UY.y) (refl UY.y) TR.F TR.f0 = (CP.PS.I[DE.Omega dl.1].equiv (PC.realise (Ga, Gb, k))).1 dl.2 ;
  -- only its type is used: locked
  opaque eps ;
  pi : PtMap (Id UY.Y UY.y UY.y) (refl UY.y) (Id (KA.K (suc two)) (KA.pt (suc two)) (KA.pt (suc two))) (refl (KA.pt (suc two))) = ptcomp (Id UY.Y UY.y UY.y) (refl UY.y) TR.F TR.f0 (Id (KA.K (suc two)) (KA.pt (suc two)) (KA.pt (suc two))) (refl (KA.pt (suc two))) eps.1 (ptcomp TR.F TR.f0 (KA.K two) (KA.pt two) (Id (KA.K (suc two)) (KA.pt (suc two)) (KA.pt (suc two))) (refl (KA.pt (suc two))) (Fb.fpr (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) k) (pt-inv (Id (KA.K (suc two)) (KA.pt (suc two)) (KA.pt (suc two))) (refl (KA.pt (suc two))) (KA.K two) (KA.pt two) (LA.eB two)).1) ;
  -- Step 1: pi is a loop map (Lemma 1)
  pi-cell : Maps[UY.Y, UY.y, (KA.K (suc two)), (KA.pt (suc two))].Over[pi].Unloop =
    (S3S.LoopEquiv[UY.Y, UY.y, (KA.K (suc two)), (KA.pt (suc two)), two, UY.conn, trunc-suc (suc (suc (suc two))) (KA.K (suc two)) (KA.trunc two)].cell pi).1 ;
  P : PtMap UY.Y UY.y (KA.K (suc two)) (KA.pt (suc two)) = pi-cell.1 ;
  pi-loop : Id Maps[UY.Y, UY.y, (KA.K (suc two)), (KA.pt (suc two))].PMO pi (Maps[UY.Y, UY.y, (KA.K (suc two)), (KA.pt (suc two))].loop P) = pi-cell.2 ;
  pi-mult (p q : (Id UY.Y UY.y UY.y)) : Id (Id (KA.K (suc two)) (KA.pt (suc two)) (KA.pt (suc two))) (pi.1 (trans UY.Y UY.y UY.y UY.y p q)) (trans (KA.K (suc two)) (KA.pt (suc two)) (KA.pt (suc two)) (KA.pt (suc two)) (pi.1 p) (pi.1 q)) =
    transH (apH (\ L -> L.1 (trans UY.Y UY.y UY.y UY.y p q)) pi-loop)
      (transH (CT.LMult[UY.Y, UY.y, (KA.K (suc two)), (KA.pt (suc two)), P].lmult p q)
         (apH (\ L -> trans (KA.K (suc two)) (KA.pt (suc two)) (KA.pt (suc two)) (KA.pt (suc two)) (L.1 p) (L.1 q)) (symH pi-loop))) ;
  -- f_k = e_2 ; k ; e_4^-1
  fk : Maps[(KA.K (suc two)), (KA.pt (suc two)), (KB.K (suc four)), (KB.pt (suc four))].PMO = ptcomp (Id (KA.K (suc two)) (KA.pt (suc two)) (KA.pt (suc two))) (refl (KA.pt (suc two))) (KB.K four) (KB.pt four) (Id (KB.K (suc four)) (KB.pt (suc four)) (KB.pt (suc four))) (refl (KB.pt (suc four))) (ptcomp (Id (KA.K (suc two)) (KA.pt (suc two)) (KA.pt (suc two))) (refl (KA.pt (suc two))) (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) (LA.eB two).1 k) (pt-inv (Id (KB.K (suc four)) (KB.pt (suc four)) (KB.pt (suc four))) (refl (KB.pt (suc four))) (KB.K four) (KB.pt four) (L2.eB four)).1 ;
  -- Step 2: pi ; f_k = 0, given fpr ; k = 0
  N (n : Id (PtMap TR.F TR.f0 (KB.K four) (KB.pt four)) (ptcomp TR.F TR.f0 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) (Fb.fpr (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) k) k) (ptconst TR.F TR.f0 (KB.K four) (KB.pt four))) :
    Id Maps[UY.Y, UY.y, (KB.K (suc four)), (KB.pt (suc four))].PMO (ptcomp (Id UY.Y UY.y UY.y) (refl UY.y) (Id (KA.K (suc two)) (KA.pt (suc two)) (KA.pt (suc two))) (refl (KA.pt (suc two))) (Id (KB.K (suc four)) (KB.pt (suc four)) (KB.pt (suc four))) (refl (KB.pt (suc four))) pi fk) (ptconst (Id UY.Y UY.y UY.y) (refl UY.y) (Id (KB.K (suc four)) (KB.pt (suc four)) (KB.pt (suc four))) (refl (KB.pt (suc four)))) =
    calc Maps[UY.Y, UY.y, (KB.K (suc four)), (KB.pt (suc four))].PMO {
      ptcomp (Id UY.Y UY.y UY.y) (refl UY.y) (Id (KA.K (suc two)) (KA.pt (suc two)) (KA.pt (suc two))) (refl (KA.pt (suc two))) (Id (KB.K (suc four)) (KB.pt (suc four)) (KB.pt (suc four))) (refl (KB.pt (suc four))) pi fk
        =< ptcomp-assoc (Id UY.Y UY.y UY.y) (refl UY.y) TR.F TR.f0 (Id (KA.K (suc two)) (KA.pt (suc two)) (KA.pt (suc two))) (refl (KA.pt (suc two))) (Id (KB.K (suc four)) (KB.pt (suc four)) (KB.pt (suc four))) (refl (KB.pt (suc four))) eps.1 (ptcomp TR.F TR.f0 (KA.K two) (KA.pt two) (Id (KA.K (suc two)) (KA.pt (suc two)) (KA.pt (suc two))) (refl (KA.pt (suc two))) (Fb.fpr (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) k) (pt-inv (Id (KA.K (suc two)) (KA.pt (suc two)) (KA.pt (suc two))) (refl (KA.pt (suc two))) (KA.K two) (KA.pt two) (LA.eB two)).1) fk >
      ptcomp (Id UY.Y UY.y UY.y) (refl UY.y) TR.F TR.f0 (Id (KB.K (suc four)) (KB.pt (suc four)) (KB.pt (suc four))) (refl (KB.pt (suc four))) eps.1 (ptcomp TR.F TR.f0 (Id (KA.K (suc two)) (KA.pt (suc two)) (KA.pt (suc two))) (refl (KA.pt (suc two))) (Id (KB.K (suc four)) (KB.pt (suc four)) (KB.pt (suc four))) (refl (KB.pt (suc four))) (ptcomp TR.F TR.f0 (KA.K two) (KA.pt two) (Id (KA.K (suc two)) (KA.pt (suc two)) (KA.pt (suc two))) (refl (KA.pt (suc two))) (Fb.fpr (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) k) (pt-inv (Id (KA.K (suc two)) (KA.pt (suc two)) (KA.pt (suc two))) (refl (KA.pt (suc two))) (KA.K two) (KA.pt two) (LA.eB two)).1) fk)
        =< apH (ptcomp (Id UY.Y UY.y UY.y) (refl UY.y) TR.F TR.f0 (Id (KB.K (suc four)) (KB.pt (suc four)) (KB.pt (suc four))) (refl (KB.pt (suc four))) eps.1) (cancel-inv TR.F TR.f0 (Id (KA.K (suc two)) (KA.pt (suc two)) (KA.pt (suc two))) (refl (KA.pt (suc two))) (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) (Id (KB.K (suc four)) (KB.pt (suc four)) (KB.pt (suc four))) (refl (KB.pt (suc four))) (Fb.fpr (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) k) (LA.eB two) k (pt-inv (Id (KB.K (suc four)) (KB.pt (suc four)) (KB.pt (suc four))) (refl (KB.pt (suc four))) (KB.K four) (KB.pt four) (L2.eB four)).1) >
      ptcomp (Id UY.Y UY.y UY.y) (refl UY.y) TR.F TR.f0 (Id (KB.K (suc four)) (KB.pt (suc four)) (KB.pt (suc four))) (refl (KB.pt (suc four))) eps.1 (ptcomp TR.F TR.f0 (KB.K four) (KB.pt four) (Id (KB.K (suc four)) (KB.pt (suc four)) (KB.pt (suc four))) (refl (KB.pt (suc four))) (ptcomp TR.F TR.f0 (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) (Fb.fpr (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) k) k) (pt-inv (Id (KB.K (suc four)) (KB.pt (suc four)) (KB.pt (suc four))) (refl (KB.pt (suc four))) (KB.K four) (KB.pt four) (L2.eB four)).1)
        =< apH (\ M -> ptcomp (Id UY.Y UY.y UY.y) (refl UY.y) TR.F TR.f0 (Id (KB.K (suc four)) (KB.pt (suc four)) (KB.pt (suc four))) (refl (KB.pt (suc four))) eps.1 (ptcomp TR.F TR.f0 (KB.K four) (KB.pt four) (Id (KB.K (suc four)) (KB.pt (suc four)) (KB.pt (suc four))) (refl (KB.pt (suc four))) M (pt-inv (Id (KB.K (suc four)) (KB.pt (suc four)) (KB.pt (suc four))) (refl (KB.pt (suc four))) (KB.K four) (KB.pt four) (L2.eB four)).1)) n >
      ptcomp (Id UY.Y UY.y UY.y) (refl UY.y) TR.F TR.f0 (Id (KB.K (suc four)) (KB.pt (suc four)) (KB.pt (suc four))) (refl (KB.pt (suc four))) eps.1 (ptcomp TR.F TR.f0 (KB.K four) (KB.pt four) (Id (KB.K (suc four)) (KB.pt (suc four)) (KB.pt (suc four))) (refl (KB.pt (suc four))) (ptconst TR.F TR.f0 (KB.K four) (KB.pt four)) (pt-inv (Id (KB.K (suc four)) (KB.pt (suc four)) (KB.pt (suc four))) (refl (KB.pt (suc four))) (KB.K four) (KB.pt four) (L2.eB four)).1)
        =< apH (ptcomp (Id UY.Y UY.y UY.y) (refl UY.y) TR.F TR.f0 (Id (KB.K (suc four)) (KB.pt (suc four)) (KB.pt (suc four))) (refl (KB.pt (suc four))) eps.1) (comp-const-l TR.F TR.f0 (KB.K four) (KB.pt four) (Id (KB.K (suc four)) (KB.pt (suc four)) (KB.pt (suc four))) (refl (KB.pt (suc four))) (pt-inv (Id (KB.K (suc four)) (KB.pt (suc four)) (KB.pt (suc four))) (refl (KB.pt (suc four))) (KB.K four) (KB.pt four) (L2.eB four)).1) >
      ptcomp (Id UY.Y UY.y UY.y) (refl UY.y) TR.F TR.f0 (Id (KB.K (suc four)) (KB.pt (suc four)) (KB.pt (suc four))) (refl (KB.pt (suc four))) eps.1 (ptconst TR.F TR.f0 (Id (KB.K (suc four)) (KB.pt (suc four)) (KB.pt (suc four))) (refl (KB.pt (suc four))))
        =< comp-const-r (Id UY.Y UY.y UY.y) (refl UY.y) TR.F TR.f0 (Id (KB.K (suc four)) (KB.pt (suc four)) (KB.pt (suc four))) (refl (KB.pt (suc four))) eps.1 >
      ptconst (Id UY.Y UY.y UY.y) (refl UY.y) (Id (KB.K (suc four)) (KB.pt (suc four)) (KB.pt (suc four))) (refl (KB.pt (suc four))) } ;
  -- pi at eps^-1 w is e_2^-1 (w.1)
  pi-sec (v : TR.F) : Id (Id (KA.K (suc two)) (KA.pt (suc two)) (KA.pt (suc two))) (pi.1 ((pt-inv (Id UY.Y UY.y UY.y) (refl UY.y) TR.F TR.f0 eps).1.1 v)) ((pt-inv (Id (KA.K (suc two)) (KA.pt (suc two)) (KA.pt (suc two))) (refl (KA.pt (suc two))) (KA.K two) (KA.pt two) (LA.eB two)).1.1 v.1) =
    calc (Id (KA.K (suc two)) (KA.pt (suc two)) (KA.pt (suc two))) {
      pi.1 ((pt-inv (Id UY.Y UY.y UY.y) (refl UY.y) TR.F TR.f0 eps).1.1 v)
