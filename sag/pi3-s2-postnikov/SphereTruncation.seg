-- The 3-truncation of S^2: an inhabitant of SphereUniversal.Interfaces.Trunc3
-- (doc/finite-truncation.pdf, §5), from the sphere axiom and the
-- truncations TO (Truncations), with no other assumption.
--   ev-base-equiv  (a) into a 1-type Y, evaluation at base is an equivalence:
--                  ev2 followed by the first projection, whose fibres
--                  Omega^2 (Y, y) are contractible
--   V-contr        (b) V = T_3 S2 is contractible: id and const |base| agree
--                  after |-|^*, since |-| and const |base| agree at base
--   s2-conn        (c) Lemma 14: S2 is simply connected, as the fibre of |-|
--                  over |base| (a Sigma of contractible types)
--   trunc3         Theorem 15: T = T_5 S2 with eta = (|-|, refl)
-- (b), (c) are proved for any truncation structure T3 at level 3 (Simply)
-- and Theorem 15 for any T5 at level 5 (Theorem15), given (c); trunc3
-- instantiates them at the truncations TO two and TO four.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ; open HLevels[l] ; open Connected[l] ;
open Lemma4[l] ; open DeloopMaps[l] ; open LoopCalc[l] ;
open ConnectedMaps[l] ; open Truncations[l] ; open TruncationProps[l] ; open SphereAxiom[l] ; open SphereUniversal[l] ; open PostnikovRealization[l] ;
module W = Whitehead[l] ; module E = Equivalences[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;

-- the first projection of a Sigma with contractible fibres is an equivalence
fst-equiv (Y : U l) (P : Y -> U l) (cP : (y : Y) -> isContr (P y)) : isEquiv ((y : Y) * P y) Y (\ w -> w.1) =
  qinv ((y : Y) * P y) Y (\ w -> w.1) (\ y -> (y, (cP y).1)) (\ y -> refl y)
    (\ w -> ap (P w.1) ((y : Y) * P y) (\ u -> (w.1, u)) (cP w.1).1 w.2 ((cP w.1).2 w.2)) ;

-- the 2-loops of a 1-type are contractible
o2-contr (Y : U l) (tY : isTrunc three Y) (y : Y) : isContr (O2 Y y) =
  (refl (refl y), \ a -> trunc-one-prop (O2 Y y) (tY y y (refl y) (refl y)) (refl (refl y)) a) ;

module SphereTrunc (S2 : U l) (base : S2) (surf : O2 S2 base)
  (ump : (X : U l) -> isEquiv (S2 -> X) ((x : X) * O2 X x) (ev2 S2 base surf X)) {

  -- (a)
  ev-base-equiv (Y : U l) (tY : isTrunc three Y) : isEquiv (S2 -> Y) Y (\ g -> g base) =
    (E.compose (S2 -> Y) ((y : Y) * O2 Y y) Y (ev2 S2 base surf Y, ump Y) (\ w -> w.1, fst-equiv Y (\ y -> O2 Y y) (o2-contr Y tY))).2 ;

  -- (b), (c)
  module Simply (T3 : TruncOp[three]) {
    module EV = Elim[three, S2, T3.T S2, T3.unit S2, T3.conn S2, \ z -> T3.T S2, \ z -> T3.trunc S2] ;
    -- |-| and const |base| agree, since they agree at base
    unit-const : Id (S2 -> T3.T S2) (T3.unit S2) (\ s -> T3.unit S2 base) =
      E.injective (S2 -> T3.T S2) (T3.T S2) (\ g -> g base) (ev-base-equiv (T3.T S2) (T3.trunc S2))
        (T3.unit S2) (\ s -> T3.unit S2 base) (refl (T3.unit S2 base)) ;
    -- hence id and const |base| agree after |-|^*
    id-const : Id (T3.T S2 -> T3.T S2) (\ z -> z) (\ z -> T3.unit S2 base) =
      EV.unique (\ z -> z) (\ z -> T3.unit S2 base) (happly S2 (\ s -> T3.T S2) (T3.unit S2) (\ s -> T3.unit S2 base) unit-const) ;
    V-contr : isContr (T3.T S2) =
      (T3.unit S2 base, \ z -> sym (T3.T S2) z (T3.unit S2 base) (happly (T3.T S2) (\ z1 -> T3.T S2) (\ z1 -> z1) (\ z1 -> T3.unit S2 base) id-const z)) ;
    -- (c) Lemma 14: S2 is the fibre of |-| over |base|
    to-fib (s : S2) : W.fib S2 (T3.T S2) (T3.unit S2) (T3.unit S2 base) = (s, contr-prop (T3.T S2) V-contr (T3.unit S2 s) (T3.unit S2 base)) ;
    fib-equiv : Equiv S2 (W.fib S2 (T3.T S2) (T3.unit S2) (T3.unit S2 base)) =
      (to-fib, qinv S2 (W.fib S2 (T3.T S2) (T3.unit S2) (T3.unit S2 base)) to-fib (\ w -> w.1)
         (\ w -> Sigma-eq S2 (\ s -> Id (T3.T S2) (T3.unit S2 s) (T3.unit S2 base)) w.1 w.1 (to-fib w.1).2 w.2 (refl w.1)
                   (contr-prop (Id (T3.T S2) (T3.unit S2 w.1) (T3.unit S2 base)) (contr-paths (T3.T S2) V-contr (T3.unit S2 w.1) (T3.unit S2 base))))
         (\ s -> refl s)) ;
    s2-conn : isConn three S2 = Deloop[l].equiv-conn three S2 (W.fib S2 (T3.T S2) (T3.unit S2) (T3.unit S2 base)) fib-equiv (T3.conn S2 (T3.unit S2 base)) ;
  } ;

  -- Theorem 15
  module Theorem15 (T5 : TruncOp[five]) (s2-conn : isConn three S2) {
    module UP = PtUP[five, T5, S2, base] ;
    connT : isConn three (T5.T S2) =
      conn-up three S2 (T5.T S2) (T5.unit S2)
        (\ z -> conn-down three (W.fib S2 (T5.T S2) (T5.unit S2) z) (conn-down four (W.fib S2 (T5.T S2) (T5.unit S2) z) (T5.conn S2 z))) s2-conn ;
    -- the loopings of eta: fibres isConn 4, 3, 2
    c4 (v : Id (T5.T S2) (T5.unit S2 base) (T5.unit S2 base)) :
      isConn four (W.fib (Id S2 base base) (Id (T5.T S2) (T5.unit S2 base) (T5.unit S2 base)) (Maps[S2, base, T5.T S2, T5.unit S2 base].loop UP.eta).1 v) =
      loop-conn four S2 base (T5.T S2) (T5.unit S2) (T5.conn S2) (T5.unit S2 base) (refl (T5.unit S2 base)) v ;
    c3 (v : O2 (T5.T S2) (T5.unit S2 base)) :
      isConn three (W.fib (O2 S2 base) (O2 (T5.T S2) (T5.unit S2 base)) (loop2 S2 base (T5.T S2) (T5.unit S2 base) UP.eta).1 v) =
      loop-conn three (Id S2 base base) (refl base) (Id (T5.T S2) (T5.unit S2 base) (T5.unit S2 base)) (Maps[S2, base, T5.T S2, T5.unit S2 base].loop UP.eta).1 c4
        (refl (T5.unit S2 base)) (Maps[S2, base, T5.T S2, T5.unit S2 base].loop UP.eta).2 v ;
    c2 (v : Id (O2 (T5.T S2) (T5.unit S2 base)) (refl (refl (T5.unit S2 base))) (refl (refl (T5.unit S2 base)))) :
      isConn two (W.fib (Id (O2 S2 base) (refl (refl base)) (refl (refl base))) (Id (O2 (T5.T S2) (T5.unit S2 base)) (refl (refl (T5.unit S2 base))) (refl (refl (T5.unit S2 base))))
        (Maps[O2 S2 base, refl (refl base), O2 (T5.T S2) (T5.unit S2 base), refl (refl (T5.unit S2 base))].loop (loop2 S2 base (T5.T S2) (T5.unit S2 base) UP.eta)).1 v) =
      loop-conn two (O2 S2 base) (refl (refl base)) (O2 (T5.T S2) (T5.unit S2 base)) (loop2 S2 base (T5.T S2) (T5.unit S2 base) UP.eta).1 c3
        (refl (refl (T5.unit S2 base))) (loop2 S2 base (T5.T S2) (T5.unit S2 base) UP.eta).2 v ;
    trunc3 : Interfaces[S2, base].Trunc3 =
      new Interfaces[S2, base].Trunc3[T5.T S2, T5.unit S2 base, UP.eta, T5.trunc S2, connT, \ Y y0 tY -> UP.up Y y0 tY,
        ConnPi1[O2 S2 base, refl (refl base), O2 (T5.T S2) (T5.unit S2 base), refl (refl (T5.unit S2 base)), loop2 S2 base (T5.T S2) (T5.unit S2 base) UP.eta, c2].equiv] ;
  } ;

  trunc3 : Interfaces[S2, base].Trunc3 = Theorem15[TO four, Simply[TO two].s2-conn].trunc3 ;
} ;
