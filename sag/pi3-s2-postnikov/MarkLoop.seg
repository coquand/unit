-- The looped form of statement M (doc/delooping-direct.pdf, Section 1).
-- Informal proof.  Let s : [S3, BR]_* be the class of SourceS3.Final, e =
-- DeloopR.omega-BR : Omega BR ~pt R and r = (loop s) ; [e] : [Omega S3, R]_*.
--   LoopCls     Lemma 1 on classes: for X isConn 4 and Y isTrunc 6, looping
--               [X, Y]_* -> [Omega X, Omega Y]_* is a bijection: it is the map
--               of set truncations of looping on pointed maps (loopC-beta,
--               STrMap.beta; loopC-map), an equivalence (SourceS3.LoopEquiv at
--               c = 2), and classes-equiv
--   LMark.r     Definition: r = loopC s ; [e]
--   At[u]       for u = (Y, y, ..) : SC4, with the four maps
--                 sst c = s ; c        [BR, Y]_*         -> [S3, Y]_*
--                 ls c  = loopC s ; c  [Omega BR, OY]_*  -> [Omega S3, OY]_*
--                 es c  = [e] ; c      [R, OY]_*         -> [Omega BR, OY]_*
--                 rs c  = r ; c        [R, OY]_*         -> [Omega S3, OY]_*
--               (OY = Omega Y):
--     sq        loopC (s ; c) = ls (loopC c)              (loopC-comp)
--     tri       rs c = ls (es c)                          (comp-assoc)
--     e-star    es is a bijection (pre-pteq, pre-equiv)
--     to-ls, from-ls   sst bijective iff ls bijective: the two loopC are
--               bijections (LoopCls at BR: BR-conn; at S3: s3-conn), sq, 2-out-of-3
--               (MapFib.cancel-r, Whitehead.cancel-equiv)
--     ls-to-r, r-to-ls  rs bijective iff ls bijective: tri, e-star, 2-out-of-3
--     to-loop, from-loop   Proposition L: Marked u iff LMarked u (rs bijective)
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open HLevels[l] ; open Connected[l] ; open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ;
open HomotopyClasses[l] ; open Sphere3Axiom[l] ; open Truncations[l] ; open SphereUniversal[l] ; open PostnikovRealization[l] ;
module E = Equivalences[l] ; module W = Whitehead[l] ; module MF = MapFib[l] ;
module S3S = SourceS3[l] ; module S3T = Sphere3Trunc[l] ; module DR = DeloopR[l] ; module DE = DeloopEmbedding[l] ;

------------------------------------------------------------------------
-- Lemma 1 on classes

module LoopCls (X : U l) (x0 : X) (Y : U l) (y0 : Y) (cX : isConn four X) (tY : isTrunc (suc five) Y) {
  module LE = S3S.LoopEquiv[X, x0, Y, y0, two, cX, tY] ;
  module SM = STrMap[PtMap X x0 Y y0, PtMap (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0), LE.M.loop] ;
  -- loopC is the map of set truncations of loop
  loopC-map (a : HC X x0 Y y0) : Id (HC (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0)) (S3T.loopC X x0 Y y0 a) (SM.map a) =
    STr[PtMap X x0 Y y0].ext (HC (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0)) (hc-set (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0))
      (S3T.loopC X x0 Y y0) SM.map (\ F -> transH (S3T.loopC-beta X x0 Y y0 F) (symH (SM.beta F))) a ;
  equiv : isEquiv (HC X x0 Y y0) (HC (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0)) (S3T.loopC X x0 Y y0) =
    E.homotopy (HC X x0 Y y0) (HC (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0))
      (SM.map, classes-equiv (PtMap X x0 Y y0) (PtMap (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0)) LE.M.loop LE.equiv) (S3T.loopC X x0 Y y0) loopC-map ;
} ;

------------------------------------------------------------------------
-- Proposition L: statement M and its looped form

module LMark (S3 : U l) (base : S3) (surf : O3 S3 base)
  (ump3 : (X : U l) -> isEquiv (S3 -> X) ((x : X) * O3 X x) (ev3 S3 base surf X)) {
  module FS = S3S.Final[S3, base, surf, ump3] ;
  module MK = DE.Mark[S3, base, surf, ump3] ;
  s3-conn : isConn four S3 = S3T.Sphere3Trunc[S3, base, surf, ump3].Simply[TO three].s3-conn ;
  -- Definition: r = loop s ; [e]
  r : HC (Id S3 base base) (refl base) DR.TR.F DR.TR.f0 =
    compC (Id S3 base base) (refl base) (Id DR.BR DR.br0 DR.br0) (refl DR.br0) DR.TR.F DR.TR.f0
      (S3T.loopC S3 base DR.BR DR.br0 FS.s) (hcl (Id DR.BR DR.br0 DR.br0) (refl DR.br0) DR.TR.F DR.TR.f0 DR.omega-BR.1) ;

  module At (u : DE.SC4) {
    module A = DE.Acs[u] ;
    module LB = LoopCls[DR.BR, DR.br0, A.Y, A.y, DR.BR-conn, A.trunc] ;
    module LS = LoopCls[S3, base, A.Y, A.y, s3-conn, A.trunc] ;
    -- the four maps
    sst (c : HC DR.BR DR.br0 A.Y A.y) : HC S3 base A.Y A.y = compC S3 base DR.BR DR.br0 A.Y A.y FS.s c ;
    ls (c : HC (Id DR.BR DR.br0 DR.br0) (refl DR.br0) (Id A.Y A.y A.y) (refl A.y)) : HC (Id S3 base base) (refl base) (Id A.Y A.y A.y) (refl A.y) =
      compC (Id S3 base base) (refl base) (Id DR.BR DR.br0 DR.br0) (refl DR.br0) (Id A.Y A.y A.y) (refl A.y) (S3T.loopC S3 base DR.BR DR.br0 FS.s) c ;
    es (c : HC DR.TR.F DR.TR.f0 (Id A.Y A.y A.y) (refl A.y)) : HC (Id DR.BR DR.br0 DR.br0) (refl DR.br0) (Id A.Y A.y A.y) (refl A.y) =
      compC (Id DR.BR DR.br0 DR.br0) (refl DR.br0) DR.TR.F DR.TR.f0 (Id A.Y A.y A.y) (refl A.y)
        (hcl (Id DR.BR DR.br0 DR.br0) (refl DR.br0) DR.TR.F DR.TR.f0 DR.omega-BR.1) c ;
    rs (c : HC DR.TR.F DR.TR.f0 (Id A.Y A.y A.y) (refl A.y)) : HC (Id S3 base base) (refl base) (Id A.Y A.y A.y) (refl A.y) =
      compC (Id S3 base base) (refl base) DR.TR.F DR.TR.f0 (Id A.Y A.y A.y) (refl A.y) r c ;
    LMarked : U l = isEquiv (HC DR.TR.F DR.TR.f0 (Id A.Y A.y A.y) (refl A.y)) (HC (Id S3 base base) (refl base) (Id A.Y A.y A.y) (refl A.y)) rs ;

    -- looping commutes with s^*
    sq (c : HC DR.BR DR.br0 A.Y A.y) :
      Id (HC (Id S3 base base) (refl base) (Id A.Y A.y A.y) (refl A.y)) (S3T.loopC S3 base A.Y A.y (sst c)) (ls (S3T.loopC DR.BR DR.br0 A.Y A.y c)) =
      S3T.loopC-comp S3 base DR.BR DR.br0 A.Y A.y FS.s c ;
    -- r^* is (loop s)^* after [e]^*
    tri (c : HC DR.TR.F DR.TR.f0 (Id A.Y A.y A.y) (refl A.y)) :
      Id (HC (Id S3 base base) (refl base) (Id A.Y A.y A.y) (refl A.y)) (rs c) (ls (es c)) =
      comp-assoc (Id S3 base base) (refl base) (Id DR.BR DR.br0 DR.br0) (refl DR.br0) DR.TR.F DR.TR.f0 (Id A.Y A.y A.y) (refl A.y)
        (S3T.loopC S3 base DR.BR DR.br0 FS.s) (hcl (Id DR.BR DR.br0 DR.br0) (refl DR.br0) DR.TR.F DR.TR.f0 DR.omega-BR.1) c ;
    -- [e]^* is a bijection
    e-star : isEquiv (HC DR.TR.F DR.TR.f0 (Id A.Y A.y A.y) (refl A.y)) (HC (Id DR.BR DR.br0 DR.br0) (refl DR.br0) (Id A.Y A.y A.y) (refl A.y)) es =
      pre-equiv (Id DR.BR DR.br0 DR.br0) (refl DR.br0) DR.TR.F DR.TR.f0 (Id A.Y A.y A.y) (refl A.y) DR.omega-BR.1
        (MF.pre-pteq (Id DR.BR DR.br0 DR.br0) (refl DR.br0) (Id A.Y A.y A.y) (refl A.y) DR.TR.F DR.TR.f0 DR.omega-BR) ;

    -- (a) M iff (loop s)^* bijective
    to-ls (m : MK.Marked u) :
      isEquiv (HC (Id DR.BR DR.br0 DR.br0) (refl DR.br0) (Id A.Y A.y A.y) (refl A.y)) (HC (Id S3 base base) (refl base) (Id A.Y A.y A.y) (refl A.y)) ls =
      MF.cancel-r (HC DR.BR DR.br0 A.Y A.y) (HC (Id DR.BR DR.br0 DR.br0) (refl DR.br0) (Id A.Y A.y A.y) (refl A.y)) (HC (Id S3 base base) (refl base) (Id A.Y A.y A.y) (refl A.y))
        (S3T.loopC DR.BR DR.br0 A.Y A.y) ls LB.equiv
        (E.homotopy (HC DR.BR DR.br0 A.Y A.y) (HC (Id S3 base base) (refl base) (Id A.Y A.y A.y) (refl A.y))
           (E.compose (HC DR.BR DR.br0 A.Y A.y) (HC S3 base A.Y A.y) (HC (Id S3 base base) (refl base) (Id A.Y A.y A.y) (refl A.y))
              (sst, m) (S3T.loopC S3 base A.Y A.y, LS.equiv))
           (\ c -> ls (S3T.loopC DR.BR DR.br0 A.Y A.y c)) (\ c -> symH (sq c))) ;
    from-ls (m : isEquiv (HC (Id DR.BR DR.br0 DR.br0) (refl DR.br0) (Id A.Y A.y A.y) (refl A.y)) (HC (Id S3 base base) (refl base) (Id A.Y A.y A.y) (refl A.y)) ls) :
      MK.Marked u =
      W.cancel-equiv (HC DR.BR DR.br0 A.Y A.y) (HC S3 base A.Y A.y) (HC (Id S3 base base) (refl base) (Id A.Y A.y A.y) (refl A.y))
        sst (S3T.loopC S3 base A.Y A.y) LS.equiv
        (E.homotopy (HC DR.BR DR.br0 A.Y A.y) (HC (Id S3 base base) (refl base) (Id A.Y A.y A.y) (refl A.y))
           (E.compose (HC DR.BR DR.br0 A.Y A.y) (HC (Id DR.BR DR.br0 DR.br0) (refl DR.br0) (Id A.Y A.y A.y) (refl A.y)) (HC (Id S3 base base) (refl base) (Id A.Y A.y A.y) (refl A.y))
              (S3T.loopC DR.BR DR.br0 A.Y A.y, LB.equiv) (ls, m))
           (\ c -> S3T.loopC S3 base A.Y A.y (sst c)) sq) ;

    -- (b) r^* bijective iff (loop s)^* bijective
    ls-to-r (m : isEquiv (HC (Id DR.BR DR.br0 DR.br0) (refl DR.br0) (Id A.Y A.y A.y) (refl A.y)) (HC (Id S3 base base) (refl base) (Id A.Y A.y A.y) (refl A.y)) ls) :
      LMarked =
      E.homotopy (HC DR.TR.F DR.TR.f0 (Id A.Y A.y A.y) (refl A.y)) (HC (Id S3 base base) (refl base) (Id A.Y A.y A.y) (refl A.y))
        (E.compose (HC DR.TR.F DR.TR.f0 (Id A.Y A.y A.y) (refl A.y)) (HC (Id DR.BR DR.br0 DR.br0) (refl DR.br0) (Id A.Y A.y A.y) (refl A.y)) (HC (Id S3 base base) (refl base) (Id A.Y A.y A.y) (refl A.y))
           (es, e-star) (ls, m))
        rs tri ;
    r-to-ls (m : LMarked) :
      isEquiv (HC (Id DR.BR DR.br0 DR.br0) (refl DR.br0) (Id A.Y A.y A.y) (refl A.y)) (HC (Id S3 base base) (refl base) (Id A.Y A.y A.y) (refl A.y)) ls =
      MF.cancel-r (HC DR.TR.F DR.TR.f0 (Id A.Y A.y A.y) (refl A.y)) (HC (Id DR.BR DR.br0 DR.br0) (refl DR.br0) (Id A.Y A.y A.y) (refl A.y)) (HC (Id S3 base base) (refl base) (Id A.Y A.y A.y) (refl A.y))
        es ls e-star
        (E.homotopy (HC DR.TR.F DR.TR.f0 (Id A.Y A.y A.y) (refl A.y)) (HC (Id S3 base base) (refl base) (Id A.Y A.y A.y) (refl A.y))
           (rs, m) (\ c -> ls (es c)) (\ c -> symH (tri c))) ;

    -- Proposition L
    to-loop (m : MK.Marked u) : LMarked = ls-to-r (to-ls m) ;
    from-loop (m : LMarked) : MK.Marked u = from-ls (r-to-ls m) ;
  } ;
} ;
