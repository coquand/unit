-- R = Fib kbar deloops (doc/cross-term.pdf, Section 6).  X = K(Z,3), W = K(Z/2,5),
-- f = e_2 ; kbar ; e_4^-1 (CrossTerm.Cross, e_2 and e_4 the locked Lev ones).
--   UnloopGen     Theorem 16, for any B and f with delta_f = 0 (CrossGen):
--   unloop-contr  Unloop f is contractible.  Levels[c = 2, t = 1]
--                 (X is isConn 4, W is isTrunc 7 = 3 + (3 + 1)): every (b : W) * C a b
--                 is a proposition (cell) and Unloop f is one (cor10); at a = x0,
--                 (w0, |f|, CrossGen.cell-of) inhabits it, so every cell is
--                 inhabited (conn-elim 2), giving rel : Rel, and lemma9.r rel.
--                 No pointing in p is used.  unloop-contr: the instance at
--                 (Z/2, Cross.f, Cross.cross).
--   Fhat, gamma   Definition 17: the centre, Fhat : K(Z,3) ->pt K(Z/2,5) and
--                 gamma : f = loop Fhat; BR = Fib Fhat, pointed by fpt; Fhat is
--                 locked after gamma (MapBR.fseq otherwise unfolded unloop-contr)
--   omega-BR      Theorem 18 (i): Omega BR ~pt R = Fib kbar: omega-fib, fib-path
--                 along gamma^-1, fib-equiv along e_2, e_4 (sq-f: f ; e_4 = e_2 ; kbar)
--   BR-trunc, BR-conn  Theorem 18 (ii): BR is isTrunc 6 (trunc-Sigma, trunc-suc) and
--                 isConn 4 (FibConn with surj-triv, then conn-from-point 2 with
--                 Omega BR ~ R isConn 3)
--   mu, tor       Corollary 19: mu r = phi ; (phi r . -) ; phi^-1 (phi = omega-BR^-1,
--                 pointed by the sec-eq of omega-BR), a homogeneous structure on R;
--                 the torsor homog mu (Deloop.Torsors), so PT is contractible
--                 (cor8, c = 1) and Tor_R deloops R (theorem2, tor-conn, tor-trunc).
-- The S^3 axiom is not used; BR settles the existence of the candidate
-- delooping, not its universal property (step 3, handoff 9).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ; open HLevels[l] ; open Connected[l] ;
open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ; open Torsor[l] ; open LoopCalc[l] ;
open EMMaps[l] ; open SphereUniversal[l] ; open PostnikovRealization[l] ; open KZ2Cohomology[l] ;
open Z2[l] ; open CrossTerm[l] ;
module Tr = Truncation[l] ;
module Fb = Fibres[l] ;
module A = KK[Zab] ;
module B = KK[Z2ab] ;
module MX = Maps[(A.K (suc two)), (A.pt (suc two)), (B.K (suc four)), (B.pt (suc four))] ;
module O = MX.Over[Cross.f] ;
module TR = PostnikovRealization[l].Triple[Zab, Z2ab, kbar] ;

-- Theorem 16, for any coefficient group B and f with delta_f = 0 (the cells
-- argument; doc/delooping-direct.pdf, (delta2))
module UnloopGen (Gb : Ab) (f : Maps[KK[Zab].K (suc two), KK[Zab].pt (suc two), KK[Gb].K (suc four), KK[Gb].pt (suc four)].PMO)
  (cross : Id (PtMap KZ2 kz2 (PtMap KZ2 kz2 (KK[Gb].K four) (KK[Gb].pt four)) (ptconst KZ2 kz2 (KK[Gb].K four) (KK[Gb].pt four)))
             CrossGen[Gb, f].delta (ptconst KZ2 kz2 (PtMap KZ2 kz2 (KK[Gb].K four) (KK[Gb].pt four)) (ptconst KZ2 kz2 (KK[Gb].K four) (KK[Gb].pt four)))) {
  module BG = KK[Gb] ;
  module MG = Maps[(A.K (suc two)), (A.pt (suc two)), (BG.K (suc four)), (BG.pt (suc four))] ;
  module OG = MG.Over[f] ;
  module LV = OG.Levels[two, suc zero, A.conn two, BG.trunc four] ;
  cell0 : (b : (BG.K (suc four))) * OG.C (A.pt (suc two)) b = ((BG.pt (suc four)), (f.1, CrossGen[Gb, f].cell-of cross)) ;
  rel : OG.Rel = \ a -> conn-elim two (A.K (suc two)) (A.pt (suc two)) (A.conn two) (\ a1 -> (b : (BG.K (suc four))) * OG.C a1 b)
    (\ a1 -> trunc-one-prop ((b : (BG.K (suc four))) * OG.C a1 b) (LV.cell a1)) cell0 a ;
  unloop-contr : isContr OG.Unloop = (OG.lemma9.r rel, \ v -> trunc-one-prop OG.Unloop LV.cor10 (OG.lemma9.r rel) v) ;
} ;

-- Theorem 16
unloop-contr : isContr O.Unloop = UnloopGen[Z2ab, Cross.f, Cross.cross].unloop-contr ;

-- Definition 17
Fhat : PtMap (A.K (suc two)) (A.pt (suc two)) (B.K (suc four)) (B.pt (suc four)) = unloop-contr.1.1 ;
gamma : Id MX.PMO Cross.f (MX.loop Fhat) = unloop-contr.1.2 ;
-- only used through gamma: locked
opaque Fhat ;
BR : U l = Fb.Fib (A.K (suc two)) (A.pt (suc two)) (B.K (suc four)) (B.pt (suc four)) Fhat ;
br0 : BR = Fb.fpt (A.K (suc two)) (A.pt (suc two)) (B.K (suc four)) (B.pt (suc four)) Fhat ;

-- Theorem 18 (i)
sq-f : Id (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K four) (B.pt four)) (ptcomp (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (Id (B.K (suc four)) (B.pt (suc four)) (B.pt (suc four))) (refl (B.pt (suc four))) (B.K four) (B.pt four) Cross.f (Cross.L2.eB four).1) (ptcomp (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) KZ2 kz2 (B.K four) (B.pt four) (Cross.L.eB two).1 kbar) =
  calc (PtMap (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K four) (B.pt four)) {
    ptcomp (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (Id (B.K (suc four)) (B.pt (suc four)) (B.pt (suc four))) (refl (B.pt (suc four))) (B.K four) (B.pt four) Cross.f (Cross.L2.eB four).1
      =< refl (ptcomp (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (Id (B.K (suc four)) (B.pt (suc four)) (B.pt (suc four))) (refl (B.pt (suc four))) (B.K four) (B.pt four) Cross.f (Cross.L2.eB four).1) >
    ptcomp (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (Id (B.K (suc four)) (B.pt (suc four)) (B.pt (suc four))) (refl (B.pt (suc four))) (B.K four) (B.pt four) (ptcomp (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K four) (B.pt four) (Id (B.K (suc four)) (B.pt (suc four)) (B.pt (suc four))) (refl (B.pt (suc four))) (ptcomp (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) KZ2 kz2 (B.K four) (B.pt four) (Cross.L.eB two).1 kbar) (pt-inv (Id (B.K (suc four)) (B.pt (suc four)) (B.pt (suc four))) (refl (B.pt (suc four))) (B.K four) (B.pt four) (Cross.L2.eB four)).1) (Cross.L2.eB four).1
      =< ptcomp-assoc (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K four) (B.pt four) (Id (B.K (suc four)) (B.pt (suc four)) (B.pt (suc four))) (refl (B.pt (suc four))) (B.K four) (B.pt four) (ptcomp (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) KZ2 kz2 (B.K four) (B.pt four) (Cross.L.eB two).1 kbar) (pt-inv (Id (B.K (suc four)) (B.pt (suc four)) (B.pt (suc four))) (refl (B.pt (suc four))) (B.K four) (B.pt four) (Cross.L2.eB four)).1 (Cross.L2.eB four).1 >
    ptcomp (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K four) (B.pt four) (B.K four) (B.pt four) (ptcomp (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) KZ2 kz2 (B.K four) (B.pt four) (Cross.L.eB two).1 kbar) (ptcomp (B.K four) (B.pt four) (Id (B.K (suc four)) (B.pt (suc four)) (B.pt (suc four))) (refl (B.pt (suc four))) (B.K four) (B.pt four) (pt-inv (Id (B.K (suc four)) (B.pt (suc four)) (B.pt (suc four))) (refl (B.pt (suc four))) (B.K four) (B.pt four) (Cross.L2.eB four)).1 (Cross.L2.eB four).1)
      =< apH (ptcomp (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K four) (B.pt four) (B.K four) (B.pt four) (ptcomp (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) KZ2 kz2 (B.K four) (B.pt four) (Cross.L.eB two).1 kbar)) (pt-inv-r (Id (B.K (suc four)) (B.pt (suc four)) (B.pt (suc four))) (refl (B.pt (suc four))) (B.K four) (B.pt four) (Cross.L2.eB four)) >
    ptcomp (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K four) (B.pt four) (B.K four) (B.pt four) (ptcomp (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) KZ2 kz2 (B.K four) (B.pt four) (Cross.L.eB two).1 kbar) (ptid (B.K four) (B.pt four))
      =< Fb.ptcomp-idr (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (B.K four) (B.pt four) (ptcomp (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) KZ2 kz2 (B.K four) (B.pt four) (Cross.L.eB two).1 kbar) >
    (ptcomp (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) KZ2 kz2 (B.K four) (B.pt four) (Cross.L.eB two).1 kbar) } ;
omega-BR : PtEquiv (Id BR br0 br0) (refl br0) TR.F TR.f0 =
  pt-comp (Id BR br0 br0) (refl br0) (Fb.Fib (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (Id (B.K (suc four)) (B.pt (suc four)) (B.pt (suc four))) (refl (B.pt (suc four))) (MX.loop Fhat)) (Fb.fpt (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (Id (B.K (suc four)) (B.pt (suc four)) (B.pt (suc four))) (refl (B.pt (suc four))) (MX.loop Fhat)) TR.F TR.f0 (Fb.omega-fib (A.K (suc two)) (A.pt (suc two)) (B.K (suc four)) (B.pt (suc four)) Fhat).1
    (pt-comp (Fb.Fib (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (Id (B.K (suc four)) (B.pt (suc four)) (B.pt (suc four))) (refl (B.pt (suc four))) (MX.loop Fhat)) (Fb.fpt (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (Id (B.K (suc four)) (B.pt (suc four)) (B.pt (suc four))) (refl (B.pt (suc four))) (MX.loop Fhat)) (Fb.Fib (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (Id (B.K (suc four)) (B.pt (suc four)) (B.pt (suc four))) (refl (B.pt (suc four))) Cross.f) (Fb.fpt (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (Id (B.K (suc four)) (B.pt (suc four)) (B.pt (suc four))) (refl (B.pt (suc four))) Cross.f) TR.F TR.f0
       (Fb.fib-path (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (Id (B.K (suc four)) (B.pt (suc four)) (B.pt (suc four))) (refl (B.pt (suc four))) (MX.loop Fhat) Cross.f (symH gamma)).1
       (Fb.fib-equiv (Id (A.K (suc two)) (A.pt (suc two)) (A.pt (suc two))) (refl (A.pt (suc two))) (Id (B.K (suc four)) (B.pt (suc four)) (B.pt (suc four))) (refl (B.pt (suc four))) KZ2 kz2 (B.K four) (B.pt four) (Cross.L.eB two) (Cross.L2.eB four) Cross.f kbar sq-f).1) ;
-- only used as a pointed equivalence
opaque omega-BR ;

-- Theorem 18 (ii)
BR-trunc : isTrunc (suc five) BR =
  trunc-Sigma (suc five) (A.K (suc two)) (\ x -> Id (B.K (suc four)) (Fhat.1 x) (B.pt (suc four))) (trunc-suc five (A.K (suc two)) (A.trunc two)) (\ x -> B.trunc four (Fhat.1 x) (B.pt (suc four))) ;
cW : isConn three (B.K (suc four)) = conn-down three (B.K (suc four)) (conn-down four (B.K (suc four)) (conn-down five (B.K (suc four)) (B.conn four))) ;
paths0 (v v' : BR) : Tr.Trunc[Id BR v v'].carrier =
  Fb.FibConn[(A.K (suc two)), (A.pt (suc two)), (B.K (suc four)), (B.pt (suc four)), Fhat, conn-zero two (A.K (suc two)) (A.conn two), surj-triv (A.K (suc two)) (A.pt (suc two)) (B.K (suc four)) (B.pt (suc four)) Fhat cW].paths v v' ;
BR-conn : isConn (suc (suc two)) BR =
  conn-from-point two BR br0 paths0 (Deloop[l].equiv-conn three (Id BR br0 br0) TR.F Acc[(Id BR br0 br0), refl br0, TR.F, TR.f0, omega-BR].equiv TR.conn3) ;

-- Corollary 19
phi : PtEquiv TR.F TR.f0 (Id BR br0 br0) (refl br0) = pt-inv (Id BR br0 br0) (refl br0) TR.F TR.f0 omega-BR ;
-- by definition of pt-inv, phi is the section of omega-BR
phi-def (r : TR.F) : Id (Id BR br0 br0) (phi.1.1 r) (omega-BR.2.sec r) = refl (phi.1.1 r) ;
-- left translation by a loop y, pointed by y . refl = y
transl (y : (Id BR br0 br0)) : PtEquiv (Id BR br0 br0) (refl br0) (Id BR br0 br0) y =
  ((\ q -> trans BR br0 br0 br0 y q, refl y),
   qinv (Id BR br0 br0) (Id BR br0 br0) (\ q -> trans BR br0 br0 br0 y q) (\ q -> trans BR br0 br0 br0 (sym BR br0 br0 y) q)
     (\ q -> Fb.trans-cancel' BR br0 br0 br0 y q) (\ q -> trans-cancel BR br0 br0 br0 y q)) ;
-- omega-BR, pointed at phi r
back (r : TR.F) : PtEquiv (Id BR br0 br0) (phi.1.1 r) TR.F r =
  ((omega-BR.1.1, transH (apH omega-BR.1.1 (phi-def r)) (omega-BR.2.sec-eq r)), omega-BR.2) ;
mu (r : TR.F) : PtEquiv TR.F TR.f0 TR.F r =
  pt-comp TR.F TR.f0 (Id BR br0 br0) (refl br0) TR.F r phi
    (pt-comp (Id BR br0 br0) (refl br0) (Id BR br0 br0) (phi.1.1 r) TR.F r (transl (phi.1.1 r)) (back r)) ;
module T = Deloop[l].Torsors[TR.F, TR.f0] ;
tor : T.Tor = T.homog mu ;
pt-contr : isContr T.PT = T.cor8 (suc zero) TR.conn3 TR.trunc5 (Tr.Trunc[T.Tor].inc tor) ;
module DT = T.Deloop[pt-contr] ;
tor-loops : PtEquiv (Id T.Tor DT.ptT DT.ptT) (refl DT.ptT) TR.F TR.f0 = DT.theorem2 ;
tor-conn : isConn (suc (suc two)) T.Tor = DT.tor-conn two TR.conn3 ;
tor-trunc : isTrunc (suc five) T.Tor = DT.tor-trunc five TR.trunc5 ;
