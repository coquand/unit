-- Pointed simply connected 3-types are classified by triples (A, B, k)
-- (doc/postnikov-classification.pdf, Theorem 2): the realisation
--     realise (A, B, k) = (Fib k, (pt, k0), conn3, trunc5)
-- (PostnikovRealization.Triple) is an equivalence Triples ~ SC3 (ClassPost.SC3) of types
-- in U l+.  Hart-Milner's Theorem 41 (Milner's equivalence) at n = 2,
-- simply connected; only the Theory parameters.
--   base       Triples ~ (V : Stage[0]) * (W : Stage[1]) * V ->pt Tor W:
--              sigma-base along K2, K3 (ClassEM, Theorem 6); Tor (K3 B) is
--              K(B,4) by definition
--   chain      base, then ClassFib.Chain.fib-equiv (Proposition 8)
--              under V, then ClassPost.post-equiv (Lemma 40)
--   realise-agree    Proposition 11 (Note 42): Fib k ~pt Sigma_x el (k x).1,
--              (x, q) |-> (x, tr (k x) q^-1), pointed by refl
--   realise-equiv    realise is homotopic to chain
--   classification   (realise, realise-equiv), the final equivalence
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open HLevels[l] ; open Connected[l] ;
open Lemma4[l] ; open PtEquivOps[l] ; open Torsor[l] ; open EMMaps[l] ; open AbHom[l] ;
open SphereUniversal[l] ; open PostnikovRealization[l] ;
module EMf = EM[l] ; module CB = ClassBase[l] ; module CE = ClassEM[l] ; module CF = ClassFib[l] ; module CP = ClassPost[l] ;
module Fb = Fibres[l] ; module CM = ConnectedMaps[l] ; module Eq = Equivalences[l] ;
module P1 = Prelude[l+] ; module E1 = Equivalences[l+] ; module SA1 = SphereAxiom[l+] ;

-- Definition 1: SC3 is ClassPost.SC3 (defined with Lemma 40); Triples
Triples : U l+ = (A : Ab) * (B : Ab) * PtMap (KK[A].K two) (KK[A].pt two) (KK[B].K four) (KK[B].pt four) ;

realise (t : Triples) : CP.SC3 =
  (Triple[t.1, t.2.1, t.2.2].F, Triple[t.1, t.2.1, t.2.2].f0, (Triple[t.1, t.2.1, t.2.2].conn3, Triple[t.1, t.2.1, t.2.2].trunc5)) ;

------------------------------------------------------------------------
-- the bases

-- the cocycles over V, with the coefficients as a group or as a stage
GB (V : CP.St0) : U l+ = (B : Ab) * PtMap V.X V.pt (KK[B].K four) (KK[B].pt four) ;
GW (V : CP.St0) : U l+ = (W : CF.St1) * CF.Chain[V].T0 W ;

base-W (V : CP.St0) : P1.Equiv (GB V) (GW V) =
  (\ w -> (CE.K3 w.1, w.2), SA1.sigma-base Ab CF.St1 (CE.K3, CE.k3-equiv) (\ W -> CF.Chain[V].T0 W)) ;

base : P1.Equiv Triples ((V : CP.St0) * GW V) =
  E1.compose Triples ((V : CP.St0) * GB V) ((V : CP.St0) * GW V)
    ((\ w -> (CE.K2 w.1, w.2), SA1.sigma-base Ab CP.St0 (CE.K2, CE.k2-equiv) (\ V -> GB V)))
    (Fibres[l+].sigma-equiv CP.St0 (\ V -> GB V) (\ V -> GW V) base-W) ;

-- Theorem 2, as a chain
chain : P1.Equiv Triples CP.SC3 =
  E1.compose Triples ((V : CP.St0) * GW V) CP.SC3 base
    (E1.compose ((V : CP.St0) * GW V) CP.SigFam CP.SC3
       (Fibres[l+].sigma-equiv CP.St0 (\ V -> GW V) (\ V -> CF.Fam V) (\ V -> CF.Chain[V].fib-equiv))
       CP.post-equiv) ;

------------------------------------------------------------------------
-- Proposition 11: the chain is the realisation

module Agree (t : Triples) {
  module R = Triple[t.1, t.2.1, t.2.2] ;
  X : U l = KK[t.1].K two ;
  x0 : X = KK[t.1].pt two ;
  module TW = CF.TorW[CE.K3 t.2.1] ;
  k : PtMap X x0 TW.Tor TW.ptT = t.2.2 ;
  -- (x, q) |-> (x, tr (k x) q^-1)
  fib-eq : Equiv R.F ((x : X) * TW.T.el (k.1 x).1) =
    Fb.sigma-equiv X (\ x -> Id TW.Tor (k.1 x) TW.ptT) (\ x -> TW.T.el (k.1 x).1)
      (\ x -> Eq.compose (Id TW.Tor (k.1 x) TW.ptT) (Id TW.Tor TW.ptT (k.1 x)) (TW.T.el (k.1 x).1)
                (CM.sym-equiv TW.Tor (k.1 x) TW.ptT) (TW.tau (k.1 x))) ;
  pe : PtEquiv R.F R.f0 (chain.1 t).1 (chain.1 t).2.1 = ((fib-eq.1, refl (chain.1 t).2.1), fib-eq.2) ;
  agree : Id CP.SC3 (realise t) (chain.1 t) = CP.PS.I[realise t].path (chain.1 t) pe ;
} ;

realise-agree (t : Triples) : Id CP.SC3 (realise t) (chain.1 t) = Agree[t].agree ;

-- Theorem 2
realise-equiv : P1.isEquiv Triples CP.SC3 realise = E1.homotopy Triples CP.SC3 chain realise realise-agree ;

classification : P1.Equiv Triples CP.SC3 = (realise, realise-equiv) ;
