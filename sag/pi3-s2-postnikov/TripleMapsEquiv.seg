-- Arbitrary pointed maps between Postnikov triples (doc/postnikov-morphisms.pdf,
-- Theorem 1).  Informal proof: the note, Section 2.
--   Coef[A, B]     Lemma coef: a |-> K(a,2) and b |-> K(b,4) are equivalences
--                  Hom(A,B) ~ Map_*(K(A,m), K(B,m)) (inverses H2.inv2, Climb.inv4;
--                  unconj-conj at every level, inv2-K, inv3-K, inv4-K)
--   Dec            Lemma dec: (al, F, e) |-> ((x, q) |-> (al x, F x q), Sigma-path al0 (piq e))
--                  is an equivalence (al : V ->pt V', (F, e) : T(al ; k')):
--                  reordering; (al0, e) |-> Sigma-path (piq e) (piq-equiv, sigma-paths);
--                  cur-equiv (currying, ConnectedMaps.Elim along fpr, distributivity);
--                  sigma-base for the pointing
--   Maps2[A, B, k, A', B', k']   the triples (A, B, k), (A', B', k'):
--     Mor, mor-a, mor-b, mor-H     Definition mor
--     realise-map                  Definition realise-map: FibMap.fm at (k, k', K(a,2), K(b,4), H)
--     realise-map-def              it is Dec of (K(a,2), Phi (K(b,4), H)), by definition
--     realise-map-equiv            Theorem 1: the composite of the coefficient
--                                  equivalences, Key.key (TripleMaps) and Dec
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ; open HLevels[l] ; open Connected[l] ; open Lemma4[l] ;
open DeloopMaps[l] ; open LoopCalc[l] ; open PtEquivOps[l] ; open EMMaps[l] ; open AbHom[l] ; open SphereUniversal[l] ; open PostnikovRealization[l] ;
open Group[l] ; open Torsor[l] ; open TripleMaps[l] ;
module E = Equivalences[l] ; module W = Whitehead[l] ; module Fb = Fibres[l] ; module CM = ConnectedMaps[l] ;
module Gp = Groupoid[l] ; module CB = ClassBase[l] ; module FM = FibMap[l] ; module HB = H4Bilinear[l] ; module FH = FibreH3[l] ;

------------------------------------------------------------------------
-- Lemma coef

module Coef (Ga Gb : Ab) {
  module A = KK[Ga] ;
  module B = KK[Gb] ;
  module L = HB.Lev[Ga, Gb] ;
  module H2 = HB.H2[Ga, Gb] ;
  module CL = FH.Climb[Ga, Gb] ;
  -- unconj (conj F) = F, at every level (the computation of H2.unconj-conj)
  unconj-conj (m : Nat) (F : PtMap (A.K m) (A.pt m) (B.K m) (B.pt m)) : Id (PtMap (A.K m) (A.pt m) (B.K m) (B.pt m)) (CL.unconj m (L.conj m F)) F =
    calc (PtMap (A.K m) (A.pt m) (B.K m) (B.pt m)) {
    CL.unconj m (L.conj m F)
      =< apH (ptcomp (A.K m) (A.pt m) (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (B.K m) (B.pt m) (L.eAi m))
           (ptcomp-assoc (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (B.K m) (B.pt m) (Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m))) (refl (B.pt (suc m))) (B.K m) (B.pt m)
              (ptcomp (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (A.K m) (A.pt m) (B.K m) (B.pt m) (L.eA m).1 F) (L.eBi m) (L.eB m).1) >
    ptcomp (A.K m) (A.pt m) (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (B.K m) (B.pt m) (L.eAi m)
      (ptcomp (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (B.K m) (B.pt m) (B.K m) (B.pt m) (ptcomp (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (A.K m) (A.pt m) (B.K m) (B.pt m) (L.eA m).1 F)
         (ptcomp (B.K m) (B.pt m) (Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m))) (refl (B.pt (suc m))) (B.K m) (B.pt m) (L.eBi m) (L.eB m).1))
      =< apH (\ H -> ptcomp (A.K m) (A.pt m) (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (B.K m) (B.pt m) (L.eAi m)
                      (ptcomp (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (B.K m) (B.pt m) (B.K m) (B.pt m) (ptcomp (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (A.K m) (A.pt m) (B.K m) (B.pt m) (L.eA m).1 F) H))
           (pt-inv-r (Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m))) (refl (B.pt (suc m))) (B.K m) (B.pt m) (L.eB m)) >
    ptcomp (A.K m) (A.pt m) (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (B.K m) (B.pt m) (L.eAi m)
      (ptcomp (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (B.K m) (B.pt m) (B.K m) (B.pt m) (ptcomp (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (A.K m) (A.pt m) (B.K m) (B.pt m) (L.eA m).1 F)
         (ptid (B.K m) (B.pt m)))
      =< apH (ptcomp (A.K m) (A.pt m) (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (B.K m) (B.pt m) (L.eAi m))
           (Fb.ptcomp-idr (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (B.K m) (B.pt m) (ptcomp (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (A.K m) (A.pt m) (B.K m) (B.pt m) (L.eA m).1 F)) >
    ptcomp (A.K m) (A.pt m) (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (B.K m) (B.pt m) (L.eAi m) (ptcomp (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (A.K m) (A.pt m) (B.K m) (B.pt m) (L.eA m).1 F)
      =< symH (ptcomp-assoc (A.K m) (A.pt m) (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (A.K m) (A.pt m) (B.K m) (B.pt m) (L.eAi m) (L.eA m).1 F) >
    ptcomp (A.K m) (A.pt m) (A.K m) (A.pt m) (B.K m) (B.pt m) (ptcomp (A.K m) (A.pt m) (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (A.K m) (A.pt m) (L.eAi m) (L.eA m).1) F
      =< apH (\ H -> ptcomp (A.K m) (A.pt m) (A.K m) (A.pt m) (B.K m) (B.pt m) H F) (pt-inv-r (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (A.K m) (A.pt m) (L.eA m)) >
    ptcomp (A.K m) (A.pt m) (A.K m) (A.pt m) (B.K m) (B.pt m) (ptid (A.K m) (A.pt m)) F
      =< Fb.ptcomp-idl (A.K m) (A.pt m) (B.K m) (B.pt m) F >
    F } ;
  -- unconj (loop K(g, m+1)) = K(g, m)
  unloopK (g : Hom Ga Gb) (m : Nat) : Id (PtMap (A.K m) (A.pt m) (B.K m) (B.pt m)) (CL.unconj m (Maps[A.K (suc m), A.pt (suc m), B.K (suc m), B.pt (suc m)].loop (L.K g (suc m)))) (L.K g m) =
    transH (apH (CL.unconj m) (L.loopK g m)) (unconj-conj m (L.K g m)) ;
  inv2-K (g : Hom Ga Gb) : Id (Hom Ga Gb) (H2.inv2 (L.K g two)) g = H2.k2-inj (H2.inv2 (L.K g two)) g (H2.k2-surj (L.K g two)) ;
  inv3-K (g : Hom Ga Gb) : Id (Hom Ga Gb) (CL.inv3 (L.K g three)) g = transH (apH H2.inv2 (unloopK g two)) (inv2-K g) ;
  inv4-K (g : Hom Ga Gb) : Id (Hom Ga Gb) (CL.inv4 (L.K g four)) g = transH (apH CL.inv3 (unloopK g three)) (inv3-K g) ;
  k2-equiv : Equiv (Hom Ga Gb) (PtMap (A.K two) (A.pt two) (B.K two) (B.pt two)) =
    (\ g -> L.K g two, qinv (Hom Ga Gb) (PtMap (A.K two) (A.pt two) (B.K two) (B.pt two)) (\ g -> L.K g two) H2.inv2 H2.k2-surj inv2-K) ;
  k4-equiv : Equiv (Hom Ga Gb) (PtMap (A.K four) (A.pt four) (B.K four) (B.pt four)) =
    (\ g -> L.K g four, qinv (Hom Ga Gb) (PtMap (A.K four) (A.pt four) (B.K four) (B.pt four)) (\ g -> L.K g four) CL.inv4 CL.surj4 inv4-K) ;
} ;

------------------------------------------------------------------------
-- Lemma dec: pointed maps Fib k -> Fib k'

module Dec (V : U l) (v0 : V) (Y : U l) (y0 : Y) (cY : isConn five Y) (V' : U l) (v0' : V') (tV' : isTrunc four V')
  (Y' : U l) (y0' : Y') (k : PtMap V v0 Y y0) (k' : PtMap V' v0' Y' y0') {
  Fk : U l = Fb.Fib V v0 Y y0 k ;
  w0 : Fk = Fb.fpt V v0 Y y0 k ;
  Fk' : U l = Fb.Fib V' v0' Y' y0' k' ;
  w0' : Fk' = Fb.fpt V' v0' Y' y0' k' ;
  P (x : V) : U l = Id Y (k.1 x) y0 ;
  R (z : V') : U l = Id Y' (k'.1 z) y0' ;
  TA (al : PtMap V v0 V' v0') : U l = Tc V v0 Y y0 Y' y0' k (ptcomp V v0 V' v0' Y' y0' al k') ;
  Src : U l = (al : PtMap V v0 V' v0') * TA al ;
  -- the pointing in the fibre (the steps of FibMap.fm-pt-q)
  piq (a1 : V -> V') (F0 : R (a1 v0)) (a0 : Id V' (a1 v0) v0')
    (e : Id (R (a1 v0)) F0 (trans Y' (k'.1 (a1 v0)) (k'.1 v0') y0' (ap V' Y' k'.1 (a1 v0) v0' a0) k'.2)) :
    Id (R v0') (subst V' R (a1 v0) v0' a0 F0) k'.2 = calc (R v0') {
      subst V' R (a1 v0) v0' a0 F0
        =< Gp.transport-fib V' Y' k'.1 y0' (a1 v0) v0' a0 F0 >
      trans Y' (k'.1 v0') (k'.1 (a1 v0)) y0' (sym Y' (k'.1 (a1 v0)) (k'.1 v0') (ap V' Y' k'.1 (a1 v0) v0' a0)) F0
        =< apH (trans Y' (k'.1 v0') (k'.1 (a1 v0)) y0' (sym Y' (k'.1 (a1 v0)) (k'.1 v0') (ap V' Y' k'.1 (a1 v0) v0' a0))) e >
      trans Y' (k'.1 v0') (k'.1 (a1 v0)) y0' (sym Y' (k'.1 (a1 v0)) (k'.1 v0') (ap V' Y' k'.1 (a1 v0) v0' a0))
        (trans Y' (k'.1 (a1 v0)) (k'.1 v0') y0' (ap V' Y' k'.1 (a1 v0) v0' a0) k'.2)
        =< trans-cancel Y' (k'.1 (a1 v0)) (k'.1 v0') y0' (ap V' Y' k'.1 (a1 v0) v0' a0) k'.2 >
      k'.2 } ;
  -- Definition Dec
  dec (w : Src) : PtMap Fk w0 Fk' w0' =
    (\ z -> (w.1.1 z.1, w.2.1 z.1 z.2), Sigma-path V' R (w.1.1 v0) v0' (w.2.1 v0 k.2) k'.2 w.1.2 (piq w.1.1 (w.2.1 v0 k.2) w.1.2 w.2.2)) ;

  -- (iv) the pointing: piq is an equivalence, then Sigma-path
  piq-equiv (a1 : V -> V') (F0 : R (a1 v0)) (a0 : Id V' (a1 v0) v0') :
    isEquiv (Id (R (a1 v0)) F0 (trans Y' (k'.1 (a1 v0)) (k'.1 v0') y0' (ap V' Y' k'.1 (a1 v0) v0' a0) k'.2)) (Id (R v0') (subst V' R (a1 v0) v0' a0 F0) k'.2) (piq a1 F0 a0) =
    E.homotopy (Id (R (a1 v0)) F0 (trans Y' (k'.1 (a1 v0)) (k'.1 v0') y0' (ap V' Y' k'.1 (a1 v0) v0' a0) k'.2)) (Id (R v0') (subst V' R (a1 v0) v0' a0 F0) k'.2)
      (E.compose (Id (R (a1 v0)) F0 (trans Y' (k'.1 (a1 v0)) (k'.1 v0') y0' (ap V' Y' k'.1 (a1 v0) v0' a0) k'.2))
         (Id (R v0') (trans Y' (k'.1 v0') (k'.1 (a1 v0)) y0' (sym Y' (k'.1 (a1 v0)) (k'.1 v0') (ap V' Y' k'.1 (a1 v0) v0' a0)) F0) k'.2)
         (Id (R v0') (subst V' R (a1 v0) v0' a0 F0) k'.2)
         (E.compose (Id (R (a1 v0)) F0 (trans Y' (k'.1 (a1 v0)) (k'.1 v0') y0' (ap V' Y' k'.1 (a1 v0) v0' a0) k'.2))
            (Id (R v0') (trans Y' (k'.1 v0') (k'.1 (a1 v0)) y0' (sym Y' (k'.1 (a1 v0)) (k'.1 v0') (ap V' Y' k'.1 (a1 v0) v0' a0)) F0)
                        (trans Y' (k'.1 v0') (k'.1 (a1 v0)) y0' (sym Y' (k'.1 (a1 v0)) (k'.1 v0') (ap V' Y' k'.1 (a1 v0) v0' a0)) (trans Y' (k'.1 (a1 v0)) (k'.1 v0') y0' (ap V' Y' k'.1 (a1 v0) v0' a0) k'.2)))
            (Id (R v0') (trans Y' (k'.1 v0') (k'.1 (a1 v0)) y0' (sym Y' (k'.1 (a1 v0)) (k'.1 v0') (ap V' Y' k'.1 (a1 v0) v0' a0)) F0) k'.2)
            (ap (R (a1 v0)) (R v0') (trans Y' (k'.1 v0') (k'.1 (a1 v0)) y0' (sym Y' (k'.1 (a1 v0)) (k'.1 v0') (ap V' Y' k'.1 (a1 v0) v0' a0))) F0
               (trans Y' (k'.1 (a1 v0)) (k'.1 v0') y0' (ap V' Y' k'.1 (a1 v0) v0' a0) k'.2),
             CB.ap-equiv (R (a1 v0)) (R v0') (Fb.trans-equiv Y' (k'.1 v0') (k'.1 (a1 v0)) y0' (sym Y' (k'.1 (a1 v0)) (k'.1 v0') (ap V' Y' k'.1 (a1 v0) v0' a0))) F0
               (trans Y' (k'.1 (a1 v0)) (k'.1 v0') y0' (ap V' Y' k'.1 (a1 v0) v0' a0) k'.2))
            (\ u -> trans (R v0') (trans Y' (k'.1 v0') (k'.1 (a1 v0)) y0' (sym Y' (k'.1 (a1 v0)) (k'.1 v0') (ap V' Y' k'.1 (a1 v0) v0' a0)) F0)
                      (trans Y' (k'.1 v0') (k'.1 (a1 v0)) y0' (sym Y' (k'.1 (a1 v0)) (k'.1 v0') (ap V' Y' k'.1 (a1 v0) v0' a0)) (trans Y' (k'.1 (a1 v0)) (k'.1 v0') y0' (ap V' Y' k'.1 (a1 v0) v0' a0) k'.2))
                      k'.2 u (trans-cancel Y' (k'.1 (a1 v0)) (k'.1 v0') y0' (ap V' Y' k'.1 (a1 v0) v0' a0) k'.2),
             rmul-equiv (R v0') (trans Y' (k'.1 v0') (k'.1 (a1 v0)) y0' (sym Y' (k'.1 (a1 v0)) (k'.1 v0') (ap V' Y' k'.1 (a1 v0) v0' a0)) F0)
               (trans Y' (k'.1 v0') (k'.1 (a1 v0)) y0' (sym Y' (k'.1 (a1 v0)) (k'.1 v0') (ap V' Y' k'.1 (a1 v0) v0' a0)) (trans Y' (k'.1 (a1 v0)) (k'.1 v0') y0' (ap V' Y' k'.1 (a1 v0) v0' a0) k'.2))
               k'.2 (trans-cancel Y' (k'.1 (a1 v0)) (k'.1 v0') y0' (ap V' Y' k'.1 (a1 v0) v0' a0) k'.2)))
         (Fb.trans-equiv (R v0') (subst V' R (a1 v0) v0' a0 F0) (trans Y' (k'.1 v0') (k'.1 (a1 v0)) y0' (sym Y' (k'.1 (a1 v0)) (k'.1 v0') (ap V' Y' k'.1 (a1 v0) v0' a0)) F0) k'.2
            (Gp.transport-fib V' Y' k'.1 y0' (a1 v0) v0' a0 F0)))
      (piq a1 F0 a0) (\ e -> refl (piq a1 F0 a0 e)) ;
  -- the maps of (ii)
  U1 : U l = (a1 : V -> V') * ((x : V) -> P x -> R (a1 x)) ;
  cur (u : U1) (z : Fk) : Fk' = (u.1 z.1, u.2 z.1 z.2) ;
  -- the fibres of fpr are 2-connected
  cp (x : V) : isConn four (W.fib Fk V (\ w -> w.1) x) =
    Deloop[l].equiv-conn four (W.fib Fk V (\ w -> w.1) x) (P x) (MapFib[l].fib-fst V P x) (conn-id four Y cY (k.1 x) y0) ;
  module EV = CM.Elim[four, Fk, V, \ w -> w.1, cp, \ x -> V', \ x -> tV'] ;
  U2 : U l = (a1 : V -> V') * ((z : Fk) -> R (a1 z.1)) ;
  U3 : U l = (g : Fk -> V') * ((z : Fk) -> R (g z)) ;
  cur-equiv : Equiv U1 (Fk -> Fk') =
    (cur, E.homotopy U1 (Fk -> Fk')
      (E.compose U1 U2 (Fk -> Fk')
         (\ u -> (u.1, \ z -> u.2 z.1 z.2), qinv U1 U2 (\ u -> (u.1, \ z -> u.2 z.1 z.2)) (\ v -> (v.1, \ x q -> v.2 (x, q))) (\ v -> refl v) (\ u -> refl u))
         (E.compose U2 U3 (Fk -> Fk')
            (\ v -> (EV.precomp v.1, v.2), SphereAxiom[l].sigma-base (V -> V') (Fk -> V') (EV.precomp, EV.equiv) (\ g -> (z : Fk) -> R (g z)))
            (\ w z -> (w.1 z, w.2 z), qinv U3 (Fk -> Fk') (\ w z -> (w.1 z, w.2 z)) (\ G -> (\ z -> (G z).1, \ z -> (G z).2)) (\ G -> refl G) (\ w -> refl w))))
      cur (\ u -> refl (cur u))) ;
  Ptd (G : Fk -> Fk') : U l = Id Fk' (G w0) w0' ;
  Pts (u : U1) : U l = (a0 : Id V' (u.1 v0) v0') * Id (R (u.1 v0)) (u.2 v0 k.2) (trans Y' (k'.1 (u.1 v0)) (k'.1 v0') y0' (ap V' Y' k'.1 (u.1 v0) v0' a0) k'.2) ;
  bmap (u : U1) (w : Pts u) : Ptd (cur u) = Sigma-path V' R (u.1 v0) v0' (u.2 v0 k.2) k'.2 w.1 (piq u.1 (u.2 v0 k.2) w.1 w.2) ;
  bmap-equiv (u : U1) : Equiv (Pts u) (Ptd (cur u)) =
    E.compose (Pts u) ((a0 : Id V' (u.1 v0) v0') * Id (R v0') (subst V' R (u.1 v0) v0' a0 (u.2 v0 k.2)) k'.2) (Ptd (cur u))
      (Fb.sigma-equiv (Id V' (u.1 v0) v0') (\ a0 -> Id (R (u.1 v0)) (u.2 v0 k.2) (trans Y' (k'.1 (u.1 v0)) (k'.1 v0') y0' (ap V' Y' k'.1 (u.1 v0) v0' a0) k'.2))
         (\ a0 -> Id (R v0') (subst V' R (u.1 v0) v0' a0 (u.2 v0 k.2)) k'.2)
         (\ a0 -> (piq u.1 (u.2 v0 k.2) a0, piq-equiv u.1 (u.2 v0 k.2) a0)))
      (\ w -> Sigma-path V' R (u.1 v0) v0' (u.2 v0 k.2) k'.2 w.1 w.2,
       W.inv-equiv (Ptd (cur u)) ((a0 : Id V' (u.1 v0) v0') * Id (R v0') (subst V' R (u.1 v0) v0' a0 (u.2 v0 k.2)) k'.2)
         (CM.sigma-paths V' R (u.1 v0, u.2 v0 k.2) (v0', k'.2)).1 (CM.sigma-paths V' R (u.1 v0, u.2 v0 k.2) (v0', k'.2)).2) ;
  -- Lemma dec
  dec-equiv : isEquiv Src (PtMap Fk w0 Fk' w0') dec =
    E.homotopy Src (PtMap Fk w0 Fk' w0')
      (E.compose Src ((u : U1) * Pts u) (PtMap Fk w0 Fk' w0')
         (\ w -> ((w.1.1, w.2.1), (w.1.2, w.2.2)),
          qinv Src ((u : U1) * Pts u) (\ w -> ((w.1.1, w.2.1), (w.1.2, w.2.2))) (\ v -> ((v.1.1, v.2.1), (v.1.2, v.2.2))) (\ v -> refl v) (\ w -> refl w))
         (E.compose ((u : U1) * Pts u) ((u : U1) * Ptd (cur u)) (PtMap Fk w0 Fk' w0')
            (\ w -> (w.1, bmap w.1 w.2), (Fb.sigma-equiv U1 Pts (\ u -> Ptd (cur u)) bmap-equiv).2)
            (\ w -> (cur w.1, w.2), SphereAxiom[l].sigma-base U1 (Fk -> Fk') cur-equiv Ptd)))
      dec (\ w -> refl (dec w)) ;
} ;

------------------------------------------------------------------------
-- Theorem 1

module Maps2 (Ga Gb : Ab) (k : PtMap (KK[Ga].K two) (KK[Ga].pt two) (KK[Gb].K four) (KK[Gb].pt four))
  (Ga' Gb' : Ab) (k' : PtMap (KK[Ga'].K two) (KK[Ga'].pt two) (KK[Gb'].K four) (KK[Gb'].pt four)) {
  module KA = KK[Ga] ; module KB = KK[Gb] ; module KA' = KK[Ga'] ; module KB' = KK[Gb'] ;
  module LA = HB.Lev[Ga, Ga'] ; module LB = HB.Lev[Gb, Gb'] ;
  module R = Triple[Ga, Gb, k] ; module R' = Triple[Ga', Gb', k'] ;
  -- K(a,2) ; k'
  ck (a : Hom Ga Ga') : PtMap (KA.K two) (KA.pt two) (KB'.K four) (KB'.pt four) =
    ptcomp (KA.K two) (KA.pt two) (KA'.K two) (KA'.pt two) (KB'.K four) (KB'.pt four) (LA.K a two) k' ;
  -- k ; K(b,4)
  kc (b : Hom Gb Gb') : PtMap (KA.K two) (KA.pt two) (KB'.K four) (KB'.pt four) =
    ptcomp (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) (KB'.K four) (KB'.pt four) k (LB.K b four) ;
  -- Definition mor
  Mor : U l = (a : Hom Ga Ga') * (b : Hom Gb Gb') * Id (PtMap (KA.K two) (KA.pt two) (KB'.K four) (KB'.pt four)) (ck a) (kc b) ;
  mor-a (m : Mor) : Hom Ga Ga' = m.1 ;
  mor-b (m : Mor) : Hom Gb Gb' = m.2.1 ;
  mor-H (m : Mor) : Id (PtMap (KA.K two) (KA.pt two) (KB'.K four) (KB'.pt four)) (ck (mor-a m)) (kc (mor-b m)) = m.2.2 ;
  -- Definition realise-map
  realise-map (m : Mor) : PtMap R.F R.f0 R'.F R'.f0 =
    FM.FibMap[KA.K two, KA.pt two, KB.K four, KB.pt four, KA'.K two, KA'.pt two, KB'.K four, KB'.pt four, k, k', LA.K (mor-a m) two, LB.K (mor-b m) four, mor-H m].fm ;

  -- the ingredients
  cV : isConn two (KA.K two) = conn-down two (KA.K two) (KA.conn (suc zero)) ;
  module D = Dec[KA.K two, KA.pt two, KB.K four, KB.pt four, KB.conn three, KA'.K two, KA'.pt two, KA'.trunc (suc zero), KB'.K four, KB'.pt four, k, k'] ;
  -- by definition, realise-map is Dec of (K(a,2), Phi (K(b,4), H))
  realise-map-def (m : Mor) : Id (PtMap R.F R.f0 R'.F R'.f0) (realise-map m) (D.dec (LA.K (mor-a m) two, Key[KA.K two, KA.pt two, cV, KB.K four, KB.pt four, KB.conn three, KB'.K four, KB'.pt four, conn-down four (KB'.K four) (KB'.conn three), KB'.trunc three, k, ck (mor-a m)].Phi (LB.K (mor-b m) four, mor-H m))) =
    refl (realise-map m) ;
  -- the factorisations with an abstract be, and the coefficient b
  Sb (a : Hom Ga Ga') : U l = (b : Hom Gb Gb') * Id (PtMap (KA.K two) (KA.pt two) (KB'.K four) (KB'.pt four)) (ck a) (kc b) ;
  -- Theorem 1
  realise-map-equiv : isEquiv Mor (PtMap R.F R.f0 R'.F R'.f0) realise-map =
    E.homotopy Mor (PtMap R.F R.f0 R'.F R'.f0)
      (E.compose Mor ((a : Hom Ga Ga') * Key[KA.K two, KA.pt two, cV, KB.K four, KB.pt four, KB.conn three, KB'.K four, KB'.pt four, conn-down four (KB'.K four) (KB'.conn three), KB'.trunc three, k, ck a].S) (PtMap R.F R.f0 R'.F R'.f0)
         (Fb.sigma-equiv (Hom Ga Ga') Sb (\ a -> Key[KA.K two, KA.pt two, cV, KB.K four, KB.pt four, KB.conn three, KB'.K four, KB'.pt four, conn-down four (KB'.K four) (KB'.conn three), KB'.trunc three, k, ck a].S)
            (\ a -> (\ w -> (LB.K w.1 four, w.2),
                     SphereAxiom[l].sigma-base (Hom Gb Gb') (PtMap (KB.K four) (KB.pt four) (KB'.K four) (KB'.pt four)) Coef[Gb, Gb'].k4-equiv
                       (\ be -> Id (PtMap (KA.K two) (KA.pt two) (KB'.K four) (KB'.pt four)) (ck a) (ptcomp (KA.K two) (KA.pt two) (KB.K four) (KB.pt four) (KB'.K four) (KB'.pt four) k be)))))
         (E.compose ((a : Hom Ga Ga') * Key[KA.K two, KA.pt two, cV, KB.K four, KB.pt four, KB.conn three, KB'.K four, KB'.pt four, conn-down four (KB'.K four) (KB'.conn three), KB'.trunc three, k, ck a].S) ((a : Hom Ga Ga') * Key[KA.K two, KA.pt two, cV, KB.K four, KB.pt four, KB.conn three, KB'.K four, KB'.pt four, conn-down four (KB'.K four) (KB'.conn three), KB'.trunc three, k, ck a].T) (PtMap R.F R.f0 R'.F R'.f0)
            (Fb.sigma-equiv (Hom Ga Ga') (\ a -> Key[KA.K two, KA.pt two, cV, KB.K four, KB.pt four, KB.conn three, KB'.K four, KB'.pt four, conn-down four (KB'.K four) (KB'.conn three), KB'.trunc three, k, ck a].S) (\ a -> Key[KA.K two, KA.pt two, cV, KB.K four, KB.pt four, KB.conn three, KB'.K four, KB'.pt four, conn-down four (KB'.K four) (KB'.conn three), KB'.trunc three, k, ck a].T) (\ a -> (Key[KA.K two, KA.pt two, cV, KB.K four, KB.pt four, KB.conn three, KB'.K four, KB'.pt four, conn-down four (KB'.K four) (KB'.conn three), KB'.trunc three, k, ck a].Phi, Key[KA.K two, KA.pt two, cV, KB.K four, KB.pt four, KB.conn three, KB'.K four, KB'.pt four, conn-down four (KB'.K four) (KB'.conn three), KB'.trunc three, k, ck a].key)))
            (E.compose ((a : Hom Ga Ga') * Key[KA.K two, KA.pt two, cV, KB.K four, KB.pt four, KB.conn three, KB'.K four, KB'.pt four, conn-down four (KB'.K four) (KB'.conn three), KB'.trunc three, k, ck a].T) D.Src (PtMap R.F R.f0 R'.F R'.f0)
               (\ w -> (LA.K w.1 two, w.2), SphereAxiom[l].sigma-base (Hom Ga Ga') (PtMap (KA.K two) (KA.pt two) (KA'.K two) (KA'.pt two)) Coef[Ga, Ga'].k2-equiv D.TA)
               (D.dec, D.dec-equiv))))
      realise-map realise-map-def ;
} ;
