-- Milestone B: the universal-property argument, CONDITIONAL on two
-- explicit interfaces (records, not Theory parameters):
--
--   Trunc3 S2 : a 3-truncation T of S2: a pointed map eta : S2 -> T into a
--               simply connected 3-type such that precomposition with eta
--               is an equivalence of pointed mapping types into every
--               3-type, and pi3 eta is bijective.  (To be CONSTRUCTED:
--               finite truncations are not yet available from the
--               Theory assumptions in Unit.)
--   Rep P      : a simply connected 3-type P with a class s in [S2, P]_*
--               such that for every simply connected 3-type X,
--               precomposition  s^* : [P, X]_* -> [S2, X]_*  is a
--               bijection of SETS of classes.  Via the sphere's pointed
--               universal property [S2, X]_* = pi_2 X (SphereAxiom), this
--               is the statement [P, X]_* = pi_2 X, natural in X, that
--               the Postnikov mapping theorem and (H3)/(H4) provide for
--               P = Fib kappa (milestones C, D: not yet constructed).
--
-- Indexing (HLevels, Connected): 3-type = isTrunc 5, simply connected =
-- isConn 3.
--
-- The two-map form of Yoneda, on classes only (no representative of a
-- class is chosen; pi3 is applied to classes, Pi3C):
--   u : [T, P]  the class with  eta^* u = s       (Trunc3 on classes)
--   t : [P, T]  the class with  s^* t = [eta]     (Rep at X = T)
--   s^* (t ; u) = (s ; t) ; u = eta^* u = s = s^* id    so t ; u = id_P
--   eta^* (u ; t) = s ; t = [eta] = eta^* id           so u ; t = id_T
-- hence pi3 u : pi3 T -> pi3 P is an isomorphism, and with pi3 eta
--   pi3 S2 = pi3 T = pi3 P            (iso-S2-P)
-- Two states this with the two instances sP, sT of Rep.rep as hypotheses;
-- Assemble is its instance for a Rep.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Lemma4[l] ; open LoopCalc[l] ;
open HLevels[l] ; open Connected[l] ;
open Group[l] ; open SphereAxiom[l] ; open HomotopyClasses[l] ; open HomotopyGroups[l] ;
module N = NatArith[l] ;

three : Nat = suc (suc (suc zero)) ;
five : Nat = suc (suc three) ;

module Interfaces (S2 : U l) (base : S2) {

  record Trunc3 {
    T : U l ;
    t0 : T ;
    eta : PtMap S2 base T t0 ;
    truncT : isTrunc five T ;
    connT : isConn three T ;
    up (Y : U l) (y0 : Y) (tY : isTrunc five Y) :
      isEquiv (PtMap T t0 Y y0) (PtMap S2 base Y y0) (\ G -> ptcomp S2 base T t0 Y y0 eta G) ;
    pi3-eta : isEquiv (pi3 S2 base).G (pi3 T t0).G (pi3-map S2 base T t0 eta).1 ;
  } ;

  record Rep {
    P : U l ;
    p0 : P ;
    truncP : isTrunc five P ;
    connP : isConn three P ;
    s : HC S2 base P p0 ;
    rep (X : U l) (x0 : X) (tX : isTrunc five X) (cX : isConn three X) :
      isEquiv (HC P p0 X x0) (HC S2 base X x0) (\ b -> compC S2 base P p0 X x0 s b) ;
  } ;
} ;

-- Theorem B in the form used: Rep.rep is needed only at X = P (sP) and
-- X = T (sT), so these two bijections are the hypotheses
module Two (S2 : U l) (base : S2) (TR : Interfaces[S2, base].Trunc3) (P : U l) (p0 : P) (truncP : isTrunc five P)
  (s : HC S2 base P p0)
  (sP : isEquiv (HC P p0 P p0) (HC S2 base P p0) (\ b -> compC S2 base P p0 P p0 s b))
  (sT : isEquiv (HC P p0 TR.T TR.t0) (HC S2 base TR.T TR.t0) (\ b -> compC S2 base P p0 TR.T TR.t0 s b)) {
  open TR ;
  -- [eta]
  e : HC S2 base T t0 = hcl S2 base T t0 eta ;

  -- eta^* on classes into P and into T
  etaP : isEquiv (HC T t0 P p0) (HC S2 base P p0) (\ b -> compC S2 base T t0 P p0 e b) =
    pre-equiv S2 base T t0 P p0 eta (up P p0 truncP) ;
  etaT : isEquiv (HC T t0 T t0) (HC S2 base T t0) (\ b -> compC S2 base T t0 T t0 e b) =
    pre-equiv S2 base T t0 T t0 eta (up T t0 truncT) ;

  u : HC T t0 P p0 = etaP.sec s ;
  u-eq : Id (HC S2 base P p0) (compC S2 base T t0 P p0 e u) s = etaP.sec-eq s ;
  t : HC P p0 T t0 = sT.sec e ;
  t-eq : Id (HC S2 base T t0) (compC S2 base P p0 T t0 s t) e = sT.sec-eq e ;

  tu : Id (HC P p0 P p0) (compC P p0 T t0 P p0 t u) (idC P p0) =
    Equivalences[l].injective (HC P p0 P p0) (HC S2 base P p0) (\ b -> compC S2 base P p0 P p0 s b) sP _ _
      (calc (HC S2 base P p0) {
        compC S2 base P p0 P p0 s (compC P p0 T t0 P p0 t u)
          =< symH (comp-assoc S2 base P p0 T t0 P p0 s t u) >
        compC S2 base T t0 P p0 (compC S2 base P p0 T t0 s t) u
          =< apH (\ c -> compC S2 base T t0 P p0 c u) t-eq >
        compC S2 base T t0 P p0 e u
          =< u-eq >
        s
          =< symH (comp-idr S2 base P p0 s) >
        compC S2 base P p0 P p0 s (idC P p0) }) ;

  ut : Id (HC T t0 T t0) (compC T t0 P p0 T t0 u t) (idC T t0) =
    Equivalences[l].injective (HC T t0 T t0) (HC S2 base T t0) (\ b -> compC S2 base T t0 T t0 e b) etaT _ _
      (calc (HC S2 base T t0) {
        compC S2 base T t0 T t0 e (compC T t0 P p0 T t0 u t)
          =< symH (comp-assoc S2 base T t0 P p0 T t0 e u t) >
        compC S2 base P p0 T t0 (compC S2 base T t0 P p0 e u) t
          =< apH (\ c -> compC S2 base P p0 T t0 c t) u-eq >
        compC S2 base P p0 T t0 s t
          =< t-eq >
        e
          =< symH (comp-idr S2 base T t0 e) >
        compC S2 base T t0 T t0 e (idC T t0) }) ;

  -- pi3 of the two classes are inverse isomorphisms
  iso-T-P : GIso[pi3 T t0, pi3 P p0] =
    new GIso[pi3 T t0, pi3 P p0, pi3C T t0 P p0 u, pi3C P p0 T t0 t,
     \ x -> transH (symH (pi3C-comp T t0 P p0 T t0 u t x))
              (transH (apH (\ c -> (pi3C T t0 T t0 c).1 x) ut) (pi3C-id T t0 x)),
     \ y -> transH (symH (pi3C-comp P p0 T t0 P p0 t u y))
              (transH (apH (\ c -> (pi3C P p0 P p0 c).1 y) tu) (pi3C-id P p0 y))] ;

  iso-S2-T : GIso[pi3 S2 base, pi3 T t0] = gi-of-equiv (pi3 S2 base) (pi3 T t0) (pi3-map S2 base T t0 eta) pi3-eta ;

  iso-S2-P : GIso[pi3 S2 base, pi3 P p0] = gi-comp (pi3 S2 base) (pi3 T t0) (pi3 P p0) iso-S2-T iso-T-P ;
} ;

module Assemble (S2 : U l) (base : S2) (TR : Interfaces[S2, base].Trunc3) (RP : Interfaces[S2, base].Rep) {
  open TR ; open RP ;
  sP : isEquiv (HC P p0 P p0) (HC S2 base P p0) (\ b -> compC S2 base P p0 P p0 s b) = rep P p0 truncP connP ;
  sT : isEquiv (HC P p0 T t0) (HC S2 base T t0) (\ b -> compC S2 base P p0 T t0 s b) = rep T t0 truncT connT ;
  module A2 = Two[S2, base, TR, P, p0, truncP, s, sP, sT] ;
  iso-S2-P : GIso[pi3 S2 base, pi3 P p0] = A2.iso-S2-P ;
} ;
