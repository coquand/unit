-- pi_4(S^3) = Z/2 (doc/br-universal.pdf, Theorems up and final), under the S^3
-- axiom only: the final declaration Pi4S3[S3, base, surf, ump3].pi4-S3 has no other
-- parameter.
--
-- Informal proof.
--   pi3-pe      a pointed equivalence X ~ Y gives pi3 X ~ pi3 Y as groups (loopPE twice,
--               then pi1-pe: LoopIso)
--   pi4-BR      pi4 BR = pi3 (Omega BR) (by definition) ~ pi3 R (pi3-pe at omega-BR)
--               ~ Z/2 (Triple[Z, Z/2, kbar].pi3-iso)
--   Two4        SphereUniversal.Two one level up, on classes only: for a level-4
--               truncation TR of S3 and a 4-type P with a class s such that s^* is
--               bijective into P and into T,
--                 u in [T, P]_* with [eta] ; u = s           (eta^* at P, TR.up)
--                 t in [P, T]_* with s ; t = [eta]           (s^* at T)
--                 s ; (t ; u) = [eta] ; u = s = s ; id       so t ; u = id_P (s^* at P)
--                 [eta] ; (u ; t) = s ; t = [eta] = [eta] ; id   so u ; t = id_T (eta^* at T)
--               hence pi4C u, pi4C t are inverse isomorphisms (pi4C-comp, pi4C-id) and
--               pi4 S3 ~ pi4 T ~ pi4 P (TR.pi4-eta)
--   Assemble4   the instance P = BR, s = SourceS3.Final.s, s^* at BR = Final.rep-fib at
--               (Z, Z/2, Fhat) (BR = Fib Fhat literally: sP), s^* at T = Final4.rep-T;
--               pi4 S3 ~ pi4 BR ~ Z/2
--   Pi4S3       Assemble4 at the constructed truncation Sphere3Trunc.trunc4
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open HLevels[l] ; open Connected[l] ;
open Lemma4[l] ; open DeloopMaps[l] ; open LoopCalc[l] ; open Torsor[l] ;
open EMMaps[l] ; open SphereAxiom[l] ; open SphereUniversal[l] ; open PostnikovRealization[l] ; open KZ2Cohomology[l] ; open Z2[l] ;
open Group[l] ; open HomotopyClasses[l] ; open HomotopyGroups[l] ; open LoopIso[l] ;
module E = Equivalences[l] ; module S3A = Sphere3Axiom[l] ;
module MB = MapBR[l] ; module DR = DeloopR[l] ; module S3S = SourceS3[l] ; module S3T = Sphere3Trunc[l] ; module P4 = Presentation4[l] ;

------------------------------------------------------------------------
-- pi4 BR = Z/2

pi3-pe (X : U l) (x0 : X) (Y : U l) (y0 : Y) (e : PtEquiv X x0 Y y0) : GIso[pi3 X x0, pi3 Y y0] =
  pi1-pe (O2 X x0) (refl (refl x0)) (O2 Y y0) (refl (refl y0))
    (loopPE (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0) (loopPE X x0 Y y0 e)) ;

pi4-BR : GIso[S3T.pi4 DR.BR DR.br0, ab-grp Z2ab] =
  gi-comp (S3T.pi4 DR.BR DR.br0) (pi3 DR.TR.F DR.TR.f0) (ab-grp Z2ab)
    (pi3-pe (Id DR.BR DR.br0 DR.br0) (refl DR.br0) DR.TR.F DR.TR.f0 DR.omega-BR) DR.TR.pi3-iso ;

------------------------------------------------------------------------
-- Theorem final, as SphereUniversal.Two one level up

module Two4 (S3 : U l) (base : S3) (TR : S3T.Interfaces4[S3, base].Trunc4) (P : U l) (p0 : P) (truncP : isTrunc (suc five) P)
  (s : HC S3 base P p0)
  (sP : isEquiv (HC P p0 P p0) (HC S3 base P p0) (\ b -> compC S3 base P p0 P p0 s b))
  (sT : isEquiv (HC P p0 TR.T TR.t0) (HC S3 base TR.T TR.t0) (\ b -> compC S3 base P p0 TR.T TR.t0 s b)) {
  open TR ;
  -- [eta]
  e : HC S3 base T t0 = hcl S3 base T t0 eta ;

  -- eta^* on classes into P and into T
  etaP : isEquiv (HC T t0 P p0) (HC S3 base P p0) (\ b -> compC S3 base T t0 P p0 e b) =
    pre-equiv S3 base T t0 P p0 eta (up P p0 truncP) ;
  etaT : isEquiv (HC T t0 T t0) (HC S3 base T t0) (\ b -> compC S3 base T t0 T t0 e b) =
    pre-equiv S3 base T t0 T t0 eta (up T t0 truncT) ;

  u : HC T t0 P p0 = etaP.sec s ;
  u-eq : Id (HC S3 base P p0) (compC S3 base T t0 P p0 e u) s = etaP.sec-eq s ;
  t : HC P p0 T t0 = sT.sec e ;
  t-eq : Id (HC S3 base T t0) (compC S3 base P p0 T t0 s t) e = sT.sec-eq e ;

  tu : Id (HC P p0 P p0) (compC P p0 T t0 P p0 t u) (idC P p0) =
    E.injective (HC P p0 P p0) (HC S3 base P p0) (\ b -> compC S3 base P p0 P p0 s b) sP _ _
      (calc (HC S3 base P p0) {
        compC S3 base P p0 P p0 s (compC P p0 T t0 P p0 t u)
          =< symH (comp-assoc S3 base P p0 T t0 P p0 s t u) >
        compC S3 base T t0 P p0 (compC S3 base P p0 T t0 s t) u
          =< apH (\ c -> compC S3 base T t0 P p0 c u) t-eq >
        compC S3 base T t0 P p0 e u
          =< u-eq >
        s
          =< symH (comp-idr S3 base P p0 s) >
        compC S3 base P p0 P p0 s (idC P p0) }) ;

  ut : Id (HC T t0 T t0) (compC T t0 P p0 T t0 u t) (idC T t0) =
    E.injective (HC T t0 T t0) (HC S3 base T t0) (\ b -> compC S3 base T t0 T t0 e b) etaT _ _
      (calc (HC S3 base T t0) {
        compC S3 base T t0 T t0 e (compC T t0 P p0 T t0 u t)
          =< symH (comp-assoc S3 base T t0 P p0 T t0 e u t) >
        compC S3 base P p0 T t0 (compC S3 base T t0 P p0 e u) t
          =< apH (\ c -> compC S3 base P p0 T t0 c t) u-eq >
        compC S3 base P p0 T t0 s t
          =< t-eq >
        e
          =< symH (comp-idr S3 base T t0 e) >
        compC S3 base T t0 T t0 e (idC T t0) }) ;

  -- pi4 of the two classes are inverse isomorphisms
  iso-T-P : GIso[S3T.pi4 T t0, S3T.pi4 P p0] =
    new GIso[S3T.pi4 T t0, S3T.pi4 P p0, S3T.pi4C T t0 P p0 u, S3T.pi4C P p0 T t0 t,
     \ x -> transH (symH (S3T.pi4C-comp T t0 P p0 T t0 u t x))
              (transH (apH (\ c -> (S3T.pi4C T t0 T t0 c).1 x) ut) (S3T.pi4C-id T t0 x)),
     \ y -> transH (symH (S3T.pi4C-comp P p0 T t0 P p0 t u y))
              (transH (apH (\ c -> (S3T.pi4C P p0 P p0 c).1 y) tu) (S3T.pi4C-id P p0 y))] ;

  iso-S3-T : GIso[S3T.pi4 S3 base, S3T.pi4 T t0] = gi-of-equiv (S3T.pi4 S3 base) (S3T.pi4 T t0) (S3T.pi4-map S3 base T t0 eta) pi4-eta ;

  iso-S3-P : GIso[S3T.pi4 S3 base, S3T.pi4 P p0] = gi-comp (S3T.pi4 S3 base) (S3T.pi4 T t0) (S3T.pi4 P p0) iso-S3-T iso-T-P ;
} ;

------------------------------------------------------------------------
-- the instance P = BR

module Assemble4 (S3 : U l) (base : S3) (surf : S3A.O3 S3 base)
  (ump3 : (X : U l) -> isEquiv (S3 -> X) ((x : X) * S3A.O3 X x) (S3A.ev3 S3 base surf X)) (TR : S3T.Interfaces4[S3, base].Trunc4) {
  module FS = S3S.Final[S3, base, surf, ump3] ;
  module F4 = P4.Final4[S3, base, surf, ump3, TR] ;
  -- Theorem main at the triple (Z, Z/2, Fhat), whose fibre is BR (the one boundary
  -- conversion Triple3[Z, Z/2, Fhat].F = BR, as in Final.s)
  sP : isEquiv (HC DR.BR DR.br0 DR.BR DR.br0) (HC S3 base DR.BR DR.br0) (\ b -> compC S3 base DR.BR DR.br0 DR.BR DR.br0 FS.s b) =
    FS.rep-fib Zab Z2ab DR.Fhat ;
  module A2 = Two4[S3, base, TR, DR.BR, DR.br0, DR.BR-trunc, FS.s, sP, F4.rep-T] ;
  pi4-S3 : GIso[S3T.pi4 S3 base, ab-grp Z2ab] =
    gi-comp (S3T.pi4 S3 base) (S3T.pi4 DR.BR DR.br0) (ab-grp Z2ab) A2.iso-S3-P pi4-BR ;
} ;

------------------------------------------------------------------------
-- Theorem final: pi_4(S^3) = Z/2, from the S^3 axiom alone

module Pi4S3 (S3 : U l) (base : S3) (surf : S3A.O3 S3 base)
  (ump3 : (X : U l) -> isEquiv (S3 -> X) ((x : X) * S3A.O3 X x) (S3A.ev3 S3 base surf X)) {
  pi4-S3 : GIso[S3T.pi4 S3 base, ab-grp Z2ab] =
    Assemble4[S3, base, surf, ump3, S3T.Sphere3Trunc[S3, base, surf, ump3].trunc4].pi4-S3 ;
} ;
