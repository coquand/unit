-- A Postnikov presentation of T = ||S2||_3, and pi3 S2 = Z
-- (doc/postnikov-presentation.pdf; numbers below are those of the note).
--   deloop-equiv     Lemma 5: an equivalence of loop spaces with a contractible
--                    space of deloopings deloops to a pointed equivalence
--                    (Whitehead)
--   O3               Definition 6: Omega^3 F as an abelian group (EH)
--   Rec              Proposition 7: a 2-connected 3-type F is K(Omega^3 F, 3):
--                    G1 (Cor. 12, the band), G2, e3 (Cor. 11, c = 1, 2)
--   Pres[S2, .., TR] for a 3-truncation TR of S2:
--     section 2      r, phi, psi (Def. 1), psi-phi, r-psi, phi-psi (Lemma 2),
--                    psi-equiv (Prop. 3): V = ||T||_2 is K(Z,2)
--     section 4      E z the fibres of u, RF (B = Omega^3 E v0, e3), q-set
--                    (Lemma 9), ext (Lemma 8: Lemma 4 with t = 0, c = 2),
--                    mu', mu (Def. 10)
--     section 5      K4-def, pt4-def, tau; tor-fib, tor, tor-el (Lemma 11);
--                    k1, c, kp (Def. 12); tot (Prop. 13)
--     section 6      kT (Def. 14), fib-kT (Prop. 15), pres-pt, pres (Thm 16)
--   Final[S2, ..]    sT (Cor. 17: the mapping theorem at T), A2
--                    (SphereUniversal.Two, Prop. 18), pi3-S2 (Theorem 19):
--                    pi3 S2 = Z as groups, from the sphere axiom alone
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ; open HLevels[l] ; open Connected[l] ;
open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ; open LoopCalc[l] ; open Torsor[l] ;
open EMMaps[l] ; open SphereAxiom[l] ; open SphereUniversal[l] ; open PostnikovRealization[l] ; open KZ2Cohomology[l] ;
open Group[l] ; open HomotopyClasses[l] ; open HomotopyGroups[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Eq = Equivalences[l] ; module W = Whitehead[l] ; module G = Groupoid[l] ; module Fb = Fibres[l] ;
module TS = Truncations[l] ; module P1 = Prelude[l+] ; module EMf = EM[l] ; module TRP = TruncationProps[l] ; module MF = MapFib[l] ; module ST = SphereTruncation[l] ; module CS = CupSquare[l] ;

six : Nat = suc five ;

------------------------------------------------------------------------
-- section 3: recognising K(B,3)

-- Lemma 5
deloop-equiv (A : U l) (a0 : A) (Y : U l) (y0 : Y) (cA : isConn two A) (cY : isConn two Y)
  (f : Maps[A, a0, Y, y0].PMO) (ef : isEquiv (Id A a0 a0) (Id Y y0 y0) f.1)
  (u : isContr Maps[A, a0, Y, y0].Over[f].Unloop) : PtEquiv A a0 Y y0 =
  (u.1.1, W.Pointed[A, a0, Y, y0, u.1.1, cA,
     Eq.homotopy (Id A a0 a0) (Id Y y0 y0) (f.1, ef) (Maps[A, a0, Y, y0].loop u.1.1).1
       (\ q -> sym (Id Y y0 y0) (f.1 q) ((Maps[A, a0, Y, y0].loop u.1.1).1 q)
          (happly (Id A a0 a0) (\ q1 -> Id Y y0 y0) f.1 (Maps[A, a0, Y, y0].loop u.1.1).1
             (ap (Maps[A, a0, Y, y0].PMO) (Id A a0 a0 -> Id Y y0 y0) (\ g -> g.1) f (Maps[A, a0, Y, y0].loop u.1.1) u.1.2) q))].equiv cY) ;

-- Definition 6
module O3 (F : U l) (f0 : F) (tF : isTrunc five F) {
  X1 : U l = O2 F f0 ;
  x1 : X1 = refl (refl f0) ;
  A3 : U l = Id X1 x1 x1 ;
  add (x y : A3) : A3 = trans X1 x1 x1 x1 x y ;
  set : isSet A3 = \ x y -> trunc-one-prop (Id A3 x y) (tF f0 f0 (refl f0) (refl f0) x1 x1 x y) ;
  ab : Ab = new Ab[A3, set, refl x1, add, sym X1 x1 x1,
    \ x y w -> G.tassoc X1 x1 x1 x1 x y x1 w,
    EH[l].EH[Id F f0 f0, refl f0].eh,
    \ x -> refl x,
    G.trans-sym-r X1 x1 x1] ;
} ;

-- Proposition 7
module Rec (F : U l) (f0 : F) (cF : isConn four F) (tF : isTrunc five F) {
  module O = O3[F, f0, tF] ;
  open O ;
  module KB = KK[ab] ;
  -- levels
  cY2 : isConn three (Id F f0 f0) = conn-id three F cF f0 f0 ;
  cX1 : isConn two X1 = conn-id two (Id F f0 f0) cY2 (refl f0) (refl f0) ;
  tX1 : isTrunc three X1 = tF f0 f0 (refl f0) (refl f0) ;
  -- step 1: the band of K(B,1) = EM1.K1, Corollary 12
  f1 : Maps[KB.E1.K1, KB.E1.k0, X1, x1].PMO = (KB.E1.band KB.E1.k0, KB.E1.band-unit KB.E1.k0) ;
  cell1 : isContr Maps[KB.E1.K1, KB.E1.k0, X1, x1].Over[f1].Unloop =
    Maps[KB.E1.K1, KB.E1.k0, X1, x1].Over[f1].Mult[KB.E1.conn1, tX1, KB.E1.band-hom KB.E1.k0].cor12 ;
  G1 : PtEquiv KB.E1.K1 KB.E1.k0 X1 x1 =
    deloop-equiv KB.E1.K1 KB.E1.k0 X1 x1 KB.E1.conn1 cX1 f1 (KB.E1.band-equiv KB.E1.k0).2 cell1 ;
  -- step 2: Corollary 11, c = 1
  f2 : Maps[KB.K two, KB.pt two, Id F f0 f0, refl f0].PMO =
    ptcomp (Id (KB.K two) (KB.pt two) (KB.pt two)) (refl (KB.pt two)) KB.E1.K1 KB.E1.k0 X1 x1 (KB.e (suc zero)).1 G1.1 ;
  cell2 : isContr Maps[KB.K two, KB.pt two, Id F f0 f0, refl f0].Over[f2].Unloop =
    Maps[KB.K two, KB.pt two, Id F f0 f0, refl f0].Over[f2].cor11 (suc zero) (KB.conn (suc zero)) (tF f0 f0) ;
  G2 : PtEquiv (KB.K two) (KB.pt two) (Id F f0 f0) (refl f0) =
    deloop-equiv (KB.K two) (KB.pt two) (Id F f0 f0) (refl f0) (conn-zero (suc zero) (KB.K two) (KB.conn (suc zero)))
      (conn-zero (suc zero) (Id F f0 f0) cY2) f2
      (Eq.compose (Id (KB.K two) (KB.pt two) (KB.pt two)) KB.E1.K1 X1
         ((KB.e (suc zero)).1.1, (KB.e (suc zero)).2) (G1.1.1, G1.2)).2 cell2 ;
  -- step 3: Corollary 11, c = 2
  f3 : Maps[KB.K three, KB.pt three, F, f0].PMO =
    ptcomp (Id (KB.K three) (KB.pt three) (KB.pt three)) (refl (KB.pt three)) (KB.K two) (KB.pt two) (Id F f0 f0) (refl f0) (KB.e two).1 G2.1 ;
  cell3 : isContr Maps[KB.K three, KB.pt three, F, f0].Over[f3].Unloop =
    Maps[KB.K three, KB.pt three, F, f0].Over[f3].cor11 two (KB.conn two) (trunc-suc five F tF) ;
  e3 : PtEquiv (KB.K three) (KB.pt three) F f0 =
    deloop-equiv (KB.K three) (KB.pt three) F f0 (conn-zero two (KB.K three) (KB.conn two)) (conn-zero two F cF) f3
      (Eq.compose (Id (KB.K three) (KB.pt three) (KB.pt three)) (KB.K two) (Id F f0 f0)
         ((KB.e two).1.1, (KB.e two).2) (G2.1.1, G2.2)).2 cell3 ;
} ;

------------------------------------------------------------------------
-- section 2: V = ||T||_2 is K(Z,2)

module Pres (S2 : U l) (base : S2) (surf : O2 S2 base)
  (ump : (X : U l) -> isEquiv (S2 -> X) ((x : X) * O2 X x) (ev2 S2 base surf X)) (TR : Interfaces[S2, base].Trunc3) {
  open TR ;
  module SS = MF.SourceS[S2, base, surf, ump] ;
  module UP = TRP.PtUP[four, TS.TO three, T, t0] ;
  -- the 2-truncation of T
  V : U l = (TS.TO three).T T ;
  v0 : V = (TS.TO three).unit T t0 ;
  tV : isTrunc four V = (TS.TO three).trunc T ;
  tK2 : isTrunc four KZ2 = KK[Zab].trunc (suc zero) ;

  -- Definition 1
  r : PtMap T t0 KZ2 kz2 = (up KZ2 kz2 (trunc-suc four KZ2 tK2)).sec SS.sigma ;
  r-eq : Id (PtMap S2 base KZ2 kz2) (ptcomp S2 base T t0 KZ2 kz2 eta r) SS.sigma = (up KZ2 kz2 (trunc-suc four KZ2 tK2)).sec-eq SS.sigma ;
  phi : PtMap V v0 KZ2 kz2 = (UP.up KZ2 kz2 tK2).sec r ;
  phi-eq : Id (PtMap T t0 KZ2 kz2) (ptcomp T t0 V v0 KZ2 kz2 UP.eta phi) r = (UP.up KZ2 kz2 tK2).sec-eq r ;
  psi : PtMap KZ2 kz2 V v0 = SS.Sig[V, v0, tV].sigma-star.sec (ptcomp S2 base T t0 V v0 eta UP.eta) ;
  psi-eq : Id (PtMap S2 base V v0) (ptcomp S2 base KZ2 kz2 V v0 SS.sigma psi) (ptcomp S2 base T t0 V v0 eta UP.eta) =
    SS.Sig[V, v0, tV].sigma-star.sec-eq (ptcomp S2 base T t0 V v0 eta UP.eta) ;

  -- Lemma 2
  psi-phi : Id (PtMap KZ2 kz2 KZ2 kz2) (ptcomp KZ2 kz2 V v0 KZ2 kz2 psi phi) (ptid KZ2 kz2) =
    Eq.injective (PtMap KZ2 kz2 KZ2 kz2) (PtMap S2 base KZ2 kz2) (\ G1 -> ptcomp S2 base KZ2 kz2 KZ2 kz2 SS.sigma G1)
      SS.Sig[KZ2, kz2, tK2].sigma-star _ _ (calc (PtMap S2 base KZ2 kz2) {
        ptcomp S2 base KZ2 kz2 KZ2 kz2 SS.sigma (ptcomp KZ2 kz2 V v0 KZ2 kz2 psi phi)
          =< symH (ptcomp-assoc S2 base KZ2 kz2 V v0 KZ2 kz2 SS.sigma psi phi) >
        ptcomp S2 base V v0 KZ2 kz2 (ptcomp S2 base KZ2 kz2 V v0 SS.sigma psi) phi
          =< apH (\ c -> ptcomp S2 base V v0 KZ2 kz2 c phi) psi-eq >
        ptcomp S2 base V v0 KZ2 kz2 (ptcomp S2 base T t0 V v0 eta UP.eta) phi
          =< ptcomp-assoc S2 base T t0 V v0 KZ2 kz2 eta UP.eta phi >
        ptcomp S2 base T t0 KZ2 kz2 eta (ptcomp T t0 V v0 KZ2 kz2 UP.eta phi)
          =< apH (ptcomp S2 base T t0 KZ2 kz2 eta) phi-eq >
        ptcomp S2 base T t0 KZ2 kz2 eta r
          =< r-eq >
        SS.sigma
          =< symH (Fb.ptcomp-idr S2 base KZ2 kz2 SS.sigma) >
        ptcomp S2 base KZ2 kz2 KZ2 kz2 SS.sigma (ptid KZ2 kz2) }) ;
  r-psi : Id (PtMap T t0 V v0) (ptcomp T t0 KZ2 kz2 V v0 r psi) UP.eta =
    Eq.injective (PtMap T t0 V v0) (PtMap S2 base V v0) (\ G1 -> ptcomp S2 base T t0 V v0 eta G1)
      (up V v0 (trunc-suc four V tV)) _ _ (calc (PtMap S2 base V v0) {
        ptcomp S2 base T t0 V v0 eta (ptcomp T t0 KZ2 kz2 V v0 r psi)
          =< symH (ptcomp-assoc S2 base T t0 KZ2 kz2 V v0 eta r psi) >
        ptcomp S2 base KZ2 kz2 V v0 (ptcomp S2 base T t0 KZ2 kz2 eta r) psi
          =< apH (\ c -> ptcomp S2 base KZ2 kz2 V v0 c psi) r-eq >
        ptcomp S2 base KZ2 kz2 V v0 SS.sigma psi
          =< psi-eq >
        ptcomp S2 base T t0 V v0 eta UP.eta }) ;
  phi-psi : Id (PtMap V v0 V v0) (ptcomp V v0 KZ2 kz2 V v0 phi psi) (ptid V v0) =
    Eq.injective (PtMap V v0 V v0) (PtMap T t0 V v0) (\ G1 -> ptcomp T t0 V v0 V v0 UP.eta G1)
      (UP.up V v0 tV) _ _ (calc (PtMap T t0 V v0) {
        ptcomp T t0 V v0 V v0 UP.eta (ptcomp V v0 KZ2 kz2 V v0 phi psi)
          =< symH (ptcomp-assoc T t0 V v0 KZ2 kz2 V v0 UP.eta phi psi) >
        ptcomp T t0 KZ2 kz2 V v0 (ptcomp T t0 V v0 KZ2 kz2 UP.eta phi) psi
          =< apH (\ c -> ptcomp T t0 KZ2 kz2 V v0 c psi) phi-eq >
        ptcomp T t0 KZ2 kz2 V v0 r psi
          =< r-psi >
        UP.eta
          =< symH (Fb.ptcomp-idr T t0 V v0 UP.eta) >
        ptcomp T t0 V v0 V v0 UP.eta (ptid V v0) }) ;

  -- Proposition 3
  psi-equiv : isEquiv KZ2 V psi.1 =
    qinv KZ2 V psi.1 phi.1
      (happly V (\ z -> V) (\ z -> psi.1 (phi.1 z)) (\ z -> z) (apH (\ g -> g.1) phi-psi))
      (happly KZ2 (\ x -> KZ2) (\ x -> phi.1 (psi.1 x)) (\ x -> x) (apH (\ g -> g.1) psi-phi)) ;

  ----------------------------------------------------------------------
  -- section 4: homogeneity of the fibres of u

  E (z : V) : U l = W.fib T V ((TS.TO three).unit T) z ;
  e-conn (z : V) : isConn four (E z) = (TS.TO three).conn T z ;
  e-trunc (z : V) : isTrunc five (E z) =
    trunc-Sigma five T (\ t -> Id V ((TS.TO three).unit T t) z) truncT
      (\ t -> trunc-suc four (Id V ((TS.TO three).unit T t) z) (trunc-suc three (Id V ((TS.TO three).unit T t) z) (tV ((TS.TO three).unit T t) z))) ;
  f0 : E v0 = (t0, refl v0) ;
  -- B = Omega^3 F0 and e0 : K(B,3) ~pt F0 (Proposition 7)
  module RF = Rec[E v0, f0, e-conn v0, e-trunc v0] ;
  open RF ;
  Q (t : T) : U l = PtEquiv (KB.K three) (KB.pt three) (E ((TS.TO three).unit T t)) (t, refl ((TS.TO three).unit T t)) ;
  -- Lemma 9
  q-set (t : T) : isTrunc two (Q t) =
    cor5-equiv (suc zero) three (KB.K three) (KB.pt three) (KB.conn two) (E ((TS.TO three).unit T t)) (t, refl ((TS.TO three).unit T t))
      (e-trunc ((TS.TO three).unit T t)) ;
  -- Lemma 8
  ext : isContr (PtSec T t0 Q e3) = lemma4 zero two T t0 connT Q q-set e3 ;
  -- Definition 10
  mu' (t : T) : Q t = ext.1.1 t ;
  mu (z : V) (y : E z) : PtEquiv (KB.K three) (KB.pt three) (E z) y =
    idJ V ((TS.TO three).unit T y.1) (\ z1 p1 -> PtEquiv (KB.K three) (KB.pt three) (E z1) (y.1, p1)) (mu' y.1) z y.2 ;

  ----------------------------------------------------------------------
  -- section 5: the classifying map

  -- K(B,4) is the type of K(B,3)-torsors (EM, Step), by definition
  module DS = EMf.Step[suc zero, EMf.EMn[O.ab].Kstage (suc zero)] ;
  K4-def : Id (U l) (KB.K four) DS.T.Tor = refl (KB.K four) ;
  pt4-def : Id DS.T.Tor (KB.pt four) DS.D.ptT = refl (KB.pt four) ;
  K3-def : Id (U l) (KB.K three) (EMf.EMn[O.ab].Kstage (suc zero)).X = refl (KB.K three) ;
  -- (pt = t) ~ el t (the fundamental theorem of Deloop)
  tau (t : DS.T.Tor) : Equiv (Id DS.T.Tor DS.D.ptT t) (DS.T.el t.1) = (DS.D.F.tr t, DS.D.F.equiv t) ;

  -- Lemma 11
  tor-fib (Y : U l) (inh : Tr.Trunc[Y].carrier) (m : DS.T.Mu Y) : DS.T.Fib Y =
    TC.rec Y @(l+) (DS.T.Fib Y) (DS.T.fib-prop Y) (\ y -> (DS.T.fib-contr Y (inh, m, y)).1) inh ;
  tor (Y : U l) (inh : Tr.Trunc[Y].carrier) (m : DS.T.Mu Y) : DS.T.Tor =
    ((tor-fib Y inh m).1,
     P1.subst (U l) (\ Z -> Tr.Trunc[Z].carrier * DS.T.Mu Z) Y (DS.T.el (tor-fib Y inh m).1)
       (P1.sym (U l) (DS.T.el (tor-fib Y inh m).1) Y (tor-fib Y inh m).2) (inh, m)) ;
  tor-el (Y : U l) (inh : Tr.Trunc[Y].carrier) (m : DS.T.Mu Y) : Id (U l) (DS.T.el (tor Y inh m).1) Y = (tor-fib Y inh m).2 ;

  -- Definition 12
  k1 (z : V) : DS.T.Tor = tor (E z) (conn-inh three (E z) (e-conn z)) (mu z) ;
  c (z : V) : Equiv (DS.T.el (k1 z).1) (E z) = Axioms[l].idtoeqv (DS.T.el (k1 z).1) (E z) (tor-el (E z) (conn-inh three (E z) (e-conn z)) (mu z)) ;
  kp : PtMap V v0 (KB.K four) (KB.pt four) =
    (k1, sym DS.T.Tor DS.D.ptT (k1 v0) ((tau (k1 v0)).2.sec ((c v0).2.sec f0))) ;

  -- Proposition 13
  sym-equiv (X : U l) (x y : X) : Equiv (Id X x y) (Id X y x) =
    (sym X x y, qinv (Id X x y) (Id X y x) (sym X x y) (sym X y x) (G.sym-sym X y x) (G.sym-sym X x y)) ;
  tot-ret (t : T) (z : V) (p : Id V ((TS.TO three).unit T t) z) :
    Id ((z1 : V) * E z1) ((TS.TO three).unit T t, (t, refl ((TS.TO three).unit T t))) (z, (t, p)) =
    idJ V ((TS.TO three).unit T t) (\ z1 p1 -> Id ((z2 : V) * E z2) ((TS.TO three).unit T t, (t, refl ((TS.TO three).unit T t))) (z1, (t, p1)))
      (refl ((TS.TO three).unit T t, (t, refl ((TS.TO three).unit T t)))) z p ;
  tot-fib : Equiv ((z : V) * E z) T =
    (\ w -> w.2.1, qinv ((z : V) * E z) T (\ w -> w.2.1) (\ t -> ((TS.TO three).unit T t, (t, refl ((TS.TO three).unit T t))))
       (\ t -> refl t) (\ w -> tot-ret w.2.1 w.1 w.2.2)) ;
  tot : Equiv (Fb.Fib V v0 (KB.K four) (KB.pt four) kp) T =
    Eq.compose (Fb.Fib V v0 (KB.K four) (KB.pt four) kp) ((z : V) * Id DS.T.Tor DS.D.ptT (k1 z)) T
      (Fb.sigma-equiv V (\ z -> Id DS.T.Tor (k1 z) DS.D.ptT) (\ z -> Id DS.T.Tor DS.D.ptT (k1 z)) (\ z -> sym-equiv DS.T.Tor (k1 z) DS.D.ptT))
      (Eq.compose ((z : V) * Id DS.T.Tor DS.D.ptT (k1 z)) ((z : V) * DS.T.el (k1 z).1) T
         (Fb.sigma-equiv V (\ z -> Id DS.T.Tor DS.D.ptT (k1 z)) (\ z -> DS.T.el (k1 z).1) (\ z -> tau (k1 z)))
         (Eq.compose ((z : V) * DS.T.el (k1 z).1) ((z : V) * E z) T
            (Fb.sigma-equiv V (\ z -> DS.T.el (k1 z).1) E c) tot-fib)) ;

  ----------------------------------------------------------------------
  -- section 6: the presentation

  -- Definition 14
  kT : PtMap KZ2 kz2 (KB.K four) (KB.pt four) = ptcomp KZ2 kz2 V v0 (KB.K four) (KB.pt four) psi kp ;
  -- by definition
  kT-def : Id (KZ2 -> KB.K four) kT.1 (\ x -> k1 (psi.1 x)) = refl kT.1 ;
  -- Proposition 15
  fib-kT : Equiv Triple[Zab, O.ab, kT].F T =
    Eq.compose Triple[Zab, O.ab, kT].F (Fb.Fib V v0 (KB.K four) (KB.pt four) kp) T
      ((\ w -> (psi.1 w.1, w.2)), sigma-base KZ2 V (psi.1, psi-equiv) (\ z -> Id (KB.K four) (k1 z) (KB.pt four))) tot ;
  -- Theorem 16: B, kT, fib-kT, and the pointing, merely (T is 0-connected)
  pres-pt : Tr.Trunc[Id T (fib-kT.1 Triple[Zab, O.ab, kT].f0) t0].carrier =
    conn-path (suc zero) T connT (fib-kT.1 Triple[Zab, O.ab, kT].f0) t0 ;
  pres (a : Id T (fib-kT.1 Triple[Zab, O.ab, kT].f0) t0) : PtEquiv Triple[Zab, O.ab, kT].F Triple[Zab, O.ab, kT].f0 T t0 =
    ((fib-kT.1, a), fib-kT.2) ;
} ;

------------------------------------------------------------------------
-- section 7: the mapping theorem at T, and pi3 S2 = Z

module Final (S2 : U l) (base : S2) (surf : O2 S2 base)
  (ump : (X : U l) -> isEquiv (S2 -> X) ((x : X) * O2 X x) (ev2 S2 base surf X)) {
  module PR = Pres[S2, base, surf, ump, ST.SphereTrunc[S2, base, surf, ump].trunc3] ;
  module MFF = MF.Final[S2, base, surf, ump, CS.kappa, H4Proof[l].h4] ;
  module RP = Triple[Zab, Zab, CS.kappa] ;
  -- Corollary 17
  sT : isEquiv (HC RP.F RP.f0 ST.SphereTrunc[S2, base, surf, ump].trunc3.T ST.SphereTrunc[S2, base, surf, ump].trunc3.t0)
      (HC S2 base ST.SphereTrunc[S2, base, surf, ump].trunc3.T ST.SphereTrunc[S2, base, surf, ump].trunc3.t0)
      (\ b -> compC S2 base RP.F RP.f0 ST.SphereTrunc[S2, base, surf, ump].trunc3.T ST.SphereTrunc[S2, base, surf, ump].trunc3.t0 MFF.s b) =
    TC.rec (Id ST.SphereTrunc[S2, base, surf, ump].trunc3.T (PR.fib-kT.1 Triple[Zab, PR.RF.O.ab, PR.kT].f0) ST.SphereTrunc[S2, base, surf, ump].trunc3.t0) @l
      (isEquiv (HC RP.F RP.f0 ST.SphereTrunc[S2, base, surf, ump].trunc3.T ST.SphereTrunc[S2, base, surf, ump].trunc3.t0)
         (HC S2 base ST.SphereTrunc[S2, base, surf, ump].trunc3.T ST.SphereTrunc[S2, base, surf, ump].trunc3.t0)
         (\ b -> compC S2 base RP.F RP.f0 ST.SphereTrunc[S2, base, surf, ump].trunc3.T ST.SphereTrunc[S2, base, surf, ump].trunc3.t0 MFF.s b))
      (EquivProp[l].isEquiv-prop (HC RP.F RP.f0 ST.SphereTrunc[S2, base, surf, ump].trunc3.T ST.SphereTrunc[S2, base, surf, ump].trunc3.t0)
         (HC S2 base ST.SphereTrunc[S2, base, surf, ump].trunc3.T ST.SphereTrunc[S2, base, surf, ump].trunc3.t0)
         (\ b -> compC S2 base RP.F RP.f0 ST.SphereTrunc[S2, base, surf, ump].trunc3.T ST.SphereTrunc[S2, base, surf, ump].trunc3.t0 MFF.s b))
      (\ a -> MFF.rep-pteq Zab PR.RF.O.ab PR.kT ST.SphereTrunc[S2, base, surf, ump].trunc3.T ST.SphereTrunc[S2, base, surf, ump].trunc3.t0 (PR.pres a))
      PR.pres-pt ;
  -- Proposition 18 (SphereUniversal.Two) and Theorem 19
  module A2 = Two[S2, base, ST.SphereTrunc[S2, base, surf, ump].trunc3, RP.F, RP.f0, RP.trunc5, MFF.s, MFF.rep-fib Zab Zab CS.kappa, sT] ;
  pi3-S2 : GIso[pi3 S2 base, ab-grp Zab] = gi-comp (pi3 S2 base) (pi3 RP.F RP.f0) (ab-grp Zab) A2.iso-S2-P RP.pi3-iso ;
} ;
