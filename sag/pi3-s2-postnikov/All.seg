-- pi_3(S^2) = Z by a Postnikov universal property (doc/pi3-s2-postnikov.pdf,
-- doc/pi3-s2-postnikov-handoff.txt).  The Theory parameters are those of
-- sag/em: univalence, images and their surjectivity; function
-- extensionality is derived.  The sphere is NOT a Theory parameter: it is
-- the parameter telescope of the segment SphereAxiom.Sphere (S2, base,
-- surf and the universal property of S2), the only axiom authorised.
import Base ; import Prelude ; import Paths ; import Axioms ; import FunExtUA ;
import Replacement ; import Ring ;
module Theory
 (univ : [l] Axioms[l].Univalence)
 (images : [l] [k] Replacement[l,k].Images)
 (surjections : [l] [k] [j] (Replacement[l,k].Surjectivity (images @l @k)) @j) {
 fe : [l] Axioms[l].FunExt = <l> FunExtUA[l].FE[univ @l].fe ;
 opaque fe ;
 import Truncation ; import TruncationCombinators ; import FinChoice ; import Quotient ; import RingHom ; import Equivalences ;
 import Torsor ; import TorsorId ; import Groupoid ; import Gerbe ; import TrivialGerbe ;
 import NatArith ; import HLevels ; import Connected ; import EquivProp ; import Lemma4 ; import FundThm ; import TruncUp ; import PtEquivOps ; import Completion ; import Deloop ; import Retracts ; import DeloopMaps ; import Whitehead ; import EM ;
 import Group ; import LoopCalc ; import Fibres ; import EMMaps ; import Bijection ; import PiEquiv ;
 import QGrp ; import PiOne ; import Puppe ; import LoopConj ; import KFun ; import LiftUnique ; import FibMap ; import EH ;
 import Logic ; import Integers ;
 -- milestone A
 import SphereAxiom ; import HomotopyClasses ; import HomotopyGroups ;
 -- milestone B (conditional)
 import SphereUniversal ;
 -- milestone C (realization of Postnikov triples)
 import LoopIso ; import PostnikovRealization ;
 -- finite truncations and Trunc3 for S2 (doc/finite-truncation.pdf)
 import ConnectedMaps ; import Truncations ; import TruncationProps ; import SphereTruncation ;
 -- milestone D (statements only) and E (conditional on kappa and the mapping theorem)
 import KZ2Cohomology ; import Pi3Sphere ;
 -- the circle property of K(Z,1) and (H3) (doc/circle-torsors.pdf)
 import CircleProperty ; import H3Proof ;
 -- the cup square kappa (doc/cup-square.pdf)
 import CupSquare ;
 -- (H4) for the cup square (doc/h4.pdf)
 import H4Classes ; import H4Diagonal ; import H4Bilinear ; import H4Proof ;
 -- [Fib kappa, K(B,3)]_* = 0 (doc/fibre-h3.pdf)
 import FibreH3 ;
 -- the mapping theorem for targets Fib k (doc/mapping-fib.pdf)
 import MapFib ;
 -- a Postnikov presentation of ||S2||_3 (doc/postnikov-presentation.pdf)
 import Presentation ;
 -- towards pi_4(S^3) = Z/2: the cross term of the reduced cup square (doc/cross-term.pdf)
 import Z2 ; import Doubling ; import CrossTerm ; import DeloopR ;
 -- the marked universal property of BR (doc/br-universal.pdf)
 import Conj ; import Necessity ; import MapBR ;
 -- the S^3 axiom (segment parameters) and the source S^3 (doc/br-universal.pdf)
 import Sphere3Axiom ; import SourceS3 ; import Sphere3Trunc ; import Presentation4 ; import Pi4Sphere ;
 -- pointed simply connected 3-types ~ triples (A, B, k : K(A,2) ->pt K(B,4)) (doc/postnikov-classification.pdf)
 import ClassAb ; import ClassBase ; import ClassEM ; import ClassFib ; import ClassPost ; import PostnikovClassification ;
 -- pi3 S2 = Z through the classification (doc/postnikov-classification.pdf, section 9)
 import Pi3Classified ;
 -- delooping is an embedding SC4 -> SC3; deloopable triples (doc/delooping-embedding.pdf)
 import DeloopEmbedding ;
 import MarkLoop ;
 import CrossDeloop ;
 import TwoTorsion ;
 import MarkDirect ;
 import Pi4Direct ;
 -- arbitrary maps of Postnikov triples (doc/postnikov-morphisms.pdf)
 import TripleMaps ; import TripleMapsEquiv ; import TripleComponents ; import Pi3TripleUniversal ; import Pi4TripleUniversal ; import TripleHomotopy ;
} ;
