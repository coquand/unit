-- Isomorphisms of fundamental groups from maps of loop spaces.
--   loop-pe-equiv   the looping of a pointed equivalence is an equivalence
--                   (induction on pointed equivalences, Puppe.loop-id)
--   loopPE          Omega of a pointed equivalence, a pointed equivalence
--   LoopEquivIso    a pointed map whose looping is an equivalence induces
--                   an isomorphism pi_1 Y = pi_1 Z (the inverse descends
--                   from the inverse on loops; no choice)
--   pi1-pe          pi_1 of a pointed equivalence
--   ap-fst-equiv    a Sigma over propositions is a subtype: ap fst is an
--                   equivalence
--   ProjIso         for h : W -> E into a SET, fpr : Fib h -> W gives
--                   pi_1 (Fib h) = pi_1 W
--   LoopsSetIso     a multiplicative bijection from the loops of Y to a group
--                   H gives pi_1 Y = H
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Lemma4[l] ; open DeloopMaps[l] ; open LoopCalc[l] ; open PtEquivOps[l] ;
open Group[l] ; open HomotopyGroups[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module QG = QGrp[l] ;

loop-pe-equiv (X : U l) (x0 : X) (Y : U l) (y0 : Y) (e : PtEquiv X x0 Y y0) :
  isEquiv (Id X x0 x0) (Id Y y0 y0) (Maps[X, x0, Y, y0].loop e.1).1 =
  ptEqInd X x0 (\ Z z p -> isEquiv (Id X x0 x0) (Id Z z z) (Maps[X, x0, Z, z].loop p.1).1)
    (Equivalences[l].homotopy (Id X x0 x0) (Id X x0 x0) (idEquiv (Id X x0 x0)) (Maps[X, x0, X, x0].loop (ptid X x0)).1
       (Puppe[l].loop-id X x0))
    Y y0 e ;

loopPE (X : U l) (x0 : X) (Y : U l) (y0 : Y) (e : PtEquiv X x0 Y y0) :
  PtEquiv (Id X x0 x0) (refl x0) (Id Y y0 y0) (refl y0) =
  (Maps[X, x0, Y, y0].loop e.1, loop-pe-equiv X x0 Y y0 e) ;

module LoopEquivIso (Y : U l) (y0 : Y) (Z : U l) (z0 : Z) (F : PtMap Y y0 Z z0)
  (eq : isEquiv (Id Y y0 y0) (Id Z z0 z0) (Maps[Y, y0, Z, z0].loop F).1) {
  module PY = PiOne[l].PiOne[Y, y0] ; module PZ = PiOne[l].PiOne[Z, z0] ;
  module I = PiOne[l].Induced[Y, y0, Z, z0, F] ;
  respect (u v : PZ.O) (h : PZ.Same u v) : Id PY.grp.G (PY.cls (eq.sec u)) (PY.cls (eq.sec v)) =
    PY.P.Q.relates (eq.sec u) (eq.sec v) (TC.map (Id PZ.O u v) (Id PY.O (eq.sec u) (eq.sec v)) (apH eq.sec) h) ;
  module D = PZ.P.Q.Descend[PY.grp.G, PY.grp.setG, \ u -> PY.cls (eq.sec u), respect] ;
  inv (x : PZ.grp.G) : PY.grp.G = D.map x ;
  fi (x : PZ.grp.G) : Id PZ.grp.G (I.map (inv x)) x =
    PZ.P.ind @l (\ x1 -> Id PZ.grp.G (I.map (inv x1)) x1) (\ x1 -> PZ.grp.setG _ _)
      (\ u -> calc PZ.grp.G {
         I.map (inv (PZ.cls u)) =< apH I.map (D.beta u) > I.map (PY.cls (eq.sec u))
           =< I.map-cls (eq.sec u) > PZ.cls ((Maps[Y, y0, Z, z0].loop F).1 (eq.sec u))
           =< apH PZ.cls (eq.sec-eq u) > PZ.cls u }) x ;
  if (x : PY.grp.G) : Id PY.grp.G (inv (I.map x)) x =
    PY.P.ind @l (\ x1 -> Id PY.grp.G (inv (I.map x1)) x1) (\ x1 -> PY.grp.setG _ _)
      (\ q -> calc PY.grp.G {
         inv (I.map (PY.cls q)) =< apH inv (I.map-cls q) > inv (PZ.cls ((Maps[Y, y0, Z, z0].loop F).1 q))
           =< D.beta ((Maps[Y, y0, Z, z0].loop F).1 q) > PY.cls (eq.sec ((Maps[Y, y0, Z, z0].loop F).1 q))
           =< apH PY.cls (sec-ret PY.O PZ.O (Maps[Y, y0, Z, z0].loop F).1 eq q) > PY.cls q }) x ;
  equiv : isEquiv PY.grp.G PZ.grp.G I.map = qinv PY.grp.G PZ.grp.G I.map inv fi if ;
  iso : GIso[PY.grp, PZ.grp] = gi-of-equiv PY.grp PZ.grp I.hom equiv ;
} ;

pi1-pe (X : U l) (x0 : X) (Y : U l) (y0 : Y) (e : PtEquiv X x0 Y y0) :
  GIso[PiOne[l].PiOne[X, x0].grp, PiOne[l].PiOne[Y, y0].grp] =
  LoopEquivIso[X, x0, Y, y0, e.1, loop-pe-equiv X x0 Y y0 e].iso ;

------------------------------------------------------------------------
-- subtypes

ap-fst-equiv (W : U l) (P : W -> U l) (pP : (w : W) -> isProp (P w)) (u v : (w : W) * P w) :
  isEquiv (Id ((w : W) * P w) u v) (Id W u.1 v.1) (ap ((w : W) * P w) W (\ z -> z.1) u v) =
  qinv (Id ((w : W) * P w) u v) (Id W u.1 v.1) (ap ((w : W) * P w) W (\ z -> z.1) u v)
    (\ p -> Sigma-path W P u.1 v.1 u.2 v.2 p (pP v.1 (subst W P u.1 v.1 p u.2) v.2))
    (\ p -> Fibres[l].fst-Sigma-path W P u.1 v.1 u.2 v.2 p (pP v.1 (subst W P u.1 v.1 p u.2) v.2))
    (\ Q -> idJ ((w : W) * P w) u (\ v1 Q1 -> Id (Id ((w : W) * P w) u v1)
         (Sigma-path W P u.1 v1.1 u.2 v1.2 (ap ((w : W) * P w) W (\ z -> z.1) u v1 Q1)
            (pP v1.1 (subst W P u.1 v1.1 (ap ((w : W) * P w) W (\ z -> z.1) u v1 Q1) u.2) v1.2)) Q1)
       (ap (Id (P u.1) u.2 u.2) (Id ((w : W) * P w) u u) (\ r -> Sigma-path W P u.1 u.1 u.2 u.2 (refl u.1) r)
          (pP u.1 u.2 u.2) (refl u.2) (prop-to-set (P u.1) (pP u.1) u.2 u.2 (pP u.1 u.2 u.2) (refl u.2)))
       v Q) ;

module ProjIso (W : U l) (w0 : W) (E : U l) (e0 : E) (h : PtMap W w0 E e0) (sE : isSet E) {
  open Fibres[l] ;
  -- ap fst is an equivalence on the loops at the base of Fib h
  ap-pr : isEquiv (Id (Fib W w0 E e0 h) (fpt W w0 E e0 h) (fpt W w0 E e0 h)) (Id W w0 w0)
      (ap (Fib W w0 E e0 h) W (\ z -> z.1) (fpt W w0 E e0 h) (fpt W w0 E e0 h)) =
    ap-fst-equiv W (\ w -> Id E (h.1 w) e0) (\ w -> sE (h.1 w) e0) (fpt W w0 E e0 h) (fpt W w0 E e0 h) ;
  -- the looping of fpr is ap fst, up to refl . -  (loop-ap, fpr pointed by refl)
  loop-eq : isEquiv (Id (Fib W w0 E e0 h) (fpt W w0 E e0 h) (fpt W w0 E e0 h)) (Id W w0 w0)
      (Maps[Fib W w0 E e0 h, fpt W w0 E e0 h, W, w0].loop (fpr W w0 E e0 h)).1 =
    Equivalences[l].homotopy (Id (Fib W w0 E e0 h) (fpt W w0 E e0 h) (fpt W w0 E e0 h)) (Id W w0 w0)
      (ap (Fib W w0 E e0 h) W (\ z -> z.1) (fpt W w0 E e0 h) (fpt W w0 E e0 h), ap-pr)
      (Maps[Fib W w0 E e0 h, fpt W w0 E e0 h, W, w0].loop (fpr W w0 E e0 h)).1
      (\ q -> transH (Maps[Fib W w0 E e0 h, fpt W w0 E e0 h, W, w0].loop-ap (fpr W w0 E e0 h) q)
                 (trans-refl-l W w0 w0 (ap (Fib W w0 E e0 h) W (\ z -> z.1) (fpt W w0 E e0 h) (fpt W w0 E e0 h) q))) ;
  iso : GIso[PiOne[l].PiOne[Fib W w0 E e0 h, fpt W w0 E e0 h].grp, PiOne[l].PiOne[W, w0].grp] =
    LoopEquivIso[Fib W w0 E e0 h, fpt W w0 E e0 h, W, w0, fpr W w0 E e0 h, loop-eq].iso ;
} ;

------------------------------------------------------------------------
-- loops onto a group

module LoopsSetIso (Y : U l) (y0 : Y) (H : Grp) (f : Id Y y0 y0 -> H.G) (eq : isEquiv (Id Y y0 y0) H.G f)
  (hom : (p q : Id Y y0 y0) -> Id H.G (f (trans Y y0 y0 y0 p q)) (H.mul (f p) (f q))) {
  module PY = PiOne[l].PiOne[Y, y0] ;
  respect (u v : PY.O) (h : PY.Same u v) : Id H.G (f u) (f v) =
    Tr.Trunc[Id PY.O u v].induction @l (\ t -> Id H.G (f u) (f v)) (\ t -> H.setG (f u) (f v)) (apH f) h ;
  module D = PY.P.Q.Descend[H.G, H.setG, f, respect] ;
  map (x : PY.grp.G) : H.G = D.map x ;
  mult (x y : PY.grp.G) : Id H.G (map (PY.grp.mul x y)) (H.mul (map x) (map y)) =
    PY.P.ind @l (\ x1 -> Id H.G (map (PY.grp.mul x1 y)) (H.mul (map x1) (map y))) (\ x1 -> H.setG _ _) (\ p ->
    PY.P.ind @l (\ y1 -> Id H.G (map (PY.grp.mul (PY.cls p) y1)) (H.mul (map (PY.cls p)) (map y1))) (\ y1 -> H.setG _ _) (\ q ->
      calc H.G {
        map (PY.grp.mul (PY.cls p) (PY.cls q)) =< apH map (PY.P.cls-mul p q) > map (PY.cls (PY.comp p q))
          =< D.beta (PY.comp p q) > f (PY.comp p q)
          =< hom p q > H.mul (f p) (f q)
          =< symH (transH (apH (\ a -> H.mul a (map (PY.cls q))) (D.beta p)) (apH (H.mul (f p)) (D.beta q))) >
        H.mul (map (PY.cls p)) (map (PY.cls q)) }) y) x ;
  inv (a : H.G) : PY.grp.G = PY.cls (eq.sec a) ;
  fi (a : H.G) : Id H.G (map (inv a)) a = transH (D.beta (eq.sec a)) (eq.sec-eq a) ;
  if (x : PY.grp.G) : Id PY.grp.G (inv (map x)) x =
    PY.P.ind @l (\ x1 -> Id PY.grp.G (inv (map x1)) x1) (\ x1 -> PY.grp.setG _ _)
      (\ q -> transH (apH inv (D.beta q)) (apH PY.cls (sec-ret PY.O H.G f eq q))) x ;
  iso : GIso[PY.grp, H] = gi-of-equiv PY.grp H (map, mult) (qinv PY.grp.G H.G map inv fi if) ;
} ;
