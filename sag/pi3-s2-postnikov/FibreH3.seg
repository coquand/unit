-- [Fib k, K(B,3)]_* = 0, for every abelian B (doc/fibre-h3.pdf), for any
-- k : K(Z,2) ->pt K(C,4) whose coefficient map is injective; used with
-- CupSquare.kappa and H4Proof.h4, and with CrossTerm.kbar (doc/br-universal.pdf, Prop. UR).
-- No Serre sequence: two facts for this fibration, with explicit
-- null-homotopies, and (H3) for the base.
--   Const, const-emb, const-prop   Lemma 1: over a 2-connected T the constant
--                 maps into a 3-truncated Z form an embedding, so Const d
--                 (d is constant, with its value) is a proposition
--   pi-mere       Lemma 2: pointed maps with equal underlying maps are merely
--                 equal when Omega Z is connected
--   reparam, TG.tg  Lemma 3 (a), (b): two J computations; cancel-v the
--                 groupoid identity u (v^-1 u)^-1 = v
--   Climb         Lemma 8, Cor. 9: G^flat = e^-1 ; loop G ; e; every
--                 K(Z,4) ->pt K(B,4) is K(g,4), g = inv4 G
--   PhiC          the coefficient map g |-> [k ; K(g,4)] of k : K(Z,2) ->pt K(C,4)
--   FibAtC[C, k, inj, B]  with P = Fib k, W = K(B,4), inj : PhiC injective
--                 (the only use of the cohomology of k, in Kill.g-eq):
--     res         Definition 4: the restriction of F : P ->pt Omega W to
--                 the fibre over the point, q |-> F (*, kappa0 . q)
--     deloop      Lemma 5: its unique delooping G_F (Corollary 11)
--     Trans       Proposition 6: if res F = loop G, d_x is constant on every
--                 fibre, so kappa ; G is merely 0
--     Exact       Proposition 7: if res F = 0, F (x, t) = H x and F is merely 0 by (H3)
--     Kill, contr Theorem 10: G_F = K(g,4) with Phi g = [0] = Phi g0, so
--                 g = g0 by inj, G_F = 0, res F = 0
--   FibAt[kappa, h4k, B]  the instance C = Z, inj from (H4)
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ; open HLevels[l] ; open Connected[l] ;
open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ; open LoopCalc[l] ; open Torsor[l] ;
open EMMaps[l] ; open AbHom[l] ; open HomotopyClasses[l] ; open SphereUniversal[l] ; open PostnikovRealization[l] ; open KZ2Cohomology[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module E = Equivalences[l] ; module W = Whitehead[l] ; module N = NatArith[l] ;

------------------------------------------------------------------------
-- Lemma 1

-- d is constant, with its value
Const (T Z : U l) (d : T -> Z) : U l = (z : Z) * Id (T -> Z) (\ t -> z) d ;

-- happly o ap const is the constant map of (z = z'), an equivalence (null)
const-emb (T Z : U l) (cT : isConn four T) (tZ : isTrunc five Z) (z z' : Z) :
  isEquiv (Id Z z z') (Id (T -> Z) (\ t -> z) (\ t -> z')) (ap Z (T -> Z) (\ y t -> y) z z') =
  W.cancel-equiv (Id Z z z') (Id (T -> Z) (\ t -> z) (\ t -> z')) (T -> Id Z z z')
    (ap Z (T -> Z) (\ y t -> y) z z') (happly T (\ t -> Z) (\ t -> z) (\ t -> z')) (fe @l T (\ t -> Z) (\ t -> z) (\ t -> z'))
    (E.homotopy (Id Z z z') (T -> Id Z z z') ((\ p t -> p), ConnectedMaps[l].null four T (Id Z z z') cT (tZ z z'))
       (\ p -> happly T (\ t -> Z) (\ t -> z) (\ t -> z') (ap Z (T -> Z) (\ y t -> y) z z' p))
       (\ p -> idJ Z z (\ z1 p1 -> Id (T -> Id Z z z1) (happly T (\ t -> Z) (\ t -> z) (\ t -> z1) (ap Z (T -> Z) (\ y t -> y) z z1 p1)) (\ t -> p1))
                 (refl (\ t -> refl z)) z' p)) ;

const-prop (T Z : U l) (cT : isConn four T) (tZ : isTrunc five Z) (d : T -> Z) : isProp (Const T Z d) =
  Groupoid[l].emb-fib-prop Z (T -> Z) (\ y t -> y) (const-emb T Z cT tZ) d ;

------------------------------------------------------------------------
-- Lemma 2

pi-mere (X : U l) (x0 : X) (Z : U l) (z0 : Z) (cO : isConn two (Id Z z0 z0)) (k k' : X -> Z) (e : Id (X -> Z) k k')
  (z : Id Z (k x0) z0) (z' : Id Z (k' x0) z0) : Tr.Trunc[Id (PtMap X x0 Z z0) (k, z) (k', z')].carrier =
  idJ (X -> Z) k (\ k1 e1 -> (z1 : Id Z (k1 x0) z0) -> Tr.Trunc[Id (PtMap X x0 Z z0) (k, z) (k1, z1)].carrier)
    (\ z1 -> TC.map (Id (Id Z z0 z0) (trans Z z0 (k x0) z0 (sym Z (k x0) z0 z) z1) (refl z0)) (Id (PtMap X x0 Z z0) (k, z) (k, z1))
       (\ r -> apH (\ w -> (k, w)) (transH (symH (apH (trans Z (k x0) z0 z0 z) r)) (Fibres[l].trans-cancel' Z (k x0) z0 z0 z z1)))
       (conn-path zero (Id Z z0 z0) cO (trans Z z0 (k x0) z0 (sym Z (k x0) z0 z) z1) (refl z0)))
    k' e z' ;

------------------------------------------------------------------------
-- Lemma 3

-- (a)
reparam (Y : U l) (y0 : Y) (C : U l) (c : C) : (y : Y) (k : Id Y y y0) (h : Id Y y y0 -> C)
  (e : (q : Id Y y0 y0) -> Id C (h (trans Y y y0 y0 k q)) c) (t : Id Y y y0) -> Id C (h t) c =
  idJR Y y0 (\ y1 k1 -> (h : Id Y y1 y0 -> C) (e : (q : Id Y y0 y0) -> Id C (h (trans Y y1 y0 y0 k1 q)) c) (t : Id Y y1 y0) -> Id C (h t) c)
    (\ h e t -> transH (apH h (symH (trans-refl-l Y y0 y0 t))) (e t)) ;

-- the groupoid identity  u . (w^-1 . u)^-1 = w
cancel-v (Z : U l) (c d : Z) (u w : Id Z c d) : Id (Id Z c d) (trans Z c d d u (sym Z d d (trans Z d c d (sym Z c d w) u))) w =
  idJ Z c (\ d1 u1 -> (w : Id Z c d1) -> Id (Id Z c d1) (trans Z c d1 d1 u1 (sym Z d1 d1 (trans Z d1 c d1 (sym Z c d1 w) u1))) w)
    (\ w -> transH (trans-refl-l Z c c (sym Z c c (sym Z c c w))) (Groupoid[l].sym-sym Z c c w)) d u w ;

-- (b)
module TG (Y : U l) (y0 : Y) (Wt : U l) (w0 : Wt) (G : PtMap Y y0 Wt w0) {
  module MG = Maps[Y, y0, Wt, w0] ;
  tg : (y : Y) (k : Id Y y y0) (h : Id Y y y0 -> Id Wt w0 w0)
    (e : (q : Id Y y0 y0) -> Id (Id Wt w0 w0) (h (trans Y y y0 y0 k q)) ((MG.loop G).1 q)) (t : Id Y y y0) ->
    Id (Id Wt (G.1 y) w0) (trans Wt (G.1 y) (G.1 y0) w0 (ap Y Wt G.1 y y0 k) G.2)
      (trans Wt (G.1 y) w0 w0 (trans Wt (G.1 y) (G.1 y0) w0 (ap Y Wt G.1 y y0 t) G.2) (sym Wt w0 w0 (h t))) =
    idJR Y y0 (\ y1 k1 -> (h : Id Y y1 y0 -> Id Wt w0 w0)
        (e : (q : Id Y y0 y0) -> Id (Id Wt w0 w0) (h (trans Y y1 y0 y0 k1 q)) ((MG.loop G).1 q)) (t : Id Y y1 y0) ->
        Id (Id Wt (G.1 y1) w0) (trans Wt (G.1 y1) (G.1 y0) w0 (ap Y Wt G.1 y1 y0 k1) G.2)
          (trans Wt (G.1 y1) w0 w0 (trans Wt (G.1 y1) (G.1 y0) w0 (ap Y Wt G.1 y1 y0 t) G.2) (sym Wt w0 w0 (h t))))
      (\ h e t -> calc (Id Wt (G.1 y0) w0) {
        trans Wt (G.1 y0) (G.1 y0) w0 (ap Y Wt G.1 y0 y0 (refl y0)) G.2
          =< refl (trans Wt (G.1 y0) (G.1 y0) w0 (refl (G.1 y0)) G.2) >
        trans Wt (G.1 y0) (G.1 y0) w0 (refl (G.1 y0)) G.2
          =< trans-refl-l Wt (G.1 y0) w0 G.2 >
        G.2
          =< symH (cancel-v Wt (G.1 y0) w0 (trans Wt (G.1 y0) (G.1 y0) w0 (ap Y Wt G.1 y0 y0 t) G.2) G.2) >
        trans Wt (G.1 y0) w0 w0 (trans Wt (G.1 y0) (G.1 y0) w0 (ap Y Wt G.1 y0 y0 t) G.2)
          (sym Wt w0 w0 (trans Wt w0 (G.1 y0) w0 (sym Wt (G.1 y0) w0 G.2) (trans Wt (G.1 y0) (G.1 y0) w0 (ap Y Wt G.1 y0 y0 t) G.2)))
          =< apH (\ v -> trans Wt (G.1 y0) w0 w0 (trans Wt (G.1 y0) (G.1 y0) w0 (ap Y Wt G.1 y0 y0 t) G.2) (sym Wt w0 w0 v))
               (transH (symH (MG.loop-ap G t)) (symH (e t))) >
        trans Wt (G.1 y0) w0 w0 (trans Wt (G.1 y0) (G.1 y0) w0 (ap Y Wt G.1 y0 y0 t) G.2) (sym Wt w0 w0 (h (trans Y y0 y0 y0 (refl y0) t)))
          =< apH (\ v -> trans Wt (G.1 y0) w0 w0 (trans Wt (G.1 y0) (G.1 y0) w0 (ap Y Wt G.1 y0 y0 t) G.2) (sym Wt w0 w0 (h v)))
               (trans-refl-l Y y0 y0 t) >
        trans Wt (G.1 y0) w0 w0 (trans Wt (G.1 y0) (G.1 y0) w0 (ap Y Wt G.1 y0 y0 t) G.2) (sym Wt w0 w0 (h t)) }) ;
} ;

------------------------------------------------------------------------
-- Lemma 8, Corollary 9: climbing from H2

module Climb (Ga Gb : Ab) {
  module A = KK[Ga] ;
  module B = KK[Gb] ;
  module L = H4Bilinear[l].Lev[Ga, Gb] ;
  module H2 = H4Bilinear[l].H2[Ga, Gb] ;
  -- G^flat = e_A^-1 ; H ; e_B (H2.unconj is the case m = 1)
  unconj (m : Nat) (H : (Maps[A.K (suc m), A.pt (suc m), B.K (suc m), B.pt (suc m)].PMO)) : PtMap (A.K m) (A.pt m) (B.K m) (B.pt m) =
    ptcomp (A.K m) (A.pt m) (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (B.K m) (B.pt m) (L.eAi m) (ptcomp (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m))) (refl (B.pt (suc m))) (B.K m) (B.pt m) H (L.eB m).1) ;
  conj-unconj (m : Nat) (H : (Maps[A.K (suc m), A.pt (suc m), B.K (suc m), B.pt (suc m)].PMO)) : Id (Maps[A.K (suc m), A.pt (suc m), B.K (suc m), B.pt (suc m)].PMO) ((L.conj m) (unconj m H)) H = calc (Maps[A.K (suc m), A.pt (suc m), B.K (suc m), B.pt (suc m)].PMO) {
    (L.conj m) (unconj m H)
      =< apH (\ X -> ptcomp (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (B.K m) (B.pt m) (Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m))) (refl (B.pt (suc m))) X (L.eBi m))
           (transH (symH (ptcomp-assoc (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (A.K m) (A.pt m) (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (B.K m) (B.pt m) (L.eA m).1 (L.eAi m)
                            (ptcomp (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m))) (refl (B.pt (suc m))) (B.K m) (B.pt m) H (L.eB m).1)))
              (transH (apH (\ X -> ptcomp (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (B.K m) (B.pt m) X (ptcomp (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m))) (refl (B.pt (suc m))) (B.K m) (B.pt m) H (L.eB m).1))
                         (pt-inv-l (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (A.K m) (A.pt m) (L.eA m)))
                 (Fibres[l].ptcomp-idl (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (B.K m) (B.pt m) (ptcomp (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m))) (refl (B.pt (suc m))) (B.K m) (B.pt m) H (L.eB m).1)))) >
    ptcomp (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (B.K m) (B.pt m) (Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m))) (refl (B.pt (suc m))) (ptcomp (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m))) (refl (B.pt (suc m))) (B.K m) (B.pt m) H (L.eB m).1) (L.eBi m)
      =< ptcomp-assoc (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m))) (refl (B.pt (suc m))) (B.K m) (B.pt m) (Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m))) (refl (B.pt (suc m))) H (L.eB m).1 (L.eBi m) >
    ptcomp (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m))) (refl (B.pt (suc m))) (Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m))) (refl (B.pt (suc m))) H (ptcomp (Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m))) (refl (B.pt (suc m))) (B.K m) (B.pt m) (Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m))) (refl (B.pt (suc m))) (L.eB m).1 (L.eBi m))
      =< apH (ptcomp (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m))) (refl (B.pt (suc m))) (Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m))) (refl (B.pt (suc m))) H) (pt-inv-l (Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m))) (refl (B.pt (suc m))) (B.K m) (B.pt m) (L.eB m)) >
    ptcomp (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m))) (refl (B.pt (suc m))) (Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m))) (refl (B.pt (suc m))) H (ptid (Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m))) (refl (B.pt (suc m))))
      =< Fibres[l].ptcomp-idr (Id (A.K (suc m)) (A.pt (suc m)) (A.pt (suc m))) (refl (A.pt (suc m))) (Id (B.K (suc m)) (B.pt (suc m)) (B.pt (suc m))) (refl (B.pt (suc m))) H >
    H } ;
  -- if G^flat = K(g,m) then K(g,m+1) = G
  climb (m c : Nat) (cA : isConn (suc (suc c)) (A.K (suc m))) (tB : isTrunc (N.plus (suc c) (N.plus (suc c) zero)) (B.K (suc m)))
    (g : Hom Ga Gb) (G : PtMap (A.K (suc m)) (A.pt (suc m)) (B.K (suc m)) (B.pt (suc m)))
    (e : Id (PtMap (A.K m) (A.pt m) (B.K m) (B.pt m)) (L.K g m) (unconj m (Maps[A.K (suc m), A.pt (suc m), B.K (suc m), B.pt (suc m)].loop G))) :
    Id (PtMap (A.K (suc m)) (A.pt (suc m)) (B.K (suc m)) (B.pt (suc m))) (L.K g (suc m)) G =
    unique-loop c (A.K (suc m)) (A.pt (suc m)) (B.K (suc m)) (B.pt (suc m)) cA tB (L.K g (suc m)) G
      (transH (L.loopK g m) (transH (apH (L.conj m) e) (conj-unconj m (Maps[A.K (suc m), A.pt (suc m), B.K (suc m), B.pt (suc m)].loop G)))) ;
  inv3 (G : PtMap (A.K three) (A.pt three) (B.K three) (B.pt three)) : Hom Ga Gb =
    H2.inv2 (unconj two (Maps[A.K three, A.pt three, B.K three, B.pt three].loop G)) ;
  surj3 (G : PtMap (A.K three) (A.pt three) (B.K three) (B.pt three)) : Id (PtMap (A.K three) (A.pt three) (B.K three) (B.pt three)) (L.K (inv3 G) three) G =
    climb two two (A.conn two) (trunc-suc five (B.K three) (B.trunc two)) (inv3 G) G
      (H2.k2-surj (unconj two (Maps[A.K three, A.pt three, B.K three, B.pt three].loop G))) ;
  inv4 (G : PtMap (A.K four) (A.pt four) (B.K four) (B.pt four)) : Hom Ga Gb =
    inv3 (unconj three (Maps[A.K four, A.pt four, B.K four, B.pt four].loop G)) ;
  surj4 (G : PtMap (A.K four) (A.pt four) (B.K four) (B.pt four)) : Id (PtMap (A.K four) (A.pt four) (B.K four) (B.pt four)) (L.K (inv4 G) four) G =
    climb three two (conn-down four (A.K four) (A.conn three)) (B.trunc three) (inv4 G) G
      (surj3 (unconj three (Maps[A.K four, A.pt four, B.K four, B.pt four].loop G))) ;
} ;

------------------------------------------------------------------------
-- Propositions 6 and 7, Theorem 10

-- Steps 1-3 of Propositions 6 and 7: constancy over the point spreads
-- along the 0-connected K(Z,2) (Lemma 1, conn-elim)
spread (T Z : KZ2 -> U l) (cT : (x : KZ2) -> isConn four (T x)) (tZ : (x : KZ2) -> isTrunc five (Z x))
  (d : (x : KZ2) -> T x -> Z x) (c0 : Const (T kz2) (Z kz2) (d kz2)) (x : KZ2) : Const (T x) (Z x) (d x) =
  conn-elim (suc zero) KZ2 kz2 (KK[Zab].conn (suc zero)) (\ x1 -> Const (T x1) (Z x1) (d x1))
    (\ x1 -> const-prop (T x1) (Z x1) (cT x1) (tZ x1) (d x1)) c0 x ;

-- the coefficient map of k : K(Z,2) ->pt K(C,4), g |-> [k ; K(g,4)]
PhiC (Gc : Ab) (k : PtMap KZ2 kz2 (KK[Gc].K four) (KK[Gc].pt four)) (Gb : Ab) (g : Hom Gc Gb) : HC KZ2 kz2 (KK[Gb].K four) (KK[Gb].pt four) =
  hcl KZ2 kz2 (KK[Gb].K four) (KK[Gb].pt four) (ptcomp KZ2 kz2 (KK[Gc].K four) (KK[Gc].pt four) (KK[Gb].K four) (KK[Gb].pt four) k (KMap[Gc, Gb, g].K four)) ;
-- at C = Z, it is Phi
phiC-map (kappa : PtMap KZ2 kz2 KZ4 kz4) (Gb : Ab) (g : Hom Zab Gb) :
  Id (PtMap KZ2 kz2 (KK[Gb].K four) (KK[Gb].pt four)) (ptcomp KZ2 kz2 (KK[Zab].K four) (KK[Zab].pt four) (KK[Gb].K four) (KK[Gb].pt four) kappa (KMap[Zab, Gb, g].K four))
    (ptcomp KZ2 kz2 KZ4 kz4 (KK[Gb].K four) (KK[Gb].pt four) kappa (KMap[Zab, Gb, g].K four)) =
  refl (ptcomp KZ2 kz2 KZ4 kz4 (KK[Gb].K four) (KK[Gb].pt four) kappa (KMap[Zab, Gb, g].K four)) ;
phiC-phi (kappa : PtMap KZ2 kz2 KZ4 kz4) (Gb : Ab) (g : Hom Zab Gb) : Id (HC KZ2 kz2 (KK[Gb].K four) (KK[Gb].pt four)) (PhiC Zab kappa Gb g) (Phi kappa Gb g) =
  apH (hcl KZ2 kz2 (KK[Gb].K four) (KK[Gb].pt four)) (phiC-map kappa Gb g) ;

module FibAtC (Gc : Ab) (k : PtMap KZ2 kz2 (KK[Gc].K four) (KK[Gc].pt four)) (inj : (Gb : Ab) -> Bijection[l].Injective (PhiC Gc k Gb)) (Gb : Ab) {
  module R = Triple[Zab, Gc, k] ;
  module C = KK[Gc] ;
  module B = KK[Gb] ;
  module MW = Maps[(C.K four), (C.pt four), B.K four, B.pt four] ;
  module L = H4Bilinear[l].Lev[Gc, Gb] ;
  module CB = Climb[Gc, Gb] ;
  -- the fibre T_x of P over x
  T (x : KZ2) : U l = Id (C.K four) (k.1 x) (C.pt four) ;
  cT (x : KZ2) : isConn four (T x) = conn-id four (C.K four) (C.conn three) (k.1 x) (C.pt four) ;
  -- Omega W and Omega^2 W are connected
  cOW : isConn two (Id (B.K four) (B.pt four) (B.pt four)) =
    conn-down two (Id (B.K four) (B.pt four) (B.pt four)) (conn-down three (Id (B.K four) (B.pt four) (B.pt four))
      (conn-id four (B.K four) (B.conn three) (B.pt four) (B.pt four))) ;
  cOOW : isConn two (Id (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)) (refl (B.pt four))) =
    conn-down two (Id (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)) (refl (B.pt four)))
      (conn-id three (Id (B.K four) (B.pt four) (B.pt four)) (conn-id four (B.K four) (B.conn three) (B.pt four) (B.pt four))
         (refl (B.pt four)) (refl (B.pt four))) ;

  -- Definition 4: the restriction to the fibre over the point
  res (F : PtMap R.F R.f0 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four))) : MW.PMO =
    (\ q -> F.1 (kz2, trans (C.K four) (k.1 kz2) (C.pt four) (C.pt four) k.2 q), F.2) ;
  res-def (F : PtMap R.F R.f0 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four))) (q : Id (C.K four) (C.pt four) (C.pt four)) :
    Id (Id (B.K four) (B.pt four) (B.pt four)) ((res F).1 q) (F.1 (kz2, trans (C.K four) (k.1 kz2) (C.pt four) (C.pt four) k.2 q)) =
    refl ((res F).1 q) ;

  -- Lemma 5: its delooping (Corollary 11, c = 2)
  deloop-c (F : PtMap R.F R.f0 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four))) : isContr MW.Over[res F].Unloop =
    MW.Over[res F].cor11 two (conn-down four (C.K four) (C.conn three)) (B.trunc three) ;
  deloop (F : PtMap R.F R.f0 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four))) : PtMap (C.K four) (C.pt four) (B.K four) (B.pt four) =
    (deloop-c F).1.1 ;
  deloop-eq (F : PtMap R.F R.f0 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four))) : Id MW.PMO (res F) (MW.loop (deloop F)) =
    (deloop-c F).1.2 ;

  -- Proposition 6
  module Trans (F : PtMap R.F R.f0 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)))
    (G : PtMap (C.K four) (C.pt four) (B.K four) (B.pt four)) (w : Id MW.PMO (res F) (MW.loop G)) {
    Z (x : KZ2) : U l = Id (B.K four) (G.1 (k.1 x)) (B.pt four) ;
    d (x : KZ2) (t : T x) : Z x =
      trans (B.K four) (G.1 (k.1 x)) (B.pt four) (B.pt four)
        (trans (B.K four) (G.1 (k.1 x)) (G.1 (C.pt four)) (B.pt four) (ap (C.K four) (B.K four) G.1 (k.1 x) (C.pt four) t) G.2)
        (sym (B.K four) (B.pt four) (B.pt four) (F.1 (x, t))) ;
    hyp (q : Id (C.K four) (C.pt four) (C.pt four)) : Id (Id (B.K four) (B.pt four) (B.pt four)) (F.1 (kz2, trans (C.K four) (k.1 kz2) (C.pt four) (C.pt four) k.2 q)) ((MW.loop G).1 q) =
      transH (symH (res-def F q)) (apH (\ H -> H.1 q) w) ;
    -- Step 2 (Lemma 3 b)
    const-base : Const (T kz2) (Z kz2) (d kz2) =
      (trans (B.K four) (G.1 (k.1 kz2)) (G.1 (C.pt four)) (B.pt four) (ap (C.K four) (B.K four) G.1 (k.1 kz2) (C.pt four) k.2) G.2,
       FL.funext (T kz2) (\ t -> Z kz2)
         (\ t -> trans (B.K four) (G.1 (k.1 kz2)) (G.1 (C.pt four)) (B.pt four) (ap (C.K four) (B.K four) G.1 (k.1 kz2) (C.pt four) k.2) G.2) (d kz2)
         (TG[(C.K four), (C.pt four), B.K four, B.pt four, G].tg (k.1 kz2) k.2 (\ t -> F.1 (kz2, t)) hyp)) ;
    -- Step 3
    Nu (x : KZ2) : Z x = (spread T Z cT (\ x1 -> B.trunc three (G.1 (k.1 x1)) (B.pt four)) d const-base x).1 ;
    -- Step 4 (Lemma 2)
    null : Tr.Trunc[Id (PtMap KZ2 kz2 (B.K four) (B.pt four)) (ptconst KZ2 kz2 (B.K four) (B.pt four)) (ptcomp KZ2 kz2 (C.K four) (C.pt four) (B.K four) (B.pt four) k G)].carrier =
      pi-mere KZ2 kz2 (B.K four) (B.pt four) cOW (\ x -> B.pt four) (\ x -> G.1 (k.1 x))
        (FL.funext KZ2 (\ x -> B.K four) (\ x -> B.pt four) (\ x -> G.1 (k.1 x)) (\ x -> symH (Nu x)))
        (refl (B.pt four)) (ptcomp KZ2 kz2 (C.K four) (C.pt four) (B.K four) (B.pt four) k G).2 ;
    trans-cls : Id (HC KZ2 kz2 (B.K four) (B.pt four)) (hcl KZ2 kz2 (B.K four) (B.pt four) (ptconst KZ2 kz2 (B.K four) (B.pt four)))
        (hcl KZ2 kz2 (B.K four) (B.pt four) (ptcomp KZ2 kz2 (C.K four) (C.pt four) (B.K four) (B.pt four) k G)) =
      STr[PtMap KZ2 kz2 (B.K four) (B.pt four)].Q.relates (ptconst KZ2 kz2 (B.K four) (B.pt four)) (ptcomp KZ2 kz2 (C.K four) (C.pt four) (B.K four) (B.pt four) k G) null ;
  } ;

  -- (H3) for the target Omega W, along e_3
  h3-loop : isContr (HC KZ2 kz2 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four))) =
    ptEqInd (B.K three) (B.pt three) (\ Z z p -> isContr (HC KZ2 kz2 Z z)) (H3Proof[l].h3 Gb)
      (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four))
      (pt-inv (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)) (B.K three) (B.pt three) (B.e three)) ;

  -- Proposition 7
  module Exact (F : PtMap R.F R.f0 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)))
    (z : Id MW.PMO (res F) (ptconst (Id (C.K four) (C.pt four) (C.pt four)) (refl (C.pt four)) (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)))) {
    hyp (q : Id (C.K four) (C.pt four) (C.pt four)) : Id (Id (B.K four) (B.pt four) (B.pt four)) (F.1 (kz2, trans (C.K four) (k.1 kz2) (C.pt four) (C.pt four) k.2 q)) (refl (B.pt four)) =
      transH (symH (res-def F q)) (apH (\ H -> H.1 q) z) ;
    -- Step 2 (Lemma 3 a)
    const-base : Const (T kz2) (Id (B.K four) (B.pt four) (B.pt four)) (\ t -> F.1 (kz2, t)) =
      (refl (B.pt four), FL.funext (T kz2) (\ t -> Id (B.K four) (B.pt four) (B.pt four)) (\ t -> refl (B.pt four)) (\ t -> F.1 (kz2, t))
         (\ t -> symH (reparam (C.K four) (C.pt four) (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)) (k.1 kz2) k.2 (\ t1 -> F.1 (kz2, t1)) hyp t))) ;
    -- Step 3
    cF (x : KZ2) : Const (T x) (Id (B.K four) (B.pt four) (B.pt four)) (\ t -> F.1 (x, t)) =
      spread T (\ x1 -> Id (B.K four) (B.pt four) (B.pt four)) cT (\ x1 -> B.trunc three (B.pt four) (B.pt four)) (\ x1 t -> F.1 (x1, t)) const-base x ;
    H (x : KZ2) : Id (B.K four) (B.pt four) (B.pt four) = (cF x).1 ;
    H-eq (x : KZ2) (t : T x) : Id (Id (B.K four) (B.pt four) (B.pt four)) (H x) (F.1 (x, t)) =
      happly (T x) (\ t1 -> Id (B.K four) (B.pt four) (B.pt four)) (\ t1 -> H x) (\ t1 -> F.1 (x, t1)) (cF x).2 t ;
    -- Step 4: the pointing, from the witness at kappa0 and F0
    zeta : Id (Id (B.K four) (B.pt four) (B.pt four)) (H kz2) (refl (B.pt four)) = transH (H-eq kz2 k.2) F.2 ;
    base-zero : Tr.Trunc[Id (PtMap KZ2 kz2 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)))
        (ptconst KZ2 kz2 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four))) (H, zeta)].carrier =
      STr[PtMap KZ2 kz2 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four))].effective
        (ptconst KZ2 kz2 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four))) (H, zeta)
        (contr-prop (HC KZ2 kz2 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four))) h3-loop
          (hcl KZ2 kz2 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)) (ptconst KZ2 kz2 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four))))
          (hcl KZ2 kz2 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)) (H, zeta))) ;
    -- Step 5 (Lemma 2)
    from-base (e : Id (PtMap KZ2 kz2 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)))
        (ptconst KZ2 kz2 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four))) (H, zeta)) :
      Tr.Trunc[Id (PtMap R.F R.f0 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)))
        (ptconst R.F R.f0 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four))) F].carrier =
      pi-mere R.F R.f0 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)) cOOW (\ p -> refl (B.pt four)) F.1
        (FL.funext R.F (\ p -> Id (B.K four) (B.pt four) (B.pt four)) (\ p -> refl (B.pt four)) F.1 (\ p ->
           transH (happly KZ2 (\ x -> Id (B.K four) (B.pt four) (B.pt four)) (\ x -> refl (B.pt four)) H (apH (\ M -> M.1) e) p.1)
             (H-eq p.1 p.2)))
        (refl (refl (B.pt four))) F.2 ;
    exact : Tr.Trunc[Id (PtMap R.F R.f0 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)))
        (ptconst R.F R.f0 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four))) F].carrier =
      TC.bind (Id (PtMap KZ2 kz2 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)))
          (ptconst KZ2 kz2 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four))) (H, zeta))
        (Id (PtMap R.F R.f0 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)))
          (ptconst R.F R.f0 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four))) F)
        from-base base-zero ;
  } ;

  -- Theorem 10
  g0 : Hom Gc Gb = CB.inv4 (ptconst (C.K four) (C.pt four) (B.K four) (B.pt four)) ;
  module Kill (F : PtMap R.F R.f0 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four))) {
    g : Hom Gc Gb = CB.inv4 (deloop F) ;
    cls-eq : Id (HC KZ2 kz2 (B.K four) (B.pt four)) (PhiC Gc k Gb g) (PhiC Gc k Gb g0) = calc (HC KZ2 kz2 (B.K four) (B.pt four)) {
      PhiC Gc k Gb g
        =< refl (PhiC Gc k Gb g) >
      hcl KZ2 kz2 (B.K four) (B.pt four) (ptcomp KZ2 kz2 (C.K four) (C.pt four) (B.K four) (B.pt four) k (KMap[Gc, Gb, g].K four))
        =< apH (\ G1 -> hcl KZ2 kz2 (B.K four) (B.pt four) (ptcomp KZ2 kz2 (C.K four) (C.pt four) (B.K four) (B.pt four) k G1)) (transH (L.K-def g four) (CB.surj4 (deloop F))) >
      hcl KZ2 kz2 (B.K four) (B.pt four) (ptcomp KZ2 kz2 (C.K four) (C.pt four) (B.K four) (B.pt four) k (deloop F))
        =< symH (Trans[F, deloop F, deloop-eq F].trans-cls) >
      hcl KZ2 kz2 (B.K four) (B.pt four) (ptconst KZ2 kz2 (B.K four) (B.pt four))
        =< symH (apH (hcl KZ2 kz2 (B.K four) (B.pt four)) (comp-const-r KZ2 kz2 (C.K four) (C.pt four) (B.K four) (B.pt four) k)) >
      hcl KZ2 kz2 (B.K four) (B.pt four) (ptcomp KZ2 kz2 (C.K four) (C.pt four) (B.K four) (B.pt four) k (ptconst (C.K four) (C.pt four) (B.K four) (B.pt four)))
        =< symH (apH (\ G1 -> hcl KZ2 kz2 (B.K four) (B.pt four) (ptcomp KZ2 kz2 (C.K four) (C.pt four) (B.K four) (B.pt four) k G1)) (transH (L.K-def g0 four) (CB.surj4 (ptconst (C.K four) (C.pt four) (B.K four) (B.pt four))))) >
      hcl KZ2 kz2 (B.K four) (B.pt four) (ptcomp KZ2 kz2 (C.K four) (C.pt four) (B.K four) (B.pt four) k (KMap[Gc, Gb, g0].K four))
        =< refl (PhiC Gc k Gb g0) >
      PhiC Gc k Gb g0 } ;
    -- injectivity of Phi_B
    g-eq : Id (Hom Gc Gb) g g0 = inj Gb g g0 cls-eq ;
    G-zero : Id (PtMap (C.K four) (C.pt four) (B.K four) (B.pt four)) (deloop F) (ptconst (C.K four) (C.pt four) (B.K four) (B.pt four)) =
      transH (symH (CB.surj4 (deloop F))) (transH (apH (\ h -> L.K h four) g-eq) (CB.surj4 (ptconst (C.K four) (C.pt four) (B.K four) (B.pt four)))) ;
    res-zero : Id MW.PMO (res F) (ptconst (Id (C.K four) (C.pt four) (C.pt four)) (refl (C.pt four)) (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four))) =
      transH (deloop-eq F) (transH (apH MW.loop G-zero) (loop-const (C.K four) (C.pt four) (B.K four) (B.pt four))) ;
  } ;
  merely-zero (F : PtMap R.F R.f0 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four))) :
    Tr.Trunc[Id (PtMap R.F R.f0 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)))
      (ptconst R.F R.f0 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four))) F].carrier =
    Exact[F, Kill[F].res-zero].exact ;
  contr-loop : isContr (HC R.F R.f0 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four))) =
    (hcl R.F R.f0 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)) (ptconst R.F R.f0 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four))),
     STr[PtMap R.F R.f0 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four))].ind @l
       (\ c -> Id (HC R.F R.f0 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)))
                 (hcl R.F R.f0 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)) (ptconst R.F R.f0 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)))) c)
       (\ c -> hc-set R.F R.f0 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four))
                 (hcl R.F R.f0 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)) (ptconst R.F R.f0 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)))) c)
       (\ F -> STr[PtMap R.F R.f0 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four))].Q.relates
                 (ptconst R.F R.f0 (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four))) F (merely-zero F))) ;
  -- along e_3 : Omega W ~pt K(B,3)
  contr : isContr (HC R.F R.f0 (B.K three) (B.pt three)) =
    ptEqInd (Id (B.K four) (B.pt four) (B.pt four)) (refl (B.pt four)) (\ Z z p -> isContr (HC R.F R.f0 Z z)) contr-loop
      (B.K three) (B.pt three) (B.e three) ;
} ;

-- the specialisation C = Z, with (H4)
module FibAt (kappa : PtMap KZ2 kz2 KZ4 kz4) (h4k : H4 kappa) (Gb : Ab) {
  inj (Gd : Ab) : Bijection[l].Injective (PhiC Zab kappa Gd) =
    \ g g' e -> E.injective (Hom Zab Gd) (HC KZ2 kz2 (KK[Gd].K four) (KK[Gd].pt four)) (Phi kappa Gd) (h4k Gd) g g'
      (transH (symH (phiC-phi kappa Gd g)) (transH e (phiC-phi kappa Gd g'))) ;
  merely-zero (F : PtMap Triple[Zab, Zab, kappa].F Triple[Zab, Zab, kappa].f0 (Id (KK[Gb].K four) (KK[Gb].pt four) (KK[Gb].pt four)) (refl (KK[Gb].pt four))) :
    Tr.Trunc[Id (PtMap Triple[Zab, Zab, kappa].F Triple[Zab, Zab, kappa].f0 (Id (KK[Gb].K four) (KK[Gb].pt four) (KK[Gb].pt four)) (refl (KK[Gb].pt four)))
      (ptconst Triple[Zab, Zab, kappa].F Triple[Zab, Zab, kappa].f0 (Id (KK[Gb].K four) (KK[Gb].pt four) (KK[Gb].pt four)) (refl (KK[Gb].pt four))) F].carrier =
    FibAtC[Zab, kappa, inj, Gb].merely-zero F ;
  contr : isContr (HC Triple[Zab, Zab, kappa].F Triple[Zab, Zab, kappa].f0 (KK[Gb].K three) (KK[Gb].pt three)) =
    FibAtC[Zab, kappa, inj, Gb].contr ;
} ;

-- for the cup square
fib-h3 (Gb : Ab) : isContr (HC Triple[Zab, Zab, CupSquare[l].kappa].F Triple[Zab, Zab, CupSquare[l].kappa].f0 (KK[Gb].K three) (KK[Gb].pt three)) =
  FibAt[CupSquare[l].kappa, H4Proof[l].h4, Gb].contr ;
