-- pi_3(S^2) = Z through the classification (doc/postnikov-classification.pdf,
-- section 9): the mapping theorem MapFib.Final.rep-fib holds for every fibre
-- Fib k, and every pointed simply connected 3-type is one
-- (PostnikovClassification.classification), so P = Fib kappa represents the
-- 3-truncation of S2 for EVERY simply connected 3-type X; this is the
-- interface Pi3Sphere.Conditional.MapThm, and Pi3Sphere.pi3-S2-T concludes.
--   rep        transport of rep-fib at the triple sec X along sec-eq X :
--              realise (sec X) = X in SC3
--   map-thm    the MapThm record with s = MapFib.Final.s
--   pi3-S2     pi3 S2 = Z as groups, from the sphere axiom alone, without
--              the presentation of Presentation.Pres
level l ;
open Base ; open Prelude[l] ; open HLevels[l] ; open Connected[l] ; open Lemma4[l] ;
open Group[l] ; open Torsor[l] ; open SphereAxiom[l] ; open HomotopyClasses[l] ; open HomotopyGroups[l] ;
open SphereUniversal[l] ; open PostnikovRealization[l] ; open KZ2Cohomology[l] ;
module P1 = Prelude[l+] ; module PC = PostnikovClassification[l] ; module CP = ClassPost[l] ;
module CS = CupSquare[l] ; module MF = MapFib[l] ;

module Final (S2 : U l) (base : S2) (surf : O2 S2 base)
  (ump : (X : U l) -> isEquiv (S2 -> X) ((x : X) * O2 X x) (ev2 S2 base surf X)) {
  module MFF = MF.Final[S2, base, surf, ump, CS.kappa, H4Proof[l].h4] ;
  module RP = Triple[Zab, Zab, CS.kappa] ;
  module C = Pi3Sphere[l].Conditional[S2, base, surf, ump, CS.kappa] ;

  -- the statement, for a pointed type in SC3
  Rep (v : CP.SC3) : U l =
    isEquiv (HC RP.F RP.f0 v.1 v.2.1) (HC S2 base v.1 v.2.1) (\ b -> compC S2 base RP.F RP.f0 v.1 v.2.1 MFF.s b) ;

  rep (X : U l) (x0 : X) (tX : isTrunc five X) (cX : isConn three X) : Rep (X, x0, (cX, tX)) =
    P1.subst CP.SC3 (\ v -> Rep v) (PC.realise (PC.realise-equiv.sec (X, x0, (cX, tX)))) (X, x0, (cX, tX))
      (PC.realise-equiv.sec-eq (X, x0, (cX, tX)))
      (MFF.rep-fib (PC.realise-equiv.sec (X, x0, (cX, tX))).1 (PC.realise-equiv.sec (X, x0, (cX, tX))).2.1
         (PC.realise-equiv.sec (X, x0, (cX, tX))).2.2) ;

  map-thm : C.MapThm = new C.MapThm[MFF.s, rep] ;

  pi3-S2 : GIso[pi3 S2 base, ab-grp Zab] = C.pi3-S2-T map-thm ;
} ;
