-- Generic lemmas for the classification (doc/postnikov-classification.pdf,
-- section 3).
--   PtProp[P]      Lemma 1: pointed types with a propositional property P;
--                  (v : PP) * u ~pt v is contractible (a retract of PtUniv
--                  with the proposition P over it), so (u = v) ~ (u ~pt v)
--                  by the fundamental theorem (I.equiv, I.path)
--   StageId[n]     the same for the record EM.Stage[n] (pointed (n+1)-
--                  connected (n+2)-types): a retract of PtProp.contr,
--                  computing on new Stage[..] (split); stage-gpd: Stage[1]
--                  is a 1-type (Lemma 2, cor5-equiv)
--   conn-lift      isConn at l gives isConn at l+ (truncations compared by
--                  induction)
--   const-contr    Lemma 3: D 1-connected, Z a 1-type (in U l+), g : D -> Z:
--                  (z : Z) * ((d : D) -> z = g d) is contractible; a retract
--                  of pointed sections of d |-> g d0 = g d (lemma4, t = 0, c = 2)
--   conn-back      Lemma 4: isConn m fibres and base give isConn m domain
--                  (as ConnectedMaps.conn-up, with fib-ap-conn)
--   fib-pr1, total-conn   the fibres of pr1 are the family; a total space of
--                  isConn m types over an isConn m base is isConn m
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ; open HLevels[l] ; open Connected[l] ;
open Lemma4[l] ; open PtEquivOps[l] ; open SphereUniversal[l] ; open PostnikovRealization[l] ;
module P1 = Prelude[l+] ; module H1 = HLevels[l+] ; module C1 = Connected[l+] ; module FU1 = FunExtUA[l+] ;
module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ; module TC = TruncationCombinators[l] ;
module TU = TruncUp[l] ; module W = Whitehead[l] ; module CM = ConnectedMaps[l] ;
module EMf = EM[l] ;

------------------------------------------------------------------------
-- Lemma 1

module PtProp (P : U l -> U l) (pP : (X : U l) -> isProp (P X)) {
  PP : U l+ = (X : U l) * (x : X) * P X ;
  R (u v : PP) : U l = PtEquiv u.1 u.2.1 v.1 v.2.1 ;
  -- the property at the centre of PtUniv
  pcontr (u : PP) : H1.isTrunc zero (P u.1) = (u.2.2, \ q -> pP u.1 u.2.2 q) ;
  contr (u : PP) : FU1.isContr ((v : PP) * R u v) =
    H1.retract-contr ((v : PP) * R u v) ((w : PtUniv u.1 u.2.1) * P w.1)
      (\ a -> ((a.1.1, a.1.2.1, a.2), a.1.2.2)) (\ b -> ((b.1.1, b.1.2.1, b.2), b.1.2.2)) (\ a -> refl a)
      (H1.trunc-Sigma-contr zero (PtUniv u.1 u.2.1) (\ w -> P w.1) (pt-univ u.1 u.2.1) (pcontr u)) ;
  module I (u : PP) {
    module F = FundThm[l+].FT[PP, u, \ v -> R u v, idPt u.1 u.2.1, contr u] ;
    equiv (v : PP) : P1.Equiv (Id PP u v) (R u v) = (F.tr v, F.equiv v) ;
    path (v : PP) (e : R u v) : Id PP u v = F.un v e ;
  } ;
} ;

------------------------------------------------------------------------
-- Stage[n]

module StageId (n : Nat) {
  P (X : U l) : U l = isConn (suc (suc (suc n))) X * isTrunc (suc (suc (suc (suc n)))) X ;
  pP (X : U l) : isProp (P X) =
    isProp-Sigma (isConn (suc (suc (suc n))) X) (\ c -> isTrunc (suc (suc (suc (suc n)))) X)
      (conn-prop (suc (suc (suc n))) X) (\ c -> trunc-prop (suc (suc (suc (suc n)))) X) ;
  module PS = PtProp[P, pP] ;
  St : U l+ = EMf.Stage[n] ;
  to (S : St) : PS.PP = (S.X, S.pt, (S.conn, S.trunc)) ;
  of (u : PS.PP) : St = new EMf.Stage[n, u.1, u.2.1, u.2.2.1, u.2.2.2] ;
  R (S T : St) : U l = PtEquiv S.X S.pt T.X T.pt ;
  -- of (to T) is T on a constructed stage
  back : (T : St) (S0 : St) (e : R S0 T) -> Id ((T' : St) * R S0 T') (of (to T), e) (T, e) = split {
    Stage x p c t -> \ S0 e -> refl (new EMf.Stage[n, x, p, c, t], e) } ;
  contr (S : St) : FU1.isContr ((T : St) * R S T) =
    H1.retract-contr ((T : St) * R S T) ((v : PS.PP) * PS.R (to S) v)
      (\ a -> (to a.1, a.2)) (\ b -> (of b.1, b.2))
      (\ a -> back a.1 S a.2)
      (PS.contr (to S)) ;
  module I (S : St) {
    module F = FundThm[l+].FT[St, S, \ T -> R S T, idPt S.X S.pt, contr S] ;
    equiv (T : St) : P1.Equiv (Id St S T) (R S T) = (F.tr T, F.equiv T) ;
    path (T : St) (e : R S T) : Id St S T = F.un T e ;
  } ;
  -- induction on pointed equivalences out of a stage
  J (S : St) (M : (T : St) -> R S T -> U l+) (d : M S (idPt S.X S.pt)) (T : St) (e : R S T) : M T e =
    P1.subst ((T' : St) * R S T') (\ w -> M w.1 w.2) (S, idPt S.X S.pt) (T, e)
      (FU1.pathC ((T' : St) * R S T') (contr S) (S, idPt S.X S.pt) (T, e)) d ;
} ;

-- Lemma 2
stage-gpd : H1.isTrunc three EMf.Stage[suc zero] = \ S T ->
  H1.equiv-trunc two (Id EMf.Stage[suc zero] S T) (PtEquiv S.X S.pt T.X T.pt) (StageId[suc zero].I[S].equiv T)
    (TU.trunc-up two (PtEquiv S.X S.pt T.X T.pt) (cor5-equiv (suc zero) three S.X S.pt S.conn T.X T.pt T.trunc)) ;

------------------------------------------------------------------------
-- Lemma 3

conn-lift : (n : Nat) (X : U l) -> isConn n X -> C1.isConn n X = split {
  zero -> \ X c -> tt ;
  suc n | r -> \ X c ->
    (Tr.Trunc[X].induction @(l+) (\ t -> Tr1.Trunc[X].carrier) (\ t -> Tr1.Trunc[X].proposition) (\ x -> Tr1.Trunc[X].inc x) c.1,
     \ x y -> r (Id X x y) (c.2 x y)) } ;

module Const (D : U l) (Z : U l+) (tZ : H1.isTrunc three Z) (g : D -> Z) {
  A : U l+ = (z : Z) * ((d : D) -> Id Z z (g d)) ;
  B (d0 : D) : U l+ = Lemma4[l+].PtSec D d0 (\ d -> Id Z (g d0) (g d)) (refl (g d0)) ;
  s (d0 : D) (a : A) : B d0 =
    (\ d -> P1.trans Z (g d0) a.1 (g d) (P1.sym Z a.1 (g d0) (a.2 d0)) (a.2 d),
     P1.trans-sym-l Z a.1 (g d0) (a.2 d0)) ;
  r (d0 : D) (b : B d0) : A = (g d0, b.1) ;
  -- (g d0, d |-> p^-1 . h d) = (z, h) for p : z = g d0
  rs-gen (d0 : D) (z : Z) (p : Id Z z (g d0)) (h : (d : D) -> Id Z z (g d)) :
    Id A (g d0, \ d -> P1.trans Z (g d0) z (g d) (P1.sym Z z (g d0) p) (h d)) (z, h) =
    Paths[l+].idJR Z (g d0) (\ z1 p1 -> (h1 : (d : D) -> Id Z z1 (g d)) ->
        Id A (g d0, \ d -> P1.trans Z (g d0) z1 (g d) (P1.sym Z z1 (g d0) p1) (h1 d)) (z1, h1))
      (\ h1 -> P1.ap ((d : D) -> Id Z (g d0) (g d)) A (\ k -> (g d0, k))
         (\ d -> P1.trans Z (g d0) (g d0) (g d) (refl (g d0)) (h1 d)) h1
         (Axioms[l+].FunExtLemmas[fe @(l+)].funext D (\ d -> Id Z (g d0) (g d))
            (\ d -> P1.trans Z (g d0) (g d0) (g d) (refl (g d0)) (h1 d)) h1
            (\ d -> P1.trans-refl-l Z (g d0) (g d) (h1 d))))
      z p h ;
  rs (d0 : D) (a : A) : Id A (r d0 (s d0 a)) a = rs-gen d0 a.1 (a.2 d0) a.2 ;
  contr-at (d0 : D) (cD : isConn three D) : FU1.isContr A =
    H1.retract-contr A (B d0) (s d0) (r d0) (rs d0)
      (Lemma4[l+].lemma4 zero two D d0 (conn-lift three D cD) (\ d -> Id Z (g d0) (g d)) (\ d -> tZ (g d0) (g d)) (refl (g d0))) ;
} ;

const-contr (D : U l) (cD : isConn three D) (Z : U l+) (tZ : H1.isTrunc three Z) (g : D -> Z)
  : FU1.isContr Const[D, Z, tZ, g].A =
  Tr.Trunc[D].induction @(l+) (\ t -> FU1.isContr Const[D, Z, tZ, g].A) (\ t -> Torsor[l+].isProp-isContr Const[D, Z, tZ, g].A)
    (\ d0 -> Const[D, Z, tZ, g].contr-at d0 cD) cD.1 ;

------------------------------------------------------------------------
-- Lemma 4

conn-back : (m : Nat) (A B : U l) (f : A -> B) -> ((b : B) -> isConn m (W.fib A B f b)) -> isConn m B -> isConn m A = split {
  zero -> \ A B f cf cB -> tt ;
  suc m | r -> \ A B f cf cB ->
    (Tr.Trunc[B].induction @l (\ t -> Tr.Trunc[A].carrier) (\ t -> Tr.Trunc[A].proposition)
       (\ b -> TC.map (W.fib A B f b) A (\ w -> w.1) (cf b).1) cB.1,
     \ a a' -> r (Id A a a') (Id B (f a) (f a')) (ap A B f a a') (CM.fib-ap-conn m A B f cf a a') (cB.2 (f a) (f a'))) } ;

fib-pr1 (V : U l) (F : V -> U l) (v : V) : Equiv (W.fib ((x : V) * F x) V (\ w -> w.1) v) (F v) =
  (\ w -> subst V F w.1.1 v w.2 w.1.2,
   qinv (W.fib ((x : V) * F x) V (\ w -> w.1) v) (F v) (\ w -> subst V F w.1.1 v w.2 w.1.2)
     (\ y -> ((v, y), refl v)) (\ y -> refl y)
     (\ w -> idJ V w.1.1 (\ v1 p1 -> Id (W.fib ((x : V) * F x) V (\ w1 -> w1.1) v1) ((v1, subst V F w.1.1 v1 p1 w.1.2), refl v1) (w.1, p1))
        (refl ((w.1.1, w.1.2), refl w.1.1)) v w.2)) ;

total-conn (m : Nat) (V : U l) (F : V -> U l) (cV : isConn m V) (cF : (v : V) -> isConn m (F v)) : isConn m ((x : V) * F x) =
  conn-back m ((x : V) * F x) V (\ w -> w.1)
    (\ v -> Deloop[l].equiv-conn m (W.fib ((x : V) * F x) V (\ w -> w.1) v) (F v) (fib-pr1 V F v) (cF v)) cV ;

-- an equivalence of U l as one of U l+ (isEquiv is a record of each level)
raise (A B : U l) (e : Equiv A B) : P1.Equiv A B =
  (e.1, struct { sec = e.2.sec ; sec-eq = e.2.sec-eq ; ret = e.2.ret ; ret-eq = e.2.ret-eq }) ;

-- a type which is contractible as soon as it is inhabited is a proposition
prop-of-contr (A : U l+) (h : A -> FU1.isContr A) : P1.isProp A = \ a b -> FU1.pathC A (h a) a b ;

-- two propositions with maps both ways are equivalent
prop-equiv (A B : U l+) (pA : P1.isProp A) (pB : P1.isProp B) (f : A -> B) (g : B -> A) : P1.Equiv A B =
  (f, P1.qinv A B f g (\ b -> pB (f (g b)) b) (\ a -> pA (g (f a)) a)) ;

-- paths in a product
pair-path (A B : U l) (a a' : A) (b b' : B) (p : Id A a a') (q : Id B b b') : Id (A * B) (a, b) (a', b') =
  idJ A a (\ a1 p1 -> Id (A * B) (a, b) (a1, b')) (ap B (A * B) (\ y -> (a, y)) b b' q) a' p ;

-- ap of an equivalence is an equivalence
ap-equiv (A B : U l) (e : Equiv A B) (x y : A) : isEquiv (Id A x y) (Id B (e.1 x) (e.1 y)) (ap A B e.1 x y) =
  Axioms[l].UnivalenceLemmas[univ @l].eqind A (\ B1 e1 -> (x1 y1 : A) -> isEquiv (Id A x1 y1) (Id B1 (e1.1 x1) (e1.1 y1)) (ap A B1 e1.1 x1 y1))
    (\ x1 y1 -> Equivalences[l].homotopy (Id A x1 y1) (Id A x1 y1) (idEquiv (Id A x1 y1)) (ap A A (\ a -> a) x1 y1)
       (Fibres[l].ap-id A x1 y1))
    B e x y ;

-- transport along p after transport along p^-1
subst-cancel (A : U l) (P : A -> U l) (a b : A) (p : Id A a b) (u : P b) :
  Id (P b) (subst A P a b p (subst A P b a (sym A a b p) u)) u =
  idJR A b (\ a1 p1 -> Id (P b) (subst A P a1 b p1 (subst A P b a1 (sym A a1 b p1) u)) u) (refl u) a p ;
