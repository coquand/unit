-- The cross term of a cocycle whose fibre deloops (doc/delooping-direct.pdf,
-- Section 2).  Informal proof.
--   LoopIrr     for pointed m, m' : S ->pt Omega W with pointwise equal
--               underlying functions (H), loop m and loop m' are pointwise
--               equal: loop m' r = conj c (loop m r), c in Omega^2 W
--               (LoopConj.LoopHomotopy), and conj c is the identity on
--               Omega^2 W (Eckmann-Hilton at W: conj-eh)
--   PtIrr       Lemma (lambda0), pointing irrelevance of loop^2: under the
--               same hypothesis, loop^2 m = loop^2 m' pointwise.  Two levels,
--               each conjugation identified before it is removed: LoopIrr at
--               m, m' (h1), then LoopIrr at loop m, loop m' with h1 (EH at
--               Omega W).  The text's (lambda0) is S = Omega X.
--   loop2-comp  loop^2 (F ; G) = loop^2 G o loop^2 F pointwise (loop-comp at
--               both levels)
--   ELoop       Lemma (lambda3), first equation: with gamma0 = (loop e_1^-1) g
--               in Omega^2 K(Z,2) (g the generator of the circle used by E),
--               (E c)(x) = loop^2 (c ; ev_x) gamma0.  ENat.E-loop gives
--               loop (phi c ; Ex x) g; phi c ; Ex x and e_1^-1 ; loop (c ; ev_x)
--               have pointwise equal functions (ev-ap, loop-comp, ev-loop:
--               looping ev_x is ap of evaluation, loop-ap), so LoopIrr; then
--               loop-comp at e_1^-1.
--   EDelta      Lemma (lambda3), second equation, for pointed equivalences
--               e2 : Omega X ~ K(Z,2), e4 : Omega W ~ Y and gamma^0 =
--               loop^2 e2^-1 gamma0: if (c y)(x) = e4 (m (e2^-1 y)) for all y,
--               then (E c)(x) = loop^2 e4 (loop^2 m gamma^0).  Compose with
--               e4^-1: P = e2^-1 ; m and Q = (c ; ev_x) ; e4^-1 : K(Z,2) ->pt
--               Omega W have pointwise equal functions (H, e4^-1 e4 = id), so
--               loop^2 P = loop^2 Q (lambda0); c ; ev_x = Q ; e4 (back:
--               ptcomp-assoc, pt-inv-r, ptcomp-idr); loop2-comp on both sides.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Lemma4[l] ; open PtEquivOps[l] ; open DeloopMaps[l] ;
open LoopCalc[l] ; open SphereUniversal[l] ; open PostnikovRealization[l] ; open KZ2Cohomology[l] ;
module LC = LoopConj[l] ;
module CS = CupSquare[l] ;

-- conjugation of a 2-loop by a 2-loop is trivial (Eckmann-Hilton)
conj-eh (W : U l) (w0 : W) (c u : Id (Id W w0 w0) (refl w0) (refl w0)) :
  Id (Id (Id W w0 w0) (refl w0) (refl w0)) (LC.conj (Id W w0 w0) (refl w0) (refl w0) c u) u =
  transH (apH (trans (Id W w0 w0) (refl w0) (refl w0) (refl w0) (sym (Id W w0 w0) (refl w0) (refl w0) c)) (EH[l].EH[W, w0].eh u c))
    (trans-cancel (Id W w0 w0) (refl w0) (refl w0) (refl w0) c u) ;

------------------------------------------------------------------------
-- Lemma (lambda0)

module LoopIrr (S : U l) (s0 : S) (W : U l) (w0 : W)
  (m m' : PtMap S s0 (Id W w0 w0) (refl w0))
  (H : (s : S) -> Id (Id W w0 w0) (m.1 s) (m'.1 s)) {
  module M = Maps[S, s0, Id W w0 w0, refl w0] ;
  module LH = LC.LoopHomotopy[S, s0, Id W w0 w0, refl w0, m, m', H] ;
  irr (r : Id S s0 s0) : Id (Id (Id W w0 w0) (refl w0) (refl w0)) ((M.loop m).1 r) ((M.loop m').1 r) =
    symH (transH (LH.loop-homotopy r) (conj-eh W w0 LH.c ((M.loop m).1 r))) ;
} ;

module PtIrr (S : U l) (s0 : S) (W : U l) (w0 : W)
  (m m' : PtMap S s0 (Id W w0 w0) (refl w0))
  (H : (s : S) -> Id (Id W w0 w0) (m.1 s) (m'.1 s)) {
  module M1 = Maps[S, s0, Id W w0 w0, refl w0] ;
  module M2 = Maps[Id S s0 s0, refl s0, Id (Id W w0 w0) (refl w0) (refl w0), refl (refl w0)] ;
  -- level 1: loop m and loop m' are pointwise equal
  h1 (r : Id S s0 s0) : Id (Id (Id W w0 w0) (refl w0) (refl w0)) ((M1.loop m).1 r) ((M1.loop m').1 r) =
    LoopIrr[S, s0, W, w0, m, m', H].irr r ;
  -- level 2: the same for loop m, loop m'
  lambda0 (g : Id (Id S s0 s0) (refl s0) (refl s0)) :
    Id (Id (Id (Id W w0 w0) (refl w0) (refl w0)) (refl (refl w0)) (refl (refl w0))) ((M2.loop (M1.loop m)).1 g) ((M2.loop (M1.loop m')).1 g) =
    LoopIrr[Id S s0 s0, refl s0, Id W w0 w0, refl w0, M1.loop m, M1.loop m', h1].irr g ;
} ;

-- loop^2 (F ; G) = loop^2 G o loop^2 F, pointwise
loop2-comp (A : U l) (a0 : A) (B : U l) (b0 : B) (C : U l) (c0 : C) (F : PtMap A a0 B b0) (G : PtMap B b0 C c0)
  (z : Id (Id A a0 a0) (refl a0) (refl a0)) :
  Id (Id (Id C c0 c0) (refl c0) (refl c0))
    ((Maps[Id A a0 a0, refl a0, Id C c0 c0, refl c0].loop (Maps[A, a0, C, c0].loop (ptcomp A a0 B b0 C c0 F G))).1 z)
    ((Maps[Id B b0 b0, refl b0, Id C c0 c0, refl c0].loop (Maps[B, b0, C, c0].loop G)).1
       ((Maps[Id A a0 a0, refl a0, Id B b0 b0, refl b0].loop (Maps[A, a0, B, b0].loop F)).1 z)) =
  transH (apH (\ L -> (Maps[Id A a0 a0, refl a0, Id C c0 c0, refl c0].loop L).1 z) (loop-comp A a0 B b0 C c0 F G))
    (apH (\ L -> L.1 z)
       (loop-comp (Id A a0 a0) (refl a0) (Id B b0 b0) (refl b0) (Id C c0 c0) (refl c0) (Maps[A, a0, B, b0].loop F) (Maps[B, b0, C, c0].loop G))) ;

------------------------------------------------------------------------
-- The cross term in one variable and the invariant lambda

module Inv (X : U l) (x0 : X) (W : U l) (w0 : W) {
  module MX = Maps[X, x0, W, w0] ;
  module M1 = Maps[Id X x0 x0, refl x0, Id W w0 w0, refl w0] ;
  module M2 = Maps[Id (Id X x0 x0) (refl x0) (refl x0), refl (refl x0), Id (Id W w0 w0) (refl w0) (refl w0), refl (refl w0)] ;
  -- lambda_g (m) = loop^2 m g
  lam (g : Id (Id (Id X x0 x0) (refl x0) (refl x0)) (refl (refl x0)) (refl (refl x0))) (m : MX.PMO) :
    Id (Id (Id W w0 w0) (refl w0) (refl w0)) (refl (refl w0)) (refl (refl w0)) = (M2.loop (M1.loop m)).1 g ;
  -- Delta^f_q (p) = (f p)^-1 . f (p . q) . (f q)^-1
  dfun (f : MX.PMO) (q p : Id X x0 x0) : Id W w0 w0 =
    trans W w0 w0 w0 (trans W w0 w0 w0 (sym W w0 w0 (f.1 p)) (f.1 (trans X x0 x0 x0 p q))) (sym W w0 w0 (f.1 q)) ;
  -- a pointing (only the function matters, by lambda0)
  dpt (f : MX.PMO) (q : Id X x0 x0) : Id (Id W w0 w0) (dfun f q (refl x0)) (refl w0) = calc (Id W w0 w0) {
    dfun f q (refl x0)
      =< apH (\ u -> trans W w0 w0 w0 (trans W w0 w0 w0 (sym W w0 w0 (f.1 (refl x0))) (f.1 u)) (sym W w0 w0 (f.1 q))) (trans-refl-l X x0 x0 q) >
    trans W w0 w0 w0 (trans W w0 w0 w0 (sym W w0 w0 (f.1 (refl x0))) (f.1 q)) (sym W w0 w0 (f.1 q))
      =< apH (\ v -> trans W w0 w0 w0 (trans W w0 w0 w0 (sym W w0 w0 v) (f.1 q)) (sym W w0 w0 (f.1 q))) f.2 >
    trans W w0 w0 w0 (trans W w0 w0 w0 (sym W w0 w0 (refl w0)) (f.1 q)) (sym W w0 w0 (f.1 q))
      =< refl (trans W w0 w0 w0 (trans W w0 w0 w0 (refl w0) (f.1 q)) (sym W w0 w0 (f.1 q))) >
    trans W w0 w0 w0 (trans W w0 w0 w0 (refl w0) (f.1 q)) (sym W w0 w0 (f.1 q))
      =< apH (\ u -> trans W w0 w0 w0 u (sym W w0 w0 (f.1 q))) (trans-refl-l W w0 w0 (f.1 q)) >
    trans W w0 w0 w0 (f.1 q) (sym W w0 w0 (f.1 q))
      =< Groupoid[l].trans-sym-r W w0 w0 (f.1 q) >
    refl w0 } ;
  Delta (f : MX.PMO) (q : Id X x0 x0) : MX.PMO = (dfun f q, dpt f q) ;
  -- by definition
  Delta-fun (f : MX.PMO) (q p : Id X x0 x0) : Id (Id W w0 w0) ((Delta f q).1 p) (dfun f q p) = refl (dfun f q p) ;
  -- locked: only its function is used
  opaque Delta ;
  -- (Delta0): Delta^0_q is pointwise refl (by definition of dfun, sym and trans)
  delta0 (q p : Id X x0 x0) : Id (Id W w0 w0) ((Delta (ptconst (Id X x0 x0) (refl x0) (Id W w0 w0) (refl w0)) q).1 p) (refl w0) =
    Delta-fun (ptconst (Id X x0 x0) (refl x0) (Id W w0 w0) (refl w0)) q p ;
  -- (lambda2): lambda_g (0) = refl (loop-const twice)
  lam-zero (g : Id (Id (Id X x0 x0) (refl x0) (refl x0)) (refl (refl x0)) (refl (refl x0))) :
    Id (Id (Id (Id W w0 w0) (refl w0) (refl w0)) (refl (refl w0)) (refl (refl w0))) (lam g (ptconst (Id X x0 x0) (refl x0) (Id W w0 w0) (refl w0))) (refl (refl (refl w0))) =
    transH (apH (\ L -> (M2.loop L).1 g) (loop-const (Id X x0 x0) (refl x0) (Id W w0 w0) (refl w0)))
      (apH (\ L -> L.1 g) (loop-const (Id (Id X x0 x0) (refl x0) (refl x0)) (refl (refl x0)) (Id (Id W w0 w0) (refl w0) (refl w0)) (refl (refl w0)))) ;
} ;

-- (Delta1): for a multiplicative L : Omega X' ->pt Omega X (a loop map,
-- LMult.lmult), Delta^{L;f}_q' (p') = Delta^f_{L q'} (L p'); no pointing is compared
module Delta1 (X : U l) (x0 : X) (X' : U l) (x0' : X') (W : U l) (w0 : W)
  (L : PtMap (Id X' x0' x0') (refl x0') (Id X x0 x0) (refl x0))
  (mult : (p q : Id X' x0' x0') -> Id (Id X x0 x0) (L.1 (trans X' x0' x0' x0' p q)) (trans X x0 x0 x0 (L.1 p) (L.1 q)))
  (f : Maps[X, x0, W, w0].PMO) {
  module I = Inv[X, x0, W, w0] ;
  module I' = Inv[X', x0', W, w0] ;
  d1 (q' p' : Id X' x0' x0') :
    Id (Id W w0 w0) ((I'.Delta (ptcomp (Id X' x0' x0') (refl x0') (Id X x0 x0) (refl x0) (Id W w0 w0) (refl w0) L f) q').1 p') ((I.Delta f (L.1 q')).1 (L.1 p')) =
    calc (Id W w0 w0) {
      (I'.Delta (ptcomp (Id X' x0' x0') (refl x0') (Id X x0 x0) (refl x0) (Id W w0 w0) (refl w0) L f) q').1 p'
        =< I'.Delta-fun (ptcomp (Id X' x0' x0') (refl x0') (Id X x0 x0) (refl x0) (Id W w0 w0) (refl w0) L f) q' p' >
      I'.dfun (ptcomp (Id X' x0' x0') (refl x0') (Id X x0 x0) (refl x0) (Id W w0 w0) (refl w0) L f) q' p'
        =< refl (I'.dfun (ptcomp (Id X' x0' x0') (refl x0') (Id X x0 x0) (refl x0) (Id W w0 w0) (refl w0) L f) q' p') >
      trans W w0 w0 w0 (trans W w0 w0 w0 (sym W w0 w0 ((ptcomp (Id X' x0' x0') (refl x0') (Id X x0 x0) (refl x0) (Id W w0 w0) (refl w0) L f).1 p')) ((ptcomp (Id X' x0' x0') (refl x0') (Id X x0 x0) (refl x0) (Id W w0 w0) (refl w0) L f).1 (trans X' x0' x0' x0' p' q'))) (sym W w0 w0 ((ptcomp (Id X' x0' x0') (refl x0') (Id X x0 x0) (refl x0) (Id W w0 w0) (refl w0) L f).1 q'))
        =< refl (trans W w0 w0 w0 (trans W w0 w0 w0 (sym W w0 w0 ((ptcomp (Id X' x0' x0') (refl x0') (Id X x0 x0) (refl x0) (Id W w0 w0) (refl w0) L f).1 p')) ((ptcomp (Id X' x0' x0') (refl x0') (Id X x0 x0) (refl x0) (Id W w0 w0) (refl w0) L f).1 (trans X' x0' x0' x0' p' q'))) (sym W w0 w0 ((ptcomp (Id X' x0' x0') (refl x0') (Id X x0 x0) (refl x0) (Id W w0 w0) (refl w0) L f).1 q'))) >
      trans W w0 w0 w0 (trans W w0 w0 w0 (sym W w0 w0 (f.1 (L.1 p'))) (f.1 (L.1 (trans X' x0' x0' x0' p' q')))) (sym W w0 w0 (f.1 (L.1 q')))
        =< apH (\ u -> trans W w0 w0 w0 (trans W w0 w0 w0 (sym W w0 w0 (f.1 (L.1 p'))) (f.1 u)) (sym W w0 w0 (f.1 (L.1 q')))) (mult p' q') >
      trans W w0 w0 w0 (trans W w0 w0 w0 (sym W w0 w0 (f.1 (L.1 p'))) (f.1 (trans X x0 x0 x0 (L.1 p') (L.1 q')))) (sym W w0 w0 (f.1 (L.1 q')))
        =< symH (I.Delta-fun f (L.1 q') (L.1 p')) >
      (I.Delta f (L.1 q')).1 (L.1 p') } ;
} ;

-- (lambda1): lambda_g (L ; m) = lambda_{loop^2 L g} (m)
lam-pre (X : U l) (x0 : X) (X' : U l) (x0' : X') (W : U l) (w0 : W)
  (L : PtMap (Id X' x0' x0') (refl x0') (Id X x0 x0) (refl x0)) (m : Maps[X, x0, W, w0].PMO)
  (g : Id (Id (Id X' x0' x0') (refl x0') (refl x0')) (refl (refl x0')) (refl (refl x0'))) :
  Id (Id (Id (Id W w0 w0) (refl w0) (refl w0)) (refl (refl w0)) (refl (refl w0)))
    (Inv[X', x0', W, w0].lam g (ptcomp (Id X' x0' x0') (refl x0') (Id X x0 x0) (refl x0) (Id W w0 w0) (refl w0) L m))
    (Inv[X, x0, W, w0].lam ((Maps[Id (Id X' x0' x0') (refl x0') (refl x0'), refl (refl x0'), Id (Id X x0 x0) (refl x0) (refl x0), refl (refl x0)].loop
                               (Maps[Id X' x0' x0', refl x0', Id X x0 x0, refl x0].loop L)).1 g) m) =
  loop2-comp (Id X' x0' x0') (refl x0') (Id X x0 x0) (refl x0) (Id W w0 w0) (refl w0) L m g ;

------------------------------------------------------------------------
-- Lemma (lambda3)

-- first equation: E c at x is loop^2 (c ; ev_x) at gamma0
module ELoop (Y : U l) (y0 : Y) {
  module EN = H4Bilinear[l].ENat[Y, y0, Y, y0, ptid Y y0] ;
  module ED = H4Bilinear[l].EDef[Y, y0] ;
  module MV = Maps[EN.M, EN.L4.pt0, Y, y0] ;
  module MC = Maps[KZ2, kz2, Y, y0] ;
  module MC2 = Maps[Id KZ2 kz2 kz2, refl kz2, Id Y y0 y0, refl y0] ;
  -- evaluation at x, as a pointed map
  Evx (x : KZ2) : PtMap EN.M EN.L4.pt0 Y y0 = (\ F -> F.1 x, refl y0) ;
  cx (c : PtMap KZ2 kz2 EN.M EN.L4.pt0) (x : KZ2) : PtMap KZ2 kz2 Y y0 = ptcomp KZ2 kz2 EN.M EN.L4.pt0 Y y0 c (Evx x) ;
  -- the generator of Omega^2 K(Z,2), for the circle of E
  gamma0 : Id (Id KZ2 kz2 kz2) (refl kz2) (refl kz2) = (Maps[EN.K1, EN.k0, Id KZ2 kz2 kz2, refl kz2].loop CS.e1inv).1 EN.C.g ;
  -- looping ev_x is ap of evaluation (loop-ap; the pointing of ev_x is refl)
  ev-loop (x : KZ2) (P : Id EN.M EN.L4.pt0 EN.L4.pt0) :
    Id (Id Y y0 y0) ((MV.loop (Evx x)).1 P) (ap EN.M Y (\ F -> F.1 x) EN.L4.pt0 EN.L4.pt0 P) =
    transH (MV.loop-ap (Evx x) P) (trans-refl-l Y y0 y0 (ap EN.M Y (\ F -> F.1 x) EN.L4.pt0 EN.L4.pt0 P)) ;
  module At (c : PtMap KZ2 kz2 EN.M EN.L4.pt0) (x : KZ2) {
    A1 : PtMap EN.K1 EN.k0 (Id Y y0 y0) (refl y0) = ptcomp EN.K1 EN.k0 EN.N EN.LO.pt0 (Id Y y0 y0) (refl y0) (EN.phi c) (EN.Ex x) ;
    A2 : PtMap EN.K1 EN.k0 (Id Y y0 y0) (refl y0) = ptcomp EN.K1 EN.k0 (Id KZ2 kz2 kz2) (refl kz2) (Id Y y0 y0) (refl y0) CS.e1inv (MC.loop (cx c x)) ;
    -- an unpointed homotopy A1 = A2
    hh (k : EN.K1) : Id (Id Y y0 y0) (A1.1 k) (A2.1 k) =
      transH (EN.L4.ev-ap EN.L4.pt0 ((EN.MM.loop c).1 (CS.e1inv.1 k)) x)
        (symH (transH (apH (\ L -> L.1 (CS.e1inv.1 k)) (loop-comp KZ2 kz2 EN.M EN.L4.pt0 Y y0 c (Evx x)))
                 (ev-loop x ((EN.MM.loop c).1 (CS.e1inv.1 k))))) ;
    e-loop : Id (Id (Id Y y0 y0) (refl y0) (refl y0)) ((ED.E c).1 x) ((MC2.loop (MC.loop (cx c x))).1 gamma0) =
      transH (EN.E-loop c x)
        (transH (LoopIrr[EN.K1, EN.k0, Y, y0, A1, A2, hh].irr EN.C.g)
           (apH (\ L -> L.1 EN.C.g) (loop-comp EN.K1 EN.k0 (Id KZ2 kz2 kz2) (refl kz2) (Id Y y0 y0) (refl y0) CS.e1inv (MC.loop (cx c x))))) ;
  } ;
} ;

-- second equation: through pointed equivalences e2 : Omega X ~ K(Z,2), e4 : Omega W ~ Y
module EDelta (X : U l) (x0 : X) (W : U l) (w0 : W) (Y : U l) (y0 : Y)
  (e2 : PtEquiv (Id X x0 x0) (refl x0) KZ2 kz2) (e4 : PtEquiv (Id W w0 w0) (refl w0) Y y0) {
  module EL = ELoop[Y, y0] ;
  module MX = Maps[X, x0, W, w0] ;
  module I = Inv[X, x0, W, w0] ;
  e2i : PtMap KZ2 kz2 (Id X x0 x0) (refl x0) = (pt-inv (Id X x0 x0) (refl x0) KZ2 kz2 e2).1 ;
  e4i : PtMap Y y0 (Id W w0 w0) (refl w0) = (pt-inv (Id W w0 w0) (refl w0) Y y0 e4).1 ;
  -- gamma^0 = loop^2 e2^-1 gamma0
  gamma-hat : Id (Id (Id X x0 x0) (refl x0) (refl x0)) (refl (refl x0)) (refl (refl x0)) =
    (Maps[Id KZ2 kz2 kz2, refl kz2, Id (Id X x0 x0) (refl x0) (refl x0), refl (refl x0)].loop (Maps[KZ2, kz2, Id X x0 x0, refl x0].loop e2i)).1 EL.gamma0 ;
  module At (c : PtMap KZ2 kz2 EL.EN.M EL.EN.L4.pt0) (x : KZ2) (m : MX.PMO)
    (H : (y : KZ2) -> Id Y ((c.1 y).1 x) (e4.1.1 (m.1 (e2i.1 y)))) {
    P : PtMap KZ2 kz2 (Id W w0 w0) (refl w0) = ptcomp KZ2 kz2 (Id X x0 x0) (refl x0) (Id W w0 w0) (refl w0) e2i m ;
    Q : PtMap KZ2 kz2 (Id W w0 w0) (refl w0) = ptcomp KZ2 kz2 Y y0 (Id W w0 w0) (refl w0) (EL.cx c x) e4i ;
    -- P and Q have pointwise equal functions (H, then e4^-1 e4 = id)
    hq (y : KZ2) : Id (Id W w0 w0) (P.1 y) (Q.1 y) =
      symH (transH (apH e4i.1 (H y))
              (apH (\ F -> F.1 (m.1 (e2i.1 y))) (pt-inv-l (Id W w0 w0) (refl w0) Y y0 e4))) ;
    -- c ; ev_x = Q ; e4
    back : Id (PtMap KZ2 kz2 Y y0) (ptcomp KZ2 kz2 (Id W w0 w0) (refl w0) Y y0 Q e4.1) (EL.cx c x) =
      transH (ptcomp-assoc KZ2 kz2 Y y0 (Id W w0 w0) (refl w0) Y y0 (EL.cx c x) e4i e4.1)
        (transH (apH (ptcomp KZ2 kz2 Y y0 Y y0 (EL.cx c x)) (pt-inv-r (Id W w0 w0) (refl w0) Y y0 e4))
           (Fibres[l].ptcomp-idr KZ2 kz2 Y y0 (EL.cx c x))) ;
    e-delta : Id (Id (Id Y y0 y0) (refl y0) (refl y0)) ((EL.ED.E c).1 x)
        ((Maps[Id (Id W w0 w0) (refl w0) (refl w0), refl (refl w0), Id Y y0 y0, refl y0].loop (Maps[Id W w0 w0, refl w0, Y, y0].loop e4.1)).1 (I.lam gamma-hat m)) =
      calc (Id (Id Y y0 y0) (refl y0) (refl y0)) {
        (EL.ED.E c).1 x
          =< EL.At[c, x].e-loop >
        (EL.MC2.loop (EL.MC.loop (EL.cx c x))).1 EL.gamma0
          =< apH (\ F -> (EL.MC2.loop (EL.MC.loop F)).1 EL.gamma0) (symH back) >
        (EL.MC2.loop (EL.MC.loop (ptcomp KZ2 kz2 (Id W w0 w0) (refl w0) Y y0 Q e4.1))).1 EL.gamma0
          =< loop2-comp KZ2 kz2 (Id W w0 w0) (refl w0) Y y0 Q e4.1 EL.gamma0 >
        (Maps[Id (Id W w0 w0) (refl w0) (refl w0), refl (refl w0), Id Y y0 y0, refl y0].loop (Maps[Id W w0 w0, refl w0, Y, y0].loop e4.1)).1
          ((Maps[Id KZ2 kz2 kz2, refl kz2, Id (Id W w0 w0) (refl w0) (refl w0), refl (refl w0)].loop (Maps[KZ2, kz2, Id W w0 w0, refl w0].loop Q)).1 EL.gamma0)
          =< apH (Maps[Id (Id W w0 w0) (refl w0) (refl w0), refl (refl w0), Id Y y0 y0, refl y0].loop (Maps[Id W w0 w0, refl w0, Y, y0].loop e4.1)).1
               (symH (PtIrr[KZ2, kz2, W, w0, P, Q, hq].lambda0 EL.gamma0)) >
        (Maps[Id (Id W w0 w0) (refl w0) (refl w0), refl (refl w0), Id Y y0 y0, refl y0].loop (Maps[Id W w0 w0, refl w0, Y, y0].loop e4.1)).1
          ((Maps[Id KZ2 kz2 kz2, refl kz2, Id (Id W w0 w0) (refl w0) (refl w0), refl (refl w0)].loop (Maps[KZ2, kz2, Id W w0 w0, refl w0].loop P)).1 EL.gamma0)
          =< apH (Maps[Id (Id W w0 w0) (refl w0) (refl w0), refl (refl w0), Id Y y0 y0, refl y0].loop (Maps[Id W w0 w0, refl w0, Y, y0].loop e4.1)).1
               (loop2-comp KZ2 kz2 (Id X x0 x0) (refl x0) (Id W w0 w0) (refl w0) e2i m EL.gamma0) >
        (Maps[Id (Id W w0 w0) (refl w0) (refl w0), refl (refl w0), Id Y y0 y0, refl y0].loop (Maps[Id W w0 w0, refl w0, Y, y0].loop e4.1)).1 ((Maps[Id (Id X x0 x0) (refl x0) (refl x0), refl (refl x0), Id (Id W w0 w0) (refl w0) (refl w0), refl (refl w0)].loop (Maps[Id X x0 x0, refl x0, Id W w0 w0, refl w0].loop m)).1 ((Maps[Id KZ2 kz2 kz2, refl kz2, Id (Id X x0 x0) (refl x0) (refl x0), refl (refl x0)].loop (Maps[KZ2, kz2, Id X x0 x0, refl x0].loop e2i)).1 EL.gamma0))
          =< refl ((Maps[Id (Id W w0 w0) (refl w0) (refl w0), refl (refl w0), Id Y y0 y0, refl y0].loop (Maps[Id W w0 w0, refl w0, Y, y0].loop e4.1)).1 ((Maps[Id (Id X x0 x0) (refl x0) (refl x0), refl (refl x0), Id (Id W w0 w0) (refl w0) (refl w0), refl (refl w0)].loop (Maps[Id X x0 x0, refl x0, Id W w0 w0, refl w0].loop m)).1 gamma-hat)) >
        (Maps[Id (Id W w0 w0) (refl w0) (refl w0), refl (refl w0), Id Y y0 y0, refl y0].loop (Maps[Id W w0 w0, refl w0, Y, y0].loop e4.1)).1 ((Maps[Id (Id X x0 x0) (refl x0) (refl x0), refl (refl x0), Id (Id W w0 w0) (refl w0) (refl w0), refl (refl w0)].loop (Maps[Id X x0 x0, refl x0, Id W w0 w0, refl w0].loop m)).1 gamma-hat)
          =< refl ((Maps[Id (Id W w0 w0) (refl w0) (refl w0), refl (refl w0), Id Y y0 y0, refl y0].loop (Maps[Id W w0 w0, refl w0, Y, y0].loop e4.1)).1 (I.lam gamma-hat m)) >
        (Maps[Id (Id W w0 w0) (refl w0) (refl w0), refl (refl w0), Id Y y0 y0, refl y0].loop (Maps[Id W w0 w0, refl w0, Y, y0].loop e4.1)).1 (I.lam gamma-hat m) } ;
  } ;
