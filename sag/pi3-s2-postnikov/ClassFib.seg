-- Theorem 41 of Hart-Milner at a simply connected base
-- (doc/postnikov-classification.pdf, section 5).  For V : Stage[0]
-- (X = V.X, v0 = V.pt):
--     (W : Stage[1]) * (X, v0) ->pt (Tor W, ptT W)  ~  Fam V,
--     Fam V = (F : X -> U) * F v0 * ((v : X) -> C (F v)),
--     C Y = isConn 4 Y * isTrunc 5 Y,
-- by (W, k, p) |-> (v |-> el (k v).1, tr (k v0) p^-1, ..).
--   TorW[W]     Tor W = K(W,1)-torsors (EM.Step[1, W]; Tor (K3 B) is K(B,4)
--               by definition), tau = Theorem 36(1) (from the centre);
--               TorL W = (Y : U) * ||Y|| * Mu Y and toL : Tor W ~ TorL W
--               (el is an embedding, every Y with ||Y|| * Mu Y in its image:
--               tor-fib, as Presentation.Pres.tor-fib)
--   Key[X, v0, cX, F]   Lemma 9: S F = (W : Stage[1]) * ((v : X) -> ||F v||
--               * Mu_W (F v)) is a proposition (contractible when inhabited:
--               a retract of (W : Stage[1]) * ((e : E) -> W = G e), E = Sigma F,
--               ClassBase.const-contr) equivalent to (v : X) -> C (F v)
--               (to-C; existence by lemma4 over E, as Presentation.Pres.ext)
--   Chain[V]    steps 1-4 of Proposition 8 and fib-equiv
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FunExtUA[l] ; open HLevels[l] ; open Connected[l] ;
open Lemma4[l] ; open PtEquivOps[l] ; open SphereUniversal[l] ; open PostnikovRealization[l] ;
module EMf = EM[l] ; module CB = ClassBase[l] ; module CM = ConnectedMaps[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module P1 = Prelude[l+] ; module H1 = HLevels[l+] ; module FU1 = FunExtUA[l+] ; module E1 = Equivalences[l+] ;
module Eq = Equivalences[l] ; module FL = Axioms[l].FunExtLemmas[fe @l] ;

St1 : U l+ = EMf.Stage[suc zero] ;

C (Y : U l) : U l = isConn four Y * isTrunc five Y ;
c-prop (Y : U l) : isProp (C Y) = isProp-Sigma (isConn four Y) (\ c -> isTrunc five Y) (conn-prop four Y) (\ c -> trunc-prop five Y) ;

Fam (V : EMf.Stage[zero]) : U l+ = (F : V.X -> U l) * F V.pt * ((v : V.X) -> C (F v)) ;

------------------------------------------------------------------------
-- torsors over W

module TorW (W : St1) {
  module S = EMf.Step[suc zero, W] ;
  module T = S.T ;
  Tor : U l = T.Tor ;
  ptT : Tor = S.D.ptT ;
  -- Theorem 36(1): (ptT = t) ~ el t
  tau (t : Tor) : Equiv (Id Tor ptT t) (T.el t.1) = (S.D.F.tr t, S.D.F.equiv t) ;

  Q (Z : U l) : U l = Tr.Trunc[Z].carrier * T.Mu Z ;
  TorL : U l+ = (Y : U l) * Q Y ;
  toL (t : Tor) : TorL = (T.el t.1, t.2) ;
  tor-fib (u : TorL) : T.Fib u.1 =
    TC.rec u.1 @(l+) (T.Fib u.1) (T.fib-prop u.1) (\ y -> (T.fib-contr u.1 (u.2.1, u.2.2, y)).1) u.2.1 ;
  ofL (u : TorL) : Tor =
    ((tor-fib u).1, P1.subst (U l) (\ Z0 -> Q Z0) u.1 (T.el (tor-fib u).1) (P1.sym (U l) (T.el (tor-fib u).1) u.1 (tor-fib u).2) u.2) ;
  back-gen (Y : U l) (Z : U l) (p : Id (U l) Z Y) (w : Q Y) : Id TorL (Z, P1.subst (U l) (\ Z0 -> Q Z0) Y Z (P1.sym (U l) Z Y p) w) (Y, w) =
    Paths[l+].idJR (U l) Y (\ Z1 p1 -> Id TorL (Z1, P1.subst (U l) (\ Z0 -> Q Z0) Y Z1 (P1.sym (U l) Z1 Y p1) w) (Y, w)) (refl (Y, w)) Z p ;
  toL-ofL (u : TorL) : Id TorL (toL (ofL u)) u = back-gen u.1 (T.el (tor-fib u).1) (tor-fib u).2 u.2 ;
  ofL-toL (t : Tor) : Id Tor (ofL (toL t)) t =
    P1.ap (T.Fib (T.el t.1)) Tor
      (\ z -> (z.1, P1.subst (U l) (\ Z0 -> Q Z0) (T.el t.1) (T.el z.1) (P1.sym (U l) (T.el z.1) (T.el t.1) z.2) t.2))
      (tor-fib (toL t)) (t.1, refl (T.el t.1))
      (T.fib-prop (T.el t.1) (tor-fib (toL t)) (t.1, refl (T.el t.1))) ;
  toL-equiv : P1.isEquiv Tor TorL toL = P1.qinv Tor TorL toL ofL toL-ofL ofL-toL ;
} ;

------------------------------------------------------------------------
-- Lemma 9

module Key (X : U l) (v0 : X) (cX : isConn three X) (F : X -> U l) {
  Mu (W : St1) (Y : U l) : U l = (y : Y) -> PtEquiv W.X W.pt Y y ;
  S : U l+ = (W : St1) * ((v : X) -> Tr.Trunc[F v].carrier * Mu W (F v)) ;
  PiC : U l = (v : X) -> C (F v) ;
  piC-prop : isProp PiC = FL.isProp-Pi X (\ v -> C (F v)) (\ v -> c-prop (F v)) ;

  -- the structure gives the levels
  to-C (s : S) (v : X) : C (F v) =
    Tr.Trunc[F v].induction @l (\ t -> C (F v)) (\ t -> c-prop (F v))
      (\ y -> (Deloop[l].equiv-conn four (F v) s.1.X (Acc[F v, y, s.1.X, s.1.pt, pt-inv s.1.X s.1.pt (F v) y ((s.2 v).2 y)].equiv) s.1.conn,
               equiv-trunc' five s.1.X (F v) Acc[s.1.X, s.1.pt, F v, y, (s.2 v).2 y].equiv s.1.trunc))
      (s.2 v).1 ;

  E : U l = (v : X) * F v ;
  cE (c : PiC) : isConn three E = CB.total-conn three X F cX (\ v -> conn-down three (F v) (c v).1) ;
  G (c : PiC) (e : E) : St1 = new EMf.Stage[suc zero, F e.1, e.2, (c e.1).1, (c e.1).2] ;
  A' (c : PiC) : U l+ = (W : St1) * ((e : E) -> Id St1 W (G c e)) ;

  -- S is a proposition
  module Uniq (s0 : S) {
    c : PiC = to-C s0 ;
    eqv (W : St1) (e : E) : P1.Equiv (Id St1 W (G c e)) (PtEquiv W.X W.pt (F e.1) e.2) = CB.StageId[suc zero].I[W].equiv (G c e) ;
    sa (s : S) : A' c = (s.1, \ e -> (eqv s.1 e).2.sec ((s.2 e.1).2 e.2)) ;
    ra (a : A' c) : S = (a.1, \ v -> ((c v).1.1, \ y -> (eqv a.1 (v, y)).1 (a.2 (v, y)))) ;
    rs (s : S) : Id S (ra (sa s)) s =
      P1.ap ((v : X) -> Tr.Trunc[F v].carrier * Mu s.1 (F v)) S (\ m -> (s.1, m)) (ra (sa s)).2 s.2
        (FL.funext X (\ v -> Tr.Trunc[F v].carrier * Mu s.1 (F v)) (ra (sa s)).2 s.2 (\ v ->
          CB.pair-path Tr.Trunc[F v].carrier (Mu s.1 (F v)) (c v).1.1 (s.2 v).1 ((ra (sa s)).2 v).2 (s.2 v).2
            (Tr.Trunc[F v].proposition (c v).1.1 (s.2 v).1)
            (FL.funext (F v) (\ y -> PtEquiv s.1.X s.1.pt (F v) y) ((ra (sa s)).2 v).2 (s.2 v).2 (\ y ->
               (eqv s.1 (v, y)).2.sec-eq ((s.2 v).2 y))))) ;
    contr : FU1.isContr S =
      H1.retract-contr S (A' c) sa ra rs (CB.const-contr E (cE c) St1 CB.stage-gpd (G c)) ;
  } ;
  s-prop : P1.isProp S = CB.prop-of-contr S (\ s0 -> Uniq[s0].contr) ;

  -- existence: Lemma 4 over E (Presentation.Pres.ext)
  module Exist (c : PiC) (y0 : F v0) {
    W0 : St1 = new EMf.Stage[suc zero, F v0, y0, (c v0).1, (c v0).2] ;
    Qe (e : E) : U l = PtEquiv (F v0) y0 (F e.1) e.2 ;
    q-set (e : E) : isTrunc two (Qe e) = cor5-equiv (suc zero) three (F v0) y0 (c v0).1 (F e.1) e.2 (c e.1).2 ;
    ext : isContr (PtSec E (v0, y0) Qe (idPt (F v0) y0)) = lemma4 zero two E (v0, y0) (cE c) Qe q-set (idPt (F v0) y0) ;
    s : S = (W0, \ v -> ((c v).1.1, \ y -> ext.1.1 (v, y))) ;
  } ;
  of-C (c : PiC) : S =
    Tr.Trunc[F v0].induction @(l+) (\ t -> S) (\ t -> s-prop) (\ y0 -> Exist[c, y0].s) (c v0).1.1 ;

  key : P1.Equiv S PiC = CB.prop-equiv S PiC s-prop piC-prop to-C of-C ;
} ;

------------------------------------------------------------------------
-- Proposition 8

module Chain (V : EMf.Stage[zero]) {
  X : U l = V.X ;
  v0 : X = V.pt ;
  -- step 1
  T0 (W : St1) : U l = PtMap X v0 TorW[W].Tor TorW[W].ptT ;
  T1 (W : St1) : U l = (k : X -> TorW[W].Tor) * TorW[W].T.el (k v0).1 ;
  e01 (W : St1) : P1.Equiv (T0 W) (T1 W) =
    CB.raise (T0 W) (T1 W)
      (Fibres[l].sigma-equiv (X -> TorW[W].Tor) (\ k -> Id TorW[W].Tor (k v0) TorW[W].ptT) (\ k -> TorW[W].T.el (k v0).1)
         (\ k -> Eq.compose (Id TorW[W].Tor (k v0) TorW[W].ptT) (Id TorW[W].Tor TorW[W].ptT (k v0)) (TorW[W].T.el (k v0).1)
                   (CM.sym-equiv TorW[W].Tor (k v0) TorW[W].ptT) (TorW[W].tau (k v0)))) ;
  -- step 2
  T2 (W : St1) : U l+ = (k : X -> TorW[W].TorL) * (k v0).1 ;
  post (W : St1) : P1.Equiv (X -> TorW[W].Tor) (X -> TorW[W].TorL) =
    (\ k v -> TorW[W].toL (k v),
     PiEquiv[l+].pi-equiv X (\ v -> TorW[W].Tor) (\ v -> TorW[W].TorL) (\ v -> TorW[W].toL) (\ v -> TorW[W].toL-equiv)) ;
  e12 (W : St1) : P1.Equiv (T1 W) (T2 W) =
    (\ w -> ((post W).1 w.1, w.2), SphereAxiom[l+].sigma-base (X -> TorW[W].Tor) (X -> TorW[W].TorL) (post W) (\ k -> (k v0).1)) ;
  -- step 3
  T3 : U l+ = (F : X -> U l) * F v0 * Key[X, v0, V.conn, F].S ;
  s23 (w : (W : St1) * T2 W) : T3 = (\ v -> (w.2.1 v).1, w.2.2, (w.1, \ v -> (w.2.1 v).2)) ;
  r23 (u : T3) : (W : St1) * T2 W = (u.2.2.1, \ v -> (u.1 v, u.2.2.2 v), u.2.1) ;
  e23 : P1.Equiv ((W : St1) * T2 W) T3 = (s23, P1.qinv ((W : St1) * T2 W) T3 s23 r23 (\ u -> refl u) (\ w -> refl w)) ;
  -- step 4
  e34 : P1.Equiv T3 (Fam V) =
    Fibres[l+].sigma-equiv (X -> U l) (\ F -> F v0 * Key[X, v0, V.conn, F].S) (\ F -> F v0 * Key[X, v0, V.conn, F].PiC) (\ F ->
      Fibres[l+].sigma-equiv (F v0) (\ y -> Key[X, v0, V.conn, F].S) (\ y -> Key[X, v0, V.conn, F].PiC) (\ y -> Key[X, v0, V.conn, F].key)) ;

  fib-equiv : P1.Equiv ((W : St1) * T0 W) (Fam V) =
    E1.compose ((W : St1) * T0 W) ((W : St1) * T2 W) (Fam V)
      (Fibres[l+].sigma-equiv St1 (\ W -> T0 W) (\ W -> T2 W) (\ W -> E1.compose (T0 W) (T1 W) (T2 W) (e01 W) (e12 W)))
      (E1.compose ((W : St1) * T2 W) T3 (Fam V) e23 e34) ;
} ;
