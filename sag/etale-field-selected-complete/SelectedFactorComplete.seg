-- Complete selected separable monogenic factor. Construct monic
-- annihilators and collect their coefficients before the finite-field
-- dichotomy. The large branch uses the tensor separator; the small
-- branch lifts those same equations to the actual finite subfield.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) {
 module C = Algebras[l].Over[k,setk] ; module St = SelectedFactorStatement[l].Over[k,setk] ;
 module At (S : C.Algebra) (input : St.At[S].Input)
  (reduced : (a : S.ring.R) -> Id S.ring.R (S.ring.mul a a) S.ring.z -> Id S.ring.R a S.ring.z)
  (D : C.Algebra) (cp : Tensor[l].Over[k,setk].Coproduct S S D)
  (epsilon : DiagonalCertificate[l].Over[k,setk].At[S,D,cp].Witness) {
  module Target = St.At[S] ;
  module Monic = FiniteMonicCoefficientFamily[l].Over[k,setk,S,input.rank,input.basis] ;
  module Separator = DiagonalSeparator[l].Over[k,setk,input.field.decide,input.field.nonzero].At[
   S,D,cp,input.rank,input.basis,epsilon] ;
  module Selected = SeparatorSelectedFactor[l].Over[k,setk,input.field,S,input.rank,input.basis,reduced,input.perfect-trace,input.prime] ;
  module Given (m : Monic.Data) {
   module Coefficients = FiniteCoefficientField[l].Over[k,setk,input.field.decide,input.field.nonzero,m.count,m.coefficient] ;
   module Large (many : Coefficients.Closure.Distinct Separator.count) {
    separator : Separator.Data = Separator.theorem many.1 many.2 ;
    result : Target.Result input = Selected.Separator[D,cp,epsilon,separator.element,separator.inverse,separator.equation].theorem ;
   } ;
   module Small (K0 : Coefficients.Subfield) {
    module Lift = Monic.Given[m].Lift[K0.ring,K0.set,K0.inclusion,K0.coefficient,K0.coefficient-image] ;
    module Branch = SmallFieldBranch[l].Over[k,setk].At[S,input].Coefficients[m.count,m.coefficient,K0].Given[reduced,Lift.lower,Lift.roots] ;
    result : Target.Result input = Branch.result ;
   } ;
   cases : Coefficients.Result Separator.degree -> Target.Result input = split {
    inl many -> Large[many].result ; inr K0 -> Small[K0].result } ;
   result : Target.Result input = cases (Coefficients.theorem Separator.degree) ;
  } ;
  theorem : Target.Result input = TC.rec Monic.Data @l (Target.Result input)
   Tr.Trunc[Target.Selected[input.rank,input.basis,input.prime]].proposition (\ m -> Given[m].result) Monic.theorem ;
 } ;
} ;
