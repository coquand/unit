-- Run the actual complete theorem on the base field F2, including its
-- constructed tensor and diagonal. Explicit branch inputs additionally
-- exercise both sides of the large/small assembly and coefficient lift.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module R = SeparatorRegression[l] ; module B = BooleanRing[l] ;
module C = R.C ; module L = RL[R.k] ; module St = SelectedFactorStatement[l].Over[R.k,B.bool-set] ;
module Target = St.At[C.base] ;
field : St.Field = new St.Field[R.dec,R.nontrivial] ;
reduced (a : R.k.R) (h : Id R.k.R (R.k.mul a a) R.k.z) : Id R.k.R a R.k.z = trans (sym (B.and-self a)) h ;
member (a : R.k.R) : U l = Id R.k.R a R.k.z ;
ideal : RegularIdeal[l].IdealPred[R.k] = RegularIdeal[l].mkIdealPred R.k member (refl false)
 (\ a b ha hb -> trans (cong2 R.k.R R.k.add _ _ _ _ ha hb) (R.k.addZ false))
 (\ a b hb -> trans (ap (R.k.mul a) hb) (L.mul-zero a)) ;
prime-product : (a b : R.k.R) -> Id R.k.R (R.k.mul a b) false -> Plus (Id R.k.R a false) (Id R.k.R b false) = split {
 false -> \ b h -> inl (refl false) ;
 true -> split { false -> \ h -> inr (refl false) ; true -> \ h -> efq (R.nontrivial h) } } ;
zero-dec : (a : R.k.R) -> Plus (Id R.k.R a false) (Not (Id R.k.R a false)) = split {
 false -> inl (refl false) ; true -> inr R.nontrivial } ;
prime : PrimeIdempotents[l].Over[R.k].Prime = new PrimeIdempotents[l].Over[R.k].Prime[
 ideal,\ a -> B.bool-set a false,R.nontrivial,prime-product,zero-dec] ;
perfect : PerfectTraceNondegenerate[l].Over[R.k,B.bool-set,C.base,R.one,R.base-basis].Perfect = (true,refl true) ;
input : Target.Input = new Target.Input[field,R.one,R.base-basis,perfect,prime] ;
eight : Nat = suc (suc (suc (suc (suc (suc (suc (suc zero))))))) ;
module Main = SelectedFactorComplete[l].Over[R.k,B.bool-set] ;
module WithDiagonal (epsilon : R.Actual.Diag.Witness) {
 module Apply = Main.At[C.base,input,reduced,R.Actual.T.T,R.Actual.T.coproduct,epsilon] ;
 complete : Target.Result input = Apply.theorem ;
 monic : Apply.Monic.Data = new Apply.Monic.Data[\ i -> cons true nil,\ i -> refl false,
  R.one,\ i -> true,\ i -> (inr tt,refl true,tt)] ;
 module Given = Apply.Given[monic] ;
 large : Target.Result input = Given.cases (inl (R.candidates,R.distinct)) ;
 covers : (a : R.k.R) -> (i : Fin R.two) * Id R.k.R (R.candidates i) a = split {
  false -> (inl (inr tt),refl false) ; true -> (inr tt,refl true) } ;
 subfield : Given.Coefficients.Subfield = new Given.Coefficients.Subfield[
  R.k,B.bool-set,RingHom[l].identity R.k,\ a b h -> h,R.dec,R.nontrivial,R.two,
  R.candidates,R.distinct,covers,monic.coefficient,\ i -> refl (monic.coefficient i)] ;
 small : Target.Result input = Given.cases (inr subfield) ;
 lifted-list : Id (List R.k.R) (Given.Small[subfield].Lift.lower (inr tt)) (cons true nil) = refl (cons true nil) ;
 lifted-root : Id R.k.R
  (MonicBasisUniversal[l].Values[R.k,R.k,RingHom[l].identity R.k,true].value (Given.Small[subfield].Lift.lower (inr tt))) false =
  Given.Small[subfield].Lift.roots (inr tt) ;
 branch-tag : Given.Coefficients.Result Apply.Separator.degree -> Nat = split { inl many -> zero ; inr K0 -> suc zero } ;
 chosen-large : Id Nat (branch-tag (Given.Coefficients.theorem Apply.Separator.degree)) zero = refl zero ;
 -- A larger stopping bound forces the actual coefficient closure to
 -- return the finite subfield, and the same lifting assembly runs.
 polynomial : List R.k.R = cons false (cons true (cons true nil)) ;
 all-roots : (a : R.k.R) -> Id R.k.R (Poly[l].PolyR[R.k].ev polynomial a) false = split {
  false -> refl false ; true -> refl false } ;
 module RB = PolynomialRootBound[l].Over[R.k].Field[\ a h -> (DiscreteFieldOperations[l].Over[R.k,B.bool-set,R.dec,R.nontrivial].inverse a,
  DiscreteFieldOperations[l].Over[R.k,B.bool-set,R.dec,R.nontrivial].inverse-law a h)] ;
 no-many (many : Given.Coefficients.Closure.Distinct (suc eight)) : Empty =
  R.nontrivial (RB.theorem (suc eight) polynomial (\ j -> refl false) many.1 many.2 (\ i -> all-roots (many.1 i)) R.two) ;
 wide-cases : Given.Coefficients.Result eight -> Target.Result input = split {
  inl many -> efq (no-many many) ; inr K0 -> Given.Small[K0].result } ;
 small-from-closure : Target.Result input = wide-cases (Given.Coefficients.theorem eight) ;
 wide-tag : Given.Coefficients.Result eight -> Nat = split { inl many -> zero ; inr K0 -> suc zero } ;
 chosen-small : Id Nat (wide-tag (Given.Coefficients.theorem eight)) (suc zero) = refl (suc zero) ;
} ;
constructed : Target.Result input = TC.rec R.Actual.Diag.Witness @l (Target.Result input)
 Tr.Trunc[Target.Selected[input.rank,input.basis,input.prime]].proposition
 (\ epsilon -> WithDiagonal[epsilon].complete) R.Actual.theorem ;
