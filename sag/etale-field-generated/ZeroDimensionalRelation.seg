-- A finitely generated zero-dimensional algebra has a rooted, nonempty
-- sparse relation on every nonempty list of generators.  If t is last,
-- choose t^N(1-t*b)=0 and an expression P for b.  The formal polynomial
-- t^N-t^(N+1)P has a distinguished coefficient 1; no test in the algebra
-- and no choice of representatives outside a truncation is used.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TH = Truncation[l+] ; module TC = TruncationCombinators[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (dec : (a : k.R) -> Plus (Id k.R a k.z) (RL[k].unit a))
 (nontrivial : Not (Id k.R k.o k.z)) {
 module C = Algebras[l].Over[k,setk] ; module P = Presentations[l].Over[k,setk] ;
 module Sparse = NagataSparse[l].Over[k,setk,dec,nontrivial] ;
 module At (n : Nat) (S : C.Algebra) (x : Fin (suc n) -> S.ring.R) {
  module G = GeneratedSubalgebra[l].Over[k,setk].At[S,suc n,x] ;
  module Z = IntegralDescent[l].ZeroDim[S.ring,S.set] ;
  module Fam = MonomialFamily[l].Over[k,setk,suc n].Normalized[Sparse.zero-dec] ;
  module Difference = MonomialDifference[l].Over[k,setk,n,Sparse.zero-dec,nontrivial] ;
  module L = RL[S.ring] ; module Pow = AffinePowers[l].Over[S.ring] ;
  t : S.ring.R = x (inr tt) ;
  Rooted : U l+ = (e : P.Expr (Fin (suc n))) * (sparse : Fam.SparseData[e]) *
   Fin sparse.size * Id S.ring.R (P.eval (Fin (suc n)) S x e) S.ring.z ;
  module Witness (w : Z.Witness t) (r : G.Rep w.2.1) {
   module D = Difference.At[w.1,r.1,Fam.expand r.1] ;
   module E = D.Eval[S,x] ;
   product : Id S.ring.R (S.ring.mul (Pow.power t (suc w.1)) w.2.1)
    (S.ring.mul (Pow.power t w.1) (S.ring.mul t w.2.1)) =
    trans (ap (\ a -> S.ring.mul a w.2.1) (S.ring.mulC t (Pow.power t w.1)))
     (sym (S.ring.mulA (Pow.power t w.1) t w.2.1)) ;
   difference-zero : Id S.ring.R
    (S.ring.add (Pow.power t w.1) (S.ring.neg (S.ring.mul (Pow.power t (suc w.1)) w.2.1))) S.ring.z =
    trans (ap (\ a -> S.ring.add (Pow.power t w.1) (S.ring.neg a)) product)
     (trans (ap (\ a -> S.ring.add a (S.ring.neg (S.ring.mul (Pow.power t w.1) (S.ring.mul t w.2.1))))
       (Z.absorption t w.1 w.2.1 w.2.2))
      (S.ring.addN (S.ring.mul (Pow.power t w.1) (S.ring.mul t w.2.1)))) ;
   root : Id S.ring.R (P.eval (Fin (suc n)) S x D.expression) S.ring.z =
    trans E.expression-value
     (trans (ap (\ b -> S.ring.add (Pow.power t w.1) (S.ring.neg (S.ring.mul (Pow.power t (suc w.1)) b))) r.2)
      difference-zero) ;
   rooted : Rooted = (D.expression,D.sparse,D.distinguished,root) ;
  } ;
  from-witness (gen : G.Generators) (w : Z.Witness t) : TH.Trunc[Rooted].carrier =
   TC.rec (G.Rep w.2.1) @l+ TH.Trunc[Rooted].carrier TH.Trunc[Rooted].proposition
    (\ r -> TH.Trunc[Rooted].inc Witness[w,r].rooted) (gen w.2.1) ;
  theorem (gen : G.Generators) (zd : Z.Property) : TH.Trunc[Rooted].carrier =
   TC.rec (Z.Witness t) @l+ TH.Trunc[Rooted].carrier TH.Trunc[Rooted].proposition (from-witness gen) (zd t) ;
 } ;
} ;
