-- Expression generation by one element gives raw univariate polynomial
-- representatives over any commutative set-ring. No field hypothesis.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) {
 module C = Algebras[l].Over[k,setk] ; module P = Presentations[l].Over[k,setk] ;
 module B = PolynomialRing[l].Extension[k,setk] ; module Raw = RawLaws[l].Laws[k] ;
 module M = Mul[l].MulR[k] ;
 module At (S : C.Algebra) (x : S.ring.R) {
  module G = GeneratedSubalgebra[l].Over[k,setk].At[S,suc zero,\ i -> x] ;
  module UP = Universal[l].Property[k,S.ring,setk,S.set].Given[S.iota,x] ;
  raw : P.Expr (Fin (suc zero)) -> List k.R = split {
   var i -> cons k.z (cons k.o nil) ; cst a -> Raw.constantP a ;
   sumE e f | re rf -> M.addP re rf ; mulE e f | re rf -> M.pmul re rf } ;
  sound : (e : P.Expr (Fin (suc zero))) -> Id S.ring.R (UP.extend.1 (B.include (raw e))) (G.ev e) = split {
   var i -> UP.on-variable ; cst a -> UP.on-constants a ;
   sumE e f | re rf ->
    trans (ap UP.extend.1 (sym (B.Add.beta (raw e) (raw f))))
     (trans (UP.extend.2.2.1 (B.include (raw e)) (B.include (raw f)))
      (cong2 S.ring.R S.ring.add _ _ _ _ re rf)) ;
   mulE e f | re rf ->
    trans (ap UP.extend.1 (sym (B.Multiply.beta (raw e) (raw f))))
     (trans (UP.extend.2.2.2 (B.include (raw e)) (B.include (raw f)))
      (cong2 S.ring.R S.ring.mul _ _ _ _ re rf)) } ;
  Representation (c : S.ring.R) : U l = (p : List k.R) * Id S.ring.R (UP.extend.1 (B.include p)) c ;
  PolynomialGeneration : U l = (c : S.ring.R) -> Tr.Trunc[Representation c].carrier ;
  representation (c : S.ring.R) (r : G.Rep c) : Representation c =
   (raw r.1,trans (sound r.1) r.2) ;
  generation (gen : G.Generators) : PolynomialGeneration =
   \ c -> TC.map (G.Rep c) (Representation c) (representation c) (gen c) ;
 } ;
} ;
