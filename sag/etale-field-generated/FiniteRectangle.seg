-- A rectangular finite family is flattened by concatenating rows.
-- The paired sum formula avoids any choice of an indexing equivalence.
level l ; open Ring[l] ; open Presentations[l] ;
size : (n m : Nat) -> Nat = split {
 zero -> \ m -> zero ; suc n | r -> \ m -> plus m (r m) } ;
flatten (A : U l) : (n m : Nat) -> (Fin n -> Fin m -> A) -> Fin (size n m) -> A = split {
 zero -> \ m f i -> efq i ;
 suc n | r -> \ m f -> FinSum[l].cases (size n m) A (r m (\ i -> f (inl i))) m (f (inr tt)) } ;
module Sum (C : CRing) {
 module S = FiniteIdeal[l].Sums[C] ;
 formula (A B : U l) (phi : A -> B -> C.R) :
  (n m : Nat) (a : Fin n -> Fin m -> A) (b : Fin n -> Fin m -> B) ->
  Id C.R (S.sum (size n m) (\ j -> phi (flatten A n m a j) (flatten B n m b j)))
   (S.sum n (\ i -> S.sum m (\ j -> phi (a i j) (b i j)))) = split {
  zero -> \ m a b -> refl C.z ;
  suc n | ih -> \ m a b ->
   trans (FlatRelations[l].Concat[C].sum A B phi
    (size n m) (flatten A n m (\ i -> a (inl i))) (flatten B n m (\ i -> b (inl i))) m (a (inr tt)) (b (inr tt)))
    (trans (C.addC
     (S.sum (size n m) (\ j -> phi (flatten A n m (\ i -> a (inl i)) j) (flatten B n m (\ i -> b (inl i)) j)))
     (S.sum m (\ j -> phi (a (inr tt) j) (b (inr tt) j))))
     (ap (C.add (S.sum m (\ j -> phi (a (inr tt) j) (b (inr tt) j))))
      (ih m (\ i -> a (inl i)) (\ i -> b (inl i))))) } ;
} ;
