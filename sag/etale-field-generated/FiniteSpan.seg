-- Finite spanning data. Coefficients for each element are merely given;
-- the finite family itself is chosen in Data and merely given in Finite.
level l ; open Ring[l] ; open Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (R C : CRing) (h : RingHom[l].Hom R C) {
 module S = FiniteIdeal[l].Sums[C] ;
 Coordinates (n : Nat) (v : Fin n -> C.R) (c : C.R) : U l =
  (a : Fin n -> R.R) * Id C.R (S.lin n (\ i -> h.1 (a i)) v) c ;
 Spans (n : Nat) (v : Fin n -> C.R) : U l = (c : C.R) -> Tr.Trunc[Coordinates n v c].carrier ;
 Data : U l = (n : Nat) * (v : Fin n -> C.R) * Spans n v ;
 Finite : U l = Tr.Trunc[Data].carrier ;
} ;
module Retarget (R C : CRing) (h h' : RingHom[l].Hom R C)
 (same : (r : R.R) -> Id C.R (h.1 r) (h'.1 r)) {
 module A = Over[R,C,h] ; module B = Over[R,C,h'] ; module S = FiniteIdeal[l].Sums[C] ;
 coordinates (n : Nat) (v : Fin n -> C.R) (c : C.R) (w : A.Coordinates n v c) : B.Coordinates n v c =
  (w.1,trans (S.sum-cong n (\ i -> C.mul (h'.1 (w.1 i)) (v i)) (\ i -> C.mul (h.1 (w.1 i)) (v i))
   (\ i -> ap (\ z -> C.mul z (v i)) (sym (same (w.1 i))))) w.2) ;
 transfer (d : A.Data) : B.Data =
  (d.1,d.2.1,\ c -> TC.map (A.Coordinates d.1 d.2.1 c) (B.Coordinates d.1 d.2.1 c)
   (coordinates d.1 d.2.1 c) (d.2.2 c)) ;
 finite (f : A.Finite) : B.Finite = TC.map A.Data B.Data transfer f ;
} ;
