-- The one-generator theorem with the expression-generation interface.
-- Convert each expression to a raw polynomial list by recursion, then
-- apply the checked monic-relation construction. The source scalar map
-- agrees pointwise with the polynomial evaluation's constant map.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (dec : (a : k.R) -> Plus (Id k.R a k.z) (RL[k].unit a))
 (nonzero : Not (Id k.R k.o k.z)) {
 module C = Algebras[l].Over[k,setk] ; module P = Presentations[l].Over[k,setk] ;
 module B = PolynomialRing[l].Extension[k,setk] ; module Raw = RawLaws[l].Laws[k] ;
 module M = Mul[l].MulR[k] ;
 module At (S : C.Algebra) (x : S.ring.R) {
  module G = GeneratedSubalgebra[l].Over[k,setk].At[S,suc zero,\ i -> x] ;
  module UP = Universal[l].Property[k,S.ring,setk,S.set].Given[S.iota,x] ;
  module Mono = MonogenicFinite[l].Over[k,S.ring,setk,S.set,dec,nonzero,UP.extend] ;
  module FS = FiniteSpan[l].Over[k,S.ring,S.iota] ;
  module Polynomial = OneGeneratorPolynomial[l].Over[k,setk].At[S,x] ;
  representation (c : S.ring.R) (r : G.Rep c) : Mono.Representation c = Polynomial.representation c r ;
  generation (gen : G.Generators) : Mono.PolynomialGeneration = Polynomial.generation gen ;
  scalar (a : k.R) : Id S.ring.R (Mono.PolyExpansion.phi.1 a) (S.iota.1 a) = UP.on-constants a ;
  module Change = FiniteSpan[l].Retarget[k,S.ring,Mono.PolyExpansion.phi,S.iota,scalar] ;
  theorem (gen : G.Generators) (zd : IntegralDescent[l].ZeroDim[S.ring,S.set].Property) : FS.Finite =
   Change.finite (Mono.theorem (generation gen) zd) ;
 } ;
} ;
