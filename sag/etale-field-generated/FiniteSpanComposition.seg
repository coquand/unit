-- If A is spanned over R by v_i and C over A by w_j, the fixed products
-- j(v_i)*w_j span C over R. For each c, choose its A-coefficients merely,
-- then choose representations of that finite family in A by finite
-- choice. The two finite sums are flattened explicitly.
level l ; open Ring[l] ; open Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ; module H = RingHom[l] ;
module Over (R A C : CRing) (iota : H.Hom R A) (jota : H.Hom A C) {
 composite : H.Hom R C = H.compose R A C jota iota ;
 module FA = FiniteSpan[l].Over[R,A,iota] ; module FC = FiniteSpan[l].Over[A,C,jota] ;
 module FR = FiniteSpan[l].Over[R,C,composite] ;
 module SA = FiniteIdeal[l].Sums[A] ; module SC = FiniteIdeal[l].Sums[C] ;
 module MC = MnSums[l].Over[C] ; module Rect = FiniteRectangle[l] ;
 module Chosen (da : FA.Data) (dc : FC.Data) {
  n : Nat = da.1 ; m : Nat = dc.1 ;
  products (v : Fin m) (u : Fin n) : C.R = C.mul (jota.1 (da.2.1 u)) (dc.2.1 v) ;
  family : Fin (Rect.size m n) -> C.R = Rect.flatten C.R m n products ;
  module At (c : C.R) (cc : FC.Coordinates m dc.2.1 c)
   (ac : (v : Fin m) -> FA.Coordinates n da.2.1 (cc.1 v)) {
   coefficients (v : Fin m) (u : Fin n) : R.R = (ac v).1 u ;
   term (v : Fin m) (u : Fin n) :
    Id C.R (C.mul (composite.1 (coefficients v u)) (products v u))
     (C.mul (C.mul (jota.1 (iota.1 (coefficients v u))) (jota.1 (da.2.1 u))) (dc.2.1 v)) =
    C.mulA (jota.1 (iota.1 (coefficients v u))) (jota.1 (da.2.1 u)) (dc.2.1 v) ;
   row (v : Fin m) :
    Id C.R (SC.sum n (\ u -> C.mul (composite.1 (coefficients v u)) (products v u)))
     (C.mul (jota.1 (cc.1 v)) (dc.2.1 v)) =
    trans (SC.sum-cong n (\ u -> C.mul (composite.1 (coefficients v u)) (products v u))
     (\ u -> C.mul (C.mul (jota.1 (iota.1 (coefficients v u))) (jota.1 (da.2.1 u))) (dc.2.1 v)) (term v))
     (trans (MC.sum-scale-right (dc.2.1 v) n
      (\ u -> C.mul (jota.1 (iota.1 (coefficients v u))) (jota.1 (da.2.1 u))))
      (ap (\ z -> C.mul z (dc.2.1 v))
       (trans (sym (FlatRelations[l].MapSums[A,C,jota].lin n (\ u -> iota.1 (coefficients v u)) da.2.1))
        (ap jota.1 (ac v).2)))) ;
   equation : Id C.R
    (SC.lin (Rect.size m n) (\ u -> composite.1 (Rect.flatten R.R m n coefficients u)) family) c =
    trans (Rect.Sum[C].formula R.R C.R (\ r z -> C.mul (composite.1 r) z) m n coefficients products)
     (trans (SC.sum-cong m
      (\ v -> SC.sum n (\ u -> C.mul (composite.1 (coefficients v u)) (products v u)))
      (\ v -> C.mul (jota.1 (cc.1 v)) (dc.2.1 v)) row) cc.2) ;
   coordinates : FR.Coordinates (Rect.size m n) family c = (Rect.flatten R.R m n coefficients,equation) ;
  } ;
  from-outer (c : C.R) (cc : FC.Coordinates m dc.2.1 c) : Tr.Trunc[FR.Coordinates (Rect.size m n) family c].carrier =
   TC.map ((v : Fin m) -> FA.Coordinates n da.2.1 (cc.1 v)) (FR.Coordinates (Rect.size m n) family c)
    (\ ac -> At[c,cc,ac].coordinates)
    (AffineFinite[l].choice m (\ v -> FA.Coordinates n da.2.1 (cc.1 v)) (\ v -> da.2.2 (cc.1 v))) ;
  spans : FR.Spans (Rect.size m n) family = \ c ->
   TC.bind (FC.Coordinates m dc.2.1 c) (FR.Coordinates (Rect.size m n) family c) (from-outer c) (dc.2.2 c) ;
  result : FR.Data = (Rect.size m n,family,spans) ;
 } ;
 compose (da : FA.Data) (dc : FC.Data) : FR.Data = Chosen[da,dc].result ;
 finite (fa : FA.Finite) (fc : FC.Finite) : FR.Finite = TC.map2 FA.Data FC.Data FR.Data compose fa fc ;
} ;
