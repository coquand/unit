-- Full finite-span theorem over a discrete nonzero field, for every
-- finite number of algebra generators. Finite presentation is not needed.
-- The formerly explicit coordinate-reduction parameter is constructed by
-- ZeroDimensionalRelation and NagataReduction, then fed to the unchanged
-- algebraic induction.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l+] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (dec : (a : k.R) -> Plus (Id k.R a k.z) (RL[k].unit a))
 (nontrivial : Not (Id k.R k.o k.z)) {
 module C = Algebras[l].Over[k,setk] ;
 module I = GeneratedFiniteInduction[l].Over[k,setk] ;
 module Relation = ZeroDimensionalRelation[l].Over[k,setk,dec,nontrivial] ;
 module Nagata = NagataReduction[l].Over[k,setk,dec,nontrivial] ;
 module At (n : Nat) (S : C.Algebra) (x : Fin (suc n) -> S.ring.R) {
  module R = Relation.At[n,S,x] ;
  module Witness (gen : R.G.Generators) (r : R.Rooted) {
   module N = Nagata.At[n,S,x,r.1,r.2.1,r.2.2.1,r.2.2.2] ;
   step : I.Step S n = (N.y,N.t,N.generation gen,N.monic-data) ;
  } ;
  reduction (gen : R.G.Generators) (zd : R.Z.Property) : Tr.Trunc[I.Step S n].carrier =
   TC.rec R.Rooted @l Tr.Trunc[I.Step S n].carrier Tr.Trunc[I.Step S n].proposition
    (\ r -> Tr.Trunc[I.Step S n].inc Witness[gen,r].step) (R.theorem gen zd) ;
 } ;
 reduction : I.Reduction = \ n S x gen zd -> At[n,S,x].reduction gen zd ;
 module Induction = I.Use[reduction] ;
 theorem : (n : Nat) -> I.Induction n = Induction.theorem ;
} ;
