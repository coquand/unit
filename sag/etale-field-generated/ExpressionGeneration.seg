-- Generation survives any polynomial change expressing the old
-- generators in the new ones. The same syntax gives the zero-generator
-- finite-span case and monogenic generation over the image subalgebra.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ; module P = Presentations[l].Over[R,setR] ;
 substitute (V W : U l) (s : V -> P.Expr W) : P.Expr V -> P.Expr W = split {
  var v -> s v ; cst r -> cst r ; sumE e f | re rf -> sumE re rf ; mulE e f | re rf -> mulE re rf } ;
 module Change (S : C.Algebra) (n m : Nat) (x : Fin n -> S.ring.R) (y : Fin m -> S.ring.R)
  (s : Fin n -> P.Expr (Fin m)) (values : (i : Fin n) -> Id S.ring.R (P.eval (Fin m) S y (s i)) (x i)) {
  module X = GeneratedSubalgebra[l].Over[R,setR].At[S,n,x] ;
  module Y = GeneratedSubalgebra[l].Over[R,setR].At[S,m,y] ;
  sound : (e : P.Expr (Fin n)) -> Id S.ring.R (Y.ev (substitute (Fin n) (Fin m) s e)) (X.ev e) = split {
   var i -> values i ; cst r -> refl (S.iota.1 r) ;
   sumE e f | re rf -> cong2 S.ring.R S.ring.add _ _ _ _ re rf ;
   mulE e f | re rf -> cong2 S.ring.R S.ring.mul _ _ _ _ re rf } ;
  representation (c : S.ring.R) (r : X.Rep c) : Y.Rep c =
   (substitute (Fin n) (Fin m) s r.1,trans (sound r.1) r.2) ;
  generated (gen : X.Generators) : Y.Generators =
   \ c -> TC.map (X.Rep c) (Y.Rep c) (representation c) (gen c) ;
 } ;
 module NoGenerators (S : C.Algebra) {
  empty (i : Fin zero) : S.ring.R = efq i ;
  module G = GeneratedSubalgebra[l].Over[R,setR].At[S,zero,empty] ;
  module FS = FiniteSpan[l].Over[R,S.ring,S.iota] ;
  scalar : P.Expr (Fin zero) -> R.R = split {
   var i -> efq i ; cst r -> r ; sumE e f | re rf -> R.add re rf ; mulE e f | re rf -> R.mul re rf } ;
  value : (e : P.Expr (Fin zero)) -> Id S.ring.R (S.iota.1 (scalar e)) (G.ev e) = split {
   var i -> efq i ; cst r -> refl (S.iota.1 r) ;
   sumE e f | re rf -> trans (S.iota.2.2.1 (scalar e) (scalar f)) (cong2 S.ring.R S.ring.add _ _ _ _ re rf) ;
   mulE e f | re rf -> trans (S.iota.2.2.2 (scalar e) (scalar f)) (cong2 S.ring.R S.ring.mul _ _ _ _ re rf) } ;
  coordinates (c : S.ring.R) (r : G.Rep c) : FS.Coordinates (suc zero) (\ i -> S.ring.o) c =
   (\ i -> scalar r.1,trans (S.ring.addZ (S.ring.mul (S.iota.1 (scalar r.1)) S.ring.o))
    (trans (S.ring.mulO (S.iota.1 (scalar r.1))) (trans (value r.1) r.2))) ;
  finite-data (gen : G.Generators) : FS.Data =
   (suc zero,\ i -> S.ring.o,\ c -> TC.map (G.Rep c) (FS.Coordinates (suc zero) (\ i -> S.ring.o) c) (coordinates c) (gen c)) ;
 } ;
 module Adjoin (S : C.Algebra) (n : Nat) (y : Fin n -> S.ring.R) (t : S.ring.R) {
  module B = GeneratedSubalgebra[l].Over[R,setR].At[S,n,y] ;
  module BC = Algebras[l].Over[B.ring,B.set] ; module BP = Presentations[l].Over[B.ring,B.set] ;
  algebra : BC.Algebra = BC.mkAlgebra S.ring S.set B.incl ;
  module Old = GeneratedSubalgebra[l].Over[R,setR].At[S,suc n,snoc (Fin n) S.ring.R y t] ;
  module New = GeneratedSubalgebra[l].Over[B.ring,B.set].At[algebra,suc zero,\ i -> t] ;
  variable : Fin (suc n) -> BP.Expr (Fin (suc zero)) = split {
   inl i -> cst (B.variables i) ; inr u -> var (inr tt) } ;
  variable-value : (i : Fin (suc n)) ->
   Id S.ring.R (New.ev (variable i)) (snoc (Fin n) S.ring.R y t i) = split {
   inl i -> refl (y i) ; inr u -> refl t } ;
  translate : P.Expr (Fin (suc n)) -> BP.Expr (Fin (suc zero)) = split {
   var i -> variable i ; cst r -> cst (B.iotaB.1 r) ;
   sumE e f | re rf -> sumE re rf ; mulE e f | re rf -> mulE re rf } ;
  sound : (e : P.Expr (Fin (suc n))) -> Id S.ring.R (New.ev (translate e)) (Old.ev e) = split {
   var i -> variable-value i ; cst r -> refl (S.iota.1 r) ;
   sumE e f | re rf -> cong2 S.ring.R S.ring.add _ _ _ _ re rf ;
   mulE e f | re rf -> cong2 S.ring.R S.ring.mul _ _ _ _ re rf } ;
  representation (c : S.ring.R) (r : Old.Rep c) : New.Rep c = (translate r.1,trans (sound r.1) r.2) ;
  generated (gen : Old.Generators) : New.Generators =
   \ c -> TC.map (Old.Rep c) (New.Rep c) (representation c) (gen c) ;
 } ;
} ;
