-- Algebraic induction after a monic coordinate change. This file proves
-- the induction step and its assembly; the Reduction parameter is an
-- explicit remaining construction, not an axiom or completed field proof.
-- C is monogenic over the generated image A'=k[y]. The monic relation
-- makes C finite/integral over A'; dimension zero descends by injectivity,
-- and the induction hypothesis and finite-span composition finish.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) {
 module C = Algebras[l].Over[k,setk] ;
 module G = GeneratedSubalgebra[l].Over[k,setk] ;
 module Z (S : C.Algebra) { module Dim = IntegralDescent[l].ZeroDim[S.ring,S.set] ; } ;
 module F (S : C.Algebra) { module Span = FiniteSpan[l].Over[k,S.ring,S.iota] ; } ;
 Induction (n : Nat) : U l+ = (S : C.Algebra) (x : Fin n -> S.ring.R) ->
  G.At[S,n,x].Generators -> Z[S].Dim.Property -> F[S].Span.Finite ;
 module At (S : C.Algebra) (n : Nat) (y : Fin n -> S.ring.R) (t : S.ring.R) {
  module Adj = ExpressionGeneration[l].Over[k,setk].Adjoin[S,n,y,t] ; module B = Adj.B ;
  module Mono = MonicGeneratedFinite[l].Over[B.ring,B.set].At[Adj.algebra,t] ;
  module Raw = Poly[l].PolyR[B.ring] ; module Bounds = PolynomialBounds[l].Over[B.ring] ;
  module Pol = PolynomialRing[l].Extension[B.ring,B.set] ;
  MonicData : U l = (d : Nat) * (f : List B.ring.R) *
   Id B.ring.R (Raw.coef f d) B.ring.o * Bounds.Bound (suc d) f *
   Id S.ring.R (Mono.P.UP.extend.1 (Pol.include f)) S.ring.z ;
  module Apply (ind : Induction n) (gen : Adj.Old.Generators) (zd : Z[S].Dim.Property) (monic : MonicData) {
   over-image : Mono.FS.Finite = Mono.Relation[monic.2.1,monic.1,monic.2.2.1,monic.2.2.2.1,monic.2.2.2.2].finite (Adj.generated gen) ;
   module Integrals = FiniteSpanIntegral[l].Over[B.ring,S.ring,B.set,S.set,B.incl] ;
   integral : Integrals.IM.Extension = Integrals.theorem over-image ;
   image-dimension : IntegralDescent[l].ZeroDim[B.ring,B.set].Property =
    Integrals.IM.Descent[B.set,S.set,B.incl-inj].theorem integral zd ;
   image-finite : FiniteSpan[l].Over[k,B.ring,B.iotaB].Finite =
    ind B.algebra B.variables B.generated image-dimension ;
   module Composition = FiniteSpanComposition[l].Over[k,B.ring,S.ring,B.iotaB,B.incl] ;
   module Change = FiniteSpan[l].Retarget[k,S.ring,Composition.composite,S.iota,\ r -> refl (S.iota.1 r)] ;
   result : F[S].Span.Finite = Change.finite (Composition.finite image-finite over-image) ;
  } ;
 } ;
 Step (S : C.Algebra) (n : Nat) : U l =
  (y : Fin n -> S.ring.R) * (t : S.ring.R) * At[S,n,y,t].Adj.Old.Generators * At[S,n,y,t].MonicData ;
 Reduction : U l+ = (n : Nat) (S : C.Algebra) (x : Fin (suc n) -> S.ring.R) ->
  G.At[S,suc n,x].Generators -> Z[S].Dim.Property -> Tr.Trunc[Step S n].carrier ;
 module Use (reduction : Reduction) {
  module Initial (S : C.Algebra) (x : Fin zero -> S.ring.R) (gen : G.At[S,zero,x].Generators) {
   module E = ExpressionGeneration[l].Over[k,setk].NoGenerators[S] ;
   same (e : Presentations[l].Over[k,setk].Expr (Fin zero)) :
    Id S.ring.R (E.G.ev e) (G.At[S,zero,x].ev e) =
    Generated[l].Over[k,setk].eval-ext (Fin zero) S E.empty x (\ i -> efq i) e ;
   generated : E.G.Generators = \ c -> TC.map (G.At[S,zero,x].Rep c) (E.G.Rep c)
    (\ r -> (r.1,trans (same r.1) r.2)) (gen c) ;
   finite : F[S].Span.Finite = Tr.Trunc[F[S].Span.Data].inc (E.finite-data generated) ;
  } ;
  step (n : Nat) (ind : Induction n) (S : C.Algebra) (zd : Z[S].Dim.Property) (s : Step S n) : F[S].Span.Finite =
   At[S,n,s.1,s.2.1].Apply[ind,s.2.2.1,zd,s.2.2.2].result ;
  theorem : (n : Nat) -> Induction n = split {
   zero -> \ S x gen zd -> Initial[S,x,gen].finite ;
   suc n | ih -> \ S x gen zd -> TC.bind (Step S n) F[S].Span.Data (step n ih S zd) (reduction n S x gen zd) } ;
 } ;
} ;
