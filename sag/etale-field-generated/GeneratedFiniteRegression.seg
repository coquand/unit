-- Empty algebra generators and a linear monic relation over any base,
-- instantiated over the nonreduced ring Z/4. Also exercise finite-span
-- composition, generated image equality, and the determinant witness.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module E = ExpressionGeneration[l].Over[R,setR].NoGenerators[C.base] ;
 empty-generation : E.G.Generators = \ r -> Tr.Trunc[E.G.Rep r].inc (cst r,refl r) ;
 empty-finite : E.FS.Data = E.finite-data empty-generation ;
 empty-size : Id Nat empty-finite.1 (suc zero) = refl (suc zero) ;
 module G = GeneratedSubalgebra[l].Over[R,setR].At[C.base,zero,E.empty] ;
 image-inverse (r : R.R) : G.Carrier = G.iotaB.1 r ;
 image-section (r : R.R) : Id R.R (G.incl.1 (image-inverse r)) r = refl r ;
 image-retraction (b : G.Carrier) : Id G.Carrier (image-inverse (G.incl.1 b)) b = G.eqB _ b (refl b.1) ;
 module M = MonicGeneratedFinite[l].Over[R,setR].At[C.base,R.z] ;
 generation : M.P.G.Generators = \ r -> Tr.Trunc[M.P.G.Rep r].inc (cst r,refl r) ;
 polynomial : List R.R = cons R.z (cons R.o nil) ;
 module L = M.Relation[polynomial,suc zero,refl R.o,\ k -> refl R.z,M.P.UP.on-variable] ;
 linear-finite : M.FS.Data = L.finite-data generation ;
 linear-size : Id Nat linear-finite.1 (suc zero) = refl (suc zero) ;
 module Compose = FiniteSpanComposition[l].Over[R,R,R,RingHom[l].identity R,RingHom[l].identity R] ;
 composite-finite : Compose.FR.Data = Compose.compose empty-finite linear-finite ;
 composite-size : Id Nat composite-finite.1 (suc zero) = refl (suc zero) ;
 module I = FiniteSpanIntegral[l].Over[R,R,setR,setR,RingHom[l].identity R] ;
 integral : I.IM.Extension = I.integral empty-finite ;
} ;
module Z4 = Over[ZMod4[l].ring,ZMod4[l].set] ;
nilpotent-integral : Z4.I.IM.Integral q2 = Z4.integral q2 ;
