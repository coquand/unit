-- A monogenic algebra with a specified monic relation is finite over
-- any commutative set-ring. The lower powers are the fixed spanning
-- family. The zero degree case is allowed and gives the empty family.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module B = PolynomialRing[l].Extension[R,setR] ; module Raw = Poly[l].PolyR[R] ;
 module Bounds = PolynomialBounds[l].Over[R] ;
 module At (S : C.Algebra) (x : S.ring.R) {
  module P = OneGeneratorPolynomial[l].Over[R,setR].At[S,x] ;
  module Ex = PolynomialFiniteExpansion[l].Over[R,S.ring,setR,P.UP.extend] ;
  module F0 = FiniteSpan[l].Over[R,S.ring,Ex.phi] ;
  module FS = FiniteSpan[l].Over[R,S.ring,S.iota] ;
  module Change = FiniteSpan[l].Retarget[R,S.ring,Ex.phi,S.iota,P.UP.on-constants] ;
  module Relation (f : List R.R) (d : Nat) (leading : Id R.R (Raw.coef f d) R.o)
   (bound : Bounds.Bound (suc d) f) (root : Id S.ring.R (P.UP.extend.1 (B.include f)) S.ring.z) {
   module Q = MonicQuotientCoordinates[l].Over[R,S.ring,setR,P.UP.extend].At[f,d,leading,bound,root] ;
   coordinates (c : S.ring.R) (r : P.Representation c) : F0.Coordinates d (Ex.basis d) c =
    (Q.coordinates r.1,trans (sym (Q.equation r.1)) r.2) ;
   finite-data (gen : P.G.Generators) : FS.Data = Change.transfer
    (d,Ex.basis d,\ c -> TC.map (P.Representation c) (F0.Coordinates d (Ex.basis d) c)
     (coordinates c) (P.generation gen c)) ;
   finite (gen : P.G.Generators) : FS.Finite = Tr.Trunc[FS.Data].inc (finite-data gen) ;
  } ;
 } ;
} ;
