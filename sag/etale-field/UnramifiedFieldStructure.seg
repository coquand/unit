-- The first two field milestones, and the trace conclusion, assembled.
-- Input: a discrete nonzero field k, a k-algebra S with merely a finite
-- presentation, and uniqueness of square-zero lifting. All intermediate
-- constructions are proved: diagonal, flatness transfer, regularity,
-- arbitrary-arity finite span, actual finite basis, tensor coordinates,
-- and trace duality. No ZMT, basis, or primitive element is assumed.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (dec : (a : k.R) -> Plus (Id k.R a k.z) (RL[k].unit a))
 (nontrivial : Not (Id k.R k.o k.z)) {
 module C = Algebras[l].Over[k,setk] ; module P = Presentations[l].Over[k,setk] ;
 module FE = FormallyEtale[l].Over[k,setk] ;
 module At (S : C.Algebra) (fp : P.FP S) (unique : FE.Unique S) {
  module Regular = UnramifiedFieldRegular[l].Over[k,setk,dec].At[S,fp,unique] ;
  module Finite = UnramifiedFieldFiniteGeneral[l].Over[k,setk,dec,nontrivial].At[S,fp,unique] ;
  module Basis = FinitePresentedFieldBasis[l].Over[k,setk,dec].At[S] ;
  module TB = TraceBasis[l].Over[k,setk,S] ;
  module Trace = FiniteUnramifiedTrace[l].Over[k,setk] ;
  finite : FiniteSpan[l].Over[k,S.ring,S.iota].Finite = Finite.finite ;
  basis : Basis.Result = Basis.theorem fp finite ;
  record Structure {
   dimension : Nat ;
   coordinates : TB.Basis[dimension] ;
   duality : TraceDuality[l].Over[k,setk,S,dimension,coordinates].Certificate ;
   perfect : Trace.At[S,dimension,coordinates].Result ;
  } ;
  Result : U l = Tr.Trunc[Structure].carrier ;
  module Given (w : Basis.Witness) {
   module T = Trace.At[S,w.1,w.2] ;
   construct (d : T.TD.Certificate) : Structure = new Structure[w.1,w.2,d,T.theorem fp unique] ;
   result : Result = TC.map T.TD.Certificate Structure construct (T.duality fp unique) ;
  } ;
  theorem : Result = TC.bind Basis.Witness Structure (\ w -> Given[w].result) basis ;
 } ;
} ;
