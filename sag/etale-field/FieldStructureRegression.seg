-- The assembled field theorem on F2 and the actual standard quadratic
-- F2[X]/(X^2-X). The latter uses its constructed presentation and Unique,
-- not a supplied span or basis. Its distinguished generator is nonzero.
level l ; open Ring[l] ;
module B = BooleanRing[l] ; module F = FieldRegression[l] ;
module R = FieldFiniteRegression[l] ;
module General = UnramifiedFieldStructure[l].Over[F.A,B.bool-set,F.dec,R.nontrivial] ;
base : General.At[R.C.base,R.BaseP.finitely-presented,R.base-unique].Result =
 General.At[R.C.base,R.BaseP.finitely-presented,R.base-unique].theorem ;
module Quadratic (rq : FieldRegularRegression[l].Reps.Representation FieldRegularRegression[l].q)
 (rg : FieldRegularRegression[l].Reps.Representation FieldRegularRegression[l].Pt.g) {
 module Q = FieldRegularRegression[l].Test[rq,rg] ;
 module T = General.At[Q.S,Q.fp,Q.etale.1.2] ;
 structure : T.Result = T.theorem ;
 nonzero : Not (Id Q.S.ring.R Q.x Q.S.ring.z) = Q.nonzero ;
} ;
