-- Consequences testing the strength and universe behaviour of the schema.
level l ;
open Base ;
module P = Prelude[l] ;
module Tr = Truncation[l] ;

-- Replacement does not turn an empty image into an inhabited type.
empty-image : Tr.Trunc[Empty].carrier -> Empty =
  Tr.Trunc[Empty].induction @l (\ x -> Empty) (\ x -> P.isProp-Empty) (\ e -> e) ;
unit-image : Tr.Trunc[Top].carrier = Tr.Trunc[Top].inc tt ;

-- Elimination is into a genuinely larger universe, without changing
-- the chosen small truncation or assuming propositional resizing.
module LargeElimination (A : U l) (B : U l+) (prop : Prelude[l+].isProp B) (f : A -> B) {
  extend : Tr.Trunc[A].carrier -> B = Tr.Trunc[A].induction @(l+) (\ x -> B) (\ x -> prop) f ;
  beta (a : A) : Id B (extend (Tr.Trunc[A].inc a)) (f a) =
    Tr.Trunc[A].beta @(l+) (\ x -> B) (\ x -> prop) f a ;
} ;

-- A family of small types has a completion whose base remains small,
-- even though its image lies in U l, which itself has level l+.
module SmallCompletion (A : U l) (F : A -> U l) {
  module C = Completion[l].Complete[A,F] ;
  base : U l = C.base ;
  extend : base -> U l = C.extension ;
  at-generator (a : A) : Id (U l) (extend (C.quotient a)) (F a) = C.triangle a ;
  univalent (x y : base) : Prelude[l+].isEquiv (Id base x y) (P.Equiv (extend x) (extend y))
    C.Identity[x,y].forward = C.Identity[x,y].univalent ;
} ;
