-- Cavallo--Coquand, cavrep.pdf, Definitions 2, 4 and 6.
-- Axiom interface only: no interpretation in a model is asserted.
-- Chosen small image data and its all-universe surjectivity are separate
-- parameters because quantification over all levels is a large type.
-- Crucially, the chosen image does NOT depend on the elimination level.
level l k ;
open Base ;
module P = Prelude[l \/ k] ;

Small (B : U k) : U (l+ \/ k) = (X : U l) * P.Equiv X B ;
LocallySmall (B : U k) : U (l+ \/ k) = (x y : B) -> Small (Id B x y) ;
Embedding (X : U l) (B : U k) (i : X -> B) : U (l \/ k) =
  (x y : X) -> P.isEquiv (Id X x y) (Id B (i x) (i y)) (P.ap X B i x y) ;

record Image (A : U l) (B : U k) (f : A -> B) {
  carrier : U l ;
  quotient : A -> carrier ;
  inclusion : carrier -> B ;
  triangle (a : A) : Id B (inclusion (quotient a)) (f a) ;
  embedding : Embedding carrier B inclusion ;
} ;

-- First part of replacement: choose the same image for every elimination
-- universe.  'Images' alone is not the replacement axiom.
Images : U (l+ \/ k+) =
  (A : U l) (B : U k) -> LocallySmall B -> (f : A -> B) -> Image[A,B,f] ;

-- Dependent precomposition; this states surjectivity without truncation.
precompose (A X : U l) (q : A -> X) : [j]
  (F : X -> U j) -> ((x : X) -> F x) -> (a : A) -> F (q a) =
  <j> \ F s a -> s (q a) ;

Surjectivity (images : Images) : [j] U (l+ \/ k+ \/ j+) = <j>
  (A : U l) (B : U k) (small : LocallySmall B) (f : A -> B)
  (F : (images A B small f).carrier -> U j)
  (prop : (x : (images A B small f).carrier) -> Prelude[j].isProp (F x)) ->
  Prelude[l \/ j].isEquiv
    ((x : (images A B small f).carrier) -> F x)
    ((a : A) -> F ((images A B small f).quotient a))
    (precompose A (images A B small f).carrier (images A B small f).quotient @j F) ;
