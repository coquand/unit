-- Nondependent elimination and composition for mere witnesses.
-- Every eliminator still checks that its target is a proposition.
level l ; open Prelude[l] ;
module Tr = Truncation[l] ;
rec (A : U l) : [j] (P : U j) -> Prelude[j].isProp P ->
 (A -> P) -> Tr.Trunc[A].carrier -> P = <j> \ P prop f ->
 Tr.Trunc[A].induction @j (\ t -> P) (\ t -> prop) f ;
map (A B : U l) (f : A -> B) : Tr.Trunc[A].carrier -> Tr.Trunc[B].carrier =
 rec A @l Tr.Trunc[B].carrier Tr.Trunc[B].proposition (\ a -> Tr.Trunc[B].inc (f a)) ;
bind (A B : U l) (f : A -> Tr.Trunc[B].carrier) : Tr.Trunc[A].carrier -> Tr.Trunc[B].carrier =
 rec A @l Tr.Trunc[B].carrier Tr.Trunc[B].proposition f ;
map2 (A B C : U l) (f : A -> B -> C)
 (a : Tr.Trunc[A].carrier) (b : Tr.Trunc[B].carrier) : Tr.Trunc[C].carrier =
 bind A C (\ x -> map B C (f x) b) a ;
bind2 (A B C : U l) (f : A -> B -> Tr.Trunc[C].carrier)
 (a : Tr.Trunc[A].carrier) (b : Tr.Trunc[B].carrier) : Tr.Trunc[C].carrier =
 bind A C (\ x -> bind B C (f x) b) a ;
pair (A B : U l) : Tr.Trunc[A].carrier -> Tr.Trunc[B].carrier -> Tr.Trunc[A * B].carrier =
 map2 A B (A * B) (\ a b -> (a,b)) ;
bind-inc (A B : U l) (f : A -> Tr.Trunc[B].carrier) (a : A) :
 Id Tr.Trunc[B].carrier (bind A B f (Tr.Trunc[A].inc a)) (f a) =
 Tr.Trunc[A].beta @l (\ t -> Tr.Trunc[B].carrier) (\ t -> Tr.Trunc[B].proposition) f a ;
map-inc (A B : U l) (f : A -> B) (a : A) :
 Id Tr.Trunc[B].carrier (map A B f (Tr.Trunc[A].inc a)) (Tr.Trunc[B].inc (f a)) =
 bind-inc A B (\ x -> Tr.Trunc[B].inc (f x)) a ;
