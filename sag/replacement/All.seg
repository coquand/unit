-- Standalone foundation for examples: univalence plus replacement.
-- This entry point deliberately does not import or edit primrec/sag.
import Base ;
import Prelude ;
import Paths ;
import Axioms ;
import FunExtUA ;
import Replacement ;

-- These three explicit parameters are univalence and the two parts of
-- the replacement axiom schema; function extensionality is derived.
module Theory
  (univ : [l] Axioms[l].Univalence)
  (images : [l] [k] Replacement[l,k].Images)
  (surjections : [l] [k] [j] (Replacement[l,k].Surjectivity (images @l @k)) @j) {
  fe : [l] Axioms[l].FunExt = <l> FunExtUA[l].FE[univ @l].fe ;
  import Truncation ;
  import Completion ;
  import Test ;
} ;
