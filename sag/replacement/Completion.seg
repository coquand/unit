-- The small image of A -> U l exists because univalence makes U l
-- locally U l-small.  It is the universe-sized-codomain test for the axiom.
level l ;
open Base ; open Prelude[l+] ;
module P = Prelude[l] ; module R = Replacement[l,l+] ;

module UniversePaths (X Y : U l) {
  equivalences : U l = P.Equiv X Y ;
  paths : U l+ = Id (U l) X Y ;
  encode : paths -> equivalences = Axioms[l].idtoeqv X Y ;
  equiv : isEquiv paths equivalences encode = univ @l X Y ;
  decode : equivalences -> paths = equiv.sec ;
  small : R.Small paths = (equivalences,
    (decode,qinv equivalences paths decode encode
      (sec-ret paths equivalences encode equiv) equiv.sec-eq)) ;
} ;
universe-small : R.LocallySmall (U l) = \ X Y -> UniversePaths[X,Y].small ;

module Complete (A : U l) (family : A -> U l) {
  image : R.Image[A,U l,family] = images @l @(l+) A (U l) universe-small family ;
  base : U l = image.carrier ;
  quotient : A -> base = image.quotient ;
  extension (x : base) : U l = image.inclusion x ;
  triangle (a : A) : Id (U l) (extension (quotient a)) (family a) = image.triangle a ;

  module Identity (x y : base) {
    code : Id base x y -> Id (U l) (extension x) (extension y) = ap base (U l) extension x y ;
    embedding : isEquiv (Id base x y) (Id (U l) (extension x) (extension y)) code = image.embedding x y ;
    module UPath = UniversePaths[extension x,extension y] ;
    forward (p : Id base x y) : P.Equiv (extension x) (extension y) = UPath.encode (code p) ;
    backward (e : P.Equiv (extension x) (extension y)) : Id base x y = embedding.sec (UPath.decode e) ;
    forward-backward (e : P.Equiv (extension x) (extension y)) :
      Id (P.Equiv (extension x) (extension y)) (forward (backward e)) e =
      trans _ _ _ _ (ap _ _ UPath.encode _ _ (embedding.sec-eq (UPath.decode e))) (UPath.equiv.sec-eq e) ;
    backward-forward (p : Id base x y) : Id (Id base x y) (backward (forward p)) p =
      trans _ _ _ _
        (ap _ _ embedding.sec _ _ (sec-ret UPath.paths UPath.equivalences UPath.encode UPath.equiv (code p)))
        (sec-ret (Id base x y) UPath.paths code embedding p) ;
    univalent : isEquiv (Id base x y) (P.Equiv (extension x) (extension y)) forward =
      qinv _ _ forward backward forward-backward backward-forward ;
  } ;
  -- Surjectivity of quotient into propositions of any size.
  surjective : [j] (F : base -> U j) -> ((x : base) -> Prelude[j].isProp (F x)) ->
    Prelude[l \/ j].isEquiv ((x : base) -> F x) ((a : A) -> F (quotient a))
      (R.precompose A base quotient @j F) = <j> \ F p ->
    surjections @l @(l+) @j A (U l) universe-small family F p ;
} ;
