-- Propositional truncation derived from replacement, as the image of
-- A -> Top.  This is an axiomatic construction in the ambient theory,
-- separate from core/CTrunc's concrete presheaf construction.
level l ;
open Base ; open Prelude[l] ;
module R = Replacement[l,l] ;

top-small : R.LocallySmall Top = \ x y -> (Id Top x y,idEquiv (Id Top x y)) ;

module Trunc (A : U l) {
  image : R.Image[A,Top,\ a -> tt] = images @l @l A Top top-small (\ a -> tt) ;
  carrier : U l = image.carrier ;
  inc : A -> carrier = image.quotient ;
  proposition : isProp carrier = \ x y ->
    (image.embedding x y).sec (isTop (image.inclusion x) (image.inclusion y)) ;

  induction : [j] (F : carrier -> U j) -> ((x : carrier) -> Prelude[j].isProp (F x)) ->
    ((a : A) -> F (inc a)) -> (x : carrier) -> F x = <j> \ F p b ->
    (surjections @l @l @j A Top top-small (\ a -> tt) F p).sec b ;
  beta : [j] (F : carrier -> U j) (p : (x : carrier) -> Prelude[j].isProp (F x))
    (b : (a : A) -> F (inc a)) (a : A) -> Id (F (inc a)) (induction @j F p b (inc a)) (b a) =
    <j> \ F p b a -> Prelude[l \/ j].happly A (\ a -> F (inc a))
      (\ a -> induction @j F p b (inc a)) b
      ((surjections @l @l @j A Top top-small (\ a -> tt) F p).sec-eq b) a ;
  uniqueness : [j] (F : carrier -> U j) (p : (x : carrier) -> Prelude[j].isProp (F x))
    (s : (x : carrier) -> F x) -> Id ((x : carrier) -> F x) (induction @j F p (\ a -> s (inc a))) s =
    <j> \ F p s -> Prelude[l \/ j].sec-ret ((x : carrier) -> F x) ((a : A) -> F (inc a))
      (R.precompose A carrier inc @j F) (surjections @l @l @j A Top top-small (\ a -> tt) F p) s ;
} ;
