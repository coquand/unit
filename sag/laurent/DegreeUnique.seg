-- Uniqueness of the degree: x^d a(x) = x^e b(1/x) on units forces d = e.
-- After moving all powers to one side this is x^N a(x) = x^M b(1/x).  If
-- N = M + k with k > 0, then x^k a(x) = b(1/x), so by ChartIntersection
-- b(0) = 0^k a(0) = 0, which is a unit; if M = N + k, the same argument
-- applies to the pointwise inverses with the charts exchanged.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (sqc : Presentations[l].Over[R,setR].SQC)
 (one-nz : Not (Id R.R R.o R.z)) {
 module CI = ChartIntersection[l].Over[R,setR,sqc] ;
 module PI = PicardInterface[l].Over[R,setR] ;
 module Pow = AffinePowers[l].Over[R] ;
 module UP = UnitPowers[l].Over[R,setR] ;
 open UP ;
 -- the positive gap is impossible
 module Shift (k : Nat) (a b : R.R -> Unit)
  (h : (x : Unit) -> Id Unit (tm (pw x (suc k)) (a x.1)) (b x.2.1)) {
  f (r : R.R) : R.R = R.mul (Pow.power r (suc k)) (a r).1 ;
  g (r : R.R) : R.R = (b r).1 ;
  agree (x : Unit) : Id R.R (f x.1) (g x.2.1) =
   trans (ap (\ t -> R.mul t (a x.1).1) (sym (power-fst x (suc k)))) (ap (\ u -> u.1) (h x)) ;
  f-zero : Id R.R (f R.z) R.z =
   trans (ap (\ t -> R.mul t (a R.z).1) (RL[R].zero-mul (Pow.power R.z k))) (RL[R].zero-mul (a R.z).1) ;
  g-zero : Id R.R (g R.z) R.z = trans ((CI.intersection f g agree).2 R.z) f-zero ;
  result : Empty = one-nz (trans (sym (b R.z).2.2)
   (trans (ap (\ t -> R.mul t (b R.z).2.1) g-zero) (RL[R].zero-mul (b R.z).2.1))) ;
 } ;
 module Gap (N M : Nat) (a b : R.R -> Unit)
  (h : (x : Unit) -> Id Unit (tm (pw x N) (a x.1)) (tm (pw x M) (b x.2.1))) {
  above (j : Nat) (p : Id Nat N (plus M (suc j))) : Empty = Shift[j,a,b,\ x ->
   cancel (pw x M) (tm (pw x (suc j)) (a x.1)) (b x.2.1)
    (trans (sym (G.assoc (pw x M) (pw x (suc j)) (a x.1)))
     (trans (ap (\ t -> tm t (a x.1)) (sym (power-add x M (suc j))))
      (trans (ap (\ n -> tm (pw x n) (a x.1)) (sym p)) (h x))))].result ;
  below-at (j : Nat) (p : Id Nat M (plus N (suc j))) (x : Unit) :
   Id Unit (a x.1) (tm (pw x (suc j)) (b x.2.1)) =
   cancel (pw x N) (a x.1) (tm (pw x (suc j)) (b x.2.1))
    (trans (h x) (trans (ap (\ n -> tm (pw x n) (b x.2.1)) p)
     (trans (ap (\ t -> tm t (b x.2.1)) (power-add x N (suc j)))
      (G.assoc (pw x N) (pw x (suc j)) (b x.2.1))))) ;
  below-inv (j : Nat) (p : Id Nat M (plus N (suc j))) (y : Unit) :
   Id Unit (tm (pw y (suc j)) (inv (b y.1))) (inv (a y.2.1)) =
   trans (GL.solve (tm (pw y (suc j)) (inv (b y.1))) (a y.2.1) G.one (calc Unit {
     tm (tm (pw y (suc j)) (inv (b y.1))) (a y.2.1)
      =< ap (tm (tm (pw y (suc j)) (inv (b y.1)))) (below-at j p (inv y))
      > tm (tm (pw y (suc j)) (inv (b y.1))) (tm (pw (inv y) (suc j)) (b y.1))
      =< four (pw y (suc j)) (inv (b y.1)) (pw (inv y) (suc j)) (b y.1)
      > tm (tm (pw y (suc j)) (pw (inv y) (suc j))) (tm (inv (b y.1)) (b y.1))
      =< ap (\ t -> tm t (tm (inv (b y.1)) (b y.1))) (power-inv y (suc j))
      > tm G.one (tm (inv (b y.1)) (b y.1))
      =< ap (tm G.one) (GL.invl (b y.1)) > tm G.one G.one
      =< G.unitr G.one > G.one })) (GL.unitl (inv (a y.2.1))) ;
  below (j : Nat) (p : Id Nat M (plus N (suc j))) : Empty =
   Shift[j,\ r -> inv (b r),\ r -> inv (a r),below-inv j p].result ;
  apart : Plus ((j : Nat) * Id Nat N (plus M (suc j))) ((j : Nat) * Id Nat M (plus N (suc j))) -> Empty = split {
   inl v -> above v.1 v.2 ; inr v -> below v.1 v.2 } ;
  cases : Cmp N M -> Id Nat N M = split { inl p -> p ; inr w -> efq (apart w) } ;
  result : Id Nat N M = cases (compare N M) ;
 } ;
 -- monomials as x^p (1/x)^q
 pos : PicardInterface[l].Degree -> Nat = split { nonneg n -> n ; negative n -> zero } ;
 neg : PicardInterface[l].Degree -> Nat = split { nonneg n -> zero ; negative n -> suc n } ;
 mono-form : (d : PicardInterface[l].Degree) (x : Unit) ->
  Id Unit (PI.monomial d x) (tm (pw x (pos d)) (pw (inv x) (neg d))) = split {
  nonneg n -> \ x -> sym (G.unitr (pw x n)) ;
  negative n -> \ x -> sym (GL.unitl (pw (inv x) (suc n))) } ;
 claim (x : Unit) (s t u : Nat) (W : Unit) :
  Id Unit (tm (tm (pw x s) (pw x t)) (tm (tm (pw x u) (pw (inv x) s)) W)) (tm (pw x (plus u t)) W) = calc Unit {
  tm (tm (pw x s) (pw x t)) (tm (tm (pw x u) (pw (inv x) s)) W)
   =< sym (G.assoc (tm (pw x s) (pw x t)) (tm (pw x u) (pw (inv x) s)) W)
   > tm (tm (tm (pw x s) (pw x t)) (tm (pw x u) (pw (inv x) s))) W
   =< ap (\ v -> tm (tm (tm (pw x s) (pw x t)) v) W) (G.comm (pw x u) (pw (inv x) s))
   > tm (tm (tm (pw x s) (pw x t)) (tm (pw (inv x) s) (pw x u))) W
   =< ap (\ v -> tm v W) (four (pw x s) (pw x t) (pw (inv x) s) (pw x u))
   > tm (tm (tm (pw x s) (pw (inv x) s)) (tm (pw x t) (pw x u))) W
   =< ap (\ v -> tm (tm v (tm (pw x t) (pw x u))) W) (power-inv x s)
   > tm (tm G.one (tm (pw x t) (pw x u))) W
   =< ap (\ v -> tm v W) (trans (GL.unitl (tm (pw x t) (pw x u))) (G.comm (pw x t) (pw x u)))
   > tm (tm (pw x u) (pw x t)) W
   =< ap (\ v -> tm v W) (sym (power-add x u t)) > tm (pw x (plus u t)) W } ;
 rebalanced (d e : PicardInterface[l].Degree) (a b : PI.PolynomialUnit)
  (h : (x : Unit) -> Id Unit (tm (PI.monomial d x) (a x.1)) (tm (PI.monomial e x) (b x.2.1))) (x : Unit) :
  Id Unit (tm (pw x (plus (pos d) (neg e))) (a x.1)) (tm (pw x (plus (pos e) (neg d))) (b x.2.1)) =
  trans (sym (claim x (neg d) (neg e) (pos d) (a x.1)))
   (trans (ap (tm (tm (pw x (neg d)) (pw x (neg e))))
     (trans (ap (\ t -> tm t (a x.1)) (sym (mono-form d x)))
      (trans (h x) (ap (\ t -> tm t (b x.2.1)) (mono-form e x)))))
    (trans (ap (\ t -> tm t (tm (tm (pw x (pos e)) (pw (inv x) (neg e))) (b x.2.1)))
      (G.comm (pw x (neg d)) (pw x (neg e))))
     (claim x (neg e) (neg d) (pos e) (b x.2.1)))) ;
 finish : (d e : PicardInterface[l].Degree) ->
  Id Nat (plus (pos d) (neg e)) (plus (pos e) (neg d)) -> Id PicardInterface[l].Degree d e = split {
  nonneg n -> split {
   nonneg m -> \ p -> ap (\ i -> nonneg i) (trans (sym (plus-zero n)) (trans p (plus-zero m))) ;
   negative m -> \ p -> efq (suc-zero (plus n m) (trans (sym (plus-suc n m)) p)) } ;
  negative n -> split {
   nonneg m -> \ p -> efq (zero-suc (plus m n) (trans p (plus-suc m n))) ;
   negative m -> \ p -> Pr.ap Nat PicardInterface[l].Degree (\ i -> negative i) n m
    (sym (Pr.ap Nat Nat pred (suc m) (suc n) p)) } } ;
 degree-unique : PI.DegreeUnique = \ d e a b h ->
  finish d e (Gap[plus (pos d) (neg e),plus (pos e) (neg d),a,b,rebalanced d e a b h].result) ;
} ;
