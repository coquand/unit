-- Every function on the units splits as g(x) + h(1/x) with g, h : R -> R.
-- From LaurentRep, phi(x) = y^N p(x) with y = 1/x; induction on N, using
-- y (c + x p'(x)) = c y + p'(x).
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (sqc : Presentations[l].Over[R,setR].SQC) {
 open R ; open RL[R] ;
 module LR = LaurentRep[l].Over[R,setR,sqc] ;
 module Raw = LR.Raw ;
 module G = LR.G ;
 module UP = UnitPowers[l].Over[R,setR] ;
 module Pow = AffinePowers[l].Over[R] ;
 SplitOf (phi : G.Unit -> R.R) : U l =
  (g : R.R -> R.R) * (h : R.R -> R.R) * ((u : G.Unit) -> Id R.R (phi u) (add (g u.1) (h u.2.1))) ;
 Laurent (N : Nat) (p : Raw.P) (u : G.Unit) : R.R = mul (Pow.power u.2.1 N) (Raw.ev p u.1) ;
 cancel-x (u : G.Unit) (Y E : R.R) : Id R.R (mul (mul u.2.1 Y) (mul u.1 E)) (mul Y E) = calc R.R {
  mul (mul u.2.1 Y) (mul u.1 E)
   =< ap (\ t -> mul t (mul u.1 E)) (mulC u.2.1 Y) > mul (mul Y u.2.1) (mul u.1 E)
   =< sym (mulA Y u.2.1 (mul u.1 E)) > mul Y (mul u.2.1 (mul u.1 E))
   =< ap (mul Y) (mulA u.2.1 u.1 E) > mul Y (mul (mul u.2.1 u.1) E)
   =< ap (\ t -> mul Y (mul t E)) (trans (mulC u.2.1 u.1) u.2.2) > mul Y (mul o E)
   =< ap (mul Y) (Pow.one-left E) > mul Y E } ;
 step (N : Nat) (ih : (p : Raw.P) -> SplitOf (Laurent N p)) : (p : Raw.P) -> SplitOf (Laurent (suc N) p) = split {
  nil -> (\ x -> z,\ y -> z,\ u -> trans (mul-zero (Pow.power u.2.1 (suc N))) (sym (addZ z))) ;
  cons c p -> let { r : SplitOf (Laurent N p) = ih p ; } in
   (r.1,\ y -> add (r.2.1 y) (mul c (Pow.power y (suc N))),\ u -> calc R.R {
    mul (mul u.2.1 (Pow.power u.2.1 N)) (add c (mul u.1 (Raw.ev p u.1)))
     =< dist (mul u.2.1 (Pow.power u.2.1 N)) c (mul u.1 (Raw.ev p u.1))
     > add (mul (mul u.2.1 (Pow.power u.2.1 N)) c) (mul (mul u.2.1 (Pow.power u.2.1 N)) (mul u.1 (Raw.ev p u.1)))
     =< Presentations[l].cong2 R.R add _ _ _ _ (mulC (mul u.2.1 (Pow.power u.2.1 N)) c)
       (cancel-x u (Pow.power u.2.1 N) (Raw.ev p u.1))
     > add (mul c (mul u.2.1 (Pow.power u.2.1 N))) (Laurent N p u)
     =< ap (add (mul c (mul u.2.1 (Pow.power u.2.1 N)))) (r.2.2 u)
     > add (mul c (mul u.2.1 (Pow.power u.2.1 N))) (add (r.1 u.1) (r.2.1 u.2.1))
     =< addC (mul c (mul u.2.1 (Pow.power u.2.1 N))) (add (r.1 u.1) (r.2.1 u.2.1))
     > add (add (r.1 u.1) (r.2.1 u.2.1)) (mul c (mul u.2.1 (Pow.power u.2.1 N)))
     =< sym (addA (r.1 u.1) (r.2.1 u.2.1) (mul c (mul u.2.1 (Pow.power u.2.1 N))))
     > add (r.1 u.1) (add (r.2.1 u.2.1) (mul c (Pow.power u.2.1 (suc N)))) }) } ;
 split-laurent : (N : Nat) (p : Raw.P) -> SplitOf (Laurent N p) = split {
  zero -> \ p -> (Raw.ev p,\ y -> z,\ u -> trans (Pow.one-left (Raw.ev p u.1)) (sym (addZ (Raw.ev p u.1)))) ;
  suc N | ih -> step N ih } ;
 xy-power (u : G.Unit) (N : Nat) : Id R.R (mul (Pow.power u.1 N) (Pow.power u.2.1 N)) o =
  trans (sym (Presentations[l].cong2 R.R mul _ _ _ _ (UP.power-fst u N) (UP.power-fst (G.inverse u) N)))
   (ap (\ v -> v.1) (UP.power-inv u N)) ;
 from-rep (phi : G.Unit -> R.R) (w : LR.Rep phi) (u : G.Unit) : Id R.R (phi u) (Laurent w.2.1 w.1 u) = calc R.R {
  phi u =< sym (Pow.one-left (phi u)) > mul o (phi u)
   =< ap (\ t -> mul t (phi u)) (sym (trans (mulC (Pow.power u.2.1 w.2.1) (Pow.power u.1 w.2.1)) (xy-power u w.2.1)))
   > mul (mul (Pow.power u.2.1 w.2.1) (Pow.power u.1 w.2.1)) (phi u)
   =< sym (mulA (Pow.power u.2.1 w.2.1) (Pow.power u.1 w.2.1) (phi u))
   > mul (Pow.power u.2.1 w.2.1) (mul (Pow.power u.1 w.2.1) (phi u))
   =< ap (mul (Pow.power u.2.1 w.2.1)) (sym (w.2.2 u)) > Laurent w.2.1 w.1 u } ;
 splitting (phi : G.Unit -> R.R) : Tr.Trunc[SplitOf phi].carrier =
  Tr.Trunc[LR.Rep phi].induction @l (\ t -> Tr.Trunc[SplitOf phi].carrier)
   (\ t -> Tr.Trunc[SplitOf phi].proposition)
   (\ w -> let { s : SplitOf (Laurent w.2.1 w.1) = split-laurent w.2.1 w.1 ; } in
     Tr.Trunc[SplitOf phi].inc (s.1,s.2.1,\ u -> trans (from-rep phi w u) (s.2.2 u)))
   (LR.representation phi) ;
} ;
