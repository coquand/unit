-- The checked matrix McCoy theorem, specialized to a square matrix:
-- injectivity makes its determinant a regular element. This includes
-- the empty matrix, whose determinant is one.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module M = Matrices[l].Over[A] ; module EM = ExteriorModel[l].Over[A] ;
 module EA = ExteriorAlgebra[l].Over[A,setA] ; module DT = Determinant[l].Over[A,setA] ; module DG = ExteriorDegree[l].Over[A,setA] ;
 module At (n : Nat) (matrix : M.Mat n n) (injective : M.Injective n n matrix) {
  regular (a : A.R) (h : Id A.R (A.mul (EM.det n matrix) a) A.z) : Id A.R a A.z =
   McCoy[l].Over[n].mccoy n A setA matrix injective a
    (trans (ap (EM.escale n a) (DT.free n matrix))
     (trans (EA.escale-scale n a (EM.det n matrix) (DG.omega n))
      (trans (ap (\ c -> EM.escale n c (DG.omega n)) (trans (A.mulC a (EM.det n matrix)) h))
       (EA.zero-scale n (DG.omega n))))) ;
  nonzero (one-nonzero : Not (Id A.R A.o A.z)) : Not (Id A.R (EM.det n matrix) A.z) =
   \ h -> one-nonzero (regular A.o (trans (A.mulO (EM.det n matrix)) h)) ;
 } ;
} ;
