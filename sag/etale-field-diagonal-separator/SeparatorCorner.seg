-- If epsilon+Delta(z) is a unit, its inverse supplies an inverse for
-- Delta(z) on the complementary diagonal component. No quotient is used.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (epsilon delta : A.R)
 (idempotent : Id A.R (A.mul epsilon epsilon) epsilon)
 (annihilates : Id A.R (A.mul epsilon delta) A.z)
 (unit : RL[A].unit (A.add epsilon delta)) {
 open A ; module L = RL[A] ;
 complement : R = add o (neg epsilon) ;
 inverse : R = mul complement unit.1 ;
 complement-epsilon : Id R (mul complement epsilon) z =
  trans (L.dist-left o (neg epsilon) epsilon)
   (trans (cong2 R add _ _ _ _ (L.one-left epsilon) (trans (L.neg-mul-left epsilon epsilon) (ap neg idempotent))) (addN epsilon)) ;
 complement-delta : Id R (mul complement delta) delta =
  trans (L.dist-left o (neg epsilon) delta)
   (trans (cong2 R add _ _ _ _ (L.one-left delta) (trans (L.neg-mul-left epsilon delta) (trans (ap neg annihilates) L.neg-zero))) (addZ delta)) ;
 complement-sum : Id R (mul complement (add epsilon delta)) delta =
  trans (dist complement epsilon delta)
   (trans (cong2 R add _ _ _ _ complement-epsilon complement-delta) (L.zl delta)) ;
 delta-unit : Id R (mul delta unit.1) complement =
  trans (ap (\ a -> mul a unit.1) (sym complement-sum))
   (trans (sym (mulA complement (add epsilon delta) unit.1))
    (trans (ap (mul complement) unit.2) (mulO complement))) ;
 complement-square : Id R (mul complement complement) complement =
  trans (dist complement o (neg epsilon))
   (trans (cong2 R add _ _ _ _ (mulO complement) (trans (L.mul-neg complement epsilon) (trans (ap neg complement-epsilon) L.neg-zero))) (addZ complement)) ;
 equation : Id R (mul delta inverse) complement =
  trans (L.mul-swap delta complement unit.1)
   (trans (ap (mul complement) delta-unit) complement-square) ;
} ;
