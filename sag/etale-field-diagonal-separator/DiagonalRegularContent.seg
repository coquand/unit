-- The diagonal averaging element together with the differences of any
-- finite spanning basis is a regular family.  Expand epsilon in the
-- left basis.  An annihilator of every basis difference can replace the
-- left basis vectors by the right ones; normalisation then says y*epsilon=y.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) {
 module C = Algebras[l].Over[k,setk] ; module Tn = Tensor[l].Over[k,setk] ;
 module At (S D : C.Algebra) (cp : Tn.Coproduct S S D)
  (n : Nat) (b : TraceBasis[l].Over[k,setk,S].Basis[n])
  (epsilon : DiagonalCertificate[l].Over[k,setk].At[S,D,cp].Witness) {
  module T = TensorBasisConstruct[l].Over[k,setk].At[S,D,cp,n,b] ;
  module DK = T.DK ; module Ex = T.Trace.Extract[epsilon] ;
  module DS = FiniteIdeal[l].Sums[D.ring] ; module SS = FiniteIdeal[l].Sums[S.ring] ;
  module L = RL[D.ring] ; module DU = FormallyEtale[l].Units[D.ring,D.set] ;
  module RI = RegularIdeal[l].Over[D.ring,RegularIdeal[l].self D.ring] ;
  family : Fin (suc n) -> D.ring.R = snoc (Fin n) D.ring.R (\ i -> DK.difference (b.vector i)) epsilon.epsilon ;
  right-sum : (m : Nat) (v : Fin m -> S.ring.R) ->
   Id D.ring.R (DK.right.1.1 (SS.sum m v)) (DS.sum m (\ i -> DK.right.1.1 (v i))) = split {
   zero -> \ v -> H.zero S.ring D.ring DK.right.1 ;
   suc m | ih -> \ v -> trans (DK.right.1.2.2.1 (v (inr tt)) (SS.sum m (\ i -> v (inl i))))
    (ap (D.ring.add (DK.right.1.1 (v (inr tt)))) (ih (\ i -> v (inl i)))) } ;
  module Annihilator (y : D.ring.R) (kill : RI.ZeroOn (Fin (suc n)) family y) {
   equalise (i : Fin n) : Id D.ring.R
    (D.ring.mul y (DK.left.1.1 (b.vector i))) (D.ring.mul y (DK.right.1.1 (b.vector i))) =
    DU.sub-zero _ _ (trans
     (sym (trans (D.ring.dist y (DK.left.1.1 (b.vector i)) (D.ring.neg (DK.right.1.1 (b.vector i))))
      (ap (D.ring.add (D.ring.mul y (DK.left.1.1 (b.vector i)))) (L.mul-neg y (DK.right.1.1 (b.vector i))))))
     (trans (D.ring.mulC y (DK.difference (b.vector i))) (kill (inl i)))) ;
   term (i : Fin n) : Id D.ring.R
    (D.ring.mul y (D.ring.mul (DK.left.1.1 (b.vector i)) (DK.right.1.1 (Ex.cofactor i))))
    (D.ring.mul y (DK.right.1.1 (S.ring.mul (b.vector i) (Ex.cofactor i)))) =
    trans (D.ring.mulA y (DK.left.1.1 (b.vector i)) (DK.right.1.1 (Ex.cofactor i)))
     (trans (ap (\ a -> D.ring.mul a (DK.right.1.1 (Ex.cofactor i))) (equalise i))
      (trans (sym (D.ring.mulA y (DK.right.1.1 (b.vector i)) (DK.right.1.1 (Ex.cofactor i))))
       (ap (D.ring.mul y) (sym (DK.right.1.2.2.2 (b.vector i) (Ex.cofactor i)))))) ;
   fixes : Id D.ring.R (D.ring.mul y epsilon.epsilon) y =
    trans (ap (D.ring.mul y) (sym (T.reconstruction epsilon.epsilon)))
     (trans (sym (DS.sum-scale y n (\ i -> D.ring.mul (DK.left.1.1 (b.vector i)) (DK.right.1.1 (Ex.cofactor i)))))
      (trans (DS.sum-cong n (\ i -> D.ring.mul y (D.ring.mul (DK.left.1.1 (b.vector i)) (DK.right.1.1 (Ex.cofactor i)))) (\ i -> D.ring.mul y (DK.right.1.1 (S.ring.mul (b.vector i) (Ex.cofactor i)))) term)
       (trans (DS.sum-scale y n (\ i -> DK.right.1.1 (S.ring.mul (b.vector i) (Ex.cofactor i))))
        (trans (ap (D.ring.mul y) (sym (right-sum n (\ i -> S.ring.mul (b.vector i) (Ex.cofactor i)))))
         (trans (ap (\ a -> D.ring.mul y (DK.right.1.1 a)) Ex.normalisation)
          (trans (ap (D.ring.mul y) DK.right.1.2.1) (D.ring.mulO y))))))) ;
   zero : Id D.ring.R y D.ring.z =
    trans (sym fixes) (trans (D.ring.mulC y epsilon.epsilon) (kill (inr tt))) ;
  } ;
  regular : RI.Regular (Fin (suc n)) family = \ y t kill -> Annihilator[y,kill].zero ;
  module P = PolyRegular[l].Over[D.ring,D.set] ;
  raw : Poly[l].PolyR[D.ring].P = P.kron (suc n) family ;
  polynomial : P.Carrier = P.AX.include raw ;
  polynomial-regular : P.RX.Regular (Fin (suc zero)) (\ i -> polynomial) = P.Kronecker[suc n,family].regular regular ;
 } ;
} ;
