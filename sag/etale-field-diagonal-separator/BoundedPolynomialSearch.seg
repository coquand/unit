-- A nonzero polynomial with an explicit degree bound has a nonzero
-- value on any supplied list of sufficiently many distinct field elements.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (inverse : (a : k.R) -> Not (Id k.R a k.z) -> RL[k].unit a)
 (zero-dec : (a : k.R) -> Plus (Id k.R a k.z) (Not (Id k.R a k.z))) {
 module B = PolynomialRing[l].Extension[k,setk] ; module Raw = Poly[l].PolyR[k] ;
 module BP = BoundedPolynomialDeterminant[l].Over[k,setk] ;
 module RB = PolynomialRootBound[l].Over[k] ; module Fld = RB.Field[inverse] ; module Search = Fld.Search[zero-dec] ;
 module At (d : Nat) (f : B.Carrier) (bound : BP.Bounded[d,f])
  (nonzero : Not (Id B.Carrier f B.zeroQ))
  (candidates : Fin (suc d) -> k.R) (distinct : RB.Injective (suc d) candidates) {
  Values : Fin (suc d) -> k.R = \ i -> Raw.ev bound.raw (candidates i) ;
  reject (h : Search.AllZero (suc d) Values) : Empty =
   nonzero (trans (sym bound.equation) (B.Q.relates bound.raw nil (Fld.theorem (suc d) bound.raw bound.bounded candidates distinct h))) ;
  choose : Search.Result (suc d) Values -> Search.Nonzero (suc d) Values = split {
   inl h -> efq (reject h) ; inr h -> h } ;
  result : Search.Nonzero (suc d) Values = choose (Search.scan (suc d) Values) ;
 } ;
} ;
