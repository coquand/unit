-- A regular polynomial over a finite free field algebra has a unit
-- specialization on any sufficiently long distinct scalar list.
-- The explicit bound is rank times the supplied polynomial degree.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (dec : (a : k.R) -> Plus (Id k.R a k.z) (RL[k].unit a))
 (nontrivial : Not (Id k.R k.o k.z)) {
 module Op = DiscreteFieldOperations[l].Over[k,setk,dec,nontrivial] ;
 inverse (a : k.R) (h : Not (Id k.R a k.z)) : RL[k].unit a = (Op.inverse a,Op.inverse-law a h) ;
 module At (S : Algebras[l].Over[k,setk].Algebra)
  (n : Nat) (b : TraceBasis[l].Over[k,setk,S].Basis[n])
  (d : Nat) (p : Poly[l].PolyR[S.ring].P)
  (bound : PolynomialBounds[l].Over[S.ring].Bound (suc d) p)
  (regular : (q : PolynomialRing[l].Extension[S.ring,S.set].Carrier) ->
   Id (PolynomialRing[l].Extension[S.ring,S.set].Carrier)
    (PolynomialRing[l].Extension[S.ring,S.set].mulQ (PolynomialRing[l].Extension[S.ring,S.set].include p) q)
    PolynomialRing[l].Extension[S.ring,S.set].zeroQ ->
   Id (PolynomialRing[l].Extension[S.ring,S.set].Carrier) q PolynomialRing[l].Extension[S.ring,S.set].zeroQ) {
  module PB = PolynomialBasis[l].Over[k,setk,S,n,b] ; module PBB = PolynomialBasisBounds[l].Over[k,setk,S,n,b] ;
  module K = PB.K ; module P = PB.P ; module SM = Mul[l].MulR[S.ring] ; module SB = PolynomialBounds[l].Over[S.ring] ;
  module BT = TraceBasis[l].Over[k,setk,S].At[n,b] ;
  module BP = BoundedPolynomialDeterminant[l].Over[k,setk] ;
  polynomial : P.Carrier = P.include p ;
  module Matrix = FiniteBasisRegularMatrix[l].Over[K.ring,K.set,PB.algebra,n,PB.basis].At[polynomial,regular] ;
  constant-multiple (a : S.ring.R) : Id P.Carrier
   (P.mulQ polynomial (P.constant a)) (P.include (SM.scal a p)) =
   trans (P.mul-comm polynomial (P.constant a))
    (trans (P.Multiply.beta (cons a nil) p) (P.Q.relates _ _ (P.M.mul-single-left a p))) ;
  entry-bound (j i : Fin n) : BP.Bounded[d,Matrix.matrix j i] =
   new BP.Bounded[d,Matrix.matrix j i,PB.coordinateRaw (SM.scal (b.vector j) p) i,
    \ r -> trans (PBB.raw-coefficient (SM.scal (b.vector j) p) i (plus (suc d) r))
     (trans (ap (\ c -> b.coordinate c i) (SB.scale-bound (suc d) (b.vector j) p bound r)) (BT.zero i)),
    trans (sym (PB.coordinate-list (SM.scal (b.vector j) p) i))
     (ap (\ q -> PB.coordinate q i) (sym (constant-multiple (b.vector j))))] ;
  determinant : K.Carrier = ExteriorModel[l].Over[K.ring].det n Matrix.matrix ;
  degree : Nat = Integers[l].times n d ;
  determinant-bound : BP.Bounded[degree,determinant] = BP.determinant n d Matrix.matrix entry-bound ;
  one-nonzero : Not (Id K.Carrier K.oneQ K.zeroQ) =
   \ h -> nontrivial (K.constant-injective k.o k.z (trans h (sym (H.zero k K.ring K.inclusion)))) ;
  determinant-nonzero : Not (Id K.Carrier determinant K.zeroQ) = Matrix.determinant-nonzero one-nonzero ;
  module Choose (candidates : Fin (suc degree) -> k.R)
   (distinct : PolynomialRootBound[l].Over[k].Injective (suc degree) candidates) {
   module Search = BoundedPolynomialSearch[l].Over[k,setk,inverse,Op.zero-dec].At[degree,determinant,determinant-bound,determinant-nonzero,candidates,distinct] ;
   index : Fin (suc degree) = Search.result.1 ;
   scalar : k.R = candidates index ;
   module Special = PolynomialBasisSpecialisation[l].Over[k,setk,S,n,b].At[scalar] ;
   module KR = Poly[l].PolyR[k] ;
   identity-eval : (q : KR.P) -> Id k.R (Special.EK.E q) (KR.ev q scalar) = split {
    nil -> refl k.z ; cons a q | ih -> ap (\ t -> k.add a (k.mul scalar t)) ih } ;
   determinant-value : Id k.R (KR.ev determinant-bound.raw scalar)
    (FiniteAlgebraDeterminantUnit[l].Over[k,setk,S,n,b].At[Special.ES.evaluate polynomial].determinant) =
    trans (sym (identity-eval determinant-bound.raw))
     (trans (sym (Special.EK.D.beta determinant-bound.raw))
      (trans (ap Special.EK.evaluate determinant-bound.equation) (Special.determinant polynomial))) ;
   evaluated-nonzero : Not (Id k.R
    (FiniteAlgebraDeterminantUnit[l].Over[k,setk,S,n,b].At[Special.ES.evaluate polynomial].determinant) k.z) =
    \ h -> Search.result.2 (trans determinant-value h) ;
   unit : RL[S.ring].unit (Special.ES.evaluate polynomial) =
    FiniteAlgebraDeterminantUnit[l].Over[k,setk,S,n,b].At[Special.ES.evaluate polynomial].from-nonzero dec evaluated-nonzero ;
  } ;
 } ;
} ;
