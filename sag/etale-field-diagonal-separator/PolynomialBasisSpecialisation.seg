-- Evaluation commutes with the explicit polynomial basis coordinates.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ; module FE = Axioms[l].FunExtLemmas[fe @l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (S : Algebras[l].Over[k,setk].Algebra) (n : Nat) (b : TraceBasis[l].Over[k,setk,S].Basis[n]) {
 module PB = PolynomialBasis[l].Over[k,setk,S,n,b] ;
 module B = TraceBasis[l].Over[k,setk,S].At[n,b] ;
 module K = PB.K ; module P = PB.P ;
 module At (a : k.R) {
  module EK = Evaluation[l].Evaluate[k,k,setk,setk,H.identity k,a] ;
  module ES = Evaluation[l].Evaluate[S.ring,S.ring,S.set,S.set,H.identity S.ring,S.iota.1 a] ;
  raw (i : Fin n) : (p : List S.ring.R) ->
   Id k.R (EK.E (PB.coordinateRaw p i)) (b.coordinate (ES.E p) i) = split {
   nil -> sym (B.zero i) ;
   cons c p | ih -> trans (ap (k.add (b.coordinate c i)) (ap (k.mul a) ih))
    (sym (trans (b.add c (S.ring.mul (S.iota.1 a) (ES.E p)) i)
     (ap (k.add (b.coordinate c i)) (b.scale a (ES.E p) i)))) } ;
  coordinate (i : Fin n) : (p : P.Carrier) ->
   Id k.R (EK.evaluate (PB.coordinate p i)) (b.coordinate (ES.evaluate p) i) =
   P.Q.induction @l (\ p -> Id k.R (EK.evaluate (PB.coordinate p i)) (b.coordinate (ES.evaluate p) i))
    (\ p -> setk _ _)
    (\ p -> trans (ap EK.evaluate (PB.coordinate-list p i))
     (trans (EK.D.beta (PB.coordinateRaw p i))
      (trans (raw i p) (ap (\ x -> b.coordinate x i) (sym (ES.D.beta p)))))) ;
  entry (p : P.Carrier) (j i : Fin n) :
   Id k.R (EK.evaluate (PB.coordinate (P.mulQ p (P.constant (b.vector j))) i))
    (b.coordinate (S.ring.mul (ES.evaluate p) (b.vector j)) i) =
   trans (coordinate i (P.mulQ p (P.constant (b.vector j))))
    (ap (\ x -> b.coordinate x i)
     (trans (ES.preserves-mul p (P.constant (b.vector j)))
      (ap (S.ring.mul (ES.evaluate p)) (ES.on-constant (b.vector j))))) ;
  determinant (p : P.Carrier) :
   Id k.R (EK.evaluate (ExteriorModel[l].Over[K.ring].det n (\ j i -> PB.coordinate (P.mulQ p (P.constant (b.vector j))) i)))
    (FiniteAlgebraDeterminantUnit[l].Over[k,setk,S,n,b].At[ES.evaluate p].determinant) =
   trans (Naturality[l].Over[K.ring,k,EK.extension].det-nat n (\ j i -> PB.coordinate (P.mulQ p (P.constant (b.vector j))) i))
    (ap (ExteriorModel[l].Over[k].det n)
     (FE.funext (Fin n) (\ j -> Fin n -> k.R) (\ j i -> EK.evaluate (PB.coordinate (P.mulQ p (P.constant (b.vector j))) i)) (\ j i -> b.coordinate (S.ring.mul (ES.evaluate p) (b.vector j)) i) (\ j -> FE.funext (Fin n) (\ i -> k.R) (\ i -> EK.evaluate (PB.coordinate (P.mulQ p (P.constant (b.vector j))) i)) (\ i -> b.coordinate (S.ring.mul (ES.evaluate p) (b.vector j)) i) (entry p j)))) ;
 } ;
} ;
