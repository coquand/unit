-- The Kronecker polynomial epsilon + T sum Delta(b_i) T^i
-- evaluates to epsilon+Delta(z), with z explicitly evaluated in S.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) {
 module C = Algebras[l].Over[k,setk] ; module Tn = Tensor[l].Over[k,setk] ;
 module At (S D : C.Algebra) (cp : Tn.Coproduct S S D)
  (n : Nat) (b : TraceBasis[l].Over[k,setk,S].Basis[n])
  (epsilon : DiagonalCertificate[l].Over[k,setk].At[S,D,cp].Witness) {
  module RC = DiagonalRegularContent[l].Over[k,setk].At[S,D,cp,n,b,epsilon] ;
  module DK = RC.DK ; module L = RL[D.ring] ;
  module SP = PolyRegular[l].Over[S.ring,S.set] ; module DP = RC.P ;
  module SR = Poly[l].PolyR[S.ring] ; module DR = Poly[l].PolyR[D.ring] ;
  difference-zero : Id D.ring.R (DK.difference S.ring.z) D.ring.z =
   trans (cong2 D.ring.R D.ring.add _ _ _ _ (H.zero S.ring D.ring DK.left.1)
    (trans (ap D.ring.neg (H.zero S.ring D.ring DK.right.1)) L.neg-zero)) (D.ring.addZ D.ring.z) ;
  difference-add (x y : S.ring.R) : Id D.ring.R (DK.difference (S.ring.add x y))
   (D.ring.add (DK.difference x) (DK.difference y)) =
   trans (cong2 D.ring.R D.ring.add _ _ _ _ (DK.left.1.2.2.1 x y)
    (trans (ap D.ring.neg (DK.right.1.2.2.1 x y)) (L.neg-add (DK.right.1.1 x) (DK.right.1.1 y))))
    (L.swap (DK.left.1.1 x) (DK.left.1.1 y) (D.ring.neg (DK.right.1.1 x)) (D.ring.neg (DK.right.1.1 y))) ;
  difference-scale (a : k.R) (x : S.ring.R) :
   Id D.ring.R (DK.difference (S.ring.mul (S.iota.1 a) x)) (D.ring.mul (D.iota.1 a) (DK.difference x)) =
   trans (cong2 D.ring.R D.ring.add _ _ _ _
    (trans (DK.left.1.2.2.2 (S.iota.1 a) x) (ap (\ t -> D.ring.mul t (DK.left.1.1 x)) (DK.left.2 a)))
    (ap D.ring.neg (trans (DK.right.1.2.2.2 (S.iota.1 a) x) (ap (\ t -> D.ring.mul t (DK.right.1.1 x)) (DK.right.2 a)))))
    (trans (ap (D.ring.add (D.ring.mul (D.iota.1 a) (DK.left.1.1 x))) (sym (L.mul-neg (D.iota.1 a) (DK.right.1.1 x))))
     (sym (D.ring.dist (D.iota.1 a) (DK.left.1.1 x) (D.ring.neg (DK.right.1.1 x))))) ;
  horner (a : k.R) : (m : Nat) (v : Fin m -> S.ring.R) ->
   Id D.ring.R (DK.difference (SR.ev (SP.kron m v) (S.iota.1 a)))
    (DR.ev (DP.kron m (\ i -> DK.difference (v i))) (D.iota.1 a)) = split {
   zero -> \ v -> difference-zero ;
   suc m | ih -> \ v -> trans (difference-add (v (inr tt)) (S.ring.mul (S.iota.1 a) (SR.ev (SP.kron m (\ i -> v (inl i))) (S.iota.1 a))))
    (ap (D.ring.add (DK.difference (v (inr tt))))
     (trans (difference-scale a (SR.ev (SP.kron m (\ i -> v (inl i))) (S.iota.1 a)))
      (ap (D.ring.mul (D.iota.1 a)) (ih (\ i -> v (inl i)))))) } ;
  selected (a : k.R) : S.ring.R = S.ring.mul (S.iota.1 a) (SR.ev (SP.kron n b.vector) (S.iota.1 a)) ;
  module Evaluate (a : k.R) {
   module EV = Evaluation[l].Evaluate[D.ring,D.ring,D.set,D.set,H.identity D.ring,D.iota.1 a] ;
   raw-identity : (p : DR.P) -> Id D.ring.R (EV.E p) (DR.ev p (D.iota.1 a)) = split {
    nil -> refl D.ring.z ; cons c p | ih -> ap (\ t -> D.ring.add c (D.ring.mul (D.iota.1 a) t)) ih } ;
   delta : Id D.ring.R (DK.difference (selected a))
    (D.ring.mul (D.iota.1 a) (DR.ev (DP.kron n (\ i -> DK.difference (b.vector i))) (D.iota.1 a))) =
    trans (difference-scale a (SR.ev (SP.kron n b.vector) (S.iota.1 a))) (ap (D.ring.mul (D.iota.1 a)) (horner a n b.vector)) ;
   equation : Id D.ring.R (EV.evaluate RC.polynomial) (D.ring.add epsilon.epsilon (DK.difference (selected a))) =
    trans (EV.D.beta RC.raw) (trans (raw-identity RC.raw) (ap (D.ring.add epsilon.epsilon) (sym delta))) ;
   annihilates : Id D.ring.R (D.ring.mul epsilon.epsilon (DK.difference (selected a))) D.ring.z =
    trans (D.ring.dist epsilon.epsilon (DK.left.1.1 (selected a)) (D.ring.neg (DK.right.1.1 (selected a))))
     (trans (ap (D.ring.add (D.ring.mul epsilon.epsilon (DK.left.1.1 (selected a)))) (L.mul-neg epsilon.epsilon (DK.right.1.1 (selected a))))
      (trans (ap (\ t -> D.ring.add t (D.ring.neg (D.ring.mul epsilon.epsilon (DK.right.1.1 (selected a))))) (epsilon.equalises (selected a)))
       (D.ring.addN (D.ring.mul epsilon.epsilon (DK.right.1.1 (selected a)))))) ;
   module Unit (u : L.unit (EV.evaluate RC.polynomial)) {
    sum-unit : L.unit (D.ring.add epsilon.epsilon (DK.difference (selected a))) =
     (u.1,trans (ap (\ t -> D.ring.mul t u.1) (sym equation)) u.2) ;
    module Corner = SeparatorCorner[l].Over[D.ring,D.set,epsilon.epsilon,DK.difference (selected a),epsilon.idempotent,annihilates,sum-unit] ;
    inverse : D.ring.R = Corner.inverse ;
    inverse-equation : Id D.ring.R (D.ring.mul (DK.difference (selected a)) inverse) (D.ring.add D.ring.o (D.ring.neg epsilon.epsilon)) = Corner.equation ;
   } ;
  } ;
 } ;
} ;
