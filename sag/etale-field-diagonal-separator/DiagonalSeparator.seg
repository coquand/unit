-- A sufficiently large finite scalar list supplies a separating element.
-- Work on the full tensor algebra: epsilon is the constant coefficient,
-- and the remaining coefficients are the differences of the basis.
-- No splitting algebra, factorisation, discriminant, or basis of the
-- off-diagonal component is required.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (dec : (a : k.R) -> Plus (Id k.R a k.z) (RL[k].unit a))
 (nontrivial : Not (Id k.R k.o k.z)) {
 module C = Algebras[l].Over[k,setk] ; module Tn = Tensor[l].Over[k,setk] ;
 module At (S D : C.Algebra) (cp : Tn.Coproduct S S D)
  (n : Nat) (b : TraceBasis[l].Over[k,setk,S].Basis[n])
  (epsilon : DiagonalCertificate[l].Over[k,setk].At[S,D,cp].Witness) {
  module TensorBasis = TensorFieldBasis[l].Over[k,setk].At[S,D,cp,n,b] ;
  module RC = DiagonalRegularContent[l].Over[k,setk].At[S,D,cp,n,b,epsilon] ;
  module Value = DiagonalPolynomialValue[l].Over[k,setk].At[S,D,cp,n,b,epsilon] ;
  module DP = Poly[l].PolyR[D.ring] ;
  kron-bound : (m : Nat) (v : Fin m -> D.ring.R) -> PolynomialBounds[l].Over[D.ring].Bound m (RC.P.kron m v) = split {
   zero -> \ v j -> refl D.ring.z ;
   suc m | ih -> \ v j -> ih (\ i -> v (inl i)) j } ;
  module Selection = FinitePolynomialSelection[l].Over[k,setk,dec,nontrivial].At[
   D,TensorBasis.rank,TensorBasis.basis,n,RC.raw,kron-bound (suc n) RC.family,
   \ q h -> RC.polynomial-regular q tt (\ i -> h)] ;
  degree : Nat = Integers[l].times (FiniteProduct[l].size n n) n ;
  count : Nat = suc degree ;
  record Data {
   scalar : k.R ; element : S.ring.R ; inverse : D.ring.R ;
   formula : Id S.ring.R element (Value.selected scalar) ;
   equation : Id D.ring.R (D.ring.mul (RC.DK.difference element) inverse)
    (D.ring.add D.ring.o (D.ring.neg epsilon.epsilon)) ;
  } ;
  module Choose (candidates : Fin count -> k.R)
   (distinct : PolynomialRootBound[l].Over[k].Injective count candidates) {
   module Good = Selection.Choose[candidates,distinct] ;
   module V = Value.Evaluate[Good.scalar] ;
   module Inverse = V.Unit[Good.unit] ;
   result : Data = new Data[Good.scalar,Value.selected Good.scalar,Inverse.inverse,
    refl (Value.selected Good.scalar),Inverse.inverse-equation] ;
  } ;
  theorem (candidates : Fin count -> k.R)
   (distinct : PolynomialRootBound[l].Over[k].Injective count candidates) : Data = Choose[candidates,distinct].result ;
 } ;
} ;
