-- Injectivity of multiplication passes to its actual finite basis matrix.
-- This interface works over every base ring and includes rank zero.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (S : Algebras[l].Over[R,setR].Algebra) (n : Nat) (b : TraceBasis[l].Over[R,setR,S].Basis[n]) {
 module B = TraceBasis[l].Over[R,setR,S].At[n,b] ;
 module Coordinates = FiniteBasisComposition[l].Coordinates[R,setR,S,n,b] ;
 module M = Matrices[l].Over[R] ; module RS = FiniteIdeal[l].Sums[R] ;
 module At (x : S.ring.R) (regular : (a : S.ring.R) -> Id S.ring.R (S.ring.mul x a) S.ring.z -> Id S.ring.R a S.ring.z) {
  matrix : M.Mat n n = \ j i -> b.coordinate (S.ring.mul x (b.vector j)) i ;
  action (v : Fin n -> R.R) (i : Fin n) :
   Id R.R (b.coordinate (S.ring.mul x (Coordinates.expand v)) i) (M.apply n n matrix v i) =
   trans (B.product-coordinate x (Coordinates.expand v) i)
    (RS.sum-cong n (\ j -> R.mul (b.coordinate (Coordinates.expand v) j) (matrix j i)) (\ j -> R.mul (v j) (matrix j i)) (\ j -> ap (\ a -> R.mul a (matrix j i)) (Coordinates.coordinate-expand v j))) ;
  injective : M.Injective n n matrix = \ v h i ->
   trans (sym (Coordinates.coordinate-expand v i))
    (trans (ap (\ a -> b.coordinate a i)
      (regular (Coordinates.expand v)
       (B.coordinates-determine _ _ (\ j -> trans (action v j) (trans (h j) (sym (B.zero j)))))))
     (B.zero i)) ;
  module Mc = SquareMatrixMcCoy[l].Over[R,setR].At[n,matrix,injective] ;
  determinant-regular : (a : R.R) -> Id R.R (R.mul (ExteriorModel[l].Over[R].det n matrix) a) R.z -> Id R.R a R.z = Mc.regular ;
  determinant-nonzero (one-nonzero : Not (Id R.R R.o R.z)) : Not (Id R.R (ExteriorModel[l].Over[R].det n matrix) R.z) = Mc.nonzero one-nonzero ;
 } ;
} ;
