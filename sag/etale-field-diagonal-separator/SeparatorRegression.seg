-- Full separator on F2 over itself; nonconstant regular polynomial T
-- really chooses a nonroot; rank-zero algebra; and nontrivial corner.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ; module Tr = Truncation[l] ;
module F2 = BooleanRing[l] ;
k : CRing = F2.two-ring ;
one : Nat = suc zero ; two : Nat = suc one ;
dec : (a : k.R) -> Plus (Id k.R a k.z) (RL[k].unit a) = split {
 false -> inl (refl false) ; true -> inr (true,refl true) } ;
nontrivial : Not (Id k.R k.o k.z) = \ h -> Pr.absurd Empty (F2.true-false h) ;
candidates : Fin two -> k.R = snoc (Fin one) k.R (\ i -> false) true ;
index : k.R -> Fin two = split { false -> inl (inr tt) ; true -> inr tt } ;
index-value : (i : Fin two) -> Id (Fin two) (index (candidates i)) i = split {
 inl i -> ap (\ j -> inl j) (FiniteFieldAnnihilator[l].singleton-prop (inr tt) i) ;
 inr t -> ap (\ u -> inr u) (MnSums[l].top-eq tt t) } ;
distinct (i j : Fin two) (h : Id k.R (candidates i) (candidates j)) : Id (Fin two) i j =
 trans (sym (index-value i)) (trans (ap index h) (index-value j)) ;
module C = Algebras[l].Over[k,F2.bool-set] ; module TB = TraceBasis[l].Over[k,F2.bool-set,C.base] ;
one-index : (i : Fin one) -> Id (Fin one) i (inr tt) = split {
 inl e -> efq e ; inr t -> ap (\ u -> inr u) (MnSums[l].top-eq t tt) } ;
delta-one (i j : Fin one) : Id k.R (MnSums[l].Over[k].delta one i j) k.o =
 trans (ap (\ h -> MnSums[l].Over[k].delta one h j) (one-index i))
  (ap (MnSums[l].Over[k].delta one (inr tt)) (one-index j)) ;
base-basis : TB.Basis[one] = TB.mkBasis one (\ i -> k.o) (\ a i -> a)
 (\ a b i -> refl (k.add a b)) (\ r a i -> refl (k.mul r a))
 (\ a -> trans (k.addZ (k.mul a k.o)) (k.mulO a)) (\ j i -> sym (delta-one i j)) ;
unique : FormallyEtale[l].Over[k,F2.bool-set].Unique C.base = \ A N f g h ->
 C.ext C.base A f g (\ r -> trans (f.2 r) (sym (g.2 r))) ;
module BaseP = BasePresentation[l].Over[k,F2.bool-set] ;
module Actual = DiagonalCertificate[l].Over[k,F2.bool-set].Concrete[BaseP.empty,C.base,BaseP.presentation,unique] ;
module Sep = DiagonalSeparator[l].Over[k,F2.bool-set,dec,nontrivial] ;
module Given (epsilon : Actual.Diag.Witness) {
 module Test = Sep.At[C.base,Actual.T.T,Actual.T.coproduct,one,base-basis,epsilon] ;
 result : Test.Data = Test.theorem candidates distinct ;
 equation : Id Actual.T.T.ring.R
  (Actual.T.T.ring.mul (Test.RC.DK.difference result.element) result.inverse)
  (Actual.T.T.ring.add Actual.T.T.ring.o (Actual.T.T.ring.neg epsilon.epsilon)) = result.equation ;
} ;
constructed : Tr.Trunc[(epsilon : Actual.Diag.Witness) * Sep.At[C.base,Actual.T.T,Actual.T.coproduct,one,base-basis,epsilon].Data].carrier =
 TruncationCombinators[l].map Actual.Diag.Witness
  ((epsilon : Actual.Diag.Witness) * Sep.At[C.base,Actual.T.T,Actual.T.coproduct,one,base-basis,epsilon].Data)
  (\ epsilon -> (epsilon,Given[epsilon].result)) Actual.theorem ;
module K = PolynomialRing[l].Extension[k,F2.bool-set] ;
module Variable = FinitePolynomialSelection[l].Over[k,F2.bool-set,dec,nontrivial].At[
 C.base,one,base-basis,one,K.T,\ r -> refl false,MonicRegular[l].Over[k,F2.bool-set].At[cons false nil].kernel] ;
module Good = Variable.Choose[candidates,distinct] ;
nonroot : Not (Id k.R (Good.Special.ES.evaluate K.variable) false) =
 DiscreteFieldOperations[l].Over[k,F2.bool-set,dec,nontrivial].unit-nonzero _ Good.unit ;
selected-one : Id k.R Good.scalar true = refl true ;
module ZeroAlgebra {
 ring : CRing = mkCRing Top tt tt (\ a b -> tt) (\ a b -> tt) (\ a -> tt)
  (\ a b c -> refl tt) (\ a b -> refl tt) (\ a -> MnSums[l].top-eq tt a) (\ a -> refl tt)
  (\ a b c -> refl tt) (\ a b -> refl tt) (\ a -> MnSums[l].top-eq tt a) (\ a b c -> refl tt) ;
 set : Pr.isSet Top = Pr.prop-to-set Top MnSums[l].top-eq ;
 algebra : C.Algebra = C.mkAlgebra ring set (\ a -> tt,refl tt,\ a b -> refl tt,\ a b -> refl tt) ;
 module B = TraceBasis[l].Over[k,F2.bool-set,algebra] ;
 zero-basis : B.Basis[zero] = B.mkBasis zero (\ i -> efq i) (\ a i -> efq i)
  (\ a b i -> efq i) (\ r a i -> efq i) (\ a -> MnSums[l].top-eq tt a) (\ j i -> efq j) ;
 module P = PolynomialRing[l].Extension[ring,set] ;
 all-zero (q : P.Carrier) : Id P.Carrier q P.zeroQ =
  P.Q.induction @l (\ q -> Id P.Carrier q P.zeroQ) (\ q -> P.set _ _)
   (\ p -> P.Q.relates p nil (\ i -> MnSums[l].top-eq _ _)) q ;
 module Selection = FinitePolynomialSelection[l].Over[k,F2.bool-set,dec,nontrivial].At[
  algebra,zero,zero-basis,zero,nil,\ r -> refl tt,\ q h -> all-zero q] ;
 module Choose = Selection.Choose[\ i -> false,\ i j h -> trans (one-index i) (sym (one-index j))] ;
 invertible : RL[ring].unit tt = Choose.unit ;
} ;
module Corner {
 Pair : U l = k.R * k.R ;
 pair-eq (a b : Pair) (h : Id k.R a.1 b.1) (j : Id k.R a.2 b.2) : Id Pair a b =
  AffineHLevels[l].pair-path k.R k.R a.1 b.1 a.2 b.2 h j ;
 add (a b : Pair) : Pair = (k.add a.1 b.1,k.add a.2 b.2) ;
 mul (a b : Pair) : Pair = (k.mul a.1 b.1,k.mul a.2 b.2) ;
 neg (a : Pair) : Pair = (k.neg a.1,k.neg a.2) ;
 ring : CRing = mkCRing Pair (false,false) (true,true) add mul neg
  (\ a b c -> pair-eq _ _ (k.addA a.1 b.1 c.1) (k.addA a.2 b.2 c.2))
  (\ a b -> pair-eq _ _ (k.addC a.1 b.1) (k.addC a.2 b.2))
  (\ a -> pair-eq _ _ (k.addZ a.1) (k.addZ a.2)) (\ a -> pair-eq _ _ (k.addN a.1) (k.addN a.2))
  (\ a b c -> pair-eq _ _ (k.mulA a.1 b.1 c.1) (k.mulA a.2 b.2 c.2))
  (\ a b -> pair-eq _ _ (k.mulC a.1 b.1) (k.mulC a.2 b.2))
  (\ a -> pair-eq _ _ (k.mulO a.1) (k.mulO a.2))
  (\ a b c -> pair-eq _ _ (k.dist a.1 b.1 c.1) (k.dist a.2 b.2 c.2)) ;
 set : Pr.isSet Pair = Pr.isSet-Sigma k.R (\ a -> k.R) F2.bool-set (\ a -> F2.bool-set) ;
 module Test = SeparatorCorner[l].Over[ring,set,(true,false),(false,true),refl (true,false),refl (false,false),((true,true),refl (true,true))] ;
 inverse : Id Pair Test.inverse (false,true) = refl (false,true) ;
 equation : Id Pair (ring.mul (false,true) Test.inverse) (false,true) = Test.equation ;
 not-global-inverse : Not (Id Pair (ring.mul (false,true) Test.inverse) ring.o) =
  \ h -> nontrivial (sym (ap (\ a -> a.1) h)) ;
} ;
