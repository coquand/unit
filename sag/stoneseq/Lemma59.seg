-- SSD Lemma 5.9, generic part: the Čech complex of a limit of finite data
-- is exact at C1 once its groups are the colimits of the finite stages.
--
-- Setting: an inverse sequence S of finite sets, a family T over it with
-- every T k x merely inhabited, and an abelian group G (Z in SSD).  The
-- limit is L = lim S with a cone K over T: a family K.T over L with
-- compatible maps K.pr k x to T k (x k) (for instance K.T x = lim T k (x k),
-- SeqLim.Over.cone, or the fibres of a limit map, FibreSeq).  The Čech
-- complexes of (S k, T k, G) form sequences (precomposition), with maps of
-- sequences d0, d1; the canonical maps Phi i from their colimits to the
-- complex of (L, K.T, G) are  inc k a |-> a at the k-th components.
-- SSD gets "Phi i is an equivalence" from Corollary 3.7; here we assume only
-- what is used: Phi 1 surjective and Phi 2 injective.
--
-- Proof (SSD).  Each stage is exact: S k is finite and the T k x are
-- inhabited, so by finite choice there is a section, and Lemma 5.5 applies.
-- A sequential colimit of exact sequences is exact (ExactColim).  Given a
-- cocycle b on the limit, b = Phi 1 b' (surjective); Phi 2 (d1 b') = d1 b = 0,
-- so d1 b' = 0 (injective); hence b' = d0 a' and b = d0 (Phi 0 a').
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Torsor[l] ; open SeqColim[l] ; open SeqMaps[l] ; open Bijection[l] ;
open Finite[l] ; open CechComplex[l] ; open SeqLim[l] ; open ExactColim[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;

-- functions of several arguments: pointwise equality
module Pointwise (X : U l) (Y : X -> U l) (R : U l) {
  app2 (f g : (x : X) -> Y x -> Y x -> R) (p : Id ((x : X) -> Y x -> Y x -> R) f g) (x : X) (u v : Y x) : Id R (f x u v) (g x u v) =
    happly (Y x) (\ t -> R) (f x u) (g x u)
      (happly (Y x) (\ t -> Y x -> R) (f x) (g x) (happly X (\ y -> Y y -> Y y -> R) f g p x) u) v ;
  app3 (f g : (x : X) -> Y x -> Y x -> Y x -> R) (p : Id ((x : X) -> Y x -> Y x -> Y x -> R) f g) (x : X) (u v w : Y x)
    : Id R (f x u v w) (g x u v w) =
    happly (Y x) (\ t -> R) (f x u v) (g x u v)
      (happly (Y x) (\ t -> Y x -> R) (f x u) (g x u)
        (happly (Y x) (\ t -> Y x -> Y x -> R) (f x) (g x) (happly X (\ y -> Y y -> Y y -> Y y -> R) f g p x) u) v) w ;
  fun1 (f g : (x : X) -> Y x -> R) (h : (x : X) (u : Y x) -> Id R (f x u) (g x u)) : Id ((x : X) -> Y x -> R) f g =
    FL.funext X (\ y -> Y y -> R) f g (\ x -> FL.funext (Y x) (\ t -> R) (f x) (g x) (h x)) ;
  fun2 (f g : (x : X) -> Y x -> Y x -> R) (h : (x : X) (u v : Y x) -> Id R (f x u v) (g x u v)) : Id ((x : X) -> Y x -> Y x -> R) f g =
    FL.funext X (\ y -> Y y -> Y y -> R) f g (\ x -> FL.funext (Y x) (\ t -> Y x -> R) (f x) (g x) (\ u ->
      FL.funext (Y x) (\ t -> R) (f x u) (g x u) (h x u))) ;
  fun3 (f g : (x : X) -> Y x -> Y x -> Y x -> R) (h : (x : X) (u v w : Y x) -> Id R (f x u v w) (g x u v w))
    : Id ((x : X) -> Y x -> Y x -> Y x -> R) f g =
    FL.funext X (\ y -> Y y -> Y y -> Y y -> R) f g (\ x -> FL.funext (Y x) (\ t -> Y x -> Y x -> R) (f x) (g x) (\ u ->
      FL.funext (Y x) (\ t -> Y x -> R) (f x u) (g x u) (\ v -> FL.funext (Y x) (\ t -> R) (f x u v) (g x u v) (h x u v)))) ;
  set1 (sR : isSet R) : isSet ((x : X) -> Y x -> R) =
    FL.isSet-Pi X (\ y -> Y y -> R) (\ y -> FL.isSet-Pi (Y y) (\ t -> R) (\ t -> sR)) ;
  set2 (sR : isSet R) : isSet ((x : X) -> Y x -> Y x -> R) =
    FL.isSet-Pi X (\ y -> Y y -> Y y -> R) (\ y -> FL.isSet-Pi (Y y) (\ t -> Y y -> R) (\ t -> FL.isSet-Pi (Y y) (\ t' -> R) (\ t' -> sR))) ;
  set3 (sR : isSet R) : isSet ((x : X) -> Y x -> Y x -> Y x -> R) =
    FL.isSet-Pi X (\ y -> Y y -> Y y -> Y y -> R) (\ y -> FL.isSet-Pi (Y y) (\ t -> Y y -> Y y -> R) (\ t ->
      FL.isSet-Pi (Y y) (\ t' -> Y y -> R) (\ t' -> FL.isSet-Pi (Y y) (\ t'' -> R) (\ t'' -> sR)))) ;
  -- moving the arguments along a path of the base and matching paths of the fibres
  move1 (a : (x : X) -> Y x -> R) (y y' : X) (e : Id X y y') (t : Y y) (t' : Y y') (q : Id (Y y') (subst X Y y y' e t) t')
    : Id R (a y t) (a y' t') =
    idJ X y (\ z e1 -> (t1 : Y z) -> Id (Y z) (subst X Y y z e1 t) t1 -> Id R (a y t) (a z t1))
      (\ t1 q1 -> apH (a y) q1) y' e t' q ;
  move2 (a : (x : X) -> Y x -> Y x -> R) (y y' : X) (e : Id X y y') (t s : Y y) (t' s' : Y y')
    (q : Id (Y y') (subst X Y y y' e t) t') (r : Id (Y y') (subst X Y y y' e s) s') : Id R (a y t s) (a y' t' s') =
    idJ X y (\ z e1 -> (t1 s1 : Y z) -> Id (Y z) (subst X Y y z e1 t) t1 -> Id (Y z) (subst X Y y z e1 s) s1 -> Id R (a y t s) (a z t1 s1))
      (\ t1 s1 q1 r1 -> transH (apH (\ c -> a y c s) q1) (apH (a y t1) r1)) y' e t' s' q r ;
  move3 (a : (x : X) -> Y x -> Y x -> Y x -> R) (y y' : X) (e : Id X y y') (t s o : Y y) (t' s' o' : Y y')
    (q : Id (Y y') (subst X Y y y' e t) t') (r : Id (Y y') (subst X Y y y' e s) s') (m : Id (Y y') (subst X Y y y' e o) o')
    : Id R (a y t s o) (a y' t' s' o') =
    idJ X y (\ z e1 -> (t1 s1 o1 : Y z) -> Id (Y z) (subst X Y y z e1 t) t1 -> Id (Y z) (subst X Y y z e1 s) s1
         -> Id (Y z) (subst X Y y z e1 o) o1 -> Id R (a y t s o) (a z t1 s1 o1))
      (\ t1 s1 o1 q1 r1 m1 -> transH (apH (\ c -> a y c s o) q1) (transH (apH (\ c -> a y t1 c o) r1) (apH (a y t1 s1) m1)))
      y' e t' s' o' q r m ;
} ;

module Lemma59 (S : InvSeq) (F : Family[S]) (G : Ab)
  (finS : (k : Nat) -> isFinite (S.E k)) (inh : (k : Nat) (x : S.E k) -> Tr.Trunc[F.T k x].carrier)
  (K : Cone[S, F]) {
  -- the finite stages
  seq0 : Seq = new Seq[\ k -> Cech[S.E k, F.T k, \ x -> G].C0, \ k a x u -> a (S.p k x) (F.q k x u)] ;
  seq1 : Seq = new Seq[\ k -> Cech[S.E k, F.T k, \ x -> G].C1, \ k b x u v -> b (S.p k x) (F.q k x u) (F.q k x v)] ;
  seq2 : Seq = new Seq[\ k -> Cech[S.E k, F.T k, \ x -> G].C2,
    \ k b x u v w -> b (S.p k x) (F.q k x u) (F.q k x v) (F.q k x w)] ;
  D0 : SeqMap[seq0, seq1] = new SeqMap[seq0, seq1, \ k -> Cech[S.E k, F.T k, \ x -> G].d0,
    \ k a -> refl (seq1.f k (Cech[S.E k, F.T k, \ x -> G].d0 a))] ;
  D1 : SeqMap[seq1, seq2] = new SeqMap[seq1, seq2, \ k -> Cech[S.E k, F.T k, \ x -> G].d1,
    \ k b -> refl (seq2.f k (Cech[S.E k, F.T k, \ x -> G].d1 b))] ;
  zero2 (k : Nat) : seq2.A k = \ x u v w -> G.o ;
  -- each stage is exact (finite choice of a section, Lemma 5.5)
  exact (k : Nat) (b : seq1.A k) (z : Id (seq2.A k) (D1.h k b) (zero2 k)) : Tr.Trunc[Fibre (D0.h k) b].carrier =
    TC.bind ((x : S.E k) -> F.T k x) (Fibre (D0.h k) b) (\ t ->
      TC.map ((a : seq0.A k) * Cech[S.E k, F.T k, \ x -> G].Bounds b a) (Fibre (D0.h k) b)
        (\ w -> (w.1, symH (Pointwise[S.E k, F.T k, G.A].fun2 b (D0.h k w.1) w.2)))
        (lemma55 (S.E k) (F.T k) (\ x -> G) t b
          (Cech[S.E k, F.T k, \ x -> G].d1-cocycle b (Pointwise[S.E k, F.T k, G.A].app3 (D1.h k b) (zero2 k) z))))
      (choice (S.E k) (finS k) (F.T k) (inh k)) ;
  module EC = ExactColim[l].ExactColim[seq0, seq1, seq2, D0, D1, zero2, \ k -> refl (zero2 (suc k)), exact] ;

  -- the limit and its complex
  L : U l = Limit[S].lim ;
  module CI = Cech[L, K.T, \ x -> G] ;
  module PI = Pointwise[L, K.T, G.A] ;
  module PK (k : Nat) { module P = Pointwise[S.E k, F.T k, G.A] ; } ;
  module R0 = EC.CA.Rec[CI.C0, PI.set1 G.setA, new EC.CA.Cocone[CI.C0, \ k a x u -> a (x.1 k) (K.pr k x u), \ k a ->
    PI.fun1 _ _ (\ x u -> PK[k].P.move1 a (S.p k (x.1 (suc k))) (x.1 k) (x.2 k)
      (F.q k (x.1 (suc k)) (K.pr (suc k) x u)) (K.pr k x u) (K.pc k x u))]] ;
  module R1 = EC.CB.Rec[CI.C1, PI.set2 G.setA, new EC.CB.Cocone[CI.C1, \ k b x u v -> b (x.1 k) (K.pr k x u) (K.pr k x v), \ k b ->
    PI.fun2 _ _ (\ x u v -> PK[k].P.move2 b (S.p k (x.1 (suc k))) (x.1 k) (x.2 k)
      (F.q k (x.1 (suc k)) (K.pr (suc k) x u)) (F.q k (x.1 (suc k)) (K.pr (suc k) x v)) (K.pr k x u) (K.pr k x v) (K.pc k x u) (K.pc k x v))]] ;
  module R2 = EC.CC.Rec[CI.C2, PI.set3 G.setA, new EC.CC.Cocone[CI.C2, \ k b x u v w -> b (x.1 k) (K.pr k x u) (K.pr k x v) (K.pr k x w), \ k b ->
    PI.fun3 _ _ (\ x u v w -> PK[k].P.move3 b (S.p k (x.1 (suc k))) (x.1 k) (x.2 k)
      (F.q k (x.1 (suc k)) (K.pr (suc k) x u)) (F.q k (x.1 (suc k)) (K.pr (suc k) x v)) (F.q k (x.1 (suc k)) (K.pr (suc k) x w))
      (K.pr k x u) (K.pr k x v) (K.pr k x w) (K.pc k x u) (K.pc k x v) (K.pc k x w))]] ;
  Phi0 (c : EC.CA.colim) : CI.C0 = R0.map c ;
  Phi1 (c : EC.CB.colim) : CI.C1 = R1.map c ;
  Phi2 (c : EC.CC.colim) : CI.C2 = R2.map c ;
  square0 (c : EC.CA.colim) : Id CI.C1 (Phi1 (EC.I0.map c)) (CI.d0 (Phi0 c)) =
    EC.CA.ext CI.C1 (PI.set2 G.setA) (\ c1 -> Phi1 (EC.I0.map c1)) (\ c1 -> CI.d0 (Phi0 c1)) (\ k a -> calc CI.C1 {
      Phi1 (EC.I0.map (EC.CA.inc k a)) =< apH Phi1 (EC.I0.map-inc k a) > Phi1 (EC.CB.inc k (D0.h k a))
        =< R1.beta k (D0.h k a) > CI.d0 (\ x u -> a (x.1 k) (K.pr k x u))
        =< apH CI.d0 (symH (R0.beta k a)) > CI.d0 (Phi0 (EC.CA.inc k a)) }) c ;
  square1 (c : EC.CB.colim) : Id CI.C2 (Phi2 (EC.I1.map c)) (CI.d1 (Phi1 c)) =
    EC.CB.ext CI.C2 (PI.set3 G.setA) (\ c1 -> Phi2 (EC.I1.map c1)) (\ c1 -> CI.d1 (Phi1 c1)) (\ k b -> calc CI.C2 {
      Phi2 (EC.I1.map (EC.CB.inc k b)) =< apH Phi2 (EC.I1.map-inc k b) > Phi2 (EC.CC.inc k (D1.h k b))
        =< R2.beta k (D1.h k b) > CI.d1 (\ x u v -> b (x.1 k) (K.pr k x u) (K.pr k x v))
        =< apH CI.d1 (symH (R1.beta k b)) > CI.d1 (Phi1 (EC.CB.inc k b)) }) c ;
  zero-inf : CI.C2 = \ x u v w -> G.o ;
  point : Id CI.C2 (Phi2 EC.point) zero-inf = R2.beta zero (zero2 zero) ;

  module Theorem (surj1 : (b : CI.C1) -> Tr.Trunc[Fibre Phi1 b].carrier) (inj2 : Injective Phi2) {
    module Given (b : CI.C1) (cb : CI.Cocycle b) (w : Fibre Phi1 b) {
      killed : Id EC.CC.colim (EC.I1.map w.1) EC.point = inj2 (EC.I1.map w.1) EC.point (calc CI.C2 {
        Phi2 (EC.I1.map w.1) =< square1 w.1 > CI.d1 (Phi1 w.1)
          =< apH CI.d1 w.2 > CI.d1 b
          =< PI.fun3 (CI.d1 b) zero-inf (CI.cocycle-d1 b cb) > zero-inf
          =< symH point > Phi2 EC.point }) ;
      bounds (v : Fibre EC.I0.map w.1) : CI.Bounds b (Phi0 v.1) =
        PI.app2 b (CI.d0 (Phi0 v.1)) (transH (symH w.2) (transH (apH Phi1 (symH v.2)) (square0 v.1))) ;
      result : CI.Coboundary b =
        TC.map (Fibre EC.I0.map w.1) ((a : CI.C0) * CI.Bounds b a) (\ v -> (Phi0 v.1, bounds v))
          (EC.exact-colim w.1 killed) ;
    } ;
    h1 : CI.H1Zero = \ b cb ->
      TC.bind (Fibre Phi1 b) ((a : CI.C0) * CI.Bounds b a) (\ w -> Given[b, cb, w].result) (surj1 b) ;
  } ;
} ;
