-- SSD Lemmas 5.8 and 5.9: for S Stone and T x Stone and merely inhabited,
-- Ȟ^1 (S, T, Z) = 0.
--
-- Lemma 5.8.  (x : S) * T x is Stone (Theorem 4.18, worker A) and the first
-- projection is onto (T x inhabited), so by Remark 3.4 (worker A) it is
-- merely a limit of surjections g k : E k -> G k of finite sets, with
-- S = lim G and (x : S) * T x = lim E over it.  The finite families of
-- SSD are the fibres of the g k (FibreSeq.Fib), with limit the fibres of
-- lim g (FibreSeq.cone).
--
-- Lemma 5.9.  The goal is a proposition, so take such data.  Ȟ^1 vanishes
-- for (lim G, fibres of lim g) (Lemma59Fibres); it moves along S = lim G
-- (CechTransfer.base) and along
--   T x = fibre of the projection over x = fibre of lim g over eY x
-- (fibre-fst, then SquareFibre on the square of Remark 3.4), by
-- CechTransfer.Fibrewise.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Torsor[l] ; open Integers[l] ; open Bijection[l] ;
open DependentChoice[l] ; open SeqLim[l] ; open CechComplex[l] ; open CechTransfer[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module T1 = Truncation[l+] ; module TC1 = TruncationCombinators[l+] ;
module PF = Profinite[l,l] ;
module Eq = Equivalences[l] ;

module Over (ax : StoneAxioms[l,l].Assumptions) {
  fst-surjective (S : U l) (T : S -> U l) (inh : (x : S) -> Tr.Trunc[T x].carrier) : Surjective (fst S T) = \ x ->
    TC.map (T x) (Fibre (fst S T) x) (\ t -> ((x, t), refl x)) (inh x) ;

  -- SSD Lemma 5.8
  lemma58 (S : U l) (sS : PF.isStone S) (T : S -> U l) (sT : (x : S) -> PF.isStone (T x))
    (inh : (x : S) -> Tr.Trunc[T x].carrier) : T1.Trunc[Remark34[l].SurjLim[(x : S) * T x, S, fst S T]].carrier =
    Remark34[l].Over[ax].remark34 ((x : S) * T x) S (Thm418[l].Over[ax].thm418 S sS T sT) sS (fst S T)
      (fst-surjective S T inh) ;

  -- Lemma 5.9 from the data of Lemma 5.8
  module FromLimit (S : U l) (T : S -> U l) (d : Remark34[l].SurjLim[(x : S) * T x, S, fst S T]) {
    SE : InvSeq = new InvSeq[d.E, d.p] ;
    SG : InvSeq = new InvSeq[d.G, d.q] ;
    H : InvMap[SE, SG] = new InvMap[SE, SG, d.g, d.comm] ;
    module LF = Lemma59Fibres[l].Over[ax].Lemma59Fibres[SE, SG, H, d.finE, d.finG, d.surj] ;
    set-E : isSet (Limit[SE].lim) = Limit[SE].Sets[LF.Fi.sE].set ;
    set-G : isSet (Limit[SG].lim) = Limit[SG].Sets[LF.Fi.sG].set ;
    set-S : isSet S = isSet-retract S (Limit[SG].lim) d.eY.1 d.eY.2.sec (sec-ret S (Limit[SG].lim) d.eY.1 d.eY.2) set-G ;
    -- the square of Remark 3.4, for the limit map of SeqLim
    over (w : (x : S) * T x) : Id (Limit[SG].lim) (d.eY.1 (fst S T w)) (lim-map SE SG H (d.eX.1 w)) =
      transH (d.over w) (Limit[SG].Sets[LF.Fi.sG].lim-eq (Remark34[l].limit-map d.E d.p d.G d.q d.g d.comm (d.eX.1 w))
        (lim-map SE SG H (d.eX.1 w)) (\ n -> refl (d.g n ((d.eX.1 w).1 n)))) ;
    phi (x : S) : Equiv (T x) (Fibre (lim-map SE SG H) (d.eY.1 x)) =
      Eq.compose (T x) (Fibre (fst S T) x) (Fibre (lim-map SE SG H) (d.eY.1 x)) (fibre-fst S T x)
        (SquareFibre[(y : S) * T y, S, Limit[SE].lim, Limit[SG].lim, set-S, set-E, set-G, fst S T, lim-map SE SG H,
          d.eX, d.eY, over, x].equiv) ;
    theorem : Cech[S, T, \ x -> intAb].H1Zero =
      Fibrewise[S, T, \ x -> Fibre (lim-map SE SG H) (d.eY.1 x), intAb, phi,
        base S intAb (Limit[SG].lim) d.eY (Fibre (lim-map SE SG H)) LF.theorem].result ;
  } ;

  -- SSD Lemma 5.9
  lemma59 (S : U l) (sS : PF.isStone S) (T : S -> U l) (sT : (x : S) -> PF.isStone (T x))
    (inh : (x : S) -> Tr.Trunc[T x].carrier) : Cech[S, T, \ x -> intAb].H1Zero =
    TC1.rec (Remark34[l].SurjLim[(x : S) * T x, S, fst S T]) @l (Cech[S, T, \ x -> intAb].H1Zero) (h1-prop S T intAb)
      (\ d -> FromLimit[S, T, d].theorem) (lemma58 S sS T sT inh) ;
} ;
