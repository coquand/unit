-- SSD Lemma 5.10: for S Stone, H^1 (S, Z) = 0: every family alpha of
-- Z-torsors over S is merely trivial (BZ = Z-torsors, CechComplex.CohZero).
--
-- Proof (SSD).  The goal is a proposition, so take S = Sp B (e).  Each
-- alpha x is merely inhabited, so by local choice (Axiom 3, worker A)
-- there are merely C : Booleω, q : Sp C -> Sp B onto, and points
-- sigma t of alpha at q t.  Let T x be the fibre of q over e x: it is Stone
-- (Theorem 4.18: Sp C is Stone, and equality in Sp B is closed, Lemma 3.10,
-- so Stone, Corollary 3.9) and merely inhabited (q is onto), and gives
-- points beta x (t, h) of alpha x (transport sigma t along h and e).  Then
-- Ȟ^1 (S, T, Z) = 0 (Lemma 5.9) and Lemma 5.7 conclude.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Torsor[l] ; open TorsorId[l] ; open TrivialGerbe[l] ;
open Integers[l] ; open Bijection[l] ; open CechComplex[l] ;
module Tr = Truncation[l] ;
module T1 = Truncation[l+] ; module TC1 = TruncationCombinators[l+] ;
module P = Presented[l] ;
module PF = Profinite[l,l] ;
module SA = StoneAxioms[l,l] ;

module Over (ax : SA.Assumptions) {
  sp-stone (C : P.Booleω) : PF.isStone (P.Sp C.1) = T1.Trunc[PF.StoneW (P.Sp C.1)].inc (C, idEquiv (P.Sp C.1)) ;
  sp-set (C : P.Booleω) : isSet (P.Sp C.1) = RingHom[l].Properties[C.1.ring, BooleanRing[l].two-ring, BooleanRing[l].bool-set].set ;

  module Lemma510 (S : U l) (alpha : (x : S) -> TorId[intAb].Tor) {
    Goal : U l+ = T1.Trunc[(x : S) -> Id (TorId[intAb].Tor) (alpha x) (TrivG[intAb].Atriv)].carrier ;
    module OnSp (B : P.Booleω) (e : Equiv S (P.Sp B.1)) {
      -- the points of alpha, as a family over Sp B
      F (s : P.Sp B.1) : U l = (alpha (e.2.sec s)).1 ;
      inhabited (s : P.Sp B.1) : Tr.Trunc[F s].carrier = (alpha (e.2.sec s)).2.2.2.2.2.2 ;
      module Chosen (ld : SA.LocalData B F) {
        q (t : P.Sp ld.1.1) : P.Sp B.1 = ld.2.1 t ;
        T (x : S) : U l = Fibre q (e.1 x) ;
        stone (x : S) : PF.isStone (T x) =
          Thm418[l].Over[ax].thm418 (P.Sp ld.1.1) (sp-stone ld.1) (\ t -> Id (P.Sp B.1) (q t) (e.1 x)) (\ t ->
            StoneClosed[l,l].Over[ax].closed-stone (Id (P.Sp B.1) (q t) (e.1 x)) (sp-set B (q t) (e.1 x))
              (StoneClosed[l,l].lemma310 (P.Sp B.1) (sp-stone B) (q t) (e.1 x))) ;
        inh (x : S) : Tr.Trunc[T x].carrier = ld.2.2.1 (e.1 x) ;
        beta (x : S) (u : T x) : (alpha x).1 =
          subst S (\ y -> (alpha y).1) (e.2.sec (e.1 x)) x (sec-ret S (P.Sp B.1) e.1 e.2 x)
            (subst (P.Sp B.1) F (q u.1) (e.1 x) u.2 (ld.2.2.2 u.1)) ;
        result : Goal = Lemma57[S, T, inh, \ x -> intAb,
          Lemma59Stone[l].Over[ax].lemma59 S (T1.Trunc[PF.StoneW S].inc (B, e)) T stone inh, alpha, beta].result ;
      } ;
      result : Goal = TC1.rec (SA.LocalData B F) @(l+) Goal T1.Trunc[(x : S) -> Id (TorId[intAb].Tor) (alpha x) (TrivG[intAb].Atriv)].proposition
        (\ ld -> Chosen[ld].result) (ax.local B F inhabited) ;
    } ;
    result (sS : PF.isStone S) : Goal = TC1.rec (PF.StoneW S) @(l+) Goal
      T1.Trunc[(x : S) -> Id (TorId[intAb].Tor) (alpha x) (TrivG[intAb].Atriv)].proposition
      (\ w -> OnSp[w.1, w.2].result) sS ;
  } ;
  lemma510 (S : U l) (sS : PF.isStone S) : CohZero S (\ x -> intAb) = \ alpha -> Lemma510[S, alpha].result sS ;
} ;
