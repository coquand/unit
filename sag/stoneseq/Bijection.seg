-- A map of sets that is injective and (merely) surjective is an
-- equivalence: its fibres are propositions (by injectivity) that are merely
-- inhabited, hence inhabited.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;

Fibre {A B : U l} (f : A -> B) (b : B) : U l = (a : A) * Id B (f a) b ;
Injective {A B : U l} (f : A -> B) : U l = (a a' : A) -> Id B (f a) (f a') -> Id A a a' ;

module Bij (A B : U l) (sB : isSet B) (f : A -> B) (inj : Injective f)
  (surj : (b : B) -> Tr.Trunc[Fibre f b].carrier) {
  fibre-prop (b : B) : isProp (Fibre f b) = \ w w' ->
    Sigma-eq A (\ a -> Id B (f a) b) w.1 w'.1 w.2 w'.2 (inj w.1 w'.1 (transH w.2 (symH w'.2))) (sB (f w'.1) b) ;
  point (b : B) : Fibre f b = TC.rec (Fibre f b) @l (Fibre f b) (fibre-prop b) (\ w -> w) (surj b) ;
  equiv : isEquiv A B f = struct {
    sec = \ b -> (point b).1 ;
    sec-eq = \ b -> (point b).2 ;
    ret = \ b -> (point b).1 ;
    ret-eq = \ a -> inj (point (f a)).1 a (point (f a)).2 } ;
} ;

-- the inverse of an equivalence
inverse (A B : U l) (e : Equiv A B) : Equiv B A =
  (e.2.sec, qinv B A e.2.sec e.1 (sec-ret A B e.1 e.2) e.2.sec-eq) ;

-- logically equivalent propositions are equivalent
prop-equiv (A B : U l) (pA : isProp A) (pB : isProp B) (f : A -> B) (g : B -> A) : Equiv A B =
  (f, qinv A B f g (\ b -> pB (f (g b)) b) (\ a -> pA (g (f a)) a)) ;
