-- "Ȟ^1 (S, T, G) = 0" depends only on (S, T) up to equivalence, and the
-- fibres of equivalent maps are equivalent (used for SSD Lemma 5.9).
--
--  - Fibrewise (fibrewise): with phi x : T x = T' x, a cocycle b on T gives
--    the cocycle b' x u' v' = b x (phi^-1 u') (phi^-1 v') on T'; if
--    b' = d0 a' then b = d0 (a' o phi), since phi^-1 (phi u) = u.
--  - Base (base): along e : S = S', by induction on equivalences (eqind);
--    for the identity there is nothing to do.
--  - T x is the fibre of the first projection over x (fibre-fst: J).
--  - A commuting square of equivalences eX, eY between f and f' (sets)
--    gives fib f y = fib f' (eY y) (square-fibre): (w, h) |-> (eX w, ..) is
--    injective (eX is) and onto (w = eX^-1 a lies over y since eY is
--    injective), into a set.
--  - "Ȟ^1 = 0" is a proposition (h1-prop).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Torsor[l] ; open Bijection[l] ; open CechComplex[l] ;
module Tr = Truncation[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module Eq = Equivalences[l] ;

h1-prop (S : U l) (T : S -> U l) (G : Ab) : isProp (Cech[S, T, \ x -> G].H1Zero) =
  FL.isProp-Pi (Cech[S, T, \ x -> G].C1) (\ b -> Cech[S, T, \ x -> G].Cocycle b -> Cech[S, T, \ x -> G].Coboundary b) (\ b ->
    FL.isProp-Pi (Cech[S, T, \ x -> G].Cocycle b) (\ c -> Cech[S, T, \ x -> G].Coboundary b) (\ c ->
      Tr.Trunc[(a : Cech[S, T, \ x -> G].C0) * Cech[S, T, \ x -> G].Bounds b a].proposition)) ;

module Fibrewise (S : U l) (T T' : S -> U l) (G : Ab) (phi : (x : S) -> Equiv (T x) (T' x))
  (h : Cech[S, T', \ x -> G].H1Zero) {
  module C = Cech[S, T, \ x -> G] ;
  module C' = Cech[S, T', \ x -> G] ;
  back (x : S) (u : T' x) : T x = (phi x).2.sec u ;
  back-to (x : S) (u : T x) : Id (T x) (back x ((phi x).1 u)) u = sec-ret (T x) (T' x) (phi x).1 (phi x).2 u ;
  moved (b : C.C1) : C'.C1 = \ x u v -> b x (back x u) (back x v) ;
  module Given (b : C.C1) (cb : C.Cocycle b) (w : (a : C'.C0) * C'.Bounds (moved b) a) {
    a : C.C0 = \ x u -> w.1 x ((phi x).1 u) ;
    bounds : C.Bounds b a = \ x u v -> calc G.A {
      b x u v =< symH (transH (apH (\ s -> b x s (back x ((phi x).1 v))) (back-to x u)) (apH (b x u) (back-to x v))) >
      moved b x ((phi x).1 u) ((phi x).1 v)
        =< w.2 x ((phi x).1 u) ((phi x).1 v) > C.d0 a x u v } ;
  } ;
  result : C.H1Zero = \ b cb ->
    TruncationCombinators[l].map ((a : C'.C0) * C'.Bounds (moved b) a) ((a : C.C0) * C.Bounds b a)
      (\ w -> (Given[b, cb, w].a, Given[b, cb, w].bounds))
      (h (moved b) (\ x u v w -> cb x (back x u) (back x v) (back x w))) ;
} ;

base (S : U l) (G : Ab) (S' : U l) (e : Equiv S S') : (T' : S' -> U l) -> Cech[S', T', \ x -> G].H1Zero ->
  Cech[S, \ x -> T' (e.1 x), \ x -> G].H1Zero =
  Axioms[l].UnivalenceLemmas[univ @l].eqind S (\ S1 e1 -> (T1 : S1 -> U l) -> Cech[S1, T1, \ x -> G].H1Zero -> Cech[S, \ x -> T1 (e1.1 x), \ x -> G].H1Zero)
    (\ T1 h -> h) S' e ;

-- T x is the fibre of the first projection
fst (S : U l) (T : S -> U l) (w : (y : S) * T y) : S = w.1 ;
fibre-fst (S : U l) (T : S -> U l) (x : S) : Equiv (T x) (Fibre (fst S T) x) =
  (\ t -> ((x, t), refl x), qinv (T x) (Fibre (fst S T) x) (\ t -> ((x, t), refl x))
    (\ z -> subst S T z.1.1 x z.2 z.1.2)
    (\ z -> idJR S x (\ y h -> (t : T y) -> Id (Fibre (fst S T) x)
        ((x, subst S T y x h t), refl x) ((y, t), h)) (\ t -> refl ((x, t), refl x)) z.1.1 z.2 z.1.2)
    (\ t -> refl t)) ;

-- equivalent maps have equivalent fibres
module SquareFibre (X Y X' Y' : U l) (sY : isSet Y) (sX' : isSet X') (sY' : isSet Y') (f : X -> Y) (f' : X' -> Y')
  (eX : Equiv X X') (eY : Equiv Y Y') (over : (w : X) -> Id Y' (eY.1 (f w)) (f' (eX.1 w))) (y : Y) {
  to (z : Fibre f y) : Fibre f' (eY.1 y) = (eX.1 z.1, transH (symH (over z.1)) (apH eY.1 z.2)) ;
  fibre-set : isSet (Fibre f' (eY.1 y)) =
    isSet-Sigma X' (\ a -> Id Y' (f' a) (eY.1 y)) sX' (\ a -> prop-to-set (Id Y' (f' a) (eY.1 y)) (sY' (f' a) (eY.1 y))) ;
  injective : Injective to = \ z z' q ->
    Sigma-eq X (\ w -> Id Y (f w) y) z.1 z'.1 z.2 z'.2
      (Eq.injective X X' eX.1 eX.2 z.1 z'.1 (apH (\ v -> v.1) q)) (sY (f z'.1) y) ;
  module Onto (v : Fibre f' (eY.1 y)) {
    w : X = eX.2.sec v.1 ;
    lies : Id Y (f w) y = Eq.injective Y Y' eY.1 eY.2 (f w) y
      (transH (over w) (transH (apH f' (eX.2.sec-eq v.1)) v.2)) ;
    hit : Id (Fibre f' (eY.1 y)) (to (w, lies)) v =
      Sigma-eq X' (\ a -> Id Y' (f' a) (eY.1 y)) (eX.1 w) v.1 (to (w, lies)).2 v.2 (eX.2.sec-eq v.1) (sY' (f' v.1) (eY.1 y)) ;
  } ;
  equiv : Equiv (Fibre f y) (Fibre f' (eY.1 y)) = (to, Bij[Fibre f y, Fibre f' (eY.1 y), fibre-set, to, injective,
    \ v -> Tr.Trunc[Fibre to v].inc ((Onto[v].w, Onto[v].lies), Onto[v].hit)].equiv) ;
} ;
