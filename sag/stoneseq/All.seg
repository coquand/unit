-- Sequential colimits and limits, dependent choice, cohomology base for
-- synthetic Stone duality (SSD.pdf; ../stone/DESIGN.md, HANDOFF-B.md): the
-- shared foundation up to Quotient, then the stoneseq files.
import Base ; import Prelude ; import Paths ; import Axioms ; import FunExtUA ;
import Replacement ; import Ring ;
module Theory
 (univ : [l] Axioms[l].Univalence)
 (images : [l] [k] Replacement[l,k].Images)
 (surjections : [l] [k] [j] (Replacement[l,k].Surjectivity (images @l @k)) @j) {
 fe : [l] Axioms[l].FunExt = <l> FunExtUA[l].FE[univ @l].fe ;
 propUA : [l] Axioms[l].PropUnivalence = <l> Axioms[l].UnivalenceLemmas[univ @l].prop-univ ;
 import Truncation ; import TruncationCombinators ; import FinChoice ; import Quotient ; import RingHom ; import Logic ; import Equivalences ; import Torsor ; import TorsorCocycles ; import TorsorId ; import Groupoid ; import Gerbe ; import TrivialGerbe ;
 -- SSD Axiom 4 (dependent choice), as a type
 import DependentChoice ; import CountableChoice ;
 -- sequential colimits (SSD §2)
 import NatArith ; import Bijection ; import SeqColim ; import Finite ; import SeqSub ; import SeqFinite ; import SeqMaps ; import ODisc ; import Lemma23 ; import Lemma24 ; import SeqSigma ; import SeqProp ; import SeqGrid ; import Lemma26 ; import FiniteClosure ; import Lemma27 ; import Cor25 ;
 -- cohomology base (SSD §5.1)
 import Integers ; import CechComplex ; import ExactColim ; import SeqLim ; import Lemma59 ; import FibrePairs ; import FibreSeq ;
 -- worker A (stone/, stable): Boolean algebras, Stone spaces, SSD 1-4
 import NatOrder ; import ConstantMap ; import FiniteFacts ;
 import BooleanRing ; import FreeFinite ; import FreeCountable ; import QuotientBA ; import Presented ;
 import Examples ; import TwoPresented ; import Product ; import BinfFacts ; import NoRetraction ; import BoolSeq ;
 import StoneAxioms ; import StoneDuality ; import Omniscience ; import ProductPresented ; import LLPO ; import OpenClosed ; import Remark110 ;
 import Lemma28 ; import CantorStages ; import Profinite ; import Blocks ; import Tabulate ; import FinBool ; import LimCode ; import Lemma32 ; import FiniteCode ; import Cor37 ; import DecFree ; import StoneClosed ; import ImageClosed ; import Thm311 ; import Lemma316 ; import Pairing ; import Spread ; import Remark34 ;
 import Compact ; import StoneProduct ; import CHaus ; import Sigma411 ; import PowerSet ; import Lemma412 ; import Components ; import Thm418 ;
 -- SSD 5.2 (B3)
 import Lemma59Fibres ; import CechTransfer ; import Lemma59Stone ; import Lemma510 ; import Cor511 ;
 -- SSD 5.3 (B4)
 import Thm516 ; import Thm516Set ;
} ;
