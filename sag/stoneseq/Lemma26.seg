-- SSD Lemma 2.6: overtly discrete types are stable under sequential
-- colimits.
--
-- Proof.  Let X 0 -> X 1 -> .. with every X n overtly discrete.  By
-- dependent choice (relational form) and Lemma 2.3 with the source
-- presentation kept (lemma23-rel), there are presentations P n of X n and
-- maps of sequences H n : P n -> P (suc n) inducing X n -> X (suc n).  This
-- is a grid; colim X is the colimit of the colimits of the P n (levelwise
-- equivalences), which is the colimit of the diagonal (Grid), a sequence of
-- finite sets.
--
-- Dependent choice is used at level l+ (presentations are large).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open SeqColim[l] ; open SeqMaps[l] ; open Bijection[l] ;
open ODisc[l] ; open Lemma23[l] ; open SeqGrid[l] ; open CountableChoice[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;

module Lemma26 (cc : CC) (dc : DependentChoice[l+].DC) (X : Seq) (oX : (n : Nat) -> isODisc (X.A n)) {
  D (n : Nat) : U l+ = Pres[X.A n] ;
  R (n : Nat) (P : D n) (P' : D (suc n)) : U l+ = (H : SeqMap[P.seq, P'.seq]) *
    ((x : X.A n) -> Id (Colim[P'.seq].colim) (P'.equiv.1 (X.f n x)) (Induced[P.seq, P'.seq, H].map (P.equiv.1 x))) ;
  total (n : Nat) (P : D n) : Truncation[l+].Trunc[(P' : D (suc n)) * R n P P'].carrier =
    TruncationCombinators[l+].map RelPres[X.A n, X.A (suc n), X.f n, P] ((P' : D (suc n)) * R n P P')
      (\ r -> (r.target, (r.H, r.square))) (lemma23-rel cc (X.A n) (X.A (suc n)) P (oX (suc n)) (X.f n)) ;
  module DCR = CountableChoice[l+].Relational[dc, D, R, oX zero, total] ;

  module Built (path : DCR.Path) {
    P (n : Nat) : D n = path.1 n ;
    Sg (n : Nat) : Seq = (P n).seq ;
    Hg (n : Nat) : SeqMap[Sg n, Sg (suc n)] = (path.2 n).1 ;
    module G = Grid[Sg, Hg] ;
    -- colim X = colim outer, levelwise by the equivalences of the presentations
    -- the square of the chosen path: H n induces X n -> X (suc n)
    square (n : Nat) (x : X.A n)
      : Id (Colim[Sg (suc n)].colim) ((P (suc n)).equiv.1 (X.f n x)) (Induced[Sg n, Sg (suc n), Hg n].map ((P n).equiv.1 x)) =
      (path.2 n).2 x ;
    toOuter : SeqMap[X, G.outer] = new SeqMap[X, G.outer, \ n x -> (P n).equiv.1 x, \ n x -> symH (square n x)] ;
    module IX = Induced[X, G.outer, toOuter] ;
    injective : Injective IX.map = IX.Inj[\ n -> Equivalences[l].injective (X.A n) (Colim[Sg n].colim) (P n).equiv.1 (P n).equiv.2].injective ;
    surjective (c : Colim[G.outer].colim) : Tr.Trunc[Fibre IX.map c].carrier =
      IX.Surj[\ n y -> Tr.Trunc[Fibre ((P n).equiv.1) y].inc ((P n).equiv.2.sec y, (P n).equiv.2.sec-eq y)].surjective c ;
    to-outer : Equiv (Colim[X].colim) (Colim[G.outer].colim) =
      (IX.map, Bij[Colim[X].colim, Colim[G.outer].colim, Colim[G.outer].set, IX.map, injective, surjective].equiv) ;
    pres : Pres[Colim[X].colim] = new Pres[Colim[X].colim, G.diag, \ n -> (P n).finite n,
      Equivalences[l].compose (Colim[X].colim) (Colim[G.outer].colim) (Colim[G.diag].colim) to-outer
        (inverse (Colim[G.diag].colim) (Colim[G.outer].colim) G.equiv)] ;
  } ;
  theorem : isODisc (Colim[X].colim) =
    TruncationCombinators[l+].map DCR.Path (Pres[Colim[X].colim]) (\ p -> Built[p].pres) DCR.result ;
} ;
