-- Čech complexes (SSD Def. 5.3, 5.4) and the three general lemmas 5.5-5.7.
--
-- For S a type, T x types and A x abelian groups (x : S):
--   C0 = (x : S) -> A x ^ T x,  C1 = .. ^ (T x)^2,  C2 = .. ^ (T x)^3,
--   d0 a x u v = a x v - a x u,  d1 b x u v w = b x v w - b x u w + b x u v.
-- A cocycle is b with b x u v + b x v w = b x u w (that is, d1 b = 0), a
-- coboundary is merely some d0 a, and "H^1(S, T, A) = 0" is: every cocycle
-- is a coboundary (exactness at C1; SSD after Def. 5.4).
--
-- Lemma 5.5: with a section t, a = (x u |-> b x (t x) u) has d0 a = b.
-- Lemma 5.6: for the groups A x ^ T x, a x u t = b x t u t.
-- Lemma 5.7 (BA = A-torsors, pn/Torsor.seg): given torsors alpha x with
-- points beta x u (u : T x), g x u v = beta x v - beta x u is a cocycle;
-- from g = d0 f the points f x u . beta x u do not depend on u, so give a
-- point of alpha x (|| T x ||), and alpha x is trivial.  (The paper's
-- beta x u : alpha x = * are the points of alpha x.)
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Torsor[l] ; open TorsorCocycles[l] ; open TorsorId[l] ; open TrivialGerbe[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module T1 = Truncation[l+] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ; module FL1 = Axioms[l+].FunExtLemmas[fe @(l+)] ;

-- a + (b - a) = b
cancel (G : Ab) (a b : G.A) : Id G.A (G.add a (G.add b (G.inv a))) b = calc G.A {
  G.add a (G.add b (G.inv a)) =< G.comm a (G.add b (G.inv a)) > G.add (G.add b (G.inv a)) a
    =< G.assoc b (G.inv a) a > G.add b (G.add (G.inv a) a)
    =< apH (G.add b) (AbL[G].invl a) > G.add b G.o
    =< G.unitr b > b } ;

-- the abelian group of functions X -> A
fun-ab (X : U l) (G : Ab) : Ab = new Ab[X -> G.A, FL.isSet-Pi X (\ t -> G.A) (\ t -> G.setA), \ t -> G.o,
  \ f g t -> G.add (f t) (g t), \ f t -> G.inv (f t),
  \ f g h -> FL.funext X (\ t -> G.A) _ _ (\ t -> G.assoc (f t) (g t) (h t)),
  \ f g -> FL.funext X (\ t -> G.A) _ _ (\ t -> G.comm (f t) (g t)),
  \ f -> FL.funext X (\ t -> G.A) _ _ (\ t -> G.unitr (f t)),
  \ f -> FL.funext X (\ t -> G.A) _ _ (\ t -> G.invr (f t))] ;

module Cech (S : U l) (T : S -> U l) (A : S -> Ab) {
  C0 : U l = (x : S) -> T x -> (A x).A ;
  C1 : U l = (x : S) -> T x -> T x -> (A x).A ;
  C2 : U l = (x : S) -> T x -> T x -> T x -> (A x).A ;
  d0 (a : C0) : C1 = \ x u v -> (A x).add (a x v) ((A x).inv (a x u)) ;
  d1 (b : C1) : C2 = \ x u v w -> (A x).add ((A x).add (b x v w) ((A x).inv (b x u w))) (b x u v) ;
  Cocycle (b : C1) : U l = (x : S) (u v w : T x) -> Id (A x).A ((A x).add (b x u v) (b x v w)) (b x u w) ;
  Bounds (b : C1) (a : C0) : U l = (x : S) (u v : T x) -> Id (A x).A (b x u v) (d0 a x u v) ;
  Coboundary (b : C1) : U l = Tr.Trunc[(a : C0) * Bounds b a].carrier ;
  -- H^1(S, T, A) = 0
  H1Zero : U l = (b : C1) -> Cocycle b -> Coboundary b ;
  -- H^0 = ker d0
  H0 : U l = (a : C0) * ((x : S) (u v : T x) -> Id (A x).A (d0 a x u v) (A x).o) ;
  -- a cocycle is in ker d1
  cocycle-d1 (b : C1) (c : Cocycle b) (x : S) (u v w : T x) : Id (A x).A (d1 b x u v w) (A x).o = calc (A x).A {
    (A x).add ((A x).add (b x v w) ((A x).inv (b x u w))) (b x u v)
      =< (A x).comm ((A x).add (b x v w) ((A x).inv (b x u w))) (b x u v) >
    (A x).add (b x u v) ((A x).add (b x v w) ((A x).inv (b x u w)))
      =< symH ((A x).assoc (b x u v) (b x v w) ((A x).inv (b x u w))) >
    (A x).add ((A x).add (b x u v) (b x v w)) ((A x).inv (b x u w))
      =< apH (\ y -> (A x).add y ((A x).inv (b x u w))) (c x u v w) > (A x).add (b x u w) ((A x).inv (b x u w))
      =< (A x).invr (b x u w) > (A x).o } ;
  -- and conversely
  d1-cocycle (b : C1) (z : (x : S) (u v w : T x) -> Id (A x).A (d1 b x u v w) (A x).o) : Cocycle b = \ x u v w ->
    calc (A x).A {
      (A x).add (b x u v) (b x v w)
        =< apH ((A x).add (b x u v)) (symH (transH ((A x).assoc (b x v w) ((A x).inv (b x u w)) (b x u w))
             (transH (apH ((A x).add (b x v w)) (AbL[A x].invl (b x u w))) ((A x).unitr (b x v w))))) >
      (A x).add (b x u v) ((A x).add ((A x).add (b x v w) ((A x).inv (b x u w))) (b x u w))
        =< symH ((A x).assoc (b x u v) ((A x).add (b x v w) ((A x).inv (b x u w))) (b x u w)) >
      (A x).add ((A x).add (b x u v) ((A x).add (b x v w) ((A x).inv (b x u w)))) (b x u w)
        =< apH (\ y -> (A x).add y (b x u w)) (transH ((A x).comm (b x u v) ((A x).add (b x v w) ((A x).inv (b x u w)))) (z x u v w)) >
      (A x).add (A x).o (b x u w)
        =< AbL[A x].unitl (b x u w) > b x u w } ;
} ;

-- H^1(X, A) = 0 (SSD Remark 5.2, BA = A-torsors): every family of
-- A x-torsors over X is merely trivial
CohZero (X : U l) (A : X -> Ab) : U l+ = (alpha : (x : X) -> TorId[A x].Tor) ->
  T1.Trunc[(x : X) -> Id (TorId[A x].Tor) (alpha x) (TrivG[A x].Atriv)].carrier ;

-- SSD Lemma 5.5: a section gives H^1 = 0
lemma55 (S : U l) (T : S -> U l) (A : S -> Ab) (t : (x : S) -> T x) : Cech[S,T,A].H1Zero = \ b c ->
  Tr.Trunc[(a : Cech[S,T,A].C0) * Cech[S,T,A].Bounds b a].inc (\ x u -> b x (t x) u, \ x u v ->
    AbL[A x].solve (b x u v) (b x (t x) u) (b x (t x) v)
      (transH ((A x).comm (b x u v) (b x (t x) u)) (c x (t x) u v))) ;

-- SSD Lemma 5.6: H^1 (S, T, x |-> A x ^ T x) = 0
lemma56 (S : U l) (T : S -> U l) (A : S -> Ab) : Cech[S,T,\ x -> fun-ab (T x) (A x)].H1Zero = \ b c ->
  Tr.Trunc[(a : Cech[S,T,\ x -> fun-ab (T x) (A x)].C0) * Cech[S,T,\ x -> fun-ab (T x) (A x)].Bounds b a].inc
    (\ x u t -> b x t u t, \ x u v -> FL.funext (T x) (\ t -> (A x).A) (b x u v)
      (\ t -> (A x).add (b x t v t) ((A x).inv (b x t u t))) (\ t ->
        AbL[A x].solve (b x u v t) (b x t u t) (b x t v t)
          (transH ((A x).comm (b x u v t) (b x t u t))
            (happly (T x) (\ s -> (A x).A) (\ s -> (A x).add (b x t u s) (b x u v s)) (b x t v) (c x t u v) t)))) ;

-- a weakly constant map into a set factors through the truncation
-- (local copy of stone/ConstantMap.seg, to be replaced once A announces it)
module Constant (X Y : U l) (sY : isSet Y) (h : X -> Y) (wc : (u v : X) -> Id Y (h u) (h v)) {
  Candidate : U l = (y : Y) * Tr.Trunc[(u : X) * Id Y (h u) y].carrier ;
  candidate-prop : isProp Candidate = \ p q ->
    Sigma-eq Y (\ y -> Tr.Trunc[(u : X) * Id Y (h u) y].carrier) p.1 q.1 p.2 q.2
      (TC.rec ((u : X) * Id Y (h u) p.1) @l (Id Y p.1 q.1) (sY p.1 q.1) (\ w ->
        TC.rec ((u : X) * Id Y (h u) q.1) @l (Id Y p.1 q.1) (sY p.1 q.1) (\ w' ->
          transH (symH w.2) (transH (wc w.1 w'.1) w'.2)) q.2) p.2)
      (Tr.Trunc[(u : X) * Id Y (h u) q.1].proposition) ;
  value (t : Tr.Trunc[X].carrier) : Y =
    (TC.rec X @l Candidate candidate-prop (\ u -> (h u, Tr.Trunc[(u' : X) * Id Y (h u') (h u)].inc (u, refl (h u)))) t).1 ;
} ;

-- SSD Lemma 5.7
module Lemma57 (S : U l) (T : S -> U l) (hT : (x : S) -> Tr.Trunc[T x].carrier) (A : S -> Ab)
  (h1 : Cech[S,T,A].H1Zero) (alpha : (x : S) -> TorId[A x].Tor) (beta : (x : S) -> T x -> (alpha x).1) {
  module Ch = Cech[S,T,A] ;
  -- g x u v = beta x v - beta x u  (the a with  a . beta x v = beta x u)
  g : Ch.C1 = \ x u v -> Tors[A x, T x, hT x].PhiM[((alpha x).1, ((alpha x).2, beta x))].c u v ;
  cocycle : Ch.Cocycle g = \ x u v w -> Tors[A x, T x, hT x].PhiM[((alpha x).1, ((alpha x).2, beta x))].coc u v w ;
  module Given (f : Ch.C0) (e : Ch.Bounds g f) {
    act (x : S) (a : (A x).A) (y : (alpha x).1) : (alpha x).1 = (alpha x).2.1 a y ;
    moved (x : S) (u : T x) : (alpha x).1 = act x (f x u) (beta x u) ;
    const (x : S) (u v : T x) : Id (alpha x).1 (moved x u) (moved x v) = calc (alpha x).1 {
      act x (f x u) (beta x u)
        =< apH (act x (f x u)) (symH (TorBase[A x].D[(alpha x).1, (alpha x).2].dact (beta x v) (beta x u))) >
      act x (f x u) (act x (g x u v) (beta x v))
        =< symH ((alpha x).2.2.2.1 (f x u) (g x u v) (beta x v)) > act x ((A x).add (f x u) (g x u v)) (beta x v)
        =< apH (\ a -> act x a (beta x v)) (transH (apH ((A x).add (f x u)) (e x u v)) (cancel (A x) (f x u) (f x v))) >
      act x (f x v) (beta x v) } ;
    point (x : S) : (alpha x).1 = Constant[T x, (alpha x).1, (alpha x).2.2.1, moved x, const x].value (hT x) ;
    trivial (x : S) : Id (TorId[A x].Tor) (alpha x) (TrivG[A x].Atriv) =
      Prelude[l+].sym (TorId[A x].Tor) (TrivG[A x].Atriv) (alpha x)
        (TorId[A x].decode (TrivG[A x].Atriv) (alpha x) (TrivG[A x].pthom (alpha x) (point x))) ;
  } ;
  -- alpha is merely trivial
  result : T1.Trunc[(x : S) -> Id (TorId[A x].Tor) (alpha x) (TrivG[A x].Atriv)].carrier =
    TC.rec ((f : Ch.C0) * Ch.Bounds g f) @(l+) (T1.Trunc[(x : S) -> Id (TorId[A x].Tor) (alpha x) (TrivG[A x].Atriv)].carrier)
      (T1.Trunc[(x : S) -> Id (TorId[A x].Tor) (alpha x) (TrivG[A x].Atriv)].proposition)
      (\ w -> T1.Trunc[(x : S) -> Id (TorId[A x].Tor) (alpha x) (TrivG[A x].Atriv)].inc (Given[w.1, w.2].trivial)) (h1 g cocycle) ;
} ;
