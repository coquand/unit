-- Sequential limits of sets (SSD §3.1: Stone spaces are sequential limits of
-- finite sets): an inverse sequence E 0 <- E 1 <- .. has as limit the
-- compatible sequences (DependentChoice.Lim).
--   Two points of a limit of sets are equal when their components are.
--   A cone gives a map into the limit; a map of inverse sequences gives a
--   map of limits.
--   A family over an inverse sequence (T n over E n, with maps
--   T (suc n) x -> T n (p x)) has a total inverse sequence (pairs) and, over
--   each point x of the limit, a fibre inverse sequence T n (x n).
--   A cone over a family is a family over the limit with compatible maps
--   to the T n (x n); the limits of the fibres form one.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open DependentChoice[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;

record InvSeq {
  E : Nat -> U l ;
  p : (n : Nat) -> E (suc n) -> E n ;
} ;

module Limit (S : InvSeq) {
  lim : U l = Lim S.E S.p ;
  proj (n : Nat) (x : lim) : S.E n = x.1 n ;
  compat (n : Nat) (x : lim) : Id (S.E n) (S.p n (proj (suc n) x)) (proj n x) = x.2 n ;
  module Sets (sets : (n : Nat) -> isSet (S.E n)) {
    compat-prop (x : (n : Nat) -> S.E n) : isProp ((n : Nat) -> Id (S.E n) (S.p n (x (suc n))) (x n)) =
      FL.isProp-Pi Nat (\ n -> Id (S.E n) (S.p n (x (suc n))) (x n)) (\ n -> sets n (S.p n (x (suc n))) (x n)) ;
    set : isSet lim = isSet-Sigma ((n : Nat) -> S.E n) (\ x -> (n : Nat) -> Id (S.E n) (S.p n (x (suc n))) (x n))
      (FL.isSet-Pi Nat S.E sets) (\ x -> prop-to-set ((n : Nat) -> Id (S.E n) (S.p n (x (suc n))) (x n)) (compat-prop x)) ;
    lim-eq (x y : lim) (h : (n : Nat) -> Id (S.E n) (proj n x) (proj n y)) : Id lim x y =
      Sigma-eq ((n : Nat) -> S.E n) (\ z -> (n : Nat) -> Id (S.E n) (S.p n (z (suc n))) (z n)) x.1 y.1 x.2 y.2
        (FL.funext Nat S.E x.1 y.1 h) (compat-prop y.1) ;
  } ;
  -- a cone over the sequence gives a map into the limit
  cone (X : U l) (g : (n : Nat) -> X -> S.E n) (c : (n : Nat) (x : X) -> Id (S.E n) (S.p n (g (suc n) x)) (g n x))
    (x : X) : lim = (\ n -> g n x, \ n -> c n x) ;
} ;

record InvMap (S T : InvSeq) {
  h : (n : Nat) -> S.E n -> T.E n ;
  c : (n : Nat) (x : S.E (suc n)) -> Id (T.E n) (T.p n (h (suc n) x)) (h n (S.p n x)) ;
} ;
lim-map (S T : InvSeq) (H : InvMap[S,T]) (x : Limit[S].lim) : Limit[T].lim =
  (\ n -> H.h n (x.1 n), \ n -> transH (H.c n (x.1 (suc n))) (apH (H.h n) (x.2 n))) ;

-- families over an inverse sequence
record Family (S : InvSeq) {
  T : (n : Nat) -> S.E n -> U l ;
  q : (n : Nat) (x : S.E (suc n)) -> T (suc n) x -> T n (S.p n x) ;
} ;
-- a cone over a family: a family T over the limit with compatible maps to
-- the stages (the limit of the fibres is one, Over.cone)
record Cone (S : InvSeq) (F : Family[S]) {
  T : Limit[S].lim -> U l ;
  pr : (k : Nat) (x : Limit[S].lim) -> T x -> F.T k (x.1 k) ;
  pc : (k : Nat) (x : Limit[S].lim) (u : T x) -> Id (F.T k (x.1 k))
    (subst (S.E k) (F.T k) (S.p k (x.1 (suc k))) (x.1 k) (x.2 k) (F.q k (x.1 (suc k)) (pr (suc k) x u))) (pr k x u) ;
} ;
module Over (S : InvSeq) (F : Family[S]) {
  -- the pairs
  total : InvSeq = new InvSeq[\ n -> (x : S.E n) * F.T n x, \ n w -> (S.p n w.1, F.q n w.1 w.2)] ;
  -- the fibre over a point of the limit
  fibre (x : Limit[S].lim) : InvSeq = new InvSeq[\ n -> F.T n (x.1 n),
    \ n t -> subst (S.E n) (F.T n) (S.p n (x.1 (suc n))) (x.1 n) (x.2 n) (F.q n (x.1 (suc n)) t)] ;
  -- the family over the limit
  T-lim (x : Limit[S].lim) : U l = Limit[fibre x].lim ;
  cone : Cone[S, F] = new Cone[S, F, T-lim, \ k x u -> u.1 k, \ k x u -> u.2 k] ;
} ;
