-- SSD Lemma 2.3, for presentations: let S, T be sequences with every S n
-- finite and f : colim S -> colim T.  Then f is, up to a cofinal reindexing
-- Sub of T (SeqSub.seg), the colimit of a map of sequences S -> Sub.
--
-- Proof.  (1) For each n, f . inc n : S n -> colim T merely factors through
-- a stage m n, by h n (SeqFinite.lift); by countable choice for all n at once.
-- (2) h (suc n) . f n and h n have the same images in colim T (glue), so
-- they merely meet at one stage K n (SeqFinite.agree); countable choice again.
-- (3) Reindex T by stage 0 = m 0 and gap n = K n + m (suc n), so that
-- m n <= stage n and K n <= stage (suc n); let H n be h n raised to stage n.
-- Then shift (H n x) and H (suc n) (f n x) are raises of two points that
-- have met at K n <= stage (suc n), hence equal (meet-up); so H is a map of
-- sequences, and Phi (colim H) = f on every inc n x, hence everywhere.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open NatArith[l] ; open SeqColim[l] ; open Finite[l] ;
open SeqSub[l] ; open SeqFinite[l] ; open SeqMaps[l] ; open CountableChoice[l] ; open Bijection[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;

module Lemma23 (cc : CC) (S T : Seq) (finS : (n : Nat) -> isFinite (S.A n))
  (f : Colim[S].colim -> Colim[T].colim) {
  module CS = Colim[S] ; module CT = Colim[T] ; module OT = Over[T] ;

  -- (1) a stage for each n
  Lift (n : Nat) : U l = (N : Nat) * OT.At (S.A n) (\ x -> f (CS.inc n x)) N ;
  module Lifted (L : (n : Nat) -> Lift n) {
    m (n : Nat) : Nat = (L n).1 ;
    h (n : Nat) (x : S.A n) : T.A (m n) = ((L n).2 x).1 ;
    corr (n : Nat) (x : S.A n) : Id CT.colim (CT.inc (m n) (h n x)) (f (CS.inc n x)) = ((L n).2 x).2 ;

    -- (2) consecutive lifts meet
    same (n : Nat) (x : S.A n) : Id CT.colim (CT.inc (m (suc n)) (h (suc n) (S.f n x))) (CT.inc (m n) (h n x)) =
      transH (corr (suc n) (S.f n x)) (transH (apH f (symH (CS.glue n x))) (symH (corr n x))) ;
    Agree (n : Nat) : U l = (K : Nat) * ((x : S.A n) -> CT.MeetAt[K, (m (suc n), h (suc n) (S.f n x)), (m n, h n x)]) ;
    agree (n : Nat) : Tr.Trunc[Agree n].carrier =
      OT.agree (S.A n) (finS n) (m (suc n)) (m n) (\ x -> h (suc n) (S.f n x)) (h n) (same n) ;

    -- (3) the reindexing
    module Agreed (A : (n : Nat) -> Agree n) {
      K (n : Nat) : Nat = (A n).1 ;
      gap (n : Nat) : Nat = plus (K n) (m (suc n)) ;
      module SB = Sub[T, m zero, gap] ;
      le-gap (n : Nat) : Le (gap n) (SB.stage (suc n)) =
        le-trans (gap n) (suc (gap n)) (SB.stage (suc n)) (suc zero, refl (suc (gap n))) (le-sum-l (SB.stage n) (suc (gap n))) ;
      le-K (n : Nat) : Le (K n) (SB.stage (suc n)) =
        le-trans (K n) (gap n) (SB.stage (suc n)) (le-sum-l (m (suc n)) (K n)) (le-gap n) ;
      le-m : (n : Nat) -> Le (m n) (SB.stage n) = split {
        zero -> le-refl (m zero) ;
        suc n -> le-trans (m (suc n)) (gap n) (SB.stage (suc n)) (le-sum-r (m (suc n)) (K n)) (le-gap n) } ;
      H (n : Nat) (x : S.A n) : T.A (SB.stage n) = CT.raise (m n) (SB.stage n) (le-m n) (h n x) ;
      compat (n : Nat) (x : S.A n)
        : Id (T.A (SB.stage (suc n))) (CT.shift (suc (gap n)) (SB.stage n) (H n x)) (H (suc n) (S.f n x)) =
        CT.tot-stage (SB.stage (suc n)) (CT.shift (suc (gap n)) (SB.stage n) (H n x)) (H (suc n) (S.f n x)) (calc CT.Tot {
          CT.iter (suc (gap n)) (SB.stage n, H n x)
            =< apH (CT.iter (suc (gap n))) (symH (CT.raise-tot (m n) (SB.stage n) (le-m n) (h n x))) >
          CT.iter (suc (gap n)) (CT.iter (le-m n).1 (m n, h n x))
            =< symH (CT.iter-plus (suc (gap n)) (le-m n).1 (m n, h n x)) >
          CT.iter (plus (suc (gap n)) (le-m n).1) (m n, h n x)
            =< symH (CT.meet-up (K n) (SB.stage (suc n)) (m (suc n), h (suc n) (S.f n x)) (m n, h n x) ((A n).2 x) (le-K n)
                 (le-m (suc n)).1 (plus (suc (gap n)) (le-m n).1) (le-m (suc n)).2
                 (transH (plus-assoc (suc (gap n)) (le-m n).1 (m n)) (apH (plus (suc (gap n))) (le-m n).2))) >
          CT.iter (le-m (suc n)).1 (m (suc n), h (suc n) (S.f n x))
            =< CT.raise-tot (m (suc n)) (SB.stage (suc n)) (le-m (suc n)) (h (suc n) (S.f n x)) >
          (SB.stage (suc n), H (suc n) (S.f n x)) }) ;
      map : SeqMap[S, SB.seq] = new SeqMap[S, SB.seq, H, compat] ;
      module I = Induced[S, SB.seq, map] ;
      factor (c : CS.colim) : Id CT.colim (SB.Phi (I.map c)) (f c) =
        CS.ext CT.colim CT.set (\ c1 -> SB.Phi (I.map c1)) f (\ n x -> calc CT.colim {
          SB.Phi (I.map (CS.inc n x)) =< apH SB.Phi (I.map-inc n x) > SB.Phi (SB.CS.inc n (H n x))
            =< SB.Phi-inc n (H n x) > CT.inc (SB.stage n) (H n x)
            =< CT.inc-raise (m n) (SB.stage n) (le-m n) (h n x) > CT.inc (m n) (h n x)
            =< corr n x > f (CS.inc n x) }) c ;
    } ;
  } ;

  Factorisation : U l = (M0 : Nat) * (gap : Nat -> Nat) * (H : SeqMap[S, Sub[T,M0,gap].seq]) *
    ((c : CS.colim) -> Id CT.colim (Sub[T,M0,gap].Phi (Induced[S, Sub[T,M0,gap].seq, H].map c)) (f c)) ;
  theorem : Tr.Trunc[Factorisation].carrier =
    TC.bind ((n : Nat) -> Lift n) Factorisation (\ L ->
      TC.map ((n : Nat) -> Lifted[L].Agree n) Factorisation (\ A ->
        (Lifted[L].m zero, Lifted[L].Agreed[A].gap, Lifted[L].Agreed[A].map, Lifted[L].Agreed[A].factor))
        (cc (Lifted[L].Agree) (Lifted[L].agree)))
      (cc Lift (\ n -> OT.lift (S.A n) (finS n) (\ x -> f (CS.inc n x)))) ;
} ;

-- SSD Lemma 2.3: a map f : X -> Y between overtly discrete types is a
-- sequential colimit of maps between finite sets.  With presentations
-- eX : X = colim S and eY : Y = colim T, apply the above to
-- eY . f . eX^-1, and present Y by Sub through Phi^-1 . eY.
record MapPres (X Y : U l) (f : X -> Y) {
  source : Seq ;
  target : Seq ;
  source-finite : (n : Nat) -> isFinite (source.A n) ;
  target-finite : (n : Nat) -> isFinite (target.A n) ;
  H : SeqMap[source, target] ;
  eX : Equiv X (Colim[source].colim) ;
  eY : Equiv Y (Colim[target].colim) ;
  square : (x : X) -> Id (Colim[target].colim) (eY.1 (f x)) (Induced[source, target, H].map (eX.1 x)) ;
} ;
-- the same with the presentation of X kept: a presentation of Y and a map of
-- sequences from that of X
record RelPres (X Y : U l) (f : X -> Y) (pX : ODisc[l].Pres[X]) {
  target : ODisc[l].Pres[Y] ;
  H : SeqMap[pX.seq, target.seq] ;
  square : (x : X) -> Id (Colim[target.seq].colim) (target.equiv.1 (f x)) (Induced[pX.seq, target.seq, H].map (pX.equiv.1 x)) ;
} ;
module MapODisc (cc : CC) (X Y : U l) (pX : ODisc[l].Pres[X]) (pY : ODisc[l].Pres[Y]) (f : X -> Y) {
  S : Seq = pX.seq ; T : Seq = pY.seq ;
  module CS = Colim[S] ; module CT = Colim[T] ;
  f' (c : CS.colim) : CT.colim = pY.equiv.1 (f (pX.equiv.2.sec c)) ;
  module L = Lemma23[cc, S, T, pX.finite, f'] ;
  module Given (F : L.Factorisation) {
    module SB = Sub[T, F.1, F.2.1] ;
    module I = Induced[S, SB.seq, F.2.2.1] ;
    eY : Equiv Y SB.CS.colim = Equivalences[l].compose Y CT.colim SB.CS.colim pY.equiv (inverse SB.CS.colim CT.colim SB.equiv) ;
    square (x : X) : Id SB.CS.colim (eY.1 (f x)) (I.map (pX.equiv.1 x)) = calc SB.CS.colim {
      SB.equiv.2.sec (pY.equiv.1 (f x))
        =< apH (\ y -> SB.equiv.2.sec (pY.equiv.1 (f y))) (symH (sec-ret X CS.colim pX.equiv.1 pX.equiv.2 x)) >
      SB.equiv.2.sec (f' (pX.equiv.1 x))
        =< apH SB.equiv.2.sec (symH (F.2.2.2 (pX.equiv.1 x))) > SB.equiv.2.sec (SB.Phi (I.map (pX.equiv.1 x)))
        =< sec-ret SB.CS.colim CT.colim SB.Phi SB.equiv.2 (I.map (pX.equiv.1 x)) > I.map (pX.equiv.1 x) } ;
    result : MapPres[X,Y,f] = new MapPres[X, Y, f, S, SB.seq, pX.finite, \ n -> pY.finite (SB.stage n),
      F.2.2.1, pX.equiv, eY, square] ;
    relative : RelPres[X,Y,f,pX] = new RelPres[X, Y, f, pX,
      new ODisc[l].Pres[Y, SB.seq, \ n -> pY.finite (SB.stage n), eY], F.2.2.1, square] ;
  } ;
  theorem : Truncation[l+].Trunc[MapPres[X,Y,f]].carrier =
    TC.rec L.Factorisation @(l+) (Truncation[l+].Trunc[MapPres[X,Y,f]].carrier) (Truncation[l+].Trunc[MapPres[X,Y,f]].proposition)
      (\ F -> Truncation[l+].Trunc[MapPres[X,Y,f]].inc (Given[F].result)) L.theorem ;
  relative : Truncation[l+].Trunc[RelPres[X,Y,f,pX]].carrier =
    TC.rec L.Factorisation @(l+) (Truncation[l+].Trunc[RelPres[X,Y,f,pX]].carrier) (Truncation[l+].Trunc[RelPres[X,Y,f,pX]].proposition)
      (\ F -> Truncation[l+].Trunc[RelPres[X,Y,f,pX]].inc (Given[F].relative)) L.theorem ;
} ;
lemma23 (cc : CC) (X Y : U l) (oX : ODisc[l].isODisc X) (oY : ODisc[l].isODisc Y) (f : X -> Y)
  : Truncation[l+].Trunc[MapPres[X,Y,f]].carrier =
  TruncationCombinators[l+].bind2 (ODisc[l].Pres[X]) (ODisc[l].Pres[Y]) MapPres[X,Y,f]
    (\ pX pY -> MapODisc[cc, X, Y, pX, pY, f].theorem) oX oY ;
lemma23-rel (cc : CC) (X Y : U l) (pX : ODisc[l].Pres[X]) (oY : ODisc[l].isODisc Y) (f : X -> Y)
  : Truncation[l+].Trunc[RelPres[X,Y,f,pX]].carrier =
  TruncationCombinators[l+].bind (ODisc[l].Pres[Y]) RelPres[X,Y,f,pX]
    (\ pY -> MapODisc[cc, X, Y, pX, pY, f].relative) oY ;
