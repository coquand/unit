-- The integers Z, with normal forms  pos n = n  and  negsuc n = -(n+1), as
-- an abelian group (Torsor.Ab) and a set (equality has a code, as on Nat).
-- Addition is iterated successor / predecessor in the second argument:
--   x + pos n = suc^n x,   x + negsuc n = pred^(n+1) x.
-- The group laws follow from  (suc x) + y = suc (x + y)  and
-- (pred x) + y = pred (x + y)  (induction on y) and their mirror images in y
-- (cases): associativity and commutativity by induction on the last
-- argument, x + (-x) = 0 by induction on |x|.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ;
module NA = NatArith[l] ;

data Int = pos (n : Nat) | negsuc (n : Nat) ;
zeroZ : Int = pos zero ;

-- successor and predecessor, mutually inverse
sucNeg : Nat -> Int = split { zero -> pos zero ; suc m -> negsuc m } ;
sucZ : Int -> Int = split { pos n -> pos (suc n) ; negsuc n -> sucNeg n } ;
predPos : Nat -> Int = split { zero -> negsuc zero ; suc m -> pos m } ;
predZ : Int -> Int = split { pos n -> predPos n ; negsuc n -> negsuc (suc n) } ;
suc-predPos : (n : Nat) -> Id Int (sucZ (predPos n)) (pos n) = split {
  zero -> refl (pos zero) ; suc m -> refl (pos (suc m)) } ;
suc-pred : (x : Int) -> Id Int (sucZ (predZ x)) x = split {
  pos n -> suc-predPos n ; negsuc n -> refl (negsuc n) } ;
pred-sucNeg : (n : Nat) -> Id Int (predZ (sucNeg n)) (negsuc n) = split {
  zero -> refl (negsuc zero) ; suc m -> refl (negsuc (suc m)) } ;
pred-suc : (x : Int) -> Id Int (predZ (sucZ x)) x = split {
  pos n -> refl (pos n) ; negsuc n -> pred-sucNeg n } ;

-- addition
addP (x : Int) : Nat -> Int = split { zero -> x ; suc n | r -> sucZ r } ;
addN (x : Int) : Nat -> Int = split { zero -> predZ x ; suc n | r -> predZ r } ;
add (x : Int) : Int -> Int = split { pos n -> addP x n ; negsuc n -> addN x n } ;
negPos : Nat -> Int = split { zero -> pos zero ; suc m -> negsuc m } ;
neg : Int -> Int = split { pos n -> negPos n ; negsuc n -> pos (suc n) } ;

-- suc and pred on the left
addP-sucL (x : Int) : (n : Nat) -> Id Int (addP (sucZ x) n) (sucZ (addP x n)) = split {
  zero -> refl (sucZ x) ; suc n | r -> apH sucZ r } ;
addN-sucL (x : Int) : (n : Nat) -> Id Int (addN (sucZ x) n) (sucZ (addN x n)) = split {
  zero -> transH (pred-suc x) (symH (suc-pred x)) ;
  suc n | r -> transH (apH predZ r) (transH (pred-suc (addN x n)) (symH (suc-pred (addN x n)))) } ;
add-sucL (x : Int) : (y : Int) -> Id Int (add (sucZ x) y) (sucZ (add x y)) = split {
  pos n -> addP-sucL x n ; negsuc n -> addN-sucL x n } ;
addP-predL (x : Int) : (n : Nat) -> Id Int (addP (predZ x) n) (predZ (addP x n)) = split {
  zero -> refl (predZ x) ;
  suc n | r -> transH (apH sucZ r) (transH (suc-pred (addP x n)) (symH (pred-suc (addP x n)))) } ;
addN-predL (x : Int) : (n : Nat) -> Id Int (addN (predZ x) n) (predZ (addN x n)) = split {
  zero -> refl (predZ (predZ x)) ; suc n | r -> apH predZ r } ;
add-predL (x : Int) : (y : Int) -> Id Int (add (predZ x) y) (predZ (add x y)) = split {
  pos n -> addP-predL x n ; negsuc n -> addN-predL x n } ;
-- suc and pred on the right
sucR-neg (x : Int) : (n : Nat) -> Id Int (add x (sucNeg n)) (sucZ (addN x n)) = split {
  zero -> symH (suc-pred x) ; suc m -> symH (suc-pred (addN x m)) } ;
add-sucR (x : Int) : (y : Int) -> Id Int (add x (sucZ y)) (sucZ (add x y)) = split {
  pos n -> refl (sucZ (addP x n)) ; negsuc n -> sucR-neg x n } ;
predR-pos (x : Int) : (n : Nat) -> Id Int (add x (predPos n)) (predZ (addP x n)) = split {
  zero -> refl (predZ x) ; suc m -> symH (pred-suc (addP x m)) } ;
add-predR (x : Int) : (y : Int) -> Id Int (add x (predZ y)) (predZ (add x y)) = split {
  pos n -> predR-pos x n ; negsuc n -> refl (predZ (addN x n)) } ;

-- the group laws
zero-lP : (n : Nat) -> Id Int (addP zeroZ n) (pos n) = split {
  zero -> refl zeroZ ; suc n | r -> apH sucZ r } ;
zero-lN : (n : Nat) -> Id Int (addN zeroZ n) (negsuc n) = split {
  zero -> refl (negsuc zero) ; suc n | r -> apH predZ r } ;
zero-l : (y : Int) -> Id Int (add zeroZ y) y = split { pos n -> zero-lP n ; negsuc n -> zero-lN n } ;
assocP (x y : Int) : (n : Nat) -> Id Int (addP (add x y) n) (add x (addP y n)) = split {
  zero -> refl (add x y) ; suc n | r -> transH (apH sucZ r) (symH (add-sucR x (addP y n))) } ;
assocN (x y : Int) : (n : Nat) -> Id Int (addN (add x y) n) (add x (addN y n)) = split {
  zero -> symH (add-predR x y) ; suc n | r -> transH (apH predZ r) (symH (add-predR x (addN y n))) } ;
assoc (x y : Int) : (z : Int) -> Id Int (add (add x y) z) (add x (add y z)) = split {
  pos n -> assocP x y n ; negsuc n -> assocN x y n } ;
commP (x : Int) : (n : Nat) -> Id Int (addP x n) (add (pos n) x) = split {
  zero -> symH (zero-l x) ; suc n | r -> transH (apH sucZ r) (symH (add-sucL (pos n) x)) } ;
commN (x : Int) : (n : Nat) -> Id Int (addN x n) (add (negsuc n) x) = split {
  zero -> transH (apH predZ (symH (zero-l x))) (symH (add-predL zeroZ x)) ;
  suc n | r -> transH (apH predZ r) (symH (add-predL (negsuc n) x)) } ;
comm (x : Int) : (y : Int) -> Id Int (add x y) (add y x) = split { pos n -> commP x n ; negsuc n -> commN x n } ;
invr-pos : (m : Nat) -> Id Int (addN (pos (suc m)) m) zeroZ = split {
  zero -> refl zeroZ ;
  suc m | r -> transH (apH predZ (addN-sucL (pos (suc m)) m)) (transH (pred-suc (addN (pos (suc m)) m)) r) } ;
invr-neg : (m : Nat) -> Id Int (sucZ (addP (negsuc m) m)) zeroZ = split {
  zero -> refl zeroZ ;
  suc m | r -> transH (apH (\ y -> sucZ (sucZ y)) (addP-predL (negsuc m) m)) (transH (apH sucZ (suc-pred (addP (negsuc m) m))) r) } ;
invr-posN : (n : Nat) -> Id Int (add (pos n) (negPos n)) zeroZ = split {
  zero -> refl zeroZ ; suc m -> invr-pos m } ;
invr : (x : Int) -> Id Int (add x (neg x)) zeroZ = split { pos n -> invr-posN n ; negsuc m -> invr-neg m } ;

-- Int is a set
code : Int -> Int -> U l = split {
  pos m -> split { pos n -> NA.code m n ; negsuc n -> Empty } ;
  negsuc m -> split { pos n -> Empty ; negsuc n -> NA.code m n } } ;
code-prop : (x y : Int) -> isProp (code x y) = split {
  pos m -> split { pos n -> NA.code-prop m n ; negsuc n -> isProp-Empty } ;
  negsuc m -> split { pos n -> isProp-Empty ; negsuc n -> NA.code-prop m n } } ;
code-refl : (x : Int) -> code x x = split { pos m -> NA.code-refl m ; negsuc m -> NA.code-refl m } ;
code-eq : (x y : Int) -> code x y -> Id Int x y = split {
  pos m -> split { pos n -> \ h -> apH (\ k -> pos k) (NA.code-eq m n h) ;
                   negsuc n -> \ h -> absurd (Id Int (pos m) (negsuc n)) h } ;
  negsuc m -> split { pos n -> \ h -> absurd (Id Int (negsuc m) (pos n)) h ;
                      negsuc n -> \ h -> apH (\ k -> negsuc k) (NA.code-eq m n h) } } ;
int-set : isSet Int = \ x -> Hedberg[Int, x, code x, code-prop x, code-refl x, code-eq x].hedberg ;

intAb : Torsor[l].Ab = new Torsor[l].Ab[Int, int-set, zeroZ, add, neg, assoc, comm, \ x -> refl x, invr] ;

-- equality of naturals is decidable (Logic.Dec)
not-code (m n : Nat) (p : Id Nat m n) : NA.code m n = substH (NA.code m) p (NA.code-refl m) ;
dec-suc (m n : Nat) : Logic[l].Dec (Id Nat m n) -> Logic[l].Dec (Id Nat (suc m) (suc n)) = split {
  yes p -> yes (apH (\ k -> suc k) p) ;
  no k -> no (\ p -> k (NA.suc-inj p)) } ;
nat-dec : (m n : Nat) -> Logic[l].Dec (Id Nat m n) = split {
  zero -> split { zero -> yes (refl zero) ; suc n -> no (not-code zero (suc n)) } ;
  suc m | r -> split { zero -> no (not-code (suc m) zero) ; suc n -> dec-suc m n (r n) } } ;

-- equality is decidable (Logic.Dec)
encode (x y : Int) (p : Id Int x y) : code x y = substH (code x) p (code-refl x) ;
dec-pos (m n : Nat) : Logic[l].Dec (Id Nat m n) -> Logic[l].Dec (Id Int (pos m) (pos n)) = split {
  yes p -> yes (apH (\ k -> pos k) p) ;
  no k -> no (\ p -> k (NA.code-eq m n (encode (pos m) (pos n) p))) } ;
dec-neg (m n : Nat) : Logic[l].Dec (Id Nat m n) -> Logic[l].Dec (Id Int (negsuc m) (negsuc n)) = split {
  yes p -> yes (apH (\ k -> negsuc k) p) ;
  no k -> no (\ p -> k (NA.code-eq m n (encode (negsuc m) (negsuc n) p))) } ;
int-dec : (x y : Int) -> Logic[l].Dec (Id Int x y) = split {
  pos m -> split { pos n -> dec-pos m n (nat-dec m n) ; negsuc n -> no (encode (pos m) (negsuc n)) } ;
  negsuc m -> split { pos n -> no (encode (negsuc m) (pos n)) ; negsuc n -> dec-neg m n (nat-dec m n) } } ;

-- Z is countable: the enumeration 0, -1, 1, -2, 2, ..  (ofNat), with inverse
-- pos n |-> 2n, negsuc n |-> 2n+1 (toNat); next is the successor in the
-- enumeration, so toNat (next x) = suc (toNat x).
dbl : Nat -> Nat = split { zero -> zero ; suc n | r -> suc (suc r) } ;
toNat : Int -> Nat = split { pos n -> dbl n ; negsuc n -> suc (dbl n) } ;
next : Int -> Int = split { pos n -> negsuc n ; negsuc n -> pos (suc n) } ;
ofNat : Nat -> Int = split { zero -> pos zero ; suc m | r -> next r } ;
toNat-next : (x : Int) -> Id Nat (toNat (next x)) (suc (toNat x)) = split {
  pos n -> refl (suc (dbl n)) ; negsuc n -> refl (suc (suc (dbl n))) } ;
to-of : (m : Nat) -> Id Nat (toNat (ofNat m)) m = split {
  zero -> refl zero ; suc m | r -> transH (toNat-next (ofNat m)) (apH (\ k -> suc k) r) } ;
of-dbl : (n : Nat) -> Id Int (ofNat (dbl n)) (pos n) = split {
  zero -> refl (pos zero) ; suc n | r -> apH (\ x -> next (next x)) r } ;
of-to : (x : Int) -> Id Int (ofNat (toNat x)) x = split { pos n -> of-dbl n ; negsuc n -> apH next (of-dbl n) } ;
