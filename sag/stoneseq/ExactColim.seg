-- A sequential colimit of exact sequences is exact (for SSD Lemma 5.9).
--
-- Setting: maps of sequences d0 : A -> B and d1 : B -> C, and points c n of
-- C n preserved by the maps (the zeros, for sequences of groups).  The
-- sequence is exact at stage n when every b with d1 b = c n is merely some
-- d0 a.  If it is exact at every stage, then so is the colimit, at the
-- point inc 0 (c 0).
-- Proof.  Let inc n y with d1 (inc n y) = inc n (d1 y) equal to the point
-- inc n (c n).  These meet: shift d (d1 y) = shift d (c n) = c (d + n) for
-- some d (stage-meet), and shift d (d1 y) = d1 (shift d y).  By exactness at
-- d + n, shift d y = d0 a, so inc n y = inc (d + n) (shift d y) = d0 (inc a).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open NatArith[l] ; open SeqColim[l] ; open SeqMaps[l] ; open Bijection[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;

module ExactColim (A B C : Seq) (D0 : SeqMap[A,B]) (D1 : SeqMap[B,C])
  (c : (n : Nat) -> C.A n) (cf : (n : Nat) -> Id (C.A (suc n)) (C.f n (c n)) (c (suc n)))
  (exact : (n : Nat) (b : B.A n) -> Id (C.A n) (D1.h n b) (c n) -> Tr.Trunc[Fibre (D0.h n) b].carrier) {
  module CA = Colim[A] ; module CB = Colim[B] ; module CC = Colim[C] ;
  module I0 = Induced[A, B, D0] ; module I1 = Induced[B, C, D1] ;
  shift-c : (d n : Nat) -> Id (C.A (plus d n)) (CC.shift d n (c n)) (c (plus d n)) = split {
    zero -> \ n -> refl (c n) ;
    suc d | r -> \ n -> transH (apH (C.f (plus d n)) (r n)) (cf (plus d n)) } ;
  point : CC.colim = CC.inc zero (c zero) ;
  point-at : (n : Nat) -> Id CC.colim (CC.inc n (c n)) point = split {
    zero -> refl point ;
    suc n | r -> transH (apH (CC.inc (suc n)) (symH (cf n))) (transH (symH (CC.glue n (c n))) r) } ;
  module At (n : Nat) (y : B.A n) (q : Id CC.colim (I1.map (CB.inc n y)) point) {
    meeting : Id CC.colim (CC.inc n (D1.h n y)) (CC.inc n (c n)) =
      transH (symH (I1.map-inc n y)) (transH q (symH (point-at n))) ;
    lifted (w : (d : Nat) * Id (C.A (plus d n)) (CC.shift d n (D1.h n y)) (CC.shift d n (c n)))
      : Tr.Trunc[Fibre I0.map (CB.inc n y)].carrier =
      TC.map (Fibre (D0.h (plus w.1 n)) (CB.shift w.1 n y)) (Fibre I0.map (CB.inc n y))
        (\ v -> (CA.inc (plus w.1 n) v.1, transH (I0.map-inc (plus w.1 n) v.1)
                  (transH (apH (CB.inc (plus w.1 n)) v.2) (CB.inc-iter w.1 (n, y)))))
        (exact (plus w.1 n) (CB.shift w.1 n y)
          (transH (symH (I1.shift-nat w.1 n y)) (transH w.2 (shift-c w.1 n)))) ;
    result : Tr.Trunc[Fibre I0.map (CB.inc n y)].carrier =
      TC.bind CC.Meet[(n, D1.h n y), (n, c n)] (Fibre I0.map (CB.inc n y))
        (\ m -> lifted (CC.stage-meet n (D1.h n y) (c n) m))
        (CC.effective (n, D1.h n y) (n, c n) meeting) ;
  } ;
  exact-colim (b : CB.colim) (q : Id CC.colim (I1.map b) point) : Tr.Trunc[Fibre I0.map b].carrier =
    CB.induction @l (\ b1 -> Id CC.colim (I1.map b1) point -> Tr.Trunc[Fibre I0.map b1].carrier)
      (\ b1 -> FL.isProp-Pi (Id CC.colim (I1.map b1) point) (\ q1 -> Tr.Trunc[Fibre I0.map b1].carrier)
                 (\ q1 -> Tr.Trunc[Fibre I0.map b1].proposition))
      (\ n y q1 -> At[n, y, q1].result) b q ;
} ;
