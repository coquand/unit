-- SSD Corollary 2.5: an injective (resp. surjective) map between overtly
-- discrete types is a sequential colimit of injective (resp. surjective)
-- maps between finite sets.
--
-- Proof.  By Lemma 2.3, f is colim h for h : S -> T, up to the
-- presentations.  By Lemma 2.4, h n = into n . onto n through the images
-- Im (h n) (finite: a Sigma over T n of truncations of finite Sigmas), with
-- colim im = Im (colim h).  If f is injective, so is colim h, hence
-- colim S = Im (colim h) = colim im, and f is the colimit of the injections
-- into n.  If f is surjective, so is colim h, hence Im (colim h) = colim T,
-- and f is the colimit of the surjections onto n.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open SeqColim[l] ; open SeqMaps[l] ; open Bijection[l] ; open Finite[l] ;
open FiniteClosure[l] ; open ODisc[l] ; open Lemma23[l] ; open Lemma24[l] ; open CountableChoice[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module T1 = Truncation[l+] ; module TC1 = TruncationCombinators[l+] ;
module Eq = Equivalences[l] ;

-- images of maps of finite sets are finite
im-finite (A B : U l) (fA : isFinite A) (fB : isFinite B) (h : A -> B) : isFinite (Im h) =
  sigma-finite B fB (\ b -> Tr.Trunc[Fibre h b].carrier) (\ b ->
    trunc-finite (Fibre h b) (sigma-finite A fA (\ a -> Id B (h a) b) (\ a -> id-finite B fB (h a) b))) ;

module Through (X Y : U l) (f : X -> Y) (M : MapPres[X,Y,f]) {
  module I = Images[M.source, M.target, M.H] ;
  g (c : Colim[M.source].colim) : Colim[M.target].colim = I.IH.map c ;
  im-fin (n : Nat) : isFinite (I.im.A n) =
    im-finite (M.source.A n) (M.target.A n) (M.source-finite n) (M.target-finite n) (M.H.h n) ;
  -- g at a point of X
  at (x : X) : Id (Colim[M.target].colim) (g (M.eX.1 x)) (M.eY.1 (f x)) = symH (M.square x) ;
  theta-inv : Equiv (Im g) (Colim[I.im].colim) = inverse (Colim[I.im].colim) (Im g) I.equiv ;
  -- the first component of theta^-1 w, through colim into, is w.1
  into-inv (w : Im g) : Id (Colim[M.target].colim) (I.II.map (theta-inv.1 w)) w.1 =
    apH (\ v -> v.1) (I.equiv.2.sec-eq w) ;
} ;

module InjCase (X Y : U l) (f : X -> Y) (finj : Injective f) (M : MapPres[X,Y,f]) {
  module Th = Through[X, Y, f, M] ;
  g-inj : Injective Th.g = \ c c' q ->
    transH (symH (M.eX.2.sec-eq c)) (transH (apH M.eX.1
      (finj (M.eX.2.sec c) (M.eX.2.sec c') (Eq.injective Y (Colim[M.target].colim) M.eY.1 M.eY.2 (f (M.eX.2.sec c)) (f (M.eX.2.sec c'))
        (transH (symH (Th.at (M.eX.2.sec c))) (transH (apH Th.g (M.eX.2.sec-eq c))
          (transH q (transH (symH (apH Th.g (M.eX.2.sec-eq c'))) (Th.at (M.eX.2.sec c')))))))))
      (M.eX.2.sec-eq c')) ;
  cores (c : Colim[M.source].colim) : Im Th.g = (Th.g c, Tr.Trunc[Fibre Th.g (Th.g c)].inc (c, refl (Th.g c))) ;
  cores-equiv : Equiv (Colim[M.source].colim) (Im Th.g) = (cores, Bij[Colim[M.source].colim, Im Th.g, im-set Th.g (Colim[M.target].set), cores,
    \ c c' q -> g-inj c c' (apH (\ w -> w.1) q),
    \ w -> TC.map (Fibre Th.g w.1) (Fibre cores w) (\ v -> (v.1, im-eq Th.g (cores v.1) w v.2)) w.2].equiv) ;
  eX : Equiv X (Colim[Th.I.im].colim) = Eq.compose X (Im Th.g) (Colim[Th.I.im].colim)
    (Eq.compose X (Colim[M.source].colim) (Im Th.g) M.eX cores-equiv) Th.theta-inv ;
  square (x : X) : Id (Colim[M.target].colim) (M.eY.1 (f x)) (Th.I.II.map (eX.1 x)) =
    symH (transH (Th.into-inv (cores (M.eX.1 x))) (Th.at x)) ;
  result : MapPres[X,Y,f] = new MapPres[X, Y, f, Th.I.im, M.target, Th.im-fin, M.target-finite, Th.I.into, eX, M.eY, square] ;
  levelwise (n : Nat) : Injective (result.H.h n) = Th.I.into-inj n ;
} ;

module SurjCase (X Y : U l) (f : X -> Y) (fsurj : (y : Y) -> Tr.Trunc[Fibre f y].carrier) (M : MapPres[X,Y,f]) {
  module Th = Through[X, Y, f, M] ;
  -- every point of colim T is in the image of g
  g-surj (c : Colim[M.target].colim) : Tr.Trunc[Fibre Th.g c].carrier =
    TC.map (Fibre f (M.eY.2.sec c)) (Fibre Th.g c) (\ v -> (M.eX.1 v.1,
      transH (Th.at v.1) (transH (apH M.eY.1 v.2) (M.eY.2.sec-eq c)))) (fsurj (M.eY.2.sec c)) ;
  incl (w : Im Th.g) : Colim[M.target].colim = w.1 ;
  incl-equiv : Equiv (Im Th.g) (Colim[M.target].colim) = (incl, Bij[Im Th.g, Colim[M.target].colim, Colim[M.target].set, incl,
    \ w w' q -> im-eq Th.g w w' q,
    \ c -> TC.map (Fibre Th.g c) (Fibre incl c)
      (\ v -> ((c, Tr.Trunc[Fibre Th.g c].inc v), refl c)) (g-surj c)].equiv) ;
  eY : Equiv Y (Colim[Th.I.im].colim) = Eq.compose Y (Im Th.g) (Colim[Th.I.im].colim)
    (Eq.compose Y (Colim[M.target].colim) (Im Th.g) M.eY (inverse (Im Th.g) (Colim[M.target].colim) incl-equiv)) Th.theta-inv ;
  -- theta (colim onto c) = (g c, _), so colim onto c = theta^-1 (incl^-1 (g c))
  square (x : X) : Id (Colim[Th.I.im].colim) (eY.1 (f x)) (Th.I.IO.map (M.eX.1 x)) = calc (Colim[Th.I.im].colim) {
    Th.theta-inv.1 (incl-equiv.2.sec (M.eY.1 (f x)))
      =< apH Th.theta-inv.1 (Eq.injective (Im Th.g) (Colim[M.target].colim) incl-equiv.1 incl-equiv.2
           (incl-equiv.2.sec (M.eY.1 (f x))) (Th.I.theta (Th.I.IO.map (M.eX.1 x)))
           (transH (incl-equiv.2.sec-eq (M.eY.1 (f x))) (transH (symH (Th.at x)) (symH (Th.I.onto-part (M.eX.1 x)))))) >
    Th.theta-inv.1 (Th.I.theta (Th.I.IO.map (M.eX.1 x)))
      =< sec-ret (Colim[Th.I.im].colim) (Im Th.g) Th.I.theta Th.I.equiv.2 (Th.I.IO.map (M.eX.1 x)) >
    Th.I.IO.map (M.eX.1 x) } ;
  result : MapPres[X,Y,f] = new MapPres[X, Y, f, M.source, Th.I.im, M.source-finite, Th.im-fin, Th.I.onto, M.eX, eY, square] ;
  levelwise (n : Nat) (y : Th.I.im.A n) : Tr.Trunc[Fibre (result.H.h n) y].carrier = Th.I.onto-surj n y ;
} ;

cor25-inj (cc : CC) (X Y : U l) (oX : isODisc X) (oY : isODisc Y) (f : X -> Y) (finj : Injective f)
  : T1.Trunc[(M : MapPres[X,Y,f]) * ((n : Nat) -> Injective (M.H.h n))].carrier =
  TC1.map (MapPres[X,Y,f]) ((M : MapPres[X,Y,f]) * ((n : Nat) -> Injective (M.H.h n)))
    (\ M -> (InjCase[X, Y, f, finj, M].result, InjCase[X, Y, f, finj, M].levelwise)) (lemma23 cc X Y oX oY f) ;
cor25-surj (cc : CC) (X Y : U l) (oX : isODisc X) (oY : isODisc Y) (f : X -> Y) (fsurj : (y : Y) -> Tr.Trunc[Fibre f y].carrier)
  : T1.Trunc[(M : MapPres[X,Y,f]) * ((n : Nat) (y : M.target.A n) -> Tr.Trunc[Fibre (M.H.h n) y].carrier)].carrier =
  TC1.map (MapPres[X,Y,f]) ((M : MapPres[X,Y,f]) * ((n : Nat) (y : M.target.A n) -> Tr.Trunc[Fibre (M.H.h n) y].carrier))
    (\ M -> (SurjCase[X, Y, f, fsurj, M].result, SurjCase[X, Y, f, fsurj, M].levelwise)) (lemma23 cc X Y oX oY f) ;
