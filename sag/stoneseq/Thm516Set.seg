-- SSD Theorem 5.16 as a bijection of sets: for a Čech cover (X, S) (each S x
-- merely inhabited, (x : X) * S x Stone), the map
--   Ȟ^1 (X, S, Z) = cocycles / coboundaries  ->  H^1 (X, Z) = ||X -> BZ||_0,
--   [b] |-> [alpha_b],   alpha_b x = the torsor of b x (Tors.psi, Thm516.Glue)
-- is a bijection.  (Both sides are quotients, pn/Quotient; no group
-- structure.)  Not the paper's proof (Lemmas 5.13-5.15).
--
--  (ii) b = b' + d0 a  iff  alpha_b and alpha_b' are merely equal.
--    <= (Shift): v |-> v - a x is an equivariant map alpha_b x -> alpha_b' x
--       (L1), so a path (TorId.decode).
--    => (Unshift): from equivariant g x : alpha_b x -> alpha_b' x, let
--       G x u = g x (uc u) (uc u = b x u _, the point of alpha_b x at u) and
--       a x u = G x u at u.  Since uc v = (- b x u v) . uc u (cocycle, L3),
--       G x v = (- b x u v) . G x u (equivariance); at v, with the
--       condition of G x u: a x v = - b x u v + (a x u + b' x u v), so
--       b' = b + d0 a (L2).
--    Hence "differ by a coboundary" is an equivalence relation (through
--    mere equality of the alpha's).
--  (i) Every alpha is merely an alpha_b (onto): Lemma 5.10 on (x : X) * S x
--    gives points of alpha x over S x; the torsors with points are the
--    cocycles (Tors.phi, Tors.psiphi: SAG Lemma 7.4.2).
--  So [b] |-> [alpha_b] is well defined and injective by (ii), onto by (i).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Torsor[l] ; open TorsorCocycles[l] ; open TorsorId[l] ; open TrivialGerbe[l] ;
open CechComplex[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module P1 = Prelude[l+] ;
module T1 = Truncation[l+] ; module TC1 = TruncationCombinators[l+] ;
module FL1 = Axioms[l+].FunExtLemmas[fe @(l+)] ;
module PF = Profinite[l,l] ;

-- three identities of abelian groups
module AbMore (G : Ab) {
  open G ;
  open AbL[G] ;
  L1 (p q r s : A) : Id A (add (add p (add q (add r (inv s)))) (inv r)) (add (add p (inv s)) q) = calc A {
    add (add p (add q (add r (inv s)))) (inv r) =< assoc p (add q (add r (inv s))) (inv r) >
    add p (add (add q (add r (inv s))) (inv r)) =< apH (add p) (assoc q (add r (inv s)) (inv r)) >
    add p (add q (add (add r (inv s)) (inv r))) =< apH (\ t -> add p (add q (add t (inv r)))) (comm r (inv s)) >
    add p (add q (add (add (inv s) r) (inv r))) =< apH (\ t -> add p (add q t)) (assoc (inv s) r (inv r)) >
    add p (add q (add (inv s) (add r (inv r)))) =< apH (\ t -> add p (add q (add (inv s) t))) (invr r) >
    add p (add q (add (inv s) o)) =< apH (\ t -> add p (add q t)) (unitr (inv s)) >
    add p (add q (inv s)) =< apH (add p) (comm q (inv s)) >
    add p (add (inv s) q) =< symH (assoc p (inv s) q) > add (add p (inv s)) q } ;
  L2 (b b' gu gv : A) (e : Id A gv (add (inv b) (add gu b'))) : Id A b' (add b (add gv (inv gu))) = symH (calc A {
    add b (add gv (inv gu)) =< apH (\ t -> add b (add t (inv gu))) e >
    add b (add (add (inv b) (add gu b')) (inv gu)) =< apH (add b) (assoc (inv b) (add gu b') (inv gu)) >
    add b (add (inv b) (add (add gu b') (inv gu))) =< apH (\ t -> add b (add (inv b) (add t (inv gu)))) (comm gu b') >
    add b (add (inv b) (add (add b' gu) (inv gu))) =< apH (\ t -> add b (add (inv b) t)) (assoc b' gu (inv gu)) >
    add b (add (inv b) (add b' (add gu (inv gu)))) =< apH (\ t -> add b (add (inv b) (add b' t))) (invr gu) >
    add b (add (inv b) (add b' o)) =< apH (\ t -> add b (add (inv b) t)) (unitr b') >
    add b (add (inv b) b') =< symH (assoc b (inv b) b') >
    add (add b (inv b)) b' =< apH (\ t -> add t b') (invr b) >
    add o b' =< unitl b' > b' }) ;
  L3 (x y z : A) (e : Id A (add x y) z) : Id A y (add (inv x) z) = symH (calc A {
    add (inv x) z =< apH (add (inv x)) (symH e) > add (inv x) (add x y)
      =< symH (assoc (inv x) x y) > add (add (inv x) x) y
      =< apH (\ t -> add t y) (invl x) > add o y
      =< unitl y > y }) ;
} ;

module Over (ax : StoneAxioms[l,l].Assumptions) {
  open Integers[l] ;
  module Z = TrivG[intAb] ;
  module Cover (X : U l) (S : X -> U l) (inh : (x : X) -> Tr.Trunc[S x].carrier) (sS : PF.isStone ((x : X) * S x)) {
    module C = Cech[X, S, \ x -> intAb] ;
    module V = Thm516[l].Over[ax].Cover[X, S, inh, sS] ;
    module Ab = AbMore[intAb] ;
    Coc : U l = (b : C.C1) * C.Cocycle b ;
    -- b' = b + d0 a, merely
    Cohom (c c' : Coc) : U l = Tr.Trunc[(a : C.C0) * ((x : X) (u v : S x) -> Id Int (c'.1 x u v) (add (c.1 x u v) (C.d0 a x u v)))].carrier ;
    BZX : U l+ = X -> TorId[intAb].Tor ;
    alpha (c : Coc) : BZX = V.Glue[c.1, c.2].alpha ;
    Same (c c' : Coc) : U l+ = T1.Trunc[Id BZX (alpha c) (alpha c')].carrier ;

    -- (ii) <=
    module Shift (c c' : Coc) (a : C.C0) (h : (x : X) (u v : S x) -> Id Int (c'.1 x u v) (add (c.1 x u v) (C.d0 a x u v)))
      (x : X) {
      module M = V.Glue[c'.1, c'.2].Tx[x].M ;
      module M' = V.Glue[c.1, c.2].Tx[x].M ;
      f (v : M.Tc) : M'.Tc = (\ k -> add (v.1 k) (neg (a x k)), \ k m -> calc Int {
        add (v.1 m) (neg (a x m))
          =< apH (\ t -> add t (neg (a x m))) (transH (v.2 k m) (apH (add (v.1 k)) (h x k m))) >
        add (add (v.1 k) (add (c.1 x k m) (add (a x m) (neg (a x k))))) (neg (a x m))
          =< Ab.L1 (v.1 k) (c.1 x k m) (a x m) (a x k) > add (add (v.1 k) (neg (a x k))) (c.1 x k m) }) ;
      hom : TorId[intAb].Hom (alpha c' x) (alpha c x) = (f, \ e v ->
        M'.tc-eq (f (M.actc e v)) (M'.actc e (f v)) (\ k -> assoc e (v.1 k) (neg (a x k)))) ;
      path : Id (TorId[intAb].Tor) (alpha c' x) (alpha c x) = TorId[intAb].decode (alpha c' x) (alpha c x) hom ;
    } ;
    same-of-cohom (c c' : Coc) (h : Cohom c c') : Same c' c =
      TC.rec ((a : C.C0) * ((x : X) (u v : S x) -> Id Int (c'.1 x u v) (add (c.1 x u v) (C.d0 a x u v)))) @(l+)
        (Same c' c) T1.Trunc[Id BZX (alpha c') (alpha c)].proposition
        (\ w -> T1.Trunc[Id BZX (alpha c') (alpha c)].inc
          (FL1.funext X (\ x -> TorId[intAb].Tor) (alpha c') (alpha c) (\ x -> Shift[c, c', w.1, w.2, x].path))) h ;

    -- (ii) =>
    module Unshift (c c' : Coc) (p : (x : X) -> Id (TorId[intAb].Tor) (alpha c x) (alpha c' x)) {
      module M (x : X) { module N = V.Glue[c.1, c.2].Tx[x].M ; module N' = V.Glue[c'.1, c'.2].Tx[x].M ; } ;
      g (x : X) : TorId[intAb].Hom (alpha c x) (alpha c' x) = TorId[intAb].idtohom (alpha c x) (alpha c' x) (p x) ;
      G (x : X) (u : S x) : M[x].N'.Tc = (g x).1 (M[x].N.uc u) ;
      a : C.C0 = \ x u -> (G x u).1 u ;
      uc-move (x : X) (u v : S x) : Id M[x].N.Tc (M[x].N.uc v) (M[x].N.actc (neg (c.1 x u v)) (M[x].N.uc u)) =
        M[x].N.tc-eq (M[x].N.uc v) (M[x].N.actc (neg (c.1 x u v)) (M[x].N.uc u)) (\ k ->
          Ab.L3 (c.1 x u v) (c.1 x v k) (c.1 x u k) (c.2 x u v k)) ;
      at-v (x : X) (u v : S x) : Id Int (a x v) (add (neg (c.1 x u v)) ((G x u).1 v)) =
        apH (\ z -> z.1 v) (transH (apH (g x).1 (uc-move x u v)) ((g x).2 (neg (c.1 x u v)) (M[x].N.uc u))) ;
      bounds (x : X) (u v : S x) : Id Int (c'.1 x u v) (add (c.1 x u v) (C.d0 a x u v)) =
        Ab.L2 (c.1 x u v) (c'.1 x u v) (a x u) (a x v)
          (transH (at-v x u v) (apH (add (neg (c.1 x u v))) ((G x u).2 u v))) ;
      result : Cohom c c' = Tr.Trunc[(a : C.C0) * ((x : X) (u v : S x) -> Id Int (c'.1 x u v) (add (c.1 x u v) (C.d0 a x u v)))].inc
        (a, bounds) ;
    } ;
    cohom-of-same (c c' : Coc) (s : Same c c') : Cohom c c' =
      TC1.rec (Id BZX (alpha c) (alpha c')) @l (Cohom c c')
        Tr.Trunc[(a : C.C0) * ((x : X) (u v : S x) -> Id Int (c'.1 x u v) (add (c.1 x u v) (C.d0 a x u v)))].proposition
        (\ q -> Unshift[c, c', P1.happly X (\ x -> TorId[intAb].Tor) (alpha c) (alpha c') q].result) s ;

    -- so Cohom is an equivalence relation
    same-sym (c c' : Coc) (s : Same c c') : Same c' c =
      TC1.map (Id BZX (alpha c) (alpha c')) (Id BZX (alpha c') (alpha c)) (P1.sym BZX (alpha c) (alpha c')) s ;
    cohom-refl (c : Coc) : Cohom c c = cohom-of-same c c (T1.Trunc[Id BZX (alpha c) (alpha c)].inc (refl (alpha c))) ;
    cohom-sym (c c' : Coc) (h : Cohom c c') : Cohom c' c = cohom-of-same c' c (same-of-cohom c c' h) ;
    cohom-trans (c c' c'' : Coc) (h : Cohom c c') (h' : Cohom c' c'') : Cohom c c'' = cohom-of-same c c''
      (TC1.map2 (Id BZX (alpha c) (alpha c')) (Id BZX (alpha c') (alpha c'')) (Id BZX (alpha c) (alpha c''))
        (P1.trans BZX (alpha c) (alpha c') (alpha c''))
        (same-sym c' c (same-of-cohom c c' h)) (same-sym c'' c' (same-of-cohom c' c'' h'))) ;

    -- (i)
    module FromPoints (alpha0 : BZX) (p : (w : (x : X) * S x) -> Id (TorId[intAb].Tor) (alpha0 w.1) Z.Atriv) {
      module K (x : X) { module T = Tors[intAb, S x, inh x] ; } ;
      w (x : X) : K[x].T.Left = ((alpha0 x).1, (alpha0 x).2, \ s -> Thm516[l].Over[ax].point-of (alpha0 x) (p (x, s))) ;
      c : Coc = (\ x -> K[x].T.PhiM[w x].c, \ x -> K[x].T.PhiM[w x].coc) ;
      forget (x : X) (z : K[x].T.Left) : TorId[intAb].Tor = (z.1, z.2.1) ;
      path : Id BZX (alpha c) alpha0 = FL1.funext X (\ x -> TorId[intAb].Tor) (alpha c) alpha0 (\ x ->
        P1.ap (K[x].T.Left) (TorId[intAb].Tor) (forget x) (K[x].T.psi (K[x].T.phi (w x))) (w x) (K[x].T.psiphi (w x))) ;
    } ;
    onto (alpha0 : BZX) : T1.Trunc[(c : Coc) * Id BZX (alpha c) alpha0].carrier =
      TC1.map ((w : (x : X) * S x) -> Id (TorId[intAb].Tor) (alpha0 w.1) Z.Atriv) ((c : Coc) * Id BZX (alpha c) alpha0)
        (\ p -> (FromPoints[alpha0, p].c, FromPoints[alpha0, p].path))
        (Lemma510[l].Over[ax].lemma510 ((x : X) * S x) sS (\ w -> alpha0 w.1)) ;

    -- the bijection
    module HC = Quotient[l+].Quot[Coc, \ c c' -> Cohom c c',
      \ c c' -> Tr.Trunc[(a : C.C0) * ((x : X) (u v : S x) -> Id Int (c'.1 x u v) (add (c.1 x u v) (C.d0 a x u v)))].proposition,
      cohom-refl, cohom-sym, cohom-trans] ;
    module H1 = Quotient[l+].Quot[BZX, \ f f' -> T1.Trunc[Id BZX f f'].carrier,
      \ f f' -> T1.Trunc[Id BZX f f'].proposition,
      \ f -> T1.Trunc[Id BZX f f].inc (refl f),
      \ f f' -> TC1.map (Id BZX f f') (Id BZX f' f) (P1.sym BZX f f'),
      \ f f' f'' -> TC1.map2 (Id BZX f f') (Id BZX f' f'') (Id BZX f f'') (P1.trans BZX f f' f'')] ;
    module D = HC.Descend[H1.Q, H1.set, \ c -> H1.inc (alpha c), \ c c' h ->
      H1.relates (alpha c) (alpha c') (same-sym c' c (same-of-cohom c c' h))] ;
    Phi (q : HC.Q) : H1.Q = D.map q ;
    injective : Bijection[l+].Injective Phi = \ q ->
      HC.induction @(l+) (\ q1 -> (q2 : HC.Q) -> Id H1.Q (Phi q1) (Phi q2) -> Id HC.Q q1 q2)
        (\ q1 -> FL1.isProp-Pi HC.Q (\ q2 -> Id H1.Q (Phi q1) (Phi q2) -> Id HC.Q q1 q2) (\ q2 ->
          FL1.isProp-Pi (Id H1.Q (Phi q1) (Phi q2)) (\ e -> Id HC.Q q1 q2) (\ e -> HC.set q1 q2)))
        (\ c -> HC.induction @(l+) (\ q2 -> Id H1.Q (Phi (HC.inc c)) (Phi q2) -> Id HC.Q (HC.inc c) q2)
          (\ q2 -> FL1.isProp-Pi (Id H1.Q (Phi (HC.inc c)) (Phi q2)) (\ e -> Id HC.Q (HC.inc c) q2) (\ e -> HC.set (HC.inc c) q2))
          (\ c' e -> HC.relates c c' (cohom-of-same c c' (H1.effective (alpha c) (alpha c')
            (P1.trans H1.Q (H1.inc (alpha c)) (Phi (HC.inc c)) (H1.inc (alpha c'))
              (P1.sym H1.Q (Phi (HC.inc c)) (H1.inc (alpha c)) (D.beta c))
              (P1.trans H1.Q (Phi (HC.inc c)) (Phi (HC.inc c')) (H1.inc (alpha c')) e (D.beta c'))))))) q ;
    surjective (q : H1.Q) : T1.Trunc[Bijection[l+].Fibre Phi q].carrier =
      H1.induction @(l+) (\ q1 -> T1.Trunc[Bijection[l+].Fibre Phi q1].carrier)
        (\ q1 -> T1.Trunc[Bijection[l+].Fibre Phi q1].proposition)
        (\ f -> TC1.map ((c : Coc) * Id BZX (alpha c) f) (Bijection[l+].Fibre Phi (H1.inc f))
          (\ w -> (HC.inc w.1, P1.trans H1.Q (Phi (HC.inc w.1)) (H1.inc (alpha w.1)) (H1.inc f) (D.beta w.1)
            (P1.ap BZX H1.Q H1.inc (alpha w.1) f w.2)))
          (onto f)) q ;
    -- SSD Theorem 5.16 (as sets)
    theorem : P1.isEquiv HC.Q H1.Q Phi = Bijection[l+].Bij[HC.Q, H1.Q, H1.set, Phi, injective, surjective].equiv ;
  } ;
} ;
