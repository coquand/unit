-- Maps from a finite set into a sequential colimit (the two facts behind
-- SSD Lemma 2.3).  For F finite:
--   lift:  a map g : F -> colim merely factors through one stage N
--          (each g x is merely some inc n y; one stage serves all, Finite.Uniform);
--   agree: two maps F -> A m with equal images in the colimit merely meet
--          at one stage K, at every x.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open NatArith[l] ; open SeqColim[l] ; open Finite[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;

module Over (S : Seq) {
  module C = Colim[S] ;
  -- g factors through stage N
  At (F : U l) (g : F -> C.colim) (N : Nat) : U l = (x : F) -> (y : S.A N) * Id C.colim (C.inc N y) (g x) ;
  Point (F : U l) (g : F -> C.colim) (x : F) (N : Nat) : U l = (y : S.A N) * Id C.colim (C.inc N y) (g x) ;
  point-up (F : U l) (g : F -> C.colim) (x : F) (N a : Nat) (w : Point F g x N) : Point F g x (plus a N) =
    (C.shift a N w.1, transH (C.inc-iter a (N, w.1)) w.2) ;
  lift (F : U l) (fF : isFinite F) (g : F -> C.colim) : Tr.Trunc[(N : Nat) * At F g N].carrier =
    Uniform[F, fF, Point F g, point-up F g].stage (\ x ->
      TC.map ((u : C.Tot) * Id C.colim (C.Q.inc u) (g x)) ((N : Nat) * Point F g x N)
        (\ w -> (w.1.1, (w.1.2, w.2))) (C.inc-surj (g x))) ;

  -- h and h' meet at stage K, at every x
  agree (F : U l) (fF : isFinite F) (m m' : Nat) (h : F -> S.A m) (h' : F -> S.A m')
    (e : (x : F) -> Id C.colim (C.inc m (h x)) (C.inc m' (h' x)))
    : Tr.Trunc[(K : Nat) * ((x : F) -> C.MeetAt[K, (m, h x), (m', h' x)])].carrier =
    Uniform[F, fF, \ x K -> C.MeetAt[K, (m, h x), (m', h' x)], \ x K a -> C.meet-at-up K a (m, h x) (m', h' x)].stage
      (\ x -> TC.map C.Meet[(m, h x), (m', h' x)] ((K : Nat) * C.MeetAt[K, (m, h x), (m', h' x)])
        (\ w -> (plus w.d m, C.meet-at (m, h x) (m', h' x) w)) (C.effective (m, h x) (m', h' x) (e x))) ;
} ;
