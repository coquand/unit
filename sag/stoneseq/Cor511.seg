-- SSD Corollary 5.11, in the form its proof gives: for S Stone, (BZ)^S
-- (families of Z-torsors over S) is connected, and its loops at the
-- trivial family are the group Z^S.  So (BZ)^S is a delooping of Z^S,
-- i.e. B(Z^S) (the identification with Z^S-torsors is not formalised; see
-- HANDOFF-B "Gaps").
--
--  - Connected: every alpha is merely the trivial family, by Lemma 5.10 and
--    function extensionality.
--  - Loops: a loop p at the trivial family is, pointwise (happly), a loop
--    at the trivial torsor, i.e. an integer (TrivG.tb, inverse TrivG.tloop);
--    both steps are equivalences, so loop is one.  Composition of loops is
--    pointwise composition (happly-trans: J), which tb sends to addition
--    (TrivG.tb-hom).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Torsor[l] ; open TorsorId[l] ; open TrivialGerbe[l] ;
open Integers[l] ; open CechComplex[l] ;
module P1 = Prelude[l+] ;
module T1 = Truncation[l+] ; module TC1 = TruncationCombinators[l+] ;
module FL1 = Axioms[l+].FunExtLemmas[fe @(l+)] ;
module PF = Profinite[l,l] ;

-- happly sends composition to pointwise composition
happly-trans (A : U l) (B : A -> U l+) (f g : (x : A) -> B x) (p : Id ((x : A) -> B x) f g) :
  (h : (x : A) -> B x) (q : Id ((x : A) -> B x) g h) (x : A) ->
  Id (Id (B x) (f x) (h x)) (P1.happly A B f h (P1.trans ((x : A) -> B x) f g h p q) x)
    (P1.trans (B x) (f x) (g x) (h x) (P1.happly A B f g p x) (P1.happly A B g h q x)) =
  idJ ((x : A) -> B x) f (\ g1 p1 -> (h : (x : A) -> B x) (q : Id ((x : A) -> B x) g1 h) (x : A) ->
      Id (Id (B x) (f x) (h x)) (P1.happly A B f h (P1.trans ((x : A) -> B x) f g1 h p1 q) x)
        (P1.trans (B x) (f x) (g1 x) (h x) (P1.happly A B f g1 p1 x) (P1.happly A B g1 h q x)))
    (\ h q x -> idJ ((x1 : A) -> B x1) f (\ h1 q1 ->
        Id (Id (B x) (f x) (h1 x)) (P1.happly A B f h1 (P1.trans ((x1 : A) -> B x1) f f h1 (refl f) q1) x)
          (P1.trans (B x) (f x) (f x) (h1 x) (P1.happly A B f f (refl f) x) (P1.happly A B f h1 q1 x)))
      (refl (refl (f x))) h q) g p ;

module Over (ax : StoneAxioms[l,l].Assumptions) {
  module Cor511 (S : U l) (sS : PF.isStone S) {
    module Z = TrivG[intAb] ;
    -- (BZ)^S, pointed by the trivial family
    BZS : U l+ = S -> TorId[intAb].Tor ;
    triv : BZS = \ x -> Z.Atriv ;
    -- connected
    connected (alpha : BZS) : T1.Trunc[Id BZS alpha triv].carrier =
      TC1.map ((x : S) -> Id (TorId[intAb].Tor) (alpha x) Z.Atriv) (Id BZS alpha triv)
        (FL1.funext S (\ x -> TorId[intAb].Tor) alpha triv) (Lemma510[l].Over[ax].lemma510 S sS alpha) ;
    -- loops
    Loop : U l+ = Id BZS triv triv ;
    loop (p : Loop) (x : S) : Int = Z.tb Z.Atriv (P1.happly S (\ y -> TorId[intAb].Tor) triv triv p x) ;
    unloop (a : S -> Int) : Loop = FL1.funext S (\ y -> TorId[intAb].Tor) triv triv (\ x -> Z.tloop Z.Atriv (a x)) ;
    tb-tloop (a : Int) : Id Int (Z.tb Z.Atriv (Z.tloop Z.Atriv a)) a = (Z.tb-be Z.Atriv a).1.2 ;
    tloop-tb (lp : Id (TorId[intAb].Tor) Z.Atriv Z.Atriv) : Id (Id (TorId[intAb].Tor) Z.Atriv Z.Atriv)
        (Z.tloop Z.Atriv (Z.tb Z.Atriv lp)) lp =
      P1.ap ((q : Id (TorId[intAb].Tor) Z.Atriv Z.Atriv) * Id Int (Z.tb Z.Atriv q) (Z.tb Z.Atriv lp))
        (Id (TorId[intAb].Tor) Z.Atriv Z.Atriv) (\ z -> z.1)
        (Z.tb-be Z.Atriv (Z.tb Z.Atriv lp)).1 (lp, refl (Z.tb Z.Atriv lp))
        ((Z.tb-be Z.Atriv (Z.tb Z.Atriv lp)).2 (lp, refl (Z.tb Z.Atriv lp))) ;
    loop-unloop (a : S -> Int) : Id (S -> Int) (loop (unloop a)) a =
      Axioms[l].FunExtLemmas[fe @l].funext S (\ x -> Int) (loop (unloop a)) a (\ x -> transH
        (P1.ap (Id (TorId[intAb].Tor) Z.Atriv Z.Atriv) Int (Z.tb Z.Atriv)
          (P1.happly S (\ y -> TorId[intAb].Tor) triv triv (unloop a) x) (Z.tloop Z.Atriv (a x))
          (P1.happly S (\ x1 -> Id (TorId[intAb].Tor) Z.Atriv Z.Atriv)
            (P1.happly S (\ y -> TorId[intAb].Tor) triv triv (unloop a)) (\ x1 -> Z.tloop Z.Atriv (a x1))
            (FL1.happly-funext S (\ y -> TorId[intAb].Tor) triv triv (\ x1 -> Z.tloop Z.Atriv (a x1))) x))
        (tb-tloop (a x))) ;
    unloop-loop (p : Loop) : Id Loop (unloop (loop p)) p = P1.trans Loop (unloop (loop p))
      (FL1.funext S (\ y -> TorId[intAb].Tor) triv triv (P1.happly S (\ y -> TorId[intAb].Tor) triv triv p)) p
      (P1.ap ((x : S) -> Id (TorId[intAb].Tor) Z.Atriv Z.Atriv) Loop (FL1.funext S (\ y -> TorId[intAb].Tor) triv triv)
        (\ x -> Z.tloop Z.Atriv (loop p x)) (P1.happly S (\ y -> TorId[intAb].Tor) triv triv p)
        (FL1.funext S (\ x -> Id (TorId[intAb].Tor) Z.Atriv Z.Atriv) (\ x -> Z.tloop Z.Atriv (loop p x))
          (P1.happly S (\ y -> TorId[intAb].Tor) triv triv p)
          (\ x -> tloop-tb (P1.happly S (\ y -> TorId[intAb].Tor) triv triv p x))))
      (FL1.funext-happly S (\ y -> TorId[intAb].Tor) triv triv p) ;
    -- the loops at the trivial family are Z^S
    loop-equiv : P1.isEquiv Loop (S -> Int) loop = P1.qinv Loop (S -> Int) loop unloop loop-unloop unloop-loop ;
    loop-hom (p q : Loop) : Id (S -> Int) (loop (P1.trans BZS triv triv triv p q)) (\ x -> add (loop p x) (loop q x)) =
      Axioms[l].FunExtLemmas[fe @l].funext S (\ x -> Int) (loop (P1.trans BZS triv triv triv p q))
        (\ x -> add (loop p x) (loop q x)) (\ x -> transH
          (P1.ap (Id (TorId[intAb].Tor) Z.Atriv Z.Atriv) Int (Z.tb Z.Atriv)
            (P1.happly S (\ y -> TorId[intAb].Tor) triv triv (P1.trans BZS triv triv triv p q) x)
            (P1.trans (TorId[intAb].Tor) Z.Atriv Z.Atriv Z.Atriv (P1.happly S (\ y -> TorId[intAb].Tor) triv triv p x)
              (P1.happly S (\ y -> TorId[intAb].Tor) triv triv q x))
            (happly-trans S (\ y -> TorId[intAb].Tor) triv triv p triv q x))
          (Z.tb-hom Z.Atriv (P1.happly S (\ y -> TorId[intAb].Tor) triv triv p x)
            (P1.happly S (\ y -> TorId[intAb].Tor) triv triv q x))) ;
  } ;
} ;
