-- Propositions, identity types and truncation commute with sequential
-- colimits (for sets; [18] Thm 7.4, Cor 7.7, as used in SSD §2.1).
--   A colimit of propositions is a proposition: inc n p and inc n' p' meet
--   at stage n' + n = n + n'.  So it is the proposition "some P n holds".
--   For a sequence of sets and x y : S n, inc n x = inc n y iff
--   shift d x = shift d y for some d: a meeting iter d (n, x) = iter e (n, y)
--   has d = e (equal stages); this is the colimit of the propositions
--   shift d x = shift d y (identity types commute).
--   || colim S || is the colimit of the || S n ||: both are propositions,
--   and each implies the other.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open NatArith[l] ; open Bijection[l] ; open SeqColim[l] ; open SeqMaps[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;

module PropColim (P : Seq) (prop : (n : Nat) -> isProp (P.A n)) {
  module C = Colim[P] ;
  is-prop : isProp C.colim = C.prop-on-inc (\ n x n' x' ->
    C.meets (n, x) (n', x') (Tr.Trunc[C.Meet[(n, x),(n', x')]].inc (new C.Meet[(n, x), (n', x'), n', n,
      Sigma-path Nat P.A (plus n' n) (plus n n') (C.shift n' n x) (C.shift n n' x') (plus-comm n' n)
        (prop (plus n n') (subst Nat P.A (plus n' n) (plus n n') (plus-comm n' n) (C.shift n' n x)) (C.shift n n' x'))]))) ;
  Some : U l = Tr.Trunc[C.Tot].carrier ;
  equiv : Equiv C.colim Some = prop-equiv C.colim Some is-prop Tr.Trunc[C.Tot].proposition
    (C.induction @l (\ c -> Some) (\ c -> Tr.Trunc[C.Tot].proposition) (\ n x -> Tr.Trunc[C.Tot].inc (n, x)))
    (TC.rec C.Tot @l C.colim is-prop C.Q.inc) ;
} ;

module IdColim (S : Seq) (sets : (n : Nat) -> isSet (S.A n)) (n : Nat) (x y : S.A n) {
  module C = Colim[S] ;
  ids : Seq = new Seq[\ d -> Id (S.A (plus d n)) (C.shift d n x) (C.shift d n y), \ d p -> apH (S.f (plus d n)) p] ;
  module PI = PropColim[ids, \ d -> sets (plus d n) (C.shift d n x) (C.shift d n y)] ;
  -- (n, x) and (n, y) can only meet at d = e
  same (m : C.Meet[(n, x),(n, y)]) : PI.C.Tot = C.stage-meet n x y m ;
  to (p : Id C.colim (C.inc n x) (C.inc n y)) : PI.Some =
    TC.map C.Meet[(n, x),(n, y)] PI.C.Tot same (C.effective (n, x) (n, y) p) ;
  from (s : PI.Some) : Id C.colim (C.inc n x) (C.inc n y) =
    TC.rec PI.C.Tot @l (Id C.colim (C.inc n x) (C.inc n y)) (C.set (C.inc n x) (C.inc n y)) (\ w -> calc C.colim {
      C.inc n x =< symH (C.inc-iter w.1 (n, x)) > C.inc (plus w.1 n) (C.shift w.1 n x)
        =< apH (C.inc (plus w.1 n)) w.2 > C.inc (plus w.1 n) (C.shift w.1 n y)
        =< C.inc-iter w.1 (n, y) > C.inc n y }) s ;
  equiv : Equiv (Id C.colim (C.inc n x) (C.inc n y)) PI.C.colim =
    Equivalences[l].compose (Id C.colim (C.inc n x) (C.inc n y)) PI.Some PI.C.colim
      (prop-equiv (Id C.colim (C.inc n x) (C.inc n y)) PI.Some (C.set (C.inc n x) (C.inc n y)) Tr.Trunc[PI.C.Tot].proposition to from)
      (inverse PI.C.colim PI.Some PI.equiv) ;
} ;

module TruncColim (S : Seq) {
  module C = Colim[S] ;
  trs : Seq = new Seq[\ n -> Tr.Trunc[S.A n].carrier, \ n -> TC.map (S.A n) (S.A (suc n)) (S.f n)] ;
  module PT = PropColim[trs, \ n -> Tr.Trunc[S.A n].proposition] ;
  module R = C.Rec[PT.C.colim, prop-to-set PT.C.colim PT.is-prop, new C.Cocone[PT.C.colim,
    \ n x -> PT.C.inc n (Tr.Trunc[S.A n].inc x), \ n x -> PT.is-prop _ _]] ;
  to : Tr.Trunc[C.colim].carrier -> PT.C.colim = TC.rec C.colim @l PT.C.colim PT.is-prop R.map ;
  from (c : PT.C.colim) : Tr.Trunc[C.colim].carrier =
    PT.C.induction @l (\ c -> Tr.Trunc[C.colim].carrier) (\ c -> Tr.Trunc[C.colim].proposition)
      (\ n t -> TC.map (S.A n) C.colim (C.inc n) t) c ;
  equiv : Equiv Tr.Trunc[C.colim].carrier PT.C.colim =
    prop-equiv Tr.Trunc[C.colim].carrier PT.C.colim Tr.Trunc[C.colim].proposition PT.is-prop to from ;
} ;
