-- Addition on the natural numbers of Base (Ring.seg has its own Nat), by
-- recursion on the first argument: plus zero n = n, plus (suc m) n = suc (plus m n).
level l ;
open Base ; open Paths[l] ;

plus : Nat -> Nat -> Nat = split {
  zero -> \ n -> n ;
  suc m | r -> \ n -> suc (r n) } ;

plus-zero : (m : Nat) -> Id Nat (plus m zero) m = split {
  zero -> refl zero ;
  suc m | r -> apH (\ k -> suc k) r } ;
plus-suc : (m n : Nat) -> Id Nat (plus m (suc n)) (suc (plus m n)) = split {
  zero -> \ n -> refl (suc n) ;
  suc m | r -> \ n -> apH (\ k -> suc k) (r n) } ;
plus-comm : (m n : Nat) -> Id Nat (plus m n) (plus n m) = split {
  zero -> \ n -> symH (plus-zero n) ;
  suc m | r -> \ n -> transH (apH (\ k -> suc k) (r n)) (symH (plus-suc n m)) } ;
plus-assoc : (a b c : Nat) -> Id Nat (plus (plus a b) c) (plus a (plus b c)) = split {
  zero -> \ b c -> refl (plus b c) ;
  suc a | r -> \ b c -> apH (\ k -> suc k) (r b c) } ;

pred : Nat -> Nat = split { zero -> zero ; suc n -> n } ;
suc-inj {m n : Nat} (p : Id Nat (suc m) (suc n)) : Id Nat m n = apH pred p ;

-- cancellation, on the left by induction, on the right by commutativity
plus-cancel-l : (n : Nat) (a b : Nat) -> Id Nat (plus n a) (plus n b) -> Id Nat a b = split {
  zero -> \ a b p -> p ;
  suc n | r -> \ a b p -> r a b (suc-inj p) } ;
plus-cancel-r (n a b : Nat) (p : Id Nat (plus a n) (plus b n)) : Id Nat a b =
  plus-cancel-l n a b (transH (plus-comm n a) (transH p (plus-comm b n))) ;

-- Nat is a set (Hedberg, with the code of equality)
code : Nat -> Nat -> U l = split {
  zero -> split { zero -> Top ; suc n -> Empty } ;
  suc m | r -> split { zero -> Empty ; suc n -> r n } } ;
code-prop : (m n : Nat) -> Prelude[l].isProp (code m n) = split {
  zero -> split { zero -> isTop ; suc n -> Prelude[l].isProp-Empty } ;
  suc m | r -> split { zero -> Prelude[l].isProp-Empty ; suc n -> r n } } ;
code-refl : (m : Nat) -> code m m = split { zero -> tt ; suc m | r -> r } ;
code-eq : (m n : Nat) -> code m n -> Id Nat m n = split {
  zero -> split { zero -> \ h -> refl zero ; suc n -> \ h -> Prelude[l].absurd (Id Nat zero (suc n)) h } ;
  suc m | r -> split { zero -> \ h -> Prelude[l].absurd (Id Nat (suc m) zero) h ;
                       suc n -> \ h -> apH (\ k -> suc k) (r n h) } } ;
nat-set : Prelude[l].isSet Nat = \ m -> Prelude[l].Hedberg[Nat,m,code m,code-prop m,code-refl m,code-eq m].hedberg ;

-- the order: n <= k when a + n = k for some a (a is unique by cancellation)
Le (n k : Nat) : U l = (a : Nat) * Id Nat (plus a n) k ;
le-refl (n : Nat) : Le n n = (zero, refl n) ;
le-trans (n k m : Nat) (h : Le n k) (h' : Le k m) : Le n m =
  (plus h'.1 h.1, transH (plus-assoc h'.1 h.1 n) (transH (apH (plus h'.1) h.2) h'.2)) ;
-- n + k bounds n and k
le-sum-r (n k : Nat) : Le n (plus k n) = (k, refl (plus k n)) ;
le-sum-l (n k : Nat) : Le k (plus k n) = (n, plus-comm n k) ;
le-prop (n k : Nat) : Prelude[l].isProp (Le n k) = \ h h' ->
  Prelude[l].Sigma-eq Nat (\ a -> Id Nat (plus a n) k) h.1 h'.1 h.2 h'.2
    (plus-cancel-r n h.1 h'.1 (transH h.2 (symH h'.2))) (nat-set (plus h'.1 n) k) ;
