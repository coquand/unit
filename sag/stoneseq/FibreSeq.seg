-- A map of inverse sequences of finite sets g : E -> G, seen as a family
-- over G: the family of fibres (used for SSD Lemmas 5.8, 5.9).
--
--  - The fibres fib k y of g k form a family over the inverse sequence G
--    (Fib): u = (e, h) |-> (p e, (c e)^-1 . q h), where c is the square of g.
--  - The fibres of the limit map  lim g : lim E -> lim G  form a cone over
--    it (cone): a point (a, h) of the fibre over x goes to (a k, h at k);
--    compatibility holds on first components (fib-subst, then a.2 k).
--  - The fibre products E2 k, E3 k of g k form inverse sequences SE2, SE3;
--    a point w of lim SE2 gives a point of the fibre product of lim g
--    (Two[w].point: the two components, equal images by lim-eq), and every
--    point z of that fibre product arises so (Section2: build w from the
--    components of z; Two[w].point = z by e2-eq and lim-eq).  The same for
--    SE3 (Three).
--  - All the fibres and fibre products are finite (Sigma and identity types
--    of finite sets, FiniteClosure).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Finite[l] ; open FiniteClosure[l] ; open DependentChoice[l] ;
open SeqLim[l] ; open FibrePairs[l] ;

module Fibres (SE SG : InvSeq) (H : InvMap[SE, SG]) (finE : (k : Nat) -> isFinite (SE.E k))
  (finG : (k : Nat) -> isFinite (SG.E k)) {
  sE (k : Nat) : isSet (SE.E k) = finite-set (SE.E k) (finE k) ;
  sG (k : Nat) : isSet (SG.E k) = finite-set (SG.E k) (finG k) ;
  module P (k : Nat) { module Q = Pairs[SE.E k, SG.E k, sG k, H.h k] ; } ;

  -- the family of fibres
  Fib : Family[SG] = new Family[SG, \ k y -> P[k].Q.fib y,
    \ k y u -> (SE.p k u.1, transH (symH (H.c k u.1)) (apH (SG.p k) u.2))] ;
  fib-finite (k : Nat) (y : SG.E k) : isFinite (P[k].Q.fib y) =
    sigma-finite (SE.E k) (finE k) (\ e -> Id (SG.E k) (H.h k e) y) (\ e -> id-finite (SG.E k) (finG k) (H.h k e) y) ;

  -- the fibres of the limit map form a cone
  module PL = Pairs[Limit[SE].lim, Limit[SG].lim, Limit[SG].Sets[sG].set, lim-map SE SG H] ;
  pr (k : Nat) (x : Limit[SG].lim) (u : PL.fib x) : P[k].Q.fib (x.1 k) = (u.1.1 k, apH (\ z -> z.1 k) u.2) ;
  cone : Cone[SG, Fib] = new Cone[SG, Fib, PL.fib, pr, \ k x u ->
    P[k].Q.fib-eq (x.1 k) (subst (SG.E k) (\ y -> P[k].Q.fib y) (SG.p k (x.1 (suc k))) (x.1 k) (x.2 k)
        (Fib.q k (x.1 (suc k)) (pr (suc k) x u))) (pr k x u)
      (transH (P[k].Q.fib-subst (SG.p k (x.1 (suc k))) (x.1 k) (x.2 k) (Fib.q k (x.1 (suc k)) (pr (suc k) x u)))
        (u.1.2 k))] ;

  -- fibre products of the stages
  path2 (k : Nat) (w : P[suc k].Q.E2) : Id (SG.E k) (H.h k (SE.p k w.1)) (H.h k (SE.p k w.2.1)) =
    transH (symH (H.c k w.1)) (transH (apH (SG.p k) w.2.2) (H.c k w.2.1)) ;
  p2 (k : Nat) (w : P[suc k].Q.E2) : P[k].Q.E2 = (SE.p k w.1, SE.p k w.2.1, path2 k w) ;
  SE2 : InvSeq = new InvSeq[\ k -> P[k].Q.E2, p2] ;
  path3a (k : Nat) (w : P[suc k].Q.E3) : Id (SG.E k) (H.h k (SE.p k w.1)) (H.h k (SE.p k w.2.2.1)) =
    transH (symH (H.c k w.1)) (transH (apH (SG.p k) w.2.2.2.1) (H.c k w.2.2.1)) ;
  path3b (k : Nat) (w : P[suc k].Q.E3) : Id (SG.E k) (H.h k (SE.p k w.2.1)) (H.h k (SE.p k w.2.2.1)) =
    transH (symH (H.c k w.2.1)) (transH (apH (SG.p k) w.2.2.2.2) (H.c k w.2.2.1)) ;
  p3 (k : Nat) (w : P[suc k].Q.E3) : P[k].Q.E3 = (SE.p k w.1, SE.p k w.2.1, SE.p k w.2.2.1, path3a k w, path3b k w) ;
  SE3 : InvSeq = new InvSeq[\ k -> P[k].Q.E3, p3] ;
  e2-finite (k : Nat) : isFinite (P[k].Q.E2) =
    sigma-finite (SE.E k) (finE k) (\ e -> (e' : SE.E k) * Id (SG.E k) (H.h k e) (H.h k e')) (\ e ->
      sigma-finite (SE.E k) (finE k) (\ e' -> Id (SG.E k) (H.h k e) (H.h k e')) (\ e' ->
        id-finite (SG.E k) (finG k) (H.h k e) (H.h k e'))) ;
  e3-finite (k : Nat) : isFinite (P[k].Q.E3) =
    sigma-finite (SE.E k) (finE k)
      (\ e -> (e' : SE.E k) * (e'' : SE.E k) * (Id (SG.E k) (H.h k e) (H.h k e'') * Id (SG.E k) (H.h k e') (H.h k e''))) (\ e ->
    sigma-finite (SE.E k) (finE k)
      (\ e' -> (e'' : SE.E k) * (Id (SG.E k) (H.h k e) (H.h k e'') * Id (SG.E k) (H.h k e') (H.h k e''))) (\ e' ->
    sigma-finite (SE.E k) (finE k) (\ e'' -> Id (SG.E k) (H.h k e) (H.h k e'') * Id (SG.E k) (H.h k e') (H.h k e'')) (\ e'' ->
    sigma-finite (Id (SG.E k) (H.h k e) (H.h k e'')) (id-finite (SG.E k) (finG k) (H.h k e) (H.h k e''))
      (\ h -> Id (SG.E k) (H.h k e') (H.h k e'')) (\ h -> id-finite (SG.E k) (finG k) (H.h k e') (H.h k e''))))) ;

  -- points of lim SE2 and of the fibre product of the limit map
  module Two (w : Limit[SE2].lim) {
    a : Limit[SE].lim = (\ k -> (w.1 k).1, \ k -> apH (\ z -> z.1) (w.2 k)) ;
    a' : Limit[SE].lim = (\ k -> (w.1 k).2.1, \ k -> apH (\ z -> z.2.1) (w.2 k)) ;
    same : Id (Limit[SG].lim) (lim-map SE SG H a) (lim-map SE SG H a') =
      Limit[SG].Sets[sG].lim-eq (lim-map SE SG H a) (lim-map SE SG H a') (\ k -> (w.1 k).2.2) ;
    point : PL.E2 = (a, a', same) ;
  } ;
  module Section2 (z : PL.E2) {
    stage (k : Nat) : P[k].Q.E2 = (z.1.1 k, z.2.1.1 k, apH (\ y -> y.1 k) z.2.2) ;
    w : Limit[SE2].lim = (stage, \ k -> P[k].Q.e2-eq (SE.p k (z.1.1 (suc k))) (SE.p k (z.2.1.1 (suc k)))
      (z.1.1 k) (z.2.1.1 k) (path2 k (stage (suc k))) (stage k).2.2 (z.1.2 k) (z.2.1.2 k)) ;
    back : Id PL.E2 (Two[w].point) z = PL.e2-eq Two[w].a Two[w].a' z.1 z.2.1 Two[w].same z.2.2
      (Limit[SE].Sets[sE].lim-eq Two[w].a z.1 (\ k -> refl (z.1.1 k)))
      (Limit[SE].Sets[sE].lim-eq Two[w].a' z.2.1 (\ k -> refl (z.2.1.1 k))) ;
  } ;
  module Three (w : Limit[SE3].lim) {
    a : Limit[SE].lim = (\ k -> (w.1 k).1, \ k -> apH (\ z -> z.1) (w.2 k)) ;
    a' : Limit[SE].lim = (\ k -> (w.1 k).2.1, \ k -> apH (\ z -> z.2.1) (w.2 k)) ;
    a'' : Limit[SE].lim = (\ k -> (w.1 k).2.2.1, \ k -> apH (\ z -> z.2.2.1) (w.2 k)) ;
    same1 : Id (Limit[SG].lim) (lim-map SE SG H a) (lim-map SE SG H a'') =
      Limit[SG].Sets[sG].lim-eq (lim-map SE SG H a) (lim-map SE SG H a'') (\ k -> (w.1 k).2.2.2.1) ;
    same2 : Id (Limit[SG].lim) (lim-map SE SG H a') (lim-map SE SG H a'') =
      Limit[SG].Sets[sG].lim-eq (lim-map SE SG H a') (lim-map SE SG H a'') (\ k -> (w.1 k).2.2.2.2) ;
    point : PL.E3 = (a, a', a'', same1, same2) ;
  } ;
} ;
