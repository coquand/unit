-- SSD Theorem 5.16, vanishing form: for a Čech cover (X, S) (each S x
-- merely inhabited, (x : X) * S x Stone),
--   H^1 (X, Z) = 0  iff  Ȟ^1 (X, S, Z) = 0
-- (CohZero, Cech.H1Zero).  Not the paper's proof (Lemmas 5.13-5.15): we use
-- the torsor of a cocycle (pn/Torsor, SAG Lemma 7.4.2).
--
--  - A path p : alpha = * gives a point of the torsor alpha: the image of
--    0 under the isomorphism * = alpha (point-of).
--  - <= (coh-of-cech): given alpha : X -> BZ, Lemma 5.10 on (x : X) * S x
--    merely trivialises alpha over each point of S x, giving points beta x s
--    of alpha x; with Ȟ^1 (X, S, Z) = 0, Lemma 5.7 gives alpha = *.
--  - => (cech-of-coh): a cocycle b gives at each x the Z-torsor psi (b x)
--    of maps v : S x -> Z with v m = v k + b x k m (Tors.psi; S x is merely
--    inhabited).  If all these torsors are merely trivial, a choice of
--    points v x is a cochain with d0 v = b (solve the condition for b).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Torsor[l] ; open TorsorCocycles[l] ; open TorsorId[l] ; open TrivialGerbe[l] ;
open Integers[l] ; open CechComplex[l] ;
module Tr = Truncation[l] ;
module P1 = Prelude[l+] ;
module T1 = Truncation[l+] ; module TC1 = TruncationCombinators[l+] ;
module PF = Profinite[l,l] ;

module Over (ax : StoneAxioms[l,l].Assumptions) {
  module Z = TrivG[intAb] ;
  point-of (Y : TorId[intAb].Tor) (p : Id (TorId[intAb].Tor) Y Z.Atriv) : Y.1 =
    (TorId[intAb].idtohom Z.Atriv Y (P1.sym (TorId[intAb].Tor) Y Z.Atriv p)).1 zeroZ ;

  module Cover (X : U l) (S : X -> U l) (inh : (x : X) -> Tr.Trunc[S x].carrier) (sS : PF.isStone ((x : X) * S x)) {
    module C = Cech[X, S, \ x -> intAb] ;

    -- <=
    module Local (alpha : (x : X) -> TorId[intAb].Tor) (h1 : C.H1Zero)
      (p : (w : (x : X) * S x) -> Id (TorId[intAb].Tor) (alpha w.1) Z.Atriv) {
      beta (x : X) (s : S x) : (alpha x).1 = point-of (alpha x) (p (x, s)) ;
      result : T1.Trunc[(x : X) -> Id (TorId[intAb].Tor) (alpha x) Z.Atriv].carrier =
        Lemma57[X, S, inh, \ x -> intAb, h1, alpha, beta].result ;
    } ;
    coh-of-cech (h1 : C.H1Zero) : CohZero X (\ x -> intAb) = \ alpha ->
      TC1.rec ((w : (x : X) * S x) -> Id (TorId[intAb].Tor) (alpha w.1) Z.Atriv) @(l+)
        (T1.Trunc[(x : X) -> Id (TorId[intAb].Tor) (alpha x) Z.Atriv].carrier)
        T1.Trunc[(x : X) -> Id (TorId[intAb].Tor) (alpha x) Z.Atriv].proposition
        (\ p -> Local[alpha, h1, p].result)
        (Lemma510[l].Over[ax].lemma510 ((x : X) * S x) sS (\ w -> alpha w.1)) ;

    -- =>
    module Glue (b : C.C1) (cb : C.Cocycle b) {
      module Tx (x : X) { module M = Tors[intAb, S x, inh x].PsiM[(b x, cb x)] ; } ;
      alpha (x : X) : TorId[intAb].Tor = (Tx[x].M.Tc, Tx[x].M.str) ;
      module Trivial (p : (x : X) -> Id (TorId[intAb].Tor) (alpha x) Z.Atriv) {
        v (x : X) : Tx[x].M.Tc = point-of (alpha x) (p x) ;
        a : C.C0 = \ x u -> (v x).1 u ;
        bounds : C.Bounds b a = \ x u w -> AbL[intAb].solve (b x u w) ((v x).1 u) ((v x).1 w)
          (transH (comm (b x u w) ((v x).1 u)) (symH ((v x).2 u w))) ;
      } ;
    } ;
    cech-of-coh (h : CohZero X (\ x -> intAb)) : C.H1Zero = \ b cb ->
      TC1.rec ((x : X) -> Id (TorId[intAb].Tor) (Glue[b, cb].alpha x) Z.Atriv) @l (C.Coboundary b)
        Tr.Trunc[(a : C.C0) * C.Bounds b a].proposition
        (\ p -> Tr.Trunc[(a : C.C0) * C.Bounds b a].inc (Glue[b, cb].Trivial[p].a, Glue[b, cb].Trivial[p].bounds))
        (h (Glue[b, cb].alpha)) ;

    -- SSD Theorem 5.16 (vanishing form)
    theorem : (C.H1Zero -> CohZero X (\ x -> intAb)) * (CohZero X (\ x -> intAb) -> C.H1Zero) = (coh-of-cech, cech-of-coh) ;
  } ;
} ;
