-- Overtly discrete types (SSD Def. 2.1): sequential colimits of finite sets.
-- A presentation of X is a sequence of finite sets with X equivalent to its
-- colimit; X is overtly discrete when it merely has one.  (Remark 2.2: the
-- colimit is the set-level one of SeqColim.seg, so overtly discrete types
-- are sets.)
level l ;
open Base ; open Prelude[l] ; open SeqColim[l] ; open Finite[l] ;

record Pres (X : U l) {
  seq : Seq ;
  finite : (n : Nat) -> isFinite (seq.A n) ;
  equiv : Equiv X (Colim[seq].colim) ;
} ;
isODisc (X : U l) : U l+ = Truncation[l+].Trunc[Pres[X]].carrier ;
ODisc : U l+ = (X : U l) * isODisc X ;
