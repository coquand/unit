-- SSD Lemma 2.7: overtly discrete types are stable under propositional
-- truncation, identity types and Sigma types.  (Also: they are sets, and
-- the notion is invariant under equivalence.)
--
-- Proof.  Let X = colim S, S a sequence of finite sets.
--   || X || = || colim S || = colim || S n ||  (SeqProp), and || S n || is finite.
--   For a b : X, merely a = inc N x and b = inc N y at one stage N; then
--   a = b is the colimit of the  shift d x = shift d y  (SeqProp), identity
--   types of finite sets, hence finite.
--   For B over X with every B x overtly discrete: (x : X) * B x is the
--   colimit of the  (x : S n) * B (inc n x)  (SeqSigma), each a finite Sigma
--   of overtly discrete types, hence overtly discrete (choose presentations,
--   SigmaFamily, finite Sigmas of finite sets are finite); by Lemma 2.6 the
--   colimit is overtly discrete.  For a general X, move the statement along
--   X = colim S (univalence).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open SeqColim[l] ; open Bijection[l] ; open Finite[l] ;
open FiniteClosure[l] ; open SeqSigma[l] ; open SeqProp[l] ; open ODisc[l] ; open Lemma26[l] ; open CountableChoice[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module T1 = Truncation[l+] ; module TC1 = TruncationCombinators[l+] ;
module Eq = Equivalences[l] ; module To = Torsor[l] ;
module FL2 = Axioms[l+].FunExtLemmas[fe @(l+)] ;

pres-set (X : U l) (p : Pres[X]) : isSet X =
  isSet-retract X (Colim[p.seq].colim) p.equiv.1 p.equiv.2.sec (sec-ret X (Colim[p.seq].colim) p.equiv.1 p.equiv.2) (Colim[p.seq].set) ;
odisc-set (X : U l) (oX : isODisc X) : isSet X = TC1.rec (Pres[X]) @l (isSet X) (To.isProp-isSet X) (pres-set X) oX ;
pres-equiv (X Y : U l) (e : Equiv X Y) (p : Pres[Y]) : Pres[X] =
  new Pres[X, p.seq, p.finite, Eq.compose X Y (Colim[p.seq].colim) e p.equiv] ;
odisc-equiv (X Y : U l) (e : Equiv X Y) (oY : isODisc Y) : isODisc X = TC1.map (Pres[Y]) (Pres[X]) (pres-equiv X Y e) oY ;

-- truncation
module TruncPres (X : U l) (p : Pres[X]) {
  module TCo = TruncColim[p.seq] ;
  to-colim : Equiv Tr.Trunc[X].carrier Tr.Trunc[Colim[p.seq].colim].carrier =
    prop-equiv Tr.Trunc[X].carrier Tr.Trunc[Colim[p.seq].colim].carrier Tr.Trunc[X].proposition Tr.Trunc[Colim[p.seq].colim].proposition
      (TC.map X (Colim[p.seq].colim) p.equiv.1) (TC.map (Colim[p.seq].colim) X p.equiv.2.sec) ;
  pres : Pres[Tr.Trunc[X].carrier] = new Pres[Tr.Trunc[X].carrier, TCo.trs, \ n -> trunc-finite (p.seq.A n) (p.finite n),
    Eq.compose Tr.Trunc[X].carrier Tr.Trunc[Colim[p.seq].colim].carrier (Colim[TCo.trs].colim) to-colim TCo.equiv] ;
} ;
trunc-odisc (X : U l) (oX : isODisc X) : isODisc Tr.Trunc[X].carrier =
  TC1.map (Pres[X]) (Pres[Tr.Trunc[X].carrier]) (\ p -> TruncPres[X,p].pres) oX ;

-- identity types
module IdPres (X : U l) (p : Pres[X]) (a b : X) {
  S : Seq = p.seq ; module C = Colim[S] ;
  sets (n : Nat) : isSet (S.A n) = finite-set (S.A n) (p.finite n) ;
  to-colim : Equiv (Id X a b) (Id C.colim (p.equiv.1 a) (p.equiv.1 b)) =
    prop-equiv (Id X a b) (Id C.colim (p.equiv.1 a) (p.equiv.1 b)) (pres-set X p a b) (C.set (p.equiv.1 a) (p.equiv.1 b))
      (apH p.equiv.1) (Eq.injective X C.colim p.equiv.1 p.equiv.2 a b) ;
  -- a and b at one stage N
  module At (u v : C.Tot) (pu : Id C.colim (C.Q.inc u) (p.equiv.1 a)) (pv : Id C.colim (C.Q.inc v) (p.equiv.1 b)) {
    N : Nat = NatArith[l].plus v.1 u.1 ;
    x : S.A N = C.raise u.1 N (NatArith[l].le-sum-r u.1 v.1) u.2 ;
    y : S.A N = C.raise v.1 N (NatArith[l].le-sum-l u.1 v.1) v.2 ;
    px : Id C.colim (C.inc N x) (p.equiv.1 a) = transH (C.inc-raise u.1 N (NatArith[l].le-sum-r u.1 v.1) u.2) pu ;
    py : Id C.colim (C.inc N y) (p.equiv.1 b) = transH (C.inc-raise v.1 N (NatArith[l].le-sum-l u.1 v.1) v.2) pv ;
    to-stage : Equiv (Id C.colim (p.equiv.1 a) (p.equiv.1 b)) (Id C.colim (C.inc N x) (C.inc N y)) =
      prop-equiv (Id C.colim (p.equiv.1 a) (p.equiv.1 b)) (Id C.colim (C.inc N x) (C.inc N y))
        (C.set (p.equiv.1 a) (p.equiv.1 b)) (C.set (C.inc N x) (C.inc N y))
        (\ q -> transH px (transH q (symH py))) (\ q -> transH (symH px) (transH q py)) ;
    module IC = IdColim[S, sets, N, x, y] ;
    pres : Pres[Id X a b] = new Pres[Id X a b, IC.ids,
      \ d -> id-finite (S.A (NatArith[l].plus d N)) (p.finite (NatArith[l].plus d N)) (C.shift d N x) (C.shift d N y),
      Eq.compose (Id X a b) (Id C.colim (C.inc N x) (C.inc N y)) (Colim[IC.ids].colim)
        (Eq.compose (Id X a b) (Id C.colim (p.equiv.1 a) (p.equiv.1 b)) (Id C.colim (C.inc N x) (C.inc N y)) to-colim to-stage)
        IC.equiv] ;
  } ;
  result : isODisc (Id X a b) =
    TC.rec ((u : C.Tot) * Id C.colim (C.Q.inc u) (p.equiv.1 a)) @(l+) (isODisc (Id X a b)) T1.Trunc[Pres[Id X a b]].proposition (\ wu ->
      TC.rec ((v : C.Tot) * Id C.colim (C.Q.inc v) (p.equiv.1 b)) @(l+) (isODisc (Id X a b)) T1.Trunc[Pres[Id X a b]].proposition (\ wv ->
        T1.Trunc[Pres[Id X a b]].inc (At[wu.1, wv.1, wu.2, wv.2].pres)) (C.inc-surj (p.equiv.1 b))) (C.inc-surj (p.equiv.1 a)) ;
} ;
id-odisc (X : U l) (oX : isODisc X) (a b : X) : isODisc (Id X a b) =
  TC1.bind (Pres[X]) (Pres[Id X a b]) (\ p -> IdPres[X,p,a,b].result) oX ;

-- Sigma types
sigma-fibre (A : U l) (B C : A -> U l) (e : (a : A) -> Equiv (B a) (C a)) : Equiv ((a : A) * B a) ((a : A) * C a) =
  (\ w -> (w.1, (e w.1).1 w.2), qinv ((a : A) * B a) ((a : A) * C a) (\ w -> (w.1, (e w.1).1 w.2)) (\ w -> (w.1, (e w.1).2.sec w.2))
    (\ w -> apH (\ c -> (w.1, c)) ((e w.1).2.sec-eq w.2))
    (\ w -> apH (\ b -> (w.1, b)) (sec-ret (B w.1) (C w.1) (e w.1).1 (e w.1).2 w.2))) ;
-- a finite Sigma of overtly discrete types
module FinSigma (F : U l) (fF : isFinite F) (B : F -> U l) (oB : (i : F) -> isODisc (B i)) {
  module Given (P : (i : F) -> Pres[B i]) {
    module SF = SigmaFamily[F, finite-set F fF, \ i -> (P i).seq] ;
    pres : Pres[(i : F) * B i] = new Pres[(i : F) * B i, SF.seq,
      \ n -> sigma-finite F fF (\ i -> (P i).seq.A n) (\ i -> (P i).finite n),
      Eq.compose ((i : F) * B i) ((i : F) * Colim[(P i).seq].colim) (Colim[SF.seq].colim)
        (sigma-fibre F B (\ i -> Colim[(P i).seq].colim) (\ i -> (P i).equiv))
        (inverse (Colim[SF.seq].colim) ((i : F) * Colim[(P i).seq].colim) SF.equiv)] ;
  } ;
  result : isODisc ((i : F) * B i) =
    TC1.map ((i : F) -> Pres[B i]) (Pres[(i : F) * B i]) (\ P -> Given[P].pres) (Up.choice-up F fF (\ i -> Pres[B i]) oB) ;
} ;
SigmaODisc (X : U l) : U l+ = (B : X -> U l) -> ((x : X) -> isODisc (B x)) -> isODisc ((x : X) * B x) ;
sigma-odisc-prop (X : U l) : Prelude[l+].isProp (SigmaODisc X) =
  FL2.isProp-Pi (X -> U l) (\ B -> ((x : X) -> isODisc (B x)) -> isODisc ((x : X) * B x)) (\ B ->
    FL2.isProp-Pi ((x : X) -> isODisc (B x)) (\ oB -> isODisc ((x : X) * B x)) (\ oB -> T1.Trunc[Pres[(x : X) * B x]].proposition)) ;
-- over a colimit of finite sets: Sigma commutes with the colimit, then Lemma 2.6
module SigmaOverColim (cc : CC) (dc : DependentChoice[l+].DC) (S : Seq) (finS : (n : Nat) -> isFinite (S.A n)) {
  module C = Colim[S] ;
  module Fam (B : C.colim -> U l) (oB : (c : C.colim) -> isODisc (B c)) {
    module SC = SigmaColim[S, B, \ c -> odisc-set (B c) (oB c)] ;
    terms (n : Nat) : isODisc (SC.seq.A n) =
      FinSigma[S.A n, finS n, \ x -> B (C.inc n x), \ x -> oB (C.inc n x)].result ;
    result : isODisc ((c : C.colim) * B c) =
      odisc-equiv ((c : C.colim) * B c) (Colim[SC.seq].colim) (inverse (Colim[SC.seq].colim) ((c : C.colim) * B c) SC.equiv)
        (Lemma26[l].Lemma26[cc, dc, SC.seq, terms].theorem) ;
  } ;
  statement : SigmaODisc C.colim = \ B oB -> Fam[B, oB].result ;
} ;
sigma-odisc (cc : CC) (dc : DependentChoice[l+].DC) (X : U l) (oX : isODisc X) : SigmaODisc X =
  TC1.rec (Pres[X]) @(l+) (SigmaODisc X) (sigma-odisc-prop X) (\ p ->
    To.eqind (Colim[p.seq].colim) (\ X1 e -> SigmaODisc X1) (SigmaOverColim[cc, dc, p.seq, p.finite].statement)
      X (inverse X (Colim[p.seq].colim) p.equiv)) oX ;
