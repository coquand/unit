-- SSD Lemma 5.9 for the fibres of a limit of surjections of finite sets:
-- for g : E -> G a map of inverse sequences of finite sets with every g k
-- surjective,  Ȟ^1 (lim G, fibres of lim g, Z) = 0.
--
-- Proof.  The family of fibres of g k over G k is finite and inhabited, and
-- the fibres of lim g form a cone over it (FibreSeq), so the generic
-- Lemma 5.9 applies once Phi 1 is surjective and Phi 2 injective.  For these
-- we use SSD Corollary 3.7 (worker A, N-valued) on the fibre products:
--  - tau1 identifies the stage C1 (Čech group of (G k, fib, Z)) with the
--    N-valued maps on E2 k, naturally in k (nat1: move2 along the square of
--    g); this is a map of sequences T1 with each tau1 surjective (untau1);
--  - Theta1 b = tau1 b o Two.point identifies C1 of the limit with N-valued
--    maps on lim SE2: it is injective (tau1 is, and every point of the
--    fibre product of lim g is a Two.point, Section2);
--  - the square  Theta1 o Phi1 = phi o (map of T1)  holds on each inc k b
--    (square1: both sides are b at the k-th components, move2).
--  Surjective: Theta1 c = phi u (Cor 3.7), u = T1 v (T1 levelwise onto),
--  so Theta1 (Phi1 v) = Theta1 c and Phi1 v = c.
--  Injective: likewise with tau2, E3, Theta2 and square2, using that phi
--  (Cor 3.7) and the map of T2 (tau2 levelwise injective) are injective.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Integers[l] ; open Bijection[l] ; open DependentChoice[l] ;
open Finite[l] ; open SeqColim[l] ; open SeqMaps[l] ; open SeqLim[l] ; open FibrePairs[l] ; open FibreSeq[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;

module Over (ax : StoneAxioms[l,l].Assumptions) {
 module Lemma59Fibres (SE SG : InvSeq) (H : InvMap[SE, SG]) (finE : (k : Nat) -> isFinite (SE.E k))
   (finG : (k : Nat) -> isFinite (SG.E k)) (surj : (k : Nat) -> Surjective (H.h k)) {
  module Fi = Fibres[SE, SG, H, finE, finG] ;
  module L = Lemma59[l].Lemma59[SG, Fi.Fib, intAb, finG, surj, Fi.cone] ;

  -- C1: the stages, the limit, the square
  module M2 = Cor37[l,l].Maps[Fi.SE2.E, Fi.SE2.p] ;
  module C37a = Cor37[l,l].Over[ax].Cor37[Fi.SE2.E, Fi.SE2.p, Fi.e2-finite] ;
  -- tau1 commutes with the steps (move2 along the square of g); restriction
  -- along the family of fibres is  b |-> step k b  (as in Lemma59.seq1)
  step (k : Nat) (b : Fi.P[k].Q.C1) : Fi.P[suc k].Q.C1 = \ y u v -> b (SG.p k y) (Fi.Fib.q k y u) (Fi.Fib.q k y v) ;
  nat1-at (k : Nat) (b : Fi.P[k].Q.C1) (w : Fi.SE2.E (suc k)) :
      Id Nat (Fi.P[k].Q.tau1 b (Fi.p2 k w)) (Fi.P[suc k].Q.tau1 (step k b) w) =
    apH toNat (Fi.P[k].Q.move2 b (H.h k (SE.p k w.2.1)) (SG.p k (H.h (suc k) w.2.1)) (symH (H.c k w.2.1))
      (SE.p k w.1, Fi.path2 k w) (Fi.P[k].Q.pt (SE.p k w.2.1))
      (Fi.Fib.q k (H.h (suc k) w.2.1) (w.1, w.2.2)) (Fi.Fib.q k (H.h (suc k) w.2.1) (Fi.P[suc k].Q.pt w.2.1))
      (refl (SE.p k w.1)) (refl (SE.p k w.2.1))) ;
  nat1 (k : Nat) (b : L.seq1.A k) : Id (Fi.SE2.E (suc k) -> Nat) (M2.seq.f k (Fi.P[k].Q.tau1 b))
      (Fi.P[suc k].Q.tau1 (L.seq1.f k b)) =
    FL.funext (Fi.SE2.E (suc k)) (\ w -> Nat) (M2.seq.f k (Fi.P[k].Q.tau1 b)) (Fi.P[suc k].Q.tau1 (L.seq1.f k b)) (nat1-at k b) ;
  T1 : SeqMap[L.seq1, M2.seq] = new SeqMap[L.seq1, M2.seq, \ k b -> Fi.P[k].Q.tau1 b, nat1] ;
  module I1 = Induced[L.seq1, M2.seq, T1] ;
  Theta1 (b : L.CI.C1) (w : Limit[Fi.SE2].lim) : Nat = Fi.PL.tau1 b (Fi.Two[w].point) ;
  theta1-injective : Injective Theta1 = \ b b' q -> Fi.PL.tau1-injective b b'
    (FL.funext Fi.PL.E2 (\ z -> Nat) (Fi.PL.tau1 b) (Fi.PL.tau1 b') (\ z -> calc Nat {
      Fi.PL.tau1 b z =< apH (Fi.PL.tau1 b) (symH (Fi.Section2[z].back)) > Theta1 b (Fi.Section2[z].w)
        =< happly (Limit[Fi.SE2].lim) (\ w -> Nat) (Theta1 b) (Theta1 b') q (Fi.Section2[z].w) > Theta1 b' (Fi.Section2[z].w)
        =< apH (Fi.PL.tau1 b') (Fi.Section2[z].back) > Fi.PL.tau1 b' z })) ;
  square1 (c : L.EC.CB.colim) : Id (M2.Lim -> Nat) (Theta1 (L.Phi1 c)) (M2.phi (I1.map c)) =
    L.EC.CB.ext (M2.Lim -> Nat) M2.fun-set (\ c1 -> Theta1 (L.Phi1 c1)) (\ c1 -> M2.phi (I1.map c1)) (\ k b -> calc (M2.Lim -> Nat) {
      Theta1 (L.Phi1 (L.EC.CB.inc k b)) =< apH Theta1 (L.R1.beta k b) >
      Theta1 (\ x u v -> b (x.1 k) (Fi.pr k x u) (Fi.pr k x v))
        =< FL.funext M2.Lim (\ w -> Nat) (Theta1 (\ x u v -> b (x.1 k) (Fi.pr k x u) (Fi.pr k x v)))
             (M2.restrict k (Fi.P[k].Q.tau1 b)) (\ w ->
             apH toNat (Fi.P[k].Q.move2 b (H.h k (w.1 k).2.1) (H.h k (w.1 k).2.1) (refl (H.h k (w.1 k).2.1))
               (Fi.pr k (lim-map SE SG H Fi.Two[w].a') (Fi.Two[w].a, Fi.Two[w].same))
               (Fi.pr k (lim-map SE SG H Fi.Two[w].a') (Fi.PL.pt Fi.Two[w].a'))
               ((w.1 k).1, (w.1 k).2.2) (Fi.P[k].Q.pt (w.1 k).2.1) (refl (w.1 k).1) (refl (w.1 k).2.1))) >
      M2.restrict k (Fi.P[k].Q.tau1 b)
        =< symH (M2.R.beta k (Fi.P[k].Q.tau1 b)) > M2.phi (M2.CN.inc k (Fi.P[k].Q.tau1 b))
        =< apH M2.phi (symH (I1.map-inc k b)) > M2.phi (I1.map (L.EC.CB.inc k b)) }) c ;
  module I1S = I1.Surj[\ k beta -> Tr.Trunc[Fibre (Fi.P[k].Q.tau1) beta].inc
    (Fi.P[k].Q.untau1 beta, Fi.P[k].Q.tau1-untau1 beta)] ;
  surj1 (c : L.CI.C1) : Tr.Trunc[Fibre L.Phi1 c].carrier =
    TC.bind ((u : M2.CN.colim) * Id (M2.Lim -> Nat) (M2.phi u) (Theta1 c)) (Fibre L.Phi1 c) (\ uu ->
      TC.map (Fibre I1.map uu.1) (Fibre L.Phi1 c) (\ vv -> (vv.1, theta1-injective (L.Phi1 vv.1) c
          (transH (square1 vv.1) (transH (apH M2.phi vv.2) uu.2))))
        (I1S.surjective uu.1))
      (C37a.surjective (Theta1 c)) ;

  -- C2: the stages, the limit, the square
  module M3 = Cor37[l,l].Maps[Fi.SE3.E, Fi.SE3.p] ;
  module C37b = Cor37[l,l].Over[ax].Cor37[Fi.SE3.E, Fi.SE3.p, Fi.e3-finite] ;
  nat2 (k : Nat) (b : L.seq2.A k) : Id (Fi.SE3.E (suc k) -> Nat) (M3.seq.f k (Fi.P[k].Q.tau2 b))
      (Fi.P[suc k].Q.tau2 (L.seq2.f k b)) =
    FL.funext (Fi.SE3.E (suc k)) (\ w -> Nat) (M3.seq.f k (Fi.P[k].Q.tau2 b)) (Fi.P[suc k].Q.tau2 (L.seq2.f k b)) (\ w ->
      apH toNat (Fi.P[k].Q.move3 b (H.h k (SE.p k w.2.2.1)) (SG.p k (H.h (suc k) w.2.2.1)) (symH (H.c k w.2.2.1))
        (SE.p k w.1, Fi.path3a k w) (SE.p k w.2.1, Fi.path3b k w) (Fi.P[k].Q.pt (SE.p k w.2.2.1))
        (Fi.Fib.q k (H.h (suc k) w.2.2.1) (w.1, w.2.2.2.1)) (Fi.Fib.q k (H.h (suc k) w.2.2.1) (w.2.1, w.2.2.2.2))
        (Fi.Fib.q k (H.h (suc k) w.2.2.1) (Fi.P[suc k].Q.pt w.2.2.1))
        (refl (SE.p k w.1)) (refl (SE.p k w.2.1)) (refl (SE.p k w.2.2.1)))) ;
  T2 : SeqMap[L.seq2, M3.seq] = new SeqMap[L.seq2, M3.seq, \ k b -> Fi.P[k].Q.tau2 b, nat2] ;
  module I2 = Induced[L.seq2, M3.seq, T2] ;
  Theta2 (b : L.CI.C2) (w : Limit[Fi.SE3].lim) : Nat = Fi.PL.tau2 b (Fi.Three[w].point) ;
  square2 (c : L.EC.CC.colim) : Id (M3.Lim -> Nat) (Theta2 (L.Phi2 c)) (M3.phi (I2.map c)) =
    L.EC.CC.ext (M3.Lim -> Nat) M3.fun-set (\ c1 -> Theta2 (L.Phi2 c1)) (\ c1 -> M3.phi (I2.map c1)) (\ k b -> calc (M3.Lim -> Nat) {
      Theta2 (L.Phi2 (L.EC.CC.inc k b)) =< apH Theta2 (L.R2.beta k b) >
      Theta2 (\ x u v w -> b (x.1 k) (Fi.pr k x u) (Fi.pr k x v) (Fi.pr k x w))
        =< FL.funext M3.Lim (\ w -> Nat) (Theta2 (\ x u v w -> b (x.1 k) (Fi.pr k x u) (Fi.pr k x v) (Fi.pr k x w)))
             (M3.restrict k (Fi.P[k].Q.tau2 b)) (\ w ->
             apH toNat (Fi.P[k].Q.move3 b (H.h k (w.1 k).2.2.1) (H.h k (w.1 k).2.2.1) (refl (H.h k (w.1 k).2.2.1))
               (Fi.pr k (lim-map SE SG H Fi.Three[w].a'') (Fi.Three[w].a, Fi.Three[w].same1))
               (Fi.pr k (lim-map SE SG H Fi.Three[w].a'') (Fi.Three[w].a', Fi.Three[w].same2))
               (Fi.pr k (lim-map SE SG H Fi.Three[w].a'') (Fi.PL.pt Fi.Three[w].a''))
               ((w.1 k).1, (w.1 k).2.2.2.1) ((w.1 k).2.1, (w.1 k).2.2.2.2) (Fi.P[k].Q.pt (w.1 k).2.2.1)
               (refl (w.1 k).1) (refl (w.1 k).2.1) (refl (w.1 k).2.2.1))) >
      M3.restrict k (Fi.P[k].Q.tau2 b)
        =< symH (M3.R.beta k (Fi.P[k].Q.tau2 b)) > M3.phi (M3.CN.inc k (Fi.P[k].Q.tau2 b))
        =< apH M3.phi (symH (I2.map-inc k b)) > M3.phi (I2.map (L.EC.CC.inc k b)) }) c ;
  module I2I = I2.Inj[\ k -> Fi.P[k].Q.tau2-injective] ;
  inj2 : Injective L.Phi2 = \ c c' q -> I2I.injective c c'
    (C37b.injective (I2.map c) (I2.map c') (transH (symH (square2 c)) (transH (apH Theta2 q) (square2 c')))) ;

  -- Ȟ^1 (lim G, fibres of lim g, Z) = 0
  theorem : L.CI.H1Zero = L.Theorem[surj1, inj2].h1 ;
 } ;
} ;
