-- Dependent choice (SSD Axiom 4), as a type: the axioms record of
-- ../stone/StoneAxioms.seg has a field of type DC.
--
-- A sequence of types E 0 <- E 1 <- E 2 <- .. with maps p n : E (suc n) -> E n
-- has as limit the compatible sequences; dependent choice says that if
-- every p n is surjective then so is the projection of the limit to E 0.
-- Surjective is the mere notion: every fibre is merely inhabited.
level l ;
open Base ; open Prelude[l] ;
module T = Truncation[l] ;

-- the fibre of f over b, merely inhabited for every b
Surjective {A B : U l} (f : A -> B) : U l =
  (b : B) -> T.Trunc[(a : A) * Id B (f a) b].carrier ;

-- compatible sequences
Lim (E : Nat -> U l) (p : (n : Nat) -> E (suc n) -> E n) : U l =
  (x : (n : Nat) -> E n) * ((n : Nat) -> Id (E n) (p n (x (suc n))) (x n)) ;

proj0 (E : Nat -> U l) (p : (n : Nat) -> E (suc n) -> E n) (x : Lim E p) : E zero =
  x.1 zero ;

DC : U l+ = (E : Nat -> U l) (p : (n : Nat) -> E (suc n) -> E n) ->
  ((n : Nat) -> Surjective (p n)) -> Surjective (proj0 E p) ;
