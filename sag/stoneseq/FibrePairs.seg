-- Fibres of a map of sets, and the Čech groups of the family of fibres as
-- functions on fibre products (used for SSD Lemma 5.9).
--
-- For g : E -> G with G a set, fib y = (e : E) * g e = y.
--  - Two points of fib y with the same first component are equal, since
--    G is a set (fib-eq); transport along a path of G keeps the first
--    component (fib-subst, by J).  Hence a function of points of fibres
--    takes the same value at points with the same first components over
--    equal bases (move2, move3: J on the base path, then fib-eq).
--  - Fibre products  E2 = (e e' : E) * g e = g e'  and
--    E3 = (e e' e'' : E) * (g e = g e'') * (g e' = g e'').  Points with equal
--    E-components are equal (e2-eq, e3-eq: J, then G is a set).
--  - The Čech groups C1, C2 of (G, fib, Z), sent to N along the enumeration
--    of Z (Int.toNat) so that SSD Corollary 3.7 applies:
--      tau1 b (e, e', h) = b (g e') (e, h) (e', refl).
--    b is recovered:  b y u v = b (g v.1) (u.1, u.2 . v.2^-1) (pt v.1)
--    (move2 along v.2^-1) = ofNat (tau1 b (u.1, v.1, u.2 . v.2^-1)); and
--    every N-valued function on E2 is a tau1 (untau1, using toNat o ofNat
--    = id and e2-eq).  So tau1 is injective and surjective.  Likewise tau2
--    is injective.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Integers[l] ; open Bijection[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;

module Pairs (E G : U l) (sG : isSet G) (g : E -> G) {
  fib (y : G) : U l = (e : E) * Id G (g e) y ;
  pt (e : E) : fib (g e) = (e, refl (g e)) ;
  fib-eq (y : G) (u v : fib y) (p : Id E u.1 v.1) : Id (fib y) u v =
    Sigma-eq E (\ e -> Id G (g e) y) u.1 v.1 u.2 v.2 p (sG (g v.1) y) ;
  fib-subst (y y' : G) (r : Id G y y') (u : fib y) : Id E (subst G fib y y' r u).1 u.1 =
    idJ G y (\ y1 r1 -> Id E (subst G fib y y1 r1 u).1 u.1) (refl u.1) y' r ;

  -- the Čech groups of (G, fib, Z)
  C1 : U l = (y : G) -> fib y -> fib y -> Int ;
  C2 : U l = (y : G) -> fib y -> fib y -> fib y -> Int ;
  move2 (b : C1) (y y' : G) (r : Id G y y') (u v : fib y) (u' v' : fib y') (pu : Id E u.1 u'.1) (pv : Id E v.1 v'.1)
    : Id Int (b y u v) (b y' u' v') =
    idJ G y (\ y1 r1 -> (u1 v1 : fib y1) -> Id E u.1 u1.1 -> Id E v.1 v1.1 -> Id Int (b y u v) (b y1 u1 v1))
      (\ u1 v1 pu1 pv1 -> transH (apH (\ s -> b y s v) (fib-eq y u u1 pu1)) (apH (b y u1) (fib-eq y v v1 pv1)))
      y' r u' v' pu pv ;
  move3 (b : C2) (y y' : G) (r : Id G y y') (u v w : fib y) (u' v' w' : fib y')
    (pu : Id E u.1 u'.1) (pv : Id E v.1 v'.1) (pw : Id E w.1 w'.1) : Id Int (b y u v w) (b y' u' v' w') =
    idJ G y (\ y1 r1 -> (u1 v1 w1 : fib y1) -> Id E u.1 u1.1 -> Id E v.1 v1.1 -> Id E w.1 w1.1 ->
        Id Int (b y u v w) (b y1 u1 v1 w1))
      (\ u1 v1 w1 pu1 pv1 pw1 -> transH (apH (\ s -> b y s v w) (fib-eq y u u1 pu1))
        (transH (apH (\ s -> b y u1 s w) (fib-eq y v v1 pv1)) (apH (b y u1 v1) (fib-eq y w w1 pw1))))
      y' r u' v' w' pu pv pw ;

  -- fibre products
  E2 : U l = (e : E) * (e' : E) * Id G (g e) (g e') ;
  e2-eq (e e' d d' : E) (h : Id G (g e) (g e')) (h' : Id G (g d) (g d')) (p : Id E e d) (p' : Id E e' d')
    : Id E2 (e, e', h) (d, d', h') =
    idJ E e (\ d1 p1 -> (h1 : Id G (g d1) (g d')) -> Id E2 (e, e', h) (d1, d', h1))
      (idJ E e' (\ d1 p1 -> (h1 : Id G (g e) (g d1)) -> Id E2 (e, e', h) (e, d1, h1))
        (\ h1 -> apH (\ k -> (e, e', k)) (sG (g e) (g e') h h1)) d' p') d p h' ;
  E3 : U l = (e : E) * (e' : E) * (e'' : E) * (Id G (g e) (g e'') * Id G (g e') (g e'')) ;

  -- C1 and N-valued functions on E2
  tau1 (b : C1) (w : E2) : Nat = toNat (b (g w.2.1) (w.1, w.2.2) (pt w.2.1)) ;
  untau1 (beta : E2 -> Nat) : C1 = \ y u v -> ofNat (beta (u.1, v.1, transH u.2 (symH v.2))) ;
  recover1 (b : C1) (y : G) (u v : fib y) : Id Int (b y u v) (untau1 (tau1 b) y u v) = calc Int {
    b y u v =< move2 b y (g v.1) (symH v.2) u v (u.1, transH u.2 (symH v.2)) (pt v.1) (refl u.1) (refl v.1) >
    b (g v.1) (u.1, transH u.2 (symH v.2)) (pt v.1)
      =< symH (of-to (b (g v.1) (u.1, transH u.2 (symH v.2)) (pt v.1))) > untau1 (tau1 b) y u v } ;
  tau1-injective : Injective tau1 = \ b b' q ->
    Lemma59[l].Pointwise[G, fib, Int].fun2 b b' (\ y u v ->
      transH (recover1 b y u v) (transH (apH (\ beta -> untau1 beta y u v) q) (symH (recover1 b' y u v)))) ;
  tau1-untau1 (beta : E2 -> Nat) : Id (E2 -> Nat) (tau1 (untau1 beta)) beta =
    FL.funext E2 (\ w -> Nat) (tau1 (untau1 beta)) beta (\ w ->
      transH (to-of (beta (w.1, w.2.1, transH w.2.2 (symH (refl (g w.2.1))))))
        (apH beta (e2-eq w.1 w.2.1 w.1 w.2.1 (transH w.2.2 (symH (refl (g w.2.1)))) w.2.2 (refl w.1) (refl w.2.1)))) ;

  -- C2 and N-valued functions on E3
  tau2 (b : C2) (w : E3) : Nat = toNat (b (g w.2.2.1) (w.1, w.2.2.2.1) (w.2.1, w.2.2.2.2) (pt w.2.2.1)) ;
  untau2 (beta : E3 -> Nat) : C2 = \ y u v w ->
    ofNat (beta (u.1, v.1, w.1, transH u.2 (symH w.2), transH v.2 (symH w.2))) ;
  recover2 (b : C2) (y : G) (u v w : fib y) : Id Int (b y u v w) (untau2 (tau2 b) y u v w) = calc Int {
    b y u v w =< move3 b y (g w.1) (symH w.2) u v w (u.1, transH u.2 (symH w.2)) (v.1, transH v.2 (symH w.2)) (pt w.1)
      (refl u.1) (refl v.1) (refl w.1) >
    b (g w.1) (u.1, transH u.2 (symH w.2)) (v.1, transH v.2 (symH w.2)) (pt w.1)
      =< symH (of-to (b (g w.1) (u.1, transH u.2 (symH w.2)) (v.1, transH v.2 (symH w.2)) (pt w.1))) >
    untau2 (tau2 b) y u v w } ;
  tau2-injective : Injective tau2 = \ b b' q ->
    Lemma59[l].Pointwise[G, fib, Int].fun3 b b' (\ y u v w ->
      transH (recover2 b y u v w) (transH (apH (\ beta -> untau2 beta y u v w) q) (symH (recover2 b' y u v w)))) ;
} ;
