-- Rank-one multiplication over the nonreduced ring Z/4Z: determinant 3
-- is a unit and the constructed inverse of 3 is 3. The theorem itself
-- takes a unit determinant and requires no field or reducedness.
level l ; open Ring[l] ; open Presentations[l] ;
module T = TraceRegression[l].Nonreduced ;
module Test = FiniteAlgebraDeterminantUnit[l].Over[ZMod4[l].ring,ZMod4[l].set,T.C.base,TraceRegression[l].one,T.basis].At[q3] ;
determinant : Id ZMod4[l].ring.R Test.determinant q3 = refl q3 ;
unit : RL[ZMod4[l].ring].unit q3 = Test.from-unit (q3,refl q1) ;
inverse-three : Id ZMod4[l].ring.R unit.1 q3 = refl q3 ;
equation : Id ZMod4[l].ring.R (ZMod4[l].ring.mul q3 unit.1) q1 = unit.2 ;
