-- A unit determinant for multiplication by x constructs an inverse of x.
-- Matrix(column,row)=coordinate(x*b_column,row), exactly the standard
-- TraceBasis orientation. Solve M_x*v=coordinate(1) with the right
-- adjugate, then reconstruct v as an element of the algebra.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module FE = Axioms[l].FunExtLemmas[fe @l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (S : Algebras[l].Over[k,setk].Algebra) (n : Nat) (basis : TraceBasis[l].Over[k,setk,S].Basis[n]) {
 module B = TraceBasis[l].Over[k,setk,S].At[n,basis] ;
 module Coordinates = FiniteBasisComposition[l].Coordinates[k,setk,S,n,basis] ;
 module DT = Determinant[l].Over[k,setk] ; module L = RL[k] ;
 module At (x : S.ring.R) {
  matrix : DT.Mat n = \ j i -> basis.coordinate (S.ring.mul x (basis.vector j)) i ;
  determinant : k.R = ExteriorModel[l].Over[k].det n matrix ;
  module Adj = RightAdjugate[l].Over[k,setk].At[n,matrix] ;
  module Unit (u : L.unit determinant) {
   coefficients (i : Fin n) : k.R = k.mul u.1 (DT.act n Adj.right (basis.coordinate S.ring.o) i) ;
   solves (i : Fin n) : Id k.R (DT.act n matrix coefficients i) (basis.coordinate S.ring.o i) =
    trans (DT.act-scale n matrix u.1 (DT.act n Adj.right (basis.coordinate S.ring.o)) i)
     (trans (ap (k.mul u.1) (Adj.action (basis.coordinate S.ring.o) i))
      (trans (k.mulA u.1 determinant (basis.coordinate S.ring.o i))
       (trans (ap (\ a -> k.mul a (basis.coordinate S.ring.o i)) (trans (k.mulC u.1 determinant) u.2))
        (L.one-left (basis.coordinate S.ring.o i))))) ;
   inverse : S.ring.R = Coordinates.expand coefficients ;
   coordinate-equation (i : Fin n) : Id k.R (basis.coordinate (S.ring.mul x inverse) i) (basis.coordinate S.ring.o i) =
    trans (B.product-coordinate x inverse i)
     (trans (ap (\ c -> DT.act n matrix c i)
      (FE.funext (Fin n) (\ j -> k.R) (basis.coordinate inverse) coefficients (Coordinates.coordinate-expand coefficients))) (solves i)) ;
   equation : Id S.ring.R (S.ring.mul x inverse) S.ring.o = B.coordinates-determine _ _ coordinate-equation ;
   result : RL[S.ring].unit x = (inverse,equation) ;
  } ;
  from-unit (u : L.unit determinant) : RL[S.ring].unit x = Unit[u].result ;
  choose (nonzero : Not (Id k.R determinant k.z)) : Plus (Id k.R determinant k.z) (L.unit determinant) -> RL[S.ring].unit x = split {
   inl h -> efq (nonzero h) ; inr u -> from-unit u } ;
  from-nonzero (dec : (a : k.R) -> Plus (Id k.R a k.z) (L.unit a))
   (nonzero : Not (Id k.R determinant k.z)) : RL[S.ring].unit x = choose nonzero (dec determinant) ;
 } ;
} ;
