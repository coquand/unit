-- Transpose the checked adj(A^t)*A^t identity to obtain a right adjugate.
-- The existing determinant-transpose theorem restores the determinant
-- in the original column-row orientation. No determinant is cancelled.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module FE = Axioms[l].FunExtLemmas[fe @l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) {
 module DT = Determinant[l].Over[k,setk] ; module Adj = Adjugate[l].Over[k,setk] ;
 module TP = ExteriorTranspose[l].Over[k,setk] ; module TR = DeterminantTrick[l].Over[k,setk] ;
 module S = FiniteIdeal[l].Sums[k] ; module D = MnSums[l].Over[k] ;
 module At (n : Nat) (matrix : DT.Mat n) {
  transpose : DT.Mat n = TP.transpose n matrix ;
  right : DT.Mat n = \ j i -> Adj.adj n transpose i j ;
  equation (j i : Fin n) : Id k.R (DT.mmul n matrix right j i)
   (k.mul (ExteriorModel[l].Over[k].det n matrix) (D.delta n j i)) =
   trans (S.sum-cong n (\ t -> k.mul (Adj.adj n transpose t j) (matrix t i))
    (\ t -> k.mul (transpose i t) (Adj.adj n transpose t j))
    (\ t -> trans (k.mulC (Adj.adj n transpose t j) (matrix t i))
     (ap (\ a -> k.mul a (Adj.adj n transpose t j)) (sym (TP.transpose-value n matrix i t)))))
    (trans (Adj.adj-mul n transpose i j)
     (cong2 k.R k.mul _ _ _ _ (sym (TP.det-transpose n matrix)) (D.delta-sym n i j))) ;
  matrix-equation : Id (DT.Mat n) (DT.mmul n matrix right)
   (\ j i -> k.mul (ExteriorModel[l].Over[k].det n matrix) (D.delta n j i)) =
   FE.funext (Fin n) (\ j -> Fin n -> k.R) _ _ (\ j -> FE.funext (Fin n) (\ i -> k.R) _ _ (equation j)) ;
  action (x : Fin n -> k.R) (i : Fin n) :
   Id k.R (DT.act n matrix (DT.act n right x) i) (k.mul (ExteriorModel[l].Over[k].det n matrix) (x i)) =
   trans (sym (TR.act-mmul n matrix right x i))
    (trans (ap (\ m -> DT.act n m x i) matrix-equation) (TR.act-scalar n (ExteriorModel[l].Over[k].det n matrix) x i)) ;
 } ;
} ;
