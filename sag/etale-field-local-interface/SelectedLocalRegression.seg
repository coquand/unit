-- A genuinely noninjective B -> E regression. Take A=E=F2 and
-- B=F2 x F2, j the first projection, s=(1,0), e=1 and x=0.
-- The finite family is (1,0),(0,1). Its generation identities hold
-- only after multiplying by s; the second basis vector is nonzero
-- in B but vanishes in E. Thus no inclusion B/mB -> E is used.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ; module Tr = Truncation[l] ; module BF = BooleanRing[l] ;
A : CRing = BF.two-ring ; module L = RL[A] ;
empty-to-ring : Base.Empty -> Empty = split {} ;
nonzero : Not (Id A.R A.o A.z) = \ h -> empty-to-ring (BF.true-false h) ;
m (a : A.R) : U l = Id A.R a A.z ;
m-zero : m A.z = refl false ;
m-add (a b : A.R) (ha : m a) (hb : m b) : m (A.add a b) =
 trans (ap (\ z -> A.add z b) ha) (trans (L.zl b) hb) ;
m-scale (a b : A.R) (hb : m b) : m (A.mul a b) = trans (ap (A.mul a) hb) (L.mul-zero a) ;
dec : (a : A.R) -> Plus (m a) (L.unit a) = split {
 false -> inl (refl false) ; true -> inr (true,refl true) } ;
rad (a : A.R) (ha : m a) : L.unit (A.add A.o (A.neg a)) =
 subst (\ z -> L.unit (A.add A.o (A.neg z))) (sym ha) (true,refl true) ;
prime : (a b : A.R) -> m (A.mul a b) -> Plus (m a) (m b) = split {
 false -> \ b h -> inl (refl false) ;
 true -> split { false -> \ h -> inr (refl false) ; true -> \ h -> efq (nonzero h) } } ;
prime-dec : (a : A.R) -> Plus (m a) (Not (m a)) = split {
 false -> inl (refl false) ; true -> inr nonzero } ;
Pair : U l = A.R * A.R ;
pair-eq (a b : Pair) (h : Id A.R a.1 b.1) (j : Id A.R a.2 b.2) : Id Pair a b =
 AffineHLevels[l].pair-path A.R A.R a.1 b.1 a.2 b.2 h j ;
z : Pair = (false,false) ; o : Pair = (true,true) ;
add (a b : Pair) : Pair = (A.add a.1 b.1,A.add a.2 b.2) ;
mul (a b : Pair) : Pair = (A.mul a.1 b.1,A.mul a.2 b.2) ;
neg (a : Pair) : Pair = (A.neg a.1,A.neg a.2) ;
B : CRing = mkCRing Pair z o add mul neg
 (\ a b c -> pair-eq _ _ (A.addA a.1 b.1 c.1) (A.addA a.2 b.2 c.2))
 (\ a b -> pair-eq _ _ (A.addC a.1 b.1) (A.addC a.2 b.2))
 (\ a -> pair-eq _ _ (A.addZ a.1) (A.addZ a.2))
 (\ a -> pair-eq _ _ (A.addN a.1) (A.addN a.2))
 (\ a b c -> pair-eq _ _ (A.mulA a.1 b.1 c.1) (A.mulA a.2 b.2 c.2))
 (\ a b -> pair-eq _ _ (A.mulC a.1 b.1) (A.mulC a.2 b.2))
 (\ a -> pair-eq _ _ (A.mulO a.1) (A.mulO a.2))
 (\ a b c -> pair-eq _ _ (A.dist a.1 b.1 c.1) (A.dist a.2 b.2 c.2)) ;
setB : Pr.isSet Pair = Pr.isSet-Sigma A.R (\ a -> A.R) BF.bool-set (\ a -> BF.bool-set) ;
iota : H.Hom A B = (\ a -> (a,a),refl o,\ a b -> refl (A.add a b,A.add a b),\ a b -> refl (A.mul a b,A.mul a b)) ;
j : H.Hom B A = (\ a -> a.1,refl true,\ a b -> refl (A.add a.1 b.1),\ a b -> refl (A.mul a.1 b.1)) ;
one : Nat = suc zero ; two : Nat = suc one ;
i0 : Fin two = inl (inr tt) ; i1 : Fin two = inr tt ;
bs : Fin two -> Pair = snoc (Fin one) Pair (\ i -> (true,false)) (false,true) ;
rho (a : Pair) : Fin two -> A.R = snoc (Fin one) A.R (\ i -> a.1) a.2 ;
module Sum = FiniteIdeal[l].Sums[B] ;
coordinate-equation : (a b : A.R) -> Id Pair (a,b) (Sum.sum two (\ i -> B.mul (iota.1 (rho (a,b) i)) (bs i))) = split {
 false -> split { false -> refl z ; true -> refl (false,true) } ;
 true -> split { false -> refl (true,false) ; true -> refl o } } ;
Coord (a : Pair) : U l = (r : Fin two -> A.R) * Id Pair a (Sum.sum two (\ i -> B.mul (iota.1 (r i)) (bs i))) ;
coord (a : Pair) : Tr.Trunc[Coord a].carrier = Tr.Trunc[Coord a].inc (rho a,coordinate-equation a.1 a.2) ;
s : Pair = (true,false) ;
module IG = IdealGenerated[l].Over[A,m,A,H.identity A] ;
s-one : Tr.Trunc[IG.InmB (A.add (j.1 s) (A.neg A.o))].carrier =
 Tr.Trunc[IG.InmB (A.add (j.1 s) (A.neg A.o))].inc (nil,refl false) ;
Zmt (a : A.R) : U l = (k : Nat) * (b : Pair) *
 Id A.R (A.mul (AffinePowers[l].Over[A].power (j.1 s) k) a) (j.1 b) ;
zmt (a : A.R) : Tr.Trunc[Zmt a].carrier = Tr.Trunc[Zmt a].inc (zero,(a,false),L.one-left a) ;
module BP = BasePresentation[l].Over[A,BF.bool-set] ;
module Test = SelectedFlatLocal[l].Over[A,BF.bool-set,m,m-zero,m-add,m-scale,dec,rad,
 A,BF.bool-set,H.identity A,m,m-zero,m-add,m-scale,(\ a h -> h),prime,nonzero,prime-dec,
 B,setB,iota,j,(\ a -> refl a),one,bs,coord,s,s-one,zmt,(BP.empty,BP.presentation),FlatRelations[l].Self[A].flat] ;
polynomial : List A.R = cons false (cons true nil) ;
root : Test.PRoot o z polynomial = (zero,nil,refl false) ;
separable : Test.PSeparable o z polynomial = (true,zero,nil,refl false) ;
representation : Fin two -> List A.R = snoc (Fin one) (List A.R) (\ i -> cons true nil) nil ;
generation-equation : (i : Fin two) -> Id Pair
 (B.mul (Test.In0.PB.power s one) (B.mul o (B.add (bs i) (B.neg (MonicReduce[l].Horner[A,B,iota,z].horner (representation i)))))) z =
 AffineFinite[l].section one (\ i -> Id Pair
  (B.mul (Test.In0.PB.power s one) (B.mul o (B.add (bs i) (B.neg (MonicReduce[l].Horner[A,B,iota,z].horner (representation i)))))) z)
  (\ i -> refl z) (refl z) ;
generates : Test.PGenerates o z = \ i -> (representation i,one,nil,generation-equation i) ;
piece : Test.Piece o z = (polynomial,root,separable,generates) ;
selected : Test.SelectedData = (o,z,nonzero,piece) ;
-- The complete local theorem, with actual finite local input.
theorem : Truncation[l+].Trunc[Test.St.Conclusion].carrier = Test.theorem (Tr.Trunc[Test.SelectedData].inc selected) ;
-- The lost second factor is nonzero in B and killed by j.
other-nonzero : Not (Id Pair (bs i1) z) = \ h -> nonzero (ap (\ a -> a.2) h) ;
other-killed : Id A.R (j.1 (bs i1)) A.z = refl false ;
-- Its uncleared generation difference is the same nonzero element.
uncleared-nonzero : Not (Id Pair (B.mul o (B.add (bs i1) (B.neg (MonicReduce[l].Horner[A,B,iota,z].horner nil)))) z) = other-nonzero ;
