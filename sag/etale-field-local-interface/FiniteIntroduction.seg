-- PRIVATE DERIVED VARIANT of etale-flat-unramified/Introduction.seg.
-- Only Generates is restricted to the fixed finite spanning family bs;
-- its Shift and Ci/e-gen consumers take the index i. All other proof
-- text is unchanged. See README.txt for the checked interface and diff.
-- The Introduction of zmt2-revised.tex (lines 75-200): from ZMT and the
-- field case, the inputs of Section 1 (LoopInputs.Section1).
--
-- Hypotheses (parameters of Over and of FieldCase; they stay hypotheses):
--  * A local, residually discrete (m, dec, rad), as in Section1Eg.
--  * E an A-algebra (iota), q a prime of E containing m E, with decidable
--    membership (q-dec), 1 not in q.
--  * ZMT (ACL Cor. 1.4), after the refinement of the note (lines 85-90):
--    a finite A-subalgebra B of E, given as an A-algebra B with a map of
--    A-algebras j : B -> E and module generators b_1 .. b_r (coord:
--    every element is sum_k rho_k b_k), and s in B, s not in q, with
--    B[1/s] = E[1/s] (zmt: every z in E has s^k z = j(b)).
--  * The field case, in the chosen monogenic factor: x in B and P in A[X]
--    with A[1/s-bar] = k[X]/(P), X |-> x-bar.  Of this isomorphism only
--    three consequences are used (Factor x):
--      root       s^N P(x) is in m E          (P(x-bar) = 0)
--      separable  s^N (P'(x) w - 1) is in m E (P'(x-bar) a unit)
--      generates  for each fixed bs_i a C in A[X] with s^N (bs_i - C(x)) in m B
--                                             (x-bar generates)
--    P'(x) is the epsilon-component of P(x + epsilon) (slope).  The note
--    states the first two in A[1/s-bar] = (E/mE)[1/s-bar]; they are used in
--    E, so they are stated there.  Monicity of P and injectivity of
--    k[X]/(P) -> A[1/s-bar] are not used.
--
-- Steps (informal proof; the file follows it).
--  0. x not in q (note line 116): if j(x) is in q, replace x by x - 1 and
--     P by P(X + 1) (HornerValues.sh); j(x) - j(x - 1) = 1 is not in q.
--  1. Lemma 1 modulo m B (IdempotentModM): s is integral over A
--     (LoopInputs.Integral on the generators), so s^N (1 - s v) is in m B;
--     e = (s v)^N is idempotent mod m B, s^N (1 - e) is in m B, and
--     e w is in m B whenever s^K w is (kill).
--  2. y = x e.  For b in B with s^N (b - C(x)) in m B:  e b = e C(x) and
--     e C(x) = e C(x e) mod m B (e idempotent), so
--       y b = x e b = x e C(y) = (X C)(y)  mod m B:
--     y B is in R[y] + m B, and with coordinates (coords: an element of
--     m B is sum_k mu_k b_k with mu_k in m) this is the system of Lemma 2.
--     y is not in q: x is not, and e is not (s^N (1 - e) in q, s not in q).
--  3. Lemma 2 (DeterminantLemma): p with p b in R[y] for b in B, p not in
--     q.  g = p s.  Choosing lists F_k for the polynomials p b_k = F_k(y)
--     (finitely many; a mere choice, so the result is a mere existence),
--     p b = sum_k rho_k F_k(y) is the value of a list for every b; G is
--     the list of g.  Full: for z in E, s^k z = j(b), so
--       z g^(k+1) = p^k p (b s) = (P^k r_(b s))(y).
--  4. The special fibre.  J = { w in E | g^k w in m E for some k } (the
--     note's m E_g, read in E: Section 1 runs in E with this J, so no
--     localisation is built).  H = P.
--       hH : P(y) in J:  y = x mod J (1 - e in J), and s^N P(x) in m E.
--       hH': P'(y) a unit mod J:  P'(y) = P'(x) mod J (congruence in the
--            dual numbers), and s^N (P'(x) w - 1) in m E.
--       hG : g a unit mod J: Lemma 1 modulo m B for g gives
--            g^N (1 - g v) in m B.
--     The certificate (G^n H)(y) = sum_j mu_j R_j(y): H(y) in J gives
--     g^k H(y) in m E, cleared by ClearDenominators.clear.
--  Also: g is not in q, and J is contained in q.
-- Differences from the note: H = P rather than P / gcd(P, X) (the loop
-- only needs H(y) in J and H'(y) a unit mod J, and y is a unit mod J);
-- Section 1 runs in E with J rather than in E_g with m E_g.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module H = RingHom[l] ; module Tr = Truncation[l] ;
-- ring steps used below
module Steps (T : CRing) {
 open T ;
 module L = RL[T] ;
 -- (p - q) + (q - w) = p - w
 cancel-mid (p q w : R) : Id R (add (add p (neg q)) (add q (neg w))) (add p (neg w)) =
  trans (sym (addA p (neg q) (add q (neg w))))
   (ap (add p) (trans (addA (neg q) q (neg w)) (trans (ap (\ t -> add t (neg w)) (L.neg-cancel q)) (L.zl (neg w))))) ;
 -- (c + u) - (c + w) = u - w
 diff-common (c u w : R) : Id R (add (add c u) (neg (add c w))) (add u (neg w)) =
  trans (ap (add (add c u)) (L.neg-add c w))
   (trans (L.swap c u (neg c) (neg w)) (trans (ap (\ t -> add t (add u (neg w))) (addN c)) (L.zl (add u (neg w))))) ;
 -- c + (a - c) = a
 add-sub (c a : R) : Id R (add c (add a (neg c))) a =
  trans (addC c (add a (neg c))) (trans (sym (addA a (neg c) c)) (trans (ap (add a) (L.neg-cancel c)) (addZ a))) ;
 -- (1 - a) + a = 1
 one-sub (a : R) : Id R (add (add o (neg a)) a) o =
  trans (sym (addA o (neg a) a)) (trans (ap (add o) (L.neg-cancel a)) (addZ o)) ;
 -- (a - c) + c = a
 sub-add (a c : R) : Id R (add (add a (neg c)) c) a =
  trans (sym (addA a (neg c) c)) (trans (ap (add a) (L.neg-cancel c)) (addZ a)) ;
 -- a - (a - c) = c
 sub-sub (a c : R) : Id R (add a (neg (add a (neg c)))) c =
  trans (ap (add a) (L.negsub a c)) (trans (addA a (neg a) c) (trans (ap (\ t -> add t c) (addN a)) (L.zl c))) ;
 -- z (P Pk) (S Sk) = Pk (P ((Sk z) S))
 five (z P Pk S Sk : R) : Id R (mul z (mul (mul P Pk) (mul S Sk))) (mul Pk (mul P (mul (mul Sk z) S))) = calc R {
  mul z (mul (mul P Pk) (mul S Sk))
   =< L.mul-swap z (mul P Pk) (mul S Sk) > mul (mul P Pk) (mul z (mul S Sk))
   =< ap (\ t -> mul t (mul z (mul S Sk))) (mulC P Pk) > mul (mul Pk P) (mul z (mul S Sk))
   =< sym (mulA Pk P (mul z (mul S Sk))) > mul Pk (mul P (mul z (mul S Sk)))
   =< ap (\ t -> mul Pk (mul P t)) (trans (ap (mul z) (mulC S Sk)) (trans (mulA z Sk S) (ap (\ t -> mul t S) (mulC z Sk))))
    > mul Pk (mul P (mul (mul Sk z) S)) } ;
 -- -(1 - a) = a - 1
 neg-one-sub (a : R) : Id R (neg (add o (neg a))) (add a (neg o)) = trans (L.negsub o a) (addC (neg o) a) ;
} ;
module Over (A : CRing) (setA : Pr.isSet A.R) (m : A.R -> U l) (m-zero : m A.z)
 (m-add : (a c : A.R) -> m a -> m c -> m (A.add a c))
 (m-scale : (a c : A.R) -> m c -> m (A.mul a c))
 (dec : (a : A.R) -> Plus (m a) (RL[A].unit a))
 (rad : (a : A.R) -> m a -> RL[A].unit (A.add A.o (A.neg a)))
 -- the etale algebra and the prime
 (E : CRing) (setE : Pr.isSet E.R) (iota : H.Hom A E)
 (q : E.R -> U l) (q-zero : q E.z) (q-add : (a c : E.R) -> q a -> q c -> q (E.add a c))
 (q-scale : (a c : E.R) -> q c -> q (E.mul a c)) (q-m : (a : A.R) -> m a -> q (iota.1 a))
 (q-prime : (a c : E.R) -> q (E.mul a c) -> Plus (q a) (q c)) (q-proper : Not (q E.o))
 (q-dec : (a : E.R) -> Plus (q a) (Not (q a)))
 -- ZMT: the finite subalgebra B with generators, and s
 (B : CRing) (setB : Pr.isSet B.R) (iB : H.Hom A B) (j : H.Hom B E)
 (j-alg : (a : A.R) -> Id E.R (j.1 (iB.1 a)) (iota.1 a))
 (n' : Nat) (bs : Ps.Fin (suc n') -> B.R)
 (coord : (x : B.R) -> Tr.Trunc[(rho : Ps.Fin (suc n') -> A.R) * Id B.R x (FiniteIdeal[l].Sums[B].sum (suc n') (\ k -> B.mul (iB.1 (rho k)) (bs k)))].carrier)
 (s : B.R) (s-out : Not (q (j.1 s)))
 (zmt : (z : E.R) -> Tr.Trunc[(k : Nat) * (b : B.R) * Id E.R (E.mul (AffinePowers[l].Over[E].power (j.1 s) k) z) (j.1 b)].carrier) {
 r : Nat = suc n' ;
 module TC = TruncationCombinators[l] ;
 -- coordinates of an element of B, and an element of E cleared into B
 Coord (x : B.R) : U l = (rho : Ps.Fin r -> A.R) * Id B.R x (FiniteIdeal[l].Sums[B].sum r (\ k -> B.mul (iB.1 (rho k)) (bs k))) ;
 Zmt (z : E.R) : U l = (k : Nat) * (b : B.R) * Id E.R (E.mul (AffinePowers[l].Over[E].power (j.1 s) k) z) (j.1 b) ;
 choose-coords (n : Nat) (f : Ps.Fin n -> B.R) : Tr.Trunc[(i : Ps.Fin n) -> Coord (f i)].carrier =
  EtaleCase[l].choice n (\ i -> Coord (f i)) (\ i -> coord (f i)) ;
 module SB = FiniteIdeal[l].Sums[B] ; module SE = FiniteIdeal[l].Sums[E] ;
 module LB = RL[B] ; module LE = RL[E] ;
 module StB = Steps[B] ; module StE = Steps[E] ;
 module PB = AffinePowers[l].Over[B] ; module PE = AffinePowers[l].Over[E] ;
 module Jm = DeterminantLemma[l].Map[B,E,setB,setE,j] ;
 module MR = Mul[l].MulR[A] ;
 module SH = HornerValues[l].Shifts[A] ;
 -- the ideals m B and m E (IdealGenerated)
 module IGB = IdealGenerated[l].Over[A,m,B,iB] ;
 module IGE = IdealGenerated[l].Over[A,m,E,iota] ;
 -- j maps m B into m E
 gens-E : List IGB.Gen -> List IGE.Gen = split { nil -> nil ; cons p ps | r -> cons (p.1,p.2.1,j.1 p.2.2) r } ;
 gens-value : (ps : List IGB.Gen) -> Id E.R (j.1 (IGB.Ls.lsum IGB.value ps)) (IGE.Ls.lsum IGE.value (gens-E ps)) = split {
  nil -> H.zero B E j ;
  cons p ps | r -> trans (j.2.2.1 (IGB.value p) (IGB.Ls.lsum IGB.value ps))
   (Ps.cong2 E.R E.add _ _ _ _ (trans (j.2.2.2 (iB.1 p.1) p.2.2) (ap (\ t -> E.mul t (j.1 p.2.2)) (j-alg p.1))) r) } ;
 to-E (b : B.R) (h : IGB.InmB b) : IGE.InmB (j.1 b) = (gens-E h.1,trans (ap j.1 h.2) (gens-value h.1)) ;
 -- m E is contained in q
 q-gens : (ps : List IGE.Gen) -> q (IGE.Ls.lsum IGE.value ps) = split {
  nil -> q-zero ;
  cons p ps | r -> q-add _ _ (subst q (E.mulC p.2.2 (iota.1 p.1)) (q-scale p.2.2 _ (q-m p.1 p.2.1))) r } ;
 q-mE (w : E.R) (h : IGE.InmB w) : q w = subst q (sym h.2) (q-gens h.1) ;
 q-neg (a : E.R) (h : q a) : q (E.neg a) = subst q (trans (LE.neg-mul-left E.o a) (ap E.neg (LE.one-left a))) (q-scale (E.neg E.o) a h) ;
 -- powers of an element outside q are outside q
 out-step (w : E.R) (hw : Not (q w)) (k : Nat) (ih : Not (q (PE.power w k))) : Plus (q w) (q (PE.power w k)) -> Empty = split {
  inl a -> hw a ; inr c -> ih c } ;
 power-out (w : E.R) (hw : Not (q w)) : (k : Nat) -> Not (q (PE.power w k)) = split {
  zero -> q-proper ;
  suc k | ih -> \ h -> out-step w hw k ih (q-prime w (PE.power w k) h) } ;
 -- an element of m B has coordinates in m
 Coords (w : B.R) : U l = (mu : Ps.Fin r -> A.R) * ((k : Ps.Fin r) -> m (mu k)) * Id B.R w (SB.lin r bs (\ k -> iB.1 (mu k))) ;
 -- iota(nu) t = sum_k b_k iota(rho_k nu)
 gen-coords (nu : A.R) (t : B.R) (ct : Coord t) : Id B.R (B.mul (iB.1 nu) t) (SB.lin r bs (\ k -> iB.1 (A.mul (ct.1 k) nu))) = calc B.R {
  B.mul (iB.1 nu) t
   =< ap (B.mul (iB.1 nu)) (trans ct.2
        (SB.sum-cong r (\ k -> B.mul (iB.1 (ct.1 k)) (bs k)) (\ k -> B.mul (bs k) (iB.1 (ct.1 k))) (\ k -> B.mulC (iB.1 (ct.1 k)) (bs k))))
    > B.mul (iB.1 nu) (SB.lin r bs (\ k -> iB.1 (ct.1 k)))
   =< sym (SB.lin-scale r bs (\ k -> iB.1 (ct.1 k)) (iB.1 nu)) > SB.lin r bs (\ k -> B.mul (iB.1 nu) (iB.1 (ct.1 k)))
   =< SB.sum-cong r (\ k -> B.mul (bs k) (B.mul (iB.1 nu) (iB.1 (ct.1 k)))) (\ k -> B.mul (bs k) (iB.1 (A.mul (ct.1 k) nu)))
       (\ k -> ap (B.mul (bs k)) (trans (B.mulC (iB.1 nu) (iB.1 (ct.1 k))) (sym (iB.2.2.2 (ct.1 k) nu))))
    > SB.lin r bs (\ k -> iB.1 (A.mul (ct.1 k) nu)) } ;
 gens-coords : (ps : List IGB.Gen) -> Tr.Trunc[Coords (IGB.Ls.lsum IGB.value ps)].carrier = split {
  nil -> Tr.Trunc[Coords (IGB.Ls.lsum IGB.value nil)].inc (\ k -> A.z,\ k -> m-zero,
   sym (trans (SB.sum-cong r (\ k -> B.mul (bs k) (iB.1 A.z)) (\ k -> B.mul (bs k) B.z) (\ k -> ap (B.mul (bs k)) (H.zero A B iB))) (SB.lin-zero r bs))) ;
  cons p ps | c -> TC.map2 (Coord p.2.2) (Coords (IGB.Ls.lsum IGB.value ps)) (Coords (IGB.Ls.lsum IGB.value (cons p ps)))
   (\ cp c1 -> (\ k -> A.add (A.mul (cp.1 k) p.1) (c1.1 k),
   \ k -> m-add _ _ (m-scale (cp.1 k) p.1 p.2.1) (c1.2.1 k),
   trans (Ps.cong2 B.R B.add _ _ _ _ (gen-coords p.1 p.2.2 cp) c1.2.2)
    (sym (trans (SB.sum-cong r (\ k -> B.mul (bs k) (iB.1 (A.add (A.mul (cp.1 k) p.1) (c1.1 k))))
                  (\ k -> B.mul (bs k) (B.add (iB.1 (A.mul (cp.1 k) p.1)) (iB.1 (c1.1 k))))
                  (\ k -> ap (B.mul (bs k)) (iB.2.2.1 (A.mul (cp.1 k) p.1) (c1.1 k))))
          (SB.lin-add r bs (\ k -> iB.1 (A.mul (cp.1 k) p.1)) (\ k -> iB.1 (c1.1 k))))))) (coord p.2.2) c } ;
 coords (w : B.R) (h : IGB.InmB w) : Tr.Trunc[Coords w].carrier =
  subst (\ w1 -> Tr.Trunc[Coords w1].carrier) (sym h.2) (gens-coords h.1) ;

 ---------------------------------------------------------------------
 -- the field case: Factor x

 module DNE = QuadraticPairs[l].Over[E,setE,E.z] ;
 dual : H.Hom A DNE.ring = H.compose A E DNE.ring DNE.inclusion iota ;
 -- P'(t): the epsilon-component of P(t + epsilon)
 slope (t : E.R) (fs : List A.R) : E.R = (MonicReduce[l].Horner[A,DNE.ring,dual,(t,E.o)].horner fs).2 ;
 Root (x : B.R) (P : List A.R) : U l =
  (N : Nat) * IGE.InmB (E.mul (PE.power (j.1 s) N) (MonicReduce[l].Horner[A,E,iota,j.1 x].horner P)) ;
 Separable (x : B.R) (P : List A.R) : U l =
  (w : E.R) * (N : Nat) * IGE.InmB (E.mul (PE.power (j.1 s) N) (E.add (E.mul (slope (j.1 x) P) w) (E.neg E.o))) ;
 Generates (x : B.R) : U l =
  (i : Ps.Fin r) -> (C : List A.R) * (N : Nat) * IGB.InmB (B.mul (PB.power s N) (B.add (bs i) (B.neg (MonicReduce[l].Horner[A,B,iB,x].horner C)))) ;
 Factor (x : B.R) : U l = (P : List A.R) * Root x P * Separable x P * Generates x ;
 poly {x : B.R} (F : Factor x) : List A.R = F.1 ;
 root {x : B.R} (F : Factor x) : Root x (poly F) = F.2.1 ;
 separable {x : B.R} (F : Factor x) : Separable x (poly F) = F.2.2.1 ;
 generates {x : B.R} (F : Factor x) : Generates x = F.2.2.2 ;

 ---------------------------------------------------------------------
 -- 0. x - 1 generates as well, with P(X + 1)

 module Shift (x : B.R) (F : Factor x) {
  x' : B.R = B.add x (B.neg B.o) ;
  -- (x - 1) + 1 = x, in B, in E and in the dual numbers
  back-B : Id B.R (B.add x' B.o) x = trans (sym (B.addA x (B.neg B.o) B.o)) (trans (ap (B.add x) (LB.neg-cancel B.o)) (B.addZ x)) ;
  jx' : Id E.R (j.1 x') (E.add (j.1 x) (E.neg E.o)) =
   trans (j.2.2.1 x (B.neg B.o)) (ap (E.add (j.1 x)) (trans (H.negation B E j B.o) (ap E.neg j.2.1))) ;
  back-E : Id E.R (E.add (j.1 x') E.o) (j.1 x) =
   trans (ap (\ t -> E.add t E.o) jx') (trans (sym (E.addA (j.1 x) (E.neg E.o) E.o)) (trans (ap (E.add (j.1 x)) (LE.neg-cancel E.o)) (E.addZ (j.1 x)))) ;
  back-D : Id DNE.Pair (DNE.plusQ (j.1 x',E.o) DNE.oneQ) (j.1 x,E.o) = DNE.eq _ _ back-E (E.addZ E.o) ;
  module HB = HornerValues[l].Over[A,setA,m,m-zero,m-add,m-scale,dec,rad,B,setB,iB,x'] ;
  module HE = HornerValues[l].Over[A,setA,m,m-zero,m-add,m-scale,dec,rad,E,setE,iota,j.1 x'] ;
  module HD = HornerValues[l].Over[A,setA,m,m-zero,m-add,m-scale,dec,rad,DNE.ring,DNE.set,dual,(j.1 x',E.o)] ;
  module SHB = HB.Shift[x,back-B] ; module SHE = HE.Shift[j.1 x,back-E] ; module SHD = HD.Shift[(j.1 x,E.o),back-D] ;
  P' : List A.R = SH.sh (poly F) ;
  root' : Root x' P' =
   ((root F).1,subst IGE.InmB (ap (E.mul (PE.power (j.1 s) (root F).1)) (sym (SHE.horner-sh (poly F)))) (root F).2) ;
  separable' : Separable x' P' =
   ((separable F).1,(separable F).2.1,
    subst IGE.InmB (ap (\ t -> E.mul (PE.power (j.1 s) (separable F).2.1) (E.add (E.mul t (separable F).1) (E.neg E.o)))
                     (sym (ap (\ p -> p.2) (SHD.horner-sh (poly F))))) (separable F).2.2) ;
  generates' : Generates x' = \ i ->
   (SH.sh ((generates F) i).1,((generates F) i).2.1,
    subst IGB.InmB (ap (\ t -> B.mul (PB.power s ((generates F) i).2.1) (B.add (bs i) (B.neg t))) (sym (SHB.horner-sh ((generates F) i).1)))
     ((generates F) i).2.2) ;
  factor : Factor x' = (P',root',separable',generates') ;
  -- if x is in q then x - 1 is not: their difference is 1
  out (hx : q (j.1 x)) (hx' : q (j.1 x')) : Empty =
   q-proper (subst q
    (trans (ap (\ t -> E.add (j.1 x) (E.neg t)) jx')
     (trans (ap (E.add (j.1 x)) (LE.negsub (j.1 x) E.o))
      (trans (E.addA (j.1 x) (E.neg (j.1 x)) E.o) (trans (ap (\ t -> E.add t E.o) (E.addN (j.1 x))) (LE.zl E.o)))))
    (q-add _ _ hx (q-neg _ hx'))) ;
 } ;
 -- a generator outside q
 Generator : U l = (x : B.R) * Not (q (j.1 x)) * Factor x ;
 choose-case (x : B.R) (F : Factor x) : Plus (q (j.1 x)) (Not (q (j.1 x))) -> Generator = split {
  inl hx -> (Shift[x,F].x',Shift[x,F].out hx,Shift[x,F].factor) ;
  inr hx -> (x,hx,F) } ;
 choose (x : B.R) (F : Factor x) : Generator = choose-case x F (q-dec (j.1 x)) ;

 ---------------------------------------------------------------------
 -- 1. Lemma 1 modulo m B, for an element z of B

 -- 1 = sum_k c_k b_k
 module One (c1 : Coord B.o) {
  cB (k : Ps.Fin r) : B.R = iB.1 (c1.1 k) ;
  oneB : Id B.R (SB.lin r cB bs) B.o = sym c1.2 ;
 } ;
 module Residual (c1 : Coord B.o) (z : B.R) (cz : (i : Ps.Fin r) -> Coord (B.mul z (bs i))) {
  module O = One[c1] ;
  -- z b_i = sum_k b_k a_ki
  a (k i : Ps.Fin r) : A.R = (cz i).1 k ;
  integral (i : Ps.Fin r) : Id B.R (B.mul z (bs i)) (Determinant[l].Over[B,setB].act r (\ k i1 -> iB.1 (a k i1)) bs i) =
   trans (cz i).2
    (SB.sum-cong r (\ k -> B.mul (iB.1 (a k i)) (bs k)) (\ k -> B.mul (bs k) (iB.1 (a k i))) (\ k -> B.mulC (iB.1 (a k i)) (bs k))) ;
  module LIz = LoopInputs[l].Over[A,setA,m,m-zero,m-add,m-scale,dec,rad,B,setB,iB,z] ;
  module IT = LIz.Integral[n',a,bs,integral,O.cB,O.oneB] ;
  module IM = IdempotentModM[l].Over[A,m,dec,B,iB,IGB.InmB,IGB.in-zero,IGB.in-add,IGB.in-scale,IGB.in-m,z] ;
  -- z is a root of chi = monic (coefs r cf)
  chi-root : IGB.InmB (IM.Hs.horner (IM.monic (IM.coefs r IT.cf))) =
   subst IGB.InmB (sym (trans (IM.horner-monic r IT.cf)
     (trans (B.addC (IM.PS.psum r (\ i -> iB.1 (IT.cf i))) (PB.power z r)) IT.root))) IGB.in-zero ;
  module Lm = IM.Lemma[IM.monic (IM.coefs r IT.cf),IM.monic-nonzero (IM.coefs r IT.cf),chi-root] ;
 } ;

 -- the list of a finite sum
 sumL : (n : Nat) -> (Ps.Fin n -> List A.R) -> List A.R = split {
  zero -> \ f -> nil ; suc n | rr -> \ f -> MR.addP (f (inr tt)) (rr (\ i -> f (inl i))) } ;

 module Main (x : B.R) (x-out : Not (q (j.1 x))) (F : Factor x) {
  ---------------------------------------------------------------------
  -- the coordinates of 1, s and s b_i: a mere choice
  Choice0 : U l = Coord B.o * Coord s * ((i : Ps.Fin r) -> Coord (B.mul s (bs i))) ;
  choice0 : Tr.Trunc[Choice0].carrier =
   TC.pair (Coord B.o) (Coord s * ((i : Ps.Fin r) -> Coord (B.mul s (bs i)))) (coord B.o)
    (TC.pair (Coord s) ((i : Ps.Fin r) -> Coord (B.mul s (bs i))) (coord s) (choose-coords r (\ i -> B.mul s (bs i)))) ;
  module Step0 (c0 : Choice0) {
  -- 1. the idempotent e for s
  module RS = Residual[c0.1,s,c0.2.2] ;
  module Ide = RS.Lm.Ide ;
  e : B.R = Ide.e ;
  -- e - e e in m B
  e-sub : IGB.InmB (B.add e (B.neg (B.mul e e))) =
   RS.IM.I-eq (trans (LB.negsub (B.mul e e) e) (B.addC (B.neg (B.mul e e)) e)) (RS.IM.I-neg _ Ide.idempotent) ;

  ---------------------------------------------------------------------
  -- 2. y = x e, and y B in R[y] + m B
  y : B.R = B.mul x e ;
  module HBx = MonicReduce[l].Horner[A,B,iB,x] ;
  module LIy = LoopInputs[l].Over[A,setA,m,m-zero,m-add,m-scale,dec,rad,B,setB,iB,y] ;
  -- e (c + x a) - e (c + x e b) = x (e a - e b) + x b (e - e e)
  eh-step (c a b : B.R) :
   Id B.R (B.add (B.mul x (B.add (B.mul e a) (B.neg (B.mul e b)))) (B.mul (B.mul x b) (B.add e (B.neg (B.mul e e)))))
          (B.add (B.mul e (B.add c (B.mul x a))) (B.neg (B.mul e (B.add c (B.mul y b))))) = trans (calc B.R {
   B.add (B.mul x (B.add (B.mul e a) (B.neg (B.mul e b)))) (B.mul (B.mul x b) (B.add e (B.neg (B.mul e e))))
    =< Ps.cong2 B.R B.add _ _ _ _
        (trans (B.dist x (B.mul e a) (B.neg (B.mul e b))) (ap (B.add (B.mul x (B.mul e a))) (LB.mul-neg x (B.mul e b))))
        (trans (B.dist (B.mul x b) e (B.neg (B.mul e e)))
          (Ps.cong2 B.R B.add _ _ _ _
            (trans (sym (B.mulA x b e)) (ap (B.mul x) (B.mulC b e)))
            (trans (LB.mul-neg (B.mul x b) (B.mul e e))
              (ap B.neg (trans (sym (B.mulA x b (B.mul e e)))
                (ap (B.mul x) (trans (B.mulC b (B.mul e e)) (sym (B.mulA e e b)))))))))
     > B.add (B.add (B.mul x (B.mul e a)) (B.neg (B.mul x (B.mul e b)))) (B.add (B.mul x (B.mul e b)) (B.neg (B.mul x (B.mul e (B.mul e b)))))
    =< StB.cancel-mid (B.mul x (B.mul e a)) (B.mul x (B.mul e b)) (B.mul x (B.mul e (B.mul e b)))
     > B.add (B.mul x (B.mul e a)) (B.neg (B.mul x (B.mul e (B.mul e b)))) })
   (sym (calc B.R {
   B.add (B.mul e (B.add c (B.mul x a))) (B.neg (B.mul e (B.add c (B.mul y b))))
    =< Ps.cong2 B.R B.add _ _ _ _
        (trans (B.dist e c (B.mul x a)) (ap (B.add (B.mul e c)) (LB.mul-swap e x a)))
        (ap B.neg (trans (B.dist e c (B.mul y b))
          (ap (B.add (B.mul e c)) (trans (ap (B.mul e) (sym (B.mulA x e b))) (LB.mul-swap e x (B.mul e b))))))
     > B.add (B.add (B.mul e c) (B.mul x (B.mul e a))) (B.neg (B.add (B.mul e c) (B.mul x (B.mul e (B.mul e b)))))
    =< StB.diff-common (B.mul e c) (B.mul x (B.mul e a)) (B.mul x (B.mul e (B.mul e b)))
     > B.add (B.mul x (B.mul e a)) (B.neg (B.mul x (B.mul e (B.mul e b)))) })) ;
  -- e C(x) = e C(y) mod m B
  e-horner : (fs : List A.R) -> IGB.InmB (B.add (B.mul e (HBx.horner fs)) (B.neg (B.mul e (LIy.Hb.horner fs)))) = split {
   nil -> RS.IM.I-eq (sym (B.addN (B.mul e B.z))) IGB.in-zero ;
   cons f fs | ih -> RS.IM.I-eq (eh-step (iB.1 f) (HBx.horner fs) (LIy.Hb.horner fs))
     (IGB.in-add _ _ (IGB.in-scale x _ ih) (IGB.in-scale (B.mul x (LIy.Hb.horner fs)) _ e-sub)) } ;
  -- b_i = C_i(x) on the factor
  Ci (i : Ps.Fin r) : List A.R = ((generates F) i).1 ;
  -- e b_i = e C_i(x) mod m B
  e-gen (i : Ps.Fin r) : IGB.InmB (B.add (B.mul e (bs i)) (B.neg (B.mul e (HBx.horner (Ci i))))) =
   RS.IM.I-eq (trans (B.dist e (bs i) (B.neg (HBx.horner (Ci i)))) (ap (B.add (B.mul e (bs i))) (LB.mul-neg e (HBx.horner (Ci i)))))
    (Ide.kill ((generates F) i).2.1 _ ((generates F) i).2.2) ;
  -- y b_i = (X C_i)(y) mod m B
  sys-mod (i : Ps.Fin r) : IGB.InmB (B.add (B.mul y (bs i)) (B.neg (LIy.Hb.horner (cons A.z (Ci i))))) =
   RS.IM.I-eq (calc B.R {
    B.add (B.mul x (B.add (B.mul e (bs i)) (B.neg (B.mul e (HBx.horner (Ci i))))))
          (B.mul x (B.add (B.mul e (HBx.horner (Ci i))) (B.neg (B.mul e (LIy.Hb.horner (Ci i))))))
     =< sym (B.dist x _ _)
      > B.mul x (B.add (B.add (B.mul e (bs i)) (B.neg (B.mul e (HBx.horner (Ci i)))))
                       (B.add (B.mul e (HBx.horner (Ci i))) (B.neg (B.mul e (LIy.Hb.horner (Ci i))))))
     =< ap (B.mul x) (StB.cancel-mid (B.mul e (bs i)) (B.mul e (HBx.horner (Ci i))) (B.mul e (LIy.Hb.horner (Ci i))))
      > B.mul x (B.add (B.mul e (bs i)) (B.neg (B.mul e (LIy.Hb.horner (Ci i)))))
     =< trans (B.dist x (B.mul e (bs i)) (B.neg (B.mul e (LIy.Hb.horner (Ci i)))))
         (Ps.cong2 B.R B.add _ _ _ _ (B.mulA x e (bs i))
           (trans (LB.mul-neg x (B.mul e (LIy.Hb.horner (Ci i))))
             (ap B.neg (trans (B.mulA x e (LIy.Hb.horner (Ci i)))
               (sym (trans (ap (\ t -> B.add t (B.mul y (LIy.Hb.horner (Ci i)))) (H.zero A B iB)) (LB.zl (B.mul y (LIy.Hb.horner (Ci i))))))))))
      > B.add (B.mul y (bs i)) (B.neg (LIy.Hb.horner (cons A.z (Ci i)))) })
    (IGB.in-add _ _ (IGB.in-scale x _ (e-gen i)) (IGB.in-scale x _ (e-horner (Ci i)))) ;
  -- coordinates in m of the elements y b_i - (X C_i)(y) of m B: a mere choice
  SysElt (i : Ps.Fin r) : B.R = B.add (B.mul y (bs i)) (B.neg (LIy.Hb.horner (cons A.z (Ci i)))) ;
  Choice1 : U l = (i : Ps.Fin r) -> Coords (SysElt i) ;
  choice1 : Tr.Trunc[Choice1].carrier = EtaleCase[l].choice r (\ i -> Coords (SysElt i)) (\ i -> coords _ (sys-mod i)) ;
  module Step1 (cm : Choice1) {
  -- the system of Lemma 2: y b_i = (X C_i)(y) + sum_k b_k mu_ki, mu_ki in m
  mu (k i : Ps.Fin r) : A.R = (cm i).1 k ;
  Cpoly (i : Ps.Fin r) : LIy.RX.Carrier = LIy.Ho.horner (cons A.z (Ci i)) ;
  system (i : Ps.Fin r) : Id B.R (B.mul y (bs i)) (B.add (LIy.ev.1 (Cpoly i)) (SB.lin r bs (\ k -> iB.1 (mu k i)))) =
   sym (trans (Ps.cong2 B.R B.add _ _ _ _ (LIy.ev-horner (cons A.z (Ci i))) (sym (cm i).2.2))
         (StB.add-sub (LIy.Hb.horner (cons A.z (Ci i))) (B.mul y (bs i)))) ;

  ---------------------------------------------------------------------
  -- 3. Lemma 2
  module DL = DeterminantLemma[l].Over[A,setA,B,setB,iB,y] ;
  module SYS = DL.System[r,mu,bs,Cpoly,system] ;
  p : B.R = SYS.p ;
  -- e and y are not in q
  j-one-sub : Id E.R (j.1 (B.add B.o (B.neg e))) (E.add E.o (E.neg (j.1 e))) =
   trans (j.2.2.1 B.o (B.neg e)) (Ps.cong2 E.R E.add _ _ _ _ j.2.1 (H.negation B E j e)) ;
  out-e : Plus (q (j.1 Ide.sN)) (q (j.1 (B.add B.o (B.neg e)))) -> q (j.1 e) -> Empty = split {
   inl h -> \ he -> power-out (j.1 s) s-out Ide.N (subst q (AffinePowers[l].power-map B E j s Ide.N) h) ;
   inr h -> \ he -> q-proper (subst q (StE.one-sub (j.1 e)) (q-add _ _ (subst q j-one-sub h) he)) } ;
  e-out : Not (q (j.1 e)) = \ he ->
   out-e (q-prime _ _ (subst q (j.2.2.2 Ide.sN (B.add B.o (B.neg e))) (q-mE _ (to-E _ Ide.e-one)))) he ;
  y-case : Plus (q (j.1 x)) (q (j.1 e)) -> Empty = split { inl h -> x-out h ; inr h -> e-out h } ;
  y-out : Not (q (j.1 y)) = \ hy -> y-case (q-prime _ _ (subst q (j.2.2.2 x e) hy)) ;
  -- q pulled back to B
  Jq (b : B.R) : U l = q (j.1 b) ;
  Jq-zero : Jq B.z = subst q (sym (H.zero B E j)) q-zero ;
  Jq-add (a c : B.R) (ha : Jq a) (hc : Jq c) : Jq (B.add a c) = subst q (sym (j.2.2.1 a c)) (q-add _ _ ha hc) ;
  Jq-scale (a c : B.R) (hc : Jq c) : Jq (B.mul a c) = subst q (sym (j.2.2.2 a c)) (q-scale _ _ hc) ;
  Jq-mu (k i : Ps.Fin r) : Jq (iB.1 (mu k i)) = subst q (sym (j-alg (mu k i))) (q-m _ ((cm i).2.1 k)) ;
  Jq-prime (a c : B.R) (h : Jq (B.mul a c)) : Plus (Jq a) (Jq c) = q-prime _ _ (subst q (j.2.2.2 a c) h) ;
  module CG = SYS.Congruence[Jq,Jq-zero,Jq-add,Jq-scale,Jq-mu] ;
  -- p is not in q
  p-out : Not (q (j.1 p)) = CG.Prime[Jq-prime,y-out].p-out ;

  -- lists for the polynomials F_k with F_k(y) = p b_k: a mere choice
  Representative (Fp : LIy.RX.Carrier) : U l = (L : List A.R) * Id LIy.RX.Carrier (LIy.RX.include L) Fp ;
  representative (Fp : LIy.RX.Carrier) : Tr.Trunc[Representative Fp].carrier =
   LIy.RX.Q.induction @l (\ F1 -> Tr.Trunc[Representative F1].carrier) (\ F1 -> Tr.Trunc[Representative F1].proposition)
    (\ L -> Tr.Trunc[Representative (LIy.RX.include L)].inc (L,refl (LIy.RX.include L))) Fp ;
  g : B.R = B.mul p s ;
  -- with the lists, the coordinates of g b_i and y b_i: a mere choice
  Lists : U l = (k : Ps.Fin r) -> Representative (SYS.Fk k) ;
  Choice : U l = Lists * ((i : Ps.Fin r) -> Coord (B.mul g (bs i))) * ((i : Ps.Fin r) -> Coord (B.mul y (bs i))) ;
  choice : Tr.Trunc[Choice].carrier =
   TC.pair Lists (((i : Ps.Fin r) -> Coord (B.mul g (bs i))) * ((i : Ps.Fin r) -> Coord (B.mul y (bs i))))
    (EtaleCase[l].choice r (\ k -> Representative (SYS.Fk k)) (\ k -> representative (SYS.Fk k)))
    (TC.pair ((i : Ps.Fin r) -> Coord (B.mul g (bs i))) ((i : Ps.Fin r) -> Coord (B.mul y (bs i)))
      (choose-coords r (\ i -> B.mul g (bs i))) (choose-coords r (\ i -> B.mul y (bs i)))) ;

  module Chosen (ch : Choice) {
   FL (k : Ps.Fin r) : Representative (SYS.Fk k) = ch.1 k ;
   module HVy = HornerValues[l].Over[A,setA,m,m-zero,m-add,m-scale,dec,rad,B,setB,iB,y] ;
   -- F_k(y) = p b_k
   FL-value (k : Ps.Fin r) : Id B.R (LIy.Hb.horner (FL k).1) (B.mul p (bs k)) =
    trans (HVy.value-class (FL k).1) (trans (ap LIy.ev.1 (FL k).2) (SYS.in-Ry k)) ;
   sumL-value : (n : Nat) (f : Ps.Fin n -> List A.R) -> Id B.R (LIy.Hb.horner (sumL n f)) (SB.sum n (\ i -> LIy.Hb.horner (f i))) = split {
    zero -> \ f -> refl B.z ;
    suc n | ih -> \ f -> trans (HVy.horner-add (f (inr tt)) (sumL n (\ i -> f (inl i))))
      (ap (B.add (LIy.Hb.horner (f (inr tt)))) (ih (\ i -> f (inl i)))) } ;
   -- p b = sum_k rho_k F_k(y), the value of the list rL b
   rL (b : B.R) (cb : Coord b) : List A.R = sumL r (\ k -> MR.pmul (cons (cb.1 k) nil) (FL k).1) ;
   rL-value (b : B.R) (cb : Coord b) : Id B.R (LIy.Hb.horner (rL b cb)) (B.mul p b) = calc B.R {
    LIy.Hb.horner (rL b cb)
     =< sumL-value r (\ k -> MR.pmul (cons (cb.1 k) nil) (FL k).1)
      > SB.sum r (\ k -> LIy.Hb.horner (MR.pmul (cons (cb.1 k) nil) (FL k).1))
     =< SB.sum-cong r (\ k -> LIy.Hb.horner (MR.pmul (cons (cb.1 k) nil) (FL k).1)) (\ k -> B.mul p (B.mul (iB.1 (cb.1 k)) (bs k)))
         (\ k -> trans (HVy.horner-mul (cons (cb.1 k) nil) (FL k).1)
                  (trans (Ps.cong2 B.R B.mul _ _ _ _ (HVy.horner-constant (cb.1 k)) (FL-value k))
                   (LB.mul-swap (iB.1 (cb.1 k)) p (bs k))))
      > SB.sum r (\ k -> B.mul p (B.mul (iB.1 (cb.1 k)) (bs k)))
     =< SB.sum-scale p r (\ k -> B.mul (iB.1 (cb.1 k)) (bs k)) > B.mul p (SB.sum r (\ k -> B.mul (iB.1 (cb.1 k)) (bs k)))
     =< ap (B.mul p) (sym cb.2) > B.mul p b } ;
   -- p and g = p s, and the list G of g
   PL : List A.R = rL B.o c0.1 ;
   PL-value : Id B.R (LIy.Hb.horner PL) p = trans (rL-value B.o c0.1) (B.mulO p) ;
   G : List A.R = rL s c0.2.1 ;
   module LIE = LoopInputs[l].Over[A,setA,m,m-zero,m-add,m-scale,dec,rad,E,setE,iota,j.1 y] ;
   module HVmap = HVy.Map[E,iota,j,j-alg] ;
   gE : E.R = LIE.Hb.horner G ;
   gE-value : Id E.R gE (j.1 g) = trans (sym (HVmap.horner-map G)) (ap j.1 (rL-value s c0.2.1)) ;
   -- g^N = p^N s^N in E
   g-power (N : Nat) : Id E.R (PE.power gE N) (E.mul (PE.power (j.1 p) N) (PE.power (j.1 s) N)) =
    trans (ap (\ t -> PE.power t N) (trans gE-value (j.2.2.2 p s))) (PE.power-mul (j.1 p) (j.1 s) N) ;

   ---------------------------------------------------------------------
   -- Full: z g^(k+1) = (P^k r_(b s))(y) when s^k z = j(b)
   lpow-value (L : List A.R) : (k : Nat) -> Id B.R (LIy.Hb.horner (LIE.lpow L k)) (PB.power (LIy.Hb.horner L) k) = split {
    zero -> trans (HVy.horner-constant A.o) iB.2.1 ;
    suc k | ih -> trans (HVy.horner-mul L (LIE.lpow L k)) (ap (B.mul (LIy.Hb.horner L)) ih) } ;
   module CDE = ClearDenominators[l].Over[A,setA,m,m-zero,m-add,m-scale,dec,rad,E,setE,iota,j.1 y] ;
   full-eq (z : E.R) (k : Nat) (b : B.R) (hz : Id E.R (E.mul (PE.power (j.1 s) k) z) (j.1 b)) (cb : Coord (B.mul b s)) :
    Id E.R (E.mul z (PE.power gE (suc k))) (LIE.Hb.horner (LIE.product PL (rL (B.mul b s) cb) k)) = calc E.R {
    E.mul z (PE.power gE (suc k))
     =< ap (E.mul z) (g-power (suc k)) > E.mul z (E.mul (PE.power (j.1 p) (suc k)) (PE.power (j.1 s) (suc k)))
     =< StE.five z (j.1 p) (PE.power (j.1 p) k) (j.1 s) (PE.power (j.1 s) k)
      > E.mul (PE.power (j.1 p) k) (E.mul (j.1 p) (E.mul (E.mul (PE.power (j.1 s) k) z) (j.1 s)))
     =< ap (\ t -> E.mul (PE.power (j.1 p) k) (E.mul (j.1 p) (E.mul t (j.1 s)))) hz
      > E.mul (PE.power (j.1 p) k) (E.mul (j.1 p) (E.mul (j.1 b) (j.1 s)))
     =< sym (trans (j.2.2.2 (PB.power p k) (B.mul p (B.mul b s)))
          (Ps.cong2 E.R E.mul _ _ _ _ (AffinePowers[l].power-map B E j p k) (trans (j.2.2.2 p (B.mul b s)) (ap (E.mul (j.1 p)) (j.2.2.2 b s)))))
      > j.1 (B.mul (PB.power p k) (B.mul p (B.mul b s)))
     =< ap j.1 (sym (Ps.cong2 B.R B.mul _ _ _ _ (trans (lpow-value PL k) (ap (\ t -> PB.power t k) PL-value)) (rL-value (B.mul b s) cb)))
      > j.1 (B.mul (LIy.Hb.horner (LIE.lpow PL k)) (LIy.Hb.horner (rL (B.mul b s) cb)))
     =< ap j.1 (sym (HVy.horner-mul (LIE.lpow PL k) (rL (B.mul b s) cb))) > j.1 (LIy.Hb.horner (LIE.product PL (rL (B.mul b s) cb) k))
     =< HVmap.horner-map (LIE.product PL (rL (B.mul b s) cb) k) > LIE.Hb.horner (LIE.product PL (rL (B.mul b s) cb) k) } ;
   -- merely: s^k z = j(b) (zmt), then coordinates of b s
   full : CDE.FullT G = \ z ->
    TC.bind (Zmt z) (CDE.FullAt G z)
     (\ w -> TC.map (Coord (B.mul w.2.1 s)) (CDE.FullAt G z)
       (\ cb -> (LIE.product PL (rL (B.mul w.2.1 s) cb) w.1,suc w.1,full-eq z w.1 w.2.1 w.2.2 cb)) (coord (B.mul w.2.1 s))) (zmt z) ;

   ---------------------------------------------------------------------
   -- 4. J = { w | g^k w in m E } (the note's m E_g, read in E)
   Jsat (w : E.R) : U l = (k : Nat) * IGE.InmB (E.mul (PE.power gE k) w) ;
   J-zero : Jsat E.z = (zero,subst IGE.InmB (sym (LE.one-left E.z)) IGE.in-zero) ;
   J-add (a c : E.R) (ha : Jsat a) (hc : Jsat c) : Jsat (E.add a c) =
    (plus ha.1 hc.1,subst IGE.InmB (sym (calc E.R {
      E.mul (PE.power gE (plus ha.1 hc.1)) (E.add a c)
       =< ap (\ t -> E.mul t (E.add a c)) (PE.power-add gE ha.1 hc.1) > E.mul (E.mul (PE.power gE ha.1) (PE.power gE hc.1)) (E.add a c)
       =< E.dist (E.mul (PE.power gE ha.1) (PE.power gE hc.1)) a c
        > E.add (E.mul (E.mul (PE.power gE ha.1) (PE.power gE hc.1)) a) (E.mul (E.mul (PE.power gE ha.1) (PE.power gE hc.1)) c)
       =< Ps.cong2 E.R E.add _ _ _ _
           (trans (ap (\ t -> E.mul t a) (E.mulC (PE.power gE ha.1) (PE.power gE hc.1))) (sym (E.mulA (PE.power gE hc.1) (PE.power gE ha.1) a)))
           (sym (E.mulA (PE.power gE ha.1) (PE.power gE hc.1) c))
        > E.add (E.mul (PE.power gE hc.1) (E.mul (PE.power gE ha.1) a)) (E.mul (PE.power gE ha.1) (E.mul (PE.power gE hc.1) c)) }))
     (IGE.in-add _ _ (IGE.in-scale (PE.power gE hc.1) _ ha.2) (IGE.in-scale (PE.power gE ha.1) _ hc.2))) ;
   J-scale (a c : E.R) (hc : Jsat c) : Jsat (E.mul a c) =
    (hc.1,subst IGE.InmB (LE.mul-swap a (PE.power gE hc.1) c) (IGE.in-scale a _ hc.2)) ;
   J-m (a : A.R) (ha : m a) : Jsat (iota.1 a) = (zero,subst IGE.InmB (sym (LE.one-left (iota.1 a))) (IGE.in-m a ha)) ;
   -- s^N w in m E gives w in J
   from-s (N : Nat) (w : E.R) (h : IGE.InmB (E.mul (PE.power (j.1 s) N) w)) : Jsat w =
    (N,subst IGE.InmB (sym (trans (ap (\ t -> E.mul t w) (g-power N)) (sym (E.mulA (PE.power (j.1 p) N) (PE.power (j.1 s) N) w))))
       (IGE.in-scale (PE.power (j.1 p) N) _ h)) ;
   -- g is not in q, and J is contained in q
   g-case : Plus (q (j.1 p)) (q (j.1 s)) -> Empty = split { inl h -> p-out h ; inr h -> s-out h } ;
   g-out : Not (q gE) = \ h -> g-case (q-prime _ _ (subst q (trans gE-value (j.2.2.2 p s)) h)) ;
   q-J-case (w : E.R) (k : Nat) : Plus (q (PE.power gE k)) (q w) -> q w = split {
    inl h -> efq (power-out gE g-out k h) ; inr h -> h } ;
   q-J (w : E.R) (h : Jsat w) : q w = q-J-case w h.1 (q-prime _ _ (q-mE _ h.2)) ;
   module DSy = DerivativeStep[l].Over[A,setA,m,E,setE,iota,j.1 y,Jsat,J-zero,J-add,J-scale,J-m] ;

   -- hG: Lemma 1 modulo m B for g
   module RG = Residual[c0.1,g,ch.2.1] ;
   j-rel (z v : B.R) (K : Nat) :
    Id E.R (j.1 (B.mul (PB.power z K) (B.add B.o (B.neg (B.mul z v))))) (E.mul (PE.power (j.1 z) K) (E.add E.o (E.neg (E.mul (j.1 z) (j.1 v))))) =
    trans (j.2.2.2 (PB.power z K) (B.add B.o (B.neg (B.mul z v))))
     (Ps.cong2 E.R E.mul _ _ _ _ (AffinePowers[l].power-map B E j z K)
      (trans (j.2.2.1 B.o (B.neg (B.mul z v))) (Ps.cong2 E.R E.add _ _ _ _ j.2.1 (trans (H.negation B E j (B.mul z v)) (ap E.neg (j.2.2.2 z v)))))) ;
   g-unit : Jsat (E.add E.o (E.neg (E.mul gE (j.1 RG.Lm.v)))) =
    (suc RG.Lm.k,subst IGE.InmB
      (trans (j-rel g RG.Lm.v (suc RG.Lm.k))
        (ap (\ t -> E.mul (PE.power t (suc RG.Lm.k)) (E.add E.o (E.neg (E.mul t (j.1 RG.Lm.v))))) (sym gE-value)))
      (to-E _ RG.Lm.rel)) ;
   hG : DSy.UnitMod (LIE.Hb.horner G) =
    (j.1 RG.Lm.v,DSy.J-eq (StE.neg-one-sub (E.mul gE (j.1 RG.Lm.v))) (DSy.J-neg _ g-unit)) ;

   -- hH: H = P, P(y) in J
   P : List A.R = poly F ;
   one-e : Jsat (E.add E.o (E.neg (j.1 e))) =
    from-s Ide.N _ (subst IGE.InmB (trans (j.2.2.2 Ide.sN (B.add B.o (B.neg e)))
      (Ps.cong2 E.R E.mul _ _ _ _ (AffinePowers[l].power-map B E j s Ide.N) j-one-sub)) (to-E _ Ide.e-one)) ;
   -- y = x mod J
   y-x : Jsat (E.add (j.1 y) (E.neg (j.1 x))) =
    DSy.J-eq (calc E.R {
     E.neg (E.mul (j.1 x) (E.add E.o (E.neg (j.1 e))))
      =< ap E.neg (trans (E.dist (j.1 x) E.o (E.neg (j.1 e))) (Ps.cong2 E.R E.add _ _ _ _ (E.mulO (j.1 x)) (LE.mul-neg (j.1 x) (j.1 e))))
       > E.neg (E.add (j.1 x) (E.neg (E.mul (j.1 x) (j.1 e))))
      =< LE.negsub (j.1 x) (E.mul (j.1 x) (j.1 e)) > E.add (E.neg (j.1 x)) (E.mul (j.1 x) (j.1 e))
      =< E.addC (E.neg (j.1 x)) (E.mul (j.1 x) (j.1 e)) > E.add (E.mul (j.1 x) (j.1 e)) (E.neg (j.1 x))
      =< ap (\ t -> E.add t (E.neg (j.1 x))) (sym (j.2.2.2 x e)) > E.add (j.1 y) (E.neg (j.1 x)) })
     (DSy.J-neg _ (J-scale (j.1 x) _ one-e)) ;
   module HVE = HornerValues[l].Over[A,setA,m,m-zero,m-add,m-scale,dec,rad,E,setE,iota,j.1 y] ;
   module CgE = HVE.Congruence[Jsat,J-zero,J-add,J-scale,j.1 x,y-x] ;
   hH : Jsat (LIE.Hb.horner P) =
    DSy.J-eq (StE.sub-add (LIE.Hb.horner P) (CgE.Hb'.horner P))
     (J-add _ _ (CgE.horner-cong P) (from-s (root F).1 _ (root F).2)) ;

   -- hH': P'(y) a unit mod J, by the congruence y = x in the dual numbers
   JD (u : DNE.Pair) : U l = Jsat u.1 * Jsat u.2 ;
   JD-zero : JD DNE.zeroQ = (J-zero,J-zero) ;
   JD-add (a c : DNE.Pair) (ha : JD a) (hc : JD c) : JD (DNE.plusQ a c) = (J-add _ _ ha.1 hc.1,J-add _ _ ha.2 hc.2) ;
   JD-scale (a c : DNE.Pair) (hc : JD c) : JD (DNE.timesQ a c) =
    (J-add _ _ (J-scale a.1 _ hc.1) (DSy.J-eq (sym (LE.zero-mul (E.mul a.2 c.2))) J-zero),
     J-add _ _ (J-scale a.1 _ hc.2) (J-scale a.2 _ hc.1)) ;
   module HVD = HornerValues[l].Over[A,setA,m,m-zero,m-add,m-scale,dec,rad,DNE.ring,DNE.set,dual,(j.1 y,E.o)] ;
   module CgD = HVD.Congruence[JD,JD-zero,JD-add,JD-scale,(j.1 x,E.o),(y-x,DSy.J-eq (sym (E.addN E.o)) J-zero)] ;
   slope-congr : Jsat (E.add (slope (j.1 y) P) (E.neg (slope (j.1 x) P))) = (CgD.horner-cong P).2 ;
   sep-unit : DSy.UnitMod (slope (j.1 x) P) = ((separable F).1,from-s (separable F).2.1 _ (separable F).2.2) ;
   -- by definition, DerivativeStep's dual numbers and dual-iota are DNE and dual
   slope-is (t : E.R) (fs : List A.R) :
    Id E.R ((MonicReduce[l].Horner[A,DSy.DN.ring,DSy.dual-iota,(t,E.o)].horner fs).2) (slope t fs) = refl (slope t fs) ;
   module HVDy = HornerValues[l].Over[A,setA,m,m-zero,m-add,m-scale,dec,rad,DSy.DN.ring,DSy.DN.set,DSy.dual-iota,(j.1 y,E.o)] ;
   -- P'(y) = der P, the epsilon-component of P(y + epsilon)
   der-slope : Id E.R (DSy.der (LIE.Ho.horner P)) (slope (j.1 y) P) =
    trans (ap (\ u -> u.2) (HVDy.LI.ev-horner P)) (slope-is (j.1 y) P) ;
   hH' : DSy.UnitMod (DSy.der (LIE.Ho.horner P)) =
    subst DSy.UnitMod (sym der-slope) (DSy.unit-mod-congr (slope (j.1 y) P) (slope (j.1 x) P) slope-congr sep-unit) ;

   ---------------------------------------------------------------------
   -- the integrality equations of y in E (images of the generators)
   module RY = Residual[c0.1,y,ch.2.2] ;
   module O = One[c0.1] ;
   bsE (k : Ps.Fin r) : E.R = j.1 (bs k) ;
   cE (k : Ps.Fin r) : E.R = j.1 (O.cB k) ;
   integralE (i : Ps.Fin r) : Id E.R (E.mul (j.1 y) (bsE i)) (Determinant[l].Over[E,setE].act r (\ k i1 -> iota.1 (RY.a k i1)) bsE i) =
    trans (sym (j.2.2.2 y (bs i))) (trans (ap j.1 (RY.integral i))
     (trans (Jm.sum-map r (\ k -> B.mul (bs k) (iB.1 (RY.a k i))))
      (SE.sum-cong r (\ k -> j.1 (B.mul (bs k) (iB.1 (RY.a k i)))) (\ k -> E.mul (bsE k) (iota.1 (RY.a k i)))
        (\ k -> trans (j.2.2.2 (bs k) (iB.1 (RY.a k i))) (ap (E.mul (j.1 (bs k))) (j-alg (RY.a k i))))))) ;
   oneE : Id E.R (SE.lin r cE bsE) E.o =
    trans (sym (trans (Jm.sum-map r (\ k -> B.mul (O.cB k) (bs k)))
                 (SE.sum-cong r (\ k -> j.1 (B.mul (O.cB k) (bs k))) (\ k -> E.mul (cE k) (bsE k)) (\ k -> j.2.2.2 (O.cB k) (bs k)))))
     (trans (ap j.1 O.oneB) j.2.1) ;

   -- the certificate (G^n P)(y) = sum_i mu_i R_i(y): g^k P(y) in m E, cleared
   module CL = CDE.Clear[G] ;
   Clearing : U l = CL.Cleared (IGE.Ls.lsum IGE.value hH.2.1) ;
   clearing : Tr.Trunc[Clearing].carrier = CL.clearT full hH.2.1 ;
   module Cl (cl : Clearing) {
   n : Nat = plus cl.1 hH.1 ;
   qs : List CL.PGen = cl.2.1 ;
   kc : Nat = len qs ;
   mu' (i : Ps.Fin kc) : A.R = (IGE.Ls.at qs i).1 ;
   mu'-m (i : Ps.Fin kc) : m (mu' i) = (IGE.Ls.at qs i).2.1 ;
   Rs (i : Ps.Fin kc) : List A.R = (IGE.Ls.at qs i).2.2 ;
   cert : Id E.R (LIE.Hb.horner (LIE.product G P n)) (LIE.S.sum kc (\ i -> E.mul (iota.1 (mu' i)) (LIE.Hb.horner (Rs i)))) = calc E.R {
    LIE.Hb.horner (LIE.product G P n)
     =< CL.hb-product P n > E.mul (PE.power gE n) (LIE.Hb.horner P)
     =< ap (\ t -> E.mul t (LIE.Hb.horner P)) (PE.power-add gE cl.1 hH.1) > E.mul (E.mul (PE.power gE cl.1) (PE.power gE hH.1)) (LIE.Hb.horner P)
     =< sym (E.mulA (PE.power gE cl.1) (PE.power gE hH.1) (LIE.Hb.horner P)) > E.mul (PE.power gE cl.1) (E.mul (PE.power gE hH.1) (LIE.Hb.horner P))
     =< ap (E.mul (PE.power gE cl.1)) hH.2.2 > E.mul (PE.power gE cl.1) (IGE.Ls.lsum IGE.value hH.2.1)
     =< cl.2.2 > IGE.Ls.lsum CL.pvalue qs
     =< IGE.Ls.lsum-sum CL.pvalue qs > LIE.S.sum kc (\ i -> E.mul (iota.1 (mu' i)) (LIE.Hb.horner (Rs i))) } ;

   ---------------------------------------------------------------------
   -- Section 1 in E with J
   module S1 = LIE.Section1[Jsat,J-zero,J-add,J-scale,J-m,n',RY.a,bsE,integralE,cE,oneE,G,P,n,kc,mu',mu'-m,Rs,cert,hH,hH',hG] ;
   -- the conclusions: Q(y) = 0, G^n P = U Q + [c]_e, Q'(y) a unit mod J, hence not in q
   root-Q : Id E.R (LIE.pw S1.S1.e) (LIE.MP.V S1.S1.e S1.S1.a) = S1.root ;
   -- Q'(y), the epsilon-component of Q(y + epsilon)
   Qprime : E.R = S1.LQ.DS.der S1.S1.Q ;
   Qprime-unit : S1.LQ.DS.UnitMod Qprime = S1.q-prime ;
   -- Q'(y) v - 1 is in J, hence in q; so Q'(y) is not in q
   Qprime-out (h : q Qprime) : Empty =
    q-proper (subst q (StE.sub-sub (E.mul Qprime Qprime-unit.1) E.o)
     (q-add (E.mul Qprime Qprime-unit.1) (E.neg (E.add (E.mul Qprime Qprime-unit.1) (E.neg E.o)))
      (subst q (E.mulC Qprime-unit.1 Qprime) (q-scale Qprime-unit.1 Qprime h))
      (q-neg (E.add (E.mul Qprime Qprime-unit.1) (E.neg E.o)) (q-J (E.add (E.mul Qprime Qprime-unit.1) (E.neg E.o)) Qprime-unit.2)))) ;
   } ;
  } ;
  } ;
  } ;
 } ;

 ---------------------------------------------------------------------
 -- the field case: a generator x0 of the factor, then x not in q (step 0)
 module FieldCase (x0 : B.R) (F0 : Factor x0) {
  generator : Generator = choose x0 F0 ;
  module M = Main[generator.1,generator.2.1,generator.2.2] ;
 } ;
} ;
