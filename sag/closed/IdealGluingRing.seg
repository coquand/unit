-- The ring-level instance of Lemma 1.3.8.
-- Every ring is finitely presented over itself, so the fraction interface's
-- finite-presentation input places no restriction on this arbitrary ring.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module C = Algebras[l].Over[A,setA] ;
 module I = AffineInterface[l].Over[A,setA] ;
 module BaseP = BasePresentation[l].Over[A,setA] ;
 module At (m : Nat) (fs : Fin m -> A.R)
  (ls : (i : Fin m) -> I.LocalizationWitness C.base (fs i))
  (ns : Fin m -> Nat) (gs : (i : Fin m) -> Fin (ns i) -> (ls i).1.ring.R)
  (os : (i j : Fin m) -> I.LocalizationWitness (ls j).1 ((ls j).2.2.1.1.1 (fs i))) {
  module G = IdealGluingFractions[l].Over[A,setA].At[C.base,BaseP.finitely-presented,m,fs,ls,ns,gs,os] ;
  lemma-1-3-8 : G.Compatible -> Tr.Trunc[G.Result].carrier = G.glue ;
 } ;
} ;
