-- SAG 4.1.2: order-reversing equivalence between finitely generated
-- ideals of R and closed propositions. The inverse sends Q to
-- { a : R | Q -> a=0 }, so no representative is chosen from a truncation.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ; module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (sqc : Presentations[l].Over[R,setR].SQC) {
 module C = Algebras[l].Over[R,setR] ;
 module CP = ClosedProp[l].Over[R,setR] ;
 module I = Ideals[l].Over[R,setR] ;
 module BP = BasePresentation[l].Over[R,setR] ;
 module CI = ClosedInclusion[l].Over[R,setR] ;
 ClosedType : U l+ = (Q : U l) * CP.Closed Q ;
 Zero (J : I.Ideal) : U l = (a : R.R) -> J.1 a -> Id R.R a R.z ;
 zero-prop (J : I.Ideal) : Pr.isProp (Zero J) =
  F.isProp-Pi R.R (\ a -> J.1 a -> Id R.R a R.z)
   (\ a -> F.isProp-Pi (J.1 a) (\ h -> Id R.R a R.z) (\ h -> setR _ _)) ;
 module Finite (J : I.Ideal) (w : I.FGWitness J) {
  module G = GeneratedIdeal[l].Over[R,w.1,w.2.1] ;
  to-zeros (h : Zero J) : CP.Zeros w.1 w.2.1 =
   \ i -> h (w.2.1 i) ((w.2.2 (w.2.1 i)).2 (G.generator i)) ;
  from-zeros (h : CP.Zeros w.1 w.2.1) : Zero J =
   \ a u -> IdealVanishing[l].Over[R,R,setR,RingHom[l].identity R,w.1,w.2.1,h].vanish a ((w.2.2 a).1 u) ;
  closed : CP.Closed (Zero J) =
   Tr.Trunc[CP.Witness (Zero J)].inc
    (CP.from-iff (Zero J) (zero-prop J) w.1 w.2.1 to-zeros from-zeros) ;
  zero-test (a : R.R) (h : Zero J -> Id R.R a R.z) : J.1 a =
   (w.2.2 a).2
    (CI.At[C.base,w.1,w.2.1,suc zero,\ i -> a].SAG[sqc,BP.finitely-presented].to-ideal
     (\ x zs i -> trans (x.2 a) (h (from-zeros (\ j -> trans (sym (x.2 (w.2.1 j))) (zs j))))) (inr tt)) ;
 } ;
 zero-closed (J : I.Ideal) : I.FG J -> CP.Closed (Zero J) =
  Tr.Trunc[I.FGWitness J].induction @l (\ t -> CP.Closed (Zero J))
   (\ t -> Tr.Trunc[CP.Witness (Zero J)].proposition) (\ w -> Finite[J,w].closed) ;
 zero-test (J : I.FinitelyGenerated) (a : R.R) (h : Zero J.1 -> Id R.R a R.z) : J.1.1 a =
  Tr.Trunc[I.FGWitness J.1].induction @l (\ t -> J.1.1 a) (\ t -> J.1.2.1 a)
   (\ w -> Finite[J.1,w].zero-test a h) J.2 ;
 forward (J : I.FinitelyGenerated) : ClosedType = (Zero J.1,zero-closed J.1 J.2) ;
 module From (Q : U l) {
  member (a : R.R) : U l = Q -> Id R.R a R.z ;
  proposition (a : R.R) : Pr.isProp (member a) = F.isProp-Pi Q (\ q -> Id R.R a R.z) (\ q -> setR _ _) ;
  zero-member : member R.z = \ q -> refl R.z ;
  addition (a b : R.R) (h : member a) (k : member b) : member (R.add a b) =
   \ q -> trans (cong2 R.R R.add _ _ _ _ (h q) (k q)) (R.addZ R.z) ;
  scale (a b : R.R) (h : member b) : member (R.mul a b) =
   \ q -> trans (ap (R.mul a) (h q)) (RL[R].mul-zero a) ;
  ideal : I.Ideal = (member,proposition,zero-member,addition,scale) ;
  module Witness (w : CP.Witness Q) {
   module G = GeneratedIdeal[l].Over[R,w.1,w.2.1] ;
   from-member (a : R.R) (h : member a) : G.Member a =
    CI.At[C.base,w.1,w.2.1,suc zero,\ i -> a].SAG[sqc,BP.finitely-presented].to-ideal
     (\ x zs i -> trans (x.2 a)
      (h (w.2.2.2.sec (\ j -> trans (sym (x.2 (w.2.1 j))) (zs j))))) (inr tt) ;
   to-member (a : R.R) (h : G.Member a) : member a = \ q ->
    IdealVanishing[l].Over[R,R,setR,RingHom[l].identity R,w.1,w.2.1,w.2.2.1 q].vanish a h ;
   fg : I.FGWitness ideal = (w.1,w.2.1,\ a -> (from-member a,to-member a)) ;
  } ;
  fg (closed : CP.Closed Q) : I.FG ideal =
   Tr.Trunc[CP.Witness Q].induction @l (\ t -> I.FG ideal)
    (\ t -> Tr.Trunc[I.FGWitness ideal].proposition)
    (\ w -> Tr.Trunc[I.FGWitness ideal].inc Witness[w].fg) closed ;
 } ;
 backward (Q : ClosedType) : I.FinitelyGenerated = (From[Q.1].ideal,From[Q.1].fg Q.2) ;
 module Round (Q : ClosedType) {
  module B = From[Q.1] ;
  to (h : Zero B.ideal) : Q.1 =
   Tr.Trunc[CP.Witness Q.1].induction @l (\ t -> Q.1) (\ t -> CP.closed-prop Q.1 Q.2)
    (\ w -> w.2.2.2.sec (\ i -> h (w.2.1 i) (\ q -> w.2.2.1 q i))) Q.2 ;
  from (q : Q.1) : Zero B.ideal = \ a h -> h q ;
  equivalence : Pr.Equiv (Zero B.ideal) Q.1 =
   (to,Pr.qinv _ _ to from (\ q -> CP.closed-prop Q.1 Q.2 _ q) (\ h -> zero-prop B.ideal _ h)) ;
 } ;
 fb (Q : ClosedType) : Id ClosedType (forward (backward Q)) Q =
  Hi.Sigma-eq (U l) (\ T -> CP.Closed T) _ _ _ _
   (Axioms[l].UnivalenceLemmas[univ @l].ua _ _ Round[Q].equivalence) Tr.Trunc[CP.Witness Q.1].proposition ;
 bf (J : I.FinitelyGenerated) : Id I.FinitelyGenerated (backward (forward J)) J =
  I.fg-ext _ J (\ a h -> zero-test J a h) (\ a h z -> z a h) ;
 equivalence : Hi.Equiv I.FinitelyGenerated ClosedType =
  (forward,Hi.qinv _ _ forward backward fb bf) ;
 reverses-forward (J K : I.FinitelyGenerated) (h : I.Included J.1 K.1) : Zero K.1 -> Zero J.1 =
  \ z a ja -> z a (h a ja) ;
 reverses-backward (J K : I.FinitelyGenerated) (h : Zero K.1 -> Zero J.1) : I.Included J.1 K.1 =
  \ a ja -> zero-test K a (\ z -> h z a ja) ;
} ;
