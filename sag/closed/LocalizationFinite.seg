-- Any algebra satisfying the localization UP is finitely presented
-- when the source is. This discharges the FP field of localization
-- witnesses rather than imposing it as an extra algebraic assumption.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr1 = Truncation[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ; module P = Presentations[l].Over[R,setR] ;
 module I = AffineInterface[l].Over[R,setR] ;
 module Uniq = LocalizationOverlap[l].Over[R,setR] ;
 module At (A : C.Algebra) (fp : P.FP A) (f : A.ring.R)
  (L : C.Algebra) (inc : C.Hom A L) (loc : I.Localizes A L f inc) {
  module Compare (k : I.LocalizationWitness A f) {
   forward : C.Hom k.1 L = (k.2.2.2.2 L).sec (inc,loc.1) ;
   backward : C.Hom L k.1 = (loc.2 k.1).sec (k.2.2.1,k.2.2.2.1) ;
   forward-beta (a : A.ring.R) : Id L.ring.R (forward.1.1 (k.2.2.1.1.1 a)) (inc.1.1 a) =
    ap (\ d -> d.1.1.1 a) ((k.2.2.2.2 L).sec-eq (inc,loc.1)) ;
   backward-beta (a : A.ring.R) : Id k.1.ring.R (backward.1.1 (inc.1.1 a)) (k.2.2.1.1.1 a) =
    ap (\ d -> d.1.1.1 a) ((loc.2 k.1).sec-eq (k.2.2.1,k.2.2.2.1)) ;
   fb-hom : Id (C.Hom L L) (C.compose L k.1 L forward backward) (C.identity L) =
    Uniq.unique A L f inc loc L _ _ (\ a -> trans (ap forward.1.1 (backward-beta a)) (forward-beta a)) ;
   bf-hom : Id (C.Hom k.1 k.1) (C.compose k.1 L k.1 backward forward) (C.identity k.1) =
    Uniq.unique A k.1 f k.2.2.1 k.2.2.2 k.1 _ _ (\ a -> trans (ap backward.1.1 (forward-beta a)) (backward-beta a)) ;
   equivalence : Pr.isEquiv k.1.ring.R L.ring.R forward.1.1 =
    Pr.qinv _ _ forward.1.1 backward.1.1
     (\ b -> ap (\ h -> h.1.1 b) fb-hom) (\ a -> ap (\ h -> h.1.1 a) bf-hom) ;
   finite : P.FP L = AlgebraInverse[l].Over[R,setR].transfer-fp k.1 L forward equivalence k.2.1 ;
  } ;
  finite : P.FP L =
   Tr1.Trunc[I.LocalizationWitness A f].induction @l+ (\ t -> P.FP L)
    (\ t -> Tr1.Trunc[P.Witness L].proposition) (\ k -> Compare[k].finite) (I.localize A fp f) ;
  witness : I.LocalizationWitness A f = (L,finite,inc,loc) ;
 } ;
} ;
