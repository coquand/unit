-- The global equation system in SAG 4.1.4. Local equations agree as
-- ideals on overlaps by 4.1.3; Lemma 1.3.8 glues them without taking radicals.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ; module P = Presentations[l].Over[R,setR] ;
 module I = AffineInterface[l].Over[R,setR] ; module Cl = ClosedProp[l].Over[R,setR] ;
 module Local = ClosedLocal[l].Over[R,setR] ;
 module O = StandardOpens[l].Over[R,setR] ;
 module At (A : C.Algebra) (fp : P.FP A) (sub : C.Spec A -> U l)
  (closed : Cl.ClosedSubtype (C.Spec A) sub) {
  prop (x : C.Spec A) : Pr.isProp (sub x) = Cl.closed-prop (sub x) (closed x) ;
  Equations : U l = (N : Nat) * (hs : Fin N -> A.ring.R) *
   ((x : C.Spec A) -> Pr.Equiv (sub x) (Cl.Zeros N (\ k -> x.1.1 (hs k)))) ;
  module Cover (w : Local.Witness A sub) {
   m : Nat = w.1 ; fs : Fin m -> A.ring.R = w.2.1 ;
   ls (i : Fin m) : I.LocalizationWitness A (fs i) = (w.2.2.2 i).1 ;
   ns (i : Fin m) : Nat = (w.2.2.2 i).2.1 ;
   gs (i : Fin m) : Fin (ns i) -> (ls i).1.ring.R = (w.2.2.2 i).2.2.1 ;
   equations (i : Fin m) (x : C.Spec (ls i).1) :
    Pr.Equiv (sub (Local.restrict A (fs i) (ls i) x)) (Cl.Zeros (ns i) (\ k -> x.1.1 (gs i k))) =
    (w.2.2.2 i).2.2.2 x ;
   covered (x : C.Spec A) : O.Union A m fs x =
    AffineCovers[l].Over[R,setR,axioms.loc].At[A,m,fs].cover w.2.2.1 x ;
   Overlaps : U l+ = (i j : Fin m) -> I.LocalizationWitness (ls j).1 ((ls j).2.2.1.1.1 (fs i)) ;
   overlaps : Tr1.Trunc[Overlaps].carrier =
    ClosedLocal[l].high-choice m
     (\ i -> (j : Fin m) -> I.LocalizationWitness (ls j).1 ((ls j).2.2.1.1.1 (fs i)))
     (\ i -> ClosedLocal[l].high-choice m
      (\ j -> I.LocalizationWitness (ls j).1 ((ls j).2.2.1.1.1 (fs i)))
      (\ j -> I.localize (ls j).1 (ls j).2.1 ((ls j).2.2.1.1.1 (fs i)))) ;
   module With (os : Overlaps) {
    module Glue = IdealGluingFractions[l].Over[R,setR].At[A,fp,m,fs,ls,ns,gs,os] ;
    module Overlap (i j : Fin m) {
     module T = LocalizationOverlap[l].Over[R,setR].At[A,fs i,fs j,ls i,ls j,os i j] ;
     module CI = ClosedInclusion[l].Over[R,setR].At[T.O,ns j,\ k -> T.fromJ.1.1 (gs j k),ns i,\ k -> T.fromI.1.1 (gs i k)] ;
     zero-inclusion : CI.Inclusion = \ x zs ->
      (equations i (T.pointI x)).1
       (Pr.subst (C.Spec A) sub _ _ (sym (T.same-point x)) ((equations j (T.pointJ x)).2.sec zs)) ;
     compatible : CI.IdealInclusion = CI.SAG[axioms.sqc,(os i j).2.1].to-ideal zero-inclusion ;
    } ;
    compatible : Glue.Compatible = \ i j -> Overlap[i,j].compatible ;
    module Glued (g : Glue.Result) {
     N : Nat = g.1 ; hs : Fin N -> A.ring.R = g.2.1 ;
     Z (x : C.Spec A) : U l = Cl.Zeros N (\ k -> x.1.1 (hs k)) ;
     module On (i : Fin m) {
      L : C.Algebra = (ls i).1 ;
      inc : C.Hom A L = (ls i).2.2.1 ;
      module GlobalIdeal = GeneratedIdeal[l].Over[L.ring,N,\ k -> inc.1.1 (hs k)] ;
      module LocalIdeal = GeneratedIdeal[l].Over[L.ring,ns i,gs i] ;
      to (x : C.Spec L) (u : sub (Local.restrict A (fs i) (ls i) x)) :
       Z (Local.restrict A (fs i) (ls i) x) = \ k ->
       IdealVanishing[l].Over[L.ring,R,setR,x.1,ns i,gs i,(equations i x).1 u].vanish (inc.1.1 (hs k))
        ((g.2.2 i (inc.1.1 (hs k))).1 (GlobalIdeal.generator k)) ;
      from (x : C.Spec L) (z : Z (Local.restrict A (fs i) (ls i) x)) :
       sub (Local.restrict A (fs i) (ls i) x) =
       (equations i x).2.sec (\ k ->
        IdealVanishing[l].Over[L.ring,R,setR,x.1,N,\ k -> inc.1.1 (hs k),z].vanish (gs i k)
         ((g.2.2 i (gs i k)).2 (LocalIdeal.generator k))) ;
      module Lift (x : C.Spec A) (u : RL[R].unit (x.1.1 (fs i))) {
       e : Pr.Equiv (C.Spec L) (I.D A (fs i)) = I.spectrum A (fs i) (ls i) ;
       y : C.Spec L = e.2.sec (x,u) ;
       beta : Id (C.Spec A) (Local.restrict A (fs i) (ls i) y) x =
        ap (\ d -> d.1) (e.2.sec-eq (x,u)) ;
       forward : sub x -> Z x =
        Pr.subst (C.Spec A) (\ x -> sub x -> Z x) _ _ beta (to y) ;
       backward : Z x -> sub x =
        Pr.subst (C.Spec A) (\ x -> Z x -> sub x) _ _ beta (from y) ;
      } ;
     } ;
     to (x : C.Spec A) (u : sub x) : Z x =
      Tr.Trunc[(i : Fin m) * RL[R].unit (x.1.1 (fs i))].induction @l
       (\ t -> Z x) (\ t -> Cl.zeros-prop N (\ k -> x.1.1 (hs k)))
       (\ v -> On[v.1].Lift[x,v.2].forward u) (covered x) ;
     from (x : C.Spec A) (z : Z x) : sub x =
      Tr.Trunc[(i : Fin m) * RL[R].unit (x.1.1 (fs i))].induction @l
       (\ t -> sub x) (\ t -> prop x) (\ v -> On[v.1].Lift[x,v.2].backward z) (covered x) ;
     result : Equations = (N,hs,\ x ->
      (Cl.from-iff (sub x) (prop x) N (\ k -> x.1.1 (hs k)) (to x) (from x)).2.2) ;
    } ;
    result : Tr.Trunc[Equations].carrier =
     Tr.Trunc[Glue.Result].induction @l (\ t -> Tr.Trunc[Equations].carrier)
      (\ t -> Tr.Trunc[Equations].proposition) (\ g -> Tr.Trunc[Equations].inc Glued[g].result)
      (Glue.glue compatible) ;
   } ;
   result : Tr.Trunc[Equations].carrier =
    Tr1.Trunc[Overlaps].induction @l (\ t -> Tr.Trunc[Equations].carrier)
     (\ t -> Tr.Trunc[Equations].proposition) (\ os -> With[os].result) overlaps ;
  } ;
  theorem : Tr.Trunc[Equations].carrier =
   Tr1.Trunc[Local.Witness A sub].induction @l (\ t -> Tr.Trunc[Equations].carrier)
    (\ t -> Tr.Trunc[Equations].proposition) (\ w -> Cover[w].result)
    Local.SAG[axioms].At[A,fp,sub,closed].theorem ;
 } ;
} ;
