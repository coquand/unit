-- Dual numbers distinguish genuine ideal membership from radical membership.
-- This is an essential boundary for the closed-locus criterion 4.1.3.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (one-nz : Not (Id R.R R.o R.z)) {
 module C = Algebras[l].Over[R,setR] ; module P = Presentations[l].Over[R,setR] ;
 module Q = QuadraticPairs[l].Over[R,setR,R.z] ;
 module N = QuadraticNormalForm[l].Over[R,setR,R.z] ;
 module Pow = AffinePowers[l].Over[Q.ring] ;
 empty : Fin zero -> Q.Pair = split { } ;
 module Zero = GeneratedIdeal[l].Over[Q.ring,zero,empty] ;
 epsilon-square : Id Q.Pair (Pow.power Q.tau (suc (suc zero))) Q.zeroQ =
  trans (ap (Q.timesQ Q.tau) (Q.one-mul Q.tau)) Q.square ;
 epsilon-nonzero (h : Id Q.Pair Q.tau Q.zeroQ) : Empty = one-nz (ap (\ p -> p.2) h) ;
 epsilon-not-member (h : Zero.Member Q.tau) : Empty =
  epsilon-nonzero (IdealVanishing[l].Over[Q.ring,Q.ring,Q.set,RingHom[l].identity Q.ring,zero,empty,
   \ i -> efq i].vanish Q.tau h) ;
 radical-witness : StandardOpens[l].Over[R,setR].RadicalWitness Q.algebra Q.tau zero empty =
  (suc (suc zero),Zero.I.equal _ _ epsilon-square) ;
 epsilon-in-radical : StandardOpens[l].Over[R,setR].Radical Q.algebra Q.tau zero empty =
  Tr.Trunc[StandardOpens[l].Over[R,setR].RadicalWitness Q.algebra Q.tau zero empty].inc radical-witness ;
 fp : P.FP Q.algebra = Tr1.Trunc[P.Witness Q.algebra].inc (N.J.presentation,N.pair-presentation) ;
 module SAG (sqc : P.SQC) {
  module Inclusion = ClosedInclusion[l].Over[R,setR].At[Q.algebra,zero,empty,suc zero,\ i -> Q.tau] ;
  -- Even though epsilon is nilpotent, it need not vanish on every synthetic point.
  zero-locus-not-contained (h : Inclusion.Inclusion) : Empty =
   epsilon-not-member (Inclusion.SAG[sqc,fp].to-ideal h (inr tt)) ;
 } ;
 #fails {
  false-radical-to-ideal : Zero.Member Q.tau = epsilon-in-radical ;
 } ;
 #fails {
  false-nilpotent-zero : Id Q.Pair Q.tau Q.zeroQ = refl Q.zeroQ ;
 } ;
} ;
