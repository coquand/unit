-- Literal ideal-order forms of SAG 4.1.2 and 4.1.3.
-- No choices of finite generating families are made.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ; module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module I = Ideals[l].Over[A,setA] ;
 reflexive (J : I.Ideal) : I.Included J J = \ a h -> h ;
 transitive (J K L : I.Ideal) (h : I.Included J K) (k : I.Included K L) : I.Included J L =
  \ a u -> k a (h a u) ;
 antisymmetric (J K : I.Ideal) (h : I.Included J K) (k : I.Included K J) : Id I.Ideal J K = I.ext J K h k ;
 mutual-prop (J K : I.Ideal) : Pr.isProp (I.Included J K * I.Included K J) =
  Pr.isProp-Sigma (I.Included J K) (\ h -> I.Included K J)
   (I.included-prop J K) (\ h -> I.included-prop K J) ;
 ideal-set : Hi.isSet I.Ideal = \ J ->
  Hi.Hedberg[I.Ideal,J,\ K -> I.Included J K * I.Included K J,
   \ K -> mutual-prop J K,(reflexive J,reflexive J),\ K h -> antisymmetric J K h.1 h.2].hedberg ;
 fg-set : Hi.isSet I.FinitelyGenerated =
  Hi.isSet-Sigma I.Ideal (\ J -> I.FG J) ideal-set
   (\ J -> Hi.prop-to-set (I.FG J) Tr.Trunc[I.FGWitness J].proposition) ;
 fg-reflexive (J : I.FinitelyGenerated) : I.Included J.1 J.1 = reflexive J.1 ;
 fg-transitive (J K L : I.FinitelyGenerated) (h : I.Included J.1 K.1) (k : I.Included K.1 L.1) : I.Included J.1 L.1 =
  transitive J.1 K.1 L.1 h k ;
 fg-antisymmetric (J K : I.FinitelyGenerated) (h : I.Included J.1 K.1) (k : I.Included K.1 J.1) :
  Id I.FinitelyGenerated J K = I.fg-ext J K h k ;
 zero-ideal : I.Ideal =
  (\ a -> Id A.R a A.z,\ a -> setA a A.z,refl A.z,
   \ a b h k -> trans (cong2 A.R A.add _ _ _ _ h k) (A.addZ A.z),
   \ a b h -> trans (ap (A.mul a) h) (RL[A].mul-zero a)) ;
 Vanishes (J : I.Ideal) : U l = (a : A.R) -> J.1 a -> Id A.R a A.z ;
 vanishes-prop (J : I.Ideal) : Pr.isProp (Vanishes J) =
  F.isProp-Pi A.R (\ a -> J.1 a -> Id A.R a A.z)
   (\ a -> F.isProp-Pi (J.1 a) (\ h -> Id A.R a A.z) (\ h -> setA _ _)) ;
 vanishes-to-zero (J : I.Ideal) (h : Vanishes J) : Id I.Ideal J zero-ideal =
  I.ext J zero-ideal h (\ a p -> Pr.subst A.R J.1 A.z a (sym p) J.2.2.1) ;
 zero-to-vanishes (J : I.Ideal) (h : Id I.Ideal J zero-ideal) : Vanishes J =
  Hi.subst I.Ideal (\ K -> Vanishes K) zero-ideal J (Hi.sym I.Ideal J zero-ideal h) (\ a p -> p) ;
 zero-equivalence (J : I.Ideal) : Hi.Equiv (Vanishes J) (Id I.Ideal J zero-ideal) =
  (vanishes-to-zero J,Hi.qinv _ _ (vanishes-to-zero J) (zero-to-vanishes J)
   (\ h -> ideal-set J zero-ideal _ h) (\ h -> vanishes-prop J _ h)) ;
 module FiniteInclusion (n : Nat) (fs : Fin n -> A.R) (m : Nat) (gs : Fin m -> A.R) {
  module G = GeneratedIdeal[l].Over[A,n,fs] ;
  module H = GeneratedIdeal[l].Over[A,m,gs] ;
  GeneratorInclusion : U l = (j : Fin m) -> G.Member (gs j) ;
  LiteralInclusion : U l = I.Included I.Gen[m,gs].ideal I.Gen[n,fs].ideal ;
  to-literal (h : GeneratorInclusion) : LiteralInclusion = G.includes m gs h ;
  from-literal (h : LiteralInclusion) : GeneratorInclusion = \ j -> h (gs j) (H.generator j) ;
  generator-prop : Pr.isProp GeneratorInclusion = F.isProp-Pi (Fin m) (\ j -> G.Member (gs j)) (\ j -> G.proposition (gs j)) ;
  equivalence : Pr.Equiv GeneratorInclusion LiteralInclusion =
   (to-literal,Pr.qinv _ _ to-literal from-literal
    (\ h -> I.included-prop I.Gen[m,gs].ideal I.Gen[n,fs].ideal _ h)
    (\ h -> generator-prop _ h)) ;
 } ;
} ;
module SAG (R : CRing) (setR : Pr.isSet R.R) (sqc : Presentations[l].Over[R,setR].SQC) {
 module C = Algebras[l].Over[R,setR] ; module P = Presentations[l].Over[R,setR] ;
 module I = Ideals[l].Over[R,setR] ; module O = Over[R,setR] ;
 module CI = ClosedIdeals[l].Over[R,setR,sqc] ;
 module CP = ClosedProp[l].Over[R,setR] ;
 ClosedIncluded (Q S : CI.ClosedType) : U l = Q.1 -> S.1 ;
 closed-included-prop (Q S : CI.ClosedType) : Pr.isProp (ClosedIncluded Q S) =
  F.isProp-Pi Q.1 (\ q -> S.1) (\ q -> CP.closed-prop S.1 S.2) ;
 closed-reflexive (Q : CI.ClosedType) : ClosedIncluded Q Q = \ q -> q ;
 closed-transitive (Q S T : CI.ClosedType) (h : ClosedIncluded Q S) (k : ClosedIncluded S T) : ClosedIncluded Q T = \ q -> k (h q) ;
 closed-antisymmetric (Q S : CI.ClosedType) (h : ClosedIncluded Q S) (k : ClosedIncluded S Q) : Id CI.ClosedType Q S =
  Hi.Sigma-eq (U l) (\ T -> CP.Closed T) Q.1 S.1 Q.2 S.2
   (Axioms[l].UnivalenceLemmas[univ @l].ua Q.1 S.1
    (h,Pr.qinv Q.1 S.1 h k (\ s -> CP.closed-prop S.1 S.2 _ s) (\ q -> CP.closed-prop Q.1 Q.2 _ q)))
   Tr.Trunc[CP.Witness S.1].proposition ;
 closed-mutual-prop (Q S : CI.ClosedType) : Pr.isProp (ClosedIncluded Q S * ClosedIncluded S Q) =
  Pr.isProp-Sigma (ClosedIncluded Q S) (\ h -> ClosedIncluded S Q)
   (closed-included-prop Q S) (\ h -> closed-included-prop S Q) ;
 closed-set : Hi.isSet CI.ClosedType = \ Q ->
  Hi.Hedberg[CI.ClosedType,Q,\ S -> ClosedIncluded Q S * ClosedIncluded S Q,
   \ S -> closed-mutual-prop Q S,(closed-reflexive Q,closed-reflexive Q),
   \ S h -> closed-antisymmetric Q S h.1 h.2].hedberg ;
 order-equivalence (J K : I.FinitelyGenerated) :
  Pr.Equiv (I.Included J.1 K.1) (ClosedIncluded (CI.forward K) (CI.forward J)) =
  (CI.reverses-forward J K,Pr.qinv _ _ (CI.reverses-forward J K) (CI.reverses-backward J K)
   (\ h -> closed-included-prop (CI.forward K) (CI.forward J) _ h)
   (\ h -> I.included-prop J.1 K.1 _ h)) ;
 zero-equivalence (J : I.Ideal) : Hi.Equiv (CI.Zero J) (Id I.Ideal J O.zero-ideal) = O.zero-equivalence J ;
 module Inclusion (A : C.Algebra) (fp : P.FP A) (n : Nat) (fs : Fin n -> A.ring.R)
  (m : Nat) (gs : Fin m -> A.ring.R) {
  module At = ClosedInclusion[l].Over[R,setR].At[A,n,fs,m,gs] ;
  module Gen = Over[A.ring,A.set].FiniteInclusion[n,fs,m,gs] ;
  equivalence : Pr.Equiv At.Inclusion Gen.LiteralInclusion =
   Equivalences[l].compose _ _ _ At.SAG[sqc,fp].equivalence Gen.equivalence ;
 } ;
} ;
