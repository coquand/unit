-- Lemma 1.3.8 with literal equalities of extended ideals on overlaps
-- and literal equality of each restriction of the global ideal.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ;
module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module C = Algebras[l].Over[A,setA] ;
 module I = AffineInterface[l].Over[A,setA] ;
 module IA = Ideals[l].Over[A,setA] ;
 module At (m : Nat) (fs : Fin m -> A.R)
  (ls : (i : Fin m) -> I.LocalizationWitness C.base (fs i))
  (js : (i : Fin m) -> Ideals[l].Over[(ls i).1.ring,(ls i).1.set].FinitelyGenerated)
  (os : (i j : Fin m) -> I.LocalizationWitness (ls j).1 ((ls j).2.2.1.1.1 (fs i))) {
  module G = IdealGluingIdeals[l].Over[A,setA].At[m,fs,ls,js,os] ;
  module On (i j : Fin m) {
   module Ov = G.Overlap[i,j] ;
   module IL = Ideals[l].Over[(ls i).1.ring,(ls i).1.set] ;
   module IO = Ideals[l].Over[Ov.O.ring,Ov.O.set] ;
   module Left = IdealGluingIdeals[l].Extension[(ls i).1.ring,Ov.O.ring,(ls i).1.set,Ov.O.set,Ov.left.1,(js i).1] ;
   Agreement : U l+ = Id IO.Ideal (Left.ideal (js i).2) (Ov.RightIdeal.ideal (js j).2) ;
   image (a : (ls i).1.ring.R) (h : (js i).1.1 a) : Left.Member (Ov.left.1.1 a) =
    Tr.Trunc[IL.FGWitness (js i).1].induction @l (\ t -> Left.Member (Ov.left.1.1 a))
     (\ t -> Left.proposition (Ov.left.1.1 a))
     (\ w -> Left.from-chosen w _ (Left.Chosen[w].from-member a h)) (js i).2 ;
   compatible (agree : Agreement) (a : (ls i).1.ring.R) (h : (js i).1.1 a) :
    Ov.RightIdeal.Member (Ov.left.1.1 a) =
    Hi.subst IO.Ideal (\ J -> J.1 (Ov.left.1.1 a)) _ _ agree (image a h) ;
  } ;
  Agreement : U l+ = (i j : Fin m) -> On[i,j].Agreement ;
  module Restriction (J : IA.FinitelyGenerated) (j : Fin m) {
   module IL = Ideals[l].Over[(ls j).1.ring,(ls j).1.set] ;
   Equality : U l+ = Id IL.Ideal (G.Global[J].In[j].Ext.ideal J.2) (js j).1 ;
   equality (h : G.Global[J].Matches) : Equality =
    IL.ext _ (js j).1 (\ a -> (h j a).1) (\ a -> (h j a).2) ;
  } ;
  Result : U l+ = (J : IA.FinitelyGenerated) * ((j : Fin m) -> Restriction[J,j].Equality) ;
  lemma-1-3-8 (agree : Agreement) : Tr1.Trunc[Result].carrier =
   Tr1.Trunc[G.Result].induction @l+ (\ t -> Tr1.Trunc[Result].carrier)
    (\ t -> Tr1.Trunc[Result].proposition)
    (\ w -> Tr1.Trunc[Result].inc (w.1,\ j -> Restriction[w.1,j].equality w.2))
    (G.lemma-1-3-8 (\ i j -> On[i,j].compatible (agree i j))) ;
 } ;
} ;
