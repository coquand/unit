-- Boundary regressions: no covering hypothesis, empty families, and
-- localizations at zero and one.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module I = AffineInterface[l].Over[R,setR] ;
 module Ex = AffineExamples[l].Over[R,setR] ;
 module Pow = AffinePowers[l].Over[R] ;
 -- The empty family is deliberately permitted: its union need not cover.
 empty-values : Fin zero -> R.R = split { } ;
 empty-localizations : (i : Fin zero) -> I.LocalizationWitness C.base (empty-values i) = split { } ;
 empty-sizes : Fin zero -> Nat = split { } ;
 empty-generators : (i : Fin zero) -> Fin (empty-sizes i) -> R.R = split { } ;
 empty-overlaps : (i j : Fin zero) ->
  I.LocalizationWitness (empty-localizations j).1 ((empty-localizations j).2.2.1.1.1 (empty-values i)) = split { } ;
 module EmptyGlue = IdealGluing[l].Over[R,setR].At[C.base,zero,empty-values,empty-localizations,
  empty-sizes,empty-generators,empty-overlaps] ;
 empty-compatible : EmptyGlue.Compatible = split { } ;
 empty-data : EmptyGlue.Data = split { } ;
 empty-generator-count : Id Nat EmptyGlue.Build[empty-data].total zero = refl zero ;
 empty-family-glues : Tr.Trunc[EmptyGlue.Result].carrier = EmptyGlue.glue empty-compatible ;
 -- At one, eventual equality reduces to actual equality in the source.
 power-one : (n : Nat) -> Id R.R (Pow.power R.o n) R.o = split {
  zero -> refl R.o ; suc n | ih -> trans (ap (R.mul R.o) ih) (R.mulO R.o) } ;
 one-times (n : Nat) (a : R.R) : Id R.R (R.mul (Pow.power R.o n) a) a =
  trans (ap (\ t -> R.mul t a) (power-one n)) (Pow.one-left a) ;
 module One = LocalizationKernel[l].Over[R,setR].At[C.base,Ex.One.L.algebra,R.o,
  Ex.One.L.inclusion,Ex.One.result.2.2.2] ;
 one-reflects (a b : R.R) (h : Id Ex.One.L.algebra.ring.R (Ex.One.L.inclusion.1.1 a) (Ex.One.L.inclusion.1.1 b)) :
  Id R.R a b =
  Tr.Trunc[One.EqualityWitness a b].induction @l (\ t -> Id R.R a b) (\ t -> setR a b)
   (\ w -> trans (sym (one-times w.1 a)) (trans w.2 (one-times w.1 b))) (One.clear-equal a b h) ;
 -- At zero, exponent one kills every source element.
 zero-times (a : R.R) : Id R.R (R.mul (Pow.power R.z (suc zero)) a) R.z =
  trans (ap (\ t -> R.mul t a) (RL[R].zero-mul R.o)) (RL[R].zero-mul a) ;
 module Zero = LocalizationKernel[l].Over[R,setR].At[C.base,Ex.Zero.L.algebra,R.z,
  Ex.Zero.L.inclusion,Ex.Zero.result.2.2.2] ;
 zero-identifies (a b : R.R) : Id Ex.Zero.L.algebra.ring.R (Ex.Zero.L.inclusion.1.1 a) (Ex.Zero.L.inclusion.1.1 b) =
  Zero.equal a b (Tr.Trunc[Zero.EqualityWitness a b].inc
   (suc zero,trans (zero-times a) (sym (zero-times b)))) ;
 module ZeroIdeal = LocalizationIdeal[l].Over[R,setR].At[C.base,Ex.Zero.L.algebra,R.z,
  Ex.Zero.L.inclusion,Ex.Zero.result.2.2.2,zero,empty-values] ;
 zero-localized-empty-ideal (a : R.R) : ZeroIdeal.IL.Member (Ex.Zero.L.inclusion.1.1 a) =
  ZeroIdeal.localize a (Tr.Trunc[ZeroIdeal.Witness a].inc
   (suc zero,ZeroIdeal.IA.equal R.z (R.mul (Pow.power R.z (suc zero)) a)
    (sym (zero-times a)) ZeroIdeal.IA.zero-member)) ;
 #fails {
  -- Clearing denominators is not cancellation of the denominator in R.
  false-kernel-cancellation : (a : R.R) ->
   Id Ex.Zero.L.algebra.ring.R (Ex.Zero.L.inclusion.1.1 a) Ex.Zero.L.algebra.ring.z -> Id R.R a R.z =
   Zero.clear ;
 } ;
 #fails {
  -- Equality after localizing at zero cannot be reflected to the source.
  false-zero-injection : Id R.R R.o R.z = zero-identifies R.o R.z ;
 } ;
 #fails {
  -- An arbitrary positive exponent does not disappear from membership.
  false-source-empty-ideal : ZeroIdeal.IA.Member R.o = zero-localized-empty-ideal R.o ;
 } ;
} ;
