-- van Benthem Jutting, "The development of a text in AUT-QE" (1973):
-- an injection of [1,n] into itself is a surjection.  This version: the
-- image is a proposition (a propositional truncation).
import Base ; import Prelude ; import Axioms ; import Replacement ; import Naturals ;
module Theory
 (univ : [l] Axioms[l].Univalence)
 (images : [l] [k] Replacement[l,k].Images)
 (surjections : [l] [k] [j] (Replacement[l,k].Surjectivity (images @l @k)) @j) {
 import Truncation ; import Injection ;
} ;
