-- A-linear degree projection from a native arbitrary-coordinate chart
-- ring into actual finitely supported homogeneous chart coefficient modules.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module Pr = Prelude[l] ; module RH = RingHom[l] ; module IP = IdealPowers[l] ;
module EX = GenericLaurent[l] ; module B = GenericSupport[l] ; module N = FiniteExponents[l] ;
module FP = FinitePolynomial4[l] ; module LG = Logic[l] ; module TC = TruncationCombinators[l] ;
Bad (n : Nat) (E : Sub n) (k : Int) (m : EX.Exp n) : U l =
 Plus (Not (Id Int (EX.total n m) k)) (B.bad n (EX.mask n m) E) ;
module Over (A : CRing) (setA : Pr.isSet A.R) (nvar : Nat) (E : Sub nvar) {
 module R = NativeChartRing[l].Over[A,setA,nvar,E] ; module V = LaurentExponentBridge[l].At[nvar] ;
 module Support = NativeChartSupport[l].Over[A,setA,nvar,E] ; module LO = EX.Over[A,setA] ;
 module RR = RL[R.ring] ; module AL = RL[A] ;
 module GP = GenericPolynomialRingLaws[l].Over[A,setA] ;
 iota : RH.Hom A R.ring = RH.compose A R.S R.ring R.inclusion (R.B.T.grD nvar).iota ;
 moduleM : IP.Mod[A] = IP.mkMod A R.ring.R R.ring.z R.ring.add R.ring.neg
   R.ring.addA R.ring.addC R.ring.addZ R.ring.addN (\ a x -> R.ring.mul (iota.1 a) x)
   (\ a b x -> trans (R.ring.mulA (iota.1 a) (iota.1 b) x) (ap (\ c -> R.ring.mul c x) (sym (iota.2.2.2 a b))))
   (\ x -> trans (ap (\ c -> R.ring.mul c x) iota.2.1) (RR.one-left x))
   (\ a x y -> R.ring.dist (iota.1 a) x y)
   (\ a b x -> trans (ap (\ c -> R.ring.mul c x) (iota.2.2.1 a b)) (RR.dist-left (iota.1 a) (iota.1 b) x)) ;
 constant-polynomial (a : A.R) : Id R.S.R (R.B.phi nvar (cons (a,N.zeroE nvar) nil)) ((R.B.T.grD nvar).iota.1 a) =
   trans (GP.At[nvar].phi-single (a,N.zeroE nvar)) (GP.term-zero nvar a) ;
 coeff-sm (a : A.R) (x : R.ring.R) (m : EX.Exp nvar) : Id A.R (R.coeff (moduleM.sm a x) m) (A.mul a (R.coeff x m)) =
   trans (ap (\ c -> R.coeff (R.ring.mul c x) m) (ap R.inclusion.1 (sym (constant-polynomial a))))
     (trans (R.coeff-mul-polynomial (cons (a,N.zeroE nvar) nil) x m)
       (trans (A.addZ (A.mul a (R.coeff x (V.subE m (N.zeroE nvar)))))
         (ap (\ u -> A.mul a (R.coeff x u)) (V.ext (V.subE m (N.zeroE nvar)) m (\ i -> refl (m i)))))) ;
 select-cong (k : Int) (m : (EX.Exp nvar)) (x y : A.R) (e : Id A.R x y) :
   Id A.R (FP.sel A x (Id Int (EX.total nvar m) k) (int-dec (EX.total nvar m) k)) (FP.sel A y (Id Int (EX.total nvar m) k) (int-dec (EX.total nvar m) k)) =
   ap (\ c -> FP.sel A c (Id Int (EX.total nvar m) k) (int-dec (EX.total nvar m) k)) e ;
 select-add (P : U l) (x y : A.R) : (d : LG.Dec P) ->
   Id A.R (FP.sel A (A.add x y) P d) (A.add (FP.sel A x P d) (FP.sel A y P d)) = split {
   yes h -> refl (A.add x y) ; no ne -> sym (A.addZ A.z) } ;
 select-sm (P : U l) (a x : A.R) : (d : LG.Dec P) ->
   Id A.R (FP.sel A (A.mul a x) P d) (A.mul a (FP.sel A x P d)) = split {
   yes h -> refl (A.mul a x) ; no ne -> sym (AL.mul-zero a) } ;
 select-zero (P : U l) (x : A.R) (e : Id A.R x A.z) (d : LG.Dec P) : Id A.R (FP.sel A x P d) A.z =
   trans (ap (\ c -> FP.sel A c P d) e) (FP.sel-zero A P d) ;
 module Part (k : Int) {
   value (x : R.ring.R) (m : (EX.Exp nvar)) : A.R = FP.sel A (R.coeff x m) (Id Int (EX.total nvar m) k) (int-dec (EX.total nvar m) k) ;
   at (x : R.ring.R) (m : (EX.Exp nvar)) (e : Id Int (EX.total nvar m) k) : Id A.R (value x m) (R.coeff x m) =
     FP.sel-yes A (R.coeff x m) (Id Int (EX.total nvar m) k) e (int-dec (EX.total nvar m) k) ;
   zero (x : R.ring.R) (m : (EX.Exp nvar)) (ne : Not (Id Int (EX.total nvar m) k)) : Id A.R (value x m) A.z =
     FP.sel-no A (R.coeff x m) (Id Int (EX.total nvar m) k) ne (int-dec (EX.total nvar m) k) ;
   van (x : R.ring.R) (m : (EX.Exp nvar)) : Bad nvar E k m -> Id A.R (value x m) A.z = split {
     inl ne -> zero x m ne ;
     inr b -> select-zero (Id Int (EX.total nvar m) k) (R.coeff x m) (Support.van x m b) (int-dec (EX.total nvar m) k) } ;
   module Into (I : U l) {
     module C = LO.Chart[EX.Exp nvar,I,\ i -> Bad nvar E k] ;
     support (x : R.ring.R) : C.Supp (\ i -> value x) = TC.map (R.Support (R.coeff x)) (C.SuppW (\ i -> value x))
       (\ w -> (w.1,\ i m nm -> select-zero (Id Int (EX.total nvar m) k) (R.coeff x m) (w.2 m nm) (int-dec (EX.total nvar m) k))) (R.finite x) ;
     element (x : R.ring.R) : C.El = C.mk (\ i -> value x) (support x) (\ i -> van x) ;
     add (x y : R.ring.R) : Id C.El (element (R.ring.add x y)) (C.mod.madd (element x) (element y)) =
       C.eq _ _ (\ i m -> trans (select-cong k m _ _ (R.coeff-add x y m))
         (select-add (Id Int (EX.total nvar m) k) (R.coeff x m) (R.coeff y m) (int-dec (EX.total nvar m) k))) ;
     sm (a : A.R) (x : R.ring.R) : Id C.El (element (moduleM.sm a x)) (C.mod.sm a (element x)) =
       C.eq _ _ (\ i m -> trans (select-cong k m _ _ (coeff-sm a x m))
         (select-sm (Id Int (EX.total nvar m) k) a (R.coeff x m) (int-dec (EX.total nvar m) k))) ;
     lin : IP.Lin[A,moduleM,C.mod] = IP.mkLin A moduleM C.mod element add sm ;
   } ;
 } ;
} ;
