-- Every native chart-ring element automatically has support on its
-- chart. A forbidden negative coordinate is not shifted by any power
-- of the chart denominator, so its polynomial numerator coefficient is0.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module Pr = Prelude[l] ; module L = GenericLaurent[l] ; module B = GenericSupport[l] ;
module CD = ChartDenominators[l] ; module LV = Laurent4[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (n : Nat) (s : Sub n) {
 module R = NativeChartRing[l].Over[A,setA,n,s] ;
 module V = LaurentExponentBridge[l].At[n] ;
 shift-off (m : L.Exp n) (i : Presentations[l].Fin n) (e : Id Flag (CD.flag n s i) absent) (r : Nat) :
   Id Int (V.addE m (R.Dir.direction r) i) (m i) = ap (addP (m i)) (R.Dir.off i e r) ;
 raw-van (q : R.Raw.Fraction) (m : L.Exp n) (b : B.bad n (L.mask n m) s) : Id A.R (R.raw-coeff q m) A.z =
   R.Core.TA.psi-negative n q.1 (V.addE m (R.Dir.direction q.2.2.1)) (CD.bad-witness n s m b).1
     (subst LV.Neg (sym (shift-off m (CD.bad-witness n s m b).1 (CD.bad-witness n s m b).2.2 q.2.2.1)) (CD.bad-witness n s m b).2.1) ;
 van (x : R.ring.R) (m : L.Exp n) (b : B.bad n (L.mask n m) s) : Id A.R (R.coeff x m) A.z =
   R.Q.induction @l (\ x -> Id A.R (R.coeff x m) A.z) (\ x -> setA _ _)
     (\ q -> trans (R.coeff-fraction q m) (raw-van q m b)) x ;
} ;
