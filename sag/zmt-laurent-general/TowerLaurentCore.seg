-- Signed coefficients for the arbitrary finite polynomial tower, with
-- extensionality and finite support. The source term/action comparisons
-- are those of TowerLaurentAction, reused unchanged.
level l ; open Ring[l] ; open ZInt[l] ;
module N = FiniteExponents[l] ; module L = GenericLaurent[l] ; module X = LaurentExponentBridge[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (n : Nat) {
 module P = PolynomialTowerBridge[l].Over[A,setA] ; module T = P.T ;
 S : CRing = T.D n ; module SL = RL[S] ;
 module TA = TowerLaurentAction[l].Over[A,setA] ; module V = X.At[n] ;
 module AL = IP.ModL[A,IP.regular A] ;
 coeff (x : S.R) : L.Exp n -> A.R = TA.psi n x ;
 ext (x y : S.R) (h : (m : L.Exp n) -> Id A.R (coeff x m) (coeff y m)) : Id S.R x y =
   P.ext n x y (\ v -> trans (sym (TA.psi-natural n x v)) (trans (h (V.emb v)) (TA.psi-natural n y v))) ;
 coeff-zero (m : L.Exp n) : Id A.R (coeff S.z m) A.z = TA.psi-zero n m ;
 coeff-add (x y : S.R) (m : L.Exp n) : Id A.R (coeff (S.add x y) m) (A.add (coeff x m) (coeff y m)) = TA.psi-add n x y m ;
 coeff-neg (x : S.R) (m : L.Exp n) : Id A.R (coeff (S.neg x) m) (A.neg (coeff x m)) =
   RL[A].neg-uniq (coeff x m) (coeff (S.neg x) m)
     (trans (sym (coeff-add x (S.neg x) m)) (trans (ap (\ x -> coeff x m) (S.addN x)) (coeff-zero m))) ;
 term-action (c : A.R) (u : N.Exp n) (x : S.R) (m : L.Exp n) :
   Id A.R (coeff (S.mul (P.term n (c,u)) x) m) (A.mul c (coeff x (V.subE m u))) = TA.term-mul n (c,u) x m ;
 module FA = FiniteLaurentAction[l].Over[A,setA,n] ;
 phi-action (ps : List (P.Term n)) (x : S.R) (m : L.Exp n) :
   Id A.R (coeff (S.mul (P.phi n ps) x) m) (FA.mulP ps (coeff x) m) = TA.At[n].phi-mul x m ps ;
 Support (f : L.Exp n -> A.R) : U l = (ms : List (L.Exp n)) * ((m : L.Exp n) -> Not (L.Mem (L.Exp n) m ms) -> Id A.R (f m) A.z) ;
 Finite (f : L.Exp n -> A.R) : U l = Tr.Trunc[Support f].carrier ;
 finite (x : S.R) : Finite (coeff x) = TC.map (TA.LC.At[n].Support x) (Support (coeff x))
   (\ w -> (w.1,\ m nm -> trans (TA.psi-coeff n x m) (w.2 m nm))) (TA.LC.At[n].finite x) ;
} ;
