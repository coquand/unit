-- Explicit inverse of every inverted coordinate in every finite chart.
-- Variables are singleton-denominator monomials. Their inverses and
-- coefficient shifts are independent of the chart and restrict naturally.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module N = FiniteExponents[l] ;
module L = GenericLaurent[l] ; module F = GenericSubsetFaces[l] ; module CC = ChartContainment[l] ;
module X = LaurentExponentBridge[l] ; module NA = NatArith[l] ;
axis (n : Nat) (i : Ps.Fin n) : N.Exp n = ChartDirections[l].At[n,F.singleton n i].oneN ;
empty-degree : (n : Nat) -> Id Base.Nat (N.degree n ChartDirections[l].At[n,empty n].oneN) zero = split {
 zero -> refl zero ; suc n | rec -> rec } ;
axis-degree : (n : Nat) (i : Ps.Fin n) -> Id Base.Nat (N.degree n (axis n i)) (suc zero) = split {
 zero -> \ i -> absurd (Id Base.Nat (N.degree zero (axis zero i)) (suc zero)) i ;
 suc n | rec -> split { inl i -> rec i ; inr t -> ap (\ b -> suc b) (empty-degree n) } } ;
module Over (A : CRing) (setA : Pr.isSet A.R) (n : Nat) (E : Sub n) {
 module R = NativeChartRing[l].Over[A,setA,n,E] ; module V = X.At[n] ;
 module G = CoefficientParts[l].Laws[A,n,R.S,R.B.T.setD n,R.B.T.grD n] ;
 variable (i : Ps.Fin n) : R.ring.R = R.inclusion.1 (R.B.term n (A.o,axis n i)) ;
 delta-zero (m : L.Exp n) (ne : Not (Id Int (L.total n m) zeroZ)) : Id A.R (R.delta0 m) A.z =
   trans (R.Core.TA.psi-coeff n R.S.o m) (R.Core.TA.LC.At[n].Degree[zeroZ,R.S.o,G.hom-one].homogeneous m ne) ;
 module Inverse (i : Ps.Fin n) (has : CC.Le n (F.singleton n i) E) {
   module S = NativeRestriction[l].Over[A,setA,n,F.singleton n i,E,has] ;
   inverse : R.ring.R = S.invertible.1 ;
   law : Id R.ring.R (R.ring.mul (variable i) inverse) R.ring.o = S.invertible.2 ;
   unit : RL[R.ring].unit (variable i) = (inverse,law) ;
   coefficient-variable (x : R.ring.R) (m : L.Exp n) :
     Id A.R (R.coeff (R.ring.mul (variable i) x) m) (R.coeff x (V.subE m (axis n i))) =
     trans (S.coeff-term A.o (axis n i) x m) (RL[A].one-left (R.coeff x (V.subE m (axis n i)))) ;
   coefficient (m : L.Exp n) : Id A.R (R.coeff inverse m) (R.delta0 (V.addE m (axis n i))) =
     trans (ap (R.coeff inverse) (sym (V.sub-add m (axis n i))))
       (trans (sym (coefficient-variable inverse (V.addE m (axis n i))))
         (trans (ap (\ x -> R.coeff x (V.addE m (axis n i))) law) (R.coeff-one (V.addE m (axis n i))))) ;
   degree (m : L.Exp n) (ne : Not (Id Int (L.total n m) (negsuc zero))) : Id A.R (R.coeff inverse m) A.z =
     trans (coefficient m) (delta-zero (V.addE m (axis n i)) (\ eq -> ne
       (trans (sym (pred-suc (L.total n m)))
         (ap predZ (trans (sym (trans (X.deg-add n m (axis n i)) (ap (addP (L.total n m)) (axis-degree n i)))) eq))))) ;
 } ;
} ;
module Restriction (A : CRing) (setA : Pr.isSet A.R) (n : Nat) (E F0 : Sub n) (le : CC.Le n E F0) {
 module Map = NativeRestriction[l].Over[A,setA,n,E,F0,le] ;
 module Source = Over[A,setA,n,E] ; module Target = Over[A,setA,n,F0] ;
 variable (i : Ps.Fin n) : Id Target.R.ring.R (Map.hom.1 (Source.variable i)) (Target.variable i) =
   Map.constant (Source.R.B.term n (A.o,axis n i)) ;
 module Inverse (i : Ps.Fin n) (hs : CC.Le n (F.singleton n i) E) (ht : CC.Le n (F.singleton n i) F0) {
   module SI = Source.Inverse[i,hs] ; module TI = Target.Inverse[i,ht] ;
   law : Id Target.R.ring.R (Target.R.ring.mul (Target.variable i) (Map.hom.1 SI.inverse)) Target.R.ring.o =
     trans (ap (\ x -> Target.R.ring.mul x (Map.hom.1 SI.inverse)) (sym (variable i)))
       (trans (sym (Map.hom.2.2.2 (Source.variable i) SI.inverse)) (trans (ap Map.hom.1 SI.law) Map.hom.2.1)) ;
   equation : Id Target.R.ring.R (Map.hom.1 SI.inverse) TI.inverse =
     Map.Map.cancel (Target.variable i) TI.unit _ _ (trans law (sym TI.law)) ;
 } ;
} ;
