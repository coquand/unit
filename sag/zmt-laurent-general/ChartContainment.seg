-- Structural chart containment and the complementary denominator.
-- This follows finite bitsets, including the empty chart; no finite
-- coordinate order or dimension-specific table is needed.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module CD = ChartDenominators[l] ; module N = FiniteExponents[l] ; module F = GenericSubsetFaces[l] ;
module Ps = Presentations[l] ; module D = ChartDirections[l] ; module X = LaurentExponentBridge[l] ;
module NA = NatArith[l] ;
FlagLe : Flag -> Flag -> U l = split { absent -> \ f -> Top ; present -> split { absent -> Empty ; present -> Top } } ;
Le : (n : Nat) -> Sub n -> Sub n -> U l = split {
 zero -> \ s t -> Top ; suc n | rec -> \ s t -> FlagLe s.1 t.1 * rec s.2 t.2 } ;
flag-self : (f : Flag) -> FlagLe f f = split { absent -> tt ; present -> tt } ;
self : (n : Nat) (s : Sub n) -> Le n s s = split { zero -> \ s -> tt ; suc n | rec -> \ s -> (flag-self s.1,rec s.2) } ;
empty-le : (n : Nat) (s : Sub n) -> Le n (empty n) s = split { zero -> \ s -> tt ; suc n | rec -> \ s -> (tt,rec s.2) } ;
IsPresent : Flag -> U l = split { absent -> Empty ; present -> Top } ;
no-ap (e : Id Flag absent present) : Empty = subst IsPresent (sym e) tt ;
flag-map : (f g : Flag) -> FlagLe f g -> Id Flag f present -> Id Flag g present = split {
 absent -> \ g h e -> absurd (Id Flag g present) (no-ap e) ;
 present -> split { absent -> \ h e -> absurd (Id Flag absent present) h ; present -> \ h e -> refl present } } ;
pointwise : (n : Nat) (s t : Sub n) -> Le n s t -> (i : Ps.Fin n) -> Id Flag (CD.flag n s i) present -> Id Flag (CD.flag n t i) present = split {
 zero -> \ s t h i -> absurd (Id Flag (CD.flag zero s i) present -> Id Flag (CD.flag zero t i) present) i ;
 suc n | rec -> \ s t h -> pts n rec s t h }
where {
 top (n : Nat) (s t : Sub (suc n)) (h : Le (suc n) s t) : (u : Top) -> Id Flag (CD.flag (suc n) s (inr u)) present -> Id Flag (CD.flag (suc n) t (inr u)) present = split {
   tt -> flag-map s.1 t.1 h.1 } ;
 pts (n : Nat) (rec : (s t : Sub n) -> Le n s t -> (i : Ps.Fin n) -> Id Flag (CD.flag n s i) present -> Id Flag (CD.flag n t i) present)
   (s t : Sub (suc n)) (h : Le (suc n) s t) : (i : Ps.Fin (suc n)) -> Id Flag (CD.flag (suc n) s i) present -> Id Flag (CD.flag (suc n) t i) present = split {
   inl i -> rec s.2 t.2 h.2 i ; inr u -> top n s t h u } } ;
rest : Flag -> Flag -> Flag = split { absent -> \ g -> g ; present -> \ g -> absent } ;
entry-sum : (f g : Flag) -> (Id Flag f present -> Id Flag g present) ->
 Id Base.Nat (NA.plus (D.entry f (suc zero)) (D.entry (rest f g) (suc zero))) (D.entry g (suc zero)) = split {
 absent -> \ g h -> refl (D.entry g (suc zero)) ;
 present -> split { absent -> \ h -> absurd (Id Base.Nat (suc zero) zero) (no-ap (h (refl present))) ; present -> \ h -> refl (suc zero) } } ;
module At (n : Nat) (s t : Sub n) (le : Le n s t) {
 module S = D.At[n,s] ; module T = D.At[n,t] ; module V = X.At[n] ;
 complement : N.Exp n = \ i -> D.entry (rest (CD.flag n s i) (CD.flag n t i)) (suc zero) ;
 sum : Id (N.Exp n) (V.addN S.oneN complement) T.oneN =
   N.ext n _ _ (\ i -> entry-sum (CD.flag n s i) (CD.flag n t i) (pointwise n s t le i)) ;
} ;
first-in : (n : Nat) (e : F.Pair n) -> Le n (F.singleton n (F.first n e)) (F.pairSet n e) = split {
 zero -> \ e -> absurd (Le zero (F.singleton zero (F.first zero e)) (F.pairSet zero e)) e ;
 suc n | rec -> split { inl e -> (tt,rec e) ; inr i -> (tt,empty-le n (F.singleton n i)) } } ;
second-in : (n : Nat) (e : F.Pair n) -> Le n (F.singleton n (F.second n e)) (F.pairSet n e) = split {
 zero -> \ e -> absurd (Le zero (F.singleton zero (F.second zero e)) (F.pairSet zero e)) e ;
 suc n | rec -> split { inl e -> (tt,rec e) ; inr i -> (tt,self n (F.singleton n i)) } } ;
