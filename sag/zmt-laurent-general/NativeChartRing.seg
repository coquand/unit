-- Native arbitrary-coordinate chart Laurent rings, constructed by the
-- existing power localisation at the product of inverted coordinates.
-- Signed tower coefficients descend because this monomial shifts them
-- injectively. All operations, finite support and extensionality are proved.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module N = FiniteExponents[l] ;
module EX = GenericLaurent[l] ; module FE = Axioms[l].FunExtLemmas[fe @l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (nvar : Nat) (E : Sub nvar) {
 module Core = TowerLaurentCore[l].Over[A,setA,nvar] ; module Dir = ChartDirections[l].At[nvar,E] ; open Dir ;
 module B = Core.P ; S : CRing = Core.S ; module SL = RL[S] ;
 module PW = AffinePowers[l].Over[S] ; module PA = Core.FA ;
 module AL = IP.ModL[A,IP.regular A] ;
 module V = LaurentExponentBridge[l].At[nvar] ; open V ;
 module CA = CechPolynomialAction[l].Over[A,setA,nvar] ;
 J : S.R = B.term nvar (A.o,Dir.oneN) ;
 psi-J (x : S.R) (m : (EX.Exp nvar)) : Id A.R (Core.coeff (S.mul J x) m) (Core.coeff x (subE m Dir.oneN)) =
   trans (Core.term-action A.o Dir.oneN x m) (RL[A].one-left (Core.coeff x (subE m Dir.oneN))) ;
 psi-power : (n : Nat) (x : S.R) (m : (EX.Exp nvar)) ->
   Id A.R (Core.coeff (S.mul (PW.power J n) x) m) (Core.coeff x (subE m (direction n))) = split {
   zero -> \ x m -> trans (ap (\ z -> Core.coeff z m) (SL.one-left x)) (ap (Core.coeff x) (sym (sub-zero m))) ;
   suc n | rec -> \ x m -> trans (ap (\ z -> Core.coeff z m) (sym (S.mulA J (PW.power J n) x)))
     (trans (psi-J (S.mul (PW.power J n) x) m)
       (trans (rec x (subE m Dir.oneN)) (ap (Core.coeff x) (trans (V.sub-sub m Dir.oneN (direction n)) (ap (subE m) (Dir.step n)))))) } ;
 power-inj (n : Nat) (x y : S.R) (e : Id S.R (S.mul (PW.power J n) x) (S.mul (PW.power J n) y)) : Id S.R x y =
   Core.ext x y (\ m -> trans (ap (Core.coeff x) (sym (V.sub-add m (direction n))))
     (trans (sym (psi-power n x (addE m (direction n))))
       (trans (ap (\ z -> Core.coeff z (addE m (direction n))) e)
         (trans (psi-power n y (addE m (direction n))) (ap (Core.coeff y) (V.sub-add m (direction n))))))) ;
 module Loc = PowerLocalization[l].Over[S,J] ; module Q = Loc.L.Q ; module Raw = Loc.L.Raw ;
 ring : CRing = Loc.ring ; set : Pr.isSet ring.R = Loc.set ;
 inclusion : RingHom[l].Hom S ring = Loc.inclusion ;
 raw-coeff (q : Raw.Fraction) (m : (EX.Exp nvar)) : A.R = Core.coeff q.1 (addE m (direction q.2.2.1)) ;
 -- Cancellation removes the auxiliary annihilator in the fraction relation.
 exact (q r : Raw.Fraction) (w : Raw.Witness q r) : Raw.Exact q r =
   power-inj w.2.1.1 (S.mul q.1 r.2.1) (S.mul r.1 q.2.1)
     (trans (ap (\ z -> S.mul z (S.mul q.1 r.2.1)) (sym w.2.1.2))
       (trans w.2.2 (ap (\ z -> S.mul z (S.mul r.1 q.2.1)) w.2.1.2))) ;
 module Compare (q r : Raw.Fraction) (e : Raw.Exact q r) (m : (EX.Exp nvar)) {
   nq : Nat = q.2.2.1 ; nr : Nat = r.2.2.1 ;
   at : (EX.Exp nvar) = addE (addE m (direction nq)) (direction nr) ;
   result : Id A.R (raw-coeff q m) (raw-coeff r m) = calc A.R {
     Core.coeff q.1 (addE m (direction nq))
       =< ap (Core.coeff q.1) (sym (V.sub-add (addE m (direction nq)) (direction nr)))
       > Core.coeff q.1 (subE at (direction nr))
       =< sym (psi-power nr q.1 at) > Core.coeff (S.mul (PW.power J nr) q.1) at
       =< ap (\ x -> Core.coeff x at) (S.mulC (PW.power J nr) q.1) > Core.coeff (S.mul q.1 (PW.power J nr)) at
       =< ap (\ x -> Core.coeff x at) (ap (S.mul q.1) (sym r.2.2.2)) > Core.coeff (S.mul q.1 r.2.1) at
       =< ap (\ x -> Core.coeff x at) e > Core.coeff (S.mul r.1 q.2.1) at
       =< ap (\ x -> Core.coeff x at) (ap (S.mul r.1) q.2.2.2) > Core.coeff (S.mul r.1 (PW.power J nq)) at
       =< ap (\ x -> Core.coeff x at) (S.mulC r.1 (PW.power J nq)) > Core.coeff (S.mul (PW.power J nq) r.1) at
       =< psi-power nq r.1 at > Core.coeff r.1 (subE at (direction nq))
       =< ap (Core.coeff r.1) (V.sub-add-comm (addE m (direction nq)) (direction nq) (direction nr))
       > Core.coeff r.1 (addE (subE (addE m (direction nq)) (direction nq)) (direction nr))
       =< ap (Core.coeff r.1) (ap (\ x -> addE x (direction nr)) (V.sub-add m (direction nq)))
       > Core.coeff r.1 (addE m (direction nr)) } ;
 } ;
 raw-respects-exact (q r : Raw.Fraction) (e : Raw.Exact q r) (m : (EX.Exp nvar)) : Id A.R (raw-coeff q m) (raw-coeff r m) = Compare[q,r,e,m].result ;
 raw-respects (q r : Raw.Fraction) (e : Raw.Relation q r) : Id ((EX.Exp nvar) -> A.R) (raw-coeff q) (raw-coeff r) =
   FE.funext (EX.Exp nvar) (\ m -> A.R) _ _ (\ m -> TC.rec (Raw.Witness q r) @l
     (Id A.R (raw-coeff q m) (raw-coeff r m)) (setA _ _)
       (\ w -> raw-respects-exact q r (exact q r w) m) e) ;
 module Coeff = Q.Descend[(EX.Exp nvar) -> A.R,FE.isSet-Pi (EX.Exp nvar) (\ m -> A.R) (\ m -> setA),raw-coeff,raw-respects] ;
 coeff (x : ring.R) : (EX.Exp nvar) -> A.R = Coeff.map x ;
 coeff-fraction (q : Raw.Fraction) (m : (EX.Exp nvar)) : Id A.R (coeff (Loc.L.include q) m) (raw-coeff q m) =
   ap (\ f -> f m) (Coeff.beta q) ;
 coeff-inclusion (x : S.R) (m : (EX.Exp nvar)) : Id A.R (coeff (inclusion.1 x) m) (Core.coeff x m) =
   trans (coeff-fraction (Raw.constantF x) m) (ap (Core.coeff x) (add-zero m)) ;
 psi-neg (x : S.R) (m : (EX.Exp nvar)) : Id A.R (Core.coeff (S.neg x) m) (A.neg (Core.coeff x m)) =
   RL[A].neg-uniq (Core.coeff x m) (Core.coeff (S.neg x) m)
     (trans (sym (Core.coeff-add x (S.neg x) m))
       (trans (ap (\ z -> Core.coeff z m) (S.addN x)) (Core.coeff-zero m))) ;
 module AddRaw (q r : Raw.Fraction) (m : (EX.Exp nvar)) {
   nq : Nat = q.2.2.1 ; nr : Nat = r.2.2.1 ;
   at : (EX.Exp nvar) = addE m (direction (plus nq nr)) ;
   left-shift : Id (EX.Exp nvar) (subE at (direction nr)) (addE m (direction nq)) =
     trans (ap (\ t -> subE t (direction nr)) (Dir.up-plus nq nr m)) (V.sub-add (addE m (direction nq)) (direction nr)) ;
   right-shift : Id (EX.Exp nvar) (subE at (direction nq)) (addE m (direction nr)) =
     trans (ap (\ t -> subE t (direction nq)) (Dir.up-plus nq nr m))
       (trans (V.sub-add-comm (addE m (direction nq)) (direction nq) (direction nr))
         (ap (\ t -> addE t (direction nr)) (V.sub-add m (direction nq)))) ;
   read-left : Id A.R (Core.coeff (S.mul q.1 r.2.1) at) (raw-coeff q m) =
     trans (ap (\ z -> Core.coeff z at) (ap (S.mul q.1) r.2.2.2))
       (trans (ap (\ z -> Core.coeff z at) (S.mulC q.1 (PW.power J nr)))
         (trans (psi-power nr q.1 at) (ap (Core.coeff q.1) left-shift))) ;
   read-right : Id A.R (Core.coeff (S.mul r.1 q.2.1) at) (raw-coeff r m) =
     trans (ap (\ z -> Core.coeff z at) (ap (S.mul r.1) q.2.2.2))
       (trans (ap (\ z -> Core.coeff z at) (S.mulC r.1 (PW.power J nq)))
         (trans (psi-power nq r.1 at) (ap (Core.coeff r.1) right-shift))) ;
   result : Id A.R (raw-coeff (Raw.addF q r) m) (A.add (raw-coeff q m) (raw-coeff r m)) =
     trans (Core.coeff-add (S.mul q.1 r.2.1) (S.mul r.1 q.2.1) at) (AL.G.cong-add read-left read-right) ;
 } ;
 coeff-add-raw (q r : Raw.Fraction) (m : (EX.Exp nvar)) :
   Id A.R (coeff (ring.add (Loc.L.include q) (Loc.L.include r)) m)
     (A.add (coeff (Loc.L.include q) m) (coeff (Loc.L.include r) m)) =
   trans (ap (\ z -> coeff z m) (Loc.L.Add.beta q r))
     (trans (coeff-fraction (Raw.addF q r) m)
       (trans (AddRaw[q,r,m].result) (AL.G.cong-add (sym (coeff-fraction q m)) (sym (coeff-fraction r m))))) ;
 coeff-add (x y : ring.R) (m : (EX.Exp nvar)) : Id A.R (coeff (ring.add x y) m) (A.add (coeff x m) (coeff y m)) =
   Loc.L.forall2 (\ x y -> Id A.R (coeff (ring.add x y) m) (A.add (coeff x m) (coeff y m)))
     (\ x y -> setA _ _) (\ q r -> coeff-add-raw q r m) x y ;
 coeff-neg (x : ring.R) (m : (EX.Exp nvar)) : Id A.R (coeff (ring.neg x) m) (A.neg (coeff x m)) =
   Q.induction @l (\ x -> Id A.R (coeff (ring.neg x) m) (A.neg (coeff x m))) (\ x -> setA _ _)
     (\ q -> trans (ap (\ z -> coeff z m) (Loc.L.Negate.beta q))
       (trans (coeff-fraction (Raw.negF q) m)
         (trans (psi-neg q.1 (addE m (direction q.2.2.1))) (ap A.neg (sym (coeff-fraction q m)))))) x ;
 coeff-zero (m : (EX.Exp nvar)) : Id A.R (coeff ring.z m) A.z = trans (coeff-inclusion S.z m) (Core.coeff-zero m) ;
 delta0 (m : EX.Exp nvar) : A.R = Core.coeff S.o m ;
 coeff-one (m : EX.Exp nvar) : Id A.R (coeff ring.o m) (delta0 m) = coeff-inclusion S.o m ;
 coeff-polynomial (p : List (B.Term nvar)) (m : EX.Exp nvar) :
   Id A.R (coeff (inclusion.1 (B.phi nvar p)) m) (Core.coeff (B.phi nvar p) m) = coeff-inclusion (B.phi nvar p) m ;
 module PolynomialRaw (p : List (B.Term nvar)) (q : Raw.Fraction) (m : (EX.Exp nvar)) {
   at : (EX.Exp nvar) = addE m (direction q.2.2.1) ;
   result : Id A.R (coeff (ring.mul (inclusion.1 (B.phi nvar p)) (Loc.L.include q)) m)
     (PA.mulP p (coeff (Loc.L.include q)) m) =
     trans (ap (\ z -> coeff z m) (Loc.L.Multiply.beta (Raw.constantF (B.phi nvar p)) q))
       (trans (coeff-fraction (Raw.mulF (Raw.constantF (B.phi nvar p)) q) m)
         (trans (Core.phi-action p q.1 at)
           (trans (sym (PA.mulP-shift (\ m -> addE m (direction q.2.2.1))
             (\ m u -> V.sub-add-comm m u (direction q.2.2.1)) p (Core.coeff q.1) m))
             (PA.mulP-cong p (raw-coeff q) (coeff (Loc.L.include q)) (\ m -> sym (coeff-fraction q m)) m)))) ;
 } ;
 coeff-mul-polynomial (p : List (B.Term nvar)) (x : ring.R) (m : (EX.Exp nvar)) :
   Id A.R (coeff (ring.mul (inclusion.1 (B.phi nvar p)) x) m) (PA.mulP p (coeff x) m) =
   Q.induction @l (\ x -> Id A.R (coeff (ring.mul (inclusion.1 (B.phi nvar p)) x) m) (PA.mulP p (coeff x) m))
     (\ x -> setA _ _) (\ q -> PolynomialRaw[p,q,m].result) x ;
 module RawExt (q r : Raw.Fraction) (h : (m : (EX.Exp nvar)) -> Id A.R (raw-coeff q m) (raw-coeff r m)) {
   nq : Nat = q.2.2.1 ; nr : Nat = r.2.2.1 ;
   down (m : (EX.Exp nvar)) : (EX.Exp nvar) = subE (subE m (direction nr)) (direction nq) ;
   recover-q (m : (EX.Exp nvar)) : Id (EX.Exp nvar) (addE (down m) (direction nq)) (subE m (direction nr)) = V.add-sub (subE m (direction nr)) (direction nq) ;
   recover-r (m : (EX.Exp nvar)) : Id (EX.Exp nvar) (addE (down m) (direction nr)) (subE m (direction nq)) =
     trans (ap (\ t -> addE t (direction nr)) (V.sub-comm m (direction nr) (direction nq))) (V.add-sub (subE m (direction nq)) (direction nr)) ;
   cross-left (m : (EX.Exp nvar)) : Id A.R (Core.coeff (S.mul q.1 r.2.1) m) (raw-coeff q (down m)) =
     trans (ap (\ z -> Core.coeff z m) (ap (S.mul q.1) r.2.2.2))
       (trans (ap (\ z -> Core.coeff z m) (S.mulC q.1 (PW.power J nr)))
         (trans (psi-power nr q.1 m) (ap (Core.coeff q.1) (sym (recover-q m))))) ;
   cross-right (m : (EX.Exp nvar)) : Id A.R (raw-coeff r (down m)) (Core.coeff (S.mul r.1 q.2.1) m) =
     trans (ap (Core.coeff r.1) (recover-r m))
       (trans (sym (psi-power nq r.1 m))
         (trans (ap (\ z -> Core.coeff z m) (S.mulC (PW.power J nq) r.1))
           (ap (\ z -> Core.coeff z m) (ap (S.mul r.1) (sym q.2.2.2))))) ;
   cross-exact : Raw.Exact q r = Core.ext _ _ (\ m -> trans (cross-left m) (trans (h (down m)) (cross-right m))) ;
   equal : Id ring.R (Loc.L.include q) (Loc.L.include r) = Q.relates q r (Raw.exact q r cross-exact) ;
 } ;
 CoeffEq (x y : ring.R) : U l = (m : (EX.Exp nvar)) -> Id A.R (coeff x m) (coeff y m) ;
 ext (x y : ring.R) (h : CoeffEq x y) : Id ring.R x y =
   Loc.L.forall2 (\ x y -> CoeffEq x y -> Id ring.R x y)
     (\ x y -> FE.isProp-Pi (CoeffEq x y) (\ h -> Id ring.R x y) (\ h -> set x y))
     (\ q r h -> RawExt[q,r,\ m -> trans (sym (coeff-fraction q m)) (trans (h m) (coeff-fraction r m))].equal) x y h ;
 Support (f : EX.Exp nvar -> A.R) : U l = Core.Support f ;
 Finite (f : EX.Exp nvar -> A.R) : U l = Tr.Trunc[Support f].carrier ;
 module FractionSupport (q : Raw.Fraction) (sw : Core.Support (Core.coeff q.1)) {
   list : List (EX.Exp nvar) = CA.mapE (\ m -> V.subE m (direction q.2.2.1)) sw.1 ;
   vanish (m : EX.Exp nvar) (nm : Not (EX.Mem (EX.Exp nvar) m list)) : Id A.R (raw-coeff q m) A.z =
     sw.2 (V.addE m (direction q.2.2.1)) (\ hm -> nm (CA.mem-tr list
       (V.subE (V.addE m (direction q.2.2.1)) (direction q.2.2.1)) m (V.sub-add m (direction q.2.2.1))
       (CA.mem-map (\ u -> V.subE u (direction q.2.2.1)) (V.addE m (direction q.2.2.1)) sw.1 hm))) ;
   witness : Support (raw-coeff q) = (list,vanish) ;
 } ;
 raw-finite (q : Raw.Fraction) : Finite (raw-coeff q) =
   TC.map (Core.Support (Core.coeff q.1)) (Support (raw-coeff q)) (\ sw -> FractionSupport[q,sw].witness) (Core.finite q.1) ;
 finite (x : ring.R) : Finite (coeff x) = Q.induction @l (\ x -> Finite (coeff x))
   (\ x -> Tr.Trunc[Support (coeff x)].proposition)
   (\ q -> TC.map (Support (raw-coeff q)) (Support (coeff (Loc.L.include q)))
     (\ w -> (w.1,\ m nm -> trans (coeff-fraction q m) (w.2 m nm))) (raw-finite q)) x ;
} ;
