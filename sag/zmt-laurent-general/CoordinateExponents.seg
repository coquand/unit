-- Standard coordinate exponents, recursively over Fin n. The newest
-- variable is inr tt; affine variables are lifted through inl.
level l ; open Ring[l] ; open ZInt[l] ;
module N = FiniteExponents[l] ; module Ps = Presentations[l] ; module NA = NatArith[l] ;
axis : (n : Nat) -> Ps.Fin n -> N.Exp n = split {
 zero -> \ i -> absurd (N.Exp zero) i ;
 suc n | rec -> split { inl i -> N.join n (rec i) zero ; inr t -> N.join n (N.zeroE n) (suc zero) } } ;
zero-degree : (n : Nat) -> Id Base.Nat (N.degree n (N.zeroE n)) zero = split {
 zero -> refl zero ; suc n | rec -> rec } ;
degree : (n : Nat) (i : Ps.Fin n) -> Id Base.Nat (N.degree n (axis n i)) (suc zero) = split {
 zero -> \ i -> absurd (Id Base.Nat (N.degree zero (axis zero i)) (suc zero)) i ;
 suc n | rec -> split { inl i -> rec i ; inr t -> ap (\ a -> suc a) (zero-degree n) } } ;
module Monomials (E : CRing) {
 module M = GenericDehomogenisation[l].Monomials[E] ; module P = M.P ; module L = RL[E] ;
 zero-value : (n : Nat) (y : Ps.Fin n -> E.R) -> Id E.R (M.value n y (N.zeroE n)) E.o = split {
   zero -> \ y -> refl E.o ; suc n | rec -> \ y -> trans (E.mulO (M.value n (\ i -> y (inl i)) (N.zeroE n))) (rec (\ i -> y (inl i))) } ;
 value : (n : Nat) (y : Ps.Fin n -> E.R) (i : Ps.Fin n) -> Id E.R (M.value n y (axis n i)) (y i) = split {
   zero -> \ y i -> absurd (Id E.R (M.value zero y (axis zero i)) (y i)) i ;
   suc n | rec -> \ y -> valS n rec y }
 where {
   top (n : Nat) (y : Ps.Fin (suc n) -> E.R) : (t : Top) ->
     Id E.R (M.value (suc n) y (axis (suc n) (inr t))) (y (inr t)) = split {
       tt -> trans (ap (\ x -> E.mul x (E.mul (y (inr tt)) E.o)) (zero-value n (\ i -> y (inl i))))
         (trans (L.one-left (E.mul (y (inr tt)) E.o)) (E.mulO (y (inr tt)))) } ;
   valS (n : Nat) (rec : (y : Ps.Fin n -> E.R) (i : Ps.Fin n) -> Id E.R (M.value n y (axis n i)) (y i))
     (y : Ps.Fin (suc n) -> E.R) : (i : Ps.Fin (suc n)) -> Id E.R (M.value (suc n) y (axis (suc n) i)) (y i) = split {
       inl i -> trans (E.mulO (M.value n (\ i -> y (inl i)) (axis n i))) (rec (\ i -> y (inl i)) i) ;
       inr t -> top n y t } } ;
} ;
