-- Polynomial action on constant-chart homogeneous Laurent modules, in
-- arbitrary finite coordinate number. This is the chart counterpart of
-- the already constructed generic Cech action, without a rank index.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module L = GenericLaurent[l] ;
module N = FiniteExponents[l] ; module X = LaurentExponentBridge[l] ; module TC = TruncationCombinators[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (n : Nat) (E : Sub n) {
 module D = NativeDegreePart[l].Over[A,setA,n,E] ; module C = CechPolynomialAction[l].Over[A,setA,n] ;
 module F = L.Over[A,setA] ; module V = X.At[n] ; module R = RL[A] ;
 module AL = IP.ModL[A,IP.regular A] ;
 bad-sub (k k' : Int) (m : L.Exp n) (u : N.Exp n) (e : Id Int (PolynomialAction4[l].minus k' (N.degree n u)) k) :
   NativeDegreePart[l].Bad n E k' m -> NativeDegreePart[l].Bad n E k (V.subE m u) = split {
   inl ne -> inl (C.not-degree k k' m u e ne) ; inr b -> inr (X.bad-sub n E m u b) } ;
 van-mulP (k k' : Int) (f : L.Exp n -> A.R)
   (v : (m : L.Exp n) -> NativeDegreePart[l].Bad n E k m -> Id A.R (f m) A.z) :
   (p : C.A.Polys) -> C.Shifts k k' p -> (m : L.Exp n) -> NativeDegreePart[l].Bad n E k' m -> Id A.R (C.A.mulP p f m) A.z = split {
   nil -> \ hp m b -> refl A.z ;
   cons t p | rec -> \ hp m b -> trans (AL.G.cong-add
     (trans (ap (A.mul t.1) (v (V.subE m t.2) (bad-sub k k' m t.2 hp.1 b))) (R.mul-zero t.1)) (rec hp.2 m b)) (A.addZ A.z) } ;
 module Act (I : U l) (k k' : Int) (p : C.A.Polys) (hp : C.Shifts k k' p) {
   module Source = F.Chart[L.Exp n,I,\ i -> NativeDegreePart[l].Bad n E k] ;
   module Target = F.Chart[L.Exp n,I,\ i -> NativeDegreePart[l].Bad n E k'] ;
   raw (x : Source.El) : Target.Raw = \ i m -> C.A.mulP p (Source.val x i) m ;
   support (x : Source.El) : Target.Supp (raw x) = TC.map (Source.SuppW (Source.val x)) (Target.SuppW (raw x))
     (\ sw -> (C.suppL sw.1 p,\ i m nm -> C.vanish-mulP sw.1 (Source.val x i) (sw.2 i) p m nm)) (Source.supp x) ;
   element (x : Source.El) : Target.El = Target.mk (raw x) (support x) (\ i -> van-mulP k k' (Source.val x i) (Source.van x i) p hp) ;
   lin : IP.Lin[A,Source.mod,Target.mod] = IP.mkLin A Source.mod Target.mod element
     (\ x y -> Target.eq _ _ (\ i m -> C.A.mulP-add p (Source.val x i) (Source.val y i) m))
     (\ a x -> Target.eq _ _ (\ i m -> C.A.mulP-sm p a (Source.val x i) m)) ;
 } ;
} ;
