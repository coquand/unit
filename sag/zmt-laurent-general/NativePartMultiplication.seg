-- Homogeneous polynomial multiplication commutes with native degree
-- projection. The input J coefficient need not itself be homogeneous.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module Pr = Prelude[l] ; module L = GenericLaurent[l] ; module N = FiniteExponents[l] ;
module X = LaurentExponentBridge[l] ; module FP = FinitePolynomial4[l] ; module LG = Logic[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (n : Nat) (E : Sub n) {
 module D = NativeDegreePart[l].Over[A,setA,n,E] ; module R = D.R ;
 module C = NativeChartAction[l].Over[A,setA,n,E] ; module M = ShiftedMatrixAction[l].Over[A,setA,n] ;
 module AL = IdealPowers[l].ModL[A,IdealPowers[l].regular A] ; module V = X.At[n] ;
 degree-shift (k : Int) (dd : Base.Nat) (m : L.Exp n) (u : N.Exp n)
   (hm : Id Int (L.total n m) k) (hu : Id Base.Nat (N.degree n u) dd) :
   Id Int (L.total n (V.subE m u)) (PolynomialAction4[l].minus k dd) =
   trans (X.deg-sub n m u) (trans (ap (\ d -> PolynomialAction4[l].minus d (N.degree n u)) hm) (ap (PolynomialAction4[l].minus k) hu)) ;
 read-terms (k : Int) (dd : Base.Nat) (x : R.ring.R) : (p : C.C.A.Polys) -> M.HomShift zero dd p ->
   (m : L.Exp n) -> Id Int (L.total n m) k ->
   Id A.R (R.PA.mulP p (D.Part[PolynomialAction4[l].minus k dd].value x) m) (R.PA.mulP p (R.coeff x) m) = split {
   nil -> \ hp m hm -> refl A.z ;
   cons t p | rec -> \ hp m hm -> AL.G.cong-add
     (ap (A.mul t.1) (D.Part[PolynomialAction4[l].minus k dd].at x (V.subE m t.2) (degree-shift k dd m t.2 hm hp.1))) (rec hp.2 m hm) } ;
 module Product (I : U l) (k : Int) (dd : Base.Nat) (p : C.C.A.Polys) (hp : M.HomShift zero dd p) {
   module Source = D.Part[PolynomialAction4[l].minus k dd].Into[I] ; module Target = D.Part[k].Into[I] ;
   module Act = C.Act[I,PolynomialAction4[l].minus k dd,k,p,M.shifts k zero dd p hp] ;
   product (x : R.ring.R) : R.ring.R = R.ring.mul (R.inclusion.1 (R.B.phi n p)) x ;
   case (x : R.ring.R) (i : I) (m : L.Exp n) : (q : LG.Dec (Id Int (L.total n m) k)) ->
     Id A.R (FP.sel A (R.coeff (product x) m) (Id Int (L.total n m) k) q) (Act.Target.val (Act.lin.f (Source.element x)) i m) = split {
     yes hm -> trans (R.coeff-mul-polynomial p x m) (sym (read-terms k dd x p hp m hm)) ;
     no ne -> sym (Act.Target.van (Act.lin.f (Source.element x)) i m (inl (\ h -> Pr.absurd Empty (ne h)))) } ;
   equation (x : R.ring.R) : Id Target.C.El (Target.element (product x)) (Act.lin.f (Source.element x)) =
     Target.C.eq _ _ (\ i m -> case x i m (int-dec (L.total n m) k)) ;
 } ;
} ;
