-- Identify structural standard coordinate exponents with singleton
-- chart denominator exponents, once at the generic level.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module N = FiniteExponents[l] ; module Ps = Presentations[l] ; module C = CoordinateExponents[l] ;
module D = ChartDirections[l] ; module V = NativeCoordinates[l] ;
empty-direction : (n : Nat) -> Id (N.Exp n) D.At[n,empty n].oneN (N.zeroE n) = split {
 zero -> N.ext zero _ _ (\ i -> absurd (Id Base.Nat (D.At[zero,empty zero].oneN i) (N.zeroE zero i)) i) ;
 suc n | rec -> N.split-eq n D.At[suc n,empty (suc n)].oneN (N.zeroE (suc n)) (refl zero) rec } ;
axis : (n : Nat) (i : Ps.Fin n) -> Id (N.Exp n) (V.axis n i) (C.axis n i) = split {
 zero -> \ i -> absurd (Id (N.Exp zero) (V.axis zero i) (C.axis zero i)) i ;
 suc n | rec -> split {
   inl i -> N.split-eq n (V.axis (suc n) (inl i)) (C.axis (suc n) (inl i)) (refl zero) (rec i) ;
   inr t -> N.split-eq n (V.axis (suc n) (inr t)) (C.axis (suc n) (inr t)) (refl (suc zero)) (empty-direction n) } } ;
