-- The chart denominator is the monomial with exponent one exactly on
-- the inverted coordinates. Its r-th power has exponent r there and zero
-- elsewhere. All identities are componentwise over Fin n.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module N = FiniteExponents[l] ; module L = GenericLaurent[l] ; module X = LaurentExponentBridge[l] ;
module CD = ChartDenominators[l] ; module BR = PolynomialRing4Bridge[l] ; module NA = NatArith[l] ;
entry : Flag -> Nat -> Base.Nat = split { absent -> \ r -> zero ; present -> BR.toB } ;
plusB : (r t : Nat) -> Id Base.Nat (BR.toB (plus r t)) (NA.plus (BR.toB t) (BR.toB r)) = split {
 zero -> \ t -> sym (NA.plus-zero (BR.toB t)) ;
 suc r | rec -> \ t -> trans (ap (\ x -> suc x) (rec t)) (sym (NA.plus-suc (BR.toB t) (BR.toB r))) } ;
entry-step : (f : Flag) (r : Nat) -> Id Base.Nat (NA.plus (entry f r) (entry f (suc zero))) (entry f (suc r)) = split {
 absent -> \ r -> refl zero ; present -> \ r -> trans (NA.plus-suc (BR.toB r) zero) (ap (\ x -> suc x) (NA.plus-zero (BR.toB r))) } ;
entry-plus : (f : Flag) (r t : Nat) -> Id Base.Nat (entry f (plus r t)) (NA.plus (entry f t) (entry f r)) = split {
 absent -> \ r t -> refl zero ; present -> plusB } ;
entry-zero : (f : Flag) -> Id Base.Nat (entry f zero) zero = split { absent -> refl zero ; present -> refl zero } ;
module At (n : Nat) (s : Sub n) {
 module V = X.At[n] ;
 direction (r : Nat) : N.Exp n = \ i -> entry (CD.flag n s i) r ;
 oneN : N.Exp n = direction (suc zero) ;
 step (r : Nat) : Id (N.Exp n) (V.addN (direction r) oneN) (direction (suc r)) =
   N.ext n _ _ (\ i -> entry-step (CD.flag n s i) r) ;
 zero-dir : Id (N.Exp n) (direction zero) (N.zeroE n) = N.ext n _ _ (\ i -> entry-zero (CD.flag n s i)) ;
 up-plus (r t : Nat) (m : L.Exp n) : Id (L.Exp n) (V.addE m (direction (plus r t))) (V.addE (V.addE m (direction r)) (direction t)) =
   V.ext _ _ (\ i -> trans (ap (addP (m i)) (entry-plus (CD.flag n s i) r t))
     (sym (PolynomialAction4[l].addP-addP (m i) (entry (CD.flag n s i) r) (entry (CD.flag n s i) t)))) ;
 sub-zero (m : L.Exp n) : Id (L.Exp n) (V.subE m (direction zero)) m =
   trans (ap (V.subE m) zero-dir) (V.ext _ _ (\ i -> refl (m i))) ;
 add-zero (m : L.Exp n) : Id (L.Exp n) (V.addE m (direction zero)) m =
   trans (ap (V.addE m) zero-dir) (V.ext _ _ (\ i -> refl (m i))) ;
 off (i : Presentations[l].Fin n) (e : Id Flag (CD.flag n s i) absent) (r : Nat) : Id Base.Nat (direction r i) zero =
   ap (\ f -> entry f r) e ;
} ;
