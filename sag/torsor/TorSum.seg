-- TorSum.seg: the sum (contracted product) of A-torsors, torsor3.pdf 2.
--   BiHom T S Z   maps  phi : T -> S -> Z  with
--                 phi (a.t) s = a . phi t s   and   phi t (b.s) = b . phi t s
--   the pairs (Z, phi) form a contractible type (sum-contr): being
--   contractible is a proposition, so assume t0 : T, s0 : S; the centre is
--   then A with  phi0 t s = (t - t0) + (s - s0).
--   Sum T S, q    the centre: q (a.t) (b.s) = (a + b) . q t s  (q-both),
--                 so (a.t, (-a).s) and (t, s) have the same image
--   universal     Hom (Sum T S) Z  ~  BiHom T S Z,  f |-> f o q
--   tensor        functoriality for equivariant maps

level l ;
open Base ;
open Prelude[l] ;
open Paths[l] ;
open FunExtUA[l] ;
open Torsor[l] ;
open TorsorId[l] ;
open TrivialGerbe[l] ;
module Tr = Truncation[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module P1 = Prelude[l+] ;
module E1 = FunExtUA[l+] ;
module F1 = Ftit[l+] ;

module TSum (Gr : Ab) {
  open Gr ;
  open AbL[Gr] ;
  open TorBase[Gr] ;
  open TorId[Gr] ;
  open TrivG[Gr] ;

  LawL (T S Z : Tor) (phi : T.1 -> S.1 -> Z.1) : U l =
    (a : A) (t : T.1) (s : S.1) -> Id Z.1 (phi (T.2.1 a t) s) (Z.2.1 a (phi t s)) ;
  LawR (T S Z : Tor) (phi : T.1 -> S.1 -> Z.1) : U l =
    (b : A) (t : T.1) (s : S.1) -> Id Z.1 (phi t (S.2.1 b s)) (Z.2.1 b (phi t s)) ;
  BiHom (T S Z : Tor) : U l = (phi : T.1 -> S.1 -> Z.1) * (l1 : LawL T S Z phi) * LawR T S Z phi ;

  laws-prop (T S Z : Tor) (phi : T.1 -> S.1 -> Z.1) : isProp ((l1 : LawL T S Z phi) * LawR T S Z phi) =
    isProp-Sigma (LawL T S Z phi) (\ l1 -> LawR T S Z phi)
      (FL.isProp-Pi A (\ a -> (t : T.1) (s : S.1) -> Id Z.1 (phi (T.2.1 a t) s) (Z.2.1 a (phi t s))) (\ a ->
       FL.isProp-Pi T.1 (\ t -> (s : S.1) -> Id Z.1 (phi (T.2.1 a t) s) (Z.2.1 a (phi t s))) (\ t ->
       FL.isProp-Pi S.1 (\ s -> Id Z.1 (phi (T.2.1 a t) s) (Z.2.1 a (phi t s))) (\ s ->
         Z.2.2.1 (phi (T.2.1 a t) s) (Z.2.1 a (phi t s))))))
      (\ l1 -> FL.isProp-Pi A (\ b -> (t : T.1) (s : S.1) -> Id Z.1 (phi t (S.2.1 b s)) (Z.2.1 b (phi t s))) (\ b ->
       FL.isProp-Pi T.1 (\ t -> (s : S.1) -> Id Z.1 (phi t (S.2.1 b s)) (Z.2.1 b (phi t s))) (\ t ->
       FL.isProp-Pi S.1 (\ s -> Id Z.1 (phi t (S.2.1 b s)) (Z.2.1 b (phi t s))) (\ s ->
         Z.2.2.1 (phi t (S.2.1 b s)) (Z.2.1 b (phi t s)))))) ;

  bihom-eq (T S Z : Tor) (phi psi : BiHom T S Z) (h : (t : T.1) (s : S.1) -> Id Z.1 (phi.1 t s) (psi.1 t s))
    : Id (BiHom T S Z) phi psi =
    Sigma-eq (T.1 -> S.1 -> Z.1) (\ f -> (l1 : LawL T S Z f) * LawR T S Z f) phi.1 psi.1 phi.2 psi.2
      (FL.funext T.1 (\ t -> S.1 -> Z.1) phi.1 psi.1 (\ t -> FL.funext S.1 (\ s -> Z.1) (phi.1 t) (psi.1 t) (h t)))
      (laws-prop T S Z psi.1) ;

  -- postcomposition with an equivariant map
  postBi (T S Z Z' : Tor) (f : Hom Z Z') (phi : BiHom T S Z) : BiHom T S Z' =
    (\ t s -> f.1 (phi.1 t s),
     \ a t s -> transH (ap Z.1 Z'.1 f.1 (phi.1 (T.2.1 a t) s) (Z.2.1 a (phi.1 t s)) (phi.2.1 a t s)) (f.2 a (phi.1 t s)),
     \ b t s -> transH (ap Z.1 Z'.1 f.1 (phi.1 t (S.2.1 b s)) (Z.2.1 b (phi.1 t s)) (phi.2.2 b t s)) (f.2 b (phi.1 t s))) ;

  -- transport of a bilinear map along a path of torsors is postcomposition
  transp-bi (T S Z : Tor) (phi : BiHom T S Z) : (Z' : Tor) (p : Id Tor Z Z')
    -> Id (BiHom T S Z') (P1.subst Tor (\ W -> BiHom T S W) Z Z' p phi) (postBi T S Z Z' (idtohom Z Z' p) phi) =
    \ Z' p -> idJ Tor Z
      (\ W p' -> Id (BiHom T S W) (P1.subst Tor (\ V -> BiHom T S V) Z W p' phi) (postBi T S Z W (idtohom Z W p') phi))
      (bihom-eq T S Z phi (postBi T S Z Z (idhom Z) phi) (\ t s -> refl (phi.1 t s))) Z' p ;

  SumP (T S : Tor) : U l+ = (Z : Tor) * BiHom T S Z ;

  ----------------------------------------------------------------------
  -- the pairs (Z, phi) form a contractible type

  module Centre (T S : Tor) (t0 : T.1) (s0 : S.1) {
    module DT = D[T.1, T.2] ;
    module DS = D[S.1, S.2] ;

    -- (a.t) - t0 = a + (t - t0)
    dshift (X : Tor) (x0 : X.1) (a : A) (x : X.1)
      : Id A (D[X.1, X.2].diff x0 (X.2.1 a x)) (add a (D[X.1, X.2].diff x0 x)) =
      D[X.1, X.2].uniq x0 (X.2.1 a x) (add a (D[X.1, X.2].diff x0 x))
        (transH (X.2.2.2.1 a (D[X.1, X.2].diff x0 x) x0)
                (ap X.1 X.1 (X.2.1 a) (X.2.1 (D[X.1, X.2].diff x0 x) x0) x (D[X.1, X.2].dact x0 x))) ;

    phi0 : BiHom T S Atriv =
      (\ t s -> add (DT.diff t0 t) (DS.diff s0 s),
       \ a t s -> transH (ap A A (\ d -> add d (DS.diff s0 s)) (DT.diff t0 (T.2.1 a t)) (add a (DT.diff t0 t))
                            (dshift T t0 a t))
                         (assoc a (DT.diff t0 t) (DS.diff s0 s)),
       \ b t s -> calc A {
         add (DT.diff t0 t) (DS.diff s0 (S.2.1 b s))
           =< ap A A (add (DT.diff t0 t)) (DS.diff s0 (S.2.1 b s)) (add b (DS.diff s0 s)) (dshift S s0 b s)
           > add (DT.diff t0 t) (add b (DS.diff s0 s))
           =< symH (assoc (DT.diff t0 t) b (DS.diff s0 s)) > add (add (DT.diff t0 t) b) (DS.diff s0 s)
           =< ap A A (\ d -> add d (DS.diff s0 s)) (add (DT.diff t0 t) b) (add b (DT.diff t0 t)) (comm (DT.diff t0 t) b)
           > add (add b (DT.diff t0 t)) (DS.diff s0 s)
           =< assoc b (DT.diff t0 t) (DS.diff s0 s) > add b (add (DT.diff t0 t) (DS.diff s0 s)) }) ;

    -- any (Z, phi) is A with  a |-> a . phi t0 s0
    to (z : SumP T S) : Hom Atriv z.1 = pthom z.1 (z.2.1 t0 s0) ;

    agree (z : SumP T S) (t : T.1) (s : S.1)
      : Id z.1.1 ((to z).1 (phi0.1 t s)) (z.2.1 t s) =
      calc z.1.1 {
        z.1.2.1 (add (DT.diff t0 t) (DS.diff s0 s)) (z.2.1 t0 s0)
          =< z.1.2.2.2.1 (DT.diff t0 t) (DS.diff s0 s) (z.2.1 t0 s0)
          > z.1.2.1 (DT.diff t0 t) (z.1.2.1 (DS.diff s0 s) (z.2.1 t0 s0))
          =< ap z.1.1 z.1.1 (z.1.2.1 (DT.diff t0 t)) (z.1.2.1 (DS.diff s0 s) (z.2.1 t0 s0))
               (z.2.1 t0 (S.2.1 (DS.diff s0 s) s0)) (symH (z.2.2.2 (DS.diff s0 s) t0 s0))
          > z.1.2.1 (DT.diff t0 t) (z.2.1 t0 (S.2.1 (DS.diff s0 s) s0))
          =< ap S.1 z.1.1 (\ v -> z.1.2.1 (DT.diff t0 t) (z.2.1 t0 v)) (S.2.1 (DS.diff s0 s) s0) s (DS.dact s0 s)
          > z.1.2.1 (DT.diff t0 t) (z.2.1 t0 s)
          =< symH (z.2.2.1 (DT.diff t0 t) t0 s) > z.2.1 (T.2.1 (DT.diff t0 t) t0) s
          =< ap T.1 z.1.1 (\ v -> z.2.1 v s) (T.2.1 (DT.diff t0 t) t0) t (DT.dact t0 t) > z.2.1 t s } ;

    contr : E1.isContr (SumP T S) =
      ((Atriv, phi0),
       \ z -> P1.Sigma-path Tor (\ W -> BiHom T S W) Atriv z.1 phi0 z.2 (decode Atriv z.1 (to z))
                (P1.trans (BiHom T S z.1)
                   (P1.subst Tor (\ W -> BiHom T S W) Atriv z.1 (decode Atriv z.1 (to z)) phi0)
                   (postBi T S Atriv z.1 (idtohom Atriv z.1 (decode Atriv z.1 (to z))) phi0) z.2
                   (transp-bi T S Atriv phi0 z.1 (decode Atriv z.1 (to z)))
                   (bihom-eq T S z.1 (postBi T S Atriv z.1 (idtohom Atriv z.1 (decode Atriv z.1 (to z))) phi0) z.2
                      (\ t s -> transH (ap (Hom Atriv z.1) z.1.1 (\ f -> f.1 (phi0.1 t s))
                                          (idtohom Atriv z.1 (decode Atriv z.1 (to z))) (to z)
                                          (idtohom-decode Atriv z.1 (to z)))
                                       (agree z t s))))) ;
  } ;

  sum-contr (T S : Tor) : E1.isContr (SumP T S) =
    Tr.Trunc[T.1].induction @(l+) (\ v -> E1.isContr (SumP T S)) (\ v -> Torsor[l+].isProp-isContr (SumP T S))
      (\ t0 -> Tr.Trunc[S.1].induction @(l+) (\ v -> E1.isContr (SumP T S)) (\ v -> Torsor[l+].isProp-isContr (SumP T S))
                 (\ s0 -> Centre[T, S, t0, s0].contr) S.2.2.2.2.2.2)
      T.2.2.2.2.2.2 ;

  ----------------------------------------------------------------------
  -- the sum and its interface

  Sum (T S : Tor) : Tor = (sum-contr T S).1.1 ;
  qb (T S : Tor) : BiHom T S (Sum T S) = (sum-contr T S).1.2 ;
  q (T S : Tor) (t : T.1) (s : S.1) : (Sum T S).1 = (qb T S).1 t s ;

  -- q (a.t) (b.s) = (a + b) . q t s;  in particular q (a.t) ((-a).s) = q t s
  q-both (T S : Tor) (a b : A) (t : T.1) (s : S.1)
    : Id (Sum T S).1 (q T S (T.2.1 a t) (S.2.1 b s)) ((Sum T S).2.1 (add a b) (q T S t s)) =
    transH ((qb T S).2.1 a t (S.2.1 b s))
      (transH (ap (Sum T S).1 (Sum T S).1 ((Sum T S).2.1 a) (q T S t (S.2.1 b s)) ((Sum T S).2.1 b (q T S t s))
                  ((qb T S).2.2 b t s))
              (symH ((Sum T S).2.2.2.1 a b (q T S t s)))) ;

  q-anti (T S : Tor) (a : A) (t : T.1) (s : S.1)
    : Id (Sum T S).1 (q T S (T.2.1 a t) (S.2.1 (inv a) s)) (q T S t s) =
    transH (q-both T S a (inv a) t s)
      (transH (ap A (Sum T S).1 (\ c -> (Sum T S).2.1 c (q T S t s)) (add a (inv a)) o (invr a))
              ((Sum T S).2.2.2.2.1 (q T S t s))) ;

  -- universal property:  Hom (Sum T S) Z  ~  BiHom T S Z,  f |-> f o q
  module UP (T S : Tor) {
    module FTS = F1.FT[Tor, \ W -> BiHom T S W, Sum T S, qb T S, sum-contr T S] ;
    restrict (Z : Tor) (f : Hom (Sum T S) Z) : BiHom T S Z = postBi T S (Sum T S) Z f (qb T S) ;
    extend (Z : Tor) (phi : BiHom T S Z) : Hom (Sum T S) Z = idtohom (Sum T S) Z (FTS.dec Z phi) ;

    restrict-extend (Z : Tor) (phi : BiHom T S Z) : Id (BiHom T S Z) (restrict Z (extend Z phi)) phi =
      P1.trans (BiHom T S Z) (restrict Z (extend Z phi)) (FTS.enc Z (FTS.dec Z phi)) phi
        (P1.sym (BiHom T S Z) (FTS.enc Z (FTS.dec Z phi)) (restrict Z (extend Z phi))
           (transp-bi T S (Sum T S) (qb T S) Z (FTS.dec Z phi)))
        (FTS.enc-dec Z phi) ;

    extend-restrict (Z : Tor) (f : Hom (Sum T S) Z) : Id (Hom (Sum T S) Z) (extend Z (restrict Z f)) f =
      P1.trans (Hom (Sum T S) Z) (extend Z (restrict Z f)) (idtohom (Sum T S) Z (decode (Sum T S) Z f)) f
        (P1.ap (Id Tor (Sum T S) Z) (Hom (Sum T S) Z) (idtohom (Sum T S) Z)
           (FTS.dec Z (restrict Z f)) (decode (Sum T S) Z f)
           (P1.trans (Id Tor (Sum T S) Z) (FTS.dec Z (restrict Z f))
              (FTS.dec Z (FTS.enc Z (decode (Sum T S) Z f))) (decode (Sum T S) Z f)
              (P1.ap (BiHom T S Z) (Id Tor (Sum T S) Z) (FTS.dec Z) (restrict Z f)
                 (FTS.enc Z (decode (Sum T S) Z f))
                 (P1.trans (BiHom T S Z) (restrict Z f)
                    (postBi T S (Sum T S) Z (idtohom (Sum T S) Z (decode (Sum T S) Z f)) (qb T S))
                    (FTS.enc Z (decode (Sum T S) Z f))
                    (P1.ap (Hom (Sum T S) Z) (BiHom T S Z) (\ g -> postBi T S (Sum T S) Z g (qb T S))
                       f (idtohom (Sum T S) Z (decode (Sum T S) Z f))
                       (P1.sym (Hom (Sum T S) Z) (idtohom (Sum T S) Z (decode (Sum T S) Z f)) f
                          (idtohom-decode (Sum T S) Z f)))
                    (P1.sym (BiHom T S Z) (FTS.enc Z (decode (Sum T S) Z f))
                       (postBi T S (Sum T S) Z (idtohom (Sum T S) Z (decode (Sum T S) Z f)) (qb T S))
                       (transp-bi T S (Sum T S) (qb T S) Z (decode (Sum T S) Z f)))))
              (FTS.dec-enc Z (decode (Sum T S) Z f))))
        (idtohom-decode (Sum T S) Z f) ;

    universal (Z : Tor) : Equiv (Hom (Sum T S) Z) (BiHom T S Z) =
      (restrict Z, qinv (Hom (Sum T S) Z) (BiHom T S Z) (restrict Z) (extend Z)
                     (restrict-extend Z) (extend-restrict Z)) ;

    -- the extension of phi satisfies  extend phi (q t s) = phi t s
    extend-q (Z : Tor) (phi : BiHom T S Z) (t : T.1) (s : S.1)
      : Id Z.1 ((extend Z phi).1 (q T S t s)) (phi.1 t s) =
      ap (BiHom T S Z) Z.1 (\ psi -> psi.1 t s) (restrict Z (extend Z phi)) phi (restrict-extend Z phi) ;
  } ;

  -- functoriality: f (x) g with (f (x) g) (q t s) = q (f t) (g s)
  module Tensor (T T' S S' : Tor) (f : Hom T T') (g : Hom S S') {
    phi : BiHom T S (Sum T' S') =
      (\ t s -> q T' S' (f.1 t) (g.1 s),
       \ a t s -> transH (ap T'.1 (Sum T' S').1 (\ v -> q T' S' v (g.1 s)) (f.1 (T.2.1 a t)) (T'.2.1 a (f.1 t)) (f.2 a t))
                         ((qb T' S').2.1 a (f.1 t) (g.1 s)),
       \ b t s -> transH (ap S'.1 (Sum T' S').1 (q T' S' (f.1 t)) (g.1 (S.2.1 b s)) (S'.2.1 b (g.1 s)) (g.2 b s))
                         ((qb T' S').2.2 b (f.1 t) (g.1 s))) ;
    tensor : Hom (Sum T S) (Sum T' S') = UP[T, S].extend (Sum T' S') phi ;
    tensor-q (t : T.1) (s : S.1) : Id (Sum T' S').1 (tensor.1 (q T S t s)) (q T' S' (f.1 t) (g.1 s)) =
      UP[T, S].extend-q (Sum T' S') phi t s ;
  } ;
} ;
