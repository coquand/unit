-- All.seg: SAG Lemma 7.4.2 (cocycles and torsors with local sections),
-- in the setting of ../replacement: univalence and replacement as the
-- parameters of one segment; truncation is derived from replacement.
import Base ;
import Prelude ;
import Paths ;
import Axioms ;
import FunExtUA ;
import Replacement ;

module Theory
  (univ : [l] Axioms[l].Univalence)
  (images : [l] [k] Replacement[l,k].Images)
  (surjections : [l] [k] [j] (Replacement[l,k].Surjectivity (images @l @k)) @j) {
  fe : [l] Axioms[l].FunExt = <l> FunExtUA[l].FE[univ @l].fe ;
  propUA : [l] Axioms[l].PropUnivalence = <l> Axioms[l].UnivalenceLemmas[univ @l].prop-univ ;
  import Truncation ; import TruncationCombinators ;
  import Torsor ;
  import TorsorId ;
  import Groupoid ;
  import Gerbe ;
  import Cocycle2 ;
  import TrivialGerbe ;
  import Trivialise ;
  import Sip2 ;
  import Gerbe74 ;
  import Coboundary ;
  import Vanish ;
  import FinChoice ;
  import Cech ;
  import Quotient ;
  import Ftit ;
  import TorSum ;
  import GerbeSum ;
  import SumCocycle ;
  import CechQ ;
  import CechGroup ;
  import Refine ;
  import Alg73 ;
  import Affine ;
} ;
