-- Groupoid.seg: the groupoid laws of identity types, and two generic
-- lemmas: a retract of a set is a set; an embedding has propositional
-- fibres.  Level-polymorphic, used at l and l+.

level l ;
open Base ;
open Prelude[l] ;
open Paths[l] ;

------------------------------------------------------------------------
-- groupoid laws

tassoc (X : U l) (x y z : X) (p : Id X x y) (q : Id X y z) : (w : X) (r : Id X z w)
  -> Id (Id X x w) (trans X x z w (trans X x y z p q) r) (trans X x y w p (trans X y z w q r)) =
  \ w r -> idJ X z (\ w' r' -> Id (Id X x w') (trans X x z w' (trans X x y z p q) r')
                                         (trans X x y w' p (trans X y z w' q r')))
             (refl (trans X x y z p q)) w r ;

trans-sym-r (X : U l) (x y : X) (p : Id X x y) : Id (Id X x x) (trans X x y x p (sym X x y p)) (refl x) =
  idJ X x (\ y' p' -> Id (Id X x x) (trans X x y' x p' (sym X x y' p')) (refl x)) (refl (refl x)) y p ;

-- (k p) p^-1 = k
cancel-r (X : U l) (x y z : X) (k : Id X x y) (p : Id X y z)
  : Id (Id X x y) (trans X x z y (trans X x y z k p) (sym X y z p)) k =
  transH (tassoc X x y z k p y (sym X y z p))
         (ap (Id X y y) (Id X x y) (trans X x y y k) (trans X y z y p (sym X y z p)) (refl y)
             (trans-sym-r X y z p)) ;

-- (k p^-1) p = k
cancel-r' (X : U l) (x y z : X) (k : Id X x z) (p : Id X y z)
  : Id (Id X x z) (trans X x y z (trans X x z y k (sym X y z p)) p) k =
  transH (tassoc X x z y k (sym X y z p) z p)
         (ap (Id X z z) (Id X x z) (trans X x z z k) (trans X z y z (sym X y z p) p) (refl z)
             (trans-sym-l X y z p)) ;

sym-trans (X : U l) (x y z : X) (p : Id X x y) (q : Id X y z)
  : Id (Id X z x) (sym X x z (trans X x y z p q)) (trans X z y x (sym X y z q) (sym X x y p)) =
  idJ X y (\ z' q' -> Id (Id X z' x) (sym X x z' (trans X x y z' p q'))
                                     (trans X z' y x (sym X y z' q') (sym X x y p)))
    (symH (trans-refl-l X y x (sym X x y p))) z q ;

ap-trans (X Y : U l) (f : X -> Y) (x y z : X) (p : Id X x y) (q : Id X y z)
  : Id (Id Y (f x) (f z)) (ap X Y f x z (trans X x y z p q))
                          (trans Y (f x) (f y) (f z) (ap X Y f x y p) (ap X Y f y z q)) =
  idJ X y (\ z' q' -> Id (Id Y (f x) (f z')) (ap X Y f x z' (trans X x y z' p q'))
                                             (trans Y (f x) (f y) (f z') (ap X Y f x y p) (ap X Y f y z' q')))
    (refl (ap X Y f x y p)) z q ;

sym-sym (X : U l) (x y : X) (p : Id X x y) : Id (Id X x y) (sym X y x (sym X x y p)) p =
  idJ X x (\ y' p' -> Id (Id X x y') (sym X y' x (sym X x y' p')) p') (refl (refl x)) y p ;

-- transport in x |-> (x = x) is conjugation
transport-conj (X : U l) (a b : X) (q : Id X a b) (lp : Id X a a)
  : Id (Id X b b) (subst X (\ x -> Id X x x) a b q lp) (trans X b a b (trans X b a a (sym X a b q) lp) q) =
  idJ X a (\ b' q' -> Id (Id X b' b') (subst X (\ x -> Id X x x) a b' q' lp)
                                      (trans X b' a b' (trans X b' a a (sym X a b' q') lp) q'))
    (symH (trans-refl-l X a a lp)) b q ;

-- transport in x |-> (f x = c) is precomposition with ap f q^-1
transport-fib (X Y : U l) (f : X -> Y) (c : Y) (a b : X) (q : Id X a b) (p : Id Y (f a) c)
  : Id (Id Y (f b) c) (subst X (\ x -> Id Y (f x) c) a b q p)
                      (trans Y (f b) (f a) c (sym Y (f a) (f b) (ap X Y f a b q)) p) =
  idJ X a (\ b' q' -> Id (Id Y (f b') c) (subst X (\ x -> Id Y (f x) c) a b' q' p)
                                         (trans Y (f b') (f a) c (sym Y (f a) (f b') (ap X Y f a b' q')) p))
    (symH (trans-refl-l Y (f a) c p)) b q ;

-- (a c^-1)(c d) = a d
cancel-mid (X : U l) (x y z : X) (a : Id X y z) (c : Id X x z) : (w : X) (d : Id X z w)
  -> Id (Id X y w) (trans X y x w (trans X y z x a (sym X x z c)) (trans X x z w c d)) (trans X y z w a d) =
  \ w d -> idJ X z (\ w' d' -> Id (Id X y w') (trans X y x w' (trans X y z x a (sym X x z c)) (trans X x z w' c d'))
                                              (trans X y z w' a d'))
             (cancel-r' X y x z a c) w d ;


-- a retract of a set is a set
set-retract (X Y : U l) (s : X -> Y) (r : Y -> X) (h : (x : X) -> Id X (r (s x)) x) (sY : isSet Y)
  : isSet X = \ x y ->
  retract-prop (Id X x y) (Id Y (s x) (s y)) (ap X Y s x y)
    (\ q -> trans X x (r (s x)) y (sym X (r (s x)) x (h x))
              (trans X (r (s x)) (r (s y)) y (ap Y X r (s x) (s y) q) (h y)))
    (\ e -> idJ X x
       (\ y' e' -> Id (Id X x y')
          (trans X x (r (s x)) y' (sym X (r (s x)) x (h x))
             (trans X (r (s x)) (r (s y')) y' (ap Y X r (s x) (s y') (ap X Y s x y' e')) (h y'))) e')
       (transH (ap (Id X (r (s x)) x) (Id X x x) (trans X x (r (s x)) x (sym X (r (s x)) x (h x)))
                   (trans X (r (s x)) (r (s x)) x (refl (r (s x))) (h x)) (h x)
                   (trans-refl-l X (r (s x)) x (h x)))
               (trans-sym-l X (r (s x)) x (h x)))
       y e)
    (sY (s x) (s y)) ;

-- an embedding has propositional fibres
emb-fib-prop (X Y : U l) (F : X -> Y)
  (apE : (x x' : X) -> isEquiv (Id X x x') (Id Y (F x) (F x')) (ap X Y F x x')) (y : Y)
  : isProp ((x : X) * Id Y (F x) y) = \ w w' ->
  Sigma-path X (\ x -> Id Y (F x) y) w.1 w'.1 w.2 w'.2
    ((apE w.1 w'.1).sec (trans Y (F w.1) y (F w'.1) w.2 (sym Y (F w'.1) y w'.2)))
    (calc (Id Y (F w'.1) y) {
      subst X (\ x -> Id Y (F x) y) w.1 w'.1
        ((apE w.1 w'.1).sec (trans Y (F w.1) y (F w'.1) w.2 (sym Y (F w'.1) y w'.2))) w.2
        =< transport-fib X Y F y w.1 w'.1
             ((apE w.1 w'.1).sec (trans Y (F w.1) y (F w'.1) w.2 (sym Y (F w'.1) y w'.2))) w.2
        > trans Y (F w'.1) (F w.1) y
            (sym Y (F w.1) (F w'.1)
               (ap X Y F w.1 w'.1 ((apE w.1 w'.1).sec
                  (trans Y (F w.1) y (F w'.1) w.2 (sym Y (F w'.1) y w'.2))))) w.2
        =< ap (Id Y (F w.1) (F w'.1)) (Id Y (F w'.1) y)
             (\ k -> trans Y (F w'.1) (F w.1) y (sym Y (F w.1) (F w'.1) k) w.2)
             (ap X Y F w.1 w'.1 ((apE w.1 w'.1).sec
                (trans Y (F w.1) y (F w'.1) w.2 (sym Y (F w'.1) y w'.2))))
             (trans Y (F w.1) y (F w'.1) w.2 (sym Y (F w'.1) y w'.2))
             ((apE w.1 w'.1).sec-eq (trans Y (F w.1) y (F w'.1) w.2 (sym Y (F w'.1) y w'.2)))
        > trans Y (F w'.1) (F w.1) y
            (sym Y (F w.1) (F w'.1) (trans Y (F w.1) y (F w'.1) w.2 (sym Y (F w'.1) y w'.2))) w.2
        =< ap (Id Y (F w'.1) (F w.1)) (Id Y (F w'.1) y)
             (\ k -> trans Y (F w'.1) (F w.1) y k w.2)
             (sym Y (F w.1) (F w'.1) (trans Y (F w.1) y (F w'.1) w.2 (sym Y (F w'.1) y w'.2)))
             (trans Y (F w'.1) y (F w.1) (sym Y y (F w'.1) (sym Y (F w'.1) y w'.2)) (sym Y (F w.1) y w.2))
             (sym-trans Y (F w.1) y (F w'.1) w.2 (sym Y (F w'.1) y w'.2))
        > trans Y (F w'.1) (F w.1) y
            (trans Y (F w'.1) y (F w.1) (sym Y y (F w'.1) (sym Y (F w'.1) y w'.2)) (sym Y (F w.1) y w.2)) w.2
        =< cancel-r' Y (F w'.1) (F w.1) y (sym Y y (F w'.1) (sym Y (F w'.1) y w'.2)) w.2
        > sym Y y (F w'.1) (sym Y (F w'.1) y w'.2)
        =< sym-sym Y (F w'.1) y w'.2 > w'.2 }) ;

-- any dependent function on loops is invariant under conjugation
conj-inv (X B : U l) (b : (x : X) -> Id X x x -> B) (a : X) (lp : Id X a a) (c : X) (q : Id X a c)
  : Id B (b c (trans X c a c (trans X c a a (sym X a c q) lp) q)) (b a lp) =
  idJ X a (\ c' q' -> Id B (b c' (trans X c' a c' (trans X c' a a (sym X a c' q') lp) q')) (b a lp))
    (ap (Id X a a) B (b a) (trans X a a a (refl a) lp) lp (trans-refl-l X a a lp)) c q ;

-- (a m) u = (a u) ((u^-1 m) u)
conj-move (X : U l) (x y : X) (a : Id X x y) (m : Id X y y) : (z : X) (v : Id X y z)
  -> Id (Id X x z) (trans X x y z (trans X x y y a m) v)
                   (trans X x z z (trans X x y z a v) (trans X z y z (trans X z y y (sym X y z v) m) v)) =
  \ z v -> idJ X y (\ z' v' -> Id (Id X x z') (trans X x y z' (trans X x y y a m) v')
                     (trans X x z' z' (trans X x y z' a v') (trans X z' y z' (trans X z' y y (sym X y z' v') m) v')))
             (symH (ap (Id X y y) (Id X x y) (trans X x y y a) (trans X y y y (refl y) m) m (trans-refl-l X y y m)))
             z v ;
