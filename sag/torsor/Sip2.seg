-- Sip2.seg: structure identity for gerbes with points and paths.  An
-- equivalence e : X ~ X' preserving the bands (BP), with paths
-- q i : e (u i) = u' i (QP) compatible with the chosen paths (CP), gives
-- an identification  (X, s, u, p) = (X', s', u', p')  in Left2.  By
-- induction on equivalences (eqind) it suffices that e is the identity;
-- then the bands agree pointwise and the other fields are propositions,
-- and the points are moved by function extensionality (stepJ).

level l ;
open Base ;
open Prelude[l] ;
open Paths[l] ;
open FunExtUA[l] ;
open Torsor[l] ;
open Groupoid[l] ;
open Gerbe[l] ;
open Cocycle2[l] ;
module Tr = Truncation[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module P1 = Prelude[l+] ;

ap-id (X : U l) (x y : X) (h : Id X x y) : Id (Id X x y) (ap X X (\ z -> z) x y h) h =
  idJ X x (\ y' h' -> Id (Id X x y') (ap X X (\ z -> z) x y' h') h') (refl (refl x)) y h ;

module SipG (Gr : Ab) (L : U l) {
  open Gr ;
  open AbL[Gr] ;
  open Gerbes[Gr] ;
  open Coc2[Gr,L] ;

  GS (X : U l) : U l =
    (gpd : (a b : X) -> isSet (Id X a b)) * (inh : Tr.Trunc[X].carrier)
    * (conn : (a b : X) -> Tr.Trunc[Id X a b].carrier) * ((x : X) -> Band X x) ;
  PP (X : U l) (u : L -> X) : U l = (i j : L) -> Id X (u i) (u j) ;

  BP (X X' : U l) (s : GS X) (s' : GS X') (e : Equiv X X') : U l =
    (x : X) (lp : Id X x x) -> Id A ((s'.2.2.2 (e.1 x)).1 (ap X X' e.1 x x lp)) ((s.2.2.2 x).1 lp) ;
  QP (X X' : U l) (e : Equiv X X') (u : L -> X) (u' : L -> X') : U l =
    (i : L) -> Id X' (e.1 (u i)) (u' i) ;
  CP (X X' : U l) (e : Equiv X X') (u : L -> X) (u' : L -> X') (p : PP X u) (p' : PP X' u')
    (q : QP X X' e u u') : U l =
    (i j : L) -> Id (Id X' (e.1 (u i)) (u' j))
                    (trans X' (e.1 (u i)) (e.1 (u j)) (u' j) (ap X X' e.1 (u i) (u j) (p i j)) (q j))
                    (trans X' (e.1 (u i)) (u' i) (u' j) (q i) (p' i j)) ;

  Mot (X : U l) (s : GS X) (u : L -> X) (p : PP X u) (X' : U l) (e : Equiv X X') : U l+ =
    (s' : GS X') (u' : L -> X') (p' : PP X' u') -> BP X X' s s' e -> (q : QP X X' e u u')
    -> CP X X' e u u' p p' q -> Id Left2 ((X, s), u, p) ((X', s'), u', p') ;

  ----------------------------------------------------------------------
  -- gerbe structures on X with the same band are equal

  bandrest-prop (X : U l) (x : X) (f : Id X x x -> A)
    : isProp ((be : (a : A) -> isContr ((lp : Id X x x) * Id A (f lp) a))
              * ((p q : Id X x x) -> Id A (f (trans X x x x p q)) (add (f p) (f q)))) =
    isProp-Sigma ((a : A) -> isContr ((lp : Id X x x) * Id A (f lp) a))
      (\ be -> (p q : Id X x x) -> Id A (f (trans X x x x p q)) (add (f p) (f q)))
      (FL.isProp-Pi A (\ a -> isContr ((lp : Id X x x) * Id A (f lp) a))
         (\ a -> isProp-isContr ((lp : Id X x x) * Id A (f lp) a)))
      (\ be -> FL.isProp-Pi (Id X x x) (\ p -> (q : Id X x x) -> Id A (f (trans X x x x p q)) (add (f p) (f q)))
         (\ p -> FL.isProp-Pi (Id X x x) (\ q -> Id A (f (trans X x x x p q)) (add (f p) (f q)))
            (\ q -> setA (f (trans X x x x p q)) (add (f p) (f q))))) ;

  band-eq (X : U l) (b b' : (x : X) -> Band X x)
    (h : (x : X) (lp : Id X x x) -> Id A ((b x).1 lp) ((b' x).1 lp)) : Id ((x : X) -> Band X x) b b' =
    FL.funext X (\ x -> Band X x) b b' (\ x ->
      Sigma-eq (Id X x x -> A)
        (\ f -> (be : (a : A) -> isContr ((lp : Id X x x) * Id A (f lp) a))
                * ((p q : Id X x x) -> Id A (f (trans X x x x p q)) (add (f p) (f q))))
        (b x).1 (b' x).1 (b x).2 (b' x).2
        (FL.funext (Id X x x) (\ lp -> A) (b x).1 (b' x).1 (h x))
        (bandrest-prop X x (b' x).1)) ;

  gpd-prop (X : U l) : isProp ((a b : X) -> isSet (Id X a b)) =
    FL.isProp-Pi X (\ a -> (b : X) -> isSet (Id X a b))
      (\ a -> FL.isProp-Pi X (\ b -> isSet (Id X a b)) (\ b -> isProp-isSet (Id X a b))) ;
  conn-prop (X : U l) : isProp ((a b : X) -> Tr.Trunc[Id X a b].carrier) =
    FL.isProp-Pi X (\ a -> (b : X) -> Tr.Trunc[Id X a b].carrier)
      (\ a -> FL.isProp-Pi X (\ b -> Tr.Trunc[Id X a b].carrier) (\ b -> Tr.Trunc[Id X a b].proposition)) ;

  gs-eq (X : U l) (s s' : GS X)
    (h : (x : X) (lp : Id X x x) -> Id A ((s.2.2.2 x).1 lp) ((s'.2.2.2 x).1 lp)) : Id (GS X) s s' =
    trans (GS X) s (s'.1, s.2) s'
      (ap ((a b : X) -> isSet (Id X a b)) (GS X) (\ g -> (g, s.2)) s.1 s'.1 (gpd-prop X s.1 s'.1))
      (trans (GS X) (s'.1, s.2) (s'.1, s'.2.1, s.2.2) s'
        (ap Tr.Trunc[X].carrier (GS X) (\ i -> (s'.1, i, s.2.2)) s.2.1 s'.2.1
            (Tr.Trunc[X].proposition s.2.1 s'.2.1))
        (trans (GS X) (s'.1, s'.2.1, s.2.2) (s'.1, s'.2.1, s'.2.2.1, s.2.2.2) s'
          (ap ((a b : X) -> Tr.Trunc[Id X a b].carrier) (GS X) (\ c -> (s'.1, s'.2.1, c, s.2.2.2))
              s.2.2.1 s'.2.2.1 (conn-prop X s.2.2.1 s'.2.2.1))
          (ap ((x : X) -> Band X x) (GS X) (\ b -> (s'.1, s'.2.1, s'.2.2.1, b))
              s.2.2.2 s'.2.2.2 (band-eq X s.2.2.2 s'.2.2.2 h)))) ;

  ----------------------------------------------------------------------
  -- moving the points, for e the identity

  stepJ-base (X : U l) (s' : GS X) (u : L -> X) (p p' : PP X u)
    (cp : CP X X (idEquiv X) u u p p' (\ i -> refl (u i))) : Id Left2 ((X, s'), u, p) ((X, s'), u, p') =
    P1.ap (PP X u) Left2 (\ P -> ((X, s'), u, P)) p p'
      (FL.funext L (\ i -> (j : L) -> Id X (u i) (u j)) p p' (\ i ->
         FL.funext L (\ j -> Id X (u i) (u j)) (p i) (p' i) (\ j ->
           transH (symH (ap-id X (u i) (u j) (p i j)))
                  (transH (cp i j) (trans-refl-l X (u i) (u j) (p' i j)))))) ;

  stepJ (X : U l) (s' : GS X) (u : L -> X) (p : PP X u) : (u' : L -> X) (U' : Id (L -> X) u u')
    (p' : PP X u') (cp : CP X X (idEquiv X) u u' p p' (happly L (\ i -> X) u u' U'))
    -> Id Left2 ((X, s'), u, p) ((X, s'), u', p') =
    \ u' U' -> idJ (L -> X) u
      (\ u2 U2 -> (p' : PP X u2) -> CP X X (idEquiv X) u u2 p p' (happly L (\ i -> X) u u2 U2)
                  -> Id Left2 ((X, s'), u, p) ((X, s'), u2, p'))
      (\ p' cp -> stepJ-base X s' u p p' cp) u' U' ;

  stepB (X : U l) (s' : GS X) (u u' : L -> X) (p : PP X u) (p' : PP X u')
    (q : QP X X (idEquiv X) u u') (cp : CP X X (idEquiv X) u u' p p' q)
    : Id Left2 ((X, s'), u, p) ((X, s'), u', p') =
    stepJ X s' u p u' (FL.funext L (\ i -> X) u u' q) p'
      (subst (QP X X (idEquiv X) u u') (\ Q -> CP X X (idEquiv X) u u' p p' Q) q
         (happly L (\ i -> X) u u' (FL.funext L (\ i -> X) u u' q))
         (sym (QP X X (idEquiv X) u u') (happly L (\ i -> X) u u' (FL.funext L (\ i -> X) u u' q)) q
            (FL.happly-funext L (\ i -> X) u u' q))
         cp) ;

  base (X : U l) (s : GS X) (u : L -> X) (p : PP X u) : Mot X s u p X (idEquiv X) =
    \ s' u' p' bp q cp ->
      P1.trans Left2 ((X, s), u, p) ((X, s'), u, p) ((X, s'), u', p')
        (P1.ap (GS X) Left2 (\ t -> ((X, t), u, p)) s s'
           (gs-eq X s s' (\ x lp -> symH (transH (ap (Id X x x) A (s'.2.2.2 x).1 lp (ap X X (\ z -> z) x x lp)
                                                     (symH (ap-id X x x lp)))
                                                 (bp x lp)))))
        (stepB X s' u u' p p' q cp) ;

  -- the structure identity principle for Left2
  sip2 (X : U l) (s : GS X) (u : L -> X) (p : PP X u) (X' : U l) (e : Equiv X X') : Mot X s u p X' e =
    eqind X (Mot X s u p) (base X s u p) X' e ;
} ;
