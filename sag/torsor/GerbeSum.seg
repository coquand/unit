-- GerbeSum.seg: the sum (contracted product along A x A -> A) of A-gerbes.
--   H = G1 x G2,  F g h = (h1 = g1) (x) (h2 = g2)   (sum of path torsors;
--   the loops at the source h act, so moving the target g along a loop
--   is the translation by +beta: PostM.tb-post)
--   G = image of F : H -> (H -> Tor)  (replacement; smallness by fsmall)
--   band of G at x: the constant value of h |-> tb (loop of incl x at h);
--   c |-> (\ h -> c) is an equivalence A ~ (H -> A) since H is connected
--   and inhabited, and cinv is its inverse (no point is chosen).

level l ;
open Base ;
open Prelude[l] ;
open Paths[l] ;
open FunExtUA[l] ;
open Torsor[l] ;
open TorsorId[l] ;
open Groupoid[l] ;
open Gerbe[l] ;
open TrivialGerbe[l] ;
open TorSum[l] ;
module Tr = Truncation[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module FL1 = Axioms[l+].FunExtLemmas[fe @(l+)] ;
module P1 = Prelude[l+] ;
module G1 = Groupoid[l+] ;
module R = Replacement[l,l+] ;

module GSumBase (Gr : Ab) {
  open Gr ;
  open AbL[Gr] ;
  open TorBase[Gr] ;
  open TorId[Gr] ;
  open Gerbes[Gr] ;
  open TrivG[Gr] ;
  open TSum[Gr] ;

  -- moving the target of a path torsor along a loop l is translation by beta l
  module PostM (Gb : AGerbe) (u0 : Gb.1) {
    module GW = GL[Gb] ;
    X : U l = Gb.1 ;
    FT (y : X) : Tor = GW.PTor u0 y ;

    post (y : X) : (y' : X) (h : Id X y y') (k : Id X u0 y)
      -> Id (Id X u0 y') ((idtohom (FT y) (FT y') (P1.ap X Tor FT y y' h)).1 k) (trans X u0 y y' k h) =
      \ y' h -> idJ X y (\ y2 h2 -> (k : Id X u0 y)
                   -> Id (Id X u0 y2) ((idtohom (FT y) (FT y2) (P1.ap X Tor FT y y2 h2)).1 k) (trans X u0 y y2 k h2))
                 (\ k -> refl k) y' h ;

    binv-conj (y : X) (lp : Id X y y) (k : Id X u0 y)
      : Id (Id X u0 u0) (GW.binv u0 (GW.bnd y lp)) (trans X u0 y u0 (trans X u0 y y k lp) (sym X u0 y k)) =
      transH (ap A (Id X u0 u0) (GW.binv u0) (GW.bnd y lp)
                 (GW.bnd u0 (trans X u0 y u0 (trans X u0 y y k lp) (sym X u0 y k)))
                 (symH (transH (ap (Id X u0 y) A
                                  (\ r -> GW.bnd u0 (trans X u0 y u0 (trans X u0 y y r lp) (sym X u0 y k)))
                                  k (sym X y u0 (sym X u0 y k)) (symH (sym-sym X u0 y k)))
                               (GW.band-conj y lp u0 (sym X u0 y k)))))
             (GW.bret u0 (trans X u0 y u0 (trans X u0 y y k lp) (sym X u0 y k))) ;

    tb-post (y : X) (lp : Id X y y) : Id A (tb (FT y) (P1.ap X Tor FT y y lp)) (GW.bnd y lp) =
      tb-char (FT y) (P1.ap X Tor FT y y lp) (GW.bnd y lp)
        (hom-eq (FT y) (FT y) (transl (FT y) (GW.bnd y lp)) (idtohom (FT y) (FT y) (P1.ap X Tor FT y y lp))
          (\ k -> transH (transH (ap (Id X u0 u0) (Id X u0 y) (\ r -> trans X u0 u0 y r k)
                                     (GW.binv u0 (GW.bnd y lp))
                                     (trans X u0 y u0 (trans X u0 y y k lp) (sym X u0 y k)) (binv-conj y lp k))
                                 (cancel-r' X u0 u0 y (trans X u0 y y k lp) k))
                         (symH (post y y lp k)))) ;
  } ;

  -- maps out of a sum agree if they agree on q
  hom-from-q (T S Z : Tor) (h1 h2 : Hom (Sum T S) Z)
    (e : (t : T.1) (s : S.1) -> Id Z.1 (h1.1 (q T S t s)) (h2.1 (q T S t s))) : Id (Hom (Sum T S) Z) h1 h2 =
    transH (symH (UP[T, S].extend-restrict Z h1))
      (transH (ap (BiHom T S Z) (Hom (Sum T S) Z) (UP[T, S].extend Z)
                  (UP[T, S].restrict Z h1) (UP[T, S].restrict Z h2)
                  (bihom-eq T S Z (UP[T, S].restrict Z h1) (UP[T, S].restrict Z h2) e))
              (UP[T, S].extend-restrict Z h2)) ;

  -- the tensor of two translations is the translation by the sum
  tensor-transl (T S : Tor) (a b : A)
    : Id (Hom (Sum T S) (Sum T S)) Tensor[T, T, S, S, transl T a, transl S b].tensor (transl (Sum T S) (add a b)) =
    hom-from-q T S (Sum T S) Tensor[T, T, S, S, transl T a, transl S b].tensor (transl (Sum T S) (add a b))
      (\ t s -> transH (Tensor[T, T, S, S, transl T a, transl S b].tensor-q t s) (q-both T S a b t s)) ;

  -- the path Sum T S = Sum T' S' from paths T = T', S = S', and its idtohom
  sump (T T' S S' : Tor) (p : Id Tor T T') (p' : Id Tor S S') : Id Tor (Sum T S) (Sum T' S') =
    P1.trans Tor (Sum T S) (Sum T' S) (Sum T' S')
      (P1.ap Tor Tor (\ W -> Sum W S) T T' p) (P1.ap Tor Tor (\ W -> Sum T' W) S S' p') ;

  sump-hom (T : Tor) (S : Tor) : (T' : Tor) (p : Id Tor T T') (S' : Tor) (p' : Id Tor S S')
    -> Id (Hom (Sum T S) (Sum T' S')) (idtohom (Sum T S) (Sum T' S') (sump T T' S S' p p'))
          Tensor[T, T', S, S', idtohom T T' p, idtohom S S' p'].tensor =
    \ T' p -> idJ Tor T
      (\ T2 p2 -> (S' : Tor) (p' : Id Tor S S')
          -> Id (Hom (Sum T S) (Sum T2 S')) (idtohom (Sum T S) (Sum T2 S') (sump T T2 S S' p2 p'))
                Tensor[T, T2, S, S', idtohom T T2 p2, idtohom S S' p'].tensor)
      (\ S' p' -> idJ Tor S
          (\ S2 p3 -> Id (Hom (Sum T S) (Sum T S2)) (idtohom (Sum T S) (Sum T S2) (sump T T S S2 (refl T) p3))
                         Tensor[T, T, S, S2, idhom T, idtohom S S2 p3].tensor)
          (hom-from-q T S (Sum T S) (idhom (Sum T S)) Tensor[T, T, S, S, idhom T, idhom S].tensor
             (\ t s -> symH (Tensor[T, T, S, S, idhom T, idhom S].tensor-q t s)))
          S' p')
      T' p ;

  -- loops of torsors are determined by their band
  tb-inj (X : Tor) (c : A) (e1 e2 : Id Tor X X) (h1 : Id A (tb X e1) c) (h2 : Id A (tb X e2) c)
    : Id (Id Tor X X) e1 e2 =
    P1.ap ((lp : Id Tor X X) * Id A (tb X lp) c) (Id Tor X X) (\ z -> z.1) (e1, h1) (e2, h2)
      (P1.trans ((lp : Id Tor X X) * Id A (tb X lp) c) (e1, h1) (tb-be X c).1 (e2, h2)
         (P1.sym ((lp : Id Tor X X) * Id A (tb X lp) c) (tb-be X c).1 (e1, h1) ((tb-be X c).2 (e1, h1)))
         ((tb-be X c).2 (e2, h2))) ;
} ;

------------------------------------------------------------------------
-- the sum of two gerbes

module GSum (Gr : Ab) (Ga Gb : Gerbes[Gr].AGerbe) {
  open Gr ;
  open AbL[Gr] ;
  open TorBase[Gr] ;
  open TorId[Gr] ;
  open Gerbes[Gr] ;
  open TrivG[Gr] ;
  open TSum[Gr] ;
  open GSumBase[Gr] ;
  module La = GL[Ga] ;
  module Lb = GL[Gb] ;

  H : U l = (x : Ga.1) * Gb.1 ;
  F (g h : H) : Tor = Sum (La.PTor h.1 g.1) (Lb.PTor h.2 g.2) ;
  FT : U l+ = H -> Tor ;
  hap (f f' : FT) (L : Id FT f f') (h : H) : Id Tor (f h) (f' h) = P1.happly H (\ k -> Tor) f f' L h ;

  -- path types of H -> Tor are small
  fsmall : R.LocallySmall FT = \ f f' ->
    ((h : H) -> Hom (f h) (f' h),
     (\ phi -> FL1.funext H (\ h -> Tor) f f' (\ h -> decode (f h) (f' h) (phi h)),
      P1.qinv ((h : H) -> Hom (f h) (f' h)) (Id FT f f')
        (\ phi -> FL1.funext H (\ h -> Tor) f f' (\ h -> decode (f h) (f' h) (phi h)))
        (\ L h -> idtohom (f h) (f' h) (hap f f' L h))
        (\ L -> P1.trans (Id FT f f')
                  (FL1.funext H (\ h -> Tor) f f' (\ h -> decode (f h) (f' h) (idtohom (f h) (f' h) (hap f f' L h))))
                  (FL1.funext H (\ h -> Tor) f f' (hap f f' L)) L
                  (P1.ap ((h : H) -> Id Tor (f h) (f' h)) (Id FT f f') (FL1.funext H (\ h -> Tor) f f')
                     (\ h -> decode (f h) (f' h) (idtohom (f h) (f' h) (hap f f' L h))) (hap f f' L)
                     (FL1.funext H (\ h -> Id Tor (f h) (f' h))
                        (\ h -> decode (f h) (f' h) (idtohom (f h) (f' h) (hap f f' L h))) (hap f f' L)
                        (\ h -> dec-enc (f h) (f' h) (hap f f' L h))))
                  (FL1.funext-happly H (\ h -> Tor) f f' L))
        (\ phi -> FL.funext H (\ h -> Hom (f h) (f' h))
                    (\ h -> idtohom (f h) (f' h)
                              (hap f f' (FL1.funext H (\ k -> Tor) f f' (\ k -> decode (f k) (f' k) (phi k))) h))
                    phi
                    (\ h -> transH (P1.ap (Id Tor (f h) (f' h)) (Hom (f h) (f' h)) (idtohom (f h) (f' h))
                                      (hap f f' (FL1.funext H (\ k -> Tor) f f' (\ k -> decode (f k) (f' k) (phi k))) h)
                                      (decode (f h) (f' h) (phi h))
                                      (P1.happly H (\ k -> Id Tor (f k) (f' k))
                                         (hap f f' (FL1.funext H (\ k -> Tor) f f' (\ k -> decode (f k) (f' k) (phi k))))
                                         (\ k -> decode (f k) (f' k) (phi k))
                                         (FL1.happly-funext H (\ k -> Tor) f f' (\ k -> decode (f k) (f' k) (phi k))) h))
                                   (idtohom-decode (f h) (f' h) (phi h)))))) ;

  img : R.Image[H, FT, F] = images @l @(l+) H FT fsmall F ;
  G : U l = img.carrier ;
  mu (g : H) : G = img.quotient g ;
  incl (x : G) : FT = img.inclusion x ;
  emb (x y : G) : P1.isEquiv (Id G x y) (Id FT (incl x) (incl y)) (P1.ap G FT incl x y) = img.embedding x y ;
  ind (P : G -> U l) (pP : (x : G) -> isProp (P x)) (b : (g : H) -> P (mu g)) (x : G) : P x =
    (surjections @l @(l+) @l H FT fsmall F P pP).sec b x ;

  ----------------------------------------------------------------------
  -- H is connected and inhabited; functions H -> A are constant

  pairp (x x' : Ga.1) (y y' : Gb.1) (p : Id Ga.1 x x') (p' : Id Gb.1 y y') : Id H (x, y) (x', y') =
    trans H (x, y) (x', y) (x', y') (ap Ga.1 H (\ a -> (a, y)) x x' p) (ap Gb.1 H (\ b -> (x', b)) y y' p') ;

  conn-H (g g' : H) : Tr.Trunc[Id H g g'].carrier =
    Tr.Trunc[Id Ga.1 g.1 g'.1].induction @l (\ v -> Tr.Trunc[Id H g g'].carrier) (\ v -> Tr.Trunc[Id H g g'].proposition)
      (\ p -> Tr.Trunc[Id Gb.1 g.2 g'.2].induction @l (\ v -> Tr.Trunc[Id H g g'].carrier)
                (\ v -> Tr.Trunc[Id H g g'].proposition)
                (\ p' -> Tr.Trunc[Id H g g'].inc (pairp g.1 g'.1 g.2 g'.2 p p'))
                (Lb.conn g.2 g'.2))
      (La.conn g.1 g'.1) ;

  inh-H : Tr.Trunc[H].carrier =
    Tr.Trunc[Ga.1].induction @l (\ v -> Tr.Trunc[H].carrier) (\ v -> Tr.Trunc[H].proposition)
      (\ x -> Tr.Trunc[Gb.1].induction @l (\ v -> Tr.Trunc[H].carrier) (\ v -> Tr.Trunc[H].proposition)
                (\ y -> Tr.Trunc[H].inc (x, y)) Gb.2.2.1)
      Ga.2.2.1 ;

  CF (phi : H -> A) : U l = (a : A) * Id (H -> A) (\ h -> a) phi ;
  setHA : isSet (H -> A) = FL.isSet-Pi H (\ h -> A) (\ h -> setA) ;

  cf-prop (phi : H -> A) : isProp (CF phi) = \ z z' ->
    Sigma-eq A (\ a -> Id (H -> A) (\ h -> a) phi) z.1 z'.1 z.2 z'.2
      (Tr.Trunc[H].induction @l (\ v -> Id A z.1 z'.1) (\ v -> setA z.1 z'.1)
         (\ h0 -> transH (happly H (\ h -> A) (\ h -> z.1) phi z.2 h0)
                         (symH (happly H (\ h -> A) (\ h -> z'.1) phi z'.2 h0)))
         inh-H)
      (setHA (\ h -> z'.1) phi) ;

  cf-at (phi : H -> A) (h0 : H) : CF phi =
    (phi h0, FL.funext H (\ h -> A) (\ h -> phi h0) phi (\ h ->
       Tr.Trunc[Id H h0 h].induction @l (\ v -> Id A (phi h0) (phi h)) (\ v -> setA (phi h0) (phi h))
         (\ e -> ap H A phi h0 h e) (conn-H h0 h))) ;

  cf-contr (phi : H -> A) : isContr (CF phi) =
    Tr.Trunc[H].induction @l (\ v -> isContr (CF phi)) (\ v -> isProp-isContr (CF phi))
      (\ h0 -> (cf-at phi h0, cf-prop phi (cf-at phi h0))) inh-H ;

  -- the constant value
  cinv (phi : H -> A) : A = (cf-contr phi).1.1 ;
  cinv-pt (phi : H -> A) (h : H) : Id A (cinv phi) (phi h) =
    happly H (\ k -> A) (\ k -> cinv phi) phi (cf-contr phi).1.2 h ;
  cinv-const (a : A) : Id A (cinv (\ h -> a)) a =
    ap (CF (\ h -> a)) A (\ z -> z.1) (cf-contr (\ h -> a)).1 (a, refl (\ h -> a))
       (cf-prop (\ h -> a) (cf-contr (\ h -> a)).1 (a, refl (\ h -> a))) ;
  cinv-ext (phi psi : H -> A) (e : (h : H) -> Id A (phi h) (psi h)) : Id A (cinv phi) (cinv psi) =
    ap (H -> A) A cinv phi psi (FL.funext H (\ h -> A) phi psi e) ;
  cinv-add (phi psi : H -> A) : Id A (cinv (\ h -> add (phi h) (psi h))) (add (cinv phi) (cinv psi)) =
    transH (cinv-ext (\ h -> add (phi h) (psi h)) (\ h -> add (cinv phi) (cinv psi))
              (\ h -> symH (transH (ap A A (\ c -> add c (cinv psi)) (cinv phi) (phi h) (cinv-pt phi h))
                                   (ap A A (add (phi h)) (cinv psi) (psi h) (cinv-pt psi h)))))
           (cinv-const (add (cinv phi) (cinv psi))) ;

  ----------------------------------------------------------------------
  -- the band of G

  Bnd (f : FT) (L : Id FT f f) : A = cinv (\ h -> tb (f h) (hap f f L h)) ;
  kb (x : G) (lp : Id G x x) : A = Bnd (incl x) (P1.ap G FT incl x x lp) ;

  hap-trans (f f' : FT) (L : Id FT f f') : (f'' : FT) (L' : Id FT f' f'') (h : H)
    -> Id (Id Tor (f h) (f'' h)) (hap f f'' (P1.trans FT f f' f'' L L') h)
          (P1.trans Tor (f h) (f' h) (f'' h) (hap f f' L h) (hap f' f'' L' h)) =
    \ f'' L' -> idJ FT f'
      (\ f3 L3 -> (h : H) -> Id (Id Tor (f h) (f3 h)) (hap f f3 (P1.trans FT f f' f3 L L3) h)
                     (P1.trans Tor (f h) (f' h) (f3 h) (hap f f' L h) (hap f' f3 L3 h)))
      (\ h -> refl (hap f f' L h)) f'' L' ;

  Bnd-hom (f : FT) (L L' : Id FT f f) : Id A (Bnd f (P1.trans FT f f f L L')) (add (Bnd f L) (Bnd f L')) =
    transH (cinv-ext (\ h -> tb (f h) (hap f f (P1.trans FT f f f L L') h))
              (\ h -> add (tb (f h) (hap f f L h)) (tb (f h) (hap f f L' h)))
              (\ h -> transH (P1.ap (Id Tor (f h) (f h)) A (tb (f h)) (hap f f (P1.trans FT f f f L L') h)
                                (P1.trans Tor (f h) (f h) (f h) (hap f f L h) (hap f f L' h)) (hap-trans f f L f L' h))
                             (tb-hom (f h) (hap f f L h) (hap f f L' h))))
           (cinv-add (\ h -> tb (f h) (hap f f L h)) (\ h -> tb (f h) (hap f f L' h))) ;

  kb-hom (x : G) (p p' : Id G x x) : Id A (kb x (trans G x x x p p')) (add (kb x p) (kb x p')) =
    transH (P1.ap (Id FT (incl x) (incl x)) A (Bnd (incl x))
               (P1.ap G FT incl x x (trans G x x x p p'))
               (P1.trans FT (incl x) (incl x) (incl x) (P1.ap G FT incl x x p) (P1.ap G FT incl x x p'))
               (G1.ap-trans G FT incl x x x p p'))
           (Bnd-hom (incl x) (P1.ap G FT incl x x p) (P1.ap G FT incl x x p')) ;

  -- a section and a retraction of the band
  lsec (f : FT) (a : A) : Id FT f f = FL1.funext H (\ h -> Tor) f f (\ h -> tloop (f h) a) ;

  Bnd-lsec (f : FT) (a : A) : Id A (Bnd f (lsec f a)) a =
    transH (cinv-ext (\ h -> tb (f h) (hap f f (lsec f a) h)) (\ h -> a)
              (\ h -> transH (P1.ap (Id Tor (f h) (f h)) A (tb (f h)) (hap f f (lsec f a) h) (tloop (f h) a)
                                (P1.happly H (\ k -> Id Tor (f k) (f k)) (hap f f (lsec f a)) (\ k -> tloop (f k) a)
                                   (FL1.happly-funext H (\ k -> Tor) f f (\ k -> tloop (f k) a)) h))
                             (tb-be (f h) a).1.2))
           (cinv-const a) ;

  lret (f : FT) (L : Id FT f f) : Id (Id FT f f) L (lsec f (Bnd f L)) =
    P1.trans (Id FT f f) L (FL1.funext H (\ h -> Tor) f f (hap f f L)) (lsec f (Bnd f L))
      (P1.sym (Id FT f f) (FL1.funext H (\ h -> Tor) f f (hap f f L)) L (FL1.funext-happly H (\ h -> Tor) f f L))
      (P1.ap ((h : H) -> Id Tor (f h) (f h)) (Id FT f f) (FL1.funext H (\ h -> Tor) f f)
         (hap f f L) (\ h -> tloop (f h) (Bnd f L))
         (FL1.funext H (\ h -> Id Tor (f h) (f h)) (hap f f L) (\ h -> tloop (f h) (Bnd f L)) (\ h ->
            tb-inj (f h) (Bnd f L) (hap f f L h) (tloop (f h) (Bnd f L))
              (symH (cinv-pt (\ k -> tb (f k) (hap f f L k)) h))
              (tb-be (f h) (Bnd f L)).1.2))) ;

  ksec (x : G) (a : A) : Id G x x = (emb x x).sec (lsec (incl x) a) ;
  ksec-kb (x : G) (a : A) : Id A (kb x (ksec x a)) a =
    transH (P1.ap (Id FT (incl x) (incl x)) A (Bnd (incl x))
               (P1.ap G FT incl x x (ksec x a)) (lsec (incl x) a) ((emb x x).sec-eq (lsec (incl x) a)))
           (Bnd-lsec (incl x) a) ;
  kret (x : G) (lp : Id G x x) : Id (Id G x x) lp (ksec x (kb x lp)) =
    transH (symH (P1.sec-ret (Id G x x) (Id FT (incl x) (incl x)) (P1.ap G FT incl x x) (emb x x) lp))
           (P1.ap (Id FT (incl x) (incl x)) (Id G x x) (emb x x).sec
              (P1.ap G FT incl x x lp) (lsec (incl x) (kb x lp)) (lret (incl x) (P1.ap G FT incl x x lp))) ;

  kb-be (x : G) (a : A) : isContr ((lp : Id G x x) * Id A (kb x lp) a) =
    ((ksec x a, ksec-kb x a),
     \ z -> Sigma-eq (Id G x x) (\ lp -> Id A (kb x lp) a) (ksec x a) z.1 (ksec-kb x a) z.2
              (transH (ap A (Id G x x) (ksec x) a (kb x z.1) (symH z.2)) (symH (kret x z.1)))
              (setA (kb x z.1) a)) ;

  ----------------------------------------------------------------------
  -- G is an A-gerbe

  ft-set (f f' : FT) : P1.isSet (Id FT f f') =
    G1.set-retract (Id FT f f') ((h : H) -> Id Tor (f h) (f' h)) (hap f f') (FL1.funext H (\ h -> Tor) f f')
      (FL1.funext-happly H (\ h -> Tor) f f')
      (FL1.isSet-Pi H (\ h -> Id Tor (f h) (f' h)) (\ h -> tor-gpd (f h) (f' h))) ;

  g-gpd (x y : G) : isSet (Id G x y) =
    G1.set-retract (Id G x y) (Id FT (incl x) (incl y)) (P1.ap G FT incl x y) (emb x y).ret (emb x y).ret-eq
      (ft-set (incl x) (incl y)) ;

  g-inh : Tr.Trunc[G].carrier =
    Tr.Trunc[H].induction @l (\ v -> Tr.Trunc[G].carrier) (\ v -> Tr.Trunc[G].proposition)
      (\ h0 -> Tr.Trunc[G].inc (mu h0)) inh-H ;

  g-conn (x y : G) : Tr.Trunc[Id G x y].carrier =
    ind (\ x' -> Tr.Trunc[Id G x' y].carrier) (\ x' -> Tr.Trunc[Id G x' y].proposition)
      (\ g -> ind (\ y' -> Tr.Trunc[Id G (mu g) y'].carrier) (\ y' -> Tr.Trunc[Id G (mu g) y'].proposition)
                (\ g' -> Tr.Trunc[Id H g g'].induction @l (\ v -> Tr.Trunc[Id G (mu g) (mu g')].carrier)
                           (\ v -> Tr.Trunc[Id G (mu g) (mu g')].proposition)
                           (\ e -> Tr.Trunc[Id G (mu g) (mu g')].inc (ap H G mu g g' e)) (conn-H g g'))
                y)
      x ;

  SG : AGerbe = (G, g-gpd, g-inh, g-conn, \ x -> (kb x, kb-be x, kb-hom x)) ;

  ----------------------------------------------------------------------
  -- the band effect of mu:  beta (mu (l1, l2)) = beta l1 + beta l2

  tri (g : H) : Id FT (incl (mu g)) (F g) = img.triangle g ;
  apF (g g' : H) (L : Id H g g') : Id FT (F g) (F g') = P1.ap H FT F g g' L ;
  apmu (g g' : H) (L : Id H g g') : Id FT (incl (mu g)) (incl (mu g')) = P1.ap G FT incl (mu g) (mu g') (ap H G mu g g' L) ;

  nat (g : H) : (g' : H) (L : Id H g g')
    -> Id (Id FT (incl (mu g)) (F g')) (P1.trans FT (incl (mu g)) (incl (mu g')) (F g') (apmu g g' L) (tri g'))
                                      (P1.trans FT (incl (mu g)) (F g) (F g') (tri g) (apF g g' L)) =
    \ g' L -> idJ H g (\ g2 L2 -> Id (Id FT (incl (mu g)) (F g2))
                    (P1.trans FT (incl (mu g)) (incl (mu g2)) (F g2) (apmu g g2 L2) (tri g2))
                    (P1.trans FT (incl (mu g)) (F g) (F g2) (tri g) (apF g g2 L2)))
                (P1.trans-refl-l FT (incl (mu g)) (F g) (tri g)) g' L ;

  -- on loops, kb (mu g) (mu L) = Bnd (F g) (F L)
  kb-mu (g : H) (L : Id H g g) : Id A (kb (mu g) (ap H G mu g g L)) (Bnd (F g) (apF g g L)) =
    calc A {
      Bnd (incl (mu g)) (apmu g g L)
        =< P1.ap (Id FT (incl (mu g)) (incl (mu g))) A (Bnd (incl (mu g))) (apmu g g L)
             (P1.trans FT (incl (mu g)) (F g) (incl (mu g))
                (P1.trans FT (incl (mu g)) (F g) (F g) (tri g) (apF g g L)) (P1.sym FT (incl (mu g)) (F g) (tri g)))
             (P1.trans (Id FT (incl (mu g)) (incl (mu g))) (apmu g g L)
                (P1.trans FT (incl (mu g)) (F g) (incl (mu g))
                   (P1.trans FT (incl (mu g)) (incl (mu g)) (F g) (apmu g g L) (tri g)) (P1.sym FT (incl (mu g)) (F g) (tri g)))
                (P1.trans FT (incl (mu g)) (F g) (incl (mu g))
                   (P1.trans FT (incl (mu g)) (F g) (F g) (tri g) (apF g g L)) (P1.sym FT (incl (mu g)) (F g) (tri g)))
                (P1.sym (Id FT (incl (mu g)) (incl (mu g)))
                   (P1.trans FT (incl (mu g)) (F g) (incl (mu g))
                      (P1.trans FT (incl (mu g)) (incl (mu g)) (F g) (apmu g g L) (tri g)) (P1.sym FT (incl (mu g)) (F g) (tri g)))
                   (apmu g g L) (G1.cancel-r FT (incl (mu g)) (incl (mu g)) (F g) (apmu g g L) (tri g)))
                (P1.ap (Id FT (incl (mu g)) (F g)) (Id FT (incl (mu g)) (incl (mu g)))
                   (\ r -> P1.trans FT (incl (mu g)) (F g) (incl (mu g)) r (P1.sym FT (incl (mu g)) (F g) (tri g)))
                   (P1.trans FT (incl (mu g)) (incl (mu g)) (F g) (apmu g g L) (tri g))
                   (P1.trans FT (incl (mu g)) (F g) (F g) (tri g) (apF g g L)) (nat g g L)))
        > Bnd (incl (mu g)) (P1.trans FT (incl (mu g)) (F g) (incl (mu g))
             (P1.trans FT (incl (mu g)) (F g) (F g) (tri g) (apF g g L)) (P1.sym FT (incl (mu g)) (F g) (tri g)))
        =< P1.ap (Id FT (incl (mu g)) (F g)) A
             (\ r -> Bnd (incl (mu g)) (P1.trans FT (incl (mu g)) (F g) (incl (mu g))
                       (P1.trans FT (incl (mu g)) (F g) (F g) r (apF g g L)) (P1.sym FT (incl (mu g)) (F g) (tri g))))
             (tri g) (P1.sym FT (F g) (incl (mu g)) (P1.sym FT (incl (mu g)) (F g) (tri g)))
             (P1.sym (Id FT (incl (mu g)) (F g)) (P1.sym FT (F g) (incl (mu g)) (P1.sym FT (incl (mu g)) (F g) (tri g))) (tri g)
                (G1.sym-sym FT (incl (mu g)) (F g) (tri g)))
        > Bnd (incl (mu g)) (P1.trans FT (incl (mu g)) (F g) (incl (mu g))
             (P1.trans FT (incl (mu g)) (F g) (F g) (P1.sym FT (F g) (incl (mu g)) (P1.sym FT (incl (mu g)) (F g) (tri g)))
                (apF g g L))
             (P1.sym FT (incl (mu g)) (F g) (tri g)))
        =< G1.conj-inv FT A Bnd (F g) (apF g g L) (incl (mu g)) (P1.sym FT (incl (mu g)) (F g) (tri g))
        > Bnd (F g) (apF g g L) } ;

  -- happly of ap F is ap of the evaluation
  hap-ap (g : H) : (g' : H) (L : Id H g g') (h : H)
    -> Id (Id Tor (F g h) (F g' h)) (hap (F g) (F g') (apF g g' L) h) (P1.ap H Tor (\ k -> F k h) g g' L) =
    \ g' L -> idJ H g (\ g2 L2 -> (h : H) -> Id (Id Tor (F g h) (F g2 h)) (hap (F g) (F g2) (apF g g2 L2) h)
                                                                     (P1.ap H Tor (\ k -> F k h) g g2 L2))
                (\ h -> refl (refl (F g h))) g' L ;

  -- the evaluation of a pair path is the sum path
  ev-pair (h : H) (x : Ga.1) : (x' : Ga.1) (p : Id Ga.1 x x') (y y' : Gb.1) (p' : Id Gb.1 y y')
    -> Id (Id Tor (F (x, y) h) (F (x', y') h)) (P1.ap H Tor (\ k -> F k h) (x, y) (x', y') (pairp x x' y y' p p'))
          (sump (La.PTor h.1 x) (La.PTor h.1 x') (Lb.PTor h.2 y) (Lb.PTor h.2 y')
             (P1.ap Ga.1 Tor (La.PTor h.1) x x' p) (P1.ap Gb.1 Tor (Lb.PTor h.2) y y' p')) =
    \ x' p -> idJ Ga.1 x
      (\ x2 p2 -> (y y' : Gb.1) (p' : Id Gb.1 y y')
          -> Id (Id Tor (F (x, y) h) (F (x2, y') h)) (P1.ap H Tor (\ k -> F k h) (x, y) (x2, y') (pairp x x2 y y' p2 p'))
                (sump (La.PTor h.1 x) (La.PTor h.1 x2) (Lb.PTor h.2 y) (Lb.PTor h.2 y')
                   (P1.ap Ga.1 Tor (La.PTor h.1) x x2 p2) (P1.ap Gb.1 Tor (Lb.PTor h.2) y y' p')))
      (\ y y' p' -> idJ Gb.1 y
          (\ y2 p3 -> Id (Id Tor (F (x, y) h) (F (x, y2) h)) (P1.ap H Tor (\ k -> F k h) (x, y) (x, y2) (pairp x x y y2 (refl x) p3))
                         (sump (La.PTor h.1 x) (La.PTor h.1 x) (Lb.PTor h.2 y) (Lb.PTor h.2 y2)
                            (refl (La.PTor h.1 x)) (P1.ap Gb.1 Tor (Lb.PTor h.2) y y2 p3)))
          (refl (refl (F (x, y) h))) y' p')
      x' p ;

  -- the torsor band of the sum path is beta l1 + beta l2
  tb-sum (h : H) (x : Ga.1) (y : Gb.1) (l1 : Id Ga.1 x x) (l2 : Id Gb.1 y y)
    : Id A (tb (F (x, y) h) (sump (La.PTor h.1 x) (La.PTor h.1 x) (Lb.PTor h.2 y) (Lb.PTor h.2 y)
                              (P1.ap Ga.1 Tor (La.PTor h.1) x x l1) (P1.ap Gb.1 Tor (Lb.PTor h.2) y y l2)))
           (add (La.bnd x l1) (Lb.bnd y l2)) =
    tb-char (F (x, y) h)
      (sump (La.PTor h.1 x) (La.PTor h.1 x) (Lb.PTor h.2 y) (Lb.PTor h.2 y)
         (P1.ap Ga.1 Tor (La.PTor h.1) x x l1) (P1.ap Gb.1 Tor (Lb.PTor h.2) y y l2))
      (add (La.bnd x l1) (Lb.bnd y l2))
      (symH (transH (sump-hom (La.PTor h.1 x) (Lb.PTor h.2 y) (La.PTor h.1 x) (P1.ap Ga.1 Tor (La.PTor h.1) x x l1)
                       (Lb.PTor h.2 y) (P1.ap Gb.1 Tor (Lb.PTor h.2) y y l2))
              (transH (ap (Hom (La.PTor h.1 x) (La.PTor h.1 x)) (Hom (F (x, y) h) (F (x, y) h))
                         (\ f -> Tensor[La.PTor h.1 x, La.PTor h.1 x, Lb.PTor h.2 y, Lb.PTor h.2 y, f,
                                        idtohom (Lb.PTor h.2 y) (Lb.PTor h.2 y) (P1.ap Gb.1 Tor (Lb.PTor h.2) y y l2)].tensor)
                         (idtohom (La.PTor h.1 x) (La.PTor h.1 x) (P1.ap Ga.1 Tor (La.PTor h.1) x x l1))
                         (transl (La.PTor h.1 x) (La.bnd x l1))
                         (symH (transH (ap A (Hom (La.PTor h.1 x) (La.PTor h.1 x)) (transl (La.PTor h.1 x))
                                           (La.bnd x l1) (tb (La.PTor h.1 x) (P1.ap Ga.1 Tor (La.PTor h.1) x x l1))
                                           (symH (PostM[Ga, h.1].tb-post x l1)))
                                       (tb-tr (La.PTor h.1 x) (P1.ap Ga.1 Tor (La.PTor h.1) x x l1)))))
                 (transH (ap (Hom (Lb.PTor h.2 y) (Lb.PTor h.2 y)) (Hom (F (x, y) h) (F (x, y) h))
                            (\ f -> Tensor[La.PTor h.1 x, La.PTor h.1 x, Lb.PTor h.2 y, Lb.PTor h.2 y,
                                           transl (La.PTor h.1 x) (La.bnd x l1), f].tensor)
                            (idtohom (Lb.PTor h.2 y) (Lb.PTor h.2 y) (P1.ap Gb.1 Tor (Lb.PTor h.2) y y l2))
                            (transl (Lb.PTor h.2 y) (Lb.bnd y l2))
                            (symH (transH (ap A (Hom (Lb.PTor h.2 y) (Lb.PTor h.2 y)) (transl (Lb.PTor h.2 y))
                                              (Lb.bnd y l2) (tb (Lb.PTor h.2 y) (P1.ap Gb.1 Tor (Lb.PTor h.2) y y l2))
                                              (symH (PostM[Gb, h.2].tb-post y l2)))
                                          (tb-tr (Lb.PTor h.2 y) (P1.ap Gb.1 Tor (Lb.PTor h.2) y y l2)))))
                         (tensor-transl (La.PTor h.1 x) (Lb.PTor h.2 y) (La.bnd x l1) (Lb.bnd y l2)))))) ;

  -- the decisive lemma
  mu-band (x : Ga.1) (y : Gb.1) (l1 : Id Ga.1 x x) (l2 : Id Gb.1 y y)
    : Id A (kb (mu (x, y)) (ap H G mu (x, y) (x, y) (pairp x x y y l1 l2))) (add (La.bnd x l1) (Lb.bnd y l2)) =
    transH (kb-mu (x, y) (pairp x x y y l1 l2))
      (transH (cinv-ext (\ h -> tb (F (x, y) h) (hap (F (x, y)) (F (x, y)) (apF (x, y) (x, y) (pairp x x y y l1 l2)) h))
                 (\ h -> add (La.bnd x l1) (Lb.bnd y l2))
                 (\ h -> transH (P1.ap (Id Tor (F (x, y) h) (F (x, y) h)) A (tb (F (x, y) h))
                                   (hap (F (x, y)) (F (x, y)) (apF (x, y) (x, y) (pairp x x y y l1 l2)) h)
                                   (sump (La.PTor h.1 x) (La.PTor h.1 x) (Lb.PTor h.2 y) (Lb.PTor h.2 y)
                                      (P1.ap Ga.1 Tor (La.PTor h.1) x x l1) (P1.ap Gb.1 Tor (Lb.PTor h.2) y y l2))
                                   (P1.trans (Id Tor (F (x, y) h) (F (x, y) h))
                                      (hap (F (x, y)) (F (x, y)) (apF (x, y) (x, y) (pairp x x y y l1 l2)) h)
                                      (P1.ap H Tor (\ k -> F k h) (x, y) (x, y) (pairp x x y y l1 l2))
                                      (sump (La.PTor h.1 x) (La.PTor h.1 x) (Lb.PTor h.2 y) (Lb.PTor h.2 y)
                                         (P1.ap Ga.1 Tor (La.PTor h.1) x x l1) (P1.ap Gb.1 Tor (Lb.PTor h.2) y y l2))
                                      (hap-ap (x, y) (x, y) (pairp x x y y l1 l2) h)
                                      (ev-pair h x x l1 y y l2)))
                                (tb-sum h x y l1 l2)))
              (cinv-const (add (La.bnd x l1) (Lb.bnd y l2)))) ;
} ;
