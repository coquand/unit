-- TorsorId.seg: identity types of A-torsors.  For torsors X, Y:
--   (X = Y)  ~  Hom X Y   (equivariant maps; idtohom-equiv)
--   A  ~  Hom X X         (translations; aut-equiv)
-- so the type of A-torsors is a delooping of A.  First step towards SAG
-- Theorem 7.4.7 (gerbes).  Proof: an equivariant map of torsors is a
-- bijection (HE); hence  (Y : Tor) * Hom X Y  is contractible, by
-- induction on equivalences (contr); hence idtohom is an equivalence, by
-- encode-decode from the centre (X, id).

level l ;
open Base ;
open Prelude[l] ;
open Paths[l] ;
open FunExtUA[l] ;
open Torsor[l] ;
module Tr = Truncation[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module P1 = Prelude[l+] ;
module E1 = FunExtUA[l+] ;

module TorId (G : Ab) {
  open G ;
  open AbL[G] ;
  open TorBase[G] ;

  Tor : U l+ = (T : U l) * TorStr T ;

  EqvH (X Y : Tor) (f : X.1 -> Y.1) : U l =
    (a : A) (t : X.1) -> Id Y.1 (f (X.2.1 a t)) (Y.2.1 a (f t)) ;
  Hom (X Y : Tor) : U l = (f : X.1 -> Y.1) * EqvH X Y f ;

  idhom (X : Tor) : Hom X X = (\ t -> t, \ a t -> refl (X.2.1 a t)) ;
  idtohom (X Y : Tor) (p : Id Tor X Y) : Hom X Y = idJ Tor X (\ Z q -> Hom X Z) (idhom X) Y p ;

  eqvh-prop (X Y : Tor) (f : X.1 -> Y.1) : isProp (EqvH X Y f) =
    FL.isProp-Pi A (\ a -> (t : X.1) -> Id Y.1 (f (X.2.1 a t)) (Y.2.1 a (f t))) (\ a ->
    FL.isProp-Pi X.1 (\ t -> Id Y.1 (f (X.2.1 a t)) (Y.2.1 a (f t))) (\ t ->
      Y.2.2.1 (f (X.2.1 a t)) (Y.2.1 a (f t)))) ;

  hom-eq (X Y : Tor) (f g : Hom X Y) (h : (t : X.1) -> Id Y.1 (f.1 t) (g.1 t)) : Id (Hom X Y) f g =
    Sigma-eq (X.1 -> Y.1) (EqvH X Y) f.1 g.1 f.2 g.2
      (FL.funext X.1 (\ t -> Y.1) f.1 g.1 h) (eqvh-prop X Y g.1) ;

  hom-set (X Y : Tor) : isSet (Hom X Y) =
    isSet-sub (X.1 -> Y.1) (EqvH X Y) (FL.isSet-Pi X.1 (\ t -> Y.1) (\ t -> Y.2.2.1)) (eqvh-prop X Y) ;

  ----------------------------------------------------------------------
  -- an equivariant map of torsors is a bijection

  module HE (X Y : Tor) (f : Hom X Y) {
    module DX = D[X.1, X.2] ;
    module DY = D[Y.1, Y.2] ;
    Fib (y : Y.1) : U l = (t : X.1) * Id Y.1 (f.1 t) y ;

    -- given t0, the preimage of y is (y - f t0) . t0
    cen (t0 : X.1) (y : Y.1) : Fib y =
      (X.2.1 (DY.diff (f.1 t0) y) t0,
       transH (f.2 (DY.diff (f.1 t0) y) t0) (DY.dact (f.1 t0) y)) ;

    same (t0 : X.1) (y : Y.1) (z : Fib y) : Id A (DY.diff (f.1 t0) y) (DX.diff t0 z.1) =
      DY.uniq (f.1 t0) y (DX.diff t0 z.1) (calc Y.1 {
        Y.2.1 (DX.diff t0 z.1) (f.1 t0)
          =< symH (f.2 (DX.diff t0 z.1) t0) > f.1 (X.2.1 (DX.diff t0 z.1) t0)
          =< ap X.1 Y.1 f.1 (X.2.1 (DX.diff t0 z.1) t0) z.1 (DX.dact t0 z.1) > f.1 z.1
          =< z.2 > y }) ;

    fibk (t0 : X.1) (y : Y.1) : isContr (Fib y) =
      (cen t0 y,
       \ z -> Sigma-eq X.1 (\ t -> Id Y.1 (f.1 t) y) (cen t0 y).1 z.1 (cen t0 y).2 z.2
                (transH (ap A X.1 (\ b -> X.2.1 b t0) (DY.diff (f.1 t0) y) (DX.diff t0 z.1) (same t0 y z))
                        (DX.dact t0 z.1))
                (Y.2.2.1 (f.1 z.1) y)) ;

    fib (y : Y.1) : isContr (Fib y) =
      Tr.Trunc[X.1].induction @l (\ x -> isContr (Fib y)) (\ x -> isProp-isContr (Fib y))
        (\ t0 -> fibk t0 y) X.2.2.2.2.2.2 ;

    equiv : Equiv X.1 Y.1 =
      (f.1, qinv X.1 Y.1 f.1 (\ y -> (fib y).1.1) (\ y -> (fib y).1.2)
              (\ t -> ap (Fib (f.1 t)) X.1 (\ z -> z.1) (fib (f.1 t)).1 (t, refl (f.1 t))
                        ((fib (f.1 t)).2 (t, refl (f.1 t))))) ;
  } ;

  ----------------------------------------------------------------------
  -- (Y : Tor) * Hom X Y is contractible

  TH (X : Tor) : U l+ = (Y : Tor) * Hom X Y ;

  base-path (X : Tor) (s2 : TorStr X.1) (p : Id (TorStr X.1) X.2 s2)
    : (h : EqvH X (X.1, s2) (\ t -> t)) -> Id (TH X) (X, idhom X) ((X.1, s2), (\ t -> t, h)) =
    idJ (TorStr X.1) X.2
      (\ s3 q -> (h : EqvH X (X.1, s3) (\ t -> t)) -> Id (TH X) (X, idhom X) ((X.1, s3), (\ t -> t, h)))
      (\ h -> P1.ap (EqvH X X (\ t -> t)) (TH X) (\ h' -> (X, (\ t -> t, h'))) (idhom X).2 h
                (eqvh-prop X X (\ t -> t) (idhom X).2 h))
      s2 p ;

  Mot (X : Tor) (T' : U l) (e : Equiv X.1 T') : U l+ =
    (s' : TorStr T') -> (h : EqvH X (T', s') e.1) -> Id (TH X) (X, idhom X) ((T', s'), (e.1, h)) ;

  mot-base (X : Tor) : Mot X X.1 (idEquiv X.1) = \ s' h ->
    base-path X s'
      (Sigma-eq (A -> X.1 -> X.1) (Laws X.1) X.2.1 s'.1 X.2.2 s'.2
        (FL.funext A (\ a -> X.1 -> X.1) X.2.1 s'.1 (\ a ->
           FL.funext X.1 (\ t -> X.1) (X.2.1 a) (s'.1 a) (\ t -> h a t)))
        (laws-prop X.1 s'.1))
      h ;

  contr (X : Tor) : E1.isContr (TH X) =
    ((X, idhom X), \ w -> eqind X.1 (Mot X) (mot-base X) w.1.1 HE[X, w.1, w.2].equiv w.1.2 w.2.2) ;

  ----------------------------------------------------------------------
  -- encode-decode: (X = Y) ~ Hom X Y

  decode (X Y : Tor) (f : Hom X Y) : Id Tor X Y =
    P1.ap (TH X) Tor (\ w -> w.1) (X, idhom X) (Y, f) (E1.pathC (TH X) (contr X) (X, idhom X) (Y, f)) ;

  enc-dec (X : Tor) (w : TH X) (Q : Id (TH X) (X, idhom X) w)
    : Id (Hom X w.1) (idtohom X w.1 (P1.ap (TH X) Tor (\ v -> v.1) (X, idhom X) w Q)) w.2 =
    idJ (TH X) (X, idhom X)
      (\ v Q' -> Id (Hom X v.1) (idtohom X v.1 (P1.ap (TH X) Tor (\ v' -> v'.1) (X, idhom X) v Q')) v.2)
      (refl (idhom X)) w Q ;

  dec-refl (X : Tor) : Id (Id Tor X X) (decode X X (idhom X)) (refl X) =
    P1.ap (Id (TH X) (X, idhom X) (X, idhom X)) (Id Tor X X)
      (\ q -> P1.ap (TH X) Tor (\ w -> w.1) (X, idhom X) (X, idhom X) q)
      (E1.pathC (TH X) (contr X) (X, idhom X) (X, idhom X)) (refl (X, idhom X))
      (E1.pathC-refl (TH X) (contr X) (X, idhom X)) ;

  dec-enc (X Y : Tor) (p : Id Tor X Y) : Id (Id Tor X Y) (decode X Y (idtohom X Y p)) p =
    idJ Tor X (\ Z q -> Id (Id Tor X Z) (decode X Z (idtohom X Z q)) q) (dec-refl X) Y p ;

  idtohom-equiv (X Y : Tor) : P1.isEquiv (Id Tor X Y) (Hom X Y) (idtohom X Y) =
    P1.qinv (Id Tor X Y) (Hom X Y) (idtohom X Y) (decode X Y)
      (\ f -> enc-dec X (Y, f) (E1.pathC (TH X) (contr X) (X, idhom X) (Y, f)))
      (dec-enc X Y) ;

  ----------------------------------------------------------------------
  -- automorphisms are translations:  A ~ Hom X X

  transl (X : Tor) (a : A) : Hom X X =
    (\ t -> X.2.1 a t,
     \ b t -> calc X.1 {
       X.2.1 a (X.2.1 b t) =< symH (X.2.2.2.1 a b t) > X.2.1 (add a b) t
         =< ap A X.1 (\ c -> X.2.1 c t) (add a b) (add b a) (comm a b) > X.2.1 (add b a) t
         =< X.2.2.2.1 b a t > X.2.1 b (X.2.1 a t) }) ;

  module AutM (X : Tor) {
    module DX = D[X.1, X.2] ;
    Fa (f : Hom X X) : U l = (a : A) * Id (Hom X X) (transl X a) f ;

    -- given t0, f is the translation by  f t0 - t0
    agree (t0 : X.1) (f : Hom X X) (t : X.1)
      : Id X.1 (X.2.1 (DX.diff t0 (f.1 t0)) t) (f.1 t) = calc X.1 {
      X.2.1 (DX.diff t0 (f.1 t0)) t
        =< ap X.1 X.1 (X.2.1 (DX.diff t0 (f.1 t0))) t (X.2.1 (DX.diff t0 t) t0) (symH (DX.dact t0 t))
        > X.2.1 (DX.diff t0 (f.1 t0)) (X.2.1 (DX.diff t0 t) t0)
        =< (transl X (DX.diff t0 (f.1 t0))).2 (DX.diff t0 t) t0
        > X.2.1 (DX.diff t0 t) (X.2.1 (DX.diff t0 (f.1 t0)) t0)
        =< ap X.1 X.1 (X.2.1 (DX.diff t0 t)) (X.2.1 (DX.diff t0 (f.1 t0)) t0) (f.1 t0)
              (DX.dact t0 (f.1 t0))
        > X.2.1 (DX.diff t0 t) (f.1 t0)
        =< symH (f.2 (DX.diff t0 t) t0) > f.1 (X.2.1 (DX.diff t0 t) t0)
        =< ap X.1 X.1 f.1 (X.2.1 (DX.diff t0 t) t0) t (DX.dact t0 t) > f.1 t } ;

    fak (t0 : X.1) (f : Hom X X) : isContr (Fa f) =
      ((DX.diff t0 (f.1 t0), hom-eq X X (transl X (DX.diff t0 (f.1 t0))) f (agree t0 f)),
       \ z -> Sigma-eq A (\ a -> Id (Hom X X) (transl X a) f) (DX.diff t0 (f.1 t0)) z.1
                (hom-eq X X (transl X (DX.diff t0 (f.1 t0))) f (agree t0 f)) z.2
                (DX.uniq t0 (f.1 t0) z.1
                   (happly X.1 (\ t -> X.1) (transl X z.1).1 f.1
                      (ap (Hom X X) (X.1 -> X.1) (\ g -> g.1) (transl X z.1) f z.2) t0))
                (hom-set X X (transl X z.1) f)) ;

    fa (f : Hom X X) : isContr (Fa f) =
      Tr.Trunc[X.1].induction @l (\ x -> isContr (Fa f)) (\ x -> isProp-isContr (Fa f))
        (\ t0 -> fak t0 f) X.2.2.2.2.2.2 ;

    aut-equiv : Equiv A (Hom X X) =
      (transl X, qinv A (Hom X X) (transl X) (\ f -> (fa f).1.1) (\ f -> (fa f).1.2)
         (\ a -> ap (Fa (transl X a)) A (\ z -> z.1) (fa (transl X a)).1 (a, refl (transl X a))
                   ((fa (transl X a)).2 (a, refl (transl X a))))) ;
  } ;
} ;
