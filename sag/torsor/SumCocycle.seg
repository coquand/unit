-- SumCocycle.seg: the cocycle of the sum of two gerbes with points and
-- paths is the sum of the cocycles.  For (Ga, u, p) and (Gb, u', p') with
-- cocycles c and d, the sum gerbe GSum[Ga, Gb].SG with points
-- mu (u i, u' i) and paths mu (pair (p i j, p' i j)) has cocycle c + d:
-- mu and pairing preserve composition and inverses, so its loop is
-- mu (pair (l i j k, l' i j k)), and mu-band applies.

level l ;
open Base ;
open Prelude[l] ;
open Paths[l] ;
open Torsor[l] ;
open Groupoid[l] ;
open Gerbe[l] ;
open Cocycle2[l] ;
open GerbeSum[l] ;

ap-sym (X Y : U l) (f : X -> Y) (x y : X) (p : Id X x y)
  : Id (Id Y (f y) (f x)) (ap X Y f y x (sym X x y p)) (sym Y (f x) (f y) (ap X Y f x y p)) =
  idJ X x (\ y' p' -> Id (Id Y (f y') (f x)) (ap X Y f y' x (sym X x y' p')) (sym Y (f x) (f y') (ap X Y f x y' p')))
    (refl (refl (f x))) y p ;

module SumCoc (Gr : Ab) (L : U l) (w1 w2 : Coc2[Gr,L].Left2) {
  open Gr ;
  open Gerbes[Gr] ;
  open Coc2[Gr,L] ;
  module S = GSum[Gr, w1.1, w2.1] ;
  module L1 = GL[w1.1] ;
  module L2 = GL[w2.1] ;
  X1 : U l = w1.1.1 ;
  X2 : U l = w2.1.1 ;
  H : U l = S.H ;
  G : U l = S.G ;

  -- pairing preserves composition and inverses
  pp (x x' : X1) (y y' : X2) (p : Id X1 x x') (p' : Id X2 y y') : Id H (x, y) (x', y') = S.pairp x x' y y' p p' ;

  pp-trans (x x' : X1) (y y' : X2) (p : Id X1 x x') (p' : Id X2 y y')
    : (x'' : X1) (q : Id X1 x' x'') (y'' : X2) (q' : Id X2 y' y'')
    -> Id (Id H (x, y) (x'', y'')) (trans H (x, y) (x', y') (x'', y'') (pp x x' y y' p p') (pp x' x'' y' y'' q q'))
                                   (pp x x'' y y'' (trans X1 x x' x'' p q) (trans X2 y y' y'' p' q')) =
    \ x'' q -> idJ X1 x'
      (\ x3 q3 -> (y'' : X2) (q' : Id X2 y' y'')
          -> Id (Id H (x, y) (x3, y'')) (trans H (x, y) (x', y') (x3, y'') (pp x x' y y' p p') (pp x' x3 y' y'' q3 q'))
                                        (pp x x3 y y'' (trans X1 x x' x3 p q3) (trans X2 y y' y'' p' q')))
      (\ y'' q' -> idJ X2 y'
          (\ y3 q4 -> Id (Id H (x, y) (x', y3)) (trans H (x, y) (x', y') (x', y3) (pp x x' y y' p p') (pp x' x' y' y3 (refl x') q4))
                                                (pp x x' y y3 (trans X1 x x' x' p (refl x')) (trans X2 y y' y3 p' q4)))
          (refl (pp x x' y y' p p')) y'' q')
      x'' q ;

  pp-sym (x : X1) (y : X2) : (x' : X1) (p : Id X1 x x') (y' : X2) (p' : Id X2 y y')
    -> Id (Id H (x', y') (x, y)) (sym H (x, y) (x', y') (pp x x' y y' p p'))
                                 (pp x' x y' y (sym X1 x x' p) (sym X2 y y' p')) =
    \ x' p -> idJ X1 x
      (\ x2 p2 -> (y' : X2) (p' : Id X2 y y')
          -> Id (Id H (x2, y') (x, y)) (sym H (x, y) (x2, y') (pp x x2 y y' p2 p'))
                                       (pp x2 x y' y (sym X1 x x2 p2) (sym X2 y y' p')))
      (\ y' p' -> idJ X2 y
          (\ y2 p3 -> Id (Id H (x, y2) (x, y)) (sym H (x, y) (x, y2) (pp x x y y2 (refl x) p3))
                                               (pp x x y2 y (refl x) (sym X2 y y2 p3)))
          (refl (refl (x, y))) y' p')
      x' p ;

  -- the sum system
  u (i : L) : H = (w1.2.1 i, w2.2.1 i) ;
  ps (i j : L) : Id H (u i) (u j) = pp (w1.2.1 i) (w1.2.1 j) (w2.2.1 i) (w2.2.1 j) (w1.2.2 i j) (w2.2.2 i j) ;
  ws : Left2 = (S.SG, \ i -> S.mu (u i), \ i j -> ap H G S.mu (u i) (u j) (ps i j)) ;

  -- its loop is mu of the pair of loops
  lp1 (i j k : L) : Id X1 (w1.2.1 i) (w1.2.1 i) = PhiG[w1].lp i j k ;
  lp2 (i j k : L) : Id X2 (w2.2.1 i) (w2.2.1 i) = PhiG[w2].lp i j k ;

  loop-eq (i j k : L)
    : Id (Id G (S.mu (u i)) (S.mu (u i))) (PhiG[ws].lp i j k)
         (ap H G S.mu (u i) (u i) (pp (w1.2.1 i) (w1.2.1 i) (w2.2.1 i) (w2.2.1 i) (lp1 i j k) (lp2 i j k))) =
    calc (Id G (S.mu (u i)) (S.mu (u i))) {
      trans G (S.mu (u i)) (S.mu (u k)) (S.mu (u i))
        (trans G (S.mu (u i)) (S.mu (u j)) (S.mu (u k)) (ap H G S.mu (u i) (u j) (ps i j)) (ap H G S.mu (u j) (u k) (ps j k)))
        (sym G (S.mu (u i)) (S.mu (u k)) (ap H G S.mu (u i) (u k) (ps i k)))
        =< ap (Id G (S.mu (u i)) (S.mu (u k))) (Id G (S.mu (u i)) (S.mu (u i)))
             (\ r -> trans G (S.mu (u i)) (S.mu (u k)) (S.mu (u i)) r (sym G (S.mu (u i)) (S.mu (u k)) (ap H G S.mu (u i) (u k) (ps i k))))
             (trans G (S.mu (u i)) (S.mu (u j)) (S.mu (u k)) (ap H G S.mu (u i) (u j) (ps i j)) (ap H G S.mu (u j) (u k) (ps j k)))
             (ap H G S.mu (u i) (u k) (trans H (u i) (u j) (u k) (ps i j) (ps j k)))
             (symH (ap-trans H G S.mu (u i) (u j) (u k) (ps i j) (ps j k)))
        > trans G (S.mu (u i)) (S.mu (u k)) (S.mu (u i))
            (ap H G S.mu (u i) (u k) (trans H (u i) (u j) (u k) (ps i j) (ps j k)))
            (sym G (S.mu (u i)) (S.mu (u k)) (ap H G S.mu (u i) (u k) (ps i k)))
        =< ap (Id G (S.mu (u k)) (S.mu (u i))) (Id G (S.mu (u i)) (S.mu (u i)))
             (trans G (S.mu (u i)) (S.mu (u k)) (S.mu (u i)) (ap H G S.mu (u i) (u k) (trans H (u i) (u j) (u k) (ps i j) (ps j k))))
             (sym G (S.mu (u i)) (S.mu (u k)) (ap H G S.mu (u i) (u k) (ps i k)))
             (ap H G S.mu (u k) (u i) (sym H (u i) (u k) (ps i k)))
             (symH (ap-sym H G S.mu (u i) (u k) (ps i k)))
        > trans G (S.mu (u i)) (S.mu (u k)) (S.mu (u i))
            (ap H G S.mu (u i) (u k) (trans H (u i) (u j) (u k) (ps i j) (ps j k)))
            (ap H G S.mu (u k) (u i) (sym H (u i) (u k) (ps i k)))
        =< symH (ap-trans H G S.mu (u i) (u k) (u i) (trans H (u i) (u j) (u k) (ps i j) (ps j k)) (sym H (u i) (u k) (ps i k)))
        > ap H G S.mu (u i) (u i) (trans H (u i) (u k) (u i) (trans H (u i) (u j) (u k) (ps i j) (ps j k)) (sym H (u i) (u k) (ps i k)))
        =< ap (Id H (u i) (u i)) (Id G (S.mu (u i)) (S.mu (u i))) (ap H G S.mu (u i) (u i))
             (trans H (u i) (u k) (u i) (trans H (u i) (u j) (u k) (ps i j) (ps j k)) (sym H (u i) (u k) (ps i k)))
             (pp (w1.2.1 i) (w1.2.1 i) (w2.2.1 i) (w2.2.1 i) (lp1 i j k) (lp2 i j k))
             (transH (ap (Id H (u i) (u k)) (Id H (u i) (u i))
                        (\ r -> trans H (u i) (u k) (u i) r (sym H (u i) (u k) (ps i k)))
                        (trans H (u i) (u j) (u k) (ps i j) (ps j k))
                        (pp (w1.2.1 i) (w1.2.1 k) (w2.2.1 i) (w2.2.1 k)
                           (trans X1 (w1.2.1 i) (w1.2.1 j) (w1.2.1 k) (w1.2.2 i j) (w1.2.2 j k))
                           (trans X2 (w2.2.1 i) (w2.2.1 j) (w2.2.1 k) (w2.2.2 i j) (w2.2.2 j k)))
                        (pp-trans (w1.2.1 i) (w1.2.1 j) (w2.2.1 i) (w2.2.1 j) (w1.2.2 i j) (w2.2.2 i j)
                           (w1.2.1 k) (w1.2.2 j k) (w2.2.1 k) (w2.2.2 j k)))
               (transH (ap (Id H (u k) (u i)) (Id H (u i) (u i))
                          (trans H (u i) (u k) (u i)
                             (pp (w1.2.1 i) (w1.2.1 k) (w2.2.1 i) (w2.2.1 k)
                                (trans X1 (w1.2.1 i) (w1.2.1 j) (w1.2.1 k) (w1.2.2 i j) (w1.2.2 j k))
                                (trans X2 (w2.2.1 i) (w2.2.1 j) (w2.2.1 k) (w2.2.2 i j) (w2.2.2 j k))))
                          (sym H (u i) (u k) (ps i k))
                          (pp (w1.2.1 k) (w1.2.1 i) (w2.2.1 k) (w2.2.1 i)
                             (sym X1 (w1.2.1 i) (w1.2.1 k) (w1.2.2 i k)) (sym X2 (w2.2.1 i) (w2.2.1 k) (w2.2.2 i k)))
                          (pp-sym (w1.2.1 i) (w2.2.1 i) (w1.2.1 k) (w1.2.2 i k) (w2.2.1 k) (w2.2.2 i k)))
                       (pp-trans (w1.2.1 i) (w1.2.1 k) (w2.2.1 i) (w2.2.1 k)
                          (trans X1 (w1.2.1 i) (w1.2.1 j) (w1.2.1 k) (w1.2.2 i j) (w1.2.2 j k))
                          (trans X2 (w2.2.1 i) (w2.2.1 j) (w2.2.1 k) (w2.2.2 i j) (w2.2.2 j k))
                          (w1.2.1 i) (sym X1 (w1.2.1 i) (w1.2.1 k) (w1.2.2 i k))
                          (w2.2.1 i) (sym X2 (w2.2.1 i) (w2.2.1 k) (w2.2.2 i k)))))
        > ap H G S.mu (u i) (u i) (pp (w1.2.1 i) (w1.2.1 i) (w2.2.1 i) (w2.2.1 i) (lp1 i j k) (lp2 i j k)) } ;

  -- the cocycle of the sum is the sum of the cocycles
  cocycle-sum (i j k : L) : Id A ((phi2 ws).1 i j k) (add ((phi2 w1).1 i j k) ((phi2 w2).1 i j k)) =
    transH (ap (Id G (S.mu (u i)) (S.mu (u i))) A (S.kb (S.mu (u i))) (PhiG[ws].lp i j k)
               (ap H G S.mu (u i) (u i) (pp (w1.2.1 i) (w1.2.1 i) (w2.2.1 i) (w2.2.1 i) (lp1 i j k) (lp2 i j k)))
               (loop-eq i j k))
           (S.mu-band (w1.2.1 i) (w2.2.1 i) (lp1 i j k) (lp2 i j k)) ;
} ;
