-- CechGroup.seg: SAG Theorem 7.4.8 as an isomorphism of abelian groups.
-- On Cech classes Hc: zero, negation (respecting coboundaries) and the
-- group laws, from pointwise equalities of cocycles.  On H2: addition is
-- the sum of gerbes (CechQ.addH2), zero is the class of the trivial family
-- (m-zero: the zero cocycle is realised by the trivial gerbe with constant
-- points and identity paths, so no point of L x is needed), negation is
-- transported; the laws are transferred through m (m-add, m-zero) using
-- that m is an equivalence (allM).

level l ;
open Base ;
open Prelude[l] ;
open Paths[l] ;
open Torsor[l] ;
open Gerbe[l] ;
open Cocycle2[l] ;
open Gerbe74[l] ;
open TrivialGerbe[l] ;
open Cech[l] ;
open CechQ[l] ;
module Tr = Truncation[l] ;
module Tr1 = Truncation[l+] ;
module P1 = Prelude[l+] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;

module CG (n : Nat) (X : U l) (Uc : Fin n -> X -> U l)
  (cover : (x : X) -> Tr.Trunc[(i : Fin n) * Uc i x].carrier) (F : X -> Ab)
  (h1 : (i j : Fin n) -> CechM[n, X, Uc, cover, F].H1Zero i j)
  (h2 : (i : Fin n) -> CechM[n, X, Uc, cover, F].H2Zero i) {
  open CechM[n, X, Uc, cover, F] ;
  open CechQM[n, X, Uc, cover, F, h1, h2] ;

  ----------------------------------------------------------------------
  -- cocycles: zero, negation, laws

  z2-eq (c d : Z2) (h : (x : X) (i j k : L x) -> Id (Ax x) ((c x).1 i j k) ((d x).1 i j k)) : Id Z2 c d =
    FL.funext X (\ x -> Coc2[F x, L x].Coc2) c d (\ x ->
      Sigma-eq (L x -> L x -> L x -> Ax x) (Coc2[F x, L x].CocP2) (c x).1 (d x).1 (c x).2 (d x).2
        (FL.funext (L x) (\ i -> L x -> L x -> Ax x) (c x).1 (d x).1 (\ i ->
           FL.funext (L x) (\ j -> L x -> Ax x) ((c x).1 i) ((d x).1 i) (\ j ->
             FL.funext (L x) (\ k -> Ax x) ((c x).1 i j) ((d x).1 i j) (\ k -> h x i j k))))
        (M74[F x, L x, cover x].coc2-prop (d x).1)) ;

  zeroZ : Z2 = \ x -> (\ i j k -> (F x).o, \ i j k m' -> refl ((F x).add (F x).o (F x).o)) ;

  negZ (c : Z2) : Z2 = \ x ->
    (\ i j k -> (F x).inv ((c x).1 i j k),
     \ i j k m' -> transH (symH (AbL2[F x].inv-add ((c x).1 i j k) ((c x).1 i k m')))
                     (transH (ap (Ax x) (Ax x) (F x).inv ((F x).add ((c x).1 i j k) ((c x).1 i k m'))
                                 ((F x).add ((c x).1 j k m') ((c x).1 i j m')) ((c x).2 i j k m'))
                             (AbL2[F x].inv-add ((c x).1 j k m') ((c x).1 i j m')))) ;

  assocZ (c d e : Z2) : Id Z2 (addZ (addZ c d) e) (addZ c (addZ d e)) =
    z2-eq (addZ (addZ c d) e) (addZ c (addZ d e)) (\ x i j k -> (F x).assoc ((c x).1 i j k) ((d x).1 i j k) ((e x).1 i j k)) ;
  commZ (c d : Z2) : Id Z2 (addZ c d) (addZ d c) =
    z2-eq (addZ c d) (addZ d c) (\ x i j k -> (F x).comm ((c x).1 i j k) ((d x).1 i j k)) ;
  unitZ (c : Z2) : Id Z2 (addZ c zeroZ) c =
    z2-eq (addZ c zeroZ) c (\ x i j k -> (F x).unitr ((c x).1 i j k)) ;
  invZ (c : Z2) : Id Z2 (addZ c (negZ c)) zeroZ =
    z2-eq (addZ c (negZ c)) zeroZ (\ x i j k -> (F x).invr ((c x).1 i j k)) ;

  -- negation respects coboundaries
  rel-neg (c c' : Z2) (r : Rel c c') : Rel (negZ c) (negZ c') =
    (\ x -> RelLaws[x].neg (r.1 x),
     \ x i j k -> transH (ap (Ax x) (Ax x) (F x).inv ((c' x).1 i j k) ((F x).add ((c x).1 i j k) (dlt x (r.1 x) i j k))
                            (r.2 x i j k))
                    (transH (AbL2[F x].inv-add ((c x).1 i j k) (dlt x (r.1 x) i j k))
                       (ap (Ax x) (Ax x) ((F x).add ((F x).inv ((c x).1 i j k)))
                           ((F x).inv (dlt x (r.1 x) i j k)) (dlt x (RelLaws[x].neg (r.1 x)) i j k)
                           (symH (RelLaws[x].dlt-neg (r.1 x) i j k))))) ;

  ----------------------------------------------------------------------
  -- the group Hc

  zeroHc : Hc = HcQ.inc zeroZ ;
  respNeg (c c' : Z2) (t : RelT c c') : Id Hc (HcQ.inc (negZ c)) (HcQ.inc (negZ c')) =
    HcQ.relates (negZ c) (negZ c')
      (Tr1.Trunc[Rel c c'].induction @(l+) (\ v -> RelT (negZ c) (negZ c'))
         (\ v -> Tr1.Trunc[Rel (negZ c) (negZ c')].proposition)
         (\ r -> Tr1.Trunc[Rel (negZ c) (negZ c')].inc (rel-neg c c' r)) t) ;
  negHc (q : Hc) : Hc = HcQ.Descend[Hc, HcQ.set, \ c -> HcQ.inc (negZ c), respNeg].map q ;
  negHc-inc (c : Z2) : Id Hc (negHc (HcQ.inc c)) (HcQ.inc (negZ c)) =
    HcQ.Descend[Hc, HcQ.set, \ c0 -> HcQ.inc (negZ c0), respNeg].beta c ;

  ai (c d : Z2) : Id Hc (addHc (HcQ.inc c) (HcQ.inc d)) (HcQ.inc (addZ c d)) = addHc-inc c d ;
  incZ (c d : Z2) (e : Id Z2 c d) : Id Hc (HcQ.inc c) (HcQ.inc d) = P1.ap Z2 Hc HcQ.inc c d e ;

  assocHc (q1 q2 q3 : Hc) : Id Hc (addHc (addHc q1 q2) q3) (addHc q1 (addHc q2 q3)) =
    HcQ.induction @(l+) (\ a -> Id Hc (addHc (addHc a q2) q3) (addHc a (addHc q2 q3)))
      (\ a -> HcQ.set (addHc (addHc a q2) q3) (addHc a (addHc q2 q3))) (\ c ->
    HcQ.induction @(l+) (\ b -> Id Hc (addHc (addHc (HcQ.inc c) b) q3) (addHc (HcQ.inc c) (addHc b q3)))
      (\ b -> HcQ.set (addHc (addHc (HcQ.inc c) b) q3) (addHc (HcQ.inc c) (addHc b q3))) (\ d ->
    HcQ.induction @(l+) (\ e0 -> Id Hc (addHc (addHc (HcQ.inc c) (HcQ.inc d)) e0) (addHc (HcQ.inc c) (addHc (HcQ.inc d) e0)))
      (\ e0 -> HcQ.set (addHc (addHc (HcQ.inc c) (HcQ.inc d)) e0) (addHc (HcQ.inc c) (addHc (HcQ.inc d) e0))) (\ e ->
      calc Hc {
        addHc (addHc (HcQ.inc c) (HcQ.inc d)) (HcQ.inc e)
          =< P1.ap Hc Hc (\ h -> addHc h (HcQ.inc e)) (addHc (HcQ.inc c) (HcQ.inc d)) (HcQ.inc (addZ c d)) (ai c d)
          > addHc (HcQ.inc (addZ c d)) (HcQ.inc e)
          =< ai (addZ c d) e > HcQ.inc (addZ (addZ c d) e)
          =< incZ (addZ (addZ c d) e) (addZ c (addZ d e)) (assocZ c d e) > HcQ.inc (addZ c (addZ d e))
          =< P1.sym Hc (addHc (HcQ.inc c) (HcQ.inc (addZ d e))) (HcQ.inc (addZ c (addZ d e))) (ai c (addZ d e))
          > addHc (HcQ.inc c) (HcQ.inc (addZ d e))
          =< P1.ap Hc Hc (addHc (HcQ.inc c)) (HcQ.inc (addZ d e)) (addHc (HcQ.inc d) (HcQ.inc e))
               (P1.sym Hc (addHc (HcQ.inc d) (HcQ.inc e)) (HcQ.inc (addZ d e)) (ai d e))
          > addHc (HcQ.inc c) (addHc (HcQ.inc d) (HcQ.inc e)) }) q3) q2) q1 ;

  commHc (q1 q2 : Hc) : Id Hc (addHc q1 q2) (addHc q2 q1) =
    HcQ.induction @(l+) (\ a -> Id Hc (addHc a q2) (addHc q2 a)) (\ a -> HcQ.set (addHc a q2) (addHc q2 a)) (\ c ->
    HcQ.induction @(l+) (\ b -> Id Hc (addHc (HcQ.inc c) b) (addHc b (HcQ.inc c)))
      (\ b -> HcQ.set (addHc (HcQ.inc c) b) (addHc b (HcQ.inc c))) (\ d ->
      P1.trans Hc (addHc (HcQ.inc c) (HcQ.inc d)) (HcQ.inc (addZ c d)) (addHc (HcQ.inc d) (HcQ.inc c)) (ai c d)
        (P1.trans Hc (HcQ.inc (addZ c d)) (HcQ.inc (addZ d c)) (addHc (HcQ.inc d) (HcQ.inc c))
           (incZ (addZ c d) (addZ d c) (commZ c d))
           (P1.sym Hc (addHc (HcQ.inc d) (HcQ.inc c)) (HcQ.inc (addZ d c)) (ai d c)))) q2) q1 ;

  unitHc (q : Hc) : Id Hc (addHc q zeroHc) q =
    HcQ.induction @(l+) (\ a -> Id Hc (addHc a zeroHc) a) (\ a -> HcQ.set (addHc a zeroHc) a) (\ c ->
      P1.trans Hc (addHc (HcQ.inc c) zeroHc) (HcQ.inc (addZ c zeroZ)) (HcQ.inc c) (ai c zeroZ)
        (incZ (addZ c zeroZ) c (unitZ c))) q ;

  invHc (q : Hc) : Id Hc (addHc q (negHc q)) zeroHc =
    HcQ.induction @(l+) (\ a -> Id Hc (addHc a (negHc a)) zeroHc) (\ a -> HcQ.set (addHc a (negHc a)) zeroHc) (\ c ->
      P1.trans Hc (addHc (HcQ.inc c) (negHc (HcQ.inc c))) (addHc (HcQ.inc c) (HcQ.inc (negZ c))) zeroHc
        (P1.ap Hc Hc (addHc (HcQ.inc c)) (negHc (HcQ.inc c)) (HcQ.inc (negZ c)) (negHc-inc c))
        (P1.trans Hc (addHc (HcQ.inc c) (HcQ.inc (negZ c))) (HcQ.inc (addZ c (negZ c))) zeroHc (ai c (negZ c))
           (incZ (addZ c (negZ c)) zeroZ (invZ c)))) q ;

  ----------------------------------------------------------------------
  -- the zero of H2 is the class of the trivial family

  trivF : GF = \ x -> TrivG[F x].KG ;
  zeroH2 : H2 = H2Q.inc trivF ;

  module ZeroPt (x : X) {
    module E = M74[F x, L x, cover x] ;
    module KX = TrivG[F x] ;
    sys0 : Coc2[F x, L x].Left2 = (KX.KG, \ i -> KX.k0, \ i j -> refl KX.k0) ;
    phi0 : Id (Coc2[F x, L x].Coc2) (Coc2[F x, L x].phi2 sys0) (zeroZ x) =
      Sigma-eq (L x -> L x -> L x -> Ax x) (Coc2[F x, L x].CocP2)
        (Coc2[F x, L x].phi2 sys0).1 (zeroZ x).1 (Coc2[F x, L x].phi2 sys0).2 (zeroZ x).2
        (FL.funext (L x) (\ i -> L x -> L x -> Ax x) (Coc2[F x, L x].phi2 sys0).1 (zeroZ x).1 (\ i ->
           FL.funext (L x) (\ j -> L x -> Ax x) ((Coc2[F x, L x].phi2 sys0).1 i) ((zeroZ x).1 i) (\ j ->
             FL.funext (L x) (\ k -> Ax x) ((Coc2[F x, L x].phi2 sys0).1 i j) ((zeroZ x).1 i j) (\ k ->
               Gerbes[F x].GL[KX.KG].bnd-refl KX.k0))))
        (E.coc2-prop (zeroZ x).1) ;
    pt : Id (Gerbes[F x].AGerbe) (Gc zeroZ x) (trivF x) =
      P1.trans (Gerbes[F x].AGerbe) (Gc zeroZ x) (inv74 x (Coc2[F x, L x].phi2 sys0)).1 (trivF x)
        (P1.ap (Coc2[F x, L x].Coc2) (Gerbes[F x].AGerbe) (\ v -> (inv74 x v).1) (zeroZ x) (Coc2[F x, L x].phi2 sys0)
           (sym (Coc2[F x, L x].Coc2) (Coc2[F x, L x].phi2 sys0) (zeroZ x) phi0))
        (P1.ap (Coc2[F x, L x].Left2) (Gerbes[F x].AGerbe) (\ v -> v.1)
           (inv74 x (Coc2[F x, L x].phi2 sys0)) sys0 (E.theorem-7-4-7.2.ret-eq sys0)) ;
  } ;

  Gc-zero : Id GF (Gc zeroZ) trivF =
    Axioms[l+].FunExtLemmas[fe @(l+)].funext X (\ x -> Gerbes[F x].AGerbe) (Gc zeroZ) trivF (\ x -> ZeroPt[x].pt) ;

  m-zero : Id H2 (m zeroHc) zeroH2 =
    P1.trans H2 (m zeroHc) (f zeroZ) zeroH2 (DM.beta zeroZ) (P1.ap GF H2 H2Q.inc (Gc zeroZ) trivF Gc-zero) ;

  ----------------------------------------------------------------------
  -- the laws of H2, transferred through m

  minv (h : H2) : Hc = (fib h).1.1 ;
  msec (h : H2) : Id H2 (m (minv h)) h = (fib h).1.2 ;
  mret (q : Hc) : Id Hc (minv (m q)) q =
    P1.ap (Fib (m q)) Hc (\ z -> z.1) (fib (m q)).1 (q, refl (m q)) ((fib (m q)).2 (q, refl (m q))) ;

  -- to prove a property of every h, prove it of every m q
  allM (P : H2 -> U l+) (pf : (q : Hc) -> P (m q)) (h : H2) : P h =
    P1.subst H2 P (m (minv h)) h (msec h) (pf (minv h)) ;

  negH2 (h : H2) : H2 = m (negHc (minv h)) ;

  -- m (q1 + q2) written with addH2
  ma (q1 q2 : Hc) : Id H2 (m (addHc q1 q2)) (addH2 (m q1) (m q2)) = m-add q1 q2 ;

  assocH2 (a b c : H2) : Id H2 (addH2 (addH2 a b) c) (addH2 a (addH2 b c)) =
    allM (\ a0 -> Id H2 (addH2 (addH2 a0 b) c) (addH2 a0 (addH2 b c))) (\ q1 ->
    allM (\ b0 -> Id H2 (addH2 (addH2 (m q1) b0) c) (addH2 (m q1) (addH2 b0 c))) (\ q2 ->
    allM (\ c0 -> Id H2 (addH2 (addH2 (m q1) (m q2)) c0) (addH2 (m q1) (addH2 (m q2) c0))) (\ q3 ->
      calc H2 {
        addH2 (addH2 (m q1) (m q2)) (m q3)
          =< P1.ap H2 H2 (\ h -> addH2 h (m q3)) (addH2 (m q1) (m q2)) (m (addHc q1 q2))
               (P1.sym H2 (m (addHc q1 q2)) (addH2 (m q1) (m q2)) (ma q1 q2))
          > addH2 (m (addHc q1 q2)) (m q3)
          =< P1.sym H2 (m (addHc (addHc q1 q2) q3)) (addH2 (m (addHc q1 q2)) (m q3)) (ma (addHc q1 q2) q3)
          > m (addHc (addHc q1 q2) q3)
          =< P1.ap Hc H2 m (addHc (addHc q1 q2) q3) (addHc q1 (addHc q2 q3)) (assocHc q1 q2 q3)
          > m (addHc q1 (addHc q2 q3))
          =< ma q1 (addHc q2 q3) > addH2 (m q1) (m (addHc q2 q3))
          =< P1.ap H2 H2 (addH2 (m q1)) (m (addHc q2 q3)) (addH2 (m q2) (m q3)) (ma q2 q3)
          > addH2 (m q1) (addH2 (m q2) (m q3)) }) c) b) a ;

  commH2 (a b : H2) : Id H2 (addH2 a b) (addH2 b a) =
    allM (\ a0 -> Id H2 (addH2 a0 b) (addH2 b a0)) (\ q1 ->
    allM (\ b0 -> Id H2 (addH2 (m q1) b0) (addH2 b0 (m q1))) (\ q2 ->
      P1.trans H2 (addH2 (m q1) (m q2)) (m (addHc q1 q2)) (addH2 (m q2) (m q1))
        (P1.sym H2 (m (addHc q1 q2)) (addH2 (m q1) (m q2)) (ma q1 q2))
        (P1.trans H2 (m (addHc q1 q2)) (m (addHc q2 q1)) (addH2 (m q2) (m q1))
           (P1.ap Hc H2 m (addHc q1 q2) (addHc q2 q1) (commHc q1 q2)) (ma q2 q1))) b) a ;

  unitH2 (a : H2) : Id H2 (addH2 a zeroH2) a =
    allM (\ a0 -> Id H2 (addH2 a0 zeroH2) a0) (\ q ->
      calc H2 {
        addH2 (m q) zeroH2
          =< P1.ap H2 H2 (addH2 (m q)) zeroH2 (m zeroHc) (P1.sym H2 (m zeroHc) zeroH2 m-zero)
          > addH2 (m q) (m zeroHc)
          =< P1.sym H2 (m (addHc q zeroHc)) (addH2 (m q) (m zeroHc)) (ma q zeroHc) > m (addHc q zeroHc)
          =< P1.ap Hc H2 m (addHc q zeroHc) q (unitHc q) > m q }) a ;

  invH2 (a : H2) : Id H2 (addH2 a (negH2 a)) zeroH2 =
    allM (\ a0 -> Id H2 (addH2 a0 (negH2 a0)) zeroH2) (\ q ->
      calc H2 {
        addH2 (m q) (m (negHc (minv (m q))))
          =< P1.ap Hc H2 (\ r -> addH2 (m q) (m (negHc r))) (minv (m q)) q (mret q)
          > addH2 (m q) (m (negHc q))
          =< P1.sym H2 (m (addHc q (negHc q))) (addH2 (m q) (m (negHc q))) (ma q (negHc q))
          > m (addHc q (negHc q))
          =< P1.ap Hc H2 m (addHc q (negHc q)) zeroHc (invHc q) > m zeroHc
          =< m-zero > zeroH2 }) a ;

  ----------------------------------------------------------------------
  -- SAG Theorem 7.4.8: Cech H^2 ~ H^2 as abelian groups
  iso : (e : P1.Equiv Hc H2) * (add : (q1 q2 : Hc) -> Id H2 (e.1 (addHc q1 q2)) (addH2 (e.1 q1) (e.1 q2)))
        * Id H2 (e.1 zeroHc) zeroH2 =
    (theorem-7-4-8, m-add, m-zero) ;
} ;
