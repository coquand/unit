-- CechQ.seg: SAG Theorem 7.4.8 as an equivalence of sets.
--   Hc  = Cech 2-cocycles / (merely cohomologous)       (Cech H^2)
--   H2  = || (x : X) -> F x-gerbe ||_0                  (H^2, as a quotient)
-- The map c |-> class of Gc c descends to Hc -> H2 (Thm2.well-defined) and
-- is an equivalence: injective by Thm2.injective (and effectiveness of
-- the quotients), surjective by Thm2.surjective.  Quotients are the
-- effective quotients of projective/Quotient.seg (replacement).

level l ;
open Base ;
open Prelude[l] ;
open Paths[l] ;
open FunExtUA[l] ;
open Torsor[l] ;
open Gerbe[l] ;
open Cocycle2[l] ;
open Cech[l] ;
open Gerbe74[l] ;
open GerbeSum[l] ;
open SumCocycle[l] ;
module Tr = Truncation[l] ;
module Tr1 = Truncation[l+] ;
module P1 = Prelude[l+] ;
module E1 = FunExtUA[l+] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module Q1 = Quotient[l+] ;
module FL1 = Axioms[l+].FunExtLemmas[fe @(l+)] ;

-- some abelian group algebra
module AbL2 (Gr : Ab) {
  open Gr ;
  open AbL[Gr] ;
  swap4 (p q r s : A) : Id A (add (add p q) (add r s)) (add (add p r) (add q s)) =
    calc A {
      add (add p q) (add r s) =< assoc p q (add r s) > add p (add q (add r s))
        =< ap A A (add p) (add q (add r s)) (add (add q r) s) (symH (assoc q r s)) > add p (add (add q r) s)
        =< ap A A (\ t -> add p (add t s)) (add q r) (add r q) (comm q r) > add p (add (add r q) s)
        =< ap A A (add p) (add (add r q) s) (add r (add q s)) (assoc r q s) > add p (add r (add q s))
        =< symH (assoc p r (add q s)) > add (add p r) (add q s) } ;
  inv-uniq (a b : A) (h : Id A (add a b) o) : Id A b (inv a) =
    transH (solve b a o (transH (comm b a) h)) (unitl (inv a)) ;
  inv-inv (x : A) : Id A (inv (inv x)) x = symH (inv-uniq (inv x) x (invl x)) ;
  inv-o : Id A (inv o) o = symH (inv-uniq o o (unitr o)) ;
  inv-add (x y : A) : Id A (inv (add x y)) (add (inv x) (inv y)) =
    symH (inv-uniq (add x y) (add (inv x) (inv y))
      (transH (swap4 x y (inv x) (inv y))
         (transH (ap A A (\ t -> add t (add y (inv y))) (add x (inv x)) o (invr x))
            (transH (ap A A (add o) (add y (inv y)) o (invr y)) (unitr o))))) ;
  -- (x + y) + z = (x + z) + y
  swap3 (x y z : A) : Id A (add (add x y) z) (add (add x z) y) =
    transH (assoc x y z)
      (transH (ap A A (add x) (add y z) (add z y) (comm y z)) (symH (assoc x z y))) ;
  -- (c + d) - d = c
  add-sub (c0 d : A) : Id A (add (add c0 d) (inv d)) c0 =
    transH (assoc c0 d (inv d)) (transH (ap A A (add c0) (add d (inv d)) o (invr d)) (unitr c0)) ;
} ;

module CechQM (n : Nat) (X : U l) (Uc : Fin n -> X -> U l)
  (cover : (x : X) -> Tr.Trunc[(i : Fin n) * Uc i x].carrier) (F : X -> Ab)
  (h1 : (i j : Fin n) -> CechM[n, X, Uc, cover, F].H1Zero i j)
  (h2 : (i : Fin n) -> CechM[n, X, Uc, cover, F].H2Zero i) {
  open CechM[n, X, Uc, cover, F] ;
  module T2 = Thm2[h1, h2] ;

  ----------------------------------------------------------------------
  -- cohomologous is an equivalence relation

  module RelLaws (x : X) {
    module A2 = AbL2[F x] ;
    zero (i j : L x) : Ax x = (F x).o ;
    neg (b : L x -> L x -> Ax x) (i j : L x) : Ax x = (F x).inv (b i j) ;
    sum (b b' : L x -> L x -> Ax x) (i j : L x) : Ax x = (F x).add (b i j) (b' i j) ;

    dlt-zero (i j k : L x) : Id (Ax x) (dlt x zero i j k) (F x).o =
      transH (ap (Ax x) (Ax x) ((F x).add ((F x).add (F x).o (F x).o)) ((F x).inv (F x).o) (F x).o A2.inv-o)
        (transH ((F x).unitr ((F x).add (F x).o (F x).o)) ((F x).unitr (F x).o)) ;
    dlt-neg (b : L x -> L x -> Ax x) (i j k : L x) : Id (Ax x) (dlt x (neg b) i j k) ((F x).inv (dlt x b i j k)) =
      symH (transH (A2.inv-add ((F x).add (b i j) (b j k)) ((F x).inv (b i k)))
              (transH (ap (Ax x) (Ax x) ((F x).add ((F x).inv ((F x).add (b i j) (b j k)))) ((F x).inv ((F x).inv (b i k))) (b i k)
                          (A2.inv-inv (b i k)))
                 (transH (ap (Ax x) (Ax x) (\ t -> (F x).add t (b i k)) ((F x).inv ((F x).add (b i j) (b j k)))
                             ((F x).add ((F x).inv (b i j)) ((F x).inv (b j k))) (A2.inv-add (b i j) (b j k)))
                    (ap (Ax x) (Ax x) ((F x).add ((F x).add ((F x).inv (b i j)) ((F x).inv (b j k)))) (b i k) ((F x).inv ((F x).inv (b i k)))
                        (symH (A2.inv-inv (b i k))))))) ;
    dlt-sum (b b' : L x -> L x -> Ax x) (i j k : L x)
      : Id (Ax x) (dlt x (sum b b') i j k) ((F x).add (dlt x b i j k) (dlt x b' i j k)) =
      transH (ap (Ax x) (Ax x) (\ t -> (F x).add t ((F x).inv ((F x).add (b i k) (b' i k))))
                 ((F x).add ((F x).add (b i j) (b' i j)) ((F x).add (b j k) (b' j k)))
                 ((F x).add ((F x).add (b i j) (b j k)) ((F x).add (b' i j) (b' j k)))
                 (A2.swap4 (b i j) (b' i j) (b j k) (b' j k)))
        (transH (ap (Ax x) (Ax x) ((F x).add ((F x).add ((F x).add (b i j) (b j k)) ((F x).add (b' i j) (b' j k))))
                    ((F x).inv ((F x).add (b i k) (b' i k))) ((F x).add ((F x).inv (b i k)) ((F x).inv (b' i k)))
                    (A2.inv-add (b i k) (b' i k)))
                (A2.swap4 ((F x).add (b i j) (b j k)) ((F x).add (b' i j) (b' j k)) ((F x).inv (b i k)) ((F x).inv (b' i k)))) ;
  } ;

  rel-refl (c : Z2) : Rel c c =
    (\ x -> RelLaws[x].zero,
     \ x i j k -> symH (transH (ap (Ax x) (Ax x) ((F x).add ((c x).1 i j k)) (dlt x RelLaws[x].zero i j k) (F x).o
                                   (RelLaws[x].dlt-zero i j k))
                               ((F x).unitr ((c x).1 i j k)))) ;

  rel-sym (c c' : Z2) (r : Rel c c') : Rel c' c =
    (\ x -> RelLaws[x].neg (r.1 x),
     \ x i j k -> symH (calc (Ax x) {
        (F x).add ((c' x).1 i j k) (dlt x (RelLaws[x].neg (r.1 x)) i j k)
          =< ap (Ax x) (Ax x) ((F x).add ((c' x).1 i j k)) (dlt x (RelLaws[x].neg (r.1 x)) i j k)
               ((F x).inv (dlt x (r.1 x) i j k)) (RelLaws[x].dlt-neg (r.1 x) i j k)
          > (F x).add ((c' x).1 i j k) ((F x).inv (dlt x (r.1 x) i j k))
          =< ap (Ax x) (Ax x) (\ t -> (F x).add t ((F x).inv (dlt x (r.1 x) i j k))) ((c' x).1 i j k)
               ((F x).add ((c x).1 i j k) (dlt x (r.1 x) i j k)) (r.2 x i j k)
          > (F x).add ((F x).add ((c x).1 i j k) (dlt x (r.1 x) i j k)) ((F x).inv (dlt x (r.1 x) i j k))
          =< AbL2[F x].add-sub ((c x).1 i j k) (dlt x (r.1 x) i j k) > (c x).1 i j k })) ;

  rel-trans (c c' c'' : Z2) (r : Rel c c') (r' : Rel c' c'') : Rel c c'' =
    (\ x -> RelLaws[x].sum (r.1 x) (r'.1 x),
     \ x i j k -> calc (Ax x) {
        (c'' x).1 i j k
          =< r'.2 x i j k > (F x).add ((c' x).1 i j k) (dlt x (r'.1 x) i j k)
          =< ap (Ax x) (Ax x) (\ t -> (F x).add t (dlt x (r'.1 x) i j k)) ((c' x).1 i j k)
               ((F x).add ((c x).1 i j k) (dlt x (r.1 x) i j k)) (r.2 x i j k)
          > (F x).add ((F x).add ((c x).1 i j k) (dlt x (r.1 x) i j k)) (dlt x (r'.1 x) i j k)
          =< (F x).assoc ((c x).1 i j k) (dlt x (r.1 x) i j k) (dlt x (r'.1 x) i j k)
          > (F x).add ((c x).1 i j k) ((F x).add (dlt x (r.1 x) i j k) (dlt x (r'.1 x) i j k))
          =< ap (Ax x) (Ax x) ((F x).add ((c x).1 i j k))
               ((F x).add (dlt x (r.1 x) i j k) (dlt x (r'.1 x) i j k))
               (dlt x (RelLaws[x].sum (r.1 x) (r'.1 x)) i j k)
               (symH (RelLaws[x].dlt-sum (r.1 x) (r'.1 x) i j k))
          > (F x).add ((c x).1 i j k) (dlt x (RelLaws[x].sum (r.1 x) (r'.1 x)) i j k) }) ;

  ----------------------------------------------------------------------
  -- the two quotients

  RelT (c c' : Z2) : U l+ = Tr1.Trunc[Rel c c'].carrier ;
  module HcQ = Q1.Quot[Z2, RelT, \ c c' -> Tr1.Trunc[Rel c c'].proposition,
    \ c -> Tr1.Trunc[Rel c c].inc (rel-refl c),
    \ c c' t -> Tr1.Trunc[Rel c c'].induction @(l+) (\ v -> RelT c' c) (\ v -> Tr1.Trunc[Rel c' c].proposition)
                  (\ r -> Tr1.Trunc[Rel c' c].inc (rel-sym c c' r)) t,
    \ c c' c'' t t' -> Tr1.Trunc[Rel c c'].induction @(l+) (\ v -> RelT c c'') (\ v -> Tr1.Trunc[Rel c c''].proposition)
                  (\ r -> Tr1.Trunc[Rel c' c''].induction @(l+) (\ v -> RelT c c'') (\ v -> Tr1.Trunc[Rel c c''].proposition)
                            (\ r' -> Tr1.Trunc[Rel c c''].inc (rel-trans c c' c'' r r')) t') t] ;

  Eq1 (G G' : GF) : U l+ = Tr1.Trunc[Id GF G G'].carrier ;
  module H2Q = Q1.Quot[GF, Eq1, \ G G' -> Tr1.Trunc[Id GF G G'].proposition,
    \ G -> Tr1.Trunc[Id GF G G].inc (refl G),
    \ G G' t -> Tr1.Trunc[Id GF G G'].induction @(l+) (\ v -> Eq1 G' G) (\ v -> Tr1.Trunc[Id GF G' G].proposition)
                  (\ P -> Tr1.Trunc[Id GF G' G].inc (P1.sym GF G G' P)) t,
    \ G G' G'' t t' -> Tr1.Trunc[Id GF G G'].induction @(l+) (\ v -> Eq1 G G'') (\ v -> Tr1.Trunc[Id GF G G''].proposition)
                  (\ P -> Tr1.Trunc[Id GF G' G''].induction @(l+) (\ v -> Eq1 G G'') (\ v -> Tr1.Trunc[Id GF G G''].proposition)
                            (\ P' -> Tr1.Trunc[Id GF G G''].inc (P1.trans GF G G' G'' P P')) t') t] ;

  Hc : U l+ = HcQ.Q ;
  H2 : U l+ = H2Q.Q ;

  ----------------------------------------------------------------------
  -- the comparison map and SAG Theorem 7.4.8

  f (c : Z2) : H2 = H2Q.inc (Gc c) ;
  respect (c c' : Z2) (t : RelT c c') : Id H2 (f c) (f c') =
    H2Q.relates (Gc c) (Gc c')
      (Tr1.Trunc[Rel c c'].induction @(l+) (\ v -> Eq1 (Gc c) (Gc c')) (\ v -> Tr1.Trunc[Id GF (Gc c) (Gc c')].proposition)
         (\ r -> Tr1.Trunc[Id GF (Gc c) (Gc c')].inc (T2.well-defined c c' r)) t) ;

  module DM = HcQ.Descend[H2, H2Q.set, f, respect] ;
  m (q : Hc) : H2 = DM.map q ;

  -- injective
  rel-of (c c' : Z2) (e : Id H2 (f c) (f c')) : RelT c c' =
    Tr.Trunc[Rel c c'].induction @(l+) (\ v -> RelT c c') (\ v -> Tr1.Trunc[Rel c c'].proposition)
      (\ r -> Tr1.Trunc[Rel c c'].inc r)
      (T2.injective c c' (H2Q.effective (Gc c) (Gc c') e)) ;

  InjT (q q' : Hc) : U l+ = Id H2 (m q) (m q') -> Id Hc q q' ;
  injT-prop (q q' : Hc) : P1.isProp (InjT q q') =
    FL1.isProp-Pi (Id H2 (m q) (m q')) (\ e -> Id Hc q q') (\ e -> HcQ.set q q') ;

  inj (q : Hc) : (q' : Hc) -> InjT q q' =
    HcQ.induction @(l+) (\ q0 -> (q' : Hc) -> InjT q0 q')
      (\ q0 -> FL1.isProp-Pi Hc (\ q' -> InjT q0 q') (\ q' -> injT-prop q0 q'))
      (\ c -> HcQ.induction @(l+) (\ q' -> InjT (HcQ.inc c) q') (\ q' -> injT-prop (HcQ.inc c) q')
                (\ c' e -> HcQ.relates c c'
                   (rel-of c c' (P1.trans H2 (f c) (m (HcQ.inc c)) (f c') (P1.sym H2 (m (HcQ.inc c)) (f c) (DM.beta c))
                                   (P1.trans H2 (m (HcQ.inc c)) (m (HcQ.inc c')) (f c') e (DM.beta c'))))))
      q ;

  -- surjective
  Fib (h : H2) : U l+ = (q : Hc) * Id H2 (m q) h ;
  surj (h : H2) : Tr1.Trunc[Fib h].carrier =
    H2Q.induction @(l+) (\ h0 -> Tr1.Trunc[Fib h0].carrier) (\ h0 -> Tr1.Trunc[Fib h0].proposition)
      (\ G -> Tr1.Trunc[(c : Z2) * Id GF (Gc c) G].induction @(l+) (\ v -> Tr1.Trunc[Fib (H2Q.inc G)].carrier)
                (\ v -> Tr1.Trunc[Fib (H2Q.inc G)].proposition)
                (\ cp -> Tr1.Trunc[Fib (H2Q.inc G)].inc
                   (HcQ.inc cp.1, P1.trans H2 (m (HcQ.inc cp.1)) (f cp.1) (H2Q.inc G) (DM.beta cp.1)
                                    (P1.ap GF H2 H2Q.inc (Gc cp.1) G cp.2)))
                (T2.surjective G))
      h ;

  fib-prop (h : H2) : P1.isProp (Fib h) = \ z z' ->
    P1.Sigma-eq Hc (\ q -> Id H2 (m q) h) z.1 z'.1 z.2 z'.2
      (inj z.1 z'.1 (P1.trans H2 (m z.1) h (m z'.1) z.2 (P1.sym H2 (m z'.1) h z'.2)))
      (H2Q.set (m z'.1) h) ;

  fib (h : H2) : E1.isContr (Fib h) =
    Tr1.Trunc[Fib h].induction @(l+) (\ v -> E1.isContr (Fib h)) (\ v -> Torsor[l+].isProp-isContr (Fib h))
      (\ z -> (z, \ z' -> fib-prop h z z')) (surj h) ;

  -- SAG Theorem 7.4.8:  Cech H^2 ~ H^2  for a 2-acyclic finite cover
  theorem-7-4-8 : P1.Equiv Hc H2 =
    (m, P1.qinv Hc H2 m (\ h -> (fib h).1.1) (\ h -> (fib h).1.2)
          (\ q -> P1.ap (Fib (m q)) Hc (\ z -> z.1) (fib (m q)).1 (q, refl (m q))
                    ((fib (m q)).2 (q, refl (m q))))) ;

  ----------------------------------------------------------------------
  -- compatibility with addition

  -- addition of cocycles
  addZ (c d : Z2) : Z2 = \ x ->
    (\ i j k -> (F x).add ((c x).1 i j k) ((d x).1 i j k),
     \ i j k m -> calc (Ax x) {
       (F x).add ((F x).add ((c x).1 i j k) ((d x).1 i j k)) ((F x).add ((c x).1 i k m) ((d x).1 i k m))
         =< AbL2[F x].swap4 ((c x).1 i j k) ((d x).1 i j k) ((c x).1 i k m) ((d x).1 i k m)
         > (F x).add ((F x).add ((c x).1 i j k) ((c x).1 i k m)) ((F x).add ((d x).1 i j k) ((d x).1 i k m))
         =< ap (Ax x) (Ax x) (\ t -> (F x).add t ((F x).add ((d x).1 i j k) ((d x).1 i k m)))
              ((F x).add ((c x).1 i j k) ((c x).1 i k m)) ((F x).add ((c x).1 j k m) ((c x).1 i j m)) ((c x).2 i j k m)
         > (F x).add ((F x).add ((c x).1 j k m) ((c x).1 i j m)) ((F x).add ((d x).1 i j k) ((d x).1 i k m))
         =< ap (Ax x) (Ax x) ((F x).add ((F x).add ((c x).1 j k m) ((c x).1 i j m)))
              ((F x).add ((d x).1 i j k) ((d x).1 i k m)) ((F x).add ((d x).1 j k m) ((d x).1 i j m)) ((d x).2 i j k m)
         > (F x).add ((F x).add ((c x).1 j k m) ((c x).1 i j m)) ((F x).add ((d x).1 j k m) ((d x).1 i j m))
         =< AbL2[F x].swap4 ((c x).1 j k m) ((c x).1 i j m) ((d x).1 j k m) ((d x).1 i j m)
         > (F x).add ((F x).add ((c x).1 j k m) ((d x).1 j k m)) ((F x).add ((c x).1 i j m) ((d x).1 i j m)) }) ;

  -- addition of families of gerbes: the pointwise sum
  addG (G G' : GF) : GF = \ x -> GSum[F x, G x, G' x].SG ;

  -- on representatives: the gerbes of c + d are the sum of those of c and d
  module AddPt (c d : Z2) (x : X) {
    module E = M74[F x, L x, cover x] ;
    module SC = SumCoc[F x, L x, inv74 x (c x), inv74 x (d x)] ;
    phi-ws : Id (Coc2[F x, L x].Coc2) (Coc2[F x, L x].phi2 SC.ws) (addZ c d x) =
      Sigma-eq (L x -> L x -> L x -> Ax x) (Coc2[F x, L x].CocP2)
        (Coc2[F x, L x].phi2 SC.ws).1 (addZ c d x).1 (Coc2[F x, L x].phi2 SC.ws).2 (addZ c d x).2
        (FL.funext (L x) (\ i -> L x -> L x -> Ax x) (Coc2[F x, L x].phi2 SC.ws).1 (addZ c d x).1 (\ i ->
           FL.funext (L x) (\ j -> L x -> Ax x) ((Coc2[F x, L x].phi2 SC.ws).1 i) ((addZ c d x).1 i) (\ j ->
             FL.funext (L x) (\ k -> Ax x) ((Coc2[F x, L x].phi2 SC.ws).1 i j) ((addZ c d x).1 i j) (\ k ->
               transH (SC.cocycle-sum i j k)
                 (transH (ap (Ax x) (Ax x) (\ t -> (F x).add t ((Coc2[F x, L x].phi2 (inv74 x (d x))).1 i j k))
                             ((Coc2[F x, L x].phi2 (inv74 x (c x))).1 i j k) ((c x).1 i j k)
                             (ap (Coc2[F x, L x].Coc2) (Ax x) (\ v -> v.1 i j k) (Coc2[F x, L x].phi2 (inv74 x (c x))) (c x)
                                 (E.theorem-7-4-7.2.sec-eq (c x))))
                         (ap (Ax x) (Ax x) ((F x).add ((c x).1 i j k))
                             ((Coc2[F x, L x].phi2 (inv74 x (d x))).1 i j k) ((d x).1 i j k)
                             (ap (Coc2[F x, L x].Coc2) (Ax x) (\ v -> v.1 i j k) (Coc2[F x, L x].phi2 (inv74 x (d x))) (d x)
                                 (E.theorem-7-4-7.2.sec-eq (d x)))))))))
        (E.coc2-prop (addZ c d x).1) ;
    pt : Id (Gerbes[F x].AGerbe) (Gc (addZ c d) x) (addG (Gc c) (Gc d) x) =
      P1.trans (Gerbes[F x].AGerbe) (Gc (addZ c d) x) (inv74 x (Coc2[F x, L x].phi2 SC.ws)).1 (addG (Gc c) (Gc d) x)
        (P1.ap (Coc2[F x, L x].Coc2) (Gerbes[F x].AGerbe) (\ v -> (inv74 x v).1) (addZ c d x) (Coc2[F x, L x].phi2 SC.ws)
           (sym (Coc2[F x, L x].Coc2) (Coc2[F x, L x].phi2 SC.ws) (addZ c d x) phi-ws))
        (P1.ap (Coc2[F x, L x].Left2) (Gerbes[F x].AGerbe) (\ v -> v.1)
           (inv74 x (Coc2[F x, L x].phi2 SC.ws)) SC.ws (E.theorem-7-4-7.2.ret-eq SC.ws)) ;
  } ;

  Gc-add (c d : Z2) : Id GF (Gc (addZ c d)) (addG (Gc c) (Gc d)) =
    FL1.funext X (\ x -> Gerbes[F x].AGerbe) (Gc (addZ c d)) (addG (Gc c) (Gc d)) (\ x -> AddPt[c, d, x].pt) ;

  -- addition on H2, from the sum of gerbes
  respIn (G G' G'' : GF) (t : Eq1 G' G'') : Id H2 (H2Q.inc (addG G G')) (H2Q.inc (addG G G'')) =
    H2Q.relates (addG G G') (addG G G'')
      (Tr1.Trunc[Id GF G' G''].induction @(l+) (\ v -> Eq1 (addG G G') (addG G G''))
         (\ v -> Tr1.Trunc[Id GF (addG G G') (addG G G'')].proposition)
         (\ P -> Tr1.Trunc[Id GF (addG G G') (addG G G'')].inc (P1.ap GF GF (addG G) G' G'' P)) t) ;
  inner (G : GF) (h : H2) : H2 = H2Q.Descend[H2, H2Q.set, \ G' -> H2Q.inc (addG G G'), respIn G].map h ;
  innerB (G G' : GF) : Id H2 (inner G (H2Q.inc G')) (H2Q.inc (addG G G')) =
    H2Q.Descend[H2, H2Q.set, \ G'' -> H2Q.inc (addG G G''), respIn G].beta G' ;

  fun-set : P1.isSet (H2 -> H2) = FL1.isSet-Pi H2 (\ h -> H2) (\ h -> H2Q.set) ;
  respOut (G G1 : GF) (t : Eq1 G G1) : Id (H2 -> H2) (inner G) (inner G1) =
    FL1.funext H2 (\ h -> H2) (inner G) (inner G1)
      (H2Q.induction @(l+) (\ h -> Id H2 (inner G h) (inner G1 h)) (\ h -> H2Q.set (inner G h) (inner G1 h))
         (\ G' -> P1.trans H2 (inner G (H2Q.inc G')) (H2Q.inc (addG G G')) (inner G1 (H2Q.inc G'))
                    (innerB G G')
                    (P1.trans H2 (H2Q.inc (addG G G')) (H2Q.inc (addG G1 G')) (inner G1 (H2Q.inc G'))
                       (H2Q.relates (addG G G') (addG G1 G')
                          (Tr1.Trunc[Id GF G G1].induction @(l+) (\ v -> Eq1 (addG G G') (addG G1 G'))
                             (\ v -> Tr1.Trunc[Id GF (addG G G') (addG G1 G')].proposition)
                             (\ P -> Tr1.Trunc[Id GF (addG G G') (addG G1 G')].inc
                                       (P1.ap GF GF (\ g -> addG g G') G G1 P)) t))
                       (P1.sym H2 (inner G1 (H2Q.inc G')) (H2Q.inc (addG G1 G')) (innerB G1 G'))))) ;
  addH2 (h h' : H2) : H2 = H2Q.Descend[H2 -> H2, fun-set, inner, respOut].map h h' ;
  addH2-inc (G G' : GF) : Id H2 (addH2 (H2Q.inc G) (H2Q.inc G')) (H2Q.inc (addG G G')) =
    P1.trans H2 (addH2 (H2Q.inc G) (H2Q.inc G')) (inner G (H2Q.inc G')) (H2Q.inc (addG G G'))
      (P1.happly H2 (\ h -> H2) (addH2 (H2Q.inc G)) (inner G)
         (H2Q.Descend[H2 -> H2, fun-set, inner, respOut].beta G) (H2Q.inc G'))
      (innerB G G') ;

  -- addition on Hc, from the addition of cocycles
  rel-addL (c c' d : Z2) (r : Rel c c') : Rel (addZ c d) (addZ c' d) =
    (r.1, \ x i j k -> transH (ap (Ax x) (Ax x) (\ t -> (F x).add t ((d x).1 i j k)) ((c' x).1 i j k)
                                 ((F x).add ((c x).1 i j k) (dlt x (r.1 x) i j k)) (r.2 x i j k))
                         (AbL2[F x].swap3 ((c x).1 i j k) (dlt x (r.1 x) i j k) ((d x).1 i j k))) ;
  rel-addR (c d d' : Z2) (r : Rel d d') : Rel (addZ c d) (addZ c d') =
    (r.1, \ x i j k -> transH (ap (Ax x) (Ax x) ((F x).add ((c x).1 i j k)) ((d' x).1 i j k)
                                 ((F x).add ((d x).1 i j k) (dlt x (r.1 x) i j k)) (r.2 x i j k))
                         (symH ((F x).assoc ((c x).1 i j k) ((d x).1 i j k) (dlt x (r.1 x) i j k)))) ;

  innerC (c : Z2) (q : Hc) : Hc =
    HcQ.Descend[Hc, HcQ.set, \ d -> HcQ.inc (addZ c d),
      \ d d' t -> HcQ.relates (addZ c d) (addZ c d')
         (Tr1.Trunc[Rel d d'].induction @(l+) (\ v -> RelT (addZ c d) (addZ c d'))
            (\ v -> Tr1.Trunc[Rel (addZ c d) (addZ c d')].proposition)
            (\ r -> Tr1.Trunc[Rel (addZ c d) (addZ c d')].inc (rel-addR c d d' r)) t)].map q ;
  innerCB (c d : Z2) : Id Hc (innerC c (HcQ.inc d)) (HcQ.inc (addZ c d)) =
    HcQ.Descend[Hc, HcQ.set, \ d0 -> HcQ.inc (addZ c d0),
      \ d0 d1 t -> HcQ.relates (addZ c d0) (addZ c d1)
         (Tr1.Trunc[Rel d0 d1].induction @(l+) (\ v -> RelT (addZ c d0) (addZ c d1))
            (\ v -> Tr1.Trunc[Rel (addZ c d0) (addZ c d1)].proposition)
            (\ r -> Tr1.Trunc[Rel (addZ c d0) (addZ c d1)].inc (rel-addR c d0 d1 r)) t)].beta d ;

  funC-set : P1.isSet (Hc -> Hc) = FL1.isSet-Pi Hc (\ h -> Hc) (\ h -> HcQ.set) ;
  respC (c c1 : Z2) (t : RelT c c1) : Id (Hc -> Hc) (innerC c) (innerC c1) =
    FL1.funext Hc (\ h -> Hc) (innerC c) (innerC c1)
      (HcQ.induction @(l+) (\ h -> Id Hc (innerC c h) (innerC c1 h)) (\ h -> HcQ.set (innerC c h) (innerC c1 h))
         (\ d -> P1.trans Hc (innerC c (HcQ.inc d)) (HcQ.inc (addZ c d)) (innerC c1 (HcQ.inc d))
                   (innerCB c d)
                   (P1.trans Hc (HcQ.inc (addZ c d)) (HcQ.inc (addZ c1 d)) (innerC c1 (HcQ.inc d))
                      (HcQ.relates (addZ c d) (addZ c1 d)
                         (Tr1.Trunc[Rel c c1].induction @(l+) (\ v -> RelT (addZ c d) (addZ c1 d))
                            (\ v -> Tr1.Trunc[Rel (addZ c d) (addZ c1 d)].proposition)
                            (\ r -> Tr1.Trunc[Rel (addZ c d) (addZ c1 d)].inc (rel-addL c c1 d r)) t))
                      (P1.sym Hc (innerC c1 (HcQ.inc d)) (HcQ.inc (addZ c1 d)) (innerCB c1 d))))) ;
  addHc (q q' : Hc) : Hc = HcQ.Descend[Hc -> Hc, funC-set, innerC, respC].map q q' ;
  addHc-inc (c d : Z2) : Id Hc (addHc (HcQ.inc c) (HcQ.inc d)) (HcQ.inc (addZ c d)) =
    P1.trans Hc (addHc (HcQ.inc c) (HcQ.inc d)) (innerC c (HcQ.inc d)) (HcQ.inc (addZ c d))
      (P1.happly Hc (\ h -> Hc) (addHc (HcQ.inc c)) (innerC c)
         (HcQ.Descend[Hc -> Hc, funC-set, innerC, respC].beta c) (HcQ.inc d))
      (innerCB c d) ;

  -- SAG Theorem 7.4.8: the equivalence preserves addition
  m-add (q q' : Hc) : Id H2 (m (addHc q q')) (addH2 (m q) (m q')) =
    HcQ.induction @(l+) (\ q0 -> Id H2 (m (addHc q0 q')) (addH2 (m q0) (m q')))
      (\ q0 -> H2Q.set (m (addHc q0 q')) (addH2 (m q0) (m q')))
      (\ c -> HcQ.induction @(l+) (\ q1 -> Id H2 (m (addHc (HcQ.inc c) q1)) (addH2 (m (HcQ.inc c)) (m q1)))
                (\ q1 -> H2Q.set (m (addHc (HcQ.inc c) q1)) (addH2 (m (HcQ.inc c)) (m q1)))
                (\ d -> calc H2 {
                   m (addHc (HcQ.inc c) (HcQ.inc d))
                     =< P1.ap Hc H2 m (addHc (HcQ.inc c) (HcQ.inc d)) (HcQ.inc (addZ c d)) (addHc-inc c d)
                     > m (HcQ.inc (addZ c d))
                     =< DM.beta (addZ c d) > f (addZ c d)
                     =< P1.ap GF H2 H2Q.inc (Gc (addZ c d)) (addG (Gc c) (Gc d)) (Gc-add c d)
                     > H2Q.inc (addG (Gc c) (Gc d))
                     =< P1.sym H2 (addH2 (f c) (f d)) (H2Q.inc (addG (Gc c) (Gc d))) (addH2-inc (Gc c) (Gc d))
                     > addH2 (f c) (f d)
                     =< P1.ap H2 H2 (\ h -> addH2 h (f d)) (f c) (m (HcQ.inc c))
                          (P1.sym H2 (m (HcQ.inc c)) (f c) (DM.beta c))
                     > addH2 (m (HcQ.inc c)) (f d)
                     =< P1.ap H2 H2 (addH2 (m (HcQ.inc c))) (f d) (m (HcQ.inc d))
                          (P1.sym H2 (m (HcQ.inc d)) (f d) (DM.beta d))
                     > addH2 (m (HcQ.inc c)) (m (HcQ.inc d)) })
                q')
      q ;
} ;
