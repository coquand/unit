-- Refine.seg: naturality of SAG Theorem 7.4.8 under refinement of covers.
-- A cover V 1 .. V n' refines U 1 .. U n through rho : Fin n' -> Fin n with
-- V j x -> U (rho j) x.  Cocycles are pulled back along
-- r : L' x -> L x, (j, v) |-> (rho j, v).  Restricting the points and
-- paths of a gerbe along r pulls back its cocycle, so the family of gerbes
-- of the pulled-back cocycle is the same family (Gc-pull, an equality).
-- Hence the refinement map on classes commutes with the comparison maps
-- (natural); it is therefore independent of rho and additive.

level l ;
open Base ;
open Prelude[l] ;
open Paths[l] ;
open Torsor[l] ;
open Gerbe[l] ;
open Cocycle2[l] ;
open Gerbe74[l] ;
open Cech[l] ;
open CechQ[l] ;
module Tr = Truncation[l] ;
module Tr1 = Truncation[l+] ;
module P1 = Prelude[l+] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module FL1 = Axioms[l+].FunExtLemmas[fe @(l+)] ;

module Ref (n n' : Nat) (X : U l) (Uc : Fin n -> X -> U l) (Vc : Fin n' -> X -> U l)
  (covU : (x : X) -> Tr.Trunc[(i : Fin n) * Uc i x].carrier)
  (covV : (x : X) -> Tr.Trunc[(j : Fin n') * Vc j x].carrier)
  (F : X -> Ab) (rho : Fin n' -> Fin n) (inc : (j : Fin n') (x : X) -> Vc j x -> Uc (rho j) x) {
  module CU = CechM[n, X, Uc, covU, F] ;
  module CV = CechM[n', X, Vc, covV, F] ;

  r (x : X) (a : CV.L x) : CU.L x = (rho a.1, inc a.1 x a.2) ;

  pullC (x : X) (cx : Coc2[F x, CU.L x].Coc2) : Coc2[F x, CV.L x].Coc2 =
    (\ a b d -> cx.1 (r x a) (r x b) (r x d), \ a b d e -> cx.2 (r x a) (r x b) (r x d) (r x e)) ;
  pullZ (c : CU.Z2) : CV.Z2 = \ x -> pullC x (c x) ;

  pullW (x : X) (w : Coc2[F x, CU.L x].Left2) : Coc2[F x, CV.L x].Left2 =
    (w.1, \ a -> w.2.1 (r x a), \ a b -> w.2.2 (r x a) (r x b)) ;

  -- restricting the points and paths pulls back the cocycle
  phi-pull (x : X) (w : Coc2[F x, CU.L x].Left2)
    : Id (Coc2[F x, CV.L x].Coc2) (Coc2[F x, CV.L x].phi2 (pullW x w)) (pullC x (Coc2[F x, CU.L x].phi2 w)) =
    Sigma-eq (CV.L x -> CV.L x -> CV.L x -> CV.Ax x) (Coc2[F x, CV.L x].CocP2)
      (Coc2[F x, CV.L x].phi2 (pullW x w)).1 (pullC x (Coc2[F x, CU.L x].phi2 w)).1
      (Coc2[F x, CV.L x].phi2 (pullW x w)).2 (pullC x (Coc2[F x, CU.L x].phi2 w)).2
      (FL.funext (CV.L x) (\ a -> CV.L x -> CV.L x -> CV.Ax x)
         (Coc2[F x, CV.L x].phi2 (pullW x w)).1 (pullC x (Coc2[F x, CU.L x].phi2 w)).1 (\ a ->
         FL.funext (CV.L x) (\ b -> CV.L x -> CV.Ax x)
           ((Coc2[F x, CV.L x].phi2 (pullW x w)).1 a) ((pullC x (Coc2[F x, CU.L x].phi2 w)).1 a) (\ b ->
           FL.funext (CV.L x) (\ d -> CV.Ax x)
             ((Coc2[F x, CV.L x].phi2 (pullW x w)).1 a b) ((pullC x (Coc2[F x, CU.L x].phi2 w)).1 a b) (\ d ->
             refl ((Coc2[F x, CU.L x].phi2 w).1 (r x a) (r x b) (r x d))))))
      (M74[F x, CV.L x, covV x].coc2-prop (pullC x (Coc2[F x, CU.L x].phi2 w)).1) ;

  -- the gerbes of the pulled-back cocycle are the same family
  module PullPt (c : CU.Z2) (x : X) {
    module EU = M74[F x, CU.L x, covU x] ;
    module EV = M74[F x, CV.L x, covV x] ;
    w : Coc2[F x, CU.L x].Left2 = CU.inv74 x (c x) ;
    eqc : Id (Coc2[F x, CV.L x].Coc2) (pullZ c x) (Coc2[F x, CV.L x].phi2 (pullW x w)) =
      sym (Coc2[F x, CV.L x].Coc2) (Coc2[F x, CV.L x].phi2 (pullW x w)) (pullZ c x)
        (transH (phi-pull x w)
           (ap (Coc2[F x, CU.L x].Coc2) (Coc2[F x, CV.L x].Coc2) (pullC x)
               (Coc2[F x, CU.L x].phi2 w) (c x) (EU.theorem-7-4-7.2.sec-eq (c x)))) ;
    pt : Id (Gerbes[F x].AGerbe) (CV.Gc (pullZ c) x) (CU.Gc c x) =
      P1.trans (Gerbes[F x].AGerbe) (CV.Gc (pullZ c) x) (CV.inv74 x (Coc2[F x, CV.L x].phi2 (pullW x w))).1 (CU.Gc c x)
        (P1.ap (Coc2[F x, CV.L x].Coc2) (Gerbes[F x].AGerbe) (\ v -> (CV.inv74 x v).1)
           (pullZ c x) (Coc2[F x, CV.L x].phi2 (pullW x w)) eqc)
        (P1.ap (Coc2[F x, CV.L x].Left2) (Gerbes[F x].AGerbe) (\ v -> v.1)
           (CV.inv74 x (Coc2[F x, CV.L x].phi2 (pullW x w))) (pullW x w) (EV.theorem-7-4-7.2.ret-eq (pullW x w))) ;
  } ;

  Gc-pull (c : CU.Z2) : Id CU.GF (CV.Gc (pullZ c)) (CU.Gc c) =
    FL1.funext X (\ x -> Gerbes[F x].AGerbe) (CV.Gc (pullZ c)) (CU.Gc c) (\ x -> PullPt[c, x].pt) ;

  -- pulling back preserves coboundaries
  rel-pull (c d : CU.Z2) (rl : CU.Rel c d) : CV.Rel (pullZ c) (pullZ d) =
    (\ x a b -> rl.1 x (r x a) (r x b), \ x a b e -> rl.2 x (r x a) (r x b) (r x e)) ;

  ----------------------------------------------------------------------
  -- on classes, for 2-acyclic covers

  module Classes (h1U : (i j : Fin n) -> CU.H1Zero i j) (h2U : (i : Fin n) -> CU.H2Zero i)
                 (h1V : (i j : Fin n') -> CV.H1Zero i j) (h2V : (i : Fin n') -> CV.H2Zero i) {
    module QU = CechQM[n, X, Uc, covU, F, h1U, h2U] ;
    module QV = CechQM[n', X, Vc, covV, F, h1V, h2V] ;

    respP (c d : CU.Z2) (t : QU.RelT c d) : Id QV.Hc (QV.HcQ.inc (pullZ c)) (QV.HcQ.inc (pullZ d)) =
      QV.HcQ.relates (pullZ c) (pullZ d)
        (Tr1.Trunc[CU.Rel c d].induction @(l+) (\ v -> QV.RelT (pullZ c) (pullZ d))
           (\ v -> Tr1.Trunc[CV.Rel (pullZ c) (pullZ d)].proposition)
           (\ rl -> Tr1.Trunc[CV.Rel (pullZ c) (pullZ d)].inc (rel-pull c d rl)) t) ;

    -- the refinement map on Cech classes
    refine (q : QU.Hc) : QV.Hc = QU.HcQ.Descend[QV.Hc, QV.HcQ.set, \ c -> QV.HcQ.inc (pullZ c), respP].map q ;
    refine-inc (c : CU.Z2) : Id QV.Hc (refine (QU.HcQ.inc c)) (QV.HcQ.inc (pullZ c)) =
      QU.HcQ.Descend[QV.Hc, QV.HcQ.set, \ c0 -> QV.HcQ.inc (pullZ c0), respP].beta c ;

    -- naturality:  m_V (refine q) = m_U q
    natural (q : QU.Hc) : Id QU.H2 (QV.m (refine q)) (QU.m q) =
      QU.HcQ.induction @(l+) (\ q0 -> Id QU.H2 (QV.m (refine q0)) (QU.m q0))
        (\ q0 -> QU.H2Q.set (QV.m (refine q0)) (QU.m q0))
        (\ c -> calc QU.H2 {
           QV.m (refine (QU.HcQ.inc c))
             =< P1.ap QV.Hc QU.H2 QV.m (refine (QU.HcQ.inc c)) (QV.HcQ.inc (pullZ c)) (refine-inc c)
             > QV.m (QV.HcQ.inc (pullZ c))
             =< QV.DM.beta (pullZ c) > QU.H2Q.inc (CV.Gc (pullZ c))
             =< P1.ap CU.GF QU.H2 QU.H2Q.inc (CV.Gc (pullZ c)) (CU.Gc c) (Gc-pull c)
             > QU.H2Q.inc (CU.Gc c)
             =< P1.sym QU.H2 (QU.m (QU.HcQ.inc c)) (QU.H2Q.inc (CU.Gc c)) (QU.DM.beta c)
             > QU.m (QU.HcQ.inc c) })
        q ;

    -- refine is additive
    refine-add (q q' : QU.Hc) : Id QV.Hc (refine (QU.addHc q q')) (QV.addHc (refine q) (refine q')) =
      QV.inj (refine (QU.addHc q q')) (QV.addHc (refine q) (refine q'))
        (calc QU.H2 {
           QV.m (refine (QU.addHc q q'))
             =< natural (QU.addHc q q') > QU.m (QU.addHc q q')
             =< QU.m-add q q' > QU.addH2 (QU.m q) (QU.m q')
             =< P1.ap QU.H2 QU.H2 (\ h -> QU.addH2 h (QU.m q')) (QU.m q) (QV.m (refine q))
                  (P1.sym QU.H2 (QV.m (refine q)) (QU.m q) (natural q))
             > QU.addH2 (QV.m (refine q)) (QU.m q')
             =< P1.ap QU.H2 QU.H2 (QU.addH2 (QV.m (refine q))) (QU.m q') (QV.m (refine q'))
                  (P1.sym QU.H2 (QV.m (refine q')) (QU.m q') (natural q'))
             > QU.addH2 (QV.m (refine q)) (QV.m (refine q'))
             =< P1.sym QU.H2 (QV.m (QV.addHc (refine q) (refine q'))) (QU.addH2 (QV.m (refine q)) (QV.m (refine q')))
                  (QV.m-add (refine q) (refine q'))
             > QV.m (QV.addHc (refine q) (refine q')) }) ;
  } ;
} ;

-- the refinement map does not depend on the refinement data
module Indep (n n' : Nat) (X : U l) (Uc : Fin n -> X -> U l) (Vc : Fin n' -> X -> U l)
  (covU : (x : X) -> Tr.Trunc[(i : Fin n) * Uc i x].carrier)
  (covV : (x : X) -> Tr.Trunc[(j : Fin n') * Vc j x].carrier) (F : X -> Ab)
  (rho1 rho2 : Fin n' -> Fin n)
  (inc1 : (j : Fin n') (x : X) -> Vc j x -> Uc (rho1 j) x)
  (inc2 : (j : Fin n') (x : X) -> Vc j x -> Uc (rho2 j) x)
  (h1U : (i j : Fin n) -> CechM[n, X, Uc, covU, F].H1Zero i j) (h2U : (i : Fin n) -> CechM[n, X, Uc, covU, F].H2Zero i)
  (h1V : (i j : Fin n') -> CechM[n', X, Vc, covV, F].H1Zero i j) (h2V : (i : Fin n') -> CechM[n', X, Vc, covV, F].H2Zero i) {
  module R1 = Ref[n, n', X, Uc, Vc, covU, covV, F, rho1, inc1].Classes[h1U, h2U, h1V, h2V] ;
  module R2 = Ref[n, n', X, Uc, Vc, covU, covV, F, rho2, inc2].Classes[h1U, h2U, h1V, h2V] ;
  indep (q : R1.QU.Hc) : Id R1.QV.Hc (R1.refine q) (R2.refine q) =
    R1.QV.inj (R1.refine q) (R2.refine q)
      (P1.trans R1.QU.H2 (R1.QV.m (R1.refine q)) (R1.QU.m q) (R1.QV.m (R2.refine q))
         (R1.natural q) (P1.sym R1.QU.H2 (R1.QV.m (R2.refine q)) (R1.QU.m q) (R2.natural q))) ;
} ;

-- identity and composition laws for refinement
module RefId (n : Nat) (X : U l) (Uc : Fin n -> X -> U l)
  (covU : (x : X) -> Tr.Trunc[(i : Fin n) * Uc i x].carrier) (F : X -> Ab)
  (h1U : (i j : Fin n) -> CechM[n, X, Uc, covU, F].H1Zero i j) (h2U : (i : Fin n) -> CechM[n, X, Uc, covU, F].H2Zero i) {
  module R = Ref[n, n, X, Uc, Uc, covU, covU, F, \ i -> i, \ i x a -> a].Classes[h1U, h2U, h1U, h2U] ;
  refine-id (q : R.QU.Hc) : Id R.QU.Hc (R.refine q) q =
    R.QV.inj (R.refine q) q (R.natural q) ;
} ;

module RefComp (n n' n'' : Nat) (X : U l) (Uc : Fin n -> X -> U l) (Vc : Fin n' -> X -> U l) (Wc : Fin n'' -> X -> U l)
  (covU : (x : X) -> Tr.Trunc[(i : Fin n) * Uc i x].carrier)
  (covV : (x : X) -> Tr.Trunc[(j : Fin n') * Vc j x].carrier)
  (covW : (x : X) -> Tr.Trunc[(k : Fin n'') * Wc k x].carrier) (F : X -> Ab)
  (rho : Fin n' -> Fin n) (incr : (j : Fin n') (x : X) -> Vc j x -> Uc (rho j) x)
  (sg : Fin n'' -> Fin n') (incs : (k : Fin n'') (x : X) -> Wc k x -> Vc (sg k) x)
  (h1U : (i j : Fin n) -> CechM[n, X, Uc, covU, F].H1Zero i j) (h2U : (i : Fin n) -> CechM[n, X, Uc, covU, F].H2Zero i)
  (h1V : (i j : Fin n') -> CechM[n', X, Vc, covV, F].H1Zero i j) (h2V : (i : Fin n') -> CechM[n', X, Vc, covV, F].H2Zero i)
  (h1W : (i j : Fin n'') -> CechM[n'', X, Wc, covW, F].H1Zero i j) (h2W : (i : Fin n'') -> CechM[n'', X, Wc, covW, F].H2Zero i) {
  module RUV = Ref[n, n', X, Uc, Vc, covU, covV, F, rho, incr].Classes[h1U, h2U, h1V, h2V] ;
  module RVW = Ref[n', n'', X, Vc, Wc, covV, covW, F, sg, incs].Classes[h1V, h2V, h1W, h2W] ;
  module RUW = Ref[n, n'', X, Uc, Wc, covU, covW, F, \ k -> rho (sg k), \ k x a -> incr (sg k) x (incs k x a)]
                 .Classes[h1U, h2U, h1W, h2W] ;
  refine-comp (q : RUV.QU.Hc) : Id RUW.QV.Hc (RUW.refine q) (RVW.refine (RUV.refine q)) =
    RUW.QV.inj (RUW.refine q) (RVW.refine (RUV.refine q))
      (P1.trans RUW.QU.H2 (RUW.QV.m (RUW.refine q)) (RUV.QU.m q) (RUW.QV.m (RVW.refine (RUV.refine q)))
         (RUW.natural q)
         (P1.sym RUW.QU.H2 (RUW.QV.m (RVW.refine (RUV.refine q))) (RUV.QU.m q)
            (P1.trans RUW.QU.H2 (RVW.QV.m (RVW.refine (RUV.refine q))) (RVW.QU.m (RUV.refine q)) (RUV.QU.m q)
               (RVW.natural (RUV.refine q)) (RUV.natural q)))) ;
} ;
