-- Ftit.seg: the fundamental theorem of identity types.  If (x : X) * B x
-- is contractible and b0 : B x0, then  p |-> transport p b0  is an
-- equivalence  (x0 = x) ~ B x  for every x.  Level-polymorphic.

level l ;
open Base ;
open Prelude[l] ;
open FunExtUA[l] ;

module FT (X : U l) (B : X -> U l) (x0 : X) (b0 : B x0) (c : isContr ((x : X) * B x)) {
  TS : U l = (x : X) * B x ;
  enc (x : X) (p : Id X x0 x) : B x = subst X B x0 x p b0 ;
  dec (x : X) (b : B x) : Id X x0 x =
    ap TS X (\ w -> w.1) (x0, b0) (x, b) (pathC TS c (x0, b0) (x, b)) ;

  enc-dec' (w : TS) (Q : Id TS (x0, b0) w) : Id (B w.1) (enc w.1 (ap TS X (\ v -> v.1) (x0, b0) w Q)) w.2 =
    idJ TS (x0, b0) (\ v Q' -> Id (B v.1) (enc v.1 (ap TS X (\ v' -> v'.1) (x0, b0) v Q')) v.2) (refl b0) w Q ;
  enc-dec (x : X) (b : B x) : Id (B x) (enc x (dec x b)) b = enc-dec' (x, b) (pathC TS c (x0, b0) (x, b)) ;

  dec-refl : Id (Id X x0 x0) (dec x0 b0) (refl x0) =
    ap (Id TS (x0, b0) (x0, b0)) (Id X x0 x0) (\ q -> ap TS X (\ w -> w.1) (x0, b0) (x0, b0) q)
      (pathC TS c (x0, b0) (x0, b0)) (refl (x0, b0)) (pathC-refl TS c (x0, b0)) ;
  dec-enc (x : X) (p : Id X x0 x) : Id (Id X x0 x) (dec x (enc x p)) p =
    idJ X x0 (\ x' p' -> Id (Id X x0 x') (dec x' (enc x' p')) p') dec-refl x p ;

  equiv (x : X) : isEquiv (Id X x0 x) (B x) (enc x) =
    qinv (Id X x0 x) (B x) (enc x) (dec x) (enc-dec x) (dec-enc x) ;
} ;
