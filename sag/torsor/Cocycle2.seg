-- Cocycle2.seg: SAG Theorem 7.4.7, the map from gerbes with points and
-- paths to 2-cocycles.  Given an A-gerbe G, u : L -> G and p i j : u i = u j,
--     c i j k = beta_(u i) (p i j . p j k . (p i k)^-1)
-- is a 2-cocycle:  c i j k + c i k l = c j k l + c i j l,  which is SAG's
-- condition  c j k l - c i k l + c i j l - c i j k = 0  rearranged.
-- Proof: both sides are beta_(u i) of  p i j . p j k . p k l . (p i l)^-1;
-- c j k l is moved from u j to u i by band-conj (the band commutes with
-- conjugation by p i j).

level l ;
open Base ;
open Prelude[l] ;
open Paths[l] ;
open Torsor[l] ;
open Groupoid[l] ;
open Gerbe[l] ;
module Tr = Truncation[l] ;

module Coc2 (Gr : Ab) (L : U l) {
  open Gr ;
  open Gerbes[Gr] ;

  CocP2 (c : L -> L -> L -> A) : U l =
    (i j k m : L) -> Id A (add (c i j k) (c i k m)) (add (c j k m) (c i j m)) ;
  Coc2 : U l = (c : L -> L -> L -> A) * CocP2 c ;

  -- a gerbe with an L-family of points and paths between them
  Left2 : U l+ = (Gb : AGerbe) * (u : L -> Gb.1) * ((i j : L) -> Id Gb.1 (u i) (u j)) ;

  module PhiG (w : Left2) {
    open GL[w.1] ;
    u : L -> X = w.2.1 ;
    p (i j : L) : Id X (u i) (u j) = w.2.2 i j ;
    t (x y z : X) (a : Id X x y) (b : Id X y z) : Id X x z = trans X x y z a b ;
    s (x y : X) (a : Id X x y) : Id X y x = sym X x y a ;

    -- the loop  p i j . p j k . (p i k)^-1  at u i
    lp (i j k : L) : Id X (u i) (u i) =
      t (u i) (u k) (u i) (t (u i) (u j) (u k) (p i j) (p j k)) (s (u i) (u k) (p i k)) ;
    c (i j k : L) : A = bnd (u i) (lp i j k) ;

    -- p i j . p j k . p k m . (p i m)^-1
    W (i j k m : L) : Id X (u i) (u i) =
      t (u i) (u m) (u i) (t (u i) (u k) (u m) (t (u i) (u j) (u k) (p i j) (p j k)) (p k m))
        (s (u i) (u m) (p i m)) ;

    e1 (i j k m : L) : Id (Id X (u i) (u i)) (t (u i) (u i) (u i) (lp i j k) (lp i k m)) (W i j k m) =
      calc (Id X (u i) (u i)) {
        t (u i) (u i) (u i) (lp i j k) (lp i k m)
          =< symH (tassoc X (u i) (u i) (u m) (lp i j k) (t (u i) (u k) (u m) (p i k) (p k m))
                     (u i) (s (u i) (u m) (p i m)))
          > t (u i) (u m) (u i) (t (u i) (u i) (u m) (lp i j k) (t (u i) (u k) (u m) (p i k) (p k m)))
              (s (u i) (u m) (p i m))
          =< ap (Id X (u i) (u m)) (Id X (u i) (u i)) (\ r -> t (u i) (u m) (u i) r (s (u i) (u m) (p i m)))
                (t (u i) (u i) (u m) (lp i j k) (t (u i) (u k) (u m) (p i k) (p k m)))
                (t (u i) (u k) (u m) (t (u i) (u j) (u k) (p i j) (p j k)) (p k m))
                (cancel-mid X (u i) (u i) (u k) (t (u i) (u j) (u k) (p i j) (p j k)) (p i k) (u m) (p k m))
          > W i j k m } ;

    -- p i j . (p j k . p k m . (p j m)^-1) . (p i j)^-1 : c j k m moved to u i
    conj (i j k m : L) : Id X (u i) (u i) =
      t (u i) (u j) (u i) (t (u i) (u j) (u j) (p i j) (lp j k m)) (s (u i) (u j) (p i j)) ;

    c-conj (i j k m : L) : Id A (bnd (u i) (conj i j k m)) (c j k m) =
      transH (ap (Id X (u i) (u j)) A
                 (\ r -> bnd (u i) (t (u i) (u j) (u i) (t (u i) (u j) (u j) r (lp j k m)) (s (u i) (u j) (p i j))))
                 (p i j) (s (u j) (u i) (s (u i) (u j) (p i j)))
                 (symH (sym-sym X (u i) (u j) (p i j))))
             (band-conj (u j) (lp j k m) (u i) (s (u i) (u j) (p i j))) ;

    -- (p . L) . f = (p . b) . d  for L = (b . d) . f^-1
    e2a (i j k m : L)
      : Id (Id X (u i) (u m)) (t (u i) (u j) (u m) (t (u i) (u j) (u j) (p i j) (lp j k m)) (p j m))
                              (t (u i) (u k) (u m) (t (u i) (u j) (u k) (p i j) (p j k)) (p k m)) =
      calc (Id X (u i) (u m)) {
        t (u i) (u j) (u m) (t (u i) (u j) (u j) (p i j) (lp j k m)) (p j m)
          =< tassoc X (u i) (u j) (u j) (p i j) (lp j k m) (u m) (p j m)
          > t (u i) (u j) (u m) (p i j) (t (u j) (u j) (u m) (lp j k m) (p j m))
          =< ap (Id X (u j) (u m)) (Id X (u i) (u m)) (t (u i) (u j) (u m) (p i j))
                (t (u j) (u j) (u m) (lp j k m) (p j m)) (t (u j) (u k) (u m) (p j k) (p k m))
                (cancel-r' X (u j) (u j) (u m) (t (u j) (u k) (u m) (p j k) (p k m)) (p j m))
          > t (u i) (u j) (u m) (p i j) (t (u j) (u k) (u m) (p j k) (p k m))
          =< symH (tassoc X (u i) (u j) (u k) (p i j) (p j k) (u m) (p k m))
          > t (u i) (u k) (u m) (t (u i) (u j) (u k) (p i j) (p j k)) (p k m) } ;

    e2 (i j k m : L) : Id (Id X (u i) (u i)) (t (u i) (u i) (u i) (conj i j k m) (lp i j m)) (W i j k m) =
      calc (Id X (u i) (u i)) {
        t (u i) (u i) (u i) (conj i j k m) (lp i j m)
          =< symH (tassoc X (u i) (u i) (u m) (conj i j k m) (t (u i) (u j) (u m) (p i j) (p j m))
                     (u i) (s (u i) (u m) (p i m)))
          > t (u i) (u m) (u i) (t (u i) (u i) (u m) (conj i j k m) (t (u i) (u j) (u m) (p i j) (p j m)))
              (s (u i) (u m) (p i m))
          =< ap (Id X (u i) (u m)) (Id X (u i) (u i)) (\ r -> t (u i) (u m) (u i) r (s (u i) (u m) (p i m)))
                (t (u i) (u i) (u m) (conj i j k m) (t (u i) (u j) (u m) (p i j) (p j m)))
                (t (u i) (u k) (u m) (t (u i) (u j) (u k) (p i j) (p j k)) (p k m))
                (transH (cancel-mid X (u i) (u i) (u j) (t (u i) (u j) (u j) (p i j) (lp j k m)) (p i j)
                           (u m) (p j m))
                        (e2a i j k m))
          > W i j k m } ;

    coc (i j k m : L) : Id A (add (c i j k) (c i k m)) (add (c j k m) (c i j m)) =
      calc A {
        add (c i j k) (c i k m)
          =< symH (bhom (u i) (lp i j k) (lp i k m)) > bnd (u i) (t (u i) (u i) (u i) (lp i j k) (lp i k m))
          =< ap (Id X (u i) (u i)) A (bnd (u i)) (t (u i) (u i) (u i) (lp i j k) (lp i k m)) (W i j k m) (e1 i j k m)
          > bnd (u i) (W i j k m)
          =< ap (Id X (u i) (u i)) A (bnd (u i)) (W i j k m) (t (u i) (u i) (u i) (conj i j k m) (lp i j m))
                (symH (e2 i j k m))
          > bnd (u i) (t (u i) (u i) (u i) (conj i j k m) (lp i j m))
          =< bhom (u i) (conj i j k m) (lp i j m) > add (bnd (u i) (conj i j k m)) (c i j m)
          =< ap A A (\ a -> add a (c i j m)) (bnd (u i) (conj i j k m)) (c j k m) (c-conj i j k m)
          > add (c j k m) (c i j m) } ;
  } ;

  -- SAG 7.4.7, forward map
  phi2 (w : Left2) : Coc2 = (PhiG[w].c, PhiG[w].coc) ;
} ;
