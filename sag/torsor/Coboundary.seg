-- Coboundary.seg: changing the chosen paths by a 1-cochain, and objects
-- with paths as cobounding cochains (towards SAG Theorem 7.4.8).
--
--   Change[b].thm   replacing p i j by  b i j . p i j  (the path-torsor
--                   action) changes the cocycle c to  c + delta b,
--                   delta b i j k = b i j + b j k - b i k;
--                   the gerbe and its points are unchanged.
--   Obj ~ Cob       for ||L||: an object y with paths  r i : u i = y  is
--                   the same as a 1-cochain b with  c + delta b = 0
--                   (theta: b i j is the difference from p i j to
--                   r i . (r j)^-1).  The paths are part of the data, so
--                   nothing is chosen; a point of L is used only to prove
--                   that theta is an equivalence, a proposition.
-- In a path torsor, c i j k is the difference from p i k to p i j . p j k
-- (cdiff), which reduces both statements to the torsor laws.

level l ;
open Base ;
open Prelude[l] ;
open Paths[l] ;
open FunExtUA[l] ;
open Torsor[l] ;
open Groupoid[l] ;
open Gerbe[l] ;
open Cocycle2[l] ;
module Tr = Truncation[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module P1 = Prelude[l+] ;

-- transport in y |-> (x = y) is postcomposition
transport-post (X : U l) (x y : X) (r : Id X x y) : (y' : X) (q : Id X y y')
  -> Id (Id X x y') (subst X (\ z -> Id X x z) y y' q r) (trans X x y y' r q) =
  \ y' q -> idJ X y (\ y2 q2 -> Id (Id X x y2) (subst X (\ z -> Id X x z) y y2 q2 r) (trans X x y y2 r q2))
              (refl r) y' q ;

-- transport in y |-> ((i : L) -> u i = y), pointwise postcomposition
transport-post-pi (X L : U l) (u : L -> X) (y : X) (r : (i : L) -> Id X (u i) y) : (y' : X) (q : Id X y y') (i : L)
  -> Id (Id X (u i) y') (subst X (\ z -> (k : L) -> Id X (u k) z) y y' q r i) (trans X (u i) y y' (r i) q) =
  \ y' q -> idJ X y (\ y2 q2 -> (i : L) -> Id (Id X (u i) y2) (subst X (\ z -> (k : L) -> Id X (u k) z) y y2 q2 r i)
                                                         (trans X (u i) y y2 (r i) q2))
              (\ i -> refl (r i)) y' q ;

-- in the torsor of paths u i = u k:  c i j k . p i k = p i j . p j k
module CDiff (Gr : Ab) (L : U l) (v : Coc2[Gr,L].Left2) {
  open Gr ;
  open Gerbes[Gr] ;
  module GV = GL[v.1] ;
  module CV = Coc2[Gr,L].PhiG[v] ;
  X : U l = v.1.1 ;
  u (i : L) : X = v.2.1 i ;
  p (i j : L) : Id X (u i) (u j) = v.2.2 i j ;

  cdiff (i j k : L) : Id (Id X (u i) (u k)) (GV.pact (u i) (u k) (CV.c i j k) (p i k))
                                          (trans X (u i) (u j) (u k) (p i j) (p j k)) =
    transH (ap (Id X (u i) (u i)) (Id X (u i) (u k)) (\ r -> trans X (u i) (u i) (u k) r (p i k))
               (GV.binv (u i) (CV.c i j k)) (CV.lp i j k) (GV.bret (u i) (CV.lp i j k)))
           (cancel-r' X (u i) (u i) (u k) (trans X (u i) (u j) (u k) (p i j) (p j k)) (p i k)) ;
} ;

module Cob (Gr : Ab) (L : U l) (w : Coc2[Gr,L].Left2) {
  open Gr ;
  open AbL[Gr] ;
  open TorBase[Gr] ;
  open Gerbes[Gr] ;
  open Coc2[Gr,L] ;
  module GW = GL[w.1] ;
  module CW = PhiG[w] ;
  X : U l = w.1.1 ;
  u (i : L) : X = w.2.1 i ;
  p (i j : L) : Id X (u i) (u j) = w.2.2 i j ;
  c (i j k : L) : A = CW.c i j k ;
  act (x y : X) (a : A) (h : Id X x y) : Id X x y = GW.pact x y a h ;

  delta (b : L -> L -> A) (i j k : L) : A = add (add (b i j) (b j k)) (inv (b i k)) ;

  -- prefixing a path is equivariant:  q (a . h) = a . (q h)
  pre-eqv (x y z : X) (q : Id X x y) (a : A) (h : Id X y z)
    : Id (Id X x z) (trans X x y z q (act y z a h)) (act x z a (trans X x y z q h)) =
    calc (Id X x z) {
      trans X x y z q (trans X y y z (GW.binv y a) h)
        =< symH (tassoc X x y y q (GW.binv y a) z h)
        > trans X x y z (trans X x y y q (GW.binv y a)) h
        =< ap (Id X x y) (Id X x z) (\ r -> trans X x y z r h)
             (trans X x y y q (GW.binv y a)) (trans X x x y (GW.binv x a) q)
             (symH (transH (ap (Id X x x) (Id X x y) (\ r -> trans X x x y r q)
                               (GW.binv x a) (trans X x y x (trans X x y y q (GW.binv y a)) (sym X x y q))
                               (transH (ap A (Id X x x) (GW.binv x) a
                                          (GW.bnd x (trans X x y x (trans X x y y q (GW.binv y a)) (sym X x y q)))
                                          (symH (transH (ap (Id X x y) A
                                                   (\ r -> GW.bnd x (trans X x y x (trans X x y y r (GW.binv y a)) (sym X x y q)))
                                                   q (sym X y x (sym X x y q)) (symH (sym-sym X x y q)))
                                                (transH (GW.band-conj y (GW.binv y a) x (sym X x y q)) (GW.bsec y a)))))
                                       (GW.bret x (trans X x y x (trans X x y y q (GW.binv y a)) (sym X x y q)))))
                           (cancel-r' X x x y (trans X x y y q (GW.binv y a)) q)))
        > trans X x y z (trans X x x y (GW.binv x a) q) h
        =< tassoc X x x y (GW.binv x a) q z h > trans X x x z (GW.binv x a) (trans X x y z q h) } ;

  ----------------------------------------------------------------------
  -- stage 1: changing the paths by b changes the cocycle by delta b

  alg (c0 x y z : A) : Id A (add (add c0 (add (add x y) (inv z))) z) (add x (add y c0)) =
    calc A {
      add (add c0 (add (add x y) (inv z))) z
        =< assoc c0 (add (add x y) (inv z)) z > add c0 (add (add (add x y) (inv z)) z)
        =< ap A A (add c0) (add (add (add x y) (inv z)) z) (add x y)
             (transH (assoc (add x y) (inv z) z)
                (transH (ap A A (add (add x y)) (add (inv z) z) o (invl z)) (unitr (add x y))))
        > add c0 (add x y)
        =< comm c0 (add x y) > add (add x y) c0
        =< assoc x y c0 > add x (add y c0) } ;

  module Change (b : L -> L -> A) {
    p' (i j : L) : Id X (u i) (u j) = act (u i) (u j) (b i j) (p i j) ;
    w' : Left2 = (w.1, w.2.1, p') ;
    module C' = CDiff[Gr,L,w'] ;
    c' (i j k : L) : A = PhiG[w'].c i j k ;

    key (i j k : L) : Id (Id X (u i) (u k)) (act (u i) (u k) (add (c i j k) (delta b i j k)) (p' i k))
                                          (trans X (u i) (u j) (u k) (p' i j) (p' j k)) =
      symH (calc (Id X (u i) (u k)) {
        trans X (u i) (u j) (u k) (p' i j) (p' j k)
          =< tassoc X (u i) (u i) (u j) (GW.binv (u i) (b i j)) (p i j) (u k) (p' j k)
          > act (u i) (u k) (b i j) (trans X (u i) (u j) (u k) (p i j) (p' j k))
          =< ap (Id X (u i) (u k)) (Id X (u i) (u k)) (act (u i) (u k) (b i j))
               (trans X (u i) (u j) (u k) (p i j) (p' j k))
               (act (u i) (u k) (b j k) (trans X (u i) (u j) (u k) (p i j) (p j k)))
               (pre-eqv (u i) (u j) (u k) (p i j) (b j k) (p j k))
          > act (u i) (u k) (b i j) (act (u i) (u k) (b j k) (trans X (u i) (u j) (u k) (p i j) (p j k)))
          =< ap (Id X (u i) (u k)) (Id X (u i) (u k)) (\ r -> act (u i) (u k) (b i j) (act (u i) (u k) (b j k) r))
               (trans X (u i) (u j) (u k) (p i j) (p j k)) (act (u i) (u k) (c i j k) (p i k))
               (symH (CDiff[Gr,L,w].cdiff i j k))
          > act (u i) (u k) (b i j) (act (u i) (u k) (b j k) (act (u i) (u k) (c i j k) (p i k)))
          =< ap (Id X (u i) (u k)) (Id X (u i) (u k)) (act (u i) (u k) (b i j))
               (act (u i) (u k) (b j k) (act (u i) (u k) (c i j k) (p i k)))
               (act (u i) (u k) (add (b j k) (c i j k)) (p i k))
               (symH (GW.pad (u i) (u k) (b j k) (c i j k) (p i k)))
          > act (u i) (u k) (b i j) (act (u i) (u k) (add (b j k) (c i j k)) (p i k))
          =< symH (GW.pad (u i) (u k) (b i j) (add (b j k) (c i j k)) (p i k))
          > act (u i) (u k) (add (b i j) (add (b j k) (c i j k))) (p i k)
          =< ap A (Id X (u i) (u k)) (\ a -> act (u i) (u k) a (p i k))
               (add (b i j) (add (b j k) (c i j k))) (add (add (c i j k) (delta b i j k)) (b i k))
               (symH (alg (c i j k) (b i j) (b j k) (b i k)))
          > act (u i) (u k) (add (add (c i j k) (delta b i j k)) (b i k)) (p i k)
          =< GW.pad (u i) (u k) (add (c i j k) (delta b i j k)) (b i k) (p i k)
          > act (u i) (u k) (add (c i j k) (delta b i j k)) (p' i k) }) ;

    -- the new cocycle is c + delta b
    thm (i j k : L) : Id A (c' i j k) (add (c i j k) (delta b i j k)) =
      transH (symH (D[Id X (u i) (u k), GW.PT (u i) (u k)].uniq (p' i k) (trans X (u i) (u j) (u k) (p' i j) (p' j k))
                      (c' i j k) (C'.cdiff i j k)))
             (D[Id X (u i) (u k), GW.PT (u i) (u k)].uniq (p' i k) (trans X (u i) (u j) (u k) (p' i j) (p' j k))
                (add (c i j k) (delta b i j k)) (key i j k)) ;
  } ;

  ----------------------------------------------------------------------
  -- stage 2: objects with paths are cochains bounding -c

  Obj : U l = (y : X) * ((i : L) -> Id X (u i) y) ;
  CobP (b : L -> L -> A) : U l = (i j k : L) -> Id A (add (c i j k) (delta b i j k)) o ;
  CobT : U l = (b : L -> L -> A) * CobP b ;
  PP : U l = (i j : L) -> Id X (u i) (u j) ;

  -- the paths  r i . (r j)^-1
  rr (o' : Obj) (i j : L) : Id X (u i) (u j) =
    trans X (u i) o'.1 (u j) (o'.2 i) (sym X (u j) o'.1 (o'.2 j)) ;
  bOf (o' : Obj) (i j : L) : A = D[Id X (u i) (u j), GW.PT (u i) (u j)].diff (p i j) (rr o' i j) ;
  bOf-act (o' : Obj) (i j : L) : Id (Id X (u i) (u j)) (act (u i) (u j) (bOf o' i j) (p i j)) (rr o' i j) =
    D[Id X (u i) (u j), GW.PT (u i) (u j)].dact (p i j) (rr o' i j) ;

  wr (o' : Obj) : Left2 = (w.1, w.2.1, rr o') ;

  -- the paths rr have cocycle 0
  rr-zero (o' : Obj) (i j k : L) : Id A ((phi2 (wr o')).1 i j k) o =
    transH (ap (Id X (u i) (u i)) A (GW.bnd (u i))
               (trans X (u i) (u k) (u i) (trans X (u i) (u j) (u k) (rr o' i j) (rr o' j k)) (sym X (u i) (u k) (rr o' i k)))
               (refl (u i))
               (transH (ap (Id X (u i) (u k)) (Id X (u i) (u i))
                           (\ r -> trans X (u i) (u k) (u i) r (sym X (u i) (u k) (rr o' i k)))
                           (trans X (u i) (u j) (u k) (rr o' i j) (rr o' j k)) (rr o' i k)
                           (cancel-mid X (u j) (u i) o'.1 (o'.2 i) (o'.2 j) (u k) (sym X (u k) o'.1 (o'.2 k))))
                       (trans-sym-r X (u i) (u k) (rr o' i k))))
           (GW.bnd-refl (u i)) ;

  w-eq (o' : Obj) : Id Left2 (Change[bOf o'].w') (wr o') =
    P1.ap PP Left2 (\ P -> (w.1, w.2.1, P)) (Change[bOf o'].p') (rr o')
      (FL.funext L (\ i -> (j : L) -> Id X (u i) (u j)) (Change[bOf o'].p') (rr o') (\ i ->
         FL.funext L (\ j -> Id X (u i) (u j)) (Change[bOf o'].p' i) (rr o' i) (\ j -> bOf-act o' i j))) ;

  cond (o' : Obj) : CobP (bOf o') = \ i j k ->
    transH (symH (Change[bOf o'].thm i j k))
      (transH (P1.ap Left2 A (\ v -> (phi2 v).1 i j k) (Change[bOf o'].w') (wr o') (w-eq o'))
              (rr-zero o' i j k)) ;

  theta (o' : Obj) : CobT = (bOf o', cond o') ;

  cob-prop (b : L -> L -> A) : isProp (CobP b) =
    FL.isProp-Pi L (\ i -> (j k : L) -> Id A (add (c i j k) (delta b i j k)) o) (\ i ->
    FL.isProp-Pi L (\ j -> (k : L) -> Id A (add (c i j k) (delta b i j k)) o) (\ j ->
    FL.isProp-Pi L (\ k -> Id A (add (c i j k) (delta b i j k)) o) (\ k ->
      setA (add (c i j k) (delta b i j k)) o))) ;

  cobT-set : isSet CobT =
    isSet-sub (L -> L -> A) CobP
      (FL.isSet-Pi L (\ i -> L -> A) (\ i -> FL.isSet-Pi L (\ j -> A) (\ j -> setA))) cob-prop ;

  TFib (cb : CobT) : U l = (o' : Obj) * Id CobT (theta o') cb ;

  module Fibre (cb : CobT) (i0 : L) {
    module CH = Change[cb.1] ;

    -- the changed paths have cocycle 0, so  p' i i0 = p' i j . p' j i0
    tri (i j : L) : Id (Id X (u i) (u i0)) (CH.p' i i0) (trans X (u i) (u j) (u i0) (CH.p' i j) (CH.p' j i0)) =
      transH (symH (GW.pze (u i) (u i0) (CH.p' i i0)))
        (transH (ap A (Id X (u i) (u i0)) (\ a -> act (u i) (u i0) a (CH.p' i i0)) o (CH.c' i j i0)
                    (symH (transH (CH.thm i j i0) (cb.2 i j i0))))
                (CH.C'.cdiff i j i0)) ;

    o0 : Obj = (u i0, \ i -> CH.p' i i0) ;

    pp (i j : L) : Id (Id X (u i) (u j)) (CH.p' i j) (rr o0 i j) =
      transH (symH (cancel-r X (u i) (u j) (u i0) (CH.p' i j) (CH.p' j i0)))
        (ap (Id X (u i) (u i0)) (Id X (u i) (u j))
            (\ r -> trans X (u i) (u i0) (u j) r (sym X (u j) (u i0) (CH.p' j i0)))
            (trans X (u i) (u j) (u i0) (CH.p' i j) (CH.p' j i0)) (CH.p' i i0) (symH (tri i j))) ;

    b-eq (i j : L) : Id A (bOf o0 i j) (cb.1 i j) =
      D[Id X (u i) (u j), GW.PT (u i) (u j)].uniq (p i j) (rr o0 i j) (cb.1 i j) (pp i j) ;

    centre : TFib cb =
      (o0, Sigma-eq (L -> L -> A) CobP (bOf o0) cb.1 (cond o0) cb.2
             (FL.funext L (\ i -> L -> A) (bOf o0) cb.1 (\ i ->
                FL.funext L (\ j -> A) (bOf o0 i) (cb.1 i) (\ j -> b-eq i j)))
             (cob-prop cb.1)) ;

    -- p' i i0 . r i0 = r i
    pt (z : TFib cb) (i : L) : Id (Id X (u i) z.1.1) (trans X (u i) (u i0) z.1.1 (CH.p' i i0) (z.1.2 i0)) (z.1.2 i) =
      transH (ap (Id X (u i) (u i0)) (Id X (u i) z.1.1) (\ r -> trans X (u i) (u i0) z.1.1 r (z.1.2 i0))
                 (CH.p' i i0) (rr z.1 i i0)
                 (transH (ap A (Id X (u i) (u i0)) (\ a -> act (u i) (u i0) a (p i i0)) (cb.1 i i0) (bOf z.1 i i0)
                             (ap CobT A (\ v -> v.1 i i0) cb (theta z.1) (symH z.2)))
                         (bOf-act z.1 i i0)))
             (cancel-r' X (u i) (u i0) z.1.1 (z.1.2 i) (z.1.2 i0)) ;

    opath (z : TFib cb) : Id Obj o0 z.1 =
      Sigma-path X (\ y -> (i : L) -> Id X (u i) y) (u i0) z.1.1 o0.2 z.1.2 (z.1.2 i0)
        (FL.funext L (\ i -> Id X (u i) z.1.1)
           (subst X (\ y -> (i : L) -> Id X (u i) y) (u i0) z.1.1 (z.1.2 i0) o0.2) z.1.2
           (\ i -> transH (transport-post-pi X L u (u i0) o0.2 z.1.1 (z.1.2 i0) i) (pt z i))) ;

    contr (z : TFib cb) : Id (TFib cb) centre z =
      Sigma-eq Obj (\ o' -> Id CobT (theta o') cb) o0 z.1 centre.2 z.2 (opath z) (cobT-set (theta z.1) cb) ;
  } ;

  -- objects with paths ~ cochains with  c + delta b = 0
  module Objects (hL : Tr.Trunc[L].carrier) {
    fib (cb : CobT) : isContr (TFib cb) =
      Tr.Trunc[L].induction @l (\ v -> isContr (TFib cb)) (\ v -> isProp-isContr (TFib cb))
        (\ i0 -> (Fibre[cb, i0].centre, Fibre[cb, i0].contr)) hL ;

    theta-equiv : Equiv Obj CobT =
      (theta, qinv Obj CobT theta (\ cb -> (fib cb).1.1) (\ cb -> (fib cb).1.2)
                (\ o' -> ap (TFib (theta o')) Obj (\ z -> z.1) (fib (theta o')).1 (o', refl (theta o'))
                           ((fib (theta o')).2 (o', refl (theta o'))))) ;
  } ;
} ;
