-- Gerbe74.seg: SAG Theorem 7.4.7.  For an abelian group A and L with ||L||,
--   phi2 : (G : A-gerbe) * (u : L -> G) * ((i j : L) -> u i = u j)  ->  L-2-cocycles
-- is an equivalence.  Being an equivalence is a proposition, so we may
-- assume a point i0 : L.  Then every fibre is contractible:
--   centre       the trivial gerbe K with points k0 and the loops of
--                band c i0 i j (Psi); it is sent to c by the cocycle law
--                at (i0, i, j, k) (phipsi);
--   contraction  each (G, u, p) is identified with Psi i0 (phi2 (G, u, p))
--                by the trivialisation G ~ K (Trivialise) and the
--                structure identity principle (Sip2).

level l ;
open Base ;
open Prelude[l] ;
open Paths[l] ;
open FunExtUA[l] ;
open Torsor[l] ;
open TorsorId[l] ;
open Groupoid[l] ;
open Gerbe[l] ;
open Cocycle2[l] ;
open TrivialGerbe[l] ;
open Trivialise[l] ;
open Sip2[l] ;
module Tr = Truncation[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module P1 = Prelude[l+] ;
module E1 = FunExtUA[l+] ;

module M74 (Gr : Ab) (L : U l) (hL : Tr.Trunc[L].carrier) {
  open Gr ;
  open AbL[Gr] ;
  open TorBase[Gr] ;
  open TorId[Gr] ;
  open Gerbes[Gr] ;
  open TrivG[Gr] ;
  open Coc2[Gr,L] ;
  open SipG[Gr,L] ;
  module GK = GL[KG] ;
  CC : U l = Coc2[Gr,L].Coc2 ;

  -- the trivial gerbe with the loops of band c i0 i j
  Psi (i0 : L) (c : CC) : Left2 = (KG, \ i -> k0, \ i j -> GK.binv k0 (c.1 i0 i j)) ;

  cpsi (i0 : L) (c : CC) (i j k : L) : Id A (PhiG[Psi i0 c].c i j k) (c.1 i j k) =
    calc A {
      kb k0 (trans K k0 k0 k0 (trans K k0 k0 k0 (GK.binv k0 (c.1 i0 i j)) (GK.binv k0 (c.1 i0 j k)))
               (sym K k0 k0 (GK.binv k0 (c.1 i0 i k))))
        =< GK.bhom k0 (trans K k0 k0 k0 (GK.binv k0 (c.1 i0 i j)) (GK.binv k0 (c.1 i0 j k)))
             (sym K k0 k0 (GK.binv k0 (c.1 i0 i k)))
        > add (kb k0 (trans K k0 k0 k0 (GK.binv k0 (c.1 i0 i j)) (GK.binv k0 (c.1 i0 j k))))
              (kb k0 (sym K k0 k0 (GK.binv k0 (c.1 i0 i k))))
        =< ap A A (\ t -> add t (kb k0 (sym K k0 k0 (GK.binv k0 (c.1 i0 i k)))))
             (kb k0 (trans K k0 k0 k0 (GK.binv k0 (c.1 i0 i j)) (GK.binv k0 (c.1 i0 j k))))
             (add (c.1 i0 i j) (c.1 i0 j k))
             (transH (GK.bhom k0 (GK.binv k0 (c.1 i0 i j)) (GK.binv k0 (c.1 i0 j k)))
                (transH (ap A A (\ t -> add t (kb k0 (GK.binv k0 (c.1 i0 j k))))
                           (kb k0 (GK.binv k0 (c.1 i0 i j))) (c.1 i0 i j) (GK.bsec k0 (c.1 i0 i j)))
                        (ap A A (add (c.1 i0 i j)) (kb k0 (GK.binv k0 (c.1 i0 j k))) (c.1 i0 j k)
                           (GK.bsec k0 (c.1 i0 j k)))))
        > add (add (c.1 i0 i j) (c.1 i0 j k)) (kb k0 (sym K k0 k0 (GK.binv k0 (c.1 i0 i k))))
        =< ap A A (add (add (c.1 i0 i j) (c.1 i0 j k)))
             (kb k0 (sym K k0 k0 (GK.binv k0 (c.1 i0 i k)))) (inv (c.1 i0 i k))
             (transH (GK.bnd-sym k0 (GK.binv k0 (c.1 i0 i k)))
                     (ap A A inv (kb k0 (GK.binv k0 (c.1 i0 i k))) (c.1 i0 i k) (GK.bsec k0 (c.1 i0 i k))))
        > add (add (c.1 i0 i j) (c.1 i0 j k)) (inv (c.1 i0 i k))
        =< ap A A (\ t -> add t (inv (c.1 i0 i k))) (add (c.1 i0 i j) (c.1 i0 j k))
             (add (c.1 i j k) (c.1 i0 i k)) (c.2 i0 i j k)
        > add (add (c.1 i j k) (c.1 i0 i k)) (inv (c.1 i0 i k))
        =< assoc (c.1 i j k) (c.1 i0 i k) (inv (c.1 i0 i k))
        > add (c.1 i j k) (add (c.1 i0 i k) (inv (c.1 i0 i k)))
        =< ap A A (add (c.1 i j k)) (add (c.1 i0 i k) (inv (c.1 i0 i k))) o (invr (c.1 i0 i k))
        > add (c.1 i j k) o
        =< unitr (c.1 i j k) > c.1 i j k } ;

  coc2-prop (c : L -> L -> L -> A) : isProp (CocP2 c) =
    FL.isProp-Pi L (\ i -> (j k m : L) -> Id A (add (c i j k) (c i k m)) (add (c j k m) (c i j m))) (\ i ->
    FL.isProp-Pi L (\ j -> (k m : L) -> Id A (add (c i j k) (c i k m)) (add (c j k m) (c i j m))) (\ j ->
    FL.isProp-Pi L (\ k -> (m : L) -> Id A (add (c i j k) (c i k m)) (add (c j k m) (c i j m))) (\ k ->
    FL.isProp-Pi L (\ m -> Id A (add (c i j k) (c i k m)) (add (c j k m) (c i j m))) (\ m ->
      setA (add (c i j k) (c i k m)) (add (c j k m) (c i j m)))))) ;

  coc2-set : isSet CC =
    isSet-sub (L -> L -> L -> A) CocP2
      (FL.isSet-Pi L (\ i -> L -> L -> A) (\ i -> FL.isSet-Pi L (\ j -> L -> A)
         (\ j -> FL.isSet-Pi L (\ k -> A) (\ k -> setA))))
      coc2-prop ;

  phipsi (i0 : L) (c : CC) : Id CC (phi2 (Psi i0 c)) c =
    Sigma-eq (L -> L -> L -> A) CocP2 (PhiG[Psi i0 c].c) c.1 (PhiG[Psi i0 c].coc) c.2
      (FL.funext L (\ i -> L -> L -> A) (PhiG[Psi i0 c].c) c.1 (\ i ->
        FL.funext L (\ j -> L -> A) (PhiG[Psi i0 c].c i) (c.1 i) (\ j ->
          FL.funext L (\ k -> A) (PhiG[Psi i0 c].c i j) (c.1 i j) (\ k -> cpsi i0 c i j k))))
      (coc2-prop c.1) ;

  -- every gerbe with points and paths is identified with Psi of its cocycle
  back (i0 : L) (w : Left2) : Id Left2 w (Psi i0 (phi2 w)) =
    sip2 w.1.1 w.1.2 w.2.1 w.2.2 K Triv[Gr,L,w,i0].Feq KG.2 (\ i -> k0)
      (\ i j -> GK.binv k0 ((phi2 w).1 i0 i j))
      Triv[Gr,L,w,i0].Fbp Triv[Gr,L,w,i0].qpt Triv[Gr,L,w,i0].compat ;

  Fib (c : CC) : U l+ = (w : Left2) * Id CC (phi2 w) c ;

  fib-contr (c : CC) : E1.isContr (Fib c) =
    Tr.Trunc[L].induction @(l+) (\ v -> E1.isContr (Fib c)) (\ v -> Torsor[l+].isProp-isContr (Fib c))
      (\ i0 -> ((Psi i0 c, phipsi i0 c),
                \ z -> P1.Sigma-eq Left2 (\ w -> Id CC (phi2 w) c) (Psi i0 c) z.1 (phipsi i0 c) z.2
                         (P1.trans Left2 (Psi i0 c) (Psi i0 (phi2 z.1)) z.1
                            (P1.ap CC Left2 (Psi i0) c (phi2 z.1) (symH z.2))
                            (P1.sym Left2 z.1 (Psi i0 (phi2 z.1)) (back i0 z.1)))
                         (coc2-set (phi2 z.1) c)))
      hL ;

  -- SAG Theorem 7.4.7
  theorem-7-4-7 : P1.Equiv Left2 CC =
    (phi2, P1.qinv Left2 CC phi2 (\ c -> (fib-contr c).1.1) (\ c -> (fib-contr c).1.2)
             (\ w -> P1.ap (Fib (phi2 w)) Left2 (\ z -> z.1) (fib-contr (phi2 w)).1 (w, refl (phi2 w))
                       ((fib-contr (phi2 w)).2 (w, refl (phi2 w))))) ;
} ;
