-- Gerbe.seg: A-banded gerbes (SAG Definition 7.4.6, torsor3.pdf 3), and
-- three lemmas towards SAG Theorem 7.4.7:
--   band-conj    the band is compatible with conjugation:
--                beta_b (q^-1 l q) = beta_a l    (path induction on q;
--                transport in x |-> (x = x) is conjugation, transport-conj)
--   PT           the paths x = y form an A-torsor: a . h = beta_x^-1(a) h
--   GE.equiv     a map of A-gerbes preserving the bands is an equivalence:
--                on paths it is an equivariant map of torsors (TorsorId.HE),
--                so an embedding; with connectedness, a surjection.
--
-- A gerbe is a 1-type (torsor3.pdf 3), merely inhabited and connected,
-- with for each x a group isomorphism beta_x : (x = x) -> A, given by
-- contractible fibres (so that being a band iso is a proposition).  Being a
-- 1-type is a proposition; in SAG it follows from the band.

level l ;
open Base ;
open Prelude[l] ;
open Paths[l] ;
open FunExtUA[l] ;
open Torsor[l] ;
open TorsorId[l] ;
open Groupoid[l] ;
module Tr = Truncation[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;

------------------------------------------------------------------------
-- gerbes

module Gerbes (Gr : Ab) {
  open Gr ;
  open AbL[Gr] ;
  open TorBase[Gr] ;
  open TorId[Gr] ;

  -- a group isomorphism (x = x) -> A
  Band (X : U l) (x : X) : U l =
    (b : Id X x x -> A) * (be : (a : A) -> isContr ((lp : Id X x x) * Id A (b lp) a))
    * ((p q : Id X x x) -> Id A (b (trans X x x x p q)) (add (b p) (b q))) ;

  AGerbe : U l+ =
    (X : U l) * (gpd : (a b : X) -> isSet (Id X a b))
    * (inh : Tr.Trunc[X].carrier) * (conn : (a b : X) -> Tr.Trunc[Id X a b].carrier)
    * ((x : X) -> Band X x) ;

  module GL (Gb : AGerbe) {
    X : U l = Gb.1 ;
    gpd : (a b : X) -> isSet (Id X a b) = Gb.2.1 ;
    conn : (a b : X) -> Tr.Trunc[Id X a b].carrier = Gb.2.2.2.1 ;
    bnd (x : X) : Id X x x -> A = (Gb.2.2.2.2 x).1 ;
    be (x : X) : (a : A) -> isContr ((lp : Id X x x) * Id A (bnd x lp) a) = (Gb.2.2.2.2 x).2.1 ;
    bhom (x : X) : (p q : Id X x x) -> Id A (bnd x (trans X x x x p q)) (add (bnd x p) (bnd x q)) =
      (Gb.2.2.2.2 x).2.2 ;
    binv (x : X) (a : A) : Id X x x = (be x a).1.1 ;
    bsec (x : X) (a : A) : Id A (bnd x (binv x a)) a = (be x a).1.2 ;
    bret (x : X) (lp : Id X x x) : Id (Id X x x) (binv x (bnd x lp)) lp =
      ap ((k : Id X x x) * Id A (bnd x k) (bnd x lp)) (Id X x x) (\ z -> z.1)
         (be x (bnd x lp)).1 (lp, refl (bnd x lp)) ((be x (bnd x lp)).2 (lp, refl (bnd x lp))) ;

    -- SAG 7.4.6 / torsor3 3: the band commutes with conjugation
    band-conj (a : X) (lp : Id X a a) : (b : X) (q : Id X a b)
      -> Id A (bnd b (trans X b a b (trans X b a a (sym X a b q) lp) q)) (bnd a lp) =
      \ b q -> idJ X a (\ b' q' -> Id A (bnd b' (trans X b' a b' (trans X b' a a (sym X a b' q') lp) q'))
                                         (bnd a lp))
                 (ap (Id X a a) A (bnd a) (trans X a a a (refl a) lp) lp (trans-refl-l X a a lp)) b q ;

    -- beta_x refl = 0, and beta_x^-1 is a homomorphism
    bnd-refl (x : X) : Id A (bnd x (refl x)) o =
      transH (solve (bnd x (refl x)) (bnd x (refl x)) (bnd x (refl x)) (symH (bhom x (refl x) (refl x))))
             (invr (bnd x (refl x))) ;

    binv-o (x : X) : Id (Id X x x) (binv x o) (refl x) =
      transH (ap A (Id X x x) (binv x) o (bnd x (refl x)) (symH (bnd-refl x)))
             (bret x (refl x)) ;

    binv-add (x : X) (a c : A) : Id (Id X x x) (binv x (add a c)) (trans X x x x (binv x a) (binv x c)) =
      transH (ap A (Id X x x) (binv x) (add a c) (bnd x (trans X x x x (binv x a) (binv x c)))
                 (symH (transH (bhom x (binv x a) (binv x c))
                               (transH (ap A A (\ t -> add t (bnd x (binv x c))) (bnd x (binv x a)) a
                                           (bsec x a))
                                       (ap A A (add a) (bnd x (binv x c)) c (bsec x c))))))
             (bret x (trans X x x x (binv x a) (binv x c))) ;

    -- beta_x l^-1 = - beta_x l
    bnd-sym (x : X) (lp : Id X x x) : Id A (bnd x (sym X x x lp)) (inv (bnd x lp)) =
      transH (solve (bnd x (sym X x x lp)) (bnd x lp) o
                (transH (comm (bnd x (sym X x x lp)) (bnd x lp))
                   (transH (symH (bhom x lp (sym X x x lp)))
                      (transH (ap (Id X x x) A (bnd x) (trans X x x x lp (sym X x x lp)) (refl x)
                                  (trans-sym-r X x x lp))
                              (bnd-refl x)))))
             (unitl (inv (bnd x lp))) ;

    ------------------------------------------------------------------
    -- the paths x = y form an A-torsor

    pact (x y : X) (a : A) (h : Id X x y) : Id X x y = trans X x x y (binv x a) h ;

    pad (x y : X) : AD (Id X x y) (pact x y) = \ a c h ->
      transH (ap (Id X x x) (Id X x y) (\ k -> trans X x x y k h) (binv x (add a c))
                 (trans X x x x (binv x a) (binv x c)) (binv-add x a c))
             (tassoc X x x x (binv x a) (binv x c) y h) ;

    pze (x y : X) : ZE (Id X x y) (pact x y) = \ h ->
      transH (ap (Id X x x) (Id X x y) (\ k -> trans X x x y k h) (binv x o) (refl x) (binv-o x))
             (trans-refl-l X x y h) ;

    -- the a with  a . h = h'  is  beta_x (h' h^-1)
    pft (x y : X) : FT (Id X x y) (pact x y) = \ h h' ->
      ((bnd x (trans X x y x h' (sym X x y h)),
        transH (ap (Id X x x) (Id X x y) (\ k -> trans X x x y k h)
                   (binv x (bnd x (trans X x y x h' (sym X x y h)))) (trans X x y x h' (sym X x y h))
                   (bret x (trans X x y x h' (sym X x y h))))
               (cancel-r' X x x y h' h)),
       \ w -> Sigma-eq A (\ a -> Id (Id X x y) (pact x y a h) h')
                (bnd x (trans X x y x h' (sym X x y h))) w.1
                (transH (ap (Id X x x) (Id X x y) (\ k -> trans X x x y k h)
                           (binv x (bnd x (trans X x y x h' (sym X x y h)))) (trans X x y x h' (sym X x y h))
                           (bret x (trans X x y x h' (sym X x y h))))
                        (cancel-r' X x x y h' h))
                w.2
                (transH (ap (Id X x x) A (bnd x) (trans X x y x h' (sym X x y h)) (binv x w.1)
                           (symH (transH (symH (cancel-r X x x y (binv x w.1) h))
                                         (ap (Id X x y) (Id X x x) (\ k -> trans X x y x k (sym X x y h))
                                             (pact x y w.1 h) h' w.2))))
                        (bsec x w.1))
                (gpd x y (pact x y w.1 h) h')) ;

    PT (x y : X) : TorStr (Id X x y) =
      (pact x y, gpd x y, pad x y, pze x y, pft x y, conn x y) ;
    PTor (x y : X) : Tor = (Id X x y, PT x y) ;
  } ;

  ----------------------------------------------------------------------
  -- a map of gerbes preserving the bands is an equivalence

  module GE (G1 G2 : AGerbe) (F : G1.1 -> G2.1)
    (bp : (x : G1.1) (lp : Id G1.1 x x)
          -> Id A (GL[G2].bnd (F x) (ap G1.1 G2.1 F x x lp)) (GL[G1].bnd x lp)) {
    module L1 = GL[G1] ;
    module L2 = GL[G2] ;
    X1 : U l = G1.1 ;
    X2 : U l = G2.1 ;
    apF (x y : X1) (p : Id X1 x y) : Id X2 (F x) (F y) = ap X1 X2 F x y p ;

    -- F sends beta^-1 a to beta^-1 a
    apF-binv (x : X1) (a : A) : Id (Id X2 (F x) (F x)) (apF x x (L1.binv x a)) (L2.binv (F x) a) =
      transH (symH (L2.bret (F x) (apF x x (L1.binv x a))))
             (ap A (Id X2 (F x) (F x)) (L2.binv (F x)) (L2.bnd (F x) (apF x x (L1.binv x a))) a
                 (transH (bp x (L1.binv x a)) (L1.bsec x a))) ;

    -- on paths, F is an equivariant map of torsors
    apHom (x y : X1) : Hom (L1.PTor x y) (L2.PTor (F x) (F y)) =
      (apF x y,
       \ a h -> transH (ap-trans X1 X2 F x x y (L1.binv x a) h)
                  (ap (Id X2 (F x) (F x)) (Id X2 (F x) (F y)) (\ k -> trans X2 (F x) (F x) (F y) k (apF x y h))
                      (apF x x (L1.binv x a)) (L2.binv (F x) a) (apF-binv x a))) ;

    apEq (x y : X1) : Equiv (Id X1 x y) (Id X2 (F x) (F y)) =
      HE[L1.PTor x y, L2.PTor (F x) (F y), apHom x y].equiv ;

    Fib (y : X2) : U l = (x : X1) * Id X2 (F x) y ;

    -- the fibres are propositions (F is an embedding)
    fib-prop (y : X2) : isProp (Fib y) = emb-fib-prop X1 X2 F (\ x x' -> (apEq x x').2) y ;

    -- and merely inhabited (G1 inhabited, G2 connected)
    fib-inh (y : X2) : Tr.Trunc[Fib y].carrier =
      Tr.Trunc[X1].induction @l (\ t -> Tr.Trunc[Fib y].carrier) (\ t -> Tr.Trunc[Fib y].proposition)
        (\ x -> Tr.Trunc[Id X2 (F x) y].induction @l (\ t -> Tr.Trunc[Fib y].carrier)
                  (\ t -> Tr.Trunc[Fib y].proposition)
                  (\ p -> Tr.Trunc[Fib y].inc (x, p)) (L2.conn (F x) y))
        G1.2.2.1 ;

    fib (y : X2) : isContr (Fib y) =
      Tr.Trunc[Fib y].induction @l (\ t -> isContr (Fib y)) (\ t -> isProp-isContr (Fib y))
        (\ w -> (w, \ w' -> fib-prop y w w')) (fib-inh y) ;

    equiv : Equiv X1 X2 =
      (F, qinv X1 X2 F (\ y -> (fib y).1.1) (\ y -> (fib y).1.2)
            (\ x -> ap (Fib (F x)) X1 (\ z -> z.1) (fib (F x)).1 (x, refl (F x))
                      ((fib (F x)).2 (x, refl (F x))))) ;
  } ;
} ;
