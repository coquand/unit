-- Trivialise.seg: an A-gerbe G with points u : L -> G is trivial, given a
-- point i0 : L.  The map  F : G -> K  sends y to (the preimage in K of)
-- the torsor of paths  u i0 = y.  It preserves the bands (Fbp), hence is
-- an equivalence (Gerbe.GE).

level l ;
open Base ;
open Prelude[l] ;
open Paths[l] ;
open FunExtUA[l] ;
open Torsor[l] ;
open TorsorId[l] ;
open Groupoid[l] ;
open Gerbe[l] ;
open Cocycle2[l] ;
open TrivialGerbe[l] ;
module Tr = Truncation[l] ;
module P1 = Prelude[l+] ;
module G1 = Groupoid[l+] ;

module Triv (Gr : Ab) (L : U l) (w : Coc2[Gr,L].Left2) (i0 : L) {
  open Gr ;
  open AbL[Gr] ;
  open TorBase[Gr] ;
  open TorId[Gr] ;
  open Gerbes[Gr] ;
  open TrivG[Gr] ;
  module GW = GL[w.1] ;
  X : U l = w.1.1 ;
  u (i : L) : X = w.2.1 i ;
  p (i j : L) : Id X (u i) (u j) = w.2.2 i j ;
  u0 : X = u i0 ;

  FT (y : X) : Tor = GW.PTor u0 y ;
  F (y : X) : K = (iota-fib (FT y)).1.1 ;
  qF (y : X) : Id Tor (iota (F y)) (FT y) = (iota-fib (FT y)).1.2 ;

  -- idtohom (ap FT h) is postcomposition with h
  post (y : X) : (y' : X) (h : Id X y y') (k : Id X u0 y)
    -> Id (Id X u0 y') ((idtohom (FT y) (FT y') (P1.ap X Tor FT y y' h)).1 k) (trans X u0 y y' k h) =
    \ y' h -> idJ X y (\ y2 h2 -> (k : Id X u0 y)
                 -> Id (Id X u0 y2) ((idtohom (FT y) (FT y2) (P1.ap X Tor FT y y2 h2)).1 k) (trans X u0 y y2 k h2))
               (\ k -> refl k) y' h ;

  -- naturality of qF
  nat (y : X) : (y' : X) (h : Id X y y')
    -> Id (Id Tor (iota (F y)) (FT y'))
          (P1.trans Tor (iota (F y)) (iota (F y')) (FT y') (P1.ap K Tor iota (F y) (F y') (ap X K F y y' h)) (qF y'))
          (P1.trans Tor (iota (F y)) (FT y) (FT y') (qF y) (P1.ap X Tor FT y y' h)) =
    \ y' h -> idJ X y (\ y2 h2 -> Id (Id Tor (iota (F y)) (FT y2))
                 (P1.trans Tor (iota (F y)) (iota (F y2)) (FT y2) (P1.ap K Tor iota (F y) (F y2) (ap X K F y y2 h2)) (qF y2))
                 (P1.trans Tor (iota (F y)) (FT y) (FT y2) (qF y) (P1.ap X Tor FT y y2 h2)))
               (P1.trans-refl-l Tor (iota (F y)) (FT y) (qF y)) y' h ;

  -- the loop  k l k^-1  has band beta_y l
  binv-conj (y : X) (lp : Id X y y) (k : Id X u0 y)
    : Id (Id X u0 u0) (GW.binv u0 (GW.bnd y lp)) (trans X u0 y u0 (trans X u0 y y k lp) (sym X u0 y k)) =
    transH (ap A (Id X u0 u0) (GW.binv u0) (GW.bnd y lp)
               (GW.bnd u0 (trans X u0 y u0 (trans X u0 y y k lp) (sym X u0 y k)))
               (symH (transH (ap (Id X u0 y) A
                                (\ r -> GW.bnd u0 (trans X u0 y u0 (trans X u0 y y r lp) (sym X u0 y k)))
                                k (sym X y u0 (sym X u0 y k)) (symH (sym-sym X u0 y k)))
                             (GW.band-conj y lp u0 (sym X u0 y k)))))
           (GW.bret u0 (trans X u0 y u0 (trans X u0 y y k lp) (sym X u0 y k))) ;

  -- on loops, FT has band beta_y
  tb-FT (y : X) (lp : Id X y y) : Id A (tb (FT y) (P1.ap X Tor FT y y lp)) (GW.bnd y lp) =
    tb-char (FT y) (P1.ap X Tor FT y y lp) (GW.bnd y lp)
      (hom-eq (FT y) (FT y) (transl (FT y) (GW.bnd y lp)) (idtohom (FT y) (FT y) (P1.ap X Tor FT y y lp))
        (\ k -> transH (transH (ap (Id X u0 u0) (Id X u0 y) (\ r -> trans X u0 u0 y r k)
                                   (GW.binv u0 (GW.bnd y lp))
                                   (trans X u0 y u0 (trans X u0 y y k lp) (sym X u0 y k)) (binv-conj y lp k))
                               (cancel-r' X u0 u0 y (trans X u0 y y k lp) k))
                       (symH (post y y lp k)))) ;

  -- F preserves the bands
  Fbp (y : X) (lp : Id X y y) : Id A (kb (F y) (ap X K F y y lp)) (GW.bnd y lp) =
    calc A {
      tb (iota (F y)) (P1.ap K Tor iota (F y) (F y) (ap X K F y y lp))
        =< P1.ap (Id Tor (iota (F y)) (iota (F y))) A (tb (iota (F y)))
             (P1.ap K Tor iota (F y) (F y) (ap X K F y y lp))
             (P1.trans Tor (iota (F y)) (FT y) (iota (F y))
                (P1.trans Tor (iota (F y)) (FT y) (FT y) (qF y) (P1.ap X Tor FT y y lp)) (P1.sym Tor (iota (F y)) (FT y) (qF y)))
             (P1.trans (Id Tor (iota (F y)) (iota (F y)))
                (P1.ap K Tor iota (F y) (F y) (ap X K F y y lp))
                (P1.trans Tor (iota (F y)) (FT y) (iota (F y))
                   (P1.trans Tor (iota (F y)) (iota (F y)) (FT y) (P1.ap K Tor iota (F y) (F y) (ap X K F y y lp)) (qF y))
                   (P1.sym Tor (iota (F y)) (FT y) (qF y)))
                (P1.trans Tor (iota (F y)) (FT y) (iota (F y))
                   (P1.trans Tor (iota (F y)) (FT y) (FT y) (qF y) (P1.ap X Tor FT y y lp)) (P1.sym Tor (iota (F y)) (FT y) (qF y)))
                (P1.sym (Id Tor (iota (F y)) (iota (F y)))
                   (P1.trans Tor (iota (F y)) (FT y) (iota (F y))
                      (P1.trans Tor (iota (F y)) (iota (F y)) (FT y) (P1.ap K Tor iota (F y) (F y) (ap X K F y y lp)) (qF y))
                      (P1.sym Tor (iota (F y)) (FT y) (qF y)))
                   (P1.ap K Tor iota (F y) (F y) (ap X K F y y lp))
                   (G1.cancel-r Tor (iota (F y)) (iota (F y)) (FT y) (P1.ap K Tor iota (F y) (F y) (ap X K F y y lp)) (qF y)))
                (P1.ap (Id Tor (iota (F y)) (FT y)) (Id Tor (iota (F y)) (iota (F y)))
                   (\ r -> P1.trans Tor (iota (F y)) (FT y) (iota (F y)) r (P1.sym Tor (iota (F y)) (FT y) (qF y)))
                   (P1.trans Tor (iota (F y)) (iota (F y)) (FT y) (P1.ap K Tor iota (F y) (F y) (ap X K F y y lp)) (qF y))
                   (P1.trans Tor (iota (F y)) (FT y) (FT y) (qF y) (P1.ap X Tor FT y y lp))
                   (nat y y lp)))
        > tb (iota (F y)) (P1.trans Tor (iota (F y)) (FT y) (iota (F y))
                (P1.trans Tor (iota (F y)) (FT y) (FT y) (qF y) (P1.ap X Tor FT y y lp)) (P1.sym Tor (iota (F y)) (FT y) (qF y)))
        =< P1.ap (Id Tor (iota (F y)) (FT y)) A
             (\ r -> tb (iota (F y)) (P1.trans Tor (iota (F y)) (FT y) (iota (F y))
                       (P1.trans Tor (iota (F y)) (FT y) (FT y) r (P1.ap X Tor FT y y lp)) (P1.sym Tor (iota (F y)) (FT y) (qF y))))
             (qF y) (P1.sym Tor (FT y) (iota (F y)) (P1.sym Tor (iota (F y)) (FT y) (qF y)))
             (P1.sym (Id Tor (iota (F y)) (FT y)) (P1.sym Tor (FT y) (iota (F y)) (P1.sym Tor (iota (F y)) (FT y) (qF y))) (qF y)
                (G1.sym-sym Tor (iota (F y)) (FT y) (qF y)))
        > tb (iota (F y)) (P1.trans Tor (iota (F y)) (FT y) (iota (F y))
                (P1.trans Tor (iota (F y)) (FT y) (FT y) (P1.sym Tor (FT y) (iota (F y)) (P1.sym Tor (iota (F y)) (FT y) (qF y)))
                   (P1.ap X Tor FT y y lp))
                (P1.sym Tor (iota (F y)) (FT y) (qF y)))
        =< G1.conj-inv Tor A tb (FT y) (P1.ap X Tor FT y y lp) (iota (F y)) (P1.sym Tor (iota (F y)) (FT y) (qF y))
        > tb (FT y) (P1.ap X Tor FT y y lp)
        =< tb-FT y lp > GW.bnd y lp } ;

  Feq : Equiv X K = GE[w.1, KG, F, Fbp].equiv ;

  ----------------------------------------------------------------------
  -- the points: F (u i) = k0

  module CW = Coc2[Gr,L].PhiG[w] ;
  c (i j k : L) : A = CW.c i j k ;
  tri : Id Tor (iota k0) Atriv = img.triangle tt ;

  -- h |-> beta (h . (p i0 i)^-1),  the torsor of paths from u0 to u i is A
  g (i : L) : Hom (FT (u i)) Atriv =
    (\ h -> GW.bnd u0 (trans X u0 (u i) u0 h (sym X u0 (u i) (p i0 i))),
     \ a h -> calc A {
       GW.bnd u0 (trans X u0 (u i) u0 (trans X u0 u0 (u i) (GW.binv u0 a) h) (sym X u0 (u i) (p i0 i)))
         =< ap (Id X u0 u0) A (GW.bnd u0)
              (trans X u0 (u i) u0 (trans X u0 u0 (u i) (GW.binv u0 a) h) (sym X u0 (u i) (p i0 i)))
              (trans X u0 u0 u0 (GW.binv u0 a) (trans X u0 (u i) u0 h (sym X u0 (u i) (p i0 i))))
              (tassoc X u0 u0 (u i) (GW.binv u0 a) h u0 (sym X u0 (u i) (p i0 i)))
         > GW.bnd u0 (trans X u0 u0 u0 (GW.binv u0 a) (trans X u0 (u i) u0 h (sym X u0 (u i) (p i0 i))))
         =< GW.bhom u0 (GW.binv u0 a) (trans X u0 (u i) u0 h (sym X u0 (u i) (p i0 i)))
         > add (GW.bnd u0 (GW.binv u0 a)) (GW.bnd u0 (trans X u0 (u i) u0 h (sym X u0 (u i) (p i0 i))))
         =< ap A A (\ b -> add b (GW.bnd u0 (trans X u0 (u i) u0 h (sym X u0 (u i) (p i0 i)))))
              (GW.bnd u0 (GW.binv u0 a)) a (GW.bsec u0 a)
         > add a (GW.bnd u0 (trans X u0 (u i) u0 h (sym X u0 (u i) (p i0 i)))) }) ;

  Q (i : L) : Id Tor (FT (u i)) Atriv = decode (FT (u i)) Atriv (g i) ;

  -- the path iota (F (u i)) = iota k0 in Tor, and its preimage in K
  tq (i : L) : Id Tor (iota (F (u i))) (iota k0) =
    P1.trans Tor (iota (F (u i))) (FT (u i)) (iota k0) (qF (u i))
      (P1.trans Tor (FT (u i)) Atriv (iota k0) (Q i) (P1.sym Tor (iota k0) Atriv tri)) ;
  qpt (i : L) : Id K (F (u i)) k0 = (emb (F (u i)) k0).sec (tq i) ;

  ----------------------------------------------------------------------
  -- the paths: F (p i j) . qpt j = qpt i . phat i j, with phat of band c i0 i j

  phat (i j : L) : Id K k0 k0 = GL[KG].binv k0 (c i0 i j) ;
  m (i j : L) : Id Tor Atriv Atriv = tloop Atriv (c i0 i j) ;

  -- (h p i j)(p i0 j)^-1 = (h (p i0 i)^-1)((p i0 i . p i j)(p i0 j)^-1)
  hp (i j : L) (h : Id X u0 (u i))
    : Id (Id X u0 u0) (trans X u0 (u j) u0 (trans X u0 (u i) (u j) h (p i j)) (sym X u0 (u j) (p i0 j)))
         (trans X u0 u0 u0 (trans X u0 (u i) u0 h (sym X u0 (u i) (p i0 i))) (CW.lp i0 i j)) =
    symH (transH (symH (tassoc X u0 u0 (u j) (trans X u0 (u i) u0 h (sym X u0 (u i) (p i0 i)))
                         (trans X u0 (u i) (u j) (p i0 i) (p i j)) u0 (sym X u0 (u j) (p i0 j))))
                 (ap (Id X u0 (u j)) (Id X u0 u0) (\ r -> trans X u0 (u j) u0 r (sym X u0 (u j) (p i0 j)))
                     (trans X u0 u0 (u j) (trans X u0 (u i) u0 h (sym X u0 (u i) (p i0 i)))
                        (trans X u0 (u i) (u j) (p i0 i) (p i j)))
                     (trans X u0 (u i) (u j) h (p i j))
                     (cancel-mid X u0 u0 (u i) h (p i0 i) (u j) (p i j)))) ;

  hpt (Y Z : Tor) (f f' : Hom Y Z) (e : Id (Hom Y Z) f f') (t : Y.1) : Id Z.1 (f.1 t) (f'.1 t) =
    ap (Hom Y Z) Z.1 (\ k -> k.1 t) f f' e ;

  keyp (i j : L) (h : Id X u0 (u i))
    : Id A ((idtohom (FT (u i)) Atriv
               (P1.trans Tor (FT (u i)) (FT (u j)) Atriv (P1.ap X Tor FT (u i) (u j) (p i j)) (Q j))).1 h)
           ((idtohom (FT (u i)) Atriv (P1.trans Tor (FT (u i)) Atriv Atriv (Q i) (m i j))).1 h) =
    calc A {
      (idtohom (FT (u i)) Atriv
         (P1.trans Tor (FT (u i)) (FT (u j)) Atriv (P1.ap X Tor FT (u i) (u j) (p i j)) (Q j))).1 h
        =< idtohom-trans (FT (u i)) (FT (u j)) (P1.ap X Tor FT (u i) (u j) (p i j)) Atriv (Q j) h
        > (idtohom (FT (u j)) Atriv (Q j)).1 ((idtohom (FT (u i)) (FT (u j)) (P1.ap X Tor FT (u i) (u j) (p i j))).1 h)
        =< ap (Id X u0 (u j)) A (idtohom (FT (u j)) Atriv (Q j)).1
             ((idtohom (FT (u i)) (FT (u j)) (P1.ap X Tor FT (u i) (u j) (p i j))).1 h)
             (trans X u0 (u i) (u j) h (p i j)) (post (u i) (u j) (p i j) h)
        > (idtohom (FT (u j)) Atriv (Q j)).1 (trans X u0 (u i) (u j) h (p i j))
        =< hpt (FT (u j)) Atriv (idtohom (FT (u j)) Atriv (Q j)) (g j) (idtohom-decode (FT (u j)) Atriv (g j))
             (trans X u0 (u i) (u j) h (p i j))
        > GW.bnd u0 (trans X u0 (u j) u0 (trans X u0 (u i) (u j) h (p i j)) (sym X u0 (u j) (p i0 j)))
        =< ap (Id X u0 u0) A (GW.bnd u0)
             (trans X u0 (u j) u0 (trans X u0 (u i) (u j) h (p i j)) (sym X u0 (u j) (p i0 j)))
             (trans X u0 u0 u0 (trans X u0 (u i) u0 h (sym X u0 (u i) (p i0 i))) (CW.lp i0 i j))
             (hp i j h)
        > GW.bnd u0 (trans X u0 u0 u0 (trans X u0 (u i) u0 h (sym X u0 (u i) (p i0 i))) (CW.lp i0 i j))
        =< GW.bhom u0 (trans X u0 (u i) u0 h (sym X u0 (u i) (p i0 i))) (CW.lp i0 i j)
        > add ((g i).1 h) (c i0 i j)
        =< comm ((g i).1 h) (c i0 i j) > add (c i0 i j) ((g i).1 h)
        =< symH (hpt Atriv Atriv (idtohom Atriv Atriv (m i j)) (transl Atriv (c i0 i j))
                   (idtohom-decode Atriv Atriv (transl Atriv (c i0 i j))) ((g i).1 h))
        > (idtohom Atriv Atriv (m i j)).1 ((g i).1 h)
        =< symH (ap A A (idtohom Atriv Atriv (m i j)).1 ((idtohom (FT (u i)) Atriv (Q i)).1 h) ((g i).1 h)
                   (hpt (FT (u i)) Atriv (idtohom (FT (u i)) Atriv (Q i)) (g i) (idtohom-decode (FT (u i)) Atriv (g i)) h))
        > (idtohom Atriv Atriv (m i j)).1 ((idtohom (FT (u i)) Atriv (Q i)).1 h)
        =< symH (idtohom-trans (FT (u i)) Atriv (Q i) Atriv (m i j) h)
        > (idtohom (FT (u i)) Atriv (P1.trans Tor (FT (u i)) Atriv Atriv (Q i) (m i j))).1 h } ;

  -- the key identity in Tor, compared through idtohom
  key (i j : L) : Id (Id Tor (FT (u i)) Atriv)
      (P1.trans Tor (FT (u i)) (FT (u j)) Atriv (P1.ap X Tor FT (u i) (u j) (p i j)) (Q j))
      (P1.trans Tor (FT (u i)) Atriv Atriv (Q i) (m i j)) =
    P1.trans (Id Tor (FT (u i)) Atriv)
      (P1.trans Tor (FT (u i)) (FT (u j)) Atriv (P1.ap X Tor FT (u i) (u j) (p i j)) (Q j))
      (decode (FT (u i)) Atriv (idtohom (FT (u i)) Atriv
         (P1.trans Tor (FT (u i)) (FT (u j)) Atriv (P1.ap X Tor FT (u i) (u j) (p i j)) (Q j))))
      (P1.trans Tor (FT (u i)) Atriv Atriv (Q i) (m i j))
      (P1.sym (Id Tor (FT (u i)) Atriv)
         (decode (FT (u i)) Atriv (idtohom (FT (u i)) Atriv
            (P1.trans Tor (FT (u i)) (FT (u j)) Atriv (P1.ap X Tor FT (u i) (u j) (p i j)) (Q j))))
         (P1.trans Tor (FT (u i)) (FT (u j)) Atriv (P1.ap X Tor FT (u i) (u j) (p i j)) (Q j))
         (dec-enc (FT (u i)) Atriv
            (P1.trans Tor (FT (u i)) (FT (u j)) Atriv (P1.ap X Tor FT (u i) (u j) (p i j)) (Q j))))
      (P1.trans (Id Tor (FT (u i)) Atriv)
         (decode (FT (u i)) Atriv (idtohom (FT (u i)) Atriv
            (P1.trans Tor (FT (u i)) (FT (u j)) Atriv (P1.ap X Tor FT (u i) (u j) (p i j)) (Q j))))
         (decode (FT (u i)) Atriv (idtohom (FT (u i)) Atriv (P1.trans Tor (FT (u i)) Atriv Atriv (Q i) (m i j))))
         (P1.trans Tor (FT (u i)) Atriv Atriv (Q i) (m i j))
         (P1.ap (Hom (FT (u i)) Atriv) (Id Tor (FT (u i)) Atriv) (decode (FT (u i)) Atriv)
            (idtohom (FT (u i)) Atriv
               (P1.trans Tor (FT (u i)) (FT (u j)) Atriv (P1.ap X Tor FT (u i) (u j) (p i j)) (Q j)))
            (idtohom (FT (u i)) Atriv (P1.trans Tor (FT (u i)) Atriv Atriv (Q i) (m i j)))
            (hom-eq (FT (u i)) Atriv
               (idtohom (FT (u i)) Atriv
                  (P1.trans Tor (FT (u i)) (FT (u j)) Atriv (P1.ap X Tor FT (u i) (u j) (p i j)) (Q j)))
               (idtohom (FT (u i)) Atriv (P1.trans Tor (FT (u i)) Atriv Atriv (Q i) (m i j)))
               (\ h -> keyp i j h)))
         (dec-enc (FT (u i)) Atriv (P1.trans Tor (FT (u i)) Atriv Atriv (Q i) (m i j)))) ;

  ----------------------------------------------------------------------
  -- F (p i j) . qpt j = qpt i . phat i j

  iFi (i : L) : Tor = iota (F (u i)) ;
  ik0 : Tor = iota k0 ;
  a1 (i j : L) : Id Tor (iFi i) (iFi j) = P1.ap K Tor iota (F (u i)) (F (u j)) (ap X K F (u i) (u j) (p i j)) ;
  aFT (i j : L) : Id Tor (FT (u i)) (FT (u j)) = P1.ap X Tor FT (u i) (u j) (p i j) ;
  Tq (i : L) : Id Tor (FT (u i)) ik0 = P1.trans Tor (FT (u i)) Atriv ik0 (Q i) (P1.sym Tor ik0 Atriv tri) ;
  mhat (i j : L) : Id Tor ik0 ik0 =
    P1.trans Tor ik0 Atriv ik0 (P1.trans Tor ik0 Atriv Atriv (P1.sym Tor Atriv ik0 (P1.sym Tor ik0 Atriv tri)) (m i j))
      (P1.sym Tor ik0 Atriv tri) ;

  apF-iota (i j : L) : Id (Id Tor (iFi i) (iFi j)) (a1 i j)
      (P1.trans Tor (iFi i) (FT (u j)) (iFi j) (P1.trans Tor (iFi i) (FT (u i)) (FT (u j)) (qF (u i)) (aFT i j))
         (P1.sym Tor (iFi j) (FT (u j)) (qF (u j)))) =
    P1.trans (Id Tor (iFi i) (iFi j)) (a1 i j)
      (P1.trans Tor (iFi i) (FT (u j)) (iFi j) (P1.trans Tor (iFi i) (iFi j) (FT (u j)) (a1 i j) (qF (u j)))
         (P1.sym Tor (iFi j) (FT (u j)) (qF (u j))))
      (P1.trans Tor (iFi i) (FT (u j)) (iFi j) (P1.trans Tor (iFi i) (FT (u i)) (FT (u j)) (qF (u i)) (aFT i j))
         (P1.sym Tor (iFi j) (FT (u j)) (qF (u j))))
      (P1.sym (Id Tor (iFi i) (iFi j))
         (P1.trans Tor (iFi i) (FT (u j)) (iFi j) (P1.trans Tor (iFi i) (iFi j) (FT (u j)) (a1 i j) (qF (u j)))
            (P1.sym Tor (iFi j) (FT (u j)) (qF (u j))))
         (a1 i j) (G1.cancel-r Tor (iFi i) (iFi j) (FT (u j)) (a1 i j) (qF (u j))))
      (P1.ap (Id Tor (iFi i) (FT (u j))) (Id Tor (iFi i) (iFi j))
         (\ r -> P1.trans Tor (iFi i) (FT (u j)) (iFi j) r (P1.sym Tor (iFi j) (FT (u j)) (qF (u j))))
         (P1.trans Tor (iFi i) (iFi j) (FT (u j)) (a1 i j) (qF (u j)))
         (P1.trans Tor (iFi i) (FT (u i)) (FT (u j)) (qF (u i)) (aFT i j))
         (nat (u i) (u j) (p i j))) ;

  -- loops at ik0 are determined by their band
  tb-inj (c0 : A) (e1 e2 : Id Tor ik0 ik0) (h1 : Id A (tb ik0 e1) c0) (h2 : Id A (tb ik0 e2) c0)
    : Id (Id Tor ik0 ik0) e1 e2 =
    P1.ap ((lp : Id Tor ik0 ik0) * Id A (tb ik0 lp) c0) (Id Tor ik0 ik0) (\ z -> z.1) (e1, h1) (e2, h2)
      (P1.trans ((lp : Id Tor ik0 ik0) * Id A (tb ik0 lp) c0) (e1, h1) (tb-be ik0 c0).1 (e2, h2)
         (P1.sym ((lp : Id Tor ik0 ik0) * Id A (tb ik0 lp) c0) (tb-be ik0 c0).1 (e1, h1) ((tb-be ik0 c0).2 (e1, h1)))
         ((tb-be ik0 c0).2 (e2, h2))) ;

  phat-iota (i j : L) : Id (Id Tor ik0 ik0) (P1.ap K Tor iota k0 k0 (phat i j)) (mhat i j) =
    tb-inj (c i0 i j) (P1.ap K Tor iota k0 k0 (phat i j)) (mhat i j)
      (GL[KG].bsec k0 (c i0 i j))
      (transH (G1.conj-inv Tor A tb Atriv (m i j) ik0 (P1.sym Tor ik0 Atriv tri)) (tb-be Atriv (c i0 i j)).1.2) ;

  -- ap iota is injective on paths of K
  inj (a b : K) (e e' : Id K a b) (E : Id (Id Tor (iota a) (iota b)) (P1.ap K Tor iota a b e) (P1.ap K Tor iota a b e'))
    : Id (Id K a b) e e' =
    transH (symH (P1.sec-ret (Id K a b) (Id Tor (iota a) (iota b)) (P1.ap K Tor iota a b) (emb a b) e))
      (transH (P1.ap (Id Tor (iota a) (iota b)) (Id K a b) (emb a b).sec
                  (P1.ap K Tor iota a b e) (P1.ap K Tor iota a b e') E)
              (P1.sec-ret (Id K a b) (Id Tor (iota a) (iota b)) (P1.ap K Tor iota a b) (emb a b) e')) ;

  compat-tor (i j : L)
    : Id (Id Tor (iFi i) ik0)
         (P1.ap K Tor iota (F (u i)) k0 (trans K (F (u i)) (F (u j)) k0 (ap X K F (u i) (u j) (p i j)) (qpt j)))
         (P1.ap K Tor iota (F (u i)) k0 (trans K (F (u i)) k0 k0 (qpt i) (phat i j))) =
    calc (Id Tor (iFi i) ik0) {
      P1.ap K Tor iota (F (u i)) k0 (trans K (F (u i)) (F (u j)) k0 (ap X K F (u i) (u j) (p i j)) (qpt j))
        =< G1.ap-trans K Tor iota (F (u i)) (F (u j)) k0 (ap X K F (u i) (u j) (p i j)) (qpt j)
        > P1.trans Tor (iFi i) (iFi j) ik0 (a1 i j) (P1.ap K Tor iota (F (u j)) k0 (qpt j))
        =< P1.ap (Id Tor (iFi j) ik0) (Id Tor (iFi i) ik0) (P1.trans Tor (iFi i) (iFi j) ik0 (a1 i j))
             (P1.ap K Tor iota (F (u j)) k0 (qpt j)) (tq j) ((emb (F (u j)) k0).sec-eq (tq j))
        > P1.trans Tor (iFi i) (iFi j) ik0 (a1 i j) (tq j)
        =< P1.ap (Id Tor (iFi i) (iFi j)) (Id Tor (iFi i) ik0) (\ r -> P1.trans Tor (iFi i) (iFi j) ik0 r (tq j))
             (a1 i j)
             (P1.trans Tor (iFi i) (FT (u j)) (iFi j) (P1.trans Tor (iFi i) (FT (u i)) (FT (u j)) (qF (u i)) (aFT i j))
                (P1.sym Tor (iFi j) (FT (u j)) (qF (u j))))
             (apF-iota i j)
        > P1.trans Tor (iFi i) (iFi j) ik0
            (P1.trans Tor (iFi i) (FT (u j)) (iFi j) (P1.trans Tor (iFi i) (FT (u i)) (FT (u j)) (qF (u i)) (aFT i j))
               (P1.sym Tor (iFi j) (FT (u j)) (qF (u j))))
            (P1.trans Tor (iFi j) (FT (u j)) ik0 (qF (u j)) (Tq j))
        =< G1.cancel-mid Tor (iFi j) (iFi i) (FT (u j))
             (P1.trans Tor (iFi i) (FT (u i)) (FT (u j)) (qF (u i)) (aFT i j)) (qF (u j)) ik0 (Tq j)
        > P1.trans Tor (iFi i) (FT (u j)) ik0 (P1.trans Tor (iFi i) (FT (u i)) (FT (u j)) (qF (u i)) (aFT i j)) (Tq j)
        =< G1.tassoc Tor (iFi i) (FT (u i)) (FT (u j)) (qF (u i)) (aFT i j) ik0 (Tq j)
        > P1.trans Tor (iFi i) (FT (u i)) ik0 (qF (u i)) (P1.trans Tor (FT (u i)) (FT (u j)) ik0 (aFT i j) (Tq j))
        =< P1.ap (Id Tor (FT (u i)) ik0) (Id Tor (iFi i) ik0) (P1.trans Tor (iFi i) (FT (u i)) ik0 (qF (u i)))
             (P1.trans Tor (FT (u i)) (FT (u j)) ik0 (aFT i j) (Tq j))
             (P1.trans Tor (FT (u i)) ik0 ik0 (Tq i) (mhat i j))
             (P1.trans (Id Tor (FT (u i)) ik0)
                (P1.trans Tor (FT (u i)) (FT (u j)) ik0 (aFT i j) (Tq j))
                (P1.trans Tor (FT (u i)) Atriv ik0
                   (P1.trans Tor (FT (u i)) (FT (u j)) Atriv (aFT i j) (Q j)) (P1.sym Tor ik0 Atriv tri))
                (P1.trans Tor (FT (u i)) ik0 ik0 (Tq i) (mhat i j))
                (P1.sym (Id Tor (FT (u i)) ik0)
                   (P1.trans Tor (FT (u i)) Atriv ik0
                      (P1.trans Tor (FT (u i)) (FT (u j)) Atriv (aFT i j) (Q j)) (P1.sym Tor ik0 Atriv tri))
                   (P1.trans Tor (FT (u i)) (FT (u j)) ik0 (aFT i j) (Tq j))
                   (G1.tassoc Tor (FT (u i)) (FT (u j)) Atriv (aFT i j) (Q j) ik0 (P1.sym Tor ik0 Atriv tri)))
                (P1.trans (Id Tor (FT (u i)) ik0)
                   (P1.trans Tor (FT (u i)) Atriv ik0
                      (P1.trans Tor (FT (u i)) (FT (u j)) Atriv (aFT i j) (Q j)) (P1.sym Tor ik0 Atriv tri))
                   (P1.trans Tor (FT (u i)) Atriv ik0
                      (P1.trans Tor (FT (u i)) Atriv Atriv (Q i) (m i j)) (P1.sym Tor ik0 Atriv tri))
                   (P1.trans Tor (FT (u i)) ik0 ik0 (Tq i) (mhat i j))
                   (P1.ap (Id Tor (FT (u i)) Atriv) (Id Tor (FT (u i)) ik0)
                      (\ r -> P1.trans Tor (FT (u i)) Atriv ik0 r (P1.sym Tor ik0 Atriv tri))
                      (P1.trans Tor (FT (u i)) (FT (u j)) Atriv (aFT i j) (Q j))
                      (P1.trans Tor (FT (u i)) Atriv Atriv (Q i) (m i j)) (key i j))
                   (G1.conj-move Tor (FT (u i)) Atriv (Q i) (m i j) ik0 (P1.sym Tor ik0 Atriv tri))))
        > P1.trans Tor (iFi i) (FT (u i)) ik0 (qF (u i)) (P1.trans Tor (FT (u i)) ik0 ik0 (Tq i) (mhat i j))
        =< P1.sym (Id Tor (iFi i) ik0)
             (P1.trans Tor (iFi i) ik0 ik0 (tq i) (mhat i j))
             (P1.trans Tor (iFi i) (FT (u i)) ik0 (qF (u i)) (P1.trans Tor (FT (u i)) ik0 ik0 (Tq i) (mhat i j)))
             (G1.tassoc Tor (iFi i) (FT (u i)) ik0 (qF (u i)) (Tq i) ik0 (mhat i j))
        > P1.trans Tor (iFi i) ik0 ik0 (tq i) (mhat i j)
        =< P1.ap (Id Tor ik0 ik0) (Id Tor (iFi i) ik0) (P1.trans Tor (iFi i) ik0 ik0 (tq i))
             (mhat i j) (P1.ap K Tor iota k0 k0 (phat i j))
             (P1.sym (Id Tor ik0 ik0) (P1.ap K Tor iota k0 k0 (phat i j)) (mhat i j) (phat-iota i j))
        > P1.trans Tor (iFi i) ik0 ik0 (tq i) (P1.ap K Tor iota k0 k0 (phat i j))
        =< P1.ap (Id Tor (iFi i) ik0) (Id Tor (iFi i) ik0) (\ r -> P1.trans Tor (iFi i) ik0 ik0 r (P1.ap K Tor iota k0 k0 (phat i j)))
             (tq i) (P1.ap K Tor iota (F (u i)) k0 (qpt i))
             (P1.sym (Id Tor (iFi i) ik0) (P1.ap K Tor iota (F (u i)) k0 (qpt i)) (tq i) ((emb (F (u i)) k0).sec-eq (tq i)))
        > P1.trans Tor (iFi i) ik0 ik0 (P1.ap K Tor iota (F (u i)) k0 (qpt i)) (P1.ap K Tor iota k0 k0 (phat i j))
        =< P1.sym (Id Tor (iFi i) ik0)
             (P1.ap K Tor iota (F (u i)) k0 (trans K (F (u i)) k0 k0 (qpt i) (phat i j)))
             (P1.trans Tor (iFi i) ik0 ik0 (P1.ap K Tor iota (F (u i)) k0 (qpt i)) (P1.ap K Tor iota k0 k0 (phat i j)))
             (G1.ap-trans K Tor iota (F (u i)) k0 k0 (qpt i) (phat i j))
        > P1.ap K Tor iota (F (u i)) k0 (trans K (F (u i)) k0 k0 (qpt i) (phat i j)) } ;

  compat (i j : L)
    : Id (Id K (F (u i)) k0) (trans K (F (u i)) (F (u j)) k0 (ap X K F (u i) (u j) (p i j)) (qpt j))
                             (trans K (F (u i)) k0 k0 (qpt i) (phat i j)) =
    inj (F (u i)) k0 (trans K (F (u i)) (F (u j)) k0 (ap X K F (u i) (u j) (p i j)) (qpt j))
      (trans K (F (u i)) k0 k0 (qpt i) (phat i j)) (compat-tor i j) ;
} ;
