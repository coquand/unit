-- FieldLeading's scan relative to a proposition O: the zero-or-unit
-- decision is only given in the closed modality of O, and "nonzero"
-- becomes an exit "zero -> O".  Pilot of the conversion of the field
-- route.
--
-- Informal proof.  As in FieldLeading.Given: scan the coefficients from
-- the top; a unit coefficient is the leading one, a zero one lowers the
-- bound.  Each decision is used inside the O-modal goal Cl (Result p).
-- A coefficient c_i whose vanishing gives O makes the result leading.
-- Zero, Leading, Result and Normalize are FieldLeading's.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (A : CRing) (O : U l) (propO : Pr.isProp O) {
 module M = ClosedModality[l].Over[O,propO] ;
 module FL = FieldLeading[l].Over[A] ;
 module P = FL.P ; module Bound = FL.Bound ;
 module Given (dec : (a : A.R) -> M.Cl (Plus (Id A.R a A.z) (RL[A].unit a))) {
  scan-step (n : Nat)
   (ih : (p : P.P) -> Bound.Bound n p -> M.Cl (FL.Result p))
   (p : P.P) (bound : Bound.Bound (suc n) p) :
   Plus (Id A.R (P.coef p n) A.z) (RL[A].unit (P.coef p n)) -> M.Cl (FL.Result p) = split {
   inl h -> ih p (Bound.lower-bound n p bound h) ;
   inr u -> M.ret (FL.Result p) (inr (n,u,bound)) } ;
  scan-suc (n : Nat)
   (ih : (p : P.P) -> Bound.Bound n p -> M.Cl (FL.Result p))
   (p : P.P) (bound : Bound.Bound (suc n) p) : M.Cl (FL.Result p) =
   M.bind (Plus (Id A.R (P.coef p n) A.z) (RL[A].unit (P.coef p n))) (FL.Result p)
    (scan-step n ih p bound) (dec (P.coef p n)) ;
  scan : (n : Nat) (p : P.P) -> Bound.Bound n p -> M.Cl (FL.Result p) = split {
   zero -> \ p bound -> M.ret (FL.Result p) (inl bound) ;
   suc n | ih -> scan-suc n ih } ;
  result (p : P.P) : M.Cl (FL.Result p) = scan (P.plen p) p (FL.M.coef-beyond p) ;
  nonzero-result (p : P.P) (i : Nat) (nonzero : Id A.R (P.coef p i) A.z -> O) :
   FL.Result p -> M.Cl (FL.Leading p) = split {
   inl h -> M.exit (FL.Leading p) (nonzero (h i)) ; inr h -> M.ret (FL.Leading p) h } ;
  leading (p : P.P) (i : Nat) (nonzero : Id A.R (P.coef p i) A.z -> O) : M.Cl (FL.Leading p) =
   M.bind (FL.Result p) (FL.Leading p) (nonzero-result p i nonzero) (result p) ;
 } ;
} ;
