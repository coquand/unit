-- The closed modality of a proposition O, used for targets that hold
-- when O does: Cl X = Trunc (O + X).
--
-- Informal account.  A proposition P is O-modal when O -> P.  Cl X is
-- O-modal, and maps Cl X -> P into an O-modal P are maps X -> P: the
-- O-branch is answered by P itself.  So a proof of an O-modal goal may
-- use a hypothesis of the form Cl X as if it were X, and a contradiction
-- "1 = 0" may be replaced by an exit "1 = 0 -> O".  For a proposition O
-- this Cl X is the image of the join O * X in props, which is all that
-- is used: every goal here is an O-modal proposition.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (O : U l) (propO : Pr.isProp O) {
 Cl (X : U l) : U l = Tr.Trunc[Plus O X].carrier ;
 cl-prop (X : U l) : Pr.isProp (Cl X) = Tr.Trunc[Plus O X].proposition ;
 ret (X : U l) (x : X) : Cl X = Tr.Trunc[Plus O X].inc (inr x) ;
 exit (X : U l) (o : O) : Cl X = Tr.Trunc[Plus O X].inc (inl o) ;
 -- An O-modal proposition.
 Modal (P : U l) : U l = Pr.isProp P * (O -> P) ;
 cases (X P : U l) (m : Modal P) (f : X -> P) : Plus O X -> P = split {
  inl o -> m.2 o ; inr x -> f x } ;
 rec (X P : U l) (m : Modal P) (f : X -> P) : Cl X -> P =
  TC.rec (Plus O X) @l P m.1 (cases X P m f) ;
 modal (X : U l) : Modal (Cl X) = (cl-prop X,exit X) ;
 modal-O : Modal O = (propO,\ o -> o) ;
 bind (X Y : U l) (f : X -> Cl Y) : Cl X -> Cl Y = rec X (Cl Y) (modal Y) f ;
 map (X Y : U l) (f : X -> Y) : Cl X -> Cl Y = bind X Y (\ x -> ret Y (f x)) ;
 -- Decision-free lemmas about mere witnesses lift unchanged.
 from-trunc (X : U l) : Tr.Trunc[X].carrier -> Cl X =
  TC.rec X @l (Cl X) (cl-prop X) (ret X) ;
 lift (X Y : U l) (f : Tr.Trunc[X].carrier -> Tr.Trunc[Y].carrier) : Cl X -> Cl Y =
  bind X Y (\ x -> from-trunc Y (f (Tr.Trunc[X].inc x))) ;
} ;
