-- Monic-friendly homogeneous generators in arbitrary affine dimension.
level l ; open Ring[l] ; open ZInt[l] ;
module Pr=Prelude[l] ; module Ps=Presentations[l] ; module N=FiniteExponents[l] ; module NA=NatArith[l] ;
module BR=PolynomialRing4Bridge[l] ; module WP=WeightedParts4[l] ; module CE=CoordinateExponents[l] ; module ZC=ZMTCertificate[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (m : Nat) (D0 : ResidualAlgebra[l].Residual[A,setA,m]) {
 n : Nat = suc m ; module FD=ResidualAlgebra[l].Algebra[A,setA,m,D0] ;
 E : CRing=FD.ring ; setE : Pr.isSet E.R=FD.algebra.set ; iota : RingHom[l].Hom A E=FD.algebra.iota ;
 module HT=HomogeneousTermsGeneral[l].Over[A,setA,m] ; module DE=HT.Dehom[E,iota,FD.y] ; module CO=DE.CO ;
 module LE=RL[E] ; module EV=ZC.Eval[A,E,iota] ; module EI=FD.EQ.At[FD.algebra,FD.y] ; module FS=FiniteIdeal[l].Sums[E] ;
 module EX=Presentations[l].Over[A,setA] ;
 exS (q : Ps.Fin m) : N.Exp n=CE.axis n (inl q) ;
 tl : EX.Expr (Ps.Fin m) -> HT.Polys = split {
   var i -> cons (A.o,exS i) nil ; cst c -> cons (c,N.zeroE n) nil ;
   sumE p q | rp rq -> Bar[l].app rp rq ; mulE p q | rp rq -> HT.FA.pmul rp rq } ;
 deh-var (i : Ps.Fin m) : Id E.R (CO.deh (tl (var i))) (FD.y i) =
   trans (DE.deh-term A.o (exS i)) (trans (ap (\a -> E.mul a (CO.mon (exS i))) iota.2.1)
     (trans (LE.one-left (CO.mon (exS i))) (DE.Mon.value m FD.y i))) ;
 deh-tl : (e : EX.Expr (Ps.Fin m)) -> Id E.R (CO.deh (tl e)) (EI.I.ev e) = split {
   var i -> deh-var i ; cst c -> trans (DE.deh-term c (N.zeroE n))
     (trans (ap (E.mul (iota.1 c)) (DE.Mon.zero-value m FD.y)) (E.mulO (iota.1 c))) ;
   sumE p q | rp rq -> trans (CO.deh-app (tl p) (tl q)) (Ps.cong2 E.R E.add _ _ _ _ rp rq) ;
   mulE p q | rp rq -> trans (CO.deh-product (tl p) (tl q)) (Ps.cong2 E.R E.mul _ _ _ _ rp rq) } ;
 xp (q : Ps.Fin m) : Base.Nat -> N.Exp n = split {
   zero -> N.zeroE n ; suc d | rec -> HT.V.addN (exS q) rec } ;
 size-xp (q : Ps.Fin m) : (d : Base.Nat) -> Id Base.Nat (N.degree n (xp q d)) d = split {
   zero -> CE.zero-degree n ; suc d | rec -> trans (ActionComposition[l].degree-add n (exS q) (xp q d))
     (trans (ap (\ x -> NA.plus x (N.degree n (xp q d))) (CE.degree n (inl q))) (ap (\ x -> suc x) rec)) } ;
 mon-var (q : Ps.Fin m) : Id E.R (CO.mon (exS q)) (FD.y q) = DE.Mon.value m FD.y q ;
 mon-xp (q : Ps.Fin m) : (d : Base.Nat) -> Id E.R (CO.mon (xp q d)) (CO.M.P.power (FD.y q) d) = split {
   zero -> (DE.Mon.zero-value m FD.y) ; suc d | rec -> trans (DE.mon-add (exS q) (xp q d))
     (Ps.cong2 E.R E.mul _ _ _ _ (mon-var q) rec) } ;
 bpow-cast (x : E.R) : (d : Nat) -> Id E.R (CO.M.P.power x (BR.toB d)) (EV.PF.pow x d) = split {
   zero -> refl E.o ; suc d | rec -> ap (E.mul x) rec } ;
 scalar (c : A.R) (p : HT.Polys) : HT.Polys = HT.FA.scaleT (c,N.zeroE n) p ;
 hom-scalar (c : A.R) (e : Base.Nat) (p : HT.Polys) (hp : HT.Hom e p) : HT.Hom e (scalar c p) =
   subst (\ d -> HT.Hom d (scalar c p)) (trans (ap (NA.plus e) (CE.zero-degree n)) (NA.plus-zero e)) (HT.hom-scale c (N.zeroE n) e p hp) ;
 deh-scalar (c : A.R) (p : HT.Polys) : Id E.R (CO.deh (scalar c p)) (E.mul (iota.1 c) (CO.deh p)) =
   trans (CO.deh-scale (c,N.zeroE n) p) (ap (\ v -> E.mul v (CO.deh p))
     (trans (ap (E.mul (iota.1 c)) (DE.Mon.zero-value m FD.y)) (E.mulO (iota.1 c)))) ;
 zscale (b : Base.Nat) (p : HT.Polys) : HT.Polys = HT.FA.scaleT (A.o,HT.zexp b) p ;
 deh-zscale (b : Base.Nat) (p : HT.Polys) : Id E.R (CO.deh (zscale b p)) (CO.deh p) =
   trans (CO.deh-scale (A.o,HT.zexp b) p)
     (trans (ap (\ v -> E.mul v (CO.deh p))
       (trans (ap (E.mul (iota.1 A.o)) (DE.Mon.zero-value m FD.y)) (trans (E.mulO (iota.1 A.o)) iota.2.1))) (LE.one-left (CO.deh p))) ;
 lower (q : Ps.Fin m) : (d : Nat) -> (Ps.Fin d -> A.R) -> HT.Polys = split {
   zero -> \ c -> nil ; suc d | rec -> \ c -> zscale (suc zero)
     (Bar[l].app (cons (c (inr tt),xp q (BR.toB d)) nil) (rec (\ i -> c (inl i)))) } ;
 hom-lower (q : Ps.Fin m) : (d : Nat) (c : Ps.Fin d -> A.R) -> HT.Hom (BR.toB d) (lower q d c) = split {
   zero -> \ c -> tt ; suc d | rec -> \ c -> Pr.subst Base.Nat (\ e -> HT.Hom e (lower q (suc d) c))
     (NA.plus (BR.toB d) (N.degree n (HT.zexp (suc zero)))) (BR.toB (suc d))
     (trans (ap (NA.plus (BR.toB d)) (HT.zdegree (suc zero)))
       (trans (NA.plus-suc (BR.toB d) zero) (ap (\ x -> suc x) (NA.plus-zero (BR.toB d)))))
     (HT.hom-scale A.o (HT.zexp (suc zero)) (BR.toB d)
       (Bar[l].app (cons (c (inr tt),xp q (BR.toB d)) nil) (lower q d (\ i -> c (inl i))))
       (HT.hom-app (BR.toB d) (cons (c (inr tt),xp q (BR.toB d)) nil) (lower q d (\ i -> c (inl i)))
         (size-xp q (BR.toB d),tt) (rec (\ i -> c (inl i))))) } ;
 deh-lower (q : Ps.Fin m) : (d : Nat) (c : Ps.Fin d -> A.R) ->
   Id E.R (CO.deh (lower q d c)) (FS.sum d (\ i -> E.mul (EV.PF.pw (FD.y q) d i) (iota.1 (c i)))) = split {
   zero -> \ c -> refl E.z ; suc d | rec -> \ c ->
     trans (deh-zscale (suc zero) (Bar[l].app (cons (c (inr tt),xp q (BR.toB d)) nil) (lower q d (\ i -> c (inl i)))))
       (trans (CO.deh-app (cons (c (inr tt),xp q (BR.toB d)) nil) (lower q d (\ i -> c (inl i))))
         (Ps.cong2 E.R E.add _ _ _ _
           (trans (DE.deh-term (c (inr tt)) (xp q (BR.toB d)))
             (trans (ap (E.mul (iota.1 (c (inr tt)))) (trans (mon-xp q (BR.toB d)) (bpow-cast (FD.y q) d)))
               (E.mulC (iota.1 (c (inr tt))) (EV.PF.pow (FD.y q) d))))
           (rec (\ i -> c (inl i))))) } ;
 monic (q : Ps.Fin m) : HT.Polys = Bar[l].app
   (cons (A.o,xp q (BR.toB (D0.P q).deg)) nil) (lower q (D0.P q).deg (D0.P q).low) ;
 hom-monic (q : Ps.Fin m) : HT.Hom (BR.toB (D0.P q).deg) (monic q) =
   HT.hom-app (BR.toB (D0.P q).deg) (cons (A.o,xp q (BR.toB (D0.P q).deg)) nil) (lower q (D0.P q).deg (D0.P q).low)
     (size-xp q (BR.toB (D0.P q).deg),tt)
     (hom-lower q (D0.P q).deg (D0.P q).low) ;
 deh-monic (q : Ps.Fin m) : Id E.R (CO.deh (monic q)) (EV.mev (D0.P q) (FD.y q)) =
   trans (CO.deh-app _ _) (Ps.cong2 E.R E.add _ _ _ _
     (trans (DE.deh-term A.o (xp q (BR.toB (D0.P q).deg)))
       (trans (ap (\ x -> E.mul x (CO.mon (xp q (BR.toB (D0.P q).deg)))) iota.2.1)
         (trans (LE.one-left (CO.mon (xp q (BR.toB (D0.P q).deg))))
           (trans (mon-xp q (BR.toB (D0.P q).deg)) (bpow-cast (FD.y q) (D0.P q).deg)))))
     (deh-lower q (D0.P q).deg (D0.P q).low)) ;
 bound (q : Ps.Fin m) (j : Ps.Fin D0.t) : Base.Nat = HT.bnd (tl (D0.H q j)) ;
 delta (q : Ps.Fin m) : Base.Nat = suc (WP.sumN D0.t (bound q)) ;
 e (q : Ps.Fin m) : Base.Nat = NA.plus (BR.toB (D0.P q).deg) (delta q) ;
 le-bound (q : Ps.Fin m) (j : Ps.Fin D0.t) : NA.Le (bound q j) (e q) =
   NA.le-trans _ _ _ (WP.le-sumN D0.t (bound q) j)
     (NA.le-trans _ _ _ (suc zero,refl (delta q)) (NA.le-sum-r (delta q) (BR.toB (D0.P q).deg))) ;
 all-mono (a b : Base.Nat) (le : NA.Le a b) : (p : HT.Polys) -> HT.AllLe a p -> HT.AllLe b p = split {
   nil -> \ h -> tt ; cons t p | rec -> \ h -> (NA.le-trans _ _ _ h.1 le,rec h.2) } ;
 hT (q : Ps.Fin m) (j : Ps.Fin D0.t) : HT.Polys = HT.homT (e q) (tl (D0.H q j)) ;
 hhT (q : Ps.Fin m) (j : Ps.Fin D0.t) : HT.Hom (e q) (hT q j) = HT.hom-homT (e q) (tl (D0.H q j)) ;
 deh-hT (q : Ps.Fin m) (j : Ps.Fin D0.t) : Id E.R (CO.deh (hT q j)) (EI.I.ev (D0.H q j)) =
   trans (DE.deh-homT (e q) (tl (D0.H q j))
     (all-mono (bound q j) (e q) (le-bound q j) (tl (D0.H q j)) (HT.bounded (tl (D0.H q j)))))
     (deh-tl (D0.H q j)) ;
 sum-hom (dd : Base.Nat) : (t : Nat) (p : Ps.Fin t -> HT.Polys) -> ((j : Ps.Fin t) -> HT.Hom dd (p j)) -> HT.Hom dd (HT.FA.psum t p) = split {
   zero -> \ p h -> tt ; suc t | rec -> \ p h -> HT.hom-app dd _ _ (h (inr tt)) (rec (\ i -> p (inl i)) (\ i -> h (inl i))) } ;
 deh-sum : (t : Nat) (p : Ps.Fin t -> HT.Polys) -> Id E.R (CO.deh (HT.FA.psum t p)) (FS.sum t (\ j -> CO.deh (p j))) = split {
   zero -> \ p -> refl E.z ; suc t | rec -> \ p -> trans (CO.deh-app _ _) (ap (E.add (CO.deh (p (inr tt)))) (rec (\ i -> p (inl i)))) } ;
 error (q : Ps.Fin m) : HT.Polys = HT.FA.psum D0.t (\ j -> scalar (D0.b j) (hT q j)) ;
 hom-error (q : Ps.Fin m) : HT.Hom (e q) (error q) = sum-hom (e q) D0.t (\ j -> scalar (D0.b j) (hT q j))
   (\ j -> hom-scalar (D0.b j) (e q) (hT q j) (hhT q j)) ;
 deh-error (q : Ps.Fin m) : Id E.R (CO.deh (error q))
   (FS.sum D0.t (\ j -> E.mul (iota.1 (D0.b j)) (EI.I.ev (D0.H q j)))) =
   trans (deh-sum D0.t (\ j -> scalar (D0.b j) (hT q j)))
     (FS.sum-cong D0.t (\ j -> CO.deh (scalar (D0.b j) (hT q j)))
       (\ j -> E.mul (iota.1 (D0.b j)) (EI.I.ev (D0.H q j))) (\ j -> trans (deh-scalar (D0.b j) (hT q j))
     (ap (E.mul (iota.1 (D0.b j))) (deh-hT q j)))) ;
 P (q : Ps.Fin m) : HT.Polys = Bar[l].app (zscale (delta q) (monic q)) (scalar (A.neg A.o) (error q)) ;
 hp (q : Ps.Fin m) : HT.Hom (e q) (P q) = HT.hom-app (e q) _ _
   (subst (\ d -> HT.Hom d (zscale (delta q) (monic q)))
     (ap (NA.plus (BR.toB (D0.P q).deg)) (HT.zdegree (delta q)))
       (HT.hom-scale A.o (HT.zexp (delta q)) (BR.toB (D0.P q).deg) (monic q) (hom-monic q)))
   (hom-scalar (A.neg A.o) (e q) (error q) (hom-error q)) ;
 deh-P (q : Ps.Fin m) : Id E.R (CO.deh (P q)) E.z =
   trans (CO.deh-app _ _) (trans (Ps.cong2 E.R E.add _ _ _ _
     (trans (deh-zscale (delta q) (monic q)) (deh-monic q))
     (trans (deh-scalar (A.neg A.o) (error q)) (trans (EI.neg-one (CO.deh (error q))) (ap E.neg (deh-error q)))))
     (trans (ap (\ v -> E.add v (E.neg (FS.sum D0.t (\ j -> E.mul (iota.1 (D0.b j)) (EI.I.ev (D0.H q j)))))) (FD.y-holds q))
       (E.addN (FS.sum D0.t (\ j -> E.mul (iota.1 (D0.b j)) (EI.I.ev (D0.H q j))))))) ;
} ;
