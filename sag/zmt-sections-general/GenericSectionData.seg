-- Explicit generic native chart sections and their restriction naturality.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module Pr=Prelude[l] ; module Ps=Presentations[l] ; module BR=PolynomialRing4Bridge[l] ;
module CC=NativeCoordinates[l] ; module CT=ChartContainment[l] ; module Faces=GenericSubsetFaces[l] ;
module SE=SectionExpression4[l] ; module SW=SectionsErrorWitness[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (m : Nat) (D0 : ResidualAlgebra[l].Residual[A,setA,m]) {
 module ST = GenericMonicSetup[l].Over[A,setA,m,D0] ;
 module MC = GenericMonicChartRelation[l].Over[A,setA,m,D0] ;
 nvar : Nat=suc m ;
 exp (i : Ps.Fin m) : Id (FiniteExponents[l].Exp nvar) (CC.axis nvar (inl i)) (ST.exS i)=CoordinateComparison[l].axis nvar (inl i) ;
 expZ : Id (FiniteExponents[l].Exp nvar) (CC.axis nvar (inr tt)) (ST.HT.zexp (suc zero))=CoordinateComparison[l].axis nvar (inr tt) ;
 module AtChart (E : Sub nvar) {
   module R = NativeChartRing[l].Over[A,setA,nvar,E] ; module D = NativeDegreePart[l].Over[A,setA,nvar,E] ;
   module C = CC.Over[A,setA,nvar,E] ; module Read = MC.To[R.ring,R.inclusion] ;
   module P = SectionsPowerAlgebra[l].Over[R.ring] ; module Units = ChartUnitAlgebra[l].Over[R.ring] ;
   module L = RL[R.ring] ;
   J (q : Ps.Fin m) : R.ring.R = R.inclusion.1 (R.B.phi nvar (ST.P q)) ;
   module W = SW.Over[R.ring,D0.t,\ j -> D.iota.1 (D0.b j),m,J] ;
   variable (q : Ps.Fin m) : Id R.ring.R (C.variable (inl q)) (Read.X q) =
     ap (\ u -> R.inclusion.1 (R.B.term nvar (A.o,u))) (exp q) ;
   variableZ : Id R.ring.R (C.variable (inr tt)) Read.z=ap (\u -> R.inclusion.1 (R.B.term nvar (A.o,u))) expZ ;
   module ZInverse (has : CT.Le nvar (Faces.singleton nvar (inr tt)) E) {
     module Inv=C.Inverse[inr tt,has] ; inverse : R.ring.R=Inv.inverse ;
     law : Id R.ring.R (R.ring.mul Read.z inverse) R.ring.o=trans (ap (\x -> R.ring.mul x inverse) (sym variableZ)) Inv.law ;
   } ;
   module Affine (q : Ps.Fin m) (has : CT.Le nvar (Faces.singleton nvar (inl q)) E) {
     module Inv = C.Inverse[inl q,has] ;
     unit : Id R.ring.R (R.ring.mul (Read.X q) Inv.inverse) R.ring.o =
       trans (ap (\ x -> R.ring.mul x Inv.inverse) (sym (variable q))) Inv.law ;
     module Rel = Read.Chart[q,Inv.inverse,unit] ;
     ys : Ps.Fin m -> R.ring.R = FiniteSingleCoefficient[l].Over[R.ring].single m q Rel.ve ;
     J-equation : Id R.ring.R (W.C.value ys) (R.ring.mul Rel.ve (Read.T.read (ST.P q))) =
       trans (FiniteSingleCoefficient[l].Over[R.ring].equation m J q Rel.ve) (R.ring.mulC (J q) Rel.ve) ;
     relation : Id R.ring.R Rel.Gvalue (R.ring.add (W.F.gen Rel.error-coeff) (W.C.value ys)) =
       trans Rel.relation (ap (R.ring.add Rel.error-value) (sym J-equation)) ;
     module GP = W.Power[Rel.Gvalue,Rel.error-coeff,ys,relation] ;
     module At (n : Nat) {
       p : Base.Nat = suc (BR.toB n) ;
       module Bound = SectionsDenominatorAlgebra[l].Bound[m,ST.delta,p] ;
       module Expr = SE.Expression[R.ring,Read.X q,Read.z,Inv.inverse,unit,(D0.P q).deg,
         \ i -> Read.T.scalar.1 ((D0.P q).low i),p,Bound.M] ;
       section : R.ring.R = Expr.section ;
       power-error : W.Witness p (P.power Rel.Gvalue p) = GP.witness p ;
       first-error : W.Witness (suc zero) (P.power Rel.Gvalue (suc zero)) = GP.witness (suc zero) ;
     } ;
   } ;
 } ;
 module Restriction (E F : Sub nvar) (le : CT.Le nvar E F) (q : Ps.Fin m)
   (hs : CT.Le nvar (Faces.singleton nvar (inl q)) E) (ht : CT.Le nvar (Faces.singleton nvar (inl q)) F) {
   module Source = AtChart[E] ; module Target = AtChart[F] ;
   module S = Source.Affine[q,hs] ; module T = Target.Affine[q,ht] ;
   module Map = NativeRestriction[l].Over[A,setA,nvar,E,F,le] ;
   module Coords = CC.Restriction[A,setA,nvar,E,F,le] ;
   x-map : Id Target.R.ring.R (Map.hom.1 (Source.Read.X q)) (Target.Read.X q) =
     Map.constant (Source.R.B.term nvar (A.o,ST.exS q)) ;
   z-map : Id Target.R.ring.R (Map.hom.1 Source.Read.z) Target.Read.z = Map.constant (Source.R.B.term nvar (A.o,ST.HT.zexp (suc zero))) ;
   c-map (i : Ps.Fin (D0.P q).deg) :
     Id Target.R.ring.R (Map.hom.1 (Source.Read.T.scalar.1 ((D0.P q).low i))) (Target.Read.T.scalar.1 ((D0.P q).low i)) =
     Map.constant ((Source.R.B.T.grD nvar).iota.1 ((D0.P q).low i)) ;
   module Natural = SE.Natural[Source.R.ring,Target.R.ring,Map.hom,
     Source.Read.X q,Source.Read.z,S.Inv.inverse,S.unit,
     Target.Read.X q,Target.Read.z,T.Inv.inverse,T.unit,x-map,z-map,Coords.Inverse[inl q,hs,ht].equation] ;
   module Coeff = Natural.At[(D0.P q).deg,\ i -> Source.Read.T.scalar.1 ((D0.P q).low i),\ i -> Target.Read.T.scalar.1 ((D0.P q).low i),c-map] ;
   section (n : Nat) : Id Target.R.ring.R (Map.hom.1 (S.At[n].section)) (T.At[n].section) = Coeff.Bound[S.At[n].p,S.At[n].Bound.M].section ;
   coefficient (n : Nat) (v : GenericLaurent[l].Exp nvar) : Id A.R (Source.R.coeff (S.At[n].section) v) (Target.R.coeff (T.At[n].section) v) =
     trans (sym (Map.coefficient (S.At[n].section) v)) (ap (\ x -> Target.R.coeff x v) (section n)) ;
 } ;
} ;
