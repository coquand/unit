-- Original homogeneous ideal acting on a single native-chart module.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module Pr=Prelude[l] ; module Ps=Presentations[l] ; module IP=IdealPowers[l] ; module PA=PolynomialAction4[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (nvar : Nat) (E : Sub nvar)
 (t : Nat) (b : Ps.Fin t -> A.R) (s : Nat) (p : Ps.Fin s -> FiniteLaurentAction[l].Over[A,setA,nvar].Polys)
 (e : Ps.Fin s -> Base.Nat) (hp : (q : Ps.Fin s) -> ShiftedMatrixAction[l].Over[A,setA,nvar].HomShift zero (e q) (p q))
 (I : U l) (k : Int) {
 module D=NativeDegreePart[l].Over[A,setA,nvar,E] ; module C=NativeChartAction[l].Over[A,setA,nvar,E] ;
 module M=ShiftedMatrixAction[l].Over[A,setA,nvar] ; module P=ShiftedCech4[l].Over[A,setA] ;
 module Target=D.Part[k].Into[I].C ;
 ki (q : Ps.Fin s) : Int=PA.minus k (e q) ;
 Md (q : Ps.Fin s) : IP.Mod[A]=D.Part[ki q].Into[I].C.mod ;
 module Source=P.Prod[s,Md] ;
 entry (q : Ps.Fin s) : IP.Lin[A,Md q,Target.mod]=C.Act[I,ki q,k,p q,M.shifts k zero (e q) (p q) (hp q)].lin ;
 module Sum=Source.SumMap[Target.mod,entry] ; action : IP.Lin[A,Source.mod,Target.mod]=Sum.lin ;
 module Q=ImageQuotient[l].Over[A,t,b,Source.mod,Target.mod,action] ;
} ;
