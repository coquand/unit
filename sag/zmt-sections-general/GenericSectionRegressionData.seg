-- Concrete residual inputs for front-half section regressions: the
-- finite point, a zero fibre with degree-zero monic equations, and a
-- nonreduced base with a genuinely nonzero ideal generator.
level l ; open Ring[l] ; open ZInt[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; 
module ZC = ZMTCertificate[l] ; module RA = ResidualAlgebra[l] ;
module Point (A : CRing) (setA : Pr.isSet A.R) (m : Nat) {
 module P = Presentations[l].Over[A,setA] ;
 monic : ZC.Monic[A] = ZC.mkMonic A (suc zero) (\ i -> A.z) ;
 D0 : RA.Residual[A,setA,m] = RA.mkResidual A setA m zero
   (\ j -> absurd A.R j) (\ i -> monic) (\ i j -> absurd (P.Expr (Ps.Fin m)) j) ;
 module Setup = GenericMonicSetup[l].Over[A,setA,m,D0] ;
 delta-one (q : Ps.Fin m) : Id Base.Nat (Setup.delta q) (suc zero) = refl (suc zero) ;
 degree-two (q : Ps.Fin m) : Id Base.Nat (Setup.e q) (suc (suc zero)) = refl (suc (suc zero)) ;
} ;
module ZeroFibre (A : CRing) (setA : Pr.isSet A.R) (m : Nat) {
 module P = Presentations[l].Over[A,setA] ;
 monic : ZC.Monic[A] = ZC.mkMonic A zero (\ i -> absurd A.R i) ;
 D0 : RA.Residual[A,setA,m] = RA.mkResidual A setA m zero
   (\ j -> absurd A.R j) (\ i -> monic) (\ i j -> absurd (P.Expr (Ps.Fin m)) j) ;
 module Setup = GenericMonicSetup[l].Over[A,setA,m,D0] ;
 monic-degree-zero : Id Nat monic.deg zero = refl zero ;
 degree-one (q : Ps.Fin m) : Id Base.Nat (Setup.e q) (suc zero) = refl (suc zero) ;
} ;
module Nonreduced (m : Nat) {
 module Z4 = ZMod4[l] ;
 A : CRing = Z4.ring ; setA : Pr.isSet A.R = Z4.set ;
 module P = Presentations[l].Over[A,setA] ;
 monic : ZC.Monic[A] = ZC.mkMonic A (suc (suc zero)) (\ i -> A.z) ;
 b (j : Ps.Fin (suc zero)) : A.R = q2 ;
 D0 : RA.Residual[A,setA,m] = RA.mkResidual A setA m (suc zero) b
   (\ i -> monic) (\ i j -> cst A.o) ;
 module Setup = GenericMonicSetup[l].Over[A,setA,m,D0] ;
 nilpotent (j : Ps.Fin (suc zero)) : Id A.R (A.mul (b j) (b j)) A.z = refl A.z ;
 degree-three (q : Ps.Fin m) : Id Base.Nat (Setup.e q) (suc (suc (suc zero))) = ap (\b -> NatArith[l].plus (suc (suc zero)) (suc (NatArith[l].plus (NatArith[l].plus b zero) zero))) (CoordinateExponents[l].zero-degree (suc m)) ;
} ;
