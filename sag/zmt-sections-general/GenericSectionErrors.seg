-- Explicit native-ring witnesses for every overlap and compatibility.
-- Affine/affine: each cross term contains u_k^M H_l^p, and the common
-- bound converts it to a multiple of G_l^p. On Z/affine, Z is a unit,
-- so use u=1, ratio=(X_k/Z), and M=delta*p in the same cross formula.
-- For compatibility with n=0, both cross terms use p=1 only.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module Ps = Presentations[l] ; module Pr = Prelude[l] ; module BR = PolynomialRing4Bridge[l] ;
module CT=ChartContainment[l] ; module Faces=GenericSubsetFaces[l] ; module SD = SectionsDenominatorAlgebra[l] ;
module NA = NatArith[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (m : Nat) (D0 : ResidualAlgebra[l].Residual[A,setA,m]) {
 module D = GenericSectionData[l].Over[A,setA,m,D0] ; module ST = D.ST ;
 nvar : Nat=suc m ;
 module AtChart (E : Sub nvar) {
   module N = D.AtChart[E] ; R : CRing = N.R.ring ; module W = N.W ; module P = N.P ; module L = N.L ;
   module AffineCross (q r : Ps.Fin m) (hq : CT.Le nvar (Faces.singleton nvar (inl q)) E)
     (hr : CT.Le nvar (Faces.singleton nvar (inl r)) E) (n : Nat) {
     module Q = N.Affine[q,hq] ; module T = N.Affine[r,hr] ;
     module QS = Q.At[n] ; module TS = T.At[n] ;
     ratio : R.R = R.mul (N.Read.X r) Q.Inv.inverse ;
     eu : Id R.R QS.Expr.u (R.mul ratio TS.Expr.u) =
       N.Units.ratio N.Read.z (N.Read.X q) (N.Read.X r) Q.Inv.inverse T.Inv.inverse T.unit ;
     module Cross = W.Cross[QS.p,ST.delta r,QS.Bound.M,N.Read.z,QS.section,TS.section,
       QS.Expr.u,TS.Expr.u,ratio,TS.Expr.H,T.Rel.Gvalue,QS.Expr.B,TS.Expr.a,
       QS.Expr.factor,TS.Expr.error,eu,refl T.Rel.Gvalue,QS.Bound.enough r,TS.power-error] ;
     witness : W.Witness QS.p (R.mul QS.section (W.ML.msub R.o (R.mul N.Read.z TS.section))) = Cross.witness ;
   } ;
   module AffineOverlap (q r : Ps.Fin m) (hq : CT.Le nvar (Faces.singleton nvar (inl q)) E)
     (hr : CT.Le nvar (Faces.singleton nvar (inl r)) E) (n : Nat) {
     module Q = N.Affine[q,hq].At[n] ; module T = N.Affine[r,hr].At[n] ;
     witness : W.Witness Q.p (W.ML.msub Q.section T.section) = W.overlap Q.p N.Read.z Q.section T.section
       AffineCross[q,r,hq,hr,n].witness AffineCross[r,q,hr,hq,n].witness ;
   } ;
   module ZAffine (q : Ps.Fin m) (hq : CT.Le nvar (Faces.singleton nvar (inl q)) E)
     (hZ : CT.Le nvar (Faces.singleton nvar (inr tt)) E) (n : Nat) {
     module Q = N.Affine[q,hq] ; module QS = Q.At[n] ; module ZI = N.ZInverse[hZ] ;
     ratio : R.R = R.mul (N.Read.X q) ZI.inverse ;
     eu : Id R.R R.o (R.mul ratio QS.Expr.u) = N.Units.inverse-ratio N.Read.z (N.Read.X q) ZI.inverse Q.Inv.inverse ZI.law Q.unit ;
     M : Base.Nat = SD.times (ST.delta q) QS.p ;
     module Cross = W.Cross[QS.p,ST.delta q,M,N.Read.z,ZI.inverse,QS.section,
       R.o,QS.Expr.u,ratio,QS.Expr.H,Q.Rel.Gvalue,ZI.inverse,QS.Expr.a,
       N.Units.factor-one ZI.inverse M,QS.Expr.error,eu,refl Q.Rel.Gvalue,(zero,refl M),QS.power-error] ;
     zero-error : Id R.R (R.mul QS.section (W.ML.msub R.o (R.mul N.Read.z ZI.inverse))) R.z =
       trans (ap (R.mul QS.section) (trans (ap (W.ML.msub R.o) ZI.law) (R.addN R.o))) (L.mul-zero QS.section) ;
     zero-witness : W.Witness QS.p (R.mul QS.section (W.ML.msub R.o (R.mul N.Read.z ZI.inverse))) =
       W.transport QS.p R.z _ (sym zero-error) (W.zero-witness QS.p) ;
     witness : W.Witness QS.p (W.ML.msub QS.section ZI.inverse) =
       W.overlap QS.p N.Read.z QS.section ZI.inverse zero-witness Cross.witness ;
   } ;
   module Compatibility (q : Ps.Fin m) (hq : CT.Le nvar (Faces.singleton nvar (inl q)) E) (n : Nat) {
     module Q = N.Affine[q,hq] ; module S = Q.At[n] ; module T = Q.At[zero] ;
     first-bound (m : Nat) : NA.Le (SD.times (ST.delta q) (suc zero)) Q.At[m].Bound.M =
       ((Q.At[m].Bound.compatible q).1,
         trans (ap (NA.plus (Q.At[m].Bound.compatible q).1) (NA.plus-zero (ST.delta q))) (Q.At[m].Bound.compatible q).2) ;
     eu : Id R.R Q.Rel.u (R.mul R.o Q.Rel.u) = sym (L.one-left Q.Rel.u) ;
     next-error : Id R.R (W.ML.msub R.o (R.mul N.Read.z S.section))
       (R.mul (R.mul S.Expr.a (P.power S.Expr.H (BR.toB n))) (P.power S.Expr.H (suc zero))) =
       trans S.Expr.error (N.Units.error-one S.Expr.a S.Expr.H (BR.toB n)) ;
     module Forward = W.Cross[suc zero,ST.delta q,S.Bound.M,N.Read.z,S.section,T.section,
       S.Expr.u,T.Expr.u,R.o,T.Expr.H,Q.Rel.Gvalue,S.Expr.B,T.Expr.a,
       S.Expr.factor,T.Expr.error,eu,refl Q.Rel.Gvalue,first-bound n,T.first-error] ;
     module Backward = W.Cross[suc zero,ST.delta q,T.Bound.M,N.Read.z,T.section,S.section,
       T.Expr.u,S.Expr.u,R.o,S.Expr.H,Q.Rel.Gvalue,T.Expr.B,R.mul S.Expr.a (P.power S.Expr.H (BR.toB n)),
       T.Expr.factor,next-error,eu,refl Q.Rel.Gvalue,first-bound zero,T.first-error] ;
     witness : W.Witness (suc zero) (W.ML.msub S.section T.section) =
       W.overlap (suc zero) N.Read.z S.section T.section Forward.witness Backward.witness ;
   } ;
 } ;
} ;
