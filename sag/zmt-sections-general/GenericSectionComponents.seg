-- Actual local section components on vertices and oriented pairs.
-- The newest vertex Z comes first, so its pair differential is affine-Z.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module Pr=Prelude[l] ; module Ps=Presentations[l] ; module IP=IdealPowers[l] ;
module Faces=GenericSubsetFaces[l] ; module CT=ChartContainment[l] ; module BR=PolynomialRing4Bridge[l] ;
module LG=Logic[l] ; module FP=FinitePolynomial4[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (m : Nat) (D0 : ResidualAlgebra[l].Residual[A,setA,m]) {
 nvar : Nat=suc m ; module D=GenericSectionData[l].Over[A,setA,m,D0] ; module ST=D.ST ;
 module Errors=GenericSectionErrors[l].Over[A,setA,m,D0] ; module AL=IP.ModL[A,IP.regular A] ;
 module Chart (E : Sub nvar) {
   module N=D.AtChart[E] ; module Error=Errors.AtChart[E] ;
   module Part=N.D.Part[negsuc zero].Into[Sub nvar] ;
   module Lin=RelationCertificate[l].LinL[A,N.D.moduleM,Part.C.mod,Part.lin] ;
   section : (i : Ps.Fin nvar) -> CT.Le nvar (Faces.singleton nvar i) E -> Nat -> N.R.ring.R=split {
     inl q -> \has r -> N.Affine[q,has].At[r].section ; inr t -> \has r -> N.ZInverse[has].inverse } ;
   part-sub (x y : N.R.ring.R) (v : GenericLaurent[l].Exp nvar) :
     Id A.R (N.D.Part[negsuc zero].value (N.W.ML.msub x y) v)
       (AL.msub (N.D.Part[negsuc zero].value x v) (N.D.Part[negsuc zero].value y v))=
     ap (\c -> Part.C.val c (empty nvar) v) (Lin.f-sub x y) ;
 } ;
 module Restriction (E F : Sub nvar) (le : CT.Le nvar E F) {
   module Source=Chart[E] ; module Target=Chart[F] ;
   module Map=NativeRestriction[l].Over[A,setA,nvar,E,F,le] ;
   section (r : Nat) : (i : Ps.Fin nvar) (hs : CT.Le nvar (Faces.singleton nvar i) E) (ht : CT.Le nvar (Faces.singleton nvar i) F) ->
     Id Target.N.R.ring.R (Map.hom.1 (Source.section i hs r)) (Target.section i ht r)=split {
       inl q -> \hs ht -> D.Restriction[E,F,le,q,hs,ht].section r ;
       inr t -> \hs ht -> NativeCoordinates[l].Restriction[A,setA,nvar,E,F,le].Inverse[inr tt,hs,ht].equation } ;
   coefficient (r : Nat) (i : Ps.Fin nvar) (hs : CT.Le nvar (Faces.singleton nvar i) E)
     (ht : CT.Le nvar (Faces.singleton nvar i) F) (v : GenericLaurent[l].Exp nvar) :
     Id A.R (Source.N.R.coeff (Source.section i hs r) v) (Target.N.R.coeff (Target.section i ht r) v)=
     trans (sym (Map.coefficient (Source.section i hs r) v)) (ap (\x -> Target.N.R.coeff x v) (section r i hs ht)) ;
   part (r : Nat) (i : Ps.Fin nvar) (hs : CT.Le nvar (Faces.singleton nvar i) E)
     (ht : CT.Le nvar (Faces.singleton nvar i) F) (v : GenericLaurent[l].Exp nvar) :
     Id A.R (Source.N.D.Part[negsuc zero].value (Source.section i hs r) v)
       (Target.N.D.Part[negsuc zero].value (Target.section i ht r) v)=
     Source.N.D.select-cong (negsuc zero) v _ _ (coefficient r i hs ht v) ;
 } ;
 module Point (i : Ps.Fin nvar) {
   module C=Chart[Faces.singleton nvar i] ;
   raw (r : Nat) : C.N.R.ring.R=C.section i (CT.self nvar (Faces.singleton nvar i)) r ;
   value (r : Nat) : C.Part.C.El=C.Part.element (raw r) ;
   compat (r : Nat) : C.N.R.ring.R=C.N.W.ML.msub (raw r) (raw zero) ;
 } ;
 module Edge (e : Faces.Pair nvar) {
   module C=Chart[Faces.pairSet nvar e] ;
   raw (r : Nat) : C.N.R.ring.R=C.N.W.ML.msub (C.section (Faces.second nvar e) (CT.second-in nvar e) r)
      (C.section (Faces.first nvar e) (CT.first-in nvar e) r) ;
   value (r : Nat) : C.Part.C.El=C.Part.element (raw r) ;
 } ;
 edge-witness (r : Nat) : (e : Faces.Pair nvar) -> Edge[e].C.N.W.Witness (suc (BR.toB r)) (Edge[e].raw r)=split {
   inl e -> Errors.AtChart[Faces.pairSet nvar (inl e)].AffineOverlap[Faces.second m e,Faces.first m e,
     CT.second-in nvar (inl e),CT.first-in nvar (inl e),r].witness ;
   inr i -> Errors.AtChart[Faces.pairSet nvar (inr i)].ZAffine[i,CT.second-in nvar (inr i),CT.first-in nvar (inr i),r].witness } ;
 compat-witness (r : Nat) : (i : Ps.Fin nvar) -> Point[i].C.N.W.Witness (suc zero) (Point[i].compat r)=split {
   inl q -> Errors.AtChart[Faces.singleton nvar (inl q)].Compatibility[q,CT.self nvar (Faces.singleton nvar (inl q)),r].witness ;
   inr t -> Point[inr t].C.N.W.transport (suc zero) Point[inr t].C.N.R.ring.z _
     (sym (Point[inr t].C.N.W.ML.sub-self (Point[inr t].raw zero))) (Point[inr t].C.N.W.zero-witness (suc zero)) } ;
 module ZPoint {
   module P=Point[inr tt] ; module Inv=P.C.N.C.Inverse[inr tt,CT.self nvar (Faces.singleton nvar (inr tt))] ;
   projection-case (v : GenericLaurent[l].Exp nvar) : (d : LG.Dec (Id Int (GenericLaurent[l].total nvar v) (negsuc zero))) ->
     Id A.R (FP.sel A (P.C.N.R.coeff Inv.inverse v) (Id Int (GenericLaurent[l].total nvar v) (negsuc zero)) d)
       (P.C.N.R.coeff Inv.inverse v)=split {
       yes e -> refl (P.C.N.R.coeff Inv.inverse v) ; no ne -> sym (Inv.degree v (\e -> Pr.absurd Empty (ne e))) } ;
   coefficient (v : GenericLaurent[l].Exp nvar) : Id A.R (P.C.N.D.Part[negsuc zero].value Inv.inverse v)
     (P.C.N.R.delta0 (LaurentExponentBridge[l].At[nvar].addE v (NativeCoordinates[l].axis nvar (inr tt))))=
     trans (projection-case v (int-dec (GenericLaurent[l].total nvar v) (negsuc zero))) (Inv.coefficient v) ;
 } ;
} ;
