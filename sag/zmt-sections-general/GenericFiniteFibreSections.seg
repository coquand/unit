-- Explicit finite-fibre sections in every finite affine dimension.
-- Only residual monic data is supplied; all section/error sequences and
-- ideal trees are constructed, with no infinite choice.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module Pr=Prelude[l] ; module Ps=Presentations[l] ; module Tr=Truncation[l] ; module IP=IdealPowers[l] ;
module BR=PolynomialRing4Bridge[l] ; module Faces=GenericSubsetFaces[l] ; module L=GenericLaurent[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (m : Nat) (D0 : ResidualAlgebra[l].Residual[A,setA,m]) {
 nvar : Nat=suc m ; module ST=GenericMonicSetup[l].Over[A,setA,m,D0] ;
 module C=GenericSectionAssembly[l].Over[A,setA,m,D0] ;
 hpC (q : Ps.Fin m) : CechPolynomialAction[l].Over[A,setA,nvar].Hom (pos (ST.e q)) (ST.P q)=
   GenericReesTermHomogeneity[l].Over[A,setA,nvar].hom (ST.e q) (ST.P q) (ST.hp q) ;
 module Edges=GenericChartErrorAssembly[l].Pairs[A,setA,nvar,D0.t,D0.b,m,ST.P,ST.e,hpC,negsuc zero].C ;
 module Points=GenericChartErrorAssembly[l].Single[A,setA,nvar,D0.t,D0.b,m,ST.P,ST.e,hpC,negsuc zero].C ;
 module CH=Edges.J ; module CJ0=Points.CJ.Q ; module CJ1=Edges.CJ.Q ;
 d : IP.Lin[A,CJ0.Target,CJ1.Target]=C.d ;
 z (r : Nat) : CJ0.Target.M=C.z r ;
 module Edge (r : Nat) {
   module Local (e : Faces.Pair nvar) {
     module R=GenericChartErrorWitness[l].Over[A,setA,nvar,Faces.pairSet nvar e,D0.t,D0.b,m,ST.P,ST.e,CH.hp-shift,Sub nvar,negsuc zero] ;
     module V=R.Realize[suc (BR.toB r),C.C.Edge[e].raw r,C.C.edge-witness r e] ;
   } ;
   module V=Edges.Assemble[suc (BR.toB r),C.edge-values r,\e -> Local[e].V.w,\e -> Local[e].V.ideal,\e -> Local[e].V.remainder] ;
 } ;
 w (r : Nat) : CJ1.Target.M=Edge[r].V.w ;
 wit (r : Nat) : CJ1.FC.Wit (suc (BR.toB r)) (w r)=Edge[r].V.ideal ;
 remainder (r : Nat) : CJ1.JW (CJ1.ML.msub (d.f (z r)) (w r))=
   subst CJ1.JW (ap (\x -> CJ1.ML.msub x (w r)) (C.edge-equation r)) Edge[r].V.remainder ;
 module Compatibility (r : Nat) {
   module Local (i : Ps.Fin nvar) {
     module R=GenericChartErrorWitness[l].Over[A,setA,nvar,Faces.singleton nvar i,D0.t,D0.b,m,ST.P,ST.e,CH.hp-shift,Sub nvar,negsuc zero] ;
     module V=R.Realize[suc zero,C.C.Point[i].compat r,C.C.compat-witness r i] ;
   } ;
   module V=Points.Assemble[suc zero,C.compat-values r,\i -> Local[i].V.w,\i -> Local[i].V.ideal,\i -> Local[i].V.remainder] ;
   witness : CJ0.IJW (suc zero) (CJ0.ML.msub (z r) (z zero))=
     subst (CJ0.IJW (suc zero)) (C.compat-equation r) V.error ;
 } ;
 compatibility (r : Nat) : CJ0.IJ (suc zero) (CJ0.ML.msub (z r) (z zero))=
   Tr.Trunc[CJ0.IJW (suc zero) (CJ0.ML.msub (z r) (z zero))].inc Compatibility[r].witness ;
 hz (r : Nat) (v : L.Exp nvar) : Id A.R (Points.CJ.Target.val (z r) (Faces.singleton nvar (inr tt)) v)
   (C.C.ZPoint.P.C.N.R.delta0 (LaurentExponentBridge[l].At[nvar].addE v (NativeCoordinates[l].axis nvar (inr tt))))=C.hz r v ;
 hz0 (v : L.Exp nvar) : Id A.R (Points.CJ.Target.val (z zero) (Faces.singleton nvar (inr tt)) v)
   (C.C.ZPoint.P.C.N.R.delta0 (LaurentExponentBridge[l].At[nvar].addE v (NativeCoordinates[l].axis nvar (inr tt))))=hz zero v ;
} ;
