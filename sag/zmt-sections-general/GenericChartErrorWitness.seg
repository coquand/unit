-- Project explicit native ideal errors into actual finite-support charts.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module Pr=Prelude[l] ; module IP=IdealPowers[l] ; module Ps=Presentations[l] ; module PA=PolynomialAction4[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (nvar : Nat) (E : Sub nvar)
 (t : Nat) (b : Ps.Fin t -> A.R) (s : Nat) (p : Ps.Fin s -> FiniteLaurentAction[l].Over[A,setA,nvar].Polys)
 (e : Ps.Fin s -> Base.Nat) (hp : (q : Ps.Fin s) -> ShiftedMatrixAction[l].Over[A,setA,nvar].HomShift zero (e q) (p q))
 (I : U l) (k : Int) {
 module D=NativeDegreePart[l].Over[A,setA,nvar,E] ; module R=D.R ; module Part=D.Part[k].Into[I] ;
 module Product=NativePartMultiplication[l].Over[A,setA,nvar,E] ;
 module Ideal=GenericChartIdeal[l].Over[A,setA,nvar,E,t,b,s,p,e,hp,I,k] ; module CJ=Ideal.Q ;
 J (q : Ps.Fin s) : R.ring.R=R.inclusion.1 (R.B.phi nvar (p q)) ;
 module W=SectionsErrorWitness[l].Over[R.ring,t,\j -> D.iota.1 (b j),s,J] ;
 module LL=RelationCertificate[l].LinL[A,D.moduleM,Part.C.mod,Part.lin] ;
 module Transport=IdealPowerWitnessTransport[l].Over[R.ring,A,IP.regular R.ring,Part.C.mod,t,
   \j -> D.iota.1 (b j),b,Part.element,LL.f-zero,Part.lin.f-add,\j x -> Part.lin.f-sm (b j) x] ;
 coefficients (ys : Ps.Fin s -> R.ring.R) : Ideal.Source.El=\q -> D.Part[PA.minus k (e q)].Into[I].element (ys q) ;
 project-sum (ys : Ps.Fin s -> R.ring.R) : Id Part.C.El (Part.element (W.C.value ys)) (Ideal.action.f (coefficients ys))=
   trans (Transport.map-sum s (\q -> R.ring.mul (J q) (ys q)))
     (CJ.S0.sum-cong s (\q -> Part.element (R.ring.mul (J q) (ys q))) (\q -> (Ideal.entry q).f (coefficients ys q))
       (\q -> Product.Product[I,k,e q,p q,hp q].equation (ys q))) ;
 module Realize (depth : Base.Nat) (x : R.ring.R) (wit : W.Witness depth x) {
   w : Part.C.El=Part.element (W.part depth x wit) ;
   ideal : CJ.FC.Wit depth w=Transport.witness depth (W.part depth x wit) (W.ideal depth x wit) ;
   remainder : CJ.JW (CJ.ML.msub (Part.element x) w)=
     (coefficients (W.coeff depth x wit),trans (sym (Transport.map-sub x (W.part depth x wit)))
       (trans (ap Part.element (W.equation depth x wit)) (project-sum (W.coeff depth x wit)))) ;
 } ;
} ;
