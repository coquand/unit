-- Five-coordinate end-to-end section/Rees regression, with no supplied
-- correction sequence or generator/kernel principle.
level l ; open Ring[l] ;
module Pr=Prelude[l] ; module Tr=Truncation[l] ;
four : Nat=suc (suc (suc (suc zero))) ; two : Nat=suc (suc zero) ;
module Five (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfn : CFN[l].CFN[K0,A])
 (D0 : ResidualAlgebra[l].Residual[A,setA,four]) {
 module S=GenericFiniteFibreSections[l].Over[A,setA,four,D0] ;
 module R=GenericReesFromSections[l].Over[K0,A,setA,cfn,two,D0.t,D0.b,four,S.ST.P,S.ST.e,S.hpC] ;
 toB : (r : Nat) -> Id Base.Nat (PolynomialRing4Bridge[l].toB r) (CoefficientParts[l].toB r)=split {
   zero -> refl zero ; suc r | rec -> ap (\b -> suc b) rec } ;
 wit (r : Nat) : R.Q1.FC.Wit (suc (CoefficientParts[l].toB r)) (S.w r)=
   subst (\b -> R.Q1.FC.Wit (suc b) (S.w r)) (toB r) (S.wit r) ;
 module C=R.Sections[S.z,S.w,wit,S.remainder,S.compatibility] ;
 correction : Tr.Trunc[C.Corrected].carrier=C.correction ;
} ;
