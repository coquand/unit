-- Actual front-half section/witness regressions, without supplied
-- correction inputs. The nonreduced instance additionally checks that
-- the constructed order-two error is zero because (2)^2=0 in Z/4Z.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module BR = PolynomialRing4Bridge[l] ;
module IP = IdealPowers[l] ; module F = GenericFiniteFibreSections[l] ; module D = GenericSectionRegressionData[l] ;
four : Nat=suc (suc (suc (suc zero))) ;
module Point (A : CRing) (setA : Pr.isSet A.R) (m : Nat) {
 module Data = D.Point[A,setA,m] ; module S = F.Over[A,setA,m,Data.D0] ;
 witness (n : Nat) : S.CJ1.FC.Wit (suc (BR.toB n)) (S.w n) = S.wit n ;
 remainder (n : Nat) : S.CJ1.JW (S.CJ1.ML.msub (S.d.f (S.z n)) (S.w n)) = S.remainder n ;
 compatibility (n : Nat) : S.CJ0.IJ (suc zero) (S.CJ0.ML.msub (S.z n) (S.z zero)) = S.compatibility n ;
 normalisation (r : Nat) (v : GenericLaurent[l].Exp (suc m)) :
   Id A.R (S.Points.CJ.Target.val (S.z r) (GenericSubsetFaces[l].singleton (suc m) (inr tt)) v)
     (S.C.C.ZPoint.P.C.N.R.delta0 (LaurentExponentBridge[l].At[suc m].addE v (NativeCoordinates[l].axis (suc m) (inr tt))))=S.hz r v ;
} ;
module ZeroFibre (A : CRing) (setA : Pr.isSet A.R) (m : Nat) {
 module Data = D.ZeroFibre[A,setA,m] ; module S = F.Over[A,setA,m,Data.D0] ;
 degree-zero : Id Nat Data.monic.deg zero = Data.monic-degree-zero ;
 witness (n : Nat) : S.CJ1.FC.Wit (suc (BR.toB n)) (S.w n) = S.wit n ;
 remainder (n : Nat) : S.CJ1.JW (S.CJ1.ML.msub (S.d.f (S.z n)) (S.w n)) = S.remainder n ;
 compatibility (n : Nat) : S.CJ0.IJ (suc zero) (S.CJ0.ML.msub (S.z n) (S.z zero)) = S.compatibility n ;
} ;
module Nonreduced {
 m : Nat=four ;
 module Data = D.Nonreduced[m] ; A : CRing = Data.A ;
 module S = F.Over[A,Data.setA,m,Data.D0] ;
 one : Nat = suc zero ; idx : Ps.Fin one = inr tt ;
 module NilpotentWitness (Md : IP.Mod[A]) {
   module P = FiniteIdealPowers[l].Over[A,Md,one,Data.b] ; module L = IP.ModL[A,Md] ;
   zero (x : Md.M) (w : P.Wit (suc (suc zero)) x) : Id Md.M x Md.mz =
     trans w.2.2
       (trans (Md.maddZ (Md.sm (Data.b idx) (w.1 idx)))
         (trans (ap (Md.sm (Data.b idx))
           (trans (w.2.1 idx).2.2 (Md.maddZ (Md.sm (Data.b idx) ((w.2.1 idx).1 idx)))))
           (trans (Md.smA (Data.b idx) (Data.b idx) ((w.2.1 idx).1 idx))
             (trans (ap (\ a -> Md.sm a ((w.2.1 idx).1 idx)) (Data.nilpotent idx)) (L.zero-sm ((w.2.1 idx).1 idx)))))) ;
 } ;
 witness (n : Nat) : S.CJ1.FC.Wit (suc (BR.toB n)) (S.w n) = S.wit n ;
 remainder (n : Nat) : S.CJ1.JW (S.CJ1.ML.msub (S.d.f (S.z n)) (S.w n)) = S.remainder n ;
 order-two-error-zero : Id S.CJ1.Target.M (S.w one) S.CJ1.Target.mz = NilpotentWitness[S.CJ1.Target].zero (S.w one) (S.wit one) ;
 compatibility (n : Nat) : S.CJ0.IJ (suc zero) (S.CJ0.ML.msub (S.z n) (S.z zero)) = S.compatibility n ;
} ;

module FivePoint (A : CRing) (setA : Pr.isSet A.R) {
 module R=Point[A,setA,four] ;
 witness (r : Nat) : R.S.CJ1.FC.Wit (suc (BR.toB r)) (R.S.w r)=R.witness r ;
 remainder (r : Nat) : R.S.CJ1.JW (R.S.CJ1.ML.msub (R.S.d.f (R.S.z r)) (R.S.w r))=R.remainder r ;
} ;
module EmptyAffine (A : CRing) (setA : Pr.isSet A.R) {
 module R=Point[A,setA,zero] ;
 witness (r : Nat) : R.S.CJ1.FC.Wit (suc (BR.toB r)) (R.S.w r)=R.witness r ;
 remainder (r : Nat) : R.S.CJ1.JW (R.S.CJ1.ML.msub (R.S.d.f (R.S.z r)) (R.S.w r))=R.remainder r ;
} ;
module FiveZeroFibre (A : CRing) (setA : Pr.isSet A.R) {
 module R=ZeroFibre[A,setA,four] ;
 remainder (r : Nat) : R.S.CJ1.JW (R.S.CJ1.ML.msub (R.S.d.f (R.S.z r)) (R.S.w r))=R.remainder r ;
} ;
