-- Assemble the local formulas into the actual generic Cech differential.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module Pr=Prelude[l] ; module Ps=Presentations[l] ; module IP=IdealPowers[l] ;
module F=GenericSubsetFaces[l] ; module CT=ChartContainment[l] ; module L=GenericLaurent[l] ;
-- Keep coordinate count abstract at this coefficient comparison boundary.
module Differential (A : CRing) (setA : Pr.isSet A.R) (n : Nat) {
 module CE=GenericCech[l].Over[A,setA] ; module GT=GenericCechTheorems[l].Over[A,setA] ;
 module Source=CE.Cochains[n,negsuc zero,sucZ zeroZ] ;
 module Target=CE.Cochains[n,negsuc zero,sucZ (sucZ zeroZ)] ;
 module D=GT.Linear[n,negsuc zero,sucZ zeroZ] ;
 raw (x : Source.El) (s : Sub n) (v : L.Exp n) :
   Id A.R (Target.val (D.d.f x) s v) (CE.C.diff n (\t -> Source.val x t v) s)=
   refl (CE.C.diff n (\t -> Source.val x t v) s) ;
} ;
module Over (A : CRing) (setA : Pr.isSet A.R) (m : Nat) (D0 : ResidualAlgebra[l].Residual[A,setA,m]) {
 nvar : Nat=suc m ; module C=GenericSectionComponents[l].Over[A,setA,m,D0] ;
 module CS0=GenericChartFamilyAssembly[l].Single[A,setA,nvar,negsuc zero].C ;
 module CS1=GenericChartFamilyAssembly[l].Pairs[A,setA,nvar,negsuc zero].C ;
 module CE=GenericCech[l].Over[A,setA] ; module GT=GenericCechTheorems[l].Over[A,setA] ;
 module AL=IP.ModL[A,IP.regular A] ;
 d : IP.Lin[A,CS0.CH.mod,CS1.CH.mod]=GT.Linear[nvar,negsuc zero,sucZ zeroZ].d ;
 points (r : Nat) : CS0.P.El=\i -> C.Point[i].value r ;
 z (r : Nat) : CS0.CH.El=CS0.assemble (points r) ;
 edge-values (r : Nat) : CS1.P.El=\e -> C.Edge[e].value r ;
 endpoint (r : Nat) (e : F.Pair nvar) (i : Ps.Fin nvar) (has : CT.Le nvar (F.singleton nvar i) (F.pairSet nvar e)) (v : L.Exp nvar) :
   Id A.R (C.Edge[e].C.N.D.Part[negsuc zero].value (C.Edge[e].C.section i has r) v) (CS0.CH.val (z r) (F.singleton nvar i) v)=
   trans (sym (C.Restriction[F.singleton nvar i,F.pairSet nvar e,has].part r i (CT.self nvar (F.singleton nvar i)) has v))
     (sym (CS0.value (points r) i v)) ;
 d-raw (x : CS0.CH.El) (s : Sub nvar) (v : L.Exp nvar) :
   Id A.R (CS1.CH.val (d.f x) s v) (CE.C.diff nvar (\t -> CS0.CH.val x t v) s)=
   Differential[A,setA,nvar].raw x s v ;
 d-value (x : CS0.CH.El) (e : F.Pair nvar) (v : L.Exp nvar) :
   Id A.R (CS1.CH.val (d.f x) (F.pairSet nvar e) v)
     (AL.msub (CS0.CH.val x (F.singleton nvar (F.second nvar e)) v)
       (CS0.CH.val x (F.singleton nvar (F.first nvar e)) v))=
   trans (d-raw x (F.pairSet nvar e) v) (F.Differential[A,setA].pair-value nvar (\s -> CS0.CH.val x s v) e) ;
 edge-equation (r : Nat) : Id CS1.CH.El (CS1.assemble (edge-values r)) (d.f (z r))=
   CS1.ext _ _ (\e v -> trans (CS1.value (edge-values r) e v)
     (trans (C.Edge[e].C.part-sub
       (C.Edge[e].C.section (F.second nvar e) (CT.second-in nvar e) r)
       (C.Edge[e].C.section (F.first nvar e) (CT.first-in nvar e) r) v)
       (trans (AL.G.cong-add (endpoint r e (F.second nvar e) (CT.second-in nvar e) v)
          (ap A.neg (endpoint r e (F.first nvar e) (CT.first-in nvar e) v)))
         (sym (d-value (z r) e v))))) ;
 compat-values (r : Nat) : CS0.P.El=\i -> C.Point[i].C.Part.element (C.Point[i].compat r) ;
 module ML0=IP.ModL[A,CS0.CH.mod] ;
 compat-equation (r : Nat) : Id CS0.CH.El (CS0.assemble (compat-values r)) (ML0.msub (z r) (z zero))=
   CS0.ext _ _ (\i v -> trans (CS0.value (compat-values r) i v)
     (trans (C.Point[i].C.part-sub (C.Point[i].raw r) (C.Point[i].raw zero) v)
       (AL.G.cong-add (sym (CS0.value (points r) i v)) (ap A.neg (sym (CS0.value (points zero) i v)))))) ;
 hz (r : Nat) (v : L.Exp nvar) : Id A.R (CS0.CH.val (z r) (F.singleton nvar (inr tt)) v)
   (C.ZPoint.P.C.N.R.delta0 (LaurentExponentBridge[l].At[nvar].addE v (NativeCoordinates[l].axis nvar (inr tt))))=
   trans (CS0.value (points r) (inr tt) v) (C.ZPoint.coefficient v) ;
} ;
