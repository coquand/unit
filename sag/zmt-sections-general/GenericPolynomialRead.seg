-- Read arbitrary finite-variable term lists through a ring map.
level l ; open Ring[l] ; open ZInt[l] ;
module Pr=Prelude[l] ; module Ps=Presentations[l] ; module RH=RingHom[l] ; module N=FiniteExponents[l] ;
module IP=IdealPowers[l] ; module GP=GenericPolynomialRingLaws[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (n : Nat) {
 module B=PolynomialTowerBridge[l].Over[A,setA] ; module Laws=GP.Over[A,setA] ; module G=Laws.At[n] ;
 module V=LaurentExponentBridge[l].At[n] ; module PA=FiniteLaurentAction[l].Over[A,setA,n] ;
 S : CRing=B.T.D n ;
 module To (R : CRing) (f : RH.Hom S R) {
   module L=RL[R] ; module P=SectionsPowerAlgebra[l].Over[R] ; module Sums=Comb[l].Sums[R,IP.regular R] ;
   scalar : RH.Hom A R=RH.compose A S R f (B.T.grD n).iota ;
   term (c : A.R) (u : N.Exp n) : R.R=f.1 (B.term n (c,u)) ;
   read (p : PA.Polys) : R.R=f.1 (B.phi n p) ;
   read-zero : Id R.R (read nil) R.z=RH.zero S R f ;
   single (c : A.R) (u : N.Exp n) : Id R.R (read (cons (c,u) nil)) (term c u)=ap f.1 (G.phi-single (c,u)) ;
   app (p q : PA.Polys) : Id R.R (read (Bar[l].app p q)) (R.add (read p) (read q))=
     trans (ap f.1 (G.PP.append p q)) (f.2.2.1 (B.phi n p) (B.phi n q)) ;
   scale (c : A.R) (u : N.Exp n) (p : PA.Polys) : Id R.R (read (PA.scaleT (c,u) p)) (R.mul (term c u) (read p))=
     trans (ap f.1 (G.phi-scaleT (c,u) p)) (f.2.2.2 (B.term n (c,u)) (B.phi n p)) ;
   constant (c : A.R) : Id R.R (term c (N.zeroE n)) (scalar.1 c)=ap f.1 (Laws.term-zero n c) ;
   term-one : Id R.R (term A.o (N.zeroE n)) R.o=trans (constant A.o) scalar.2.1 ;
   add-comm (u v : N.Exp n) : Id (N.Exp n) (V.addN u v) (V.addN v u)=
     N.ext n _ _ (\i -> NatArith[l].plus-comm (u i) (v i)) ;
   product (c c' : A.R) (u v : N.Exp n) : Id R.R (R.mul (term c u) (term c' v)) (term (A.mul c c') (V.addN u v))=
     trans (sym (f.2.2.2 (B.term n (c,u)) (B.term n (c',v))))
       (trans (ap f.1 (G.term-product (c,u) (c',v))) (ap (term (A.mul c c')) (add-comm v u))) ;
   coefficient (c : A.R) (u : N.Exp n) : Id R.R (term c u) (R.mul (scalar.1 c) (term A.o u))=
     trans (ap (\a -> term a u) (sym (A.mulO c)))
       (trans (sym (product c A.o (N.zeroE n) u)) (ap (\v -> R.mul v (term A.o u)) (constant c))) ;
   sum : (t : Nat) (p : Ps.Fin t -> PA.Polys) -> Id R.R (read (PA.psum t p)) (Sums.sum t (\j -> read (p j)))=split {
     zero -> \p -> read-zero ; suc t | rec -> \p -> trans (app (p (inr tt)) (PA.psum t (\i -> p (inl i))))
       (ap (R.add (read (p (inr tt)))) (rec (\i -> p (inl i)))) } ;
 } ;
} ;
