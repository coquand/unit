-- Concrete five-coordinate local sections and projected ideal witnesses.
-- Also exercise zero affine coordinates, degree0 monics and Z/4Z.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module Pr=Prelude[l] ; module Ps=Presentations[l] ; module BR=PolynomialRing4Bridge[l] ;
module Faces=GenericSubsetFaces[l] ; module RD=GenericSectionRegressionData[l] ;
four : Nat=suc (suc (suc (suc zero))) ;
module Run (A : CRing) (setA : Pr.isSet A.R) (m : Nat) (D0 : ResidualAlgebra[l].Residual[A,setA,m]) {
 module C=GenericSectionComponents[l].Over[A,setA,m,D0] ; module ST=C.ST ; nvar : Nat=suc m ;
 module Edge (e : Faces.Pair nvar) {
   module Local=GenericChartErrorWitness[l].Over[A,setA,nvar,Faces.pairSet nvar e,D0.t,D0.b,m,ST.P,ST.e,ST.hp,Sub nvar,negsuc zero] ;
   module At (r : Nat) {
     module R=Local.Realize[suc (BR.toB r),C.Edge[e].raw r,C.edge-witness r e] ;
     witness : Local.CJ.FC.Wit (suc (BR.toB r)) R.w=R.ideal ;
     remainder : Local.CJ.JW (Local.CJ.ML.msub (Local.Part.element (C.Edge[e].raw r)) R.w)=R.remainder ;
   } ;
 } ;
 module Vertex (i : Ps.Fin nvar) {
   module Local=GenericChartErrorWitness[l].Over[A,setA,nvar,Faces.singleton nvar i,D0.t,D0.b,m,ST.P,ST.e,ST.hp,Sub nvar,negsuc zero] ;
   module At (r : Nat) {
     module R=Local.Realize[suc zero,C.Point[i].compat r,C.compat-witness r i] ;
     witness : Local.CJ.FC.Wit (suc zero) R.w=R.ideal ;
     remainder : Local.CJ.JW (Local.CJ.ML.msub (Local.Part.element (C.Point[i].compat r)) R.w)=R.remainder ;
   } ;
 } ;
 zero-chart (r : Nat) (v : GenericLaurent[l].Exp nvar) :
   Id A.R (C.Point[inr tt].C.N.D.Part[negsuc zero].value (C.Point[inr tt].raw r) v)
     (C.ZPoint.P.C.N.R.delta0 (LaurentExponentBridge[l].At[nvar].addE v (NativeCoordinates[l].axis nvar (inr tt))))=
   C.ZPoint.coefficient v ;
} ;
module FivePoint (A : CRing) (setA : Pr.isSet A.R) {
 module Data=RD.Point[A,setA,four] ; module R=Run[A,setA,four,Data.D0] ;
 affineZ : Faces.Pair (suc four)=inr (inr tt) ;
 affineAffine : Faces.Pair (suc four)=inl (inr (inr tt)) ;
 module EZ=R.Edge[affineZ] ; module EA=R.Edge[affineAffine] ;
 z-error (r : Nat) : EZ.Local.CJ.FC.Wit (suc (BR.toB r)) EZ.At[r].R.w=EZ.At[r].witness ;
 affine-error (r : Nat) : EA.Local.CJ.FC.Wit (suc (BR.toB r)) EA.At[r].R.w=EA.At[r].witness ;
 module Compatible=R.Vertex[inl (inr tt)] ;
 compatibility (r : Nat) : Compatible.Local.CJ.FC.Wit (suc zero) Compatible.At[r].R.w=Compatible.At[r].witness ;
} ;
module FiveZeroFibre (A : CRing) (setA : Pr.isSet A.R) {
 module Data=RD.ZeroFibre[A,setA,four] ; module R=Run[A,setA,four,Data.D0] ; module E=R.Edge[inr (inr tt)] ;
 degree0 : Id Nat Data.monic.deg zero=Data.monic-degree-zero ;
 witness (r : Nat) : E.Local.CJ.FC.Wit (suc (BR.toB r)) E.At[r].R.w=E.At[r].witness ;
} ;
module EmptyAffine (A : CRing) (setA : Pr.isSet A.R) {
 module Data=RD.Point[A,setA,zero] ; module R=Run[A,setA,zero,Data.D0] ; module V=R.Vertex[inr tt] ;
 compatibility (r : Nat) : V.Local.CJ.FC.Wit (suc zero) V.At[r].R.w=V.At[r].witness ;
} ;
module FiveNonreduced {
 module Data=RD.Nonreduced[four] ; module R=Run[Data.A,Data.setA,four,Data.D0] ; module E=R.Edge[inr (inr tt)] ;
 witness (r : Nat) : E.Local.CJ.FC.Wit (suc (BR.toB r)) E.At[r].R.w=E.At[r].witness ;
}
;
