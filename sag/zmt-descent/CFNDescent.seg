-- CFNDescent.seg: the CFN-base certificate principle (an explicit
-- parameter) and the arbitrary-base certificate theorem from residual data,
-- Gate C (handoff §2, §5).
--
-- The principle, for a fixed number n of algebra generators:
--   CFNZMT n: for every CFN ring A (codes in some K0), every finite list of
--     equations f in A[X_1..X_n] with presented algebra F = A[X]/(f)
--     (PresentedAlgebra, generators y), and every finite family b in A: if
--     F / (b) F is finite over A (FibreSpan.Finite), then merely there is a
--     certificate (ZMTCert) for (F, y, b).
--   This is the ZMT certificate theorem over a CFN base for finitely
--   presented algebras with finite special fibre; it is NOT proved here.
--   Over a CFN base, "F/(b)F finite over A/(b)" in the usual sense gives
--   Finite by lifting the finitely many coefficients of a generating family
--   (Finite asks for coefficients in A directly).
--   UniversalZMT n: the same conclusion only for the residual algebras F(D0)
--     of residual data D0 over the coefficient bases Z[C_1..C_m], with b the
--     family of D0.  It is all the descent uses.
--   universal-of-cfn: CFNZMT n gives UniversalZMT n, since Z[C_1..C_m] is CFN
--     (CoefficientBase.cfn), F(D0) is presented by its residual equations, and
--     its special fibre is finite (ResidualFibreFinite.Fibre.finite).
--   Neither principle hides the descent: their algebras are over a CFN base.
--   A future theorem for n <= 3 (ZMT4), or for every n, instantiates n; the
--   four-coordinate development is not claimed to give arbitrary n.
--
-- Theorem (Descent.certificate).  Let R be any commutative set-ring (no CFN,
-- discreteness, domain, field or characteristic hypothesis), E an R-algebra,
-- x_1..x_n in E, and D residual data over R with the identities (R):
--     P_i(x_i) = sum_j iota(a_j) H_ij(x)      (a_j = D.b j).
-- Given UniversalZMT n, merely: s in E with s = 1 + sum_j iota(a_j) r_j and
-- monic polynomials over R annihilating s and every s x_i.
-- Proof.  UniversalResidualAlgebra builds A0 = Z[C_1..C_m], h : A0 -> R,
-- D0 with h D0 = D, F0 = F(D0) and phi : F0 -> E compatible with h,
-- phi(y_i) = x_i, h(b0_j) = a_j.  The principle gives merely a certificate
-- for (F0, y, b0); CertificateTransport carries it to (E, x, a).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module RH = RingHom[l] ; module Tr = Truncation[l] ;
module ZC = ZMTCertificate[l] ; module CB = CoefficientBase[l] ; module RA = ResidualAlgebra[l] ;

------------------------------------------------------------------------
-- the principles

-- the instance of CFNZMT at a presentation over A
module Instance (A : CRing) (setA : Pr.isSet A.R) (n : Nat) (eqs : Presentations[l].Over[A,setA].Equations (Ps.Fin n))
  (t : Nat) (b : Ps.Fin t -> A.R) {
  module PA = PresentedAlgebra[l].Over[A,setA,(n,eqs)] ;
  F : CRing = PA.ring ;
  iota : RH.Hom A F = PA.inclusion ;
  -- the special fibre F / (b) F is finite over A
  FiniteFibre : U l = FibreSpan[l].Over[A,F,iota,t,\ j -> iota.1 (b j)].Finite ;
  Goal : U l = Tr.Trunc[ZC.ZMTCert[A,F,iota,n,PA.generators,t,b]].carrier ;
} ;
CFNZMT (n : Nat) : U (l+) =
  (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfn : CFN[l].CFN[K0,A])
  (eqs : Presentations[l].Over[A,setA].Equations (Ps.Fin n)) (t : Nat) (b : Ps.Fin t -> A.R) ->
  Instance[A,setA,n,eqs,t,b].FiniteFibre -> Instance[A,setA,n,eqs,t,b].Goal ;

-- the instance of UniversalZMT at residual data over Z[C_1..C_m]
module UInstance (n m : Nat) (D0 : RA.Residual[CB.ring m,CB.set m,n]) {
  module FD = RA.Algebra[CB.ring m,CB.set m,n,D0] ;
  Goal : U l = Tr.Trunc[ZC.ZMTCert[CB.ring m,FD.ring,FD.algebra.iota,n,FD.y,D0.t,D0.b]].carrier ;
} ;
UniversalZMT (n : Nat) : U l = (m : Nat) (D0 : RA.Residual[CB.ring m,CB.set m,n]) -> UInstance[n,m,D0].Goal ;

-- the bridge
universal-of-cfn (n : Nat) (Z : CFNZMT n) : UniversalZMT n = \ m D0 ->
  Z CB.Codes (CB.ring m) (CB.set m) (CB.cfn m) (RA.Equations[CB.ring m,CB.set m,n,D0].eqs) D0.t D0.b
    ResidualFibreFinite[l].Fibre[CB.ring m,CB.set m,n,D0].finite ;

------------------------------------------------------------------------
-- the conditional theorem over an arbitrary base

module Descent (n : Nat) (U0 : UniversalZMT n) (R : CRing) (setR : Pr.isSet R.R) (D : RA.Residual[R,setR,n])
  (E : Algebras[l].Over[R,setR].Algebra) (x : Ps.Fin n -> E.ring.R) (hold : RA.Equations[R,setR,n,D].At[E,x].Holds) {
  module UR = UniversalResidualAlgebra[l].Over[R,setR,n,D] ;
  module TE = UR.ToE[E,x,hold] ;
  module TT = CertificateTransport[l].Over[UR.A0,R,UR.h,UR.F0.ring,E.ring,UR.F0.algebra.iota,E.iota,TE.phi,TE.phi-iota,
                                           n,UR.F0.y,x,TE.phi-y,D.t,UR.b0,D.b,UR.image-b] ;
  -- the certificate over the universal base
  universal : UInstance[n,UR.m,UR.D0].Goal = U0 UR.m UR.D0 ;
  certificate : Tr.Trunc[ZC.ZMTCert[R,E.ring,E.iota,n,x,D.t,D.b]].carrier = TT.transport universal ;
} ;

-- the same from the CFN principle for presented algebras
module DescentCFN (n : Nat) (Z : CFNZMT n) (R : CRing) (setR : Pr.isSet R.R) (D : RA.Residual[R,setR,n])
  (E : Algebras[l].Over[R,setR].Algebra) (x : Ps.Fin n -> E.ring.R) (hold : RA.Equations[R,setR,n,D].At[E,x].Holds) {
  module DS = Descent[n,universal-of-cfn n Z,R,setR,D,E,x,hold] ;
  certificate : Tr.Trunc[ZC.ZMTCert[R,E.ring,E.iota,n,x,D.t,D.b]].carrier = DS.certificate ;
} ;
