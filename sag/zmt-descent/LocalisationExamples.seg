-- LocalisationExamples.seg: regressions for B = R[s, s x_i], its
-- finiteness and B[1/s] = E[1/s] (CertificateLocalisation.Consequence).
--
-- L1  the certificate of DescentExamples.T5 transported to Z/4Z (s = 1,
--     Q0 = T + 3, Q1 = T + 2, x = 2): B is spanned by one monomial; the
--     isomorphism B[1/1] = E[1/1].
-- L2  a NILPOTENT s over Z/4Z: x = 1, a = (1), s = 2 = 1 + 1 * 1,
--     Q0 = Q1 = T + 2 (2 + 2 = 0), all by computation.  E[1/2] = 0, and the
--     construction still gives B finite and the isomorphism.
-- L3  n = 0 (no algebra generators), s = 1, Q0 = T + 3.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module RH = RingHom[l] ;
module ZC = ZMTCertificate[l] ; module DE = DescentExamples[l] ; module QX = QuotientExamples[l] ;
module ZM = ZMod4[l] ; module CL = CertificateLocalisation[l] ;
R4 : CRing = ZM.ring ;
set4 : Pr.isSet R4.R = ZM.set ;

-- L1
module L1 {
  module C = CL.Consequence[R4,set4,DE.E4,suc zero,DE.T5.x,QX.gen (suc zero) DE.T5.x,suc zero,\ j -> q2,DE.T5.c1] ;
  size : Id Nat C.finite.N (suc zero) = refl (suc zero) ;
  iso : Pr.Equiv C.I.Bs.R C.I.Es.R = C.iso ;
} ;

-- L2
module L2 {
  x (i : Ps.Fin (suc zero)) : R4.R = q1 ;
  a (j : Ps.Fin (suc zero)) : R4.R = q1 ;
  Q : ZC.Monic[R4] = ZC.mkMonic R4 (suc zero) (\ k -> q2) ;
  c : ZC.ZMTCert[R4,R4,RH.identity R4,suc zero,x,suc zero,a] =
    ZC.mkZMTCert R4 R4 (RH.identity R4) (suc zero) x (suc zero) a q2 (\ j -> q1, refl q2) Q (refl q0) (\ i -> Q) (\ i -> refl q0) ;
  module C = CL.Consequence[R4,set4,DE.E4,suc zero,x,QX.gen (suc zero) x,suc zero,a,c] ;
  size : Id Nat C.finite.N (suc zero) = refl (suc zero) ;
  iso : Pr.Equiv C.I.Bs.R C.I.Es.R = C.iso ;
  phi : RH.Hom C.I.Bs C.I.Es = C.phi ;
} ;

-- L3
module L3 {
  x (i : Ps.Fin zero) : R4.R = absurd R4.R i ;
  b (j : Ps.Fin zero) : R4.R = absurd R4.R j ;
  c : ZC.ZMTCert[R4,R4,RH.identity R4,zero,x,zero,b] =
    ZC.mkZMTCert R4 R4 (RH.identity R4) zero x zero b q1 (\ j -> absurd R4.R j, refl q1)
      (ZC.mkMonic R4 (suc zero) (\ k -> q3)) (refl q0)
      (\ i -> absurd (ZC.Monic[R4]) i) (\ i -> absurd (Id R4.R (ZC.Eval[R4,R4,RH.identity R4].mev (absurd (ZC.Monic[R4]) i) (R4.mul q1 (x i))) R4.z) i) ;
  module C = CL.Consequence[R4,set4,DE.E4,zero,x,QX.gen zero x,zero,b,c] ;
  size : Id Nat C.finite.N (suc zero) = refl (suc zero) ;
  iso : Pr.Equiv C.I.Bs.R C.I.Es.R = C.iso ;
} ;
