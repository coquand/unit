-- ResidualFibreFinite.seg: the special fibre of a residual algebra is
-- finite, Gate C (handoff §5).
--
-- Theorem.  Let D be residual data over any commutative set-ring A, F = F(D)
-- and I0 = (b_1 .. b_t).  The monomials y^e = y_1^e_1 .. y_n^e_n with
-- 0 <= e_i < deg P_i span F modulo I0 F over A (Fibre.finite).
--
-- Informal proof.  Modulo I0 F the equation (U) reads P_i(y_i) = 0, i.e.
--   (Hyp) y_i^d_i = - sum_k c_ik y_i^k  is in span(1, y_i, .., y_i^(d_i - 1))
-- (Fibre.hyp, from y-holds).  Only monic reduction is used: no Groebner
-- basis, field, domain, flatness or regular sequence; the family need not be
-- free.
--   One variable z with (Hyp) (One): z y^k is y^(k+1), in span(pw_(d+1))
--   (shift); removing the generator z^d, which is in span(pw_d), gives
--   z . span(pw_d) in span(pw_d) (Rel.closed, FibreSpan.mul-closed); and 1
--   is in span(pw_d) (one-of: for d = 0, (Hyp) says 1 is in I0 F).
--   n variables (Monomials): mono n y d = the products of the families
--   pw_(d_i)(y_i), formed variable by variable (FibreSpan.blocks: the
--   last variable outermost).  By induction on n (Claim, claim):
--     1 is in the span, as 1 * 1 (prod-in);
--     y_i . span in span: by mul-closed it suffices for the generators
--     p_j g_k (block-ind); for an old variable y_i p_j g_k = p_j (y_i g_k)
--     with y_i g_k in span(g) by induction (block-in); for the last one
--     y p_j g_k = (y p_j) g_k with y p_j in span(p) by One (prod-in).
--   Every element f of F is merely the value of an expression e at y
--   (ResidualAlgebra.generated); by induction on e, e(y) . span in span
--   (all-mul: variables by Claim, constants by in-scale, sums and products
--   by in-add and associativity), so f = e(y) . 1 is in the span.
-- The case n = 0 gives the one-element family 1, and t = 0 the ideal 0;
-- if some d_i = 0 then 1 is in I0 F and the special fibre is 0.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module RH = RingHom[l] ; module Tr = Truncation[l] ;
module ZC = ZMTCertificate[l] ; module FF = FiniteFamilies[l] ; module RA = ResidualAlgebra[l] ;
module TC = TruncationCombinators[l] ;

module Monomials (A F : CRing) (iota : RH.Hom A F) (t : Nat) (B : Ps.Fin t -> F.R) {
  module SP = FibreSpan[l].Over[A,F,iota,t,B] ;
  module PF = ZC.Powers[F] ; module L = RL[F] ;

  ------------------------------------------------------------------------
  -- one variable

  module One (z : F.R) {
    -- z z^k is in span(1, .., z^d)
    shift : (d : Nat) (k : Ps.Fin d) -> SP.In (suc d) (PF.pw z (suc d)) (F.mul z (PF.pw z d k)) = split {
      zero -> \ k -> absurd (SP.In (suc zero) (PF.pw z (suc zero)) (F.mul z (PF.pw z zero k))) k ;
      suc d | r -> split {
        inl k -> SP.in-snoc (suc d) (PF.pw z (suc d)) (PF.pow z (suc d)) (F.mul z (PF.pw z d k)) (r k) ;
        inr u -> SP.member (suc (suc d)) (PF.pw z (suc (suc d))) (inr tt) } } ;
    -- 1 is in span(1, .., z^d)
    one-pos : (d : Nat) -> SP.In (suc d) (PF.pw z (suc d)) F.o = split {
      zero -> SP.member (suc zero) (PF.pw z (suc zero)) (inr tt) ;
      suc d | r -> SP.in-snoc (suc d) (PF.pw z (suc d)) (PF.pow z (suc d)) F.o r } ;
    one-of : (d : Nat) -> SP.In d (PF.pw z d) (PF.pow z d) -> SP.In d (PF.pw z d) F.o = split {
      zero -> \ hyp -> hyp ;
      suc d -> \ hyp -> one-pos d } ;
    -- z^d in span(1, .., z^(d-1)) makes that span closed under z
    module Rel (d : Nat) (hyp : SP.In d (PF.pw z d) (PF.pow z d)) {
      step (k : Ps.Fin d) : SP.In d (PF.pw z d) (F.mul z (PF.pw z d k)) =
        SP.in-snoc-elim d (PF.pw z d) (PF.pow z d) (F.mul z (PF.pw z d k)) hyp (shift d k) ;
      closed (f : F.R) (h : SP.In d (PF.pw z d) f) : SP.In d (PF.pw z d) (F.mul z f) =
        SP.mul-closed d (PF.pw z d) z step f h ;
    } ;
  } ;

  ------------------------------------------------------------------------
  -- n variables

  sz : (n : Nat) -> (Ps.Fin n -> Nat) -> Nat = split {
    zero -> \ d -> suc zero ;
    suc n | r -> \ d -> SP.bsz (d (inr tt)) (r (\ i -> d (inl i))) } ;
  mono : (n : Nat) (y : Ps.Fin n -> F.R) (d : Ps.Fin n -> Nat) -> Ps.Fin (sz n d) -> F.R = split {
    zero -> \ y d k -> F.o ;
    suc n | r -> \ y d -> SP.blocks (d (inr tt)) (PF.pw (y (inr tt)) (d (inr tt))) (sz n (\ i -> d (inl i)))
                             (r (\ i -> y (inl i)) (\ i -> d (inl i))) } ;

  Hyp (n : Nat) (y : Ps.Fin n -> F.R) (d : Ps.Fin n -> Nat) : U l =
    (i : Ps.Fin n) -> SP.In (d i) (PF.pw (y i) (d i)) (PF.pow (y i) (d i)) ;
  Closed (n : Nat) (y : Ps.Fin n -> F.R) (d : Ps.Fin n -> Nat) (i : Ps.Fin n) : U l =
    (f : F.R) -> SP.In (sz n d) (mono n y d) f -> SP.In (sz n d) (mono n y d) (F.mul (y i) f) ;
  Claim (n : Nat) (y : Ps.Fin n -> F.R) (d : Ps.Fin n -> Nat) : U l =
    SP.In (sz n d) (mono n y d) F.o * ((i : Ps.Fin n) -> Closed n y d i) ;

  module Step (n : Nat) (y : Ps.Fin (suc n) -> F.R) (d : Ps.Fin (suc n) -> Nat) (hyp : Hyp (suc n) y d)
    (ih : Claim n (\ i -> y (inl i)) (\ i -> d (inl i))) {
    dl : Nat = d (inr tt) ;
    yl : F.R = y (inr tt) ;
    p : Ps.Fin dl -> F.R = PF.pw yl dl ;
    N : Nat = sz n (\ i -> d (inl i)) ;
    g : Ps.Fin N -> F.R = mono n (\ i -> y (inl i)) (\ i -> d (inl i)) ;
    M : Nat = SP.bsz dl N ;
    G : Ps.Fin M -> F.R = SP.blocks dl p N g ;
    module O = One[yl] ; module RO = O.Rel[dl,hyp (inr tt)] ;

    one : SP.In M G F.o =
      SP.in-eq M G (F.mul F.o F.o) F.o (F.mulO F.o) (SP.prod-in dl p N g F.o F.o ih.1 (O.one-of dl (hyp (inr tt)))) ;
    -- an old variable
    old-gen (i : Ps.Fin n) (j : Ps.Fin dl) (k : Ps.Fin N) : SP.In M G (F.mul (y (inl i)) (F.mul (p j) (g k))) =
      SP.in-eq M G (F.mul (p j) (F.mul (y (inl i)) (g k))) (F.mul (y (inl i)) (F.mul (p j) (g k))) (L.mul-swap (p j) (y (inl i)) (g k))
        (SP.block-in dl p N g j (F.mul (y (inl i)) (g k)) (ih.2 i (g k) (SP.member N g k))) ;
    old (i : Ps.Fin n) : Closed (suc n) y d (inl i) =
      SP.mul-closed M G (y (inl i)) (SP.block-ind (\ w -> SP.In M G (F.mul (y (inl i)) w)) dl p N g (old-gen i)) ;
    -- the last variable
    last-gen (j : Ps.Fin dl) (k : Ps.Fin N) : SP.In M G (F.mul yl (F.mul (p j) (g k))) =
      SP.in-eq M G (F.mul (F.mul yl (p j)) (g k)) (F.mul yl (F.mul (p j) (g k))) (sym (F.mulA yl (p j) (g k)))
        (SP.prod-in dl p N g (g k) (F.mul yl (p j)) (SP.member N g k) (RO.closed (p j) (SP.member dl p j))) ;
    last-tt : Closed (suc n) y d (inr tt) =
      SP.mul-closed M G yl (SP.block-ind (\ w -> SP.In M G (F.mul yl w)) dl p N g last-gen) ;
    last (u : Top) : Closed (suc n) y d (inr u) =
      \ f h -> SP.in-eq M G (F.mul yl f) (F.mul (y (inr u)) f) (ap (\ w -> F.mul (y (inr w)) f) (FF.top-eta u)) (last-tt f h) ;
    closed : (i : Ps.Fin (suc n)) -> Closed (suc n) y d i = split { inl i -> old i ; inr u -> last u } ;
    claim : Claim (suc n) y d = (one, closed) ;
  } ;

  claim : (n : Nat) (y : Ps.Fin n -> F.R) (d : Ps.Fin n -> Nat) -> Hyp n y d -> Claim n y d = split {
    zero -> \ y d hyp -> (SP.member (suc zero) (\ k -> F.o) (inr tt), \ i -> absurd (Closed zero y d i) i) ;
    suc n | r -> \ y d hyp -> Step[n,y,d,hyp,r (\ i -> y (inl i)) (\ i -> d (inl i)) (\ i -> hyp (inl i))].claim } ;
} ;

------------------------------------------------------------------------
-- the residual algebra

module Fibre (A : CRing) (setA : Pr.isSet A.R) (n : Nat) (D : RA.Residual[A,setA,n]) {
  module FD = RA.Algebra[A,setA,n,D] ;
  module PA = Presentations[l].Over[A,setA] ;
  F : CRing = FD.ring ;
  iota : RH.Hom A F = FD.algebra.iota ;
  B (j : Ps.Fin D.t) : F.R = iota.1 (D.b j) ;
  module MO = Monomials[A,F,iota,D.t,B] ; module SP = MO.SP ; module L = RL[F] ;
  module EQ = RA.Equations[A,setA,n,D].At[FD.algebra,FD.y] ;
  degs (i : Ps.Fin n) : Nat = (D.P i).deg ;
  N : Nat = MO.sz n degs ;
  g : Ps.Fin N -> F.R = MO.mono n FD.y degs ;

  -- u + v = w gives u = (-v) + w
  solve (u v w : F.R) (h : Id F.R (F.add u v) w) : Id F.R u (F.add (F.neg v) w) =
    trans (sym (L.add-neg-cancel u v)) (trans (ap (\ s -> F.add s (F.neg v)) h) (F.addC w (F.neg v))) ;
  -- - sum_k y^k iota(c_k) = sum_k y^k iota(-c_k)
  neg-lower (i : Ps.Fin n) : Id F.R (F.neg (EQ.I.EB.lower (D.P i) (FD.y i))) (SP.comb (degs i) (EQ.I.PB.pw (FD.y i) (degs i)) (\ k -> A.neg ((D.P i).low k))) =
    sym (trans (EQ.I.SB.sum-cong (degs i) (\ k -> F.mul (EQ.I.PB.pw (FD.y i) (degs i) k) (iota.1 (A.neg ((D.P i).low k))))
                  (\ k -> F.mul (EQ.I.PB.pw (FD.y i) (degs i) k) (F.neg (iota.1 ((D.P i).low k))))
                  (\ k -> ap (F.mul (EQ.I.PB.pw (FD.y i) (degs i) k)) (RH.negation A F iota ((D.P i).low k))))
            (EQ.I.SB.lin-neg (degs i) (EQ.I.PB.pw (FD.y i) (degs i)) (\ k -> iota.1 ((D.P i).low k)))) ;
  -- y_i^d_i = sum_k y_i^k iota(-c_ik) + sum_j iota(b_j) H_ij(y)
  hyp : MO.Hyp n FD.y degs = \ i ->
    SP.in-inc (degs i) (EQ.I.PB.pw (FD.y i) (degs i)) (EQ.I.PB.pow (FD.y i) (degs i))
      (\ k -> A.neg ((D.P i).low k),
       (\ j -> EQ.I.ev (D.H i j),
        trans (solve (EQ.I.PB.pow (FD.y i) (degs i)) (EQ.I.EB.lower (D.P i) (FD.y i)) _ (FD.y-holds i))
          (ap (\ s -> F.add s (EQ.I.SB.lin D.t B (\ j -> EQ.I.ev (D.H i j)))) (neg-lower i)))) ;
  claim : MO.Claim n FD.y degs = MO.claim n FD.y degs hyp ;

  -- e(y) . span in span
  all-mul : (e : PA.Expr (Ps.Fin n)) (f : F.R) -> SP.In N g f -> SP.In N g (F.mul (EQ.I.ev e) f) = split {
    var i -> claim.2 i ;
    cst a -> SP.in-scale N g a ;
    sumE p q | rp rq -> \ f h -> SP.in-eq N g (F.add (F.mul (EQ.I.ev p) f) (F.mul (EQ.I.ev q) f)) (F.mul (EQ.I.ev (sumE p q)) f)
                                   (sym (L.dist-left (EQ.I.ev p) (EQ.I.ev q) f))
                                   (SP.in-add N g (F.mul (EQ.I.ev p) f) (F.mul (EQ.I.ev q) f) (rp f h) (rq f h)) ;
    mulE p q | rp rq -> \ f h -> SP.in-eq N g (F.mul (EQ.I.ev p) (F.mul (EQ.I.ev q) f)) (F.mul (EQ.I.ev (mulE p q)) f)
                                   (F.mulA (EQ.I.ev p) (EQ.I.ev q) f)
                                   (rp (F.mul (EQ.I.ev q) f) (rq f h)) } ;
  spans (f : F.R) : SP.In N g f =
    TC.bind (FD.Rep f) (SP.Coords N g f)
      (\ r -> SP.in-eq N g (F.mul (EQ.I.ev r.1) F.o) f (trans (F.mulO (EQ.I.ev r.1)) r.2) (all-mul r.1 F.o claim.1))
      (FD.generated f) ;
  finite : SP.Finite = (N, (g, spans)) ;
} ;
