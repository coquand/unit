-- FibreSpan.seg: finite spanning families modulo an extended ideal, for
-- Gate C (handoff §5) and Gate D (§6).
--
-- Let iota : A -> F be a ring map and B_1 .. B_t in F (B_j = iota(b_j) for
-- the ideal I0 = (b_1..b_t) of A; then (B) F = I0 F).  For g : Fin N -> F,
-- f is in the span of g modulo (B) (In N g f) when merely
--     f = sum_k g_k iota(alpha_k) + sum_j B_j w_j
-- (Coords: alpha in A, the congruence a FiniteIdeal certificate).  This is
-- the statement that the images of the g_k generate F / I0 F as an
-- A / I0-module, with the coefficients taken in A.
--
-- Finite: some finite family spans every element.
-- Lemmas (all by the FiniteIdeal certificate calculus):
--   in-zero, in-ideal, in-cong, in-eq, in-add, in-scale (iota(a) f),
--   in-sum (finite sums), in-lin (sum_k h_k iota(beta_k) for h_k in the span),
--   member (g_k is in the span: unit coefficients), in-snoc, in-snoc-elim
--   (adding a generator x, and removing it when x is in the span);
--   mul-closed: if z g_k is in the span for every k, then z f is, for every
--     f in the span (z f = sum_k (z g_k) iota(alpha_k) + sum_j B_j (z w_j));
--   in-mul-family: x f is in the span of x g;
--   in-appL, in-appR: a span of a block is in the span of a concatenation;
--   blocks d p g = the family p_j g_k (j < d, k < N), block by block:
--     block-in: f in the span of g gives p_j f in the span of blocks;
--     block-ind: a property of every p_j g_k holds for every element;
--     prod-in: f in span(g), f' in span(p) give f' f in span(blocks d p g),
--       since f' f = sum_j iota(alpha'_j) (p_j f) modulo (B).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module RH = RingHom[l] ; module Tr = Truncation[l] ;
module FF = FiniteFamilies[l] ; module TC = TruncationCombinators[l] ;

module Over (A F : CRing) (iota : RH.Hom A F) (t : Nat) (B : Ps.Fin t -> F.R) {
  module S = FiniteIdeal[l].Sums[F] ; module I = FiniteIdeal[l].Over[F,t,B] ; module L = RL[F] ;
  module FS = FF.Sums[F] ;

  -- sum_k g_k iota(alpha_k)
  comb (N : Nat) (g : Ps.Fin N -> F.R) (alpha : Ps.Fin N -> A.R) : F.R = S.lin N g (\ k -> iota.1 (alpha k)) ;
  Coords (N : Nat) (g : Ps.Fin N -> F.R) (f : F.R) : U l = (alpha : Ps.Fin N -> A.R) * I.Certificate f (comb N g alpha) ;
  In (N : Nat) (g : Ps.Fin N -> F.R) (f : F.R) : U l = Tr.Trunc[Coords N g f].carrier ;
  in-inc (N : Nat) (g : Ps.Fin N -> F.R) (f : F.R) (c : Coords N g f) : In N g f = Tr.Trunc[Coords N g f].inc c ;
  in-prop (N : Nat) (g : Ps.Fin N -> F.R) (f : F.R) : Pr.isProp (In N g f) = Tr.Trunc[Coords N g f].proposition ;
  -- F / (B) F is finite over A: a finite family spans every element
  Finite : U l = (N : Nat) * ((g : Ps.Fin N -> F.R) * ((f : F.R) -> In N g f)) ;

  ------------------------------------------------------------------------
  -- laws of combinations

  comb-zero (N : Nat) (g : Ps.Fin N -> F.R) : Id F.R (comb N g (\ k -> A.z)) F.z =
    trans (S.sum-cong N (\ k -> F.mul (g k) (iota.1 A.z)) (\ k -> F.mul (g k) F.z) (\ k -> ap (F.mul (g k)) (RH.zero A F iota)))
      (S.lin-zero N g) ;
  comb-add (N : Nat) (g : Ps.Fin N -> F.R) (al be : Ps.Fin N -> A.R) :
    Id F.R (comb N g (\ k -> A.add (al k) (be k))) (F.add (comb N g al) (comb N g be)) =
    trans (S.sum-cong N (\ k -> F.mul (g k) (iota.1 (A.add (al k) (be k)))) (\ k -> F.mul (g k) (F.add (iota.1 (al k)) (iota.1 (be k))))
             (\ k -> ap (F.mul (g k)) (iota.2.2.1 (al k) (be k))))
      (S.lin-add N g (\ k -> iota.1 (al k)) (\ k -> iota.1 (be k))) ;
  comb-scale (N : Nat) (g : Ps.Fin N -> F.R) (a : A.R) (al : Ps.Fin N -> A.R) :
    Id F.R (comb N g (\ k -> A.mul a (al k))) (F.mul (iota.1 a) (comb N g al)) =
    trans (S.sum-cong N (\ k -> F.mul (g k) (iota.1 (A.mul a (al k)))) (\ k -> F.mul (g k) (F.mul (iota.1 a) (iota.1 (al k))))
             (\ k -> ap (F.mul (g k)) (iota.2.2.2 a (al k))))
      (S.lin-scale N g (\ k -> iota.1 (al k)) (iota.1 a)) ;
  -- sum_k (x g_k) v_k = x sum_k g_k v_k
  lin-left (x : F.R) (N : Nat) (g v : Ps.Fin N -> F.R) : Id F.R (S.lin N (\ k -> F.mul x (g k)) v) (F.mul x (S.lin N g v)) =
    trans (S.sum-cong N (\ k -> F.mul (F.mul x (g k)) (v k)) (\ k -> F.mul x (F.mul (g k) (v k))) (\ k -> sym (F.mulA x (g k) (v k))))
      (S.sum-scale x N (\ k -> F.mul (g k) (v k))) ;
  -- (sum_k v_k) x = sum_k v_k x
  sum-right (x : F.R) (N : Nat) (v : Ps.Fin N -> F.R) : Id F.R (F.mul (S.sum N v) x) (S.sum N (\ k -> F.mul (v k) x)) =
    trans (F.mulC (S.sum N v) x)
      (trans (sym (S.sum-scale x N v)) (S.sum-cong N (\ k -> F.mul x (v k)) (\ k -> F.mul (v k) x) (\ k -> F.mulC x (v k)))) ;

  ------------------------------------------------------------------------
  -- elementary closure properties

  in-zero (N : Nat) (g : Ps.Fin N -> F.R) : In N g F.z =
    in-inc N g F.z (\ k -> A.z, I.equal F.z (comb N g (\ k -> A.z)) (sym (comb-zero N g))) ;
  -- an element of (B) F
  in-ideal (N : Nat) (g : Ps.Fin N -> F.R) (f : F.R) (h : I.Certificate f F.z) : In N g f =
    in-inc N g f (\ k -> A.z, I.transitive f F.z (comb N g (\ k -> A.z)) h (I.equal F.z (comb N g (\ k -> A.z)) (sym (comb-zero N g)))) ;
  in-cong (N : Nat) (g : Ps.Fin N -> F.R) (f f' : F.R) (h : I.Certificate f' f) : In N g f -> In N g f' =
    TC.map (Coords N g f) (Coords N g f') (\ c -> (c.1, I.transitive f' f (comb N g c.1) h c.2)) ;
  in-eq (N : Nat) (g : Ps.Fin N -> F.R) (f f' : F.R) (p : Id F.R f f') : In N g f -> In N g f' =
    in-cong N g f f' (I.equal f' f (sym p)) ;
  in-add (N : Nat) (g : Ps.Fin N -> F.R) (f f' : F.R) : In N g f -> In N g f' -> In N g (F.add f f') =
    TC.map2 (Coords N g f) (Coords N g f') (Coords N g (F.add f f')) (\ c c' ->
      (\ k -> A.add (c.1 k) (c'.1 k),
       I.transitive (F.add f f') (F.add (comb N g c.1) (comb N g c'.1)) (comb N g (\ k -> A.add (c.1 k) (c'.1 k)))
         (I.addition f (comb N g c.1) f' (comb N g c'.1) c.2 c'.2)
         (I.equal _ _ (sym (comb-add N g c.1 c'.1))))) ;
  in-scale (N : Nat) (g : Ps.Fin N -> F.R) (a : A.R) (f : F.R) : In N g f -> In N g (F.mul (iota.1 a) f) =
    TC.map (Coords N g f) (Coords N g (F.mul (iota.1 a) f)) (\ c ->
      (\ k -> A.mul a (c.1 k),
       I.transitive (F.mul (iota.1 a) f) (F.mul (iota.1 a) (comb N g c.1)) (comb N g (\ k -> A.mul a (c.1 k)))
         (I.multiplication (iota.1 a) (iota.1 a) f (comb N g c.1) (I.reflexive (iota.1 a)) c.2)
         (I.equal _ _ (sym (comb-scale N g a c.1))))) ;
  in-sum (N : Nat) (g : Ps.Fin N -> F.R) : (K : Nat) (f : Ps.Fin K -> F.R) -> ((k : Ps.Fin K) -> In N g (f k)) -> In N g (S.sum K f) = split {
    zero -> \ f h -> in-zero N g ;
    suc K | r -> \ f h -> in-add N g (f (inr tt)) (S.sum K (\ k -> f (inl k))) (h (inr tt)) (r (\ k -> f (inl k)) (\ k -> h (inl k))) } ;
  -- sum_k h_k iota(beta_k), every h_k in the span
  in-lin (N : Nat) (g : Ps.Fin N -> F.R) (K : Nat) (hs : Ps.Fin K -> F.R) (be : Ps.Fin K -> A.R)
    (h : (k : Ps.Fin K) -> In N g (hs k)) : In N g (S.lin K hs (\ k -> iota.1 (be k))) =
    in-sum N g K (\ k -> F.mul (hs k) (iota.1 (be k)))
      (\ k -> in-eq N g (F.mul (iota.1 (be k)) (hs k)) (F.mul (hs k) (iota.1 (be k))) (F.mulC (iota.1 (be k)) (hs k))
                (in-scale N g (be k) (hs k) (h k))) ;
  -- a combination of g is in the span of g
  comb-in (N : Nat) (g : Ps.Fin N -> F.R) (al : Ps.Fin N -> A.R) : In N g (comb N g al) =
    in-inc N g (comb N g al) (al, I.reflexive (comb N g al)) ;

  -- unit coefficients
  unit : (N : Nat) -> Ps.Fin N -> Ps.Fin N -> A.R = split {
    zero -> \ k -> absurd (Ps.Fin zero -> A.R) k ;
    suc N | r -> split {
      inl k -> Ps.snoc (Ps.Fin N) A.R (r k) A.z ;
      inr u -> Ps.snoc (Ps.Fin N) A.R (\ k' -> A.z) A.o } } ;
  -- g_last iota(0) + c = c
  drop-last (x c : F.R) : Id F.R (F.add (F.mul x (iota.1 A.z)) c) c =
    trans (ap (\ w -> F.add w c) (trans (ap (F.mul x) (RH.zero A F iota)) (L.mul-zero x))) (L.zl c) ;
  unit-comb : (N : Nat) (g : Ps.Fin N -> F.R) (k : Ps.Fin N) -> Id F.R (comb N g (unit N k)) (g k) = split {
    zero -> \ g k -> absurd (Id F.R (comb zero g (unit zero k)) (g k)) k ;
    suc N | r -> \ g -> split {
      inl k -> trans (drop-last (g (inr tt)) (comb N (\ i -> g (inl i)) (unit N k))) (r (\ i -> g (inl i)) k) ;
      inr u -> calc F.R {
        F.add (F.mul (g (inr tt)) (iota.1 A.o)) (comb N (\ i -> g (inl i)) (\ k' -> A.z))
          =< Ps.cong2 F.R F.add _ _ _ _ (trans (ap (F.mul (g (inr tt))) iota.2.1) (F.mulO (g (inr tt)))) (comb-zero N (\ i -> g (inl i)))
          > F.add (g (inr tt)) F.z
          =< F.addZ (g (inr tt)) > g (inr tt)
          =< ap (\ w -> g (inr w)) (FF.top-eta u) > g (inr u) } } } ;
  member (N : Nat) (g : Ps.Fin N -> F.R) (k : Ps.Fin N) : In N g (g k) =
    in-inc N g (g k) (unit N k, I.equal (g k) (comb N g (unit N k)) (sym (unit-comb N g k))) ;

  -- adding and removing one generator
  in-snoc (N : Nat) (g : Ps.Fin N -> F.R) (x f : F.R) : In N g f -> In (suc N) (Ps.snoc (Ps.Fin N) F.R g x) f =
    TC.map (Coords N g f) (Coords (suc N) (Ps.snoc (Ps.Fin N) F.R g x) f) (\ c ->
      (Ps.snoc (Ps.Fin N) A.R c.1 A.z,
       I.transitive f (comb N g c.1) (comb (suc N) (Ps.snoc (Ps.Fin N) F.R g x) (Ps.snoc (Ps.Fin N) A.R c.1 A.z)) c.2
         (I.equal _ _ (sym (drop-last x (comb N g c.1)))))) ;
  in-snoc-elim (N : Nat) (g : Ps.Fin N -> F.R) (x f : F.R) (hx : In N g x) : In (suc N) (Ps.snoc (Ps.Fin N) F.R g x) f -> In N g f =
    TC.bind (Coords (suc N) (Ps.snoc (Ps.Fin N) F.R g x) f) (Coords N g f) (\ c ->
      in-cong N g (F.add (F.mul x (iota.1 (c.1 (inr tt)))) (comb N g (\ k -> c.1 (inl k)))) f c.2
        (in-add N g (F.mul x (iota.1 (c.1 (inr tt)))) (comb N g (\ k -> c.1 (inl k)))
          (in-eq N g (F.mul (iota.1 (c.1 (inr tt))) x) (F.mul x (iota.1 (c.1 (inr tt)))) (F.mulC (iota.1 (c.1 (inr tt))) x)
             (in-scale N g (c.1 (inr tt)) x hx))
          (comb-in N g (\ k -> c.1 (inl k))))) ;

  ------------------------------------------------------------------------
  -- multiplication

  mul-closed (N : Nat) (g : Ps.Fin N -> F.R) (z : F.R) (hz : (k : Ps.Fin N) -> In N g (F.mul z (g k))) (f : F.R) :
    In N g f -> In N g (F.mul z f) =
    TC.bind (Coords N g f) (Coords N g (F.mul z f)) (\ c ->
      in-cong N g (F.mul z (comb N g c.1)) (F.mul z f)
        (I.multiplication z z f (comb N g c.1) (I.reflexive z) c.2)
        (in-eq N g (S.lin N (\ k -> F.mul z (g k)) (\ k -> iota.1 (c.1 k))) (F.mul z (comb N g c.1))
           (lin-left z N g (\ k -> iota.1 (c.1 k)))
           (in-lin N g N (\ k -> F.mul z (g k)) c.1 hz))) ;
  in-mul-family (N : Nat) (g : Ps.Fin N -> F.R) (x f : F.R) : In N g f -> In N (\ k -> F.mul x (g k)) (F.mul x f) =
    TC.map (Coords N g f) (Coords N (\ k -> F.mul x (g k)) (F.mul x f)) (\ c ->
      (c.1, I.transitive (F.mul x f) (F.mul x (comb N g c.1)) (comb N (\ k -> F.mul x (g k)) c.1)
              (I.multiplication x x f (comb N g c.1) (I.reflexive x) c.2)
              (I.equal _ _ (sym (lin-left x N g (\ k -> iota.1 (c.1 k))))))) ;

  ------------------------------------------------------------------------
  -- concatenations and blocks

  module Cat (a b : Nat) (g1 : Ps.Fin a -> F.R) (g2 : Ps.Fin b -> F.R) {
    G : Ps.Fin (plus a b) -> F.R = FF.app F.R a b g1 g2 ;
    -- iota (app al be) = app (iota al) (iota be)
    iota-app (al : Ps.Fin a -> A.R) (be : Ps.Fin b -> A.R) (k : Ps.Fin (plus a b)) :
      Id F.R (iota.1 (FF.app A.R a b al be k)) (FF.app F.R a b (\ i -> iota.1 (al i)) (\ j -> iota.1 (be j)) k) =
      FF.app-zip A.R A.R F.R (\ p q -> iota.1 p) a b al be al be k ;
    comb-app (al : Ps.Fin a -> A.R) (be : Ps.Fin b -> A.R) :
      Id F.R (comb (plus a b) G (FF.app A.R a b al be)) (F.add (comb a g1 al) (comb b g2 be)) =
      trans (S.sum-cong (plus a b) (\ k -> F.mul (G k) (iota.1 (FF.app A.R a b al be k)))
               (\ k -> F.mul (G k) (FF.app F.R a b (\ i -> iota.1 (al i)) (\ j -> iota.1 (be j)) k))
               (\ k -> ap (F.mul (G k)) (iota-app al be k)))
        (FS.lin-app a b g1 (\ i -> iota.1 (al i)) g2 (\ j -> iota.1 (be j))) ;
    in-appL (f : F.R) : In a g1 f -> In (plus a b) G f =
      TC.map (Coords a g1 f) (Coords (plus a b) G f) (\ c ->
        (FF.app A.R a b c.1 (\ j -> A.z),
         I.transitive f (comb a g1 c.1) (comb (plus a b) G (FF.app A.R a b c.1 (\ j -> A.z))) c.2
           (I.equal _ _ (sym (trans (comb-app c.1 (\ j -> A.z))
              (trans (ap (F.add (comb a g1 c.1)) (comb-zero b g2)) (F.addZ (comb a g1 c.1)))))))) ;
    in-appR (f : F.R) : In b g2 f -> In (plus a b) G f =
      TC.map (Coords b g2 f) (Coords (plus a b) G f) (\ c ->
        (FF.app A.R a b (\ i -> A.z) c.1,
         I.transitive f (comb b g2 c.1) (comb (plus a b) G (FF.app A.R a b (\ i -> A.z) c.1)) c.2
           (I.equal _ _ (sym (trans (comb-app (\ i -> A.z) c.1)
              (trans (ap (\ w -> F.add w (comb b g2 c.1)) (comb-zero a g1)) (L.zl (comb b g2 c.1)))))))) ;
  } ;

  bsz : Nat -> Nat -> Nat = split { zero -> \ N -> zero ; suc d | r -> \ N -> plus (r N) N } ;
  -- p_j g_k, block by block (the block of p_(d+1) last)
  blocks : (d : Nat) (p : Ps.Fin d -> F.R) (N : Nat) (g : Ps.Fin N -> F.R) -> Ps.Fin (bsz d N) -> F.R = split {
    zero -> \ p N g k -> absurd F.R k ;
    suc d | r -> \ p N g -> FF.app F.R (bsz d N) N (r (\ j -> p (inl j)) N g) (\ k -> F.mul (p (inr tt)) (g k)) } ;

  block-in : (d : Nat) (p : Ps.Fin d -> F.R) (N : Nat) (g : Ps.Fin N -> F.R) (j : Ps.Fin d) (f : F.R) ->
    In N g f -> In (bsz d N) (blocks d p N g) (F.mul (p j) f) = split {
    zero -> \ p N g j -> absurd ((f : F.R) -> In N g f -> In (bsz zero N) (blocks zero p N g) (F.mul (p j) f)) j ;
    suc d | r -> \ p N g -> split {
      inl j -> \ f h -> Cat[bsz d N,N,blocks d (\ j' -> p (inl j')) N g,\ k -> F.mul (p (inr tt)) (g k)].in-appL (F.mul (p (inl j)) f)
                          (r (\ j' -> p (inl j')) N g j f h) ;
      inr u -> \ f h -> Cat[bsz d N,N,blocks d (\ j' -> p (inl j')) N g,\ k -> F.mul (p (inr tt)) (g k)].in-appR (F.mul (p (inr u)) f)
                          (in-eq N (\ k -> F.mul (p (inr tt)) (g k)) (F.mul (p (inr tt)) f) (F.mul (p (inr u)) f)
                             (ap (\ w -> F.mul (p (inr w)) f) (FF.top-eta u))
                             (in-mul-family N g (p (inr tt)) f h)) } } ;

  block-ind (Q : F.R -> U l) : (d : Nat) (p : Ps.Fin d -> F.R) (N : Nat) (g : Ps.Fin N -> F.R) ->
    ((j : Ps.Fin d) (k : Ps.Fin N) -> Q (F.mul (p j) (g k))) -> (idx : Ps.Fin (bsz d N)) -> Q (blocks d p N g idx) = split {
    zero -> \ p N g q idx -> absurd (Q (blocks zero p N g idx)) idx ;
    suc d | r -> \ p N g q -> FF.app-ind F.R Q (bsz d N) N (blocks d (\ j -> p (inl j)) N g) (\ k -> F.mul (p (inr tt)) (g k))
                               (r (\ j -> p (inl j)) N g (\ j k -> q (inl j) k)) (q (inr tt)) } ;

  -- (p a) f = a (p f)
  rearrange (p a f : F.R) : Id F.R (F.mul (F.mul p a) f) (F.mul a (F.mul p f)) =
    trans (ap (\ w -> F.mul w f) (F.mulC p a)) (sym (F.mulA a p f)) ;
  prod-in (d : Nat) (p : Ps.Fin d -> F.R) (N : Nat) (g : Ps.Fin N -> F.R) (f f' : F.R) (h : In N g f) :
    In d p f' -> In (bsz d N) (blocks d p N g) (F.mul f' f) =
    TC.bind (Coords d p f') (Coords (bsz d N) (blocks d p N g) (F.mul f' f)) (\ c ->
      in-cong (bsz d N) (blocks d p N g) (F.mul (comb d p c.1) f) (F.mul f' f)
        (I.multiplication f' (comb d p c.1) f f c.2 (I.reflexive f))
        (in-eq (bsz d N) (blocks d p N g) (S.sum d (\ j -> F.mul (F.mul (p j) (iota.1 (c.1 j))) f)) (F.mul (comb d p c.1) f)
           (sym (sum-right f d (\ j -> F.mul (p j) (iota.1 (c.1 j)))))
           (in-sum (bsz d N) (blocks d p N g) d (\ j -> F.mul (F.mul (p j) (iota.1 (c.1 j))) f)
              (\ j -> in-eq (bsz d N) (blocks d p N g) (F.mul (iota.1 (c.1 j)) (F.mul (p j) f)) (F.mul (F.mul (p j) (iota.1 (c.1 j))) f)
                        (sym (rearrange (p j) (iota.1 (c.1 j)) f))
                        (in-scale (bsz d N) (blocks d p N g) (c.1 j) (F.mul (p j) f) (block-in d p N g j f h)))))) ;
} ;
