-- CertificateLocalisation.seg: B[1/s] -> E[1/s] is an isomorphism, for
-- B = R[s, s x_1, .., s x_n] and x_1 .. x_n generating E (handoff §7).
--
-- LocalMap (h : A -> C a ring map, j in A).  On fractions a/u (u = j^k),
-- mapF (a/u) = h(a)/h(u), and h(j^k) = h(j)^k (power-natural).  A witness
-- v (a u' - a' u) = 0 of the relation goes to its image (map-witness), so
-- mapF descends to phi : A[1/j] -> C[1/h(j)] (D, phi-beta), a ring map:
-- on representatives the numerators and denominators of phi(p + q) and
-- phi(p) + phi(q) are equal (same), likewise for products and 1; and
-- phi(a/1) = h(a)/1 (phi-constant).
--
-- Iso (A = B, C = E, h the inclusion, j = s; any s, no certificate).
--   injective: phi(b/s^k) = 0 means v (b 1) = v (0 s^k) in E with v = s^m
--     (effectiveness of E[1/s]); this equation is in B since B -> E is
--     injective (incl-inj), with s_B^m in place of v, so b/s^k = 0 in B[1/s]
--     (kernel-zero); a ring map with zero kernel is injective.
--   surjective: e/s^k with e = H(x) merely (gen); clearing denominators,
--     s^N H(x) is in B for some N (cleared, by induction on H: s x_i,
--     iota(r), and s^(N1+N2)(p + q) = s^N2 (s^N1 p) + s^N1 (s^N2 q),
--     s^(N1+N2)(p q) = (s^N1 p)(s^N2 q)), and e/s^k = (s^N e)/s^(N+k).
--   The fibres of phi are propositions (injective, sets) and merely
--   inhabited, hence inhabited: phi is an equivalence (iso), with inverse
--   the centre of the fibre.  No choice; nothing about R.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module RH = RingHom[l] ; module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ; module CS = CertificateSubalgebra[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;

module LocalMap (A C : CRing) (h : RH.Hom A C) (j : A.R) {
  module LA = PowerLocalization[l].Over[A,j] ; module LC = PowerLocalization[l].Over[C,h.1 j] ;
  module PA = AffinePowers[l].Over[A] ; module PC = AffinePowers[l].Over[C] ;
  FA : U l = LA.L.Raw.Fraction ;
  FC : U l = LC.L.Raw.Fraction ;
  power-natural : (k : Nat) -> Id C.R (h.1 (PA.power j k)) (PC.power (h.1 j) k) = split {
    zero -> h.2.1 ;
    suc k | r -> trans (h.2.2.2 j (PA.power j k)) (ap (C.mul (h.1 j)) r) } ;
  power-map (u : A.R) (hu : LA.Powers u) : LC.Powers (h.1 u) = (hu.1, trans (ap h.1 hu.2) (power-natural hu.1)) ;
  mapF (p : FA) : FC = (h.1 p.1, (h.1 p.2.1, power-map p.2.1 p.2.2)) ;
  -- h(u (a b)) = h(u) (h(a) h(b))
  hmul2 (u a b : A.R) : Id C.R (h.1 (A.mul u (A.mul a b))) (C.mul (h.1 u) (C.mul (h.1 a) (h.1 b))) =
    trans (h.2.2.2 u (A.mul a b)) (ap (C.mul (h.1 u)) (h.2.2.2 a b)) ;
  map-witness (p q : FA) (wt : LA.L.Raw.Witness p q) : LC.L.Raw.Witness (mapF p) (mapF q) =
    (h.1 wt.1, (power-map wt.1 wt.2.1,
     trans (sym (hmul2 wt.1 p.1 q.2.1)) (trans (ap h.1 wt.2.2) (hmul2 wt.1 q.1 p.2.1)))) ;
  respect (p q : FA) (r : LA.L.Raw.Relation p q) : Id LC.L.Carrier (LC.L.include (mapF p)) (LC.L.include (mapF q)) =
    LC.L.Q.relates (mapF p) (mapF q) (TC.map (LA.L.Raw.Witness p q) (LC.L.Raw.Witness (mapF p) (mapF q)) (map-witness p q) r) ;
  module D = LA.L.Q.Descend[LC.L.Carrier,LC.L.set,\ p -> LC.L.include (mapF p),respect] ;
  phi-map (q : LA.ring.R) : LC.ring.R = D.map q ;
  phi-beta (p : FA) : Id LC.ring.R (phi-map (LA.L.include p)) (LC.L.include (mapF p)) = D.beta p ;
  -- fractions with equal numerators and denominators
  same (x y : FC) (p1 : Id C.R x.1 y.1) (p2 : Id C.R x.2.1 y.2.1) : Id LC.ring.R (LC.L.include x) (LC.L.include y) =
    LC.L.Q.relates x y (LC.L.Raw.exact x y (trans (ap (\ u -> C.mul u y.2.1) p1) (ap (C.mul y.1) (sym p2)))) ;
  phi-one : Id LC.ring.R (phi-map LA.ring.o) LC.ring.o =
    trans (phi-beta (LA.L.Raw.constantF A.o)) (same (mapF (LA.L.Raw.constantF A.o)) (LC.L.Raw.constantF C.o) h.2.1 h.2.1) ;
  phi-add (q q' : LA.ring.R) : Id LC.ring.R (phi-map (LA.ring.add q q')) (LC.ring.add (phi-map q) (phi-map q')) =
    LA.L.forall2 (\ u v -> Id LC.ring.R (phi-map (LA.ring.add u v)) (LC.ring.add (phi-map u) (phi-map v))) (\ u v -> LC.L.set _ _)
      (\ p r -> calc LC.ring.R {
        phi-map (LA.L.addQ (LA.L.include p) (LA.L.include r)) =< ap phi-map (LA.L.Add.beta p r) > phi-map (LA.L.include (LA.L.Raw.addF p r))
          =< phi-beta (LA.L.Raw.addF p r) > LC.L.include (mapF (LA.L.Raw.addF p r))
          =< same (mapF (LA.L.Raw.addF p r)) (LC.L.Raw.addF (mapF p) (mapF r))
               (trans (h.2.2.1 (A.mul p.1 r.2.1) (A.mul r.1 p.2.1)) (Ps.cong2 C.R C.add _ _ _ _ (h.2.2.2 p.1 r.2.1) (h.2.2.2 r.1 p.2.1)))
               (h.2.2.2 p.2.1 r.2.1)
          > LC.L.include (LC.L.Raw.addF (mapF p) (mapF r))
          =< sym (LC.L.Add.beta (mapF p) (mapF r)) > LC.L.addQ (LC.L.include (mapF p)) (LC.L.include (mapF r))
          =< sym (Ps.cong2 LC.ring.R LC.L.addQ _ _ _ _ (phi-beta p) (phi-beta r))
          > LC.L.addQ (phi-map (LA.L.include p)) (phi-map (LA.L.include r)) }) q q' ;
  phi-mul (q q' : LA.ring.R) : Id LC.ring.R (phi-map (LA.ring.mul q q')) (LC.ring.mul (phi-map q) (phi-map q')) =
    LA.L.forall2 (\ u v -> Id LC.ring.R (phi-map (LA.ring.mul u v)) (LC.ring.mul (phi-map u) (phi-map v))) (\ u v -> LC.L.set _ _)
      (\ p r -> calc LC.ring.R {
        phi-map (LA.L.mulQ (LA.L.include p) (LA.L.include r)) =< ap phi-map (LA.L.Multiply.beta p r) > phi-map (LA.L.include (LA.L.Raw.mulF p r))
          =< phi-beta (LA.L.Raw.mulF p r) > LC.L.include (mapF (LA.L.Raw.mulF p r))
          =< same (mapF (LA.L.Raw.mulF p r)) (LC.L.Raw.mulF (mapF p) (mapF r)) (h.2.2.2 p.1 r.1) (h.2.2.2 p.2.1 r.2.1)
          > LC.L.include (LC.L.Raw.mulF (mapF p) (mapF r))
          =< sym (LC.L.Multiply.beta (mapF p) (mapF r)) > LC.L.mulQ (LC.L.include (mapF p)) (LC.L.include (mapF r))
          =< sym (Ps.cong2 LC.ring.R LC.L.mulQ _ _ _ _ (phi-beta p) (phi-beta r))
          > LC.L.mulQ (phi-map (LA.L.include p)) (phi-map (LA.L.include r)) }) q q' ;
  phi : RH.Hom LA.ring LC.ring = (phi-map, phi-one, phi-add, phi-mul) ;
  phi-constant (a : A.R) : Id LC.ring.R (phi.1 (LA.inclusion.1 a)) (LC.inclusion.1 (h.1 a)) =
    trans (phi-beta (LA.L.Raw.constantF a)) (same (mapF (LA.L.Raw.constantF a)) (LC.L.Raw.constantF (h.1 a)) (refl (h.1 a)) h.2.1) ;
} ;

------------------------------------------------------------------------
-- the isomorphism

module Iso (R : CRing) (setR : Pr.isSet R.R) (Ea : Algebras[l].Over[R,setR].Algebra) (n : Nat) (x : Ps.Fin n -> Ea.ring.R) (s : Ea.ring.R)
  (gen : (e : Ea.ring.R) -> Tr.Trunc[(H : Presentations[l].Over[R,setR].Expr (Ps.Fin n)) *
                                     Id Ea.ring.R (Presentations[l].Over[R,setR].eval (Ps.Fin n) Ea x H) e].carrier) {
  module B = CS.Over[R,setR,Ea,n,x,s] ;
  E : CRing = Ea.ring ;
  module LM = LocalMap[B.ring,E,B.incl,B.sB] ;
  module LA = LM.LA ; module LC = LM.LC ;
  module PB = LM.PA ; module PE = LM.PC ;
  module LE = RL[E] ; module LB = RL[LA.ring] ;
  -- B[1/s] and E[1/s]
  Bs : CRing = LA.ring ;
  Es : CRing = LC.ring ;
  phi : RH.Hom Bs Es = LM.phi ;

  ------------------------------------------------------------------------
  -- injectivity

  module Ker (p : LM.FA) (wt : LC.L.Raw.Witness (LM.mapF p) (LC.L.Raw.constantF E.z)) {
    k : Nat = wt.2.1.1 ;
    u : B.Carrier = PB.power B.sB k ;
    -- incl(s_B^k) = v
    u-is : Id E.R (B.incl.1 u) wt.1 = trans (LM.power-natural k) (sym wt.2.1.2) ;
    eq : Id B.Carrier (B.ring.mul u (B.ring.mul p.1 B.ring.o)) (B.ring.mul u (B.ring.mul B.ring.z p.2.1)) =
      B.incl-inj _ _ (trans (ap (\ t -> E.mul t (E.mul p.1.1 E.o)) u-is)
                       (trans wt.2.2 (ap (\ t -> E.mul t (E.mul E.z p.2.1.1)) (sym u-is)))) ;
    zero-eq : Id Bs.R (LA.L.include p) Bs.z =
      LA.L.Q.relates p (LA.L.Raw.constantF B.ring.z)
        (Tr.Trunc[LA.L.Raw.Witness p (LA.L.Raw.constantF B.ring.z)].inc (u, ((k, refl u), eq))) ;
  } ;
  kernel-zero (q : Bs.R) : Id Es.R (phi.1 q) Es.z -> Id Bs.R q Bs.z =
    LA.L.Q.induction @l (\ q' -> Id Es.R (phi.1 q') Es.z -> Id Bs.R q' Bs.z)
      (\ q' -> FE.isProp-Pi (Id Es.R (phi.1 q') Es.z) (\ e -> Id Bs.R q' Bs.z) (\ e -> LA.set _ _))
      (\ p e -> Tr.Trunc[LC.L.Raw.Witness (LM.mapF p) (LC.L.Raw.constantF E.z)].induction @l (\ t -> Id Bs.R (LA.L.include p) Bs.z)
                  (\ t -> LA.set _ _) (\ wt -> Ker[p,wt].zero-eq)
                  (LC.L.Q.effective (LM.mapF p) (LC.L.Raw.constantF E.z) (trans (sym (LM.phi-beta p)) e))) q ;
  -- phi(q - q') = 0
  diff-zero (q q' : Bs.R) (e : Id Es.R (phi.1 q) (phi.1 q')) : Id Es.R (phi.1 (Bs.add q (Bs.neg q'))) Es.z =
    trans (phi.2.2.1 q (Bs.neg q'))
      (trans (ap (Es.add (phi.1 q)) (RH.negation Bs Es phi q'))
        (trans (ap (\ t -> Es.add t (Es.neg (phi.1 q'))) e) (Es.addN (phi.1 q')))) ;
  injective (q q' : Bs.R) (e : Id Es.R (phi.1 q) (phi.1 q')) : Id Bs.R q q' =
    sym (calc Bs.R {
      q' =< sym (LB.neg-neg q') > Bs.neg (Bs.neg q')
        =< ap Bs.neg (LB.neg-uniq q (Bs.neg q') (kernel-zero (Bs.add q (Bs.neg q')) (diff-zero q q' e))) > Bs.neg (Bs.neg q)
        =< LB.neg-neg q > q }) ;

  ------------------------------------------------------------------------
  -- surjectivity

  module P = Presentations[l].Over[R,setR] ;
  evx (H : P.Expr (Ps.Fin n)) : E.R = P.eval (Ps.Fin n) Ea x H ;
  power-in : (N : Nat) -> B.InB (PE.power s N) = split {
    zero -> B.in-one ;
    suc N | r -> B.in-mul s (PE.power s N) (B.in-w (inr tt)) r } ;
  Cleared (e : E.R) : U l = (N : Nat) * B.InB (E.mul (PE.power s N) e) ;
  -- s^(N1+N2) = s^N1 s^N2
  pa (N1 N2 : Nat) : Id E.R (PE.power s (plus N1 N2)) (E.mul (PE.power s N1) (PE.power s N2)) = PE.power-add s N1 N2 ;
  sum-eq (a1 a2 p q : E.R) : Id E.R (E.add (E.mul a2 (E.mul a1 p)) (E.mul a1 (E.mul a2 q))) (E.mul (E.mul a1 a2) (E.add p q)) =
    sym (trans (E.dist (E.mul a1 a2) p q)
          (Ps.cong2 E.R E.add _ _ _ _ (trans (ap (\ t -> E.mul t p) (E.mulC a1 a2)) (sym (E.mulA a2 a1 p))) (sym (E.mulA a1 a2 q)))) ;
  cleared : (H : P.Expr (Ps.Fin n)) -> Tr.Trunc[Cleared (evx H)].carrier = split {
    var i -> Tr.Trunc[Cleared (x i)].inc (suc zero,
               B.in-eq (E.mul s (x i)) (E.mul (PE.power s (suc zero)) (x i)) (ap (\ t -> E.mul t (x i)) (sym (E.mulO s))) (B.in-w (inl i))) ;
    cst r -> Tr.Trunc[Cleared (Ea.iota.1 r)].inc (zero, B.in-eq (Ea.iota.1 r) (E.mul E.o (Ea.iota.1 r)) (sym (LE.one-left (Ea.iota.1 r))) (B.in-cst r)) ;
    sumE p q | rp rq -> TC.map2 (Cleared (evx p)) (Cleared (evx q)) (Cleared (evx (sumE p q)))
      (\ c1 c2 -> (plus c1.1 c2.1,
        B.in-eq _ (E.mul (PE.power s (plus c1.1 c2.1)) (evx (sumE p q)))
          (trans (sum-eq (PE.power s c1.1) (PE.power s c2.1) (evx p) (evx q)) (ap (\ t -> E.mul t (evx (sumE p q))) (sym (pa c1.1 c2.1))))
          (B.in-add _ _ (B.in-mul _ _ (power-in c2.1) c1.2) (B.in-mul _ _ (power-in c1.1) c2.2)))) rp rq ;
    mulE p q | rp rq -> TC.map2 (Cleared (evx p)) (Cleared (evx q)) (Cleared (evx (mulE p q)))
      (\ c1 c2 -> (plus c1.1 c2.1,
        B.in-eq _ (E.mul (PE.power s (plus c1.1 c2.1)) (evx (mulE p q)))
          (trans (LE.mul-four (PE.power s c1.1) (evx p) (PE.power s c2.1) (evx q))
                 (ap (\ t -> E.mul t (evx (mulE p q))) (sym (pa c1.1 c2.1))))
          (B.in-mul _ _ c1.2 c2.2))) rp rq } ;

  Fib (q : Es.R) : U l = (b : Bs.R) * Id Es.R (phi.1 b) q ;
  module Pre (p : LM.FC) (H : P.Expr (Ps.Fin n)) (eH : Id E.R (evx H) p.1) (c : Cleared (evx H)) {
    N : Nat = c.1 ;
    k : Nat = p.2.2.1 ;
    num : B.Carrier = (E.mul (PE.power s N) p.1, B.in-eq _ _ (ap (E.mul (PE.power s N)) eH) c.2) ;
    frac : LM.FA = (num, (PB.power B.sB (plus N k), (plus N k, refl (PB.power B.sB (plus N k))))) ;
    -- (s^N e) s^k = e s^(N+k)
    exact : Id E.R (E.mul (E.mul (PE.power s N) p.1) p.2.1) (E.mul p.1 (B.incl.1 (PB.power B.sB (plus N k)))) = calc E.R {
      E.mul (E.mul (PE.power s N) p.1) p.2.1 =< ap (E.mul (E.mul (PE.power s N) p.1)) p.2.2.2 > E.mul (E.mul (PE.power s N) p.1) (PE.power s k)
        =< ap (\ t -> E.mul t (PE.power s k)) (E.mulC (PE.power s N) p.1) > E.mul (E.mul p.1 (PE.power s N)) (PE.power s k)
        =< sym (E.mulA p.1 (PE.power s N) (PE.power s k)) > E.mul p.1 (E.mul (PE.power s N) (PE.power s k))
        =< ap (E.mul p.1) (trans (sym (pa N k)) (sym (LM.power-natural (plus N k)))) > E.mul p.1 (B.incl.1 (PB.power B.sB (plus N k))) } ;
    hits : Id Es.R (phi.1 (LA.L.include frac)) (LC.L.include p) =
      trans (LM.phi-beta frac) (LC.L.Q.relates (LM.mapF frac) p (LC.L.Raw.exact (LM.mapF frac) p exact)) ;
  } ;
  surjective (q : Es.R) : Tr.Trunc[Fib q].carrier =
    TC.bind (LC.L.Representatives q) (Fib q) (\ rp ->
      TC.bind ((H : P.Expr (Ps.Fin n)) * Id E.R (evx H) rp.1.1) (Fib q) (\ g ->
        TC.map (Cleared (evx g.1)) (Fib q) (\ c -> (LA.L.include Pre[rp.1,g.1,g.2,c].frac, trans Pre[rp.1,g.1,g.2,c].hits rp.2))
          (cleared g.1))
        (gen rp.1.1))
      (LC.L.representatives q) ;

  ------------------------------------------------------------------------
  -- the isomorphism

  fib-prop (q : Es.R) : Pr.isProp (Fib q) = \ f f' ->
    Pr.Sigma-eq Bs.R (\ b -> Id Es.R (phi.1 b) q) f.1 f'.1 f.2 f'.2 (injective f.1 f'.1 (trans f.2 (sym f'.2))) (LC.set _ _) ;
  fib (q : Es.R) : Fib q = Tr.Trunc[Fib q].induction @l (\ u -> Fib q) (\ u -> fib-prop q) (\ f -> f) (surjective q) ;
  inverse (q : Es.R) : Bs.R = (fib q).1 ;
  iso : Pr.Equiv Bs.R Es.R =
    (phi.1, Pr.qinv Bs.R Es.R phi.1 inverse (\ q -> (fib q).2) (\ b -> injective (inverse (phi.1 b)) b (fib (phi.1 b)).2)) ;
} ;

------------------------------------------------------------------------
-- the standard consequence of a certificate

module Consequence (R : CRing) (setR : Pr.isSet R.R) (Ea : Algebras[l].Over[R,setR].Algebra) (n : Nat) (x : Ps.Fin n -> Ea.ring.R)
  (gen : (e : Ea.ring.R) -> Tr.Trunc[(H : Presentations[l].Over[R,setR].Expr (Ps.Fin n)) *
                                     Id Ea.ring.R (Presentations[l].Over[R,setR].eval (Ps.Fin n) Ea x H) e].carrier)
  (t : Nat) (a : Ps.Fin t -> R.R) (c : ZMTCertificate[l].ZMTCert[R,Ea.ring,Ea.iota,n,x,t,a]) {
  module FB = CS.Finite[R,setR,Ea,n,x,t,a,c] ;
  module I = Iso[R,setR,Ea,n,x,c.s,gen] ;
  -- B = R[s, s x_1 .. s x_n] is finite over R
  finite : QuotientFibre[l].ModuleFinite[R,FB.B.ring,FB.B.iotaB] = FB.finite ;
  -- B[1/s] -> E[1/s], a ring map and an equivalence
  phi : RH.Hom I.Bs I.Es = I.phi ;
  iso : Pr.Equiv I.Bs.R I.Es.R = I.iso ;
  iso-map (b : I.Bs.R) : Id I.Es.R (iso.1 b) (phi.1 b) = refl (phi.1 b) ;
} ;
