-- CoefficientBase.seg: the coefficient base A_m = Z[C_1, .., C_m], Gate B
-- (handoff §4).
--
-- A_0 = Z (ZRing) and A_(m+1) = A_m[C_(m+1)] (PolynomialRing.Extension).
-- A variable index k : Fin (m+1) = Fin m + 1 is inl k for an old variable
-- (a constant of A_(m+1)) and inr tt for the new one (var, var-new, var-old).
--
-- Evaluation (ev): for any commutative set-ring R and c : Fin m -> R, the
-- ring map h_c : A_m -> R with h_c(C_k) = c_k (ev-var): the initial map
-- Z -> R (ZRing.Initial) for m = 0, and the extension of h_(c o inl) by
-- C_(m+1) |-> c (inr tt) (Universal.Given) at each step.  Nothing is
-- assumed on R; h_c need not be injective or surjective.
--
-- CFN (cfn): Z is CFN with codes Nat * Nat (ZCFN), and A[X] is CFN when A
-- is (HilbertCFN.poly), so A_m is CFN by induction on m.  The arbitrary
-- target R is not required to be CFN.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module H = RingHom[l] ;
module ZR = ZRing[l] ; module FF = FiniteFamilies[l] ;

-- a commutative set-ring
SetRing : U (l+) = (R : CRing) * Pr.isSet R.R ;
tower : Nat -> SetRing = split {
  zero -> (ZR.ring, ZR.set) ;
  suc m | r -> (PolynomialRing[l].Extension[r.1,r.2].ring, PolynomialRing[l].Extension[r.1,r.2].set) } ;
ring (m : Nat) : CRing = (tower m).1 ;
set (m : Nat) : Pr.isSet (ring m).R = (tower m).2 ;
-- by definition of the tower
ring-suc (m : Nat) : Id CRing (ring (suc m)) PolynomialRing[l].Extension[ring m,set m].ring = refl (ring (suc m)) ;

-- the variables C_1 .. C_m
var : (m : Nat) -> Ps.Fin m -> (ring m).R = split {
  zero -> \ k -> absurd (ring zero).R k ;
  suc m | r -> split {
    inl k -> PolynomialRing[l].Extension[ring m,set m].constant (r k) ;
    inr u -> PolynomialRing[l].Extension[ring m,set m].variable } } ;
-- by definition of var
var-new (m : Nat) : Id (ring (suc m)).R (var (suc m) (inr tt)) PolynomialRing[l].Extension[ring m,set m].variable =
  refl (var (suc m) (inr tt)) ;
var-old (m : Nat) (k : Ps.Fin m) : Id (ring (suc m)).R (var (suc m) (inl k)) (PolynomialRing[l].Extension[ring m,set m].constant (var m k)) =
  refl (var (suc m) (inl k)) ;

------------------------------------------------------------------------
-- evaluation

module Eval (R : CRing) (setR : Pr.isSet R.R) {
  module Step (m : Nat) (f : H.Hom (ring m) R) (c : R.R) {
    module G = Universal[l].Property[ring m,R,set m,setR].Given[f,c] ;
  } ;
  ev : (m : Nat) -> (Ps.Fin m -> R.R) -> H.Hom (ring m) R = split {
    zero -> \ c -> ZR.Initial[R].hom ;
    suc m | r -> \ c -> Step[m,r (\ k -> c (inl k)),c (inr tt)].G.extend } ;
  ev-var : (m : Nat) (c : Ps.Fin m -> R.R) (k : Ps.Fin m) -> Id R.R ((ev m c).1 (var m k)) (c k) = split {
    zero -> \ c k -> absurd (Id R.R ((ev zero c).1 (var zero k)) (c k)) k ;
    suc m | r -> \ c -> split {
      inl k -> trans (Step[m,ev m (\ k' -> c (inl k')),c (inr tt)].G.on-constants (var m k)) (r (\ k' -> c (inl k')) k) ;
      inr u -> trans Step[m,ev m (\ k' -> c (inl k')),c (inr tt)].G.on-variable (ap (\ w -> c (inr w)) (FF.top-eta u)) } } ;
} ;

------------------------------------------------------------------------
-- CFN

Codes : U l = Nat * Nat ;
cfn : (m : Nat) -> CFN[l].CFN[Codes,ring m] = split {
  zero -> ZCFN[l].cfn ;
  suc m | r -> HilbertCFN[l].Over[Codes,ring m,set m].poly r } ;
