-- FiniteFibreLocalisation.seg: the ZMT conclusion in its usual form.
--
-- Theorem (Over..Theorem[U0].result).  Let R be any commutative set-ring
-- with an ideal I (propositional membership), E an R-algebra generated by
-- x_1 .. x_n (gen), and E/IE finite over R/I (merely: fo).  Given the CFN
-- principle UniversalZMT n (or CFNZMT n: TheoremCFN), merely there are
--   s in E with s - 1 in IE,
--   a finite R-subalgebra B of E containing s (B = R[s, s x_1, .., s x_n]
--     with the subring structure of CertificateSubalgebra),
--   an isomorphism B[1/s] = E[1/s] (an equivalence whose underlying map is
--     the ring map phi induced by B -> E).
-- (Conclusion, with the B of s given by ForS[s].)
--
-- Proof.  QuotientFibre.Gen.Theorem gives merely a = (a_j) in I and a
-- certificate c with s = 1 + sum_j iota(a_j) r_j: so s - 1 is in IE with
-- the witness (a, r) (in-one-plus-IE).  CertificateLocalisation.Consequence
-- for c gives B finite over R and B[1/s] = E[1/s]; s is in B (in-w).  The
-- conclusion is a proposition-valued truncation, so the certificate is
-- only used under the truncation.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module RH = RingHom[l] ; module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ; module RI = RegularIdeal[l] ; module IW = IdealWitnesses[l] ;
module QFm = QuotientFibre[l] ; module CS = CertificateSubalgebra[l] ; module CL = CertificateLocalisation[l] ;
module FFC = FiniteFibreCertificates[l] ; module CD = CFNDescent[l] ;

module Over (R : CRing) (setR : Pr.isSet R.R) (I : RI.IdealPred[R]) (propI : (a : R.R) -> Pr.isProp (I.In a))
  (Ea : Algebras[l].Over[R,setR].Algebra) (n : Nat) (x : Ps.Fin n -> Ea.ring.R)
  (gen : (e : Ea.ring.R) -> Tr.Trunc[(H : Presentations[l].Over[R,setR].Expr (Ps.Fin n)) *
                                     Id Ea.ring.R (Presentations[l].Over[R,setR].eval (Ps.Fin n) Ea x H) e].carrier)
  (fo : Tr.Trunc[QFm.Over[R,setR,I,propI,Ea].Finite].carrier) {
  module QF = QFm.Over[R,setR,I,propI,Ea] ;
  E : CRing = Ea.ring ;
  iota : RH.Hom R E = Ea.iota ;
  module L = RL[E] ;

  -- B = R[s, s x_i], finite over R, containing s, with B[1/s] = E[1/s]
  module ForS (s : E.R) {
    module B = CS.Over[R,setR,Ea,n,x,s] ;
    module LI = CL.Iso[R,setR,Ea,n,x,s,gen] ;
    Data : U l = QFm.ModuleFinite[R,B.ring,B.iotaB] * (B.InB s * Pr.Equiv LI.Bs.R LI.Es.R) ;
  } ;
  Conclusion : U l = (s : E.R) * (QF.InIE (E.add s (E.neg E.o)) * ForS[s].Data) ;

  -- s = 1 + sum_j iota(a_j) r_j with a_j in I: s - 1 is in IE
  module Of (c : FFC.Certified[R,I.In,E,iota,n,x]) {
    s : E.R = c.cert.s ;
    v : Ps.Fin c.t -> E.R = c.cert.cong.1 ;
    comb : E.R = FiniteIdeal[l].Sums[E].lin c.t (\ j -> iota.1 (c.a j)) v ;
    sub-one : Id E.R (E.add s (E.neg E.o)) comb =
      trans (ap (\ u -> E.add u (E.neg E.o)) c.cert.cong.2)
        (trans (ap (\ u -> E.add u (E.neg E.o)) (E.addC E.o comb)) (L.add-neg-cancel comb E.o)) ;
    in-one-plus-IE : QF.InIE (E.add s (E.neg E.o)) =
      Tr.Trunc[QF.W.Wit (E.add s (E.neg E.o))].inc (IW.mkIEWit R I.In E iota (E.add s (E.neg E.o)) c.t c.a c.ina v sub-one) ;
    module CQ = CL.Consequence[R,setR,Ea,n,x,gen,c.t,c.a,c.cert] ;
    conclusion : Conclusion = (s, (in-one-plus-IE, (CQ.finite, (CQ.FB.B.in-w (inr tt), CQ.iso)))) ;
  } ;

  module Theorem (U0 : CD.UniversalZMT n) {
    result : Tr.Trunc[Conclusion].carrier =
      TC.map (FFC.Certified[R,I.In,E,iota,n,x]) Conclusion (\ c -> Of[c].conclusion) (QF.Gen[n,x,gen,fo].Theorem[U0].certified) ;
  } ;
  module TheoremCFN (Z : CD.CFNZMT n) {
    result : Tr.Trunc[Conclusion].carrier = Theorem[CD.universal-of-cfn n Z].result ;
  } ;
} ;

------------------------------------------------------------------------
-- regressions (QuotientExamples): Z/4Z with I = (2), n = 1 and n = 0; the
-- zero fibre I = R

module Examples {
  module QX = QuotientExamples[l] ;
  module DE = DescentExamples[l] ;
  module Two1 (U0 : CD.UniversalZMT (suc zero)) {
    module T = Over[QX.R4,QX.set4,QX.two,QX.even-prop,DE.E4,suc zero,QX.Two.x1,QX.gen (suc zero) QX.Two.x1,QX.Two.finite] ;
    result : Tr.Trunc[T.Conclusion].carrier = T.Theorem[U0].result ;
  } ;
  module Two0 (U0 : CD.UniversalZMT zero) {
    module T = Over[QX.R4,QX.set4,QX.two,QX.even-prop,DE.E4,zero,QX.Two.x0,QX.gen zero QX.Two.x0,QX.Two.finite] ;
    result : Tr.Trunc[T.Conclusion].carrier = T.Theorem[U0].result ;
  } ;
  module Zero (U0 : CD.UniversalZMT (suc zero)) {
    module T = Over[QX.R4,QX.set4,QX.all,\ a -> ZMod4[l].top-prop,DE.E4,suc zero,QX.Zero.x,QX.gen (suc zero) QX.Zero.x,QX.Zero.finite] ;
    result : Tr.Trunc[T.Conclusion].carrier = T.Theorem[U0].result ;
  } ;
} ;
