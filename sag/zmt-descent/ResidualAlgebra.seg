-- ResidualAlgebra.seg: residual monic data and the algebra defined by the
-- residual equations alone, Gate B (handoff §2, §4).
--
-- Residual data D over A in n variables (Residual): a finite family
-- b_1 .. b_t in A, monic P_i(T) over A (i : Fin n), and polynomials H_ij
-- (expressions in X_1 .. X_n).  The residual equations are
--     f_i = P_i(X_i) - sum_j b_j H_ij(X)                       (U)
-- (res, an expression: mexpr writes P(e) = e^d + sum_k e^k c_k as an
-- expression, linX a finite combination).  In an A-algebra B with a point
-- a : Fin n -> B, f_i(a) = 0 for all i (zeros-of-holds, holds-of-zeros) iff
--     P_i(a_i) = sum_j iota(b_j) H_ij(a)                         (Holds)
-- by eval-res: f_i(a) = P_i(a_i) + (-1) sum_j iota(b_j) H_ij(a).
--
-- The algebra F(D) (Algebra) is the presented algebra of the presentation
-- (n, [f_1 .. f_n]) (PresentedAlgebra: the quotient of expressions by the
-- congruence generated by the f_i), with generators y_i.  Only the residual
-- equations are imposed: they hold at y by construction (y-holds).  It has
-- the universal property of the presentation (PresentationExistence): for a
-- point a of B satisfying Holds there is an A-algebra map
-- phi : F(D) -> B with phi(y_i) = a_i (To.phi, To.phi-y).  Every element of
-- F(D) is merely the value at y of an expression (generated).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module RH = RingHom[l] ; module Tr = Truncation[l] ;
module ZC = ZMTCertificate[l] ;

record Residual (A : CRing) (setA : Pr.isSet A.R) (n : Nat) {
  t : Nat ;
  b : Ps.Fin t -> A.R ;
  P : Ps.Fin n -> ZC.Monic[A] ;
  H : Ps.Fin n -> Ps.Fin t -> Presentations[l].Over[A,setA].Expr (Ps.Fin n) ;
} ;

-- polynomial expressions for the powers, sums and monic polynomials
module Exprs (A : CRing) (setA : Pr.isSet A.R) (V : U l) {
  module PA = Presentations[l].Over[A,setA] ;
  module C = Algebras[l].Over[A,setA] ;
  Ex : U l = PA.Expr V ;
  powE (e : Ex) : Nat -> Ex = split { zero -> cst A.o ; suc d | r -> mulE e r } ;
  pwE (e : Ex) : (d : Nat) -> Ps.Fin d -> Ex = split {
    zero -> \ k -> absurd Ex k ;
    suc d | r -> Ps.snoc (Ps.Fin d) Ex r (powE e d) } ;
  sumX : (k : Nat) -> (Ps.Fin k -> Ex) -> Ex = split {
    zero -> \ f -> cst A.z ;
    suc k | r -> \ f -> sumE (f (inr tt)) (r (\ i -> f (inl i))) } ;
  linX (k : Nat) (g w : Ps.Fin k -> Ex) : Ex = sumX k (\ i -> mulE (g i) (w i)) ;
  -- P(e)
  mexpr (P : ZC.Monic[A]) (e : Ex) : Ex = sumE (powE e P.deg) (linX P.deg (pwE e P.deg) (\ k -> cst (P.low k))) ;

  module In (B : C.Algebra) (a : V -> B.ring.R) {
    module PB = ZC.Powers[B.ring] ; module SB = FiniteIdeal[l].Sums[B.ring] ; module EB = ZC.Eval[A,B.ring,B.iota] ;
    ev (e : Ex) : B.ring.R = PA.eval V B a e ;
    ev-pow (e : Ex) : (d : Nat) -> Id B.ring.R (ev (powE e d)) (PB.pow (ev e) d) = split {
      zero -> B.iota.2.1 ;
      suc d | r -> ap (B.ring.mul (ev e)) r } ;
    ev-pw (e : Ex) : (d : Nat) (k : Ps.Fin d) -> Id B.ring.R (ev (pwE e d k)) (PB.pw (ev e) d k) = split {
      zero -> \ k -> absurd (Id B.ring.R (ev (pwE e zero k)) (PB.pw (ev e) zero k)) k ;
      suc d | r -> split { inl k -> r k ; inr u -> ev-pow e d } } ;
    ev-sum : (k : Nat) (f : Ps.Fin k -> Ex) -> Id B.ring.R (ev (sumX k f)) (SB.sum k (\ i -> ev (f i))) = split {
      zero -> \ f -> RH.zero A B.ring B.iota ;
      suc k | r -> \ f -> ap (B.ring.add (ev (f (inr tt)))) (r (\ i -> f (inl i))) } ;
    ev-lin (k : Nat) (g w : Ps.Fin k -> Ex) : Id B.ring.R (ev (linX k g w)) (SB.lin k (\ i -> ev (g i)) (\ i -> ev (w i))) =
      ev-sum k (\ i -> mulE (g i) (w i)) ;
    ev-mexpr (P : ZC.Monic[A]) (e : Ex) : Id B.ring.R (ev (mexpr P e)) (EB.mev P (ev e)) =
      Ps.cong2 B.ring.R B.ring.add _ _ _ _ (ev-pow e P.deg)
        (trans (ev-lin P.deg (pwE e P.deg) (\ k -> cst (P.low k)))
          (SB.sum-cong P.deg (\ k -> B.ring.mul (ev (pwE e P.deg k)) (B.iota.1 (P.low k)))
             (\ k -> B.ring.mul (PB.pw (ev e) P.deg k) (B.iota.1 (P.low k)))
             (\ k -> ap (\ w -> B.ring.mul w (B.iota.1 (P.low k))) (ev-pw e P.deg k)))) ;
  } ;
} ;

module Equations (A : CRing) (setA : Pr.isSet A.R) (n : Nat) (D : Residual[A,setA,n]) {
  module X = Exprs[A,setA,Ps.Fin n] ; open X ;
  module PA = Presentations[l].Over[A,setA] ; module C = Algebras[l].Over[A,setA] ;
  -- f_i = P_i(X_i) + (-1) sum_j b_j H_ij
  res (i : Ps.Fin n) : Ex = sumE (mexpr (D.P i) (var i)) (mulE (cst (A.neg A.o)) (linX D.t (\ j -> cst (D.b j)) (D.H i))) ;
  -- the list [f_1 .. f_n]
  list : (k : Nat) -> (Ps.Fin k -> Ex) -> PA.Equations (Ps.Fin n) = split {
    zero -> \ f -> nil ;
    suc k | r -> \ f -> cons (f (inr tt)) (r (\ i -> f (inl i))) } ;
  eqs : PA.Equations (Ps.Fin n) = list n res ;
  -- the presentation is (n, eqs)

  module At (B : C.Algebra) (a : Ps.Fin n -> B.ring.R) {
    module I = In[B,a] ; open I ;
    module LB = RL[B.ring] ;
    -- the residual identity at a
    Holds : U l = (i : Ps.Fin n) -> Id B.ring.R (EB.mev (D.P i) (a i)) (SB.lin D.t (\ j -> B.iota.1 (D.b j)) (\ j -> ev (D.H i j))) ;
    neg-one (v : B.ring.R) : Id B.ring.R (B.ring.mul (B.iota.1 (A.neg A.o)) v) (B.ring.neg v) =
      calc B.ring.R {
        B.ring.mul (B.iota.1 (A.neg A.o)) v
          =< ap (\ w -> B.ring.mul w v) (trans (RH.negation A B.ring B.iota A.o) (ap B.ring.neg B.iota.2.1))
          > B.ring.mul (B.ring.neg B.ring.o) v
          =< LB.neg-mul-left B.ring.o v > B.ring.neg (B.ring.mul B.ring.o v)
          =< ap B.ring.neg (LB.one-left v) > B.ring.neg v } ;
    -- f_i(a) = P_i(a_i) - sum_j iota(b_j) H_ij(a)
    ev-res (i : Ps.Fin n) : Id B.ring.R (ev (res i))
      (B.ring.add (EB.mev (D.P i) (a i)) (B.ring.neg (SB.lin D.t (\ j -> B.iota.1 (D.b j)) (\ j -> ev (D.H i j))))) =
      Ps.cong2 B.ring.R B.ring.add _ _ _ _ (ev-mexpr (D.P i) (var i))
        (trans (ap (B.ring.mul (B.iota.1 (A.neg A.o))) (ev-lin D.t (\ j -> cst (D.b j)) (D.H i)))
               (neg-one (SB.lin D.t (\ j -> B.iota.1 (D.b j)) (\ j -> ev (D.H i j))))) ;
    -- u - v = 0 iff u = v
    sub-zero (u v : B.ring.R) (h : Id B.ring.R u v) : Id B.ring.R (B.ring.add u (B.ring.neg v)) B.ring.z =
      trans (ap (\ w -> B.ring.add w (B.ring.neg v)) h) (B.ring.addN v) ;
    zero-sub (u v : B.ring.R) (h : Id B.ring.R (B.ring.add u (B.ring.neg v)) B.ring.z) : Id B.ring.R u v =
      trans (sym (LB.neg-neg u)) (trans (ap B.ring.neg (sym (LB.neg-uniq u (B.ring.neg v) h))) (LB.neg-neg v)) ;

    zeros-intro : (k : Nat) (f : Ps.Fin k -> Ex) -> ((i : Ps.Fin k) -> Id B.ring.R (ev (f i)) B.ring.z) ->
      PA.Zeros (Ps.Fin n) B a (list k f) = split {
      zero -> \ f h -> tt ;
      suc k | r -> \ f h -> (h (inr tt), r (\ i -> f (inl i)) (\ i -> h (inl i))) } ;
    zeros-elim : (k : Nat) (f : Ps.Fin k -> Ex) -> PA.Zeros (Ps.Fin n) B a (list k f) ->
      (i : Ps.Fin k) -> Id B.ring.R (ev (f i)) B.ring.z = split {
      zero -> \ f z i -> absurd (Id B.ring.R (ev (f i)) B.ring.z) i ;
      suc k | r -> \ f z -> split {
        inl i -> r (\ i' -> f (inl i')) z.2 i ;
        inr u -> trans (ap (\ w -> ev (f (inr w))) (sym (FiniteFamilies[l].top-eta u))) z.1 } } ;

    zeros-of-holds (h : Holds) : PA.Zeros (Ps.Fin n) B a eqs =
      zeros-intro n res (\ i -> trans (ev-res i) (sub-zero _ _ (h i))) ;
    holds-of-zeros (z : PA.Zeros (Ps.Fin n) B a eqs) : Holds =
      \ i -> zero-sub _ _ (trans (sym (ev-res i)) (zeros-elim n res z i)) ;
  } ;
} ;

------------------------------------------------------------------------
-- the algebra F(D)

module Algebra (A : CRing) (setA : Pr.isSet A.R) (n : Nat) (D : Residual[A,setA,n]) {
  module EQ = Equations[A,setA,n,D] ;
  module PA = Presentations[l].Over[A,setA] ; module C = Algebras[l].Over[A,setA] ;
  module UA = PresentedAlgebra[l].Over[A,setA,(n,EQ.eqs)] ;
  module PE = PresentationExistence[l].Over[A,setA,(n,EQ.eqs)] ;
  algebra : C.Algebra = UA.algebra ;
  ring : CRing = UA.ring ;
  y (i : Ps.Fin n) : ring.R = UA.generators i ;
  -- (U) holds in F(D) by construction
  y-holds : EQ.At[algebra,y].Holds = EQ.At[algebra,y].holds-of-zeros UA.solution.2 ;
  -- every element is merely an expression in y
  Rep (f : ring.R) : U l = (e : PA.Expr (Ps.Fin n)) * Id ring.R (PA.eval (Ps.Fin n) algebra y e) f ;
  generated (f : ring.R) : Tr.Trunc[Rep f].carrier =
    Tr.Trunc[PE.Representatives f].induction @l (\ u -> Tr.Trunc[Rep f].carrier) (\ u -> Tr.Trunc[Rep f].proposition)
      (\ r -> Tr.Trunc[Rep f].inc (r.1, trans (UA.reify r.1) r.2)) (PE.generated f) ;

  -- the map out of F(D)
  module To (B : C.Algebra) (a : Ps.Fin n -> B.ring.R) (hold : EQ.At[B,a].Holds) {
    solution : PA.Solutions (n,EQ.eqs) B = (a, EQ.At[B,a].zeros-of-holds hold) ;
    phi : C.Hom algebra B = PE.To[B].extend solution ;
    phi-y (i : Ps.Fin n) : Id B.ring.R (phi.1.1 (y i)) (a i) = PE.To[B].At[solution].Descent.beta (var i) ;
    phi-iota (r : A.R) : Id B.ring.R (phi.1.1 (algebra.iota.1 r)) (B.iota.1 r) = phi.2 r ;
  } ;
} ;
