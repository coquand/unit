-- QuotientExamples.seg: regressions for the usual finite-fibre hypothesis
-- (QuotientFibre), over the nonreduced ring Z/4Z.
--
-- Q1  nonreduced base: R = E = Z/4Z, I = (2) (even, a proposition by
--     cases), x = 2.  2 is 0 in R/I and in E/IE; E/IE is spanned over R/I
--     by the class of 1.  The bridge gives the elementwise FiniteFibre
--     (merely), and the certified conclusion follows from UniversalZMT 1.
-- Q2  empty family of algebra generators: the same with n = 0 (E = R is
--     generated by the constants); conclusion from UniversalZMT 0.
-- Q3  zero fibre: I = R (every element), so IE = E and E/IE = 0, spanned by
--     the EMPTY family (N = 0); 1 is in IE.  Bridge and conclusion as above.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module RH = RingHom[l] ; module Tr = Truncation[l] ;
module CD = CFNDescent[l] ; module FFC = FiniteFibreCertificates[l] ; module RI = RegularIdeal[l] ;
module ZM = ZMod4[l] ; module DE = DescentExamples[l] ; module QFm = QuotientFibre[l] ;
R4 : CRing = ZM.ring ;
set4 : Pr.isSet R4.R = ZM.set ;
module P4 = Presentations[l].Over[R4,set4] ;

------------------------------------------------------------------------
-- the ideal (2) of Z/4Z, by cases
even : R4.R -> U l = split { q0 -> Top ; q1 -> Empty ; q2 -> Top ; q3 -> Empty } ;
even-prop : (a : R4.R) -> Pr.isProp (even a) = split { q0 -> ZM.top-prop ; q1 -> ZM.empty-prop ; q2 -> ZM.top-prop ; q3 -> ZM.empty-prop } ;
even-add : (a b : R4.R) -> even a -> even b -> even (R4.add a b) = split {
  q0 -> split { q0 -> \ h k -> tt ; q1 -> \ h k -> absurd (even q1) k ; q2 -> \ h k -> tt ; q3 -> \ h k -> absurd (even q3) k } ;
  q1 -> split { q0 -> \ h k -> absurd (even q1) h ; q1 -> \ h k -> absurd (even q2) h ; q2 -> \ h k -> absurd (even q3) h ; q3 -> \ h k -> absurd (even q0) h } ;
  q2 -> split { q0 -> \ h k -> tt ; q1 -> \ h k -> absurd (even q3) k ; q2 -> \ h k -> tt ; q3 -> \ h k -> absurd (even q1) k } ;
  q3 -> split { q0 -> \ h k -> absurd (even q3) h ; q1 -> \ h k -> absurd (even q0) h ; q2 -> \ h k -> absurd (even q1) h ; q3 -> \ h k -> absurd (even q2) h }
} ;
even-mul : (b x : R4.R) -> even x -> even (R4.mul b x) = split {
  q0 -> split { q0 -> \ h -> tt ; q1 -> \ h -> absurd (even q0) h ; q2 -> \ h -> tt ; q3 -> \ h -> absurd (even q0) h } ;
  q1 -> split { q0 -> \ h -> tt ; q1 -> \ h -> absurd (even q1) h ; q2 -> \ h -> tt ; q3 -> \ h -> absurd (even q3) h } ;
  q2 -> split { q0 -> \ h -> tt ; q1 -> \ h -> absurd (even q2) h ; q2 -> \ h -> tt ; q3 -> \ h -> absurd (even q2) h } ;
  q3 -> split { q0 -> \ h -> tt ; q1 -> \ h -> absurd (even q3) h ; q2 -> \ h -> tt ; q3 -> \ h -> absurd (even q1) h }
} ;
two : RI.IdealPred[R4] = RI.mkIdealPred R4 even tt even-add even-mul ;
-- the whole ring
all : RI.IdealPred[R4] = RI.mkIdealPred R4 (\ a -> Top) tt (\ a b h k -> tt) (\ b x h -> tt) ;

-- E = Z/4Z is generated by the constants, for any number of generators
gen (n : Nat) (x : Ps.Fin n -> R4.R) (e : R4.R) :
  Tr.Trunc[(H : P4.Expr (Ps.Fin n)) * Id R4.R (P4.eval (Ps.Fin n) DE.E4 x H) e].carrier =
  Tr.Trunc[(H : P4.Expr (Ps.Fin n)) * Id R4.R (P4.eval (Ps.Fin n) DE.E4 x H) e].inc (cst e, refl e) ;

------------------------------------------------------------------------
-- Q1, Q2: I = (2)

module Two {
  module QF = QFm.Over[R4,set4,two,even-prop,DE.E4] ;
  module LQ = RL[QF.EmodIE] ;
  -- 2 is 0 modulo I and modulo IE
  two-zeroR : Id QF.RmodI.R (QF.pR.1 q2) QF.RmodI.z = QF.QR.to-zero q2 tt ;
  two-zeroE : Id QF.EmodIE.R (QF.pE.1 q2) QF.EmodIE.z = QF.QE.to-zero q2 (Tr.Trunc[QF.W.Wit q2].inc (QF.unit-wit q2 tt)) ;
  -- E/IE is spanned over R/I by the class of 1
  gb (k : Ps.Fin (suc zero)) : QF.EmodIE.R = QF.EmodIE.o ;
  Spanned (q : QF.EmodIE.R) : U l =
    (ab : Ps.Fin (suc zero) -> QF.RmodI.R) * Id QF.EmodIE.R q (QF.SQ.lin (suc zero) gb (\ k -> QF.iotaI.1 (ab k))) ;
  span-eq (e : R4.R) : Id QF.EmodIE.R (QF.pE.1 e) (QF.SQ.lin (suc zero) gb (\ k -> QF.iotaI.1 (QF.pR.1 e))) =
    sym (trans (QF.EmodIE.addZ (QF.EmodIE.mul QF.EmodIE.o (QF.iotaI.1 (QF.pR.1 e))))
          (trans (LQ.one-left (QF.iotaI.1 (QF.pR.1 e))) (QF.iotaI-beta e))) ;
  spans (q : QF.EmodIE.R) : Tr.Trunc[Spanned q].carrier =
    QF.QE.Q.induction @l (\ q' -> Tr.Trunc[Spanned q'].carrier) (\ q' -> Tr.Trunc[Spanned q'].proposition)
      (\ e -> Tr.Trunc[Spanned (QF.pE.1 e)].inc (\ k -> QF.pR.1 e, span-eq e)) q ;
  finite : Tr.Trunc[QF.Finite].carrier =
    Tr.Trunc[QF.Finite].inc (QFm.mkModuleFinite QF.RmodI QF.EmodIE QF.iotaI (suc zero) gb spans) ;
  -- the elementwise hypothesis, with no principle
  fibre : Tr.Trunc[FFC.FiniteFibre[R4,even,R4,RH.identity R4]].carrier = QF.bridge finite ;
  -- Q1: n = 1, x = 2
  x1 (i : Ps.Fin (suc zero)) : R4.R = q2 ;
  module G1 = QF.Gen[suc zero,x1,gen (suc zero) x1,finite] ;
  module Run1 (U0 : CD.UniversalZMT (suc zero)) {
    certified : Tr.Trunc[G1.Goal].carrier = G1.Theorem[U0].certified ;
  } ;
  -- Q2: n = 0
  x0 (i : Ps.Fin zero) : R4.R = absurd R4.R i ;
  module G0 = QF.Gen[zero,x0,gen zero x0,finite] ;
  module Run0 (U0 : CD.UniversalZMT zero) {
    certified : Tr.Trunc[G0.Goal].carrier = G0.Theorem[U0].certified ;
  } ;
} ;

------------------------------------------------------------------------
-- Q3: I = R, the zero fibre

module Zero {
  module QF = QFm.Over[R4,set4,all,\ a -> ZM.top-prop,DE.E4] ;
  -- every element is in IE, 1 in particular
  in-IE (e : R4.R) : QF.InIE e = Tr.Trunc[QF.W.Wit e].inc (QF.unit-wit e tt) ;
  one-in-IE : QF.InIE q1 = in-IE q1 ;
  gb (k : Ps.Fin zero) : QF.EmodIE.R = absurd QF.EmodIE.R k ;
  Spanned (q : QF.EmodIE.R) : U l =
    (ab : Ps.Fin zero -> QF.RmodI.R) * Id QF.EmodIE.R q (QF.SQ.lin zero gb (\ k -> QF.iotaI.1 (ab k))) ;
  spans (q : QF.EmodIE.R) : Tr.Trunc[Spanned q].carrier =
    QF.QE.Q.induction @l (\ q' -> Tr.Trunc[Spanned q'].carrier) (\ q' -> Tr.Trunc[Spanned q'].proposition)
      (\ e -> Tr.Trunc[Spanned (QF.pE.1 e)].inc (\ k -> absurd QF.RmodI.R k, QF.QE.to-zero e (in-IE e))) q ;
  finite : Tr.Trunc[QF.Finite].carrier =
    Tr.Trunc[QF.Finite].inc (QFm.mkModuleFinite QF.RmodI QF.EmodIE QF.iotaI zero gb spans) ;
  fibre : Tr.Trunc[FFC.FiniteFibre[R4,\ a -> Top,R4,RH.identity R4]].carrier = QF.bridge finite ;
  x (i : Ps.Fin (suc zero)) : R4.R = q2 ;
  module G = QF.Gen[suc zero,x,gen (suc zero) x,finite] ;
  module Run (U0 : CD.UniversalZMT (suc zero)) {
    certified : Tr.Trunc[G.Goal].carrier = G.Theorem[U0].certified ;
  } ;
} ;
