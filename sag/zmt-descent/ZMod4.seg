-- ZMod4.seg: the ring Z/4Z, a nonreduced target for the regression
-- instances (DescentExamples): 2 is nilpotent, 2 * 2 = 0.  The operations
-- are tables on four constructors; every ring law holds by computation, case
-- by case (the cases are generated mechanically).  Z/4Z is a set by Hedberg
-- (code: the diagonal is Top, the rest Empty).
level l ; open Ring[l] ;
module Pr = Prelude[l] ;

data Z4 = q0 | q1 | q2 | q3 ;

add : Z4 -> Z4 -> Z4 = split {
  q0 -> split { q0 -> q0 ; q1 -> q1 ; q2 -> q2 ; q3 -> q3 } ;
  q1 -> split { q0 -> q1 ; q1 -> q2 ; q2 -> q3 ; q3 -> q0 } ;
  q2 -> split { q0 -> q2 ; q1 -> q3 ; q2 -> q0 ; q3 -> q1 } ;
  q3 -> split { q0 -> q3 ; q1 -> q0 ; q2 -> q1 ; q3 -> q2 }
} ;
mul : Z4 -> Z4 -> Z4 = split {
  q0 -> split { q0 -> q0 ; q1 -> q0 ; q2 -> q0 ; q3 -> q0 } ;
  q1 -> split { q0 -> q0 ; q1 -> q1 ; q2 -> q2 ; q3 -> q3 } ;
  q2 -> split { q0 -> q0 ; q1 -> q2 ; q2 -> q0 ; q3 -> q2 } ;
  q3 -> split { q0 -> q0 ; q1 -> q3 ; q2 -> q2 ; q3 -> q1 }
} ;
neg : Z4 -> Z4 = split { q0 -> q0 ; q1 -> q3 ; q2 -> q2 ; q3 -> q1 } ;
addA : (x y w : Z4) -> Id Z4 (add x (add y w)) (add (add x y) w) = split {
  q0 -> split {
    q0 -> split { q0 -> refl q0 ; q1 -> refl q1 ; q2 -> refl q2 ; q3 -> refl q3 } ;
    q1 -> split { q0 -> refl q1 ; q1 -> refl q2 ; q2 -> refl q3 ; q3 -> refl q0 } ;
    q2 -> split { q0 -> refl q2 ; q1 -> refl q3 ; q2 -> refl q0 ; q3 -> refl q1 } ;
    q3 -> split { q0 -> refl q3 ; q1 -> refl q0 ; q2 -> refl q1 ; q3 -> refl q2 } } ;
  q1 -> split {
    q0 -> split { q0 -> refl q1 ; q1 -> refl q2 ; q2 -> refl q3 ; q3 -> refl q0 } ;
    q1 -> split { q0 -> refl q2 ; q1 -> refl q3 ; q2 -> refl q0 ; q3 -> refl q1 } ;
    q2 -> split { q0 -> refl q3 ; q1 -> refl q0 ; q2 -> refl q1 ; q3 -> refl q2 } ;
    q3 -> split { q0 -> refl q0 ; q1 -> refl q1 ; q2 -> refl q2 ; q3 -> refl q3 } } ;
  q2 -> split {
    q0 -> split { q0 -> refl q2 ; q1 -> refl q3 ; q2 -> refl q0 ; q3 -> refl q1 } ;
    q1 -> split { q0 -> refl q3 ; q1 -> refl q0 ; q2 -> refl q1 ; q3 -> refl q2 } ;
    q2 -> split { q0 -> refl q0 ; q1 -> refl q1 ; q2 -> refl q2 ; q3 -> refl q3 } ;
    q3 -> split { q0 -> refl q1 ; q1 -> refl q2 ; q2 -> refl q3 ; q3 -> refl q0 } } ;
  q3 -> split {
    q0 -> split { q0 -> refl q3 ; q1 -> refl q0 ; q2 -> refl q1 ; q3 -> refl q2 } ;
    q1 -> split { q0 -> refl q0 ; q1 -> refl q1 ; q2 -> refl q2 ; q3 -> refl q3 } ;
    q2 -> split { q0 -> refl q1 ; q1 -> refl q2 ; q2 -> refl q3 ; q3 -> refl q0 } ;
    q3 -> split { q0 -> refl q2 ; q1 -> refl q3 ; q2 -> refl q0 ; q3 -> refl q1 } }
} ;
addC : (x y : Z4) -> Id Z4 (add x y) (add y x) = split {
  q0 -> split { q0 -> refl q0 ; q1 -> refl q1 ; q2 -> refl q2 ; q3 -> refl q3 } ;
  q1 -> split { q0 -> refl q1 ; q1 -> refl q2 ; q2 -> refl q3 ; q3 -> refl q0 } ;
  q2 -> split { q0 -> refl q2 ; q1 -> refl q3 ; q2 -> refl q0 ; q3 -> refl q1 } ;
  q3 -> split { q0 -> refl q3 ; q1 -> refl q0 ; q2 -> refl q1 ; q3 -> refl q2 }
} ;
addZ : (x : Z4) -> Id Z4 (add x q0) x = split { q0 -> refl q0 ; q1 -> refl q1 ; q2 -> refl q2 ; q3 -> refl q3 } ;
addN : (x : Z4) -> Id Z4 (add x (neg x)) q0 = split { q0 -> refl q0 ; q1 -> refl q0 ; q2 -> refl q0 ; q3 -> refl q0 } ;
mulA : (x y w : Z4) -> Id Z4 (mul x (mul y w)) (mul (mul x y) w) = split {
  q0 -> split {
    q0 -> split { q0 -> refl q0 ; q1 -> refl q0 ; q2 -> refl q0 ; q3 -> refl q0 } ;
    q1 -> split { q0 -> refl q0 ; q1 -> refl q0 ; q2 -> refl q0 ; q3 -> refl q0 } ;
    q2 -> split { q0 -> refl q0 ; q1 -> refl q0 ; q2 -> refl q0 ; q3 -> refl q0 } ;
    q3 -> split { q0 -> refl q0 ; q1 -> refl q0 ; q2 -> refl q0 ; q3 -> refl q0 } } ;
  q1 -> split {
    q0 -> split { q0 -> refl q0 ; q1 -> refl q0 ; q2 -> refl q0 ; q3 -> refl q0 } ;
    q1 -> split { q0 -> refl q0 ; q1 -> refl q1 ; q2 -> refl q2 ; q3 -> refl q3 } ;
    q2 -> split { q0 -> refl q0 ; q1 -> refl q2 ; q2 -> refl q0 ; q3 -> refl q2 } ;
    q3 -> split { q0 -> refl q0 ; q1 -> refl q3 ; q2 -> refl q2 ; q3 -> refl q1 } } ;
  q2 -> split {
    q0 -> split { q0 -> refl q0 ; q1 -> refl q0 ; q2 -> refl q0 ; q3 -> refl q0 } ;
    q1 -> split { q0 -> refl q0 ; q1 -> refl q2 ; q2 -> refl q0 ; q3 -> refl q2 } ;
    q2 -> split { q0 -> refl q0 ; q1 -> refl q0 ; q2 -> refl q0 ; q3 -> refl q0 } ;
    q3 -> split { q0 -> refl q0 ; q1 -> refl q2 ; q2 -> refl q0 ; q3 -> refl q2 } } ;
  q3 -> split {
    q0 -> split { q0 -> refl q0 ; q1 -> refl q0 ; q2 -> refl q0 ; q3 -> refl q0 } ;
    q1 -> split { q0 -> refl q0 ; q1 -> refl q3 ; q2 -> refl q2 ; q3 -> refl q1 } ;
    q2 -> split { q0 -> refl q0 ; q1 -> refl q2 ; q2 -> refl q0 ; q3 -> refl q2 } ;
    q3 -> split { q0 -> refl q0 ; q1 -> refl q1 ; q2 -> refl q2 ; q3 -> refl q3 } }
} ;
mulC : (x y : Z4) -> Id Z4 (mul x y) (mul y x) = split {
  q0 -> split { q0 -> refl q0 ; q1 -> refl q0 ; q2 -> refl q0 ; q3 -> refl q0 } ;
  q1 -> split { q0 -> refl q0 ; q1 -> refl q1 ; q2 -> refl q2 ; q3 -> refl q3 } ;
  q2 -> split { q0 -> refl q0 ; q1 -> refl q2 ; q2 -> refl q0 ; q3 -> refl q2 } ;
  q3 -> split { q0 -> refl q0 ; q1 -> refl q3 ; q2 -> refl q2 ; q3 -> refl q1 }
} ;
mulO : (x : Z4) -> Id Z4 (mul x q1) x = split { q0 -> refl q0 ; q1 -> refl q1 ; q2 -> refl q2 ; q3 -> refl q3 } ;
dist : (x y w : Z4) -> Id Z4 (mul x (add y w)) (add (mul x y) (mul x w)) = split {
  q0 -> split {
    q0 -> split { q0 -> refl q0 ; q1 -> refl q0 ; q2 -> refl q0 ; q3 -> refl q0 } ;
    q1 -> split { q0 -> refl q0 ; q1 -> refl q0 ; q2 -> refl q0 ; q3 -> refl q0 } ;
    q2 -> split { q0 -> refl q0 ; q1 -> refl q0 ; q2 -> refl q0 ; q3 -> refl q0 } ;
    q3 -> split { q0 -> refl q0 ; q1 -> refl q0 ; q2 -> refl q0 ; q3 -> refl q0 } } ;
  q1 -> split {
    q0 -> split { q0 -> refl q0 ; q1 -> refl q1 ; q2 -> refl q2 ; q3 -> refl q3 } ;
    q1 -> split { q0 -> refl q1 ; q1 -> refl q2 ; q2 -> refl q3 ; q3 -> refl q0 } ;
    q2 -> split { q0 -> refl q2 ; q1 -> refl q3 ; q2 -> refl q0 ; q3 -> refl q1 } ;
    q3 -> split { q0 -> refl q3 ; q1 -> refl q0 ; q2 -> refl q1 ; q3 -> refl q2 } } ;
  q2 -> split {
    q0 -> split { q0 -> refl q0 ; q1 -> refl q2 ; q2 -> refl q0 ; q3 -> refl q2 } ;
    q1 -> split { q0 -> refl q2 ; q1 -> refl q0 ; q2 -> refl q2 ; q3 -> refl q0 } ;
    q2 -> split { q0 -> refl q0 ; q1 -> refl q2 ; q2 -> refl q0 ; q3 -> refl q2 } ;
    q3 -> split { q0 -> refl q2 ; q1 -> refl q0 ; q2 -> refl q2 ; q3 -> refl q0 } } ;
  q3 -> split {
    q0 -> split { q0 -> refl q0 ; q1 -> refl q3 ; q2 -> refl q2 ; q3 -> refl q1 } ;
    q1 -> split { q0 -> refl q3 ; q1 -> refl q2 ; q2 -> refl q1 ; q3 -> refl q0 } ;
    q2 -> split { q0 -> refl q2 ; q1 -> refl q1 ; q2 -> refl q0 ; q3 -> refl q3 } ;
    q3 -> split { q0 -> refl q1 ; q1 -> refl q0 ; q2 -> refl q3 ; q3 -> refl q2 } }
} ;
ring : CRing = mkCRing Z4 q0 q1 add mul neg addA addC addZ addN mulA mulC mulO dist ;

-- Z/4Z is a set
top-prop : Pr.isProp Top = split { tt -> split { tt -> refl tt } } ;
empty-prop : Pr.isProp Empty = \ e -> absurd ((y : Empty) -> Id Empty e y) e ;
code : Z4 -> Z4 -> U l = split {
  q0 -> split { q0 -> Top ; q1 -> Empty ; q2 -> Empty ; q3 -> Empty } ;
  q1 -> split { q0 -> Empty ; q1 -> Top ; q2 -> Empty ; q3 -> Empty } ;
  q2 -> split { q0 -> Empty ; q1 -> Empty ; q2 -> Top ; q3 -> Empty } ;
  q3 -> split { q0 -> Empty ; q1 -> Empty ; q2 -> Empty ; q3 -> Top }
} ;
code-prop : (x y : Z4) -> Pr.isProp (code x y) = split {
  q0 -> split { q0 -> top-prop ; q1 -> empty-prop ; q2 -> empty-prop ; q3 -> empty-prop } ;
  q1 -> split { q0 -> empty-prop ; q1 -> top-prop ; q2 -> empty-prop ; q3 -> empty-prop } ;
  q2 -> split { q0 -> empty-prop ; q1 -> empty-prop ; q2 -> top-prop ; q3 -> empty-prop } ;
  q3 -> split { q0 -> empty-prop ; q1 -> empty-prop ; q2 -> empty-prop ; q3 -> top-prop }
} ;
code-refl : (x : Z4) -> code x x = split { q0 -> tt ; q1 -> tt ; q2 -> tt ; q3 -> tt } ;
code-eq : (x y : Z4) -> code x y -> Id Z4 x y = split {
  q0 -> split { q0 -> \ h -> refl q0 ; q1 -> \ h -> absurd (Id Z4 q0 q1) h ; q2 -> \ h -> absurd (Id Z4 q0 q2) h ; q3 -> \ h -> absurd (Id Z4 q0 q3) h } ;
  q1 -> split { q0 -> \ h -> absurd (Id Z4 q1 q0) h ; q1 -> \ h -> refl q1 ; q2 -> \ h -> absurd (Id Z4 q1 q2) h ; q3 -> \ h -> absurd (Id Z4 q1 q3) h } ;
  q2 -> split { q0 -> \ h -> absurd (Id Z4 q2 q0) h ; q1 -> \ h -> absurd (Id Z4 q2 q1) h ; q2 -> \ h -> refl q2 ; q3 -> \ h -> absurd (Id Z4 q2 q3) h } ;
  q3 -> split { q0 -> \ h -> absurd (Id Z4 q3 q0) h ; q1 -> \ h -> absurd (Id Z4 q3 q1) h ; q2 -> \ h -> absurd (Id Z4 q3 q2) h ; q3 -> \ h -> refl q3 }
} ;
set : Pr.isSet Z4 = \ x -> Pr.Hedberg[Z4, x, code x, code-prop x, code-refl x, code-eq x].hedberg ;
