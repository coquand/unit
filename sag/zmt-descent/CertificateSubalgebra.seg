-- CertificateSubalgebra.seg: the subalgebra B = R[s, s x_1, .., s x_n] of E
-- and, for a certificate, its finiteness over R (handoff §7).
--
-- Over (any s in E).  w_0 = s, w_i = s x_i (w: Fin (n+1), inr tt is s).
-- e is in B (InB) when merely e = H(w) for an expression H over R in n+1
-- variables.  InB is a proposition containing iota(R) and the w_j, closed
-- under 0, 1, +, -, * (in-*); it is the least such predicate (least, by
-- induction on H).  B = (e : E) * InB e is a commutative set-ring
-- (ring, set) with the laws of E (two elements are equal when their images
-- in E are: eqB), an R-algebra (iotaB, algebra), and the inclusion
-- incl : B -> E is an injective ring map (incl-inj).  B is an image
-- subalgebra: no freeness, and nothing about R.  sB, sxB are s, s x_i in B.
--
-- Finite (a certificate c with s = c.s).  Each w_j is a root of a monic Q_j
-- over R (Q_0 = c.q0 at s, Q_i = c.q i at s x_i: root), so
--     w_j^d_j = - sum_k c_jk w_j^k        (hyp-of-root)
-- which is the hypothesis of ResidualFibreFinite.Monomials for the ideal 0
-- (t = 0, no generators).  As in ResidualFibreFinite.Fibre, the monomials
-- w^e with e_j < d_j span every H(w) over R (all-mul, spans-E): reduction of
-- powers of finitely many integral generators.  The monomials lie in B
-- (mono-in), and an equation in E between elements of B is one in B
-- (eqB, incl a ring map: lin-natural), so
--     B is finite over R:  ModuleFinite[R, B, iotaB]          (finite)
-- with the monomials as generators.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module RH = RingHom[l] ; module Tr = Truncation[l] ;
module ZC = ZMTCertificate[l] ; module TC = TruncationCombinators[l] ; module QFm = QuotientFibre[l] ;

module Over (R : CRing) (setR : Pr.isSet R.R) (Ea : Algebras[l].Over[R,setR].Algebra) (n : Nat) (x : Ps.Fin n -> Ea.ring.R) (s : Ea.ring.R) {
  E : CRing = Ea.ring ;
  iota : RH.Hom R E = Ea.iota ;
  module P = Presentations[l].Over[R,setR] ; module L = RL[E] ;
  Vw : U l = Ps.Fin (suc n) ;
  w : Vw -> E.R = Ps.snoc (Ps.Fin n) E.R (\ i -> E.mul s (x i)) s ;
  ev (H : P.Expr Vw) : E.R = P.eval Vw Ea w H ;
  Rep (e : E.R) : U l = (H : P.Expr Vw) * Id E.R (ev H) e ;
  InB (e : E.R) : U l = Tr.Trunc[Rep e].carrier ;
  propB (e : E.R) : Pr.isProp (InB e) = Tr.Trunc[Rep e].proposition ;

  ------------------------------------------------------------------------
  -- closure

  in-eq (e e' : E.R) (p : Id E.R e e') : InB e -> InB e' = TC.map (Rep e) (Rep e') (\ r -> (r.1, trans r.2 p)) ;
  in-cst (r : R.R) : InB (iota.1 r) = Tr.Trunc[Rep (iota.1 r)].inc (cst r, refl (iota.1 r)) ;
  in-w (j : Vw) : InB (w j) = Tr.Trunc[Rep (w j)].inc (var j, refl (w j)) ;
  in-zero : InB E.z = in-eq (iota.1 R.z) E.z (RH.zero R E iota) (in-cst R.z) ;
  in-one : InB E.o = in-eq (iota.1 R.o) E.o iota.2.1 (in-cst R.o) ;
  in-add (e e' : E.R) : InB e -> InB e' -> InB (E.add e e') =
    TC.map2 (Rep e) (Rep e') (Rep (E.add e e')) (\ r r' -> (sumE r.1 r'.1, Ps.cong2 E.R E.add _ _ _ _ r.2 r'.2)) ;
  in-mul (e e' : E.R) : InB e -> InB e' -> InB (E.mul e e') =
    TC.map2 (Rep e) (Rep e') (Rep (E.mul e e')) (\ r r' -> (mulE r.1 r'.1, Ps.cong2 E.R E.mul _ _ _ _ r.2 r'.2)) ;
  -- iota(-1) v = - v
  neg-one (v : E.R) : Id E.R (E.mul (iota.1 (R.neg R.o)) v) (E.neg v) =
    trans (ap (\ u -> E.mul u v) (trans (RH.negation R E iota R.o) (ap E.neg iota.2.1)))
      (trans (L.neg-mul-left E.o v) (ap E.neg (L.one-left v))) ;
  in-neg (e : E.R) : InB e -> InB (E.neg e) =
    TC.map (Rep e) (Rep (E.neg e)) (\ r -> (mulE (cst (R.neg R.o)) r.1, trans (ap (E.mul (iota.1 (R.neg R.o))) r.2) (neg-one e))) ;

  -- B is the least predicate with these closure properties
  module Least (Q : E.R -> U l) (propQ : (e : E.R) -> Pr.isProp (Q e)) (qc : (r : R.R) -> Q (iota.1 r)) (qw : (j : Vw) -> Q (w j))
    (qa : (e e' : E.R) -> Q e -> Q e' -> Q (E.add e e')) (qm : (e e' : E.R) -> Q e -> Q e' -> Q (E.mul e e')) {
    of-expr : (H : P.Expr Vw) -> Q (ev H) = split {
      var j -> qw j ; cst r -> qc r ;
      sumE p q | rp rq -> qa (ev p) (ev q) rp rq ;
      mulE p q | rp rq -> qm (ev p) (ev q) rp rq } ;
    least (e : E.R) (h : InB e) : Q e =
      Tr.Trunc[Rep e].induction @l (\ u -> Q e) (\ u -> propQ e) (\ r -> subst Q r.2 (of-expr r.1)) h ;
  } ;

  ------------------------------------------------------------------------
  -- the ring B

  Carrier : U l = (e : E.R) * InB e ;
  eqB (b b' : Carrier) (p : Id E.R b.1 b'.1) : Id Carrier b b' = Pr.Sigma-eq E.R InB b.1 b'.1 b.2 b'.2 p (propB b'.1) ;
  set : Pr.isSet Carrier = Pr.isSet-Sigma E.R InB Ea.set (\ e -> Pr.prop-to-set (InB e) (propB e)) ;
  zB : Carrier = (E.z, in-zero) ;
  oB : Carrier = (E.o, in-one) ;
  addB (b b' : Carrier) : Carrier = (E.add b.1 b'.1, in-add b.1 b'.1 b.2 b'.2) ;
  mulB (b b' : Carrier) : Carrier = (E.mul b.1 b'.1, in-mul b.1 b'.1 b.2 b'.2) ;
  negB (b : Carrier) : Carrier = (E.neg b.1, in-neg b.1 b.2) ;
  ring : CRing = mkCRing Carrier zB oB addB mulB negB
    (\ a b c -> eqB (addB a (addB b c)) (addB (addB a b) c) (E.addA a.1 b.1 c.1))
    (\ a b -> eqB (addB a b) (addB b a) (E.addC a.1 b.1))
    (\ a -> eqB (addB a zB) a (E.addZ a.1))
    (\ a -> eqB (addB a (negB a)) zB (E.addN a.1))
    (\ a b c -> eqB (mulB a (mulB b c)) (mulB (mulB a b) c) (E.mulA a.1 b.1 c.1))
    (\ a b -> eqB (mulB a b) (mulB b a) (E.mulC a.1 b.1))
    (\ a -> eqB (mulB a oB) a (E.mulO a.1))
    (\ a b c -> eqB (mulB a (addB b c)) (addB (mulB a b) (mulB a c)) (E.dist a.1 b.1 c.1)) ;
  incl : RH.Hom ring E = (\ b -> b.1, refl E.o, \ a b -> refl (E.add a.1 b.1), \ a b -> refl (E.mul a.1 b.1)) ;
  incl-inj (b b' : Carrier) (p : Id E.R (incl.1 b) (incl.1 b')) : Id Carrier b b' = eqB b b' p ;
  iotaB : RH.Hom R ring =
    (\ r -> (iota.1 r, in-cst r), eqB (iota.1 R.o, in-cst R.o) oB iota.2.1,
     \ a b -> eqB (iota.1 (R.add a b), in-cst (R.add a b)) (addB (iota.1 a, in-cst a) (iota.1 b, in-cst b)) (iota.2.2.1 a b),
     \ a b -> eqB (iota.1 (R.mul a b), in-cst (R.mul a b)) (mulB (iota.1 a, in-cst a) (iota.1 b, in-cst b)) (iota.2.2.2 a b)) ;
  algebra : Algebras[l].Over[R,setR].Algebra = Algebras[l].Over[R,setR].mkAlgebra ring set iotaB ;
  sB : Carrier = (s, in-w (inr tt)) ;
  sxB (i : Ps.Fin n) : Carrier = (E.mul s (x i), in-w (inl i)) ;

  -- powers of elements of B are in B
  module PF = ZC.Powers[E] ;
  pow-in (z : E.R) (h : InB z) : (d : Nat) -> InB (PF.pow z d) = split {
    zero -> in-one ;
    suc d | r -> in-mul z (PF.pow z d) h r } ;
  pw-in (z : E.R) (h : InB z) : (d : Nat) (k : Ps.Fin d) -> InB (PF.pw z d k) = split {
    zero -> \ k -> absurd (InB (PF.pw z zero k)) k ;
    suc d | r -> split { inl k -> r k ; inr u -> pow-in z h d } } ;
} ;

------------------------------------------------------------------------
-- finiteness from a certificate

module Finite (R : CRing) (setR : Pr.isSet R.R) (Ea : Algebras[l].Over[R,setR].Algebra) (n : Nat) (x : Ps.Fin n -> Ea.ring.R)
  (t : Nat) (a : Ps.Fin t -> R.R) (c : ZC.ZMTCert[R,Ea.ring,Ea.iota,n,x,t,a]) {
  module B = Over[R,setR,Ea,n,x,c.s] ;
  E : CRing = Ea.ring ;
  iota : RH.Hom R E = Ea.iota ;
  module L = RL[E] ;
  noB (j : Ps.Fin zero) : E.R = absurd E.R j ;
  module MO = ResidualFibreFinite[l].Monomials[R,E,iota,zero,noB] ; module SP = MO.SP ;
  module EV = ZC.Eval[R,E,iota] ; module SE = FiniteIdeal[l].Sums[E] ;

  -- the monic polynomial of w_j
  Qw : B.Vw -> ZC.Monic[R] = Ps.snoc (Ps.Fin n) (ZC.Monic[R]) c.q c.q0 ;
  root : (j : B.Vw) -> Id E.R (EV.mev (Qw j) (B.w j)) E.z = split { inl i -> c.ann i ; inr u -> c.ann0 } ;
  d (j : B.Vw) : Nat = (Qw j).deg ;
  -- - sum_k z^k iota(c_k) = sum_k z^k iota(-c_k)
  neg-lower (Pm : ZC.Monic[R]) (z : E.R) : Id E.R (E.neg (EV.lower Pm z)) (SP.comb Pm.deg (B.PF.pw z Pm.deg) (\ k -> R.neg (Pm.low k))) =
    sym (trans (SE.sum-cong Pm.deg (\ k -> E.mul (B.PF.pw z Pm.deg k) (iota.1 (R.neg (Pm.low k))))
                  (\ k -> E.mul (B.PF.pw z Pm.deg k) (E.neg (iota.1 (Pm.low k))))
                  (\ k -> ap (E.mul (B.PF.pw z Pm.deg k)) (RH.negation R E iota (Pm.low k))))
            (SE.lin-neg Pm.deg (B.PF.pw z Pm.deg) (\ k -> iota.1 (Pm.low k)))) ;
  -- z^d = sum_k z^k iota(-c_k) for a root z of a monic P
  hyp-of-root (Pm : ZC.Monic[R]) (z : E.R) (h : Id E.R (EV.mev Pm z) E.z) : SP.In Pm.deg (B.PF.pw z Pm.deg) (B.PF.pow z Pm.deg) =
    SP.in-inc Pm.deg (B.PF.pw z Pm.deg) (B.PF.pow z Pm.deg)
      (\ k -> R.neg (Pm.low k),
       (noB, trans (L.neg-uniq (EV.lower Pm z) (B.PF.pow z Pm.deg) (trans (E.addC (EV.lower Pm z) (B.PF.pow z Pm.deg)) h))
               (trans (neg-lower Pm z) (sym (E.addZ (SP.comb Pm.deg (B.PF.pw z Pm.deg) (\ k -> R.neg (Pm.low k)))))))) ;
  hyp : MO.Hyp (suc n) B.w d = \ j -> hyp-of-root (Qw j) (B.w j) (root j) ;
  claim : MO.Claim (suc n) B.w d = MO.claim (suc n) B.w d hyp ;
  N : Nat = MO.sz (suc n) d ;
  g : Ps.Fin N -> E.R = MO.mono (suc n) B.w d ;

  -- H(w) . span in span
  all-mul : (H : B.P.Expr B.Vw) (f : E.R) -> SP.In N g f -> SP.In N g (E.mul (B.ev H) f) = split {
    var j -> claim.2 j ;
    cst r -> SP.in-scale N g r ;
    sumE p q | rp rq -> \ f h -> SP.in-eq N g (E.add (E.mul (B.ev p) f) (E.mul (B.ev q) f)) (E.mul (B.ev (sumE p q)) f)
                                   (sym (L.dist-left (B.ev p) (B.ev q) f))
                                   (SP.in-add N g (E.mul (B.ev p) f) (E.mul (B.ev q) f) (rp f h) (rq f h)) ;
    mulE p q | rp rq -> \ f h -> SP.in-eq N g (E.mul (B.ev p) (E.mul (B.ev q) f)) (E.mul (B.ev (mulE p q)) f)
                                   (E.mulA (B.ev p) (B.ev q) f)
                                   (rp (E.mul (B.ev q) f) (rq f h)) } ;
  spans-E (e : E.R) (h : B.InB e) : SP.In N g e =
    TC.bind (B.Rep e) (SP.Coords N g e)
      (\ r -> SP.in-eq N g (E.mul (B.ev r.1) E.o) e (trans (E.mulO (B.ev r.1)) r.2) (all-mul r.1 E.o claim.1)) h ;

  -- the monomials are in B
  mono-in : (m : Nat) (y : Ps.Fin m -> E.R) (dm : Ps.Fin m -> Nat) -> ((i : Ps.Fin m) -> B.InB (y i)) ->
    (k : Ps.Fin (MO.sz m dm)) -> B.InB (MO.mono m y dm k) = split {
    zero -> \ y dm h k -> B.in-one ;
    suc m | r -> \ y dm h -> SP.block-ind B.InB (dm (inr tt)) (B.PF.pw (y (inr tt)) (dm (inr tt))) (MO.sz m (\ i -> dm (inl i)))
                               (MO.mono m (\ i -> y (inl i)) (\ i -> dm (inl i)))
                               (\ j k -> B.in-mul _ _ (B.pw-in (y (inr tt)) (h (inr tt)) (dm (inr tt)) j)
                                            (r (\ i -> y (inl i)) (\ i -> dm (inl i)) (\ i -> h (inl i)) k)) } ;
  gB (k : Ps.Fin N) : B.Carrier = (g k, mono-in (suc n) B.w d B.in-w k) ;
  module SB = FiniteIdeal[l].Sums[B.ring] ; module HS = ZC.HomSums[B.ring,E,B.incl] ;
  SpanB (b : B.Carrier) : U l = (ab : Ps.Fin N -> R.R) * Id B.Carrier b (SB.lin N gB (\ k -> B.iotaB.1 (ab k))) ;
  spans (b : B.Carrier) : Tr.Trunc[SpanB b].carrier =
    TC.map (SP.Coords N g b.1) (SpanB b)
      (\ cd -> (cd.1, B.eqB b (SB.lin N gB (\ k -> B.iotaB.1 (cd.1 k)))
                       (trans cd.2.2 (trans (E.addZ (SP.comb N g cd.1)) (sym (HS.lin-natural N gB (\ k -> B.iotaB.1 (cd.1 k))))))))
      (spans-E b.1 b.2) ;
  -- B is finite over R
  finite : QFm.ModuleFinite[R,B.ring,B.iotaB] = QFm.mkModuleFinite R B.ring B.iotaB N gB spans ;
} ;
