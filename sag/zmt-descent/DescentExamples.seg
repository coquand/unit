-- DescentExamples.seg: regression instances (handoff §8).
--
-- T1  transport of a supplied certificate Z -> Z/4Z: (s, Q0) = (1, T - 1)
--     for n = t = 0 over Z goes to (1, T + 3) over Z/4Z (by computation).
-- T2  residual data over the nonreduced ring Z/4Z: x = 2 (nilpotent),
--     b = (2), P(T) = T^2 with lower coefficients 0, 0, H = 0.  The
--     universal base is Z[C_1..C_4] (m = 4, CFN); the two equal lower
--     coefficients are recorded at different indices and both sent to 0 (h is
--     not injective); the images are the original data; phi(y) = 2; the
--     special fibre of F0 is spanned by 1, y.
-- T3  n = 0 and t = 0 over Z: the fibre is spanned by 1; the conditional
--     theorem applies.
-- T4  the residual-zero case over Z/4Z: P = 1 (degree 0), 1 = 1 * 1; the
--     spanning family of the special fibre is empty and 1 is in I0 F0.
-- T5  a supplied certificate for the residual algebra F = Z[C][y]/(y - C):
--     s = 1, Q0 = T - 1, Q1 = T - C (as y = C in F), carried along
--     C |-> 2 : Z[C] -> Z/4Z and phi : F -> Z/4Z, y |-> 2, to
--     (1, T + 3, T + 2) over Z/4Z.
-- T6  Gate D on Z/4Z with I = (2), E = Z/4Z, x = 2: the extraction of
--     residual data from the finite fibre (spanned by 1) is checked without
--     any principle, and the certified conclusion from UniversalZMT 1.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module RH = RingHom[l] ; module Tr = Truncation[l] ;
module ZC = ZMTCertificate[l] ; module CB = CoefficientBase[l] ; module RA = ResidualAlgebra[l] ;
module CD = CFNDescent[l] ; module IW = IdealWitnesses[l] ; module FFC = FiniteFibreCertificates[l] ;
module ZR = ZRing[l] ; module ZM = ZMod4[l] ;

R4 : CRing = ZM.ring ;
set4 : Pr.isSet R4.R = ZM.set ;
module C4 = Algebras[l].Over[R4,set4] ;
module P4 = Presentations[l].Over[R4,set4] ;
E4 : C4.Algebra = C4.base ;
-- the variable of Fin 1
v1 : Ps.Fin (suc zero) = inr tt ;
fin1 : (i : Ps.Fin (suc zero)) -> Id (Ps.Fin (suc zero)) v1 i = split {
  inl e -> absurd (Id (Ps.Fin (suc zero)) v1 (inl e)) e ;
  inr u -> ap (\ w -> inr w) (FiniteFamilies[l].top-eta u) } ;

------------------------------------------------------------------------
-- T1

module T1 {
  Z : CRing = ZR.ring ;
  y (i : Ps.Fin zero) : Z.R = absurd Z.R i ;
  b (j : Ps.Fin zero) : Z.R = absurd Z.R j ;
  c0 : ZC.ZMTCert[Z,Z,RH.identity Z,zero,y,zero,b] =
    ZC.mkZMTCert Z Z (RH.identity Z) zero y zero b Z.o (\ j -> absurd Z.R j, refl Z.o)
      (ZC.mkMonic Z (suc zero) (\ k -> Z.neg Z.o)) (refl Z.z)
      (\ i -> absurd (ZC.Monic[Z]) i) (\ i -> absurd (Id Z.R (ZC.Eval[Z,Z,RH.identity Z].mev (absurd (ZC.Monic[Z]) i) (Z.mul Z.o (y i))) Z.z) i) ;
  h : RH.Hom Z R4 = ZR.Initial[R4].hom ;
  x (i : Ps.Fin zero) : R4.R = absurd R4.R i ;
  a (j : Ps.Fin zero) : R4.R = absurd R4.R j ;
  module TT = CertificateTransport[l].Over[Z,R4,h,Z,R4,RH.identity Z,RH.identity R4,h,\ r -> refl (h.1 r),
                                           zero,y,x,\ i -> absurd (Id R4.R (h.1 (y i)) (x i)) i,zero,b,a,\ j -> absurd (Id R4.R (h.1 (b j)) (a j)) j] ;
  c1 : TT.Target = TT.cert c0 ;
  s-is : Id R4.R c1.s q1 = refl q1 ;
  q0-is : Id R4.R (c1.q0.low (inr tt)) q3 = refl q3 ;
} ;

------------------------------------------------------------------------
-- T2

module T2 {
  x (i : Ps.Fin (suc zero)) : R4.R = q2 ;
  P : ZC.Monic[R4] = ZC.mkMonic R4 (suc (suc zero)) (\ k -> q0) ;
  D : RA.Residual[R4,set4,suc zero] = RA.mkResidual R4 set4 (suc zero) (suc zero) (\ j -> q2) (\ i -> P) (\ i j -> cst q0) ;
  -- 2^2 = 0 = 2 * 0
  hold : RA.Equations[R4,set4,suc zero,D].At[E4,x].Holds = \ i -> refl q0 ;
  module UR = UniversalResidualAlgebra[l].Over[R4,set4,suc zero,D] ;
  m-is : Id Nat UR.m (suc (suc (suc (suc zero)))) = refl UR.m ;
  cfn : CFN[l].CFN[CB.Codes,UR.A0] = UR.cfnA0 ;
  -- repeated coefficients at different indices
  k0 : Ps.Fin (suc (suc zero)) = inl (inr tt) ;
  k1 : Ps.Fin (suc (suc zero)) = inr tt ;
  disc3 : Ps.Fin (suc (suc (suc zero))) -> U l = split { inl q -> Top ; inr u -> Empty } ;
  disc : Ps.Fin (suc (suc (suc (suc zero)))) -> U l = split { inl p -> disc3 p ; inr u -> Empty } ;
  distinct : Not (Id (Ps.Fin UR.m) (UR.iP v1 k0) (UR.iP v1 k1)) = \ p -> subst disc p tt ;
  -- both are sent to 0: h is not injective
  image0 : Id R4.R (UR.h.1 ((UR.P0 v1).low k0)) q0 = UR.image-P v1 k0 ;
  image1 : Id R4.R (UR.h.1 ((UR.P0 v1).low k1)) q0 = UR.image-P v1 k1 ;
  -- b0 goes to the nilpotent 2
  image-b : Id R4.R (UR.h.1 (UR.b0 (inr tt))) q2 = UR.image-b (inr tt) ;
  nilpotent : Id R4.R (R4.mul q2 q2) q0 = refl q0 ;
  image-H : Id (P4.Expr (Ps.Fin (suc zero))) (UR.LF.M.mapE (Ps.Fin (suc zero)) (UR.H0 v1 (inr tt))) (cst q0) = UR.image-H v1 (inr tt) ;
  -- the compatible map
  module TE = UR.ToE[E4,x,hold] ;
  phi-y : Id R4.R (TE.phi.1 (UR.F0.y v1)) q2 = TE.phi-y v1 ;
  -- the special fibre of F0 is spanned by 1, y
  module FB = ResidualFibreFinite[l].Fibre[UR.A0,UR.setA0,suc zero,UR.D0] ;
  fibre-size : Id Nat FB.N (suc (suc zero)) = refl FB.N ;
  finite : FB.SP.Finite = FB.finite ;
} ;

------------------------------------------------------------------------
-- T3

module T3 {
  Z : CRing = ZR.ring ;
  module CZ = Algebras[l].Over[Z,ZR.set] ; module PZ = Presentations[l].Over[Z,ZR.set] ;
  D : RA.Residual[Z,ZR.set,zero] = RA.mkResidual Z ZR.set zero zero (\ j -> absurd Z.R j) (\ i -> absurd (ZC.Monic[Z]) i)
    (\ i j -> absurd (PZ.Expr (Ps.Fin zero)) i) ;
  module FB = ResidualFibreFinite[l].Fibre[Z,ZR.set,zero,D] ;
  fibre-size : Id Nat FB.N (suc zero) = refl FB.N ;
  x (i : Ps.Fin zero) : Z.R = absurd Z.R i ;
  hold : RA.Equations[Z,ZR.set,zero,D].At[CZ.base,x].Holds = \ i -> absurd (RA.Equations[Z,ZR.set,zero,D].At[CZ.base,x].Holds) i i ;
  module Cond (U0 : CD.UniversalZMT zero) {
    certificate : Tr.Trunc[ZC.ZMTCert[Z,Z,RH.identity Z,zero,x,zero,D.b]].carrier = CD.Descent[zero,U0,Z,ZR.set,D,CZ.base,x,hold].certificate ;
  } ;
} ;

------------------------------------------------------------------------
-- T4

module T4 {
  x (i : Ps.Fin (suc zero)) : R4.R = q2 ;
  P : ZC.Monic[R4] = ZC.mkMonic R4 zero (\ k -> absurd R4.R k) ;
  D : RA.Residual[R4,set4,suc zero] = RA.mkResidual R4 set4 (suc zero) (suc zero) (\ j -> q1) (\ i -> P) (\ i j -> cst q1) ;
  -- 1 = 1 * 1
  hold : RA.Equations[R4,set4,suc zero,D].At[E4,x].Holds = \ i -> refl q1 ;
  module UR = UniversalResidualAlgebra[l].Over[R4,set4,suc zero,D] ;
  module FB = ResidualFibreFinite[l].Fibre[UR.A0,UR.setA0,suc zero,UR.D0] ;
  fibre-size : Id Nat FB.N zero = refl FB.N ;
  -- 1 is in I0 F0: the special fibre is 0
  one-in-ideal : FB.SP.In zero FB.g FB.F.o = FB.spans FB.F.o ;
} ;

------------------------------------------------------------------------
-- T5

module T5 {
  A1 : CRing = CB.ring (suc zero) ;
  set1 : Pr.isSet A1.R = CB.set (suc zero) ;
  C : A1.R = CB.var (suc zero) (inr tt) ;
  P1 : ZC.Monic[A1] = ZC.mkMonic A1 (suc zero) (\ k -> A1.z) ;
  -- y = C . 1
  D0 : RA.Residual[A1,set1,suc zero] = RA.mkResidual A1 set1 (suc zero) (suc zero) (\ j -> C) (\ i -> P1) (\ i j -> cst A1.o) ;
  module F = RA.Algebra[A1,set1,suc zero,D0] ;
  Fr : CRing = F.ring ;
  iota : RH.Hom A1 Fr = F.algebra.iota ;
  module L = RL[Fr] ;
  y : Fr.R = F.y v1 ;
  -- y = iota C in F
  y-is : Id Fr.R y (iota.1 C) = calc Fr.R {
    y =< sym (Fr.mulO y) > Fr.mul y Fr.o
      =< sym (trans (ap (Fr.add (Fr.mul y Fr.o)) (trans (ap (\ w -> Fr.add (Fr.mul Fr.o w) Fr.z) (RH.zero A1 Fr iota))
                                                         (trans (Fr.addZ (Fr.mul Fr.o Fr.z)) (L.mul-zero Fr.o))))
                    (Fr.addZ (Fr.mul y Fr.o)))
      > Fr.add (Fr.mul y Fr.o) (Fr.add (Fr.mul Fr.o (iota.1 A1.z)) Fr.z)
      =< F.y-holds v1 > Fr.add (Fr.mul (iota.1 C) (iota.1 A1.o)) Fr.z
      =< trans (Fr.addZ (Fr.mul (iota.1 C) (iota.1 A1.o))) (trans (ap (Fr.mul (iota.1 C)) iota.2.1) (Fr.mulO (iota.1 C)))
      > iota.1 C } ;
  -- o + (o iota(-a) + 0) = o - iota(a)
  lin1 (a : A1.R) : Id Fr.R (Fr.add (Fr.mul Fr.o (iota.1 (A1.neg a))) Fr.z) (Fr.neg (iota.1 a)) =
    trans (Fr.addZ (Fr.mul Fr.o (iota.1 (A1.neg a)))) (trans (L.one-left (iota.1 (A1.neg a))) (RH.negation A1 Fr iota a)) ;
  Q0 : ZC.Monic[A1] = ZC.mkMonic A1 (suc zero) (\ k -> A1.neg A1.o) ;
  Q1 : ZC.Monic[A1] = ZC.mkMonic A1 (suc zero) (\ k -> A1.neg C) ;
  ann0 : Id Fr.R (ZC.Eval[A1,Fr,iota].mev Q0 Fr.o) Fr.z =
    trans (Ps.cong2 Fr.R Fr.add _ _ _ _ (Fr.mulO Fr.o) (trans (lin1 A1.o) (ap Fr.neg iota.2.1))) (Fr.addN Fr.o) ;
  ann1 (i : Ps.Fin (suc zero)) : Id Fr.R (ZC.Eval[A1,Fr,iota].mev Q1 (Fr.mul Fr.o (F.y i))) Fr.z =
    trans (Ps.cong2 Fr.R Fr.add _ _ _ _
             (trans (Fr.mulO (Fr.mul Fr.o (F.y i))) (trans (L.one-left (F.y i)) (trans (ap F.y (sym (fin1 i))) y-is)))
             (lin1 C))
      (Fr.addN (iota.1 C)) ;
  cert0 : ZC.ZMTCert[A1,Fr,iota,suc zero,F.y,suc zero,\ j -> C] =
    ZC.mkZMTCert A1 Fr iota (suc zero) F.y (suc zero) (\ j -> C) Fr.o
      (\ j -> Fr.z, sym (trans (ap (Fr.add Fr.o) (trans (Fr.addZ (Fr.mul (iota.1 C) Fr.z)) (L.mul-zero (iota.1 C)))) (Fr.addZ Fr.o)))
      Q0 ann0 (\ i -> Q1) ann1 ;
  -- the target: C |-> 2, y |-> 2
  c (k : Ps.Fin (suc zero)) : R4.R = q2 ;
  h : RH.Hom A1 R4 = CB.Eval[R4,set4].ev (suc zero) c ;
  h-C : Id R4.R (h.1 C) q2 = CB.Eval[R4,set4].ev-var (suc zero) c (inr tt) ;
  x (i : Ps.Fin (suc zero)) : R4.R = q2 ;
  module M = FiniteCoefficientData[l].Map[A1,R4,set1,set4,h] ;
  EA : M.CA.Algebra = M.along E4 ;
  hold0 : RA.Equations[A1,set1,suc zero,D0].At[EA,x].Holds = \ i ->
    trans (ap (\ w -> R4.add (R4.mul q2 q1) (R4.add (R4.mul q1 w) q0)) (RH.zero A1 R4 h))
      (sym (trans (ap (\ w -> R4.add (R4.mul w (h.1 A1.o)) q0) h-C) (ap (\ w -> R4.add (R4.mul q2 w) q0) h.2.1))) ;
  module TF = F.To[EA,x,hold0] ;
  module TT = CertificateTransport[l].Over[A1,R4,h,Fr,R4,iota,RH.identity R4,TF.phi.1,TF.phi-iota,
                                           suc zero,F.y,x,TF.phi-y,suc zero,\ j -> C,\ j -> q2,\ j -> h-C] ;
  c1 : TT.Target = TT.cert cert0 ;
  -- (1, T + 3, T + 2) over Z/4Z
  q0-is : Id R4.R (c1.q0.low (inr tt)) q3 = trans (RH.negation A1 R4 h A1.o) (ap R4.neg h.2.1) ;
  q1-is : Id R4.R ((c1.q v1).low (inr tt)) q2 = trans (RH.negation A1 R4 h C) (ap R4.neg h-C) ;
  s-is : Id R4.R c1.s q1 = TF.phi.1.2.1 ;
} ;

------------------------------------------------------------------------
-- T6

module T6 {
  -- I = (2)
  I (a : R4.R) : U l = (c : R4.R) * Id R4.R (R4.mul q2 c) a ;
  x (i : Ps.Fin (suc zero)) : R4.R = q2 ;
  gen (e : R4.R) : Tr.Trunc[(H : P4.Expr (Ps.Fin (suc zero))) * Id R4.R (P4.eval (Ps.Fin (suc zero)) E4 x H) e].carrier =
    Tr.Trunc[(H : P4.Expr (Ps.Fin (suc zero))) * Id R4.R (P4.eval (Ps.Fin (suc zero)) E4 x H) e].inc (cst e, refl e) ;
  g (k : Ps.Fin (suc zero)) : R4.R = q1 ;
  -- e = 1 e + 0, by cases
  one-span : (e : R4.R) -> Id R4.R e (R4.add (R4.add (R4.mul q1 e) q0) q0) = split {
    q0 -> refl q0 ; q1 -> refl q1 ; q2 -> refl q2 ; q3 -> refl q3 } ;
  module W = IW.Over[R4,I,R4,RH.identity R4] ;
  ff : FFC.FiniteFibre[R4,I,R4,RH.identity R4] =
    FFC.mkFiniteFibre R4 I R4 (RH.identity R4) (suc zero) g (\ e ->
      Tr.Trunc[FFC.Decomp R4 I R4 (RH.identity R4) (suc zero) g e].inc (\ k -> e, (q0, (W.ie-zero, one-span e)))) ;
  module G = FFC.Over[R4,set4,I,E4,suc zero,x,gen,ff] ;
  -- residual data with (R), extracted without any principle
  residual : Tr.Trunc[G.ResidualIn].carrier = G.residual ;
  module Run (U0 : CD.UniversalZMT (suc zero)) {
    certified : Tr.Trunc[FFC.Certified[R4,I,R4,RH.identity R4,suc zero,x]].carrier = G.Theorem[U0].certified ;
  } ;
} ;
