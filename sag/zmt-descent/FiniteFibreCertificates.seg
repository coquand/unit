-- FiniteFibreCertificates.seg: the arbitrary-base certificate theorem from a
-- finite fibre, Gate D (handoff §6).
--
-- Assumptions.  R any commutative set-ring, I : R -> U any predicate (the
-- ideal; IE is the set of finite sums sum_k iota(a_k) w_k, a_k in I), E an
-- R-algebra, x_1 .. x_n in E, and
--   (gen) algebra generation: every e in E is merely the value at x of a
--     polynomial expression over R (the evaluation R[X_1..X_n] -> E is
--     surjective under truncation); no presentation of its kernel is used;
--   (FiniteFibre) g_1 .. g_N in E such that every e is merely
--     e = sum_k g_k iota(alpha_k) + r with alpha in R and r in IE (Decomp):
--     the images of the g_k generate E/IE as an R/I-module, with the
--     coefficients already lifted to R.
-- Conclusion (Theorem.certified): merely a_1 .. a_t in I and a certificate
-- s = 1 + sum_j iota(a_j) r_j, monic Q_0, Q_i over R with Q_0(s) = 0 and
-- Q_i(s x_i) = 0 (Certified), given the CFN principle UniversalZMT n
-- (or CFNZMT n, TheoremCFN).
--
-- Proof (residual data under truncation).
--   (1) For each i (ForZ[x_i]): choose decompositions of x_i g_k (finite
--       choice over k, FinCat.fchoice) and of 1; the determinant trick modulo
--       IE (CharacteristicMonic.Trick) gives a monic P_i over R with
--       P_i(x_i) in IE, with an explicit witness.  If the fibre is zero
--       (N = 0) then P_i = 1 and 1 is in IE.
--   (2) Finite choice over i, then one common family a_1 .. a_t in I with
--       P_i(x_i) = sum_j iota(a_j) W_ij (IdealWitnesses.vec-of-wits:
--       concatenation of the finitely many families).
--   (3) By (gen), choose expressions H_ij with H_ij(x) = W_ij (finite choice
--       over i and j).  This is residual data D with the identities (R)
--       (hold); CFNDescent.Descent gives the certificate for D.b = a.
-- Positive degree of the P_i is not needed anywhere, and n = 0, t = 0 are
-- allowed.  The certificate need not have s /= 0: if IE = E, 0 = 1 + ... is
-- allowed.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module RH = RingHom[l] ; module Tr = Truncation[l] ;
module ZC = ZMTCertificate[l] ; module RA = ResidualAlgebra[l] ; module IW = IdealWitnesses[l] ;
module TC = TruncationCombinators[l] ; module FC = FinCat[l] ; module CD = CFNDescent[l] ;

-- e = sum_k g_k iota(alpha_k) + r, r in IE
Decomp (R : CRing) (I : R.R -> U l) (E : CRing) (iota : RH.Hom R E) (N : Nat) (g : Ps.Fin N -> E.R) (e : E.R) : U l =
  (alpha : Ps.Fin N -> R.R) * ((r : E.R) * (IW.IEWit[R,I,E,iota,r] *
    Id E.R e (E.add (FiniteIdeal[l].Sums[E].lin N g (\ k -> iota.1 (alpha k))) r))) ;

record FiniteFibre (R : CRing) (I : R.R -> U l) (E : CRing) (iota : RH.Hom R E) {
  N : Nat ;
  g : Ps.Fin N -> E.R ;
  spans (e : E.R) : Tr.Trunc[Decomp R I E iota N g e].carrier ;
} ;

-- the conclusion: a family in I and a certificate for it
record Certified (R : CRing) (I : R.R -> U l) (E : CRing) (iota : RH.Hom R E) (n : Nat) (x : Ps.Fin n -> E.R) {
  t : Nat ;
  a : Ps.Fin t -> R.R ;
  ina (j : Ps.Fin t) : I (a j) ;
  cert : ZC.ZMTCert[R,E,iota,n,x,t,a] ;
} ;

module Over (R : CRing) (setR : Pr.isSet R.R) (I : R.R -> U l) (Ea : Algebras[l].Over[R,setR].Algebra)
  (n : Nat) (x : Ps.Fin n -> Ea.ring.R)
  (gen : (e : Ea.ring.R) -> Tr.Trunc[(H : Presentations[l].Over[R,setR].Expr (Ps.Fin n)) *
                                     Id Ea.ring.R (Presentations[l].Over[R,setR].eval (Ps.Fin n) Ea x H) e].carrier)
  (ff : FiniteFibre[R,I,Ea.ring,Ea.iota]) {
  E : CRing = Ea.ring ;
  iota : RH.Hom R E = Ea.iota ;
  module PR = Presentations[l].Over[R,setR] ;
  module W = IW.Over[R,I,E,iota] ; module S = FiniteIdeal[l].Sums[E] ;
  Dc (e : E.R) : U l = Decomp R I E iota ff.N ff.g e ;
  -- a monic polynomial with P(z) in IE
  MonicIn (z : E.R) : U l = (P : ZC.Monic[R]) * W.Wit (ZC.Eval[R,E,iota].mev P z) ;

  ------------------------------------------------------------------------
  -- (1) one element

  module ForZ (z : E.R) {
    module Of (dk : (k : Ps.Fin ff.N) -> Dc (E.mul z (ff.g k))) (d1 : Dc E.o) {
      module T = CharacteristicMonic[l].Trick[R,setR,I,E,Ea.set,iota,z,ff.N,ff.g,\ j i -> (dk i).1 j,\ i -> (dk i).2.1,
                   \ i -> (dk i).2.2.1,\ i -> (dk i).2.2.2,d1.1,d1.2.1,d1.2.2.1,d1.2.2.2] ;
      monic : MonicIn z = (T.P, T.wit) ;
    } ;
    monic : Tr.Trunc[MonicIn z].carrier =
      TC.map2 ((k : Ps.Fin ff.N) -> Dc (E.mul z (ff.g k))) (Dc E.o) (MonicIn z) (\ dk d1 -> Of[dk,d1].monic)
        (FC.fchoice ff.N (\ k -> Dc (E.mul z (ff.g k))) (\ k -> ff.spans (E.mul z (ff.g k)))) (ff.spans E.o) ;
  } ;

  ------------------------------------------------------------------------
  -- (2), (3) residual data

  Rep (e : E.R) : U l = (H : PR.Expr (Ps.Fin n)) * Id E.R (PR.eval (Ps.Fin n) Ea x H) e ;
  module Residual (ch : (i : Ps.Fin n) -> MonicIn (x i)) {
    v (i : Ps.Fin n) : E.R = ZC.Eval[R,E,iota].mev (ch i).1 (x i) ;
    vw : IW.VecWit[R,I,E,iota,n,v] = W.vec-of-wits n v (\ i -> (ch i).2) ;
    Reps : U l = (i : Ps.Fin n) (j : Ps.Fin vw.u) -> Rep (vw.W i j) ;
    reps : Tr.Trunc[Reps].carrier =
      FC.fchoice n (\ i -> (j : Ps.Fin vw.u) -> Rep (vw.W i j))
        (\ i -> FC.fchoice vw.u (\ j -> Rep (vw.W i j)) (\ j -> gen (vw.W i j))) ;
    module With (rs : Reps) {
      D : RA.Residual[R,setR,n] = RA.mkResidual R setR n vw.u vw.a (\ i -> (ch i).1) (\ i j -> (rs i j).1) ;
      hold : RA.Equations[R,setR,n,D].At[Ea,x].Holds = \ i ->
        trans (vw.eq i) (S.sum-cong vw.u (\ j -> E.mul (iota.1 (vw.a j)) (vw.W i j))
                           (\ j -> E.mul (iota.1 (vw.a j)) (PR.eval (Ps.Fin n) Ea x (rs i j).1))
                           (\ j -> ap (E.mul (iota.1 (vw.a j))) (sym (rs i j).2))) ;
    } ;
  } ;
  all-monic : Tr.Trunc[(i : Ps.Fin n) -> MonicIn (x i)].carrier = FC.fchoice n (\ i -> MonicIn (x i)) (\ i -> ForZ[x i].monic) ;

  -- residual data with the identities (R), merely
  ResidualIn : U l = (D : RA.Residual[R,setR,n]) * (RA.Equations[R,setR,n,D].At[Ea,x].Holds * ((j : Ps.Fin D.t) -> I (D.b j))) ;
  residual : Tr.Trunc[ResidualIn].carrier =
    TC.bind ((i : Ps.Fin n) -> MonicIn (x i)) ResidualIn (\ ch ->
      TC.map Residual[ch].Reps ResidualIn (\ rs -> (Residual[ch].With[rs].D, (Residual[ch].With[rs].hold, Residual[ch].vw.ina)))
        Residual[ch].reps) all-monic ;

  ------------------------------------------------------------------------
  -- the theorem

  module Theorem (U0 : CD.UniversalZMT n) {
    Goal : U l = Certified[R,I,E,iota,n,x] ;
    of-residual (r : ResidualIn) : Tr.Trunc[Goal].carrier =
      TC.map (ZC.ZMTCert[R,E,iota,n,x,r.1.t,r.1.b]) Goal (\ c -> mkCertified R I E iota n x r.1.t r.1.b r.2.2 c)
        CD.Descent[n,U0,R,setR,r.1,Ea,x,r.2.1].certificate ;
    certified : Tr.Trunc[Goal].carrier = TC.bind ResidualIn Goal of-residual residual ;
  } ;
  module TheoremCFN (Z : CD.CFNZMT n) {
    certified : Tr.Trunc[Certified[R,I,E,iota,n,x]].carrier = Theorem[CD.universal-of-cfn n Z].certified ;
  } ;
} ;
