-- Assemble the explicit native point sections and their native overlap
-- witnesses into the actual Cech complex. Section restrictions preserve
-- coefficients; the degree projection is linear. These two facts identify
-- the assembled overlap errors with d0(z), with no extra assumptions.
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open Cech4[l] ; open PolynomialAction4[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module IP = IdealPowers[l] ;
module ZM = ZMT4Certificate[l] ; module BR = PolynomialRing4Bridge[l] ;
module ND = NativeSectionData4[l] ; module NE = NativeSectionErrors4[l] ;
module AS = ChartFamilyAssembly4[l] ; module CN = ChartRestrictionNaturality4[l] ;
left : Ed -> Pt = split { e01 -> p0 ; e02 -> p0 ; e03 -> p0 ; e12 -> p1 ; e13 -> p1 ; e23 -> p2 } ;
right : Ed -> Pt = split { e01 -> p1 ; e02 -> p2 ; e03 -> p3 ; e12 -> p2 ; e13 -> p3 ; e23 -> p3 } ;
has-left : (e : Ed) -> Le4 (setPt (left e)) (setEd e) = split {
 e01 -> ok4 ; e02 -> ok4 ; e03 -> ok4 ; e12 -> ok4 ; e13 -> ok4 ; e23 -> ok4 } ;
has-right : (e : Ed) -> Le4 (setPt (right e)) (setEd e) = split {
 e01 -> ok4 ; e02 -> ok4 ; e03 -> ok4 ; e12 -> ok4 ; e13 -> ok4 ; e23 -> ok4 } ;
module Over (A : CRing) (setA : Pr.isSet A.R) (D0 : ResidualAlgebra[l].Residual[A,setA,ZM.three]) {
 module D = ND.Over[A,setA,D0] ; module Errors = NE.Over[A,setA,D0] ;
 module CE = Cech4[l].Over[A,setA] ; module AL = IP.ModL[A,IP.regular A] ;
 module CS0 = AS.Over[A,setA,Pt,setPt,AS.four,AS.pt,AS.cover-pt,TopList4[l].mOne] ;
 module CS1 = AS.Over[A,setA,Ed,setEd,AS.six,AS.ed,AS.cover-ed,TopList4[l].mOne] ;
 module Chart (E : Sub4) {
   module N = D.AtChart[E] ; module Error = Errors.AtChart[E] ;
   module Part = N.D.Part[TopList4[l].mOne].Into[Sq] ;
   module Lin = RelationCertificate[l].LinL[A,N.D.moduleM,Part.C.mod,Part.lin] ;
   section : (k : Pt) -> Le4 (setPt k) E -> Nat -> N.R.ring.R = split {
     p0 -> \ has n -> N.C.Inverse[p0,has].inverse ;
     p1 -> \ has n -> N.Affine[ZM.i1,has].At[n].section ;
     p2 -> \ has n -> N.Affine[ZM.i2,has].At[n].section ;
     p3 -> \ has n -> N.Affine[ZM.i3,has].At[n].section } ;
   part-sub (x y : N.R.ring.R) (m : E4) :
     Id A.R (N.D.Part[TopList4[l].mOne].value (N.W.ML.msub x y) m)
       (AL.msub (N.D.Part[TopList4[l].mOne].value x m) (N.D.Part[TopList4[l].mOne].value y m)) =
     ap (\ c -> Part.C.val c s0123 m) (Lin.f-sub x y) ;
 } ;
 module Restriction (E F : Sub4) (le : Le4 E F) {
   module Source = Chart[E] ; module Target = Chart[F] ;
   module Map = ChartRestriction4[l].Over[A,setA,E,F,le] ;
   section (n : Nat) : (k : Pt) (hs : Le4 (setPt k) E) (ht : Le4 (setPt k) F) ->
     Id Target.N.R.ring.R (Map.hom.1 (Source.section k hs n)) (Target.section k ht n) = split {
     p0 -> \ hs ht -> ChartCoordinates4[l].Restriction[A,setA,E,F,le].Inverse[p0,hs,ht].equation ;
     p1 -> \ hs ht -> D.Restriction[E,F,le,ZM.i1,hs,ht].section n ;
     p2 -> \ hs ht -> D.Restriction[E,F,le,ZM.i2,hs,ht].section n ;
     p3 -> \ hs ht -> D.Restriction[E,F,le,ZM.i3,hs,ht].section n } ;
   coefficient (n : Nat) (k : Pt) (hs : Le4 (setPt k) E) (ht : Le4 (setPt k) F) (m : E4) :
     Id A.R (Source.N.R.coeff (Source.section k hs n) m) (Target.N.R.coeff (Target.section k ht n) m) =
     trans (sym (Map.coefficient (Source.section k hs n) m)) (ap (\ x -> Target.N.R.coeff x m) (section n k hs ht)) ;
   part (n : Nat) (k : Pt) (hs : Le4 (setPt k) E) (ht : Le4 (setPt k) F) (m : E4) :
     Id A.R (Source.N.D.Part[TopList4[l].mOne].value (Source.section k hs n) m)
       (Target.N.D.Part[TopList4[l].mOne].value (Target.section k ht n) m) =
     Source.N.D.select-cong TopList4[l].mOne m _ _ (coefficient n k hs ht m) ;
 } ;
 module Point (k : Pt) {
   module C = Chart[setPt k] ;
   raw (n : Nat) : C.N.R.ring.R = C.section k (CN.le-self (setPt k)) n ;
   value (n : Nat) : CS0.Local[k].C.El = C.Part.element (raw n) ;
   compat (n : Nat) : C.N.R.ring.R = C.N.W.ML.msub (raw n) (raw zero) ;
 } ;
 points (n : Nat) : CS0.P.El = \ k -> Point[k].value n ;
 z (n : Nat) : CS0.CH.El = CS0.assemble (points n) ;
 hz (n : Nat) (m : E4) :
   Id A.R (CS0.CH.val (z n) p0 m) (CE.LO.Chart[Sq,BadI Sq (\ j -> setPt p0) TopList4[l].mOne].val
     (ChartInversePart4[l].Over[A,setA,setPt p0,p0,CN.le-self (setPt p0)].P.Into[Sq].element
       ChartCoordinates4[l].Over[A,setA,setPt p0].Inverse[p0,CN.le-self (setPt p0)].inverse) s0123 m) = refl (CS0.CH.val (z n) p0 m) ;
 hz0 (n : Nat) (m : E4) : Id A.R (CS0.CH.val (z n) p0 m) (D.AtChart[setPt p0].R.FP.delta0 (addE m (nx (suc zero) zero zero zero))) =
   ChartInversePart4[l].Over[A,setA,setPt p0,p0,CN.le-self (setPt p0)].coefficient m ;
 module Edge (e : Ed) {
   module C = Chart[setEd e] ;
   raw (n : Nat) : C.N.R.ring.R = C.N.W.ML.msub (C.section (right e) (has-right e) n) (C.section (left e) (has-left e) n) ;
   value (n : Nat) : CS1.Local[e].C.El = C.Part.element (raw n) ;
 } ;
 edge-witness (n : Nat) : (e : Ed) -> Edge[e].C.N.W.Witness (suc (BR.toB n)) (Edge[e].raw n) = split {
   e01 -> Errors.AtChart[setEd e01].ZAffine[ZM.i1,ok4,ok4,n].witness ;
   e02 -> Errors.AtChart[setEd e02].ZAffine[ZM.i2,ok4,ok4,n].witness ;
   e03 -> Errors.AtChart[setEd e03].ZAffine[ZM.i3,ok4,ok4,n].witness ;
   e12 -> Errors.AtChart[setEd e12].AffineOverlap[ZM.i2,ZM.i1,ok4,ok4,n].witness ;
   e13 -> Errors.AtChart[setEd e13].AffineOverlap[ZM.i3,ZM.i1,ok4,ok4,n].witness ;
   e23 -> Errors.AtChart[setEd e23].AffineOverlap[ZM.i3,ZM.i2,ok4,ok4,n].witness } ;
 edge-values (n : Nat) : CS1.P.El = \ e -> Edge[e].value n ;
 endpoint (n : Nat) (e : Ed) (k : Pt) (has : Le4 (setPt k) (setEd e)) (m : E4) :
   Id A.R (Edge[e].C.N.D.Part[TopList4[l].mOne].value (Edge[e].C.section k has n) m) (CS0.CH.val (z n) k m) =
   sym (Restriction[setPt k,setEd e,has].part n k (CN.le-self (setPt k)) has m) ;
 d0-value (x : Pt -> E4 -> A.R) : (e : Ed) (m : E4) ->
   Id A.R (CE.d0 x e m) (AL.msub (x (right e) m) (x (left e) m)) = split {
   e01 -> \ m -> refl (AL.msub (x p1 m) (x p0 m)) ;
   e02 -> \ m -> refl (AL.msub (x p2 m) (x p0 m)) ;
   e03 -> \ m -> refl (AL.msub (x p3 m) (x p0 m)) ;
   e12 -> \ m -> refl (AL.msub (x p2 m) (x p1 m)) ;
   e13 -> \ m -> refl (AL.msub (x p3 m) (x p1 m)) ;
   e23 -> \ m -> refl (AL.msub (x p3 m) (x p2 m)) } ;
 edge-equation (n : Nat) : Id CS1.CH.El (CS1.assemble (edge-values n)) ((CE.D0 TopList4[l].mOne).f (z n)) =
   CS1.CH.eq _ _ (\ e m -> trans (Edge[e].C.part-sub
     (Edge[e].C.section (right e) (has-right e) n) (Edge[e].C.section (left e) (has-left e) n) m)
     (trans (AL.G.cong-add (endpoint n e (right e) (has-right e) m) (ap A.neg (endpoint n e (left e) (has-left e) m)))
       (sym (d0-value (CS0.CH.val (z n)) e m)))) ;
 compat-witness (n : Nat) : (k : Pt) -> Point[k].C.N.W.Witness (suc zero) (Point[k].compat n) = split {
   p0 -> Point[p0].C.N.W.transport (suc zero) Point[p0].C.N.R.ring.z _
     (sym (Point[p0].C.N.W.ML.sub-self (Point[p0].raw zero))) (Point[p0].C.N.W.zero-witness (suc zero)) ;
   p1 -> Errors.AtChart[setPt p1].Compatibility[ZM.i1,CN.le-self (setPt p1),n].witness ;
   p2 -> Errors.AtChart[setPt p2].Compatibility[ZM.i2,CN.le-self (setPt p2),n].witness ;
   p3 -> Errors.AtChart[setPt p3].Compatibility[ZM.i3,CN.le-self (setPt p3),n].witness } ;
 compat-values (n : Nat) : CS0.P.El = \ k -> Point[k].C.Part.element (Point[k].compat n) ;
 module ML0 = IP.ModL[A,CS0.CH.mod] ;
 compat-equation (n : Nat) : Id CS0.CH.El (CS0.assemble (compat-values n)) (ML0.msub (z n) (z zero)) =
   CS0.CH.eq _ _ (\ k m -> Point[k].C.part-sub (Point[k].raw n) (Point[k].raw zero) m) ;
} ;
