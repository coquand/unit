-- Proposition 1.7 of projective.pdf: every map P^n -> R is constant (n >= 1).
-- f([x]) is R^*-invariant on R^{n+1} \ {0}; by Lemma 1.6 it extends to psi on
-- R^{n+1}.  For x /= 0, t |-> psi(t x) - psi(x) vanishes on units, hence
-- everywhere (unit-vanishing); at t = 0 this gives f([x]) = psi(0).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (sqc : Presentations[l].Over[R,setR].SQC) {
 module C = Algebras[l].Over[R,setR] ;
 module AS = AffineSpace[l].Over[R,setR] ;
 module RR = AffineRing[l].Laws[R,setR] ;
 -- a function R -> R vanishing on the units is zero
 module UnitZero (g : R.R -> R.R) (h : (u : R.R) -> RL[R].unit u -> Id R.R (g u) R.z) {
  A : C.Algebra = AS.alg (suc zero) ;
  x0 : Fin (suc zero) = inr tt ;
  coordinate (x : C.Spec A) : R.R = AS.coords (suc zero) x x0 ;
  e : Pr.isEquiv A.ring.R (C.Spec A -> R.R) (C.evaluation A) = sqc A (AS.fp (suc zero)) ;
  c : A.ring.R = e.sec (\ x -> g (coordinate x)) ;
  value (x : C.Spec A) : Id R.R (x.1.1 c) (g (coordinate x)) =
   Pr.happly (C.Spec A) (\ x -> R.R) _ _ (e.sec-eq (\ x -> g (coordinate x))) x ;
  module LF = LocalFunctions[l].Over[R,setR,sqc].At[A,AS.fp (suc zero),AS.var (suc zero) x0] ;
  zero-c : Id A.ring.R c A.ring.z =
   Tr.Trunc[(n : Nat) * Id A.ring.R (A.ring.mul (AffinePowers[l].Over[A.ring].power (AS.var (suc zero) x0) n) c) A.ring.z].induction @l
    (\ t -> Id A.ring.R c A.ring.z) (\ t -> A.set c A.ring.z)
    (\ w -> AS.power-regular (suc zero) (AS.var (suc zero) x0) (AS.regular (suc zero) x0) w.1 c w.2)
    (LF.vanish c (\ x -> trans (value x.1) (h (coordinate x.1) x.2))) ;
  result (t : R.R) : Id R.R (g t) R.z =
   trans (ap g (sym (AS.coords-point (suc zero) (\ i -> t) x0)))
    (trans (sym (value (AS.point (suc zero) (\ i -> t))))
     (trans (ap (AS.point (suc zero) (\ i -> t)).1.1 zero-c) (RingHom[l].zero A.ring R (AS.point (suc zero) (\ i -> t)).1))) ;
 } ;

 module Space (m : Nat) {
  n : Nat = suc m ;
  module Q2 = ProjectiveQuotient[l].Over[R,setR,n] ;
  module PS = PuncturedSpace[l].Over[R,setR,sqc,m] ;
  Pn : U l = Q2.Pn ;
  module Function (f : Pn -> R.R) {
   phi (x : Q2.Point) : R.R = f (Q2.class x) ;
   psi : Q2.V -> R.R = PS.extend phi ;
   on-points (x : Q2.Point) : Id R.R (psi x.1) (phi x) = PS.extend-restrict phi x ;
   module Along (x : Q2.Point) {
    g (t : R.R) : R.R = R.add (psi (Q2.scale t x.1)) (R.neg (psi x.1)) ;
    invariant (u : R.R) (hu : RL[R].unit u) : Id R.R (g u) R.z =
     trans (ap (\ v -> R.add v (R.neg (psi x.1)))
       (trans (on-points (Q2.scale u x.1,Q2.nonzero-scale (u,hu) x.1 x.2))
        (trans (ap f (sym (Q2.Q.relates x (Q2.scale u x.1,Q2.nonzero-scale (u,hu) x.1 x.2) ((u,hu),refl (Q2.scale u x.1)))))
         (sym (on-points x)))))
      (R.addN (psi x.1)) ;
    origin : Id R.R (psi (Q2.scale R.z x.1)) (psi x.1) = RR.difference-zero _ _ (UnitZero[g,invariant].result R.z) ;
    zero-vector : Q2.V = \ i -> R.z ;
    scaled-zero : Id Q2.V (Q2.scale R.z x.1) zero-vector =
     Q2.vector-eq _ _ (\ i -> RL[R].zero-mul (x.1 i)) ;
    result : Id R.R (phi x) (psi zero-vector) =
     trans (sym (on-points x)) (trans (sym origin) (ap psi scaled-zero)) ;
   } ;
   value : R.R = psi (\ i -> R.z) ;
   constant-value (q : Pn) : Id R.R (f q) value =
    Q2.Q.induction @l (\ q -> Id R.R (f q) value) (\ q -> setR (f q) value) (\ x -> Along[x].result) q ;
  } ;
  constant (f : Pn -> R.R) (q q' : Pn) : Id R.R (f q) (f q') =
   trans (Function[f].constant-value q) (sym (Function[f].constant-value q')) ;
 } ;
} ;
