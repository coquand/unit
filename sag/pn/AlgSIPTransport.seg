-- Transport of structure for NCAlgebra: for a construction F on algebras,
-- with values in U (l \/ j), acting on isomorphisms by equivalences Fmap
-- with Fmap (idIso A) = idEquiv, we have  ap_F (sip phi) = ua (Fmap phi).
-- By iso-induction it reduces to phi = idIso A, where both sides are refl
-- (sip-id, and ua idEquiv = refl from univalence).  This is how ap_RI is
-- computed in Prop 3.3.1 of sevb.pdf.
level l j ; open Base ;
module Pk = Prelude[l \/ j] ;
module Pk1 = Prelude[(l \/ j)+] ;
module UL = Axioms[l \/ j].UnivalenceLemmas[univ @(l \/ j)] ;
-- ua of the identity equivalence is refl
ua-id (X : U (l \/ j)) : Id (Id (U (l \/ j)) X X) (UL.ua X X (Pk.idEquiv X)) (refl X) =
 Pk1.sec-ret (Id (U (l \/ j)) X X) (Pk.Equiv X X) (Axioms[l \/ j].idtoeqv X X) (univ @(l \/ j) X X) (refl X) ;
module Over (R : Ring[l].CRing) (setR : Prelude[l].isSet R.R) {
 module S = AlgSIP[l].Over[R,setR] ; module SU = AlgSIPUA[l].Over[R,setR] ;
 module I = AlgSIPInd[l,j].Over[R,setR] ;
 module Fun (F : S.Alg -> U (l \/ j))
  (Fmap : (A B : S.Alg) -> S.AlgIso A B -> Pk.Equiv (F A) (F B))
  (Fid : (A : S.Alg) -> Id (Pk.Equiv (F A) (F A)) (Fmap A A (S.idIso A)) (Pk.idEquiv (F A))) {
  Goal (A B : S.Alg) (phi : S.AlgIso A B) : U (l \/ j)+ =
   Id (Id (U (l \/ j)) (F A) (F B)) (Pk1.ap S.Alg (U (l \/ j)) F A B (SU.sip A B phi)) (UL.ua (F A) (F B) (Fmap A B phi)) ;
  base (A : S.Alg) : Goal A A (S.idIso A) =
   Pk1.trans (Id (U (l \/ j)) (F A) (F A)) (Pk1.ap S.Alg (U (l \/ j)) F A A (SU.sip A A (S.idIso A))) (refl (F A))
    (UL.ua (F A) (F A) (Fmap A A (S.idIso A)))
    (Pk1.ap (Id S.Alg A A) (Id (U (l \/ j)) (F A) (F A)) (Pk1.ap S.Alg (U (l \/ j)) F A A)
      (SU.sip A A (S.idIso A)) (refl A) (SU.sip-id A))
    (Pk1.trans (Id (U (l \/ j)) (F A) (F A)) (refl (F A)) (UL.ua (F A) (F A) (Pk.idEquiv (F A)))
      (UL.ua (F A) (F A) (Fmap A A (S.idIso A)))
      (Pk1.sym (Id (U (l \/ j)) (F A) (F A)) (UL.ua (F A) (F A) (Pk.idEquiv (F A))) (refl (F A)) (ua-id (F A)))
      (Pk1.ap (Pk.Equiv (F A) (F A)) (Id (U (l \/ j)) (F A) (F A)) (UL.ua (F A) (F A))
        (Pk.idEquiv (F A)) (Fmap A A (S.idIso A))
        (Pk.sym (Pk.Equiv (F A) (F A)) (Fmap A A (S.idIso A)) (Pk.idEquiv (F A)) (Fid A)))) ;
  -- transport of structure
  theorem (A B : S.Alg) (phi : S.AlgIso A B) : Goal A B phi =
   I.iso-ind A (\ B1 phi1 -> Goal A B1 phi1) (base A) B phi ;
 } ;
} ;
