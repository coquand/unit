-- Decidable equality on Fin k and transpositions.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
Dec (A : U l) : U l = Plus A (Not A) ;
code (A B : U l) : Plus A B -> U l = split { inl a -> Top ; inr b -> Empty } ;
inl-inr (A B : U l) (a : A) (b : B) (p : Id (Plus A B) (inl a) (inr b)) : Empty =
 Pr.subst (Plus A B) (code A B) (inl a) (inr b) p tt ;
left (A B : U l) (d : A) : Plus A B -> A = split { inl a -> a ; inr b -> d } ;
inl-inj (A B : U l) (a a' : A) (p : Id (Plus A B) (inl a) (inl a')) : Id A a a' = ap (left A B a) p ;
top-eq : (t t' : Top) -> Id Top t t' = split { tt -> split { tt -> refl tt } } ;
lift-dec (k : Nat) (a b : Fin k) : Dec (Id (Fin k) a b) -> Dec (Id (Fin (suc k)) (inl a) (inl b)) = split {
 inl p -> inl (ap (\ c -> inl c) p) ;
 inr n -> inr (\ p -> n (inl-inj (Fin k) Top a b p)) } ;
deq : (k : Nat) (a b : Fin k) -> Dec (Id (Fin k) a b) = split {
 zero -> split { } ;
 suc k | ih -> split {
  inl a -> split {
   inl b -> lift-dec k a b (ih a b) ;
   inr t -> inr (\ p -> inl-inr (Fin k) Top a t p) } ;
  inr t -> split {
   inl b -> inr (\ p -> inl-inr (Fin k) Top b t (sym p)) ;
   inr t' -> inl (ap (\ s -> inr s) (top-eq t t')) } } } ;

-- swap u v exchanges u and v
module Swap (k : Nat) (u v : Fin k) {
 F : U l = Fin k ;
 second (w : F) : Dec (Id F w v) -> F = split { inl p -> u ; inr n -> w } ;
 first (w : F) : Dec (Id F w u) -> F = split { inl p -> v ; inr n -> second w (deq k w v) } ;
 swap (w : F) : F = first w (deq k w u) ;
 -- each case of the definition, as an equation
 at-u-dec : (d : Dec (Id F u u)) -> Id F (first u d) v = split {
  inl p -> refl v ; inr n -> efq (n (refl u)) } ;
 at-u : Id F (swap u) v = at-u-dec (deq k u u) ;
 at-v-second : (d : Dec (Id F v v)) -> Id F (second v d) u = split {
  inl p -> refl u ; inr n -> efq (n (refl v)) } ;
 at-v-dec : (d : Dec (Id F v u)) -> Id F (first v d) u = split {
  inl p -> p ;
  inr n -> at-v-second (deq k v v) } ;
 -- careful: if v = u then swap v = v = u
 at-v : Id F (swap v) u = at-v-dec (deq k v u) ;
 other-second (w : F) (nv : Not (Id F w v)) : (d : Dec (Id F w v)) -> Id F (second w d) w = split {
  inl p -> efq (nv p) ; inr n -> refl w } ;
 other-dec (w : F) (nu : Not (Id F w u)) (nv : Not (Id F w v)) : (d : Dec (Id F w u)) -> Id F (first w d) w = split {
  inl p -> efq (nu p) ; inr n -> other-second w nv (deq k w v) } ;
 other (w : F) (nu : Not (Id F w u)) (nv : Not (Id F w v)) : Id F (swap w) w = other-dec w nu nv (deq k w u) ;
 -- swap is an involution
 back-second (w : F) (nu : Not (Id F w u)) : (d : Dec (Id F w v)) -> Id F (swap (second w d)) w = split {
  inl p -> trans at-u (sym p) ;
  inr n -> other w nu n } ;
 back-dec (w : F) : (d : Dec (Id F w u)) -> Id F (swap (first w d)) w = split {
  inl p -> trans at-v (sym p) ;
  inr n -> back-second w n (deq k w v) } ;
 involution (w : F) : Id F (swap (swap w)) w = back-dec w (deq k w u) ;
} ;
