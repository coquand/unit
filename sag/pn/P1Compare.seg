-- The two-chart P^1 (Projective.Line) and the quotient P^1 (ProjectiveQuotient
-- at n = 1) are equivalent, by the line through e_X and e_Y (LineMaps):
--   [a:1] |-> [a e_X + e_Y] = [a:1],   [1:b] |-> [e_X + b e_Y] = [1:b].
-- Injective: a unit c with c (a,1) = (b,1), c (a,1) = (1,b), .. gives the
-- relation of the charts (c = 1 and a = b, or c = b and a b = c a = 1, ..).
-- Surjective: [v] = [1 : v_Y/v_X] if v_X is a unit, [v_X/v_Y : 1] if v_Y is.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (sqc : Presentations[l].Over[R,setR].SQC) (loc : StandardOpens[l].Over[R,setR].Locality) {
 open R ; open RL[R] ;
 module LM = LineMaps[l].Over[R,setR,suc zero,sqc,loc] ;
 module Q2 = LM.Q2 ;
 module P = LM.P ;
 I : U l = Q2.I ;
 V : U l = Q2.V ;
 Pn : U l = Q2.Pn ;
 iX : I = inr tt ;
 iY : I = inl (inr tt) ;
 elim-empty (A : U l) : Empty -> A = split { } ;
 top-elim (Q : Top -> U l) (h : Q tt) : (t : Top) -> Q t = split { tt -> h } ;
 low (Q : I -> U l) (hY : Q iY) : (j : Fin (suc zero)) -> Q (inl j) = split {
  inl e -> elim-empty (Q (inl (inl e))) e ;
  inr t -> top-elim (\ t -> Q (inl (inr t))) hY t } ;
 cases (Q : I -> U l) (hX : Q iX) (hY : Q iY) : (i : I) -> Q i = split {
  inr t -> top-elim (\ t -> Q (inr t)) hX t ;
  inl j -> low Q hY j } ;
 coord (x y : V) (e : Id V x y) (i : I) : Id R.R (x i) (y i) = Pr.happly I (\ j -> R.R) x y e i ;

 -- the two points and the line through them
 eX : V = split { inr t -> o ; inl j -> z } ;
 eY : V = split { inr t -> z ; inl j -> o } ;
 one-unit : unit o = (o,mulO o) ;
 pX : Q2.Point = (eX,Tr.Trunc[Q2.Pivots eX].inc (iX,one-unit)) ;
 pY : Q2.Point = (eY,Tr.Trunc[Q2.Pivots eY].inc (iY,one-unit)) ;
 ne : LM.Apart pX pY = \ e ->
  loc.1 (trans (sym (Q2.Q.effective pX pY e).1.2.2)
   (trans (ap (\ t -> mul t (Q2.Q.effective pX pY e).1.2.1)
     (trans (sym (mulO (Q2.Q.effective pX pY e).1.1)) (coord _ _ (Q2.Q.effective pX pY e).2 iX)))
    (zero-mul (Q2.Q.effective pX pY e).1.2.1))) ;
 module L = LM.Line[pX,pY,ne] ;
 map (p : P.P1) : Pn = L.map p ;

 -- coordinates of the chart vectors
 lxX (a : R.R) : Id R.R (LM.lo-vec a eX eY iX) a = trans (addZ (mul a o)) (mulO a) ;
 lyY (a : R.R) : Id R.R (LM.lo-vec a eX eY iY) o = trans (ap (\ u -> add u o) (mul-zero a)) (zl o) ;
 hxX (b : R.R) : Id R.R (LM.hi-vec b eX eY iX) o = trans (ap (add o) (mul-zero b)) (addZ o) ;
 hyY (b : R.R) : Id R.R (LM.hi-vec b eX eY iY) b = trans (zl (mul b o)) (mulO b) ;

 -- injectivity
 unit-eq (c v w t : R.R) (h : Id R.R (mul c v) w) (hv : Id R.R v o) (hw : Id R.R w t) : Id R.R c t =
  trans (sym (mulO c)) (trans (ap (mul c) (sym hv)) (trans h hw)) ;
 scaled-eq (c v w a t : R.R) (h : Id R.R (mul c v) w) (hv : Id R.R v a) (hw : Id R.R w t) : Id R.R (mul c a) t =
  trans (ap (mul c) (sym hv)) (trans h hw) ;
 -- c = 1 and c a = b give a = b;  c = b and c a = 1 give a b = 1
 equal (c a b : R.R) (c1 : Id R.R c o) (ca : Id R.R (mul c a) b) : Id R.R a b =
  trans (sym (one-left a)) (trans (ap (\ t -> mul t a) (sym c1)) ca) ;
 inverse (c a b : R.R) (cb : Id R.R c b) (ca : Id R.R (mul c a) o) : Id R.R (mul a b) o =
  trans (ap (mul a) (sym cb)) (trans (mulC a c) ca) ;
 chart-rel : (c d : P.C) -> Q2.Related (L.vec c) (L.vec d) -> P.relation c d = split {
  lo a -> split {
   lo b -> \ r -> equal r.1.1 a b
     (unit-eq r.1.1 _ _ o (coord _ _ r.2 iY) (lyY a) (lyY b))
     (scaled-eq r.1.1 _ _ a b (coord _ _ r.2 iX) (lxX a) (lxX b)) ;
   hi b -> \ r -> inverse r.1.1 a b
     (unit-eq r.1.1 _ _ b (coord _ _ r.2 iY) (lyY a) (hyY b))
     (scaled-eq r.1.1 _ _ a o (coord _ _ r.2 iX) (lxX a) (hxX b)) } ;
  hi a -> split {
   lo b -> \ r -> inverse r.1.1 a b
     (unit-eq r.1.1 _ _ b (coord _ _ r.2 iX) (hxX a) (lxX b))
     (scaled-eq r.1.1 _ _ a o (coord _ _ r.2 iY) (hyY a) (lyY b)) ;
   hi b -> \ r -> equal r.1.1 a b
     (unit-eq r.1.1 _ _ o (coord _ _ r.2 iX) (hxX a) (hxX b))
     (scaled-eq r.1.1 _ _ a b (coord _ _ r.2 iY) (hyY a) (hyY b)) } } ;
 Injects (p q : P.P1) : U l = Id Pn (map p) (map q) -> Id P.P1 p q ;
 injects-prop (p q : P.P1) : Pr.isProp (Injects p q) =
  F.isProp-Pi (Id Pn (map p) (map q)) (\ e -> Id P.P1 p q) (\ e -> P.Q.set p q) ;
 on-charts (c d : P.C) : Injects (P.point c) (P.point d) = \ e ->
  P.Q.relates c d (chart-rel c d
   (Q2.Q.effective (L.vec c) (L.vec d) (trans (sym (L.beta c)) (trans e (L.beta d))))) ;
 injective (p q : P.P1) : Injects p q =
  P.Q.induction @l (\ p' -> (q' : P.P1) -> Injects p' q')
   (\ p' -> F.isProp-Pi P.P1 (\ q' -> Injects p' q') (\ q' -> injects-prop p' q'))
   (\ c -> \ q' -> P.Q.induction @l (\ q'' -> Injects (P.point c) q'') (\ q'' -> injects-prop (P.point c) q'')
     (\ d -> on-charts c d) q') p q ;

 -- surjectivity
 module SE = SurjectiveEmbedding[l].Map[P.P1,Pn,Q2.Q.set,map,injective] ;
 module Cover (v : Q2.Point) {
  vX : R.R = v.1 iX ;
  vY : R.R = v.1 iY ;
  fibre (c : P.C) (rel : Q2.Related (L.vec c) v) : SE.Fibre (Q2.class v) =
   (P.point c,trans (L.beta c) (Q2.Q.relates (L.vec c) v rel)) ;
  -- v_X a unit with inverse w: v = v_X (1, v_Y w)
  from-X (h : unit vX) : SE.Fibre (Q2.class v) =
   fibre (hi (mul vY h.1)) ((vX,h),Q2.vector-eq _ _ (cases (\ i -> Id R.R (mul vX (LM.hi-vec (mul vY h.1) eX eY i)) (v.1 i))
    (trans (ap (mul vX) (hxX (mul vY h.1))) (mulO vX))
    (calc R.R {
      mul vX (LM.hi-vec (mul vY h.1) eX eY iY) =< ap (mul vX) (hyY (mul vY h.1)) > mul vX (mul vY h.1)
       =< ap (mul vX) (mulC vY h.1) > mul vX (mul h.1 vY)
       =< mulA vX h.1 vY > mul (mul vX h.1) vY
       =< ap (\ t -> mul t vY) h.2 > mul o vY
       =< one-left vY > vY }))) ;
  -- v_Y a unit with inverse w: v = v_Y (v_X w, 1)
  from-Y (h : unit vY) : SE.Fibre (Q2.class v) =
   fibre (lo (mul vX h.1)) ((vY,h),Q2.vector-eq _ _ (cases (\ i -> Id R.R (mul vY (LM.lo-vec (mul vX h.1) eX eY i)) (v.1 i))
    (calc R.R {
      mul vY (LM.lo-vec (mul vX h.1) eX eY iX) =< ap (mul vY) (lxX (mul vX h.1)) > mul vY (mul vX h.1)
       =< ap (mul vY) (mulC vX h.1) > mul vY (mul h.1 vX)
       =< mulA vY h.1 vX > mul (mul vY h.1) vX
       =< ap (\ t -> mul t vX) h.2 > mul o vX
       =< one-left vX > vX })
    (trans (ap (mul vY) (lyY (mul vX h.1))) (mulO vY)))) ;
  at : (i : I) -> unit (v.1 i) -> SE.Fibre (Q2.class v) =
   cases (\ i -> unit (v.1 i) -> SE.Fibre (Q2.class v)) from-X from-Y ;
  result : Tr.Trunc[SE.Fibre (Q2.class v)].carrier =
   Tr.Trunc[Q2.Pivots v.1].induction @l (\ t -> Tr.Trunc[SE.Fibre (Q2.class v)].carrier)
    (\ t -> Tr.Trunc[SE.Fibre (Q2.class v)].proposition)
    (\ p -> Tr.Trunc[SE.Fibre (Q2.class v)].inc (at p.1 p.2)) v.2 ;
 } ;
 cover (q : Pn) : Tr.Trunc[SE.Fibre q].carrier =
  Q2.Q.induction @l (\ q' -> Tr.Trunc[SE.Fibre q'].carrier) (\ q' -> Tr.Trunc[SE.Fibre q'].proposition)
   (\ v -> Cover[v].result) q ;
 equivalence : Pr.Equiv P.P1 Pn = SE.Surjective[cover].equivalence ;
} ;
