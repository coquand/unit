-- Lemma 7.2 and Theorem 7.3 of projective.pdf, for P^n with n = m+2 >= 2.
-- Lemma 7.2: along the line P^1 -> P^n through two points, (a,d) |-> a (x) O(d)
--   is the classification of Proposition 4.6, hence an equivalence.
-- Theorem 7.3: Line x Z -> (P^n -> Line), (a,d) |-> (x |-> a (x) O(d)(x)),
--   is an equivalence.  The inverse takes the value at [e_Z] and the degree
--   on the line through [e_Y], [e_Z]; L and a (x) O(d) then agree on that line,
--   so they are merely equal (LineAgreement), and an equality is fixed by
--   its value at one point, since maps P^n -> R^* are constant (Prop. 1.7).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (m : Nat)
 (sag : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 open R ; open RL[R] ;
 module LA = LineAgreement[l].Over[R,setR,m,sag] ;
 module TW = Twist[l].Over[R,setR,LA.n,sag.sqc,sag.loc] ;
 module LM = LA.LM ;
 module Q2 = LM.Q2 ;
 module P = LM.P ;
 module G = LM.G ;
 module L = LA.L ;
 module W = LA.W ;
 module C = LA.C ;
 module PF = ProjectiveFunctions[l].Over[R,setR,sag.sqc].Space[suc m] ;
 Degree : U l = LA.Degree ;
 Pn : U l = Q2.Pn ;
 Bundle : U l = Pn -> L.Line ;
 Bundle1 : U l = P.P1 -> L.Line ;

 -- Lemma 7.2
 module Lemma72 (x y : Q2.Point) (ne : LM.Apart x y) {
  restricted (w : L.Line * Degree) (q : P.P1) : L.Line = L.tensor w.1 (TW.O w.2 (LM.Line[x,y,ne].map q)) ;
  same : Id ((L.Line * Degree) -> Bundle1) restricted (\ w -> W.classify w.1 w.2) =
   F.funext (L.Line * Degree) (\ w -> Bundle1) restricted (\ w -> W.classify w.1 w.2) (\ w ->
    F.funext P.P1 (\ q -> L.Line) (restricted w) (W.classify w.1 w.2) (\ q ->
     Pr.ap L.Line L.Line (L.tensor w.1) _ _ (TW.Restrict[w.2,x,y,ne].restrict q))) ;
  lemma-7-2 : Pr.isEquiv (L.Line * Degree) Bundle1 restricted =
   Pr.subst ((L.Line * Degree) -> Bundle1) (Pr.isEquiv (L.Line * Degree) Bundle1)
    (\ w -> W.classify w.1 w.2) restricted (sym same) LA.PC.proposition-4-6 ;
 } ;

 -- Theorem 7.3
 classify (w : L.Line * Degree) (x : Pn) : L.Line = L.tensor w.1 (TW.O w.2 x) ;
 ne0 : LM.Apart LA.TP.pY LA.TP.pZ = LA.apart-of LA.cY LA.cZ LA.ne-yz LA.t0 ;
 origin : Pn = LA.standard LM.o1 ;
 on-standard (w : L.Line * Degree) : Id Bundle1 (\ q -> classify w (LA.standard q)) (W.classify w.1 w.2) =
  Pr.happly (L.Line * Degree) (\ v -> Bundle1) _ _ Lemma72[LA.TP.pY,LA.TP.pZ,ne0].same w ;
 degree (B : Bundle) : Degree = C.degree (\ q -> B (LA.standard q)) ;
 inverse (B : Bundle) : L.Line * Degree = (B origin,degree B) ;
 at-origin (w : L.Line * Degree) : Id L.Line (classify w origin) w.1 =
  L.tensor-pointed w.1 (TW.O w.2 origin) (TW.Restrict[w.2,LA.TP.pY,LA.TP.pZ,ne0].at-o1) ;
 degree-classify (w : L.Line * Degree) : Id Degree (degree (classify w)) w.2 =
  trans (Pr.ap Bundle1 Degree C.degree _ _ (on-standard w)) (C.degree-classify w.1 w.2) ;
 ret (w : L.Line * Degree) : Id (L.Line * Degree) (inverse (classify w)) w =
  trans (Pr.ap L.Line (L.Line * Degree) (\ a -> (a,degree (classify w))) (classify w origin) w.1 (at-origin w))
   (Pr.ap Degree (L.Line * Degree) (\ d -> (w.1,d)) (degree (classify w)) w.2 (degree-classify w)) ;
 -- L and its classification agree on the standard line
 agree (B : Bundle) : LA.Agreement[classify (inverse B),B].Agree LA.standard =
  Tr.Trunc[Id Bundle1 (W.classify (B origin) (degree B)) (\ q -> B (LA.standard q))].induction @l
   (\ u -> LA.Agreement[classify (inverse B),B].Agree LA.standard)
   (\ u -> Tr.Trunc[Id Bundle1 (\ q -> classify (inverse B) (LA.standard q)) (\ q -> B (LA.standard q))].proposition)
   (\ e -> Tr.Trunc[Id Bundle1 (\ q -> classify (inverse B) (LA.standard q)) (\ q -> B (LA.standard q))].inc
     (trans (on-standard (inverse B)) e))
   (C.comparison (\ q -> B (LA.standard q))) ;
 -- an equality of merely equal bundles is fixed by its value at the origin
 unit-constant (f : Pn -> G.Unit) (x : Pn) : Id G.Unit (f x) (f origin) =
  G.eq (f x) (f origin) (PF.constant (\ q -> (f q).1) x origin) ;
 module Sec = TorsorSections[l].Over[G.group,Pn,origin,unit-constant] ;
 module Ident (B D : Bundle) (same : Tr.Trunc[Id Bundle B D].carrier) {
  inhabit : Tr.Trunc[(x : Pn) -> Id L.Line (B x) (D x)].carrier =
   Tr.Trunc[Id Bundle B D].induction @l (\ u -> Tr.Trunc[(x : Pn) -> Id L.Line (B x) (D x)].carrier)
    (\ u -> Tr.Trunc[(x : Pn) -> Id L.Line (B x) (D x)].proposition)
    (\ e -> Tr.Trunc[(x : Pn) -> Id L.Line (B x) (D x)].inc (Pr.happly Pn (\ x -> L.Line) B D e)) same ;
  module T = Sec.At[\ x -> LA.GP.PTor (B x) (D x),inhabit] ;
  from-origin (e : Id L.Line (B origin) (D origin)) : Id Bundle B D =
   F.funext Pn (\ x -> L.Line) B D (T.equivalence.2.sec e) ;
 } ;
 sec (B : Bundle) : Id Bundle (classify (inverse B)) B =
  Ident[classify (inverse B),B,LA.agree-on-line (classify (inverse B)) B (agree B)].from-origin (at-origin (inverse B)) ;
 theorem-7-3 : Pr.isEquiv (L.Line * Degree) Bundle classify = Pr.qinv (L.Line * Degree) Bundle classify inverse sec ret ;
 equivalence : Pr.Equiv (L.Line * Degree) Bundle = (classify,theorem-7-3) ;
} ;
