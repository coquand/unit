-- With Loc and SQC (SAG 2.2.3(b)), "some coordinate is invertible" is
-- x /= 0, so the points of ProjectiveQuotient are exactly R^{n+1} \ {0}.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (n : Nat)
 (sqc : Presentations[l].Over[R,setR].SQC) (loc : StandardOpens[l].Over[R,setR].Locality) {
 module Q2 = ProjectiveQuotient[l].Over[R,setR,n] ;
 module U23 = Units23[l].Over[R,setR,sqc,loc] ;
 module CP = ClosedProp[l].Over[R,setR] ;
 V : U l = Q2.V ;
 Nonzero (x : V) : U l = CP.Zeros (suc n) x -> Empty ;
 nonzero-prop (x : V) : Pr.isProp (Nonzero x) =
  F.isProp-Pi (CP.Zeros (suc n) x) (\ h -> Empty) (\ h -> \ a b -> efq a) ;
 Removed : U l = (x : V) * Nonzero x ;
 to (x : Removed) : Q2.Point = (x.1,U23.nonzero-unit (suc n) x.1 x.2) ;
 from (x : Q2.Point) : Removed = (x.1,U23.unit-nonzero (suc n) x.1 x.2) ;
 points : Pr.Equiv Removed Q2.Point =
  (to,Pr.qinv Removed Q2.Point to from (\ x -> Q2.point-eq (to (from x)) x (refl x.1))
   (\ x -> Pr.Sigma-eq V Nonzero x.1 x.1 (from (to x)).2 x.2 (refl x.1) (nonzero-prop x.1))) ;
} ;
