-- Lemma 7.1 of projective.pdf, n >= 2.  For p /= q in P^n, every function
--   (iv) P^n \ {p,q} -> R,  (iii) P^n \ {p} -> R,
--   (ii) P^n \ {p,q} -> Z,  (i)   P^n \ {p} -> Z
-- is constant.  (iv): move p, q to [e_Y], [e_Z] (TwoPoints) and use
-- NormalPair.  (iii): for p = [e_Y], every x /= p is apart from [e_Z] or
-- from [e_X], so (iv) for these two pairs, which share the point
-- [e_X + e_Z], gives one constant.  (i), (ii): Z has decidable equality and
-- 1 /= 0, so the indicator of a value is an R-valued function.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (m : Nat)
 (sqc : Presentations[l].Over[R,setR].SQC) (loc : StandardOpens[l].Over[R,setR].Locality) {
 open R ; open RL[R] ;
 module NP = NormalPair[l].Over[R,setR,m,sqc,loc] ;
 module TP = NP.TP ;
 module Q2 = TP.Q2 ;
 module L = TP.L ;
 module FS = FinSwap[l] ;
 I : U l = TP.I ;
 V : U l = TP.V ;
 Pn : U l = Q2.Pn ;
 cY : Pn = Q2.class TP.pY ;
 cZ : Pn = Q2.class TP.pZ ;
 Apart (p q : Pn) : U l = Not (Id Pn p q) ;
 apart-prop (p q : Pn) : Pr.isProp (Apart p q) = \ a b -> F.funext (Id Pn p q) (\ e -> Empty) a b (\ e -> efq (a e)) ;
 Minus1 (p : Pn) : U l = (x : Pn) * Apart x p ;
 Minus2 (p q : Pn) : U l = (x : Pn) * Apart x p * Apart x q ;
 minus1-eq (p : Pn) (a b : Minus1 p) (h : Id Pn a.1 b.1) : Id (Minus1 p) a b =
  Pr.Sigma-eq Pn (\ x -> Apart x p) a.1 b.1 a.2 b.2 h (apart-prop b.1 p) ;
 minus2-eq (p q : Pn) (a b : Minus2 p q) (h : Id Pn a.1 b.1) : Id (Minus2 p q) a b =
  Pr.Sigma-eq Pn (\ x -> Apart x p * Apart x q) a.1 b.1 a.2 b.2 h
   (Pr.isProp-Sigma (Apart b.1 p) (\ e -> Apart b.1 q) (apart-prop b.1 p) (\ e -> apart-prop b.1 q)) ;
 AllConstant (W : U l) : U l = (f : W -> R.R) (w w' : W) -> Id R.R (f w) (f w') ;

 -- normal form of two distinct points
 NormalForm (p q : Pn) : U l = (T : L.Auto) * Id Pn (L.Act[T].map p) cY * Id Pn (L.Act[T].map q) cZ ;
 module Build (x y : Q2.Point) (pv : Q2.Pivots x.1) (bm : (b : I) * unit (TP.minor x.1 y.1 pv.1 b)) {
  a : I = pv.1 ;
  b : I = bm.1 ;
  module MV = TP.Move[a,b,TP.distinct x.1 y.1 a b bm.2] ;
  x' : V = MV.P.1 x.1 ;
  y' : V = MV.P.1 y.1 ;
  same : Id R.R (TP.minor x.1 y.1 a b) (TP.minor x' y' TP.iY TP.iZ) =
   sym (trans (ap (\ i -> TP.minor x.1 y.1 i (MV.SB.swap (MV.SA.swap TP.iZ))) MV.at-y) (ap (TP.minor x.1 y.1 a) MV.at-z)) ;
  module G = TP.Normalise[x',y',NP.unit-subst same bm.2] ;
  T : L.Auto = L.compose G.auto MV.P ;
  at-x : Id Pn (L.Act[T].map (Q2.class x)) cY =
   trans (L.Act[T].beta x) (ap Q2.class (Q2.point-eq (L.Act[T].point x) TP.pY G.g-x)) ;
  at-y : Id Pn (L.Act[T].map (Q2.class y)) cZ =
   trans (L.Act[T].beta y) (ap Q2.class (Q2.point-eq (L.Act[T].point y) TP.pZ G.g-y)) ;
  result : NormalForm (Q2.class x) (Q2.class y) = (T,at-x,at-y) ;
 } ;
 normal-form-points (x y : Q2.Point) (ne : Apart (Q2.class x) (Q2.class y)) :
  Tr.Trunc[NormalForm (Q2.class x) (Q2.class y)].carrier =
  Tr.Trunc[Q2.Pivots x.1].induction @l (\ t -> Tr.Trunc[NormalForm (Q2.class x) (Q2.class y)].carrier)
   (\ t -> Tr.Trunc[NormalForm (Q2.class x) (Q2.class y)].proposition)
   (\ pv -> Tr.Trunc[(b : I) * unit (TP.minor x.1 y.1 pv.1 b)].induction @l
     (\ t -> Tr.Trunc[NormalForm (Q2.class x) (Q2.class y)].carrier)
     (\ t -> Tr.Trunc[NormalForm (Q2.class x) (Q2.class y)].proposition)
     (\ bm -> Tr.Trunc[NormalForm (Q2.class x) (Q2.class y)].inc Build[x,y,pv,bm].result)
     TP.Apart[x,y,ne,pv].result)
   x.2 ;
 normal-form (p q : Pn) (ne : Apart p q) : Tr.Trunc[NormalForm p q].carrier =
  Q2.Q.induction @l (\ p -> (q : Pn) -> Apart p q -> Tr.Trunc[NormalForm p q].carrier)
   (\ p -> F.isProp-Pi Pn (\ q -> Apart p q -> Tr.Trunc[NormalForm p q].carrier)
     (\ q -> F.isProp-Pi (Apart p q) (\ e -> Tr.Trunc[NormalForm p q].carrier) (\ e -> Tr.Trunc[NormalForm p q].proposition)))
   (\ x -> Q2.Q.induction @l (\ q -> Apart (Q2.class x) q -> Tr.Trunc[NormalForm (Q2.class x) q].carrier)
     (\ q -> F.isProp-Pi (Apart (Q2.class x) q) (\ e -> Tr.Trunc[NormalForm (Q2.class x) q].carrier)
       (\ e -> Tr.Trunc[NormalForm (Q2.class x) q].proposition))
     (\ y -> normal-form-points x y))
   p q ne ;

 -- moving along an automorphism T with T p = r
 module Move1 (p r : Pn) (T : L.Auto) (hp : Id Pn (L.Act[T].map p) r) {
  map (x : Pn) : Pn = L.Act[T].map x ;
  unmap (x : Pn) : Pn = L.Act[L.inverse T].map x ;
  away (x : Pn) (n : Apart x p) : Apart (map x) r = \ e -> n (L.injective T x p (trans e (sym hp))) ;
  away-back (x : Pn) (n : Apart x r) : Apart (unmap x) p = \ e -> n (trans (sym (L.forth T x)) (trans (ap map e) hp)) ;
 } ;
 -- (iv)
 module Transport (p q : Pn) (nf : NormalForm p q) {
  module MP = Move1[p,cY,nf.1,nf.2.1] ;
  module MQ = Move1[q,cZ,nf.1,nf.2.2] ;
  forward (w : Minus2 p q) : NP.W = (MP.map w.1,MP.away w.1 w.2.1,MQ.away w.1 w.2.2) ;
  backward (w : NP.W) : Minus2 p q = (MP.unmap w.1,MP.away-back w.1 w.2.1,MQ.away-back w.1 w.2.2) ;
  bf (w : Minus2 p q) : Id (Minus2 p q) (backward (forward w)) w = minus2-eq p q _ w (L.back nf.1 w.1) ;
  constant (f : Minus2 p q -> R.R) (w w' : Minus2 p q) : Id R.R (f w) (f w') =
   trans (ap f (sym (bf w)))
    (trans (NP.constant (\ v -> f (backward v)) (forward w) (forward w')) (ap f (bf w'))) ;
 } ;
 lemma-iv (p q : Pn) (ne : Apart p q) : AllConstant (Minus2 p q) = \ f w w' ->
  Tr.Trunc[NormalForm p q].induction @l (\ t -> Id R.R (f w) (f w')) (\ t -> setR (f w) (f w'))
   (\ nf -> Transport[p,q,nf].constant f w w') (normal-form p q ne) ;

 -- (iii), first at [e_Y]
 one-unit : unit o = TP.one-unit ;
 eX : V = TP.build o z z (\ j -> z) ;
 eXZ : V = TP.build o z o (\ j -> z) ;
 pX : Q2.Point = (eX,Tr.Trunc[Q2.Pivots eX].inc (TP.iX,one-unit)) ;
 pXZ : Q2.Point = (eXZ,Tr.Trunc[Q2.Pivots eXZ].inc (TP.iX,one-unit)) ;
 cX : Pn = Q2.class pX ;
 r : Pn = Q2.class pXZ ;
 r-y : Apart r cY = NP.apart-coord pXZ TP.pY TP.iX one-unit (refl z) ;
 r-z : Apart r cZ = NP.apart-coord pXZ TP.pZ TP.iX one-unit (refl z) ;
 r-x : Apart r cX = NP.apart-coord pXZ pX TP.iZ one-unit (refl z) ;
 y-x : Apart cY cX = NP.apart-coord TP.pY pX TP.iY one-unit (refl z) ;
 z-other : (a : I) -> Not (Id I a TP.iZ) -> Id R.R (TP.eZ a) z =
  TP.cases (\ a -> Not (Id I a TP.iZ) -> Id R.R (TP.eZ a) z)
   (\ n -> refl z) (\ n -> refl z) (\ n -> efq (n (refl TP.iZ))) (\ j n -> refl z) ;
 y-other : (a : I) -> Not (Id I a TP.iY) -> Id R.R (TP.eY a) z =
  TP.cases (\ a -> Not (Id I a TP.iY) -> Id R.R (TP.eY a) z)
   (\ n -> refl z) (\ n -> efq (n (refl TP.iY))) (\ n -> refl z) (\ j n -> refl z) ;
 Either (x : Q2.Point) : U l = Plus (Apart (Q2.class x) cZ) (Apart (Q2.class x) cX) ;
 choose (x : Q2.Point) (pv : Q2.Pivots x.1) : FS.Dec (Id I pv.1 TP.iZ) -> Either x = split {
  inl e -> inr (NP.apart-coord x pX TP.iZ (NP.unit-subst (ap x.1 e) pv.2) (refl z)) ;
  inr n -> inl (NP.apart-coord x TP.pZ pv.1 pv.2 (z-other pv.1 n)) } ;
 module AtY (f : Minus1 cY -> R.R) {
  f1 (w : NP.W) : R.R = f (w.1,w.2.1) ;
  f2 (w : Minus2 cY cX) : R.R = f (w.1,w.2.1) ;
  by-cases (x : Q2.Point) (ny : Apart (Q2.class x) cY) : Either x -> Id R.R (f (Q2.class x,ny)) (f (r,r-y)) = split {
   inl nz -> NP.constant f1 (Q2.class x,ny,nz) (r,r-y,r-z) ;
   inr nx -> lemma-iv cY cX y-x f2 (Q2.class x,ny,nx) (r,r-y,r-x) } ;
  at-class (x : Q2.Point) (ny : Apart (Q2.class x) cY) : Id R.R (f (Q2.class x,ny)) (f (r,r-y)) =
   Tr.Trunc[Q2.Pivots x.1].induction @l (\ t -> Id R.R (f (Q2.class x,ny)) (f (r,r-y))) (\ t -> setR _ _)
    (\ pv -> by-cases x ny (choose x pv (FS.deq (suc TP.n) pv.1 TP.iZ))) x.2 ;
  at (w : Minus1 cY) : Id R.R (f w) (f (r,r-y)) =
   Q2.Q.induction @l (\ q -> (n : Apart q cY) -> Id R.R (f (q,n)) (f (r,r-y)))
    (\ q -> F.isProp-Pi (Apart q cY) (\ n -> Id R.R (f (q,n)) (f (r,r-y))) (\ n -> setR _ _))
    at-class w.1 w.2 ;
 } ;
 -- an automorphism sending p to [e_Y]
 ToY (p : Pn) : U l = (T : L.Auto) * Id Pn (L.Act[T].map p) cY ;
 y-ne-z (e : Id I TP.iY TP.iZ) : Empty =
  FS.inl-inr (Fin (suc m)) Top (inr tt) tt (sym (FS.inl-inj (Fin (suc (suc m))) Top (inr tt) (inl (inr tt)) e)) ;
 to-y-pair (x : Q2.Point) (q : Pn) (ne : Apart (Q2.class x) q) : Tr.Trunc[ToY (Q2.class x)].carrier =
  Tr.Trunc[NormalForm (Q2.class x) q].induction @l (\ t -> Tr.Trunc[ToY (Q2.class x)].carrier)
   (\ t -> Tr.Trunc[ToY (Q2.class x)].proposition) (\ nf -> Tr.Trunc[ToY (Q2.class x)].inc (nf.1,nf.2.1))
   (normal-form (Q2.class x) q ne) ;
 to-y-from (x : Q2.Point) (pv : Q2.Pivots x.1) : FS.Dec (Id I pv.1 TP.iY) -> Tr.Trunc[ToY (Q2.class x)].carrier = split {
  inl e -> to-y-pair x cZ (NP.apart-coord x TP.pZ pv.1 pv.2 (z-other pv.1 (\ e' -> y-ne-z (trans (sym e) e')))) ;
  inr n -> to-y-pair x cY (NP.apart-coord x TP.pY pv.1 pv.2 (y-other pv.1 n)) } ;
 to-y (p : Pn) : Tr.Trunc[ToY p].carrier =
  Q2.Q.induction @l (\ p -> Tr.Trunc[ToY p].carrier) (\ p -> Tr.Trunc[ToY p].proposition)
   (\ x -> Tr.Trunc[Q2.Pivots x.1].induction @l (\ t -> Tr.Trunc[ToY (Q2.class x)].carrier)
     (\ t -> Tr.Trunc[ToY (Q2.class x)].proposition)
     (\ pv -> to-y-from x pv (FS.deq (suc TP.n) pv.1 TP.iY)) x.2) p ;
 module Transport1 (p : Pn) (ty : ToY p) {
  module MP = Move1[p,cY,ty.1,ty.2] ;
  forward (w : Minus1 p) : Minus1 cY = (MP.map w.1,MP.away w.1 w.2) ;
  backward (w : Minus1 cY) : Minus1 p = (MP.unmap w.1,MP.away-back w.1 w.2) ;
  bf (w : Minus1 p) : Id (Minus1 p) (backward (forward w)) w = minus1-eq p _ w (L.back ty.1 w.1) ;
  constant (f : Minus1 p -> R.R) (w w' : Minus1 p) : Id R.R (f w) (f w') =
   trans (ap f (sym (bf w)))
    (trans (trans (AtY[\ v -> f (backward v)].at (forward w)) (sym (AtY[\ v -> f (backward v)].at (forward w'))))
     (ap f (bf w'))) ;
 } ;
 lemma-iii (p : Pn) : AllConstant (Minus1 p) = \ f w w' ->
  Tr.Trunc[ToY p].induction @l (\ t -> Id R.R (f w) (f w')) (\ t -> setR (f w) (f w'))
   (\ ty -> Transport1[p,ty].constant f w w') (to-y p) ;

 -- (i), (ii): values in a type with decidable equality
 module Discrete (W : U l) (all : AllConstant W) (D : U l) (dec : (d e : D) -> FS.Dec (Id D d e)) (g : W -> D) (w : W) {
  sel (d e : D) : FS.Dec (Id D d e) -> R.R = split { inl p -> o ; inr n -> z } ;
  chi (x : W) : R.R = sel (g x) (g w) (dec (g x) (g w)) ;
  sel-yes (d : D) : (c : FS.Dec (Id D d d)) -> Id R.R (sel d d c) o = split { inl p -> refl o ; inr n -> efq (n (refl d)) } ;
  decide (x : W) : (c : FS.Dec (Id D (g x) (g w))) -> Id R.R (sel (g x) (g w) c) o -> Id D (g x) (g w) = split {
   inl p -> \ h -> p ; inr n -> \ h -> efq (loc.1 (sym h)) } ;
  result (x : W) : Id D (g x) (g w) =
   decide x (dec (g x) (g w)) (trans (all chi x w) (sel-yes (g w) (dec (g w) (g w)))) ;
 } ;
 module Z = PicardInterface[l] ;
 deq-suc (a b : Nat) : FS.Dec (Id Nat a b) -> FS.Dec (Id Nat (suc a) (suc b)) = split {
  inl e -> inl (ap (\ k -> suc k) e) ; inr n -> inr (\ e -> n (suc-inj e)) } ;
 deq-nat : (a b : Nat) -> FS.Dec (Id Nat a b) = split {
  zero -> split { zero -> inl (refl zero) ; suc b -> inr (\ e -> zero-suc b e) } ;
  suc a | ih -> split { zero -> inr (\ e -> suc-zero a e) ; suc b -> deq-suc a b (ih b) } } ;
 nonneg-of (d : Nat) : Z.Degree -> Nat = split { nonneg a -> a ; negative a -> d } ;
 negative-of (d : Nat) : Z.Degree -> Nat = split { nonneg a -> d ; negative a -> a } ;
 is-nonneg : Z.Degree -> U l = split { nonneg a -> Top ; negative a -> Empty } ;
 deq-nn (a b : Nat) : FS.Dec (Id Nat a b) -> FS.Dec (Id Z.Degree (nonneg a) (nonneg b)) = split {
  inl e -> inl (ap (\ k -> nonneg k) e) ; inr n -> inr (\ e -> n (ap (nonneg-of a) e)) } ;
 deq-ng (a b : Nat) : FS.Dec (Id Nat a b) -> FS.Dec (Id Z.Degree (negative a) (negative b)) = split {
  inl e -> inl (ap (\ k -> negative k) e) ; inr n -> inr (\ e -> n (ap (negative-of a) e)) } ;
 deq-degree : (d e : Z.Degree) -> FS.Dec (Id Z.Degree d e) = split {
  nonneg a -> split {
   nonneg b -> deq-nn a b (deq-nat a b) ;
   negative b -> inr (\ e -> Pr.subst Z.Degree is-nonneg _ _ e tt) } ;
  negative a -> split {
   nonneg b -> inr (\ e -> Pr.subst Z.Degree is-nonneg _ _ (sym e) tt) ;
   negative b -> deq-ng a b (deq-nat a b) } } ;
 lemma-ii (p q : Pn) (ne : Apart p q) (g : Minus2 p q -> Z.Degree) (w w' : Minus2 p q) : Id Z.Degree (g w) (g w') =
  Discrete[Minus2 p q,lemma-iv p q ne,Z.Degree,deq-degree,g,w'].result w ;
 lemma-i (p : Pn) (g : Minus1 p -> Z.Degree) (w w' : Minus1 p) : Id Z.Degree (g w) (g w') =
  Discrete[Minus1 p,lemma-iii p,Z.Degree,deq-degree,g,w'].result w ;
} ;
