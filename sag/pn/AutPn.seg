-- Aut(P^n) = PGL_{n+1}(R) for every n >= 1: the generic proof (AutPGL) at
-- the classification of line bundles of Theorem 7.3 (n = m+2 >= 2) and of
-- Theorem73One (n = 1).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (sag : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 -- n = m+2
 module Higher (m : Nat) {
  module A = AutPGL[l].Over[R,setR,suc m,sag,Theorem73[l].Over[R,setR,m,sag].theorem-7-3] ;
  corollary-5-6 : Pr.isEquiv A.PGL A.Aut A.aut-of = A.corollary-5-6 ;
 } ;
 -- n = 1
 module Line {
  module A = AutPGL[l].Over[R,setR,zero,sag,Theorem73One[l].Over[R,setR,sag].theorem] ;
  corollary-5-6 : Pr.isEquiv A.PGL A.Aut A.aut-of = A.corollary-5-6 ;
 } ;
} ;
