-- Projective space, Remark 1.1 (ii) of projective.pdf: nonzero vectors of
-- R^{n+1} modulo multiplication by units.  "Nonzero" means that some
-- coordinate is invertible; for the local ring of SAG this is x /= 0.
-- For nonzero vectors, x ~ y (y = u x, u a unit) is a proposition and is
-- equivalent to proportionality, x_i y_j = x_j y_i for all i, j.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (n : Nat) {
 open R ; open RL[R] ;
 module G = PicardUnits[l].Over[R,setR] ;
 I : U l = Fin (suc n) ;
 V : U l = I -> R.R ;
 setV : Pr.isSet V = F.isSet-Pi I (\ i -> R.R) (\ i -> setR) ;
 vector-eq (x y : V) (h : (i : I) -> Id R.R (x i) (y i)) : Id V x y = F.funext I (\ i -> R.R) x y h ;
 scale (a : R.R) (x : V) : V = \ i -> mul a (x i) ;
 scale-one (x : V) : Id V (scale o x) x = vector-eq _ _ (\ i -> trans (mulC o (x i)) (mulO (x i))) ;
 scale-scale (a b : R.R) (x : V) : Id V (scale a (scale b x)) (scale (mul a b) x) =
  vector-eq _ _ (\ i -> mulA a b (x i)) ;
 -- a c = b c with c a unit gives a = b
 cancel (a b c : R.R) (hc : unit c) (h : Id R.R (mul a c) (mul b c)) : Id R.R a b =
  calc R.R {
   a =< sym (mulO a) > mul a o
     =< ap (mul a) (sym hc.2) > mul a (mul c hc.1)
     =< mulA a c hc.1 > mul (mul a c) hc.1
     =< ap (\ t -> mul t hc.1) h > mul (mul b c) hc.1
     =< sym (mulA b c hc.1) > mul b (mul c hc.1)
     =< ap (mul b) hc.2 > mul b o
     =< mulO b > b } ;
 unit-mul (a b : R.R) (ha : unit a) (hb : unit b) : unit (mul a b) = (G.times (a,ha) (b,hb)).2 ;

 Pivots (x : V) : U l = (i : I) * unit (x i) ;
 NonZero (x : V) : U l = Tr.Trunc[Pivots x].carrier ;
 nonzero-scale (u : G.Unit) (x : V) (h : NonZero x) : NonZero (scale u.1 x) =
  Tr.Trunc[Pivots x].induction @l (\ t -> NonZero (scale u.1 x)) (\ t -> Tr.Trunc[Pivots (scale u.1 x)].proposition)
   (\ p -> Tr.Trunc[Pivots (scale u.1 x)].inc (p.1,unit-mul u.1 (x p.1) u.2 p.2)) h ;
 Point : U l = (x : V) * NonZero x ;
 point-eq (x y : Point) (h : Id V x.1 y.1) : Id Point x y =
  Pr.Sigma-eq V NonZero x.1 y.1 x.2 y.2 h Tr.Trunc[Pivots y.1].proposition ;

 -- the action of the units
 Related (x y : Point) : U l = (u : G.Unit) * Id V (scale u.1 x.1) y.1 ;
 -- the unit is determined by one invertible coordinate of x
 same-unit (x y : Point) (u v : Related x y) : Id R.R u.1.1 v.1.1 =
  Tr.Trunc[Pivots x.1].induction @l (\ t -> Id R.R u.1.1 v.1.1) (\ t -> setR u.1.1 v.1.1)
   (\ p -> cancel u.1.1 v.1.1 (x.1 p.1) p.2
     (trans (Pr.happly I (\ i -> R.R) _ _ u.2 p.1) (sym (Pr.happly I (\ i -> R.R) _ _ v.2 p.1)))) x.2 ;
 related-prop (x y : Point) : Pr.isProp (Related x y) = \ u v ->
  Pr.Sigma-eq G.Unit (\ w -> Id V (scale w.1 x.1) y.1) u.1 v.1 u.2 v.2
   (G.eq u.1 v.1 (same-unit x y u v)) (setV (scale v.1.1 x.1) y.1) ;
 related-refl (x : Point) : Related x x = (G.one,scale-one x.1) ;
 related-sym (x y : Point) (u : Related x y) : Related y x =
  (G.inverse u.1,
   trans (ap (scale u.1.2.1) (sym u.2))
    (trans (scale-scale u.1.2.1 u.1.1 x.1)
     (trans (ap (\ t -> scale t x.1) (G.inverse u.1).2.2) (scale-one x.1)))) ;
 related-trans (x y z : Point) (u : Related x y) (v : Related y z) : Related x z =
  (G.times v.1 u.1,
   trans (sym (scale-scale v.1.1 u.1.1 x.1)) (trans (ap (scale v.1.1) u.2) v.2)) ;

 module Q = Quotient[l].Quot[Point,Related,related-prop,related-refl,related-sym,related-trans] ;
 Pn : U l = Q.Q ;
 class (x : Point) : Pn = Q.inc x ;

 -- the relation is proportionality
 Proportional (x y : V) : U l = (i j : I) -> Id R.R (mul (x i) (y j)) (mul (x j) (y i)) ;
 related-proportional (x y : Point) (u : Related x y) : Proportional x.1 y.1 = \ i j ->
  calc R.R {
   mul (x.1 i) (y.1 j) =< ap (mul (x.1 i)) (sym (Pr.happly I (\ k -> R.R) _ _ u.2 j)) > mul (x.1 i) (mul u.1.1 (x.1 j))
    =< mulA (x.1 i) u.1.1 (x.1 j) > mul (mul (x.1 i) u.1.1) (x.1 j)
    =< mulC (mul (x.1 i) u.1.1) (x.1 j) > mul (x.1 j) (mul (x.1 i) u.1.1)
    =< ap (mul (x.1 j)) (mulC (x.1 i) u.1.1) > mul (x.1 j) (mul u.1.1 (x.1 i))
    =< ap (mul (x.1 j)) (Pr.happly I (\ k -> R.R) _ _ u.2 i) > mul (x.1 j) (y.1 i) } ;
 module FromProportional (x y : Point) (h : Proportional x.1 y.1) {
  -- with x_k invertible (inverse w), u = y_k w
  module At (p : Pivots x.1) {
   k : I = p.1 ;
   w : R.R = p.2.1 ;
   c : R.R = mul (y.1 k) w ;
   -- y_j = c x_j
   coordinate (j : I) : Id R.R (mul c (x.1 j)) (y.1 j) =
    calc R.R {
     mul (mul (y.1 k) w) (x.1 j) =< mulC (mul (y.1 k) w) (x.1 j) > mul (x.1 j) (mul (y.1 k) w)
      =< mulA (x.1 j) (y.1 k) w > mul (mul (x.1 j) (y.1 k)) w
      =< ap (\ t -> mul t w) (h j k) > mul (mul (x.1 k) (y.1 j)) w
      =< mulC (mul (x.1 k) (y.1 j)) w > mul w (mul (x.1 k) (y.1 j))
      =< mulA w (x.1 k) (y.1 j) > mul (mul w (x.1 k)) (y.1 j)
      =< ap (\ t -> mul t (y.1 j)) (trans (mulC w (x.1 k)) p.2.2) > mul o (y.1 j)
      =< trans (mulC o (y.1 j)) (mulO (y.1 j)) > y.1 j } ;
   -- c is a unit: c x_m = y_m with y_m invertible
   module Invertible (q : Pivots y.1) {
    m : I = q.1 ;
    inverse : R.R = mul (x.1 m) q.2.1 ;
    proof : Id R.R (mul c inverse) o =
     trans (mulA c (x.1 m) q.2.1) (trans (ap (\ t -> mul t q.2.1) (coordinate m)) q.2.2) ;
   } ;
   unit-c : unit c =
    Tr.Trunc[Pivots y.1].induction @l (\ t -> unit c) (\ t -> G.unit-prop c)
     (\ q -> (Invertible[q].inverse,Invertible[q].proof)) y.2 ;
   related : Related x y = ((c,unit-c),vector-eq _ _ coordinate) ;
  } ;
  related : Related x y =
   Tr.Trunc[Pivots x.1].induction @l (\ t -> Related x y) (\ t -> related-prop x y) (\ p -> At[p].related) x.2 ;
 } ;
} ;
