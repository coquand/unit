-- Two line bundles L1, L2 on P^n (n >= 2) that agree on one line are
-- merely equal.  For a point p, "L1 and L2 agree on every line through p
-- and x" is a proposition of x /= p; it is decidable (compare degrees on
-- P^1), so by Lemma 7.1 (i) it holds for all x once it holds for one.  On
-- lines through p an identification at p extends uniquely along the line
-- (maps P^1 -> R^* are constant), which identifies L1 and L2 on P^n \ {p}.
-- With a second point q the two identifications differ on P^n \ {p,q} by a
-- constant unit (Lemma 7.1 (iv)); corrected by it they glue on P^n.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (m : Nat)
 (sag : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 open R ; open RL[R] ;
 n : Nat = suc (suc m) ;
 module L71 = Lemma71[l].Over[R,setR,m,sag.sqc,sag.loc] ;
 module TP = L71.TP ;
 module LM = LineMaps[l].Over[R,setR,n,sag.sqc,sag.loc] ;
 module Q2 = LM.Q2 ;
 module P = LM.P ;
 module G = LM.G ;
 module L = PicardLines[l].Over[R,setR] ;
 module W = PicardTwists[l].Over[R,setR] ;
 module PC = PicardComplete[l].Over[R,setR,sag] ;
 module C = PC.Proof.Proof.C ;
 module Con = PicardConstant[l].Over[R,setR,ChartIntersection[l].Over[R,setR,sag.sqc].intersection] ;
 module GP = Gerbe[l].Gerbes[G.group].GL[L.K.KG] ;
 module Sec = TorsorSections[l].Over[G.group,P.P1,Con.origin,Con.unit-constant] ;
 module FS = FinSwap[l] ;
 Degree : U l = PicardInterface[l].Degree ;
 Pn : U l = Q2.Pn ;
 Bundle : U l = Pn -> L.Line ;
 Bundle1 : U l = P.P1 -> L.Line ;
 Apart (x y : Pn) : U l = L71.Apart x y ;
 o1 : P.P1 = LM.o1 ;
 i1 : P.P1 = LM.i1 ;
 -- on P^1, bundles of equal degree are merely equal
 same-degree (B D : Bundle1) (h : Id Degree (C.degree B) (C.degree D)) : Tr.Trunc[Id Bundle1 B D].carrier =
  TC.bind (Id Bundle1 (W.classify (B o1) (C.degree B)) B) (Id Bundle1 B D)
   (\ pb -> TC.map2 (Id Bundle1 (W.classify (D o1) (C.degree D)) D) (Id L.Line (B o1) (D o1)) (Id Bundle1 B D)
     (\ pd e -> trans (sym pb) (trans (trans (Pr.ap L.Line Bundle1 (\ a -> W.classify a (C.degree B)) (B o1) (D o1) e)
       (Pr.ap Degree Bundle1 (W.classify (D o1)) (C.degree B) (C.degree D) h)) pd))
     (C.comparison D) (L.K.k-conn (B o1) (D o1)))
   (C.comparison B) ;
 dec-prop (A : U l) (pA : Pr.isProp A) : (c d : FS.Dec A) -> Id (FS.Dec A) c d = split {
  inl a -> split { inl b -> ap (\ u -> inl u) (pA a b) ; inr nb -> efq (nb a) } ;
  inr na -> split { inl b -> efq (na b) ; inr nb -> ap (\ u -> inr u) (F.funext A (\ x -> Empty) na nb (\ x -> efq (na x))) } } ;
 sel (A : U l) : FS.Dec A -> Degree = split { inl a -> nonneg zero ; inr na -> negative zero } ;
 sel-yes (A : U l) : (c : FS.Dec A) -> Id Degree (sel A c) (nonneg zero) -> A = split {
  inl a -> \ h -> a ;
  inr na -> \ h -> efq (Pr.subst Degree L71.is-nonneg (nonneg zero) (negative zero) (sym h) tt) } ;
 sel-of (A : U l) (a : A) : (c : FS.Dec A) -> Id Degree (sel A c) (nonneg zero) = split {
  inl b -> refl (nonneg zero) ; inr na -> efq (na a) } ;
 -- representatives of two points
 Through (x p : Pn) : U l = (a : Q2.Point) * (b : Q2.Point) * Id Pn (Q2.class a) x * Id Pn (Q2.class b) p ;
 through (x p : Pn) : Tr.Trunc[Through x p].carrier =
  Q2.Q.induction @l (\ x' -> Tr.Trunc[Through x' p].carrier) (\ x' -> Tr.Trunc[Through x' p].proposition)
   (\ a -> Q2.Q.induction @l (\ p' -> Tr.Trunc[Through (Q2.class a) p'].carrier)
     (\ p' -> Tr.Trunc[Through (Q2.class a) p'].proposition)
     (\ b -> Tr.Trunc[Through (Q2.class a) (Q2.class b)].inc (a,b,refl (Q2.class a),refl (Q2.class b))) p) x ;
 apart-of (x p : Pn) (ne : Apart x p) (t : Through x p) : LM.Apart t.1 t.2.1 =
  \ e -> ne (trans (sym t.2.2.1) (trans e t.2.2.2)) ;
 -- a change of representatives reparametrises the line
 module Change (x p : Pn) (ne : Apart x p) (t t' : Through x p) {
  r1 : Q2.Related t.1 t'.1 = Q2.Q.effective t.1 t'.1 (trans t.2.2.1 (sym t'.2.2.1)) ;
  r2 : Q2.Related t.2.1 t'.2.1 = Q2.Q.effective t.2.1 t'.2.1 (trans t.2.2.2 (sym t'.2.2.2)) ;
  mid : LM.Apart t.1 t'.2.1 = \ e -> ne (trans (sym t.2.2.1) (trans e t'.2.2.2)) ;
  module SF = LM.ScaleFirst[t.1,t'.1,t'.2.1,mid,apart-of x p ne t',r1] ;
  module SS = LM.ScaleSecond[t.1,t.2.1,t'.2.1,apart-of x p ne t,mid,r2] ;
  s (q : P.P1) : P.P1 = SS.S.map (SF.S.map q) ;
  reparam : LM.Reparam s = LM.compose-reparam SF.S.map SS.S.map SF.S.reparam SS.S.reparam ;
  pointwise : LM.Pointwise SF.B.map SS.A.map s = \ q -> trans (SF.pointwise q) (SS.pointwise (SF.S.map q)) ;
 } ;
 -- base points [e_Z], [e_X] and the standard line through [e_Y], [e_Z]
 cY : Pn = L71.cY ;
 cZ : Pn = L71.cZ ;
 cX : Pn = L71.cX ;
 ne-yz : Apart cY cZ = L71.NP.apart-coord TP.pY TP.pZ TP.iY L71.one-unit (refl z) ;
 ne-zx : Apart cZ cX = L71.NP.apart-coord TP.pZ L71.pX TP.iZ L71.one-unit (refl z) ;
 ne-xz : Apart cX cZ = \ e -> ne-zx (sym e) ;
 t0 : Through cY cZ = (TP.pY,TP.pZ,refl cY,refl cZ) ;
 standard (q : P.P1) : Pn = LM.Line[TP.pY,TP.pZ,apart-of cY cZ ne-yz t0].map q ;

 module Agreement (L1 L2 : Bundle) {
  Agree (f : P.P1 -> Pn) : U l = Tr.Trunc[Id Bundle1 (\ q -> L1 (f q)) (\ q -> L2 (f q))].carrier ;
  pre (f g : P.P1 -> Pn) (s : P.P1 -> P.P1) (pw : LM.Pointwise g f s) (a : Agree f) : Agree g =
   TC.map (Id Bundle1 (\ q -> L1 (f q)) (\ q -> L2 (f q))) (Id Bundle1 (\ q -> L1 (g q)) (\ q -> L2 (g q)))
    (\ e -> F.funext P.P1 (\ q -> L.Line) (\ q -> L1 (g q)) (\ q -> L2 (g q)) (\ q ->
      trans (Pr.ap Pn L.Line L1 (g q) (f (s q)) (pw q))
       (trans (Pr.happly P.P1 (\ q' -> L.Line) (\ q' -> L1 (f q')) (\ q' -> L2 (f q')) e (s q))
        (sym (Pr.ap Pn L.Line L2 (g q) (f (s q)) (pw q)))))) a ;
  agree-ne (a b : Q2.Point) (ne ne' : LM.Apart a b) (h : Agree LM.Line[a,b,ne].map) : Agree LM.Line[a,b,ne'].map =
   Pr.subst (LM.Apart a b) (\ e -> Agree LM.Line[a,b,e].map) ne ne'
    (F.funext (Id Pn (Q2.class a) (Q2.class b)) (\ e -> Empty) ne ne' (\ e -> efq (ne e))) h ;
  degree-dec (f : P.P1 -> Pn) : FS.Dec (Id Degree (C.degree (\ q -> L1 (f q))) (C.degree (\ q -> L2 (f q)))) -> FS.Dec (Agree f) = split {
   inl e -> inl (same-degree (\ q -> L1 (f q)) (\ q -> L2 (f q)) e) ;
   inr ne -> inr (\ a -> ne (TC.rec (Id Bundle1 (\ q -> L1 (f q)) (\ q -> L2 (f q))) @l
     (Id Degree (C.degree (\ q -> L1 (f q))) (C.degree (\ q -> L2 (f q))))
     (PicardDegree[l].degree-set (C.degree (\ q -> L1 (f q))) (C.degree (\ q -> L2 (f q))))
     (\ e -> Pr.ap Bundle1 Degree C.degree (\ q -> L1 (f q)) (\ q -> L2 (f q)) e) a)) } ;
  dec-agree (f : P.P1 -> Pn) : FS.Dec (Agree f) =
   degree-dec f (L71.deq-degree (C.degree (\ q -> L1 (f q))) (C.degree (\ q -> L2 (f q)))) ;
  -- agreement on all lines through p and x
  Tp (p x : Pn) (ne : Apart x p) : U l = (t : Through x p) -> Agree LM.Line[t.1,t.2.1,apart-of x p ne t].map ;
  tp-prop (p x : Pn) (ne : Apart x p) : Pr.isProp (Tp p x ne) =
   F.isProp-Pi (Through x p) (\ t -> Agree LM.Line[t.1,t.2.1,apart-of x p ne t].map)
    (\ t -> Tr.Trunc[Id Bundle1 (\ q -> L1 (LM.Line[t.1,t.2.1,apart-of x p ne t].map q)) (\ q -> L2 (LM.Line[t.1,t.2.1,apart-of x p ne t].map q))].proposition) ;
  transfer (x p : Pn) (ne : Apart x p) (t t' : Through x p)
   (a : Agree LM.Line[t.1,t.2.1,apart-of x p ne t].map) : Agree LM.Line[t'.1,t'.2.1,apart-of x p ne t'].map =
   pre Change[x,p,ne,t,t'].SS.A.map Change[x,p,ne,t,t'].SF.B.map Change[x,p,ne,t,t'].s Change[x,p,ne,t,t'].pointwise a ;
  from-one (p x : Pn) (ne : Apart x p) (t0 : Through x p) :
   FS.Dec (Agree LM.Line[t0.1,t0.2.1,apart-of x p ne t0].map) -> FS.Dec (Tp p x ne) = split {
   inl a -> inl (\ t -> transfer x p ne t0 t a) ;
   inr na -> inr (\ all -> na (all t0)) } ;
  dec-tp (p x : Pn) (ne : Apart x p) : FS.Dec (Tp p x ne) =
   TC.rec (Through x p) @l (FS.Dec (Tp p x ne)) (dec-prop (Tp p x ne) (tp-prop p x ne))
    (\ t0 -> from-one p x ne t0 (dec-agree LM.Line[t0.1,t0.2.1,apart-of x p ne t0].map)) (through x p) ;
  -- by Lemma 7.1 (i), agreement at one point x0 gives agreement at all x
  indicator (p : Pn) (w : L71.Minus1 p) : Degree = sel (Tp p w.1 w.2) (dec-tp p w.1 w.2) ;
  everywhere (p x0 : Pn) (ne0 : Apart x0 p) (h0 : Tp p x0 ne0) (x : Pn) (ne : Apart x p) : Tp p x ne =
   sel-yes (Tp p x ne) (dec-tp p x ne)
    (trans (L71.lemma-i p (indicator p) (x,ne) (x0,ne0)) (sel-of (Tp p x0 ne0) h0 (dec-tp p x0 ne0))) ;

  -- identifications along a line
  HY (y : Pn) : U l = Id L.Line (L1 y) (L2 y) ;
  HT (y : Pn) : L.TI.Tor = GP.PTor (L1 y) (L2 y) ;
  E : U l = (y : Pn) * HY y ;
  setE : Pr.isSet E = Pr.isSet-Sigma Pn HY Q2.Q.set (\ y -> (HT y).2.2.1) ;
  lift (y y' : Pn) (e : Id Pn y y') (h : HY y) : Id E (y,h) (y',Pr.subst Pn HY y y' e h) =
   Pr.Sigma-path Pn HY y y' h (Pr.subst Pn HY y y' e h) e (refl (Pr.subst Pn HY y y' e h)) ;
  fibre (y : Pn) (h h' : HY y) (e : Id E (y,h) (y,h')) : Id (HY y) h h' =
   trans (sym (Pr.ap (Id Pn y y) (HY y) (\ q -> Pr.subst Pn HY y y q h) (Pr.ap E Pn (\ w -> w.1) (y,h) (y,h') e) (refl y)
     (Q2.Q.set y y (Pr.ap E Pn (\ w -> w.1) (y,h) (y,h') e) (refl y))))
    (Pr.Sigma-snd Pn HY y y h h' e) ;
  module Along (f : P.P1 -> Pn) (ag : Agree f) {
   inhabit : Tr.Trunc[(q : P.P1) -> HY (f q)].carrier =
    TC.map (Id Bundle1 (\ q -> L1 (f q)) (\ q -> L2 (f q))) ((q : P.P1) -> HY (f q))
     (Pr.happly P.P1 (\ q -> L.Line) (\ q -> L1 (f q)) (\ q -> L2 (f q))) ag ;
   module T = Sec.At[\ q -> HT (f q),inhabit] ;
   from (h : HY (f o1)) : T.S = T.equivalence.2.sec h ;
   from-o1 (h : HY (f o1)) : Id (HY (f o1)) (from h o1) h = T.equivalence.2.sec-eq h ;
   unique (s s' : T.S) (e : Id (HY (f o1)) (s o1) (s' o1)) : Id T.S s s' =
    trans (sym (Pr.sec-ret T.S (HY (f o1)) T.equivalence.1 T.equivalence.2 s))
     (trans (Pr.ap (HY (f o1)) T.S T.equivalence.2.sec (s o1) (s' o1) e)
      (Pr.sec-ret T.S (HY (f o1)) T.equivalence.1 T.equivalence.2 s')) ;
  } ;
  -- the identification at x obtained from hp at p along lines through p
  module Value (p : Pn) (hp : HY p) (x : Pn) (ne : Apart x p) (tp : Tp p x ne) {
   module At (t : Through x p) {
    module LN = LM.Line[t.1,t.2.1,apart-of x p ne t] ;
    module A = Along[LN.map,tp t] ;
    ep : Id Pn (LN.map o1) p = trans LN.at-o1 t.2.2.2 ;
    ex : Id Pn (LN.map i1) x = trans LN.at-i1 t.2.2.1 ;
    start : HY (LN.map o1) = Pr.subst Pn HY p (LN.map o1) (sym ep) hp ;
    s : A.T.S = A.from start ;
    point (q : P.P1) : E = (LN.map q,s q) ;
    s-start : Id E (point o1) (p,hp) =
     trans (Pr.ap (HY (LN.map o1)) E (\ h -> (LN.map o1,h)) (s o1) start (A.from-o1 start))
      (sym (lift p (LN.map o1) (sym ep) hp)) ;
    value : E = point i1 ;
    characterise (s' : A.T.S) (e : Id E (LN.map o1,s' o1) (p,hp)) : Id A.T.S s' s =
     A.unique s' s (fibre (LN.map o1) (s' o1) (s o1) (trans e (sym s-start))) ;
   } ;
   invariance (t t' : Through x p) : Id E (At[t].value) (At[t'].value) =
    trans (sym (Pr.ap P.P1 E At[t].point (Change[x,p,ne,t,t'].s i1) i1 Change[x,p,ne,t,t'].reparam.2))
     (trans (lift (At[t].LN.map (Change[x,p,ne,t,t'].s i1)) (At[t'].LN.map i1)
        (sym (Change[x,p,ne,t,t'].pointwise i1)) (At[t].s (Change[x,p,ne,t,t'].s i1)))
      (Pr.ap At[t'].A.T.S E (\ u -> (At[t'].LN.map i1,u i1))
        (\ q -> Pr.subst Pn HY (At[t].LN.map (Change[x,p,ne,t,t'].s q)) (At[t'].LN.map q) (sym (Change[x,p,ne,t,t'].pointwise q))
          (At[t].s (Change[x,p,ne,t,t'].s q)))
        At[t'].s
        (At[t'].characterise
          (\ q -> Pr.subst Pn HY (At[t].LN.map (Change[x,p,ne,t,t'].s q)) (At[t'].LN.map q) (sym (Change[x,p,ne,t,t'].pointwise q))
            (At[t].s (Change[x,p,ne,t,t'].s q)))
          (trans (sym (lift (At[t].LN.map (Change[x,p,ne,t,t'].s o1)) (At[t'].LN.map o1)
             (sym (Change[x,p,ne,t,t'].pointwise o1)) (At[t].s (Change[x,p,ne,t,t'].s o1))))
           (trans (Pr.ap P.P1 E At[t].point (Change[x,p,ne,t,t'].s o1) o1 Change[x,p,ne,t,t'].reparam.1) At[t].s-start))))) ;
   Cand : U l = (h : HY x) * ((t : Through x p) -> Id E (At[t].value) (x,h)) ;
   cand-prop : Pr.isProp Cand = \ c c' ->
    Pr.Sigma-eq (HY x) (\ h -> (t : Through x p) -> Id E (At[t].value) (x,h)) c.1 c'.1 c.2 c'.2
     (TC.rec (Through x p) @l (Id (HY x) c.1 c'.1) ((HT x).2.2.1 c.1 c'.1)
       (\ t -> fibre x c.1 c'.1 (trans (sym (c.2 t)) (c'.2 t))) (through x p))
     (F.isProp-Pi (Through x p) (\ t -> Id E (At[t].value) (x,c'.1)) (\ t -> setE (At[t].value) (x,c'.1))) ;
   cand-at (t0 : Through x p) : Cand =
    (Pr.subst Pn HY (At[t0].LN.map i1) x At[t0].ex (At[t0].s i1),
     \ t -> trans (invariance t t0) (lift (At[t0].LN.map i1) x At[t0].ex (At[t0].s i1))) ;
   cand : Cand = TC.rec (Through x p) @l Cand cand-prop cand-at (through x p) ;
   result : HY x = cand.1 ;
  } ;

  -- gluing at the two base points
  module Glue (std : Agree standard) {
   all-z (x : Pn) (ne : Apart x cZ) : Tp cZ x ne = everywhere cZ cY ne-yz (\ t -> transfer cY cZ ne-yz t0 t std) x ne ;
   swap-at (t : Through cZ cX) : Agree LM.Line[t.1,t.2.1,apart-of cZ cX ne-zx t].map =
    agree-ne t.1 t.2.1
     (LM.apart-sym t.2.1 t.1 (apart-of cX cZ ne-xz (t.2.1,t.1,t.2.2.2,t.2.2.1)))
     (apart-of cZ cX ne-zx t)
     (pre LM.Swap[t.2.1,t.1,apart-of cX cZ ne-xz (t.2.1,t.1,t.2.2.2,t.2.2.1)].A.map
       LM.Swap[t.2.1,t.1,apart-of cX cZ ne-xz (t.2.1,t.1,t.2.2.2,t.2.2.1)].B.map
       LM.Swap[t.2.1,t.1,apart-of cX cZ ne-xz (t.2.1,t.1,t.2.2.2,t.2.2.1)].map
       LM.Swap[t.2.1,t.1,apart-of cX cZ ne-xz (t.2.1,t.1,t.2.2.2,t.2.2.1)].pointwise
       (all-z cX ne-xz (t.2.1,t.1,t.2.2.2,t.2.2.1))) ;
   all-x (x : Pn) (ne : Apart x cX) : Tp cX x ne = everywhere cX cZ ne-zx swap-at x ne ;
   module Sections (hz : HY cZ) (hx : HY cX) {
    pz (x : Pn) (ne : Apart x cZ) : HY x = Value[cZ,hz,x,ne,all-z x ne].result ;
    px (x : Pn) (ne : Apart x cX) : HY x = Value[cX,hx,x,ne,all-x x ne].result ;
    act (y : Pn) (u : G.Unit) (h : HY y) : HY y = (HT y).2.1 u h ;
    diff (w : L71.Minus2 cZ cX) : G.Unit =
     Torsor[l].TorBase[G.group].D[(HT w.1).1,(HT w.1).2].diff (px w.1 w.2.2) (pz w.1 w.2.1) ;
    dact (w : L71.Minus2 cZ cX) : Id (HY w.1) (act w.1 (diff w) (px w.1 w.2.2)) (pz w.1 w.2.1) =
     Torsor[l].TorBase[G.group].D[(HT w.1).1,(HT w.1).2].dact (px w.1 w.2.2) (pz w.1 w.2.1) ;
    w0 : L71.Minus2 cZ cX = (L71.r,L71.r-z,L71.r-x) ;
    lam : G.Unit = diff w0 ;
    constant (w : L71.Minus2 cZ cX) : Id G.Unit (diff w) lam =
     G.eq (diff w) lam (L71.lemma-iv cZ cX ne-zx (\ v -> (diff v).1) w w0) ;
    agree (x : Pn) (nz : Apart x cZ) (nx : Apart x cX) : Id (HY x) (act x lam (px x nx)) (pz x nz) =
     trans (Pr.ap G.Unit (HY x) (\ u -> act x u (px x nx)) lam (diff (x,nz,nx)) (sym (constant (x,nz,nx)))) (dact (x,nz,nx)) ;
    Spec (x : Pn) (h : HY x) : U l =
     ((nz : Apart x cZ) -> Id (HY x) h (pz x nz)) * ((nx : Apart x cX) -> Id (HY x) h (act x lam (px x nx))) ;
    Glued (x : Pn) : U l = (h : HY x) * Spec x h ;
    either (x : Pn) : Tr.Trunc[Plus (Apart x cZ) (Apart x cX)].carrier =
     Q2.Q.induction @l (\ q -> Tr.Trunc[Plus (Apart q cZ) (Apart q cX)].carrier)
      (\ q -> Tr.Trunc[Plus (Apart q cZ) (Apart q cX)].proposition)
      (\ a -> TC.map (Q2.Pivots a.1) (Plus (Apart (Q2.class a) cZ) (Apart (Q2.class a) cX))
        (\ pv -> L71.choose a pv (FS.deq (suc TP.n) pv.1 TP.iZ)) a.2) x ;
    first-eq (x : Pn) (g g' : Glued x) : Plus (Apart x cZ) (Apart x cX) -> Id (HY x) g.1 g'.1 = split {
     inl nz -> trans (g.2.1 nz) (sym (g'.2.1 nz)) ;
     inr nx -> trans (g.2.2 nx) (sym (g'.2.2 nx)) } ;
    spec-prop (x : Pn) (h : HY x) : Pr.isProp (Spec x h) =
     Pr.isProp-Sigma ((nz : Apart x cZ) -> Id (HY x) h (pz x nz)) (\ e -> (nx : Apart x cX) -> Id (HY x) h (act x lam (px x nx)))
      (F.isProp-Pi (Apart x cZ) (\ nz -> Id (HY x) h (pz x nz)) (\ nz -> (HT x).2.2.1 h (pz x nz)))
      (\ e -> F.isProp-Pi (Apart x cX) (\ nx -> Id (HY x) h (act x lam (px x nx))) (\ nx -> (HT x).2.2.1 h (act x lam (px x nx)))) ;
    glued-prop (x : Pn) : Pr.isProp (Glued x) = \ g g' ->
     Pr.Sigma-eq (HY x) (Spec x) g.1 g'.1 g.2 g'.2
      (TC.rec (Plus (Apart x cZ) (Apart x cX)) @l (Id (HY x) g.1 g'.1) ((HT x).2.2.1 g.1 g'.1)
        (first-eq x g g') (either x))
      (spec-prop x g'.1) ;
    glued-at (x : Pn) : Plus (Apart x cZ) (Apart x cX) -> Glued x = split {
     inl nz -> (pz x nz,\ nz' -> Pr.ap (Apart x cZ) (HY x) (pz x) nz nz' (L71.apart-prop x cZ nz nz'),
                \ nx -> sym (agree x nz nx)) ;
     inr nx -> (act x lam (px x nx),\ nz -> agree x nz nx,
                \ nx' -> Pr.ap (Apart x cX) (HY x) (\ e -> act x lam (px x e)) nx nx' (L71.apart-prop x cX nx nx')) } ;
    glued (x : Pn) : Glued x =
     TC.rec (Plus (Apart x cZ) (Apart x cX)) @l (Glued x) (glued-prop x) (glued-at x) (either x) ;
    result : Id Bundle L1 L2 = F.funext Pn (\ x -> L.Line) L1 L2 (\ x -> (glued x).1) ;
   } ;
   result : Tr.Trunc[Id Bundle L1 L2].carrier =
    TC.map2 (HY cZ) (HY cX) (Id Bundle L1 L2) (\ hz hx -> Sections[hz,hx].result)
     (L.K.k-conn (L1 cZ) (L2 cZ)) (L.K.k-conn (L1 cX) (L2 cX)) ;
  } ;
 } ;
 -- the result
 agree-on-line (L1 L2 : Bundle) (std : Agreement[L1,L2].Agree standard) : Tr.Trunc[Id Bundle L1 L2].carrier =
  Agreement[L1,L2].Glue[std].result ;
} ;
