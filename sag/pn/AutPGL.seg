-- Aut(P^n) = PGL_{n+1}(R) for n = n0+1 >= 1 (Corollary 5.6 of projective.pdf),
-- given the classification of line bundles on P^n (AutPn: n = 1 and n >= 2).
-- GL: linear automorphisms of R^{n+1}; PGL: GL modulo unit scalars;
-- Aut: maps P^n -> P^n with an inverse.  The action PGL -> Aut is
-- injective: if [A x] = [B x] for all x, then B x = lambda(x) A x with
-- lambda invariant under scaling, so constant (Proposition 1.7).  It is
-- surjective by AutLinear.  Hence it is an equivalence.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (n0 : Nat)
 (sag : SAGAxioms[l,l].Over[R,setR].Assumptions)
 (cls : Classification[l].Over[R,setR,n0,sag.sqc,sag.loc].Theorem) {
 open R ; open RL[R] ;
 module AL = AutLinear[l].Over[R,setR,n0,sag,cls] ;
 module PL = AL.PL ;
 module Q2 = AL.Q2 ;
 module G = AL.G ;
 module W = AL.W ;
 module PF = AL.PF ;
 Pn : U l = Q2.Pn ;
 V : U l = Q2.V ;
 Point : U l = Q2.Point ;
 p0 : Point = AL.p0 ;
 coord (v w : V) (h : Id V v w) (i : Q2.I) : Id R.R (v i) (w i) = Pr.happly Q2.I (\ j -> R.R) v w h i ;

 -- GL and PGL
 GL : U l = (A : PL.Auto) * AL.Additive A.1 ;
 Scalar (A B : GL) : U l = (c : G.Unit) * ((v : V) -> Id V (B.1.1 v) (Q2.scale c.1 (A.1.1 v))) ;
 scalar-prop (A B : GL) : Pr.isProp (Scalar A B) = \ s s' ->
  Pr.Sigma-eq G.Unit (\ c -> (v : V) -> Id V (B.1.1 v) (Q2.scale c.1 (A.1.1 v))) s.1 s'.1 s.2 s'.2
   (G.eq s.1 s'.1 (Tr.Trunc[Q2.Pivots (A.1.1 p0.1)].induction @l (\ t -> Id R.R s.1.1 s'.1.1) (\ t -> setR s.1.1 s'.1.1)
     (\ pv -> Q2.cancel s.1.1 s'.1.1 (A.1.1 p0.1 pv.1) pv.2
       (trans (sym (coord _ _ (s.2 p0.1) pv.1)) (coord _ _ (s'.2 p0.1) pv.1)))
     (PL.Act[A.1].nonzero p0.1 p0.2)))
   (F.isProp-Pi V (\ v -> Id V (B.1.1 v) (Q2.scale s'.1.1 (A.1.1 v))) (\ v -> Q2.setV _ _)) ;
 scalar-refl (A : GL) : Scalar A A = (G.one,\ v -> sym (Q2.scale-one (A.1.1 v))) ;
 scalar-sym (A B : GL) (s : Scalar A B) : Scalar B A =
  (G.inverse s.1,\ v -> trans (sym (AL.scale-cancel s.1 (A.1.1 v))) (ap (Q2.scale s.1.2.1) (sym (s.2 v)))) ;
 scalar-trans (A B C : GL) (s : Scalar A B) (s' : Scalar B C) : Scalar A C =
  (G.times s'.1 s.1,\ v -> trans (s'.2 v) (trans (ap (Q2.scale s'.1.1) (s.2 v)) (Q2.scale-scale s'.1.1 s.1.1 (A.1.1 v)))) ;
 module QP = Quotient[l].Quot[GL,Scalar,scalar-prop,scalar-refl,scalar-sym,scalar-trans] ;
 PGL : U l = QP.Q ;

 -- automorphisms of P^n
 Inv (phi : Pn -> Pn) : U l = (psi : Pn -> Pn) * ((x : Pn) -> Id Pn (psi (phi x)) x) * ((x : Pn) -> Id Pn (phi (psi x)) x) ;
 Laws (phi psi : Pn -> Pn) : U l = ((x : Pn) -> Id Pn (psi (phi x)) x) * ((x : Pn) -> Id Pn (phi (psi x)) x) ;
 laws-prop (phi psi : Pn -> Pn) : Pr.isProp (Laws phi psi) =
  Pr.isProp-Sigma ((x : Pn) -> Id Pn (psi (phi x)) x) (\ e -> (x : Pn) -> Id Pn (phi (psi x)) x)
   (F.isProp-Pi Pn (\ x -> Id Pn (psi (phi x)) x) (\ x -> Q2.Q.set _ _))
   (\ e -> F.isProp-Pi Pn (\ x -> Id Pn (phi (psi x)) x) (\ x -> Q2.Q.set _ _)) ;
 inv-prop (phi : Pn -> Pn) : Pr.isProp (Inv phi) = \ a b ->
  Pr.Sigma-eq (Pn -> Pn) (Laws phi) a.1 b.1 a.2 b.2
   (F.funext Pn (\ x -> Pn) a.1 b.1 (\ y -> trans (ap a.1 (sym (b.2.2 y))) (a.2.1 (b.1 y))))
   (laws-prop phi b.1) ;
 Aut : U l = (phi : Pn -> Pn) * Inv phi ;
 set-maps : Pr.isSet (Pn -> Pn) = F.isSet-Pi Pn (\ x -> Pn) (\ x -> Q2.Q.set) ;
 set-aut : Pr.isSet Aut = Pr.isSet-Sigma (Pn -> Pn) Inv set-maps (\ phi -> Pr.prop-to-set (Inv phi) (inv-prop phi)) ;
 aut-eq (a b : Aut) (h : (q : Pn) -> Id Pn (a.1 q) (b.1 q)) : Id Aut a b =
  Pr.Sigma-eq (Pn -> Pn) Inv a.1 b.1 a.2 b.2 (F.funext Pn (\ x -> Pn) a.1 b.1 h) (inv-prop b.1) ;

 -- the action
 act (A : GL) : Aut = (PL.Act[A.1].map,PL.Act[PL.inverse A.1].map,PL.back A.1,PL.forth A.1) ;
 act-class (A : GL) (x : Point) : Id Pn (PL.Act[A.1].map (Q2.class x)) (Q2.class (PL.Act[A.1].point x)) = PL.Act[A.1].beta x ;
 respects (A B : GL) (s : Scalar A B) : Id Aut (act A) (act B) =
  aut-eq (act A) (act B) (\ q -> Q2.Q.induction @l (\ q' -> Id Pn (PL.Act[A.1].map q') (PL.Act[B.1].map q')) (\ q' -> Q2.Q.set _ _)
   (\ x -> trans (act-class A x)
     (trans (Q2.Q.relates (PL.Act[A.1].point x) (PL.Act[B.1].point x) (s.1,sym (s.2 x.1))) (sym (act-class B x)))) q) ;
 module D = QP.Descend[Aut,set-aut,act,respects] ;
 aut-of (p : PGL) : Aut = D.map p ;

 -- the action respects composition
 compose (A B : GL) : GL =
  (PL.compose A.1 B.1,\ v w -> trans (ap A.1.1 (B.2 v w)) (A.2 (B.1.1 v) (B.1.1 w))) ;
 act-compose (A B : GL) (q : Pn) : Id Pn ((act (compose A B)).1 q) ((act A).1 ((act B).1 q)) =
  Q2.Q.induction @l (\ q' -> Id Pn ((act (compose A B)).1 q') ((act A).1 ((act B).1 q'))) (\ q' -> Q2.Q.set _ _)
   (\ x -> trans (act-class (compose A B) x)
     (trans (ap Q2.class (Q2.point-eq (PL.Act[(compose A B).1].point x) (PL.Act[A.1].point (PL.Act[B.1].point x))
       (refl (A.1.1 (B.1.1 x.1)))))
      (sym (trans (ap PL.Act[A.1].map (act-class B x)) (act-class A (PL.Act[B.1].point x)))))) q ;
 -- injectivity
 module Same (A B : GL) (e : Id Aut (act A) (act B)) {
  moved (x : Point) : Id Pn (Q2.class (PL.Act[A.1].point x)) (Q2.class (PL.Act[B.1].point x)) =
   trans (sym (act-class A x)) (trans (Pr.happly Pn (\ q -> Pn) (act A).1 (act B).1 (ap (\ a -> a.1) e) (Q2.class x)) (act-class B x)) ;
  rel (x : Point) : Q2.Related (PL.Act[A.1].point x) (PL.Act[B.1].point x) =
   Q2.Q.effective (PL.Act[A.1].point x) (PL.Act[B.1].point x) (moved x) ;
  lam (x : Point) : R.R = (rel x).1.1 ;
  invariant (u : G.Unit) (x : Point) : Id R.R (lam (AL.LF.scale-point u x)) (lam x) =
   ap (\ r -> r.1.1) (Q2.related-prop (PL.Act[A.1].point (AL.LF.scale-point u x)) (PL.Act[B.1].point (AL.LF.scale-point u x))
    (rel (AL.LF.scale-point u x))
    ((rel x).1,trans (ap (Q2.scale (rel x).1.1) (A.1.2.2.1 u.1 x.1))
      (trans (AL.scale-comm (rel x).1.1 u.1 (A.1.1 x.1)) (trans (ap (Q2.scale u.1) (rel x).2) (sym (B.1.2.2.1 u.1 x.1)))))) ;
  module DL = Q2.Q.Descend[R.R,setR,lam,
   \ x y r -> trans (sym (invariant r.1 x)) (ap lam (Q2.point-eq (AL.LF.scale-point r.1 x) y r.2))] ;
  constant (x : Point) : Id R.R (lam x) (lam p0) =
   trans (sym (DL.beta x)) (trans (PF.constant DL.map (Q2.class x) (Q2.class p0)) (DL.beta p0)) ;
  c : G.Unit = (rel p0).1 ;
  at (v : V) : Id V (B.1.1 v) (Q2.scale c.1 (A.1.1 v)) =
   Q2.vector-eq (B.1.1 v) (Q2.scale c.1 (A.1.1 v)) (\ i ->
    W.same (\ v' -> B.1.1 v' i) (\ v' -> mul c.1 (A.1.1 v' i))
     (\ x -> trans (sym (coord _ _ (rel x).2 i)) (ap (\ t -> mul t (A.1.1 x.1 i)) (constant x))) v) ;
  scalar : Scalar A B = (c,at) ;
 } ;
 injective (p p' : PGL) (e : Id Aut (aut-of p) (aut-of p')) : Id PGL p p' =
  QP.induction @l (\ q -> (q' : PGL) -> Id Aut (aut-of q) (aut-of q') -> Id PGL q q')
   (\ q -> F.isProp-Pi PGL (\ q' -> Id Aut (aut-of q) (aut-of q') -> Id PGL q q')
     (\ q' -> F.isProp-Pi (Id Aut (aut-of q) (aut-of q')) (\ e' -> Id PGL q q') (\ e' -> QP.set q q')))
   (\ A -> QP.induction @l (\ q' -> Id Aut (aut-of (QP.inc A)) (aut-of q') -> Id PGL (QP.inc A) q')
     (\ q' -> F.isProp-Pi (Id Aut (aut-of (QP.inc A)) (aut-of q')) (\ e' -> Id PGL (QP.inc A) q') (\ e' -> QP.set _ _))
     (\ B e' -> QP.relates A B Same[A,B,trans (sym (D.beta A)) (trans e' (D.beta B))].scalar))
   p p' e ;

 -- surjectivity and the equivalence
 Fib (a : Aut) : U l = (p : PGL) * Id Aut (aut-of p) a ;
 fib-prop (a : Aut) : Pr.isProp (Fib a) = \ f f' ->
  Pr.Sigma-eq PGL (\ p -> Id Aut (aut-of p) a) f.1 f'.1 f.2 f'.2
   (injective f.1 f'.1 (trans f.2 (sym f'.2))) (set-aut (aut-of f'.1) a) ;
 from-induced (a : Aut) (i : AL.Induced a.1) : Fib a =
  (QP.inc (i.1,i.2.1),trans (D.beta (i.1,i.2.1)) (aut-eq (act (i.1,i.2.1)) a i.2.2)) ;
 fib (a : Aut) : Fib a =
  Tr.Trunc[AL.Induced a.1].induction @l (\ t -> Fib a) (\ t -> fib-prop a) (from-induced a)
   (AL.surjective a.1 a.2.1 a.2.2.1 a.2.2.2) ;
 corollary-5-6 : Pr.isEquiv PGL Aut aut-of =
  Pr.qinv PGL Aut aut-of (\ a -> (fib a).1) (\ a -> (fib a).2)
   (\ p -> injective (fib (aut-of p)).1 p (fib (aut-of p)).2) ;
 equivalence : Pr.Equiv PGL Aut = (aut-of,corollary-5-6) ;
} ;
