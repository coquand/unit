-- Lines in P^n.  For points [x] /= [y], the map from the two-chart P^1 of
-- Projective
--   [a:1] |-> [a x + y],   [1:b] |-> [x + b y],
-- so [0:1] |-> [y] and [1:0] |-> [x].  Scaling x by u reparametrises P^1 by
-- a |-> u a; scaling y by v by a |-> v^-1 a; exchanging x and y exchanges
-- the two charts.  These reparametrisations fix [0:1] and [1:0].
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (n : Nat)
 (sqc : Presentations[l].Over[R,setR].SQC) (loc : StandardOpens[l].Over[R,setR].Locality) {
 open R ; open RL[R] ;
 module Q2 = ProjectiveQuotient[l].Over[R,setR,n] ;
 module P = Projective[l].Line[R,setR] ;
 module G = PicardUnits[l].Over[R,setR] ;
 module U23 = Units23[l].Over[R,setR,sqc,loc] ;
 module ARR = AffineRing[l].Laws[R,setR] ;
 module CR = Cramer[l].Over[R] ;
 I : U l = Q2.I ;
 V : U l = Q2.V ;
 Pn : U l = Q2.Pn ;
 Apart (x y : Q2.Point) : U l = Not (Id Pn (Q2.class x) (Q2.class y)) ;
 apart-sym (x y : Q2.Point) (ne : Apart x y) : Apart y x = \ e -> ne (sym e) ;
 lo-vec (a : R.R) (x y : V) : V = \ i -> add (mul a (x i)) (y i) ;
 hi-vec (b : R.R) (x y : V) : V = \ i -> add (x i) (mul b (y i)) ;
 o1 : P.P1 = P.affine z ;
 i1 : P.P1 = P.infinity-chart z ;
 coord (x y : V) (e : Id V x y) (i : I) : Id R.R (x i) (y i) = Pr.happly I (\ j -> R.R) x y e i ;
 -- a s + t = 0 gives (-a) s = t
 solve-lo (a s t : R.R) (h : Id R.R (add (mul a s) t) z) : Id R.R (mul (neg a) s) t =
  trans (CR.neg-left a s) (sym (neg-uniq (mul a s) t h)) ;
 solve-hi (b s t : R.R) (h : Id R.R (add s (mul b t)) z) : Id R.R (mul (neg b) t) s =
  solve-lo b t s (trans (addC (mul b t) s) h) ;
 -- the chart vectors are nonzero
 module NonZero (x y : Q2.Point) (ne : Apart x y) {
  lo-rel (a : R.R) (zs : (i : I) -> Id R.R (lo-vec a x.1 y.1 i) z) : Q2.Related x y =
   Tr.Trunc[Q2.Pivots y.1].induction @l (\ t -> Q2.Related x y) (\ t -> Q2.related-prop x y)
    (\ p -> ((neg a,ARR.unit-left (neg a) (x.1 p.1)
       (Pr.subst R.R unit (y.1 p.1) (mul (neg a) (x.1 p.1)) (sym (solve-lo a (x.1 p.1) (y.1 p.1) (zs p.1))) p.2)),
      Q2.vector-eq (Q2.scale (neg a) x.1) y.1 (\ i -> solve-lo a (x.1 i) (y.1 i) (zs i)))) y.2 ;
  lo (a : R.R) : Q2.NonZero (lo-vec a x.1 y.1) =
   U23.nonzero-unit (suc n) (lo-vec a x.1 y.1) (\ zs -> ne (Q2.Q.relates x y (lo-rel a zs))) ;
  hi-rel (b : R.R) (zs : (i : I) -> Id R.R (hi-vec b x.1 y.1 i) z) : Q2.Related y x =
   Tr.Trunc[Q2.Pivots x.1].induction @l (\ t -> Q2.Related y x) (\ t -> Q2.related-prop y x)
    (\ p -> ((neg b,ARR.unit-left (neg b) (y.1 p.1)
       (Pr.subst R.R unit (x.1 p.1) (mul (neg b) (y.1 p.1)) (sym (solve-hi b (x.1 p.1) (y.1 p.1) (zs p.1))) p.2)),
      Q2.vector-eq (Q2.scale (neg b) y.1) x.1 (\ i -> solve-hi b (x.1 i) (y.1 i) (zs i)))) x.2 ;
  hi (b : R.R) : Q2.NonZero (hi-vec b x.1 y.1) =
   U23.nonzero-unit (suc n) (hi-vec b x.1 y.1) (\ zs -> ne (sym (Q2.Q.relates y x (hi-rel b zs)))) ;
 } ;
 -- b (a s + t) = s + b t  and  b (s + a t) = b s + t  when a b = 1
 cross (a b : R.R) (h : Id R.R (mul a b) o) (s t : R.R) :
  Id R.R (mul b (add (mul a s) t)) (add s (mul b t)) =
  trans (dist b (mul a s) t)
   (ap (\ u -> add u (mul b t)) (trans (mulA b a s) (trans (ap (\ u -> mul u s) (trans (mulC b a) h)) (one-left s)))) ;
 cross' (a b : R.R) (h : Id R.R (mul a b) o) (s t : R.R) :
  Id R.R (mul b (add s (mul a t))) (add (mul b s) t) =
  trans (dist b s (mul a t))
   (ap (add (mul b s)) (trans (mulA b a t) (trans (ap (\ u -> mul u t) (trans (mulC b a) h)) (one-left t)))) ;
 module Line (x y : Q2.Point) (ne : Apart x y) {
  module NZ = NonZero[x,y,ne] ;
  vec : P.C -> Q2.Point = split {
   lo a -> (lo-vec a x.1 y.1,NZ.lo a) ;
   hi b -> (hi-vec b x.1 y.1,NZ.hi b) } ;
  related : (c d : P.C) -> P.relation c d -> Q2.Related (vec c) (vec d) = split {
   lo a -> split {
    lo b -> \ h -> (G.one,Q2.vector-eq (Q2.scale o (lo-vec a x.1 y.1)) (lo-vec b x.1 y.1)
      (\ i -> trans (one-left (lo-vec a x.1 y.1 i)) (ap (\ u -> add (mul u (x.1 i)) (y.1 i)) h))) ;
    hi b -> \ h -> ((b,a,trans (mulC b a) h),Q2.vector-eq (Q2.scale b (lo-vec a x.1 y.1)) (hi-vec b x.1 y.1)
      (\ i -> cross a b h (x.1 i) (y.1 i))) } ;
   hi a -> split {
    lo b -> \ h -> ((b,a,trans (mulC b a) h),Q2.vector-eq (Q2.scale b (hi-vec a x.1 y.1)) (lo-vec b x.1 y.1)
      (\ i -> cross' a b h (x.1 i) (y.1 i))) ;
    hi b -> \ h -> (G.one,Q2.vector-eq (Q2.scale o (hi-vec a x.1 y.1)) (hi-vec b x.1 y.1)
      (\ i -> trans (one-left (hi-vec a x.1 y.1 i)) (ap (\ u -> add (x.1 i) (mul u (y.1 i))) h))) } } ;
  respects (c d : P.C) (h : P.relation c d) : Id Pn (Q2.class (vec c)) (Q2.class (vec d)) =
   Q2.Q.relates (vec c) (vec d) (related c d h) ;
  module D = P.Q.Descend[Pn,Q2.Q.set,\ c -> Q2.class (vec c),respects] ;
  map (p : P.P1) : Pn = D.map p ;
  beta (c : P.C) : Id Pn (map (P.point c)) (Q2.class (vec c)) = D.beta c ;
  at-o1 : Id Pn (map o1) (Q2.class y) =
   trans (beta (lo z)) (ap Q2.class (Q2.point-eq (vec (lo z)) y
    (Q2.vector-eq (lo-vec z x.1 y.1) y.1 (\ i -> trans (ap (\ u -> add u (y.1 i)) (zero-mul (x.1 i))) (zl (y.1 i)))))) ;
  at-i1 : Id Pn (map i1) (Q2.class x) =
   trans (beta (hi z)) (ap Q2.class (Q2.point-eq (vec (hi z)) x
    (Q2.vector-eq (hi-vec z x.1 y.1) x.1 (\ i -> trans (ap (add (x.1 i)) (zero-mul (y.1 i))) (addZ (x.1 i)))))) ;
 } ;
 line (x y : Q2.Point) (ne : Apart x y) (p : P.P1) : Pn = Line[x,y,ne].map p ;

 -- reparametrisations of P^1
 Reparam (s : P.P1 -> P.P1) : U l = Id P.P1 (s o1) o1 * Id P.P1 (s i1) i1 ;
 module Scale (c : G.Unit) {
  chart : P.C -> P.C = split { lo a -> lo (mul c.1 a) ; hi b -> hi (mul c.2.1 b) } ;
  both (a b : R.R) : Id R.R (mul (mul c.1 a) (mul c.2.1 b)) (mul a b) =
   trans (G.four c.1 a c.2.1 b) (trans (ap (\ u -> mul u (mul a b)) c.2.2) (one-left (mul a b))) ;
  both' (a b : R.R) : Id R.R (mul (mul c.2.1 a) (mul c.1 b)) (mul a b) =
   trans (G.four c.2.1 a c.1 b) (trans (ap (\ u -> mul u (mul a b)) (trans (mulC c.2.1 c.1) c.2.2)) (one-left (mul a b))) ;
  respects : (u v : P.C) -> P.relation u v -> P.relation (chart u) (chart v) = split {
   lo a -> split { lo b -> \ h -> ap (mul c.1) h ; hi b -> \ h -> trans (both a b) h } ;
   hi a -> split { lo b -> \ h -> trans (both' a b) h ; hi b -> \ h -> ap (mul c.2.1) h } } ;
  module D = P.Q.Descend[P.P1,P.Q.set,\ u -> P.point (chart u),
   \ u v h -> P.Q.relates (chart u) (chart v) (respects u v h)] ;
  map (p : P.P1) : P.P1 = D.map p ;
  beta (u : P.C) : Id P.P1 (map (P.point u)) (P.point (chart u)) = D.beta u ;
  reparam : Reparam map =
   (trans (beta (lo z)) (Pr.ap R.R P.P1 P.affine (mul c.1 z) z (mul-zero c.1)),
    trans (beta (hi z)) (Pr.ap R.R P.P1 P.infinity-chart (mul c.2.1 z) z (mul-zero c.2.1))) ;
 } ;
 compose-reparam (s t : P.P1 -> P.P1) (hs : Reparam s) (ht : Reparam t) : Reparam (\ p -> t (s p)) =
  (trans (ap t hs.1) ht.1,trans (ap t hs.2) ht.2) ;
 Pointwise (f g : P.P1 -> Pn) (s : P.P1 -> P.P1) : U l = (p : P.P1) -> Id Pn (f p) (g (s p)) ;
 -- x' = u x
 module ScaleFirst (x x' y : Q2.Point) (ne : Apart x y) (ne' : Apart x' y) (r : Q2.Related x x') {
  module A = Line[x,y,ne] ;
  module B = Line[x',y,ne'] ;
  module S = Scale[r.1] ;
  u : R.R = r.1.1 ;
  w : R.R = r.1.2.1 ;
  at-lo (a : R.R) (i : I) : Id R.R (lo-vec (mul u a) x.1 y.1 i) (lo-vec a x'.1 y.1 i) =
   ap (\ t -> add t (y.1 i))
    (trans (ap (\ t -> mul t (x.1 i)) (mulC u a)) (trans (sym (mulA a u (x.1 i))) (ap (mul a) (coord _ _ r.2 i)))) ;
  at-hi (b : R.R) (i : I) : Id R.R (mul u (hi-vec (mul w b) x.1 y.1 i)) (hi-vec b x'.1 y.1 i) =
   trans (dist u (x.1 i) (mul (mul w b) (y.1 i)))
    (Presentations[l].cong2 R.R add _ _ _ _ (coord _ _ r.2 i)
     (trans (mulA u (mul w b) (y.1 i))
      (ap (\ t -> mul t (y.1 i)) (trans (mulA u w b) (trans (ap (\ t -> mul t b) r.1.2.2) (one-left b)))))) ;
  chart : (c : P.C) -> Id Pn (Q2.class (B.vec c)) (Q2.class (A.vec (S.chart c))) = split {
   lo a -> ap Q2.class (Q2.point-eq (B.vec (lo a)) (A.vec (lo (mul u a)))
     (Q2.vector-eq (lo-vec a x'.1 y.1) (lo-vec (mul u a) x.1 y.1) (\ i -> sym (at-lo a i)))) ;
   hi b -> sym (Q2.Q.relates (A.vec (hi (mul w b))) (B.vec (hi b))
     (r.1,Q2.vector-eq (Q2.scale u (hi-vec (mul w b) x.1 y.1)) (hi-vec b x'.1 y.1) (at-hi b))) } ;
  pointwise : Pointwise B.map A.map S.map = \ p ->
   P.Q.induction @l (\ q -> Id Pn (B.map q) (A.map (S.map q))) (\ q -> Q2.Q.set (B.map q) (A.map (S.map q)))
    (\ c -> trans (B.beta c) (trans (chart c) (sym (trans (ap A.map (S.beta c)) (A.beta (S.chart c)))))) p ;
 } ;
 -- y' = v y
 module ScaleSecond (x y y' : Q2.Point) (ne : Apart x y) (ne' : Apart x y') (r : Q2.Related y y') {
  module A = Line[x,y,ne] ;
  module B = Line[x,y',ne'] ;
  module S = Scale[G.inverse r.1] ;
  v : R.R = r.1.1 ;
  w : R.R = r.1.2.1 ;
  at-lo (a : R.R) (i : I) : Id R.R (mul v (lo-vec (mul w a) x.1 y.1 i)) (lo-vec a x.1 y'.1 i) =
   trans (dist v (mul (mul w a) (x.1 i)) (y.1 i))
    (Presentations[l].cong2 R.R add _ _ _ _
     (trans (mulA v (mul w a) (x.1 i))
      (ap (\ t -> mul t (x.1 i)) (trans (mulA v w a) (trans (ap (\ t -> mul t a) r.1.2.2) (one-left a)))))
     (coord _ _ r.2 i)) ;
  at-hi (b : R.R) (i : I) : Id R.R (hi-vec (mul v b) x.1 y.1 i) (hi-vec b x.1 y'.1 i) =
   ap (add (x.1 i))
    (trans (ap (\ t -> mul t (y.1 i)) (mulC v b)) (trans (sym (mulA b v (y.1 i))) (ap (mul b) (coord _ _ r.2 i)))) ;
  chart : (c : P.C) -> Id Pn (Q2.class (B.vec c)) (Q2.class (A.vec (S.chart c))) = split {
   lo a -> sym (Q2.Q.relates (A.vec (lo (mul w a))) (B.vec (lo a))
     (r.1,Q2.vector-eq (Q2.scale v (lo-vec (mul w a) x.1 y.1)) (lo-vec a x.1 y'.1) (at-lo a))) ;
   hi b -> ap Q2.class (Q2.point-eq (B.vec (hi b)) (A.vec (hi (mul v b)))
     (Q2.vector-eq (hi-vec b x.1 y'.1) (hi-vec (mul v b) x.1 y.1) (\ i -> sym (at-hi b i)))) } ;
  pointwise : Pointwise B.map A.map S.map = \ p ->
   P.Q.induction @l (\ q -> Id Pn (B.map q) (A.map (S.map q))) (\ q -> Q2.Q.set (B.map q) (A.map (S.map q)))
    (\ c -> trans (B.beta c) (trans (chart c) (sym (trans (ap A.map (S.beta c)) (A.beta (S.chart c)))))) p ;
 } ;
 -- exchanging the two points
 module Swap (x y : Q2.Point) (ne : Apart x y) {
  module A = Line[x,y,ne] ;
  module B = Line[y,x,apart-sym x y ne] ;
  chart : P.C -> P.C = split { lo a -> hi a ; hi b -> lo b } ;
  respects : (u v : P.C) -> P.relation u v -> P.relation (chart u) (chart v) = split {
   lo a -> split { lo b -> \ h -> h ; hi b -> \ h -> h } ;
   hi a -> split { lo b -> \ h -> h ; hi b -> \ h -> h } } ;
  module D = P.Q.Descend[P.P1,P.Q.set,\ u -> P.point (chart u),
   \ u v h -> P.Q.relates (chart u) (chart v) (respects u v h)] ;
  map (p : P.P1) : P.P1 = D.map p ;
  vectors : (c : P.C) -> Id V (B.vec c).1 (A.vec (chart c)).1 = split {
   lo a -> Q2.vector-eq (lo-vec a y.1 x.1) (hi-vec a x.1 y.1) (\ i -> addC (mul a (y.1 i)) (x.1 i)) ;
   hi b -> Q2.vector-eq (hi-vec b y.1 x.1) (lo-vec b x.1 y.1) (\ i -> addC (y.1 i) (mul b (x.1 i))) } ;
  pointwise : Pointwise B.map A.map map = \ p ->
   P.Q.induction @l (\ q -> Id Pn (B.map q) (A.map (map q))) (\ q -> Q2.Q.set (B.map q) (A.map (map q)))
    (\ c -> trans (B.beta c) (trans (ap Q2.class (Q2.point-eq (B.vec c) (A.vec (chart c)) (vectors c)))
      (sym (trans (ap A.map (D.beta c)) (A.beta (chart c)))))) p ;
 } ;
} ;
