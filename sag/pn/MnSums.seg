-- Finite sums over Fin n for the matrix algebra M_N(R): the Kronecker
-- delta (by recursion on n, so it computes), exchange of a double sum,
-- and sum_k delta i k v_k = v_i.
level l ; open Ring[l] ;
module Ps = Presentations[l] ;
top-eq : (u v : Top) -> Id Top u v = split { tt -> split { tt -> refl tt } } ;
module Over (R : CRing) {
 module L = RL[R] ;
 module S = FiniteIdeal[l].Sums[R] ;
 delta : (n : Nat) -> Ps.Fin n -> Ps.Fin n -> R.R = split {
  zero -> \ i j -> R.z ;
  suc n | r -> split {
   inl a -> split { inl b -> r a b ; inr t -> R.z } ;
   inr s -> split { inl b -> R.z ; inr t -> R.o } } } ;
 delta-sym : (n : Nat) (i j : Ps.Fin n) -> Id R.R (delta n i j) (delta n j i) = split {
  zero -> \ i j -> refl R.z ;
  suc n | r -> split {
   inl a -> split { inl b -> r a b ; inr t -> refl R.z } ;
   inr s -> split { inl b -> refl R.z ; inr t -> refl R.o } } } ;
 delta-diag : (n : Nat) (i : Ps.Fin n) -> Id R.R (delta n i i) R.o = split {
  zero -> \ i -> efq i ;
  suc n | r -> split { inl a -> r a ; inr s -> refl R.o } } ;
 delta-off : (n : Nat) (i j : Ps.Fin n) -> Not (Id (Ps.Fin n) i j) -> Id R.R (delta n i j) R.z = split {
  zero -> \ i j ne -> refl R.z ;
  suc n | r -> split {
   inl a -> split {
    inl b -> \ ne -> r a b (\ p -> ne (ap (\ x -> inl x) p)) ;
    inr t -> \ ne -> refl R.z } ;
   inr s -> split {
    inl b -> \ ne -> refl R.z ;
    inr t -> \ ne -> efq (ne (ap (\ x -> inr x) (top-eq s t))) } } } ;
 cong2-R {a a1 b b1 : R.R} (p : Id R.R a a1) (q : Id R.R b b1) : Id R.R (R.add a b) (R.add a1 b1) =
  Ps.cong2 R.R R.add a a1 b b1 p q ;
 -- sum_i (u_i * c) = (sum_i u_i) * c
 sum-scale-right (c : R.R) (n : Nat) (u : Ps.Fin n -> R.R) :
  Id R.R (S.sum n (\ i -> R.mul (u i) c)) (R.mul (S.sum n u) c) =
  trans (S.sum-cong n (\ i -> R.mul (u i) c) (\ i -> R.mul c (u i)) (\ i -> R.mulC (u i) c))
   (trans (S.sum-scale c n u) (R.mulC c (S.sum n u))) ;
 -- sum_i sum_j f i j = sum_j sum_i f i j
 exchange (m : Nat) : (n : Nat) (f : Ps.Fin n -> Ps.Fin m -> R.R) ->
  Id R.R (S.sum n (\ i -> S.sum m (\ j -> f i j))) (S.sum m (\ j -> S.sum n (\ i -> f i j))) = split {
  zero -> \ f -> sym (S.sum-zero m) ;
  suc n | ih -> \ f ->
   trans (ap (R.add (S.sum m (\ j -> f (inr tt) j))) (ih (\ i j -> f (inl i) j)))
    (sym (S.sum-add m (\ j -> f (inr tt) j) (\ j -> S.sum n (\ i -> f (inl i) j)))) } ;
 -- sum_k delta i k * v_k = v_i
 sum-delta : (n : Nat) (i : Ps.Fin n) (v : Ps.Fin n -> R.R) ->
  Id R.R (S.sum n (\ k -> R.mul (delta n i k) (v k))) (v i) = split {
  zero -> \ i v -> efq i ;
  suc n | ih -> split {
   inl a -> \ v ->
    trans (ap (\ x -> R.add x (S.sum n (\ k -> R.mul (delta n a k) (v (inl k))))) (L.zero-mul (v (inr tt))))
     (trans (L.zl (S.sum n (\ k -> R.mul (delta n a k) (v (inl k)))))
      (ih a (\ k -> v (inl k)))) ;
   inr s -> \ v ->
    trans (cong2-R (L.one-left (v (inr tt)))
      (trans (S.sum-cong n (\ k -> R.mul R.z (v (inl k))) (\ k -> R.z) (\ k -> L.zero-mul (v (inl k))))
       (S.sum-zero n)))
     (trans (R.addZ (v (inr tt))) (ap (\ t -> v (inr t)) (top-eq tt s))) } } ;
 -- sum_k v_k * delta k j = v_j
 sum-delta-right (n : Nat) (j : Ps.Fin n) (v : Ps.Fin n -> R.R) :
  Id R.R (S.sum n (\ k -> R.mul (v k) (delta n k j))) (v j) =
  trans (S.sum-cong n (\ k -> R.mul (v k) (delta n k j)) (\ k -> R.mul (delta n j k) (v k))
    (\ k -> trans (R.mulC (v k) (delta n k j)) (ap (\ x -> R.mul x (v k)) (delta-sym n k j))))
   (sum-delta n j v) ;
} ;
