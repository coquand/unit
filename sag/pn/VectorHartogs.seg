-- Hartogs on R^k for a family s of elements of R[x_0..x_{k-1}] satisfying
-- the hypotheses of Hartogs.At: restriction from R^k to the open set
-- Cov = {v | some s_i(v) is invertible} is an equivalence on functions to R.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (sqc : Presentations[l].Over[R,setR].SQC) (k m : Nat)
 (s : Fin (suc (suc m)) -> (AffineSpace[l].Over[R,setR].alg k).ring.R)
 (regular : (i : Fin (suc (suc m))) -> AffineSpace[l].Over[R,setR].Regular k (s i))
 (divides : (a b : Nat) (g h : (AffineSpace[l].Over[R,setR].alg k).ring.R) ->
   Id (AffineSpace[l].Over[R,setR].alg k).ring.R
    ((AffineSpace[l].Over[R,setR].alg k).ring.mul (AffinePowers[l].Over[(AffineSpace[l].Over[R,setR].alg k).ring].power (s (inl (inr tt))) b) g)
    ((AffineSpace[l].Over[R,setR].alg k).ring.mul (AffinePowers[l].Over[(AffineSpace[l].Over[R,setR].alg k).ring].power (s (inr tt)) a) h) ->
   (c : (AffineSpace[l].Over[R,setR].alg k).ring.R) *
    Id (AffineSpace[l].Over[R,setR].alg k).ring.R g
     ((AffineSpace[l].Over[R,setR].alg k).ring.mul (AffinePowers[l].Over[(AffineSpace[l].Over[R,setR].alg k).ring].power (s (inr tt)) a) c)) {
 module C = Algebras[l].Over[R,setR] ;
 module AS = AffineSpace[l].Over[R,setR] ;
 A : C.Algebra = AS.alg k ;
 module H = Hartogs[l].Over[R,setR,sqc].At[A,AS.fp k,m,s,regular,divides] ;
 V : U l = AS.Vec k ;
 value (v : V) (a : A.ring.R) : R.R = (AS.point k v).1.1 a ;
 Cov (v : V) : U l = H.Covered (AS.point k v) ;
 Open : U l = (v : V) * Cov v ;
 open-eq (v w : Open) (h : Id V v.1 w.1) : Id Open v w =
  Pr.Sigma-eq V Cov v.1 w.1 v.2 w.2 h (Tr.Trunc[(i : Fin (suc (suc m))) * RL[R].unit (value w.1 (s i))].proposition) ;
 to (y : H.Punctured) : Open =
  (AS.coords k y.1,Pr.subst (C.Spec A) H.Covered y.1 (AS.point k (AS.coords k y.1)) (sym (AS.point-coords k y.1)) y.2) ;
 from (v : Open) : H.Punctured = (AS.point k v.1,v.2) ;
 to-from (v : Open) : Id Open (to (from v)) v =
  open-eq (to (from v)) v (F.funext (Fin k) (\ i -> R.R) _ _ (AS.coords-point k v.1)) ;
 restrict (psi : V -> R.R) (v : Open) : R.R = psi v.1 ;
 pulled (phi : Open -> R.R) (y : H.Punctured) : R.R = phi (to y) ;
 extend (phi : Open -> R.R) (v : V) : R.R = H.ev (AS.point k v) (H.extend (pulled phi)) ;
 extend-restrict (phi : Open -> R.R) (v : Open) : Id R.R (extend phi v.1) (phi v) =
  trans (H.Main[pulled phi].extension.2 (from v)) (ap phi (to-from v)) ;
 module Global (psi : V -> R.R) {
  e : Pr.isEquiv A.ring.R (C.Spec A -> R.R) (C.evaluation A) = sqc A (AS.fp k) ;
  c : A.ring.R = e.sec (\ x -> psi (AS.coords k x)) ;
  value-c (x : C.Spec A) : Id R.R (H.ev x c) (psi (AS.coords k x)) =
   Pr.happly (C.Spec A) (\ x -> R.R) _ _ (e.sec-eq (\ x -> psi (AS.coords k x))) x ;
  same : Id (H.Punctured -> R.R) (pulled (restrict psi)) (H.restrict c) =
   F.funext H.Punctured (\ y -> R.R) _ _ (\ y -> sym (value-c y.1)) ;
  result (v : V) : Id R.R (extend (restrict psi) v) (psi v) =
   trans (ap (\ phi -> H.ev (AS.point k v) (H.extend phi)) same)
    (trans (ap (H.ev (AS.point k v)) (H.functions.2.ret-eq c))
     (trans (value-c (AS.point k v)) (ap psi (F.funext (Fin k) (\ i -> R.R) _ _ (AS.coords-point k v))))) ;
 } ;
 functions : Pr.Equiv (V -> R.R) (Open -> R.R) =
  (restrict,Pr.qinv (V -> R.R) (Open -> R.R) restrict extend
   (\ phi -> F.funext Open (\ v -> R.R) _ phi (extend-restrict phi))
   (\ psi -> F.funext V (\ v -> R.R) _ psi Global[psi].result)) ;
} ;
