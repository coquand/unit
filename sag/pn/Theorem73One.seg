-- Theorem 7.3 for n = 1: Line x Z -> (P^1 -> Line), (a,d) |-> a (x) O(d), is
-- an equivalence on the quotient P^1.  Along the equivalence of P1Compare
-- (the line through e_X, e_Y), a (x) O(d) restricts to the classification
-- of Proposition 4.6 (Twist.Restrict, as in Lemma 7.2); so precomposition
-- with the line turns the map into Proposition 4.6's equivalence.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (sag : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module PC1 = P1Compare[l].Over[R,setR,sag.sqc,sag.loc] ;
 module CL = Classification[l].Over[R,setR,zero,sag.sqc,sag.loc] ;
 module L = CL.L ;
 module W = PicardTwists[l].Over[R,setR] ;
 module PC = PicardComplete[l].Over[R,setR,sag] ;
 Degree : U l = CL.Degree ;
 Pn : U l = CL.Pn ;
 Bundle : U l = CL.Bundle ;
 Bundle1 : U l = PC1.P.P1 -> L.Line ;
 e : Pr.isEquiv PC1.P.P1 Pn PC1.map = PC1.equivalence.2 ;
 restricted (w : L.Line * Degree) (q : PC1.P.P1) : L.Line = CL.classify w (PC1.map q) ;
 same : Id ((L.Line * Degree) -> Bundle1) restricted (\ w -> W.classify w.1 w.2) =
  F.funext (L.Line * Degree) (\ w -> Bundle1) restricted (\ w -> W.classify w.1 w.2) (\ w ->
   F.funext PC1.P.P1 (\ q -> L.Line) (restricted w) (W.classify w.1 w.2) (\ q ->
    Pr.ap L.Line L.Line (L.tensor w.1) _ _ (CL.TW.Restrict[w.2,PC1.pX,PC1.pY,PC1.ne].restrict q))) ;
 restricted-equiv : Pr.isEquiv (L.Line * Degree) Bundle1 restricted =
  Pr.subst ((L.Line * Degree) -> Bundle1) (Pr.isEquiv (L.Line * Degree) Bundle1)
   (\ w -> W.classify w.1 w.2) restricted (sym same) PC.proposition-4-6 ;
 inverse (B : Bundle) : L.Line * Degree = restricted-equiv.sec (\ q -> B (PC1.map q)) ;
 sec (B : Bundle) : Id Bundle (CL.classify (inverse B)) B =
  F.funext Pn (\ x -> L.Line) (CL.classify (inverse B)) B (\ x ->
   trans (ap (CL.classify (inverse B)) (sym (e.sec-eq x)))
    (trans (Pr.happly PC1.P.P1 (\ q -> L.Line) _ _ (restricted-equiv.sec-eq (\ q -> B (PC1.map q))) (e.sec x))
     (ap B (e.sec-eq x)))) ;
 ret (w : L.Line * Degree) : Id (L.Line * Degree) (inverse (CL.classify w)) w =
  Pr.sec-ret (L.Line * Degree) Bundle1 restricted restricted-equiv w ;
 theorem : CL.Theorem = Pr.qinv (L.Line * Degree) Bundle CL.classify inverse sec ret ;
} ;
