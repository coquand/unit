-- Functions of a given weight on R^k, k = m+2 >= 2, from Lemma 1.6.
--   same:     functions on R^k that agree on R^k \ {0} are equal;
--   Hom:      psi(u v) = c(u) psi(v) for units u and v /= 0 gives
--             psi(t v) = c(t) psi(v) for all t : R and all v;
--   negative: t^(d+1) psi(t v) = psi(v) for units gives psi = 0 off 0;
--   hartogs:  if psi is a unit off 0, then psi(0) is a unit;
--   positive: so psi cannot be a unit off 0 if c(0) = 0.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (sqc : Presentations[l].Over[R,setR].SQC)
 (loc : StandardOpens[l].Over[R,setR].Locality) (m : Nat) {
 open R ; open RL[R] ;
 module PS = PuncturedSpace[l].Over[R,setR,sqc,m] ;
 module PF = ProjectiveFunctions[l].Over[R,setR,sqc] ;
 module Pow = AffinePowers[l].Over[R] ;
 module G = PicardUnits[l].Over[R,setR] ;
 module ARR = AffineRing[l].Laws[R,setR] ;
 k : Nat = PS.k ;
 V : U l = PS.V ;
 Punctured : U l = PS.Punctured ;
 scale (t : R.R) (v : V) : V = \ i -> mul t (v i) ;
 zero-vector : V = \ i -> z ;
 scale-zero (v : V) : Id V (scale z v) zero-vector = F.funext (Fin k) (\ i -> R.R) (scale z v) zero-vector (\ i -> zero-mul (v i)) ;
 scale-punctured (u : G.Unit) (v : Punctured) : Punctured =
  (scale u.1 v.1,Tr.Trunc[PS.Pivots v.1].induction @l (\ t -> PS.NonZero (scale u.1 v.1)) (\ t -> Tr.Trunc[PS.Pivots (scale u.1 v.1)].proposition)
    (\ p -> Tr.Trunc[PS.Pivots (scale u.1 v.1)].inc (p.1,ARR.unit-product u.1 (v.1 p.1) u.2 p.2)) v.2) ;
 same (a b : V -> R.R) (h : (v : Punctured) -> Id R.R (a v.1) (b v.1)) (w : V) : Id R.R (a w) (b w) =
  trans (sym (PS.extend-global a w))
   (trans (Pr.ap (Punctured -> R.R) R.R (\ phi -> PS.extend phi w) (PS.restrict a) (PS.restrict b)
     (F.funext Punctured (\ v -> R.R) (PS.restrict a) (PS.restrict b) h)) (PS.extend-global b w)) ;
 module Hom (c : R.R -> R.R) (psi : V -> R.R)
  (h : (u : G.Unit) (v : Punctured) -> Id R.R (psi (scale u.1 v.1)) (mul (c u.1) (psi v.1))) {
  units (u : G.Unit) (w : V) : Id R.R (psi (scale u.1 w)) (mul (c u.1) (psi w)) =
   same (\ w' -> psi (scale u.1 w')) (\ w' -> mul (c u.1) (psi w')) (h u) w ;
  module At (w : V) {
   g (t : R.R) : R.R = add (psi (scale t w)) (neg (mul (c t) (psi w))) ;
   vanish (u : R.R) (hu : unit u) : Id R.R (g u) z =
    trans (ap (\ e -> add e (neg (mul (c u) (psi w)))) (units (u,hu) w)) (addN (mul (c u) (psi w))) ;
   result (t : R.R) : Id R.R (psi (scale t w)) (mul (c t) (psi w)) =
    ARR.difference-zero _ _ (PF.UnitZero[g,vanish].result t) ;
  } ;
  all (t : R.R) (w : V) : Id R.R (psi (scale t w)) (mul (c t) (psi w)) = At[w].result t ;
 } ;
 module Negative (d : Nat) (psi : V -> R.R)
  (h : (u : G.Unit) (v : Punctured) -> Id R.R (mul (Pow.power u.1 (suc d)) (psi (scale u.1 v.1))) (psi v.1)) (v : Punctured) {
  g (t : R.R) : R.R = add (mul (Pow.power t (suc d)) (psi (scale t v.1))) (neg (psi v.1)) ;
  vanish (u : R.R) (hu : unit u) : Id R.R (g u) z =
   trans (ap (\ e -> add e (neg (psi v.1))) (h (u,hu) v)) (addN (psi v.1)) ;
  -- at t = 0
  at-zero : Id R.R (g z) (neg (psi v.1)) =
   trans (ap (\ e -> add e (neg (psi v.1)))
     (trans (ap (\ e -> mul e (psi (scale z v.1))) (zero-mul (Pow.power z d))) (zero-mul (psi (scale z v.1)))))
    (zl (neg (psi v.1))) ;
  result : Id R.R (psi v.1) z =
   trans (sym (addZ (psi v.1))) (trans (ap (add (psi v.1)) (sym (trans (sym at-zero) (PF.UnitZero[g,vanish].result z)))) (addN (psi v.1))) ;
 } ;
 module UnitAtZero (psi : V -> R.R) (h : (v : Punctured) -> unit (psi v.1)) {
  mu : V -> R.R = PS.extend (\ v -> (h v).1) ;
  product (w : V) : Id R.R (mul (psi w) (mu w)) o =
   same (\ w' -> mul (psi w') (mu w')) (\ w' -> o)
    (\ v -> trans (ap (mul (psi v.1)) (PS.extend-restrict (\ v' -> (h v').1) v)) (h v).2) w ;
  result : unit (psi zero-vector) = (mu zero-vector,product zero-vector) ;
 } ;
 positive (c : R.R -> R.R) (c0 : Id R.R (c z) z) (psi : V -> R.R)
  (h : (u : G.Unit) (v : Punctured) -> Id R.R (psi (scale u.1 v.1)) (mul (c u.1) (psi v.1)))
  (hu : (v : Punctured) -> unit (psi v.1)) : Empty =
  loc.1 (trans (sym (UnitAtZero[psi,hu].result.2))
   (trans (ap (\ e -> mul e (UnitAtZero[psi,hu].result.1))
     (trans (ap psi (sym (scale-zero zero-vector)))
      (trans (Hom[c,psi,h].all z zero-vector)
       (trans (ap (\ e -> mul e (psi zero-vector)) c0) (zero-mul (psi zero-vector))))))
    (zero-mul (UnitAtZero[psi,hu].result.1)))) ;
} ;
