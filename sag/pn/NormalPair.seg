-- Lemma 7.1 (iv) for the two points [e_Y], [e_Z] of P^n, n >= 2.
-- W = P^n \ {[e_Y],[e_Z]} lifts to the open set of R^{n+1} covered by
-- D(X), D(YZ) and D(x_j) for the other coordinates; this family satisfies
-- the Hartogs hypotheses, so a function on W extends to R^{n+1}, and the
-- argument of Proposition 1.7 makes it constant.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (m : Nat)
 (sqc : Presentations[l].Over[R,setR].SQC) (loc : StandardOpens[l].Over[R,setR].Locality) {
 open R ; open RL[R] ;
 module AS = AffineSpace[l].Over[R,setR] ;
 module TP = TwoPoints[l].Over[R,setR,m,sqc,loc] ;
 module Q2 = TP.Q2 ;
 module CR = TP.CR ;
 module ARR = AffineRing[l].Laws[R,setR] ;
 I : U l = TP.I ;
 V : U l = TP.V ;
 k : Nat = suc TP.n ;
 A : (AS.C).Algebra = AS.alg k ;
 B : (AS.C).Algebra = AS.alg (suc (suc m)) ;
 y0 : B.ring.R = AS.var (suc (suc m)) (inr tt) ;
 z0 : B.ring.R = AS.var (suc (suc m)) (inl (inr tt)) ;
 c : B.ring.R = B.ring.mul y0 z0 ;
 c-reg : AS.Regular (suc (suc m)) c =
  AS.product-regular (suc (suc m)) y0 z0 (AS.regular (suc (suc m)) (inr tt)) (AS.regular (suc (suc m)) (inl (inr tt))) ;
 module TB = AS.TwoBy[suc m,c,c-reg] ;
 s1 : Fin (suc m) -> A.ring.R = split { inr t -> TB.X.constant c ; inl j -> AS.var k (TP.inner j) } ;
 s : Fin (suc (suc m)) -> A.ring.R = split { inr t -> AS.var k TP.iX ; inl j -> s1 j } ;
 regular1 : (j : Fin (suc m)) -> AS.Regular k (s1 j) = split {
  inr t -> TB.PC.constant-regular c c-reg ; inl j -> AS.regular k (TP.inner j) } ;
 regular : (i : Fin (suc (suc m))) -> AS.Regular k (s i) = split {
  inr t -> AS.regular k TP.iX ; inl j -> regular1 j } ;
 module VH = VectorHartogs[l].Over[R,setR,sqc,k,m,s,regular,TB.divides] ;
 value-var (v : V) (j : I) : Id R.R (VH.value v (AS.var k j)) (v j) = AS.coords-point k v j ;
 value-c (v : V) : Id R.R (VH.value v (TB.X.constant c)) (mul (v TP.iY) (v TP.iZ)) =
  trans (ap (AS.point k v).1.1 (TB.X.constant-mul y0 z0))
   (trans ((AS.point k v).1.2.2.2 (TB.X.constant y0) (TB.X.constant z0))
    (Presentations[l].cong2 R.R mul _ _ _ _ (value-var v TP.iY) (value-var v TP.iZ))) ;
 unit-subst {a b : R.R} (e : Id R.R a b) (u : unit a) : unit b = Pr.subst R.R unit a b e u ;
 no-zero-unit (u : unit z) : Empty = loc.1 (trans (sym u.2) (zero-mul u.1)) ;
 Pivots (v : V) : U l = Q2.Pivots v ;
 Cov (v : V) : U l = VH.Cov v ;
 CovIndex (v : V) : U l = (i : Fin (suc (suc m))) * unit (VH.value v (s i)) ;
 cov-inc (v : V) (i : Fin (suc (suc m))) (u : unit (VH.value v (s i))) : Cov v = Tr.Trunc[CovIndex v].inc (i,u) ;

 -- a vector with a unit at j is apart from one with 0 at j
 apart-coord (v w : Q2.Point) (j : I) (u : unit (v.1 j)) (zw : Id R.R (w.1 j) z)
  (e : Id Q2.Pn (Q2.class v) (Q2.class w)) : Empty =
  no-zero-unit (unit-subst (trans (Pr.happly I (\ i -> R.R) _ _ (Q2.Q.effective v w e).2 j) zw)
   (ARR.unit-product _ _ (Q2.Q.effective v w e).1.2 u)) ;

 -- the cover gives a nonzero vector apart from e_Y and e_Z
 cov-pivot1 (v : V) : (j : Fin (suc m)) -> unit (VH.value v (s1 j)) -> Pivots v = split {
  inr t -> \ u -> (TP.iY,ARR.unit-left _ _ (unit-subst (value-c v) u)) ;
  inl j -> \ u -> (TP.inner j,unit-subst (value-var v (TP.inner j)) u) } ;
 cov-pivot (v : V) : (i : Fin (suc (suc m))) -> unit (VH.value v (s i)) -> Pivots v = split {
  inr t -> \ u -> (TP.iX,unit-subst (value-var v TP.iX) u) ;
  inl j -> cov-pivot1 v j } ;
 cov-nonzero (v : V) (cv : Cov v) : Q2.NonZero v =
  Tr.Trunc[CovIndex v].induction @l (\ t -> Q2.NonZero v) (\ t -> Tr.Trunc[Pivots v].proposition)
   (\ iu -> Tr.Trunc[Pivots v].inc (cov-pivot v iu.1 iu.2)) cv ;
 point (v : V) (cv : Cov v) : Q2.Point = (v,cov-nonzero v cv) ;
 NotY (q : Q2.Pn) : U l = Not (Id Q2.Pn q (Q2.class TP.pY)) ;
 NotZ (q : Q2.Pn) : U l = Not (Id Q2.Pn q (Q2.class TP.pZ)) ;
 -- each cover index gives a coordinate where v is a unit and e_Y (resp. e_Z) is 0
 away-y1 (v : V) (cv : Cov v) : (j : Fin (suc m)) -> unit (VH.value v (s1 j)) -> NotY (Q2.class (point v cv)) = split {
  inr t -> \ u -> apart-coord (point v cv) TP.pY TP.iZ (ARR.unit-right _ _ (unit-subst (value-c v) u)) (refl z) ;
  inl j -> \ u -> apart-coord (point v cv) TP.pY (TP.inner j) (unit-subst (value-var v (TP.inner j)) u) (refl z) } ;
 away-y (v : V) (cv : Cov v) : (i : Fin (suc (suc m))) -> unit (VH.value v (s i)) -> NotY (Q2.class (point v cv)) = split {
  inr t -> \ u -> apart-coord (point v cv) TP.pY TP.iX (unit-subst (value-var v TP.iX) u) (refl z) ;
  inl j -> away-y1 v cv j } ;
 away-z1 (v : V) (cv : Cov v) : (j : Fin (suc m)) -> unit (VH.value v (s1 j)) -> NotZ (Q2.class (point v cv)) = split {
  inr t -> \ u -> apart-coord (point v cv) TP.pZ TP.iY (ARR.unit-left _ _ (unit-subst (value-c v) u)) (refl z) ;
  inl j -> \ u -> apart-coord (point v cv) TP.pZ (TP.inner j) (unit-subst (value-var v (TP.inner j)) u) (refl z) } ;
 away-z (v : V) (cv : Cov v) : (i : Fin (suc (suc m))) -> unit (VH.value v (s i)) -> NotZ (Q2.class (point v cv)) = split {
  inr t -> \ u -> apart-coord (point v cv) TP.pZ TP.iX (unit-subst (value-var v TP.iX) u) (refl z) ;
  inl j -> away-z1 v cv j } ;
 empty-prop (q : Q2.Pn) : Pr.isProp (NotY q) = \ a b -> F.funext (Id Q2.Pn q (Q2.class TP.pY)) (\ e -> Empty) a b (\ e -> efq (a e)) ;
 emptyz-prop (q : Q2.Pn) : Pr.isProp (NotZ q) = \ a b -> F.funext (Id Q2.Pn q (Q2.class TP.pZ)) (\ e -> Empty) a b (\ e -> efq (a e)) ;
 cov-not-y (v : V) (cv : Cov v) : NotY (Q2.class (point v cv)) =
  Tr.Trunc[CovIndex v].induction @l (\ t -> NotY (Q2.class (point v cv))) (\ t -> empty-prop _) (\ iu -> away-y v cv iu.1 iu.2) cv ;
 cov-not-z (v : V) (cv : Cov v) : NotZ (Q2.class (point v cv)) =
  Tr.Trunc[CovIndex v].induction @l (\ t -> NotZ (Q2.class (point v cv))) (\ t -> emptyz-prop _) (\ iu -> away-z v cv iu.1 iu.2) cv ;

 -- conversely, apart from e_Y and e_Z gives the cover
 simp (p q : R.R) : Id R.R (CR.sub (mul o p) (mul z q)) p =
  trans (CR.cong-add (trans (mulC o p) (mulO p)) (trans (ap neg (zero-mul q)) neg-zero)) (addZ p) ;
 minor-y (x : Q2.Point) (b : I) : R.R = TP.minor TP.eY x.1 TP.iY b ;
 minor-z (x : Q2.Point) (b : I) : R.R = TP.minor TP.eZ x.1 TP.iZ b ;
 Either (x : Q2.Point) (j : I) : U l = Plus (Cov x.1) (unit (x.1 j)) ;
 from-y (x : Q2.Point) : (b : I) -> unit (minor-y x b) -> Either x TP.iZ =
  TP.cases (\ b -> unit (minor-y x b) -> Either x TP.iZ)
   (\ u -> inl (cov-inc x.1 (inr tt) (unit-subst (sym (value-var x.1 TP.iX)) (unit-subst (simp (x.1 TP.iX) (x.1 TP.iY)) u))))
   (\ u -> efq (no-zero-unit (unit-subst (addN (mul o (x.1 TP.iY))) u)))
   (\ u -> inr (unit-subst (simp (x.1 TP.iZ) (x.1 TP.iY)) u))
   (\ j u -> inl (cov-inc x.1 (inl (inl j)) (unit-subst (sym (value-var x.1 (TP.inner j))) (unit-subst (simp (x.1 (TP.inner j)) (x.1 TP.iY)) u)))) ;
 from-z (x : Q2.Point) : (b : I) -> unit (minor-z x b) -> Either x TP.iY =
  TP.cases (\ b -> unit (minor-z x b) -> Either x TP.iY)
   (\ u -> inl (cov-inc x.1 (inr tt) (unit-subst (sym (value-var x.1 TP.iX)) (unit-subst (simp (x.1 TP.iX) (x.1 TP.iZ)) u))))
   (\ u -> inr (unit-subst (simp (x.1 TP.iY) (x.1 TP.iZ)) u))
   (\ u -> efq (no-zero-unit (unit-subst (addN (mul o (x.1 TP.iZ))) u)))
   (\ j u -> inl (cov-inc x.1 (inl (inl j)) (unit-subst (sym (value-var x.1 (TP.inner j))) (unit-subst (simp (x.1 (TP.inner j)) (x.1 TP.iZ)) u)))) ;
 both (x : Q2.Point) (uy : unit (x.1 TP.iY)) (uz : unit (x.1 TP.iZ)) : Cov x.1 =
  cov-inc x.1 (inl (inr tt)) (unit-subst (sym (value-c x.1)) (ARR.unit-product _ _ uy uz)) ;
 combine (x : Q2.Point) : Either x TP.iZ -> Either x TP.iY -> Cov x.1 = split {
  inl cv -> \ e -> cv ;
  inr uz -> split { inl cv -> cv ; inr uy -> both x uy uz } } ;
 ne-to-cov (x : Q2.Point) (ny : NotY (Q2.class x)) (nz : NotZ (Q2.class x)) : Cov x.1 =
  Tr.Trunc[(b : I) * unit (minor-y x b)].induction @l (\ t -> Cov x.1) (\ t -> Tr.Trunc[CovIndex x.1].proposition)
   (\ by -> Tr.Trunc[(b : I) * unit (minor-z x b)].induction @l (\ t -> Cov x.1) (\ t -> Tr.Trunc[CovIndex x.1].proposition)
     (\ bz -> combine x (from-y x by.1 by.2) (from-z x bz.1 bz.2))
     (TP.Apart[TP.pZ,x,\ e -> nz (sym e),(TP.iZ,TP.one-unit)].result))
   (TP.Apart[TP.pY,x,\ e -> ny (sym e),(TP.iY,TP.one-unit)].result) ;

 -- functions on W are constant
 W : U l = (q : Q2.Pn) * NotY q * NotZ q ;
 w-eq (a b : W) (h : Id Q2.Pn a.1 b.1) : Id W a b =
  Pr.Sigma-eq Q2.Pn (\ q -> NotY q * NotZ q) a.1 b.1 a.2 b.2 h
   (Pr.isProp-Sigma (NotY b.1) (\ e -> NotZ b.1) (empty-prop b.1) (\ e -> emptyz-prop b.1)) ;
 module Constant (f : W -> R.R) {
  at (v : V) (cv : Cov v) : W = (Q2.class (point v cv),cov-not-y v cv,cov-not-z v cv) ;
  phi (v : VH.Open) : R.R = f (at v.1 v.2) ;
  psi : V -> R.R = VH.extend phi ;
  on-open (v : VH.Open) : Id R.R (psi v.1) (phi v) = VH.extend-restrict phi v ;
  module Along (v : VH.Open) {
   x : Q2.Point = point v.1 v.2 ;
   g (t : R.R) : R.R = CR.sub (psi (Q2.scale t v.1)) (psi v.1) ;
   module Scaled (u : R.R) (hu : unit u) {
    x' : Q2.Point = (Q2.scale u v.1,Q2.nonzero-scale (u,hu) v.1 x.2) ;
    same : Id Q2.Pn (Q2.class x') (Q2.class x) = sym (Q2.Q.relates x x' ((u,hu),refl (Q2.scale u v.1))) ;
    cv' : Cov x'.1 = ne-to-cov x' (\ e -> cov-not-y v.1 v.2 (trans (sym same) e)) (\ e -> cov-not-z v.1 v.2 (trans (sym same) e)) ;
    result : Id R.R (g u) z =
     trans (Pr.ap R.R R.R (\ t -> CR.sub t (psi v.1)) (psi x'.1) (psi v.1)
       (trans (on-open (x'.1,cv'))
        (trans (ap f (w-eq (at x'.1 cv') (at v.1 v.2) (trans (ap Q2.class (Q2.point-eq (point x'.1 cv') x' (refl x'.1))) same)))
         (sym (on-open v)))))
      (addN (psi v.1)) ;
   } ;
   origin : Id R.R (psi (Q2.scale z v.1)) (psi v.1) =
    ARR.difference-zero _ _ (ProjectiveFunctions[l].Over[R,setR,sqc].UnitZero[g,\ u hu -> Scaled[u,hu].result].result z) ;
   result : Id R.R (phi v) (psi (\ i -> z)) =
    trans (sym (on-open v)) (trans (sym origin) (ap psi (Q2.vector-eq _ _ (\ i -> zero-mul (v.1 i))))) ;
  } ;
  value : R.R = psi (\ i -> z) ;
  at-class (x : Q2.Point) (ny : NotY (Q2.class x)) (nz : NotZ (Q2.class x)) : Id R.R (f (Q2.class x,ny,nz)) value =
   trans (ap f (w-eq (Q2.class x,ny,nz) (at x.1 (ne-to-cov x ny nz)) (ap Q2.class (Q2.point-eq x (point x.1 (ne-to-cov x ny nz)) (refl x.1)))))
    (Along[(x.1,ne-to-cov x ny nz)].result) ;
  constant-value (w : W) : Id R.R (f w) value =
   Q2.Q.induction @l (\ q -> (ny : NotY q) (nz : NotZ q) -> Id R.R (f (q,ny,nz)) value)
    (\ q -> F.isProp-Pi (NotY q) (\ ny -> (nz : NotZ q) -> Id R.R (f (q,ny,nz)) value)
      (\ ny -> F.isProp-Pi (NotZ q) (\ nz -> Id R.R (f (q,ny,nz)) value) (\ nz -> setR _ _)))
    at-class w.1 w.2.1 w.2.2 ;
 } ;
 constant (f : W -> R.R) (w w' : W) : Id R.R (f w) (f w') =
  trans (Constant[f].constant-value w) (sym (Constant[f].constant-value w')) ;
} ;
