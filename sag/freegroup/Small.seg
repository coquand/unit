-- Small.seg: size (group1.pdf, for groups).  Let E be a set in U k which is
-- locally small: each Id E x y is equivalent to a type S x y in U l.
--
-- (1) Equality in F(E) is small.  (s,u) = (s',v) in F(E) iff there is
--     r : El(c + c') -> El(c + c') with [f,f'] o r = [f,f'] and
--     (r o inl) u = (r o inr) v.
--     This is a statement about a function between finite types, equalities
--     in E (replaced by S) and an equality of reduced words: it lies in U l.
--     From a link (t, m, n): let rho = [m, n] : c + c' -> t and choose, by
--     deciding on the finite type c + c', a point sel z in each nonempty
--     fibre of rho; r = sel o rho works (r o inl = sel o m, r o inr = sel o n).
--     If c + c' is empty, words over it are all equal.
-- (2) The fibre of eta over (s,u) is small: eta a = (s,u) holds iff a = s i
--     for an i with eta (s i) = (s,u).  Indeed, a link from the point stage a
--     to (s,u) gives m(gen) = n u over t, so the letter m tt occurs in n u,
--     hence m tt = n i for a generator i of u, and a = t (m tt) = t (n i) = s i.
--     The fibre is a proposition (eta is injective), equivalent to
--     || (i : El c) * (eta (s i) = (s,u)) ||, which is small by (1).
level l k ;
constraint l <= k ;
open Base ; open Prelude[k] ; open Paths[k] ; open Decisions[l] ; open Codes[l] ;
module Rep = Replacement[l,k] ; module PLK = Prelude[l \/ k] ; module TL = Truncation[l] ;

module Size (I : Interface[l,k].FinFree) (E : U k) (setE : isSet E) (ls : Rep.LocallySmall E) {
  module FG = FreeGroup[l,k].FreeGroup[I, E] ; open FG ; open CX ; open St ;
  module IJ = Injective[l,k].Injective[I, E, setE] ;

  S (a b : E) : U l = (ls a b).1 ;
  toId (a b : E) (s : S a b) : Id E a b = (ls a b).2.1 s ;
  toS (a b : E) (p : Id E a b) : S a b = (ls a b).2.2.sec p ;

  ----------------------------------------------------------------------
  -- (1) equality in F(E)

  module ID = Identification[l,k].Ident[I, E] ;
  sum (x y : Elt) : Stage = ID.sum x y ;
  SLink (x y : Elt) : U l = (r : El (sum x y).1 -> El (sum x y).1)
    * (((c : El (sum x y).1) -> S ((sum x y).2 (r c)) ((sum x y).2 c))
    * Id (Fr (sum x y).1) (push x.1.1 (sum x y).1 (\ i -> r (inl i)) x.2) (push y.1.1 (sum x y).1 (\ j -> r (inr j)) y.2)) ;
  SEq (x y : Elt) : U l = TL.Trunc[SLink x y].carrier ;

  -- S and Id E agree
  slink-rlink (x y : Elt) (L : SLink x y) : ID.RLink x y =
    (L.1, (\ c -> toId ((sum x y).2 (L.1 c)) ((sum x y).2 c) (L.2.1 c), L.2.2)) ;
  rlink-slink (x y : Elt) (L : ID.RLink x y) : SLink x y =
    (L.1, (\ c -> toS ((sum x y).2 (L.1 c)) ((sum x y).2 c) (L.2.1 c), L.2.2)) ;

  eq-of (x y : Elt) (s : SEq x y) : Id F (Q.inc x) (Q.inc y) =
    TL.Trunc[SLink x y].induction @k (\ u -> Id F (Q.inc x) (Q.inc y)) (\ u -> Q.set (Q.inc x) (Q.inc y))
      (\ L -> ID.eq-of x y (Truncation[k].Trunc[ID.RLink x y].inc (slink-rlink x y L))) s ;
  of-eq (x y : Elt) (p : Id F (Q.inc x) (Q.inc y)) : SEq x y =
    Truncation[k].Trunc[ID.RLink x y].induction @k (\ u -> SEq x y) (\ u -> TL.Trunc[SLink x y].proposition)
      (\ L -> TL.Trunc[SLink x y].inc (rlink-slink x y L)) (ID.of-eq x y p) ;

  -- Theorem (1)
  small-eq (x y : Elt) : Rep.Small (Id F (Q.inc x) (Q.inc y)) =
    (SEq x y, (eq-of x y, PLK.qinv (SEq x y) (Id F (Q.inc x) (Q.inc y)) (eq-of x y) (of-eq x y)
      (\ p -> Q.set (Q.inc x) (Q.inc y) (eq-of x y (of-eq x y p)) p)
      (\ s -> TL.Trunc[SLink x y].proposition (of-eq x y (eq-of x y s)) s))) ;

  ----------------------------------------------------------------------
  -- (2) the fibres of eta

  Fib (q : F) : U k = (a : E) * Id F (eta a) q ;
  fib-prop (q : F) : isProp (Fib q) = \ u v ->
    Sigma-eq E (\ a -> Id F (eta a) q) u.1 v.1 u.2 v.2
      (IJ.eta-inj u.1 v.1 (transH u.2 (symH v.2))) (Q.set (eta v.1) q) ;

  SFibW (y : Elt) : U l = (i : El y.1.1) * SEq (IJ.pt (y.1.2 i)) y ;
  SFib (y : Elt) : U l = TL.Trunc[SFibW y].carrier ;

  fib-of (y : Elt) (s : SFib y) : Fib (Q.inc y) =
    TL.Trunc[SFibW y].induction @k (\ u -> Fib (Q.inc y)) (\ u -> fib-prop (Q.inc y))
      (\ w -> (y.1.2 w.1, eq-of (IJ.pt (y.1.2 w.1)) y w.2)) s ;

  -- from a link of the point stage a to y: a = s i for a generator i of y
  module FromLink (a : E) (y : Elt) (p : Id F (eta a) (Q.inc y)) (L : Link (IJ.pt a) y) {
    t : Stage = L.1 ;
    m0 : El t.1 = L.2.1.1 tt ;
    -- gen m0 = n y over t
    gen-eq : Id (Fr t.1) (I.gen t.1 m0) (push y.1.1 t.1 L.2.2.1.1 y.2) = calc (Fr t.1) {
      I.gen t.1 m0 =< symH (I.push-gen fone t.1 L.2.1.1 tt) >
      push fone t.1 L.2.1.1 (I.gen fone tt) =< L.2.2.2 >
      push y.1.1 t.1 L.2.2.1.1 y.2 } ;
    pre : (i : El y.1.1) * Id (El t.1) (L.2.2.1.1 i) m0 = I.support y.1.1 t.1 L.2.2.1.1 y.2 m0 gen-eq ;
    i0 : El y.1.1 = pre.1 ;
    a-eq : Id E a (y.1.2 i0) = calc E {
      a =< symH (L.2.1.2 tt) > t.2 m0 =< apH t.2 (symH pre.2) > t.2 (L.2.2.1.1 i0) =< L.2.2.1.2 i0 > y.1.2 i0 } ;
    sfib : SFib y = TL.Trunc[SFibW y].inc (i0, of-eq (IJ.pt (y.1.2 i0)) y
      (transH (apH eta (symH a-eq)) p)) ;
  } ;
  of-fib (y : Elt) (u : Fib (Q.inc y)) : SFib y =
    rel-elim (IJ.pt u.1) y (SFib y) TL.Trunc[SFibW y].proposition
      (\ L -> FromLink[u.1, y, u.2, L].sfib) (Q.effective (IJ.pt u.1) y u.2) ;

  -- Theorem (2)
  small-fib (y : Elt) : Rep.Small (Fib (Q.inc y)) =
    (SFib y, (fib-of y, PLK.qinv (SFib y) (Fib (Q.inc y)) (fib-of y) (of-fib y)
      (\ u -> fib-prop (Q.inc y) (fib-of y (of-fib y u)) u)
      (\ s -> TL.Trunc[SFibW y].proposition (of-fib y (fib-of y s)) s))) ;

  ----------------------------------------------------------------------
  -- (1) and (2) at every element: being small is a proposition (SmallProp),
  -- and every element is merely a representative

  locally-small (p q : F) : Rep.Small (Id F p q) =
    Q.induction @(l+ \/ k) (\ p0 -> Rep.Small (Id F p0 q)) (\ p0 -> SmallProp[l,k].SmallProp[Id F p0 q].prop) (\ x ->
    Q.induction @(l+ \/ k) (\ q0 -> Rep.Small (Id F (Q.inc x) q0)) (\ q0 -> SmallProp[l,k].SmallProp[Id F (Q.inc x) q0].prop)
      (\ y -> small-eq x y) q) p ;
  small-fibres (q : F) : Rep.Small (Fib q) =
    Q.induction @(l+ \/ k) (\ q0 -> Rep.Small (Fib q0)) (\ q0 -> SmallProp[l,k].SmallProp[Fib q0].prop) small-fib q ;
} ;
