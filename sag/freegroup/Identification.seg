-- Identification.seg: equality in the colimit by one identification.
-- For x = (s,u), y = (s',v) with s + s' = (c,g):
--   [x] = [y]  iff  merely some r : El c -> El c has g o r = g and
--                   (r o inl) u = (r o inr) v.
-- From right to left, (s + s', r o inl, r o inr) is a link.  From left to
-- right, from a link (t, m, n) let rho = [m, n] : El c -> t and sigma a
-- section of rho on its image (chosen by deciding on the finite type El c);
-- r = sigma o rho.  If El c is empty, T c is trivial and r = id.
level l k ;
constraint l <= k ;
open Base ; open Prelude[k] ; open Paths[k] ; open Decisions[l] ; open Codes[l] ;
module TK = Truncation[k] ;

module Ident (I : Interface[l,k].FinFree) (X : U k) {
  module FG = FreeGroup[l,k].FreeGroup[I, X] ; open FG ; open CX ; open St ;

  -- the stage x + y
  sum (x y : Elt) : Stage = splus x.1 y.1 ;
  RLink (x y : Elt) : U k = (r : El (sum x y).1 -> El (sum x y).1)
    * (((c : El (sum x y).1) -> Id X ((sum x y).2 (r c)) ((sum x y).2 c))
    * Id (Fr (sum x y).1) (push x.1.1 (sum x y).1 (\ i -> r (inl i)) x.2) (push y.1.1 (sum x y).1 (\ j -> r (inr j)) y.2)) ;
  REq (x y : Elt) : U k = TK.Trunc[RLink x y].carrier ;

  rlink-link (x y : Elt) (L : RLink x y) : Link x y =
    (sum x y, ((\ i -> L.1 (inl i), \ i -> L.2.1 (inl i)), ((\ j -> L.1 (inr j), \ j -> L.2.1 (inr j)), L.2.2))) ;

  module Choose (x y : Elt) (L : Link x y) {
    t : Stage = L.1 ;
    c0 : FT = (sum x y).1 ;
    rho : El c0 -> El t.1 = split { inl i -> L.2.1.1 i ; inr j -> L.2.2.1.1 j } ;
    rho-tri : (c : El c0) -> Id X (t.2 (rho c)) ((sum x y).2 c) = split { inl i -> L.2.1.2 i ; inr j -> L.2.2.1.2 j } ;
    -- a point in the fibre of rho over z, if there is one
    in-fibre (z : El t.1) (c : El c0) : Bool = eqEl t.1 (rho c) z ;
    pick (d : El c0) (z : El t.1) : Decided c0 (in-fibre z) -> El c0 = split { inl w -> w.1 ; inr nn -> d } ;
    pick-spec (d : El c0) (z : El t.1) (c : El c0) (hc : Id (El t.1) (rho c) z)
      : (dd : Decided c0 (in-fibre z)) -> Id (El t.1) (rho (pick d z dd)) z = split {
      inl w -> eqEl-sound t.1 (rho w.1) z w.2 ;
      inr nn -> absurd (Id (El t.1) (rho d) z)
        (nn c (substH (\ z1 -> so (eqEl t.1 (rho c) z1)) hc (eqEl-refl t.1 (rho c)))) } ;
    sel (d : El c0) (z : El t.1) : El c0 = pick d z (decide c0 (in-fibre z)) ;

    module WithPoint (d : El c0) {
      r (c : El c0) : El c0 = sel d (rho c) ;
      r-rho (c : El c0) : Id (El t.1) (rho (r c)) (rho c) = pick-spec d (rho c) c (refl (rho c)) (decide c0 (in-fibre (rho c))) ;
      compat (c : El c0) : Id X ((sum x y).2 (r c)) ((sum x y).2 c) = calc X {
        (sum x y).2 (r c) =< symH (rho-tri (r c)) > t.2 (rho (r c))
          =< apH t.2 (r-rho c) > t.2 (rho c) =< rho-tri c > (sum x y).2 c } ;
      word : Id (Fr c0) (push x.1.1 c0 (\ i -> r (inl i)) x.2) (push y.1.1 c0 (\ j -> r (inr j)) y.2) = calc (Fr c0) {
        push x.1.1 c0 (\ i -> sel d (L.2.1.1 i)) x.2
          =< symH (I.push-comp x.1.1 t.1 c0 L.2.1.1 (sel d) x.2) >
        push t.1 c0 (sel d) (push x.1.1 t.1 L.2.1.1 x.2)
          =< apH (push t.1 c0 (sel d)) L.2.2.2 >
        push t.1 c0 (sel d) (push y.1.1 t.1 L.2.2.1.1 y.2)
          =< I.push-comp y.1.1 t.1 c0 L.2.2.1.1 (sel d) y.2 >
        push y.1.1 c0 (\ j -> sel d (L.2.2.1.1 j)) y.2 } ;
      rlink : RLink x y = (r, (compat, word)) ;
    } ;
    module NoPoint (nd : Not (El c0)) {
      rlink : RLink x y = (\ c -> c, (\ c -> refl ((sum x y).2 c),
        I.empty-prop c0 nd (push x.1.1 c0 (\ i -> inl i) x.2) (push y.1.1 c0 (\ j -> inr j) y.2))) ;
    } ;
    choose : Plus (El c0) (Not (El c0)) -> RLink x y = split {
      inl d -> WithPoint[d].rlink ; inr nd -> NoPoint[nd].rlink } ;
    rlink : RLink x y = choose (point c0) ;
  } ;


  eq-of (x y : Elt) (s : REq x y) : Id F (Q.inc x) (Q.inc y) =
    TK.Trunc[RLink x y].induction @k (\ u -> Id F (Q.inc x) (Q.inc y)) (\ u -> Q.set (Q.inc x) (Q.inc y))
      (\ L -> related x y (rlink-link x y L)) s ;
  of-eq (x y : Elt) (p : Id F (Q.inc x) (Q.inc y)) : REq x y =
    rel-elim x y (REq x y) TK.Trunc[RLink x y].proposition
      (\ L -> TK.Trunc[RLink x y].inc (Choose[x, y, L].rlink)) (Q.effective x y p) ;
} ;
