-- Interface.seg: what the colimit construction uses of the free structures
-- on the finite stages.  For each code c a group T c with generators
-- gen c : El c -> T c; for each map m : El a -> El b a homomorphism
-- push m, functorial, sending generators to generators; generators are
-- distinct; a generator in push m u comes from a generator of u; over an
-- empty type T c is trivial; and the universal property of T c for the
-- target groups (all groups, or abelian groups), natural in c.
level l k ;
constraint l <= k ;
open Base ; open Prelude[k] ; open Codes[l] ;
module GL = Group[l] ; module GK = Group[k] ;

record FinFree {
  T (c : FT) : GL.Grp ;
  gen (c : FT) (i : El c) : (T c).C ;
  push (a b : FT) (m : El a -> El b) (u : (T a).C) : (T b).C ;
  push-mul (a b : FT) (m : El a -> El b) (u v : (T a).C)
    : Id (T b).C (push a b m ((T a).mul u v)) ((T b).mul (push a b m u) (push a b m v)) ;
  push-comp (a b c : FT) (m : El a -> El b) (n : El b -> El c) (u : (T a).C)
    : Id (T c).C (push b c n (push a b m u)) (push a c (\ i -> n (m i)) u) ;
  push-id (a : FT) (u : (T a).C) : Id (T a).C (push a a (\ i -> i) u) u ;
  push-ext (a b : FT) (m m' : El a -> El b) (h : (i : El a) -> Id (El b) (m i) (m' i)) (u : (T a).C)
    : Id (T b).C (push a b m u) (push a b m' u) ;
  push-gen (a b : FT) (m : El a -> El b) (i : El a) : Id (T b).C (push a b m (gen a i)) (gen b (m i)) ;
  gen-inj (c : FT) (i j : El c) (p : Id (T c).C (gen c i) (gen c j)) : Id (El c) i j ;
  support (a b : FT) (m : El a -> El b) (u : (T a).C) (j : El b) (p : Id (T b).C (gen b j) (push a b m u))
    : (i : El a) * Id (El b) (m i) j ;
  empty-prop (c : FT) (n : Not (El c)) : isProp (T c).C ;

  Target (G : GK.Grp) : U k ;
  lift (c : FT) (G : GK.Grp) (tG : Target G) (f : El c -> G.C) (u : (T c).C) : G.C ;
  lift-mul (c : FT) (G : GK.Grp) (tG : Target G) (f : El c -> G.C) (u v : (T c).C)
    : Id G.C (lift c G tG f ((T c).mul u v)) (G.mul (lift c G tG f u) (lift c G tG f v)) ;
  lift-gen (c : FT) (G : GK.Grp) (tG : Target G) (f : El c -> G.C) (i : El c)
    : Id G.C (lift c G tG f (gen c i)) (f i) ;
  lift-unique (c : FT) (G : GK.Grp) (tG : Target G) (f : El c -> G.C) (psi : (T c).C -> G.C)
    (hom : (u v : (T c).C) -> Id G.C (psi ((T c).mul u v)) (G.mul (psi u) (psi v)))
    (on-gen : (i : El c) -> Id G.C (psi (gen c i)) (f i)) (u : (T c).C) : Id G.C (psi u) (lift c G tG f u) ;
  lift-push (a b : FT) (m : El a -> El b) (G : GK.Grp) (tG : Target G) (f : El b -> G.C) (u : (T a).C)
    : Id G.C (lift b G tG f (push a b m u)) (lift a G tG (\ i -> f (m i)) u) ;
} ;
