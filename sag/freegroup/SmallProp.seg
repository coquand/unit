-- SmallProp.seg: being small is a proposition (by univalence for U l).
-- Small B = (X : U l) * (X ~ B).  Given (X, e) and (X', e'), the map
-- d = e'^-1 o e : X ~ X' has e' o d = e; by induction on the equivalence d
-- (univalence), it suffices to take X' = X and d = id, where e' = e because
-- equivalences with the same map are equal (being an equivalence is a
-- proposition, EquivProp).
level l k ;
constraint l <= k ;
open Base ;
module Rep = Replacement[l,k] ; module P = Prelude[l \/ k] ; module PL = Prelude[l] ;
module PH = Paths[l \/ k] ; module PU = Prelude[l+ \/ k] ;
module UL = Axioms[l].UnivalenceLemmas[univ @l] ; module FE = Axioms[l \/ k].FunExtLemmas[fe @(l \/ k)] ;

module SmallProp (B : U k) {
  -- two equivalences into B with the same map are equal
  equiv-eq (X : U l) (e e' : P.Equiv X B) (h : (x : X) -> Id B (e.1 x) (e'.1 x)) : Id (P.Equiv X B) e e' =
    P.Sigma-eq (X -> B) (\ g -> P.isEquiv X B g) e.1 e'.1 e.2 e'.2 (FE.funext X (\ x -> B) e.1 e'.1 h)
      (EquivProp[l \/ k].isEquiv-prop X B e'.1) ;

  -- induction on equivalences, with a motive in U (l+ \/ k)
  eqind (T : U l) (M : (T' : U l) -> PL.Equiv T T' -> U (l+ \/ k)) (d : M T (PL.idEquiv T))
    (T' : U l) (e : PL.Equiv T T') : M T' e =
    PU.subst (PL.Equiv T T') (M T') (Axioms[l].idtoeqv T T' (UL.ua T T' e)) e ((univ @l T T').sec-eq e)
      (idJ (U l) T (\ Y q -> M Y (Axioms[l].idtoeqv T Y q)) d T' (UL.ua T T' e)) ;

  module At (u : Rep.Small B) {
    Mot (X' : U l) (d : PL.Equiv u.1 X') : U (l+ \/ k) =
      (e' : P.Equiv X' B) -> ((x : u.1) -> Id B (e'.1 (d.1 x)) (u.2.1 x)) -> Id (Rep.Small B) u (X', e') ;
    base : Mot u.1 (PL.idEquiv u.1) = \ e' h ->
      PU.ap (P.Equiv u.1 B) (Rep.Small B) (\ e0 -> (u.1, e0)) u.2 e' (equiv-eq u.1 u.2 e' (\ x -> PH.symH (h x))) ;
    -- d = e'^-1 o e
    fwd (v : Rep.Small B) (x : u.1) : v.1 = v.2.2.sec (u.2.1 x) ;
    bwd (v : Rep.Small B) (y : v.1) : u.1 = u.2.2.sec (v.2.1 y) ;
    fb (v : Rep.Small B) (y : v.1) : Id v.1 (fwd v (bwd v y)) y = PH.transH
      (PH.apH (\ b -> v.2.2.sec b) (u.2.2.sec-eq (v.2.1 y))) (P.sec-ret v.1 B v.2.1 v.2.2 y) ;
    bf (v : Rep.Small B) (x : u.1) : Id u.1 (bwd v (fwd v x)) x = PH.transH
      (PH.apH (\ b -> u.2.2.sec b) (v.2.2.sec-eq (u.2.1 x))) (P.sec-ret u.1 B u.2.1 u.2.2 x) ;
    d (v : Rep.Small B) : PL.Equiv u.1 v.1 = (fwd v, PL.qinv u.1 v.1 (fwd v) (bwd v) (fb v) (bf v)) ;
    path (v : Rep.Small B) : Id (Rep.Small B) u v =
      eqind u.1 Mot base v.1 (d v) v.2 (\ x -> v.2.2.sec-eq (u.2.1 x)) ;
  } ;
  prop : PU.isProp (Rep.Small B) = \ u v -> At[u].path v ;
} ;
