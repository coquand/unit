-- Multiples.seg: integer multiples n.g in an abelian group,
--   pos n . g = g + .. + g (n times),   negsuc n . g = -((n+1) . g),
-- with (x + y).g = x.g + y.g (from (suc x).g = g + x.g and
-- (pred x).g = -g + x.g, by induction along the definition of x + y),
-- multiples of a finite sum, and: a homomorphism chi : Z -> G is
-- n |-> n.(chi 1).
level l k ;
constraint l <= k ;
open Base ; open Prelude[k] ; open Paths[k] ; open Codes[l] ;
module Z = Integers[l] ;
oneZ : Z.Int = Z.sucZ Z.zeroZ ;
-- the constructors of Z as functions
module ZC { open Integers[l] ; posZ (n : Nat) : Int = pos n ; negZ (n : Nat) : Int = negsuc n ; } ;

module Mult (G : Torsor[k].Ab) {
  open G ;
  module GL0 = Torsor[k].AbL[G] ;
  module SG = FinSum[l,k].Sums[G] ;
  module SZ = FinSum[l,l].Sums[Z.intAb] ;

  -- a + b = o gives b = -a
  inv-unique (a b : A) (h : Id A (add a b) o) : Id A b (inv a) = calc A {
    b =< symH (unitr b) > add b o
      =< apH (add b) (symH (invr a)) > add b (add a (inv a))
      =< symH (assoc b a (inv a)) > add (add b a) (inv a)
      =< apH (\ t -> add t (inv a)) (comm b a) > add (add a b) (inv a)
      =< apH (\ t -> add t (inv a)) h > add o (inv a)
      =< GL0.unitl (inv a) > inv a } ;
  inv-add (x y : A) : Id A (inv (add x y)) (add (inv x) (inv y)) = symH (inv-unique (add x y) (add (inv x) (inv y)) (calc A {
    add (add x y) (add (inv x) (inv y)) =< SG.interchange x y (inv x) (inv y) >
    add (add x (inv x)) (add y (inv y)) =< SG.add-cong (add x (inv x)) o (add y (inv y)) o (invr x) (invr y) >
    add o o =< unitr o > o })) ;
  -- x + (y + z) = y + (x + z)
  left-comm (x y z : A) : Id A (add x (add y z)) (add y (add x z)) = calc A {
    add x (add y z) =< symH (assoc x y z) > add (add x y) z
      =< apH (\ t -> add t z) (comm x y) > add (add y x) z =< assoc y x z > add y (add x z) } ;
  -- x + (-x + y) = y  and  -x + (x + y) = y
  cancel (x y : A) : Id A (add x (add (inv x) y)) y = calc A {
    add x (add (inv x) y) =< symH (assoc x (inv x) y) > add (add x (inv x)) y
      =< apH (\ t -> add t y) (invr x) > add o y =< GL0.unitl y > y } ;
  cancel' (x y : A) : Id A (add (inv x) (add x y)) y = calc A {
    add (inv x) (add x y) =< symH (assoc (inv x) x y) > add (add (inv x) x) y
      =< apH (\ t -> add t y) (GL0.invl x) > add o y =< GL0.unitl y > y } ;

  multP (g : A) : Nat -> A = split { zero -> o ; suc n | r -> add g r } ;
  multZ (g : A) : Z.Int -> A = split { pos n -> multP g n ; negsuc n -> inv (multP g (suc n)) } ;

  mult-sucNeg (g : A) : (n : Nat) -> Id A (multZ g (Z.sucNeg n)) (add g (inv (multP g (suc n)))) = split {
    zero -> symH (calc A {
      add g (inv (add g o)) =< apH (\ t -> add g (inv t)) (unitr g) > add g (inv g) =< invr g > o }) ;
    suc m -> symH (calc A {
      add g (inv (add g (multP g (suc m)))) =< apH (add g) (inv-add g (multP g (suc m))) >
      add g (add (inv g) (inv (multP g (suc m)))) =< cancel g (inv (multP g (suc m))) >
      inv (multP g (suc m)) }) } ;
  mult-suc (g : A) : (x : Z.Int) -> Id A (multZ g (Z.sucZ x)) (add g (multZ g x)) = split {
    pos n -> refl (add g (multP g n)) ;
    negsuc n -> mult-sucNeg g n } ;
  mult-predPos (g : A) : (n : Nat) -> Id A (multZ g (Z.predPos n)) (add (inv g) (multP g n)) = split {
    zero -> calc A { inv (add g o) =< apH inv (unitr g) > inv g =< symH (unitr (inv g)) > add (inv g) o } ;
    suc m -> symH (cancel' g (multP g m)) } ;
  mult-pred (g : A) : (x : Z.Int) -> Id A (multZ g (Z.predZ x)) (add (inv g) (multZ g x)) = split {
    pos n -> mult-predPos g n ;
    negsuc n -> inv-add g (multP g (suc n)) } ;

  addP-case (g : A) (x : Z.Int) : (n : Nat) -> Id A (multZ g (Z.addP x n)) (add (multZ g x) (multP g n)) = split {
    zero -> symH (unitr (multZ g x)) ;
    suc n | r -> calc A {
      multZ g (Z.sucZ (Z.addP x n)) =< mult-suc g (Z.addP x n) >
      add g (multZ g (Z.addP x n)) =< apH (add g) r >
      add g (add (multZ g x) (multP g n)) =< left-comm g (multZ g x) (multP g n) >
      add (multZ g x) (add g (multP g n)) } } ;
  addN-case (g : A) (x : Z.Int) : (n : Nat) -> Id A (multZ g (Z.addN x n)) (add (multZ g x) (inv (multP g (suc n)))) = split {
    zero -> calc A {
      multZ g (Z.predZ x) =< mult-pred g x >
      add (inv g) (multZ g x) =< comm (inv g) (multZ g x) >
      add (multZ g x) (inv g) =< apH (\ t -> add (multZ g x) (inv t)) (symH (unitr g)) >
      add (multZ g x) (inv (add g o)) } ;
    suc n | r -> calc A {
      multZ g (Z.predZ (Z.addN x n)) =< mult-pred g (Z.addN x n) >
      add (inv g) (multZ g (Z.addN x n)) =< apH (add (inv g)) r >
      add (inv g) (add (multZ g x) (inv (multP g (suc n)))) =< left-comm (inv g) (multZ g x) (inv (multP g (suc n))) >
      add (multZ g x) (add (inv g) (inv (multP g (suc n)))) =< apH (add (multZ g x)) (symH (inv-add g (multP g (suc n)))) >
      add (multZ g x) (inv (add g (multP g (suc n)))) } } ;
  -- (x + y).g = x.g + y.g
  mult-add (g : A) (x : Z.Int) : (y : Z.Int) -> Id A (multZ g (Z.add x y)) (add (multZ g x) (multZ g y)) = split {
    pos n -> addP-case g x n ;
    negsuc n -> addN-case g x n } ;

  -- (sum n_i).g = sum (n_i . g)
  mult-sum (g : A) : (c : FT) -> (n : El c -> Z.Int) -> Id A (multZ g (SZ.sum c n)) (SG.sum c (\ i -> multZ g (n i))) = split {
    fzero -> \ n -> refl o ;
    fone -> \ n -> refl (multZ g (n tt)) ;
    fplus a b | ma mb -> \ n -> transH
      (mult-add g (SZ.sum a (\ i -> n (inl i))) (SZ.sum b (\ i -> n (inr i))))
      (SG.add-cong (multZ g (SZ.sum a (\ i -> n (inl i)))) (SG.sum a (\ i -> multZ g (n (inl i))))
                   (multZ g (SZ.sum b (\ i -> n (inr i)))) (SG.sum b (\ i -> multZ g (n (inr i))))
                   (ma (\ i -> n (inl i))) (mb (\ i -> n (inr i)))) } ;

  -- (if b then n else 0).g = if b then n.g else 0
  mult-ite (g : A) (n : Z.Int) : (b : Bool) -> Id A (multZ g (Decisions[l].ite Z.Int b n Z.zeroZ)) (Decisions[k].ite A b (multZ g n) o) = split {
    true -> refl (multZ g n) ; false -> refl o } ;
  mult-one (g : A) : Id A (multZ g oneZ) g = unitr g ;

  -- a homomorphism chi : Z -> A is n |-> n.(chi 1)
  module FromZ (chi : Z.Int -> A) (hom : (x y : Z.Int) -> Id A (chi (Z.add x y)) (add (chi x) (chi y))) {
    g : A = chi oneZ ;
    zero-v : Id A (chi Z.zeroZ) o = calc A {
      chi Z.zeroZ =< symH (unitr (chi Z.zeroZ)) > add (chi Z.zeroZ) o
        =< apH (add (chi Z.zeroZ)) (symH (invr (chi Z.zeroZ))) > add (chi Z.zeroZ) (add (chi Z.zeroZ) (inv (chi Z.zeroZ)))
        =< symH (assoc (chi Z.zeroZ) (chi Z.zeroZ) (inv (chi Z.zeroZ))) > add (add (chi Z.zeroZ) (chi Z.zeroZ)) (inv (chi Z.zeroZ))
        =< apH (\ t -> add t (inv (chi Z.zeroZ))) (symH (hom Z.zeroZ Z.zeroZ)) > add (chi Z.zeroZ) (inv (chi Z.zeroZ))
        =< invr (chi Z.zeroZ) > o } ;
    -- chi (suc x) = chi x + g, so chi (pred x) = chi x - g
    suc-v (x : Z.Int) : Id A (chi (Z.sucZ x)) (add (chi x) g) = hom x oneZ ;
    pred-v (x : Z.Int) : Id A (chi (Z.predZ x)) (add (chi x) (inv g)) = calc A {
      chi (Z.predZ x) =< symH (unitr (chi (Z.predZ x))) > add (chi (Z.predZ x)) o
        =< apH (add (chi (Z.predZ x))) (symH (invr g)) > add (chi (Z.predZ x)) (add g (inv g))
        =< symH (assoc (chi (Z.predZ x)) g (inv g)) > add (add (chi (Z.predZ x)) g) (inv g)
        =< apH (\ t -> add t (inv g)) (symH (suc-v (Z.predZ x))) > add (chi (Z.sucZ (Z.predZ x))) (inv g)
        =< apH (\ t -> add (chi t) (inv g)) (Z.suc-pred x) > add (chi x) (inv g) } ;
    on-pos : (n : Nat) -> Id A (chi (ZC.posZ n)) (multP g n) = split {
      zero -> zero-v ;
      suc n | r -> calc A {
        chi (Z.sucZ (ZC.posZ n)) =< suc-v (ZC.posZ n) > add (chi (ZC.posZ n)) g
          =< apH (\ t -> add t g) r > add (multP g n) g =< comm (multP g n) g > add g (multP g n) } } ;
    on-neg : (n : Nat) -> Id A (chi (ZC.negZ n)) (inv (multP g (suc n))) = split {
      zero -> calc A {
        chi (Z.predZ Z.zeroZ) =< pred-v Z.zeroZ > add (chi Z.zeroZ) (inv g)
          =< apH (\ t -> add t (inv g)) zero-v > add o (inv g) =< GL0.unitl (inv g) > inv g
          =< apH inv (symH (unitr g)) > inv (add g o) } ;
      suc n | r -> calc A {
        chi (Z.predZ (ZC.negZ n)) =< pred-v (ZC.negZ n) > add (chi (ZC.negZ n)) (inv g)
          =< apH (\ t -> add t (inv g)) r > add (inv (multP g (suc n))) (inv g)
          =< comm (inv (multP g (suc n))) (inv g) > add (inv g) (inv (multP g (suc n)))
          =< symH (inv-add g (multP g (suc n))) > inv (add g (multP g (suc n))) } } ;
    is-mult : (x : Z.Int) -> Id A (chi x) (multZ g x) = split { pos n -> on-pos n ; negsuc n -> on-neg n } ;
  } ;
} ;
