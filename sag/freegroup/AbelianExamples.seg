-- AbelianExamples.seg: three computations in the free abelian group A(E)
-- on a set E, for e0, e1, e2 in E, by the identification form of
-- AbelianEquality:
--   (1) e0 - e1 + 2 e2 = e0 + e1  iff  e1 = e2;
--   (2) the fibre of eta at e0 - e1 + e2 is || e0 = e1 or e1 = e2 ||;
--   (3) the fibre of eta at e0 - e1 + 2 e2 is empty (by the augmentation).
-- For (1) and (2): from right to left an explicit identification r of the formal variables
-- is given and its fibre sums are computed.  From left to right, from an
-- identification r: the fibre sum at w = r X is an integer expression in
-- the decidable memberships [r Z = w]; a case analysis on these shows which
-- variables share a class (if needed at a second point w'), and variables
-- in one class have the same value in E.
level l k ;
constraint l <= k ;
open Base ; open Prelude[k] ; open Paths[k] ; open Decisions[l] ; open Codes[l] ;
module AI = AbelianInstance[l,k] ; module Z = Integers[l] ; module TK = Truncation[k] ; module DK = Decisions[k] ;

one : Z.Int = AI.oneZ ;
mone : Z.Int = Z.neg AI.oneZ ;
two : Z.Int = Z.sucZ AI.oneZ ;
zero : Z.Int = Z.zeroZ ;
ite-Z (b : Bool) (n : Z.Int) : Z.Int = ite Z.Int b n zero ;

c2 : FT = fplus fone fone ;
c3 : FT = fplus fone c2 ;
x0 : El c3 = inl tt ; x1 : El c3 = inr (inl tt) ; x2 : El c3 = inr (inr tt) ;
vec2 (n0 n1 : Z.Int) : El c2 -> Z.Int = split { inl t -> n0 ; inr t -> n1 } ;
vec3 (n0 n1 n2 : Z.Int) : El c3 -> Z.Int = split { inl t -> n0 ; inr b -> vec2 n1 n2 b } ;

-- a statement on each element of a small concrete finite type
onTop (P : Top -> U k) (p : P tt) : (t : Top) -> P t = split { tt -> p } ;
on2 (P : El c2 -> U k) (p0 : P (inl tt)) (p1 : P (inr tt)) : (z : El c2) -> P z = split {
  inl t -> onTop (\ t' -> P (inl t')) p0 t ; inr t -> onTop (\ t' -> P (inr t')) p1 t } ;
on3 (P : El c3 -> U k) (p0 : P x0) (p1 : P x1) (p2 : P x2) : (z : El c3) -> P z = split {
  inl t -> onTop (\ t' -> P (inl t')) p0 t ; inr b -> on2 (\ b' -> P (inr b')) p1 p2 b } ;
on32 (P : El (fplus c3 c2) -> U k) (p0 : P (inl x0)) (p1 : P (inl x1)) (p2 : P (inl x2)) (q0 : P (inr (inl tt))) (q1 : P (inr (inr tt)))
  : (z : El (fplus c3 c2)) -> P z = split {
  inl a -> on3 (\ a' -> P (inl a')) p0 p1 p2 a ; inr b -> on2 (\ b' -> P (inr b')) q0 q1 b } ;
on13 (P : El (fplus fone c3) -> U k) (q : P (inl tt)) (p0 : P (inr x0)) (p1 : P (inr x1)) (p2 : P (inr x2))
  : (z : El (fplus fone c3)) -> P z = split {
  inl t -> onTop (\ t' -> P (inl t')) q t ; inr a -> on3 (\ a' -> P (inr a')) p0 p1 p2 a } ;

-- the shape of a fibre sum, in the memberships
E1 (b0 b1 b2 c0 c1 : Bool) : U l =
  Id Z.Int (Z.add (ite-Z b0 one) (Z.add (ite-Z b1 mone) (ite-Z b2 two))) (Z.add (ite-Z c0 one) (ite-Z c1 one)) ;
EF (n2 : Z.Int) (bY b0 b1 b2 : Bool) : U l =
  Id Z.Int (ite-Z bY one) (Z.add (ite-Z b0 one) (Z.add (ite-Z b1 mone) (ite-Z b2 n2))) ;
subst4 (P : Bool -> Bool -> Bool -> Bool -> U l) (a0 a1 a2 a3 v0 v1 v2 v3 : Bool)
  (p0 : Id Bool a0 v0) (p1 : Id Bool a1 v1) (p2 : Id Bool a2 v2) (p3 : Id Bool a3 v3) (h : P a0 a1 a2 a3) : P v0 v1 v2 v3 =
  substH (\ b -> P v0 v1 v2 b) p3 (substH (\ b -> P v0 v1 b a3) p2 (substH (\ b -> P v0 b a2 a3) p1 (substH (\ b -> P b a1 a2 a3) p0 h))) ;

module Ex (E : U k) (setE : isSet E) (e0 e1 e2 : E) {
  module AQ = AbelianEquality[l,k].AbEq[E] ; open AQ ; open ID ; open FG ; open CX ; open St ;

  val2 (a b : E) : El c2 -> E = split { inl t -> a ; inr t -> b } ;
  val3 : El c3 -> E = split { inl t -> e0 ; inr b -> val2 e1 e2 b } ;
  el3 (n2 : Z.Int) : Elt = ((c3, val3), vec3 one mone n2) ;
  el2 : Elt = ((c2, val2 e0 e1), vec2 one one) ;
  pt (a : E) : Elt = (spoint a, AI.gen fone tt) ;

  -- facts on an identification
  module On (x y : Elt) (L : ALink x y) {
    b (z w : El (cc x y)) : Bool = eqEl (cc x y) (L.1 z) w ;
    in-w (z w : El (cc x y)) (e : Id Bool (b z w) true) : Id (El (cc x y)) (L.1 z) w =
      eqEl-sound (cc x y) (L.1 z) w (so-true (b z w) e) ;
    same (z z' : El (cc x y)) (h : Id (El (cc x y)) (L.1 z) (L.1 z')) : Id E (g x y z) (g x y z') = calc E {
      g x y z =< symH (L.2.1 z) > g x y (L.1 z) =< apH (g x y) h > g x y (L.1 z') =< L.2.1 z' > g x y z' } ;
    -- two variables in the class of w
    same-w (z z' w : El (cc x y)) (e : Id Bool (b z w) true) (e' : Id Bool (b z' w) true) : Id E (g x y z) (g x y z') =
      same z z' (calc (El (cc x y)) { L.1 z =< in-w z w e > w =< symH (in-w z' w e') > L.1 z' }) ;
    self (z : El (cc x y)) : Id Bool (b z (L.1 z)) true = DiscreteL[disc (cc x y)].eq-self (L.1 z) ;
    flip (z z' : El (cc x y)) (e : Id Bool (b z (L.1 z')) false) : Id Bool (b z' (L.1 z)) false =
      transH (eqEl-sym (cc x y) (L.1 z') (L.1 z)) e ;
    -- b z w = b z' w when z, z' are in the class of w0
    shift (z z' w : El (cc x y)) (h : Id (El (cc x y)) (L.1 z) (L.1 z')) : Id Bool (b z w) (b z' w) =
      apH (\ t -> eqEl (cc x y) t w) h ;
  } ;

  ----------------------------------------------------------------------
  -- (1)  e0 - e1 + 2 e2 = e0 + e1  iff  e1 = e2

  X0 : El (fplus c3 c2) = inl x0 ; X1 : El (fplus c3 c2) = inl x1 ; X2 : El (fplus c3 c2) = inl x2 ;
  Y0 : El (fplus c3 c2) = inr (inl tt) ; Y1 : El (fplus c3 c2) = inr (inr tt) ;

  -- X0, Y0 |-> X0 and X1, X2, Y1 |-> X1
  r1-l : El c3 -> El (fplus c3 c2) = split { inl t -> X0 ; inr b -> X1 } ;
  r1-r : El c2 -> El (fplus c3 c2) = split { inl t -> X0 ; inr t -> X1 } ;
  r1 : El (fplus c3 c2) -> El (fplus c3 c2) = split { inl a -> r1-l a ; inr b -> r1-r b } ;
  compat1 (h12 : Id E e1 e2) : (z : El (fplus c3 c2)) -> Id E (g (el3 two) el2 (r1 z)) (g (el3 two) el2 z) =
    on32 (\ z -> Id E (g (el3 two) el2 (r1 z)) (g (el3 two) el2 z)) (refl e0) (refl e1) h12 (refl e0) (refl e1) ;
  classes1 : Classes (el3 two) el2 r1 =
    on32 (\ w -> Id Z.Int (AI.push c3 (fplus c3 c2) (\ i -> r1 (inl i)) (vec3 one mone two) w)
                          (AI.push c2 (fplus c3 c2) (\ j -> r1 (inr j)) (vec2 one one) w))
      (refl one) (refl one) (refl zero) (refl zero) (refl zero) ;
  ex1-back (h12 : Id E e1 e2) : Id F (Q.inc (el3 two)) (Q.inc el2) =
    eq-of-alink (el3 two) el2 (TK.Trunc[ALink (el3 two) el2].inc (r1, (compat1 h12, classes1))) ;

  con1 : (b1 b2 c1 : Bool) -> Id Bool b1 false -> Id Bool b2 true -> Id Bool c1 false -> (b0 c0 : Bool) -> E1 b0 b1 b2 c0 c1 -> Empty = split {
    true -> \ b2 c1 p q s b0 c0 h -> absurd Empty (so-false true p tt) ;
    false -> split {
      true -> split {
        true -> \ p q s b0 c0 h -> absurd Empty (so-false true s tt) ;
        false -> \ p q s -> split {
          true -> split {
            true -> \ h -> Z.encode (Z.add (ite-Z true one) (Z.add (ite-Z false mone) (ite-Z true two))) (Z.add (ite-Z true one) (ite-Z false one)) h ;
            false -> \ h -> Z.encode (Z.add (ite-Z true one) (Z.add (ite-Z false mone) (ite-Z true two))) (Z.add (ite-Z false one) (ite-Z false one)) h } ;
          false -> split {
            true -> \ h -> Z.encode (Z.add (ite-Z false one) (Z.add (ite-Z false mone) (ite-Z true two))) (Z.add (ite-Z true one) (ite-Z false one)) h ;
            false -> \ h -> Z.encode (Z.add (ite-Z false one) (Z.add (ite-Z false mone) (ite-Z true two))) (Z.add (ite-Z false one) (ite-Z false one)) h } } } ;
      false -> \ c1 p q s b0 c0 h -> absurd Empty (so-true false q) } } ;

  from1 (L : ALink (el3 two) el2) : Id E e1 e2 =
    DK.cases (\ bb -> Id E e1 e2) (On[el3 two, el2, L].b X1 (L.1 X2))
      (\ e -> On[el3 two, el2, L].same-w X1 X2 (L.1 X2) e (On[el3 two, el2, L].self X2))
      (\ f1 -> DK.cases (\ bb -> Id E e1 e2) (On[el3 two, el2, L].b Y1 (L.1 X2))
        (\ e -> On[el3 two, el2, L].same-w Y1 X2 (L.1 X2) e (On[el3 two, el2, L].self X2))
        (\ g1 -> absurd (Id E e1 e2)
          (con1 (On[el3 two, el2, L].b X1 (L.1 X2)) (On[el3 two, el2, L].b X2 (L.1 X2)) (On[el3 two, el2, L].b Y1 (L.1 X2))
             f1 (On[el3 two, el2, L].self X2) g1
             (On[el3 two, el2, L].b X0 (L.1 X2)) (On[el3 two, el2, L].b Y0 (L.1 X2)) (L.2.2 (L.1 X2))))) ;
  ex1-fwd (p : Id F (Q.inc (el3 two)) (Q.inc el2)) : Id E e1 e2 =
    TK.Trunc[ALink (el3 two) el2].induction @k (\ u -> Id E e1 e2) (\ u -> setE e1 e2) from1 (alink-of-eq (el3 two) el2 p) ;

  ----------------------------------------------------------------------
  -- fibres of eta

  Fib (q : F) : U k = (a : E) * Id F (eta a) q ;
  fib-prop (q : F) : isProp (Fib q) = \ u v ->
    Sigma-eq E (\ a -> Id F (eta a) q) u.1 v.1 u.2 v.2
      (Injective[l,k].Injective[AI.abelian, E, setE].eta-inj u.1 v.1 (transH u.2 (symH v.2))) (Q.set (eta v.1) q) ;

  Y : El (fplus fone c3) = inl tt ;
  Z0 : El (fplus fone c3) = inr x0 ; Z1 : El (fplus fone c3) = inr x1 ; Z2 : El (fplus fone c3) = inr x2 ;

  -- the fibre sum at w, as a function of the memberships
  at (n2 : Z.Int) (a : E) (L : ALink (pt a) (el3 n2)) (w : El (fplus fone c3)) (vY v0 v1 v2 : Bool)
    (pY : Id Bool (On[pt a, el3 n2, L].b Y w) vY) (p0 : Id Bool (On[pt a, el3 n2, L].b Z0 w) v0)
    (p1 : Id Bool (On[pt a, el3 n2, L].b Z1 w) v1) (p2 : Id Bool (On[pt a, el3 n2, L].b Z2 w) v2) : EF n2 vY v0 v1 v2 =
    subst4 (EF n2) (On[pt a, el3 n2, L].b Y w) (On[pt a, el3 n2, L].b Z0 w) (On[pt a, el3 n2, L].b Z1 w) (On[pt a, el3 n2, L].b Z2 w)
      vY v0 v1 v2 pY p0 p1 p2 (L.2.2 w) ;
  -- the contradictions
  ne (x y : Z.Int) (h : Id Z.Int x y) : Z.code x y = Z.encode x y h ;

  ----------------------------------------------------------------------
  -- (2)  the fibre at e0 - e1 + e2 is || e0 = e1 or e1 = e2 ||

  Or : U k = DK.Plus (Id E e0 e1) (Id E e1 e2) ;
  -- e1 = e2: eta e0 is the sum, by  Y, X0 |-> X0  and  X1, X2 |-> X1
  rA-r : El c3 -> El (fplus fone c3) = split { inl t -> Z0 ; inr b -> Z1 } ;
  rA : El (fplus fone c3) -> El (fplus fone c3) = split { inl t -> Z0 ; inr b -> rA-r b } ;
  compatA (h12 : Id E e1 e2) : (z : El (fplus fone c3)) -> Id E (g (pt e0) (el3 one) (rA z)) (g (pt e0) (el3 one) z) =
    on13 (\ z -> Id E (g (pt e0) (el3 one) (rA z)) (g (pt e0) (el3 one) z)) (refl e0) (refl e0) (refl e1) h12 ;
  classesA : Classes (pt e0) (el3 one) rA =
    on13 (\ w -> Id Z.Int (AI.push fone (fplus fone c3) (\ i -> rA (inl i)) (AI.gen fone tt) w)
                          (AI.push c3 (fplus fone c3) (\ j -> rA (inr j)) (vec3 one mone one) w))
      (refl zero) (refl one) (refl zero) (refl zero) ;
  -- e0 = e1: eta e2 is the sum, by  X0, X1 |-> X0  and  Y, X2 |-> X2
  rB-rr : El c2 -> El (fplus fone c3) = split { inl t -> Z0 ; inr t -> Z2 } ;
  rB-r : El c3 -> El (fplus fone c3) = split { inl t -> Z0 ; inr b -> rB-rr b } ;
  rB : El (fplus fone c3) -> El (fplus fone c3) = split { inl t -> Z2 ; inr b -> rB-r b } ;
  compatB (h01 : Id E e0 e1) : (z : El (fplus fone c3)) -> Id E (g (pt e2) (el3 one) (rB z)) (g (pt e2) (el3 one) z) =
    on13 (\ z -> Id E (g (pt e2) (el3 one) (rB z)) (g (pt e2) (el3 one) z)) (refl e2) (refl e0) h01 (refl e2) ;
  classesB : Classes (pt e2) (el3 one) rB =
    on13 (\ w -> Id Z.Int (AI.push fone (fplus fone c3) (\ i -> rB (inl i)) (AI.gen fone tt) w)
                          (AI.push c3 (fplus fone c3) (\ j -> rB (inr j)) (vec3 one mone one) w))
      (refl zero) (refl zero) (refl zero) (refl one) ;

  to-fib : Or -> Fib (Q.inc (el3 one)) = split {
    inl h01 -> (e2, eq-of-alink (pt e2) (el3 one) (TK.Trunc[ALink (pt e2) (el3 one)].inc (rB, (compatB h01, classesB)))) ;
    inr h12 -> (e0, eq-of-alink (pt e0) (el3 one) (TK.Trunc[ALink (pt e0) (el3 one)].inc (rA, (compatA h12, classesA)))) } ;
  ex2-back (t : TK.Trunc[Or].carrier) : Fib (Q.inc (el3 one)) =
    TK.Trunc[Or].induction @k (\ u -> Fib (Q.inc (el3 one))) (\ u -> fib-prop (Q.inc (el3 one))) to-fib t ;

  conEF (n2 : Z.Int) (vY v0 v1 v2 : Bool) (h : EF n2 vY v0 v1 v2)
    : Z.code (ite-Z vY one) (Z.add (ite-Z v0 one) (Z.add (ite-Z v1 mone) (ite-Z v2 n2))) =
    Z.encode (ite-Z vY one) (Z.add (ite-Z v0 one) (Z.add (ite-Z v1 mone) (ite-Z v2 n2))) h ;

  module From2 (a : E) (L : ALink (pt a) (el3 one)) {
    module O = On[pt a, el3 one, L] ;
    G : U k = TK.Trunc[Or].carrier ;
    w : El (fplus fone c3) = L.1 Y ;
    w' : El (fplus fone c3) = L.1 Z1 ;
    yes0 (h : Id E e0 e1) : G = TK.Trunc[Or].inc (inl h) ;
    yes1 (h : Id E e1 e2) : G = TK.Trunc[Or].inc (inr h) ;
    -- X0 and Y in one class, X1 and X2 not: then X2 is with X1
    case-tff (e0t : Id Bool (O.b Z0 w) true) (e1f : Id Bool (O.b Z1 w) false) : G =
      DK.cases (\ bb -> G) (O.b Z2 w')
        (\ e -> yes1 (O.same-w Z1 Z2 w' (O.self Z1) e))
        (\ e -> absurd G (conEF one false false true false (at one a L w' false false true false
            (O.flip Z1 Y e1f) (transH (O.shift Z0 Y w' (O.in-w Z0 w e0t)) (O.flip Z1 Y e1f)) (O.self Z1) e))) ;
    -- X2 and Y in one class, X0 and X1 not: then X0 is with X1
    case-fft (e1f : Id Bool (O.b Z1 w) false) (e2t : Id Bool (O.b Z2 w) true) : G =
      DK.cases (\ bb -> G) (O.b Z0 w')
        (\ e -> yes0 (O.same-w Z0 Z1 w' e (O.self Z1)))
        (\ e -> absurd G (conEF one false false true false (at one a L w' false false true false
            (O.flip Z1 Y e1f) e (O.self Z1) (transH (O.shift Z2 Y w' (O.in-w Z2 w e2t)) (O.flip Z1 Y e1f))))) ;
    result : G = DK.cases (\ bb -> G) (O.b Z0 w)
      (\ e0t -> DK.cases (\ bb -> G) (O.b Z1 w)
        (\ e1t -> yes0 (O.same-w Z0 Z1 w e0t e1t))
        (\ e1f -> DK.cases (\ bb -> G) (O.b Z2 w)
          (\ e2t -> absurd G (conEF one true true false true (at one a L w true true false true (O.self Y) e0t e1f e2t)))
          (\ e2f -> case-tff e0t e1f)))
      (\ e0f -> DK.cases (\ bb -> G) (O.b Z1 w)
        (\ e1t -> DK.cases (\ bb -> G) (O.b Z2 w)
          (\ e2t -> absurd G (conEF one true false true true (at one a L w true false true true (O.self Y) e0f e1t e2t)))
          (\ e2f -> absurd G (conEF one true false true false (at one a L w true false true false (O.self Y) e0f e1t e2f))))
        (\ e1f -> DK.cases (\ bb -> G) (O.b Z2 w)
          (\ e2t -> case-fft e1f e2t)
          (\ e2f -> absurd G (conEF one true false false false (at one a L w true false false false (O.self Y) e0f e1f e2f))))) ;
  } ;
  ex2-fwd (u : Fib (Q.inc (el3 one))) : TK.Trunc[Or].carrier =
    TK.Trunc[ALink (pt u.1) (el3 one)].induction @k (\ v -> TK.Trunc[Or].carrier) (\ v -> TK.Trunc[Or].proposition)
      (\ L -> From2[u.1, L].result) (alink-of-eq (pt u.1) (el3 one) u.2) ;

  ----------------------------------------------------------------------
  -- (3)  the fibre at e0 - e1 + 2 e2 is empty: the augmentation A(E) -> Z,
  -- every generator |-> 1, sends e0 - e1 + 2 e2 to 2 and eta a to 1

  ZG : Group[k].Grp = new Group[k].Grp[Z.Int, Z.int-set, Z.zeroZ, Z.add, Z.neg, Z.assoc,
    Z.zero-l, \ x -> refl x, Torsor[l].AbL[Z.intAb].invl, Z.invr] ;
  module Aug = Lift[l,k].Lift[AI.abelian, E, ZG, Z.comm, \ a -> one] ;
  ex3 (u : Fib (Q.inc (el3 two))) : Empty = Z.encode one two (calc Z.Int {
    one =< symH (Aug.lift-eta u.1) >
    Aug.lift (eta u.1) =< apH Aug.lift u.2 >
    Aug.lift (Q.inc (el3 two)) =< Aug.lift-beta (el3 two) >
    two }) ;
} ;
