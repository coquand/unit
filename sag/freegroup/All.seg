-- The free group on a set, as a filtered colimit of free groups on finite
-- sets; the unit is injective; with a locally small set of generators,
-- equality in the free group and the fibres of the unit are small.
import Base ; import Prelude ; import Paths ; import Axioms ; import FunExtUA ;
import Replacement ;
module Theory
 (univ : [l] Axioms[l].Univalence)
 (images : [l] [k] Replacement[l,k].Images)
 (surjections : [l] [k] [j] (Replacement[l,k].Surjectivity (images @l @k)) @j) {
 fe : [l] Axioms[l].FunExt = <l> FunExtUA[l].FE[univ @l].fe ;
 propUA : [l] Axioms[l].PropUnivalence = <l> Axioms[l].UnivalenceLemmas[univ @l].prop-univ ;
 import Truncation ; import Quotient ;
 import Decisions ; import Codes ; import Words ; import Group ; import Functor ; import Universal ; import Stages ; import Interface ; import FreeInstance ; import Colimit ; import FreeGroup ; import Lift ; import Injective ; import EquivProp ; import NatArith ; import Logic ; import Torsor ; import Integers ; import FinSum ; import Multiples ; import AbelianInstance ; import SmallProp ; import Identification ; import Small ; import Abelian ; import AbelianEquality ; import AbelianExamples ; import Theorems ;
} ;
