-- Theorems.seg: the results, for groups (instance free) and for abelian
-- groups (instance abelian).  X : U k; the finite stages are in U l.
level l k ;
constraint l <= k ;
open Base ; open Prelude[k] ; open Codes[l] ;
module GK = Group[k] ; module Rep = Replacement[l,k] ;
module FI = FreeInstance[l,k] ; module AI = AbelianInstance[l,k] ;
module FGk = FreeGroup[l,k] ;

------------------------------------------------------------------------
-- groups

-- F(X) is a group, eta : X -> F(X)
free-group (X : U k) : GK.Grp = FGk.FreeGroup[FI.free, X].FX ;
-- universal property: for every group G and f : X -> G, a homomorphism
-- lift with lift o eta = f, and every such homomorphism is lift
free-lift-mul (X : U k) (G : GK.Grp) (f : X -> G.C) (p q : (free-group X).C)
  : Id G.C (Lift[l,k].Lift[FI.free, X, G, tt, f].lift ((free-group X).mul p q))
           (G.mul (Lift[l,k].Lift[FI.free, X, G, tt, f].lift p) (Lift[l,k].Lift[FI.free, X, G, tt, f].lift q)) =
  Lift[l,k].Lift[FI.free, X, G, tt, f].lift-mul p q ;
free-lift-eta (X : U k) (G : GK.Grp) (f : X -> G.C) (a : X)
  : Id G.C (Lift[l,k].Lift[FI.free, X, G, tt, f].lift (FGk.FreeGroup[FI.free, X].eta a)) (f a) =
  Lift[l,k].Lift[FI.free, X, G, tt, f].lift-eta a ;
free-lift-unique (X : U k) (G : GK.Grp) (f : X -> G.C) (psi : (free-group X).C -> G.C)
  (hom : (p q : (free-group X).C) -> Id G.C (psi ((free-group X).mul p q)) (G.mul (psi p) (psi q)))
  (on-eta : (a : X) -> Id G.C (psi (FGk.FreeGroup[FI.free, X].eta a)) (f a)) (p : (free-group X).C)
  : Id G.C (psi p) (Lift[l,k].Lift[FI.free, X, G, tt, f].lift p) =
  Lift[l,k].Lift[FI.free, X, G, tt, f].Unique[psi, hom, on-eta].unique p ;
-- eta is injective
free-eta-inj (X : U k) (setX : isSet X) (a b : X)
  (p : Id (free-group X).C (FGk.FreeGroup[FI.free, X].eta a) (FGk.FreeGroup[FI.free, X].eta b)) : Id X a b =
  Injective[l,k].Injective[FI.free, X, setX].eta-inj a b p ;
-- group1.pdf: for E locally small, F(E) is locally small and eta has small fibres
free-locally-small (E : U k) (setE : isSet E) (ls : Rep.LocallySmall E) (p q : (free-group E).C)
  : Rep.Small (Id (free-group E).C p q) = Small[l,k].Size[FI.free, E, setE, ls].locally-small p q ;
free-small-fibres (E : U k) (setE : isSet E) (ls : Rep.LocallySmall E) (q : (free-group E).C)
  : Rep.Small ((a : E) * Id (free-group E).C (FGk.FreeGroup[FI.free, E].eta a) q) =
  Small[l,k].Size[FI.free, E, setE, ls].small-fibres q ;

------------------------------------------------------------------------
-- abelian groups

ab-group (X : U k) : GK.Grp = FGk.FreeGroup[AI.abelian, X].FX ;
ab-comm (X : U k) : AI.Target (ab-group X) = Abelian[l,k].AbelianFree[X].target ;
ab-lift-eta (X : U k) (G : GK.Grp) (tG : AI.Target G) (f : X -> G.C) (a : X)
  : Id G.C (Lift[l,k].Lift[AI.abelian, X, G, tG, f].lift (FGk.FreeGroup[AI.abelian, X].eta a)) (f a) =
  Lift[l,k].Lift[AI.abelian, X, G, tG, f].lift-eta a ;
ab-lift-mul (X : U k) (G : GK.Grp) (tG : AI.Target G) (f : X -> G.C) (p q : (ab-group X).C)
  : Id G.C (Lift[l,k].Lift[AI.abelian, X, G, tG, f].lift ((ab-group X).mul p q))
           (G.mul (Lift[l,k].Lift[AI.abelian, X, G, tG, f].lift p) (Lift[l,k].Lift[AI.abelian, X, G, tG, f].lift q)) =
  Lift[l,k].Lift[AI.abelian, X, G, tG, f].lift-mul p q ;
ab-lift-unique (X : U k) (G : GK.Grp) (tG : AI.Target G) (f : X -> G.C) (psi : (ab-group X).C -> G.C)
  (hom : (p q : (ab-group X).C) -> Id G.C (psi ((ab-group X).mul p q)) (G.mul (psi p) (psi q)))
  (on-eta : (a : X) -> Id G.C (psi (FGk.FreeGroup[AI.abelian, X].eta a)) (f a)) (p : (ab-group X).C)
  : Id G.C (psi p) (Lift[l,k].Lift[AI.abelian, X, G, tG, f].lift p) =
  Lift[l,k].Lift[AI.abelian, X, G, tG, f].Unique[psi, hom, on-eta].unique p ;
ab-eta-inj (X : U k) (setX : isSet X) (a b : X)
  (p : Id (ab-group X).C (FGk.FreeGroup[AI.abelian, X].eta a) (FGk.FreeGroup[AI.abelian, X].eta b)) : Id X a b =
  Injective[l,k].Injective[AI.abelian, X, setX].eta-inj a b p ;
ab-locally-small (E : U k) (setE : isSet E) (ls : Rep.LocallySmall E) (p q : (ab-group E).C)
  : Rep.Small (Id (ab-group E).C p q) = Small[l,k].Size[AI.abelian, E, setE, ls].locally-small p q ;
ab-small-fibres (E : U k) (setE : isSet E) (ls : Rep.LocallySmall E) (q : (ab-group E).C)
  : Rep.Small ((a : E) * Id (ab-group E).C (FGk.FreeGroup[AI.abelian, E].eta a) q) =
  Small[l,k].Size[AI.abelian, E, setE, ls].small-fibres q ;

------------------------------------------------------------------------
-- equality in A(X): three forms (AbelianEquality), and the examples

ab-eq-identification (X : U k) (x y : Colimit[l,k].Colimit[AI.abelian, X].Elt)
  : (Id (ab-group X).C (Colimit[l,k].Colimit[AI.abelian, X].Q.inc x) (Colimit[l,k].Colimit[AI.abelian, X].Q.inc y)
       -> Truncation[k].Trunc[AbelianEquality[l,k].AbEq[X].ALink x y].carrier)
  * (Truncation[k].Trunc[AbelianEquality[l,k].AbEq[X].ALink x y].carrier
       -> Id (ab-group X).C (Colimit[l,k].Colimit[AI.abelian, X].Q.inc x) (Colimit[l,k].Colimit[AI.abelian, X].Q.inc y)) =
  (AbelianEquality[l,k].AbEq[X].alink-of-eq x y, AbelianEquality[l,k].AbEq[X].eq-of-alink x y) ;
ab-eq-partition (X : U k) (x y : Colimit[l,k].Colimit[AI.abelian, X].Elt)
  : (Id (ab-group X).C (Colimit[l,k].Colimit[AI.abelian, X].Q.inc x) (Colimit[l,k].Colimit[AI.abelian, X].Q.inc y)
       -> Truncation[k].Trunc[AbelianEquality[l,k].AbEq[X].PLink x y].carrier)
  * (Truncation[k].Trunc[AbelianEquality[l,k].AbEq[X].PLink x y].carrier
       -> Id (ab-group X).C (Colimit[l,k].Colimit[AI.abelian, X].Q.inc x) (Colimit[l,k].Colimit[AI.abelian, X].Q.inc y)) =
  (AbelianEquality[l,k].AbEq[X].plink-of-eq x y, AbelianEquality[l,k].AbEq[X].eq-of-plink x y) ;
ab-eq-finite (X : U k) (x y : Colimit[l,k].Colimit[AI.abelian, X].Elt)
  : (Id (ab-group X).C (Colimit[l,k].Colimit[AI.abelian, X].Q.inc x) (Colimit[l,k].Colimit[AI.abelian, X].Q.inc y)
       -> Truncation[k].Trunc[AbelianEquality[l,k].AbEq[X].Cand x y].carrier)
  * (Truncation[k].Trunc[AbelianEquality[l,k].AbEq[X].Cand x y].carrier
       -> Id (ab-group X).C (Colimit[l,k].Colimit[AI.abelian, X].Q.inc x) (Colimit[l,k].Colimit[AI.abelian, X].Q.inc y)) =
  (AbelianEquality[l,k].AbEq[X].cand-of-eq x y, AbelianEquality[l,k].AbEq[X].eq-of-cand x y) ;

-- e0 - e1 + 2 e2 = e0 + e1  iff  e1 = e2
ab-example1 (E : U k) (setE : isSet E) (e0 e1 e2 : E)
  : (Id (ab-group E).C (Colimit[l,k].Colimit[AI.abelian, E].Q.inc (AbelianExamples[l,k].Ex[E, setE, e0, e1, e2].el3 AbelianExamples[l,k].two))
                       (Colimit[l,k].Colimit[AI.abelian, E].Q.inc AbelianExamples[l,k].Ex[E, setE, e0, e1, e2].el2) -> Id E e1 e2)
  * (Id E e1 e2 -> Id (ab-group E).C (Colimit[l,k].Colimit[AI.abelian, E].Q.inc (AbelianExamples[l,k].Ex[E, setE, e0, e1, e2].el3 AbelianExamples[l,k].two))
                       (Colimit[l,k].Colimit[AI.abelian, E].Q.inc AbelianExamples[l,k].Ex[E, setE, e0, e1, e2].el2)) =
  (AbelianExamples[l,k].Ex[E, setE, e0, e1, e2].ex1-fwd, AbelianExamples[l,k].Ex[E, setE, e0, e1, e2].ex1-back) ;
-- the fibre of eta at e0 - e1 + e2 is || e0 = e1 or e1 = e2 ||
ab-example2 (E : U k) (setE : isSet E) (e0 e1 e2 : E)
  : (AbelianExamples[l,k].Ex[E, setE, e0, e1, e2].Fib (Colimit[l,k].Colimit[AI.abelian, E].Q.inc (AbelianExamples[l,k].Ex[E, setE, e0, e1, e2].el3 AbelianExamples[l,k].one))
       -> Truncation[k].Trunc[Decisions[k].Plus (Id E e0 e1) (Id E e1 e2)].carrier)
  * (Truncation[k].Trunc[Decisions[k].Plus (Id E e0 e1) (Id E e1 e2)].carrier
       -> AbelianExamples[l,k].Ex[E, setE, e0, e1, e2].Fib (Colimit[l,k].Colimit[AI.abelian, E].Q.inc (AbelianExamples[l,k].Ex[E, setE, e0, e1, e2].el3 AbelianExamples[l,k].one))) =
  (AbelianExamples[l,k].Ex[E, setE, e0, e1, e2].ex2-fwd, AbelianExamples[l,k].Ex[E, setE, e0, e1, e2].ex2-back) ;
-- the fibre of eta at e0 - e1 + 2 e2 is empty
ab-example3 (E : U k) (setE : isSet E) (e0 e1 e2 : E)
  (u : AbelianExamples[l,k].Ex[E, setE, e0, e1, e2].Fib (Colimit[l,k].Colimit[AI.abelian, E].Q.inc (AbelianExamples[l,k].Ex[E, setE, e0, e1, e2].el3 AbelianExamples[l,k].two)))
  : Empty = AbelianExamples[l,k].Ex[E, setE, e0, e1, e2].ex3 u ;
