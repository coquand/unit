-- Group.seg: groups, and the two facts on them used for homomorphisms.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ;

record Grp {
  C : U l ;
  set : isSet C ;
  e : C ;
  mul : C -> C -> C ;
  inv : C -> C ;
  assoc (x y z : C) : Id C (mul (mul x y) z) (mul x (mul y z)) ;
  unitl (x : C) : Id C (mul e x) x ;
  unitr (x : C) : Id C (mul x e) x ;
  invl (x : C) : Id C (mul (inv x) x) e ;
  invr (x : C) : Id C (mul x (inv x)) e ;
} ;

module GrpL (G : Grp) {
  open G ;
  -- x x = x gives x = e
  idem (x : C) (h : Id C (mul x x) x) : Id C x e = calc C {
    x =< symH (unitl x) > mul e x
      =< apH (\ z -> mul z x) (symH (invl x)) > mul (mul (inv x) x) x
      =< assoc (inv x) x x > mul (inv x) (mul x x)
      =< apH (mul (inv x)) h > mul (inv x) x
      =< invl x > e } ;
  -- x y = e gives y = x^-1
  inv-unique (x y : C) (h : Id C (mul x y) e) : Id C y (inv x) = calc C {
    y =< symH (unitl y) > mul e y
      =< apH (\ z -> mul z y) (symH (invl x)) > mul (mul (inv x) x) y
      =< assoc (inv x) x y > mul (inv x) (mul x y)
      =< apH (mul (inv x)) h > mul (inv x) e
      =< unitr (inv x) > inv x } ;
} ;

-- a homomorphism preserves the unit and the inverse
module HomL (G H : Grp) (f : G.C -> H.C) (hom : (x y : G.C) -> Id H.C (f (G.mul x y)) (H.mul (f x) (f y))) {
  unit : Id H.C (f G.e) H.e = GrpL[H].idem (f G.e) (calc H.C {
    H.mul (f G.e) (f G.e) =< symH (hom G.e G.e) > f (G.mul G.e G.e) =< apH f (G.unitl G.e) > f G.e }) ;
  inverse (x : G.C) : Id H.C (f (G.inv x)) (H.inv (f x)) = GrpL[H].inv-unique (f x) (f (G.inv x)) (calc H.C {
    H.mul (f x) (f (G.inv x)) =< symH (hom x (G.inv x)) > f (G.mul x (G.inv x))
      =< apH f (G.invr x) > f G.e =< unit > H.e }) ;
} ;
