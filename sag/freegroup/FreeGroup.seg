-- FreeGroup.seg: the group F(X).  The operations of Colimit.seg respect
-- links (link-mul, link-inv), so they descend to the quotient, and the
-- group laws, which hold up to links, hold in F(X) by induction on the
-- quotient (equalities in a set are propositions).
level l k ;
constraint l <= k ;
open Base ; open Prelude[k] ; open Paths[k] ; open Codes[l] ;
module GK = Group[k] ;

module FreeGroup (I : Interface[l,k].FinFree) (X : U k) {
  module CX = Colimit[l,k].Colimit[I, X] ; open CX ;
  module FE = Axioms[k].FunExtLemmas[fe @k] ;

  setFF : isSet (F -> F) = FE.isSet-Pi F (\ u -> F) (\ u -> Q.set) ;

  -- x . - on F
  module Right (x : Elt) {
    f0 (y : Elt) : F = Q.inc (emul x y) ;
    resp (y y' : Elt) (r : rel y y') : Id F (f0 y) (f0 y') =
      rel-elim y y' (Id F (f0 y) (f0 y')) (Q.set (f0 y) (f0 y'))
        (\ L -> related (emul x y) (emul x y') (link-mul x x y y' (link-refl x) L)) r ;
  } ;
  mulR (x : Elt) : F -> F = Q.Descend[F, Q.set, Right[x].f0, Right[x].resp].map ;
  mulR-beta (x y : Elt) : Id F (mulR x (Q.inc y)) (Q.inc (emul x y)) =
    Q.Descend[F, Q.set, Right[x].f0, Right[x].resp].beta y ;
  mulR-link (x x' : Elt) (L : Link x x') : Id (F -> F) (mulR x) (mulR x') =
    FE.funext F (\ u -> F) (mulR x) (mulR x')
      (Q.induction @k (\ q -> Id F (mulR x q) (mulR x' q)) (\ q -> Q.set (mulR x q) (mulR x' q)) (\ y -> calc F {
        mulR x (Q.inc y) =< mulR-beta x y >
        Q.inc (emul x y) =< related (emul x y) (emul x' y) (link-mul x x' y y L (link-refl y)) >
        Q.inc (emul x' y) =< symH (mulR-beta x' y) >
        mulR x' (Q.inc y) })) ;
  mulR-resp (x x' : Elt) (r : rel x x') : Id (F -> F) (mulR x) (mulR x') =
    rel-elim x x' (Id (F -> F) (mulR x) (mulR x')) (setFF (mulR x) (mulR x')) (mulR-link x x') r ;

  mul (p q : F) : F = Q.Descend[F -> F, setFF, mulR, mulR-resp].map p q ;
  mul-beta (x y : Elt) : Id F (mul (Q.inc x) (Q.inc y)) (Q.inc (emul x y)) = calc F {
    mul (Q.inc x) (Q.inc y)
      =< happly F (\ u -> F) (Q.Descend[F -> F, setFF, mulR, mulR-resp].map (Q.inc x)) (mulR x)
           (Q.Descend[F -> F, setFF, mulR, mulR-resp].beta x) (Q.inc y) >
    mulR x (Q.inc y)
      =< mulR-beta x y >
    Q.inc (emul x y) } ;

  inv-f0 (x : Elt) : F = Q.inc (einv x) ;
  inv-resp (x x' : Elt) (r : rel x x') : Id F (inv-f0 x) (inv-f0 x') =
    rel-elim x x' (Id F (inv-f0 x) (inv-f0 x')) (Q.set (inv-f0 x) (inv-f0 x'))
      (\ L -> related (einv x) (einv x') (link-inv x x' L)) r ;
  inv (p : F) : F = Q.Descend[F, Q.set, inv-f0, inv-resp].map p ;
  inv-beta (x : Elt) : Id F (inv (Q.inc x)) (Q.inc (einv x)) = Q.Descend[F, Q.set, inv-f0, inv-resp].beta x ;

  one : F = Q.inc eunit ;

  ----------------------------------------------------------------------
  -- the laws

  assoc-inc (x y z : Elt) : Id F (mul (mul (Q.inc x) (Q.inc y)) (Q.inc z)) (mul (Q.inc x) (mul (Q.inc y) (Q.inc z))) = calc F {
    mul (mul (Q.inc x) (Q.inc y)) (Q.inc z)
      =< apH (\ w -> mul w (Q.inc z)) (mul-beta x y) >
    mul (Q.inc (emul x y)) (Q.inc z)
      =< mul-beta (emul x y) z >
    Q.inc (emul (emul x y) z)
      =< related (emul (emul x y) z) (emul x (emul y z)) (link-assoc x y z) >
    Q.inc (emul x (emul y z))
      =< symH (mul-beta x (emul y z)) >
    mul (Q.inc x) (Q.inc (emul y z))
      =< symH (apH (mul (Q.inc x)) (mul-beta y z)) >
    mul (Q.inc x) (mul (Q.inc y) (Q.inc z)) } ;
  assoc (p q r : F) : Id F (mul (mul p q) r) (mul p (mul q r)) =
    Q.induction @k (\ p0 -> Id F (mul (mul p0 q) r) (mul p0 (mul q r)))
      (\ p0 -> Q.set (mul (mul p0 q) r) (mul p0 (mul q r))) (\ x ->
    Q.induction @k (\ q0 -> Id F (mul (mul (Q.inc x) q0) r) (mul (Q.inc x) (mul q0 r)))
      (\ q0 -> Q.set (mul (mul (Q.inc x) q0) r) (mul (Q.inc x) (mul q0 r))) (\ y ->
    Q.induction @k (\ r0 -> Id F (mul (mul (Q.inc x) (Q.inc y)) r0) (mul (Q.inc x) (mul (Q.inc y) r0)))
      (\ r0 -> Q.set (mul (mul (Q.inc x) (Q.inc y)) r0) (mul (Q.inc x) (mul (Q.inc y) r0)))
      (\ z -> assoc-inc x y z) r) q) p ;

  unitl (p : F) : Id F (mul one p) p =
    Q.induction @k (\ p0 -> Id F (mul one p0) p0) (\ p0 -> Q.set (mul one p0) p0) (\ x -> calc F {
      mul one (Q.inc x) =< mul-beta eunit x >
      Q.inc (emul eunit x) =< related (emul eunit x) x (link-unitl x) >
      Q.inc x }) p ;
  unitr (p : F) : Id F (mul p one) p =
    Q.induction @k (\ p0 -> Id F (mul p0 one) p0) (\ p0 -> Q.set (mul p0 one) p0) (\ x -> calc F {
      mul (Q.inc x) one =< mul-beta x eunit >
      Q.inc (emul x eunit) =< related (emul x eunit) x (link-unitr x) >
      Q.inc x }) p ;
  invl (p : F) : Id F (mul (inv p) p) one =
    Q.induction @k (\ p0 -> Id F (mul (inv p0) p0) one) (\ p0 -> Q.set (mul (inv p0) p0) one) (\ x -> calc F {
      mul (inv (Q.inc x)) (Q.inc x) =< apH (\ w -> mul w (Q.inc x)) (inv-beta x) >
      mul (Q.inc (einv x)) (Q.inc x) =< mul-beta (einv x) x >
      Q.inc (emul (einv x) x) =< related (emul (einv x) x) eunit (link-invl x) >
      one }) p ;
  invr (p : F) : Id F (mul p (inv p)) one =
    Q.induction @k (\ p0 -> Id F (mul p0 (inv p0)) one) (\ p0 -> Q.set (mul p0 (inv p0)) one) (\ x -> calc F {
      mul (Q.inc x) (inv (Q.inc x)) =< apH (mul (Q.inc x)) (inv-beta x) >
      mul (Q.inc x) (Q.inc (einv x)) =< mul-beta x (einv x) >
      Q.inc (emul x (einv x)) =< related (emul x (einv x)) eunit (link-invr x) >
      one }) p ;

  -- the free group on X, and its unit
  FX : GK.Grp = new GK.Grp[F, Q.set, one, mul, inv, assoc, unitl, unitr, invl, invr] ;
  eta (a : X) : F = Q.inc (St.spoint a, I.gen fone tt) ;
} ;
