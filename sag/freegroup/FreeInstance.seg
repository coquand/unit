-- FreeInstance.seg: the free groups by reduced words (Words, Functor,
-- Universal) satisfy the interface, for all target groups.
level l k ;
constraint l <= k ;
open Base ; open Prelude[k] ; open Codes[l] ; open Words[l] ;
module GL = Group[l] ; module Fn = Functor[l] ; module UV = Universal[l,k] ;

FrG (c : FT) : GL.Grp = new GL.Grp[Free[disc c].Red, Free[disc c].set, Free[disc c].e, Free[disc c].mul,
  Free[disc c].inverse, Free[disc c].assoc, Free[disc c].unitl, Free[disc c].unitr,
  Free[disc c].invl, Free[disc c].invr] ;

occ-gen (c : FT) (j : El c) : Free[disc c].Occ j (Free[disc c].gen j).1 = inl (refl j) ;

free : Interface[l,k].FinFree = new Interface[l,k].FinFree[
  T := FrG,
  gen := \ c i -> Free[disc c].gen i,
  push := \ a b m u -> Fn.Map[disc a, disc b, m].fmap u,
  push-mul := \ a b m u v -> Fn.Map[disc a, disc b, m].fmap-mul u v,
  push-comp := \ a b c m n u -> Fn.Comp[disc a, disc b, disc c, m, n].fmap-comp u,
  push-id := \ a u -> Fn.Ident[disc a].fmap-id u,
  push-ext := \ a b m m' h u -> Fn.Ext[disc a, disc b, m, m', h].fmap-ext u,
  push-gen := \ a b m i -> refl (Free[disc b].gen (m i)),
  gen-inj := \ c i j p -> Free[disc c].gen-inj i j p,
  support := \ a b m u j p -> Fn.Map[disc a, disc b, m].occ-fmap j u
    (Paths[l].substH (\ w -> Free[disc b].Occ j w.1) p (occ-gen b j)),
  empty-prop := \ c n -> Free[disc c].empty-prop n,
  Target := \ G -> Top,
  lift := \ c G tG f u -> UV.UP[disc c, G, f].lift u,
  lift-mul := \ c G tG f u v -> UV.UP[disc c, G, f].lift-mul u v,
  lift-gen := \ c G tG f i -> UV.UP[disc c, G, f].lift-gen i,
  lift-unique := \ c G tG f psi hom on-gen u -> UV.UP[disc c, G, f].Unique[psi, hom, on-gen].unique u,
  lift-push := \ a b m G tG f u -> UV.Natural[disc a, disc b, m, G, f].lift-fmap u ] ;
