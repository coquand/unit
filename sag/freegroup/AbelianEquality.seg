-- AbelianEquality.seg: equality in the free abelian group A(X), three forms.
-- For x = (s,u), y = (s',v), with s + s' = (c,g) and u, v integer vectors:
--  (1) [x] = [y] iff merely some r : El c -> El c with g o r = g has
--        sum_{r(inl i) = w} u(i) = sum_{r(inr j) = w} v(j)   for all w;
--  (2) (partitions) iff merely some decidable equivalence relation R on
--      El c, with g constant on classes, has equal coefficient totals in
--      every class: sum_{R(inl i) w} u(i) = sum_{R(inr j) w} v(j);
--  (3) (finite disjunction) iff merely some code t of a map El c -> El c
--      with ok t (the decidable condition of (1)) has g (t z) = g z for
--      all z.
-- (1) is Identification for Z^c.  (2): from r, R z z' is r z = r z'; from
-- R, r z is the first element of the class of z (Codes.first), which
-- depends only on the class.  (3): maps El c -> El c are coded by El (fn c c).
level l k ;
constraint l <= k ;
open Base ; open Prelude[k] ; open Paths[k] ; open Decisions[l] ; open Codes[l] ;
module AI = AbelianInstance[l,k] ; module Z = Integers[l] ; module SZ = FinSum[l,l].Sums[Z.intAb] ;
module TK = Truncation[k] ; module FL = Axioms[l].FunExtLemmas[fe @l] ;

-- decidable equality of integers, as a Boolean
eqZ-of (x y : Z.Int) : Logic[l].Dec (Id Z.Int x y) -> Bool = split { yes a -> true ; no n -> false } ;
eqZb (x y : Z.Int) : Bool = eqZ-of x y (Z.int-dec x y) ;
eqZ-sound-of (x y : Z.Int) : (d : Logic[l].Dec (Id Z.Int x y)) -> so (eqZ-of x y d) -> Id Z.Int x y = split {
  yes a -> \ s -> a ; no n -> \ s -> absurd (Id Z.Int x y) s } ;
eqZ-complete-of (x y : Z.Int) (p : Id Z.Int x y) : (d : Logic[l].Dec (Id Z.Int x y)) -> so (eqZ-of x y d) = split {
  yes a -> tt ; no n -> n p } ;
eqZb-sound (x y : Z.Int) (s : so (eqZb x y)) : Id Z.Int x y = eqZ-sound-of x y (Z.int-dec x y) s ;
eqZb-complete (x y : Z.Int) (p : Id Z.Int x y) : so (eqZb x y) = eqZ-complete-of x y p (Z.int-dec x y) ;

tmap (A B : U k) (f : A -> B) (t : TK.Trunc[A].carrier) : TK.Trunc[B].carrier =
  TK.Trunc[A].induction @k (\ u -> TK.Trunc[B].carrier) (\ u -> TK.Trunc[B].proposition) (\ a -> TK.Trunc[B].inc (f a)) t ;

module AbEq (X : U k) {
  module ID = Identification[l,k].Ident[AI.abelian, X] ; open ID ; open FG ; open CX ; open St ;

  cc (x y : Elt) : FT = (sum x y).1 ;
  g (x y : Elt) (z : El (cc x y)) : X = (sum x y).2 z ;

  ----------------------------------------------------------------------
  -- (1) an identification with equal fibre sums

  Classes (x y : Elt) (r : El (cc x y) -> El (cc x y)) : U l = (w : El (cc x y)) ->
    Id Z.Int (AI.push x.1.1 (cc x y) (\ i -> r (inl i)) x.2 w) (AI.push y.1.1 (cc x y) (\ j -> r (inr j)) y.2 w) ;
  ALink (x y : Elt) : U k = (r : El (cc x y) -> El (cc x y))
    * (((z : El (cc x y)) -> Id X (g x y (r z)) (g x y z)) * Classes x y r) ;

  alink-rlink (x y : Elt) (L : ALink x y) : RLink x y = (L.1, (L.2.1,
    AI.ext (cc x y) (AI.push x.1.1 (cc x y) (\ i -> L.1 (inl i)) x.2) (AI.push y.1.1 (cc x y) (\ j -> L.1 (inr j)) y.2) L.2.2)) ;
  rlink-alink (x y : Elt) (L : RLink x y) : ALink x y = (L.1, (L.2.1, \ w ->
    Prelude[l].happly (El (cc x y)) (\ q -> Z.Int)
      (AI.push x.1.1 (cc x y) (\ i -> L.1 (inl i)) x.2) (AI.push y.1.1 (cc x y) (\ j -> L.1 (inr j)) y.2) L.2.2 w)) ;

  -- Theorem (1)
  eq-of-alink (x y : Elt) (h : TK.Trunc[ALink x y].carrier) : Id F (Q.inc x) (Q.inc y) =
    eq-of x y (tmap (ALink x y) (RLink x y) (alink-rlink x y) h) ;
  alink-of-eq (x y : Elt) (p : Id F (Q.inc x) (Q.inc y)) : TK.Trunc[ALink x y].carrier =
    tmap (RLink x y) (ALink x y) (rlink-alink x y) (of-eq x y p) ;

  ----------------------------------------------------------------------
  -- (2) partitions

  EqRel (c : FT) (R : El c -> El c -> Bool) : U l = ((z : El c) -> so (R z z))
    * (((z z' : El c) -> so (R z z') -> so (R z' z))
    * ((z z' z'' : El c) -> so (R z z') -> so (R z' z'') -> so (R z z''))) ;
  Totals (x y : Elt) (R : El (cc x y) -> El (cc x y) -> Bool) : U l = (w : El (cc x y)) ->
    Id Z.Int (SZ.sum x.1.1 (\ i -> ite Z.Int (R (inl i) w) (x.2 i) Z.zeroZ))
             (SZ.sum y.1.1 (\ j -> ite Z.Int (R (inr j) w) (y.2 j) Z.zeroZ)) ;
  PLink (x y : Elt) : U k = (R : El (cc x y) -> El (cc x y) -> Bool) * (EqRel (cc x y) R
    * (((z z' : El (cc x y)) -> so (R z z') -> Id X (g x y z) (g x y z')) * Totals x y R)) ;

  module FromMap (x y : Elt) (L : ALink x y) {
    c : FT = cc x y ;
    R (z z' : El c) : Bool = eqEl c (L.1 z) (L.1 z') ;
    sound (z z' : El c) (h : so (R z z')) : Id (El c) (L.1 z) (L.1 z') = eqEl-sound c (L.1 z) (L.1 z') h ;
    eqr : EqRel c R = (\ z -> eqEl-refl c (L.1 z),
      (\ z z' h -> substH (\ q -> so (eqEl c q (L.1 z))) (sound z z' h) (eqEl-refl c (L.1 z)),
       \ z z' z'' h h' -> substH (\ q -> so (eqEl c (L.1 z) q)) (sound z' z'' h') h)) ;
    compat (z z' : El c) (h : so (R z z')) : Id X (g x y z) (g x y z') = calc X {
      g x y z =< symH (L.2.1 z) > g x y (L.1 z) =< apH (g x y) (sound z z' h) > g x y (L.1 z') =< L.2.1 z' > g x y z' } ;
    plink : PLink x y = (R, (eqr, (compat, \ w -> L.2.2 (L.1 w)))) ;
  } ;

  module FromPartition (x y : Elt) (P : PLink x y) {
    c : FT = cc x y ;
    R (z z' : El c) : Bool = P.1 z z' ;
    rf (z : El c) : so (R z z) = P.2.1.1 z ;
    sy (z z' : El c) (h : so (R z z')) : so (R z' z) = P.2.1.2.1 z z' h ;
    tr (z z' z'' : El c) (h : so (R z z')) (h' : so (R z' z'')) : so (R z z'') = P.2.1.2.2 z z' z'' h h' ;

    -- the first element of the class of z
    rep (z : El c) : El c = value c z (first c (R z)) ;
    rep-in (z : El c) : so (R z (rep z)) = value-good c (R z) z (first c (R z)) (first-good c (R z) z (rf z)) ;
    same-class (z z' : El c) (h : so (R z z')) : Id (El c -> Bool) (R z) (R z') =
      FL.funext (El c) (\ q -> Bool) (R z) (R z') (\ q -> bool-ext (R z q) (R z' q)
        (\ s -> tr z' z q (sy z z' h) s) (\ s -> tr z z' q h s)) ;
    rep-class (z z' : El c) (h : so (R z z')) : Id (El c) (rep z) (rep z') = calc (El c) {
      value c z (first c (R z)) =< value-default c (R z) z z' (first c (R z)) (first-good c (R z) z (rf z)) >
      value c z' (first c (R z)) =< apH (\ p -> value c z' (first c p)) (same-class z z' h) >
      value c z' (first c (R z')) } ;
    compat (z : El c) : Id X (g x y (rep z)) (g x y z) = symH (P.2.2.1 z (rep z) (rep-in z)) ;

    -- rep q = rep z0 iff R q z0
    in-class (z0 q : El c) : Id Bool (eqEl c (rep q) (rep z0)) (R q z0) = bool-ext (eqEl c (rep q) (rep z0)) (R q z0)
      (\ s -> tr q (rep z0) z0 (substH (\ t -> so (R q t)) (eqEl-sound c (rep q) (rep z0) s) (rep-in q)) (sy z0 (rep z0) (rep-in z0)))
      (\ s -> substH (\ t -> so (eqEl c (rep q) t)) (rep-class q z0 s) (eqEl-refl c (rep q))) ;

    lhs (w : El c) : Z.Int = AI.push x.1.1 c (\ i -> rep (inl i)) x.2 w ;
    rhs (w : El c) : Z.Int = AI.push y.1.1 c (\ j -> rep (inr j)) y.2 w ;
    at-rep (z0 : El c) : Id Z.Int (lhs (rep z0)) (rhs (rep z0)) = calc Z.Int {
      lhs (rep z0)
        =< SZ.sum-ext x.1.1 (\ i -> ite Z.Int (eqEl c (rep (inl i)) (rep z0)) (x.2 i) Z.zeroZ) (\ i -> ite Z.Int (R (inl i) z0) (x.2 i) Z.zeroZ)
             (\ i -> apH (\ b -> ite Z.Int b (x.2 i) Z.zeroZ) (in-class z0 (inl i))) >
      SZ.sum x.1.1 (\ i -> ite Z.Int (R (inl i) z0) (x.2 i) Z.zeroZ)
        =< P.2.2.2 z0 >
      SZ.sum y.1.1 (\ j -> ite Z.Int (R (inr j) z0) (y.2 j) Z.zeroZ)
        =< symH (SZ.sum-ext y.1.1 (\ j -> ite Z.Int (eqEl c (rep (inr j)) (rep z0)) (y.2 j) Z.zeroZ) (\ j -> ite Z.Int (R (inr j) z0) (y.2 j) Z.zeroZ)
             (\ j -> apH (\ b -> ite Z.Int b (y.2 j) Z.zeroZ) (in-class z0 (inr j)))) >
      rhs (rep z0) } ;
    -- off the image of rep both sides are 0
    zero-l (w : El c) (nn : None c (\ z -> eqEl c (rep z) w)) : Id Z.Int (lhs w) Z.zeroZ =
      transH (SZ.sum-ext x.1.1 (\ i -> ite Z.Int (eqEl c (rep (inl i)) w) (x.2 i) Z.zeroZ) (\ i -> Z.zeroZ)
        (\ i -> apH (\ b -> ite Z.Int b (x.2 i) Z.zeroZ) (not-so-false (eqEl c (rep (inl i)) w) (nn (inl i))))) (SZ.sum-zero x.1.1) ;
    zero-r (w : El c) (nn : None c (\ z -> eqEl c (rep z) w)) : Id Z.Int (rhs w) Z.zeroZ =
      transH (SZ.sum-ext y.1.1 (\ j -> ite Z.Int (eqEl c (rep (inr j)) w) (y.2 j) Z.zeroZ) (\ j -> Z.zeroZ)
        (\ j -> apH (\ b -> ite Z.Int b (y.2 j) Z.zeroZ) (not-so-false (eqEl c (rep (inr j)) w) (nn (inr j))))) (SZ.sum-zero y.1.1) ;
    classes-at (w : El c) : Decided c (\ z -> eqEl c (rep z) w) -> Id Z.Int (lhs w) (rhs w) = split {
      inl wt -> substH (\ w' -> Id Z.Int (lhs w') (rhs w')) (eqEl-sound c (rep wt.1) w wt.2) (at-rep wt.1) ;
      inr nn -> transH (zero-l w nn) (symH (zero-r w nn)) } ;
    alink : ALink x y = (rep, (compat, \ w -> classes-at w (decide c (\ z -> eqEl c (rep z) w)))) ;
  } ;

  -- Corollary (2)
  eq-of-plink (x y : Elt) (h : TK.Trunc[PLink x y].carrier) : Id F (Q.inc x) (Q.inc y) =
    eq-of-alink x y (tmap (PLink x y) (ALink x y) (\ P -> FromPartition[x, y, P].alink) h) ;
  plink-of-eq (x y : Elt) (p : Id F (Q.inc x) (Q.inc y)) : TK.Trunc[PLink x y].carrier =
    tmap (ALink x y) (PLink x y) (\ L -> FromMap[x, y, L].plink) (alink-of-eq x y p) ;

  ----------------------------------------------------------------------
  -- (3) a finite disjunction of conjunctions of equalities in X

  -- the decidable condition of (1), for the map coded by t
  ok (x y : Elt) (t : El (fn (cc x y) (cc x y))) : Bool = all (cc x y) (\ w ->
    eqZb (AI.push x.1.1 (cc x y) (\ i -> dec (cc x y) (cc x y) t (inl i)) x.2 w)
         (AI.push y.1.1 (cc x y) (\ j -> dec (cc x y) (cc x y) t (inr j)) y.2 w)) ;
  Cand (x y : Elt) : U k = (t : El (fn (cc x y) (cc x y))) * (so (ok x y t)
    * ((z : El (cc x y)) -> Id X (g x y (dec (cc x y) (cc x y) t z)) (g x y z))) ;

  cand-alink (x y : Elt) (C : Cand x y) : ALink x y = (dec (cc x y) (cc x y) C.1, (C.2.2, \ w ->
    eqZb-sound (AI.push x.1.1 (cc x y) (\ i -> dec (cc x y) (cc x y) C.1 (inl i)) x.2 w)
               (AI.push y.1.1 (cc x y) (\ j -> dec (cc x y) (cc x y) C.1 (inr j)) y.2 w)
      (all-sound (cc x y) (\ w0 -> eqZb (AI.push x.1.1 (cc x y) (\ i -> dec (cc x y) (cc x y) C.1 (inl i)) x.2 w0)
                                        (AI.push y.1.1 (cc x y) (\ j -> dec (cc x y) (cc x y) C.1 (inr j)) y.2 w0)) C.2.1 w))) ;

  module ToCand (x y : Elt) (L : ALink x y) {
    c : FT = cc x y ;
    t : El (fn c c) = enc c c L.1 ;
    -- the coded map is L.1
    side (a : FT) (s : El a -> El c) (u : AI.V a) (w : El c) : Id Z.Int (AI.push a c (\ i -> dec c c t (s i)) u w) (AI.push a c (\ i -> L.1 (s i)) u w) =
      Prelude[l].happly (El c) (\ q -> Z.Int) (AI.push a c (\ i -> dec c c t (s i)) u) (AI.push a c (\ i -> L.1 (s i)) u)
        (AI.push-ext a c (\ i -> dec c c t (s i)) (\ i -> L.1 (s i)) (\ i -> dec-enc c c L.1 (s i)) u) w ;
    classes (w : El c) : Id Z.Int (AI.push x.1.1 c (\ i -> dec c c t (inl i)) x.2 w) (AI.push y.1.1 c (\ j -> dec c c t (inr j)) y.2 w) =
      calc Z.Int {
        AI.push x.1.1 c (\ i -> dec c c t (inl i)) x.2 w =< side x.1.1 (\ i -> inl i) x.2 w >
        AI.push x.1.1 c (\ i -> L.1 (inl i)) x.2 w =< L.2.2 w >
        AI.push y.1.1 c (\ j -> L.1 (inr j)) y.2 w =< symH (side y.1.1 (\ j -> inr j) y.2 w) >
        AI.push y.1.1 c (\ j -> dec c c t (inr j)) y.2 w } ;
    cand : Cand x y = (t, (all-complete c (\ w -> eqZb (AI.push x.1.1 c (\ i -> dec c c t (inl i)) x.2 w)
                                                        (AI.push y.1.1 c (\ j -> dec c c t (inr j)) y.2 w))
                             (\ w -> eqZb-complete (AI.push x.1.1 c (\ i -> dec c c t (inl i)) x.2 w)
                                                   (AI.push y.1.1 c (\ j -> dec c c t (inr j)) y.2 w) (classes w)),
                           \ z -> transH (apH (g x y) (dec-enc c c L.1 z)) (L.2.1 z))) ;
  } ;

  -- Theorem (3)
  eq-of-cand (x y : Elt) (h : TK.Trunc[Cand x y].carrier) : Id F (Q.inc x) (Q.inc y) =
    eq-of-alink x y (tmap (Cand x y) (ALink x y) (cand-alink x y) h) ;
  cand-of-eq (x y : Elt) (p : Id F (Q.inc x) (Q.inc y)) : TK.Trunc[Cand x y].carrier =
    tmap (ALink x y) (Cand x y) (\ L -> ToCand[x, y, L].cand) (alink-of-eq x y p) ;
} ;
