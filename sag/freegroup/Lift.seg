-- Lift.seg: the universal property of F(X).  For a group G and f : X -> G,
-- the value of (s, w) is the lift of w for f o s (Universal.UP); by
-- naturality it does not change along a map of stages, so it is constant
-- on links and descends to lift : F(X) -> G, a homomorphism with
-- lift (eta a) = f a.  A homomorphism psi with psi (eta a) = f a agrees with
-- lift: restricted to a stage s it is a homomorphism on the free group of
-- s, sending the generator i to f (s i), hence the lift there.
level l k ;
constraint l <= k ;
open Base ; open Prelude[k] ; open Paths[k] ; open Codes[l] ;
module GK = Group[k] ;

module Lift (I : Interface[l,k].FinFree) (X : U k) (G : GK.Grp) (tG : I.Target G) (f : X -> G.C) {
  module FG = FreeGroup[l,k].FreeGroup[I, X] ; open FG ; open CX ; open St ;
  module FE = Axioms[k].FunExtLemmas[fe @k] ;

  val (x : Elt) : G.C = I.lift x.1.1 G tG (\ i -> f (x.1.2 i)) x.2 ;

  -- along m : s -> t, the lift of m w for f o t is the lift of w for f o s
  val-over (s t : Stage) (m : Over s t) (w : Fr s.1)
    : Id G.C (I.lift t.1 G tG (\ i -> f (t.2 i)) (push s.1 t.1 m.1 w)) (I.lift s.1 G tG (\ i -> f (s.2 i)) w) = calc G.C {
    I.lift t.1 G tG (\ i -> f (t.2 i)) (push s.1 t.1 m.1 w)
      =< I.lift-push s.1 t.1 m.1 G tG (\ i -> f (t.2 i)) w >
    I.lift s.1 G tG (\ i -> f (t.2 (m.1 i))) w
      =< apH (\ g -> I.lift s.1 G tG (g) w)
           (FE.funext (El s.1) (\ i -> G.C) (\ i -> f (t.2 (m.1 i))) (\ i -> f (s.2 i)) (\ i -> apH f (m.2 i))) >
    I.lift s.1 G tG (\ i -> f (s.2 i)) w } ;

  val-link (x y : Elt) (L : Link x y) : Id G.C (val x) (val y) = calc G.C {
    val x
      =< symH (val-over x.1 L.1 L.2.1 x.2) >
    I.lift L.1.1 G tG (\ i -> f (L.1.2 i)) (push x.1.1 L.1.1 L.2.1.1 x.2)
      =< apH (I.lift L.1.1 G tG (\ i -> f (L.1.2 i))) L.2.2.2 >
    I.lift L.1.1 G tG (\ i -> f (L.1.2 i)) (push y.1.1 L.1.1 L.2.2.1.1 y.2)
      =< val-over y.1 L.1 L.2.2.1 y.2 >
    val y } ;
  val-resp (x y : Elt) (r : rel x y) : Id G.C (val x) (val y) =
    rel-elim x y (Id G.C (val x) (val y)) (G.set (val x) (val y)) (val-link x y) r ;

  lift (p : F) : G.C = Q.Descend[G.C, G.set, val, val-resp].map p ;
  lift-beta (x : Elt) : Id G.C (lift (Q.inc x)) (val x) = Q.Descend[G.C, G.set, val, val-resp].beta x ;

  val-mul (x y : Elt) : Id G.C (val (emul x y)) (G.mul (val x) (val y)) = calc G.C {
    val (emul x y)
      =< I.lift-mul ((fplus x.1.1 y.1.1)) G tG (\ i -> f ((splus x.1 y.1).2 i))
           (push x.1.1 (fplus x.1.1 y.1.1) (\ i -> inl i) x.2) (push y.1.1 (fplus x.1.1 y.1.1) (\ j -> inr j) y.2) >
    G.mul (I.lift ((fplus x.1.1 y.1.1)) G tG (\ i -> f ((splus x.1 y.1).2 i)) (push x.1.1 (fplus x.1.1 y.1.1) (\ i -> inl i) x.2))
          (I.lift ((fplus x.1.1 y.1.1)) G tG (\ i -> f ((splus x.1 y.1).2 i)) (push y.1.1 (fplus x.1.1 y.1.1) (\ j -> inr j) y.2))
      =< apH (\ g -> G.mul g (I.lift ((fplus x.1.1 y.1.1)) G tG (\ i -> f ((splus x.1 y.1).2 i)) (push y.1.1 (fplus x.1.1 y.1.1) (\ j -> inr j) y.2)))
           (val-over x.1 (splus x.1 y.1) (over-inl x.1 y.1) x.2) >
    G.mul (val x) (I.lift ((fplus x.1.1 y.1.1)) G tG (\ i -> f ((splus x.1 y.1).2 i)) (push y.1.1 (fplus x.1.1 y.1.1) (\ j -> inr j) y.2))
      =< apH (G.mul (val x)) (val-over y.1 (splus x.1 y.1) (over-inr x.1 y.1) y.2) >
    G.mul (val x) (val y) } ;

  -- lift is a homomorphism extending f
  lift-mul (p q : F) : Id G.C (lift (mul p q)) (G.mul (lift p) (lift q)) =
    Q.induction @k (\ p0 -> Id G.C (lift (mul p0 q)) (G.mul (lift p0) (lift q)))
      (\ p0 -> G.set (lift (mul p0 q)) (G.mul (lift p0) (lift q))) (\ x ->
    Q.induction @k (\ q0 -> Id G.C (lift (mul (Q.inc x) q0)) (G.mul (lift (Q.inc x)) (lift q0)))
      (\ q0 -> G.set (lift (mul (Q.inc x) q0)) (G.mul (lift (Q.inc x)) (lift q0))) (\ y -> calc G.C {
      lift (mul (Q.inc x) (Q.inc y)) =< apH lift (mul-beta x y) >
      lift (Q.inc (emul x y)) =< lift-beta (emul x y) >
      val (emul x y) =< val-mul x y >
      G.mul (val x) (val y) =< apH (\ g -> G.mul g (val y)) (symH (lift-beta x)) >
      G.mul (lift (Q.inc x)) (val y) =< apH (G.mul (lift (Q.inc x))) (symH (lift-beta y)) >
      G.mul (lift (Q.inc x)) (lift (Q.inc y)) }) q) p ;
  lift-eta (a : X) : Id G.C (lift (eta a)) (f a) = calc G.C {
    lift (eta a) =< lift-beta (spoint a, I.gen fone tt) >
    val (spoint a, I.gen fone tt) =< I.lift-gen fone G tG (\ i -> f a) tt >
    f a } ;

  -- and the only one
  module Unique (psi : F -> G.C)
    (hom : (p q : F) -> Id G.C (psi (mul p q)) (G.mul (psi p) (psi q)))
    (on-eta : (a : X) -> Id G.C (psi (eta a)) (f a)) {
    module AtStage (s : Stage) {
      psi-s (w : Fr s.1) : G.C = psi (Q.inc (s, w)) ;
      fold-link (u v : Fr s.1) : Link (emul (s, u) (s, v)) (s, (I.T s.1).mul u v) =
        link-over (emul (s, u) (s, v)) (s, (I.T s.1).mul u v) (over-fold s) (fold-pair s.1 u v) ;
      hom-s (u v : Fr s.1) : Id G.C (psi-s ((I.T s.1).mul u v)) (G.mul (psi-s u) (psi-s v)) = calc G.C {
        psi (Q.inc (s, (I.T s.1).mul u v))
          =< apH psi (symH (related (emul (s, u) (s, v)) (s, (I.T s.1).mul u v) (fold-link u v))) >
        psi (Q.inc (emul (s, u) (s, v)))
          =< apH psi (symH (mul-beta (s, u) (s, v))) >
        psi (mul (Q.inc (s, u)) (Q.inc (s, v)))
          =< hom (Q.inc (s, u)) (Q.inc (s, v)) >
        G.mul (psi-s u) (psi-s v) } ;
      point-link (i : El s.1) : Link (spoint (s.2 i), I.gen fone tt) (s, I.gen s.1 i) =
        link-over (spoint (s.2 i), I.gen fone tt) (s, I.gen s.1 i) (over-point s i)
          (I.push-gen fone s.1 (\ u -> i) tt) ;
      gen-s (i : El s.1) : Id G.C (psi-s (I.gen s.1 i)) (f (s.2 i)) = calc G.C {
        psi (Q.inc (s, I.gen s.1 i))
          =< apH psi (symH (related (spoint (s.2 i), I.gen fone tt) (s, I.gen s.1 i) (point-link i))) >
        psi (eta (s.2 i))
          =< on-eta (s.2 i) >
        f (s.2 i) } ;
      agrees (w : Fr s.1) : Id G.C (psi-s w) (I.lift s.1 G tG (\ i -> f (s.2 i)) w) =
        I.lift-unique s.1 G tG (\ i -> f (s.2 i)) psi-s hom-s gen-s w ;
    } ;
    unique (p : F) : Id G.C (psi p) (lift p) =
      Q.induction @k (\ p0 -> Id G.C (psi p0) (lift p0)) (\ p0 -> G.set (psi p0) (lift p0)) (\ x -> calc G.C {
        psi (Q.inc x) =< AtStage[x.1].agrees x.2 >
        val x =< symH (lift-beta x) >
        lift (Q.inc x) }) p ;
  } ;
} ;
