-- Abelian.seg: the colimit for the abelian instance is commutative, so it
-- is itself a target: A(X) is the free abelian group on X.
-- (s,u) (t,v) is linked to (t,v) (s,u) by the swap s + t -> t + s:
-- swap (inl u . inr v) = inr u . inl v = inl v . inr u in Z^(t+s).
level l k ;
constraint l <= k ;
open Base ; open Prelude[k] ; open Paths[k] ; open Codes[l] ;
module AI = AbelianInstance[l,k] ;

module AbelianFree (X : U k) {
  module FG = FreeGroup[l,k].FreeGroup[AI.abelian, X] ; open FG ; open CX ; open St ;

  swap-map (a b : FT) : El (fplus a b) -> El (fplus b a) = split { inl i -> inr i ; inr j -> inl j } ;
  swap-tri (s t : Stage) : (i : El (fplus s.1 t.1)) -> Id X ((splus t s).2 (swap-map s.1 t.1 i)) ((splus s t).2 i) = split {
    inl i -> refl (s.2 i) ; inr j -> refl (t.2 j) } ;

  link-comm (x y : Elt) : Link (emul x y) (emul y x) =
    link-over (emul x y) (emul y x) (swap-map x.1.1 y.1.1, swap-tri x.1 y.1) (calc (Fr (fplus y.1.1 x.1.1)) {
      push (fplus x.1.1 y.1.1) (fplus y.1.1 x.1.1) (swap-map x.1.1 y.1.1) (pair x.1.1 y.1.1 x.2 y.2)
        =< push-pair x.1.1 y.1.1 (fplus y.1.1 x.1.1) (swap-map x.1.1 y.1.1) x.2 y.2 >
      (AI.Zc (fplus y.1.1 x.1.1)).mul (push x.1.1 (fplus y.1.1 x.1.1) (\ i -> inr i) x.2) (push y.1.1 (fplus y.1.1 x.1.1) (\ j -> inl j) y.2)
        =< AI.Zc-comm (fplus y.1.1 x.1.1) (push x.1.1 (fplus y.1.1 x.1.1) (\ i -> inr i) x.2) (push y.1.1 (fplus y.1.1 x.1.1) (\ j -> inl j) y.2) >
      pair y.1.1 x.1.1 y.2 x.2 }) ;

  comm (p q : F) : Id F (mul p q) (mul q p) =
    Q.induction @k (\ p0 -> Id F (mul p0 q) (mul q p0)) (\ p0 -> Q.set (mul p0 q) (mul q p0)) (\ x ->
    Q.induction @k (\ q0 -> Id F (mul (Q.inc x) q0) (mul q0 (Q.inc x))) (\ q0 -> Q.set (mul (Q.inc x) q0) (mul q0 (Q.inc x))) (\ y -> calc F {
      mul (Q.inc x) (Q.inc y) =< mul-beta x y >
      Q.inc (emul x y) =< related (emul x y) (emul y x) (link-comm x y) >
      Q.inc (emul y x) =< symH (mul-beta y x) >
      mul (Q.inc y) (Q.inc x) }) q) p ;

  -- A(X) is a target of the abelian instance
  target : AI.Target FX = comm ;
} ;
