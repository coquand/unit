-- AbelianInstance.seg: the free abelian groups Z^c on the finite stages
-- satisfy the interface, for abelian target groups.
--   T c = (El c -> Z) with pointwise addition,  gen c j = delta_j,
--   push m u (z) = sum_{i, m i = z} u i,
--   lift f u = sum_i (u i).(f i).
-- push is functorial by Fubini and the delta rule; a generator delta_j =
-- push m u has 1 = sum_{m i = j} u i, so some i has m i = j.  Uniqueness of
-- lifts by induction on the code: on 1, a homomorphism from Z is
-- n |-> n.(chi 1) (Multiples.FromZ); on a + b, u = inl u_a + inr u_b.
level l k ;
constraint l <= k ;
open Base ; open Prelude[k] ; open Paths[k] ; open Decisions[l] ; open Codes[l] ;
module GL = Group[l] ; module GK = Group[k] ; module Z = Integers[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module SZ = FinSum[l,l].Sums[Z.intAb] ;
module ZL = Torsor[l].AbL[Z.intAb] ;
oneZ : Z.Int = Multiples[l,k].oneZ ;

V (c : FT) : U l = El c -> Z.Int ;
ext (c : FT) (u v : V c) (h : (i : El c) -> Id Z.Int (u i) (v i)) : Id (V c) u v = FL.funext (El c) (\ i -> Z.Int) u v h ;

Zc (c : FT) : GL.Grp = new GL.Grp[V c, FL.isSet-Pi (El c) (\ i -> Z.Int) (\ i -> Z.int-set),
  \ i -> Z.zeroZ, \ u v i -> Z.add (u i) (v i), \ u i -> Z.neg (u i),
  \ u v w -> ext c (\ i -> Z.add (Z.add (u i) (v i)) (w i)) (\ i -> Z.add (u i) (Z.add (v i) (w i))) (\ i -> Z.assoc (u i) (v i) (w i)),
  \ u -> ext c (\ i -> Z.add Z.zeroZ (u i)) u (\ i -> Z.zero-l (u i)),
  \ u -> ext c (\ i -> Z.add (u i) Z.zeroZ) u (\ i -> refl (u i)),
  \ u -> ext c (\ i -> Z.add (Z.neg (u i)) (u i)) (\ i -> Z.zeroZ) (\ i -> ZL.invl (u i)),
  \ u -> ext c (\ i -> Z.add (u i) (Z.neg (u i))) (\ i -> Z.zeroZ) (\ i -> Z.invr (u i))] ;
Zc-comm (c : FT) (u v : V c) : Id (V c) ((Zc c).mul u v) ((Zc c).mul v u) =
  ext c ((Zc c).mul u v) ((Zc c).mul v u) (\ i -> Z.comm (u i) (v i)) ;

gen (c : FT) (j : El c) : V c = \ i -> ite Z.Int (eqEl c i j) oneZ Z.zeroZ ;
push (a b : FT) (m : El a -> El b) (u : V a) : V b = \ z -> SZ.sum a (\ i -> ite Z.Int (eqEl b (m i) z) (u i) Z.zeroZ) ;

push-mul (a b : FT) (m : El a -> El b) (u v : V a)
  : Id (V b) (push a b m ((Zc a).mul u v)) ((Zc b).mul (push a b m u) (push a b m v)) =
  ext b (push a b m ((Zc a).mul u v)) ((Zc b).mul (push a b m u) (push a b m v)) (\ z -> calc Z.Int {
    SZ.sum a (\ i -> ite Z.Int (eqEl b (m i) z) (Z.add (u i) (v i)) Z.zeroZ)
      =< SZ.sum-ext a (\ i -> ite Z.Int (eqEl b (m i) z) (Z.add (u i) (v i)) Z.zeroZ)
           (\ i -> Z.add (ite Z.Int (eqEl b (m i) z) (u i) Z.zeroZ) (ite Z.Int (eqEl b (m i) z) (v i) Z.zeroZ))
           (\ i -> SZ.ite-add (eqEl b (m i) z) (u i) (v i)) >
    SZ.sum a (\ i -> Z.add (ite Z.Int (eqEl b (m i) z) (u i) Z.zeroZ) (ite Z.Int (eqEl b (m i) z) (v i) Z.zeroZ))
      =< SZ.sum-add a (\ i -> ite Z.Int (eqEl b (m i) z) (u i) Z.zeroZ) (\ i -> ite Z.Int (eqEl b (m i) z) (v i) Z.zeroZ) >
    Z.add (push a b m u z) (push a b m v z) }) ;

push-comp (a b c : FT) (m : El a -> El b) (n : El b -> El c) (u : V a)
  : Id (V c) (push b c n (push a b m u)) (push a c (\ i -> n (m i)) u) =
  ext c (push b c n (push a b m u)) (push a c (\ i -> n (m i)) u) (\ w -> calc Z.Int {
    SZ.sum b (\ z -> ite Z.Int (eqEl c (n z) w) (SZ.sum a (\ i -> ite Z.Int (eqEl b (m i) z) (u i) Z.zeroZ)) Z.zeroZ)
      =< SZ.sum-ext b (\ z -> ite Z.Int (eqEl c (n z) w) (SZ.sum a (\ i -> ite Z.Int (eqEl b (m i) z) (u i) Z.zeroZ)) Z.zeroZ)
           (\ z -> SZ.sum a (\ i -> ite Z.Int (eqEl c (n z) w) (ite Z.Int (eqEl b (m i) z) (u i) Z.zeroZ) Z.zeroZ))
           (\ z -> SZ.ite-sum a (\ i -> ite Z.Int (eqEl b (m i) z) (u i) Z.zeroZ) (eqEl c (n z) w)) >
    SZ.sum b (\ z -> SZ.sum a (\ i -> ite Z.Int (eqEl c (n z) w) (ite Z.Int (eqEl b (m i) z) (u i) Z.zeroZ) Z.zeroZ))
      =< SZ.sum-swap a b (\ z i -> ite Z.Int (eqEl c (n z) w) (ite Z.Int (eqEl b (m i) z) (u i) Z.zeroZ) Z.zeroZ) >
    SZ.sum a (\ i -> SZ.sum b (\ z -> ite Z.Int (eqEl c (n z) w) (ite Z.Int (eqEl b (m i) z) (u i) Z.zeroZ) Z.zeroZ))
      =< SZ.sum-ext a (\ i -> SZ.sum b (\ z -> ite Z.Int (eqEl c (n z) w) (ite Z.Int (eqEl b (m i) z) (u i) Z.zeroZ) Z.zeroZ))
           (\ i -> SZ.sum b (\ z -> ite Z.Int (eqEl b (m i) z) (ite Z.Int (eqEl c (n z) w) (u i) Z.zeroZ) Z.zeroZ))
           (\ i -> SZ.sum-ext b (\ z -> ite Z.Int (eqEl c (n z) w) (ite Z.Int (eqEl b (m i) z) (u i) Z.zeroZ) Z.zeroZ)
                     (\ z -> ite Z.Int (eqEl b (m i) z) (ite Z.Int (eqEl c (n z) w) (u i) Z.zeroZ) Z.zeroZ)
                     (\ z -> SZ.ite-ite (u i) (eqEl c (n z) w) (eqEl b (m i) z))) >
    SZ.sum a (\ i -> SZ.sum b (\ z -> ite Z.Int (eqEl b (m i) z) (ite Z.Int (eqEl c (n z) w) (u i) Z.zeroZ) Z.zeroZ))
      =< SZ.sum-ext a (\ i -> SZ.sum b (\ z -> ite Z.Int (eqEl b (m i) z) (ite Z.Int (eqEl c (n z) w) (u i) Z.zeroZ) Z.zeroZ))
           (\ i -> ite Z.Int (eqEl c (n (m i)) w) (u i) Z.zeroZ)
           (\ i -> SZ.delta' b (m i) (\ z -> ite Z.Int (eqEl c (n z) w) (u i) Z.zeroZ)) >
    SZ.sum a (\ i -> ite Z.Int (eqEl c (n (m i)) w) (u i) Z.zeroZ) }) ;

push-id (a : FT) (u : V a) : Id (V a) (push a a (\ i -> i) u) u =
  ext a (push a a (\ i -> i) u) u (\ z -> SZ.delta a z u) ;

push-ext (a b : FT) (m m' : El a -> El b) (h : (i : El a) -> Id (El b) (m i) (m' i)) (u : V a)
  : Id (V b) (push a b m u) (push a b m' u) = ext b (push a b m u) (push a b m' u) (\ z ->
    SZ.sum-ext a (\ i -> ite Z.Int (eqEl b (m i) z) (u i) Z.zeroZ) (\ i -> ite Z.Int (eqEl b (m' i) z) (u i) Z.zeroZ)
      (\ i -> apH (\ y -> ite Z.Int (eqEl b y z) (u i) Z.zeroZ) (h i))) ;

push-gen (a b : FT) (m : El a -> El b) (i : El a) : Id (V b) (push a b m (gen a i)) (gen b (m i)) =
  ext b (push a b m (gen a i)) (gen b (m i)) (\ z -> calc Z.Int {
    SZ.sum a (\ q -> ite Z.Int (eqEl b (m q) z) (ite Z.Int (eqEl a q i) oneZ Z.zeroZ) Z.zeroZ)
      =< SZ.sum-ext a (\ q -> ite Z.Int (eqEl b (m q) z) (ite Z.Int (eqEl a q i) oneZ Z.zeroZ) Z.zeroZ)
           (\ q -> ite Z.Int (eqEl a q i) (ite Z.Int (eqEl b (m q) z) oneZ Z.zeroZ) Z.zeroZ)
           (\ q -> SZ.ite-ite oneZ (eqEl b (m q) z) (eqEl a q i)) >
    SZ.sum a (\ q -> ite Z.Int (eqEl a q i) (ite Z.Int (eqEl b (m q) z) oneZ Z.zeroZ) Z.zeroZ)
      =< SZ.delta a i (\ q -> ite Z.Int (eqEl b (m q) z) oneZ Z.zeroZ) >
    ite Z.Int (eqEl b (m i) z) oneZ Z.zeroZ
      =< apH (\ bb -> ite Z.Int bb oneZ Z.zeroZ) (eqEl-sym b (m i) z) >
    ite Z.Int (eqEl b z (m i)) oneZ Z.zeroZ }) ;

-- delta_j (j) = 1
gen-self (c : FT) (j : El c) : Id Z.Int (gen c j j) oneZ =
  apH (\ bb -> ite Z.Int bb oneZ Z.zeroZ) (DiscreteL[disc c].eq-self j) ;

gen-inj (c : FT) (i j : El c) (p : Id (V c) (gen c i) (gen c j)) : Id (El c) i j =
  cases (\ bb -> Id Z.Int (ite Z.Int bb oneZ Z.zeroZ) oneZ -> Id (El c) i j) (eqEl c j i)
    (\ e r -> symH (eqEl-sound c j i (so-true (eqEl c j i) e)))
    (\ e r -> absurd (Id (El c) i j) (Z.encode Z.zeroZ oneZ r))
    (transH (Prelude[l].happly (El c) (\ q -> Z.Int) (gen c i) (gen c j) p j) (gen-self c j)) ;

support-of (a b : FT) (m : El a -> El b) (u : V a) (j : El b)
  (q : Id Z.Int oneZ (push a b m u j)) : Decided a (\ i -> eqEl b (m i) j) -> (i : El a) * Id (El b) (m i) j = split {
  inl w -> (w.1, eqEl-sound b (m w.1) j w.2) ;
  inr nn -> absurd ((i : El a) * Id (El b) (m i) j) (Z.encode oneZ Z.zeroZ (calc Z.Int {
    oneZ =< q > push a b m u j
      =< SZ.sum-ext a (\ i -> ite Z.Int (eqEl b (m i) j) (u i) Z.zeroZ) (\ i -> Z.zeroZ)
           (\ i -> apH (\ bb -> ite Z.Int bb (u i) Z.zeroZ) (not-so-false (eqEl b (m i) j) (nn i))) >
    SZ.sum a (\ i -> Z.zeroZ) =< SZ.sum-zero a > Z.zeroZ })) } ;
support (a b : FT) (m : El a -> El b) (u : V a) (j : El b) (p : Id (V b) (gen b j) (push a b m u))
  : (i : El a) * Id (El b) (m i) j =
  support-of a b m u j (transH (symH (gen-self b j)) (Prelude[l].happly (El b) (\ q -> Z.Int) (gen b j) (push a b m u) p j))
    (decide a (\ i -> eqEl b (m i) j)) ;

empty-prop (c : FT) (n : Not (El c)) : isProp (V c) = \ u v -> ext c u v (\ i -> absurd (Id Z.Int (u i) (v i)) (n i)) ;

------------------------------------------------------------------------
-- the universal property for abelian groups

Target (G : GK.Grp) : U k = (x y : G.C) -> Id G.C (G.mul x y) (G.mul y x) ;
abG (G : GK.Grp) (tG : Target G) : Torsor[k].Ab = new Torsor[k].Ab[G.C, G.set, G.e, G.mul, G.inv, G.assoc, tG, G.unitr, G.invr] ;

lift (c : FT) (G : GK.Grp) (tG : Target G) (f : El c -> G.C) (u : V c) : G.C =
  FinSum[l,k].Sums[abG G tG].sum c (\ i -> Multiples[l,k].Mult[abG G tG].multZ (f i) (u i)) ;

module LiftL (G : GK.Grp) (tG : Target G) {
  module SG = FinSum[l,k].Sums[abG G tG] ; module M = Multiples[l,k].Mult[abG G tG] ;

  lift-mul (c : FT) (f : El c -> G.C) (u v : V c)
    : Id G.C (lift c G tG f ((Zc c).mul u v)) (G.mul (lift c G tG f u) (lift c G tG f v)) = calc G.C {
    SG.sum c (\ i -> M.multZ (f i) (Z.add (u i) (v i)))
      =< SG.sum-ext c (\ i -> M.multZ (f i) (Z.add (u i) (v i))) (\ i -> G.mul (M.multZ (f i) (u i)) (M.multZ (f i) (v i)))
           (\ i -> M.mult-add (f i) (u i) (v i)) >
    SG.sum c (\ i -> G.mul (M.multZ (f i) (u i)) (M.multZ (f i) (v i)))
      =< SG.sum-add c (\ i -> M.multZ (f i) (u i)) (\ i -> M.multZ (f i) (v i)) >
    G.mul (lift c G tG f u) (lift c G tG f v) } ;

  lift-gen (c : FT) (f : El c -> G.C) (i : El c) : Id G.C (lift c G tG f (gen c i)) (f i) = calc G.C {
    SG.sum c (\ q -> M.multZ (f q) (ite Z.Int (eqEl c q i) oneZ Z.zeroZ))
      =< SG.sum-ext c (\ q -> M.multZ (f q) (ite Z.Int (eqEl c q i) oneZ Z.zeroZ))
           (\ q -> Decisions[k].ite G.C (eqEl c q i) (M.multZ (f q) oneZ) G.e)
           (\ q -> M.mult-ite (f q) oneZ (eqEl c q i)) >
    SG.sum c (\ q -> Decisions[k].ite G.C (eqEl c q i) (M.multZ (f q) oneZ) G.e)
      =< SG.delta c i (\ q -> M.multZ (f q) oneZ) >
    M.multZ (f i) oneZ =< M.mult-one (f i) >
    f i } ;

  lift-push (a b : FT) (m : El a -> El b) (f : El b -> G.C) (u : V a)
    : Id G.C (lift b G tG f (push a b m u)) (lift a G tG (\ i -> f (m i)) u) = calc G.C {
    SG.sum b (\ z -> M.multZ (f z) (SZ.sum a (\ i -> ite Z.Int (eqEl b (m i) z) (u i) Z.zeroZ)))
      =< SG.sum-ext b (\ z -> M.multZ (f z) (SZ.sum a (\ i -> ite Z.Int (eqEl b (m i) z) (u i) Z.zeroZ)))
           (\ z -> SG.sum a (\ i -> M.multZ (f z) (ite Z.Int (eqEl b (m i) z) (u i) Z.zeroZ)))
           (\ z -> M.mult-sum (f z) a (\ i -> ite Z.Int (eqEl b (m i) z) (u i) Z.zeroZ)) >
    SG.sum b (\ z -> SG.sum a (\ i -> M.multZ (f z) (ite Z.Int (eqEl b (m i) z) (u i) Z.zeroZ)))
      =< SG.sum-ext b (\ z -> SG.sum a (\ i -> M.multZ (f z) (ite Z.Int (eqEl b (m i) z) (u i) Z.zeroZ)))
           (\ z -> SG.sum a (\ i -> Decisions[k].ite G.C (eqEl b (m i) z) (M.multZ (f z) (u i)) G.e))
           (\ z -> SG.sum-ext a (\ i -> M.multZ (f z) (ite Z.Int (eqEl b (m i) z) (u i) Z.zeroZ))
                     (\ i -> Decisions[k].ite G.C (eqEl b (m i) z) (M.multZ (f z) (u i)) G.e)
                     (\ i -> M.mult-ite (f z) (u i) (eqEl b (m i) z))) >
    SG.sum b (\ z -> SG.sum a (\ i -> Decisions[k].ite G.C (eqEl b (m i) z) (M.multZ (f z) (u i)) G.e))
      =< SG.sum-swap a b (\ z i -> Decisions[k].ite G.C (eqEl b (m i) z) (M.multZ (f z) (u i)) G.e) >
    SG.sum a (\ i -> SG.sum b (\ z -> Decisions[k].ite G.C (eqEl b (m i) z) (M.multZ (f z) (u i)) G.e))
      =< SG.sum-ext a (\ i -> SG.sum b (\ z -> Decisions[k].ite G.C (eqEl b (m i) z) (M.multZ (f z) (u i)) G.e))
           (\ i -> M.multZ (f (m i)) (u i))
           (\ i -> SG.delta' b (m i) (\ z -> M.multZ (f z) (u i))) >
    SG.sum a (\ i -> M.multZ (f (m i)) (u i)) } ;
} ;

-- uniqueness, by induction on the code
Uniq (c : FT) : U k+ = (G : GK.Grp) -> (tG : Target G) -> (f : El c -> G.C) -> (psi : V c -> G.C)
  -> ((u v : V c) -> Id G.C (psi ((Zc c).mul u v)) (G.mul (psi u) (psi v)))
  -> ((i : El c) -> Id G.C (psi (gen c i)) (f i)) -> (u : V c) -> Id G.C (psi u) (lift c G tG f u) ;

uniq-zero : Uniq fzero = \ G tG f psi hom on-gen u -> calc G.C {
  psi u =< apH psi (empty-prop fzero (\ x -> x) u (Zc fzero).e) >
  psi (Zc fzero).e =< GK.GrpL[G].idem (psi (Zc fzero).e) (symH (hom (Zc fzero).e (Zc fzero).e)) >
  G.e } ;

uniq-one : Uniq fone = \ G tG f psi hom on-gen u -> calc G.C {
  psi u =< apH psi (ext fone u (\ i -> u tt) (\ i -> apH u (isTop i tt))) >
  psi (\ i -> u tt)
    =< Multiples[l,k].Mult[abG G tG].FromZ[\ n -> psi (\ i -> n), \ x y -> hom (\ i -> x) (\ i -> y)].is-mult (u tt) >
  Multiples[l,k].Mult[abG G tG].multZ (psi (\ i -> oneZ)) (u tt)
    =< apH (\ g -> Multiples[l,k].Mult[abG G tG].multZ g (u tt)) (on-gen tt) >
  Multiples[l,k].Mult[abG G tG].multZ (f tt) (u tt) } ;

-- u = inl u_a + inr u_b
decomp-at (a b : FT) (u : V (fplus a b)) : (z : El (fplus a b)) -> Id Z.Int (u z)
  (Z.add (push a (fplus a b) (\ i -> inl i) (\ i -> u (inl i)) z) (push b (fplus a b) (\ i -> inr i) (\ i -> u (inr i)) z)) = split {
  inl z -> symH (SZ.add-cong (SZ.sum a (\ i -> ite Z.Int (eqEl a i z) (u (inl i)) Z.zeroZ)) (u (inl z))
                   (SZ.sum b (\ i -> Z.zeroZ)) Z.zeroZ (SZ.delta a z (\ i -> u (inl i))) (SZ.sum-zero b)) ;
  inr z -> symH (transH (SZ.add-cong (SZ.sum a (\ i -> Z.zeroZ)) Z.zeroZ
                   (SZ.sum b (\ i -> ite Z.Int (eqEl b i z) (u (inr i)) Z.zeroZ)) (u (inr z)) (SZ.sum-zero a) (SZ.delta b z (\ i -> u (inr i))))
                   (Z.zero-l (u (inr z)))) } ;
decomp (a b : FT) (u : V (fplus a b)) : Id (V (fplus a b)) u
  ((Zc (fplus a b)).mul (push a (fplus a b) (\ i -> inl i) (\ i -> u (inl i))) (push b (fplus a b) (\ i -> inr i) (\ i -> u (inr i)))) =
  ext (fplus a b) u ((Zc (fplus a b)).mul (push a (fplus a b) (\ i -> inl i) (\ i -> u (inl i))) (push b (fplus a b) (\ i -> inr i) (\ i -> u (inr i))))
    (decomp-at a b u) ;

module Plus (a b : FT) (ua : Uniq a) (ub : Uniq b) (G : GK.Grp) (tG : Target G) (f : El (fplus a b) -> G.C)
  (psi : V (fplus a b) -> G.C) (hom : (u v : V (fplus a b)) -> Id G.C (psi ((Zc (fplus a b)).mul u v)) (G.mul (psi u) (psi v)))
  (on-gen : (i : El (fplus a b)) -> Id G.C (psi (gen (fplus a b) i)) (f i)) {
  -- psi along a summand
  module Side (c : FT) (s : El c -> El (fplus a b)) {
    psi-s (u : V c) : G.C = psi (push c (fplus a b) s u) ;
    hom-s (u v : V c) : Id G.C (psi-s ((Zc c).mul u v)) (G.mul (psi-s u) (psi-s v)) = calc G.C {
      psi (push c (fplus a b) s ((Zc c).mul u v)) =< apH psi (push-mul c (fplus a b) s u v) >
      psi ((Zc (fplus a b)).mul (push c (fplus a b) s u) (push c (fplus a b) s v))
        =< hom (push c (fplus a b) s u) (push c (fplus a b) s v) >
      G.mul (psi-s u) (psi-s v) } ;
    gen-s (i : El c) : Id G.C (psi-s (gen c i)) (f (s i)) = calc G.C {
      psi (push c (fplus a b) s (gen c i)) =< apH psi (push-gen c (fplus a b) s i) >
      psi (gen (fplus a b) (s i)) =< on-gen (s i) > f (s i) } ;
  } ;
  result (u : V (fplus a b)) : Id G.C (psi u) (lift (fplus a b) G tG f u) = calc G.C {
    psi u =< apH psi (decomp a b u) >
    psi ((Zc (fplus a b)).mul (push a (fplus a b) (\ i -> inl i) (\ i -> u (inl i))) (push b (fplus a b) (\ i -> inr i) (\ i -> u (inr i))))
      =< hom (push a (fplus a b) (\ i -> inl i) (\ i -> u (inl i))) (push b (fplus a b) (\ i -> inr i) (\ i -> u (inr i))) >
    G.mul (Side[a, \ i -> inl i].psi-s (\ i -> u (inl i))) (Side[b, \ i -> inr i].psi-s (\ i -> u (inr i)))
      =< FinSum[l,k].Sums[abG G tG].add-cong
           (Side[a, \ i -> inl i].psi-s (\ i -> u (inl i))) (lift a G tG (\ i -> f (inl i)) (\ i -> u (inl i)))
           (Side[b, \ i -> inr i].psi-s (\ i -> u (inr i))) (lift b G tG (\ i -> f (inr i)) (\ i -> u (inr i)))
           (ua G tG (\ i -> f (inl i)) (Side[a, \ i -> inl i].psi-s) (Side[a, \ i -> inl i].hom-s) (Side[a, \ i -> inl i].gen-s) (\ i -> u (inl i)))
           (ub G tG (\ i -> f (inr i)) (Side[b, \ i -> inr i].psi-s) (Side[b, \ i -> inr i].hom-s) (Side[b, \ i -> inr i].gen-s) (\ i -> u (inr i))) >
    G.mul (lift a G tG (\ i -> f (inl i)) (\ i -> u (inl i))) (lift b G tG (\ i -> f (inr i)) (\ i -> u (inr i))) } ;
} ;

uniq : (c : FT) -> Uniq c = split {
  fzero -> uniq-zero ;
  fone -> uniq-one ;
  fplus a b | ua ub -> \ G tG f psi hom on-gen u -> Plus[a, b, ua, ub, G, tG, f, psi, hom, on-gen].result u } ;

abelian : Interface[l,k].FinFree = new Interface[l,k].FinFree[
  T := Zc, gen := gen, push := push, push-mul := push-mul, push-comp := push-comp, push-id := push-id,
  push-ext := push-ext, push-gen := push-gen, gen-inj := gen-inj, support := support, empty-prop := empty-prop,
  Target := Target, lift := lift,
  lift-mul := \ c G tG f u v -> LiftL[G, tG].lift-mul c f u v,
  lift-gen := \ c G tG f i -> LiftL[G, tG].lift-gen c f i,
  lift-unique := \ c G tG f psi hom on-gen u -> uniq c G tG f psi hom on-gen u,
  lift-push := \ a b m G tG f u -> LiftL[G, tG].lift-push a b m f u ] ;
