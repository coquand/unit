-- Decisions.seg: Booleans as decisions, and discrete types.
--
-- A discrete type is a type with a Boolean equality which is reflexive and
-- sound.  By Hedberg's lemma a discrete type is a set.  Decisions are
-- Booleans, so that the reduction of words (Words.seg) computes; "so b"
-- is the proposition that b is true.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ;

data Plus (A B : U l) : U l = inl (x : A) | inr (y : B) ;

so : Bool -> U l = split { true -> Top ; false -> Empty } ;
so-prop : (b : Bool) -> isProp (so b) = split { true -> isTop ; false -> isProp-Empty } ;

-- if b then x else y
ite (A : U l) : Bool -> A -> A -> A = split { true -> \ x y -> x ; false -> \ x y -> y } ;
ite-same (A : U l) (y : A) : (b : Bool) -> Id A (ite A b y y) y = split {
  true -> refl y ; false -> refl y } ;

-- reasoning by cases on a decision
cases (P : Bool -> U l) : (b : Bool) -> (Id Bool b true -> P true) -> (Id Bool b false -> P false) -> P b =
  split { true -> \ t f -> t (refl true) ; false -> \ t f -> f (refl false) } ;
so-true (b : Bool) (p : Id Bool b true) : so b = substH so (symH p) tt ;
so-false (b : Bool) (p : Id Bool b false) (s : so b) : Empty = substH so p s ;
true-so : (b : Bool) -> so b -> Id Bool b true = split {
  true -> \ s -> refl true ; false -> \ s -> absurd (Id Bool false true) s } ;
false-not : (b : Bool) -> so (not b) -> Id Bool b false = split {
  true -> \ s -> absurd (Id Bool true false) s ; false -> \ s -> refl false } ;
not-false (b : Bool) (p : Id Bool b false) : so (not b) = substH (\ c -> so (not c)) (symH p) tt ;

so-and-l : (a b : Bool) -> so (and a b) -> so a = split {
  true -> \ b s -> tt ; false -> \ b s -> s } ;
so-and-r : (a b : Bool) -> so (and a b) -> so b = split {
  true -> \ b s -> s ; false -> \ b s -> absurd (so b) s } ;
so-and : (a b : Bool) -> so a -> so b -> so (and a b) = split {
  true -> \ b s t -> t ; false -> \ b s t -> s } ;

record Discrete {
  A : U l ;
  eq : A -> A -> Bool ;
  eq-refl (a : A) : so (eq a a) ;
  eq-sound (a b : A) : so (eq a b) -> Id A a b ;
} ;

module DiscreteL (D : Discrete) {
  open D ;
  eq-true (a b : A) (p : Id A a b) : Id Bool (eq a b) true =
    true-so (eq a b) (substH (\ y -> so (eq a y)) p (eq-refl a)) ;
  eq-self (a : A) : Id Bool (eq a a) true = true-so (eq a a) (eq-refl a) ;
  set : isSet A = \ a ->
    Hedberg[A, a, \ b -> so (eq a b), \ b -> so-prop (eq a b), eq-refl a, eq-sound a].hedberg ;
} ;

-- Booleans with the same truth are equal
bool-ext : (a b : Bool) -> (so a -> so b) -> (so b -> so a) -> Id Bool a b = split {
  true -> split { true -> \ f g -> refl true ; false -> \ f g -> absurd (Id Bool true false) (f tt) } ;
  false -> split { true -> \ f g -> absurd (Id Bool false true) (g tt) ; false -> \ f g -> refl false } } ;
