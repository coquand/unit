-- Injective.seg: for a set X, eta : X -> F(X) is injective.
-- If eta a = eta b, the quotient is effective: some stage t has maps m, n
-- from the point stages a and b with m(gen) = n(gen) over t, i.e. the
-- one-letter words of m tt and n tt are equal, so m tt = n tt (gen-inj),
-- and a = t (m tt) = t (n tt) = b.  The conclusion is a proposition since X
-- is a set, so the truncated link may be used.
level l k ;
constraint l <= k ;
open Base ; open Prelude[k] ; open Paths[k] ; open Codes[l] ;

module Injective (I : Interface[l,k].FinFree) (X : U k) (setX : isSet X) {
  module FG = FreeGroup[l,k].FreeGroup[I, X] ; open FG ; open CX ; open St ;
  pt (a : X) : Elt = (spoint a, I.gen fone tt) ;
  from-link (a b : X) (L : Link (pt a) (pt b)) : Id X a b = calc X {
    a =< symH (L.2.1.2 tt) >
    L.1.2 (L.2.1.1 tt)
      =< apH L.1.2 (I.gen-inj L.1.1 (L.2.1.1 tt) (L.2.2.1.1 tt) (calc (Fr L.1.1) {
           I.gen L.1.1 (L.2.1.1 tt) =< symH (I.push-gen fone L.1.1 L.2.1.1 tt) >
           push fone L.1.1 L.2.1.1 (I.gen fone tt) =< L.2.2.2 >
           push fone L.1.1 L.2.2.1.1 (I.gen fone tt) =< I.push-gen fone L.1.1 L.2.2.1.1 tt >
           I.gen L.1.1 (L.2.2.1.1 tt) })) >
    L.1.2 (L.2.2.1.1 tt)
      =< L.2.2.1.2 tt >
    b } ;
  eta-inj (a b : X) (p : Id F (eta a) (eta b)) : Id X a b =
    rel-elim (pt a) (pt b) (Id X a b) (setX a b) (from-link a b) (Q.effective (pt a) (pt b) p) ;
} ;
