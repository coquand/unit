-- Horner values and their dual-number derivatives commute with a square
-- of coefficient and target ring maps. No injectivity is required.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Lists (A K : CRing) (f : H.Hom A K) {
 map : List A.R -> List K.R = split { nil -> nil ; cons a p | ih -> cons (f.1 a) ih } ;
} ;
identity-list (A : CRing) : (p : List A.R) -> Id (List A.R) (Lists[A,A,H.identity A].map p) p = split {
 nil -> refl nil ; cons a p | ih -> ap (\ q -> cons a q) ih } ;
module Values (A K B C : CRing) (f : H.Hom A K) (i : H.Hom A B)
 (j : H.Hom K C) (h : H.Hom B C)
 (square : (a : A.R) -> Id C.R (h.1 (i.1 a)) (j.1 (f.1 a))) (x : B.R) {
 module P = Lists[A,K,f] ;
 module HB = MonicReduce[l].Horner[A,B,i,x] ;
 module HC = MonicReduce[l].Horner[K,C,j,h.1 x] ;
 value : (p : List A.R) -> Id C.R (h.1 (HB.horner p)) (HC.horner (P.map p)) = split {
  nil -> H.zero B C h ;
  cons a p | ih -> trans (h.2.2.1 (i.1 a) (B.mul x (HB.horner p)))
   (cong2 C.R C.add _ _ _ _ (square a)
    (trans (h.2.2.2 x (HB.horner p)) (ap (C.mul (h.1 x)) ih))) } ;
} ;
module Dual (B C : CRing) (setB : Pr.isSet B.R) (setC : Pr.isSet C.R) (h : H.Hom B C) {
 module DB = QuadraticPairs[l].Over[B,setB,B.z] ;
 module DC = QuadraticPairs[l].Over[C,setC,C.z] ;
 function (p : DB.Pair) : DC.Pair = (h.1 p.1,h.1 p.2) ;
 one : Id DC.Pair (function DB.oneQ) DC.oneQ = DC.eq _ _ h.2.1 (H.zero B C h) ;
 add (p q : DB.Pair) : Id DC.Pair (function (DB.plusQ p q)) (DC.plusQ (function p) (function q)) =
  DC.eq _ _ (h.2.2.1 p.1 q.1) (h.2.2.1 p.2 q.2) ;
 mul (p q : DB.Pair) : Id DC.Pair (function (DB.timesQ p q)) (DC.timesQ (function p) (function q)) =
  DC.eq _ _
   (trans (h.2.2.1 (B.mul p.1 q.1) (B.mul B.z (B.mul p.2 q.2)))
    (cong2 C.R C.add _ _ _ _ (h.2.2.2 p.1 q.1)
     (trans (h.2.2.2 B.z (B.mul p.2 q.2))
      (cong2 C.R C.mul _ _ _ _ (H.zero B C h) (h.2.2.2 p.2 q.2)))))
   (trans (h.2.2.1 (B.mul p.1 q.2) (B.mul p.2 q.1))
    (cong2 C.R C.add _ _ _ _ (h.2.2.2 p.1 q.2) (h.2.2.2 p.2 q.1))) ;
 hom : H.Hom DB.ring DC.ring = (function,one,add,mul) ;
 constant (b : B.R) : Id DC.Pair (function (DB.constant b)) (DC.constant (h.1 b)) =
  DC.eq _ _ (refl (h.1 b)) (H.zero B C h) ;
} ;
module Derivatives (A K B C : CRing) (setB : Pr.isSet B.R) (setC : Pr.isSet C.R)
 (f : H.Hom A K) (i : H.Hom A B) (j : H.Hom K C) (h : H.Hom B C)
 (square : (a : A.R) -> Id C.R (h.1 (i.1 a)) (j.1 (f.1 a))) (x : B.R) {
 module D = Dual[B,C,setB,setC,h] ; module P = Lists[A,K,f] ;
 bi : H.Hom A D.DB.ring = H.compose A B D.DB.ring D.DB.inclusion i ;
 ci : H.Hom K D.DC.ring = H.compose K C D.DC.ring D.DC.inclusion j ;
 dual-square (a : A.R) : Id D.DC.Pair (D.function (bi.1 a)) (ci.1 (f.1 a)) =
  D.DC.eq _ _ (square a) (H.zero B C h) ;
 module V = Values[A,K,D.DB.ring,D.DC.ring,f,bi,ci,D.hom,dual-square,(x,B.o)] ;
 bvalue (p : List A.R) : D.DB.Pair = MonicReduce[l].Horner[A,D.DB.ring,bi,(x,B.o)].horner p ;
 cvalue (p : List K.R) : D.DC.Pair = MonicReduce[l].Horner[K,D.DC.ring,ci,(h.1 x,C.o)].horner p ;
 point : Id D.DC.Pair (D.function (x,B.o)) (h.1 x,C.o) = D.DC.eq _ _ (refl (h.1 x)) h.2.1 ;
 dual-value (p : List A.R) : Id D.DC.Pair (D.function (bvalue p)) (cvalue (P.map p)) =
  trans (V.value p)
   (ap (\ y -> MonicReduce[l].Horner[K,D.DC.ring,ci,y].horner (P.map p)) point) ;
 slope (p : List A.R) : Id C.R (h.1 (bvalue p).2) (cvalue (P.map p)).2 =
  ap (\ y -> y.2) (dual-value p) ;
} ;
module SameCoefficients (A B C : CRing) (setB : Pr.isSet B.R) (setC : Pr.isSet C.R)
 (i : H.Hom A B) (j : H.Hom A C) (h : H.Hom B C)
 (square : (a : A.R) -> Id C.R (h.1 (i.1 a)) (j.1 a)) (x : B.R) {
 module V = Values[A,A,B,C,H.identity A,i,j,h,square,x] ;
 module D = Derivatives[A,A,B,C,setB,setC,H.identity A,i,j,h,square,x] ;
 value (p : List A.R) : Id C.R (h.1 (V.HB.horner p)) (V.HC.horner p) =
  trans (V.value p) (ap V.HC.horner (identity-list A p)) ;
 slope (p : List A.R) : Id C.R (h.1 (D.bvalue p).2) (D.cvalue p).2 =
  trans (D.slope p) (ap (\ q -> (D.cvalue q).2) (identity-list A p)) ;
} ;
