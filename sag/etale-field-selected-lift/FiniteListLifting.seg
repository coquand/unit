-- Surjectivity lifts a finite coefficient list inside one truncation.
-- No function selecting representatives for all quotient elements occurs.
level l ; open Ring[l] ; open Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (A K : CRing) (f : RingHom[l].Hom A K)
 (onto : (c : K.R) -> Tr.Trunc[(a : A.R) * Id K.R (f.1 a) c].carrier) {
 module P = PolynomialNaturality[l].Lists[A,K,f] ;
 Rep (p : List K.R) : U l = (q : List A.R) * Id (List K.R) (P.map q) p ;
 nil-rep : Rep nil = (nil,refl nil) ;
 cons-rep (c : K.R) (p : List K.R) (a : (a : A.R) * Id K.R (f.1 a) c) (q : Rep p) : Rep (cons c p) =
  (cons a.1 q.1,Prelude[l].trans (List K.R) (cons (f.1 a.1) (P.map q.1)) (cons c (P.map q.1)) (cons c p) (ap (\ b -> cons b (P.map q.1)) a.2) (ap (\ r -> cons c r) q.2)) ;
 lists : (p : List K.R) -> Tr.Trunc[Rep p].carrier = split {
  nil -> Tr.Trunc[Rep nil].inc nil-rep ;
  cons c p | ih -> TC.map2 ((a : A.R) * Id K.R (f.1 a) c) (Rep p) (Rep (cons c p))
   (cons-rep c p) (onto c) ih } ;
 family (n : Nat) (p : Fin n -> List K.R) : Tr.Trunc[(i : Fin n) -> Rep (p i)].carrier =
  AffineFinite[l].choice n (\ i -> Rep (p i)) (\ i -> lists (p i)) ;
} ;
