-- Convert the finite-indexed IE certificates of QuotientFibre to the
-- finite lists used in the local proof. Both conversions are explicit;
-- truncation is retained when membership alone is supplied.
level l ; open Ring[l] ; open Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (R B : CRing) (m : R.R -> U l) (i : RingHom[l].Hom R B) {
 module W = IdealWitnesses[l].Over[R,m,B,i] ;
 module G = IdealGenerated[l].Over[R,m,B,i] ;
 module S = FiniteIdeal[l].Sums[B] ;
 sum : (n : Nat) (a : Fin n -> R.R) (ha : (j : Fin n) -> m (a j)) (w : Fin n -> B.R) ->
  G.InmB (S.lin n (\ j -> i.1 (a j)) w) = split {
  zero -> \ a ha w -> G.in-zero ;
  suc n | ih -> \ a ha w ->
   G.in-add _ _
    (subst G.InmB (B.mulC (w (inr tt)) (i.1 (a (inr tt))))
     (G.in-scale (w (inr tt)) (i.1 (a (inr tt))) (G.in-m (a (inr tt)) (ha (inr tt)))))
    (ih (\ j -> a (inl j)) (\ j -> ha (inl j)) (\ j -> w (inl j))) } ;
 forward (b : B.R) (w : W.Wit b) : G.InmB b = subst G.InmB (sym w.eq) (sum w.u w.a w.ina w.w) ;
 list : (ps : List G.Gen) -> W.Wit (G.Ls.lsum G.value ps) = split {
  nil -> W.ie-zero ;
  cons p ps | ih -> W.ie-add (G.value p) (G.Ls.lsum G.value ps)
   (new IdealWitnesses[l].IEWit[R,m,B,i,G.value p,suc zero,\ j -> p.1,\ j -> p.2.1,\ j -> p.2.2,
    sym (B.addZ (G.value p))]) ih } ;
 backward (b : B.R) (w : G.InmB b) : W.Wit b = W.ie-eq (G.Ls.lsum G.value w.1) b (sym w.2) (list w.1) ;
 mere-forward (b : B.R) : Tr.Trunc[W.Wit b].carrier -> Tr.Trunc[G.InmB b].carrier =
  TC.map (W.Wit b) (G.InmB b) (forward b) ;
 mere-backward (b : B.R) : Tr.Trunc[G.InmB b].carrier -> Tr.Trunc[W.Wit b].carrier =
  TC.map (G.InmB b) (W.Wit b) (backward b) ;
} ;
