-- A supplied selected field certificate gives the exact finite Piece
-- consumed by SelectedFlatLcl. Only root and separability witnesses
-- are mapped into E; generation witnesses remain in B with their powers.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module H = RingHom[l] ; module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (m : A.R -> U l) (m-zero : m A.z)
 (m-add : (a c : A.R) -> m a -> m c -> m (A.add a c))
 (m-scale : (a c : A.R) -> m c -> m (A.mul a c))
 (dec : (a : A.R) -> Plus (m a) (RL[A].unit a))
 (rad : (a : A.R) -> m a -> RL[A].unit (A.add A.o (A.neg a)))
 (E : CRing) (setE : Pr.isSet E.R) (iota : H.Hom A E)
 (q : E.R -> U l) (q-zero : q E.z) (q-add : (a c : E.R) -> q a -> q c -> q (E.add a c))
 (q-scale : (a c : E.R) -> q c -> q (E.mul a c)) (q-m : (a : A.R) -> m a -> q (iota.1 a))
 (q-prime : (a c : E.R) -> q (E.mul a c) -> Plus (q a) (q c)) (q-proper : Not (q E.o))
 (q-dec : (a : E.R) -> Plus (q a) (Not (q a)))
 -- ZMT
 (B : CRing) (setB : Pr.isSet B.R) (iB : H.Hom A B) (j : H.Hom B E)
 (j-alg : (a : A.R) -> Id E.R (j.1 (iB.1 a)) (iota.1 a))
 (n' : Nat) (bs : Ps.Fin (suc n') -> B.R)
 (coord : (x : B.R) -> Tr.Trunc[(rho : Ps.Fin (suc n') -> A.R) * Id B.R x (FiniteIdeal[l].Sums[B].sum (suc n') (\ k -> B.mul (iB.1 (rho k)) (bs k)))].carrier)
 (s : B.R) (s-one : Tr.Trunc[IdealGenerated[l].Over[A,m,E,iota].InmB (E.add (j.1 s) (E.neg E.o))].carrier)
 (zmt : (z : E.R) -> Tr.Trunc[(k : Nat) * (b : B.R) * Id E.R (E.mul (AffinePowers[l].Over[E].power (j.1 s) k) z) (j.1 b)].carrier)
 -- E finitely presented and flat; residue-field structure is supplied below.
 (presentation : Presentations[l].Over[A,setA].Witness (Algebras[l].Over[A,setA].mkAlgebra E setE iota))
 (flat : FlatRelations[l].Over[A,E,iota].Flat) (prop-m : (a : A.R) -> Pr.isProp (m a)) {
 module Lcl = SelectedFlatLocal[l].Over[A,setA,m,m-zero,m-add,m-scale,dec,rad,E,setE,iota,
  q,q-zero,q-add,q-scale,q-m,q-prime,q-proper,q-dec,B,setB,iB,j,j-alg,n',bs,coord,s,s-one,zmt,presentation,flat] ;
 ideal : RegularIdeal[l].IdealPred[A] = new RegularIdeal[l].IdealPred[A,m,m-zero,m-add,m-scale] ;
 module CA = Algebras[l].Over[A,setA] ;
 algebraB : CA.Algebra = CA.mkAlgebra B setB iB ;
 module F = SelectedFibreLift[l].Over[A,setA,ideal,prop-m,algebraB,s] ;
 module GivenInverse (N : Nat) (v : B.R)
  (relation : F.F.InIE (B.mul (F.Q.PB.power s N) (B.add B.o (B.neg (B.mul s v))))) {
  module Inv = F.GivenInverse[N,v,relation] ;
  module Given (n : Nat) (basis : TraceBasis[l].Over[F.K,F.F.QR.set,Inv.Lift.algebra].Basis[n])
   (prime : Inv.Lift.St.PI.Prime) (selected : Inv.Lift.St.Selected[n,basis,prime])
   (prime-map : (b : B.R) -> q (j.1 b) -> prime.ideal.In (F.Q.eta.1 b)) {
   module Lift = Inv.Given[n,basis,prime,selected,suc n',bs] ;
   module At (w : Lift.Result) {
    el : Lift.L.Elements = w.1 ; pol : Lift.L.Polynomials = w.2.1 ;
    module Raw = Lift.L.Raw[el,pol] ;
    module Natural = PolynomialNaturality[l].SameCoefficients[A,B,E,setB,setE,iB,iota,j,j-alg,el.x] ;
    eps-out : Not (q (j.1 el.eps)) = \ h -> selected.outside
     (subst prime.ideal.In el.eps-image (prime-map el.eps h)) ;
    power-product (k : Nat) (b : B.R) : Id E.R (j.1 (B.mul (F.Q.PB.power s k) b))
     (E.mul (Lcl.In0.PE.power (j.1 s) k) (j.1 b)) =
     trans (j.2.2.2 (F.Q.PB.power s k) b)
      (ap (\ a -> E.mul a (j.1 b)) (AffinePowers[l].power-map B E j s k)) ;
    root-image : Id E.R (j.1 Raw.root-element)
     (E.mul (j.1 el.eps) (MonicReduce[l].Horner[A,E,iota,j.1 el.x].horner pol.p)) =
     trans (j.2.2.2 el.eps (Raw.V.HB.horner pol.p)) (ap (E.mul (j.1 el.eps)) (Natural.value pol.p)) ;
    sep-value : Id E.R (j.1 (B.add (B.mul (Raw.D.bvalue pol.p).2 el.w) (B.neg B.o)))
     (E.add (E.mul (Lcl.In0.slope (j.1 el.x) pol.p) (j.1 el.w)) (E.neg E.o)) =
     trans (j.2.2.1 (B.mul (Raw.D.bvalue pol.p).2 el.w) (B.neg B.o))
      (cong2 E.R E.add _ _ _ _
       (trans (j.2.2.2 (Raw.D.bvalue pol.p).2 el.w)
        (ap (\ a -> E.mul a (j.1 el.w)) (Natural.slope pol.p)))
       (trans (H.negation B E j B.o) (ap E.neg j.2.1))) ;
    sep-image : Id E.R (j.1 Raw.sep-element)
     (E.mul (j.1 el.eps) (E.add (E.mul (Lcl.In0.slope (j.1 el.x) pol.p) (j.1 el.w)) (E.neg E.o))) =
     trans (j.2.2.2 el.eps (B.add (B.mul (Raw.D.bvalue pol.p).2 el.w) (B.neg B.o)))
      (ap (E.mul (j.1 el.eps)) sep-value) ;
    root : Lcl.PRoot el.eps el.x pol.p =
     (w.2.2.1.1,subst Lcl.In0.IGE.InmB
      (trans (power-product w.2.2.1.1 Raw.root-element)
       (ap (E.mul (Lcl.In0.PE.power (j.1 s) w.2.2.1.1)) root-image))
      (Lcl.In0.to-E _ w.2.2.1.2)) ;
    separable : Lcl.PSeparable el.eps el.x pol.p =
     (j.1 el.w,w.2.2.2.1.1,subst Lcl.In0.IGE.InmB
      (trans (power-product w.2.2.2.1.1 Raw.sep-element)
       (ap (E.mul (Lcl.In0.PE.power (j.1 s) w.2.2.2.1.1)) sep-image))
      (Lcl.In0.to-E _ w.2.2.2.1.2)) ;
    generates : Lcl.PGenerates el.eps el.x = \ i -> (pol.cs i,w.2.2.2.2 i) ;
    piece : Lcl.Piece el.eps el.x = (pol.p,root,separable,generates) ;
    datum : Lcl.SelectedData = (el.eps,el.x,eps-out,piece) ;
   } ;
   selected-data : Tr.Trunc[Lcl.SelectedData].carrier = TC.map Lift.Result Lcl.SelectedData (\ w -> At[w].datum) Lift.theorem ;
   theorem : Truncation[l+].Trunc[Lcl.St.Conclusion].carrier = Lcl.theorem selected-data ;
  } ;
 } ;
} ;
