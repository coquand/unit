-- Full bridge on B=F2 x F2, s=(1,0), E=F2. The second factor
-- survives B/mB but is killed by localization. Construct an actual
-- selected certificate in C, then run the lifting and local theorem.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ; module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ; module T = SelectedLocalRegression[l] ;
module BF = BooleanRing[l] ;
module Bridge = SelectedLocalLift[l].Over[T.A,BF.bool-set,T.m,T.m-zero,T.m-add,T.m-scale,T.dec,T.rad,
 T.A,BF.bool-set,H.identity T.A,T.m,T.m-zero,T.m-add,T.m-scale,(\ a h -> h),T.prime,T.nonzero,T.prime-dec,
 T.B,T.setB,T.iota,T.j,(\ a -> refl a),T.one,T.bs,T.coord,T.s,T.s-one,T.zmt,
 (T.BP.empty,T.BP.presentation),FlatRelations[l].Self[T.A].flat,\ a -> BF.bool-set a false] ;
module F = Bridge.F ; module Q = F.Q ; module W = F.F.W ;
module K = F.F.QR ;
relation : F.F.InIE (T.B.mul (Q.PB.power T.s T.one) (T.B.add T.B.o (T.B.neg (T.B.mul T.s T.B.o)))) =
 Tr.Trunc[W.Wit T.z].inc W.ie-zero ;
module Inv = Bridge.GivenInverse[T.one,T.B.o,relation] ;
module Onto = Q.QuasiInverse[T.one,T.B.o,relation] ;
module C = Inv.Inv.Lift ;
module LC = RL[Q.T] ;
-- The two quotient maps back to F2.
module KA = QuotientRingDescent[l].Over[T.A,Bridge.ideal,\ a -> BF.bool-set a false,
 T.A,BF.bool-set,H.identity T.A,\ a h -> h] ;
gens-zero : (ps : List F.Convert.G.Gen) -> Id T.A.R
 (T.j.1 (F.Convert.G.Ls.lsum F.Convert.G.value ps)) T.A.z = split {
 nil -> refl false ;
 cons p ps | ih -> trans (T.j.2.2.1 (F.Convert.G.value p) (F.Convert.G.Ls.lsum F.Convert.G.value ps))
  (trans (cong2 T.A.R T.A.add _ _ _ _
   (trans (T.j.2.2.2 (T.iota.1 p.1) p.2.2)
    (trans (ap (\ a -> T.A.mul a p.2.2.1) p.2.1) (T.L.zero-mul p.2.2.1))) ih)
   (refl false)) } ;
explicit-killed (b : T.B.R) (w : W.Wit b) : Id T.A.R (T.j.1 b) T.A.z =
 trans (ap T.j.1 (F.Convert.forward b w).2) (gens-zero (F.Convert.forward b w).1) ;
killed (b : T.B.R) (h : F.F.InIE b) : Id T.A.R (T.j.1 b) T.A.z =
 TC.rec (W.Wit b) @l (Id T.A.R (T.j.1 b) T.A.z) (BF.bool-set _ _) (explicit-killed b) h ;
module BA = QuotientRingDescent[l].Over[T.B,F.F.IE,F.F.propIE,T.A,BF.bool-set,T.j,killed] ;
power-one : (n : Nat) -> Id T.A.R (AffinePowers[l].Over[T.A].power true n) true = split {
 zero -> refl true ; suc n | ih -> ap (T.A.mul true) ih } ;
denominator (a : F.F.QE.Carrier) (w : Q.Loc.Powers a) : Id T.A.R (BA.hom.1 a) true =
 trans (ap BA.hom.1 w.2)
  (trans (AffinePowers[l].power-map F.F.QE.ring T.A BA.hom (F.F.QE.include T.s) w.1)
   (trans (ap (\ z -> AffinePowers[l].Over[T.A].power z w.1) (BA.beta T.s)) (power-one w.1))) ;
units (a : F.F.QE.Carrier) (w : Q.Loc.Powers a) : T.L.unit (BA.hom.1 a) =
 (true,trans (T.A.mulO (BA.hom.1 a)) (denominator a w)) ;
module Back = MonoidLocalizationMap[l].Over[F.F.QE.ring,Q.Loc.Powers,Q.Loc.one,Q.Loc.product,T.A,BF.bool-set,BA.hom,units] ;
back-beta (b : T.B.R) : Id T.A.R (Back.hom.1 (Q.eta.1 b)) b.1 =
 trans (Back.constants (F.F.QE.include b)) (BA.beta b) ;
back-scalar : (a : K.Carrier) -> Id T.A.R (Back.hom.1 (F.iC.1 a)) (KA.hom.1 a) =
 K.Q.induction @l (\ a -> Id T.A.R (Back.hom.1 (F.iC.1 a)) (KA.hom.1 a)) (\ a -> BF.bool-set _ _)
  (\ a -> trans (ap Back.hom.1 (sym (F.square a))) (trans (back-beta (a,a)) (sym (KA.beta a)))) ;
k-section : (a : K.Carrier) -> Id K.Carrier (K.include (KA.hom.1 a)) a =
 K.Q.induction @l (\ a -> Id K.Carrier (K.include (KA.hom.1 a)) a) (\ a -> K.set _ _)
  (\ a -> ap K.include (KA.beta a)) ;
cleared : (a b : T.A.R) -> Id T.B.R
 (T.B.mul (Q.PB.power T.s T.one) (T.B.add (a,b) (T.B.neg (a,a)))) T.z = split {
 false -> split { false -> refl T.z ; true -> refl T.z } ;
 true -> split { false -> refl T.z ; true -> refl T.z } } ;
same-image (b : T.B.R) : Id Q.T.R (Q.eta.1 b) (Q.eta.1 (b.1,b.1)) =
 FormallyEtale[l].Units[Q.T,Q.Loc.set].sub-zero _ _
  (trans (sym (Q.difference b (b.1,b.1)))
   (Q.vanish (T.B.add b (T.B.neg (b.1,b.1)))
    (T.one,Tr.Trunc[W.Wit (T.B.mul (Q.PB.power T.s T.one) (T.B.add b (T.B.neg (b.1,b.1))))].inc
     (W.ie-eq T.z _ (sym (cleared b.1 b.2)) W.ie-zero)))) ;
section-at (b : T.B.R) : Id Q.T.R (F.iC.1 (K.include (Back.hom.1 (Q.eta.1 b)))) (Q.eta.1 b) =
 trans (ap (\ a -> F.iC.1 (K.include a)) (back-beta b))
  (trans (sym (F.square b.1)) (sym (same-image b))) ;
section (a : Q.T.R) : Id Q.T.R (F.iC.1 (K.include (Back.hom.1 a))) a =
 TC.rec (Onto.Rep a) @l (Id Q.T.R (F.iC.1 (K.include (Back.hom.1 a))) a) (Q.Loc.set _ _)
  (\ w -> subst (\ z -> Id Q.T.R (F.iC.1 (K.include (Back.hom.1 z))) z) w.2 (section-at w.1)) (Onto.onto a) ;
coordinate : H.Hom Q.T K.ring = H.compose Q.T T.A K.ring K.projection Back.hom ;
scalar-coordinate (a : K.Carrier) : Id K.Carrier (coordinate.1 (F.iC.1 a)) a =
 trans (ap K.include (back-scalar a)) (k-section a) ;
module Basis = TraceBasis[l].Over[K.ring,K.set,C.algebra] ;
scale (a : K.Carrier) (b : Q.T.R) (i : Fin T.one) :
 Id K.Carrier (coordinate.1 (Q.T.mul (F.iC.1 a) b)) (K.ring.mul a (coordinate.1 b)) =
 trans (coordinate.2.2.2 (F.iC.1 a) b)
  (ap (\ z -> K.ring.mul z (coordinate.1 b)) (scalar-coordinate a)) ;
reconstruction (a : Q.T.R) : Id Q.T.R (Basis.SS.sum T.one (\ i -> Q.T.mul (F.iC.1 (coordinate.1 a)) Q.T.o)) a =
 trans (Q.T.addZ (Q.T.mul (F.iC.1 (coordinate.1 a)) Q.T.o))
  (trans (Q.T.mulO (F.iC.1 (coordinate.1 a))) (section a)) ;
on-vector : (j i : Fin T.one) -> Id K.Carrier (coordinate.1 Q.T.o) (Basis.Delta.delta T.one i j) =
 split { inl e -> efq e ; inr t -> split { inl e -> efq e ; inr u -> coordinate.2.1 } } ;
basis : Basis.Basis[T.one] = new Basis.Basis[T.one,\ i -> Q.T.o,\ a i -> coordinate.1 a,
 \ a b i -> coordinate.2.2.1 a b,scale,reconstruction,on-vector] ;
-- Prime of C is the preimage of (0) in F2.
q (a : Q.T.R) : U l = T.m (Back.hom.1 a) ;
qzero : q Q.T.z = H.zero Q.T T.A Back.hom ;
qadd (a b : Q.T.R) (ha : q a) (hb : q b) : q (Q.T.add a b) =
 trans (Back.hom.2.2.1 a b) (T.m-add _ _ ha hb) ;
qscale (a b : Q.T.R) (hb : q b) : q (Q.T.mul a b) =
 trans (Back.hom.2.2.2 a b) (T.m-scale _ _ hb) ;
qproper : Not (q Q.T.o) = \ h -> T.nonzero (trans (sym Back.hom.2.1) h) ;
qprime (a b : Q.T.R) (h : q (Q.T.mul a b)) : Plus (q a) (q b) =
 T.prime (Back.hom.1 a) (Back.hom.1 b) (trans (sym (Back.hom.2.2.2 a b)) h) ;
prime : C.St.PI.Prime = new C.St.PI.Prime[
 new RegularIdeal[l].IdealPred[Q.T,q,qzero,qadd,qscale],\ a -> BF.bool-set _ _,qproper,qprime,\ a -> T.prime-dec (Back.hom.1 a)] ;
prime-map (b : T.B.R) (h : T.m b.1) : q (Q.eta.1 b) = trans (back-beta b) h ;
module St = C.St ;
poly : List K.Carrier = SelectedFactorStatement[l].Over[K.ring,K.set].monic (cons K.ring.z nil) ;
root-value : Id Q.T.R (St.value Q.T.z poly) Q.T.z =
 trans (ap (Q.T.add (F.iC.1 K.ring.z)) (LC.zero-mul (St.value Q.T.z (cons K.ring.o nil))))
  (trans (Q.T.addZ (F.iC.1 K.ring.z)) (H.zero K.ring Q.T F.iC)) ;
root : Id Q.T.R (Q.T.mul Q.T.o (St.value Q.T.z poly)) Q.T.z =
 trans (LC.one-left (St.value Q.T.z poly)) root-value ;
-- The slope of X is 1; the generic Horner calculation avoids relying
-- on quotient reduction or an assumed equality with the base field.
module Dual = St.DN ;
dual-X : Id Dual.Pair (MonicReduce[l].Horner[K.ring,Dual.ring,St.dual,(Q.T.z,Q.T.o)].horner poly) (Q.T.z,Q.T.o) =
 trans (ap (Dual.plusQ (St.dual.1 K.ring.z))
  (trans (ap (Dual.timesQ (Q.T.z,Q.T.o))
   (trans (ap (Dual.plusQ (St.dual.1 K.ring.o)) (RL[Dual.ring].mul-zero (Q.T.z,Q.T.o)))
    (trans (Dual.ring.addZ (St.dual.1 K.ring.o)) St.dual.2.1)))
   (Dual.ring.mulO (Q.T.z,Q.T.o))))
  (trans (ap (\ z -> Dual.plusQ z (Q.T.z,Q.T.o)) (H.zero K.ring Dual.ring St.dual))
   (RL[Dual.ring].zl (Q.T.z,Q.T.o))) ;
separable : Id Q.T.R (Q.T.mul Q.T.o (Q.T.add (Q.T.mul (St.slope Q.T.z poly) Q.T.o) (Q.T.neg Q.T.o))) Q.T.z =
 trans (ap (\ a -> Q.T.mul Q.T.o (Q.T.add (Q.T.mul a Q.T.o) (Q.T.neg Q.T.o))) (ap (\ p -> p.2) dual-X))
  (trans (ap (\ a -> Q.T.mul Q.T.o (Q.T.add a (Q.T.neg Q.T.o))) (Q.T.mulO Q.T.o))
   (trans (ap (Q.T.mul Q.T.o) (Q.T.addN Q.T.o)) (LC.mul-zero Q.T.o))) ;
constant-value : Id Q.T.R (St.value Q.T.z (cons K.ring.o nil)) Q.T.o =
 trans (ap (Q.T.add (F.iC.1 K.ring.o)) (LC.mul-zero Q.T.z))
  (trans (Q.T.addZ (F.iC.1 K.ring.o)) F.iC.2.1) ;
generates (i : Fin T.one) : Id Q.T.R
 (Q.T.mul Q.T.o (Q.T.add (basis.vector i) (Q.T.neg (St.value Q.T.z (cons K.ring.o nil))))) Q.T.z =
 trans (ap (\ a -> Q.T.mul Q.T.o (Q.T.add Q.T.o (Q.T.neg a))) constant-value)
  (trans (ap (Q.T.mul Q.T.o) (Q.T.addN Q.T.o)) (LC.mul-zero Q.T.o)) ;
selected : St.Selected[T.one,basis,prime] = new St.Selected[T.one,basis,prime,Q.T.o,Q.T.mulO Q.T.o,qproper,
 Q.T.z,cons K.ring.z nil,root,Q.T.o,separable,\ i -> cons K.ring.o nil,generates] ;
module Finished = Inv.Given[T.one,basis,prime,selected,prime-map] ;
lifted : Tr.Trunc[Bridge.Lcl.SelectedData].carrier = Finished.selected-data ;
theorem : Truncation[l+].Trunc[Bridge.Lcl.St.Conclusion].carrier = Finished.theorem ;
-- Concrete denominator sensitivity: eta kills a nonzero quotient class.
other-zero : Id Q.T.R (Q.eta.1 (T.bs T.i1)) Q.T.z =
 trans (same-image (T.bs T.i1)) (H.zero T.B Q.T Q.eta) ;
gens-zeroB : (ps : List F.Convert.G.Gen) -> Id T.B.R (F.Convert.G.Ls.lsum F.Convert.G.value ps) T.z = split {
 nil -> refl T.z ;
 cons p ps | ih -> trans (cong2 T.B.R T.B.add _ _ _ _
  (trans (ap (\ a -> T.B.mul (T.iota.1 a) p.2.2) p.2.1) (RL[T.B].zero-mul p.2.2)) ih)
  (T.B.addZ T.z) } ;
zero-witness (b : T.B.R) (w : W.Wit b) : Id T.B.R b T.z =
 trans (F.Convert.forward b w).2 (gens-zeroB (F.Convert.forward b w).1) ;
quotient-other-nonzero : Not (Id F.F.QE.Carrier (F.F.QE.include (T.bs T.i1)) F.F.QE.zeroQ) =
 \ h -> T.other-nonzero
  (TC.rec (W.Wit (T.bs T.i1)) @l (Id T.B.R (T.bs T.i1) T.z) (T.setB _ _)
   (zero-witness (T.bs T.i1)) (F.F.QE.kernel _ h)) ;
