-- Canonical specialization: k=R/m and C=(B/mB)[1/s] use the actual
-- QuotientFibre maps. Convert only the finitely many resulting ideal
-- memberships to list witnesses required by the local introduction.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (I : RegularIdeal[l].IdealPred[R])
 (propI : (a : R.R) -> Pr.isProp (I.In a))
 (B : Algebras[l].Over[R,setR].Algebra) (s : B.ring.R) {
 module F = QuotientFibre[l].Over[R,setR,I,propI,B] ;
 module Q = QuotientPowerClearing[l].Over[B.ring,F.IE,F.propIE,s] ;
 module Convert = FibreIdealWitnesses[l].Over[R,B.ring,I.In,B.iota] ;
 K : CRing = F.QR.ring ;
 iC : H.Hom K Q.T = H.compose K F.QE.ring Q.T Q.Loc.inclusion F.iotaI ;
 square (a : R.R) : Id Q.T.R (Q.eta.1 (B.iota.1 a)) (iC.1 (F.pR.1 a)) =
  sym (ap Q.Loc.inclusion.1 (F.iotaI-beta a)) ;
 module GivenInverse (N : Nat) (v : B.ring.R)
  (relation : F.InIE (B.ring.mul (Q.PB.power s N) (B.ring.add B.ring.o (B.ring.neg (B.ring.mul s v))))) {
  module Lift = SelectedQuotientLift[l].Over[R,K,F.QR.set,F.pR,F.surjR,B.ring,B.set,B.iota,
   F.IE,F.propIE,s,N,v,relation].At[iC,square] ;
  module Given (n : Nat) (basis : TraceBasis[l].Over[K,F.QR.set,Lift.algebra].Basis[n])
   (prime : Lift.St.PI.Prime) (selected : Lift.St.Selected[n,basis,prime])
   (r : Nat) (bs : Fin r -> B.ring.R) {
   module L = Lift.Given[n,basis,prime,selected,r,bs] ;
   Witness (b : B.ring.R) : U l = (k : Nat) * Convert.G.InmB (B.ring.mul (Q.PB.power s k) b) ;
   convert (b : B.ring.R) (w : Q.Witness b) : Tr.Trunc[Witness b].carrier =
    TC.map (F.W.Wit (B.ring.mul (Q.PB.power s w.1) b)) (Witness b)
     (\ z -> (w.1,Convert.forward _ z)) w.2 ;
   module Raw (el : L.Elements) (pol : L.Polynomials) {
    module Core = L.Raw[el,pol] ;
    Witnesses : U l = Witness Core.root-element * Witness Core.sep-element * ((i : Fin r) -> Witness (Core.gen-element i)) ;
    from-core (w : Core.Witnesses) : Tr.Trunc[Witnesses].carrier =
     TC.map2 (Witness Core.root-element) (Witness Core.sep-element * ((i : Fin r) -> Witness (Core.gen-element i))) Witnesses
      (\ a b -> (a,b)) (convert Core.root-element w.1)
      (TC.map2 (Witness Core.sep-element) ((i : Fin r) -> Witness (Core.gen-element i))
       (Witness Core.sep-element * ((i : Fin r) -> Witness (Core.gen-element i))) (\ a b -> (a,b))
       (convert Core.sep-element w.2.1)
       (AffineFinite[l].choice r (\ i -> Witness (Core.gen-element i)) (\ i -> convert (Core.gen-element i) (w.2.2 i)))) ;
   } ;
   Result : U l = (el : L.Elements) * (pol : L.Polynomials) * Raw[el,pol].Witnesses ;
   from-core (w : L.Result) : Tr.Trunc[Result].carrier =
    TC.map Raw[w.1,w.2.1].Witnesses Result (\ z -> (w.1,w.2.1,z)) (Raw[w.1,w.2.1].from-core w.2.2) ;
   theorem : Tr.Trunc[Result].carrier = TC.bind L.Result Result from-core L.theorem ;
  } ;
 } ;
} ;
