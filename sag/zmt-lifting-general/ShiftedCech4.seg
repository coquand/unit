-- ShiftedCech4.seg: polynomial action on the four-chart cochain modules,
-- and finite products of modules (handoff §4).
--
-- Degrees.  The terms c X^u of p go from degree k to degree k' when
-- k' - size u = k for each term (Shifts k k' p).  Then for a family c in
-- the chart module C(k) of (I, set) (Laurent4.Over.Chart, Cech4.BadI) the
-- family (p c)_i = p c_i lies in C(k') (Act.lin):
--   * chart and degree conditions (van-mulP): at m with Bad k' (set i) m,
--     every term reads c_i at m - u, where Bad k (set i) holds: a negative
--     coordinate outside set i stays negative (u >= 0, out-subE), and
--     deg m /= k' gives deg (m - u) /= k (not-deg-subE);
--   * finite support (vanish-mulP): if c vanishes outside S, p c vanishes
--     outside the list of the s + u, s in S, c X^u in p (suppL): a term at
--     m reads c at m - u, and (m - u) + u = m;
--   * D-linearity: mulP-add, mulP-sm, pointwise.
-- The Cech differential commutes with p (Comm.d0, d1, d2): each component
-- of d is one of the shapes x - y, (x - y) + z, ((x - y) + z) - w of
-- components at the same exponent, and p commutes with them
-- (PolynomialAction4.mulP-sub, -T, -Q).  The contractions are NOT claimed
-- to commute with p: only d does.
--
-- The polynomial chart.  setPol: no coordinate may be negative.  The chart
-- module of (Sq, setPol) in degree k is the module of homogeneous
-- polynomials of degree k with finite support (handoff §5), the model in
-- which the syzygy hypothesis is stated.
--
-- Products (Prod): for D-modules M_i, i in Fin n, the module of families
-- (y_i) with the componentwise operations; equality componentwise (ext).
-- Linear maps: the sum of a family of linear maps out of the product
-- (sumMap: y |-> sum_i F_i y_i), the family of linear maps into it (into),
-- and componentwise maps (each : (F_i)).  A linear map commutes with
-- finite sums (lin-sum).  In a chart module the coefficients of a finite
-- sum are the finite sums of the coefficients (ChartSums.val-sum).
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open Cech4[l] ; open PolynomialAction4[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Ps = Presentations[l] ; module NA = NatArith[l] ; module FE = Axioms[l].FunExtLemmas[fe @l] ;

-- the polynomial chart: no negative coordinate
none : Sub4 = sub outside outside outside outside ;
setPol (i : Sq) : Sub4 = none ;

-- Bad k' E m gives Bad k E (m - u) when k' - size u = k
bad-subE (k k' : Int) (E : Sub4) (m : E4) (u : N4) (e : Id Int (minus k' (size u)) k) :
  Bad k' E m -> Bad k E (subE m u) = split {
  inl h -> inl (not-deg-subE k k' m u e h) ;
  inr h -> inr (out-subE E m u h) } ;

module Over (D : CRing) (setD : Pr.isSet D.R) {
  module C = Cech4[l].Over[D,setD] ; module LO = C.LO ; module DL = C.DL ;
  module PA = PolynomialAction4[l].Over[D,setD] ;
  module L = RL[D] ;
  module RS = Comb[l].Sums[D,IP.regular D] ;

  -- every term goes from degree k to degree k'
  Shifts (k k' : Int) : TPoly D.R -> U l = split {
    nil -> Top ;
    cons t p | r -> Id Int (minus k' (size t.2)) k * r } ;

  -- the support list of p c
  suppL (s : List E4) : TPoly D.R -> List E4 = split {
    nil -> nil ;
    cons t p | r -> appL (mapL (\ x -> addE x t.2) s) r } ;

  vanish-mulP (s : List E4) (f : E4 -> D.R) (h : (m : E4) -> Not (Mem m s) -> Id D.R (f m) D.z) :
    (p : TPoly D.R) (m : E4) -> Not (Mem m (suppL s p)) -> Id D.R (PA.mulP p f m) D.z = split {
    nil -> \ m nm -> refl D.z ;
    cons t p | r -> \ m nm ->
      trans (DL.G.cong-add
               (trans (ap (D.mul t.1) (h (subE m t.2) (\ k -> nm (mem-appl m (mapL (\ x -> addE x t.2) s) (suppL s p)
                         (mem-tr (mapL (\ x -> addE x t.2) s) (addE (subE m t.2) t.2) m (addE-subE m t.2)
                           (mem-map (\ x -> addE x t.2) (subE m t.2) s k))))))
                      (L.mul-zero t.1))
               (r m (\ k -> nm (mem-appr m (mapL (\ x -> addE x t.2) s) (suppL s p) k))))
            (D.addZ D.z) } ;

  van-mulP (k k' : Int) (E : Sub4) (f : E4 -> D.R) (v : (m : E4) -> Bad k E m -> Id D.R (f m) D.z) :
    (p : TPoly D.R) -> Shifts k k' p -> (m : E4) -> Bad k' E m -> Id D.R (PA.mulP p f m) D.z = split {
    nil -> \ hp m b -> refl D.z ;
    cons t p | r -> \ hp m b ->
      trans (DL.G.cong-add (trans (ap (D.mul t.1) (v (subE m t.2) (bad-subE k k' E m t.2 hp.1 b))) (L.mul-zero t.1))
                           (r hp.2 m b))
            (D.addZ D.z) } ;

  -- p acting on raw families, componentwise
  ract (I : U l) (p : TPoly D.R) : IP.Lin[D,LO.powM I C.Lau,LO.powM I C.Lau] =
    IP.mkLin D (LO.powM I C.Lau) (LO.powM I C.Lau) (\ c i m -> PA.mulP p (c i) m)
      (\ c c' -> LO.ext I _ _ (\ i m -> PA.mulP-add p (c i) (c' i) m))
      (\ r c -> LO.ext I _ _ (\ i m -> PA.mulP-sm p r (c i) m)) ;

  -- p : C(k) -> C(k') for the chart modules of (I, set)
  module Act (I : U l) (set : I -> Sub4) (k k' : Int) (p : TPoly D.R) (hp : Shifts k k' p) {
    module CA = LO.Chart[I, BadI I set k] ; module CB = LO.Chart[I, BadI I set k'] ;
    module R = LO.Restrict[I,I,BadI I set k,BadI I set k',ract I p,\ s -> suppL s p,
      \ s c h i m nm -> vanish-mulP s (c i) (h i) p m nm,
      \ c v i m b -> van-mulP k k' (set i) (c i) (v i) p hp m b] ;
    lin : IP.Lin[D,CA.mod,CB.mod] = R.lin ;
    -- by definition of lin
    lin-val (x : CA.El) (i : I) (m : E4) : Id D.R (CB.val (lin.f x) i m) (PA.mulP p (CA.val x i) m) =
      refl (PA.mulP p (CA.val x i) m) ;
  } ;

  ------------------------------------------------------------------------
  -- d commutes with p

  d0-act (p : TPoly D.R) (c : Pt -> E4 -> D.R) : (j : Ed) (m : E4) ->
    Id D.R (C.d0 (\ i m' -> PA.mulP p (c i) m') j m) (PA.mulP p (C.d0 c j) m) = split {
    e01 -> \ m -> sym (PA.mulP-sub p (c p1) (c p0) m) ;
    e02 -> \ m -> sym (PA.mulP-sub p (c p2) (c p0) m) ;
    e03 -> \ m -> sym (PA.mulP-sub p (c p3) (c p0) m) ;
    e12 -> \ m -> sym (PA.mulP-sub p (c p2) (c p1) m) ;
    e13 -> \ m -> sym (PA.mulP-sub p (c p3) (c p1) m) ;
    e23 -> \ m -> sym (PA.mulP-sub p (c p3) (c p2) m) } ;
  d1-act (p : TPoly D.R) (c : Ed -> E4 -> D.R) : (j : Tri) (m : E4) ->
    Id D.R (C.d1 (\ i m' -> PA.mulP p (c i) m') j m) (PA.mulP p (C.d1 c j) m) = split {
    t012 -> \ m -> sym (PA.mulP-T p (c e12) (c e02) (c e01) m) ;
    t013 -> \ m -> sym (PA.mulP-T p (c e13) (c e03) (c e01) m) ;
    t023 -> \ m -> sym (PA.mulP-T p (c e23) (c e03) (c e02) m) ;
    t123 -> \ m -> sym (PA.mulP-T p (c e23) (c e13) (c e12) m) } ;
  d2-act (p : TPoly D.R) (c : Tri -> E4 -> D.R) : (j : Sq) (m : E4) ->
    Id D.R (C.d2 (\ i m' -> PA.mulP p (c i) m') j m) (PA.mulP p (C.d2 c j) m) = split {
    s0123 -> \ m -> sym (PA.mulP-Q p (c t123) (c t023) (c t013) (c t012) m) } ;

  module Comm (k k' : Int) (p : TPoly D.R) (hp : Shifts k k' p) {
    module A0 = Act[Pt,setPt,k,k',p,hp] ; module A1 = Act[Ed,setEd,k,k',p,hp] ;
    module A2 = Act[Tri,setTri,k,k',p,hp] ; module A3 = Act[Sq,setSq,k,k',p,hp] ;
    d0 (x : C.Deg[k].C0.El) : Id C.Deg[k'].C1.El ((C.D0 k').f (A0.lin.f x)) (A1.lin.f ((C.D0 k).f x)) =
      C.Deg[k'].C1.eq ((C.D0 k').f (A0.lin.f x)) (A1.lin.f ((C.D0 k).f x)) (d0-act p (C.Deg[k].C0.val x)) ;
    d1 (x : C.Deg[k].C1.El) : Id C.Deg[k'].C2.El ((C.D1 k').f (A1.lin.f x)) (A2.lin.f ((C.D1 k).f x)) =
      C.Deg[k'].C2.eq ((C.D1 k').f (A1.lin.f x)) (A2.lin.f ((C.D1 k).f x)) (d1-act p (C.Deg[k].C1.val x)) ;
    d2 (x : C.Deg[k].C2.El) : Id C.Deg[k'].C3.El ((C.D2 k').f (A2.lin.f x)) (A3.lin.f ((C.D2 k).f x)) =
      C.Deg[k'].C3.eq ((C.D2 k').f (A2.lin.f x)) (A3.lin.f ((C.D2 k).f x)) (d2-act p (C.Deg[k].C2.val x)) ;
  } ;

  ------------------------------------------------------------------------
  -- finite products of modules

  module Prod (n : Nat) (Md : Ps.Fin n -> IP.Mod[D]) {
    El : U l = (i : Ps.Fin n) -> (Md i).M ;
    ext (y y' : El) (h : (i : Ps.Fin n) -> Id (Md i).M (y i) (y' i)) : Id El y y' =
      FE.funext (Ps.Fin n) (\ i -> (Md i).M) y y' h ;
    mod : IP.Mod[D] = IP.mkMod D El (\ i -> (Md i).mz) (\ y y' i -> (Md i).madd (y i) (y' i)) (\ y i -> (Md i).mneg (y i))
      (\ y y' y'' -> ext _ _ (\ i -> (Md i).maddA (y i) (y' i) (y'' i)))
      (\ y y' -> ext _ _ (\ i -> (Md i).maddC (y i) (y' i)))
      (\ y -> ext _ _ (\ i -> (Md i).maddZ (y i)))
      (\ y -> ext _ _ (\ i -> (Md i).maddN (y i)))
      (\ c y i -> (Md i).sm c (y i))
      (\ c c' y -> ext _ _ (\ i -> (Md i).smA c c' (y i)))
      (\ y -> ext _ _ (\ i -> (Md i).smO (y i)))
      (\ c y y' -> ext _ _ (\ i -> (Md i).smD c (y i) (y' i)))
      (\ c c' y -> ext _ _ (\ i -> (Md i).smE c c' (y i))) ;

    -- y |-> sum_i F_i y_i
    module SumMap (T : IP.Mod[D]) (F : (i : Ps.Fin n) -> IP.Lin[D,Md i,T]) {
      module TS = Comb[l].Sums[D,T] ;
      fv (y : El) : T.M = TS.sum n (\ i -> (F i).f (y i)) ;
      lin : IP.Lin[D,mod,T] = IP.mkLin D mod T fv
        (\ y y' -> trans (TS.sum-cong n (\ i -> (F i).f ((Md i).madd (y i) (y' i))) (\ i -> T.madd ((F i).f (y i)) ((F i).f (y' i)))
                             (\ i -> (F i).f-add (y i) (y' i)))
                         (TS.sum-add n (\ i -> (F i).f (y i)) (\ i -> (F i).f (y' i))))
        (\ c y -> trans (TS.sum-cong n (\ i -> (F i).f ((Md i).sm c (y i))) (\ i -> T.sm c ((F i).f (y i)))
                           (\ i -> (F i).f-sm c (y i)))
                         (sym (TS.sum-sm n c (\ i -> (F i).f (y i))))) ;
    } ;
    -- s |-> (G_i s)_i
    module Into (S : IP.Mod[D]) (G : (i : Ps.Fin n) -> IP.Lin[D,S,Md i]) {
      lin : IP.Lin[D,S,mod] = IP.mkLin D S mod (\ s i -> (G i).f s)
        (\ s s' -> ext _ _ (\ i -> (G i).f-add s s')) (\ c s -> ext _ _ (\ i -> (G i).f-sm c s)) ;
    } ;
  } ;
  -- (y_i) |-> (F_i y_i)_i
  module Each (n : Nat) (Md Md' : Ps.Fin n -> IP.Mod[D]) (F : (i : Ps.Fin n) -> IP.Lin[D,Md i,Md' i]) {
    module P = Prod[n,Md] ; module P' = Prod[n,Md'] ;
    lin : IP.Lin[D,P.mod,P'.mod] = IP.mkLin D P.mod P'.mod (\ y i -> (F i).f (y i))
      (\ y y' -> P'.ext _ _ (\ i -> (F i).f-add (y i) (y' i))) (\ c y -> P'.ext _ _ (\ i -> (F i).f-sm c (y i))) ;
  } ;

  -- a linear map commutes with finite sums
  module LinSum (S T : IP.Mod[D]) (F : IP.Lin[D,S,T]) {
    module SS = Comb[l].Sums[D,S] ; module TS = Comb[l].Sums[D,T] ;
    module LF = RelationCertificate[l].LinL[D,S,T,F] ;
    lin-sum : (n : Nat) (f : Ps.Fin n -> S.M) -> Id T.M (F.f (SS.sum n f)) (TS.sum n (\ i -> F.f (f i))) = split {
      zero -> \ f -> LF.f-zero ;
      suc n | r -> \ f -> trans (F.f-add (f (inr tt)) (SS.sum n (\ i -> f (inl i))))
                                (ap (T.madd (F.f (f (inr tt)))) (r (\ i -> f (inl i)))) } ;
  } ;

  -- the coefficients of a finite sum in a chart module
  module ChartSums (I : U l) (Bad : I -> E4 -> U l) {
    module CH = LO.Chart[I,Bad] ; module S = Comb[l].Sums[D,CH.mod] ;
    val-sum : (n : Nat) (f : Ps.Fin n -> CH.El) (i : I) (m : E4) ->
      Id D.R (CH.val (S.sum n f) i m) (RS.sum n (\ k -> CH.val (f k) i m)) = split {
      zero -> \ f i m -> refl D.z ;
      suc n | r -> \ f i m -> ap (D.add (CH.val (f (inr tt)) i m)) (r (\ k -> f (inl k)) i m) } ;
  } ;
} ;
