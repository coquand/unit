-- ResolutionDependence4.seg: the final export (handoff §8).
--
-- Theorem (Over.Dep.dependence).  Let D be a CFN set-ring, M supplied
-- homogeneous data (Matrices) with A H = 0 by coefficients (ah) and
-- polynomial syzygy generation at every degree (syz).  Let
-- c : Nat -> E0^1 = C^1(-1) with, for every n, merely u_n in E1^2 with
-- d c_n = A u_n.  Then merely there are qs = [q_(N-1),..,q_0] (N = len qs,
-- N = 0 allowed), h in E0^0 and a in E1^1 with
--     c_N - sum_{i<N} q_i c_i = d h + A a .
-- Proof: ResolutionCertificate4.Cert.partner raises each c_n under its own
-- truncation (no sequence of u_n or w_n is chosen) to a mere partner in
-- D^m; CertifiedDependence.certificate (Stage 1, unchanged) for the
-- relation Cert.rel gives merely qs with Removable(c_N - sum q_i c_i); the
-- truncation of the primitive is flattened (bind).
-- Algebraic hypotheses, and nothing else: D, setD, cfn, M, ah, syz.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;

module Over (K0 : U l) (D : CRing) (setD : Pr.isSet D.R) (cfn : CFN[l].CFN[K0,D]) {
  module RC = ResolutionCertificate4[l].Over[D,setD] ;
  module Dep (M : HomogeneousMatrices4[l].Matrices[D]) (ah : RC.HM.Identity M) (syz : RC.LS.SyzGen M) {
    module R = RC.Cert[M,ah,syz] ;
    module MZ = R.MZ ;
    module Seq (c : Nat -> R.F1.E0.El) (lift : (n : Nat) -> Tr.Trunc[R.Lifted (c n)].carrier) {
      module CD = CertifiedDependence[l].Over[K0,D,cfn,R.F1.E0.mod,len R.TP.TL,R.rel,c,\ n -> R.partner (c n) (lift n)] ;
      -- c_N - sum_{i<N} q_i c_i, N = len qs
      rest (qs : List D.R) : R.F1.E0.El = MZ.msub (c (len qs)) (CD.RS.sumL qs) ;
      Result : U l = (qs : List D.R) * R.Bdry (rest qs) ;
      flat (k : CD.RS.Cert) : Tr.Trunc[Result].carrier = TC.map (R.Bdry (rest k.1)) Result (\ bd -> (k.1, bd)) k.2 ;
      dependence : Tr.Trunc[Result].carrier = TC.bind CD.RS.Cert Result flat CD.certificate ;
    } ;
  } ;
} ;
