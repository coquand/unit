-- CubicResolution4.seg: regression instance 1 (handoff §9, Gate D.1),
-- over any commutative set-ring D:
--   g = (P, Q),  P = X_0^3, Q = X_1^3,  H = (-Q, P)^T,  d = (3,3), e = (6).
--
-- Data (M1): degrees by computation; the identity P(-Q) + QP = 0 by
-- coefficients (id1): the two products have the same exponent (3,3,0,0)
-- and coefficients 1 and -1, so each coefficient is 1 + (-1 + 0) = 0 or
-- 0 + (0 + 0) = 0, according to one decision on N4 (cancel).
--
-- Syzygy generation (syz1), PROVED, at every degree n and over any D (no
-- domain hypothesis).  Let y = (y_0, y_1) be polynomials of degree n - 3
-- with P y_0 + Q y_1 = 0, i.e. at every exponent x
--     y_1(x - 3e_1) = -y_0(x - 3e_0)                                (rel)
-- Put z(m) = y_1(m + 3e_0) (z = X_0^-3 y_1, of degree n - 6).  z is a
-- polynomial: at m with m_k < 0 for some k >= 1, m + 3e_0 has the same
-- negative coordinate; at m with m_0 < 0, (rel) at x = m + 3e_0 + 3e_1 gives
-- z(m) = -y_0(m + 3e_1) = 0, since m + 3e_1 has its first coordinate m_0 < 0
-- (P divides y_1).  Then
--   (H z)_0 (m) = -z(m - 3e_1) = -y_1((m + 3e_0) - 3e_1) = y_0(m)    (rel)
--   (H z)_1 (m) =  z(m - 3e_0) =  y_1(m)
-- (P is injective as a shift).  Hence merely z with H z = y.
--
-- Instances: the certificate R (ResolutionCertificate4.Cert) and the
-- dependence (ResolutionDependence4).  Recovery of Stage 2:
--   * lift-conv: a Stage 2 lift d b = P u + Q v gives the general one,
--     d b = A (u, v) (A (u,v) = (Q v + (P u + 0)) componentwise);
--   * bdry-conv: a general primitive c = d h + A a gives the Stage 2 form
--     c = (d h + P a_0) + Q a_1;
--   * Dependence.Seq.dependence / stage2: the Stage 2 conclusion, literally
--     the type of CubicDependence.Over.Seq.Result, from the general theorem;
--   * the Stage 2 nonzero example (CubicExample): Gam(b, top w) for the
--     general relation, the coordinate of top w at the head of the list is
--     1 (coordN), so top w /= 0 when 1 /= 0 (nonzeroN; over Z: nonzero-Z).
-- The general top list for b = 1, e_0 = 6 has length 20 and its entries are
-- the quadruples of TopList4.T20 (TopCoordinatesShift4.recover-T20).
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open Cech4[l] ; open PolynomialAction4[l] ;
open ShiftedCech4[l] ; open HomogeneousMatrices4[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Ps = Presentations[l] ; module LG = Logic[l] ; module TL4 = TopList4[l] ; module LSL = LaurentSyzygyLift4[l] ;

------------------------------------------------------------------------
-- exponents and indices

eP : N4 = nx TL4.three zero zero zero ;
eQ : N4 = nx zero TL4.three zero zero ;
-- m - (3,0,0,0) = sh0 m,  m - (0,3,0,0) = sh1 m
subE-P : (m : E4) -> Id E4 (subE m eP) (sh0 m) = split { ex a b c d -> refl (sh0 (ex a b c d)) } ;
subE-Q : (m : E4) -> Id E4 (subE m eQ) (sh1 m) = split { ex a b c d -> refl (sh1 (ex a b c d)) } ;

rk1 : Nat = suc zero ;
rk2 : Nat = suc rk1 ;
i0 : Ps.Fin rk2 = inl (inr tt) ;
i1 : Ps.Fin rk2 = inr tt ;
fin1-ind (P : Ps.Fin rk1 -> U l) (x : P (inr tt)) : (k : Ps.Fin rk1) -> P k = split {
  inl e -> absurd (P (inl e)) e ;
  inr u -> LSL.joinT (\ v -> P (inr v)) x u } ;
pair-ind (P : Ps.Fin rk2 -> U l) (x0 : P i0) (x1 : P i1) : (i : Ps.Fin rk2) -> P i = split {
  inl k -> fin1-ind (\ k' -> P (inl k')) x0 k ;
  inr u -> LSL.joinT (\ v -> P (inr v)) x1 u } ;
pair (X : U l) (x0 x1 : X) : Ps.Fin rk2 -> X = pair-ind (\ i -> X) x0 x1 ;

module Over (D : CRing) (setD : Pr.isSet D.R) {
  module C = Cech4[l].Over[D,setD] ; module LO = C.LO ; module DL = C.DL ;
  module PA = PolynomialAction4[l].Over[D,setD] ;
  module HM = HomogeneousMatrices4[l].Over[D,setD] ;
  module LS = LSL.Over[D,setD] ;
  module RC = ResolutionCertificate4[l].Over[D,setD] ;
  module CK = CubicCertificate[l].Over[D,setD] ;
  module TP = TopCoordinates4[l].Over[D,setD] ;
  module L = RL[D] ;

  ------------------------------------------------------------------------
  -- ring identities

  one-z (a : D.R) : Id D.R (D.add (D.mul D.o a) D.z) a = trans (D.addZ (D.mul D.o a)) (L.one-left a) ;
  one-zz (a : D.R) : Id D.R (D.add (D.add (D.mul D.o a) D.z) D.z) a = trans (D.addZ (D.add (D.mul D.o a) D.z)) (one-z a) ;
  negone-zz (a : D.R) : Id D.R (D.add (D.add (D.mul (D.neg D.o) a) D.z) D.z) (D.neg a) =
    trans (D.addZ (D.add (D.mul (D.neg D.o) a) D.z))
      (trans (D.addZ (D.mul (D.neg D.o) a)) (trans (L.neg-mul-left D.o a) (ap D.neg (L.one-left a)))) ;
  -- (1 q + 0) + ((1 p + 0) + 0) = p + q
  pq-val (p q : D.R) : Id D.R (D.add (D.add (D.mul D.o q) D.z) (D.add (D.add (D.mul D.o p) D.z) D.z)) (D.add p q) =
    trans (DL.G.cong-add (one-z q) (one-zz p)) (D.addC q p) ;
  pair-zero (a b : D.R) (h : Id D.R (D.add (D.add (D.mul D.o a) D.z) (D.add (D.add (D.mul D.o b) D.z) D.z)) D.z) :
    Id D.R a (D.neg b) = L.neg-uniq b a (trans (sym (pq-val b a)) h) ;
  -- 1.1 X^v + (1.(-1) X^v + 0) has every coefficient 0
  cancel (P : U l) : (dd : LG.Dec P) ->
    Id D.R (D.add (TP.monoD (D.mul D.o D.o) P dd) (D.add (TP.monoD (D.mul D.o (D.neg D.o)) P dd) D.z)) D.z = split {
    yes p -> trans (ap (D.add (D.mul D.o D.o)) (trans (D.addZ (D.mul D.o (D.neg D.o))) (L.mul-neg D.o D.o))) (D.addN (D.mul D.o D.o)) ;
    no n -> trans (ap (D.add D.z) (D.addZ D.z)) (D.addZ D.z) } ;

  ------------------------------------------------------------------------
  -- the data

  Pl : TPoly D.R = cons (D.o, eP) nil ;
  Ql : TPoly D.R = cons (D.o, eQ) nil ;
  mQl : TPoly D.R = cons (D.neg D.o, eQ) nil ;
  dsh (i : Ps.Fin rk2) : Base.Nat = TL4.three ;
  esh (j : Ps.Fin rk1) : Base.Nat = TL4.six ;
  g : Ps.Fin rk2 -> TPoly D.R = pair (TPoly D.R) Pl Ql ;
  H (i : Ps.Fin rk2) (j : Ps.Fin rk1) : TPoly D.R = pair (TPoly D.R) mQl Pl i ;
  hg : (i : Ps.Fin rk2) -> HomDeg D.R (dsh i) (g i) =
    pair-ind (\ i -> HomDeg D.R (dsh i) (g i)) (refl TL4.three, tt) (refl TL4.three, tt) ;
  hH (i : Ps.Fin rk2) (j : Ps.Fin rk1) : HomShift D.R (dsh i) (esh j) (H i j) =
    pair-ind (\ i' -> HomShift D.R (dsh i') (esh j) (H i' j)) (refl TL4.six, tt) (refl TL4.six, tt) i ;
  M1 : Matrices[D] = mkMatrices D rk2 rk1 dsh esh g H hg hH ;

  -- P (-Q) + Q P = 0, by coefficients
  id1 : HM.Identity M1 = \ j v -> cancel (Id N4 (addN4 eP eQ) v) (dec-n4 (addN4 eP eQ) v) ;

  ------------------------------------------------------------------------
  -- syzygy generation for (P, Q)

  module Syz1 (n : Int) (y : LS.Pol[M1,n].F.E1.El) (hy : LS.Pol[M1,n].Syz y) {
    module PF = LS.Pol[M1,n].F ;
    module Y0 = LO.Chart[Sq, BadI Sq setPol (PF.k1 i0)] ; module Y1 = LO.Chart[Sq, BadI Sq setPol (PF.k1 i1)] ;
    module Z6 = LO.Chart[Sq, BadI Sq setPol (minus n TL4.six)] ;
    y0 : Sq -> E4 -> D.R = Y0.val (y i0) ;
    y1 : Sq -> E4 -> D.R = Y1.val (y i1) ;
    -- P y_0 + Q y_1 = 0 at x
    rel (x : E4) : Id D.R (y1 s0123 (subE x eQ)) (D.neg (y0 s0123 (subE x eP))) =
      pair-zero (y1 s0123 (subE x eQ)) (y0 s0123 (subE x eP)) (ap (\ v -> PF.E0.val v s0123 x) hy) ;
    -- z = X_0^-3 y_1
    zraw : Sq -> E4 -> D.R = \ i m -> y1 i (addE m eP) ;
    -- degree: (n - 6) + 3 = n - 3
    e6 : Id Int (addP (minus n TL4.six) (size eP)) (minus n TL4.three) =
      trans (ap (\ x -> addP x TL4.three) (sym (minus-minus n TL4.three TL4.three))) (addP-minus-cancel (minus n TL4.three) TL4.three) ;
    -- m with a negative coordinate: z(m) = 0
    module Off (m : E4) {
      x : E4 = addE (addE m eP) eQ ;
      xq : Id E4 (subE x eQ) (addE m eP) = subE-addE (addE m eP) eQ ;
      xp : Id E4 (subE x eP) (addE m eQ) = trans (subE-addE-comm (addE m eP) eQ eP) (ap (\ v -> addE v eQ) (subE-addE m eP)) ;
      -- m_0 < 0: z(m) = -y_0(m + 3e_1) = 0
      first (o : Out none (addE m eQ)) : Id D.R (y1 s0123 (addE m eP)) D.z = calc D.R {
        y1 s0123 (addE m eP) =< ap (y1 s0123) (sym xq) > y1 s0123 (subE x eQ)
          =< rel x > D.neg (y0 s0123 (subE x eP))
          =< ap (\ v -> D.neg (y0 s0123 v)) xp > D.neg (y0 s0123 (addE m eQ))
          =< ap D.neg (Y0.van (y i0) s0123 (addE m eQ) (inr o)) > D.neg D.z
          =< L.neg-zero > D.z } ;
      -- another negative coordinate stays in m + 3e_0
      other (o : Out none (addE m eP)) : Id D.R (y1 s0123 (addE m eP)) D.z = Y1.van (y i1) s0123 (addE m eP) (inr o) ;
    } ;
    off : (m : E4) -> Out none m -> Id D.R (y1 s0123 (addE m eP)) D.z = split {
      ex a b c d -> split {
        o0 h -> Off[ex a b c d].first (o0 h) ;
        o1 h -> Off[ex a b c d].other (o1 h) ;
        o2 h -> Off[ex a b c d].other (o2 h) ;
        o3 h -> Off[ex a b c d].other (o3 h) } } ;
    van-at (m : E4) : Bad (minus n TL4.six) none m -> Id D.R (y1 s0123 (addE m eP)) D.z = split {
      inl ne -> Y1.van (y i1) s0123 (addE m eP) (inl (not-deg-addE (minus n TL4.six) (minus n TL4.three) m eP e6 ne)) ;
      inr o -> off m o } ;
    van : Z6.Van zraw = split { s0123 -> \ m b -> van-at m b } ;
    supp : Z6.Supp zraw =
      TC.map (Y1.SuppW y1) (Z6.SuppW zraw)
        (\ sw -> (mapL (\ v -> subE v eP) sw.1,
                  LO.vanish-shift Sq (\ m -> addE m eP) (\ v -> subE v eP) (\ m -> subE-addE m eP) y1 sw.1 sw.2))
        (Y1.supp (y i1)) ;
    zEl : Z6.El = Z6.mk zraw supp van ;
    z : PF.E2.El = \ j -> zEl ;
    -- (H z)_0 = -Q z = y_0, (H z)_1 = P z = y_1
    pt0 : (s : Sq) (m : E4) -> Id D.R (Y0.val (PF.H.f z i0) s m) (y0 s m) = split {
      s0123 -> \ m -> calc D.R {
        D.add (D.add (D.mul (D.neg D.o) (y1 s0123 (addE (subE m eQ) eP))) D.z) D.z
          =< ap (\ v -> D.add (D.add (D.mul (D.neg D.o) (y1 s0123 v)) D.z) D.z) (sym (subE-addE-comm m eP eQ))
          > D.add (D.add (D.mul (D.neg D.o) (y1 s0123 (subE (addE m eP) eQ))) D.z) D.z
          =< negone-zz (y1 s0123 (subE (addE m eP) eQ)) > D.neg (y1 s0123 (subE (addE m eP) eQ))
          =< ap D.neg (rel (addE m eP)) > D.neg (D.neg (y0 s0123 (subE (addE m eP) eP)))
          =< L.neg-neg (y0 s0123 (subE (addE m eP) eP)) > y0 s0123 (subE (addE m eP) eP)
          =< ap (y0 s0123) (subE-addE m eP) > y0 s0123 m } } ;
    pt1 : (s : Sq) (m : E4) -> Id D.R (Y1.val (PF.H.f z i1) s m) (y1 s m) = split {
      s0123 -> \ m -> trans (one-zz (y1 s0123 (addE (subE m eP) eP))) (ap (y1 s0123) (addE-subE m eP)) } ;
    eq : Id PF.E1.El (PF.H.f z) y =
      PF.E1.ext (PF.H.f z) y (pair-ind (\ i -> Id (PF.C1 i).M (PF.H.f z i) (y i))
        (Y0.eq (PF.H.f z i0) (y i0) pt0) (Y1.eq (PF.H.f z i1) (y i1) pt1)) ;
    result : LS.Pol[M1,n].Lifts y = Tr.Trunc[(z' : PF.E2.El) * Id PF.E1.El (PF.H.f z') y].inc (z, eq) ;
  } ;
  syz1 : LS.SyzGen M1 = \ n y hy -> Syz1[n,y,hy].result ;

  ------------------------------------------------------------------------
  -- the general certificate for this data, and Stage 2

  module R = RC.Cert[M1,id1,syz1] ;

  -- a Stage 2 lift: d b = P u + Q v
  module LiftConv (b : CK.G1.C1.El) (x : CK.Lifted b) {
    u : R.F2.E1.El = pair CK.G4.C2.El x.1 x.2.1 ;
    pt : (e : Tri) (m : E4) -> Id D.R (CK.G1.C2.val (CK.G1.C2.mod.madd (CK.S2.P.f x.1) (CK.S2.Q.f x.2.1)) e m)
                                      (CK.G1.C2.val (R.F2.A.f u) e m) =
      \ e m -> trans (DL.G.cong-add (ap (CK.G4.C2.val x.1 e) (sym (subE-P m))) (ap (CK.G4.C2.val x.2.1 e) (sym (subE-Q m))))
                     (sym (pq-val (CK.G4.C2.val x.1 e (subE m eP)) (CK.G4.C2.val x.2.1 e (subE m eQ)))) ;
    e1 : R.E1 b u = trans x.2.2 (CK.G1.C2.eq (CK.G1.C2.mod.madd (CK.S2.P.f x.1) (CK.S2.Q.f x.2.1)) (R.F2.A.f u) pt) ;
    lifted : R.Lifted b = (u, e1) ;
  } ;
  lift-conv (b : CK.G1.C1.El) (x : CK.Lifted b) : R.Lifted b = LiftConv[b,x].lifted ;

  -- a general primitive c = d h + A a, in the Stage 2 form
  module BdryConv (c : CK.G1.C1.El) (bd : R.Bdry c) {
    h : CK.G1.C0.El = bd.1 ;
    a0 : CK.G4.C1.El = bd.2.1 i0 ;
    a1 : CK.G4.C1.El = bd.2.1 i1 ;
    pt : (e : Ed) (m : E4) -> Id D.R (CK.G1.C1.val (CK.G1.C1.mod.madd ((C.D0 TL4.mOne).f h) (R.F1.A.f bd.2.1)) e m)
                                     (CK.G1.C1.val (CK.G1.C1.mod.madd (CK.G1.C1.mod.madd ((C.D0 TL4.mOne).f h) (CK.S1.P.f a0)) (CK.S1.Q.f a1)) e m) =
      \ e m -> calc D.R {
        D.add (CK.G1.C1.val ((C.D0 TL4.mOne).f h) e m)
              (D.add (D.add (D.mul D.o (CK.G4.C1.val a1 e (subE m eQ))) D.z) (D.add (D.add (D.mul D.o (CK.G4.C1.val a0 e (subE m eP))) D.z) D.z))
          =< ap (D.add (CK.G1.C1.val ((C.D0 TL4.mOne).f h) e m)) (pq-val (CK.G4.C1.val a0 e (subE m eP)) (CK.G4.C1.val a1 e (subE m eQ)))
          > D.add (CK.G1.C1.val ((C.D0 TL4.mOne).f h) e m) (D.add (CK.G4.C1.val a0 e (subE m eP)) (CK.G4.C1.val a1 e (subE m eQ)))
          =< D.addA (CK.G1.C1.val ((C.D0 TL4.mOne).f h) e m) (CK.G4.C1.val a0 e (subE m eP)) (CK.G4.C1.val a1 e (subE m eQ))
          > D.add (D.add (CK.G1.C1.val ((C.D0 TL4.mOne).f h) e m) (CK.G4.C1.val a0 e (subE m eP))) (CK.G4.C1.val a1 e (subE m eQ))
          =< DL.G.cong-add (ap (\ v -> D.add (CK.G1.C1.val ((C.D0 TL4.mOne).f h) e m) (CK.G4.C1.val a0 e v)) (subE-P m))
                           (ap (CK.G4.C1.val a1 e) (subE-Q m))
          > D.add (D.add (CK.G1.C1.val ((C.D0 TL4.mOne).f h) e m) (CK.G4.C1.val a0 e (sh0 m))) (CK.G4.C1.val a1 e (sh1 m)) } ;
    bdry : CK.Bdry c = (h, (a0, (a1,
      trans bd.2.2 (CK.G1.C1.eq (CK.G1.C1.mod.madd ((C.D0 TL4.mOne).f h) (R.F1.A.f bd.2.1))
                                (CK.G1.C1.mod.madd (CK.G1.C1.mod.madd ((C.D0 TL4.mOne).f h) (CK.S1.P.f a0)) (CK.S1.Q.f a1)) pt)))) ;
  } ;
  bdry-conv (c : CK.G1.C1.El) (bd : R.Bdry c) : CK.Bdry c = BdryConv[c,bd].bdry ;

  ------------------------------------------------------------------------
  -- the Stage 2 nonzero example as a general partner

  module X = CubicExample[l].Over[D,setD] ;
  uN : R.F2.E1.El = LiftConv[X.bE,(X.uE, (X.vE, X.e1))].u ;
  wN : R.F3.E2.El = \ j -> X.wE ;
  e1N : R.E1 X.bE uN = LiftConv[X.bE,(X.uE, (X.vE, X.e1))].e1 ;
  -- d u = -Q w and d v = P w: the general d (u,v) = H w
  ptu (s : Sq) (m : E4) : Id D.R (CK.G4.C3.val (CK.G4.C3.mod.mneg (CK.T3.Q.f X.wE)) s m) (CK.G4.C3.val (R.F3.H.f wN i0) s m) =
    trans (ap (\ v -> D.neg (CK.G7.C3.val X.wE s v)) (sym (subE-Q m))) (sym (negone-zz (CK.G7.C3.val X.wE s (subE m eQ)))) ;
  ptv (s : Sq) (m : E4) : Id D.R (CK.G4.C3.val (CK.T3.P.f X.wE) s m) (CK.G4.C3.val (R.F3.H.f wN i1) s m) =
    trans (ap (CK.G7.C3.val X.wE s) (sym (subE-P m))) (sym (one-zz (CK.G7.C3.val X.wE s (subE m eP)))) ;
  e2N : R.E2 uN wN = R.F3.E1.ext (R.D2.d1.f uN) (R.F3.H.f wN)
    (pair-ind (\ i -> Id (R.F3.C1 i).M (R.D2.d1.f uN i) (R.F3.H.f wN i))
      (trans X.eu (CK.G4.C3.eq (CK.G4.C3.mod.mneg (CK.T3.Q.f X.wE)) (R.F3.H.f wN i0) ptu))
      (trans X.ev (CK.G4.C3.eq (CK.T3.P.f X.wE) (R.F3.H.f wN i1) ptv))) ;
  gamN : R.Gam X.bE (R.TP.top.f wN) =
    Tr.Trunc[R.Witness X.bE (R.TP.top.f wN)].inc (R.mkWit X.bE (R.TP.top.f wN) uN wN e1N e2N (refl (R.TP.top.f wN))) ;
  -- the coordinate at the head of the tagged list, (j_0, (0,0,0,3)), is 1
  coordN : Id D.R (R.TP.top.f wN (inr tt)) D.o = X.coord ;
  nonzeroN (nz : Not (Id D.R D.o D.z)) : Not (Id R.V.Vec (R.TP.top.f wN) R.V.mod.mz) =
    \ e -> nz (trans (sym coordN) (ap (\ p -> p (inr tt)) e)) ;
  -- twenty coordinates
  m20 : Id Nat (len R.TP.TL) TopCoordinates4[l].twenty = refl TopCoordinates4[l].twenty ;

  ------------------------------------------------------------------------
  -- the dependence, and the Stage 2 conclusion

  module Dependence (K0 : U l) (cfn : CFN[l].CFN[K0,D]) {
    module DP = ResolutionDependence4[l].Over[K0,D,setD,cfn].Dep[M1,id1,syz1] ;
    module Seq (b : Nat -> CK.G1.C1.El) (lift : (n : Nat) -> Tr.Trunc[CK.Lifted (b n)].carrier) {
      lift' (n : Nat) : Tr.Trunc[R.Lifted (b n)].carrier = TC.map (CK.Lifted (b n)) (R.Lifted (b n)) (lift-conv (b n)) (lift n) ;
      module S = DP.Seq[b,lift'] ;
      -- the general conclusion
      general : Tr.Trunc[S.Result].carrier = S.dependence ;
      -- the Stage 2 conclusion: b_N - sum q_i b_i = (d h + P a_0) + Q a_1
      Result : U l = (qs : List D.R) * CK.Bdry (S.rest qs) ;
      dependence : Tr.Trunc[Result].carrier =
        TC.map S.Result Result (\ r -> (r.1, bdry-conv (S.rest r.1) r.2)) S.dependence ;
      -- literally the conclusion of Stage 2 (CubicDependence.Over.Seq.dependence)
      module Old = CubicDependence[l].Over[K0,D,setD,cfn].Seq[b,lift] ;
      -- the two finite sums sum_{i<N} q_i b_i are the same
      sumL-eq : (qs : List D.R) -> Id CK.G1.C1.El (S.CD.RS.sumL qs) (Old.CD.RS.sumL qs) = split {
        nil -> refl CK.G1.C1.mod.mz ;
        cons x xs | r -> ap (CK.G1.C1.mod.madd (CK.G1.C1.mod.sm x (b (len xs)))) r } ;
      rest-eq (qs : List D.R) : Id CK.G1.C1.El (S.rest qs) (Old.rest qs) =
        ap (\ y -> CK.G1.C1.mod.madd (b (len qs)) (CK.G1.C1.mod.mneg y)) (sumL-eq qs) ;
      stage2 : Tr.Trunc[Old.Result].carrier =
        TC.map Result Old.Result (\ r -> (r.1, subst CK.Bdry (rest-eq r.1) r.2)) dependence ;
    } ;
  } ;
} ;

-- over Z
module OverZ {
  module XZ = Over[ZRing[l].ring, int-set] ;
  nonzero-Z : Not (Id XZ.R.V.Vec (XZ.R.TP.top.f XZ.wN) XZ.R.V.mod.mz) = XZ.nonzeroN CubicExample[l].one-ne-zero ;
  module DZ = XZ.Dependence[Nat * Nat, ZCFN[l].cfn] ;
} ;
