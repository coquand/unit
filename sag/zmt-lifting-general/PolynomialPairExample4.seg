-- PolynomialPairExample4.seg: regression instance 2 (handoff §9, Gate D.2),
-- a nonmonomial presentation, over any commutative set-ring D:
--   g = (P + Q, Q),  H = (-Q, P + Q)^T,  d = (3,3), e = (6),
-- P = X_0^3, Q = X_1^3; P + Q is the two-term list (both maps A and H
-- involve a genuine polynomial sum; the general theorem is used unchanged).
--
-- Identity (id2): (P+Q)(-Q) + Q(P+Q) = 0 by coefficients.  The product
-- lists are [PQ, QQ] with coefficient 1 and [PQ, QQ] with coefficient -1
-- (exponents (3,3,0,0), (0,6,0,0)); at every exponent the coefficient is
-- a + (b + (-a + (-b + 0))) = 0 (mono-neg, abab), one decision per
-- exponent of the list.
--
-- Syzygy generation (syz2), derived from instance 1 by the invertible
-- change of coordinates
--     (P+Q) y_0 + Q y_1 = P y_0 + Q (y_0 + y_1):
-- (y_0, y_0 + y_1) is a syzygy of (P, Q) (ch), so instance 1 gives merely z
-- with -Q z = y_0 and P z = y_0 + y_1; then (H z)_0 = -Q z = y_0 and
--     (H z)_1 = (P + Q) z = P z + Q z = (y_0 + y_1) - y_0 = y_1     (fin2).
-- Instances: the certificate R2 and the dependence (Dependence2), over any
-- CFN set-ring and over Z.  A concrete coefficient: (P + Q) w has
-- coefficient 1 at the exponent of P w, for the monomial w of CubicExample
-- (act-check).
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open Cech4[l] ; open PolynomialAction4[l] ;
open ShiftedCech4[l] ; open HomogeneousMatrices4[l] ; open CubicResolution4[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Ps = Presentations[l] ; module LG = Logic[l] ; module TL4 = TopList4[l] ;

module Over (D : CRing) (setD : Pr.isSet D.R) {
  module CR = CubicResolution4[l].Over[D,setD] ;
  module C = CR.C ; module LO = CR.LO ; module DL = CR.DL ; module PA = CR.PA ; module HM = CR.HM ; module LS = CR.LS ;
  module RC = CR.RC ; module TP = CR.TP ; module L = CR.L ;

  ------------------------------------------------------------------------
  -- ring identities

  mono-neg (P : U l) : (dd : LG.Dec P) -> Id D.R (TP.monoD (D.mul D.o (D.neg D.o)) P dd) (D.neg (TP.monoD (D.mul D.o D.o) P dd)) = split {
    yes p -> L.mul-neg D.o D.o ;
    no n -> sym L.neg-zero } ;
  -- a + (b + (-a + (-b + 0))) = 0
  abab (a b : D.R) : Id D.R (D.add a (D.add b (D.add (D.neg a) (D.add (D.neg b) D.z)))) D.z = calc D.R {
    D.add a (D.add b (D.add (D.neg a) (D.add (D.neg b) D.z)))
      =< ap (\ x -> D.add a (D.add b (D.add (D.neg a) x))) (D.addZ (D.neg b)) > D.add a (D.add b (D.add (D.neg a) (D.neg b)))
      =< D.addA a b (D.add (D.neg a) (D.neg b)) > D.add (D.add a b) (D.add (D.neg a) (D.neg b))
      =< ap (D.add (D.add a b)) (sym (L.neg-add a b)) > D.add (D.add a b) (D.neg (D.add a b))
      =< D.addN (D.add a b) > D.z } ;
  -- (1(a+b) + 0) + ((1 c + 0) + 0) = (1 b + 0) + ((1 c + (1 a + 0)) + 0)
  ch (a b c : D.R) : Id D.R (D.add (D.add (D.mul D.o (D.add a b)) D.z) (D.add (D.add (D.mul D.o c) D.z) D.z))
                            (D.add (D.add (D.mul D.o b) D.z) (D.add (D.add (D.mul D.o c) (D.add (D.mul D.o a) D.z)) D.z)) = calc D.R {
    D.add (D.add (D.mul D.o (D.add a b)) D.z) (D.add (D.add (D.mul D.o c) D.z) D.z)
      =< DL.G.cong-add (CR.one-z (D.add a b)) (CR.one-zz c) > D.add (D.add a b) c
      =< ap (\ x -> D.add x c) (D.addC a b) > D.add (D.add b a) c
      =< sym (D.addA b a c) > D.add b (D.add a c)
      =< ap (D.add b) (D.addC a c) > D.add b (D.add c a)
      =< sym (DL.G.cong-add (CR.one-z b) (trans (D.addZ (D.add (D.mul D.o c) (D.add (D.mul D.o a) D.z)))
                                                (DL.G.cong-add (L.one-left c) (CR.one-z a))))
      > D.add (D.add (D.mul D.o b) D.z) (D.add (D.add (D.mul D.o c) (D.add (D.mul D.o a) D.z)) D.z) } ;
  -- p = A + B and -q = A give (1 p + (1 q + 0)) + 0 = B
  fin2 (p q A B : D.R) (h1 : Id D.R p (D.add A B)) (h0 : Id D.R (D.neg q) A) :
    Id D.R (D.add (D.add (D.mul D.o p) (D.add (D.mul D.o q) D.z)) D.z) B = calc D.R {
    D.add (D.add (D.mul D.o p) (D.add (D.mul D.o q) D.z)) D.z
      =< trans (D.addZ (D.add (D.mul D.o p) (D.add (D.mul D.o q) D.z))) (DL.G.cong-add (L.one-left p) (CR.one-z q)) > D.add p q
      =< DL.G.cong-add h1 (trans (sym (L.neg-neg q)) (ap D.neg h0)) > D.add (D.add A B) (D.neg A)
      =< ap (\ x -> D.add x (D.neg A)) (D.addC A B) > D.add (D.add B A) (D.neg A)
      =< L.add-neg-cancel B A > B } ;

  ------------------------------------------------------------------------
  -- the data

  PQl : TPoly D.R = cons (D.o, eP) (cons (D.o, eQ) nil) ;
  g2 : Ps.Fin rk2 -> TPoly D.R = pair (TPoly D.R) PQl CR.Ql ;
  H2 (i : Ps.Fin rk2) (j : Ps.Fin rk1) : TPoly D.R = pair (TPoly D.R) CR.mQl PQl i ;
  hg2 : (i : Ps.Fin rk2) -> HomDeg D.R (CR.dsh i) (g2 i) =
    pair-ind (\ i -> HomDeg D.R (CR.dsh i) (g2 i)) (refl TL4.three, (refl TL4.three, tt)) (refl TL4.three, tt) ;
  hH2 (i : Ps.Fin rk2) (j : Ps.Fin rk1) : HomShift D.R (CR.dsh i) (CR.esh j) (H2 i j) =
    pair-ind (\ i' -> HomShift D.R (CR.dsh i') (CR.esh j) (H2 i' j)) (refl TL4.six, tt) (refl TL4.six, (refl TL4.six, tt)) i ;
  M2 : Matrices[D] = mkMatrices D rk2 rk1 CR.dsh CR.esh g2 H2 hg2 hH2 ;

  -- (P+Q)(-Q) + Q(P+Q) = 0, by coefficients
  module Id2 (j : Ps.Fin rk1) (v : N4) {
    P1 : U l = Id N4 (addN4 eP eQ) v ;  d1 : LG.Dec P1 = dec-n4 (addN4 eP eQ) v ;
    P2 : U l = Id N4 (addN4 eQ eQ) v ;  d2 : LG.Dec P2 = dec-n4 (addN4 eQ eQ) v ;
    a : D.R = TP.monoD (D.mul D.o D.o) P1 d1 ;
    b : D.R = TP.monoD (D.mul D.o D.o) P2 d2 ;
    zero : Id D.R (PA.coef (PA.psum M2.a (\ i -> PA.pmul (M2.g i) (M2.H i j))) v) D.z =
      trans (ap (D.add a) (ap (D.add b) (DL.G.cong-add (mono-neg P1 d1) (ap (\ x -> D.add x D.z) (mono-neg P2 d2)))))
            (abab a b) ;
  } ;
  id2 : HM.Identity M2 = \ j v -> Id2[j,v].zero ;

  ------------------------------------------------------------------------
  -- syzygy generation, by the change of coordinates to instance 1

  module Syz2 (n : Int) (y : LS.Pol[M2,n].F.E1.El) (hy : LS.Pol[M2,n].Syz y) {
    module PF2 = LS.Pol[M2,n].F ; module PF1 = LS.Pol[CR.M1,n].F ;
    module Y = LO.Chart[Sq, BadI Sq setPol (PF2.k1 i0)] ;
    y0 : Sq -> E4 -> D.R = Y.val (y i0) ;
    y1 : Sq -> E4 -> D.R = Y.val (y i1) ;
    -- (y_0, y_0 + y_1) is a syzygy of (P, Q)
    y' : PF1.E1.El = pair Y.El (y i0) (Y.mod.madd (y i0) (y i1)) ;
    hy-pt : (s : Sq) (x : E4) -> Id D.R (PF1.E0.val (PF1.A.f y') s x) (PF1.E0.val PF1.E0.mod.mz s x) = split {
      s0123 -> \ x -> trans (ch (y0 s0123 (subE x eQ)) (y1 s0123 (subE x eQ)) (y0 s0123 (subE x eP)))
                            (ap (\ w -> PF2.E0.val w s0123 x) hy) } ;
    hy' : LS.Pol[CR.M1,n].Syz y' = PF1.E0.eq (PF1.A.f y') PF1.E0.mod.mz hy-pt ;
    -- from H_1 z = y': H_2 z = y
    module FromM1 (z : PF1.E2.El) (hz : Id PF1.E1.El (PF1.H.f z) y') {
      Zv : Sq -> E4 -> D.R = LO.Chart[Sq, BadI Sq setPol (PF1.k2 (inr tt))].val (z (inr tt)) ;
      pt0 (s : Sq) (m : E4) : Id D.R (Y.val (PF2.H.f z i0) s m) (y0 s m) = ap (\ w -> Y.val (w i0) s m) hz ;
      pt1 : (s : Sq) (m : E4) -> Id D.R (Y.val (PF2.H.f z i1) s m) (y1 s m) = split {
        s0123 -> \ m -> fin2 (Zv s0123 (subE m eP)) (Zv s0123 (subE m eQ)) (y0 s0123 m) (y1 s0123 m)
                          (trans (sym (CR.one-zz (Zv s0123 (subE m eP)))) (ap (\ w -> Y.val (w i1) s0123 m) hz))
                          (trans (sym (CR.negone-zz (Zv s0123 (subE m eQ)))) (pt0 s0123 m)) } ;
      eq : Id PF2.E1.El (PF2.H.f z) y =
        PF2.E1.ext (PF2.H.f z) y (pair-ind (\ i -> Id (PF2.C1 i).M (PF2.H.f z i) (y i))
          (Y.eq (PF2.H.f z i0) (y i0) pt0) (Y.eq (PF2.H.f z i1) (y i1) pt1)) ;
    } ;
    result : LS.Pol[M2,n].Lifts y =
      TC.map ((z : PF1.E2.El) * Id PF1.E1.El (PF1.H.f z) y') ((z : PF2.E2.El) * Id PF2.E1.El (PF2.H.f z) y)
        (\ zz -> (zz.1, FromM1[zz.1,zz.2].eq)) (CR.syz1 n y' hy') ;
  } ;
  syz2 : LS.SyzGen M2 = \ n y hy -> Syz2[n,y,hy].result ;

  ------------------------------------------------------------------------
  -- the general certificate and dependence for this data

  module R2 = RC.Cert[M2,id2,syz2] ;
  module Dependence2 (K0 : U l) (cfn : CFN[l].CFN[K0,D]) {
    module DP = ResolutionDependence4[l].Over[K0,D,setD,cfn].Dep[M2,id2,syz2] ;
    dependence (b : Nat -> R2.F1.E0.El) (lift : (n : Nat) -> Tr.Trunc[R2.Lifted (b n)].carrier) :
      Tr.Trunc[DP.Seq[b,lift].Result].carrier = DP.Seq[b,lift].dependence ;
  } ;

  -- a concrete coefficient: (P + Q) w at the exponent of P w is 1
  module X = CubicExample[l].Over[D,setD] ;
  act-check : Id D.R (PA.mulP PQl (X.mon CubicExample[l].ew) (addE CubicExample[l].ew eP)) D.o =
    trans (DL.G.cong-add (D.mulO D.o) (trans (D.addZ (D.mul D.o D.z)) (L.mul-zero D.o))) (D.addZ D.o) ;
} ;

-- over Z
module OverZ {
  module XZ = Over[ZRing[l].ring, int-set] ;
  module DZ = XZ.Dependence2[Nat * Nat, ZCFN[l].cfn] ;
} ;
