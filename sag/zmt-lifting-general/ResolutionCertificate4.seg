-- ResolutionCertificate4.seg: the general four-coordinate relation
-- certificate (handoff §7), for supplied homogeneous data M (Matrices),
-- the identity A H = 0 (ah) and polynomial syzygy generation (syz).
--
-- Modules (base twist -1; HomogeneousMatrices4.Fam):
--   E0^q = C^q(-1),  E1^q = prod_i C^q(-1-d_i),  E2^q = prod_j C^q(-1-e_j),
-- with d (componentwise, DiffFam over Cech4.D0, D1, D2), A, H.
-- Z = E0^1, all chart 1-cochains of degree -1; V = D^m, m the length of
-- the tagged top list (TopCoordinatesShift4.Top).
--   Gam(c,p)     := merely u in E1^2, w in E2^3 with
--                   d c = A u,  d u = H w,  top(w) = p          (Witness)
--   Removable(c) := merely h in E0^0, a in E1^1 with c = d h + A a  (Bdry)
--
-- Raising (Raise): from d c = A u,
--   A (d u) = d (A u) = d d c = 0                                (syz)
-- (DiffFam.dA, Cech4.DD1); the top-chart lifting theorem
-- (LaurentSyzygyLift4.Lift.lift) gives merely w with H w = d u, and
-- p = top(w) is a partner of c.  So every c with merely such a u merely has
-- a partner (partner); no sequence is chosen.
--
-- Closure (gam-zero, gam-add, gam-sm): witnesses add and scale
-- componentwise, d, A, H and top being linear.
--
-- Zero-reflection (Reflect, constructed): let top(w) = 0.  Then
--   pi(w_j) = 0 for every j          (TopCoordinatesShift4.pi-zero),
--   t_j = sigma(w_j) has d t = w      (Contr.sigma-eq at -1-e_j),
--   u' = u - H t is closed:  d u' = d u - H (d t) = H w - H w = 0  (dH),
--   a_i = con2(u'_i) has d a = u'    (Contr.con2-eq at -1-d_i),
--   c' = c - A a is closed:  d c' = A u - A (d a) = A (u - u') = A (H t) = 0
--                                    (dA, HomogeneousMatrices4.AH),
--   h = con1(c') has d h = c'        (Contr.con1-eq at -1),
-- so c = c' + A a = d h + A a.  The contractions are applied componentwise
-- and never commuted with g_i or H_ij.  The primitive is exported
-- (Reflect.bdry), then the implication reflect : Gam(c,0) -> Removable(c).
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open Cech4[l] ; open PolynomialAction4[l] ;
open ShiftedCech4[l] ; open HomogeneousMatrices4[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Ps = Presentations[l] ; module TL4 = TopList4[l] ;

module Over (D : CRing) (setD : Pr.isSet D.R) {
  module C = Cech4[l].Over[D,setD] ; module LO = C.LO ;
  module CC = Cech4Contraction[l].Over[D,setD] ;
  module SC = ShiftedCech4[l].Over[D,setD] ;
  module HM = HomogeneousMatrices4[l].Over[D,setD] ;
  module LS = LaurentSyzygyLift4[l].Over[D,setD] ;
  module TS = TopCoordinatesShift4[l].Over[D,setD] ;
  module CK = CubicCertificate[l].Over[D,setD] ;
  module RCL = RelationCertificate[l] ;

  module Cert (M : Matrices[D]) (ah : HM.Identity M) (syz : LS.SyzGen M) {
    module F0 = HM.Fam[M,Pt,setPt,TL4.mOne] ; module F1 = HM.Fam[M,Ed,setEd,TL4.mOne] ;
    module F2 = HM.Fam[M,Tri,setTri,TL4.mOne] ; module F3 = HM.Fam[M,Sq,setSq,TL4.mOne] ;
    -- the differentials of the families
    module D0 = HM.DiffFam[M,Pt,setPt,Ed,setEd,C.D0,\ k k' p hp x -> SC.Comm[k,k',p,hp].d0 x,TL4.mOne] ;
    module D1 = HM.DiffFam[M,Ed,setEd,Tri,setTri,C.D1,\ k k' p hp x -> SC.Comm[k,k',p,hp].d1 x,TL4.mOne] ;
    module D2 = HM.DiffFam[M,Tri,setTri,Sq,setSq,C.D2,\ k k' p hp x -> SC.Comm[k,k',p,hp].d2 x,TL4.mOne] ;
    module TP = TS.Top[M] ;
    module V = TP.V ;
    module LF = LS.Lift[M,syz] ;
    -- linear-map lemmas
    module LD10 = RCL.LinL[D,F1.E0.mod,F2.E0.mod,D1.d0] ;
    module LD21 = RCL.LinL[D,F2.E1.mod,F3.E1.mod,D2.d1] ;
    module LA1 = RCL.LinL[D,F1.E1.mod,F1.E0.mod,F1.A] ;
    module LA2 = RCL.LinL[D,F2.E1.mod,F2.E0.mod,F2.A] ;
    module LH2 = RCL.LinL[D,F2.E2.mod,F2.E1.mod,F2.H] ;
    module LH3 = RCL.LinL[D,F3.E2.mod,F3.E1.mod,F3.H] ;
    module LTop = RCL.LinL[D,F3.E2.mod,V.mod,TP.top] ;
    module MZ = IP.ModL[D,F1.E0.mod] ; module M20 = IP.ModL[D,F2.E0.mod] ;
    module M21 = IP.ModL[D,F2.E1.mod] ; module M31 = IP.ModL[D,F3.E1.mod] ;

    ------------------------------------------------------------------------
    -- the relation

    E1 (c : F1.E0.El) (u : F2.E1.El) : U l = Id F2.E0.El (D1.d0.f c) (F2.A.f u) ;
    E2 (u : F2.E1.El) (w : F3.E2.El) : U l = Id F3.E1.El (D2.d1.f u) (F3.H.f w) ;
    Witness (c : F1.E0.El) (p : V.Vec) : U l =
      (u : F2.E1.El) * ((w : F3.E2.El) * (E1 c u * (E2 u w * Id V.Vec (TP.top.f w) p))) ;
    Gam (c : F1.E0.El) (p : V.Vec) : U l = Tr.Trunc[Witness c p].carrier ;
    Bdry (c : F1.E0.El) : U l = (h : F0.E0.El) * ((a : F1.E1.El) * Id F1.E0.El c (F1.E0.mod.madd (D0.d0.f h) (F1.A.f a))) ;
    Removable (c : F1.E0.El) : U l = Tr.Trunc[Bdry c].carrier ;

    module Wit (c : F1.E0.El) (p : V.Vec) (x : Witness c p) {
      u : F2.E1.El = x.1 ;
      w : F3.E2.El = x.2.1 ;
      e1 : E1 c u = x.2.2.1 ;
      e2 : E2 u w = x.2.2.2.1 ;
      etop : Id V.Vec (TP.top.f w) p = x.2.2.2.2 ;
    } ;
    mkWit (c : F1.E0.El) (p : V.Vec) (u : F2.E1.El) (w : F3.E2.El) (e1 : E1 c u) (e2 : E2 u w)
      (et : Id V.Vec (TP.top.f w) p) : Witness c p = (u, (w, (e1, (e2, et)))) ;

    ------------------------------------------------------------------------
    -- raising

    Lifted (c : F1.E0.El) : U l = (u : F2.E1.El) * E1 c u ;
    Partner (c : F1.E0.El) : U l = (p : V.Vec) * Gam c p ;
    module Raise (c : F1.E0.El) (u : F2.E1.El) (e1 : E1 c u) {
      du : F3.E1.El = D2.d1.f u ;
      -- A (d u) = d (A u) = d d c = 0
      syz' : Id F3.E0.El (F3.A.f du) F3.E0.mod.mz =
        calc F3.E0.El { F3.A.f du =< sym (D2.dA u) > D2.d0.f (F2.A.f u)
                          =< ap D2.d0.f (sym e1) > D2.d0.f (D1.d0.f c)
                          =< C.DD1 TL4.mOne c > F3.E0.mod.mz } ;
      found (s : LF.Sol du) : Partner c =
        (TP.top.f s.1, Tr.Trunc[Witness c (TP.top.f s.1)].inc (mkWit c (TP.top.f s.1) u s.1 e1 (sym s.2) (refl (TP.top.f s.1)))) ;
      partner : Tr.Trunc[Partner c].carrier = TC.map (LF.Sol du) (Partner c) found (LF.lift du syz') ;
    } ;
    partner (c : F1.E0.El) (h : Tr.Trunc[Lifted c].carrier) : Tr.Trunc[Partner c].carrier =
      TC.bind (Lifted c) (Partner c) (\ x -> Raise[c,x.1,x.2].partner) h ;

    ------------------------------------------------------------------------
    -- linear closure

    module Zero {
      e1 : E1 F1.E0.mod.mz F2.E1.mod.mz = trans LD10.f-zero (sym LA2.f-zero) ;
      e2 : E2 F2.E1.mod.mz F3.E2.mod.mz = trans LD21.f-zero (sym LH3.f-zero) ;
      witness : Witness F1.E0.mod.mz V.mod.mz = mkWit F1.E0.mod.mz V.mod.mz F2.E1.mod.mz F3.E2.mod.mz e1 e2 LTop.f-zero ;
    } ;
    gam-zero : Gam F1.E0.mod.mz V.mod.mz = Tr.Trunc[Witness F1.E0.mod.mz V.mod.mz].inc Zero.witness ;

    module Add (c c' : F1.E0.El) (p p' : V.Vec) (x : Witness c p) (x' : Witness c' p') {
      module X = Wit[c,p,x] ; module X' = Wit[c',p',x'] ;
      u : F2.E1.El = F2.E1.mod.madd X.u X'.u ;
      w : F3.E2.El = F3.E2.mod.madd X.w X'.w ;
      e1 : E1 (F1.E0.mod.madd c c') u =
        trans (D1.d0.f-add c c') (trans (M20.G.cong-add X.e1 X'.e1) (sym (F2.A.f-add X.u X'.u))) ;
      e2 : E2 u w =
        trans (D2.d1.f-add X.u X'.u) (trans (M31.G.cong-add X.e2 X'.e2) (sym (F3.H.f-add X.w X'.w))) ;
      et : Id V.Vec (TP.top.f w) (V.mod.madd p p') =
        trans (TP.top.f-add X.w X'.w) (IP.ModL[D,V.mod].G.cong-add X.etop X'.etop) ;
      witness : Witness (F1.E0.mod.madd c c') (V.mod.madd p p') = mkWit (F1.E0.mod.madd c c') (V.mod.madd p p') u w e1 e2 et ;
    } ;
    gam-add (c c' : F1.E0.El) (p p' : V.Vec) (g : Gam c p) (g' : Gam c' p') : Gam (F1.E0.mod.madd c c') (V.mod.madd p p') =
      TC.map2 (Witness c p) (Witness c' p') (Witness (F1.E0.mod.madd c c') (V.mod.madd p p'))
        (\ x x' -> Add[c,c',p,p',x,x'].witness) g g' ;

    module Scale (r : D.R) (c : F1.E0.El) (p : V.Vec) (x : Witness c p) {
      module X = Wit[c,p,x] ;
      u : F2.E1.El = F2.E1.mod.sm r X.u ;
      w : F3.E2.El = F3.E2.mod.sm r X.w ;
      e1 : E1 (F1.E0.mod.sm r c) u =
        trans (D1.d0.f-sm r c) (trans (ap (F2.E0.mod.sm r) X.e1) (sym (F2.A.f-sm r X.u))) ;
      e2 : E2 u w =
        trans (D2.d1.f-sm r X.u) (trans (ap (F3.E1.mod.sm r) X.e2) (sym (F3.H.f-sm r X.w))) ;
      et : Id V.Vec (TP.top.f w) (V.mod.sm r p) = trans (TP.top.f-sm r X.w) (ap (V.mod.sm r) X.etop) ;
      witness : Witness (F1.E0.mod.sm r c) (V.mod.sm r p) = mkWit (F1.E0.mod.sm r c) (V.mod.sm r p) u w e1 e2 et ;
    } ;
    gam-sm (r : D.R) (c : F1.E0.El) (p : V.Vec) (g : Gam c p) : Gam (F1.E0.mod.sm r c) (V.mod.sm r p) =
      TC.map (Witness c p) (Witness (F1.E0.mod.sm r c) (V.mod.sm r p)) (\ x -> Scale[r,c,p,x].witness) g ;

    ------------------------------------------------------------------------
    -- zero-reflection, with the primitive constructed

    module Reflect (c : F1.E0.El) (x : Witness c V.mod.mz) {
      module X = Wit[c,V.mod.mz,x] ;
      -- t_j = sigma(w_j), d t = w
      t : F2.E2.El = \ j -> CC.Contr[F2.k2 j].sigma (X.w j) ;
      dt-at (j : Ps.Fin M.b) : Id (F3.C2 j).M ((C.D2 (F2.k2 j)).f (t j)) (X.w j) =
        CK.Grp[(F3.C2 j)].drop-zero ((C.D2 (F2.k2 j)).f (t j)) (CC.Contr[F2.k2 j].piE (X.w j)) (X.w j)
          (TP.pi-zero X.w X.etop j) (CC.Contr[F2.k2 j].sigma-eq (X.w j)) ;
      dt : Id F3.E2.El (D2.d2.f t) X.w = F3.E2.ext (D2.d2.f t) X.w dt-at ;
      -- u' = u - H t is closed
      u' : F2.E1.El = M21.msub X.u (F2.H.f t) ;
      du' : Id F3.E1.El (D2.d1.f u') F3.E1.mod.mz =
        calc F3.E1.El {
          D2.d1.f u' =< LD21.f-sub X.u (F2.H.f t) > M31.msub (D2.d1.f X.u) (D2.d1.f (F2.H.f t))
            =< ap (\ y -> M31.msub y (D2.d1.f (F2.H.f t))) X.e2 > M31.msub (F3.H.f X.w) (D2.d1.f (F2.H.f t))
            =< ap (M31.msub (F3.H.f X.w)) (trans (D2.dH t) (ap F3.H.f dt)) > M31.msub (F3.H.f X.w) (F3.H.f X.w)
            =< F3.E1.mod.maddN (F3.H.f X.w) > F3.E1.mod.mz } ;
      -- a_i = con2(u'_i), d a = u'
      a : F1.E1.El = \ i -> CC.Contr[F1.k1 i].con2 (u' i) ;
      da : Id F2.E1.El (D1.d1.f a) u' =
        F2.E1.ext (D1.d1.f a) u' (\ i -> CC.Contr[F1.k1 i].con2-eq (u' i) (ap (\ y -> y i) du')) ;
      -- c' = c - A a is closed
      c' : F1.E0.El = MZ.msub c (F1.A.f a) ;
      dc' : Id F2.E0.El (D1.d0.f c') F2.E0.mod.mz =
        calc F2.E0.El {
          D1.d0.f c' =< LD10.f-sub c (F1.A.f a) > M20.msub (D1.d0.f c) (D1.d0.f (F1.A.f a))
            =< ap (\ y -> M20.msub y (D1.d0.f (F1.A.f a))) X.e1 > M20.msub (F2.A.f X.u) (D1.d0.f (F1.A.f a))
            =< ap (M20.msub (F2.A.f X.u)) (trans (D1.dA a) (ap F2.A.f da)) > M20.msub (F2.A.f X.u) (F2.A.f u')
            =< sym (LA2.f-sub X.u u') > F2.A.f (M21.msub X.u u')
            =< ap F2.A.f (M21.sub-sub-self X.u (F2.H.f t)) > F2.A.f (F2.H.f t)
            =< F2.AH ah t > F2.E0.mod.mz } ;
      -- h = con1(c'), d h = c'
      h : F0.E0.El = CC.Contr[TL4.mOne].con1 c' ;
      dh : Id F1.E0.El (D0.d0.f h) c' = CC.Contr[TL4.mOne].con1-eq c' dc' ;
      eqc : Id F1.E0.El c (F1.E0.mod.madd (D0.d0.f h) (F1.A.f a)) =
        sym (trans (ap (\ y -> F1.E0.mod.madd y (F1.A.f a)) dh) (CK.Grp[F1.E0.mod].sub-add-back c (F1.A.f a))) ;
      bdry : Bdry c = (h, (a, eqc)) ;
    } ;
    reflect (c : F1.E0.El) (g : Gam c V.mod.mz) : Removable c =
      TC.map (Witness c V.mod.mz) (Bdry c) (\ x -> Reflect[c,x].bdry) g ;

    -- the relation certificate (RelationCertificate.Rel)
    rel : RCL.Rel[D,F1.E0.mod,V.mod] = RCL.mkRel D F1.E0.mod V.mod Removable Gam gam-zero gam-add gam-sm reflect ;
  } ;
} ;
