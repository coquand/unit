-- The finite action respects equality in the constructed polynomial
-- coefficient-ring tower. Compare its selections with cf, then apply
-- the already checked coefficient extensionality bridge. The independent
-- TowerLaurentAction theorem supplies the actual ring product comparison.
level l ; open Ring[l] ; open ZInt[l] ;
module Pr = Prelude[l] ; module N = FiniteExponents[l] ; module L = GenericLaurent[l] ;
module LG = Logic[l] ; module FP = FinitePolynomial4[l] ;
module Over (D : CRing) (setD : Pr.isSet D.R) (nvar : Nat) {
 module A = FiniteLaurentAction[l].Over[D,setD,nvar] ;
 module P = PolynomialTowerBridge[l].Over[D,setD] ; module T = P.T ;
 module B = TowerLaurentAction[l].Over[D,setD] ;
 module G = IdealPowers[l].ModL[D,IdealPowers[l].regular D] ;
 pick (u v : N.Exp nvar) (c : D.R) : (d : LG.Dec (Id (N.Exp nvar) u v)) ->
   Id D.R (A.TP.monoD c (Id (N.Exp nvar) u v) d) (FP.sel D c (Id (N.Exp nvar) u v) d) = split {
   yes e -> refl c ; no ne -> refl D.z } ;
 coefficient : (p : A.Polys) (v : N.Exp nvar) -> Id D.R (A.coef p v) (P.cf nvar p v) = split {
   nil -> \ v -> refl D.z ; cons t p | rec -> \ v -> G.G.cong-add (pick t.2 v t.1 (N.dec nvar t.2 v)) (rec v) } ;
 coefficient-ring (p : A.Polys) (v : N.Exp nvar) : Id D.R (P.Coeff nvar (P.phi nvar p) v) (A.coef p v) =
   trans (P.coeff-phi nvar p v) (sym (coefficient p v)) ;
 invariant (p q : A.Polys) (e : Id (T.D nvar).R (P.phi nvar p) (P.phi nvar q))
   (f : L.Exp nvar -> D.R) (m : L.Exp nvar) : Id D.R (A.mulP p f m) (A.mulP q f m) =
   A.act-coef p q (\ v -> trans (coefficient p v) (trans (P.cf-eq nvar p q e v) (sym (coefficient q v)))) f m ;
 action (p : A.Polys) (x : (T.D nvar).R) (m : L.Exp nvar) :
   Id D.R (A.mulP p (B.LC.At[nvar].coeff x) m)
     (B.LC.At[nvar].coeff ((T.D nvar).mul (P.phi nvar p) x) m) = B.At[nvar].action p x m ;
} ;
