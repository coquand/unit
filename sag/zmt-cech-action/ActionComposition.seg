-- Degree laws for polynomial products construct the shift witness for
-- the product. Consequently multiplication composition and coefficient
-- invariance hold as equalities of actual finite Laurent cochains.
level l ; open Ring[l] ; open ZInt[l] ;
module N = FiniteExponents[l] ; module L = GenericLaurent[l] ; module X = LaurentExponentBridge[l] ;
module NA = NatArith[l] ; module P = PolynomialAction4[l] ;
swap (a b c d : Base.Nat) : Id Base.Nat (NA.plus (NA.plus a b) (NA.plus c d)) (NA.plus (NA.plus a c) (NA.plus b d)) =
 trans (NA.plus-assoc a b (NA.plus c d))
   (trans (ap (NA.plus a) (trans (sym (NA.plus-assoc b c d))
     (trans (ap (\ x -> NA.plus x d) (NA.plus-comm b c)) (NA.plus-assoc c b d))))
     (sym (NA.plus-assoc a c (NA.plus b d)))) ;
degree-add : (n : Nat) (u v : N.Exp n) -> Id Base.Nat (N.degree n (X.At[n].addN u v)) (NA.plus (N.degree n u) (N.degree n v)) = split {
 zero -> \ u v -> refl zero ; suc n | rec -> \ u v ->
   trans (ap (NA.plus (NA.plus (u (inr tt)) (v (inr tt)))) (rec (N.old n u) (N.old n v)))
     (swap (u (inr tt)) (v (inr tt)) (N.degree n (N.old n u)) (N.degree n (N.old n v))) } ;
add-pos (a : Base.Nat) : (b : Base.Nat) -> Id Int (add (pos a) (pos b)) (pos (NA.plus a b)) = split {
 zero -> ap (\ x -> pos x) (sym (NA.plus-zero a)) ; suc b | rec -> trans (ap sucZ rec) (ap (\ x -> pos x) (sym (NA.plus-suc a b))) } ;
degree-emb : (n : Nat) (u : N.Exp n) -> Id Int (L.total n (X.At[n].emb u)) (pos (N.degree n u)) = split {
 zero -> \ u -> refl zeroZ ; suc n | rec -> \ u ->
   trans (ap (add (pos (u (inr tt)))) (rec (N.old n u))) (add-pos (u (inr tt)) (N.degree n (N.old n u))) } ;
module Over (D : CRing) (setD : Prelude[l].isSet D.R) (nvar : Nat) {
 module C = CechPolynomialAction[l].Over[D,setD,nvar] ; module A = C.A ; module V = X.At[nvar] ;
 app-shifts (k0 k1 : Int) : (p q : A.Polys) -> C.Shifts k0 k1 p -> C.Shifts k0 k1 q -> C.Shifts k0 k1 (Bar[l].app p q) = split {
 nil -> \ q hp hq -> hq ; cons t p | rec -> \ q hp hq -> (hp.1,rec q hp.2 hq) } ;
 scale-shifts (k0 k1 k2 : Int) (t : D.R * N.Exp nvar) (ht : Id Int (P.minus k2 (N.degree nvar t.2)) k1) :
   (q : A.Polys) -> C.Shifts k0 k1 q -> C.Shifts k0 k2 (A.scaleT t q) = split {
 nil -> \ hq -> tt ; cons u q | rec -> \ hq ->
   (trans (ap (P.minus k2) (degree-add nvar u.2 t.2))
     (trans (sym (P.minus-minus k2 (N.degree nvar t.2) (N.degree nvar u.2)))
       (trans (ap (\ x -> P.minus x (N.degree nvar u.2)) ht) hq.1)),rec hq.2) } ;
 product-shifts (k0 k1 k2 : Int) : (p q : A.Polys) -> C.Shifts k1 k2 p -> C.Shifts k0 k1 q -> C.Shifts k0 k2 (A.pmul p q) = split {
 nil -> \ q hp hq -> tt ; cons t p | rec -> \ q hp hq ->
   app-shifts k0 k2 (A.scaleT t q) (A.pmul p q) (scale-shifts k0 k1 k2 t hp.1 q hq) (rec q hp.2 hq) } ;
 module Compose (k0 k1 k2 r : Int) (p q : A.Polys) (hp : C.Shifts k1 k2 p) (hq : C.Shifts k0 k1 q) {
   module PAct = C.Act[k1,k2,r,p,hp] ; module QAct = C.Act[k0,k1,r,q,hq] ;
   module Product = C.Act[k0,k2,r,A.pmul p q,product-shifts k0 k1 k2 p q hp hq] ;
   equation (c : QAct.CA.El) : Id Product.CB.El (Product.act c) (PAct.act (QAct.act c)) =
     Product.CB.M.eq _ _ (\ s m -> A.mulP-pmul p q (QAct.CA.val c s) m) ;
 } ;
 module Invariant (k k' r : Int) (p q : A.Polys) (hp : C.Shifts k k' p) (hq : C.Shifts k k' q)
   (eq : (u : N.Exp nvar) -> Id D.R (A.coef p u) (A.coef q u)) {
   module PAct = C.Act[k,k',r,p,hp] ; module QAct = C.Act[k,k',r,q,hq] ;
   equation (c : PAct.CA.El) : Id PAct.CB.El (PAct.act c) (QAct.act c) =
     PAct.CB.M.eq _ _ (\ s m -> A.act-coef p q eq (PAct.CA.val c s) m) ;
 } ;
} ;
