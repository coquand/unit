-- A finite box of natural exponent vectors in any finite dimension.
-- It contains every vector whose total degree has a complementary
-- summand to the bound. No coefficient-ring equality is decided.
level l ; open Ring[l] ; open ZInt[l] ;
module N = FiniteExponents[l] ; module L = GenericLaurent[l] ; module NA = NatArith[l] ;
module Pr = Prelude[l] ;
module Lists (E F : U l) {
 map (f : E -> F) : List E -> List F = split { nil -> nil ; cons x xs | r -> cons (f x) r } ;
 mem-map (f : E -> F) (x : E) : (xs : List E) -> L.Mem E x xs -> L.Mem F (f x) (map f xs) = split {
   nil -> \ h -> absurd (L.Mem F (f x) nil) h ;
   cons y ys | r -> split { inl e -> inl (ap f e) ; inr h -> inr (r h) } } ;
} ;
range : Base.Nat -> List Base.Nat = split {
 zero -> cons zero nil ; suc b | r -> cons zero (Lists[Base.Nat,Base.Nat].map (\ x -> suc x) r) } ;
range-cover : (b : Base.Nat) (x r : Base.Nat) -> Id Base.Nat (NA.plus x r) b -> L.Mem Base.Nat x (range b) = split {
 zero -> split {
   zero -> \ r e -> inl (refl zero) ;
   suc x -> \ r e -> Pr.absurd (L.Mem Base.Nat (suc x) (range zero)) (subst (NA.code (suc (NA.plus x r))) e (NA.code-refl (suc (NA.plus x r)))) } ;
 suc b | rec -> split {
   zero -> \ r e -> inl (refl zero) ;
   suc x -> \ r e -> inr (Lists[Base.Nat,Base.Nat].mem-map (\ z -> suc z) x (range b) (rec x r (NA.suc-inj e))) } } ;
module Step (n : Nat) (b : Base.Nat) (old : List (N.Exp n)) {
 lift (k : Base.Nat) : List (N.Exp (suc n)) = Lists[N.Exp n,N.Exp (suc n)].map (\ u -> N.join n u k) old ;
 product : List Base.Nat -> List (N.Exp (suc n)) = split {
   nil -> nil ; cons k ks | r -> L.append (N.Exp (suc n)) (lift k) r } ;
 cover (u : N.Exp n) (hu : L.Mem (N.Exp n) u old) :
   (ks : List Base.Nat) (k : Base.Nat) -> L.Mem Base.Nat k ks -> L.Mem (N.Exp (suc n)) (N.join n u k) (product ks) = split {
   nil -> \ k h -> absurd (L.Mem (N.Exp (suc n)) (N.join n u k) nil) h ;
   cons x xs | rec -> \ k -> split {
     inl e -> L.mem-left (N.Exp (suc n)) (N.join n u k) (lift x) (product xs)
       (subst (\ z -> L.Mem (N.Exp (suc n)) (N.join n u z) (lift x)) e
         (Lists[N.Exp n,N.Exp (suc n)].mem-map (\ v -> N.join n v x) u old hu)) ;
     inr h -> L.mem-right (N.Exp (suc n)) (N.join n u k) (lift x) (product xs) (rec k h) } } ;
} ;
boxes : (n : Nat) -> Base.Nat -> List (N.Exp n) = split {
 zero -> \ b -> cons (N.zeroE zero) nil ;
 suc n | rec -> \ b -> Step[n,b,rec b].product (range b) } ;
join-self (n : Nat) (u : N.Exp (suc n)) : Id (N.Exp (suc n)) (N.join n (N.old n u) (u (inr tt))) u =
 N.split-eq n (N.join n (N.old n u) (u (inr tt))) u (refl (u (inr tt))) (refl (N.old n u)) ;
box-cover : (n : Nat) (b : Base.Nat) (u : N.Exp n) (r : Base.Nat) ->
 Id Base.Nat (NA.plus (N.degree n u) r) b -> L.Mem (N.Exp n) u (boxes n b) = split {
 zero -> \ b u r e -> inl (N.ext zero _ _ (\ i -> absurd (Id Base.Nat zero (u i)) i)) ;
 suc n | rec -> \ b u r e -> subst (\ v -> L.Mem (N.Exp (suc n)) v (boxes (suc n) b)) (join-self n u)
   (Step[n,b,boxes n b].cover (N.old n u)
     (rec b (N.old n u) (NA.plus (u (inr tt)) r)
       (trans (sym (NA.plus-assoc (N.degree n (N.old n u)) (u (inr tt)) r))
         (trans (ap (\ z -> NA.plus z r) (NA.plus-comm (N.degree n (N.old n u)) (u (inr tt)))) e)))
     (range b) (u (inr tt)) (range-cover b (u (inr tt)) (NA.plus (N.degree n (N.old n u)) r)
       (trans (sym (NA.plus-assoc (u (inr tt)) (N.degree n (N.old n u)) r)) e))) } ;
