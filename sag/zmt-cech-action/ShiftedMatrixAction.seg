-- Arbitrary finite shifted families and polynomial matrices. The input
-- and output twists may be any integers. Each entry carries the proved
-- termwise shift condition; rows are finite sums of the constructed
-- cochain actions. Differential commutation follows by linearity of d.
level l ; open Ring[l] ; open ZInt[l] ;
module Ps = Presentations[l] ; module IP = IdealPowers[l] ; module Pr = Prelude[l] ;
module Over (D : CRing) (setD : Pr.isSet D.R) (nvar : Nat) {
 module A = CechPolynomialAction[l].Over[D,setD,nvar] ;
 module E = GenericCech[l].Over[D,setD] ; module F = GenericCechTheorems[l].Over[D,setD] ;
 module P = ShiftedCech4[l].Over[D,setD] ;
 module Family (a : Nat) (k : Ps.Fin a -> Int) (r : Int) {
   Md (i : Ps.Fin a) : IP.Mod[D] = E.Cochains[nvar,k i,r].mod ;
   module Prod = P.Prod[a,Md] ; mod : IP.Mod[D] = Prod.mod ;
   El : U l = Prod.El ;
 } ;
 module Differential (a : Nat) (k : Ps.Fin a -> Int) (r : Int) {
   module Source = Family[a,k,r] ; module Target = Family[a,k,sucZ r] ;
   lin : IP.Lin[D,Source.mod,Target.mod] = P.Each[a,Source.Md,Target.Md,\ i -> F.Linear[nvar,k i,r].d].lin ;
 } ;
 module Matrix (a b : Nat) (ko : Ps.Fin a -> Int) (ki : Ps.Fin b -> Int)
   (h : Ps.Fin a -> Ps.Fin b -> A.A.Polys)
   (hh : (i : Ps.Fin a) (j : Ps.Fin b) -> A.Shifts (ki j) (ko i) (h i j)) (r : Int) {
   module Source = Family[b,ki,r] ; module Target = Family[a,ko,r] ;
   entry (i : Ps.Fin a) (j : Ps.Fin b) : IP.Lin[D,Source.Md j,Target.Md i] =
     A.Act[ki j,ko i,r,h i j,hh i j].lin ;
   row (i : Ps.Fin a) : IP.Lin[D,Source.mod,Target.Md i] = Source.Prod.SumMap[Target.Md i,\ j -> entry i j].lin ;
   lin : IP.Lin[D,Source.mod,Target.mod] = Target.Prod.Into[Source.mod,row].lin ;
   row-value (z : Source.El) (i : Ps.Fin a) : Id (Target.Md i).M (lin.f z i)
     (Comb[l].Sums[D,Target.Md i].sum b (\ j -> (entry i j).f (z j))) = refl (lin.f z i) ;
 } ;
 module Comm (a b : Nat) (ko : Ps.Fin a -> Int) (ki : Ps.Fin b -> Int)
   (h : Ps.Fin a -> Ps.Fin b -> A.A.Polys)
   (hh : (i : Ps.Fin a) (j : Ps.Fin b) -> A.Shifts (ki j) (ko i) (h i j)) (r : Int) {
   module M = Matrix[a,b,ko,ki,h,hh,r] ; module Up = Matrix[a,b,ko,ki,h,hh,sucZ r] ;
   module Di = Differential[b,ki,r] ; module Do = Differential[a,ko,r] ;
   equation (z : M.Source.El) : Id Up.Target.El (Do.lin.f (M.lin.f z)) (Up.lin.f (Di.lin.f z)) =
     Up.Target.Prod.ext _ _ (\ i ->
       trans (P.LinSum[M.Target.Md i,Up.Target.Md i,F.Linear[nvar,ko i,r].d].lin-sum b (\ j -> (M.entry i j).f (z j)))
         (Comb[l].Sums[D,Up.Target.Md i].sum-cong b
           (\ j -> (F.Linear[nvar,ko i,r].d).f ((M.entry i j).f (z j)))
           (\ j -> (Up.entry i j).f ((F.Linear[nvar,ki j,r].d).f (z j)))
           (\ j -> A.Comm[ki j,ko i,r,h i j,hh i j].equation (z j)))) ;
 } ;
 -- Standard shifted free-family convention: twist k-d_i for a natural
 -- shift d_i. An entry with d_i+degree=e_j acts from k-e_j to k-d_i.
 HomShift (dd ee : Base.Nat) : A.A.Polys -> U l = split {
   nil -> Top ; cons t p | rec -> Id Base.Nat (NatArith[l].plus dd (FiniteExponents[l].degree nvar t.2)) ee * rec } ;
 shifts (k : Int) (dd ee : Base.Nat) : (p : A.A.Polys) -> HomShift dd ee p ->
   A.Shifts (PolynomialAction4[l].minus k ee) (PolynomialAction4[l].minus k dd) p = split {
   nil -> \ hp -> tt ; cons t p | rec -> \ hp ->
     (trans (PolynomialAction4[l].minus-minus k dd (FiniteExponents[l].degree nvar t.2))
       (ap (PolynomialAction4[l].minus k) (trans (NatArith[l].plus-comm (FiniteExponents[l].degree nvar t.2) dd) hp.1)),rec hp.2) } ;
} ;
