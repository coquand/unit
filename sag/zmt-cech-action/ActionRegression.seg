-- Edge cases and concrete four-coordinate action/top regressions.
-- The generic orientation is unchanged: the newest coordinate is first.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module N = FiniteExponents[l] ; module L = GenericLaurent[l] ; module F = FiniteTopExponents[l] ;
module K = GenericDegree[l] ; module Ps = Presentations[l] ;
n1 : Nat = suc zero ; n2 : Nat = suc n1 ; n3 : Nat = suc n2 ; n4 : Nat = suc n3 ;
oneZ : Int = pos (suc zero) ; minusTwo : Int = negsuc (suc zero) ; minusFour : Int = negsuc (suc (suc (suc zero))) ;
module Over (D : CRing) (setD : Prelude[l].isSet D.R) {
 module E = GenericCech[l].Over[D,setD] ; module R = RL[D] ;
 -- The empty-coordinate augmented complex has one top coordinate at
 -- twist zero, and no top coordinate at positive twist.
 module Empty0 = FiniteTopPresentation[l].Over[D,setD,zero,zeroZ] ;
 module Empty1 = FiniteTopPresentation[l].Over[D,setD,zero,oneZ] ;
 empty-rank0 : Id Nat Empty0.rank n1 = refl n1 ;
 empty-rank1 : Id Nat Empty1.rank zero = refl zero ;
 -- One coordinate at twist -2: precisely the exponent -2 survives.
 module One = FiniteTopPresentation[l].Over[D,setD,n1,minusTwo] ;
 one-rank : Id Nat One.rank n1 = refl n1 ;
 one-top (c : One.O.A.El) (hz : (i : Ps.Fin One.rank) -> Id D.R (One.extract c i) D.z)
   (s : Sub n1) (m : L.Exp n1) : Id D.R (One.O.pRaw c s m) D.z = One.top-zero c hz s m ;
 -- A concrete X_0 in four coordinates, where X_0 is newest/first.
 module A = CechPolynomialAction[l].Over[D,setD,n4] ;
 u0 : N.Exp n4 = N.join n3 (N.zeroE n3) (suc zero) ;
 px : A.A.Polys = cons (D.o,u0) nil ;
 shifts : A.Shifts zeroZ oneZ px = (refl zeroZ,tt) ;
 module Act = A.Act[zeroZ,oneZ,K.topRank n2,px,shifts] ;
 module Comm = A.Comm[zeroZ,oneZ,K.topRank n2,px,shifts] ;
 value (c : Act.CA.El) (s : Sub n4) (m : L.Exp n4) :
   Id D.R (Act.CB.val (Act.lin.f c) s m) (Act.CA.val c s (LaurentExponentBridge[l].At[n4].subE m u0)) =
   trans (D.addZ (D.mul D.o (Act.CA.val c s (LaurentExponentBridge[l].At[n4].subE m u0))))
     (R.one-left (Act.CA.val c s (LaurentExponentBridge[l].At[n4].subE m u0))) ;
 composition (f : L.Exp n4 -> D.R) (m : L.Exp n4) :
   Id D.R (A.A.mulP (A.A.pmul px px) f m) (A.A.mulP px (\ m' -> A.A.mulP px f m') m) = A.A.mulP-pmul px px f m ;
 module Mat = ShiftedMatrixAction[l].Over[D,setD,n4] ;
 module MatrixComm = Mat.Comm[n1,n1,\ i -> oneZ,\ j -> zeroZ,\ i j -> px,\ i j -> shifts,K.topRank n2] ;
 -- The old four-coordinate top monomial (-1,-1,-1,-1) is covered by
 -- the constructed static list at twist -4, without a hand-written list.
 four-covered : L.Mem (L.Exp n4) (F.negative n4 (N.zeroE n4)) F.At[n4,minusFour].exponents =
   F.At[n4,minusFour].cover (N.zeroE n4) (refl minusFour) ;
 module Four = FiniteTopPresentation[l].Over[D,setD,n4,minusFour] ;
 four-reconstruct (c : Four.O.A.El) (s : Sub n4) (m : L.Exp n4) :
   Id D.R (Four.reconstruct (Four.extract c) s m) (Four.O.pRaw c s m) = Four.equation c s m ;
 four-top (c : Four.O.A.El) (hz : (i : Ps.Fin Four.rank) -> Id D.R (Four.extract c i) D.z)
   (s : Sub n4) (m : L.Exp n4) : Id D.R (Four.O.pRaw c s m) D.z = Four.top-zero c hz s m ;
 -- Tagging/flattening includes the empty list of summands.
 module EmptyFamily = ShiftedTopPresentation[l].Over[D,setD,n4,zero,\ i -> absurd Int i] ;
 empty-family-rank : Id Nat EmptyFamily.rank zero = refl zero ;
 module TwoSummands = ShiftedTopPresentation[l].Over[D,setD,n4,n2,\ i -> minusFour] ;
 two-top (c : TwoSummands.Fam.El) (hz : (j : Ps.Fin TwoSummands.rank) -> Id D.R (TwoSummands.extract c j) D.z)
   (i : Ps.Fin n2) (s : Sub n4) (m : L.Exp n4) : Id D.R (TwoSummands.At[i].T.O.pRaw (c i) s m) D.z =
   TwoSummands.top-zero c hz i s m ;
 -- Compare the action directly with multiplication in D[X_0]...[X_3].
 module Tower = PolynomialActionTowerComparison[l].Over[D,setD,n4] ;
 tower (x : (Tower.T.D n4).R) (m : L.Exp n4) :
   Id D.R (A.A.mulP px (Tower.B.LC.At[n4].coeff x) m)
     (Tower.B.LC.At[n4].coeff ((Tower.T.D n4).mul (Tower.P.phi n4 px) x) m) = Tower.action px x m ;
} ;
