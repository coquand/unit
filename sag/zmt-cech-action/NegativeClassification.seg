-- Every Laurent exponent is either coordinatewise negative or has a
-- nonnegative coordinate. In the second case the selected residual pi
-- is identically zero. This is constructive finite case analysis.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module N = FiniteExponents[l] ; module L = GenericLaurent[l] ;
module F = FiniteTopExponents[l] ; module X = LaurentExponentBridge[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ; module Ps = Presentations[l] ;
join (n : Nat) (x : Int) (m : L.Exp n) : L.Exp (suc n) = split { inl i -> m i ; inr t -> x } ;
top-value (n : Nat) (m : L.Exp (suc n)) : (t : Top) -> Id Int (m (inr tt)) (m (inr t)) = split { tt -> refl (m (inr tt)) } ;
join-at (n : Nat) (m : L.Exp (suc n)) : (i : Ps.Fin (suc n)) -> Id Int (join n (m (inr tt)) (tail n m) i) (m i) = split {
 inl i -> refl (m (inl i)) ; inr t -> top-value n m t } ;
join-self (n : Nat) (m : L.Exp (suc n)) : Id (L.Exp (suc n)) (join n (m (inr tt)) (tail n m)) m =
 X.At[suc n].ext _ _ (join-at n m) ;
Negative (n : Nat) (m : L.Exp n) : U l = (u : N.Exp n) * Id (L.Exp n) (F.negative n u) m ;
Some : (n : Nat) -> Sub n -> U l = split {
 zero -> \ mask -> Empty ; suc n | r -> \ mask -> Plus (Id Flag mask.1 absent) (r mask.2) } ;
Case (n : Nat) (m : L.Exp n) : U l = Plus (Negative n m) (Some n (L.mask n m)) ;
classify : (n : Nat) (m : L.Exp n) -> Case n m = split {
 zero -> \ m -> inl (N.zeroE zero,X.At[zero].ext _ _ (\ i -> absurd (Id Int (F.negative zero (N.zeroE zero) i) (m i)) i)) ;
 suc n | rec -> \ m -> subst (Case (suc n)) (join-self n m) (classifyHead n rec (tail n m) (m (inr tt))) }
where {
 lift-at (n : Nat) (a : Base.Nat) (m : L.Exp n) (u : N.Exp n) (e : Id (L.Exp n) (F.negative n u) m) :
   (i : Ps.Fin (suc n)) -> Id Int (F.negative (suc n) (N.join n u a) i) (join n (negsuc a) m i) = split {
     inl i -> ap (\ v -> v i) e ; inr t -> refl (negsuc a) } ;
 liftNegative (n : Nat) (a : Base.Nat) (m : L.Exp n) (u : N.Exp n) (e : Id (L.Exp n) (F.negative n u) m) :
   Negative (suc n) (join n (negsuc a) m) = (N.join n u a,X.At[suc n].ext _ _
     (lift-at n a m u e)) ;
 lowerCase (n : Nat) (a : Base.Nat) (m : L.Exp n) : Case n m -> Case (suc n) (join n (negsuc a) m) = split {
   inl w -> inl (liftNegative n a m w.1 w.2) ; inr h -> inr (inr h) } ;
 classifyHead (n : Nat) (rec : (m : L.Exp n) -> Case n m) (m : L.Exp n) : (x : Int) -> Case (suc n) (join n x m) = split {
   pos a -> inr (inl (refl absent)) ; negsuc a -> lowerCase n a m (rec m) } } ;
module Over (D : CRing) (setD : Prelude[l].isSet D.R) {
 module C = GenericCube[l].Over[D,setD] ; module T = GenericTop[l].Over[D,setD] ; module H = GenericContraction[l].Over[D,setD] ;
 zero-some : (n : Nat) (mask : Sub n) -> Some n mask -> T.IsZero n mask = split {
 zero -> \ mask h c s -> absurd (Id D.R (H.proj zero mask c s) D.z) h ;
 suc n | rec -> \ mask h c s -> zs n rec mask.1 mask.2 h c s.1 s.2 }
 where {
   presentCase (n : Nat) (rec : (mask : Sub n) -> Some n mask -> T.IsZero n mask) (mask : Sub n) :
     Plus (Id Flag present absent) (Some n mask) -> T.IsZero (suc n) (present,mask) = split {
       inl e -> \ c s -> absurd (Id D.R (H.proj (suc n) (present,mask) c s) D.z) (X.no-ap (sym e)) ;
       inr h -> \ c s -> zp n mask (rec mask h) c s.1 s.2 }
   where { zp (n : Nat) (mask : Sub n) (e : T.IsZero n mask) (c : C.Raw (suc n)) : (f : Flag) (s : Sub n) ->
     Id D.R (H.proj (suc n) (present,mask) c (f,s)) D.z = split {
       absent -> e (C.left n c) ; present -> e (C.right n c) } } ;
   zs (n : Nat) (rec : (mask : Sub n) -> Some n mask -> T.IsZero n mask) :
     (b : Flag) (mask : Sub n) -> Some (suc n) (b,mask) -> (c : C.Raw (suc n)) (f : Flag) (s : Sub n) ->
     Id D.R (H.proj (suc n) (b,mask) c (f,s)) D.z = split {
       absent -> \ mask h c f s -> refl D.z ;
       present -> \ mask h c f s -> presentCase n rec mask h c (f,s) } } ;
} ;
