-- Finite top coordinates for arbitrary finite shifted families, tagged
-- by summand and flattened into one Fin-indexed free D-module. Vanishing
-- of this single vector kills the top residual in every summand.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module Ps = Presentations[l] ; module IP = IdealPowers[l] ; module K = GenericDegree[l] ;
module L = GenericLaurent[l] ; module B = FiniteFamilyCoordinates[l] ;
module Over (D : CRing) (setD : Prelude[l].isSet D.R) (nvar a : Nat) (k : Ps.Fin a -> Int) {
 module M = ShiftedMatrixAction[l].Over[D,setD,nvar] ; module Fam = M.Family[a,k,K.topRank nvar] ;
 module At (i : Ps.Fin a) { module T = FiniteTopPresentation[l].Over[D,setD,nvar,k i] ; } ;
 ranks (i : Ps.Fin a) : Nat = At[i].T.rank ;
 rank : Nat = B.total a ranks ;
 Coords : U l = Ps.Fin rank -> D.R ;
 free : IP.Mod[D] = Laurent4[l].Over[D,setD].powM (Ps.Fin rank) (IP.regular D) ;
 extract (c : Fam.El) : Coords = B.flatten D.R a ranks (\ i -> At[i].T.extract (c i)) ;
 at-tag (c : Fam.El) (i : Ps.Fin a) (j : Ps.Fin (ranks i)) :
   Id D.R (extract c (B.inject a ranks i j)) (At[i].T.extract (c i) j) =
   B.at-inject D.R a ranks (\ i -> At[i].T.extract (c i)) i j ;
 module FE = Axioms[l].FunExtLemmas[fe @l] ;
 add (c c' : Fam.El) (j : Ps.Fin rank) : Id D.R (extract (Fam.mod.madd c c') j) (D.add (extract c j) (extract c' j)) =
   trans (B.relates D.R (\ x y -> Id D.R x y) a ranks
     (\ i -> At[i].T.extract ((Fam.Md i).madd (c i) (c' i)))
     (\ i q -> D.add (At[i].T.extract (c i) q) (At[i].T.extract (c' i) q))
     (\ i q -> ap (\ v -> v q) ((At[i].T.extractlin).f-add (c i) (c' i))) j)
       (B.operation D.R D.add a ranks (\ i -> At[i].T.extract (c i)) (\ i -> At[i].T.extract (c' i)) j) ;
 sm (b : D.R) (c : Fam.El) (j : Ps.Fin rank) : Id D.R (extract (Fam.mod.sm b c) j) (D.mul b (extract c j)) =
   trans (B.relates D.R (\ x y -> Id D.R x y) a ranks (\ i -> At[i].T.extract ((Fam.Md i).sm b (c i)))
     (\ i q -> D.mul b (At[i].T.extract (c i) q))
     (\ i q -> ap (\ v -> v q) ((At[i].T.extractlin).f-sm b (c i))) j)
       (B.operation D.R (\ x y -> D.mul b x) a ranks (\ i -> At[i].T.extract (c i)) (\ i -> At[i].T.extract (c i)) j) ;
 lin : IP.Lin[D,Fam.mod,free] = IP.mkLin D Fam.mod free extract
   (\ c c' -> FE.funext (Ps.Fin rank) (\ j -> D.R) _ _ (add c c'))
   (\ b c -> FE.funext (Ps.Fin rank) (\ j -> D.R) _ _ (sm b c)) ;
 reconstruct (v : Coords) (i : Ps.Fin a) (s : Sub nvar) (m : L.Exp nvar) : D.R =
   At[i].T.reconstruct (\ j -> v (B.inject a ranks i j)) s m ;
 equation (c : Fam.El) (i : Ps.Fin a) (s : Sub nvar) (m : L.Exp nvar) :
   Id D.R (reconstruct (extract c) i s m) (At[i].T.O.pRaw (c i) s m) =
   trans (ap (\ v -> At[i].T.reconstruct v s m)
     (FE.funext (Ps.Fin (ranks i)) (\ j -> D.R)
       (\ j -> extract c (B.inject a ranks i j)) (At[i].T.extract (c i)) (at-tag c i))) (At[i].T.equation (c i) s m) ;
 top-zero (c : Fam.El) (hz : (j : Ps.Fin rank) -> Id D.R (extract c j) D.z)
   (i : Ps.Fin a) (s : Sub nvar) (m : L.Exp nvar) : Id D.R (At[i].T.O.pRaw (c i) s m) D.z =
   At[i].T.top-zero (c i) (\ j -> trans (sym (at-tag c i j)) (hz (B.inject a ranks i j))) s m ;
} ;
