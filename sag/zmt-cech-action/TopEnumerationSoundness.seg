-- Soundness complements coverage of the static top list: each coordinate
-- denotes an all-negative monomial of exactly the specified twist.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module N = FiniteExponents[l] ; module L = GenericLaurent[l] ; module F = FiniteTopExponents[l] ;
module J = FiniteLookup[l] ; module LG = Logic[l] ; module Ps = Presentations[l] ;
at-mem (E : U l) : (xs : List E) (i : Ps.Fin (J.length E xs)) -> L.Mem E (J.at E xs i) xs = split {
 nil -> \ i -> absurd (L.Mem E (J.at E nil i) nil) i ;
 cons x xs | rec -> atMemS E x xs rec }
where { atMemS (E : U l) (x : E) (xs : List E) (rec : (i : Ps.Fin (J.length E xs)) -> L.Mem E (J.at E xs i) xs) :
 (i : Ps.Fin (suc (J.length E xs))) -> L.Mem E (J.at E (cons x xs) i) (cons x xs) = split {
 inl i -> inr (rec i) ; inr t -> inl (refl x) } } ;
negative-mask : (n : Nat) (u : N.Exp n) -> Id (Sub n) (L.mask n (F.negative n u)) (full n) = split {
 zero -> \ u -> refl tt ; suc n | rec -> \ u -> ap (\ s -> (present,s)) (rec (N.old n u)) } ;
module At (n : Nat) (k : Int) {
 module Enum = F.At[n,k] ;
 good (v : N.Exp n) : (us : List (N.Exp n)) -> L.Mem (N.Exp n) v (Enum.filter us) -> Id Int (L.total n (F.negative n v)) k = split {
   nil -> \ h -> absurd (Id Int (L.total n (F.negative n v)) k) h ;
   cons u us | rec -> goodStep u us rec (int-dec (L.total n (F.negative n u)) k) }
 where {
   yesCase (v u : N.Exp n) (us : List (N.Exp n)) (eq : Id Int (L.total n (F.negative n u)) k)
     (rec : L.Mem (N.Exp n) v (Enum.filter us) -> Id Int (L.total n (F.negative n v)) k) :
     L.Mem (N.Exp n) v (cons u (Enum.filter us)) -> Id Int (L.total n (F.negative n v)) k = split {
       inl e -> trans (ap (\ w -> L.total n (F.negative n w)) (sym e)) eq ; inr h -> rec h } ;
   goodStep (u : N.Exp n) (us : List (N.Exp n))
     (rec : L.Mem (N.Exp n) v (Enum.filter us) -> Id Int (L.total n (F.negative n v)) k) :
     (d : LG.Dec (Id Int (L.total n (F.negative n u)) k)) ->
     L.Mem (N.Exp n) v (Enum.keep u (Enum.filter us) d) -> Id Int (L.total n (F.negative n v)) k = split {
       yes eq -> yesCase v u us eq rec ; no ne -> rec } } ;
 coordinate (i : Ps.Fin (J.length (N.Exp n) Enum.naturals)) : N.Exp n = J.at (N.Exp n) Enum.naturals i ;
 degree (i : Ps.Fin (J.length (N.Exp n) Enum.naturals)) : Id Int (L.total n (F.negative n (coordinate i))) k =
   good (coordinate i) (FiniteExponentBoxes[l].boxes n (F.magnitude k)) (at-mem (N.Exp n) Enum.naturals i) ;
 sign (i : Ps.Fin (J.length (N.Exp n) Enum.naturals)) : Id (Sub n) (L.mask n (F.negative n (coordinate i))) (full n) = negative-mask n (coordinate i) ;
} ;
module Over (D : CRing) (setD : Prelude[l].isSet D.R) {
 module C = GenericCube[l].Over[D,setD] ; module H = GenericContraction[l].Over[D,setD] ;
 full-proj : (n : Nat) (c : C.Raw n) (s : Sub n) -> Id D.R (H.proj n (full n) c s) (c s) = split {
   zero -> \ c s -> refl (c s) ; suc n | rec -> \ c s -> fp n rec c s.1 s.2 }
 where { fp (n : Nat) (rec : (c : C.Raw n) (s : Sub n) -> Id D.R (H.proj n (full n) c s) (c s))
   (c : C.Raw (suc n)) : (f : Flag) (s : Sub n) -> Id D.R (H.proj (suc n) (full (suc n)) c (f,s)) (c (f,s)) = split {
     absent -> rec (C.left n c) ; present -> rec (C.right n c) } } ;
 module Coordinates (n : Nat) (k : Int) {
   module T = FiniteTopPresentation[l].Over[D,setD,n,k] ; module A = At[n,k] ;
   value (c : T.O.A.El) (i : Ps.Fin T.rank) : Id D.R (T.extract c i)
     (T.O.A.val c (full n) (F.negative n (A.coordinate i))) =
     trans (ap (\ mask -> H.proj n mask (T.O.A.fibre c (F.negative n (A.coordinate i))) (full n)) (A.sign i))
       (full-proj n (T.O.A.fibre c (F.negative n (A.coordinate i))) (full n)) ;
 } ;
} ;
