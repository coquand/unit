-- Flatten a finite family of finite coordinate blocks. Indices retain
-- their summand tag through inject. Only finite recursion is used.
level l ; open Ring[l] ;
module Ps = Presentations[l] ; module B = Blocks[l] ; module FC = FinCat[l] ;
total : (a : Nat) -> (Ps.Fin a -> Nat) -> Nat = split {
 zero -> \ r -> zero ; suc a | rec -> \ r -> plus (rec (\ i -> r (inl i))) (r (inr tt)) } ;
flatten (X : U l) : (a : Nat) (r : Ps.Fin a -> Nat) -> ((i : Ps.Fin a) -> Ps.Fin (r i) -> X) -> Ps.Fin (total a r) -> X = split {
 zero -> \ r v j -> absurd X j ;
 suc a | rec -> \ r v -> FC.cat X (total a (\ i -> r (inl i))) (r (inr tt))
   (rec (\ i -> r (inl i)) (\ i -> v (inl i))) (v (inr tt)) } ;
inject : (a : Nat) (r : Ps.Fin a -> Nat) (i : Ps.Fin a) -> Ps.Fin (r i) -> Ps.Fin (total a r) = split {
 zero -> \ r i j -> absurd (Ps.Fin zero) i ;
 suc a | rec -> \ r -> injS a rec r }
where {
 injTop (a : Nat) (r : Ps.Fin (suc a) -> Nat) : (t : Top) -> Ps.Fin (r (inr t)) -> Ps.Fin (total (suc a) r) = split {
   tt -> \ j -> B.ix (total a (\ i -> r (inl i))) (r (inr tt)) (inr j) } ;
 injS (a : Nat) (rec : (r : Ps.Fin a -> Nat) (i : Ps.Fin a) -> Ps.Fin (r i) -> Ps.Fin (total a r))
   (r : Ps.Fin (suc a) -> Nat) : (i : Ps.Fin (suc a)) -> Ps.Fin (r i) -> Ps.Fin (total (suc a) r) = split {
   inl i -> \ j -> B.ix (total a (\ i -> r (inl i))) (r (inr tt)) (inl (rec (\ i -> r (inl i)) i j)) ;
   inr t -> injTop a r t } } ;
at-inject (X : U l) : (a : Nat) (r : Ps.Fin a -> Nat) (v : (i : Ps.Fin a) -> Ps.Fin (r i) -> X)
 (i : Ps.Fin a) (j : Ps.Fin (r i)) -> Id X (flatten X a r v (inject a r i j)) (v i j) = split {
 zero -> \ r v i j -> absurd (Id X (flatten X zero r v (inject zero r i j)) (v i j)) i ;
 suc a | rec -> \ r v -> aiS X a rec r v }
where {
 aiTop (X : U l) (a : Nat) (r : Ps.Fin (suc a) -> Nat) (v : (i : Ps.Fin (suc a)) -> Ps.Fin (r i) -> X) :
   (t : Top) (j : Ps.Fin (r (inr t))) -> Id X (flatten X (suc a) r v (inject (suc a) r (inr t) j)) (v (inr t) j) = split {
   tt -> \ j -> FC.cat-r X (total a (\ i -> r (inl i))) (r (inr tt))
     (flatten X a (\ i -> r (inl i)) (\ i -> v (inl i))) (v (inr tt)) j } ;
 aiS (X : U l) (a : Nat)
   (rec : (r : Ps.Fin a -> Nat) (v : (i : Ps.Fin a) -> Ps.Fin (r i) -> X) (i : Ps.Fin a) (j : Ps.Fin (r i)) ->
     Id X (flatten X a r v (inject a r i j)) (v i j))
   (r : Ps.Fin (suc a) -> Nat) (v : (i : Ps.Fin (suc a)) -> Ps.Fin (r i) -> X) :
   (i : Ps.Fin (suc a)) (j : Ps.Fin (r i)) -> Id X (flatten X (suc a) r v (inject (suc a) r i j)) (v i j) = split {
   inl i -> \ j -> trans (FC.cat-l X (total a (\ i -> r (inl i))) (r (inr tt))
     (flatten X a (\ i -> r (inl i)) (\ i -> v (inl i))) (v (inr tt)) (inject a (\ i -> r (inl i)) i j))
       (rec (\ i -> r (inl i)) (\ i -> v (inl i)) i j) ;
   inr t -> aiTop X a r v t } } ;
-- A relation holding in each block holds after flattening two families.
relates (X : U l) (Rel : X -> X -> U l) : (a : Nat) (r : Ps.Fin a -> Nat)
 (v w : (i : Ps.Fin a) -> Ps.Fin (r i) -> X) -> ((i : Ps.Fin a) (j : Ps.Fin (r i)) -> Rel (v i j) (w i j)) ->
 (j : Ps.Fin (total a r)) -> Rel (flatten X a r v j) (flatten X a r w j) = split {
 zero -> \ r v w h j -> absurd (Rel (flatten X zero r v j) (flatten X zero r w j)) j ;
 suc a | rec -> \ r v w h j -> relSplit X Rel a r v w
   (rec (\ i -> r (inl i)) (\ i -> v (inl i)) (\ i -> w (inl i)) (\ i -> h (inl i))) (h (inr tt))
   (B.xi (total a (\ i -> r (inl i))) (r (inr tt)) j) }
where {
 relSplit (X : U l) (Rel : X -> X -> U l) (a : Nat) (r : Ps.Fin (suc a) -> Nat)
   (v w : (i : Ps.Fin (suc a)) -> Ps.Fin (r i) -> X)
   (h : (j : Ps.Fin (total a (\ i -> r (inl i)))) -> Rel
     (flatten X a (\ i -> r (inl i)) (\ i -> v (inl i)) j)
     (flatten X a (\ i -> r (inl i)) (\ i -> w (inl i)) j))
   (hh : (j : Ps.Fin (r (inr tt))) -> Rel (v (inr tt) j) (w (inr tt) j)) :
   (q : Plus (Ps.Fin (total a (\ i -> r (inl i)))) (Ps.Fin (r (inr tt)))) -> Rel
     (FC.catP X (total a (\ i -> r (inl i))) (r (inr tt)) (flatten X a (\ i -> r (inl i)) (\ i -> v (inl i))) (v (inr tt)) q)
     (FC.catP X (total a (\ i -> r (inl i))) (r (inr tt)) (flatten X a (\ i -> r (inl i)) (\ i -> w (inl i))) (w (inr tt)) q) = split {
       inl j -> h j ; inr j -> hh j } } ;
operation (X : U l) (op : X -> X -> X) : (a : Nat) (r : Ps.Fin a -> Nat)
 (v w : (i : Ps.Fin a) -> Ps.Fin (r i) -> X) (j : Ps.Fin (total a r)) ->
 Id X (flatten X a r (\ i q -> op (v i q) (w i q)) j) (op (flatten X a r v j) (flatten X a r w j)) = split {
 zero -> \ r v w j -> absurd (Id X (flatten X zero r (\ i q -> op (v i q) (w i q)) j) (op (flatten X zero r v j) (flatten X zero r w j))) j ;
 suc a | rec -> \ r v w j -> opSplit X op a r v w
   (rec (\ i -> r (inl i)) (\ i -> v (inl i)) (\ i -> w (inl i)))
   (B.xi (total a (\ i -> r (inl i))) (r (inr tt)) j) }
where {
 opSplit (X : U l) (op : X -> X -> X) (a : Nat) (r : Ps.Fin (suc a) -> Nat)
   (v w : (i : Ps.Fin (suc a)) -> Ps.Fin (r i) -> X)
   (h : (j : Ps.Fin (total a (\ i -> r (inl i)))) -> Id X
     (flatten X a (\ i -> r (inl i)) (\ i q -> op (v (inl i) q) (w (inl i) q)) j)
     (op (flatten X a (\ i -> r (inl i)) (\ i -> v (inl i)) j) (flatten X a (\ i -> r (inl i)) (\ i -> w (inl i)) j))) :
   (q : Plus (Ps.Fin (total a (\ i -> r (inl i)))) (Ps.Fin (r (inr tt)))) -> Id X
     (FC.catP X (total a (\ i -> r (inl i))) (r (inr tt))
       (flatten X a (\ i -> r (inl i)) (\ i j -> op (v (inl i) j) (w (inl i) j))) (\ j -> op (v (inr tt) j) (w (inr tt) j)) q)
     (op (FC.catP X (total a (\ i -> r (inl i))) (r (inr tt)) (flatten X a (\ i -> r (inl i)) (\ i -> v (inl i))) (v (inr tt)) q)
         (FC.catP X (total a (\ i -> r (inl i))) (r (inr tt)) (flatten X a (\ i -> r (inl i)) (\ i -> w (inl i))) (w (inr tt)) q)) = split {
       inl j -> h j ; inr j -> refl (op (v (inr tt) j) (w (inr tt) j)) } } ;
