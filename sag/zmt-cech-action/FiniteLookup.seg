-- Finite coordinate lists with first-match reconstruction. Repeated
-- entries are permitted: extraction followed by reconstruction is still
-- exact on the list support, and zero coordinates reconstruct to zero.
-- Thus a finite presentation need not prove an unnecessary minimal basis.
level l ; open Ring[l] ;
module L = GenericLaurent[l] ; module Ps = Presentations[l] ; module LG = Logic[l] ;
length (E : U l) : List E -> Nat = split { nil -> zero ; cons x xs | r -> suc r } ;
at (E : U l) : (xs : List E) -> Ps.Fin (length E xs) -> E = split {
 nil -> \ i -> absurd E i ; cons x xs | rec -> atStep E x xs rec }
where { atStep (E : U l) (x : E) (xs : List E) (rec : Ps.Fin (length E xs) -> E) : Ps.Fin (suc (length E xs)) -> E = split {
 inl i -> rec i ; inr t -> x } } ;
module Over (D : CRing) (E : U l) (dec : (x y : E) -> LG.Dec (Id E x y)) {
 extract (xs : List E) (f : E -> D.R) : Ps.Fin (length E xs) -> D.R = \ i -> f (at E xs i) ;
 choose (x : E) (xs : List E) (rec : (Ps.Fin (length E xs) -> D.R) -> E -> D.R)
   (v : Ps.Fin (suc (length E xs)) -> D.R) (u : E) : LG.Dec (Id E x u) -> D.R = split {
     yes e -> v (inr tt) ; no ne -> rec (\ i -> v (inl i)) u } ;
 lookup : (xs : List E) -> (Ps.Fin (length E xs) -> D.R) -> E -> D.R = split {
   nil -> \ v u -> D.z ; cons x xs | rec -> \ v u -> choose x xs rec v u (dec x u) } ;
 read-inside : (xs : List E) (f : E -> D.R) (u : E) -> L.Mem E u xs -> Id D.R (lookup xs (extract xs f) u) (f u) = split {
   nil -> \ f u h -> absurd (Id D.R D.z (f u)) h ;
   cons x xs | rec -> \ f u h -> inside x xs rec f u h (dec x u) }
 where {
   no-head (x u : E) (xs : List E) (ne : Id E x u -> Base.Empty) : L.Mem E u (cons x xs) -> L.Mem E u xs = split {
     inl e -> Prelude[l].absurd (L.Mem E u xs) (ne e) ; inr h -> h } ;
   inside (x : E) (xs : List E)
     (rec : (f : E -> D.R) (u : E) -> L.Mem E u xs -> Id D.R (lookup xs (extract xs f) u) (f u))
     (f : E -> D.R) (u : E) (h : L.Mem E u (cons x xs)) :
     (d : LG.Dec (Id E x u)) -> Id D.R (choose x xs (lookup xs) (extract (cons x xs) f) u d) (f u) = split {
       yes e -> ap f e ; no ne -> rec f u (no-head x u xs ne h) } } ;
 read-outside : (xs : List E) (f : E -> D.R) (u : E) -> Not (L.Mem E u xs) -> Id D.R (lookup xs (extract xs f) u) D.z = split {
   nil -> \ f u h -> refl D.z ;
   cons x xs | rec -> \ f u h -> outside x xs rec f u h (dec x u) }
 where { outside (x : E) (xs : List E)
   (rec : (f : E -> D.R) (u : E) -> Not (L.Mem E u xs) -> Id D.R (lookup xs (extract xs f) u) D.z)
   (f : E -> D.R) (u : E) (h : Not (L.Mem E u (cons x xs))) :
   (d : LG.Dec (Id E x u)) -> Id D.R (choose x xs (lookup xs) (extract (cons x xs) f) u d) D.z = split {
     yes e -> absurd (Id D.R (f x) D.z) (h (inl e)) ; no ne -> rec f u (\ hm -> h (inr hm)) } } ;
 zero : (xs : List E) (v : Ps.Fin (length E xs) -> D.R) -> ((i : Ps.Fin (length E xs)) -> Id D.R (v i) D.z) ->
   (u : E) -> Id D.R (lookup xs v u) D.z = split {
   nil -> \ v hz u -> refl D.z ;
   cons x xs | rec -> \ v hz u -> zeroCase x xs rec v hz u (dec x u) }
 where { zeroCase (x : E) (xs : List E)
   (rec : (v : Ps.Fin (length E xs) -> D.R) -> ((i : Ps.Fin (length E xs)) -> Id D.R (v i) D.z) -> (u : E) -> Id D.R (lookup xs v u) D.z)
   (v : Ps.Fin (suc (length E xs)) -> D.R) (hz : (i : Ps.Fin (suc (length E xs))) -> Id D.R (v i) D.z) (u : E) :
   (d : LG.Dec (Id E x u)) -> Id D.R (choose x xs (lookup xs) v u d) D.z = split {
     yes e -> hz (inr tt) ; no ne -> rec (\ i -> v (inl i)) (\ i -> hz (inl i)) u } } ;
} ;
