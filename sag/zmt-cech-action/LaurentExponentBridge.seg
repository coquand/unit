-- Natural polynomial exponents embed componentwise into Laurent integers.
-- Translation and its inverse are proved by function extensionality;
-- total degree follows by induction on the finite coordinate set.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module N = FiniteExponents[l] ; module L = GenericLaurent[l] ;
module C = GenericCube[l] ; module B = GenericSupport[l] ;
module P = PolynomialAction4[l] ; module NA = NatArith[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ; module Ps = Presentations[l] ;
module At (n : Nat) {
 emb (u : N.Exp n) : L.Exp n = \ i -> pos (u i) ;
 addN (u v : N.Exp n) : N.Exp n = \ i -> NA.plus (u i) (v i) ;
 subE (m : L.Exp n) (u : N.Exp n) : L.Exp n = \ i -> P.minus (m i) (u i) ;
 addE (m : L.Exp n) (u : N.Exp n) : L.Exp n = \ i -> addP (m i) (u i) ;
 ext (m m' : L.Exp n) (h : (i : Ps.Fin n) -> Id Int (m i) (m' i)) : Id (L.Exp n) m m' =
   FE.funext (Ps.Fin n) (\ i -> Int) m m' h ;
 add-sub (m : L.Exp n) (u : N.Exp n) : Id (L.Exp n) (addE (subE m u) u) m =
   ext _ _ (\ i -> P.addP-minus-cancel (m i) (u i)) ;
 sub-add (m : L.Exp n) (u : N.Exp n) : Id (L.Exp n) (subE (addE m u) u) m =
   ext _ _ (\ i -> P.minus-addP (m i) (u i)) ;
 sub-sub (m : L.Exp n) (u v : N.Exp n) : Id (L.Exp n) (subE (subE m u) v) (subE m (addN v u)) =
   ext _ _ (\ i -> P.minus-minus (m i) (u i) (v i)) ;
 sub-comm (m : L.Exp n) (u v : N.Exp n) : Id (L.Exp n) (subE (subE m u) v) (subE (subE m v) u) =
   ext _ _ (\ i -> P.minus-comm (m i) (u i) (v i)) ;
 sub-add-comm (m : L.Exp n) (u v : N.Exp n) : Id (L.Exp n) (subE (addE m v) u) (addE (subE m u) v) =
   ext _ _ (\ i -> sym (P.addP-minus (m i) (u i) (v i))) ;
} ;
deg-sub : (n : Nat) (m : L.Exp n) (u : N.Exp n) ->
 Id Int (L.total n (At[n].subE m u)) (P.minus (L.total n m) (N.degree n u)) = split {
 zero -> \ m u -> refl zeroZ ;
 suc n | r -> \ m u -> trans (ap (add (P.minus (m (inr tt)) (u (inr tt))))
   (r (C.tail n m) (N.old n u)))
   (P.add-minus2 (m (inr tt)) (L.total n (C.tail n m)) (u (inr tt)) (N.degree n (N.old n u))) } ;
deg-add : (n : Nat) (m : L.Exp n) (u : N.Exp n) ->
 Id Int (L.total n (At[n].addE m u)) (addP (L.total n m) (N.degree n u)) = split {
 zero -> \ m u -> refl zeroZ ;
 suc n | r -> \ m u -> trans (ap (add (addP (m (inr tt)) (u (inr tt))))
   (r (C.tail n m) (N.old n u)))
   (P.add-addP2 (m (inr tt)) (L.total n (C.tail n m)) (u (inr tt)) (N.degree n (N.old n u))) } ;

-- A nonnegative natural subtraction cannot destroy a negative exponent.
Present : C.Flag -> U l = split { absent -> Empty ; present -> Top } ;
no-ap (e : Id C.Flag absent present) : Empty = subst Present (sym e) tt ;
flag-pred : (x : Int) -> Id C.Flag (L.IntFlags.flag x) present -> Id C.Flag (L.IntFlags.flag (predZ x)) present = split {
 pos a -> \ e -> absurd (Id C.Flag (L.IntFlags.flag (predZ (pos a))) present) (no-ap e) ;
 negsuc a -> \ e -> refl present } ;
flag-minus (x : Int) : (u : Base.Nat) -> Id C.Flag (L.IntFlags.flag x) present ->
 Id C.Flag (L.IntFlags.flag (P.minus x u)) present = split {
 zero -> \ e -> e ; suc u | r -> \ e -> flag-pred (P.minus x u) (r e) } ;
-- Monotonicity of a missing-negative condition under the sign implication.
Mono : (n : Nat) -> C.Sub n -> C.Sub n -> U l = split {
 zero -> \ a b -> Top ; suc n | r -> \ a b ->
   (Id C.Flag a.1 present -> Id C.Flag b.1 present) * r a.2 b.2 } ;
mono-bad : (n : Nat) (a b s : C.Sub n) -> Mono n a b -> B.bad n a s -> B.bad n b s = split {
 zero -> \ a b s h e -> e ;
 suc n | r -> \ a b s h -> mb n r a.1 a.2 b.1 b.2 s.1 s.2 h }
where {
 mb (n : Nat) (r : (a b s : C.Sub n) -> Mono n a b -> B.bad n a s -> B.bad n b s) :
 (a : C.Flag) (as : C.Sub n) (b : C.Flag) (bs : C.Sub n) (f : C.Flag) (s : C.Sub n) ->
 ((Id C.Flag a present -> Id C.Flag b present) * Mono n as bs) -> B.bad (suc n) (a,as) (f,s) -> B.bad (suc n) (b,bs) (f,s) = split {
 absent -> \ as -> split {
   absent -> \ bs f s h -> r as bs s h.2 ;
   present -> \ bs -> split { absent -> \ s h e -> tt ; present -> \ s h -> r as bs s h.2 } } ;
 present -> \ as -> split {
   absent -> \ bs f s h e -> absurd (B.bad (suc n) (absent,bs) (f,s)) (no-ap (h.1 (refl present))) ;
   present -> \ bs -> split { absent -> \ s h e -> tt ; present -> \ s h -> r as bs s h.2 } } } } ;
minus-mono : (n : Nat) (m : L.Exp n) (u : N.Exp n) -> Mono n (L.mask n m) (L.mask n (At[n].subE m u)) = split {
 zero -> \ m u -> tt ; suc n | r -> \ m u ->
   (flag-minus (m (inr tt)) (u (inr tt)),r (C.tail n m) (N.old n u)) } ;
bad-sub (n : Nat) (s : C.Sub n) (m : L.Exp n) (u : N.Exp n) :
 B.bad n (L.mask n m) s -> B.bad n (L.mask n (At[n].subE m u)) s =
 mono-bad n (L.mask n m) (L.mask n (At[n].subE m u)) s (minus-mono n m u) ;
