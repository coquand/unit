-- SAG 4.2.5 and 4.2.6. On an affine X, x != y is open: a presentation
-- embeds Spec A into R^n, and x != y says that the vector of coordinate
-- differences is nonzero, so by 2.2.3(b) one of its entries is invertible.
-- Consequently x specialises to y (every open containing x contains y)
-- iff not not x = y.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module E = Equivalences[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (sqc : Presentations[l].Over[R,setR].SQC) (loc : StandardOpens[l].Over[R,setR].Locality) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module FA = FunctionAlgebra[l].Over[R,setR] ;
 module CP = ClosedProp[l].Over[R,setR] ;
 module OP = OpenProp[l].Over[R,setR] ;
 module OO = OpenOps[l].Over[R,setR].SAG[sqc,loc] ;
 module U3 = Units23[l].Over[R,setR,sqc,loc] ;
 module RR = AffineRing[l].Laws[R,setR] ;
 Ne (X : U l) (x y : X) : U l = Id X x y -> Empty ;
 diff (a b : R.R) : R.R = R.add a (R.neg b) ;
 module Presented (p : P.Presentation) (A : C.Algebra) (pa : P.Presents p A) (x y : C.Spec A) {
  ds (v : Fin p.1) : R.R = diff (x.1.1 (pa.1.1 v)) (y.1.1 (pa.1.1 v)) ;
  to-zeros (h : Id (C.Spec A) x y) : CP.Zeros p.1 ds = \ v ->
   trans (ap (\ w -> diff (x.1.1 (pa.1.1 v)) (w.1.1 (pa.1.1 v))) (sym h)) (R.addN (x.1.1 (pa.1.1 v))) ;
  from-zeros (z : CP.Zeros p.1 ds) : Id (C.Spec A) x y =
   E.injective (C.Spec A) (P.Solutions p C.base) (P.canonical p A pa.1 C.base) (pa.2 C.base) x y
    (P.solutions-ext p C.base _ _ (\ v -> RR.difference-zero _ _ (z v))) ;
  is-open : OP.Open (Ne (C.Spec A) x y) =
   Tr.Trunc[OP.Witness (Ne (C.Spec A) x y)].inc (OP.from-iff (Ne (C.Spec A) x y) (OO.not-prop (Id (C.Spec A) x y)) p.1 ds
    (\ ne -> (U3.nonzero-iff-some-unit p.1 ds).1 (\ z -> ne (from-zeros z)))
    (\ u h -> (U3.nonzero-iff-some-unit p.1 ds).2 u (to-zeros h))) ;
 } ;
 open-ne-spec (A : C.Algebra) (fp : P.FP A) (x y : C.Spec A) : OP.Open (Ne (C.Spec A) x y) =
  Tr1.Trunc[P.Witness A].induction @l (\ t -> OP.Open (Ne (C.Spec A) x y))
   (\ t -> Tr.Trunc[OP.Witness (Ne (C.Spec A) x y)].proposition)
   (\ w -> Presented[w.1,A,w.2,x,y].is-open) fp ;
 ne-equiv (X Y : U l) (e : Pr.Equiv X Y) (x y : X) : Pr.Equiv (Ne X x y) (Ne Y (e.1 x) (e.1 y)) =
  (\ ne h -> ne (E.injective X Y e.1 e.2 x y h),
   Pr.qinv (Ne X x y) (Ne Y (e.1 x) (e.1 y)) (\ ne h -> ne (E.injective X Y e.1 e.2 x y h))
    (\ ne h -> ne (ap e.1 h))
    (\ ne -> OO.not-prop (Id Y (e.1 x) (e.1 y)) _ ne) (\ ne -> OO.not-prop (Id X x y) _ ne)) ;
 -- 4.2.5
 open-ne (X : U l) (aff : FA.Affine X) (x y : X) : OP.Open (Ne X x y) =
  Tr1.Trunc[FA.AffineWitness X].induction @l (\ t -> OP.Open (Ne X x y))
   (\ t -> Tr.Trunc[OP.Witness (Ne X x y)].proposition)
   (\ w -> OP.along (Ne X x y) (Ne (C.Spec w.1) (w.2.2.1 x) (w.2.2.1 y)) (ne-equiv X (C.Spec w.1) w.2.2 x y)
    (open-ne-spec w.1 w.2.1 (w.2.2.1 x) (w.2.2.1 y))) aff ;
 -- 4.2.6
 Specialises (X : U l) (x y : X) : U l+ = (S : X -> U l) -> OP.OpenSubtype X S -> S x -> S y ;
 specialises-nn (X : U l) (aff : FA.Affine X) (x y : X) (s : Specialises X x y) :
  (Id X x y -> Empty) -> Empty =
  \ ne -> s (\ z -> Ne X z y) (\ z -> open-ne X aff z y) ne (refl y) ;
 nn-specialises (X : U l) (x y : X) (nn : (Id X x y -> Empty) -> Empty) : Specialises X x y =
  \ S o sx -> OO.stable (S y) (o y) (\ nsy -> nn (\ p -> nsy (subst S p sx))) ;
} ;
