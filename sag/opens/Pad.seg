-- Padding a list of length l <= b with zeros to length b does not change
-- whether one of its entries is invertible (given 1 != 0).  Used in 4.2.7.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module CB = CoefficientBound[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (one-nz : Id R.R R.o R.z -> Empty) {
 module OP = OpenProp[l].Over[R,setR] ;
 module OO = OpenOps[l].Over[R,setR] ;
 pad : (b : Nat) -> (n : Nat) -> (Fin n -> R.R) -> Fin b -> R.R = split {
  zero -> \ n xs w -> efq w ;
  suc b | r -> split {
   zero -> \ xs w -> R.z ;
   suc n -> \ xs -> snoc (Fin b) R.R (r n (\ i -> xs (inl i))) (xs (inr tt)) } } ;
 -- the place of an entry in the padded list
 embed : (b : Nat) -> (n : Nat) -> CB.le n b -> (xs : Fin n -> R.R) -> (i : Fin n) ->
  (w : Fin b) * Id R.R (pad b n xs w) (xs i) = split {
  zero -> split { zero -> \ h xs i -> efq i ; suc n -> \ h -> efq h } ;
  suc b | r -> split {
   zero -> \ h xs i -> efq i ;
   suc n -> \ h xs -> split {
    inl i -> (inl (r n h (\ k -> xs (inl k)) i).1,(r n h (\ k -> xs (inl k)) i).2) ;
    inr t -> (inr tt,ap (\ u -> xs (inr u)) (FinSum[l].top-prop tt t)) } } } ;
 -- every padded entry is zero or an entry of the list
 Origin (b n : Nat) (xs : Fin n -> R.R) (w : Fin b) : U l =
  Plus (Id R.R (pad b n xs w) R.z) ((i : Fin n) * Id R.R (pad b n xs w) (xs i)) ;
 lift-origin (b n : Nat) (xs : Fin (suc n) -> R.R) (w : Fin b) :
  Origin b n (\ i -> xs (inl i)) w -> Origin (suc b) (suc n) xs (inl w) = split {
  inl z -> inl z ; inr a -> inr (inl a.1,a.2) } ;
 origin : (b : Nat) -> (n : Nat) -> (xs : Fin n -> R.R) -> (w : Fin b) -> Origin b n xs w = split {
  zero -> \ n xs w -> efq w ;
  suc b | r -> split {
   zero -> \ xs w -> inl (refl R.z) ;
   suc n -> \ xs -> split {
    inl w -> lift-origin b n xs w (r n (\ i -> xs (inl i)) w) ;
    inr t -> inr (inr tt,refl (xs (inr tt))) } } } ;
 zero-not-unit (u : RL[R].unit R.z) : Empty =
  one-nz (trans (sym u.2) (RL[R].zero-mul u.1)) ;
 from-origin (b n : Nat) (xs : Fin n -> R.R) (w : Fin b) (u : RL[R].unit (pad b n xs w)) :
  Origin b n xs w -> OP.Units n xs = split {
  inl z -> efq (zero-not-unit (OO.unit-along _ _ z u)) ;
  inr a -> Tr.Trunc[(i : Fin n) * RL[R].unit (xs i)].inc (a.1,OO.unit-along _ _ a.2 u) } ;
 to-padded (b n : Nat) (h : CB.le n b) (xs : Fin n -> R.R) (u : OP.Units n xs) : OP.Units b (pad b n xs) =
  Tr.Trunc[(i : Fin n) * RL[R].unit (xs i)].induction @l (\ t -> OP.Units b (pad b n xs))
   (\ t -> OP.units-prop b (pad b n xs))
   (\ v -> Tr.Trunc[(w : Fin b) * RL[R].unit (pad b n xs w)].inc
    ((embed b n h xs v.1).1,OO.unit-along _ _ (sym (embed b n h xs v.1).2) v.2)) u ;
 from-padded (b n : Nat) (xs : Fin n -> R.R) (u : OP.Units b (pad b n xs)) : OP.Units n xs =
  Tr.Trunc[(w : Fin b) * RL[R].unit (pad b n xs w)].induction @l (\ t -> OP.Units n xs)
   (\ t -> OP.units-prop n xs)
   (\ v -> from-origin b n xs v.1 v.2 (origin b n xs v.1)) u ;
} ;
