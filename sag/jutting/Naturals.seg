-- Naturals.seg: what Injection.seg uses of the naturals, their equality
-- and their order (Jutting's section "Naturals").
level l ;

data Top = tt ;
data Empty = ;
data Nat = zero | suc (n : Nat) ;
data Plus (A B : U l) : U l = inl (x : A) | inr (y : B) ;

absurd (A : U l) : Empty -> A = split { } ;
Not (A : U l) : U l = A -> Empty ;
efq {A : U l} (e : Empty) : A = absurd A e ;

------------------------------------------------------------------------
-- equality

sym {A : U l} {x y : A} (p : Id A x y) : Id A y x =
  idJ A x (\ w q -> Id A w x) (refl x) y p ;
trans {A : U l} {x y w : A} (p : Id A x y) (q : Id A y w) : Id A x w =
  idJ A y (\ v r -> Id A x v) p w q ;
ap {A B : U l} (f : A -> B) {x y : A} (p : Id A x y) : Id B (f x) (f y) =
  idJ A x (\ w q -> Id B (f x) (f w)) (refl (f x)) y p ;
subst {A : U l} (P : A -> U l) {x y : A} (p : Id A x y) (u : P x) : P y =
  idJ A x (\ w q -> P w) u y p ;

pred : Nat -> Nat = split { zero -> zero ; suc n -> n } ;
isZero : Nat -> U l = split { zero -> Top ; suc n -> Empty } ;
zero-suc (n : Nat) (p : Id Nat zero (suc n)) : Empty = subst isZero p tt ;
suc-zero (n : Nat) (p : Id Nat (suc n) zero) : Empty = zero-suc n (sym p) ;
suc-inj {m n : Nat} (p : Id Nat (suc m) (suc n)) : Id Nat m n = ap pred p ;

------------------------------------------------------------------------
-- order

Le : Nat -> Nat -> U l = split {
  zero -> \ n -> Top ;
  suc m | r -> split { zero -> Empty ; suc n -> r n } } ;
Lt (m n : Nat) : U l = Le (suc m) n ;

le-refl : (n : Nat) -> Le n n = split { zero -> tt ; suc n | r -> r } ;
le-suc : (m n : Nat) -> Le m n -> Le m (suc n) = split {
  zero -> \ n h -> tt ;
  suc m | r -> split { zero -> \ h -> efq h ; suc n -> \ h -> r n h } } ;
lt-or-eq-suc (r k : Nat) : Plus (Lt r k) (Id Nat r k) -> Plus (Lt (suc r) (suc k)) (Id Nat (suc r) (suc k)) = split {
  inl x -> inl x ;
  inr e -> inr (ap (\ n -> suc n) e) } ;
-- r <= k gives r < k or r = k
le-cases : (r k : Nat) -> Le r k -> Plus (Lt r k) (Id Nat r k) = split {
  zero -> split { zero -> \ h -> inr (refl zero) ; suc k -> \ h -> inl tt } ;
  suc r | ih -> split { zero -> \ h -> efq h ; suc k -> \ h -> lt-or-eq-suc r k (ih k h) } } ;
