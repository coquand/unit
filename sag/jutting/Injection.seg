-- Injection.seg: the main theorem of van Benthem Jutting, "The development
-- of a text in AUT-QE" (1973), with his proof C.
--
-- The naturals of Unit start at 0, so Jutting's [1,n] is [0,n) here:
-- x in [1,n] becomes x - 1 < n.  Jutting's n' (the top of [1,n']) is the
-- top n of [0,n+1), and his n (the top of [1,n]) is k, for n = k + 1.
--
--  f bounded by n:        f x < n for every x;
--  f injective on [0,n):  x, y < n and f x = f y give x = y;
--  x n-image under f:     some y < n has f y = x;
--  f surjective on [0,n): every x < n is an n-image under f.
--
-- Theorem.  For n >= 1: if f is bounded by n and injective on [0,n), then
-- f is surjective on [0,n).
--
-- Proof, by induction on n >= 1.
--  n = 1: f 0 < 1, so f 0 = 0; and x < 1 gives x = 0.  So x = f 0.
--  n -> n+1, n = k+1 (b2: f bounded by n+1; i: f injective on [0,n+1)).
--   f n < n+1, so f n = n or f n < n.
--   Case f n = n.  Put a x = k if f x = n, and a x = f x otherwise.
--    1] a x < n.  For x < n, f x /= n: otherwise f x = f n, so x = n by i.
--    2] a is injective on [0,n): a x = f x for x < n.
--    Let x < n+1.  If x = n, then f n = x.  If x < n, the induction
--    hypothesis for a gives y < n with a y = x, and f y = a y = x.
--   Case f n < n.  Put b x = f n if f x = n, and b x = f x otherwise.
--    3] b x < n.
--    For x < n: if b x = f n then f x = n (otherwise f n = b x = f x, so
--    x = n by i); if b x /= f n then b x = f x.
--    4] b is injective on [0,n): if b x = b y = f n then f x = n = f y;
--    otherwise f x = b x = b y = f y; in both cases x = y by i.
--    Let x < n+1.  If x = n, the induction hypothesis for b and f n < n
--    gives y < n with b y = f n, so f y = n = x.  If x < n and x = f n,
--    then x = f n.  If x < n and x /= f n, the induction hypothesis for b
--    gives y < n with b y = x /= f n, so f y = b y = x.
level l ; open Naturals[l] ;

---------------------------------------------------------------------
-- naturals

-- equality of naturals is decidable
dec-suc (m n : Nat) : Plus (Id Nat m n) (Not (Id Nat m n)) -> Plus (Id Nat (suc m) (suc n)) (Not (Id Nat (suc m) (suc n))) = split {
 inl e -> inl (ap (\ j -> suc j) e) ;
 inr ne -> inr (\ e -> ne (suc-inj e)) } ;
nat-dec : (m n : Nat) -> Plus (Id Nat m n) (Not (Id Nat m n)) = split {
 zero -> split { zero -> inl (refl zero) ; suc n -> inr (zero-suc n) } ;
 suc m | r -> split { zero -> inr (suc-zero m) ; suc n -> dec-suc m n (r n) } } ;

-- x < 1 gives x = 0
le-zero : (m : Nat) -> Le m zero -> Id Nat m zero = split {
 zero -> \ h -> refl zero ;
 suc m -> \ h -> efq h } ;
-- not n < n
lt-irr : (n : Nat) -> Lt n n -> Empty = split {
 zero -> \ h -> h ;
 suc n | r -> \ h -> r h } ;
lt-top (n : Nat) : Lt n (suc n) = le-refl n ;
lt-up (x n : Nat) (h : Lt x n) : Lt x (suc n) = le-suc (suc x) n h ;

---------------------------------------------------------------------
-- the notions

Bounded (n : Nat) (f : Nat -> Nat) : U l = (x : Nat) -> Lt (f x) n ;
Injective (n : Nat) (f : Nat -> Nat) : U l =
 (x y : Nat) -> Lt x n -> Lt y n -> Id Nat (f x) (f y) -> Id Nat x y ;
Image (n : Nat) (f : Nat -> Nat) (x : Nat) : U l = (y : Nat) * (Lt y n * Id Nat (f y) x) ;
Surjective (n : Nat) (f : Nat -> Nat) : U l = (x : Nat) -> Lt x n -> Image n f x ;
Statement (n : Nat) : U l = (f : Nat -> Nat) -> Bounded n f -> Injective n f -> Surjective n f ;

---------------------------------------------------------------------
-- n = 1

base : Statement (suc zero) = \ f b1 i x hx ->
 (zero, (tt, trans (le-zero (f zero) (b1 zero)) (sym (le-zero x hx)))) ;

---------------------------------------------------------------------
-- n -> n+1, for n = k+1

module Step (k : Nat) (ih : Statement (suc k)) (f : Nat -> Nat)
 (b2 : Bounded (suc (suc k)) f) (i : Injective (suc (suc k)) f) {
 n : Nat = suc k ;
 -- for x < n, f x /= f n
 ne-top (x : Nat) (hx : Lt x n) (e : Id Nat (f x) (f n)) : Empty =
  lt-irr n (subst (\ y -> Lt y n) (i x n (lt-up x n hx) (lt-top n) e) hx) ;
 -- f x /= n gives f x < n
 below-by (x : Nat) (ne : Not (Id Nat (f x) n)) : Plus (Lt (f x) n) (Id Nat (f x) n) -> Lt (f x) n = split {
  inl lt -> lt ;
  inr e -> efq (ne e) } ;
 below (x : Nat) (ne : Not (Id Nat (f x) n)) : Lt (f x) n = below-by x ne (le-cases (f x) n (b2 x)) ;

 -- case f n = n
 module CaseA (fn : Id Nat (f n) n) {
  a-by (x : Nat) : Plus (Id Nat (f x) n) (Not (Id Nat (f x) n)) -> Nat = split {
   inl e -> k ;
   inr ne -> f x } ;
  a (x : Nat) : Nat = a-by x (nat-dec (f x) n) ;
  a-other-by (x : Nat) (ne : Not (Id Nat (f x) n)) : (d : Plus (Id Nat (f x) n) (Not (Id Nat (f x) n))) -> Id Nat (a-by x d) (f x) = split {
   inl e -> efq (ne e) ;
   inr ne' -> refl (f x) } ;
  a-other (x : Nat) (ne : Not (Id Nat (f x) n)) : Id Nat (a x) (f x) = a-other-by x ne (nat-dec (f x) n) ;
  s1-by (x : Nat) : (d : Plus (Id Nat (f x) n) (Not (Id Nat (f x) n))) -> Lt (a-by x d) n = split {
   inl e -> lt-top k ;
   inr ne -> below x ne } ;
  -- 1]
  s1 : Bounded n a = \ x -> s1-by x (nat-dec (f x) n) ;
  not-top (x : Nat) (hx : Lt x n) (e : Id Nat (f x) n) : Empty = ne-top x hx (trans e (sym fn)) ;
  -- 2]
  s2 : Injective n a = \ x y hx hy e ->
   i x y (lt-up x n hx) (lt-up y n hy) (trans (sym (a-other x (not-top x hx))) (trans e (a-other y (not-top y hy)))) ;
  -- x < n: the induction hypothesis for a
  module Lower (x : Nat) (hx : Lt x n) {
   y : Nat = (ih a s1 s2 x hx).1 ;
   hy : Lt y n = (ih a s1 s2 x hx).2.1 ;
   ay : Id Nat (a y) x = (ih a s1 s2 x hx).2.2 ;
   result : Image (suc n) f x = (y, (lt-up y n hy, trans (sym (a-other y (not-top y hy))) ay)) ;
  } ;
  surj-by (x : Nat) : Plus (Lt x n) (Id Nat x n) -> Image (suc n) f x = split {
   inl lt -> Lower[x,lt].result ;
   inr e -> (n, (lt-top n, trans fn (sym e))) } ;
  surjective : Surjective (suc n) f = \ x hx -> surj-by x (le-cases x n hx) ;
 } ;

 -- case f n < n
 module CaseB (fn : Lt (f n) n) {
  b-by (x : Nat) : Plus (Id Nat (f x) n) (Not (Id Nat (f x) n)) -> Nat = split {
   inl e -> f n ;
   inr ne -> f x } ;
  b (x : Nat) : Nat = b-by x (nat-dec (f x) n) ;
  b-top-by (x : Nat) (e : Id Nat (f x) n) : (d : Plus (Id Nat (f x) n) (Not (Id Nat (f x) n))) -> Id Nat (b-by x d) (f n) = split {
   inl e' -> refl (f n) ;
   inr ne -> efq (ne e) } ;
  b-top (x : Nat) (e : Id Nat (f x) n) : Id Nat (b x) (f n) = b-top-by x e (nat-dec (f x) n) ;
  b-other-by (x : Nat) (ne : Not (Id Nat (f x) n)) : (d : Plus (Id Nat (f x) n) (Not (Id Nat (f x) n))) -> Id Nat (b-by x d) (f x) = split {
   inl e -> efq (ne e) ;
   inr ne' -> refl (f x) } ;
  b-other (x : Nat) (ne : Not (Id Nat (f x) n)) : Id Nat (b x) (f x) = b-other-by x ne (nat-dec (f x) n) ;
  s3-by (x : Nat) : (d : Plus (Id Nat (f x) n) (Not (Id Nat (f x) n))) -> Lt (b-by x d) n = split {
   inl e -> fn ;
   inr ne -> below x ne } ;
  -- 3]
  s3 : Bounded n b = \ x -> s3-by x (nat-dec (f x) n) ;
  -- for x < n, b x = f n gives f x = n
  top-of-by (x : Nat) (hx : Lt x n) (t : Id Nat (b x) (f n)) : Plus (Id Nat (f x) n) (Not (Id Nat (f x) n)) -> Id Nat (f x) n = split {
   inl e -> e ;
   inr ne -> efq (ne-top x hx (trans (sym (b-other x ne)) t)) } ;
  top-of (x : Nat) (hx : Lt x n) (t : Id Nat (b x) (f n)) : Id Nat (f x) n = top-of-by x hx t (nat-dec (f x) n) ;
  -- b x /= f n gives b x = f x
  other-of-by (x : Nat) (nt : Not (Id Nat (b x) (f n))) : Plus (Id Nat (f x) n) (Not (Id Nat (f x) n)) -> Id Nat (b x) (f x) = split {
   inl e -> efq (nt (b-top x e)) ;
   inr ne -> b-other x ne } ;
  other-of (x : Nat) (nt : Not (Id Nat (b x) (f n))) : Id Nat (b x) (f x) = other-of-by x nt (nat-dec (f x) n) ;
  s4-by (x y : Nat) (hx : Lt x n) (hy : Lt y n) (e : Id Nat (b x) (b y)) :
   Plus (Id Nat (b x) (f n)) (Not (Id Nat (b x) (f n))) -> Id Nat x y = split {
   inl t -> i x y (lt-up x n hx) (lt-up y n hy) (trans (top-of x hx t) (sym (top-of y hy (trans (sym e) t)))) ;
   inr nt -> i x y (lt-up x n hx) (lt-up y n hy)
              (trans (sym (other-of x nt)) (trans e (other-of y (\ t -> nt (trans e t))))) } ;
  -- 4]
  s4 : Injective n b = \ x y hx hy e -> s4-by x y hx hy e (nat-dec (b x) (f n)) ;
  -- the induction hypothesis for b, at w < n
  module IH (w : Nat) (hw : Lt w n) {
   y : Nat = (ih b s3 s4 w hw).1 ;
   hy : Lt y n = (ih b s3 s4 w hw).2.1 ;
   by : Id Nat (b y) w = (ih b s3 s4 w hw).2.2 ;
  } ;
  -- x = n: the induction hypothesis at f n
  at-top (x : Nat) (e : Id Nat x n) : Image (suc n) f x =
   (IH[f n,fn].y, (lt-up IH[f n,fn].y n IH[f n,fn].hy, trans (top-of IH[f n,fn].y IH[f n,fn].hy IH[f n,fn].by) (sym e))) ;
  -- x < n, x /= f n: the induction hypothesis at x
  module Lower (x : Nat) (hx : Lt x n) (ne : Not (Id Nat x (f n))) {
   module H = IH[x,hx] ;
   nt : Not (Id Nat (b H.y) (f n)) = \ t -> ne (trans (sym H.by) t) ;
   result : Image (suc n) f x = (H.y, (lt-up H.y n H.hy, trans (sym (other-of H.y nt)) H.by)) ;
  } ;
  below-top-by (x : Nat) (hx : Lt x n) : Plus (Id Nat x (f n)) (Not (Id Nat x (f n))) -> Image (suc n) f x = split {
   inl e -> (n, (lt-top n, sym e)) ;
   inr ne -> Lower[x,hx,ne].result } ;
  surj-by (x : Nat) : Plus (Lt x n) (Id Nat x n) -> Image (suc n) f x = split {
   inl lt -> below-top-by x lt (nat-dec x (f n)) ;
   inr e -> at-top x e } ;
  surjective : Surjective (suc n) f = \ x hx -> surj-by x (le-cases x n hx) ;
 } ;

 cases : Plus (Lt (f n) n) (Id Nat (f n) n) -> Surjective (suc n) f = split {
  inl lt -> CaseB[lt].surjective ;
  inr e -> CaseA[e].surjective } ;
 result : Surjective (suc n) f = cases (le-cases (f n) n (b2 n)) ;
} ;

---------------------------------------------------------------------
-- the theorem, for n = k+1

theorem : (k : Nat) -> Statement (suc k) = split {
 zero -> base ;
 suc k | ih -> \ f b2 i -> Step[k,ih,f,b2,i].result } ;
