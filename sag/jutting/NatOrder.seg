-- NatOrder.seg: order on the natural numbers, by recursion into U.
level l ; open Ring[l] ;


Le : Nat -> Nat -> U l = split {
  zero -> \ n -> Top ;
  suc m | r -> split { zero -> Empty ; suc n -> r n } } ;

Lt (m n : Nat) : U l = Le (suc m) n ;

le-refl : (n : Nat) -> Le n n = split { zero -> tt ; suc n | r -> r } ;

le-trans : (a b c : Nat) -> Le a b -> Le b c -> Le a c = split {
  zero -> \ b c h k -> tt ;
  suc a | r -> split {
    zero -> \ c h k -> efq h ;
    suc b -> split {
      zero -> \ h k -> efq k ;
      suc c -> \ h k -> r b c h k } } } ;

le-or-gt : (m n : Nat) -> Plus (Le m n) (Lt n m) = split {
  zero -> \ n -> inl tt ;
  suc m | r -> split { zero -> inr tt ; suc n -> r n } } ;

le-plus : (m n : Nat) -> Le m n -> (d : Nat) * Id Nat n (plus d m) = split {
  zero -> \ n h -> (n, sym (plus-zero n)) ;
  suc m | r -> split {
    zero -> \ h -> efq h ;
    suc n -> \ h -> ((r n h).1, trans (ap (\ k -> suc k) (r n h).2) (sym (plus-suc (r n h).1 m))) } } ;


le-suc : (m n : Nat) -> Le m n -> Le m (suc n) = split {
  zero -> \ n h -> tt ;
  suc m | r -> split { zero -> \ h -> efq h ; suc n -> \ h -> r n h } } ;

le-plus-right : (s d : Nat) -> Le d (plus s d) = split {
  zero -> \ d -> le-refl d ;
  suc s | r -> \ d -> le-suc d (plus s d) (r d) } ;

lt-or-eq-suc (r k : Nat) : Plus (Lt r k) (Id Nat r k) -> Plus (Lt (suc r) (suc k)) (Id Nat (suc r) (suc k)) = split {
  inl x -> inl x ;
  inr e -> inr (ap (\ n -> suc n) e) } ;

le-cases : (r k : Nat) -> Le r k -> Plus (Lt r k) (Id Nat r k) = split {
  zero -> split { zero -> \ h -> inr (refl zero) ; suc k -> \ h -> inl tt } ;
  suc r | ih -> split { zero -> \ h -> efq h ; suc k -> \ h -> lt-or-eq-suc r k (ih k h) } } ;

compare-suc (m n : Nat) :
  Plus ((d : Nat) * Id Nat m (plus n d)) ((d : Nat) * Id Nat n (plus m d)) ->
  Plus ((d : Nat) * Id Nat (suc m) (plus (suc n) d)) ((d : Nat) * Id Nat (suc n) (plus (suc m) d)) = split {
  inl p -> inl (p.1, ap (\ k -> suc k) p.2) ;
  inr p -> inr (p.1, ap (\ k -> suc k) p.2) } ;

-- m = n + d or n = m + d
compare : (m n : Nat) -> Plus ((d : Nat) * Id Nat m (plus n d)) ((d : Nat) * Id Nat n (plus m d)) = split {
  zero -> \ n -> inr (n, refl n) ;
  suc m | ih -> split {
    zero -> inl (suc m, refl (suc m)) ;
    suc n -> compare-suc m n (ih n) } } ;
