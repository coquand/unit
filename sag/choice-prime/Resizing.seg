-- Excluded middle makes every proposition small: a proposition P of any
-- level is Top or Empty, both of level l. Double negation elimination
-- follows in the same way.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module H = Prelude[l+] ;

top-prop : Pr.isProp Top = split { tt -> split { tt -> refl tt } } ;
empty-elim (A : U l+) : Empty -> A = split { } ;

dne-case (P : U l) (nn : Not (Not P)) : Plus P (Not P) -> P = split {
 inl p -> p ; inr n -> efq (nn n) } ;
dne (P : U l) (prop : Pr.isProp P) (nn : Not (Not P)) : P = dne-case P nn (lem @l P prop) ;

module Resize (P : U l+) (prop : H.isProp P) {
 copy : Ring[l+].Plus P (Ring[l+].Not P) -> Quotient[l].Prop = split {
  inl p -> (Top,top-prop) ; inr n -> (Empty,Diaconescu[l].empty-prop) } ;
 small : Quotient[l].Prop = copy (lem @(l+) P prop) ;
 into-copy : (d : Ring[l+].Plus P (Ring[l+].Not P)) -> P -> (copy d).1 = split {
  inl p -> \ q -> tt ; inr n -> \ q -> Ring[l+].absurd Empty (n q) } ;
 out-copy : (d : Ring[l+].Plus P (Ring[l+].Not P)) -> (copy d).1 -> P = split {
  inl p -> \ t -> p ; inr n -> \ e -> empty-elim P e } ;
 into (p : P) : small.1 = into-copy (lem @(l+) P prop) p ;
 out (t : small.1) : P = out-copy (lem @(l+) P prop) t ;
} ;
