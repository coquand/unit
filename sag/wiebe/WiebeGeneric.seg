-- The generic change of b (ctete Theorem 11, step 2).
--
-- Statement (generic n): let Gr(L) >= n+1 mod J for L in D^(n+1), L_n+1 = d.
-- Then merely, along a good ring map h : D -> T (WiebeSequences.Good),
-- there is L' in T^(n+1) reached from h L by elementary operations
-- (WiebeChain.Chain), with L'_n+1 = h d, such that
--   L'_n, L'_n-1, ..., L'_1, h d is a regular sequence mod h J
-- (WiebeSequences.RS).  It is stated for every proposition P, as "the
-- conclusion implies P, hence P", so that no type of rings is truncated.
--
-- Proof, induction on n.  n = 0: Gr(d) >= 1 is d regular (TrueGradeThm9).
-- n + 1: write t = L_n+1 (below d) and Ls = L without t.  In D[X] let
--   f = t + X fs,  fs = Ls_n+1 + Ls_n X + ...  (TrueGradeThm9.Kron;
--   PolynomialRing.horner),
-- the Kronecker polynomial of (Ls, t) with constant term t.  Then
--   - f is in (L) and regular mod J (L is regular mod J, Gr >= 1);
--   - Gr(L) >= n+1 mod (J, f) (Theorem 9, after the base change to D[X]);
--   - t = f - X fs is in (J, f, Ls), so Gr(Ls) >= n+1 mod (J, f)
--     (WiebeSequences.TgrSub);
--   - replacing t by f is one elementary operation (fs = sum v_i Ls_i).
-- By induction (in D[X], mod (J, f), for Ls) a good T and Ls' reached from
-- Ls with Ls'_n, ..., h d regular mod (J, f).  Then L' = (Ls' with f
-- inserted below d) is reached from L (WiebeChain.lift), and
-- f, Ls'_n, ..., h d is regular mod J.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module RI = RegularIdeal[l] ; module RH = RingHom[l] ;
module TG = TrueGrade[l] ; module TT = TrueGradeTools[l] ; module TB = TrueGradeBase[l] ; module T9 = TrueGradeThm9[l] ;
module WS = WiebeSequences[l] ; module WC = WiebeChain[l] ;
module KX = KoszulExact[l] ;

-- what the change gives along h : D -> T
Out (D : TG.RD) (m : Nat) (J : Ps.Fin m -> D.1.R) (n : Nat) (L : Ps.Fin (suc n) -> D.1.R) (T : TG.RD) (h : RH.Hom D.1 T.1) : U l =
 (L' : Ps.Fin (suc n) -> T.1.R) * (k : Nat) * WC.Over[T.1,T.2].Chain (suc n) k (\ j -> h.1 (L j)) L' *
 Id T.1.R (L' (inr tt)) (h.1 (L (inr tt))) * WS.Over[T.1,T.2].RS m (\ i -> h.1 (J i)) n (\ i -> L' (inl i)) (L' (inr tt)) ;
Gen (n : Nat) : U l+ = (D : TG.RD) (m : Nat) (J : Ps.Fin m -> D.1.R) (L : Ps.Fin (suc n) -> D.1.R) -> TG.TGr (suc n) D m J (suc n) L ->
 (P : U l) -> Pr.isProp P -> ((T : TG.RD) (h : RH.Hom D.1 T.1) -> WS.Good D T h -> Out D m J n L T h -> P) -> P ;

-- Gr(I) >= k + 1 gives Gr(I) >= 1
tgr-one (D : TG.RD) (m : Nat) (J : Ps.Fin m -> D.1.R) (n : Nat) (I : Ps.Fin n -> D.1.R) : (k : Nat) -> TG.TGr (suc k) D m J n I -> TG.TGr (suc zero) D m J n I = split {
 zero -> \ g -> g ;
 suc k | r -> \ g -> r (TG.mono (suc k) D m J n I g) } ;

---------------------------------------------------------------------
-- n = 0
module GenBase (D : TG.RD) (m : Nat) (J : Ps.Fin m -> D.1.R) (L : Ps.Fin (suc zero) -> D.1.R) (g : TG.TGr (suc zero) D m J (suc zero) L) {
 regid : TG.RegId D m J (suc zero) L = T9.gr1-to D m J (suc zero) L g ;
 reg : TG.RegEl D m J (L (inr tt)) = \ x t k -> regid x tt
  (KX.plus-fn (Ps.Fin zero) Top (\ i -> TG.InI D m J (D.1.mul (L i) x)) (\ e -> efq e)
    (KX.top-fn (\ s -> TG.InI D m J (D.1.mul (L (inr s)) x)) k)) ;
 out : Out D m J zero L D (RH.identity D.1) = (L,zero,\ j -> refl (L j),refl (L (inr tt)),(reg,tt)) ;
} ;

---------------------------------------------------------------------
-- n + 1
module GenStep (n : Nat) (r : Gen n) (D : TG.RD) (m : Nat) (J : Ps.Fin m -> D.1.R) (L : Ps.Fin (suc (suc n)) -> D.1.R)
 (g : TG.TGr (suc (suc n)) D m J (suc (suc n)) L) {
 module K = T9.Kron[D] ;
 module WX = WiebeLists[l].Over[(TG.ext1 D).1,(TG.ext1 D).2] ;
 module WD = WiebeLists[l].Over[D.1,D.2] ;
 module CX = WC.Over[(TG.ext1 D).1,(TG.ext1 D).2] ;
 c (x : D.1.R) : (TG.ext1 D).1.R = K.c x ;
 t : D.1.R = L (inl (inr tt)) ;
 Ls : Ps.Fin (suc n) -> D.1.R = WC.del D.1.R n L ;
 I : Ps.Fin (suc (suc n)) -> D.1.R = TG.extend D (suc n) Ls t ;
 cJ : Ps.Fin m -> (TG.ext1 D).1.R = \ i -> c (J i) ;
 cL : Ps.Fin (suc (suc n)) -> (TG.ext1 D).1.R = \ i -> c (L i) ;
 cLs : Ps.Fin (suc n) -> (TG.ext1 D).1.R = \ i -> c (Ls i) ;
 f : (TG.ext1 D).1.R = K.f (suc (suc n)) I ;
 fs : (TG.ext1 D).1.R = K.f (suc n) Ls ;
 Xfs : (TG.ext1 D).1.R = (TG.ext1 D).1.mul K.X.variable fs ;
 -- f = t + X fs
 horner : Id (TG.ext1 D).1.R f ((TG.ext1 D).1.add (c t) Xfs) = K.X.horner t (K.PR.kron (suc n) Ls) ;
 fs-in : WX.In (suc n) cLs fs = K.f-in (suc n) Ls ;
 -- L, hence (Ls, t), is regular mod J
 regL : TG.RegId D m J (suc (suc n)) L = T9.gr1-to D m J (suc (suc n)) L (tgr-one D m J (suc (suc n)) L (suc n) g) ;
 module Perm (x : D.1.R) (k : (i : Ps.Fin (suc (suc n))) -> WD.In m J (D.1.mul (I i) x)) {
  low : (i : Ps.Fin (suc n)) -> WD.In m J (D.1.mul (L (inl i)) x) = split {
   inl j -> k (inl (inl j)) ;
   inr s -> subst (\ u -> WD.In m J (D.1.mul (L (inl (inr u))) x)) (MnSums[l].top-eq tt s) (k (inr tt)) } ;
  all : (j : Ps.Fin (suc (suc n))) -> WD.In m J (D.1.mul (L j) x) = split {
   inl i -> low i ;
   inr s -> k (inl (inr s)) } ;
 } ;
 regI : TG.RegId D m J (suc (suc n)) I = \ x u k -> regL x tt (Perm[x,k].all) ;
 f-reg : TG.RegEl (TG.ext1 D) m cJ f = K.f-reg m J (suc (suc n)) I regI ;
 -- f is in (L)
 module GL = WX.Gen[suc (suc n),cL] ;
 gens-low : (i : Ps.Fin (suc n)) -> WX.In (suc (suc n)) cL (c (I (inl i))) = split {
  inl j -> GL.G.generator (inl (inl j)) ;
  inr s -> GL.G.generator (inr s) } ;
 gens : (i : Ps.Fin (suc (suc n))) -> WX.In (suc (suc n)) cL (c (I i)) = split {
  inl i -> gens-low i ;
  inr s -> GL.G.generator (inl (inr tt)) } ;
 f-in : WX.In (suc (suc n)) cL f =
  WX.included (suc (suc n)) (\ i -> c (I i)) (suc (suc n)) cL gens f (K.f-in (suc (suc n)) I) ;
 -- Gr(L) >= n + 1 mod (J, f)
 J' : Ps.Fin (suc m) -> (TG.ext1 D).1.R = TG.extend (TG.ext1 D) m cJ f ;
 g2 : TG.TGr (suc n) (TG.ext1 D) (suc m) J' (suc (suc n)) cL =
  T9.thm9 (suc n) (TG.ext1 D) m cJ (suc (suc n)) cL f f-in f-reg (TB.base-change (suc (suc n)) D m J (suc (suc n)) L g) ;
 -- t is in (J, f, Ls), so Gr(Ls) >= n + 1 mod (J, f)
 Cat : Ps.Fin (plus (suc n) (suc m)) -> (TG.ext1 D).1.R = WX.cat (suc n) cLs (suc m) J' ;
 module GC = WX.Gen[plus (suc n) (suc m),Cat] ;
 f-cat : WX.In (plus (suc n) (suc m)) Cat f = WX.cat-in-J (suc n) cLs (suc m) J' f (WX.Gen[suc m,J'].G.generator (inr tt)) ;
 Xfs-cat : WX.In (plus (suc n) (suc m)) Cat Xfs = WX.cat-in-gen (suc n) cLs (suc m) J' Xfs (WX.Gen[suc n,cLs].G.ideal.in-mul K.X.variable fs fs-in) ;
 ct-cat : WX.In (plus (suc n) (suc m)) Cat (c t) =
  GC.GL.in-eq (WX.sub f Xfs) (c t) (trans (ap (\ u -> WX.sub u Xfs) horner) (RL[(TG.ext1 D).1].add-neg-cancel (c t) Xfs))
   (GC.GL.in-sub f Xfs f-cat Xfs-cat) ;
 hI-low : (i : Ps.Fin (suc n)) -> WX.In (plus (suc n) (suc m)) Cat (cL (inl i)) = split {
  inl j -> WX.cat-in-c (suc n) cLs (suc m) J' (inl j) ;
  inr s -> subst (\ u -> WX.In (plus (suc n) (suc m)) Cat (c (L (inl (inr u))))) (MnSums[l].top-eq tt s) ct-cat } ;
 hI : (i : Ps.Fin (suc (suc n))) -> WX.In (plus (suc n) (suc m)) Cat (cL i) = split {
  inl i -> hI-low i ;
  inr s -> WX.cat-in-c (suc n) cLs (suc m) J' (inr s) } ;
 g3 : TG.TGr (suc n) (TG.ext1 D) (suc m) J' (suc n) cLs = WS.TgrSub[TG.ext1 D,suc n,suc m,J',suc (suc n),cL,suc n,cLs,hI].result g2 ;

 -- replacing t by f is an elementary operation
 module WithV (v : FiniteIdeal[l].Sums[(TG.ext1 D).1].Coordinates (suc n) cLs fs) {
  w0 : Ps.Fin (suc (suc n)) -> (TG.ext1 D).1.R = WC.ins (TG.ext1 D).1.R n (\ i -> (TG.ext1 D).1.mul K.X.variable (v.1 i)) (TG.ext1 D).1.z ;
  L0 : Ps.Fin (suc (suc n)) -> (TG.ext1 D).1.R = WC.ins (TG.ext1 D).1.R n cLs (c t) ;
  L1 : Ps.Fin (suc (suc n)) -> (TG.ext1 D).1.R = WC.ins (TG.ext1 D).1.R n cLs f ;
  s0 : (TG.ext1 D).1.R = FiniteIdeal[l].Sums[(TG.ext1 D).1].lin (suc (suc n)) L0 w0 ;
  lin0 : Id (TG.ext1 D).1.R s0 Xfs =
   trans (CX.lin-ins n cLs (\ i -> (TG.ext1 D).1.mul K.X.variable (v.1 i)) (c t))
    (trans (FiniteIdeal[l].Sums[(TG.ext1 D).1].lin-scale (suc n) cLs v.1 K.X.variable) (ap ((TG.ext1 D).1.mul K.X.variable) v.2)) ;
  zero-term (y : (TG.ext1 D).1.R) : Id (TG.ext1 D).1.R y ((TG.ext1 D).1.add y ((TG.ext1 D).1.mul (TG.ext1 D).1.z s0)) =
   sym (trans (ap ((TG.ext1 D).1.add y) (RL[(TG.ext1 D).1].zero-mul s0)) ((TG.ext1 D).1.addZ y)) ;
  new-term : Id (TG.ext1 D).1.R f ((TG.ext1 D).1.add (c t) ((TG.ext1 D).1.mul (TG.ext1 D).1.o s0)) =
   trans horner (ap ((TG.ext1 D).1.add (c t)) (sym (trans (RL[(TG.ext1 D).1].one-left s0) lin0))) ;
  rel-low : (i : Ps.Fin (suc n)) -> Id (TG.ext1 D).1.R (L1 (inl i)) (CX.WM.eop (suc (suc n)) (inl (inr tt)) w0 L0 (inl i)) = split {
   inl j -> zero-term (cLs (inl j)) ;
   inr s -> new-term } ;
  rel : CX.WM.Rel (suc (suc n)) (inl (inr tt)) w0 L0 L1 = split {
   inl i -> rel-low i ;
   inr s -> zero-term (cLs (inr s)) } ;
  -- the conclusion, from that of the induction
  module Build (T : TG.RD) (h' : RH.Hom (TG.ext1 D).1 T.1) (good' : WS.Good (TG.ext1 D) T h') (out' : Out (TG.ext1 D) (suc m) J' n cLs T h') {
   module CT = WC.Over[T.1,T.2] ;
   H : RH.Hom D.1 T.1 = RH.compose D.1 (TG.ext1 D).1 T.1 h' TG.PolyX[D].X.inclusion ;
   good : WS.Good D T H = WS.good-compose D (TG.ext1 D) T TG.PolyX[D].X.inclusion h' (WS.good-incl D) good' ;
   L' : Ps.Fin (suc (suc n)) -> T.1.R = WC.ins T.1.R n out'.1 (h'.1 f) ;
   chain1 : CT.Chain (suc (suc n)) (suc zero) (\ j -> h'.1 (L0 j)) (\ j -> h'.1 (L1 j)) =
    WC.ChainMap[TG.ext1 D,T,h'].chain-map (suc (suc n)) (suc zero) L0 L1 (CX.one (suc (suc n)) (inl (inr tt)) w0 (refl (TG.ext1 D).1.z) L0 L1 rel) ;
   chain2 : CT.Chain (suc (suc n)) out'.2.1 (\ j -> h'.1 (L1 j)) L' =
    CT.chain-resp (suc (suc n)) out'.2.1 (WC.ins T.1.R n (\ i -> h'.1 (cLs i)) (h'.1 f)) (\ j -> h'.1 (L1 j)) L'
     (WC.ins-map (TG.ext1 D).1.R T.1.R h'.1 n cLs f) (CT.lift n (h'.1 f) out'.2.1 (\ i -> h'.1 (cLs i)) out'.1 out'.2.2.1) ;
   start (j : Ps.Fin (suc (suc n))) : Id T.1.R (H.1 (L j)) (h'.1 (L0 j)) =
    ap h'.1 (sym (trans (sym (WC.ins-map D.1.R (TG.ext1 D).1.R c n Ls t j)) (ap c (WC.ins-del D.1.R n L j)))) ;
   chain : CT.Chain (suc (suc n)) (plus (suc zero) out'.2.1) (\ j -> H.1 (L j)) L' =
    CT.chain-resp (suc (suc n)) (plus (suc zero) out'.2.1) (\ j -> h'.1 (L0 j)) (\ j -> H.1 (L j)) L' start
     (CT.concat (suc (suc n)) (suc zero) out'.2.1 (\ j -> h'.1 (L0 j)) (\ j -> h'.1 (L1 j)) L' chain1 chain2) ;
   rs : WS.Over[T.1,T.2].RS m (\ i -> H.1 (J i)) (suc n) (\ i -> L' (inl i)) (L' (inr tt)) =
    (good'.1 m cJ f f-reg,
     TT.regseq-list T (suc n) (suc m) (\ i -> h'.1 (J' i)) (TG.extend T m (\ i -> H.1 (J i)) (h'.1 f))
      (TT.map-snoc (Ps.Fin m) (TG.ext1 D).1.R T.1.R h'.1 cJ f) (WS.rot T.1.R n (\ i -> out'.1 (inl i)) (out'.1 (inr tt))) out'.2.2.2.2) ;
   out : Out D m J (suc n) L T H = (L',plus (suc zero) out'.2.1,chain,out'.2.2.2.1,rs) ;
  } ;
  result (P : U l) (pp : Pr.isProp P) (kk : (T : TG.RD) (h : RH.Hom D.1 T.1) -> WS.Good D T h -> Out D m J (suc n) L T h -> P) : P =
   r (TG.ext1 D) (suc m) J' cLs g3 P pp (\ T h' good' out' -> kk T Build[T,h',good',out'].H Build[T,h',good',out'].good Build[T,h',good',out'].out) ;
 } ;
 result (P : U l) (pp : Pr.isProp P) (kk : (T : TG.RD) (h : RH.Hom D.1 T.1) -> WS.Good D T h -> Out D m J (suc n) L T h -> P) : P =
  TC.rec (FiniteIdeal[l].Sums[(TG.ext1 D).1].Coordinates (suc n) cLs fs) @l P pp (\ v -> WithV[v].result P pp kk) fs-in ;
} ;

generic : (n : Nat) -> Gen n = split {
 zero -> \ D m J L g P pp kk -> kk D (RH.identity D.1) (WS.good-id D) GenBase[D,m,J,L,g].out ;
 suc n | r -> \ D m J L g P pp kk -> GenStep[n,r,D,m,J,L,g].result P pp kk } ;
