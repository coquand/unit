-- Lists of generators for Wiebe's theorem, relative to a list J.
--
-- (J, c) = cat n c m J is J followed by c_1, ..., c_n, the last generator
-- c_n outermost: cat (n+1) c J = ((J, c_1 .. c_n-1), c_n), so that
-- TrueGradeIdeals.Plus (x in (L, c) iff x - c w in L) splits off c_n.
--
-- (sub) If every generator of L1 is in (L2) then (L1) is in (L2): x is
--   a combination of the generators of L1.
-- (cat-in-J, cat-in-c) J and c are in (J, c).
-- (cat-ext) (J, y, c) and ((J, c), y) have the same elements: induction
--   on c, moving y past c_n by TrueGradeIdeals.swap-same.
-- (cat-split) x in (J, c) gives merely t in (c) with x - t in J: by Plus,
--   x - c_n w is in (J, c_1 .. c_n-1); by induction it is t' + (J), and
--   t = t' + c_n w.
-- (cat-map) a ring map h sends (J, c) to (h J, h c), pointwise.
-- (Cong) x = y mod (K): x - y in (K); the congruence laws.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module RI = RegularIdeal[l] ; module RH = RingHom[l] ; module TG = TrueGrade[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 D : TG.RD = (Rg,setR) ;
 open Rg ; module L = RL[Rg] ;
 module S = FiniteIdeal[l].Sums[Rg] ;
 module TI = TrueGradeIdeals[l].Over[Rg,setR] ;
 sub (x y : R) : R = TI.sub x y ;
 In (m : Nat) (K : Ps.Fin m -> R) (x : R) : U l = TI.In m K x ;
 in-prop (m : Nat) (K : Ps.Fin m -> R) (x : R) : Pr.isProp (In m K x) = TI.in-prop m K x ;
 module Gen (m : Nat) (K : Ps.Fin m -> R) {
  module G = RI.Generated[Rg,m,K] ;
  module GL = RI.IdealLaws[Rg,G.ideal] ;
 } ;

 ---------------------------------------------------------------------
 -- (J, c)
 cat : (n : Nat) -> (Ps.Fin n -> R) -> (m : Nat) -> (Ps.Fin m -> R) -> Ps.Fin (plus n m) -> R = split {
  zero -> \ c m J -> J ;
  suc n | r -> \ c m J -> TG.extend D (plus n m) (r (\ i -> c (inl i)) m J) (c (inr tt)) } ;
 cat-zero (c : Ps.Fin zero -> R) (m : Nat) (J : Ps.Fin m -> R) : Id (Ps.Fin m -> R) (cat zero c m J) J = refl J ;
 cat-suc (n : Nat) (c : Ps.Fin (suc n) -> R) (m : Nat) (J : Ps.Fin m -> R) :
  Id (Ps.Fin (suc (plus n m)) -> R) (cat (suc n) c m J) (TG.extend D (plus n m) (cat n (\ i -> c (inl i)) m J) (c (inr tt))) =
  refl (cat (suc n) c m J) ;

 ---------------------------------------------------------------------
 -- inclusion by generators
 module Incl (m1 : Nat) (L1 : Ps.Fin m1 -> R) (m2 : Nat) (L2 : Ps.Fin m2 -> R) (h : (i : Ps.Fin m1) -> In m2 L2 (L1 i)) {
  module I2 = Gen[m2,L2] ;
  terms (v : Ps.Fin m1 -> R) : In m2 L2 (S.lin m1 L1 v) =
   TI.in-sum m2 L2 m1 (\ i -> mul (L1 i) (v i)) (\ i ->
    I2.GL.in-eq (mul (v i) (L1 i)) (mul (L1 i) (v i)) (mulC (v i) (L1 i)) (I2.G.ideal.in-mul (v i) (L1 i) (h i))) ;
  result (x : R) (e : In m1 L1 x) : In m2 L2 x =
   TC.rec (S.Coordinates m1 L1 x) @l (In m2 L2 x) (in-prop m2 L2 x) (\ v -> I2.GL.in-eq (S.lin m1 L1 v.1) x v.2 (terms v.1)) e ;
 } ;
 included (m1 : Nat) (L1 : Ps.Fin m1 -> R) (m2 : Nat) (L2 : Ps.Fin m2 -> R) (h : (i : Ps.Fin m1) -> In m2 L2 (L1 i)) (x : R) (e : In m1 L1 x) :
  In m2 L2 x = Incl[m1,L1,m2,L2,h].result x e ;
 -- L is in (L, c)
 ext-in (m : Nat) (K : Ps.Fin m -> R) (c x : R) (e : In m K x) : In (suc m) (TG.extend D m K c) x =
  included m K (suc m) (TG.extend D m K c) (\ i -> Gen[suc m,TG.extend D m K c].G.generator (inl i)) x e ;
 cat-in-J : (n : Nat) (c : Ps.Fin n -> R) (m : Nat) (J : Ps.Fin m -> R) (x : R) -> In m J x -> In (plus n m) (cat n c m J) x = split {
  zero -> \ c m J x e -> e ;
  suc n | r -> \ c m J x e -> ext-in (plus n m) (cat n (\ i -> c (inl i)) m J) (c (inr tt)) x (r (\ i -> c (inl i)) m J x e) } ;
 cat-in-c : (n : Nat) (c : Ps.Fin n -> R) (m : Nat) (J : Ps.Fin m -> R) (i : Ps.Fin n) -> In (plus n m) (cat n c m J) (c i) = split {
  zero -> \ c m J i -> efq i ;
  suc n | r -> \ c m J -> split {
   inl i -> ext-in (plus n m) (cat n (\ j -> c (inl j)) m J) (c (inr tt)) (c (inl i)) (r (\ j -> c (inl j)) m J i) ;
   inr t -> subst (\ s -> In (suc (plus n m)) (cat (suc n) c m J) (c (inr s))) (MnSums[l].top-eq tt t)
    (Gen[suc (plus n m),cat (suc n) c m J].G.generator (inr tt)) } } ;
 -- a property of J and of c holds on (J, c)
 cat-all (P : R -> U l) : (n : Nat) (c : Ps.Fin n -> R) (m : Nat) (J : Ps.Fin m -> R)
  (hc : (i : Ps.Fin n) -> P (c i)) (hJ : (i : Ps.Fin m) -> P (J i)) (i : Ps.Fin (plus n m)) -> P (cat n c m J i) = split {
  zero -> \ c m J hc hJ -> hJ ;
  suc n | r -> \ c m J hc hJ -> split {
   inl i -> r (\ j -> c (inl j)) m J (\ j -> hc (inl j)) hJ i ;
   inr s -> hc (inr tt) } } ;
 -- (J, c) is in (L) when J and c are
 cat-gens : (n : Nat) (c : Ps.Fin n -> R) (m1 : Nat) (L1 : Ps.Fin m1 -> R) (m2 : Nat) (L2 : Ps.Fin m2 -> R)
  (hc : (i : Ps.Fin n) -> In m2 L2 (c i)) (hL : (i : Ps.Fin m1) -> In m2 L2 (L1 i)) (i : Ps.Fin (plus n m1)) -> In m2 L2 (cat n c m1 L1 i) = split {
  zero -> \ c m1 L1 m2 L2 hc hL -> hL ;
  suc n | r -> \ c m1 L1 m2 L2 hc hL -> split {
   inl i -> r (\ j -> c (inl j)) m1 L1 m2 L2 (\ j -> hc (inl j)) hL i ;
   inr s -> hc (inr tt) } } ;
 -- (c) is in (J, c)
 cat-in-gen (n : Nat) (c : Ps.Fin n -> R) (m : Nat) (J : Ps.Fin m -> R) (x : R) (e : In n c x) : In (plus n m) (cat n c m J) x =
  included n c (plus n m) (cat n c m J) (cat-in-c n c m J) x e ;

 ---------------------------------------------------------------------
 -- lists with the same elements
 same-refl (m : Nat) (K : Ps.Fin m -> R) : TI.Same m K m K = \ x -> (\ e -> e,\ e -> e) ;
 same-sym (m1 : Nat) (L1 : Ps.Fin m1 -> R) (m2 : Nat) (L2 : Ps.Fin m2 -> R) (h : TI.Same m1 L1 m2 L2) : TI.Same m2 L2 m1 L1 =
  \ x -> ((h x).2,(h x).1) ;
 same-trans (m1 : Nat) (L1 : Ps.Fin m1 -> R) (m2 : Nat) (L2 : Ps.Fin m2 -> R) (m3 : Nat) (L3 : Ps.Fin m3 -> R)
  (h : TI.Same m1 L1 m2 L2) (k : TI.Same m2 L2 m3 L3) : TI.Same m1 L1 m3 L3 =
  \ x -> (\ e -> (k x).1 ((h x).1 e),\ e -> (h x).2 ((k x).2 e)) ;
 -- by generators, both ways
 same-gen (m1 : Nat) (L1 : Ps.Fin m1 -> R) (m2 : Nat) (L2 : Ps.Fin m2 -> R)
  (h : (i : Ps.Fin m1) -> In m2 L2 (L1 i)) (k : (i : Ps.Fin m2) -> In m1 L1 (L2 i)) : TI.Same m1 L1 m2 L2 =
  \ x -> (included m1 L1 m2 L2 h x,included m2 L2 m1 L1 k x) ;
 -- (J, y, c) ~ ((J, c), y)
 cat-ext : (n : Nat) (c : Ps.Fin n -> R) (m : Nat) (J : Ps.Fin m -> R) (y : R) ->
  TI.Same (plus n (suc m)) (cat n c (suc m) (TG.extend D m J y)) (suc (plus n m)) (TG.extend D (plus n m) (cat n c m J) y) = split {
  zero -> \ c m J y -> same-refl (suc m) (TG.extend D m J y) ;
  suc n | r -> \ c m J y -> same-trans
   (suc (plus n (suc m))) (cat (suc n) c (suc m) (TG.extend D m J y))
   (suc (suc (plus n m))) (TG.extend D (suc (plus n m)) (TG.extend D (plus n m) (cat n (\ i -> c (inl i)) m J) y) (c (inr tt)))
   (suc (suc (plus n m))) (TG.extend D (suc (plus n m)) (cat (suc n) c m J) y)
   (TI.same-ext (plus n (suc m)) (cat n (\ i -> c (inl i)) (suc m) (TG.extend D m J y))
     (suc (plus n m)) (TG.extend D (plus n m) (cat n (\ i -> c (inl i)) m J) y) (r (\ i -> c (inl i)) m J y) (c (inr tt)))
   (TI.swap-same (plus n m) (cat n (\ i -> c (inl i)) m J) y (c (inr tt))) } ;

 ---------------------------------------------------------------------
 -- x in (J, c) is t + (J) with t in (c)
 Split (n : Nat) (c : Ps.Fin n -> R) (m : Nat) (J : Ps.Fin m -> R) (x : R) : U l = (t : R) * In n c t * In m J (sub x t) ;
 split-sub (x p q : R) : Id R (sub (sub x p) q) (sub x (add q p)) = calc R {
  add (add x (neg p)) (neg q) =< sym (addA x (neg p) (neg q)) > add x (add (neg p) (neg q))
   =< ap (add x) (addC (neg p) (neg q)) > add x (add (neg q) (neg p))
   =< ap (add x) (sym (L.neg-add q p)) > add x (neg (add q p)) } ;
 sub-zero (x : R) : Id R x (sub x z) = sym (trans (ap (add x) L.neg-zero) (addZ x)) ;
 module SplitStep (n : Nat) (c : Ps.Fin (suc n) -> R) (m : Nat) (J : Ps.Fin m -> R) (x w : R)
  (u : Split n (\ i -> c (inl i)) m J (sub x (mul (c (inr tt)) w))) {
  module IC = Gen[suc n,c] ;
  t : R = add u.1 (mul (c (inr tt)) w) ;
  t-in : In (suc n) c t = IC.G.ideal.in-add u.1 (mul (c (inr tt)) w)
   (ext-in n (\ i -> c (inl i)) (c (inr tt)) u.1 u.2.1)
   (IC.GL.in-eq (mul w (c (inr tt))) (mul (c (inr tt)) w) (mulC w (c (inr tt))) (IC.G.ideal.in-mul w (c (inr tt)) (IC.G.generator (inr tt)))) ;
  result : Split (suc n) c m J x = (t,t-in,subst (In m J) (split-sub x (mul (c (inr tt)) w) u.1) u.2.2) ;
 } ;
 cat-split : (n : Nat) (c : Ps.Fin n -> R) (m : Nat) (J : Ps.Fin m -> R) (x : R) -> In (plus n m) (cat n c m J) x ->
  Tr.Trunc[Split n c m J x].carrier = split {
  zero -> \ c m J x e -> Tr.Trunc[Split zero c m J x].inc (z,Gen[zero,c].G.ideal.in-zero,subst (In m J) (sub-zero x) e) ;
  suc n | r -> \ c m J x e -> TC.bind ((w : R) * In (plus n m) (cat n (\ i -> c (inl i)) m J) (sub x (mul (c (inr tt)) w)))
   (Split (suc n) c m J x) (\ v -> TC.map (Split n (\ i -> c (inl i)) m J (sub x (mul (c (inr tt)) v.1))) (Split (suc n) c m J x)
     (\ u -> SplitStep[n,c,m,J,x,v.1,u].result) (r (\ i -> c (inl i)) m J (sub x (mul (c (inr tt)) v.1)) v.2))
   (TI.Plus[plus n m,cat n (\ i -> c (inl i)) m J,c (inr tt)].from x e) } ;

 ---------------------------------------------------------------------
 -- x = y mod (K)
 Cong (m : Nat) (K : Ps.Fin m -> R) (x y : R) : U l = In m K (sub x y) ;
 module Mod (m : Nat) (K : Ps.Fin m -> R) {
  module I = Gen[m,K] ;
  in-sub (x y : R) (hx : In m K x) (hy : In m K y) : In m K (sub x y) = I.GL.in-sub x y hx hy ;
  of-eq (x y : R) (e : Id R x y) : Cong m K x y = I.GL.in-eq z (sub x y) (trans (sym (addN x)) (ap (\ t -> sub x t) e)) I.G.ideal.in-zero ;
  cong-refl (x : R) : Cong m K x x = of-eq x x (refl x) ;
  cong-sym (x y : R) (h : Cong m K x y) : Cong m K y x =
   I.GL.in-eq (neg (sub x y)) (sub y x) (trans (L.negsub x y) (addC (neg x) y)) (I.GL.in-neg (sub x y) h) ;
  diff (x y w : R) : Id R (add (sub x y) (sub y w)) (sub x w) = calc R {
   add (add x (neg y)) (add y (neg w)) =< sym (addA x (neg y) (add y (neg w))) > add x (add (neg y) (add y (neg w)))
    =< ap (add x) (addA (neg y) y (neg w)) > add x (add (add (neg y) y) (neg w))
    =< ap (\ t -> add x (add t (neg w))) (L.neg-cancel y) > add x (add z (neg w))
    =< ap (add x) (L.zl (neg w)) > add x (neg w) } ;
  cong-trans (x y w : R) (h : Cong m K x y) (k : Cong m K y w) : Cong m K x w =
   I.GL.in-eq (add (sub x y) (sub y w)) (sub x w) (diff x y w) (I.G.ideal.in-add (sub x y) (sub y w) h k) ;
  cong-eq (x y w : R) (h : Cong m K x y) (e : Id R y w) : Cong m K x w = cong-trans x y w h (of-eq y w e) ;
  eq-cong (x y w : R) (e : Id R x y) (h : Cong m K y w) : Cong m K x w = cong-trans x y w (of-eq x y e) h ;
  add-sub2 (x y u v : R) : Id R (add (sub x y) (sub u v)) (sub (add x u) (add y v)) = calc R {
   add (add x (neg y)) (add u (neg v)) =< L.swap x (neg y) u (neg v) > add (add x u) (add (neg y) (neg v))
    =< ap (add (add x u)) (sym (L.neg-add y v)) > add (add x u) (neg (add y v)) } ;
  cong-add (x y u v : R) (h : Cong m K x y) (k : Cong m K u v) : Cong m K (add x u) (add y v) =
   I.GL.in-eq (add (sub x y) (sub u v)) (sub (add x u) (add y v)) (add-sub2 x y u v) (I.G.ideal.in-add (sub x y) (sub u v) h k) ;
  mul-sub (c x y : R) : Id R (mul c (sub x y)) (sub (mul c x) (mul c y)) = trans (dist c x (neg y)) (ap (add (mul c x)) (L.mul-neg c y)) ;
  cong-mul (c x y : R) (h : Cong m K x y) : Cong m K (mul c x) (mul c y) =
   I.GL.in-eq (mul c (sub x y)) (sub (mul c x) (mul c y)) (mul-sub c x y) (I.G.ideal.in-mul c (sub x y) h) ;
  cong-mul-r (c x y : R) (h : Cong m K x y) : Cong m K (mul x c) (mul y c) =
   eq-cong (mul x c) (mul c x) (mul y c) (mulC x c) (cong-eq (mul c x) (mul c y) (mul y c) (cong-mul c x y h) (mulC c y)) ;
  cong-sum : (n : Nat) (u v : Ps.Fin n -> R) -> ((i : Ps.Fin n) -> Cong m K (u i) (v i)) -> Cong m K (S.sum n u) (S.sum n v) = split {
   zero -> \ u v h -> cong-refl z ;
   suc n | r -> \ u v h -> cong-add (u (inr tt)) (v (inr tt)) (S.sum n (\ i -> u (inl i))) (S.sum n (\ i -> v (inl i)))
    (h (inr tt)) (r (\ i -> u (inl i)) (\ i -> v (inl i)) (\ i -> h (inl i))) } ;
  -- In = congruent to 0
  to-zero (x : R) (h : In m K x) : Cong m K x z = I.GL.in-eq x (sub x z) (sub-zero x) h ;
  from-zero (x : R) (h : Cong m K x z) : In m K x = I.GL.in-eq (sub x z) x (sym (sub-zero x)) h ;
  -- y in (K) and x = y mod (K): x in (K)
  in-cong (x y : R) (h : Cong m K x y) (hy : In m K y) : In m K x =
   from-zero x (cong-trans x y z h (to-zero y hy)) ;
 } ;
  -- (y) = (y') gives (J, y) = (J, y')
 same-cat (n : Nat) (y y' : Ps.Fin n -> R) (m : Nat) (J : Ps.Fin m -> R) (h : TI.Same n y n y') :
  TI.Same (plus n m) (cat n y m J) (plus n m) (cat n y' m J) =
  same-gen (plus n m) (cat n y m J) (plus n m) (cat n y' m J)
   (cat-gens n y m J (plus n m) (cat n y' m J) (\ i -> cat-in-gen n y' m J (y i) ((h (y i)).1 (Gen[n,y].G.generator i)))
     (\ i -> cat-in-J n y' m J (J i) (Gen[m,J].G.generator i)))
   (cat-gens n y' m J (plus n m) (cat n y m J) (\ i -> cat-in-gen n y m J (y' i) ((h (y' i)).2 (Gen[n,y'].G.generator i)))
     (\ i -> cat-in-J n y m J (J i) (Gen[m,J].G.generator i))) ;
  -- mod J gives mod (J, c)
 cong-cat (n : Nat) (c : Ps.Fin n -> R) (m : Nat) (J : Ps.Fin m -> R) (x y : R) (h : Cong m J x y) : Cong (plus n m) (cat n c m J) x y =
  cat-in-J n c m J (sub x y) h ;
} ;

-- a ring map sends (J, c) to (h J, h c)
cat-map (S S' : TG.RD) (h : RH.Hom S.1 S'.1) : (n : Nat) (c : Ps.Fin n -> S.1.R) (m : Nat) (J : Ps.Fin m -> S.1.R) (i : Ps.Fin (plus n m)) ->
 Id S'.1.R (h.1 (Over[S.1,S.2].cat n c m J i)) (Over[S'.1,S'.2].cat n (\ j -> h.1 (c j)) m (\ j -> h.1 (J j)) i) = split {
 zero -> \ c m J i -> refl (h.1 (J i)) ;
 suc n | r -> \ c m J -> split {
  inl i -> r (\ j -> c (inl j)) m J i ;
  inr t -> refl (h.1 (c (inr tt))) } } ;
