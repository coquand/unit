-- Matrices for Wiebe's theorem (ctete Theorem 11, steps 1 and 4).
--
-- (b) = (a) V is written b = V a mod J (Hyp): b_j = sum_i a_i V_ij mod J,
-- with V a list of columns as in exterior/Determinant (act).
--
-- Elementary operations.  For r and w with w_r = 0, eop r w L adds
-- sum_l w_l L_l to L_r: eop r w L = E L with E = I + e_r w^T (emat).
--   det E = 1: the transpose of E is the identity with column r replaced
--   by e_r + w, and det of that is the coefficient (e_r + w)_r = 1
--   (Adjugate: b |-> det I[r <- b] is linear and det I[r <- e_k] = delta_kr).
--   eop r (-w) undoes eop r w, since sum_l w_l (eop r w L)_l = sum_l w_l L_l.
-- On b (BOp): b' = E b gives b' = (E V) a, det (E V) = det V.
-- On a (AOp): a' = E a gives b = V a = (V E') a' with E' = E^-1 = eop r (-w),
--   det (V E') = det V.
-- Along a ring map h (Map): h b = (h V)(h a) mod h J, det (h V) = h (det V)
--   (exterior/Naturality).
--
-- Cramer (step 4): adj(V) V = det V . I (exterior/Adjugate) gives
--   det V . a = adj(V) (V a) = adj(V) b mod J; at the last index,
--   det V . a_n = sum_j b_j adj(V)_jn = b_n adj(V)_nn mod (J, b_1 .. b_n-1).
-- adj(V)_nn = det V[n <- e_n] = det W, W the top left block (block): in
--   Ext(n) = Ext(n-1) x Ext(n-1) the product of the first n-1 columns
--   times e_n = (0, 1) has second component the first component of that
--   product, which is the product of the columns of W (first-prod).
-- Restricting b = V a mod J to the first n-1 rows gives
--   b_<n = W a_<n mod (J, a_n) (Hyp.block).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module RH = RingHom[l] ; module TG = TrueGrade[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ; module L = RL[Rg] ;
 module S = FiniteIdeal[l].Sums[Rg] ;
 module D = MnSums[l].Over[Rg] ;
 module AL = Alternating[l].Over[Rg,setR] ;
 module EA = ExteriorAlgebra[l].Over[Rg,setR] ;
 module DT = Determinant[l].Over[Rg,setR] ;
 module ADJ = Adjugate[l].Over[Rg,setR] ;
 module TP = ExteriorTranspose[l].Over[Rg,setR] ;
 module DK = DeterminantTrick[l].Over[Rg,setR] ;
 module WL = WiebeLists[l].Over[Rg,setR] ;
 open ExteriorModel[l].Over[Rg] ;

 ---------------------------------------------------------------------
 -- b = V a mod J
 Hyp (m : Nat) (J : Ps.Fin m -> R) (n : Nat) (a b : AL.Vec n) (V : DT.Mat n) : U l =
  (j : Ps.Fin n) -> WL.Cong m J (b j) (DT.act n V a j) ;

 ---------------------------------------------------------------------
 -- elementary operations
 eop (n : Nat) (r : Ps.Fin n) (w y : AL.Vec n) (j : Ps.Fin n) : R = add (y j) (mul (D.delta n r j) (S.lin n y w)) ;
 Rel (n : Nat) (r : Ps.Fin n) (w y y' : AL.Vec n) : U l = (j : Ps.Fin n) -> Id R (y' j) (eop n r w y j) ;
 emat (n : Nat) (r : Ps.Fin n) (w : AL.Vec n) : DT.Mat n = \ l j -> add (D.delta n l j) (mul (D.delta n r j) (w l)) ;
 negv (n : Nat) (w : AL.Vec n) : AL.Vec n = \ l -> neg (w l) ;
 -- E v = eop r w v
 act-emat (n : Nat) (r : Ps.Fin n) (w v : AL.Vec n) (j : Ps.Fin n) : Id R (DT.act n (emat n r w) v j) (eop n r w v j) = calc R {
  S.sum n (\ l -> mul (v l) (add (D.delta n l j) (mul (D.delta n r j) (w l))))
   =< S.sum-cong n (\ l -> mul (v l) (add (D.delta n l j) (mul (D.delta n r j) (w l))))
       (\ l -> add (mul (v l) (D.delta n l j)) (mul (D.delta n r j) (mul (v l) (w l))))
       (\ l -> trans (dist (v l) (D.delta n l j) (mul (D.delta n r j) (w l))) (ap (add (mul (v l) (D.delta n l j))) (L.mul-swap (v l) (D.delta n r j) (w l)))) >
  S.sum n (\ l -> add (mul (v l) (D.delta n l j)) (mul (D.delta n r j) (mul (v l) (w l))))
   =< S.sum-add n (\ l -> mul (v l) (D.delta n l j)) (\ l -> mul (D.delta n r j) (mul (v l) (w l))) >
  add (S.sum n (\ l -> mul (v l) (D.delta n l j))) (S.sum n (\ l -> mul (D.delta n r j) (mul (v l) (w l))))
   =< Ps.cong2 R add _ _ _ _ (D.sum-delta-right n j v) (S.sum-scale (D.delta n r j) n (\ l -> mul (v l) (w l))) >
  add (v j) (mul (D.delta n r j) (S.lin n v w)) } ;
 -- the transpose of E is I[r <- e_r + w]
 erow (n : Nat) (r : Ps.Fin n) (w : AL.Vec n) : AL.Vec n = \ l -> add (D.delta n r l) (w l) ;
 col-at (n : Nat) (r : Ps.Fin n) (w : AL.Vec n) : Id (AL.Vec n) (TP.transpose n (emat n r w) r) (ADJ.repl n n (DT.idm n) r (erow n r w) r) =
  trans (F.funext (Ps.Fin n) (\ l -> R) (TP.transpose n (emat n r w) r) (erow n r w)
          (\ l -> trans (TP.transpose-value n (emat n r w) r l)
                   (Ps.cong2 R add _ _ _ _ (D.delta-sym n l r) (trans (ap (\ t -> mul t (w l)) (D.delta-diag n r)) (L.one-left (w l))))))
   (sym (ADJ.repl-at n n (DT.idm n) r (erow n r w))) ;
 col-off (n : Nat) (r : Ps.Fin n) (w : AL.Vec n) (j : Ps.Fin n) (ne : Not (Id (Ps.Fin n) j r)) :
  Id (AL.Vec n) (TP.transpose n (emat n r w) j) (ADJ.repl n n (DT.idm n) r (erow n r w) j) =
  trans (F.funext (Ps.Fin n) (\ l -> R) (TP.transpose n (emat n r w) j) (D.delta n j)
          (\ l -> trans (TP.transpose-value n (emat n r w) j l) (trans (ap (\ t -> add (D.delta n l j) (mul t (w l))) (D.delta-off n r j (\ q -> ne (sym q))))
                   (trans (ap (add (D.delta n l j)) (L.zero-mul (w l))) (trans (addZ (D.delta n l j)) (D.delta-sym n l j))))))
   (sym (ADJ.repl-off n n (DT.idm n) r (erow n r w) j ne)) ;
 col (n : Nat) (r : Ps.Fin n) (w : AL.Vec n) (j : Ps.Fin n) :
  ADJ.Dec n j r -> Id (AL.Vec n) (TP.transpose n (emat n r w) j) (ADJ.repl n n (DT.idm n) r (erow n r w) j) = split {
  inl p -> subst (\ k -> Id (AL.Vec n) (TP.transpose n (emat n r w) k) (ADJ.repl n n (DT.idm n) r (erow n r w) k)) (sym p) (col-at n r w) ;
  inr ne -> col-off n r w j ne } ;
 -- det I[r <- e_k] = delta_kr
 colform-e (n : Nat) (r k : Ps.Fin n) : Id R (ADJ.colform n (DT.idm n) r (D.delta n k)) (D.delta n k r) =
  trans (sym (ADJ.adj-entry n (DT.idm n) k r))
   (trans (ADJ.adj-mul n (DT.idm n) k r) (trans (ap (\ t -> mul t (D.delta n k r)) (DT.det-id n)) (L.one-left (D.delta n k r)))) ;
 det-emat (n : Nat) (r : Ps.Fin n) (w : AL.Vec n) (wr : Id R (w r) z) : Id R (det n (emat n r w)) o = calc R {
  det n (emat n r w)
   =< TP.det-transpose n (emat n r w) > det n (TP.transpose n (emat n r w))
   =< ap (det n) (F.funext (Ps.Fin n) (\ j -> AL.Vec n) (TP.transpose n (emat n r w)) (ADJ.repl n n (DT.idm n) r (erow n r w))
        (\ j -> col n r w j (ADJ.dec-fin n j r))) >
  ADJ.colform n (DT.idm n) r (erow n r w)
   =< ADJ.form-expand n (ADJ.colform n (DT.idm n) r) (ADJ.colform-lin n (DT.idm n) r) (erow n r w) >
  S.sum n (\ k -> mul (erow n r w k) (ADJ.colform n (DT.idm n) r (D.delta n k)))
   =< S.sum-cong n (\ k -> mul (erow n r w k) (ADJ.colform n (DT.idm n) r (D.delta n k))) (\ k -> mul (erow n r w k) (D.delta n k r))
       (\ k -> ap (mul (erow n r w k)) (colform-e n r k)) >
  S.sum n (\ k -> mul (erow n r w k) (D.delta n k r))
   =< D.sum-delta-right n r (erow n r w) > add (D.delta n r r) (w r)
   =< Ps.cong2 R add _ _ _ _ (D.delta-diag n r) wr > add o z
   =< addZ o > o } ;
 -- sum_l u_l (eop r w y)_l = sum_l u_l L_l + (sum_l w_l L_l) u_r
 lin-eop (n : Nat) (r : Ps.Fin n) (w y u : AL.Vec n) :
  Id R (S.lin n (eop n r w y) u) (add (S.lin n y u) (mul (S.lin n y w) (u r))) = calc R {
  S.sum n (\ l -> mul (eop n r w y l) (u l))
   =< S.sum-cong n (\ l -> mul (eop n r w y l) (u l)) (\ l -> add (mul (y l) (u l)) (mul (S.lin n y w) (mul (D.delta n r l) (u l))))
       (\ l -> trans (L.dist-left (y l) (mul (D.delta n r l) (S.lin n y w)) (u l))
                (ap (add (mul (y l) (u l))) (trans (ap (\ t -> mul t (u l)) (mulC (D.delta n r l) (S.lin n y w)))
                                                 (sym (mulA (S.lin n y w) (D.delta n r l) (u l)))))) >
  S.sum n (\ l -> add (mul (y l) (u l)) (mul (S.lin n y w) (mul (D.delta n r l) (u l))))
   =< S.sum-add n (\ l -> mul (y l) (u l)) (\ l -> mul (S.lin n y w) (mul (D.delta n r l) (u l))) >
  add (S.lin n y u) (S.sum n (\ l -> mul (S.lin n y w) (mul (D.delta n r l) (u l))))
   =< ap (add (S.lin n y u)) (trans (S.sum-scale (S.lin n y w) n (\ l -> mul (D.delta n r l) (u l)))
                               (ap (mul (S.lin n y w)) (D.sum-delta n r u))) >
  add (S.lin n y u) (mul (S.lin n y w) (u r)) } ;
 eop-cong (n : Nat) (r : Ps.Fin n) (w y y' : AL.Vec n) (e : (l : Ps.Fin n) -> Id R (y l) (y' l)) (j : Ps.Fin n) :
  Id R (eop n r w y j) (eop n r w y' j) =
  Ps.cong2 R add _ _ _ _ (e j) (ap (mul (D.delta n r j)) (S.sum-cong n (\ l -> mul (y l) (w l)) (\ l -> mul (y' l) (w l)) (\ l -> ap (\ t -> mul t (w l)) (e l)))) ;
 -- eop r (-w) undoes eop r w
 eop-inv (n : Nat) (r : Ps.Fin n) (w : AL.Vec n) (wr : Id R (w r) z) (y : AL.Vec n) (j : Ps.Fin n) :
  Id R (eop n r (negv n w) (eop n r w y) j) (y j) =
  let { s : R = S.lin n y w ; d : R = D.delta n r j ;
        lin-neg : Id R (S.lin n (eop n r w y) (negv n w)) (neg s) = calc R {
         S.lin n (eop n r w y) (negv n w)
          =< lin-eop n r w y (negv n w) > add (S.lin n y (negv n w)) (mul s (neg (w r)))
          =< Ps.cong2 R add _ _ _ _ (S.lin-neg n y w) (trans (ap (\ t -> mul s (neg t)) wr) (trans (ap (mul s) L.neg-zero) (L.mul-zero s))) >
         add (neg s) z =< addZ (neg s) > neg s } ; } in calc R {
  add (eop n r w y j) (mul d (S.lin n (eop n r w y) (negv n w)))
   =< ap (\ t -> add (eop n r w y j) (mul d t)) lin-neg > add (add (y j) (mul d s)) (mul d (neg s))
   =< sym (addA (y j) (mul d s) (mul d (neg s))) > add (y j) (add (mul d s) (mul d (neg s)))
   =< ap (add (y j)) (trans (sym (dist d s (neg s))) (trans (ap (mul d) (addN s)) (L.mul-zero d))) > add (y j) z
   =< addZ (y j) > y j } ;
 -- the operation stays in the ideal, both ways
 lin-in (n : Nat) (y w : AL.Vec n) : WL.In n y (S.lin n y w) = Tr.Trunc[S.Coordinates n y (S.lin n y w)].inc (w,refl (S.lin n y w)) ;
 eop-in (n : Nat) (r : Ps.Fin n) (w y : AL.Vec n) (j : Ps.Fin n) : WL.In n y (eop n r w y j) =
  WL.Gen[n,y].G.ideal.in-add (y j) (mul (D.delta n r j) (S.lin n y w)) (WL.Gen[n,y].G.generator j)
   (WL.Gen[n,y].G.ideal.in-mul (D.delta n r j) (S.lin n y w) (lin-in n y w)) ;
 rel-same (n : Nat) (r : Ps.Fin n) (w : AL.Vec n) (wr : Id R (w r) z) (y y' : AL.Vec n) (e : Rel n r w y y') : WL.TI.Same n y n y' =
  WL.same-gen n y n y' (\ j -> subst (WL.In n y') (trans (eop-cong n r (negv n w) y' (eop n r w y) e j) (eop-inv n r w wr y j)) (eop-in n r (negv n w) y' j))
   (\ j -> subst (WL.In n y) (sym (e j)) (eop-in n r w y j)) ;
 -- an operation keeps congruences mod J
 eop-mod (m : Nat) (J : Ps.Fin m -> R) (n : Nat) (r : Ps.Fin n) (w x y : AL.Vec n) (h : (l : Ps.Fin n) -> WL.Cong m J (x l) (y l)) (j : Ps.Fin n) :
  WL.Cong m J (eop n r w x j) (eop n r w y j) =
  WL.Mod[m,J].cong-add (x j) (y j) (mul (D.delta n r j) (S.lin n x w)) (mul (D.delta n r j) (S.lin n y w)) (h j)
   (WL.Mod[m,J].cong-mul (D.delta n r j) (S.lin n x w) (S.lin n y w)
     (WL.Mod[m,J].cong-sum n (\ l -> mul (x l) (w l)) (\ l -> mul (y l) (w l)) (\ l -> WL.Mod[m,J].cong-mul-r (w l) (x l) (y l) (h l)))) ;

 -- an operation on b
 module BOp (m : Nat) (J : Ps.Fin m -> R) (n : Nat) (a b : AL.Vec n) (V : DT.Mat n) (h : Hyp m J n a b V)
  (r : Ps.Fin n) (w : AL.Vec n) (wr : Id R (w r) z) (b' : AL.Vec n) (e : Rel n r w b b') {
  V' : DT.Mat n = DT.mmul n (emat n r w) V ;
  hyp : Hyp m J n a b' V' = \ j ->
   WL.Mod[m,J].eq-cong (b' j) (eop n r w b j) (DT.act n V' a j) (e j)
    (WL.Mod[m,J].cong-eq (eop n r w b j) (eop n r w (DT.act n V a) j) (DT.act n V' a j) (eop-mod m J n r w b (DT.act n V a) h j)
      (sym (trans (DK.act-mmul n (emat n r w) V a j) (act-emat n r w (DT.act n V a) j)))) ;
  det-eq : Id R (det n V') (det n V) =
   trans (DT.det-mul n (emat n r w) V) (trans (ap (\ t -> mul t (det n V)) (det-emat n r w wr)) (L.one-left (det n V))) ;
 } ;
 -- an operation on a
 module AOp (m : Nat) (J : Ps.Fin m -> R) (n : Nat) (a b : AL.Vec n) (V : DT.Mat n) (h : Hyp m J n a b V)
  (r : Ps.Fin n) (w : AL.Vec n) (wr : Id R (w r) z) (a' : AL.Vec n) (e : Rel n r w a a') {
  E' : DT.Mat n = emat n r (negv n w) ;
  V' : DT.Mat n = DT.mmul n V E' ;
  back (l : Ps.Fin n) : Id R (DT.act n E' a' l) (a l) =
   trans (act-emat n r (negv n w) a' l) (trans (eop-cong n r (negv n w) a' (eop n r w a) e l) (eop-inv n r w wr a l)) ;
  act-eq (j : Ps.Fin n) : Id R (DT.act n V' a' j) (DT.act n V a j) =
   trans (DK.act-mmul n V E' a' j) (S.sum-cong n (\ i -> mul (DT.act n E' a' i) (V i j)) (\ i -> mul (a i) (V i j)) (\ i -> ap (\ t -> mul t (V i j)) (back i))) ;
  hyp : Hyp m J n a' b V' = \ j -> WL.Mod[m,J].cong-eq (b j) (DT.act n V a j) (DT.act n V' a' j) (h j) (sym (act-eq j)) ;
  nwr : Id R (negv n w r) z = trans (ap neg wr) L.neg-zero ;
  det-eq : Id R (det n V') (det n V) =
   trans (DT.det-mul n V E') (trans (ap (mul (det n V)) (det-emat n r (negv n w) nwr)) (mulO (det n V))) ;
 } ;

 ---------------------------------------------------------------------
 -- step 4: Cramer at the last index
 -- the first components of a product
 first-prod (n : Nat) : (k : Nat) (u : Ps.Fin k -> Ext (suc n)) -> Id (Ext n) (eprod (suc n) k u).1 (eprod n k (\ i -> (u i).1)) = split {
  zero -> \ u -> refl (eone n) ;
  suc k | r -> \ u -> ap (\ x -> emul n x (u (inr tt)).1) (r (\ i -> u (inl i))) } ;
 emb-zero : (n : Nat) -> Id (Ext n) (emb n z) (ezero n) = split {
  zero -> refl z ;
  suc n | r -> ap (\ x -> (x,ezero n)) r } ;
 gen-zero : (n : Nat) -> Id (Ext n) (gen n (\ k -> z)) (ezero n) = split {
  zero -> refl z ;
  suc n | r -> ExteriorAlgebra[l].pair-eq r (emb-zero n) } ;
 -- adj(V)_nn = det V[n <- e_n] = det W
 Block (n : Nat) (V : DT.Mat (suc n)) : DT.Mat n = \ i j -> V (inl i) (inl j) ;
 module BlockDet (n : Nat) (V : DT.Mat (suc n)) {
  P : Ext (suc n) = eprod (suc n) n (\ k -> gen (suc n) (V (inl k))) ;
  result : Id R (ADJ.adj (suc n) V (inr tt) (inr tt)) (det n (Block n V)) = calc R {
   top n (eadd n (emul n P.1 (emb n o)) (emul n P.2 (alpha n (gen n (\ k -> z)))))
    =< ap (\ x -> top n (eadd n (emul n P.1 (emb n o)) (emul n P.2 (alpha n x)))) (gen-zero n) >
   top n (eadd n (emul n P.1 (emb n o)) (emul n P.2 (alpha n (ezero n))))
    =< ap (\ x -> top n (eadd n (emul n P.1 (emb n o)) (emul n P.2 x))) (EA.alpha-zero n) >
   top n (eadd n (emul n P.1 (emb n o)) (emul n P.2 (ezero n)))
    =< ap (\ x -> top n (eadd n (emul n P.1 (emb n o)) x)) (EA.mul-zero-r n P.2) >
   top n (eadd n (emul n P.1 (emb n o)) (ezero n))
    =< ap (top n) (trans (EA.eaddZ n (emul n P.1 (emb n o))) (EA.one-right n P.1)) > top n P.1
    =< ap (top n) (first-prod n n (\ k -> gen (suc n) (V (inl k)))) > det n (Block n V) } ;
 } ;
 module Cramer (m : Nat) (J : Ps.Fin m -> R) (n : Nat) (a b : AL.Vec (suc n)) (V : DT.Mat (suc n)) (h : Hyp m J (suc n) a b V) {
  X : DT.Mat (suc n) = ADJ.adj (suc n) V ;
  module MJ = WL.Mod[m,J] ;
  module MC = WL.Mod[plus n m,WL.cat n (\ i -> b (inl i)) m J] ;
  -- det V . a = adj(V) (V a)
  delta-a (k : Ps.Fin (suc n)) : Id R (mul (det (suc n) V) (a k)) (DT.act (suc n) X (DT.act (suc n) V a) k) =
   sym (trans (sym (DK.act-mmul (suc n) X V a k))
         (trans (ap (\ N -> DT.act (suc n) N a k) (ADJ.adj-mul-mat (suc n) V)) (DK.act-scalar (suc n) (det (suc n) V) a k))) ;
  -- = adj(V) b mod J
  mod-J (k : Ps.Fin (suc n)) : WL.Cong m J (mul (det (suc n) V) (a k)) (DT.act (suc n) X b k) =
   MJ.eq-cong (mul (det (suc n) V) (a k)) (DT.act (suc n) X (DT.act (suc n) V a) k) (DT.act (suc n) X b k) (delta-a k)
    (MJ.cong-sum (suc n) (\ j -> mul (DT.act (suc n) V a j) (X j k)) (\ j -> mul (b j) (X j k))
      (\ j -> MJ.cong-mul-r (X j k) (DT.act (suc n) V a j) (b j) (MJ.cong-sym (b j) (DT.act (suc n) V a j) (h j)))) ;
  -- adj(V) b = b_n adj(V)_nn mod (J, b_<n)
  rest : R = S.sum n (\ j -> mul (b (inl j)) (X (inl j) (inr tt))) ;
  rest-in : WL.In (plus n m) (WL.cat n (\ i -> b (inl i)) m J) rest =
   WL.cat-in-gen n (\ i -> b (inl i)) m J rest (lin-in n (\ i -> b (inl i)) (\ j -> X (inl j) (inr tt))) ;
  last : WL.Cong (plus n m) (WL.cat n (\ i -> b (inl i)) m J) (DT.act (suc n) X b (inr tt)) (mul (b (inr tt)) (X (inr tt) (inr tt))) =
   MC.cong-eq (add (mul (b (inr tt)) (X (inr tt) (inr tt))) rest) (add (mul (b (inr tt)) (X (inr tt) (inr tt))) z)
    (mul (b (inr tt)) (X (inr tt) (inr tt)))
    (MC.cong-add (mul (b (inr tt)) (X (inr tt) (inr tt))) (mul (b (inr tt)) (X (inr tt) (inr tt))) rest z
      (MC.cong-refl (mul (b (inr tt)) (X (inr tt) (inr tt)))) (MC.to-zero rest rest-in))
    (addZ (mul (b (inr tt)) (X (inr tt) (inr tt)))) ;
  -- det V . a_n = det W . b_n mod (J, b_<n)
  result : WL.Cong (plus n m) (WL.cat n (\ i -> b (inl i)) m J) (mul (det (suc n) V) (a (inr tt))) (mul (det n (Block n V)) (b (inr tt))) =
   MC.cong-trans (mul (det (suc n) V) (a (inr tt))) (DT.act (suc n) X b (inr tt)) (mul (det n (Block n V)) (b (inr tt)))
    (WL.cong-cat n (\ i -> b (inl i)) m J (mul (det (suc n) V) (a (inr tt))) (DT.act (suc n) X b (inr tt)) (mod-J (inr tt)))
    (MC.cong-eq (DT.act (suc n) X b (inr tt)) (mul (b (inr tt)) (X (inr tt) (inr tt))) (mul (det n (Block n V)) (b (inr tt))) last
      (trans (mulC (b (inr tt)) (X (inr tt) (inr tt))) (ap (\ t -> mul t (b (inr tt))) BlockDet[n,V].result))) ;
 } ;
 -- b_<n = W a_<n mod (J, a_n)
 module HypBlock (m : Nat) (J : Ps.Fin m -> R) (n : Nat) (a b : AL.Vec (suc n)) (V : DT.Mat (suc n)) (h : Hyp m J (suc n) a b V) {
  K : Ps.Fin (suc m) -> R = TG.extend (Rg,setR) m J (a (inr tt)) ;
  module MK = WL.Mod[suc m,K] ;
  module GK = WL.Gen[suc m,K] ;
  low (j : Ps.Fin n) : R = DT.act n (Block n V) (\ i -> a (inl i)) j ;
  t (j : Ps.Fin n) : R = mul (a (inr tt)) (V (inr tt) (inl j)) ;
  t-in (j : Ps.Fin n) : WL.In (suc m) K (t j) =
   GK.GL.in-eq (mul (V (inr tt) (inl j)) (a (inr tt))) (t j) (mulC (V (inr tt) (inl j)) (a (inr tt)))
    (GK.G.ideal.in-mul (V (inr tt) (inl j)) (a (inr tt)) (GK.G.generator (inr tt))) ;
  -- (V a)_j = a_n V_nj + (W a_<n)_j
  row (j : Ps.Fin n) : WL.Cong (suc m) K (DT.act (suc n) V a (inl j)) (low j) =
   MK.cong-eq (add (t j) (low j)) (add z (low j)) (low j)
    (MK.cong-add (t j) z (low j) (low j) (MK.to-zero (t j) (t-in j)) (MK.cong-refl (low j))) (L.zl (low j)) ;
  result : Hyp (suc m) K n (\ i -> a (inl i)) (\ i -> b (inl i)) (Block n V) = \ j ->
   MK.cong-trans (b (inl j)) (DT.act (suc n) V a (inl j)) (low j)
    (WL.ext-in m J (a (inr tt)) (WL.sub (b (inl j)) (DT.act (suc n) V a (inl j))) (h (inl j))) (row j) ;
 } ;
} ;
