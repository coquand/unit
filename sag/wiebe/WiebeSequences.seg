-- Regular sequences and ring maps for Wiebe's theorem.
--
-- (rot) For c in R^n and d, rot c d is the sequence c_n, c_n-1, ..., c_1, d
--   in the layout of TrueGrade.RegSeq (first term on top).  A regular
--   sequence rot c d mod J has
--   (rs-last) d regular mod (J, c): induction on n, (J, c_n, c_<n) and
--     (J, c) having the same elements (WiebeLists.cat-ext);
--   (replace-last) its last term replaceable by any y regular mod (J, c);
--   (rot-in) its terms in (c, d), so it witnesses Gr(c, d) >= n+1 (tgr-rot).
-- (regseq-cong) A regular sequence mod L stays one when each term is
--   changed mod L: s_1 x in L iff t_1 x in L, and (L, s_1), (L, t_1) have
--   the same elements.
-- (tgr-sub) If every I_i is in (J, I') then Gr(I) >= k mod J gives
--   Gr(I') >= k mod J: a term s of a sequence in I is t + (J) with t in
--   (I') (WiebeLists.cat-split, in ext p D, with finite choice), and the
--   t form a regular sequence mod J (regseq-cong).
-- (Good) A ring map D -> T that keeps regularity mod lists
--   (TrueGradeBase.Preserves) and has a retraction: then a membership of
--   images comes back to D (down).  Identity, composites, and the constants
--   D -> D[X] (retraction: evaluation at 0) are good.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module RI = RegularIdeal[l] ; module RH = RingHom[l] ;
module TG = TrueGrade[l] ; module TT = TrueGradeTools[l] ; module TB = TrueGradeBase[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module KX = KoszulExact[l] ;

---------------------------------------------------------------------
-- c_n, ..., c_1, d
rot (A : U l) : (n : Nat) -> (Ps.Fin n -> A) -> A -> Ps.Fin (suc n) -> A = split {
 zero -> \ c d i -> d ;
 suc n | r -> \ c d -> Ps.snoc (Ps.Fin (suc n)) A (r (\ i -> c (inl i)) d) (c (inr tt)) } ;
rot-map (A B : U l) (f : A -> B) : (n : Nat) (c : Ps.Fin n -> A) (d : A) (i : Ps.Fin (suc n)) ->
 Id B (f (rot A n c d i)) (rot B n (\ j -> f (c j)) (f d) i) = split {
 zero -> \ c d i -> refl (f d) ;
 suc n | r -> \ c d -> split {
  inl i -> r (\ j -> c (inl j)) d i ;
  inr s -> refl (f (c (inr tt))) } } ;

module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 D : TG.RD = (Rg,setR) ;
 open Rg ; module L = RL[Rg] ;
 module WL = WiebeLists[l].Over[Rg,setR] ;
 module TI = WL.TI ;
 RS (m : Nat) (J : Ps.Fin m -> R) (n : Nat) (c : Ps.Fin n -> R) (d : R) : U l = TG.RegSeq D (suc n) m J (rot R n c d) ;
 -- d is regular mod (J, c)
 rs-last : (n m : Nat) (J : Ps.Fin m -> R) (c : Ps.Fin n -> R) (d : R) -> RS m J n c d -> TG.RegEl D (plus n m) (WL.cat n c m J) d = split {
  zero -> \ m J c d s -> s.1 ;
  suc n | r -> \ m J c d s -> TI.same-el (plus n (suc m)) (WL.cat n (\ i -> c (inl i)) (suc m) (TG.extend D m J (c (inr tt))))
   (suc (plus n m)) (WL.cat (suc n) c m J) (WL.cat-ext n (\ i -> c (inl i)) m J (c (inr tt))) d
   (r (suc m) (TG.extend D m J (c (inr tt))) (\ i -> c (inl i)) d s.2) } ;
 -- the last term can be replaced
 replace-last : (n m : Nat) (J : Ps.Fin m -> R) (c : Ps.Fin n -> R) (d y : R) -> RS m J n c d ->
  TG.RegEl D (plus n m) (WL.cat n c m J) y -> RS m J n c y = split {
  zero -> \ m J c d y s ry -> (ry,tt) ;
  suc n | r -> \ m J c d y s ry -> (s.1,r (suc m) (TG.extend D m J (c (inr tt))) (\ i -> c (inl i)) d y s.2
   (TI.same-el (suc (plus n m)) (WL.cat (suc n) c m J) (plus n (suc m)) (WL.cat n (\ i -> c (inl i)) (suc m) (TG.extend D m J (c (inr tt))))
     (WL.same-sym (plus n (suc m)) (WL.cat n (\ i -> c (inl i)) (suc m) (TG.extend D m J (c (inr tt))))
       (suc (plus n m)) (WL.cat (suc n) c m J) (WL.cat-ext n (\ i -> c (inl i)) m J (c (inr tt)))) y ry)) } ;
 -- the terms are in (c, d)
 rot-in : (n : Nat) (c : Ps.Fin n -> R) (d : R) (i : Ps.Fin (suc n)) -> WL.In (suc n) (TG.extend D n c d) (rot R n c d i) = split {
  zero -> \ c d -> split { inl e -> efq e ; inr s -> WL.Gen[suc zero,TG.extend D zero c d].G.generator (inr tt) } ;
  suc n | r -> \ c d -> split {
   inl i -> WL.included (suc n) (TG.extend D n (\ j -> c (inl j)) d) (suc (suc n)) (TG.extend D (suc n) c d)
     (KX.plus-fn (Ps.Fin n) Top (\ j -> WL.In (suc (suc n)) (TG.extend D (suc n) c d) (TG.extend D n (\ k -> c (inl k)) d j))
       (\ j -> WL.Gen[suc (suc n),TG.extend D (suc n) c d].G.generator (inl (inl j)))
       (KX.top-fn (\ t -> WL.In (suc (suc n)) (TG.extend D (suc n) c d) (TG.extend D n (\ k -> c (inl k)) d (inr t)))
         (WL.Gen[suc (suc n),TG.extend D (suc n) c d].G.generator (inr tt))))
     (rot R n (\ j -> c (inl j)) d i) (r (\ j -> c (inl j)) d i) ;
   inr s -> WL.Gen[suc (suc n),TG.extend D (suc n) c d].G.generator (inl (inr tt)) } } ;
 -- Gr(c, d) >= n + 1 mod J
 tgr-rot (n m : Nat) (J : Ps.Fin m -> R) (c : Ps.Fin n -> R) (d : R) (s : RS m J n c d) : TG.TGr (suc n) D m J (suc n) (TG.extend D n c d) =
  Tr.Trunc[(p : Nat) * TG.Seq D (suc n) m J (suc n) (TG.extend D n c d) p].inc (zero,rot R n c d,rot-in n c d,s) ;
 -- I is regular mod J when rot c d is a regular sequence
 rs-regular (n m : Nat) (J : Ps.Fin m -> R) (c : Ps.Fin n -> R) (d : R) (s : RS m J n c d) : TG.RegId D m J (suc n) (TG.extend D n c d) =
  TI.elem-ideal m J (suc n) (TG.extend D n c d) (rot R n c d (inr tt)) (rot-in n c d (inr tt)) s.1 ;

 ---------------------------------------------------------------------
 -- changing the terms mod L
 module Cong1 (m : Nat) (K : Ps.Fin m -> R) (s t : R) (c : WL.Cong m K s t) {
  module MK = WL.Mod[m,K] ;
  el (r : TG.RegEl D m K s) : TG.RegEl D m K t = \ x u k ->
   r x tt (MK.from-zero (mul s x) (MK.cong-trans (mul s x) (mul t x) z (MK.cong-mul-r x s t c) (MK.to-zero (mul t x) k))) ;
  same : TI.Same (suc m) (TG.extend D m K s) (suc m) (TG.extend D m K t) =
   WL.same-gen (suc m) (TG.extend D m K s) (suc m) (TG.extend D m K t)
    (KX.plus-fn (Ps.Fin m) Top (\ i -> WL.In (suc m) (TG.extend D m K t) (TG.extend D m K s i))
      (\ i -> WL.Gen[suc m,TG.extend D m K t].G.generator (inl i))
      (KX.top-fn (\ u -> WL.In (suc m) (TG.extend D m K t) (TG.extend D m K s (inr u)))
        (WL.Mod[suc m,TG.extend D m K t].in-cong s t (WL.ext-in m K t (WL.sub s t) c) (WL.Gen[suc m,TG.extend D m K t].G.generator (inr tt)))))
    (KX.plus-fn (Ps.Fin m) Top (\ i -> WL.In (suc m) (TG.extend D m K s) (TG.extend D m K t i))
      (\ i -> WL.Gen[suc m,TG.extend D m K s].G.generator (inl i))
      (KX.top-fn (\ u -> WL.In (suc m) (TG.extend D m K s) (TG.extend D m K t (inr u)))
        (WL.Mod[suc m,TG.extend D m K s].in-cong t s (WL.ext-in m K s (WL.sub t s) (MK.cong-sym s t c)) (WL.Gen[suc m,TG.extend D m K s].G.generator (inr tt))))) ;
 } ;
 regseq-cong : (k m : Nat) (K : Ps.Fin m -> R) (s t : Ps.Fin k -> R) -> ((i : Ps.Fin k) -> WL.Cong m K (s i) (t i)) ->
  TG.RegSeq D k m K s -> TG.RegSeq D k m K t = split {
  zero -> \ m K s t c h -> tt ;
  suc k | r -> \ m K s t c h -> (Cong1[m,K,s (inr tt),t (inr tt),c (inr tt)].el h.1,
   r (suc m) (TG.extend D m K (t (inr tt))) (\ i -> s (inl i)) (\ i -> t (inl i))
    (\ i -> WL.ext-in m K (t (inr tt)) (WL.sub (s (inl i)) (t (inl i))) (c (inl i)))
    (TI.same-seq k (suc m) (TG.extend D m K (s (inr tt))) (suc m) (TG.extend D m K (t (inr tt)))
      Cong1[m,K,s (inr tt),t (inr tt),c (inr tt)].same (\ i -> s (inl i)) h.2)) } ;
 -- membership in (J, I') along a ring map
 cat-in-map (S' : TG.RD) (h : RH.Hom Rg S'.1) (n' : Nat) (I' : Ps.Fin n' -> R) (m : Nat) (J : Ps.Fin m -> R) (x : R)
  (e : WL.In (plus n' m) (WL.cat n' I' m J) x) :
  WiebeLists[l].Over[S'.1,S'.2].In (plus n' m) (WiebeLists[l].Over[S'.1,S'.2].cat n' (\ j -> h.1 (I' j)) m (\ j -> h.1 (J j))) (h.1 x) =
  TB.ini-list S' (plus n' m) (\ i -> h.1 (WL.cat n' I' m J i)) (WiebeLists[l].Over[S'.1,S'.2].cat n' (\ j -> h.1 (I' j)) m (\ j -> h.1 (J j)))
   (WiebeLists[l].cat-map D S' h n' I' m J) (h.1 x) (TB.hom-in D S' h (plus n' m) (WL.cat n' I' m J) x e) ;
} ;

---------------------------------------------------------------------
-- Gr(I) >= k mod J and I in (J, I') give Gr(I') >= k mod J
module TgrSub (D : TG.RD) (k m : Nat) (J : Ps.Fin m -> D.1.R) (n : Nat) (I : Ps.Fin n -> D.1.R) (n' : Nat) (I' : Ps.Fin n' -> D.1.R)
 (hI : (i : Ps.Fin n) -> WiebeLists[l].Over[D.1,D.2].In (plus n' m) (WiebeLists[l].Over[D.1,D.2].cat n' I' m J) (I i)) {
 module At (w : (p : Nat) * TG.Seq D k m J n I p) {
  p : Nat = w.1 ;
  T : TG.RD = TG.ext p D ;
  module WT = WiebeLists[l].Over[T.1,T.2] ;
  module ST = Over[T.1,T.2] ;
  J' : Ps.Fin m -> T.1.R = TG.img p D m J ;
  I2 : Ps.Fin n' -> T.1.R = TG.img p D n' I' ;
  s : Ps.Fin k -> T.1.R = w.2.1 ;
  -- every I_i is in (J, I') over T, so every s_j is
  hI2 (i : Ps.Fin n) : WT.In (plus n' m) (WT.cat n' I2 m J') (TG.img p D n I i) =
   Over[D.1,D.2].cat-in-map T (TG.incl p D) n' I' m J (I i) (hI i) ;
  hs (j : Ps.Fin k) : WT.In (plus n' m) (WT.cat n' I2 m J') (s j) =
   WT.included n (TG.img p D n I) (plus n' m) (WT.cat n' I2 m J') hI2 (s j) (w.2.2.1 j) ;
  module Choose (t : (j : Ps.Fin k) -> WT.Split n' I2 m J' (s j)) {
   u (j : Ps.Fin k) : T.1.R = (t j).1 ;
   cong (j : Ps.Fin k) : WT.Cong m J' (s j) (u j) = (t j).2.2 ;
   result : TG.Seq D k m J n' I' p = (u,\ j -> (t j).2.1,ST.regseq-cong k m J' s u cong w.2.2.2) ;
  } ;
  result : TG.TGr k D m J n' I' =
   TC.map ((j : Ps.Fin k) -> WT.Split n' I2 m J' (s j)) ((q : Nat) * TG.Seq D k m J n' I' q) (\ t -> (p,Choose[t].result))
    (Products[l].fin-choice k (\ j -> WT.Split n' I2 m J' (s j)) (\ j -> WT.cat-split n' I2 m J' (s j) (hs j))) ;
 } ;
 result (g : TG.TGr k D m J n I) : TG.TGr k D m J n' I' =
  TC.rec ((p : Nat) * TG.Seq D k m J n I p) @l (TG.TGr k D m J n' I') (TG.tgr-prop k D m J n' I') (\ w -> At[w].result) g ;
} ;

---------------------------------------------------------------------
-- good ring maps
Retract (S S' : TG.RD) (h : RH.Hom S.1 S'.1) : U l = (rho : RH.Hom S'.1 S.1) * ((x : S.1.R) -> Id S.1.R (rho.1 (h.1 x)) x) ;
Good (S S' : TG.RD) (h : RH.Hom S.1 S'.1) : U l = TB.Preserves S S' h * Retract S S' h ;
good-id (S : TG.RD) : Good S S (RH.identity S.1) = (\ m L a r -> r,RH.identity S.1,\ x -> refl x) ;
good-compose (S S' S'' : TG.RD) (h : RH.Hom S.1 S'.1) (h' : RH.Hom S'.1 S''.1) (g : Good S S' h) (g' : Good S' S'' h') :
 Good S S'' (RH.compose S.1 S'.1 S''.1 h' h) =
 (TB.pres-compose S S' S'' h h' g.1 g'.1,RH.compose S''.1 S'.1 S.1 g.2.1 g'.2.1,
  \ x -> trans (ap g.2.1.1 (g'.2.2 (h.1 x))) (g.2.2 x)) ;
good-incl (S : TG.RD) : Good S (TG.ext1 S) TG.PolyX[S].X.inclusion =
 (TB.pres-incl S,PolyRegular[l].Over[S.1,S.2].ev0,PolyRegular[l].Over[S.1,S.2].ev0-constant) ;
-- memberships of images come back
down (S S' : TG.RD) (h : RH.Hom S.1 S'.1) (g : Retract S S' h) (m : Nat) (L : Ps.Fin m -> S.1.R) (x : S.1.R)
 (e : TG.InI S' m (\ i -> h.1 (L i)) (h.1 x)) : TG.InI S m L x =
 subst (TG.InI S m L) (g.2 x) (TB.ini-list S m (\ i -> g.1.1 (h.1 (L i))) L (\ i -> g.2 (L i)) (g.1.1 (h.1 x))
  (TB.hom-in S' S g.1 m (\ i -> h.1 (L i)) (h.1 x) e)) ;
