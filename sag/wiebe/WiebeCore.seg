-- The induction step of Wiebe's theorem (ctete Theorem 11, steps 5 and
-- 6), in one ring, with the generic position already reached.
--
-- For a, b in R^n and d in R, everything mod (J, b) (Concl):
--   (Perp)  d-perp is in (a):  x d in (J, b) gives x in (J, b, a);
--   (Ann)   (a)-perp is in (d): x a_i in (J, b) for all i gives x in (J, b, d).
-- Base n = 0: d = det of the empty matrix = 1, (a) = (b) = 0.
--
-- Step.  a, b in R^(n+1), b = V a mod J, Delta = det V, W the top left
-- block, delta = det W; write K = (J, b_1 .. b_n), b_n+1 = bt, a_n+1 = at.
-- Assume bt and at regular mod K, and the conclusions for a_<, b_< and
-- delta mod (J, at) (by induction).  Cramer: Delta at = delta bt mod K.
-- (Perp) x Delta = bt y mod K.  Then bt (x delta) = x (delta bt)
--   = x (Delta at) = at (x Delta) = at (bt y) = bt (at y) mod K, so
--   x delta = at y mod K (bt regular): x delta in (K, at) = (J, at, b_<).
--   By induction x is in (J, at, b_<, a_<), which is in (J, b, a).
-- (Ann) x at = bt y and x a_i = bt y_i mod K (i <= n).  Then
--   bt (y a_i) = a_i (bt y) = a_i (x at) = at (x a_i) = at (bt y_i)
--   = bt (at y_i) mod K, so y a_i is in (K, at) = (J, at, b_<) for all
--   i <= n.  By induction y is in (J, at, b_<, delta):
--   y = at t + delta s mod K.  Then
--   at x = bt y = at (bt t) + (delta bt) s = at (bt t) + (Delta at) s
--   = at (bt t + Delta s) mod K, so x = bt t + Delta s mod K (at
--   regular): x is in (K, bt, Delta) = (J, b, Delta).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module TG = TrueGrade[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 D : TG.RD = (Rg,setR) ;
 open Rg ; module L = RL[Rg] ;
 module AL = Alternating[l].Over[Rg,setR] ;
 module DT = Determinant[l].Over[Rg,setR] ;
 module WL = WiebeLists[l].Over[Rg,setR] ;
 module WM = WiebeMatrices[l].Over[Rg,setR] ;
 open ExteriorModel[l].Over[Rg] ;

 ---------------------------------------------------------------------
 -- the conclusions, mod (J, b)
 Perp (m : Nat) (J : Ps.Fin m -> R) (n : Nat) (a b : AL.Vec n) (d : R) : U l =
  (x : R) -> WL.In (plus n m) (WL.cat n b m J) (mul x d) -> WL.In (plus n (plus n m)) (WL.cat n a (plus n m) (WL.cat n b m J)) x ;
 Ann (m : Nat) (J : Ps.Fin m -> R) (n : Nat) (a b : AL.Vec n) (d : R) : U l =
  (x : R) -> ((i : Ps.Fin n) -> WL.In (plus n m) (WL.cat n b m J) (mul x (a i))) ->
  WL.In (suc (plus n m)) (TG.extend D (plus n m) (WL.cat n b m J) d) x ;
 Concl (m : Nat) (J : Ps.Fin m -> R) (n : Nat) (a b : AL.Vec n) (d : R) : U l = Perp m J n a b d * Ann m J n a b d ;

 ---------------------------------------------------------------------
 -- n = 0
 base (m : Nat) (J : Ps.Fin m -> R) (a b : AL.Vec zero) (V : DT.Mat zero) : Concl m J zero a b (det zero V) =
  (\ x e -> subst (WL.In m J) (mulO x) e,
   \ x k -> WL.TI.Plus[m,J,o].to x x (WL.Mod[m,J].of-eq x (mul o x) (sym (L.one-left x)))) ;

 ---------------------------------------------------------------------
 -- the step
 module Step (m : Nat) (J : Ps.Fin m -> R) (n : Nat) (a b : AL.Vec (suc n)) (V : DT.Mat (suc n)) (h : WM.Hyp m J (suc n) a b V)
  (rb : TG.RegEl D (plus n m) (WL.cat n (\ i -> b (inl i)) m J) (b (inr tt)))
  (ra : TG.RegEl D (plus n m) (WL.cat n (\ i -> b (inl i)) m J) (a (inr tt)))
  (ih : Concl (suc m) (TG.extend D m J (a (inr tt))) n (\ i -> a (inl i)) (\ i -> b (inl i)) (det n (WM.Block n V))) {
  bt : R = b (inr tt) ;
  at : R = a (inr tt) ;
  dl : R = det n (WM.Block n V) ;
  Dl : R = det (suc n) V ;
  K : Ps.Fin (plus n m) -> R = WL.cat n (\ i -> b (inl i)) m J ;
  -- the lists of the induction hypothesis
  J' : Ps.Fin (suc m) -> R = TG.extend D m J at ;
  K' : Ps.Fin (plus n (suc m)) -> R = WL.cat n (\ i -> b (inl i)) (suc m) J' ;
  module MK = WL.Mod[plus n m,K] ;
  module PB = WL.TI.Plus[plus n m,K,bt] ;
  module PA = WL.TI.Plus[plus n m,K,at] ;
  -- (K, at) = (J, at, b_<)
  same : WL.TI.Same (plus n (suc m)) K' (suc (plus n m)) (TG.extend D (plus n m) K at) = WL.cat-ext n (\ i -> b (inl i)) m J at ;
  to-K' (x : R) (e : WL.In (suc (plus n m)) (TG.extend D (plus n m) K at) x) : WL.In (plus n (suc m)) K' x = (same x).2 e ;
  from-K' (x : R) (e : WL.In (plus n (suc m)) K' x) : WL.In (suc (plus n m)) (TG.extend D (plus n m) K at) x = (same x).1 e ;
  -- Delta at = delta bt mod K
  cramer : WL.Cong (plus n m) K (mul Dl at) (mul dl bt) = WM.Cramer[m,J,n,a,b,V,h].result ;
  -- bt u = bt v mod K gives u = v mod K
  cancel-b (u v : R) (c : WL.Cong (plus n m) K (mul bt u) (mul bt v)) : WL.Cong (plus n m) K u v =
   rb (WL.sub u v) tt (WL.Gen[plus n m,K].GL.in-eq (WL.sub (mul bt u) (mul bt v)) (mul bt (WL.sub u v)) (sym (MK.mul-sub bt u v)) c) ;
  cancel-a (u v : R) (c : WL.Cong (plus n m) K (mul at u) (mul at v)) : WL.Cong (plus n m) K u v =
   ra (WL.sub u v) tt (WL.Gen[plus n m,K].GL.in-eq (WL.sub (mul at u) (mul at v)) (mul at (WL.sub u v)) (sym (MK.mul-sub at u v)) c) ;

  -- the target lists
  T : Ps.Fin (plus (suc n) (plus (suc n) m)) -> R = WL.cat (suc n) a (plus (suc n) m) (WL.cat (suc n) b m J) ;
  t-a (i : Ps.Fin (suc n)) : WL.In (plus (suc n) (plus (suc n) m)) T (a i) = WL.cat-in-c (suc n) a (plus (suc n) m) (WL.cat (suc n) b m J) i ;
  t-b (i : Ps.Fin (suc n)) : WL.In (plus (suc n) (plus (suc n) m)) T (b i) =
   WL.cat-in-J (suc n) a (plus (suc n) m) (WL.cat (suc n) b m J) (b i) (WL.cat-in-c (suc n) b m J i) ;
  t-J (x : R) (e : WL.In m J x) : WL.In (plus (suc n) (plus (suc n) m)) T x =
   WL.cat-in-J (suc n) a (plus (suc n) m) (WL.cat (suc n) b m J) x (WL.cat-in-J (suc n) b m J x e) ;
  t-J' : (i : Ps.Fin (suc m)) -> WL.In (plus (suc n) (plus (suc n) m)) T (J' i) = split {
   inl i -> t-J (J i) (WL.Gen[m,J].G.generator i) ;
   inr s -> t-a (inr tt) } ;
  t-K' (i : Ps.Fin (plus n (suc m))) : WL.In (plus (suc n) (plus (suc n) m)) T (K' i) =
   WL.included (plus n (suc m)) K' (plus (suc n) (plus (suc n) m)) T (WL.cat-gens n (\ j -> b (inl j)) (suc m) J' (plus (suc n) (plus (suc n) m)) T (\ j -> t-b (inl j)) t-J') (K' i)
    (WL.Gen[plus n (suc m),K'].G.generator i) ;
  -- (J, at, b_<, a_<) is in (J, b, a)
  back (x : R) (e : WL.In (plus n (plus n (suc m))) (WL.cat n (\ i -> a (inl i)) (plus n (suc m)) K') x) : WL.In (plus (suc n) (plus (suc n) m)) T x =
   WL.included (plus n (plus n (suc m))) (WL.cat n (\ i -> a (inl i)) (plus n (suc m)) K') (plus (suc n) (plus (suc n) m)) T
    (WL.cat-gens n (\ i -> a (inl i)) (plus n (suc m)) K' (plus (suc n) (plus (suc n) m)) T (\ i -> t-a (inl i)) t-K') x e ;

  -- (Perp)
  module PerpAt (x : R) (y : R) (c : WL.Cong (plus n m) K (mul x Dl) (mul bt y)) {
   chain : WL.Cong (plus n m) K (mul bt (mul x dl)) (mul bt (mul at y)) =
    MK.eq-cong (mul bt (mul x dl)) (mul x (mul dl bt)) (mul bt (mul at y)) (trans (L.mul-swap bt x dl) (ap (mul x) (mulC bt dl)))
     (MK.cong-trans (mul x (mul dl bt)) (mul x (mul Dl at)) (mul bt (mul at y))
       (MK.cong-mul x (mul dl bt) (mul Dl at) (MK.cong-sym (mul Dl at) (mul dl bt) cramer))
       (MK.eq-cong (mul x (mul Dl at)) (mul at (mul x Dl)) (mul bt (mul at y))
         (trans (ap (mul x) (mulC Dl at)) (sym (L.mul-swap at x Dl)))
         (MK.cong-eq (mul at (mul x Dl)) (mul at (mul bt y)) (mul bt (mul at y)) (MK.cong-mul at (mul x Dl) (mul bt y) c) (L.mul-swap at bt y)))) ;
   in-K' : WL.In (plus n (suc m)) K' (mul x dl) = to-K' (mul x dl) (PA.to (mul x dl) y (cancel-b (mul x dl) (mul at y) chain)) ;
   result : WL.In (plus (suc n) (plus (suc n) m)) T x = back x (ih.1 x in-K') ;
  } ;
  perp : Perp m J (suc n) a b Dl = \ x e ->
   TC.rec ((y : R) * WL.In (plus n m) K (WL.sub (mul x Dl) (mul bt y))) @l (WL.In (plus (suc n) (plus (suc n) m)) T x)
    (WL.in-prop (plus (suc n) (plus (suc n) m)) T x) (\ u -> PerpAt[x,u.1,u.2].result) (PB.from (mul x Dl) e) ;

  -- (Ann)
  module AnnAt (x : R) (k : (i : Ps.Fin (suc n)) -> WL.In (suc (plus n m)) (WL.cat (suc n) b m J) (mul x (a i)))
   (y : R) (c : WL.Cong (plus n m) K (mul x at) (mul bt y)) {
   -- y a_i is in (J, at, b_<)
   module Row (i : Ps.Fin n) (yi : R) (ci : WL.Cong (plus n m) K (mul x (a (inl i))) (mul bt yi)) {
    ai : R = a (inl i) ;
    chain : WL.Cong (plus n m) K (mul bt (mul y ai)) (mul bt (mul at yi)) =
     MK.eq-cong (mul bt (mul y ai)) (mul ai (mul bt y)) (mul bt (mul at yi))
      (trans (ap (mul bt) (mulC y ai)) (sym (L.mul-swap ai bt y)))
      (MK.cong-trans (mul ai (mul bt y)) (mul ai (mul x at)) (mul bt (mul at yi))
        (MK.cong-mul ai (mul bt y) (mul x at) (MK.cong-sym (mul x at) (mul bt y) c))
        (MK.eq-cong (mul ai (mul x at)) (mul at (mul x ai)) (mul bt (mul at yi))
          (trans (L.mul-swap ai x at) (trans (ap (mul x) (mulC ai at)) (sym (L.mul-swap at x ai))))
          (MK.cong-eq (mul at (mul x ai)) (mul at (mul bt yi)) (mul bt (mul at yi)) (MK.cong-mul at (mul x ai) (mul bt yi) ci) (L.mul-swap at bt yi)))) ;
    result : WL.In (plus n (suc m)) K' (mul y ai) = to-K' (mul y ai) (PA.to (mul y ai) yi (cancel-b (mul y ai) (mul at yi) chain)) ;
   } ;
   row (i : Ps.Fin n) : WL.In (plus n (suc m)) K' (mul y (a (inl i))) =
    TC.rec ((w : R) * WL.In (plus n m) K (WL.sub (mul x (a (inl i))) (mul bt w))) @l (WL.In (plus n (suc m)) K' (mul y (a (inl i))))
     (WL.in-prop (plus n (suc m)) K' (mul y (a (inl i)))) (\ u -> Row[i,u.1,u.2].result) (PB.from (mul x (a (inl i))) (k (inl i))) ;
   -- y = at t + delta s mod K
   y-in : WL.In (suc (plus n (suc m))) (TG.extend D (plus n (suc m)) K' dl) y = ih.2 y row ;
   Goal : U l = WL.In (suc (suc (plus n m))) (TG.extend D (suc (plus n m)) (WL.cat (suc n) b m J) Dl) x ;
   module Final (s t : R) (e : WL.In (plus n m) K (WL.sub (WL.sub y (mul dl s)) (mul at t))) {
    Z : R = add (mul bt t) (mul Dl s) ;
    cy : WL.Cong (plus n m) K y (add (mul at t) (mul dl s)) = subst (WL.In (plus n m) K) (WL.split-sub y (mul dl s) (mul at t)) e ;
    ds : Id R (mul bt (mul dl s)) (mul (mul dl bt) s) = trans (mulA bt dl s) (ap (\ u -> mul u s) (mulC bt dl)) ;
    chain : WL.Cong (plus n m) K (mul at x) (mul at Z) =
     MK.eq-cong (mul at x) (mul x at) (mul at Z) (mulC at x)
      (MK.cong-trans (mul x at) (mul bt y) (mul at Z) c
        (MK.cong-trans (mul bt y) (mul bt (add (mul at t) (mul dl s))) (mul at Z) (MK.cong-mul bt y (add (mul at t) (mul dl s)) cy)
          (MK.eq-cong (mul bt (add (mul at t) (mul dl s))) (add (mul at (mul bt t)) (mul (mul dl bt) s)) (mul at Z)
            (trans (dist bt (mul at t) (mul dl s)) (Ps.cong2 R add _ _ _ _ (L.mul-swap bt at t) ds))
            (MK.cong-eq (add (mul at (mul bt t)) (mul (mul dl bt) s)) (add (mul at (mul bt t)) (mul (mul Dl at) s)) (mul at Z)
              (MK.cong-add (mul at (mul bt t)) (mul at (mul bt t)) (mul (mul dl bt) s) (mul (mul Dl at) s)
                (MK.cong-refl (mul at (mul bt t))) (MK.cong-mul-r s (mul dl bt) (mul Dl at) (MK.cong-sym (mul Dl at) (mul dl bt) cramer)))
              (trans (ap (add (mul at (mul bt t))) (trans (ap (\ u -> mul u s) (mulC Dl at)) (sym (mulA at Dl s))))
                (sym (dist at (mul bt t) (mul Dl s)))))))) ;
    cx : WL.In (plus n m) K (WL.sub (WL.sub x (mul Dl s)) (mul bt t)) =
     subst (WL.In (plus n m) K) (sym (WL.split-sub x (mul Dl s) (mul bt t))) (cancel-a x Z chain) ;
    result : Goal = WL.TI.Plus[suc (plus n m),WL.cat (suc n) b m J,Dl].to x s (PB.to (WL.sub x (mul Dl s)) t cx) ;
   } ;
   module AtS (s : R) (es : WL.In (plus n (suc m)) K' (WL.sub y (mul dl s))) {
    result : Goal =
     TC.rec ((t : R) * WL.In (plus n m) K (WL.sub (WL.sub y (mul dl s)) (mul at t))) @l Goal (WL.in-prop (suc (suc (plus n m))) (TG.extend D (suc (plus n m)) (WL.cat (suc n) b m J) Dl) x)
      (\ u -> Final[s,u.1,u.2].result) (PA.from (WL.sub y (mul dl s)) (from-K' (WL.sub y (mul dl s)) es)) ;
   } ;
   result : Goal =
    TC.rec ((s : R) * WL.In (plus n (suc m)) K' (WL.sub y (mul dl s))) @l Goal (WL.in-prop (suc (suc (plus n m))) (TG.extend D (suc (plus n m)) (WL.cat (suc n) b m J) Dl) x)
     (\ u -> AtS[u.1,u.2].result) (WL.TI.Plus[plus n (suc m),K',dl].from y y-in) ;
  } ;
  ann : Ann m J (suc n) a b Dl = \ x k ->
   TC.rec ((y : R) * WL.In (plus n m) K (WL.sub (mul x at) (mul bt y))) @l (WL.In (suc (suc (plus n m))) (TG.extend D (suc (plus n m)) (WL.cat (suc n) b m J) Dl) x)
    (WL.in-prop (suc (suc (plus n m))) (TG.extend D (suc (plus n m)) (WL.cat (suc n) b m J) Dl) x)
    (\ u -> AnnAt[x,k,u.1,u.2].result) (PB.from (mul x at) (k (inr tt))) ;
  result : Concl m J (suc n) a b Dl = (perp,ann) ;
 } ;
} ;
