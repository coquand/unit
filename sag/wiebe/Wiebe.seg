-- Wiebe's theorem: ctete Theorem 11 and Corollary 12, relative to a list J.
--
-- Let a, b in R^n with b = V a mod J (b_j = sum_i a_i V_ij), Delta = det V,
-- and Gr(b) >= n mod J (true grade).  Then, mod (J, b):
--   Delta-perp = (a):  x Delta in (J, b)  iff  x in (J, b, a);
--   (a)-perp = (Delta): x a_i in (J, b) for all i  iff  x in (J, b, Delta).
-- The inclusions "if" hold for any V (Delta a_i is in (J, b) by Cramer:
-- adj(V) b = adj(V) V a = Delta a mod J).  Corollary 12: the same when b is
-- a regular sequence mod J.
--
-- Proof of the inclusions "only if" (theorem11), by induction on n,
-- for all rings at once (ctete):
-- n = 0: WiebeCore.base.
-- n + 1 (Induction):
--   1. Generic change of b (WiebeGeneric.generic): along a good map
--      h1 : D -> T1, b1 reached from h1 b by elementary operations, with
--      b1_n+1 = h1 b_n+1 and b1_n, ..., b1_1, b1_n+1 regular mod J.  Then
--      b1 = V1 (h1 a) mod J with det V1 = h1 Delta (WiebeChain.chain-hyp,
--      WiebeTransfer.Map), and b1_n+1 is regular mod (J, b1_<) (rs-last).
--   2. (a) is regular mod J and mod (J, b1_<), since x killing (a) kills
--      (b1) (b-kill).  In T2 = T1[X] put fa = a_n+1 + X (a_n + a_n-1 X + ...),
--      the Kronecker polynomial of a with constant term a_n+1: fa is regular
--      mod J and mod (J, b1_<) (McCoy, TrueGradeThm9.Kron.f-reg), and
--      a2 = (a_<, fa) is reached from a by one elementary operation, so
--      b1 = V2 a2 mod J with det V2 = det V1 (WiebeMatrices.AOp).
--   3. b1_n, ..., b1_1, fa is a regular sequence mod J (replace-last), so
--      Gr(b1_<, fa) >= n + 1 mod J, hence Gr(b1_<, fa) >= n mod (J, fa)
--      (Theorem 9), hence Gr(b1_<) >= n mod (J, fa) (TgrSub).
--   4. By induction, mod (J, fa) with b1_< = W a_< (WiebeMatrices.HypBlock),
--      the conclusions hold for a_<, b1_<, det W; WiebeCore.Step gives
--      them for a2, b1, det V2 mod J.
--   5. Back: (J, a2) is in (J, a), (J, b1) = (J, h1 b) (WiebeTransfer.Transfer),
--      det V2 = h Delta, and the retraction of h = T1 -> T2 after h1 brings
--      the memberships back to D (WiebeTransfer.Map.Down).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module RH = RingHom[l] ; module TG = TrueGrade[l] ; module TB = TrueGradeBase[l] ; module T9 = TrueGradeThm9[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module WS = WiebeSequences[l] ; module WC = WiebeChain[l] ; module WG = WiebeGeneric[l] ; module WT = WiebeTransfer[l] ;

-- the inclusions of Theorem 11, for n
Thm (n : Nat) : U l+ = (D : TG.RD) (m : Nat) (J : Ps.Fin m -> D.1.R) (a b : Ps.Fin n -> D.1.R) (V : Determinant[l].Over[D.1,D.2].Mat n) ->
 WiebeMatrices[l].Over[D.1,D.2].Hyp m J n a b V -> TG.TGr n D m J n b ->
 WiebeCore[l].Over[D.1,D.2].Concl m J n a b (ExteriorModel[l].Over[D.1].det n V) ;

module Induction (n : Nat) (ih : Thm n) (D : TG.RD) (m : Nat) (J : Ps.Fin m -> D.1.R) (a b : Ps.Fin (suc n) -> D.1.R)
 (V : Determinant[l].Over[D.1,D.2].Mat (suc n)) (h : WiebeMatrices[l].Over[D.1,D.2].Hyp m J (suc n) a b V)
 (g : TG.TGr (suc n) D m J (suc n) b) {
 Delta : D.1.R = ExteriorModel[l].Over[D.1].det (suc n) V ;
 Goal : U l = WiebeCore[l].Over[D.1,D.2].Concl m J (suc n) a b Delta ;
 gp : Pr.isProp Goal = WT.Over[D.1,D.2].concl-prop m J (suc n) a b Delta ;
 -- 1. after the generic change of b, in T1
 module After (T1 : TG.RD) (h1 : RH.Hom D.1 T1.1) (good1 : WS.Good D T1 h1) (out : WG.Out D m J n b T1 h1) {
  module WL1 = WiebeLists[l].Over[T1.1,T1.2] ;
  module WM1 = WiebeMatrices[l].Over[T1.1,T1.2] ;
  module WS1 = WS.Over[T1.1,T1.2] ;
  module WT1 = WT.Over[T1.1,T1.2] ;
  module M1 = WT.Map[D,T1,h1] ;
  J1 : Ps.Fin m -> T1.1.R = \ i -> h1.1 (J i) ;
  a1 : Ps.Fin (suc n) -> T1.1.R = \ i -> h1.1 (a i) ;
  b0 : Ps.Fin (suc n) -> T1.1.R = \ i -> h1.1 (b i) ;
  V0 : Determinant[l].Over[T1.1,T1.2].Mat (suc n) = \ i j -> h1.1 (V i j) ;
  b1 : Ps.Fin (suc n) -> T1.1.R = out.1 ;
  hd1 : WC.Over[T1.1,T1.2].HypDet m J1 (suc n) a1 b1 (ExteriorModel[l].Over[T1.1].det (suc n) V0) =
   WC.Over[T1.1,T1.2].chain-hyp m J1 (suc n) a1 (ExteriorModel[l].Over[T1.1].det (suc n) V0) out.2.1 b0 b1 out.2.2.1
    (V0,M1.hyp-map m J (suc n) a b V h,refl (ExteriorModel[l].Over[T1.1].det (suc n) V0)) ;
  V1 : Determinant[l].Over[T1.1,T1.2].Mat (suc n) = hd1.1 ;
  hyp1 : WM1.Hyp m J1 (suc n) a1 b1 V1 = hd1.2.1 ;
  K1 : Ps.Fin (plus n m) -> T1.1.R = WL1.cat n (\ i -> b1 (inl i)) m J1 ;
  -- b1_n+1 regular mod (J, b1_<)
  rb1 : TG.RegEl T1 (plus n m) K1 (b1 (inr tt)) = WS1.rs-last n m J1 (\ i -> b1 (inl i)) (b1 (inr tt)) out.2.2.2.2 ;
  -- 2. (a) regular mod (J, b1_<) and mod J
  rega1 : TG.RegId T1 (plus n m) K1 (suc n) a1 = \ x u k ->
   rb1 x tt (WT1.b-kill (plus n m) K1 (suc n) a1 b1 V1 (WT1.hyp-cat m J1 n (\ i -> b1 (inl i)) (suc n) a1 b1 V1 hyp1) x k (inr tt)) ;
  regb1 : TG.RegId T1 m J1 (suc n) (TG.extend T1 n (\ i -> b1 (inl i)) (b1 (inr tt))) =
   WS1.rs-regular n m J1 (\ i -> b1 (inl i)) (b1 (inr tt)) out.2.2.2.2 ;
  module KillJ (x : T1.1.R) (k : (i : Ps.Fin (suc n)) -> WL1.In m J1 (T1.1.mul (a1 i) x)) {
   bk (j : Ps.Fin (suc n)) : WL1.In m J1 (T1.1.mul (b1 j) x) = WT1.b-kill m J1 (suc n) a1 b1 V1 hyp1 x k j ;
   all : (j : Ps.Fin (suc n)) -> WL1.In m J1 (T1.1.mul (TG.extend T1 n (\ i -> b1 (inl i)) (b1 (inr tt)) j) x) = split {
    inl i -> bk (inl i) ; inr s -> bk (inr tt) } ;
  } ;
  rega1J : TG.RegId T1 m J1 (suc n) a1 = \ x u k -> regb1 x tt KillJ[x,k].all ;
  -- T2 = T1[X] and the Kronecker polynomial of a
  module K = T9.Kron[T1] ;
  module WL2 = WiebeLists[l].Over[(TG.ext1 T1).1,(TG.ext1 T1).2] ;
  module WM2 = WiebeMatrices[l].Over[(TG.ext1 T1).1,(TG.ext1 T1).2] ;
  module WS2 = WS.Over[(TG.ext1 T1).1,(TG.ext1 T1).2] ;
  module WT2 = WT.Over[(TG.ext1 T1).1,(TG.ext1 T1).2] ;
  module WC2 = WC.Over[(TG.ext1 T1).1,(TG.ext1 T1).2] ;
  module M2 = WT.Map[T1,TG.ext1 T1,TG.PolyX[T1].X.inclusion] ;
  c (x : T1.1.R) : (TG.ext1 T1).1.R = K.c x ;
  cJ1 : Ps.Fin m -> (TG.ext1 T1).1.R = \ i -> c (J1 i) ;
  ca1 : Ps.Fin (suc n) -> (TG.ext1 T1).1.R = \ i -> c (a1 i) ;
  cb1 : Ps.Fin (suc n) -> (TG.ext1 T1).1.R = \ i -> c (b1 i) ;
  cb0 : Ps.Fin (suc n) -> (TG.ext1 T1).1.R = \ i -> c (b0 i) ;
  cV1 : Determinant[l].Over[(TG.ext1 T1).1,(TG.ext1 T1).2].Mat (suc n) = \ i j -> c (V1 i j) ;
  fa : (TG.ext1 T1).1.R = K.f (suc n) a1 ;
  fsa : (TG.ext1 T1).1.R = K.f n (\ i -> a1 (inl i)) ;
  horner : Id (TG.ext1 T1).1.R fa ((TG.ext1 T1).1.add (c (a1 (inr tt))) ((TG.ext1 T1).1.mul K.X.variable fsa)) =
   K.X.horner (a1 (inr tt)) (K.PR.kron n (\ i -> a1 (inl i))) ;
  fsa-in : WL2.In n (\ i -> ca1 (inl i)) fsa = K.f-in n (\ i -> a1 (inl i)) ;
  K2 : Ps.Fin (plus n m) -> (TG.ext1 T1).1.R = WL2.cat n (\ i -> cb1 (inl i)) m cJ1 ;
  fa-regJ : TG.RegEl (TG.ext1 T1) m cJ1 fa = K.f-reg m J1 (suc n) a1 rega1J ;
  fa-regK : TG.RegEl (TG.ext1 T1) (plus n m) K2 fa =
   T9.Lists[TG.ext1 T1].regel-list (plus n m) (\ i -> c (K1 i)) K2 (WiebeLists[l].cat-map T1 (TG.ext1 T1) TG.PolyX[T1].X.inclusion n (\ i -> b1 (inl i)) m J1) fa
    (K.f-reg (plus n m) K1 (suc n) a1 rega1) ;
  rb2 : TG.RegEl (TG.ext1 T1) (plus n m) K2 (cb1 (inr tt)) =
   T9.Lists[TG.ext1 T1].regel-list (plus n m) (\ i -> c (K1 i)) K2 (WiebeLists[l].cat-map T1 (TG.ext1 T1) TG.PolyX[T1].X.inclusion n (\ i -> b1 (inl i)) m J1) (cb1 (inr tt))
    (TB.pres-incl T1 (plus n m) K1 (b1 (inr tt)) rb1) ;
  hypc : WM2.Hyp m cJ1 (suc n) ca1 cb1 cV1 = M2.hyp-map m J1 (suc n) a1 b1 V1 hyp1 ;
  -- 3. Gr(b1_<) >= n mod (J, fa)
  rs2 : WS2.RS m cJ1 n (\ i -> cb1 (inl i)) (cb1 (inr tt)) =
   subst (\ s -> TG.RegSeq (TG.ext1 T1) (suc n) m cJ1 s)
    (F.funext (Ps.Fin (suc n)) (\ i -> (TG.ext1 T1).1.R) (\ i -> c (WS.rot T1.1.R n (\ j -> b1 (inl j)) (b1 (inr tt)) i))
      (WS.rot (TG.ext1 T1).1.R n (\ j -> cb1 (inl j)) (cb1 (inr tt))) (WS.rot-map T1.1.R (TG.ext1 T1).1.R c n (\ j -> b1 (inl j)) (b1 (inr tt))))
    (TB.preserves-seq T1 (TG.ext1 T1) TG.PolyX[T1].X.inclusion (TB.pres-incl T1) (suc n) m J1 (WS.rot T1.1.R n (\ j -> b1 (inl j)) (b1 (inr tt))) out.2.2.2.2) ;
  rs3 : WS2.RS m cJ1 n (\ i -> cb1 (inl i)) fa = WS2.replace-last n m cJ1 (\ i -> cb1 (inl i)) (cb1 (inr tt)) fa rs2 fa-regK ;
  I3 : Ps.Fin (suc n) -> (TG.ext1 T1).1.R = TG.extend (TG.ext1 T1) n (\ i -> cb1 (inl i)) fa ;
  J3 : Ps.Fin (suc m) -> (TG.ext1 T1).1.R = TG.extend (TG.ext1 T1) m cJ1 fa ;
  g4 : TG.TGr n (TG.ext1 T1) (suc m) J3 (suc n) I3 =
   T9.thm9 n (TG.ext1 T1) m cJ1 (suc n) I3 fa (WL2.Gen[suc n,I3].G.generator (inr tt)) fa-regJ
    (WS2.tgr-rot n m cJ1 (\ i -> cb1 (inl i)) fa rs3) ;
  hI : (i : Ps.Fin (suc n)) -> WL2.In (plus n (suc m)) (WL2.cat n (\ j -> cb1 (inl j)) (suc m) J3) (I3 i) = split {
   inl i -> WL2.cat-in-c n (\ j -> cb1 (inl j)) (suc m) J3 i ;
   inr s -> WL2.cat-in-J n (\ j -> cb1 (inl j)) (suc m) J3 fa (WL2.Gen[suc m,J3].G.generator (inr tt)) } ;
  g5 : TG.TGr n (TG.ext1 T1) (suc m) J3 n (\ i -> cb1 (inl i)) =
   WS.TgrSub[TG.ext1 T1,n,suc m,J3,suc n,I3,n,\ i -> cb1 (inl i),hI].result g4 ;
  -- the elementary operation on a
  module WithV (v : FiniteIdeal[l].Sums[(TG.ext1 T1).1].Coordinates n (\ i -> ca1 (inl i)) fsa) {
   module S2 = FiniteIdeal[l].Sums[(TG.ext1 T1).1] ;
   module L2 = RL[(TG.ext1 T1).1] ;
   w : Ps.Fin (suc n) -> (TG.ext1 T1).1.R = TG.extend (TG.ext1 T1) n (\ i -> (TG.ext1 T1).1.mul K.X.variable (v.1 i)) (TG.ext1 T1).1.z ;
   a2 : Ps.Fin (suc n) -> (TG.ext1 T1).1.R = TG.extend (TG.ext1 T1) n (\ i -> ca1 (inl i)) fa ;
   s0 : (TG.ext1 T1).1.R = S2.lin (suc n) ca1 w ;
   lin-w : Id (TG.ext1 T1).1.R s0 ((TG.ext1 T1).1.mul K.X.variable fsa) =
    trans (ap (\ t -> (TG.ext1 T1).1.add t (S2.lin n (\ i -> ca1 (inl i)) (\ i -> (TG.ext1 T1).1.mul K.X.variable (v.1 i)))) (L2.mul-zero (ca1 (inr tt))))
     (trans (L2.zl (S2.lin n (\ i -> ca1 (inl i)) (\ i -> (TG.ext1 T1).1.mul K.X.variable (v.1 i))))
       (trans (S2.lin-scale n (\ i -> ca1 (inl i)) v.1 K.X.variable) (ap ((TG.ext1 T1).1.mul K.X.variable) v.2))) ;
   at-top : Id (TG.ext1 T1).1.R fa (WM2.eop (suc n) (inr tt) w ca1 (inr tt)) =
    trans horner (ap ((TG.ext1 T1).1.add (c (a1 (inr tt)))) (sym (trans (L2.one-left s0) lin-w))) ;
   rel : WM2.Rel (suc n) (inr tt) w ca1 a2 = split {
    inl i -> sym (trans (ap ((TG.ext1 T1).1.add (ca1 (inl i))) (L2.zero-mul s0)) ((TG.ext1 T1).1.addZ (ca1 (inl i)))) ;
    inr s -> subst (\ u -> Id (TG.ext1 T1).1.R (a2 (inr u)) (WM2.eop (suc n) (inr tt) w ca1 (inr u))) (MnSums[l].top-eq tt s) at-top } ;
   module AO = WM2.AOp[m,cJ1,suc n,ca1,cb1,cV1,hypc,inr tt,w,refl (TG.ext1 T1).1.z,a2,rel] ;
   V2 : Determinant[l].Over[(TG.ext1 T1).1,(TG.ext1 T1).2].Mat (suc n) = AO.V' ;
   -- 4. induction, then the step
   ihc : WiebeCore[l].Over[(TG.ext1 T1).1,(TG.ext1 T1).2].Concl (suc m) J3 n (\ i -> a2 (inl i)) (\ i -> cb1 (inl i))
     (ExteriorModel[l].Over[(TG.ext1 T1).1].det n (WM2.Block n V2)) =
    ih (TG.ext1 T1) (suc m) J3 (\ i -> a2 (inl i)) (\ i -> cb1 (inl i)) (WM2.Block n V2) WM2.HypBlock[m,cJ1,n,a2,cb1,V2,AO.hyp].result g5 ;
   c2 : WiebeCore[l].Over[(TG.ext1 T1).1,(TG.ext1 T1).2].Concl m cJ1 (suc n) a2 cb1 (ExteriorModel[l].Over[(TG.ext1 T1).1].det (suc n) V2) =
    WiebeCore[l].Over[(TG.ext1 T1).1,(TG.ext1 T1).2].Step[m,cJ1,n,a2,cb1,V2,AO.hyp,rb2,fa-regK,ihc].result ;
   -- 5. back to a, h b, h Delta
   ha2 (i : Ps.Fin (suc n)) : WL2.In (plus (suc n) m) (WL2.cat (suc n) ca1 m cJ1) (a2 i) =
    WL2.cat-in-gen (suc n) ca1 m cJ1 (a2 i) (subst (WL2.In (suc n) ca1) (sym (rel i)) (WM2.eop-in (suc n) (inr tt) w ca1 i)) ;
   d2 : (TG.ext1 T1).1.R = ExteriorModel[l].Over[(TG.ext1 T1).1].det (suc n) V2 ;
   c3 : WiebeCore[l].Over[(TG.ext1 T1).1,(TG.ext1 T1).2].Concl m cJ1 (suc n) ca1 cb1 d2 =
    WT2.Transfer[m,cJ1,suc n,ca1,a2,cb1,cb1,d2,WL2.same-refl (plus (suc n) m) (WL2.cat (suc n) cb1 m cJ1),ha2,c2].result ;
   chain2 : WC2.Chain (suc n) out.2.1 cb0 cb1 = WC.ChainMap[T1,TG.ext1 T1,TG.PolyX[T1].X.inclusion].chain-map (suc n) out.2.1 b0 b1 out.2.2.1 ;
   c4 : WiebeCore[l].Over[(TG.ext1 T1).1,(TG.ext1 T1).2].Concl m cJ1 (suc n) ca1 cb0 d2 =
    WT2.Transfer[m,cJ1,suc n,ca1,ca1,cb0,cb1,d2,WL2.same-cat (suc n) cb0 cb1 m cJ1 (WC2.chain-same (suc n) out.2.1 cb0 cb1 chain2),
     WL2.cat-in-c (suc n) ca1 m cJ1,c3].result ;
   dq : Id (TG.ext1 T1).1.R d2 (c (h1.1 Delta)) =
    trans AO.det-eq (trans (M2.det-map (suc n) V1) (ap c (trans hd1.2.2 (M1.det-map (suc n) V)))) ;
   H : RH.Hom D.1 (TG.ext1 T1).1 = RH.compose D.1 T1.1 (TG.ext1 T1).1 TG.PolyX[T1].X.inclusion h1 ;
   good : WS.Good D (TG.ext1 T1) H = WS.good-compose D T1 (TG.ext1 T1) h1 TG.PolyX[T1].X.inclusion good1 (WS.good-incl T1) ;
   result : Goal = WT.Map[D,TG.ext1 T1,H].Down[good.2,m,J,suc n,a,b,Delta,
    subst (\ d -> WiebeCore[l].Over[(TG.ext1 T1).1,(TG.ext1 T1).2].Concl m cJ1 (suc n) ca1 cb0 d) dq c4].result ;
  } ;
  result : Goal = TC.rec (FiniteIdeal[l].Sums[(TG.ext1 T1).1].Coordinates n (\ i -> ca1 (inl i)) fsa) @l Goal gp (\ v -> WithV[v].result) fsa-in ;
 } ;
 result : Goal = WG.generic n D m J b g Goal gp (\ T1 h1 good1 out -> After[T1,h1,good1,out].result) ;
} ;

-- Theorem 11, the inclusions Delta-perp in (a) and (a)-perp in (Delta)
theorem11 : (n : Nat) -> Thm n = split {
 zero -> \ D m J a b V h g -> WiebeCore[l].Over[D.1,D.2].base m J a b V ;
 suc n | r -> \ D m J a b V h g -> Induction[n,r,D,m,J,a,b,V,h,g].result } ;

---------------------------------------------------------------------
-- the statements, with the converse inclusions
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 D : TG.RD = (Rg,setR) ;
 open Rg ;
 module S = FiniteIdeal[l].Sums[Rg] ;
 module DT = Determinant[l].Over[Rg,setR] ;
 module ADJ = Adjugate[l].Over[Rg,setR] ;
 module DK = DeterminantTrick[l].Over[Rg,setR] ;
 module WL = WiebeLists[l].Over[Rg,setR] ;
 module WM = WiebeMatrices[l].Over[Rg,setR] ;
 module WK = WiebeCore[l].Over[Rg,setR] ;
 module WTO = WT.Over[Rg,setR] ;
 open ExteriorModel[l].Over[Rg] ;
 module Thm11 (m : Nat) (J : Ps.Fin m -> R) (n : Nat) (a b : Ps.Fin n -> R) (V : DT.Mat n) (h : WM.Hyp m J n a b V) {
  Dl : R = det n V ;
  K : Ps.Fin (plus n m) -> R = WL.cat n b m J ;
  Ka : Ps.Fin (plus n (plus n m)) -> R = WL.cat n a (plus n m) K ;
  Kd : Ps.Fin (suc (plus n m)) -> R = TG.extend D (plus n m) K Dl ;
  module MJ = WL.Mod[m,J] ;
  module GK = WL.Gen[plus n m,K] ;
  -- Delta a_i is in (J, b): Delta a = adj(V) (V a) = adj(V) b mod J
  delta-a (i : Ps.Fin n) : WL.In (plus n m) K (mul Dl (a i)) =
   WL.Mod[plus n m,K].in-cong (mul Dl (a i)) (DT.act n (ADJ.adj n V) b i)
    (WL.cong-cat n b m J (mul Dl (a i)) (DT.act n (ADJ.adj n V) b i)
      (MJ.eq-cong (mul Dl (a i)) (DT.act n (ADJ.adj n V) (DT.act n V a) i) (DT.act n (ADJ.adj n V) b i)
        (sym (trans (sym (DK.act-mmul n (ADJ.adj n V) V a i)) (trans (ap (\ N -> DT.act n N a i) (ADJ.adj-mul-mat n V)) (DK.act-scalar n Dl a i))))
        (MJ.cong-sum n (\ j -> mul (DT.act n V a j) (ADJ.adj n V j i)) (\ j -> mul (b j) (ADJ.adj n V j i))
          (\ j -> MJ.cong-mul-r (ADJ.adj n V j i) (DT.act n V a j) (b j) (MJ.cong-sym (b j) (DT.act n V a j) (h j))))))
    (WL.cat-in-gen n b m J (S.lin n b (\ j -> ADJ.adj n V j i)) (WM.lin-in n b (\ j -> ADJ.adj n V j i))) ;
  -- (a) is in Delta-perp
  a-in-delta-perp (x : R) (e : WL.In (plus n (plus n m)) Ka x) : WL.In (plus n m) K (mul x Dl) =
   GK.GL.in-eq (mul Dl x) (mul x Dl) (mulC Dl x)
    (WTO.Scaled[plus n (plus n m),Ka,plus n m,K,Dl,
      WL.cat-all (\ y -> WL.In (plus n m) K (mul Dl y)) n a (plus n m) K delta-a (\ j -> GK.G.ideal.in-mul Dl (K j) (GK.G.generator j))].result x e) ;
  -- (Delta) is in (a)-perp
  delta-in-a-perp (x : R) (e : WL.In (suc (plus n m)) Kd x) (i : Ps.Fin n) : WL.In (plus n m) K (mul x (a i)) =
   GK.GL.in-eq (mul (a i) x) (mul x (a i)) (mulC (a i) x)
    (WTO.Scaled[suc (plus n m),Kd,plus n m,K,a i,
      KoszulExact[l].plus-fn (Ps.Fin (plus n m)) Top (\ j -> WL.In (plus n m) K (mul (a i) (Kd j)))
       (\ j -> GK.G.ideal.in-mul (a i) (K j) (GK.G.generator j))
       (KoszulExact[l].top-fn (\ s -> WL.In (plus n m) K (mul (a i) (Kd (inr s)))) (GK.GL.in-eq (mul Dl (a i)) (mul (a i) Dl) (mulC Dl (a i)) (delta-a i)))].result x e) ;
  module WithGrade (g : TG.TGr n D m J n b) {
   concl : WK.Concl m J n a b Dl = theorem11 n D m J a b V h g ;
   -- Delta-perp is in (a)
   delta-perp-in (x : R) (e : WL.In (plus n m) K (mul x Dl)) : WL.In (plus n (plus n m)) Ka x = concl.1 x e ;
   -- (a)-perp is in (Delta)
   a-perp-in (x : R) (k : (i : Ps.Fin n) -> WL.In (plus n m) K (mul x (a i))) : WL.In (suc (plus n m)) Kd x = concl.2 x k ;
   -- Delta-perp = (a), (a)-perp = (Delta), mod (J, b)
   delta-perp (x : R) : (WL.In (plus n m) K (mul x Dl) -> WL.In (plus n (plus n m)) Ka x) * (WL.In (plus n (plus n m)) Ka x -> WL.In (plus n m) K (mul x Dl)) =
    (delta-perp-in x,a-in-delta-perp x) ;
   a-perp (x : R) : (((i : Ps.Fin n) -> WL.In (plus n m) K (mul x (a i))) -> WL.In (suc (plus n m)) Kd x) *
    (WL.In (suc (plus n m)) Kd x -> (i : Ps.Fin n) -> WL.In (plus n m) K (mul x (a i))) =
    (a-perp-in x,delta-in-a-perp x) ;
  } ;
  -- Corollary 12: b a regular sequence mod J
  module WithSequence (rs : TG.RegSeq D n m J b) {
   g : TG.TGr n D m J n b = Tr.Trunc[(p : Nat) * TG.Seq D n m J n b p].inc (zero,b,WL.Gen[n,b].G.generator,rs) ;
   module G = WithGrade[g] ;
   delta-perp (x : R) : (WL.In (plus n m) K (mul x Dl) -> WL.In (plus n (plus n m)) Ka x) * (WL.In (plus n (plus n m)) Ka x -> WL.In (plus n m) K (mul x Dl)) =
    G.delta-perp x ;
   a-perp (x : R) : (((i : Ps.Fin n) -> WL.In (plus n m) K (mul x (a i))) -> WL.In (suc (plus n m)) Kd x) *
    (WL.In (suc (plus n m)) Kd x -> (i : Ps.Fin n) -> WL.In (plus n m) K (mul x (a i))) =
    G.a-perp x ;
  } ;
 } ;
} ;
