-- Chains of elementary operations on b (ctete Theorem 11, step 2: the
-- generic change b_i -> b_i + sum_(j>i) u_i^(j-i) b_j is such a chain).
--
-- Chain k y y': y' is reached from y by k operations eop r w (w_r = 0),
-- each given with its result (WiebeMatrices.Rel).
--   (chain-same) (y) and (y') have the same elements (rel-same);
--   (chain-hyp) y = V a mod J gives y' = V' a mod J with det V' = det V
--     (WiebeMatrices.BOp);
--   (chain-resp, concat) chains compose;
--   (ChainMap) a ring map h sends a chain to a chain: h (delta) = delta,
--     h keeps sums and products;
--   (lift) a chain on y lifts to a chain on ins y x, the list y with x
--     inserted below its last term: the operation at r with w acts at
--     the image of r with 0 at the new place, and the new term stays x.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module RH = RingHom[l] ; module TG = TrueGrade[l] ;

---------------------------------------------------------------------
-- inserting x below the last term
ins-low (A : U l) (n : Nat) (y : Ps.Fin (suc n) -> A) (x : A) : Ps.Fin (suc n) -> A = split { inl j -> y (inl j) ; inr s -> x } ;
ins (A : U l) (n : Nat) (y : Ps.Fin (suc n) -> A) (x : A) : Ps.Fin (suc (suc n)) -> A = split {
 inl i -> ins-low A n y x i ;
 inr s -> y (inr s) } ;
-- the image of an index
iota (n : Nat) : Ps.Fin (suc n) -> Ps.Fin (suc (suc n)) = split { inl j -> inl (inl j) ; inr s -> inr s } ;
-- removing the term below the last
del (A : U l) (n : Nat) (y : Ps.Fin (suc (suc n)) -> A) : Ps.Fin (suc n) -> A = split {
 inl j -> y (inl (inl j)) ;
 inr s -> y (inr s) } ;
ins-del-low (A : U l) (n : Nat) (y : Ps.Fin (suc (suc n)) -> A) : (i : Ps.Fin (suc n)) -> Id A (ins A n (del A n y) (y (inl (inr tt))) (inl i)) (y (inl i)) = split {
 inl j -> refl (y (inl (inl j))) ;
 inr s -> ap (\ t -> y (inl (inr t))) (MnSums[l].top-eq tt s) } ;
ins-del (A : U l) (n : Nat) (y : Ps.Fin (suc (suc n)) -> A) : (j : Ps.Fin (suc (suc n))) -> Id A (ins A n (del A n y) (y (inl (inr tt))) j) (y j) = split {
 inl i -> ins-del-low A n y i ;
 inr s -> refl (y (inr s)) } ;
ins-map-low (A B : U l) (f : A -> B) (n : Nat) (y : Ps.Fin (suc n) -> A) (x : A) : (i : Ps.Fin (suc n)) ->
 Id B (f (ins A n y x (inl i))) (ins B n (\ i -> f (y i)) (f x) (inl i)) = split {
 inl j -> refl (f (y (inl j))) ; inr s -> refl (f x) } ;
ins-map (A B : U l) (f : A -> B) (n : Nat) (y : Ps.Fin (suc n) -> A) (x : A) : (j : Ps.Fin (suc (suc n))) ->
 Id B (f (ins A n y x j)) (ins B n (\ i -> f (y i)) (f x) j) = split {
 inl i -> ins-map-low A B f n y x i ;
 inr s -> refl (f (y (inr s))) } ;

module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ; module L = RL[Rg] ;
 module S = FiniteIdeal[l].Sums[Rg] ;
 module D = MnSums[l].Over[Rg] ;
 module AL = Alternating[l].Over[Rg,setR] ;
 module DT = Determinant[l].Over[Rg,setR] ;
 module WL = WiebeLists[l].Over[Rg,setR] ;
 module WM = WiebeMatrices[l].Over[Rg,setR] ;
 open ExteriorModel[l].Over[Rg] ;

 Chain (n : Nat) : (k : Nat) -> AL.Vec n -> AL.Vec n -> U l = split {
  zero -> \ y y' -> (j : Ps.Fin n) -> Id R (y' j) (y j) ;
  suc k | r -> \ y y' -> (q : Ps.Fin n) * (w : AL.Vec n) * Id R (w q) z * (y1 : AL.Vec n) * WM.Rel n q w y y1 * r y1 y' } ;
 -- the same elements
 chain-same (n : Nat) : (k : Nat) (y y' : AL.Vec n) -> Chain n k y y' -> WL.TI.Same n y n y' = split {
  zero -> \ y y' c -> WL.same-gen n y n y' (\ j -> subst (WL.In n y') (c j) (WL.Gen[n,y'].G.generator j))
   (\ j -> subst (WL.In n y) (sym (c j)) (WL.Gen[n,y].G.generator j)) ;
  suc k | r -> \ y y' c -> WL.same-trans n y n c.2.2.2.1 n y' (WM.rel-same n c.1 c.2.1 c.2.2.1 y c.2.2.2.1 c.2.2.2.2.1)
   (r c.2.2.2.1 y' c.2.2.2.2.2) } ;
 -- b = V a mod J along a chain
 HypDet (m : Nat) (J : Ps.Fin m -> R) (n : Nat) (a b : AL.Vec n) (d : R) : U l = (V : DT.Mat n) * WM.Hyp m J n a b V * Id R (det n V) d ;
 chain-hyp (m : Nat) (J : Ps.Fin m -> R) (n : Nat) (a : AL.Vec n) (d : R) : (k : Nat) (y y' : AL.Vec n) -> Chain n k y y' ->
  HypDet m J n a y d -> HypDet m J n a y' d = split {
  zero -> \ y y' c h -> (h.1,\ j -> WL.Mod[m,J].eq-cong (y' j) (y j) (DT.act n h.1 a j) (c j) (h.2.1 j),h.2.2) ;
  suc k | r -> \ y y' c h -> r c.2.2.2.1 y' c.2.2.2.2.2
   (WM.BOp[m,J,n,a,y,h.1,h.2.1,c.1,c.2.1,c.2.2.1,c.2.2.2.1,c.2.2.2.2.1].V',
    WM.BOp[m,J,n,a,y,h.1,h.2.1,c.1,c.2.1,c.2.2.1,c.2.2.2.1,c.2.2.2.2.1].hyp,
    trans WM.BOp[m,J,n,a,y,h.1,h.2.1,c.1,c.2.1,c.2.2.1,c.2.2.2.1,c.2.2.2.2.1].det-eq h.2.2) } ;
 -- a chain from y works from any y0 = y
 chain-resp (n : Nat) : (k : Nat) (y y0 y' : AL.Vec n) -> ((j : Ps.Fin n) -> Id R (y0 j) (y j)) -> Chain n k y y' -> Chain n k y0 y' = split {
  zero -> \ y y0 y' e c j -> trans (c j) (sym (e j)) ;
  suc k | r -> \ y y0 y' e c -> (c.1,c.2.1,c.2.2.1,c.2.2.2.1,
   \ j -> trans (c.2.2.2.2.1 j) (WM.eop-cong n c.1 c.2.1 y y0 (\ i -> sym (e i)) j),c.2.2.2.2.2) } ;
 concat (n : Nat) : (k1 k2 : Nat) (y y1 y' : AL.Vec n) -> Chain n k1 y y1 -> Chain n k2 y1 y' -> Chain n (plus k1 k2) y y' = split {
  zero -> \ k2 y y1 y' c1 c2 -> chain-resp n k2 y1 y y' (\ j -> sym (c1 j)) c2 ;
  suc k1 | r -> \ k2 y y1 y' c1 c2 -> (c1.1,c1.2.1,c1.2.2.1,c1.2.2.2.1,c1.2.2.2.2.1,r k2 c1.2.2.2.1 y1 y' c1.2.2.2.2.2 c2) } ;
 -- one operation is a chain
 one (n : Nat) (q : Ps.Fin n) (w : AL.Vec n) (wq : Id R (w q) z) (y y' : AL.Vec n) (e : WM.Rel n q w y y') : Chain n (suc zero) y y' =
  (q,w,wq,y',e,\ j -> refl (y' j)) ;

 ---------------------------------------------------------------------
 -- lifting past an inserted term
 lin-ins (n : Nat) (y w : AL.Vec (suc n)) (x : R) :
  Id R (S.lin (suc (suc n)) (ins R n y x) (ins R n w z)) (S.lin (suc n) y w) =
  ap (add (mul (y (inr tt)) (w (inr tt)))) (trans (ap (\ t -> add t (S.lin n (\ j -> y (inl j)) (\ j -> w (inl j)))) (L.mul-zero x))
   (L.zl (S.lin n (\ j -> y (inl j)) (\ j -> w (inl j))))) ;
 delta-iota (n : Nat) : (q j : Ps.Fin (suc n)) -> Id R (D.delta (suc (suc n)) (iota n q) (iota n j)) (D.delta (suc n) q j) = split {
  inl q -> split { inl j -> refl (D.delta n q j) ; inr s -> refl z } ;
  inr t -> split { inl j -> refl z ; inr s -> refl o } } ;
 delta-new (n : Nat) (s : Top) : (q : Ps.Fin (suc n)) -> Id R (D.delta (suc (suc n)) (iota n q) (inl (inr s))) z = split {
  inl q -> refl z ; inr t -> refl z } ;
 module LiftRel (n : Nat) (q : Ps.Fin (suc n)) (w y y1 : AL.Vec (suc n)) (e : WM.Rel (suc n) q w y y1) (x : R) {
  y2 : AL.Vec (suc (suc n)) = ins R n y x ;
  w2 : AL.Vec (suc (suc n)) = ins R n w z ;
  s2 : R = S.lin (suc (suc n)) y2 w2 ;
  -- at the image of j
  iota-y : (j : Ps.Fin (suc n)) -> Id R (y j) (y2 (iota n j)) = split { inl j -> refl (y (inl j)) ; inr s -> refl (y (inr s)) } ;
  at (j : Ps.Fin (suc n)) : Id R (y1 j) (WM.eop (suc (suc n)) (iota n q) w2 y2 (iota n j)) =
   trans (e j) (Ps.cong2 R add _ _ _ _ (iota-y j) (Ps.cong2 R mul _ _ _ _ (sym (delta-iota n q j)) (sym (lin-ins n y w x)))) ;
  low : (i : Ps.Fin (suc n)) -> Id R (ins R n y1 x (inl i)) (WM.eop (suc (suc n)) (iota n q) w2 y2 (inl i)) = split {
   inl j -> at (inl j) ;
   inr s -> sym (trans (ap (\ t -> add x (mul t s2)) (delta-new n s q)) (trans (ap (add x) (L.zero-mul s2)) (addZ x))) } ;
  result : WM.Rel (suc (suc n)) (iota n q) w2 y2 (ins R n y1 x) = split {
   inl i -> low i ;
   inr s -> at (inr s) } ;
 } ;
 iota-w (n : Nat) (w : AL.Vec (suc n)) : (q : Ps.Fin (suc n)) -> Id R (w q) z -> Id R (ins R n w z (iota n q)) z = split {
  inl q -> \ h -> h ; inr s -> \ h -> h } ;
 lift-low (n : Nat) (x : R) (y y' : AL.Vec (suc n)) (c : Chain (suc n) zero y y') : (i : Ps.Fin (suc n)) ->
  Id R (ins R n y' x (inl i)) (ins R n y x (inl i)) = split { inl j -> c (inl j) ; inr s -> refl x } ;
 lift (n : Nat) (x : R) : (k : Nat) (y y' : AL.Vec (suc n)) -> Chain (suc n) k y y' -> Chain (suc (suc n)) k (ins R n y x) (ins R n y' x) = split {
  zero -> \ y y' c -> split {
   inl i -> lift-low n x y y' c i ;
   inr s -> c (inr s) } ;
  suc k | r -> \ y y' c -> (iota n c.1,ins R n c.2.1 z,iota-w n c.2.1 c.1 c.2.2.1,ins R n c.2.2.2.1 x,
   LiftRel[n,c.1,c.2.1,y,c.2.2.2.1,c.2.2.2.2.1,x].result,r c.2.2.2.1 y' c.2.2.2.2.2) } ;
} ;

---------------------------------------------------------------------
-- along a ring map
module ChainMap (S S' : TG.RD) (h : RH.Hom S.1 S'.1) {
 module C = Over[S.1,S.2] ; module C' = Over[S'.1,S'.2] ;
 module WM = WiebeMatrices[l].Over[S.1,S.2] ; module WM' = WiebeMatrices[l].Over[S'.1,S'.2] ;
 module D = MnSums[l].Over[S.1] ; module D' = MnSums[l].Over[S'.1] ;
 module SM = StandardOpens[l].SumMap[S.1,S'.1,h] ;
 hz : Id S'.1.R (h.1 S.1.z) S'.1.z = RH.zero S.1 S'.1 h ;
 delta-map : (n : Nat) (q j : Ps.Fin n) -> Id S'.1.R (h.1 (D.delta n q j)) (D'.delta n q j) = split {
  zero -> \ q j -> hz ;
  suc n | r -> split {
   inl q -> split { inl j -> r q j ; inr s -> hz } ;
   inr t -> split { inl j -> hz ; inr s -> h.2.1 } } } ;
 eop-map (n : Nat) (q : Ps.Fin n) (w y : Ps.Fin n -> S.1.R) (j : Ps.Fin n) :
  Id S'.1.R (h.1 (WM.eop n q w y j)) (WM'.eop n q (\ i -> h.1 (w i)) (\ i -> h.1 (y i)) j) =
  trans (h.2.2.1 (y j) (S.1.mul (D.delta n q j) (FiniteIdeal[l].Sums[S.1].lin n y w)))
   (ap (S'.1.add (h.1 (y j))) (trans (h.2.2.2 (D.delta n q j) (FiniteIdeal[l].Sums[S.1].lin n y w))
     (Ps.cong2 S'.1.R S'.1.mul _ _ _ _ (delta-map n q j) (SM.combination n y w)))) ;
 chain-map (n : Nat) : (k : Nat) (y y' : Ps.Fin n -> S.1.R) -> C.Chain n k y y' -> C'.Chain n k (\ i -> h.1 (y i)) (\ i -> h.1 (y' i)) = split {
  zero -> \ y y' c j -> ap h.1 (c j) ;
  suc k | r -> \ y y' c -> (c.1,\ i -> h.1 (c.2.1 i),trans (ap h.1 c.2.2.1) hz,\ i -> h.1 (c.2.2.2.1 i),
   \ j -> trans (ap h.1 (c.2.2.2.2.1 j)) (eop-map n c.1 c.2.1 y j),r c.2.2.2.1 y' c.2.2.2.2.2) } ;
} ;
