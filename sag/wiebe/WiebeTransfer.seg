-- Moving the conclusions of Wiebe's theorem (WiebeCore.Concl).
--
-- (concl-prop) They are propositions.
-- (transfer) They only depend on the ideals: if (J, b) = (J, b') and every
--   a'_i is in (J, a), then the conclusions for a', b' give those for a, b
--   (with the same d): x d in (J, b) = (J, b') gives x in (J, b', a'),
--   which is in (J, b, a); x a_i in (J, b) for all i gives x a'_i in
--   (J, b) = (J, b') (scaled), so x is in (J, b', d) = (J, b, d).
-- (b-kill) b = V a mod K: if x kills (a) mod K, x kills (b) mod K.
-- Along a ring map h (Map): b = V a mod J gives h b = (h V)(h a) mod h J,
--   and det (h V) = h (det V) (exterior/Naturality); if h has a
--   retraction, the conclusions for h J, h a, h b, h d give those for
--   J, a, b, d (concl-down: memberships of images come back, and the
--   lists (h J, h b, h a) are the images of (J, b, a), pointwise).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module RH = RingHom[l] ; module TG = TrueGrade[l] ; module TB = TrueGradeBase[l] ; module TT = TrueGradeTools[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module WS = WiebeSequences[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 D : TG.RD = (Rg,setR) ;
 open Rg ; module L = RL[Rg] ;
 module S = FiniteIdeal[l].Sums[Rg] ;
 module MS = MnSums[l].Over[Rg] ;
 module AL = Alternating[l].Over[Rg,setR] ;
 module DT = Determinant[l].Over[Rg,setR] ;
 module WL = WiebeLists[l].Over[Rg,setR] ;
 module WM = WiebeMatrices[l].Over[Rg,setR] ;
 module WK = WiebeCore[l].Over[Rg,setR] ;

 concl-prop (m : Nat) (J : Ps.Fin m -> R) (n : Nat) (a b : AL.Vec n) (d : R) : Pr.isProp (WK.Concl m J n a b d) =
  Pr.isProp-Sigma (WK.Perp m J n a b d) (\ p -> WK.Ann m J n a b d)
   (F.isProp-Pi R (\ x -> WL.In (plus n m) (WL.cat n b m J) (mul x d) -> WL.In (plus n (plus n m)) (WL.cat n a (plus n m) (WL.cat n b m J)) x)
     (\ x -> F.isProp-Pi (WL.In (plus n m) (WL.cat n b m J) (mul x d)) (\ e -> WL.In (plus n (plus n m)) (WL.cat n a (plus n m) (WL.cat n b m J)) x)
       (\ e -> WL.in-prop (plus n (plus n m)) (WL.cat n a (plus n m) (WL.cat n b m J)) x)))
   (\ p -> F.isProp-Pi R (\ x -> ((i : Ps.Fin n) -> WL.In (plus n m) (WL.cat n b m J) (mul x (a i))) ->
      WL.In (suc (plus n m)) (TG.extend D (plus n m) (WL.cat n b m J) d) x)
     (\ x -> F.isProp-Pi ((i : Ps.Fin n) -> WL.In (plus n m) (WL.cat n b m J) (mul x (a i)))
       (\ k -> WL.In (suc (plus n m)) (TG.extend D (plus n m) (WL.cat n b m J) d) x)
       (\ k -> WL.in-prop (suc (plus n m)) (TG.extend D (plus n m) (WL.cat n b m J) d) x))) ;

 ---------------------------------------------------------------------
 -- x times (L1) is in (L2) when x times each generator is
 module Scaled (m1 : Nat) (L1 : Ps.Fin m1 -> R) (m2 : Nat) (L2 : Ps.Fin m2 -> R) (x : R) (h : (i : Ps.Fin m1) -> WL.In m2 L2 (mul x (L1 i))) {
  module G2 = WL.Gen[m2,L2] ;
  term (v : Ps.Fin m1 -> R) (i : Ps.Fin m1) : WL.In m2 L2 (mul x (mul (L1 i) (v i))) =
   G2.GL.in-eq (mul (v i) (mul x (L1 i))) (mul x (mul (L1 i) (v i)))
    (trans (L.mul-swap (v i) x (L1 i)) (ap (mul x) (mulC (v i) (L1 i)))) (G2.G.ideal.in-mul (v i) (mul x (L1 i)) (h i)) ;
  result (y : R) (e : WL.In m1 L1 y) : WL.In m2 L2 (mul x y) =
   TC.rec (S.Coordinates m1 L1 y) @l (WL.In m2 L2 (mul x y)) (WL.in-prop m2 L2 (mul x y)) (\ v ->
    G2.GL.in-eq (S.sum m1 (\ i -> mul x (mul (L1 i) (v.1 i)))) (mul x y)
     (trans (S.sum-scale x m1 (\ i -> mul (L1 i) (v.1 i))) (ap (mul x) v.2))
     (WL.TI.in-sum m2 L2 m1 (\ i -> mul x (mul (L1 i) (v.1 i))) (term v.1))) e ;
 } ;

 ---------------------------------------------------------------------
 module Transfer (m : Nat) (J : Ps.Fin m -> R) (n : Nat) (a a' b b' : AL.Vec n) (d : R)
  (sb : WL.TI.Same (plus n m) (WL.cat n b m J) (plus n m) (WL.cat n b' m J))
  (ha : (i : Ps.Fin n) -> WL.In (plus n m) (WL.cat n a m J) (a' i)) (c : WK.Concl m J n a' b' d) {
  T : Ps.Fin (plus n (plus n m)) -> R = WL.cat n a (plus n m) (WL.cat n b m J) ;
  t-aJ (i : Ps.Fin (plus n m)) : WL.In (plus n (plus n m)) T (WL.cat n a m J i) =
   WL.cat-gens n a m J (plus n (plus n m)) T (WL.cat-in-c n a (plus n m) (WL.cat n b m J))
    (\ j -> WL.cat-in-J n a (plus n m) (WL.cat n b m J) (J j) (WL.cat-in-J n b m J (J j) (WL.Gen[m,J].G.generator j))) i ;
  t-a' (i : Ps.Fin n) : WL.In (plus n (plus n m)) T (a' i) = WL.included (plus n m) (WL.cat n a m J) (plus n (plus n m)) T t-aJ (a' i) (ha i) ;
  t-b' (i : Ps.Fin (plus n m)) : WL.In (plus n (plus n m)) T (WL.cat n b' m J i) =
   WL.cat-in-J n a (plus n m) (WL.cat n b m J) (WL.cat n b' m J i) ((sb (WL.cat n b' m J i)).2 (WL.Gen[plus n m,WL.cat n b' m J].G.generator i)) ;
  perp : WK.Perp m J n a b d = \ x e ->
   WL.included (plus n (plus n m)) (WL.cat n a' (plus n m) (WL.cat n b' m J)) (plus n (plus n m)) T
    (WL.cat-gens n a' (plus n m) (WL.cat n b' m J) (plus n (plus n m)) T t-a' t-b') x (c.1 x ((sb (mul x d)).1 e)) ;
  ann : WK.Ann m J n a b d = \ x k ->
   ((WL.TI.same-ext (plus n m) (WL.cat n b m J) (plus n m) (WL.cat n b' m J) sb d) x).2
    (c.2 x (\ i -> (sb (mul x (a' i))).1
      (Scaled[plus n m,WL.cat n a m J,plus n m,WL.cat n b m J,x,
        WL.cat-all (\ y -> WL.In (plus n m) (WL.cat n b m J) (mul x y)) n a m J k
         (\ j -> WL.Gen[plus n m,WL.cat n b m J].G.ideal.in-mul x (J j) (WL.cat-in-J n b m J (J j) (WL.Gen[m,J].G.generator j)))].result (a' i) (ha i)))) ;
  result : WK.Concl m J n a b d = (perp,ann) ;
 } ;

 ---------------------------------------------------------------------
 -- x kills (a) mod K gives x kills (b) mod K
 b-kill (m : Nat) (K : Ps.Fin m -> R) (n : Nat) (a b : AL.Vec n) (V : DT.Mat n) (h : WM.Hyp m K n a b V) (x : R)
  (k : (i : Ps.Fin n) -> WL.In m K (mul (a i) x)) (j : Ps.Fin n) : WL.In m K (mul (b j) x) =
  WL.Mod[m,K].in-cong (mul (b j) x) (mul (DT.act n V a j) x) (WL.Mod[m,K].cong-mul-r x (b j) (DT.act n V a j) (h j))
   (WL.Gen[m,K].GL.in-eq (S.sum n (\ i -> mul (V i j) (mul (a i) x))) (mul (DT.act n V a j) x)
     (trans (S.sum-cong n (\ i -> mul (V i j) (mul (a i) x)) (\ i -> mul (mul (a i) (V i j)) x)
              (\ i -> trans (L.mul-swap (V i j) (a i) x) (trans (mulA (a i) (V i j) x) (refl (mul (mul (a i) (V i j)) x)))))
       (MS.sum-scale-right x n (\ i -> mul (a i) (V i j))))
     (WL.TI.in-sum m K n (\ i -> mul (V i j) (mul (a i) x)) (\ i -> WL.Gen[m,K].G.ideal.in-mul (V i j) (mul (a i) x) (k i)))) ;
 -- b = V a mod J gives b = V a mod (J, c)
 hyp-cat (m : Nat) (J : Ps.Fin m -> R) (n' : Nat) (c : Ps.Fin n' -> R) (n : Nat) (a b : AL.Vec n) (V : DT.Mat n) (h : WM.Hyp m J n a b V) :
  WM.Hyp (plus n' m) (WL.cat n' c m J) n a b V = \ j -> WL.cong-cat n' c m J (b j) (DT.act n V a j) (h j) ;
} ;

---------------------------------------------------------------------
-- along a ring map
module Map (S S' : TG.RD) (h : RH.Hom S.1 S'.1) {
 module W = Over[S.1,S.2] ; module W' = Over[S'.1,S'.2] ;
 module WL = WiebeLists[l].Over[S.1,S.2] ; module WL' = WiebeLists[l].Over[S'.1,S'.2] ;
 module WM = WiebeMatrices[l].Over[S.1,S.2] ; module WM' = WiebeMatrices[l].Over[S'.1,S'.2] ;
 module WK = WiebeCore[l].Over[S.1,S.2] ; module WK' = WiebeCore[l].Over[S'.1,S'.2] ;
 module DT = Determinant[l].Over[S.1,S.2] ; module DT' = Determinant[l].Over[S'.1,S'.2] ;
 module XM = ExteriorModel[l].Over[S.1] ; module XM' = ExteriorModel[l].Over[S'.1] ;
 module SM = StandardOpens[l].SumMap[S.1,S'.1,h] ;
 module NT = Naturality[l].Over[S.1,S'.1,h] ;
 sub-map (x y : S.1.R) : Id S'.1.R (h.1 (WL.sub x y)) (WL'.sub (h.1 x) (h.1 y)) =
  trans (h.2.2.1 x (S.1.neg y)) (ap (S'.1.add (h.1 x)) (RH.negation S.1 S'.1 h y)) ;
 act-map (n : Nat) (V : DT.Mat n) (a : Ps.Fin n -> S.1.R) (j : Ps.Fin n) :
  Id S'.1.R (h.1 (DT.act n V a j)) (DT'.act n (\ i k -> h.1 (V i k)) (\ i -> h.1 (a i)) j) =
  trans (SM.natural n (\ i -> S.1.mul (a i) (V i j))) (FiniteIdeal[l].Sums[S'.1].sum-cong n (\ i -> h.1 (S.1.mul (a i) (V i j)))
   (\ i -> S'.1.mul (h.1 (a i)) (h.1 (V i j))) (\ i -> h.2.2.2 (a i) (V i j))) ;
 hyp-map (m : Nat) (J : Ps.Fin m -> S.1.R) (n : Nat) (a b : Ps.Fin n -> S.1.R) (V : DT.Mat n) (e : WM.Hyp m J n a b V) :
  WM'.Hyp m (\ i -> h.1 (J i)) n (\ i -> h.1 (a i)) (\ i -> h.1 (b i)) (\ i k -> h.1 (V i k)) = \ j ->
  subst (WL'.In m (\ i -> h.1 (J i))) (trans (sub-map (b j) (DT.act n V a j)) (ap (WL'.sub (h.1 (b j))) (act-map n V a j)))
   (TB.hom-in S S' h m J (WL.sub (b j) (DT.act n V a j)) (e j)) ;
 det-map (n : Nat) (V : DT.Mat n) : Id S'.1.R (XM'.det n (\ i k -> h.1 (V i k))) (h.1 (XM.det n V)) = sym (NT.det-nat n V) ;
 -- (h J, h b, h a) is the image of (J, b, a)
 cat2-map (n : Nat) (a b : Ps.Fin n -> S.1.R) (m : Nat) (J : Ps.Fin m -> S.1.R) (i : Ps.Fin (plus n (plus n m))) :
  Id S'.1.R (h.1 (WL.cat n a (plus n m) (WL.cat n b m J) i))
   (WL'.cat n (\ j -> h.1 (a j)) (plus n m) (WL'.cat n (\ j -> h.1 (b j)) m (\ j -> h.1 (J j))) i) =
  trans (WiebeLists[l].cat-map S S' h n a (plus n m) (WL.cat n b m J) i)
   (ap (\ K -> WL'.cat n (\ j -> h.1 (a j)) (plus n m) K i)
     (F.funext (Ps.Fin (plus n m)) (\ j -> S'.1.R) (\ j -> h.1 (WL.cat n b m J j)) (WL'.cat n (\ j -> h.1 (b j)) m (\ j -> h.1 (J j)))
       (WiebeLists[l].cat-map S S' h n b m J))) ;
 ext-map (n : Nat) (b : Ps.Fin n -> S.1.R) (m : Nat) (J : Ps.Fin m -> S.1.R) (d : S.1.R) (i : Ps.Fin (suc (plus n m))) :
  Id S'.1.R (h.1 (TG.extend S (plus n m) (WL.cat n b m J) d i)) (TG.extend S' (plus n m) (WL'.cat n (\ j -> h.1 (b j)) m (\ j -> h.1 (J j))) (h.1 d) i) =
  trans (TT.map-snoc (Ps.Fin (plus n m)) S.1.R S'.1.R h.1 (WL.cat n b m J) d i)
   (ap (\ K -> TG.extend S' (plus n m) K (h.1 d) i)
     (F.funext (Ps.Fin (plus n m)) (\ j -> S'.1.R) (\ j -> h.1 (WL.cat n b m J j)) (WL'.cat n (\ j -> h.1 (b j)) m (\ j -> h.1 (J j)))
       (WiebeLists[l].cat-map S S' h n b m J))) ;
 -- a membership in (J, b) goes to (h J, h b)
 in-up (n : Nat) (b : Ps.Fin n -> S.1.R) (m : Nat) (J : Ps.Fin m -> S.1.R) (x : S.1.R) (e : WL.In (plus n m) (WL.cat n b m J) x) :
  WL'.In (plus n m) (WL'.cat n (\ j -> h.1 (b j)) m (\ j -> h.1 (J j))) (h.1 x) =
  TB.ini-list S' (plus n m) (\ i -> h.1 (WL.cat n b m J i)) (WL'.cat n (\ j -> h.1 (b j)) m (\ j -> h.1 (J j)))
   (WiebeLists[l].cat-map S S' h n b m J) (h.1 x) (TB.hom-in S S' h (plus n m) (WL.cat n b m J) x e) ;
 -- the conclusions come back along a map with a retraction
 module Down (g : WS.Retract S S' h) (m : Nat) (J : Ps.Fin m -> S.1.R) (n : Nat) (a b : Ps.Fin n -> S.1.R) (d : S.1.R)
  (c : WK'.Concl m (\ i -> h.1 (J i)) n (\ i -> h.1 (a i)) (\ i -> h.1 (b i)) (h.1 d)) {
  perp : WK.Perp m J n a b d = \ x e ->
   WS.down S S' h g (plus n (plus n m)) (WL.cat n a (plus n m) (WL.cat n b m J)) x
    (TB.ini-list S' (plus n (plus n m)) (WL'.cat n (\ j -> h.1 (a j)) (plus n m) (WL'.cat n (\ j -> h.1 (b j)) m (\ j -> h.1 (J j))))
      (\ i -> h.1 (WL.cat n a (plus n m) (WL.cat n b m J) i)) (\ i -> sym (cat2-map n a b m J i)) (h.1 x)
      (c.1 (h.1 x) (subst (WL'.In (plus n m) (WL'.cat n (\ j -> h.1 (b j)) m (\ j -> h.1 (J j)))) (h.2.2.2 x d) (in-up n b m J (S.1.mul x d) e)))) ;
  ann : WK.Ann m J n a b d = \ x k ->
   WS.down S S' h g (suc (plus n m)) (TG.extend S (plus n m) (WL.cat n b m J) d) x
    (TB.ini-list S' (suc (plus n m)) (TG.extend S' (plus n m) (WL'.cat n (\ j -> h.1 (b j)) m (\ j -> h.1 (J j))) (h.1 d))
      (\ i -> h.1 (TG.extend S (plus n m) (WL.cat n b m J) d i)) (\ i -> sym (ext-map n b m J d i)) (h.1 x)
      (c.2 (h.1 x) (\ i -> subst (WL'.In (plus n m) (WL'.cat n (\ j -> h.1 (b j)) m (\ j -> h.1 (J j)))) (h.2.2.2 x (a i))
        (in-up n b m J (S.1.mul x (a i)) (k i))))) ;
  result : WK.Concl m J n a b d = (perp,ann) ;
 } ;
} ;
