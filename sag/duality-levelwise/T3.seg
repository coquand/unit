-- T3.seg (DUALITY.md Tier 3, step 1): the levelwise characterisation of
-- jonas.pdf §6.4.3, as a record over T2's model, statement level.
-- Fields are the conclusions of S3.6 and of Constructions 55-57
-- (P3.3-P3.5, status: stated, proof pending; step 3 proves them from
-- S3.1-S3.5).  Reading (A): fibres are Unit types, and every
-- identification is an equivalence of Unit types or a Unit path.
--
-- Fields: S3.6 (objects of C are R-algebras, maps reversed; an object
-- for each presented algebra), P3.3 (the context of presentations,
-- restriction = change of coefficients u |-> u.h), P3.4 (the fibre of
-- <->_{T/G} at u is the presented algebra X_u, restriction = h+), S3.5
-- (the fibre of G at x is alg x), P3.5 (the fibre of Sp at u is the
-- solutions of u, restriction = h . v; THE CLAUSE: ev at (v , b) is the
-- universal map X_u -> alg x of the solution v, applied to b).
-- Construction 57's intermediate form (solutions) is used for Sp; it is
-- Ret by Points.Points.equivalence.
level l k ;
constraint l <= k ;
open Ring[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module Alg = Algebras[l].Over[R,setR] ;
 module H = RingHom[l] ;
 -- presentations with coefficients in an R-algebra, and change of coefficients
 Pres (A : Alg.Algebra) : U l = Presentations[l].Over[A.ring,A.set].Presentation ;
 change (A B : Alg.Algebra) (h : Alg.Hom A B) (u : Pres A) : Pres B =
  Relative[l].Along[A.ring,A.set,B.ring,B.set,h.1].change u ;
 -- the presented algebra of w over A (chosen by PresentationExistence),
 -- its solutions in A, and the universal map of a solution
 module Pd (A : Alg.Algebra) (w : Pres A) {
  module E = PresentationExistence[l].Over[A.ring,A.set,w] ;
  X : Algebras[l].Over[A.ring,A.set].Algebra = E.A.algebra ;
  px : Presentations[l].Over[A.ring,A.set].Presents w X = E.presentation ;
  module Pt = Points[l].Over[R,setR].Points[A,w,X,px] ;
  Car : U l = X.ring.R ;
  Sol : U l = Pt.PB.Solutions w Pt.self ;
  point (v : Sol) (b : Car) : A.ring.R = ((px.2 Pt.self).sec v).1.1 b ;
 } ;
 -- h+ : X_u -> X_{u.h}, and the restriction of solutions along h
 module Moves (A B : Alg.Algebra) (h : Alg.Hom A B) (u : Pres A) {
  module Sq = RelativeChange[l].Over[R,setR].At[A,B,h,u,Pd[A,u].X,Pd[A,u].px,
   Pd[B,change A B h u].X,Pd[B,change A B h u].px] ;
  up (b : Pd[A,u].Car) : Pd[B,change A B h u].Car = Sq.up.1.1 b ;
  sol (v : Pd[A,u].Sol) : Pd[B,change A B h u].Sol =
   Relative[l].Along[A.ring,A.set,B.ring,B.set,h.1].solutions-up u Pd[B,change A B h u].Pt.self
    (Pd[A,u].Pt.PB.canonical u Pd[A,u].Pt.self v
      (Relative[l].Along[A.ring,A.set,B.ring,B.set,h.1].restrict Pd[B,change A B h u].Pt.self)
      (h.1,\ a -> refl (h.1.1 a))) ;
 } ;
 -- restriction of fibres along a map of C (transport along subT-o)
 module Rf (C : T2[l,k].PCwF) (S : T2[l,k].Site[C]) (G : C.Ctx) (A : C.Ty G) {
  module Pt = T2[l,k].Der[C].Pts[S] ;
  at (y x : S.Ob) (f : S.Hom y x) (g : C.Sub (S.yo x) G) : C.Sub (S.yo y) G =
   C.o (S.yo y) (S.yo x) G g (S.yoH y x f) ;
  res (y x : S.Ob) (f : S.Hom y x) (g : C.Sub (S.yo x) G) (a : Pt.fib G A x g) : Pt.fib G A y (at y x f g) =
   T2[l,k].Der[C].trE (S.yo y) (C.subT (S.yo y) (S.yo x) (C.subT (S.yo x) G A g) (S.yoH y x f))
    (C.subT (S.yo y) G A (at y x f g))
    (Prelude[k].sym (C.Ty (S.yo y)) (C.subT (S.yo y) G A (at y x f g))
      (C.subT (S.yo y) (S.yo x) (C.subT (S.yo x) G A g) (S.yoH y x f)) (C.subT-o (S.yo y) (S.yo x) G A g (S.yoH y x f)))
    (C.subt (S.yo y) (S.yo x) (C.subT (S.yo x) G A g) a (S.yoH y x f)) ;
 } ;
 record T3 (C : T2[l,k].PCwF) (S : T2[l,k].Site[C]) {
  -- S3.6: the objects of C are R-algebras, and maps y -> x are algebra
  -- maps alg x -> alg y (C^op = Mod_{T,kappa})
  alg (x : S.Ob) : Alg.Algebra ;
  homAlg (y x : S.Ob) (f : S.Hom y x) : Alg.Hom (alg x) (alg y) ;
  homAlg-eq (y x : S.Ob) : Pr.isEquiv (S.Hom y x) (Alg.Hom (alg x) (alg y)) (homAlg y x) ;
  homAlg-o (z y x : S.Ob) (f : S.Hom y x) (g : S.Hom z y) (a : (alg x).ring.R) :
   Id (alg z).ring.R ((homAlg z x (S.compH z y x f g)).1.1 a) ((homAlg z y g).1.1 ((homAlg y x f).1.1 a)) ;
  -- P3.3 (ruling 2026-11-10: SYNTACTIC presentations, as in
  -- SAGAxioms.seg): G0 is the context of syntactic presentations
  -- (n : N) * List (Expr_G (Fin n)) of the model; its points at x are
  -- Tier 1's presentations over alg x (premise S3.9: N, List, Expr are
  -- computed levelwise), and restriction along f is u |-> u.(homAlg f).
  -- (jonas.pdf's Construction 55 is the analogue for polynomial
  -- presentations, which have no map back to syntax without choice.)
  G0 : C.Ctx ;
  prs (x : S.Ob) (g : C.Sub (S.yo x) G0) : Pres (alg x) ;
  prs-eq (x : S.Ob) : Pr.isEquiv (C.Sub (S.yo x) G0) (Pres (alg x)) (prs x) ;
  prs-nat (y x : S.Ob) (f : S.Hom y x) (g : C.Sub (S.yo x) G0) :
   Id (Pres (alg y)) (prs y (C.o (S.yo y) (S.yo x) G0 g (S.yoH y x f)))
    (change (alg x) (alg y) (homAlg y x f) (prs x g)) ;
  -- S3.6: an object of C for each presented algebra X_u, with p_u
  obj (x : S.Ob) (u : Pres (alg x)) : S.Ob ;
  objHom (x : S.Ob) (u : Pres (alg x)) : S.Hom (obj x u) x ;
  objIso (x : S.Ob) (u : Pres (alg x)) : Alg.Hom (Relative[l].Over[R,setR].Under[alg x].total Pd[alg x,u].X) (alg (obj x u)) ;
  objInv (x : S.Ob) (u : Pres (alg x)) : Alg.Hom (alg (obj x u)) (Relative[l].Over[R,setR].Under[alg x].total Pd[alg x,u].X) ;
  objInv-l (x : S.Ob) (u : Pres (alg x)) (b : Pd[alg x,u].Car) : Id Pd[alg x,u].Car ((objInv x u).1.1 ((objIso x u).1.1 b)) b ;
  objInv-r (x : S.Ob) (u : Pres (alg x)) (c : (alg (obj x u)).ring.R) :
   Id (alg (obj x u)).ring.R ((objIso x u).1.1 ((objInv x u).1.1 c)) c ;
  objHom-p (x : S.Ob) (u : Pres (alg x)) (a : (alg x).ring.R) :
   Id (alg (obj x u)).ring.R ((homAlg (obj x u) x (objHom x u)).1.1 a) ((objIso x u).1.1 (Pd[alg x,u].X.iota.1 a)) ;
  -- P3.4: the type <->_{T/G} over G0
  Br : C.Ty G0 ;
  brE (x : S.Ob) (g : C.Sub (S.yo x) G0) :
   Pr.Equiv (T2[l,k].Der[C].Pts[S].fib G0 Br x g) Pd[alg x,prs x g].Car ;
  brE-nat (y x : S.Ob) (f : S.Hom y x) (g : C.Sub (S.yo x) G0) (b : T2[l,k].Der[C].Pts[S].fib G0 Br x g) :
   Id Pd[alg y,prs y (Rf[C,S,G0,Br].at y x f g)].Car
    ((brE y (Rf[C,S,G0,Br].at y x f g)).1 (Rf[C,S,G0,Br].res y x f g b))
    (Pr.subst (Pres (alg y)) (\ w -> Pd[alg y,w].Car)
      (change (alg x) (alg y) (homAlg y x f) (prs x g)) (prs y (Rf[C,S,G0,Br].at y x f g))
      (Pr.sym (Pres (alg y)) _ _ (prs-nat y x f g))
      (Moves[alg x,alg y,homAlg y x f,prs x g].up ((brE x g).1 b))) ;
  -- S3.5: the type G over G0 (weakened from the closed G)
  Gt : C.Ty G0 ;
  gE (x : S.Ob) (g : C.Sub (S.yo x) G0) : Pr.Equiv (T2[l,k].Der[C].Pts[S].fib G0 Gt x g) (alg x).ring.R ;
  gE-nat (y x : S.Ob) (f : S.Hom y x) (g : C.Sub (S.yo x) G0) (c : T2[l,k].Der[C].Pts[S].fib G0 Gt x g) :
   Id (alg y).ring.R ((gE y (Rf[C,S,G0,Gt].at y x f g)).1 (Rf[C,S,G0,Gt].res y x f g c))
    ((homAlg y x f).1.1 ((gE x g).1 c)) ;
  -- P3.5: the type Sp over G0
  Sp : C.Ty G0 ;
  spE (x : S.Ob) (g : C.Sub (S.yo x) G0) :
   Pr.Equiv (T2[l,k].Der[C].Pts[S].fib G0 Sp x g) Pd[alg x,prs x g].Sol ;
  spE-nat (y x : S.Ob) (f : S.Hom y x) (g : C.Sub (S.yo x) G0) (c : T2[l,k].Der[C].Pts[S].fib G0 Sp x g) :
   Id Pd[alg y,prs y (Rf[C,S,G0,Sp].at y x f g)].Sol
    ((spE y (Rf[C,S,G0,Sp].at y x f g)).1 (Rf[C,S,G0,Sp].res y x f g c))
    (Pr.subst (Pres (alg y)) (\ w -> Pd[alg y,w].Sol)
      (change (alg x) (alg y) (homAlg y x f) (prs x g)) (prs y (Rf[C,S,G0,Sp].at y x f g))
      (Pr.sym (Pres (alg y)) _ _ (prs-nat y x f g))
      (Moves[alg x,alg y,homAlg y x f,prs x g].sol ((spE x g).1 c))) ;
  -- P3.5: the evaluation map, over G0.Sp, and THE CLAUSE
  ev : T2[l,k].Der[C].Map (C.ext G0 Sp) (C.subT (C.ext G0 Sp) G0 Br (C.p G0 Sp)) (C.subT (C.ext G0 Sp) G0 Gt (C.p G0 Sp)) ;
  ev-clause (x : S.Ob) (g : C.Sub (S.yo x) G0) (c : T2[l,k].Der[C].Pts[S].fib G0 Sp x g)
   (b : T2[l,k].Der[C].Pts[S].fib G0 Br x g) :
   Id (alg x).ring.R
    ((gE x g).1 (T2[l,k].Der[C].trE (S.yo x) _ _ (T2[l,k].Der[C].wkp (S.yo x) G0 Sp Gt g c)
      (T2[l,k].Der[C].Pts[S].onFib (C.ext G0 Sp) (C.subT (C.ext G0 Sp) G0 Br (C.p G0 Sp)) (C.subT (C.ext G0 Sp) G0 Gt (C.p G0 Sp))
        ev x (C.pair (S.yo x) G0 Sp g c)
        (T2[l,k].Der[C].trE (S.yo x) _ _ (Prelude[k].sym (C.Ty (S.yo x)) _ _ (T2[l,k].Der[C].wkp (S.yo x) G0 Sp Br g c)) b))))
    (Pd[alg x,prs x g].point ((spE x g).1 c) ((brE x g).1 b)) ;
 } ;
} ;
