-- T3.seg (DUALITY.md Tier 3, step 1): the levelwise characterisation of
-- jonas.pdf §6.4.3, as a record over T2's model, statement level.
-- Fields are the conclusions of S3.6 and of Constructions 55-57
-- (P3.3-P3.5, status: stated, proof pending; step 3 proves them from
-- S3.1-S3.5).  Reading (A): fibres are Unit types, and every
-- identification is an equivalence of Unit types or a Unit path.
--
-- So far: S3.6 (objects of C are R-algebras, maps reversed) and P3.3
-- (the context of presentations, with restriction acting as change of
-- coefficients u |-> u.h).
level l k ;
constraint l <= k ;
open Ring[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module Alg = Algebras[l].Over[R,setR] ;
 module H = RingHom[l] ;
 -- presentations with coefficients in an R-algebra, and change of coefficients
 Pres (A : Alg.Algebra) : U l = Presentations[l].Over[A.ring,A.set].Presentation ;
 change (A B : Alg.Algebra) (h : Alg.Hom A B) (u : Pres A) : Pres B =
  Relative[l].Along[A.ring,A.set,B.ring,B.set,h.1].change u ;
 record T3 (C : T2[l,k].PCwF) (S : T2[l,k].Site[C]) {
  -- S3.6: the objects of C are R-algebras, and maps y -> x are algebra
  -- maps alg x -> alg y (C^op = Mod_{T,kappa})
  alg (x : S.Ob) : Alg.Algebra ;
  homAlg (y x : S.Ob) (f : S.Hom y x) : Alg.Hom (alg x) (alg y) ;
  homAlg-eq (y x : S.Ob) : Pr.isEquiv (S.Hom y x) (Alg.Hom (alg x) (alg y)) (homAlg y x) ;
  -- P3.3: the context 1.Pr_{T/G,Dkappa}; its points at x are the
  -- presentations over alg x, and restriction along f is u |-> u.(homAlg f)
  G0 : C.Ctx ;
  prs (x : S.Ob) (g : C.Sub (S.yo x) G0) : Pres (alg x) ;
  prs-eq (x : S.Ob) : Pr.isEquiv (C.Sub (S.yo x) G0) (Pres (alg x)) (prs x) ;
  prs-nat (y x : S.Ob) (f : S.Hom y x) (g : C.Sub (S.yo x) G0) :
   Id (Pres (alg y)) (prs y (C.o (S.yo y) (S.yo x) G0 g (S.yoH y x f)))
    (change (alg x) (alg y) (homAlg y x f) (prs x g)) ;
 } ;
} ;
