-- Transfer2.seg: DUALITY.md Tier 3 step 3, presented models (canonicity-45).
-- Lemma 52 / Corollary 53 for presented models, at the level of the
-- underlying algebras: for a presentation w over the ring K_G of global
-- elements, U of the presented model <w> is, at every point (x , g), the
-- Tier 1 presented algebra of w moved along kappa_{x,g} : K_G -> base(x , g).
-- This is the form of P3.4's brE (for a fixed global w; the variable
-- presentation of 1.Pr is Construction 55/56, P3.3).
--
--   FamB      the concrete category E: families over the points of G of
--             algebras over a family of base rings, pointwise homs; fibEq
--   ModelD    S3.1 / S3.2 at the level of models (premises): the
--             adjunction, the underlying K-algebra ElD of a D-model, R b's
--             elements are the tuples of elements of b (pi, joint-eq,
--             natural), presented models with their universal property
--   PresTr    Phi_D = Solutions(w , ElD -), Phi_E = pointwise solutions of
--             the moved presentations; kap : Phi_D o R = Phi_E (proved);
--             the family X of Tier 1 presented algebras represents Phi_E;
--             so U <w> = X (TrIso) and fibrewise (fibEq): brEq.
-- Informal proof of kap-eq: a solution in ElD (R b) gives, through each
-- pi_{x,g}, a solution in b x g (canonical along pi, then solutions-up).
-- Conversely pointwise solutions t give a = joint^-1 (t . 1); the equations
-- hold in ElD (R b) because they hold after every pi_{x,g} and the joint
-- map is injective (zeros-reflect).

level l k ;
constraint l+ <= k ;
open Base ;
open Prelude[k] ;

-- an equivalence of l-types read at level k
toK (A B : U l) (f : A -> B) (e : Prelude[l].isEquiv A B f) : isEquiv A B f =
 qinv A B f e.sec e.sec-eq (\ a -> Prelude[l].sec-ret A B f e a) ;

module FE = Axioms[l].FunExtLemmas[fe @l] ;

-- pointwise equivalences on a doubly indexed family give an equivalence
piEq2 (I : U l) (J : I -> U l) (P Q : (i : I) -> J i -> U l) (f : (i : I) (j : J i) -> P i j -> Q i j)
 (e : (i : I) (j : J i) -> isEquiv (P i j) (Q i j) (f i j))
 : isEquiv ((i : I) (j : J i) -> P i j) ((i : I) (j : J i) -> Q i j) (\ h i j -> f i j (h i j)) =
 qinv ((i : I) (j : J i) -> P i j) ((i : I) (j : J i) -> Q i j) (\ h i j -> f i j (h i j)) (\ t i j -> (e i j).sec (t i j))
  (\ t -> FE.funext I (\ i -> (j : J i) -> Q i j) (\ i j -> f i j ((e i j).sec (t i j))) t (\ i ->
          FE.funext (J i) (\ j -> Q i j) (\ j -> f i j ((e i j).sec (t i j))) (t i) (\ j -> (e i j).sec-eq (t i j))))
  (\ h -> FE.funext I (\ i -> (j : J i) -> P i j) (\ i j -> (e i j).sec (f i j (h i j))) h (\ i ->
          FE.funext (J i) (\ j -> P i j) (\ j -> (e i j).sec (f i j (h i j))) (h i) (\ j -> sec-ret (P i j) (Q i j) (f i j) (e i j) (h i j)))) ;

------------------------------------------------------------------------
-- the concrete category E

module FamB (C : T2[l,k].PCwF) (S : T2[l,k].Site[C]) (G : C.Ctx)
 (bs : (x : S.Ob) -> C.Sub (S.yo x) G -> (Rb : Ring[l].CRing) * Prelude[l].isSet Rb.R) {
 AlgAt (x : S.Ob) (g : C.Sub (S.yo x) G) : U k = Algebras[l].Over[(bs x g).1, (bs x g).2].Algebra ;
 Ob : U k = (x : S.Ob) (g : C.Sub (S.yo x) G) -> AlgAt x g ;
 Hm (F F' : Ob) : U l = (x : S.Ob) (g : C.Sub (S.yo x) G) -> Algebras[l].Over[(bs x g).1, (bs x g).2].Hom (F x g) (F' x g) ;
 idm (F : Ob) : Hm F F = \ x g -> Algebras[l].Over[(bs x g).1, (bs x g).2].identity (F x g) ;
 comp (F F' F'' : Ob) (b : Hm F' F'') (a : Hm F F') : Hm F F'' =
  \ x g -> Algebras[l].Over[(bs x g).1, (bs x g).2].compose (F x g) (F' x g) (F'' x g) (b x g) (a x g) ;

 hext (F F' : Ob) (a b : Hm F F') (p : (x : S.Ob) (g : C.Sub (S.yo x) G) (z : (F x g).ring.R) -> Id (F' x g).ring.R ((a x g).1.1 z) ((b x g).1.1 z))
  : Id (Hm F F') a b =
  FE.funext S.Ob (\ x -> (g : C.Sub (S.yo x) G) -> Algebras[l].Over[(bs x g).1, (bs x g).2].Hom (F x g) (F' x g)) a b (\ x ->
  FE.funext (C.Sub (S.yo x) G) (\ g -> Algebras[l].Over[(bs x g).1, (bs x g).2].Hom (F x g) (F' x g)) (a x) (b x) (\ g ->
  Algebras[l].Over[(bs x g).1, (bs x g).2].ext (F x g) (F' x g) (a x g) (b x g) (p x g))) ;

 homSet (x : S.Ob) (g : C.Sub (S.yo x) G) (A B : AlgAt x g) : Prelude[l].isSet (Algebras[l].Over[(bs x g).1, (bs x g).2].Hom A B) =
  Prelude[l].isSet-Sigma (RingHom[l].Hom A.ring B.ring) (Algebras[l].Over[(bs x g).1, (bs x g).2].Commutes A B) (RingHom[l].Properties[A.ring, B.ring, B.set].set)
   (\ h -> Prelude[l].prop-to-set (Algebras[l].Over[(bs x g).1, (bs x g).2].Commutes A B h) (Algebras[l].Over[(bs x g).1, (bs x g).2].commutes-prop A B h)) ;

 cat : Transfer[l,k].WCat = new Transfer[l,k].WCat[
  Ob := Ob, Hom := Hm, idm := idm, comp := comp,
  idl := \ F F' a -> hext F F' (comp F F' F' (idm F') a) a (\ x g z -> refl ((a x g).1.1 z)),
  idr := \ F F' a -> hext F F' (comp F F F' a (idm F)) a (\ x g z -> refl ((a x g).1.1 z)),
  assoc := \ F1 F2 F3 F4 c b a -> hext F1 F4 (comp F1 F2 F4 (comp F2 F3 F4 c b) a) (comp F1 F3 F4 c (comp F1 F2 F3 b a))
    (\ x g z -> refl ((c x g).1.1 ((b x g).1.1 ((a x g).1.1 z)))),
  hset := \ F F' -> FE.isSet-Pi S.Ob (\ x -> (g : C.Sub (S.yo x) G) -> Algebras[l].Over[(bs x g).1, (bs x g).2].Hom (F x g) (F' x g)) (\ x ->
    FE.isSet-Pi (C.Sub (S.yo x) G) (\ g -> Algebras[l].Over[(bs x g).1, (bs x g).2].Hom (F x g) (F' x g)) (\ g -> homSet x g (F x g) (F' x g)))] ;

 -- an isomorphism of families is, at every point, an equivalence of the
 -- underlying sets (the fibres)
 fibEq (F F' : Ob) (u : Hm F F') (v : Hm F' F)
  (vu : Id (Hm F F) (comp F F' F v u) (idm F)) (uv : Id (Hm F' F') (comp F' F F' u v) (idm F'))
  (x : S.Ob) (g : C.Sub (S.yo x) G) : Prelude[l].isEquiv (F x g).ring.R (F' x g).ring.R (u x g).1.1 =
  Prelude[l].qinv (F x g).ring.R (F' x g).ring.R (u x g).1.1 (v x g).1.1
   (\ z -> Prelude[l].happly (F' x g).ring.R (\ w -> (F' x g).ring.R) (\ w -> (u x g).1.1 ((v x g).1.1 w)) (\ w -> w)
      (ap (Hm F' F') ((F' x g).ring.R -> (F' x g).ring.R) (\ m -> (m x g).1.1) (comp F' F F' u v) (idm F') uv) z)
   (\ z -> Prelude[l].happly (F x g).ring.R (\ w -> (F x g).ring.R) (\ w -> (v x g).1.1 ((u x g).1.1 w)) (\ w -> w)
      (ap (Hm F F) ((F x g).ring.R -> (F x g).ring.R) (\ m -> (m x g).1.1) (comp F F' F v u) (idm F) vu) z) ;
} ;

------------------------------------------------------------------------
-- equations reflected by a jointly injective family of algebra maps

module ZR (K : Ring[l].CRing) (setK : Prelude[l].isSet K.R) (I : U l) (J : I -> U l)
 (A : Algebras[l].Over[K,setK].Algebra) (Bf : (i : I) -> J i -> Algebras[l].Over[K,setK].Algebra)
 (pi : (i : I) (j : J i) -> Algebras[l].Over[K,setK].Hom A (Bf i j))
 (inj : (z z' : A.ring.R) -> ((i : I) (j : J i) -> Id (Bf i j).ring.R ((pi i j).1.1 z) ((pi i j).1.1 z')) -> Id A.ring.R z z')
 (V : U l) (a : V -> A.ring.R) {
 module PK = Presentations[l].Over[K,setK] ;
 refl-zeros : (es : PK.Equations V) -> ((i : I) (j : J i) -> PK.Zeros V (Bf i j) (\ v -> (pi i j).1.1 (a v)) es) -> PK.Zeros V A a es = split {
  nil -> \ h -> tt ;
  cons e es | r -> \ h ->
   (inj (PK.eval V A a e) A.ring.z (\ i j ->
      trans (Bf i j).ring.R ((pi i j).1.1 (PK.eval V A a e)) (PK.eval V (Bf i j) (\ v -> (pi i j).1.1 (a v)) e) ((pi i j).1.1 A.ring.z)
        (PK.natural V A (Bf i j) (pi i j) a e)
        (trans (Bf i j).ring.R (PK.eval V (Bf i j) (\ v -> (pi i j).1.1 (a v)) e) (Bf i j).ring.z ((pi i j).1.1 A.ring.z)
           (h i j).1 (sym (Bf i j).ring.R ((pi i j).1.1 A.ring.z) (Bf i j).ring.z (RingHom[l].zero A.ring (Bf i j).ring (pi i j).1)))),
    r (\ i j -> (h i j).2)) } ;
} ;

------------------------------------------------------------------------
-- S3.1 / S3.2 at the level of models (premises)

record ModelD (C : T2[l,k].PCwF) (S : T2[l,k].Site[C]) (G : C.Ctx)
 (bs : (x : S.Ob) -> C.Sub (S.yo x) G -> (Rb : Ring[l].CRing) * Prelude[l].isSet Rb.R)
 (K : Ring[l].CRing) (setK : Prelude[l].isSet K.R)
 (kp : (x : S.Ob) (g : C.Sub (S.yo x) G) -> RingHom[l].Hom K (bs x g).1)
 (D : Transfer[l,k].WCat) (Ad : Transfer[l,k].Adj[D, FamB[C,S,G,bs].cat]) {
 -- the underlying K-algebra of a model, functorial
 ElD (a : D.Ob) : Algebras[l].Over[K,setK].Algebra ;
 ElDm (a a' : D.Ob) (f : D.Hom a a') : Algebras[l].Over[K,setK].Hom (ElD a) (ElD a') ;
 ElDm-id (a : D.Ob) (z : (ElD a).ring.R) : Id (ElD a).ring.R ((ElDm a a (D.idm a)).1.1 z) z ;
 ElDm-o (a a' a'' : D.Ob) (f' : D.Hom a' a'') (f : D.Hom a a') (z : (ElD a).ring.R)
  : Id (ElD a'').ring.R ((ElDm a a'' (D.comp a a' a'' f' f)).1.1 z) ((ElDm a' a'' f').1.1 ((ElDm a a' f).1.1 z)) ;
 -- Remark 7 at models: the elements of R b are the tuples of elements of b
 pi (b : FamB[C,S,G,bs].Ob) (x : S.Ob) (g : C.Sub (S.yo x) G)
  : Algebras[l].Over[K,setK].Hom (ElD (Ad.Ro b)) (Relative[l].Along[K,setK,(bs x g).1,(bs x g).2,kp x g].restrict (b x g)) ;
 joint-eq (b : FamB[C,S,G,bs].Ob)
  : Prelude[l].isEquiv (ElD (Ad.Ro b)).ring.R ((x : S.Ob) (g : C.Sub (S.yo x) G) -> (b x g).ring.R) (\ z x g -> (pi b x g).1.1 z) ;
 pi-nat (b b' : FamB[C,S,G,bs].Ob) (h : FamB[C,S,G,bs].Hm b b') (z : (ElD (Ad.Ro b)).ring.R) (x : S.Ob) (g : C.Sub (S.yo x) G)
  : Id (b' x g).ring.R ((pi b' x g).1.1 ((ElDm (Ad.Ro b) (Ad.Ro b') (Ad.Rm b b' h)).1.1 z)) ((h x g).1.1 ((pi b x g).1.1 z)) ;
 -- presented models (S3.2; free models are those with no equations)
 pm (w : Presentations[l].Over[K,setK].Presentation) : D.Ob ;
 pe (w : Presentations[l].Over[K,setK].Presentation) : Presentations[l].Over[K,setK].Solutions w (ElD (pm w)) ;
 pr (w : Presentations[l].Over[K,setK].Presentation) (a : D.Ob)
  : isEquiv (D.Hom (pm w) a) (Presentations[l].Over[K,setK].Solutions w (ElD a))
     (\ h -> Presentations[l].Over[K,setK].canonical w (ElD (pm w)) (pe w) (ElD a) (ElDm (pm w) a h)) ;
} ;

------------------------------------------------------------------------
-- Lemma 52 / Corollary 53 for a presented model

module PresTr (C : T2[l,k].PCwF) (S : T2[l,k].Site[C]) (G : C.Ctx)
 (bs : (x : S.Ob) -> C.Sub (S.yo x) G -> (Rb : Ring[l].CRing) * Prelude[l].isSet Rb.R)
 (K : Ring[l].CRing) (setK : Prelude[l].isSet K.R)
 (kp : (x : S.Ob) (g : C.Sub (S.yo x) G) -> RingHom[l].Hom K (bs x g).1)
 (D : Transfer[l,k].WCat) (Ad : Transfer[l,k].Adj[D, FamB[C,S,G,bs].cat])
 (MD : ModelD[C,S,G,bs,K,setK,kp,D,Ad]) (w : Presentations[l].Over[K,setK].Presentation) {
 module FB = FamB[C,S,G,bs] ;
 module PK = Presentations[l].Over[K,setK] ;

 -- w moved to the base at (x , g)
 wxg (x : S.Ob) (g : C.Sub (S.yo x) G) : Presentations[l].Over[(bs x g).1,(bs x g).2].Presentation =
  Relative[l].Along[K,setK,(bs x g).1,(bs x g).2,kp x g].change w ;

 -- Phi_D = solutions of w in the underlying K-algebra
 SolD : Transfer[l,k].CoFun[D] = new Transfer[l,k].CoFun[D,
  F := \ a -> PK.Solutions w (MD.ElD a),
  fmap := \ a a' h s -> PK.canonical w (MD.ElD a) s (MD.ElD a') (MD.ElDm a a' h),
  fid := \ a s -> PK.solutions-ext w (MD.ElD a) (PK.canonical w (MD.ElD a) s (MD.ElD a) (MD.ElDm a a (D.idm a))) s (\ v -> MD.ElDm-id a (s.1 v)),
  fcomp := \ a a' a'' h' h s -> PK.solutions-ext w (MD.ElD a'')
    (PK.canonical w (MD.ElD a) s (MD.ElD a'') (MD.ElDm a a'' (D.comp a a' a'' h' h)))
    (PK.canonical w (MD.ElD a') (PK.canonical w (MD.ElD a) s (MD.ElD a') (MD.ElDm a a' h)) (MD.ElD a'') (MD.ElDm a' a'' h'))
    (\ v -> MD.ElDm-o a a' a'' h' h (s.1 v))] ;

 -- Phi_E = pointwise solutions of the moved presentations
 FE' (b : FB.Ob) : U l = (x : S.Ob) (g : C.Sub (S.yo x) G) -> Presentations[l].Over[(bs x g).1,(bs x g).2].Solutions (wxg x g) (b x g) ;

 fmapE (b b' : FB.Ob) (h : FB.Hm b b') (t : FE' b) : FE' b' =
  \ x g -> Presentations[l].Over[(bs x g).1,(bs x g).2].canonical (wxg x g) (b x g) (t x g) (b' x g) (h x g) ;

 eqE (b : FB.Ob) (t t' : FE' b)
  (h : (x : S.Ob) (g : C.Sub (S.yo x) G) (v : Presentations[l].Fin (wxg x g).1) -> Id (b x g).ring.R ((t x g).1 v) ((t' x g).1 v)) : Id (FE' b) t t' =
  FE.funext S.Ob (\ x -> (g : C.Sub (S.yo x) G) -> Presentations[l].Over[(bs x g).1,(bs x g).2].Solutions (wxg x g) (b x g)) t t' (\ x ->
  FE.funext (C.Sub (S.yo x) G) (\ g -> Presentations[l].Over[(bs x g).1,(bs x g).2].Solutions (wxg x g) (b x g)) (t x) (t' x) (\ g ->
  Presentations[l].Over[(bs x g).1,(bs x g).2].solutions-ext (wxg x g) (b x g) (t x g) (t' x g) (h x g))) ;

 SolE : Transfer[l,k].CoFun[FB.cat] = new Transfer[l,k].CoFun[FB.cat,
  F := FE', fmap := fmapE,
  fid := \ b t -> eqE b (fmapE b b (FB.idm b) t) t (\ x g v -> refl ((t x g).1 v)),
  fcomp := \ b b' b'' h' h t -> eqE b'' (fmapE b b'' (FB.comp b b' b'' h' h) t) (fmapE b' b'' h' (fmapE b b' h t))
    (\ x g v -> refl ((h' x g).1.1 ((h x g).1.1 ((t x g).1 v))))] ;

 ------------------------------------------------------------------
 -- the comparison Phi_D o R = Phi_E

 kap (b : FB.Ob) (s : PK.Solutions w (MD.ElD (Ad.Ro b))) : FE' b =
  \ x g -> Relative[l].Along[K,setK,(bs x g).1,(bs x g).2,kp x g].solutions-up w (b x g)
   (PK.canonical w (MD.ElD (Ad.Ro b)) s (Relative[l].Along[K,setK,(bs x g).1,(bs x g).2,kp x g].restrict (b x g)) (MD.pi b x g)) ;

 module Inv (b : FB.Ob) (t : FE' b) {
  je : Prelude[l].isEquiv (MD.ElD (Ad.Ro b)).ring.R ((x : S.Ob) (g : C.Sub (S.yo x) G) -> (b x g).ring.R) (\ z x g -> (MD.pi b x g).1.1 z) = MD.joint-eq b ;
  av (v : Presentations[l].Fin w.1) : (MD.ElD (Ad.Ro b)).ring.R = je.sec (\ x g -> (t x g).1 v) ;
  -- pi (av v) = t v
  pav (x : S.Ob) (g : C.Sub (S.yo x) G) (v : Presentations[l].Fin w.1) : Id (b x g).ring.R ((MD.pi b x g).1.1 (av v)) ((t x g).1 v) =
   Prelude[l].happly (C.Sub (S.yo x) G) (\ g' -> (b x g').ring.R) (\ g' -> (MD.pi b x g').1.1 (av v)) (\ g' -> (t x g').1 v)
    (Prelude[l].happly S.Ob (\ x' -> (g' : C.Sub (S.yo x') G) -> (b x' g').ring.R)
       (\ x' g' -> (MD.pi b x' g').1.1 (av v)) (\ x' g' -> (t x' g').1 v) (je.sec-eq (\ x' g' -> (t x' g').1 v)) x) g ;
  inj (z z' : (MD.ElD (Ad.Ro b)).ring.R) (h : (x : S.Ob) (g : C.Sub (S.yo x) G) -> Id (b x g).ring.R ((MD.pi b x g).1.1 z) ((MD.pi b x g).1.1 z'))
   : Id (MD.ElD (Ad.Ro b)).ring.R z z' =
   Equivalences[l].injective (MD.ElD (Ad.Ro b)).ring.R ((x : S.Ob) (g : C.Sub (S.yo x) G) -> (b x g).ring.R) (\ z2 x g -> (MD.pi b x g).1.1 z2) je z z'
    (FE.funext S.Ob (\ x -> (g : C.Sub (S.yo x) G) -> (b x g).ring.R) (\ x g -> (MD.pi b x g).1.1 z) (\ x g -> (MD.pi b x g).1.1 z') (\ x ->
     FE.funext (C.Sub (S.yo x) G) (\ g -> (b x g).ring.R) (\ g -> (MD.pi b x g).1.1 z) (\ g -> (MD.pi b x g).1.1 z') (\ g -> h x g))) ;
  -- the equations hold after each pi
  zt (x : S.Ob) (g : C.Sub (S.yo x) G)
   : PK.Zeros (Presentations[l].Fin w.1) (Relative[l].Along[K,setK,(bs x g).1,(bs x g).2,kp x g].restrict (b x g)) (\ v -> (MD.pi b x g).1.1 (av v)) w.2 =
   Prelude[l].subst (Presentations[l].Fin w.1 -> (b x g).ring.R)
    (\ a2 -> PK.Zeros (Presentations[l].Fin w.1) (Relative[l].Along[K,setK,(bs x g).1,(bs x g).2,kp x g].restrict (b x g)) a2 w.2)
    (\ v -> (t x g).1 v) (\ v -> (MD.pi b x g).1.1 (av v))
    (FE.funext (Presentations[l].Fin w.1) (\ v -> (b x g).ring.R) (\ v -> (t x g).1 v) (\ v -> (MD.pi b x g).1.1 (av v))
       (\ v -> Prelude[l].sym (b x g).ring.R ((MD.pi b x g).1.1 (av v)) ((t x g).1 v) (pav x g v)))
    (Relative[l].Along[K,setK,(bs x g).1,(bs x g).2,kp x g].zeros-down (Presentations[l].Fin w.1) (b x g) (t x g).1 w.2 (t x g).2) ;
  sol : PK.Solutions w (MD.ElD (Ad.Ro b)) =
   (av, ZR[K, setK, S.Ob, \ x -> C.Sub (S.yo x) G, MD.ElD (Ad.Ro b),
         \ x g -> Relative[l].Along[K,setK,(bs x g).1,(bs x g).2,kp x g].restrict (b x g), MD.pi b, inj, Presentations[l].Fin w.1, av].refl-zeros w.2 zt) ;
 } ;

 kap-eq (b : FB.Ob) : isEquiv (PK.Solutions w (MD.ElD (Ad.Ro b))) (FE' b) (kap b) =
  qinv (PK.Solutions w (MD.ElD (Ad.Ro b))) (FE' b) (kap b) (\ t -> Inv[b,t].sol)
   (\ t -> eqE b (kap b Inv[b,t].sol) t (\ x g v -> Inv[b,t].pav x g v))
   (\ s -> PK.solutions-ext w (MD.ElD (Ad.Ro b)) Inv[b, kap b s].sol s
      (\ v -> Prelude[l].sec-ret (MD.ElD (Ad.Ro b)).ring.R ((x : S.Ob) (g : C.Sub (S.yo x) G) -> (b x g).ring.R)
                (\ z x g -> (MD.pi b x g).1.1 z) (MD.joint-eq b) (s.1 v))) ;

 kap-nat (b b' : FB.Ob) (h : FB.Hm b b') (s : PK.Solutions w (MD.ElD (Ad.Ro b)))
  : Id (FE' b') (kap b' (SolD.fmap (Ad.Ro b) (Ad.Ro b') (Ad.Rm b b' h) s)) (fmapE b b' h (kap b s)) =
  eqE b' (kap b' (SolD.fmap (Ad.Ro b) (Ad.Ro b') (Ad.Rm b b' h) s)) (fmapE b b' h (kap b s))
   (\ x g v -> MD.pi-nat b b' h (s.1 v) x g) ;

 ------------------------------------------------------------------
 -- the family of Tier 1 presented algebras represents Phi_E

 X : FB.Ob = \ x g -> PresentationExistence[l].Over[(bs x g).1,(bs x g).2,wxg x g].A.algebra ;
 eX : FE' X = \ x g -> (PresentationExistence[l].Over[(bs x g).1,(bs x g).2,wxg x g].presentation).1 ;
 rX : Transfer[l,k].Repr FB.cat SolE X eX = \ b ->
  piEq2 S.Ob (\ x -> C.Sub (S.yo x) G)
   (\ x g -> Algebras[l].Over[(bs x g).1,(bs x g).2].Hom (X x g) (b x g))
   (\ x g -> Presentations[l].Over[(bs x g).1,(bs x g).2].Solutions (wxg x g) (b x g))
   (\ x g h -> Presentations[l].Over[(bs x g).1,(bs x g).2].canonical (wxg x g) (X x g) (eX x g) (b x g) h)
   (\ x g -> toK (Algebras[l].Over[(bs x g).1,(bs x g).2].Hom (X x g) (b x g))
                 (Presentations[l].Over[(bs x g).1,(bs x g).2].Solutions (wxg x g) (b x g))
                 (\ h -> Presentations[l].Over[(bs x g).1,(bs x g).2].canonical (wxg x g) (X x g) (eX x g) (b x g) h)
                 ((PresentationExistence[l].Over[(bs x g).1,(bs x g).2,wxg x g].presentation).2 (b x g))) ;

 ------------------------------------------------------------------
 -- U <w> = X, and fibrewise

 module TI = Transfer[l,k].TrIso[D, FB.cat, Ad, SolD, SolE, kap, kap-eq, kap-nat, MD.pm w, MD.pe w, MD.pr w, X, eX, rX] ;

 -- the fibre of U <w> at (x , g) is the presented algebra of w_{x,g}
 brEq (x : S.Ob) (g : C.Sub (S.yo x) G)
  : Prelude[l].isEquiv ((Ad.Uo (MD.pm w)) x g).ring.R (X x g).ring.R ((TI.to x g).1.1) =
  FB.fibEq (Ad.Uo (MD.pm w)) X TI.to TI.from TI.from-to TI.to-from x g ;
} ;
