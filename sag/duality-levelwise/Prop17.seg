-- Prop17.seg (canonicity-45): jonas.pdf Prop 17, proved (formerly the
-- premise S2.6).  For fibrant D-modal A , B over G and m : A -> B:
--   prop17     : m a levelwise equivalence  =>  IsEqT m
--   prop17-inv : IsEqT m  =>  m a levelwise equivalence
-- prop17-inv is post-eq at the points.  prop17 uses the closure premise
-- isoT (an iso is an equivalence) and Lemma 67, so it still rests on
-- Prop 13 (D-eq), as the paper's proof does.
--
-- Informal proof of prop17.
-- (1) e = (p_A , m) : G.A -> G.B is a levelwise equivalence: on points
--     it is, through extEquiv, the Sigma-map of the fibrewise
--     equivalences onFib m (pairO, pair-eta).
-- (2) Lemma 67 for e and A[p_B]: restriction El(G.B , A[p_B]) ->
--     El(G.A , A[p_B][e]) is an equivalence; n is the preimage of q_A.
--     Then n . m = n restricted along (p_A , m) = e, which is q_A.
-- (3) Lemma 67 for e and B[p_B]: restriction along e is injective there;
--     m . n and q_B both restrict to m (postNat, pairO, postPath and the
--     identity law subt-id; qvPair), so m . n = q_B.
-- (4) isoT.
level l k ;
constraint l <= k ;
open Base ;
open Prelude[k] ;

module P17 (C : T2[l,k].PCwF) (S : T2[l,k].Site[C]) (Dd : T2[l,k].DS[C,S]) {
 module DR = T2[l,k].Der[C] ;
 module Pt = DR.Pts[S] ;
 module TX = TE[l,k].TEm[C] ;
 module PN = OnFibNat[l,k].PN[C] ;
 module L67 = Lemma67[l,k].L67[C,S,Dd] ;

 -- the inverse of an equivalence
 invE (X Y : U l) (e : Equiv X Y) : Equiv Y X =
  (e.2.sec, qinv Y X e.2.sec e.1 (sec-ret X Y e.1 e.2) e.2.sec-eq) ;

 prop17-inv (G : C.Ctx) (A B : C.Ty G) (m : DR.Map G A B) (ie : Dd.IsEqT G A B m) : Pt.LEqT G A B m =
  \ x g -> Dd.post-eq (S.yo x) G A B m g ie ;

 module At (G : C.Ctx) (A B : C.Ty G) (m : DR.Map G A B) (fA : Dd.Fib G A) (fB : Dd.Fib G B)
  (mA : Dd.Modal G A) (mB : Dd.Modal G B) (lm : Pt.LEqT G A B m) {
  GA : C.Ctx = C.ext G A ;
  GB : C.Ctx = C.ext G B ;
  pA : C.Sub GA G = C.p G A ;
  pB : C.Sub GB G = C.p G B ;
  Ap : C.Ty GA = C.subT GA G A pA ;
  BA : C.Ty GA = C.subT GA G B pA ;
  Ab : C.Ty GB = C.subT GB G A pB ;
  Bb : C.Ty GB = C.subT GB G B pB ;
  e : C.Sub GA GB = C.pair GA G B pA m ;

  -- (1) e is a levelwise equivalence
  module LE (x : S.Ob) {
   SA : U l = (g : C.Sub (S.yo x) G) * C.El (S.yo x) (C.subT (S.yo x) G A g) ;
   SB : U l = (g : C.Sub (S.yo x) G) * C.El (S.yo x) (C.subT (S.yo x) G B g) ;
   smap (w : SA) : SB = (w.1, DR.postAt (S.yo x) G A B m w.1 w.2) ;
   seq : isEquiv SA SB smap =
    qinv SA SB smap (\ w -> (w.1, (lm x w.1).sec w.2))
     (\ w -> ap (C.El (S.yo x) (C.subT (S.yo x) G B w.1)) SB (\ b -> (w.1, b)) _ _ ((lm x w.1).sec-eq w.2))
     (\ w -> ap (C.El (S.yo x) (C.subT (S.yo x) G A w.1)) SA (\ a -> (w.1, a)) _ _
        (sec-ret (C.El (S.yo x) (C.subT (S.yo x) G A w.1)) (C.El (S.yo x) (C.subT (S.yo x) G B w.1)) (Pt.onFib G A B m x w.1) (lm x w.1) w.2)) ;
   -- e . t = (p_A t , m at (p_A t , q t))
   aTeq (t : C.Sub (S.yo x) GA)
    : Id (C.El (S.yo x) (C.subT (S.yo x) G B (C.o (S.yo x) GA G pA t)))
       (PN.aT (S.yo x) GA G B pA t m) (DR.postAt (S.yo x) G A B m (C.o (S.yo x) GA G pA t) (TX.qv (S.yo x) G A t)) =
    TX.teAny (S.yo x) (C.subT (S.yo x) G B (C.o (S.yo x) GA G pA t)) (C.subT (S.yo x) G B (C.o (S.yo x) GA G pA t))
     (PN.aT (S.yo x) GA G B pA t m) (DR.postAt (S.yo x) G A B m (C.o (S.yo x) GA G pA t) (TX.qv (S.yo x) G A t))
     (TX.teT (S.yo x) (C.subT (S.yo x) G B (C.o (S.yo x) GA G pA t)) (C.subT (S.yo x) GA BA t) (C.subT (S.yo x) G B (C.o (S.yo x) GA G pA t))
        (PN.aT (S.yo x) GA G B pA t m) (C.subt (S.yo x) GA BA m t) (DR.postAt (S.yo x) G A B m (C.o (S.yo x) GA G pA t) (TX.qv (S.yo x) G A t))
       (TX.teS (S.yo x) (C.subT (S.yo x) GA BA t) (C.subT (S.yo x) G B (C.o (S.yo x) GA G pA t)) (C.subt (S.yo x) GA BA m t) (PN.aT (S.yo x) GA G B pA t m)
          (TX.teTr (S.yo x) (C.subT (S.yo x) GA BA t) (C.subT (S.yo x) G B (C.o (S.yo x) GA G pA t))
             (sym (C.Ty (S.yo x)) (C.subT (S.yo x) G B (C.o (S.yo x) GA G pA t)) (C.subT (S.yo x) GA BA t) (C.subT-o (S.yo x) GA G B pA t))
             (C.subt (S.yo x) GA BA m t)))
       (TX.teT (S.yo x) (C.subT (S.yo x) GA BA t) (C.subT (S.yo x) GA BA (C.pair (S.yo x) G A (C.o (S.yo x) GA G pA t) (TX.qv (S.yo x) G A t)))
           (C.subT (S.yo x) G B (C.o (S.yo x) GA G pA t))
           (C.subt (S.yo x) GA BA m t) (C.subt (S.yo x) GA BA m (C.pair (S.yo x) G A (C.o (S.yo x) GA G pA t) (TX.qv (S.yo x) G A t)))
           (DR.postAt (S.yo x) G A B m (C.o (S.yo x) GA G pA t) (TX.qv (S.yo x) G A t))
         (TX.teApS (S.yo x) GA BA t (C.pair (S.yo x) G A (C.o (S.yo x) GA G pA t) (TX.qv (S.yo x) G A t))
            (sym (C.Sub (S.yo x) GA) (C.pair (S.yo x) G A (C.o (S.yo x) GA G pA t) (TX.qv (S.yo x) G A t)) t (C.pair-eta (S.yo x) G A t)) m)
         (TX.teTr (S.yo x) (C.subT (S.yo x) GA BA (C.pair (S.yo x) G A (C.o (S.yo x) GA G pA t) (TX.qv (S.yo x) G A t)))
            (C.subT (S.yo x) G B (C.o (S.yo x) GA G pA t))
            (DR.wkp (S.yo x) G A B (C.o (S.yo x) GA G pA t) (TX.qv (S.yo x) G A t))
            (C.subt (S.yo x) GA BA m (C.pair (S.yo x) G A (C.o (S.yo x) GA G pA t) (TX.qv (S.yo x) G A t))))))
     (refl (C.subT (S.yo x) G B (C.o (S.yo x) GA G pA t))) ;
   eqt (t : C.Sub (S.yo x) GA)
    : Id (C.Sub (S.yo x) GB) (C.o (S.yo x) GA GB e t)
       (C.pair (S.yo x) G B (C.o (S.yo x) GA G pA t) (DR.postAt (S.yo x) G A B m (C.o (S.yo x) GA G pA t) (TX.qv (S.yo x) G A t))) =
    trans (C.Sub (S.yo x) GB) (C.o (S.yo x) GA GB e t) (C.pair (S.yo x) G B (C.o (S.yo x) GA G pA t) (PN.aT (S.yo x) GA G B pA t m))
     (C.pair (S.yo x) G B (C.o (S.yo x) GA G pA t) (DR.postAt (S.yo x) G A B m (C.o (S.yo x) GA G pA t) (TX.qv (S.yo x) G A t)))
     (PN.pairO (S.yo x) GA G B pA t m)
     (ap (C.El (S.yo x) (C.subT (S.yo x) G B (C.o (S.yo x) GA G pA t))) (C.Sub (S.yo x) GB) (\ b -> C.pair (S.yo x) G B (C.o (S.yo x) GA G pA t) b) _ _ (aTeq t)) ;
   leq : isEquiv (C.Sub (S.yo x) GA) (C.Sub (S.yo x) GB) (Pt.onPts GA GB e x) =
    Equivalences[k].homotopy (C.Sub (S.yo x) GA) (C.Sub (S.yo x) GB)
     (Equivalences[k].compose (C.Sub (S.yo x) GA) SA (C.Sub (S.yo x) GB) (DR.extEquiv (S.yo x) G A)
       (Equivalences[k].compose SA SB (C.Sub (S.yo x) GB) (smap, seq) (invE (C.Sub (S.yo x) GB) SB (DR.extEquiv (S.yo x) G B))))
     (Pt.onPts GA GB e x) eqt ;
  } ;
  lfe : Pt.LEqC GA GB e = \ x -> LE[x].leq ;

  -- (2) the inverse n, and n . m = q_A
  module LA = L67.D67[GA, GB, e, lfe, Ab, Dd.Fib-sub GB G A pB fA, Dd.Modal-sub GB G A pB mA] ;
  Qf : C.Ty GA = C.subT GA GB Ab e ;
  path : Id (C.Ty GA) Ap Qf =
   trans (C.Ty GA) Ap (C.subT GA G A (C.o GA GB G pB e)) Qf
    (ap (C.Sub GA G) (C.Ty GA) (\ s -> C.subT GA G A s) pA (C.o GA GB G pB e) (sym (C.Sub GA G) (C.o GA GB G pB e) pA (C.p-pair GA G B pA m)))
    (C.subT-o GA GB G A pB e) ;
  qe : C.El GA Qf = DR.trE GA Ap Qf path (C.q G A) ;
  n : DR.Map G B A = LA.lemma67.sec qe ;
  ne : Id (C.El GA Qf) (C.subt GA GB Ab n e) qe = LA.lemma67.sec-eq qe ;
  nm : Id (DR.Map G A A) (DR.postAt GA G B A n pA m) (C.q G A) =
   TX.teAny GA Ap Ap (DR.postAt GA G B A n pA m) (C.q G A)
    (TX.teT GA Ap Qf Ap (DR.postAt GA G B A n pA m) (C.subt GA GB Ab n e) (C.q G A)
      (TX.teS GA Qf Ap (C.subt GA GB Ab n e) (DR.postAt GA G B A n pA m) (TX.teTr GA Qf Ap (DR.wkp GA G B A pA m) (C.subt GA GB Ab n e)))
      (TX.teT GA Qf Qf Ap (C.subt GA GB Ab n e) qe (C.q G A)
        (TX.teR GA Qf (C.subt GA GB Ab n e) qe ne)
        (TX.teS GA Ap Qf (C.q G A) qe (TX.teTr GA Ap Qf path (C.q G A)))))
    (refl Ap) ;

  -- (3) m . n = q_B
  module LB = L67.D67[GA, GB, e, lfe, Bb, Dd.Fib-sub GB G B pB fB, Dd.Modal-sub GB G B pB mB] ;
  Qg : C.Ty GA = C.subT GA GB Bb e ;
  mn0 : DR.Map G B B = DR.postAt GB G A B m pB n ;
  -- (p_A , q_A) = id
  idA : Id (C.Sub GA GA) (C.pair GA G A pA (C.q G A)) (C.id GA) =
   TX.subExt GA G A (C.pair GA G A pA (C.q G A)) (C.id GA)
    (trans (C.Sub GA G) (C.o GA GA G pA (C.pair GA G A pA (C.q G A))) pA (C.o GA GA G pA (C.id GA))
       (C.p-pair GA G A pA (C.q G A)) (sym (C.Sub GA G) (C.o GA GA G pA (C.id GA)) pA (C.o-idr GA G pA)))
    (TX.teT GA (C.subT GA G A (C.o GA GA G pA (C.pair GA G A pA (C.q G A)))) Ap (C.subT GA G A (C.o GA GA G pA (C.id GA)))
       (TX.qv GA G A (C.pair GA G A pA (C.q G A))) (C.q G A) (TX.qv GA G A (C.id GA))
      (TX.qvPair GA G A pA (C.q G A))
      (TX.teT GA Ap (C.subT GA GA Ap (C.id GA)) (C.subT GA G A (C.o GA GA G pA (C.id GA)))
          (C.q G A) (C.subt GA GA Ap (C.q G A) (C.id GA)) (TX.qv GA G A (C.id GA))
        (TX.teS GA (C.subT GA GA Ap (C.id GA)) Ap (C.subt GA GA Ap (C.q G A) (C.id GA)) (C.q G A) (C.subT-id GA Ap, C.subt-id GA Ap (C.q G A)))
        (TX.teTr GA (C.subT GA GA Ap (C.id GA)) (C.subT GA G A (C.o GA GA G pA (C.id GA)))
           (sym (C.Ty GA) (C.subT GA G A (C.o GA GA G pA (C.id GA))) (C.subT GA GA Ap (C.id GA)) (C.subT-o GA GA G A pA (C.id GA)))
           (C.subt GA GA Ap (C.q G A) (C.id GA))))) ;
  -- m at the generic element is m
  idLaw : TX.TE GA BA BA (DR.postAt GA G A B m pA (C.q G A)) m =
   TX.teT GA BA (C.subT GA GA BA (C.pair GA G A pA (C.q G A))) BA (DR.postAt GA G A B m pA (C.q G A)) (C.subt GA GA BA m (C.pair GA G A pA (C.q G A))) m
    (TX.teS GA (C.subT GA GA BA (C.pair GA G A pA (C.q G A))) BA (C.subt GA GA BA m (C.pair GA G A pA (C.q G A))) (DR.postAt GA G A B m pA (C.q G A))
       (TX.teTr GA (C.subT GA GA BA (C.pair GA G A pA (C.q G A))) BA (DR.wkp GA G A B pA (C.q G A)) (C.subt GA GA BA m (C.pair GA G A pA (C.q G A)))))
    (TX.teT GA (C.subT GA GA BA (C.pair GA G A pA (C.q G A))) (C.subT GA GA BA (C.id GA)) BA
        (C.subt GA GA BA m (C.pair GA G A pA (C.q G A))) (C.subt GA GA BA m (C.id GA)) m
      (TX.teApS GA GA BA (C.pair GA G A pA (C.q G A)) (C.id GA) idA m)
      (C.subT-id GA BA, C.subt-id GA BA m)) ;
  -- the argument n restricted along e is q_A
  argTE : TX.TE GA (C.subT GA G A (C.o GA GB G pB e)) Ap (PN.aT GA GB G A pB e n) (C.q G A) =
   TX.teT GA (C.subT GA G A (C.o GA GB G pB e)) Qf Ap (PN.aT GA GB G A pB e n) (C.subt GA GB Ab n e) (C.q G A)
    (TX.teS GA Qf (C.subT GA G A (C.o GA GB G pB e)) (C.subt GA GB Ab n e) (PN.aT GA GB G A pB e n)
       (TX.teTr GA Qf (C.subT GA G A (C.o GA GB G pB e))
          (sym (C.Ty GA) (C.subT GA G A (C.o GA GB G pB e)) Qf (C.subT-o GA GB G A pB e)) (C.subt GA GB Ab n e)))
    (TX.teT GA Qf Qf Ap (C.subt GA GB Ab n e) qe (C.q G A)
       (TX.teR GA Qf (C.subt GA GB Ab n e) qe ne)
       (TX.teS GA Ap Qf (C.q G A) qe (TX.teTr GA Ap Qf path (C.q G A)))) ;
  r1 : TX.TE GA Qg BA (C.subt GA GB Bb mn0 e) m =
   TX.teT GA Qg (C.subT GA G B (C.o GA GB G pB e)) BA (C.subt GA GB Bb mn0 e) (DR.postAt GA G A B m (C.o GA GB G pB e) (PN.aT GA GB G A pB e n)) m
    (PN.postNat GA GB G A B m pB e n)
    (TX.teT GA (C.subT GA G B (C.o GA GB G pB e)) BA BA
        (DR.postAt GA G A B m (C.o GA GB G pB e) (PN.aT GA GB G A pB e n)) (DR.postAt GA G A B m pA (C.q G A)) m
      (PN.postPath GA G A B m (C.o GA GB G pB e) pA (C.p-pair GA G B pA m) (PN.aT GA GB G A pB e n) (C.q G A) argTE)
      idLaw) ;
  r2 : TX.TE GA Qg BA (C.subt GA GB Bb (C.q G B) e) m =
   TX.teT GA Qg (C.subT GA G B (C.o GA GB G pB e)) BA (C.subt GA GB Bb (C.q G B) e) (TX.qv GA G B e) m
    (TX.teTr GA Qg (C.subT GA G B (C.o GA GB G pB e)) (sym (C.Ty GA) (C.subT GA G B (C.o GA GB G pB e)) Qg (C.subT-o GA GB G B pB e))
       (C.subt GA GB Bb (C.q G B) e))
    (TX.qvPair GA G B pA m) ;
  mn : Id (DR.Map G B B) mn0 (C.q G B) =
   Equivalences[k].injective (C.El GB Bb) (C.El GA Qg) (\ z -> C.subt GA GB Bb z e) LB.lemma67 mn0 (C.q G B)
    (TX.teAny GA Qg Qg (C.subt GA GB Bb mn0 e) (C.subt GA GB Bb (C.q G B) e)
       (TX.teT GA Qg BA Qg (C.subt GA GB Bb mn0 e) m (C.subt GA GB Bb (C.q G B) e) r1
          (TX.teS GA Qg BA (C.subt GA GB Bb (C.q G B) e) m r2))
       (refl Qg)) ;

  -- (4)
  eqT : Dd.IsEqT G A B m = Dd.isoT G A B m n nm mn ;
 } ;

 -- PROP 17
 prop17 (G : C.Ctx) (A B : C.Ty G) (m : DR.Map G A B) (fA : Dd.Fib G A) (fB : Dd.Fib G B)
  (mA : Dd.Modal G A) (mB : Dd.Modal G B) (lm : Pt.LEqT G A B m) : Dd.IsEqT G A B m =
  At[G,A,B,m,fA,fB,mA,mB,lm].eqT ;
} ;
