-- E3.seg: Prop 76 at Sp (Axiom 1, projectivity of the spectrum) in the
-- model, DUALITY.md Tier 6 (canonicity-45).
--
-- Premises beyond those of Theorem 62 (T2, T3, Mods, P58):
--   TrS (S3.7): the truncation Tr of the model, stable under substitution;
--   TrS.prop34-l / prop34-r (S3.8, Prop 34): for A fibrant and D-modal,
--     El(G , Tr A) <-> the Unit function giving at each point g of G at x
--     an element of the Unit truncation of the fibre of A at g.
-- Unit truncation is Truncation[l] (from replacement, as in Tier 1).
--
-- Definition 73 (Proj): A over G is projective when for every s : D -> G
-- and fibrant D-modal P over D.A[s], El(D , Pi A[s] Tr P) -> El(D , Tr (Pi A[s] P)).
--
-- Informal proof (jonas.pdf, Prop 76).  Local representations are stable
-- under substitution (Remark 71, constructed below), so take s = id.  Given
-- f in El(G , Pi A Tr P): app f in El(G.A , Tr P); Prop 34 (right to left)
-- gives at every point t of G.A an element of || P(t) ||; at a point g of G,
-- take t = lpt = (g p_g , q_g) and map the inverse of Lemma 72's ev72 under
-- || - || to get || (Pi A P)(x , g) ||; Prop 34 (left to right, Pi A P being
-- fibrant and D-modal: Fib-Pi, Modal-Pi) gives El(G , Tr (Pi A P)).

level l k ;
constraint l <= k ;
open Base ;
open Ring[l] ;
module Pr = Prelude[l] ;
module Pk = Prelude[k] ;

-- the Unit truncation, and its action on maps
TrU (A : U l) : U l = Truncation[l].Trunc[A].carrier ;
tmap (A B : U l) (f : A -> B) (a : TrU A) : TrU B =
 Truncation[l].Trunc[A].induction @l (\ z -> TrU B) (\ z -> Truncation[l].Trunc[B].proposition) (\ x -> Truncation[l].Trunc[B].inc (f x)) a ;

-- S3.7 / S3.8: the model's truncation and Prop 34
record TrS (C : T2[l,k].PCwF) (S : T2[l,k].Site[C]) (Dd : T2[l,k].DS[C,S]) {
 Tr (G : C.Ctx) (A : C.Ty G) : C.Ty G ;
 Tr-sub (D G : C.Ctx) (A : C.Ty G) (s : C.Sub D G) : Id (C.Ty D) (C.subT D G (Tr G A) s) (Tr D (C.subT D G A s)) ;
 prop34-l (G : C.Ctx) (A : C.Ty G) : Dd.Fib G A -> Dd.Modal G A
  -> ((x : S.Ob) (g : C.Sub (S.yo x) G) -> TrU (T2[l,k].Der[C].Pts[S].fib G A x g)) -> C.El G (Tr G A) ;
 prop34-r (G : C.Ctx) (A : C.Ty G) : Dd.Fib G A -> Dd.Modal G A
  -> C.El G (Tr G A) -> (x : S.Ob) (g : C.Sub (S.yo x) G) -> TrU (T2[l,k].Der[C].Pts[S].fib G A x g) ;
} ;

module P76 (C : T2[l,k].PCwF) (S : T2[l,k].Site[C]) (PI : T2[l,k].PiS[C]) (Dd : T2[l,k].DS[C,S])
 (MP : T2[l,k].ModPi[C,S,PI,Dd]) (Tt : TrS[C,S,Dd]) {
 module DR = T2[l,k].Der[C] ;
 module Pt = DR.Pts[S] ;
 module TM = TE[l,k].TEm[C] ;

 -- Definition 73
 Proj (G : C.Ctx) (A : C.Ty G) : U k =
  (D : C.Ctx) (s : C.Sub D G) (P : C.Ty (C.ext D (C.subT D G A s))) -> Dd.Fib (C.ext D (C.subT D G A s)) P -> Dd.Modal (C.ext D (C.subT D G A s)) P
   -> C.El D (PI.Pi D (C.subT D G A s) (Tt.Tr (C.ext D (C.subT D G A s)) P)) -> C.El D (Tt.Tr D (PI.Pi D (C.subT D G A s) P)) ;

 ------------------------------------------------------------------
 -- Remark 71: a local representation of A gives one of A[s]

 -- a levelwise equivalence into D.X1 stays one when moved to D.X2
 lwTr (T D : C.Ctx) (X1 X2 : C.Ty D) (PA : Id (C.Ty D) X1 X2) (w : C.Sub T (C.ext D X1))
  (h : Pt.LEqC T (C.ext D X1) w) : Pt.LEqC T (C.ext D X2) (TM.trSub T D X1 X2 PA w) =
  idJ (C.Ty D) X1 (\ X2' PA' -> Pt.LEqC T (C.ext D X2') (TM.trSub T D X1 X2' PA' w)) h X2 PA ;

 module R71 (G : C.Ctx) (A : C.Ty G) (rep : T2[l,k].LocRep[C,S,G,A]) (D : C.Ctx) (s : C.Sub D G) {
  As : C.Ty D = C.subT D G A s ;
  module Pnt (x : S.Ob) (d : C.Sub (S.yo x) D) {
   sd : C.Sub (S.yo x) G = C.o (S.yo x) D G s d ;
   O : S.Ob = rep.xg x sd ;
   pO : S.Hom O x = rep.pg x sd ;
   Dp : C.Ctx = S.yo O ;
   yp : C.Sub Dp (S.yo x) = S.yoH O x pO ;
   X1 : C.Ty (S.yo x) = C.subT (S.yo x) G A sd ;
   X2 : C.Ty (S.yo x) = C.subT (S.yo x) D As d ;
   PA : Id (C.Ty (S.yo x)) X1 X2 = C.subT-o (S.yo x) D G A s d ;
   Pq : Id (C.Ty Dp) (C.subT Dp G A (C.o Dp (S.yo x) G sd yp)) (C.subT Dp D As (C.o Dp (S.yo x) D d yp)) =
    Pk.trans (C.Ty Dp) (C.subT Dp G A (C.o Dp (S.yo x) G sd yp)) (C.subT Dp G A (C.o Dp D G s (C.o Dp (S.yo x) D d yp))) (C.subT Dp D As (C.o Dp (S.yo x) D d yp))
     (Pk.ap (C.Sub Dp G) (C.Ty Dp) (\ t -> C.subT Dp G A t) (C.o Dp (S.yo x) G sd yp) (C.o Dp D G s (C.o Dp (S.yo x) D d yp)) (C.o-assoc Dp (S.yo x) D G s d yp))
     (C.subT-o Dp D G A s (C.o Dp (S.yo x) D d yp)) ;
   qO : C.El Dp (C.subT Dp D As (C.o Dp (S.yo x) D d yp)) =
    DR.trE Dp (C.subT Dp G A (C.o Dp (S.yo x) G sd yp)) (C.subT Dp D As (C.o Dp (S.yo x) D d yp)) Pq (rep.qg x sd) ;
   -- the two representing maps, and their second parts
   b1 : C.El Dp (C.subT Dp (S.yo x) X1 yp) =
    DR.trE Dp (C.subT Dp G A (C.o Dp (S.yo x) G sd yp)) (C.subT Dp (S.yo x) X1 yp) (C.subT-o Dp (S.yo x) G A sd yp) (rep.qg x sd) ;
   b2 : C.El Dp (C.subT Dp (S.yo x) X2 yp) =
    DR.trE Dp (C.subT Dp D As (C.o Dp (S.yo x) D d yp)) (C.subT Dp (S.yo x) X2 yp) (C.subT-o Dp (S.yo x) D As d yp) qO ;
   pq1 : C.Sub Dp (C.ext (S.yo x) X1) = C.pair Dp (S.yo x) X1 yp b1 ;
   pq2 : C.Sub Dp (C.ext (S.yo x) X2) = C.pair Dp (S.yo x) X2 yp b2 ;
   -- pq2 is pq1 moved along PA
   eq : Id (C.Sub Dp (C.ext (S.yo x) X2)) (TM.trSub Dp (S.yo x) X1 X2 PA pq1) pq2 =
    TM.subExt Dp (S.yo x) X2 (TM.trSub Dp (S.yo x) X1 X2 PA pq1) pq2
     (Pk.trans (C.Sub Dp (S.yo x)) (C.o Dp (C.ext (S.yo x) X2) (S.yo x) (C.p (S.yo x) X2) (TM.trSub Dp (S.yo x) X1 X2 PA pq1)) yp
        (C.o Dp (C.ext (S.yo x) X2) (S.yo x) (C.p (S.yo x) X2) pq2)
       (Pk.trans (C.Sub Dp (S.yo x)) (C.o Dp (C.ext (S.yo x) X2) (S.yo x) (C.p (S.yo x) X2) (TM.trSub Dp (S.yo x) X1 X2 PA pq1))
          (C.o Dp (C.ext (S.yo x) X1) (S.yo x) (C.p (S.yo x) X1) pq1) yp
         (TM.pTrW Dp (S.yo x) X1 X2 PA pq1) (C.p-pair Dp (S.yo x) X1 yp b1))
       (Pk.sym (C.Sub Dp (S.yo x)) (C.o Dp (C.ext (S.yo x) X2) (S.yo x) (C.p (S.yo x) X2) pq2) yp (C.p-pair Dp (S.yo x) X2 yp b2)))
     (TM.teT Dp (C.subT Dp (S.yo x) X2 (C.o Dp (C.ext (S.yo x) X2) (S.yo x) (C.p (S.yo x) X2) (TM.trSub Dp (S.yo x) X1 X2 PA pq1)))
               (C.subT Dp G A (C.o Dp (S.yo x) G sd yp))
               (C.subT Dp (S.yo x) X2 (C.o Dp (C.ext (S.yo x) X2) (S.yo x) (C.p (S.yo x) X2) pq2))
               (TM.qv Dp (S.yo x) X2 (TM.trSub Dp (S.yo x) X1 X2 PA pq1)) (rep.qg x sd) (TM.qv Dp (S.yo x) X2 pq2)
       (TM.teT Dp (C.subT Dp (S.yo x) X2 (C.o Dp (C.ext (S.yo x) X2) (S.yo x) (C.p (S.yo x) X2) (TM.trSub Dp (S.yo x) X1 X2 PA pq1)))
                 (C.subT Dp (S.yo x) X1 (C.o Dp (C.ext (S.yo x) X1) (S.yo x) (C.p (S.yo x) X1) pq1)) (C.subT Dp G A (C.o Dp (S.yo x) G sd yp))
                 (TM.qv Dp (S.yo x) X2 (TM.trSub Dp (S.yo x) X1 X2 PA pq1)) (TM.qv Dp (S.yo x) X1 pq1) (rep.qg x sd)
         (TM.qTrW Dp (S.yo x) X1 X2 PA pq1)
         (TM.teT Dp (C.subT Dp (S.yo x) X1 (C.o Dp (C.ext (S.yo x) X1) (S.yo x) (C.p (S.yo x) X1) pq1)) (C.subT Dp (S.yo x) X1 yp) (C.subT Dp G A (C.o Dp (S.yo x) G sd yp))
                   (TM.qv Dp (S.yo x) X1 pq1) b1 (rep.qg x sd)
           (TM.qvPair Dp (S.yo x) X1 yp b1)
           (TM.teS Dp (C.subT Dp G A (C.o Dp (S.yo x) G sd yp)) (C.subT Dp (S.yo x) X1 yp) (rep.qg x sd) b1
              (TM.teTr Dp (C.subT Dp G A (C.o Dp (S.yo x) G sd yp)) (C.subT Dp (S.yo x) X1 yp) (C.subT-o Dp (S.yo x) G A sd yp) (rep.qg x sd)))))
       (TM.teS Dp (C.subT Dp (S.yo x) X2 (C.o Dp (C.ext (S.yo x) X2) (S.yo x) (C.p (S.yo x) X2) pq2)) (C.subT Dp G A (C.o Dp (S.yo x) G sd yp))
                 (TM.qv Dp (S.yo x) X2 pq2) (rep.qg x sd)
         (TM.teT Dp (C.subT Dp (S.yo x) X2 (C.o Dp (C.ext (S.yo x) X2) (S.yo x) (C.p (S.yo x) X2) pq2)) (C.subT Dp (S.yo x) X2 yp) (C.subT Dp G A (C.o Dp (S.yo x) G sd yp))
                   (TM.qv Dp (S.yo x) X2 pq2) b2 (rep.qg x sd)
           (TM.qvPair Dp (S.yo x) X2 yp b2)
           (TM.teT Dp (C.subT Dp (S.yo x) X2 yp) (C.subT Dp D As (C.o Dp (S.yo x) D d yp)) (C.subT Dp G A (C.o Dp (S.yo x) G sd yp)) b2 qO (rep.qg x sd)
             (TM.teS Dp (C.subT Dp D As (C.o Dp (S.yo x) D d yp)) (C.subT Dp (S.yo x) X2 yp) qO b2
                (TM.teTr Dp (C.subT Dp D As (C.o Dp (S.yo x) D d yp)) (C.subT Dp (S.yo x) X2 yp) (C.subT-o Dp (S.yo x) D As d yp) qO))
             (TM.teS Dp (C.subT Dp G A (C.o Dp (S.yo x) G sd yp)) (C.subT Dp D As (C.o Dp (S.yo x) D d yp)) (rep.qg x sd) qO
                (TM.teTr Dp (C.subT Dp G A (C.o Dp (S.yo x) G sd yp)) (C.subT Dp D As (C.o Dp (S.yo x) D d yp)) Pq (rep.qg x sd))))))) ;
   lw2 : Pt.LEqC Dp (C.ext (S.yo x) X2) pq2 =
    Pk.subst (C.Sub Dp (C.ext (S.yo x) X2)) (\ w -> Pt.LEqC Dp (C.ext (S.yo x) X2) w) (TM.trSub Dp (S.yo x) X1 X2 PA pq1) pq2 eq
     (lwTr Dp (S.yo x) X1 X2 PA pq1 (rep.lw x sd)) ;
  } ;
  rep' : T2[l,k].LocRep[C,S,D,As] =
   new T2[l,k].LocRep[C,S,D,As,
    xg := \ x d -> Pnt[x,d].O,
    pg := \ x d -> Pnt[x,d].pO,
    qg := \ x d -> Pnt[x,d].qO,
    lw := \ x d -> Pnt[x,d].lw2] ;
 } ;

 ------------------------------------------------------------------
 -- Prop 76 at s = id, then for every s

 module Core76 (G : C.Ctx) (A : C.Ty G) (rep : T2[l,k].LocRep[C,S,G,A]) (fA : Dd.Fib G A)
  (P : C.Ty (C.ext G A)) (fP : Dd.Fib (C.ext G A) P) (mP : Dd.Modal (C.ext G A) P)
  (f : C.El G (PI.Pi G A (Tt.Tr (C.ext G A) P))) {
  -- Prop 34 (right to left) at G.A
  h (x : S.Ob) (t : C.Sub (S.yo x) (C.ext G A)) : TrU (Pt.fib (C.ext G A) P x t) =
   Tt.prop34-r (C.ext G A) P fP mP (PI.app G A (Tt.Tr (C.ext G A) P) f) x t ;
  -- evaluate at lpt, and invert Lemma 72 under the truncation
  h' (x : S.Ob) (g : C.Sub (S.yo x) G) : TrU (Pt.fib G (PI.Pi G A P) x g) =
   tmap (Pt.fib (C.ext G A) P (rep.xg x g) Lemma72[l,k].L72[C,S,PI,Dd,G,A,rep,P,fP,mP,x,g].lpt) (Pt.fib G (PI.Pi G A P) x g)
    Lemma72[l,k].L72[C,S,PI,Dd,G,A,rep,P,fP,mP,x,g].lemma72.sec
    (h (rep.xg x g) Lemma72[l,k].L72[C,S,PI,Dd,G,A,rep,P,fP,mP,x,g].lpt) ;
  -- Prop 34 (left to right) for Pi A P
  out : C.El G (Tt.Tr G (PI.Pi G A P)) =
   Tt.prop34-l G (PI.Pi G A P) (MP.Fib-Pi G A P fP) (MP.Modal-Pi G A P fA mP) h' ;
 } ;

 -- Proposition 76: a locally homotopy representable fibrant type is projective
 prop76 (G : C.Ctx) (A : C.Ty G) (rep : T2[l,k].LocRep[C,S,G,A]) (fA : Dd.Fib G A) : Proj G A =
  \ D s P fP mP f -> Core76[D, C.subT D G A s, R71[G,A,rep,D,s].rep', Dd.Fib-sub D G A s fA, P, fP, mP, f].out ;
} ;

module Over (R : CRing) (setR : Pr.isSet R.R) {
 module Tm = T3[l,k].Over[R,setR] ;
 module E1m = E1[l,k].Over[R,setR] ;
 -- PROPOSITION 76 AT Sp (Axiom 1): the spectrum is projective in the model
 module Thm76 (C : T2[l,k].PCwF) (S : T2[l,k].Site[C]) (PI : T2[l,k].PiS[C]) (Dd : T2[l,k].DS[C,S])
  (MP : T2[l,k].ModPi[C,S,PI,Dd]) (T : Tm.T3[C,S]) (Md : E1m.Mods[C,S,Dd,T]) (L58 : E1m.P58[C,S,T]) (Tt : TrS[C,S,Dd]) {
  theorem76 : P76[C,S,PI,Dd,MP,Tt].Proj T.G0 T.Sp =
   P76[C,S,PI,Dd,MP,Tt].prop76 T.G0 T.Sp E1m.Thm62[C,S,PI,Dd,MP,T,Md,L58].rep Md.Sp-fib ;
 } ;
} ;
