-- E1.seg: Theorem 62 (Axiom 2, duality) in the model, DUALITY.md Tier 4.
--
-- Statement: the transposed evaluation lambda ev : <->_{T/G} -> G^{Sp}
-- over 1.Pr is an internal equivalence (IsEqT), for the T3 data.
--
-- Premises beyond T2 and T3 (records below):
--   Mods  (S3.5 / P3.4): <->_{T/G} and G are D-modal, G and Sp fibrant;
--   P58   (P3.6, status: stated, proof pending): <p_O , q_g> is a
--         levelwise equivalence, i.e. Sp is locally representable with
--         the representation (obj u , objHom u , Core.At.qg).
--
-- Informal proof (jonas.pdf, proof of Theorem 62).  By Prop 17 (prop17,
-- with Modal-Pi for G^{Sp}) it suffices that every component
-- (lambda ev)_{(x,g)} is an equivalence.  By Remark 60 (remark60-eq) it
-- suffices that s |-> ev at lpt of S(p_g) s (canonical-45's rhs) is one.
-- The point lpt is pair (g p_O) q_g (lpt-ext), and the argument of rhs
-- is the restriction of s, up to transports (TE).  So Phi . rhs = K for
-- the equivalence Phi (transports and gE), and K is an equivalence by
-- Core (q_u . p_u+ = id).  Hence rhs is an equivalence.
level l k ;
constraint l <= k ;
open Ring[l] ;
module Pr = Prelude[l] ;
module Pk = Prelude[k] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module Tm = T3[l,k].Over[R,setR] ;
 module Co = Core[l,k].Over[R,setR] ;
 -- an equivalence of l-types, read at level k
 toK (A B : U l) (f : A -> B) (e : Pr.isEquiv A B f) : Pk.isEquiv A B f =
  Pk.qinv A B f e.sec e.sec-eq (\ a -> Pr.sec-ret A B f e a) ;
 toL (A B : U l) (f : A -> B) (e : Pk.isEquiv A B f) : Pr.isEquiv A B f =
  Pr.qinv A B f e.sec e.sec-eq (\ a -> Pk.sec-ret A B f e a) ;
 record Mods (C : T2[l,k].PCwF) (S : T2[l,k].Site[C]) (Dd : T2[l,k].DS[C,S]) (T : Tm.T3[C,S]) {
  Br-modal : Dd.Modal T.G0 T.Br ;
  Gt-fib : Dd.Fib T.G0 T.Gt ;
  Gt-modal : Dd.Modal T.G0 T.Gt ;
  Sp-fib : Dd.Fib T.G0 T.Sp ;
 } ;
 -- P3.6, pending: the levelwise equivalence of <p_O , q_g>
 record P58 (C : T2[l,k].PCwF) (S : T2[l,k].Site[C]) (T : Tm.T3[C,S]) {
  lw (x : S.Ob) (g : C.Sub (S.yo x) T.G0) :
   T2[l,k].Der[C].Pts[S].LEqC (S.yo Co.At[C,S,T,x,g].O) (C.ext (S.yo x) (C.subT (S.yo x) T.G0 T.Sp g))
    (C.pair (S.yo Co.At[C,S,T,x,g].O) (S.yo x) (C.subT (S.yo x) T.G0 T.Sp g) (S.yoH Co.At[C,S,T,x,g].O x Co.At[C,S,T,x,g].pO)
     (T2[l,k].Der[C].trE (S.yo Co.At[C,S,T,x,g].O)
       (C.subT (S.yo Co.At[C,S,T,x,g].O) T.G0 T.Sp (C.o (S.yo Co.At[C,S,T,x,g].O) (S.yo x) T.G0 g (S.yoH Co.At[C,S,T,x,g].O x Co.At[C,S,T,x,g].pO)))
       (C.subT (S.yo Co.At[C,S,T,x,g].O) (S.yo x) (C.subT (S.yo x) T.G0 T.Sp g) (S.yoH Co.At[C,S,T,x,g].O x Co.At[C,S,T,x,g].pO))
       (C.subT-o (S.yo Co.At[C,S,T,x,g].O) (S.yo x) T.G0 T.Sp g (S.yoH Co.At[C,S,T,x,g].O x Co.At[C,S,T,x,g].pO))
       Co.At[C,S,T,x,g].qg)) ;
 } ;
 module Thm62 (C : T2[l,k].PCwF) (S : T2[l,k].Site[C]) (PI : T2[l,k].PiS[C]) (Dd : T2[l,k].DS[C,S])
  (MP : T2[l,k].ModPi[C,S,PI,Dd]) (T : Tm.T3[C,S]) (Md : Mods[C,S,Dd,T]) (L58 : P58[C,S,T]) {
  module DR = T2[l,k].Der[C] ;
  module Pt = DR.Pts[S] ;
  module TM = TE[l,k].TEm[C] ;
  GA : C.Ctx = C.ext T.G0 T.Sp ;
  P : C.Ty GA = C.subT GA T.G0 T.Gt (C.p T.G0 T.Sp) ;
  rep : T2[l,k].LocRep[C,S,T.G0,T.Sp] =
   new T2[l,k].LocRep[C,S,T.G0,T.Sp,
    xg := \ x g -> Co.At[C,S,T,x,g].O,
    pg := \ x g -> Co.At[C,S,T,x,g].pO,
    qg := \ x g -> Co.At[C,S,T,x,g].qg,
    lw := L58.lw] ;
  module R6 = Remark60[l,k].R60[C,S,PI,Dd,T.G0,T.Sp,rep,P,
   Dd.Fib-sub GA T.G0 T.Gt (C.p T.G0 T.Sp) Md.Gt-fib,
   Dd.Modal-sub GA T.G0 T.Gt (C.p T.G0 T.Sp) Md.Gt-modal,
   T.Br,T.ev] ;
  module At (x : S.Ob) (g : C.Sub (S.yo x) T.G0) {
   module K0 = Co.At[C,S,T,x,g] ;
   module L = R6.At[x,g].L ;
   O : S.Ob = K0.O ;
   Dp : C.Ctx = S.yo O ;
   pr : C.Sub Dp GA = C.pair Dp T.G0 T.Sp K0.gO K0.qg ;
   -- lpt is the pair (g p_O , q_g)
   Lp : Id (C.Sub Dp GA) L.lpt pr =
    Pk.trans (C.Sub Dp GA) L.lpt (DR.extBwd Dp T.G0 T.Sp (DR.extFwd Dp T.G0 T.Sp L.lpt)) pr
     (Pk.sym (C.Sub Dp GA) (DR.extBwd Dp T.G0 T.Sp (DR.extFwd Dp T.G0 T.Sp L.lpt)) L.lpt (C.pair-eta Dp T.G0 T.Sp L.lpt))
     (Pk.ap ((s : C.Sub Dp T.G0) * C.El Dp (C.subT Dp T.G0 T.Sp s)) (C.Sub Dp GA) (DR.extBwd Dp T.G0 T.Sp)
       (DR.extFwd Dp T.G0 T.Sp L.lpt) (K0.gO,K0.qg) L.lpt-ext) ;
   -- the map of types along a path of points
   Q (t : C.Sub Dp GA) : C.Ty Dp = C.subT Dp GA P t ;
   Bp (t : C.Sub Dp GA) : C.Ty Dp = C.subT Dp GA (C.subT GA T.G0 T.Br (C.p T.G0 T.Sp)) t ;
   post (t : C.Sub Dp GA) (a : C.El Dp (Bp t)) : C.El Dp (Q t) =
    DR.postAt Dp GA (C.subT GA T.G0 T.Br (C.p T.G0 T.Sp)) P T.ev t a ;
   post-te (t t' : C.Sub Dp GA) (e : Id (C.Sub Dp GA) t t') (a : C.El Dp (Bp t)) (a' : C.El Dp (Bp t'))
    (h : TM.TE Dp (Bp t) (Bp t') a a') : TM.TE Dp (Q t) (Q t') (post t a) (post t' a') =
    idJ (C.Sub Dp GA) t (\ t2 e2 -> (a2 : C.El Dp (Bp t2)) -> TM.TE Dp (Bp t) (Bp t2) a a2
      -> TM.TE Dp (Q t) (Q t2) (post t a) (post t2 a2))
     (\ a2 h2 -> TM.teR Dp (Q t) (post t a) (post t a2)
       (Pk.ap (C.El Dp (Bp t)) (C.El Dp (Q t)) (post t) a a2 (TM.teAny Dp (Bp t) (Bp t) a a2 h2 (refl (Bp t)))))
     t' e a' h ;
   -- Phi : the fibre of P at lpt -> alg O, an equivalence
   Phi (z : C.El Dp (Q L.lpt)) : (T.alg O).ring.R =
    (T.gE O K0.gO).1 (DR.trE Dp (Q pr) (C.subT Dp T.G0 T.Gt K0.gO) (DR.wkp Dp T.G0 T.Sp T.Gt K0.gO K0.qg)
      (DR.trE Dp (Q L.lpt) (Q pr) (Pk.ap (C.Sub Dp GA) (C.Ty Dp) Q L.lpt pr Lp) z)) ;
   Phi-eqv : Pr.Equiv (C.El Dp (Q L.lpt)) (T.alg O).ring.R =
    Equivalences[l].compose (C.El Dp (Q L.lpt)) (C.El Dp (C.subT Dp T.G0 T.Gt K0.gO)) (T.alg O).ring.R
     (Equivalences[l].compose (C.El Dp (Q L.lpt)) (C.El Dp (Q pr)) (C.El Dp (C.subT Dp T.G0 T.Gt K0.gO))
       (DR.trE Dp (Q L.lpt) (Q pr) (Pk.ap (C.Sub Dp GA) (C.Ty Dp) Q L.lpt pr Lp),
        toL (C.El Dp (Q L.lpt)) (C.El Dp (Q pr)) _ (TM.trE-eq Dp (Q L.lpt) (Q pr) (Pk.ap (C.Sub Dp GA) (C.Ty Dp) Q L.lpt pr Lp)))
       (DR.trE Dp (Q pr) (C.subT Dp T.G0 T.Gt K0.gO) (DR.wkp Dp T.G0 T.Sp T.Gt K0.gO K0.qg),
        toL (C.El Dp (Q pr)) (C.El Dp (C.subT Dp T.G0 T.Gt K0.gO)) _ (TM.trE-eq Dp (Q pr) (C.subT Dp T.G0 T.Gt K0.gO) (DR.wkp Dp T.G0 T.Sp T.Gt K0.gO K0.qg))))
     (T.gE O K0.gO) ;
   Phi-equiv : Pr.isEquiv (C.El Dp (Q L.lpt)) (T.alg O).ring.R Phi = Phi-eqv.2 ;
   -- the source fibre, and the two arguments: rs (canonical-45) and the
   -- restriction of s used in Core.K
   Bg : C.Ty (S.yo x) = C.subT (S.yo x) T.G0 T.Br g ;
   module Arg (s : C.El (S.yo x) Bg) {
    module Rh = R6.At[x,g].Pt[s] ;
    Z0 : C.Ty Dp = C.subT Dp (S.yo x) Bg L.yp ;
    z : C.El Dp Z0 = C.subt Dp (S.yo x) Bg s L.yp ;
    rs-z : TM.TE Dp (Bp L.lpt) Z0 Rh.rs z =
     TM.teS Dp Z0 (Bp L.lpt) z Rh.rs (TM.teTr Dp Z0 (Bp L.lpt) Rh.Prs z) ;
    res : C.El Dp (C.subT Dp T.G0 T.Br K0.gO) = Tm.Rf[C,S,T.G0,T.Br].res O x K0.pO g s ;
    a' : C.El Dp (Bp pr) =
     DR.trE Dp (C.subT Dp T.G0 T.Br K0.gO) (Bp pr) (Pk.sym (C.Ty Dp) (Bp pr) (C.subT Dp T.G0 T.Br K0.gO) (DR.wkp Dp T.G0 T.Sp T.Br K0.gO K0.qg)) res ;
    z-a' : TM.TE Dp Z0 (Bp pr) z a' =
     TM.teT Dp Z0 (C.subT Dp T.G0 T.Br K0.gO) (Bp pr) z res a'
      (TM.teTr Dp Z0 (C.subT Dp T.G0 T.Br K0.gO)
        (Pk.sym (C.Ty Dp) (C.subT Dp T.G0 T.Br K0.gO) Z0 (C.subT-o Dp (S.yo x) T.G0 T.Br g L.yp)) z)
      (TM.teTr Dp (C.subT Dp T.G0 T.Br K0.gO) (Bp pr)
        (Pk.sym (C.Ty Dp) (Bp pr) (C.subT Dp T.G0 T.Br K0.gO) (DR.wkp Dp T.G0 T.Sp T.Br K0.gO K0.qg)) res) ;
    -- Phi (rhs s) = K s
    Phi-rhs : Id (T.alg O).ring.R (Phi Rh.rhs) (K0.K s) =
     Pk.ap (C.El Dp (Q pr)) (T.alg O).ring.R
      (\ w -> (T.gE O K0.gO).1 (DR.trE Dp (Q pr) (C.subT Dp T.G0 T.Gt K0.gO) (DR.wkp Dp T.G0 T.Sp T.Gt K0.gO K0.qg) w))
      _ _
      (TM.teAny Dp (Q L.lpt) (Q pr) (post L.lpt Rh.rs) (post pr a')
        (post-te L.lpt pr Lp Rh.rs a' (TM.teT Dp (Bp L.lpt) Z0 (Bp pr) Rh.rs z a' rs-z z-a'))
        (Pk.ap (C.Sub Dp GA) (C.Ty Dp) Q L.lpt pr Lp)) ;
   } ;
   -- rhs is an equivalence: rhs = Phi^-1 . K, and K is one (Core)
   Phi-inv : Pr.Equiv (T.alg O).ring.R (C.El Dp (Q L.lpt)) =
    Lemma66[l].invEquiv (C.El Dp (Q L.lpt)) (T.alg O).ring.R Phi Phi-equiv ;
   rhs-equiv : Pk.isEquiv (C.El (S.yo x) Bg) (C.El Dp (Q L.lpt)) (\ s -> R6.At[x,g].Pt[s].rhs) =
    toK (C.El (S.yo x) Bg) (C.El Dp (Q L.lpt)) (\ s -> R6.At[x,g].Pt[s].rhs)
     (Equivalences[l].homotopy (C.El (S.yo x) Bg) (C.El Dp (Q L.lpt))
       (Equivalences[l].compose (C.El (S.yo x) Bg) (T.alg O).ring.R (C.El Dp (Q L.lpt)) (K0.K,K0.K-equiv) Phi-inv)
       (\ s -> R6.At[x,g].Pt[s].rhs)
       (\ s -> Pr.trans (C.El Dp (Q L.lpt)) _ (Phi-inv.1 (Phi (R6.At[x,g].Pt[s].rhs))) _
         (Pr.sym (C.El Dp (Q L.lpt)) (Phi-inv.1 (Phi (R6.At[x,g].Pt[s].rhs))) (R6.At[x,g].Pt[s].rhs)
           (Pr.sec-ret (C.El Dp (Q L.lpt)) (T.alg O).ring.R Phi Phi-equiv (R6.At[x,g].Pt[s].rhs)))
         (Pr.ap (T.alg O).ring.R (C.El Dp (Q L.lpt)) Phi-inv.1 _ _ (Arg[s].Phi-rhs)))) ;
   -- the component of lambda ev at (x , g) is an equivalence (Remark 60)
   component : Pk.isEquiv (C.El (S.yo x) Bg) (Pt.fib T.G0 (PI.Pi T.G0 T.Sp P) x g) (\ s -> R6.At[x,g].Pt[s].u) =
    R6.At[x,g].remark60-eq rhs-equiv ;
  } ;
  -- THEOREM 62 (Axiom 2, duality): lambda ev : <->_{T/G} -> G^{Sp} is an
  -- equivalence in the model (Prop 17, with Modal-Pi for G^{Sp})
  theorem62 : Dd.IsEqT T.G0 T.Br (PI.Pi T.G0 T.Sp P) R6.lamm =
   Dd.prop17 T.G0 T.Br (PI.Pi T.G0 T.Sp P) R6.lamm Md.Br-modal
    (MP.Modal-Pi T.G0 T.Sp P Md.Sp-fib (Dd.Modal-sub GA T.G0 T.Gt (C.p T.G0 T.Sp) Md.Gt-modal))
    (\ x g -> At[x,g].component) ;
 } ;
} ;
