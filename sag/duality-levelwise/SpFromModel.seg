-- SpFromModel.seg: P3.5 (Construction 57, syntactic form) from the model
-- structure, DUALITY.md Tier 3 step 3.  The record SpF reads the model
-- fibrewise, over BrFromModel's PModF:
--   S3.5   G over G0 (Gt, gE, gE-nat) and over yo x (Gx), with its global
--          elements alg x (gD, Remark 46 + Yoneda);
--   S3.1   Yoneda for models: global elements over yo x are the fibre at
--          the identity point (glob), sending pe to eE;
--          Sp's fibre at g is the hom-type of models <w_g> -> G (spH);
--          ev applies such a map (ev-link).
-- Derived here: spE (the fibre of Sp at g as solutions of prs g),
-- defined as "evaluate at the generators", and its equivalence (from pr
-- and gD).  spE-nat and ev-clause follow (next step).
--
-- Informal proof of spE-eq.  For c in the fibre, evaluation at c is the
-- algebra map brAlg -> alg x given by gD . ElDm (spH c) . glob^-1 .
-- linkHom; on the generators it gives gD (ElDm (spH c) (pe w)) (linkGen,
-- glob-pe).  So spE = (move along gD) . (pr's map) . spH, a composite
-- of equivalences.
level l k ;
constraint l+ <= k ;
open Ring[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module O = T3[l,k].Over[R,setR] ;
 module Alg = Algebras[l].Over[R,setR] ;
 module BM = BrFromModel[l,k].Over[R,setR] ;
 module E1m = E1[l,k].Over[R,setR] ;
 record SpF (C : T2[l,k].PCwF) (S : T2[l,k].Site[C]) (alg : S.Ob -> Alg.Algebra)
  (homAlg : (y x : S.Ob) -> S.Hom y x -> Alg.Hom (alg x) (alg y)) (P : BM.S39[C,S,alg,homAlg])
  (PM : BM.PModF[C,S,alg,homAlg,P]) {
  -- S3.5: G over G0
  Gt : C.Ty P.G0 ;
  gE (x : S.Ob) (g : C.Sub (S.yo x) P.G0) : Pr.Equiv (T2[l,k].Der[C].Pts[S].fib P.G0 Gt x g) (alg x).ring.R ;
  gE-nat (y x : S.Ob) (f : S.Hom y x) (g : C.Sub (S.yo x) P.G0) (c : T2[l,k].Der[C].Pts[S].fib P.G0 Gt x g) :
   Id (alg y).ring.R ((gE y (O.Rf[C,S,P.G0,Gt].at y x f g)).1 (O.Rf[C,S,P.G0,Gt].res y x f g c))
    ((homAlg y x f).1.1 ((gE x g).1 c)) ;
  -- S3.5: G over yo x, whose global elements are alg x
  Gx (x : S.Ob) : (PM.D x).Ob ;
  gD (x : S.Ob) : Algebras[l].Over[(alg x).ring,(alg x).set].Hom ((PM.MD x).ElD (Gx x))
   (Relative[l].Over[R,setR].Under[alg x].under (alg x) (Alg.identity (alg x))) ;
  gD-inv (x : S.Ob) : Algebras[l].Over[(alg x).ring,(alg x).set].Hom
   (Relative[l].Over[R,setR].Under[alg x].under (alg x) (Alg.identity (alg x))) ((PM.MD x).ElD (Gx x)) ;
  gD-l (x : S.Ob) (z : ((PM.MD x).ElD (Gx x)).ring.R) : Id ((PM.MD x).ElD (Gx x)).ring.R ((gD-inv x).1.1 ((gD x).1.1 z)) z ;
  gD-r (x : S.Ob) (z : (alg x).ring.R) : Id (alg x).ring.R ((gD x).1.1 ((gD-inv x).1.1 z)) z ;
  -- S3.1: Yoneda for models (global elements over yo x = fibre at the identity)
  globInv (x : S.Ob) (a : (PM.D x).Ob) : Algebras[l].Over[(alg x).ring,(alg x).set].Hom
   (((PM.Ad x).Uo a) x (C.id (S.yo x))) ((PM.MD x).ElD a) ;
  glob-gen (x : S.Ob) (g : C.Sub (S.yo x) P.G0) (v : Presentations[l].Fin (P.prs x g).1) :
   Id ((PM.MD x).ElD ((PM.MD x).pm (P.prs x g))).ring.R
    ((globInv x ((PM.MD x).pm (P.prs x g))).1.1
      ((Transfer2[l,k].PresTr[C,S,S.yo x,BM.Bse[C,S,alg,homAlg].bs x,(alg x).ring,(alg x).set,
          BM.Bse[C,S,alg,homAlg].kp x,PM.D x,PM.Ad x,PM.MD x,P.prs x g].TI.T.eE x (C.id (S.yo x))).1 v))
    (((PM.MD x).pe (P.prs x g)).1 v) ;
  -- S3.1: Sp's fibre is the hom-type of models <w_g> -> G
  Sp : C.Ty P.G0 ;
  spH (x : S.Ob) (g : C.Sub (S.yo x) P.G0) :
   Pr.Equiv (T2[l,k].Der[C].Pts[S].fib P.G0 Sp x g) ((PM.D x).Hom ((PM.MD x).pm (P.prs x g)) (Gx x)) ;
  -- ev applies a map of models
  ev : T2[l,k].Der[C].Map (C.ext P.G0 Sp) (C.subT (C.ext P.G0 Sp) P.G0 PM.Br (C.p P.G0 Sp)) (C.subT (C.ext P.G0 Sp) P.G0 Gt (C.p P.G0 Sp)) ;
  ev-link (x : S.Ob) (g : C.Sub (S.yo x) P.G0) (c : T2[l,k].Der[C].Pts[S].fib P.G0 Sp x g)
   (b : T2[l,k].Der[C].Pts[S].fib P.G0 PM.Br x g) :
   Id (alg x).ring.R
    ((gE x g).1 (T2[l,k].Der[C].trE (S.yo x) _ _ (T2[l,k].Der[C].wkp (S.yo x) P.G0 Sp Gt g c)
      (T2[l,k].Der[C].Pts[S].onFib (C.ext P.G0 Sp) (C.subT (C.ext P.G0 Sp) P.G0 PM.Br (C.p P.G0 Sp))
        (C.subT (C.ext P.G0 Sp) P.G0 Gt (C.p P.G0 Sp))
        ev x (C.pair (S.yo x) P.G0 Sp g c)
        (T2[l,k].Der[C].trE (S.yo x) _ _ (Prelude[k].sym (C.Ty (S.yo x)) _ _ (T2[l,k].Der[C].wkp (S.yo x) P.G0 Sp PM.Br g c)) b))))
    ((gD x).1.1 (((PM.MD x).ElDm ((PM.MD x).pm (P.prs x g)) (Gx x) ((spH x g).1 c)).1.1
      ((globInv x ((PM.MD x).pm (P.prs x g))).1.1 ((PM.linkHom x g).1.1 ((PM.brC x g).1 b))))) ;
 } ;
 module Derive (C : T2[l,k].PCwF) (S : T2[l,k].Site[C]) (alg : S.Ob -> Alg.Algebra)
  (homAlg : (y x : S.Ob) -> S.Hom y x -> Alg.Hom (alg x) (alg y)) (P : BM.S39[C,S,alg,homAlg])
  (PM : BM.PModF[C,S,alg,homAlg,P]) (F : SpF[C,S,alg,homAlg,P,PM]) {
  module At (x : S.Ob) (g : C.Sub (S.yo x) P.G0) {
   module AK = Algebras[l].Over[(alg x).ring,(alg x).set] ;
   module PK = Presentations[l].Over[(alg x).ring,(alg x).set] ;
   w : PK.Presentation = P.prs x g ;
   self : AK.Algebra = Relative[l].Over[R,setR].Under[alg x].under (alg x) (Alg.identity (alg x)) ;
   Hm : U l = (PM.D x).Hom ((PM.MD x).pm w) (F.Gx x) ;
   -- evaluation at a fibre element, as an algebra map brAlg -> alg x
   evH (h : Hm) : AK.Hom (PM.brAlg x g) self =
    AK.compose (PM.brAlg x g) ((PM.MD x).ElD (F.Gx x)) self (F.gD x)
     (AK.compose (PM.brAlg x g) ((PM.MD x).ElD ((PM.MD x).pm w)) ((PM.MD x).ElD (F.Gx x)) ((PM.MD x).ElDm ((PM.MD x).pm w) (F.Gx x) h)
       (AK.compose (PM.brAlg x g) (((PM.Ad x).Uo ((PM.MD x).pm w)) x (C.id (S.yo x))) ((PM.MD x).ElD ((PM.MD x).pm w))
         (F.globInv x ((PM.MD x).pm w)) (PM.linkHom x g))) ;
   -- spE : evaluate at the generators
   spE (c : T2[l,k].Der[C].Pts[S].fib P.G0 F.Sp x g) : O.Pd[alg x,w].Sol =
    PK.canonical w (PM.brAlg x g) (PM.brGen x g) self (evH ((F.spH x g).1 c)) ;
   -- pr's map, moved along gD
   prm (h : Hm) : PK.Solutions w ((PM.MD x).ElD (F.Gx x)) =
    PK.canonical w ((PM.MD x).ElD ((PM.MD x).pm w)) ((PM.MD x).pe w) ((PM.MD x).ElD (F.Gx x)) ((PM.MD x).ElDm ((PM.MD x).pm w) (F.Gx x) h) ;
   alongD (z : PK.Solutions w ((PM.MD x).ElD (F.Gx x))) : O.Pd[alg x,w].Sol = PK.canonical w ((PM.MD x).ElD (F.Gx x)) z self (F.gD x) ;
   alongD-eq : Pr.isEquiv (PK.Solutions w ((PM.MD x).ElD (F.Gx x))) O.Pd[alg x,w].Sol alongD =
    Pr.qinv (PK.Solutions w ((PM.MD x).ElD (F.Gx x))) O.Pd[alg x,w].Sol alongD
     (\ z -> PK.canonical w self z ((PM.MD x).ElD (F.Gx x)) (F.gD-inv x))
     (\ z -> PK.solutions-ext w self _ z (\ v -> F.gD-r x (z.1 v)))
     (\ z -> PK.solutions-ext w ((PM.MD x).ElD (F.Gx x)) _ z (\ v -> F.gD-l x (z.1 v))) ;
   -- on generators, evaluation is gD . ElDm h . pe
   spE-gen (h : Hm) (v : Presentations[l].Fin w.1) :
    Id (alg x).ring.R ((evH h).1.1 ((PM.brGen x g).1 v)) ((F.gD x).1.1 (((PM.MD x).ElDm ((PM.MD x).pm w) (F.Gx x) h).1.1 (((PM.MD x).pe w).1 v))) =
    ap (\ z -> (F.gD x).1.1 (((PM.MD x).ElDm ((PM.MD x).pm w) (F.Gx x) h).1.1 z))
     (trans (ap (F.globInv x ((PM.MD x).pm w)).1.1 (PM.linkGen x g v)) (F.glob-gen x g v)) ;
   spE-eq : Pr.isEquiv (T2[l,k].Der[C].Pts[S].fib P.G0 F.Sp x g) O.Pd[alg x,w].Sol spE =
    Equivalences[l].homotopy (T2[l,k].Der[C].Pts[S].fib P.G0 F.Sp x g) O.Pd[alg x,w].Sol
     (Equivalences[l].compose (T2[l,k].Der[C].Pts[S].fib P.G0 F.Sp x g) Hm O.Pd[alg x,w].Sol (F.spH x g)
       (Equivalences[l].compose Hm (PK.Solutions w ((PM.MD x).ElD (F.Gx x))) O.Pd[alg x,w].Sol (prm,E1m.toL Hm (PK.Solutions w ((PM.MD x).ElD (F.Gx x))) prm ((PM.MD x).pr w (F.Gx x))) (alongD,alongD-eq)))
     spE
     (\ c -> PK.solutions-ext w self (spE c) _ (\ v -> spE-gen ((F.spH x g).1 c) v)) ;
  } ;
 } ;
} ;
