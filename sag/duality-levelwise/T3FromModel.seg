-- T3FromModel.seg: the record T3 (Tier 3's statements) assembled from
-- the model-level premises, so that P3.3-P3.5 (Constructions 55-57,
-- syntactic form) are no longer premises:
--   S36  the site: objects are R-algebras (maps reversed), with an object
--        for each presented algebra (S3.6, Construction 39 / Lemma 42);
--   S39  points of G0 are syntactic presentations (BrFromModel);
--   PModF presented models in families (BrFromModel; P3.4 proved there);
--   SpF  G, Sp and ev (SpFromModel; P3.5 proved there and in SpNat).
-- Then the three presheaf axioms from these premises (PresheafAxiomsM).
level l k ;
constraint l+ <= k ;
open Ring[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module Tm = T3[l,k].Over[R,setR] ;
 module Alg = Algebras[l].Over[R,setR] ;
 module BM = BrFromModel[l,k].Over[R,setR] ;
 module SM = SpFromModel[l,k].Over[R,setR] ;
 module SN = SpNat[l,k].Over[R,setR] ;
 module E1m = E1[l,k].Over[R,setR] ;
 module E2m = E2[l,k].Over[R,setR] ;
 module SA = SAGPresheaf[l,k].Over[R,setR] ;
 record S36 (C : T2[l,k].PCwF) (S : T2[l,k].Site[C]) (alg : S.Ob -> Alg.Algebra)
  (homAlg : (y x : S.Ob) -> S.Hom y x -> Alg.Hom (alg x) (alg y)) {
  homAlg-eq (y x : S.Ob) : Pr.isEquiv (S.Hom y x) (Alg.Hom (alg x) (alg y)) (homAlg y x) ;
  homAlg-o (z y x : S.Ob) (f : S.Hom y x) (g : S.Hom z y) (a : (alg x).ring.R) :
   Id (alg z).ring.R ((homAlg z x (S.compH z y x f g)).1.1 a) ((homAlg z y g).1.1 ((homAlg y x f).1.1 a)) ;
  obj (x : S.Ob) (u : Tm.Pres (alg x)) : S.Ob ;
  objHom (x : S.Ob) (u : Tm.Pres (alg x)) : S.Hom (obj x u) x ;
  objIso (x : S.Ob) (u : Tm.Pres (alg x)) : Alg.Hom (Relative[l].Over[R,setR].Under[alg x].total Tm.Pd[alg x,u].X) (alg (obj x u)) ;
  objInv (x : S.Ob) (u : Tm.Pres (alg x)) : Alg.Hom (alg (obj x u)) (Relative[l].Over[R,setR].Under[alg x].total Tm.Pd[alg x,u].X) ;
  objInv-l (x : S.Ob) (u : Tm.Pres (alg x)) (b : Tm.Pd[alg x,u].Car) : Id Tm.Pd[alg x,u].Car ((objInv x u).1.1 ((objIso x u).1.1 b)) b ;
  objInv-r (x : S.Ob) (u : Tm.Pres (alg x)) (c : (alg (obj x u)).ring.R) :
   Id (alg (obj x u)).ring.R ((objIso x u).1.1 ((objInv x u).1.1 c)) c ;
  objHom-p (x : S.Ob) (u : Tm.Pres (alg x)) (a : (alg x).ring.R) :
   Id (alg (obj x u)).ring.R ((homAlg (obj x u) x (objHom x u)).1.1 a) ((objIso x u).1.1 (Tm.Pd[alg x,u].X.iota.1 a)) ;
 } ;
 module Build (C : T2[l,k].PCwF) (S : T2[l,k].Site[C]) (alg : S.Ob -> Alg.Algebra)
  (homAlg : (y x : S.Ob) -> S.Hom y x -> Alg.Hom (alg x) (alg y)) (St : S36[C,S,alg,homAlg])
  (P : BM.S39[C,S,alg,homAlg]) (PM : BM.PModF[C,S,alg,homAlg,P]) (F : SM.SpF[C,S,alg,homAlg,P,PM]) {
  module BE = BM.BrE[C,S,alg,homAlg,P,PM] ;
  module Dv = SM.Derive[C,S,alg,homAlg,P,PM,F] ;
  module NN = SN.N[C,S,alg,homAlg,P,PM,F] ;
  t3 : Tm.T3[C,S] = new Tm.T3[C,S,
   alg := alg, homAlg := homAlg, homAlg-eq := St.homAlg-eq, homAlg-o := St.homAlg-o,
   G0 := P.G0, prs := P.prs, prs-eq := P.prs-eq, prs-nat := P.prs-nat,
   obj := St.obj, objHom := St.objHom, objIso := St.objIso, objInv := St.objInv,
   objInv-l := St.objInv-l, objInv-r := St.objInv-r, objHom-p := St.objHom-p,
   Br := PM.Br, brE := BE.brE, brE-nat := BE.brE-nat,
   Gt := F.Gt, gE := F.gE, gE-nat := F.gE-nat,
   Sp := F.Sp, spE := \ x g -> (Dv.At[x,g].spE,Dv.At[x,g].spE-eq), spE-nat := NN.spE-nat,
   ev := F.ev, ev-clause := \ x g c b -> Dv.At[x,g].ev-clause c b] ;
 } ;
 -- the three presheaf axioms from the model-level premises
 module PresheafAxiomsM (C : T2[l,k].PCwF) (S : T2[l,k].Site[C]) (PI : T2[l,k].PiS[C]) (Dd : T2[l,k].DS[C,S])
  (MP : T2[l,k].ModPi[C,S,PI,Dd]) (alg : S.Ob -> Alg.Algebra)
  (homAlg : (y x : S.Ob) -> S.Hom y x -> Alg.Hom (alg x) (alg y)) (St : S36[C,S,alg,homAlg])
  (P : BM.S39[C,S,alg,homAlg]) (PM : BM.PModF[C,S,alg,homAlg,P]) (F : SM.SpF[C,S,alg,homAlg,P,PM])
  (Md : E1m.Mods[C,S,Dd,Build[C,S,alg,homAlg,St,P,PM,F].t3])
  (Nn : E2m.NS[C,S,Dd,P.G0]) (Tt : E3[l,k].TrS[C,S,Dd]) {
  module Ax = SA.PresheafAxioms[C,S,PI,Dd,MP,Build[C,S,alg,homAlg,St,P,PM,F].t3,Md,Nn,Tt] ;
  duality : Dd.IsEqT P.G0 PM.Br (PI.Pi P.G0 F.Sp Ax.A2.P) Ax.A2.R6.lamm = Ax.duality ;
  n-constant : Dd.IsEqT P.G0 Nn.N (PI.Pi P.G0 F.Sp Ax.A3.Np) Ax.A3.R6.lamm = Ax.n-constant ;
  projective : E3[l,k].P76[C,S,PI,Dd,MP,Tt].Proj P.G0 F.Sp = Ax.projective ;
 } ;
} ;
