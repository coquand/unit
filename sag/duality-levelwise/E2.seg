-- E2.seg: Theorem 61 (Axiom 3, the natural numbers are constant) in the
-- model, DUALITY.md Tier 5 (canonicity-45).
--
-- Statement: the constant map N -> N^{Sp} over 1.Pr (the transpose of the
-- projection pi_1 : N x Sp -> N) is an internal equivalence (IsEqT).
--
-- Premises beyond those of Theorem 62 (E1.Thm62: T2, T3, Mods, P58):
--   NS (S2.7): the natural numbers N_DT of the model over 1.Pr, fibrant
--   and D-modal, with fibres naturally equivalent to N (the levelwise
--   content of N_DT = D(Delta N) with tau_{Delta N} natural: Lemma 14 makes
--   its components equivalences, and Delta N is constant).
--
-- Informal proof (jonas.pdf, proof of Theorem 61).  By Prop 17 (prop17,
-- with Modal-Pi for N^{Sp}) it suffices that each component of the
-- transpose is an equivalence; by Remark 60 (remark60-eq) that
-- s |-> m at lpt of S(p_O) s is one.  Here m = pi_1 is q, so this map is
-- S(p_O) s itself (q-pair): the restriction of N along p_O, transported.
-- The restriction is an equivalence since nE y . res = nE x (nE-nat) with
-- nE x , nE y equivalences.

level l k ;
constraint l <= k ;
open Base ;
open Ring[l] ;
module Pr = Prelude[l] ;
module Pk = Prelude[k] ;

module Over (R : CRing) (setR : Pr.isSet R.R) {
 module Tm = T3[l,k].Over[R,setR] ;
 module E1m = E1[l,k].Over[R,setR] ;

 -- S2.7: the natural numbers of the model over a context G
 record NS (C : T2[l,k].PCwF) (S : T2[l,k].Site[C]) (Dd : T2[l,k].DS[C,S]) (G : C.Ctx) {
  N : C.Ty G ;
  N-fib : Dd.Fib G N ;
  N-modal : Dd.Modal G N ;
  nE (x : S.Ob) (g : C.Sub (S.yo x) G) : Pk.Equiv (T2[l,k].Der[C].Pts[S].fib G N x g) Nat ;
  nE-nat (y x : S.Ob) (f : S.Hom y x) (g : C.Sub (S.yo x) G) (c : T2[l,k].Der[C].Pts[S].fib G N x g) :
   Id Nat ((nE y (Tm.Rf[C,S,G,N].at y x f g)).1 (Tm.Rf[C,S,G,N].res y x f g c)) ((nE x g).1 c) ;
 } ;

 module Thm61 (C : T2[l,k].PCwF) (S : T2[l,k].Site[C]) (PI : T2[l,k].PiS[C]) (Dd : T2[l,k].DS[C,S])
  (MP : T2[l,k].ModPi[C,S,PI,Dd]) (T : Tm.T3[C,S]) (Md : E1m.Mods[C,S,Dd,T]) (L58 : E1m.P58[C,S,T])
  (Nn : NS[C,S,Dd,T.G0]) {
  module DR = T2[l,k].Der[C] ;
  module Pt = DR.Pts[S] ;
  module TM = TE[l,k].TEm[C] ;
  module T62 = E1m.Thm62[C,S,PI,Dd,MP,T,Md,L58] ;
  GA : C.Ctx = C.ext T.G0 T.Sp ;
  -- N over G0.Sp, and pi_1 : N[p] -> N[p] (the variable)
  Np : C.Ty GA = C.subT GA T.G0 Nn.N (C.p T.G0 T.Sp) ;
  pi1 : DR.Map GA Np Np = C.q GA Np ;
  module R6 = Remark60[l,k].R60[C,S,PI,Dd,T.G0,T.Sp,T62.rep,Np,
   Dd.Fib-sub GA T.G0 Nn.N (C.p T.G0 T.Sp) Nn.N-fib,
   Dd.Modal-sub GA T.G0 Nn.N (C.p T.G0 T.Sp) Nn.N-modal,
   Nn.N,pi1] ;

  module At (x : S.Ob) (g : C.Sub (S.yo x) T.G0) {
   module L = R6.At[x,g].L ;
   O : S.Ob = L.xg ;
   Dp : C.Ctx = S.yo O ;
   Ng : C.Ty (S.yo x) = C.subT (S.yo x) T.G0 Nn.N g ;
   module Rf = Tm.Rf[C,S,T.G0,Nn.N] ;
   pO : S.Hom O x = T62.rep.pg x g ;

   -- the restriction of N along p_O is an equivalence (nE-nat)
   resEq : Pk.isEquiv (Pt.fib T.G0 Nn.N x g) (Pt.fib T.G0 Nn.N O (Rf.at O x pO g)) (Rf.res O x pO g) =
    Equivalences[k].homotopy (Pt.fib T.G0 Nn.N x g) (Pt.fib T.G0 Nn.N O (Rf.at O x pO g))
     (Equivalences[k].compose (Pt.fib T.G0 Nn.N x g) Nat (Pt.fib T.G0 Nn.N O (Rf.at O x pO g))
       (Nn.nE x g) (Lemma66[k].invEquiv (Pt.fib T.G0 Nn.N O (Rf.at O x pO g)) Nat (Nn.nE O (Rf.at O x pO g)).1 (Nn.nE O (Rf.at O x pO g)).2))
     (Rf.res O x pO g)
     (\ c -> Pk.trans (Pt.fib T.G0 Nn.N O (Rf.at O x pO g)) (Rf.res O x pO g c)
         ((Nn.nE O (Rf.at O x pO g)).2.sec ((Nn.nE O (Rf.at O x pO g)).1 (Rf.res O x pO g c)))
         ((Nn.nE O (Rf.at O x pO g)).2.sec ((Nn.nE x g).1 c))
        (Pk.sym (Pt.fib T.G0 Nn.N O (Rf.at O x pO g)) ((Nn.nE O (Rf.at O x pO g)).2.sec ((Nn.nE O (Rf.at O x pO g)).1 (Rf.res O x pO g c))) (Rf.res O x pO g c)
          (Pk.sec-ret (Pt.fib T.G0 Nn.N O (Rf.at O x pO g)) Nat (Nn.nE O (Rf.at O x pO g)).1 (Nn.nE O (Rf.at O x pO g)).2 (Rf.res O x pO g c)))
        (Pk.ap Nat (Pt.fib T.G0 Nn.N O (Rf.at O x pO g)) (Nn.nE O (Rf.at O x pO g)).2.sec _ _ (Nn.nE-nat O x pO g c))) ;

   -- subt along yp is the restriction, up to the transport defining it
   P0 : Id (C.Ty Dp) (C.subT Dp (S.yo x) Ng L.yp) (C.subT Dp T.G0 Nn.N (Rf.at O x pO g)) =
    Pk.sym (C.Ty Dp) (C.subT Dp T.G0 Nn.N (Rf.at O x pO g)) (C.subT Dp (S.yo x) Ng L.yp) (C.subT-o Dp (S.yo x) T.G0 Nn.N g L.yp) ;
   subtEq : Pk.isEquiv (C.El (S.yo x) Ng) (C.El Dp (C.subT Dp (S.yo x) Ng L.yp)) (\ s -> C.subt Dp (S.yo x) Ng s L.yp) =
    Equivalences[k].homotopy (C.El (S.yo x) Ng) (C.El Dp (C.subT Dp (S.yo x) Ng L.yp))
     (Equivalences[k].compose (C.El (S.yo x) Ng) (Pt.fib T.G0 Nn.N O (Rf.at O x pO g)) (C.El Dp (C.subT Dp (S.yo x) Ng L.yp))
       (Rf.res O x pO g, resEq)
       (Lemma66[k].invEquiv (C.El Dp (C.subT Dp (S.yo x) Ng L.yp)) (Pt.fib T.G0 Nn.N O (Rf.at O x pO g)) (DR.trE Dp (C.subT Dp (S.yo x) Ng L.yp) (C.subT Dp T.G0 Nn.N (Rf.at O x pO g)) P0)
          (TM.trE-eq Dp (C.subT Dp (S.yo x) Ng L.yp) (C.subT Dp T.G0 Nn.N (Rf.at O x pO g)) P0)))
     (\ s -> C.subt Dp (S.yo x) Ng s L.yp)
     (\ s -> Pk.sym (C.El Dp (C.subT Dp (S.yo x) Ng L.yp))
        ((TM.trE-eq Dp (C.subT Dp (S.yo x) Ng L.yp) (C.subT Dp T.G0 Nn.N (Rf.at O x pO g)) P0).sec (Rf.res O x pO g s))
        (C.subt Dp (S.yo x) Ng s L.yp)
        (Pk.sec-ret (C.El Dp (C.subT Dp (S.yo x) Ng L.yp)) (C.El Dp (C.subT Dp T.G0 Nn.N (Rf.at O x pO g)))
          (DR.trE Dp (C.subT Dp (S.yo x) Ng L.yp) (C.subT Dp T.G0 Nn.N (Rf.at O x pO g)) P0)
          (TM.trE-eq Dp (C.subT Dp (S.yo x) Ng L.yp) (C.subT Dp T.G0 Nn.N (Rf.at O x pO g)) P0)
          (C.subt Dp (S.yo x) Ng s L.yp))) ;

   -- the type path of R60's rs (it does not depend on s)
   PrsN : Id (C.Ty Dp) (C.subT Dp (S.yo x) Ng L.yp) (C.subT Dp GA Np L.lpt) =
    Pk.trans (C.Ty Dp) (C.subT Dp (S.yo x) Ng L.yp) (C.subT Dp T.G0 Nn.N L.s2) (C.subT Dp GA Np L.lpt)
     (Pk.sym (C.Ty Dp) (C.subT Dp T.G0 Nn.N L.s2) (C.subT Dp (S.yo x) Ng L.yp) (C.subT-o Dp (S.yo x) T.G0 Nn.N g L.yp))
     (Pk.trans (C.Ty Dp) (C.subT Dp T.G0 Nn.N L.s2) (C.subT Dp T.G0 Nn.N L.s1) (C.subT Dp GA Np L.lpt)
       (Pk.ap (C.Sub Dp T.G0) (C.Ty Dp) (\ t -> C.subT Dp T.G0 Nn.N t) L.s2 L.s1 (Pk.sym (C.Sub Dp T.G0) L.s1 L.s2 L.lpt-e))
       (C.subT-o Dp GA T.G0 Nn.N (C.p T.G0 T.Sp) L.lpt)) ;

   -- rhs s = rs s (q-pair: pi_1 at a pair is its second part)
   rhs-rs (s : C.El (S.yo x) Ng) : Id (C.El Dp (C.subT Dp GA Np L.lpt)) (R6.At[x,g].Pt[s].rhs) (R6.At[x,g].Pt[s].rs) =
    C.q-pair Dp GA Np L.lpt (R6.At[x,g].Pt[s].rs) ;

   rhs-equiv : Pk.isEquiv (C.El (S.yo x) Ng) (C.El Dp (C.subT Dp GA Np L.lpt)) (\ s -> R6.At[x,g].Pt[s].rhs) =
    Equivalences[k].homotopy (C.El (S.yo x) Ng) (C.El Dp (C.subT Dp GA Np L.lpt))
     (Equivalences[k].compose (C.El (S.yo x) Ng) (C.El Dp (C.subT Dp (S.yo x) Ng L.yp)) (C.El Dp (C.subT Dp GA Np L.lpt))
       (\ s -> C.subt Dp (S.yo x) Ng s L.yp, subtEq)
       (DR.trE Dp (C.subT Dp (S.yo x) Ng L.yp) (C.subT Dp GA Np L.lpt) (PrsN),
        TM.trE-eq Dp (C.subT Dp (S.yo x) Ng L.yp) (C.subT Dp GA Np L.lpt) (PrsN)))
     (\ s -> R6.At[x,g].Pt[s].rhs)
     (\ s -> Pk.trans (C.El Dp (C.subT Dp GA Np L.lpt)) (R6.At[x,g].Pt[s].rhs) (R6.At[x,g].Pt[s].rs)
        (DR.trE Dp (C.subT Dp (S.yo x) Ng L.yp) (C.subT Dp GA Np L.lpt) (PrsN) (C.subt Dp (S.yo x) Ng s L.yp))
        (rhs-rs s) (refl (R6.At[x,g].Pt[s].rs))) ;

   component : Pk.isEquiv (C.El (S.yo x) Ng) (Pt.fib T.G0 (PI.Pi T.G0 T.Sp Np) x g) (\ s -> R6.At[x,g].Pt[s].u) =
    R6.At[x,g].remark60-eq rhs-equiv ;
  } ;

  -- THEOREM 61 (Axiom 3): the constant map N -> N^{Sp} is an equivalence
  -- in the model (Prop 17, with Modal-Pi for N^{Sp})
  theorem61 : Dd.IsEqT T.G0 Nn.N (PI.Pi T.G0 T.Sp Np) R6.lamm =
   Prop17[l,k].P17[C,S,Dd].prop17 T.G0 Nn.N (PI.Pi T.G0 T.Sp Np) R6.lamm
    Nn.N-fib (MP.Fib-Pi T.G0 T.Sp Np (Dd.Fib-sub GA T.G0 Nn.N (C.p T.G0 T.Sp) Nn.N-fib)) Nn.N-modal
    (MP.Modal-Pi T.G0 T.Sp Np Md.Sp-fib (Dd.Modal-sub GA T.G0 Nn.N (C.p T.G0 T.Sp) Nn.N-modal))
    (\ x g -> At[x,g].component) ;
 } ;
} ;
