-- BrFromModel.seg: DUALITY.md Tier 3 step 3, P3.3 and P3.4 (canonicity-45).
-- The context G0 of syntactic presentations (P3.3, from S3.9) and the
-- type Br over G0 of presented models (P3.4): its fibre at a point g of
-- G0 over x is the Tier 1 presented algebra of the presentation prs x g,
-- naturally in x.
--
--   S39     premise S3.9: N, List, Expr_G computed levelwise, so the
--           points of G0 at x are Tier 1's presentations over alg x,
--           restriction = change of coefficients (P3.3 is this record)
--   PModF   presented models in families (S3.1 / S3.2, fibrewise reading
--           of the model structure of <-> over G0):
--             models   for each x, models over yo x (ModelD of Transfer2,
--                      K = alg x by Remark 46), their carrier types, U as
--                      levelwise evaluation (carU);
--             Br       the carrier of <-> over G0, with its fibrewise
--                      algebra structure over alg x (brAlg), restriction an
--                      algebra map along homAlg (resA), and the generic
--                      generators (brGen), restricted to the generators
--                      moved by prs-nat (res-gen);
--             link     the ONLY place where the two meet: at (x , id),
--                      Br[g] is the carrier of <prs x g> (stab), and the
--                      resulting map is an algebra map preserving the
--                      generators (linkHom).
--   BrE     brE x g = Transfer2.brEq at (x , id) through the link;
--           brE-nat by uniqueness on generators (Tensor.hom-eq).
-- No cross-context comparison of models (no substitution of models) is
-- used: naturality is read from the structure on Br.

level l k ;
constraint l+ <= k ;
open Base ;
open Prelude[k] ;

-- an equivalence read at level l
toL (A B : U l) (f : A -> B) (e : isEquiv A B f) : Prelude[l].isEquiv A B f =
 Prelude[l].qinv A B f e.sec e.sec-eq (\ a -> sec-ret A B f e a) ;

module Over (R : Ring[l].CRing) (setR : Prelude[l].isSet R.R) {
 module O = T3[l,k].Over[R,setR] ;
 module Alg = Algebras[l].Over[R,setR] ;

 ------------------------------------------------------------------
 -- S3.9: the points of G0 are syntactic presentations (P3.3)

 record S39 (C : T2[l,k].PCwF) (S : T2[l,k].Site[C]) (alg : S.Ob -> Alg.Algebra)
  (homAlg : (y x : S.Ob) -> S.Hom y x -> Alg.Hom (alg x) (alg y)) {
  G0 : C.Ctx ;
  prs (x : S.Ob) (g : C.Sub (S.yo x) G0) : O.Pres (alg x) ;
  prs-eq (x : S.Ob) : Prelude[l].isEquiv (C.Sub (S.yo x) G0) (O.Pres (alg x)) (prs x) ;
  prs-nat (y x : S.Ob) (f : S.Hom y x) (g : C.Sub (S.yo x) G0) :
   Id (O.Pres (alg y)) (prs y (C.o (S.yo y) (S.yo x) G0 g (S.yoH y x f)))
    (O.change (alg x) (alg y) (homAlg y x f) (prs x g)) ;
 } ;

 ------------------------------------------------------------------
 -- the base data of models over yo x

 module Bse (C : T2[l,k].PCwF) (S : T2[l,k].Site[C]) (alg : S.Ob -> Alg.Algebra)
  (homAlg : (y x : S.Ob) -> S.Hom y x -> Alg.Hom (alg x) (alg y)) {
  -- the base ring at a point (x' , g') of yo x is alg x'
  bs (x : S.Ob) (x' : S.Ob) (g' : C.Sub (S.yo x') (S.yo x)) : (Rb : Ring[l].CRing) * Prelude[l].isSet Rb.R =
   ((alg x').ring, (alg x').set) ;
  yoInv (x' x : S.Ob) (g' : C.Sub (S.yo x') (S.yo x)) : S.Hom x' x = (S.yoH-eq x' x).sec g' ;
  -- global elements of G over yo x are alg x (Remark 46); kappa at (x' , g')
  kp (x : S.Ob) (x' : S.Ob) (g' : C.Sub (S.yo x') (S.yo x)) : RingHom[l].Hom (alg x).ring (alg x').ring =
   (homAlg x' x (yoInv x' x g')).1 ;
 } ;

 ------------------------------------------------------------------
 -- presented models in families (S3.1 / S3.2)

 record PModF (C : T2[l,k].PCwF) (S : T2[l,k].Site[C]) (alg : S.Ob -> Alg.Algebra)
  (homAlg : (y x : S.Ob) -> S.Hom y x -> Alg.Hom (alg x) (alg y)) (P : S39[C,S,alg,homAlg]) {
  -- models over yo x
  D (x : S.Ob) : Transfer[l,k].WCat ;
  Ad (x : S.Ob) : Transfer[l,k].Adj[D x, Transfer2[l,k].FamB[C,S,S.yo x,Bse[C,S,alg,homAlg].bs x].cat] ;
  MD (x : S.Ob) : Transfer2[l,k].ModelD[C,S,S.yo x,Bse[C,S,alg,homAlg].bs x,(alg x).ring,(alg x).set,
   Bse[C,S,alg,homAlg].kp x,D x,Ad x] ;
  car (x : S.Ob) (a : (D x).Ob) : C.Ty (S.yo x) ;
  -- U is levelwise evaluation of the carrier
  carU (x : S.Ob) (a : (D x).Ob) (x' : S.Ob) (g' : C.Sub (S.yo x') (S.yo x))
   : Prelude[l].Equiv (T2[l,k].Der[C].Pts[S].fib (S.yo x) (car x a) x' g') (((Ad x).Uo a) x' g').ring.R ;
  -- Br over G0, with its fibrewise algebra structure and generators
  Br : C.Ty P.G0 ;
  brAlg (x : S.Ob) (g : C.Sub (S.yo x) P.G0) : Algebras[l].Over[(alg x).ring,(alg x).set].Algebra ;
  brC (x : S.Ob) (g : C.Sub (S.yo x) P.G0)
   : Prelude[l].Equiv (T2[l,k].Der[C].Pts[S].fib P.G0 Br x g) (brAlg x g).ring.R ;
  resA (y x : S.Ob) (f : S.Hom y x) (g : C.Sub (S.yo x) P.G0)
   : Algebras[l].Over[(alg x).ring,(alg x).set].Hom (brAlg x g)
      (Relative[l].Along[(alg x).ring,(alg x).set,(alg y).ring,(alg y).set,(homAlg y x f).1].restrict
         (brAlg y (O.Rf[C,S,P.G0,Br].at y x f g))) ;
  resA-eq (y x : S.Ob) (f : S.Hom y x) (g : C.Sub (S.yo x) P.G0) (b : T2[l,k].Der[C].Pts[S].fib P.G0 Br x g)
   : Id (brAlg y (O.Rf[C,S,P.G0,Br].at y x f g)).ring.R ((resA y x f g).1.1 ((brC x g).1 b))
      ((brC y (O.Rf[C,S,P.G0,Br].at y x f g)).1 (O.Rf[C,S,P.G0,Br].res y x f g b)) ;
  brGen (x : S.Ob) (g : C.Sub (S.yo x) P.G0)
   : Presentations[l].Over[(alg x).ring,(alg x).set].Solutions (P.prs x g) (brAlg x g) ;
  res-gen (y x : S.Ob) (f : S.Hom y x) (g : C.Sub (S.yo x) P.G0) (v : Presentations[l].Fin (P.prs x g).1)
   : Id (brAlg y (O.Rf[C,S,P.G0,Br].at y x f g)).ring.R ((resA y x f g).1.1 ((brGen x g).1 v))
      ((Prelude[l].subst (O.Pres (alg y))
          (\ u -> Presentations[l].Over[(alg y).ring,(alg y).set].Solutions u (brAlg y (O.Rf[C,S,P.G0,Br].at y x f g)))
          (P.prs y (O.Rf[C,S,P.G0,Br].at y x f g)) (O.change (alg x) (alg y) (homAlg y x f) (P.prs x g))
          (P.prs-nat y x f g) (brGen y (O.Rf[C,S,P.G0,Br].at y x f g))).1 v) ;
  -- the link, at (x , id)
  stab (x : S.Ob) (g : C.Sub (S.yo x) P.G0)
   : Id (C.Ty (S.yo x)) (C.subT (S.yo x) P.G0 Br g) (car x ((MD x).pm (P.prs x g))) ;
  linkHom (x : S.Ob) (g : C.Sub (S.yo x) P.G0)
   : Algebras[l].Over[(alg x).ring,(alg x).set].Hom (brAlg x g) (((Ad x).Uo ((MD x).pm (P.prs x g))) x (C.id (S.yo x))) ;
  linkHom-eq (x : S.Ob) (g : C.Sub (S.yo x) P.G0) (b : T2[l,k].Der[C].Pts[S].fib P.G0 Br x g)
   : Id (((Ad x).Uo ((MD x).pm (P.prs x g))) x (C.id (S.yo x))).ring.R
      ((linkHom x g).1.1 ((brC x g).1 b))
      ((carU x ((MD x).pm (P.prs x g)) x (C.id (S.yo x))).1
        (T2[l,k].Der[C].trE (S.yo x) (car x ((MD x).pm (P.prs x g)))
           (C.subT (S.yo x) (S.yo x) (car x ((MD x).pm (P.prs x g))) (C.id (S.yo x)))
           (sym (C.Ty (S.yo x)) (C.subT (S.yo x) (S.yo x) (car x ((MD x).pm (P.prs x g))) (C.id (S.yo x)))
              (car x ((MD x).pm (P.prs x g))) (C.subT-id (S.yo x) (car x ((MD x).pm (P.prs x g)))))
           (T2[l,k].Der[C].trE (S.yo x) (C.subT (S.yo x) P.G0 Br g) (car x ((MD x).pm (P.prs x g))) (stab x g) b))) ;
  linkGen (x : S.Ob) (g : C.Sub (S.yo x) P.G0) (v : Presentations[l].Fin (P.prs x g).1)
   : Id (((Ad x).Uo ((MD x).pm (P.prs x g))) x (C.id (S.yo x))).ring.R
      ((linkHom x g).1.1 ((brGen x g).1 v))
      ((Transfer2[l,k].PresTr[C,S,S.yo x,Bse[C,S,alg,homAlg].bs x,(alg x).ring,(alg x).set,
          Bse[C,S,alg,homAlg].kp x,D x,Ad x,MD x,P.prs x g].TI.T.eE x (C.id (S.yo x))).1 v) ;
 } ;

 ------------------------------------------------------------------
 -- generic lemmas over a fixed algebra A: transport of presented
 -- algebras along paths of presentations is the canonical map

 module PL (A : Alg.Algebra) {
  module CA = Algebras[l].Over[A.ring,A.set] ;
  module PA = Presentations[l].Over[A.ring,A.set] ;
  module TA = Tensor[l].Over[A.ring,A.set] ;
  Fn (Z : CA.Algebra) (n : Ring[l].Nat) : U l = Presentations[l].Fin n -> Z.ring.R ;

  fstSub (Z : CA.Algebra) (w w' : O.Pres A) (E : Id (O.Pres A) w w') (s : PA.Solutions w Z)
   : Id (Fn Z w'.1) (Prelude[l].subst (O.Pres A) (\ u -> PA.Solutions u Z) w w' E s).1
      (Prelude[l].subst Ring[l].Nat (Fn Z) w.1 w'.1 (Prelude[l].ap (O.Pres A) Ring[l].Nat (\ z -> z.1) w w' E) s.1) =
   idJ (O.Pres A) w (\ w2 E2 -> Id (Fn Z w2.1) (Prelude[l].subst (O.Pres A) (\ u -> PA.Solutions u Z) w w2 E2 s).1
      (Prelude[l].subst Ring[l].Nat (Fn Z) w.1 w2.1 (Prelude[l].ap (O.Pres A) Ring[l].Nat (\ z -> z.1) w w2 E2) s.1))
    (refl s.1) w' E ;

  -- along a path to a presentation with the same number of variables,
  -- the values of a solution do not change (Ring[l].Nat is a set)
  solFix (Z : CA.Algebra) (w : O.Pres A) (es : PA.Equations (Presentations[l].Fin w.1))
   (E : Id (O.Pres A) w (w.1,es)) (s : PA.Solutions w Z) (v : Presentations[l].Fin w.1)
   : Id Z.ring.R ((Prelude[l].subst (O.Pres A) (\ u -> PA.Solutions u Z) w (w.1,es) E s).1 v) (s.1 v) =
   Prelude[l].happly (Presentations[l].Fin w.1) (\ v2 -> Z.ring.R)
    (Prelude[l].subst (O.Pres A) (\ u -> PA.Solutions u Z) w (w.1,es) E s).1 s.1
    (Prelude[l].trans (Fn Z w.1) (Prelude[l].subst (O.Pres A) (\ u -> PA.Solutions u Z) w (w.1,es) E s).1
       (Prelude[l].subst Ring[l].Nat (Fn Z) w.1 w.1 (Prelude[l].ap (O.Pres A) Ring[l].Nat (\ z -> z.1) w (w.1,es) E) s.1) s.1
       (fstSub Z w (w.1,es) E s)
       (Prelude[l].ap (Id Ring[l].Nat w.1 w.1) (Fn Z w.1) (\ M -> Prelude[l].subst Ring[l].Nat (Fn Z) w.1 w.1 M s.1)
          (Prelude[l].ap (O.Pres A) Ring[l].Nat (\ z -> z.1) w (w.1,es) E) (refl w.1)
          (P58Lemmas[l].nat-set w.1 w.1 (Prelude[l].ap (O.Pres A) Ring[l].Nat (\ z -> z.1) w (w.1,es) E) (refl w.1)))) v ;

  Gen (w : O.Pres A) : PA.Solutions w O.Pd[A,w].X = O.Pd[A,w].px.1 ;
  SolT (w w' : O.Pres A) (E : Id (O.Pres A) w w') : PA.Solutions w O.Pd[A,w'].X =
   Prelude[l].subst (O.Pres A) (\ u -> PA.Solutions u O.Pd[A,w'].X) w' w (Prelude[l].sym (O.Pres A) w w' E) (Gen w') ;
  -- the canonical map of a path of presentations
  mq (w w' : O.Pres A) (E : Id (O.Pres A) w w') : CA.Hom O.Pd[A,w].X O.Pd[A,w'].X =
   (O.Pd[A,w].px.2 O.Pd[A,w'].X).sec (SolT w w' E) ;
  mqGen (w w' : O.Pres A) (E : Id (O.Pres A) w w') (v : Presentations[l].Fin w.1)
   : Id O.Pd[A,w'].Car ((mq w w' E).1.1 ((Gen w).1 v)) ((SolT w w' E).1 v) =
   Prelude[l].ap (PA.Solutions w O.Pd[A,w'].X) O.Pd[A,w'].Car (\ s -> s.1 v) _ _
    ((O.Pd[A,w].px.2 O.Pd[A,w'].X).sec-eq (SolT w w' E)) ;
  secId (w : O.Pres A) : Id (CA.Hom O.Pd[A,w].X O.Pd[A,w].X) ((O.Pd[A,w].px.2 O.Pd[A,w].X).sec (Gen w)) (CA.identity O.Pd[A,w].X) =
   TA.hom-eq w O.Pd[A,w].X O.Pd[A,w].px O.Pd[A,w].X ((O.Pd[A,w].px.2 O.Pd[A,w].X).sec (Gen w)) (CA.identity O.Pd[A,w].X)
    (\ v -> Prelude[l].ap (PA.Solutions w O.Pd[A,w].X) O.Pd[A,w].Car (\ s -> s.1 v) _ _ ((O.Pd[A,w].px.2 O.Pd[A,w].X).sec-eq (Gen w))) ;
  trPd (w w' : O.Pres A) (E : Id (O.Pres A) w w') (c : O.Pd[A,w].Car)
   : Id O.Pd[A,w'].Car (Prelude[l].subst (O.Pres A) (\ u -> O.Pd[A,u].Car) w w' E c) ((mq w w' E).1.1 c) =
   idJ (O.Pres A) w (\ w2 E2 -> Id O.Pd[A,w2].Car (Prelude[l].subst (O.Pres A) (\ u -> O.Pd[A,u].Car) w w2 E2 c) ((mq w w2 E2).1.1 c))
    (Prelude[l].sym O.Pd[A,w].Car ((mq w w (refl w)).1.1 c) c
      (Prelude[l].ap (CA.Hom O.Pd[A,w].X O.Pd[A,w].X) O.Pd[A,w].Car (\ h -> h.1.1 c) _ _ (secId w))) w' E ;

  -- transport of solutions commutes with postcomposition
  natSub (Z Z' : CA.Algebra) (h : CA.Hom Z Z') (w w' : O.Pres A) (E : Id (O.Pres A) w w') (s : PA.Solutions w Z)
   : Id (PA.Solutions w' Z') (Prelude[l].subst (O.Pres A) (\ u -> PA.Solutions u Z') w w' E (PA.canonical w Z s Z' h))
      (PA.canonical w' Z (Prelude[l].subst (O.Pres A) (\ u -> PA.Solutions u Z) w w' E s) Z' h) =
   idJ (O.Pres A) w (\ w2 E2 -> Id (PA.Solutions w2 Z') (Prelude[l].subst (O.Pres A) (\ u -> PA.Solutions u Z') w w2 E2 (PA.canonical w Z s Z' h))
      (PA.canonical w2 Z (Prelude[l].subst (O.Pres A) (\ u -> PA.Solutions u Z) w w2 E2 s) Z' h))
    (refl (PA.canonical w Z s Z' h)) w' E ;

  substEq (w w' : O.Pres A) (E : Id (O.Pres A) w w')
   : Prelude[l].isEquiv O.Pd[A,w].Car O.Pd[A,w'].Car (Prelude[l].subst (O.Pres A) (\ u -> O.Pd[A,u].Car) w w' E) =
   idJ (O.Pres A) w (\ w2 E2 -> Prelude[l].isEquiv O.Pd[A,w].Car O.Pd[A,w2].Car (Prelude[l].subst (O.Pres A) (\ u -> O.Pd[A,u].Car) w w2 E2))
    (Prelude[l].qinv O.Pd[A,w].Car O.Pd[A,w].Car (\ c -> c) (\ c -> c) (\ c -> refl c) (\ c -> refl c)) w' E ;
  symsym (w w' : O.Pres A) (E : Id (O.Pres A) w w')
   : Id (Id (O.Pres A) w w') (Prelude[l].sym (O.Pres A) w' w (Prelude[l].sym (O.Pres A) w w' E)) E =
   idJ (O.Pres A) w (\ w2 E2 -> Id (Id (O.Pres A) w w2) (Prelude[l].sym (O.Pres A) w2 w (Prelude[l].sym (O.Pres A) w w2 E2)) E2)
    (refl (refl w)) w' E ;

  -- the inverse of a bijective algebra map is an algebra map
  invH (Z Z' : CA.Algebra) (h : CA.Hom Z Z') (e : Prelude[l].isEquiv Z.ring.R Z'.ring.R h.1.1) : CA.Hom Z' Z =
   ((e.sec,
     Prelude[l].trans Z.ring.R (e.sec Z'.ring.o) (e.sec (h.1.1 Z.ring.o)) Z.ring.o
      (Prelude[l].ap Z'.ring.R Z.ring.R e.sec Z'.ring.o (h.1.1 Z.ring.o) (Prelude[l].sym Z'.ring.R (h.1.1 Z.ring.o) Z'.ring.o h.1.2.1))
      (Prelude[l].sec-ret Z.ring.R Z'.ring.R h.1.1 e Z.ring.o),
     \ a b -> Equivalences[l].injective Z.ring.R Z'.ring.R h.1.1 e (e.sec (Z'.ring.add a b)) (Z.ring.add (e.sec a) (e.sec b))
      (Prelude[l].trans Z'.ring.R (h.1.1 (e.sec (Z'.ring.add a b))) (Z'.ring.add a b) (h.1.1 (Z.ring.add (e.sec a) (e.sec b)))
        (e.sec-eq (Z'.ring.add a b))
        (Prelude[l].trans Z'.ring.R (Z'.ring.add a b) (Z'.ring.add (h.1.1 (e.sec a)) (h.1.1 (e.sec b))) (h.1.1 (Z.ring.add (e.sec a) (e.sec b)))
          (Prelude[l].trans Z'.ring.R (Z'.ring.add a b) (Z'.ring.add (h.1.1 (e.sec a)) b) (Z'.ring.add (h.1.1 (e.sec a)) (h.1.1 (e.sec b)))
            (Prelude[l].ap Z'.ring.R Z'.ring.R (\ t -> Z'.ring.add t b) a (h.1.1 (e.sec a)) (Prelude[l].sym Z'.ring.R (h.1.1 (e.sec a)) a (e.sec-eq a)))
            (Prelude[l].ap Z'.ring.R Z'.ring.R (\ t -> Z'.ring.add (h.1.1 (e.sec a)) t) b (h.1.1 (e.sec b)) (Prelude[l].sym Z'.ring.R (h.1.1 (e.sec b)) b (e.sec-eq b))))
          (Prelude[l].sym Z'.ring.R (h.1.1 (Z.ring.add (e.sec a) (e.sec b))) (Z'.ring.add (h.1.1 (e.sec a)) (h.1.1 (e.sec b))) (h.1.2.2.1 (e.sec a) (e.sec b))))),
     \ a b -> Equivalences[l].injective Z.ring.R Z'.ring.R h.1.1 e (e.sec (Z'.ring.mul a b)) (Z.ring.mul (e.sec a) (e.sec b))
      (Prelude[l].trans Z'.ring.R (h.1.1 (e.sec (Z'.ring.mul a b))) (Z'.ring.mul a b) (h.1.1 (Z.ring.mul (e.sec a) (e.sec b)))
        (e.sec-eq (Z'.ring.mul a b))
        (Prelude[l].trans Z'.ring.R (Z'.ring.mul a b) (Z'.ring.mul (h.1.1 (e.sec a)) (h.1.1 (e.sec b))) (h.1.1 (Z.ring.mul (e.sec a) (e.sec b)))
          (Prelude[l].trans Z'.ring.R (Z'.ring.mul a b) (Z'.ring.mul (h.1.1 (e.sec a)) b) (Z'.ring.mul (h.1.1 (e.sec a)) (h.1.1 (e.sec b)))
            (Prelude[l].ap Z'.ring.R Z'.ring.R (\ t -> Z'.ring.mul t b) a (h.1.1 (e.sec a)) (Prelude[l].sym Z'.ring.R (h.1.1 (e.sec a)) a (e.sec-eq a)))
            (Prelude[l].ap Z'.ring.R Z'.ring.R (\ t -> Z'.ring.mul (h.1.1 (e.sec a)) t) b (h.1.1 (e.sec b)) (Prelude[l].sym Z'.ring.R (h.1.1 (e.sec b)) b (e.sec-eq b))))
          (Prelude[l].sym Z'.ring.R (h.1.1 (Z.ring.mul (e.sec a) (e.sec b))) (Z'.ring.mul (h.1.1 (e.sec a)) (h.1.1 (e.sec b))) (h.1.2.2.2 (e.sec a) (e.sec b)))))),
    \ r -> Prelude[l].trans Z.ring.R (e.sec (Z'.iota.1 r)) (e.sec (h.1.1 (Z.iota.1 r))) (Z.iota.1 r)
      (Prelude[l].ap Z'.ring.R Z.ring.R e.sec (Z'.iota.1 r) (h.1.1 (Z.iota.1 r)) (Prelude[l].sym Z'.ring.R (h.1.1 (Z.iota.1 r)) (Z'.iota.1 r) (h.2 r)))
      (Prelude[l].sec-ret Z.ring.R Z'.ring.R h.1.1 e (Z.iota.1 r))) ;
 } ;

 -- an algebra map over B is one over A between the restrictions along phi
 rH (A B : Alg.Algebra) (phi : RingHom[l].Hom A.ring B.ring) (Z Z' : Algebras[l].Over[B.ring,B.set].Algebra)
  (h : Algebras[l].Over[B.ring,B.set].Hom Z Z')
  : Algebras[l].Over[A.ring,A.set].Hom (Relative[l].Along[A.ring,A.set,B.ring,B.set,phi].restrict Z)
     (Relative[l].Along[A.ring,A.set,B.ring,B.set,phi].restrict Z') =
  (h.1, \ r -> h.2 (phi.1 r)) ;

 ------------------------------------------------------------------
 -- P3.4: brE and brE-nat

 module BrE (C : T2[l,k].PCwF) (S : T2[l,k].Site[C]) (alg : S.Ob -> Alg.Algebra)
  (homAlg : (y x : S.Ob) -> S.Hom y x -> Alg.Hom (alg x) (alg y)) (P : S39[C,S,alg,homAlg])
  (M : PModF[C,S,alg,homAlg,P]) {
  module B = Bse[C,S,alg,homAlg] ;
  module Pt = T2[l,k].Der[C].Pts[S] ;
  module TEx = TE[l,k].TEm[C] ;
  module Rf = O.Rf[C,S,P.G0,M.Br] ;

  module At (x : S.Ob) (g : C.Sub (S.yo x) P.G0) {
   module CA = Algebras[l].Over[(alg x).ring,(alg x).set] ;
   module L = PL[alg x] ;
   u : O.Pres (alg x) = P.prs x g ;
   a0 : (M.D x).Ob = (M.MD x).pm u ;
   module Q = Transfer2[l,k].PresTr[C,S,S.yo x,B.bs x,(alg x).ring,(alg x).set,B.kp x,M.D x,M.Ad x,M.MD x,u] ;
   yI : S.Hom x x = B.yoInv x x (C.id (S.yo x)) ;
   w0 : O.Pres (alg x) = O.change (alg x) (alg x) (homAlg x x yI) u ;
   gq : Id (C.Sub (S.yo x) P.G0) (C.o (S.yo x) (S.yo x) P.G0 g (S.yoH x x yI)) g =
    Prelude[l].trans (C.Sub (S.yo x) P.G0) (C.o (S.yo x) (S.yo x) P.G0 g (S.yoH x x yI)) (C.o (S.yo x) (S.yo x) P.G0 g (C.id (S.yo x))) g
     (Prelude[l].ap (C.Sub (S.yo x) (S.yo x)) (C.Sub (S.yo x) P.G0) (\ h -> C.o (S.yo x) (S.yo x) P.G0 g h)
        (S.yoH x x yI) (C.id (S.yo x)) ((S.yoH-eq x x).sec-eq (C.id (S.yo x))))
     (C.o-idr (S.yo x) P.G0 g) ;
   -- the moved presentation at the identity point is u again
   rho : Id (O.Pres (alg x)) w0 u =
    Prelude[l].trans (O.Pres (alg x)) w0 (P.prs x (C.o (S.yo x) (S.yo x) P.G0 g (S.yoH x x yI))) u
     (Prelude[l].sym (O.Pres (alg x)) (P.prs x (C.o (S.yo x) (S.yo x) P.G0 g (S.yoH x x yI))) w0 (P.prs-nat x x yI g))
     (Prelude[l].ap (C.Sub (S.yo x) P.G0) (O.Pres (alg x)) (P.prs x) (C.o (S.yo x) (S.yo x) P.G0 g (S.yoH x x yI)) g gq) ;
   Uat : CA.Algebra = ((M.Ad x).Uo a0) x (C.id (S.yo x)) ;
   TO : CA.Hom Uat O.Pd[alg x,w0].X = Q.TI.to x (C.id (S.yo x)) ;
   -- brE as an algebra map: the link, then TI.to at (x , id), then rho
   Hx : CA.Hom (M.brAlg x g) O.Pd[alg x,u].X =
    CA.compose (M.brAlg x g) O.Pd[alg x,w0].X O.Pd[alg x,u].X (L.mq w0 u rho)
     (CA.compose (M.brAlg x g) Uat O.Pd[alg x,w0].X TO (M.linkHom x g)) ;
   -- brE as an equivalence of fibres
   cT : C.Ty (S.yo x) = M.car x a0 ;
   sid : Id (C.Ty (S.yo x)) cT (C.subT (S.yo x) (S.yo x) cT (C.id (S.yo x))) =
    sym (C.Ty (S.yo x)) (C.subT (S.yo x) (S.yo x) cT (C.id (S.yo x))) cT (C.subT-id (S.yo x) cT) ;
   e1 : Prelude[l].Equiv (Pt.fib P.G0 M.Br x g) (C.El (S.yo x) cT) =
    (T2[l,k].Der[C].trE (S.yo x) (C.subT (S.yo x) P.G0 M.Br g) cT (M.stab x g),
     toL (Pt.fib P.G0 M.Br x g) (C.El (S.yo x) cT) (T2[l,k].Der[C].trE (S.yo x) (C.subT (S.yo x) P.G0 M.Br g) cT (M.stab x g))
      (TEx.trE-eq (S.yo x) (C.subT (S.yo x) P.G0 M.Br g) cT (M.stab x g))) ;
   e2 : Prelude[l].Equiv (C.El (S.yo x) cT) (Pt.fib (S.yo x) cT x (C.id (S.yo x))) =
    (T2[l,k].Der[C].trE (S.yo x) cT (C.subT (S.yo x) (S.yo x) cT (C.id (S.yo x))) sid,
     toL (C.El (S.yo x) cT) (Pt.fib (S.yo x) cT x (C.id (S.yo x))) (T2[l,k].Der[C].trE (S.yo x) cT (C.subT (S.yo x) (S.yo x) cT (C.id (S.yo x))) sid)
      (TEx.trE-eq (S.yo x) cT (C.subT (S.yo x) (S.yo x) cT (C.id (S.yo x))) sid)) ;
   e3 : Prelude[l].Equiv (Pt.fib (S.yo x) cT x (C.id (S.yo x))) Uat.ring.R = M.carU x a0 x (C.id (S.yo x)) ;
   e4 : Prelude[l].Equiv Uat.ring.R O.Pd[alg x,w0].Car = (TO.1.1, Q.brEq x (C.id (S.yo x))) ;
   e5 : Prelude[l].Equiv O.Pd[alg x,w0].Car O.Pd[alg x,u].Car =
    (Prelude[l].subst (O.Pres (alg x)) (\ w -> O.Pd[alg x,w].Car) w0 u rho, L.substEq w0 u rho) ;
   brE : Prelude[l].Equiv (Pt.fib P.G0 M.Br x g) O.Pd[alg x,u].Car =
    Equivalences[l].compose (Pt.fib P.G0 M.Br x g) (C.El (S.yo x) cT) O.Pd[alg x,u].Car e1
     (Equivalences[l].compose (C.El (S.yo x) cT) (Pt.fib (S.yo x) cT x (C.id (S.yo x))) O.Pd[alg x,u].Car e2
       (Equivalences[l].compose (Pt.fib (S.yo x) cT x (C.id (S.yo x))) Uat.ring.R O.Pd[alg x,u].Car e3
         (Equivalences[l].compose Uat.ring.R O.Pd[alg x,w0].Car O.Pd[alg x,u].Car e4 e5))) ;
   -- brE is Hx through brC
   hx-eq (b : Pt.fib P.G0 M.Br x g) : Id O.Pd[alg x,u].Car (Hx.1.1 ((M.brC x g).1 b)) (brE.1 b) =
    Prelude[l].trans O.Pd[alg x,u].Car (Hx.1.1 ((M.brC x g).1 b)) ((L.mq w0 u rho).1.1 (TO.1.1 (e3.1 (e2.1 (e1.1 b))))) (brE.1 b)
     (Prelude[l].ap Uat.ring.R O.Pd[alg x,u].Car (\ t -> (L.mq w0 u rho).1.1 (TO.1.1 t)) _ _ (M.linkHom-eq x g b))
     (Prelude[l].sym O.Pd[alg x,u].Car (brE.1 b) ((L.mq w0 u rho).1.1 (TO.1.1 (e3.1 (e2.1 (e1.1 b)))))
        (L.trPd w0 u rho (TO.1.1 (e3.1 (e2.1 (e1.1 b)))))) ;
   -- TI.to sends the universal solution to the generators
   to-gen (v : Presentations[l].Fin u.1) : Id O.Pd[alg x,w0].Car (TO.1.1 ((Q.TI.T.eE x (C.id (S.yo x))).1 v)) ((L.Gen w0).1 v) =
    Prelude[l].ap (Q.FE' Q.X) O.Pd[alg x,w0].Car (\ t -> (t x (C.id (S.yo x))).1 v) _ _ Q.TI.Y.u-e ;
   -- brE sends generators to generators
   hx-gen (v : Presentations[l].Fin u.1) : Id O.Pd[alg x,u].Car (Hx.1.1 ((M.brGen x g).1 v)) ((L.Gen u).1 v) =
    Prelude[l].trans O.Pd[alg x,u].Car (Hx.1.1 ((M.brGen x g).1 v)) ((L.mq w0 u rho).1.1 ((L.Gen w0).1 v)) ((L.Gen u).1 v)
     (Prelude[l].trans O.Pd[alg x,u].Car (Hx.1.1 ((M.brGen x g).1 v)) ((L.mq w0 u rho).1.1 (TO.1.1 ((Q.TI.T.eE x (C.id (S.yo x))).1 v)))
        ((L.mq w0 u rho).1.1 ((L.Gen w0).1 v))
        (Prelude[l].ap Uat.ring.R O.Pd[alg x,u].Car (\ t -> (L.mq w0 u rho).1.1 (TO.1.1 t)) _ _ (M.linkGen x g v))
        (Prelude[l].ap O.Pd[alg x,w0].Car O.Pd[alg x,u].Car (L.mq w0 u rho).1.1 _ _ (to-gen v)))
     (Prelude[l].trans O.Pd[alg x,u].Car ((L.mq w0 u rho).1.1 ((L.Gen w0).1 v)) ((L.SolT w0 u rho).1 v) ((L.Gen u).1 v)
        (L.mqGen w0 u rho v)
        (L.solFix O.Pd[alg x,u].X u w0.2 (Prelude[l].sym (O.Pres (alg x)) w0 u rho) (L.Gen u) v)) ;
   brCinv : Prelude[l].Equiv (M.brAlg x g).ring.R (Pt.fib P.G0 M.Br x g) =
    ((M.brC x g).2.sec, Prelude[l].qinv (M.brAlg x g).ring.R (Pt.fib P.G0 M.Br x g) (M.brC x g).2.sec (M.brC x g).1
      (Prelude[l].sec-ret (Pt.fib P.G0 M.Br x g) (M.brAlg x g).ring.R (M.brC x g).1 (M.brC x g).2) (M.brC x g).2.sec-eq) ;
   hx-eqv : Prelude[l].isEquiv (M.brAlg x g).ring.R O.Pd[alg x,u].Car Hx.1.1 =
    Equivalences[l].homotopy (M.brAlg x g).ring.R O.Pd[alg x,u].Car
     (Equivalences[l].compose (M.brAlg x g).ring.R (Pt.fib P.G0 M.Br x g) O.Pd[alg x,u].Car brCinv brE) Hx.1.1
     (\ c -> Prelude[l].trans O.Pd[alg x,u].Car (Hx.1.1 c) (Hx.1.1 ((M.brC x g).1 ((M.brC x g).2.sec c))) (brE.1 ((M.brC x g).2.sec c))
        (Prelude[l].ap (M.brAlg x g).ring.R O.Pd[alg x,u].Car Hx.1.1 c ((M.brC x g).1 ((M.brC x g).2.sec c))
           (Prelude[l].sym (M.brAlg x g).ring.R ((M.brC x g).1 ((M.brC x g).2.sec c)) c ((M.brC x g).2.sec-eq c)))
        (hx-eq ((M.brC x g).2.sec c))) ;
   Hxi : CA.Hom O.Pd[alg x,u].X (M.brAlg x g) = L.invH (M.brAlg x g) O.Pd[alg x,u].X Hx hx-eqv ;
   hxi-gen (v : Presentations[l].Fin u.1) : Id (M.brAlg x g).ring.R (Hxi.1.1 ((L.Gen u).1 v)) ((M.brGen x g).1 v) =
    Prelude[l].trans (M.brAlg x g).ring.R (Hxi.1.1 ((L.Gen u).1 v)) (Hxi.1.1 (Hx.1.1 ((M.brGen x g).1 v))) ((M.brGen x g).1 v)
     (Prelude[l].ap O.Pd[alg x,u].Car (M.brAlg x g).ring.R Hxi.1.1 _ _ (Prelude[l].sym O.Pd[alg x,u].Car (Hx.1.1 ((M.brGen x g).1 v)) ((L.Gen u).1 v) (hx-gen v)))
     (Prelude[l].sec-ret (M.brAlg x g).ring.R O.Pd[alg x,u].Car Hx.1.1 hx-eqv ((M.brGen x g).1 v)) ;
  } ;

  brE (x : S.Ob) (g : C.Sub (S.yo x) P.G0) : Prelude[l].Equiv (Pt.fib P.G0 M.Br x g) O.Pd[alg x,P.prs x g].Car = At[x,g].brE ;

  -- naturality: brE_y . res . brE_x^-1 and h+ (moved along prs-nat) are
  -- maps of alg x-algebras X_u -> X_{u'}|h that agree on the generators
  module Nt (y x : S.Ob) (f : S.Hom y x) (g : C.Sub (S.yo x) P.G0) {
   module Ax = At[x,g] ;
   module Ay = At[y,Rf.at y x f g] ;
   module CX = Algebras[l].Over[(alg x).ring,(alg x).set] ;
   module LY = PL[alg y] ;
   u : O.Pres (alg x) = P.prs x g ;
   u' : O.Pres (alg y) = P.prs y (Rf.at y x f g) ;
   ch : O.Pres (alg y) = O.change (alg x) (alg y) (homAlg y x f) u ;
   pi : Id (O.Pres (alg y)) u' ch = P.prs-nat y x f g ;
   module Mv = O.Moves[alg x,alg y,homAlg y x f,u] ;
   Dst : CX.Algebra = Relative[l].Along[(alg x).ring,(alg x).set,(alg y).ring,(alg y).set,(homAlg y x f).1].restrict O.Pd[alg y,u'].X ;
   Rb' : CX.Algebra = Relative[l].Along[(alg x).ring,(alg x).set,(alg y).ring,(alg y).set,(homAlg y x f).1].restrict (M.brAlg y (Rf.at y x f g)) ;
   Rch : CX.Algebra = Relative[l].Along[(alg x).ring,(alg x).set,(alg y).ring,(alg y).set,(homAlg y x f).1].restrict O.Pd[alg y,ch].X ;
   f1 : CX.Hom O.Pd[alg x,u].X Dst =
    CX.compose O.Pd[alg x,u].X (M.brAlg x g) Dst
     (CX.compose (M.brAlg x g) Rb' Dst (rH (alg x) (alg y) (homAlg y x f).1 (M.brAlg y (Rf.at y x f g)) O.Pd[alg y,u'].X Ay.Hx) (M.resA y x f g))
     Ax.Hxi ;
   f2 : CX.Hom O.Pd[alg x,u].X Dst =
    CX.compose O.Pd[alg x,u].X Rch Dst (rH (alg x) (alg y) (homAlg y x f).1 O.Pd[alg y,ch].X O.Pd[alg y,u'].X (LY.mq ch u' (Prelude[l].sym (O.Pres (alg y)) u' ch pi)))
     Mv.Sq.hat ;
   -- the common value on the generators
   tg (v : Presentations[l].Fin u.1) : O.Pd[alg y,u'].Car =
    (Prelude[l].subst (O.Pres (alg y)) (\ w -> Presentations[l].Over[(alg y).ring,(alg y).set].Solutions w O.Pd[alg y,u'].X) u' ch pi (LY.Gen u')).1 v ;
   -- Hy . brGen_y = the generators
   canGen : Id (Presentations[l].Over[(alg y).ring,(alg y).set].Solutions u' O.Pd[alg y,u'].X)
     (Presentations[l].Over[(alg y).ring,(alg y).set].canonical u' (M.brAlg y (Rf.at y x f g)) (M.brGen y (Rf.at y x f g)) O.Pd[alg y,u'].X Ay.Hx)
     (LY.Gen u') =
    Presentations[l].Over[(alg y).ring,(alg y).set].solutions-ext u' O.Pd[alg y,u'].X _ _ (\ v -> Ay.hx-gen v) ;
   gen1 (v : Presentations[l].Fin u.1) : Id O.Pd[alg y,u'].Car (f1.1.1 ((Ax.L.Gen u).1 v)) (tg v) =
    Prelude[l].trans O.Pd[alg y,u'].Car (f1.1.1 ((Ax.L.Gen u).1 v)) (Ay.Hx.1.1 ((M.resA y x f g).1.1 ((M.brGen x g).1 v))) (tg v)
     (Prelude[l].ap (M.brAlg x g).ring.R O.Pd[alg y,u'].Car (\ t -> Ay.Hx.1.1 ((M.resA y x f g).1.1 t)) _ _ (Ax.hxi-gen v))
     (Prelude[l].trans O.Pd[alg y,u'].Car (Ay.Hx.1.1 ((M.resA y x f g).1.1 ((M.brGen x g).1 v)))
        (Ay.Hx.1.1 ((Prelude[l].subst (O.Pres (alg y)) (\ w -> Presentations[l].Over[(alg y).ring,(alg y).set].Solutions w (M.brAlg y (Rf.at y x f g))) u' ch pi
            (M.brGen y (Rf.at y x f g))).1 v)) (tg v)
        (Prelude[l].ap (M.brAlg y (Rf.at y x f g)).ring.R O.Pd[alg y,u'].Car Ay.Hx.1.1 _ _ (M.res-gen y x f g v))
        (Prelude[l].trans O.Pd[alg y,u'].Car
           (Ay.Hx.1.1 ((Prelude[l].subst (O.Pres (alg y)) (\ w -> Presentations[l].Over[(alg y).ring,(alg y).set].Solutions w (M.brAlg y (Rf.at y x f g))) u' ch pi
               (M.brGen y (Rf.at y x f g))).1 v))
           ((Prelude[l].subst (O.Pres (alg y)) (\ w -> Presentations[l].Over[(alg y).ring,(alg y).set].Solutions w O.Pd[alg y,u'].X) u' ch pi
               (Presentations[l].Over[(alg y).ring,(alg y).set].canonical u' (M.brAlg y (Rf.at y x f g)) (M.brGen y (Rf.at y x f g)) O.Pd[alg y,u'].X Ay.Hx)).1 v)
           (tg v)
           (Prelude[l].sym O.Pd[alg y,u'].Car _ _
              (Prelude[l].ap (Presentations[l].Over[(alg y).ring,(alg y).set].Solutions ch O.Pd[alg y,u'].X) O.Pd[alg y,u'].Car (\ s2 -> s2.1 v) _ _
                 (LY.natSub (M.brAlg y (Rf.at y x f g)) O.Pd[alg y,u'].X Ay.Hx u' ch pi (M.brGen y (Rf.at y x f g)))))
           (Prelude[l].ap (Presentations[l].Over[(alg y).ring,(alg y).set].Solutions u' O.Pd[alg y,u'].X) O.Pd[alg y,u'].Car
              (\ s2 -> (Prelude[l].subst (O.Pres (alg y)) (\ w -> Presentations[l].Over[(alg y).ring,(alg y).set].Solutions w O.Pd[alg y,u'].X) u' ch pi s2).1 v) _ _ canGen))) ;
   gen2 (v : Presentations[l].Fin u.1) : Id O.Pd[alg y,u'].Car (f2.1.1 ((Ax.L.Gen u).1 v)) (tg v) =
    Prelude[l].trans O.Pd[alg y,u'].Car (f2.1.1 ((Ax.L.Gen u).1 v)) ((LY.mq ch u' (Prelude[l].sym (O.Pres (alg y)) u' ch pi)).1.1 ((LY.Gen ch).1 v)) (tg v)
     (Prelude[l].ap O.Pd[alg y,ch].Car O.Pd[alg y,u'].Car (LY.mq ch u' (Prelude[l].sym (O.Pres (alg y)) u' ch pi)).1.1 _ _ (Mv.Sq.up-gen v))
     (Prelude[l].trans O.Pd[alg y,u'].Car ((LY.mq ch u' (Prelude[l].sym (O.Pres (alg y)) u' ch pi)).1.1 ((LY.Gen ch).1 v))
        ((LY.SolT ch u' (Prelude[l].sym (O.Pres (alg y)) u' ch pi)).1 v) (tg v)
        (LY.mqGen ch u' (Prelude[l].sym (O.Pres (alg y)) u' ch pi) v)
        (Prelude[l].ap (Id (O.Pres (alg y)) u' ch) O.Pd[alg y,u'].Car
           (\ E -> (Prelude[l].subst (O.Pres (alg y)) (\ w -> Presentations[l].Over[(alg y).ring,(alg y).set].Solutions w O.Pd[alg y,u'].X) u' ch E (LY.Gen u')).1 v)
           _ _ (LY.symsym u' ch pi))) ;
   -- uniqueness on generators
   eqf : Id (CX.Hom O.Pd[alg x,u].X Dst) f1 f2 =
    Tensor[l].Over[(alg x).ring,(alg x).set].hom-eq u O.Pd[alg x,u].X O.Pd[alg x,u].px Dst f1 f2
     (\ v -> Prelude[l].trans O.Pd[alg y,u'].Car (f1.1.1 ((Ax.L.Gen u).1 v)) (tg v) (f2.1.1 ((Ax.L.Gen u).1 v))
        (gen1 v) (Prelude[l].sym O.Pd[alg y,u'].Car (f2.1.1 ((Ax.L.Gen u).1 v)) (tg v) (gen2 v))) ;
   -- the naturality square
   nat (b : Pt.fib P.G0 M.Br x g)
    : Id O.Pd[alg y,u'].Car (Ay.brE.1 (Rf.res y x f g b))
       (Prelude[l].subst (O.Pres (alg y)) (\ w -> O.Pd[alg y,w].Car) ch u' (Prelude[l].sym (O.Pres (alg y)) u' ch pi) (Mv.up (Ax.brE.1 b))) =
    Prelude[l].trans O.Pd[alg y,u'].Car (Ay.brE.1 (Rf.res y x f g b)) (f1.1.1 (Ax.brE.1 b))
     (Prelude[l].subst (O.Pres (alg y)) (\ w -> O.Pd[alg y,w].Car) ch u' (Prelude[l].sym (O.Pres (alg y)) u' ch pi) (Mv.up (Ax.brE.1 b)))
     (Prelude[l].trans O.Pd[alg y,u'].Car (Ay.brE.1 (Rf.res y x f g b)) (Ay.Hx.1.1 ((M.resA y x f g).1.1 ((M.brC x g).1 b))) (f1.1.1 (Ax.brE.1 b))
        (Prelude[l].trans O.Pd[alg y,u'].Car (Ay.brE.1 (Rf.res y x f g b)) (Ay.Hx.1.1 ((M.brC y (Rf.at y x f g)).1 (Rf.res y x f g b)))
           (Ay.Hx.1.1 ((M.resA y x f g).1.1 ((M.brC x g).1 b)))
           (Prelude[l].sym O.Pd[alg y,u'].Car _ _ (Ay.hx-eq (Rf.res y x f g b)))
           (Prelude[l].ap (M.brAlg y (Rf.at y x f g)).ring.R O.Pd[alg y,u'].Car Ay.Hx.1.1 _ _
              (Prelude[l].sym (M.brAlg y (Rf.at y x f g)).ring.R _ _ (M.resA-eq y x f g b))))
        (Prelude[l].ap (M.brAlg x g).ring.R O.Pd[alg y,u'].Car (\ t -> Ay.Hx.1.1 ((M.resA y x f g).1.1 t)) _ _
           (Prelude[l].trans (M.brAlg x g).ring.R ((M.brC x g).1 b) (Ax.Hxi.1.1 (Ax.Hx.1.1 ((M.brC x g).1 b))) (Ax.Hxi.1.1 (Ax.brE.1 b))
              (Prelude[l].sym (M.brAlg x g).ring.R _ _ (Prelude[l].sec-ret (M.brAlg x g).ring.R O.Pd[alg x,u].Car Ax.Hx.1.1 Ax.hx-eqv ((M.brC x g).1 b)))
              (Prelude[l].ap O.Pd[alg x,u].Car (M.brAlg x g).ring.R Ax.Hxi.1.1 _ _ (Ax.hx-eq b)))))
     (Prelude[l].trans O.Pd[alg y,u'].Car (f1.1.1 (Ax.brE.1 b)) (f2.1.1 (Ax.brE.1 b))
        (Prelude[l].subst (O.Pres (alg y)) (\ w -> O.Pd[alg y,w].Car) ch u' (Prelude[l].sym (O.Pres (alg y)) u' ch pi) (Mv.up (Ax.brE.1 b)))
        (Prelude[l].ap (CX.Hom O.Pd[alg x,u].X Dst) O.Pd[alg y,u'].Car (\ h -> h.1.1 (Ax.brE.1 b)) f1 f2 eqf)
        (Prelude[l].sym O.Pd[alg y,u'].Car _ _ (LY.trPd ch u' (Prelude[l].sym (O.Pres (alg y)) u' ch pi) (Mv.up (Ax.brE.1 b))))) ;
  } ;

  -- brE as an algebra iso brAlg x g = X_{prs x g}, generators to generators
  brIso (x : S.Ob) (g : C.Sub (S.yo x) P.G0)
   : Algebras[l].Over[(alg x).ring,(alg x).set].Hom (M.brAlg x g) O.Pd[alg x,P.prs x g].X = At[x,g].Hx ;
  brIso-eq (x : S.Ob) (g : C.Sub (S.yo x) P.G0) (b : Pt.fib P.G0 M.Br x g)
   : Id O.Pd[alg x,P.prs x g].Car ((brIso x g).1.1 ((M.brC x g).1 b)) ((brE x g).1 b) = At[x,g].hx-eq b ;
  brIso-gen (x : S.Ob) (g : C.Sub (S.yo x) P.G0) (v : Presentations[l].Fin (P.prs x g).1)
   : Id O.Pd[alg x,P.prs x g].Car ((brIso x g).1.1 ((M.brGen x g).1 v)) ((PL[alg x].Gen (P.prs x g)).1 v) = At[x,g].hx-gen v ;
  brIso-inv (x : S.Ob) (g : C.Sub (S.yo x) P.G0)
   : Algebras[l].Over[(alg x).ring,(alg x).set].Hom O.Pd[alg x,P.prs x g].X (M.brAlg x g) = At[x,g].Hxi ;

  brE-nat (y x : S.Ob) (f : S.Hom y x) (g : C.Sub (S.yo x) P.G0) (b : Pt.fib P.G0 M.Br x g) :
   Id O.Pd[alg y,P.prs y (Rf.at y x f g)].Car
    ((brE y (Rf.at y x f g)).1 (Rf.res y x f g b))
    (Prelude[l].subst (O.Pres (alg y)) (\ w -> O.Pd[alg y,w].Car)
      (O.change (alg x) (alg y) (homAlg y x f) (P.prs x g)) (P.prs y (Rf.at y x f g))
      (Prelude[l].sym (O.Pres (alg y)) _ _ (P.prs-nat y x f g))
      (O.Moves[alg x,alg y,homAlg y x f,P.prs x g].up ((brE x g).1 b))) = Nt[y,x,f,g].nat b ;
 } ;
} ;
