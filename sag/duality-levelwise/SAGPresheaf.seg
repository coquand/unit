-- SAGPresheaf.seg: the three presheaf axioms of jonas.pdf §6.3 in the
-- model PSh(C)_DT (DUALITY.md endpoints E1-E3), with Prop 58 (P3.6)
-- proved (P58.prop58), so no longer a premise.
--   duality      Axiom 2, Theorem 62  (E1.seg, Core.seg)
--   n-constant   Axiom 3, Theorem 61  (E2.seg)
--   projective   Axiom 1, Prop 76     (E3.seg)
-- Premises: the records in the parameter list, i.e. T2 (S2.x), T3
-- (S3.5, S3.6, and P3.3-P3.5 stated, proof pending), Mods, NS (S2.7),
-- TrS (S3.7, S3.8).  No new axioms beyond these named premises and the
-- Theory parameters.
level l k ;
constraint l <= k ;
open Ring[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module Tm = T3[l,k].Over[R,setR] ;
 module E1m = E1[l,k].Over[R,setR] ;
 module E2m = E2[l,k].Over[R,setR] ;
 module E3m = E3[l,k].Over[R,setR] ;
 module P58m = P58[l,k].Over[R,setR] ;
 module PresheafAxioms (C : T2[l,k].PCwF) (S : T2[l,k].Site[C]) (PI : T2[l,k].PiS[C]) (Dd : T2[l,k].DS[C,S])
  (MP : T2[l,k].ModPi[C,S,PI,Dd]) (T : Tm.T3[C,S]) (Md : E1m.Mods[C,S,Dd,T])
  (Nn : E2m.NS[C,S,Dd,T.G0]) (Tt : E3[l,k].TrS[C,S,Dd]) {
  L58 : E1m.P58[C,S,T] = P58m.prop58 C S T ;
  module A2 = E1m.Thm62[C,S,PI,Dd,MP,T,Md,L58] ;
  module A3 = E2m.Thm61[C,S,PI,Dd,MP,T,Md,L58,Nn] ;
  module A1 = E3m.Thm76[C,S,PI,Dd,MP,T,Md,L58,Tt] ;
  duality : Dd.IsEqT T.G0 T.Br (PI.Pi T.G0 T.Sp A2.P) A2.R6.lamm = A2.theorem62 ;
  n-constant : Dd.IsEqT T.G0 Nn.N (PI.Pi T.G0 T.Sp A3.Np) A3.R6.lamm = A3.theorem61 ;
  projective : E3[l,k].P76[C,S,PI,Dd,MP,Tt].Proj T.G0 T.Sp = A1.theorem76 ;
 } ;
} ;
