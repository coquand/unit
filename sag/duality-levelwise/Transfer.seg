-- Transfer.seg: DUALITY.md Tier 3 step 3, generic part (canonicity-45):
-- P3.1 (Construction 51, the adjunction at the level of models) and P3.2
-- (Lemma 52: U preserves objects given by a universal property), in
-- reading (A), as statements about wild categories with hom-sets.
--
--   WCat       a category with hom-sets (laws are paths; hom-sets are
--              needed for the cocone functors, whose second parts are paths)
--   CoFun      a functor to types (covariant), the "Phi" of a universal
--              property (cocones, products of homs, maps out of Fin n)
--   Repr       c represents Phi with universal element e: h |-> Phi(h) e is
--              an equivalence Hom(c , b) -> Phi(b) for every b
--   Adj        S3.1 at the level of models: U on objects, R on objects and
--              maps, Hom_E(U a , b) = Hom_D(a , R b), natural in b
--   transfer   (Lemma 52) if c represents Phi_D and Phi_D o R = Phi_E
--              naturally, U c represents Phi_E, with an explicit universal
--              element
--   yonedaIso  two objects representing the same functor are isomorphic
--
-- Informal proof of transfer: at b, h |-> Phi_E(h) e_E is the composite
-- Hom_E(U c , b) -adj-> Hom_D(c , R b) -(h |-> Phi_D(h) e)-> Phi_D(R b)
-- -kappa-> Phi_E(b), up to the homotopy: Phi_E(h) (kappa (Phi_D(adj id) e))
-- = kappa (Phi_D(R h) (Phi_D(adj id) e)) (kappa natural) = kappa (Phi_D(R h o
-- adj id) e) (functor) = kappa (Phi_D(adj (h o id)) e) (adj natural) =
-- kappa (Phi_D(adj h) e) (unit law).  Each step is an equivalence.

level l k ;
constraint l+ <= k ;
open Base ;
open Prelude[k] ;

record WCat {
 Ob : U k ;
 Hom (a b : Ob) : U l ;
 idm (a : Ob) : Hom a a ;
 comp (a b c : Ob) (g : Hom b c) (f : Hom a b) : Hom a c ;
 idl (a b : Ob) (f : Hom a b) : Id (Hom a b) (comp a b b (idm b) f) f ;
 idr (a b : Ob) (f : Hom a b) : Id (Hom a b) (comp a a b f (idm a)) f ;
 assoc (a b c d : Ob) (h : Hom c d) (g : Hom b c) (f : Hom a b)
  : Id (Hom a d) (comp a b d (comp b c d h g) f) (comp a c d h (comp a b c g f)) ;
 hset (a b : Ob) : Prelude[l].isSet (Hom a b) ;
} ;

record CoFun (C : WCat) {
 F (b : C.Ob) : U l ;
 fmap (b b' : C.Ob) (h : C.Hom b b') (z : F b) : F b' ;
 fid (b : C.Ob) (z : F b) : Id (F b) (fmap b b (C.idm b) z) z ;
 fcomp (b b' b'' : C.Ob) (h' : C.Hom b' b'') (h : C.Hom b b') (z : F b)
  : Id (F b'') (fmap b b'' (C.comp b b' b'' h' h) z) (fmap b' b'' h' (fmap b b' h z)) ;
} ;

-- c represents Phi, with universal element e
Repr (C : WCat) (Ph : CoFun[C]) (c : C.Ob) (e : Ph.F c) : U k =
 (b : C.Ob) -> isEquiv (C.Hom c b) (Ph.F b) (\ h -> Ph.fmap c b h e) ;

-- S3.1 at the level of models (Construction 51)
record Adj (D E : WCat) {
 Uo (a : D.Ob) : E.Ob ;
 Ro (b : E.Ob) : D.Ob ;
 Rm (b b' : E.Ob) (h : E.Hom b b') : D.Hom (Ro b) (Ro b') ;
 adj (a : D.Ob) (b : E.Ob) (f : E.Hom (Uo a) b) : D.Hom a (Ro b) ;
 adj-eq (a : D.Ob) (b : E.Ob) : isEquiv (E.Hom (Uo a) b) (D.Hom a (Ro b)) (adj a b) ;
 adj-nat (a : D.Ob) (b b' : E.Ob) (h : E.Hom b b') (f : E.Hom (Uo a) b)
  : Id (D.Hom a (Ro b')) (adj a b' (E.comp (Uo a) b b' h f)) (D.comp a (Ro b) (Ro b') (Rm b b' h) (adj a b f)) ;
 -- U on maps, and naturality in the source (precomposition)
 Um (a a' : D.Ob) (k : D.Hom a a') : E.Hom (Uo a) (Uo a') ;
 adj-nat-src (a' a : D.Ob) (b : E.Ob) (k : D.Hom a' a) (f : E.Hom (Uo a) b)
  : Id (D.Hom a' (Ro b)) (adj a' b (E.comp (Uo a') (Uo a) b f (Um a' a k))) (D.comp a' a (Ro b) (adj a b f) k) ;
} ;

module Tr (D E : WCat) (A : Adj[D, E]) (PD : CoFun[D]) (PE : CoFun[E])
 -- Phi_D o R = Phi_E, naturally
 (kap : (b : E.Ob) -> PD.F (A.Ro b) -> PE.F b)
 (kap-eq : (b : E.Ob) -> isEquiv (PD.F (A.Ro b)) (PE.F b) (kap b))
 (kap-nat : (b b' : E.Ob) (h : E.Hom b b') (z : PD.F (A.Ro b))
    -> Id (PE.F b') (kap b' (PD.fmap (A.Ro b) (A.Ro b') (A.Rm b b' h) z)) (PE.fmap b b' h (kap b z)))
 (c : D.Ob) (e : PD.F c) (rc : Repr D PD c e) {
 Uc : E.Ob = A.Uo c ;
 eta : D.Hom c (A.Ro Uc) = A.adj c Uc (E.idm Uc) ;

 -- the universal element of U c
 eE : PE.F Uc = kap Uc (PD.fmap c (A.Ro Uc) eta e) ;

 -- the composite of equivalences
 chain (b : E.Ob) (h : E.Hom Uc b) : PE.F b = kap b (PD.fmap c (A.Ro b) (A.adj c b h) e) ;

 chain-eq (b : E.Ob) : isEquiv (E.Hom Uc b) (PE.F b) (chain b) =
  (Equivalences[k].compose (E.Hom Uc b) (PD.F (A.Ro b)) (PE.F b)
    (Equivalences[k].compose (E.Hom Uc b) (D.Hom c (A.Ro b)) (PD.F (A.Ro b))
       (A.adj c b, A.adj-eq c b) (\ g -> PD.fmap c (A.Ro b) g e, rc (A.Ro b)))
    (kap b, kap-eq b)).2 ;

 -- Phi_E(h) e_E is the composite
 hom (b : E.Ob) (h : E.Hom Uc b) : Id (PE.F b) (PE.fmap Uc b h eE) (chain b h) =
  trans (PE.F b) (PE.fmap Uc b h eE) (kap b (PD.fmap (A.Ro Uc) (A.Ro b) (A.Rm Uc b h) (PD.fmap c (A.Ro Uc) eta e))) (chain b h)
   (sym (PE.F b) (kap b (PD.fmap (A.Ro Uc) (A.Ro b) (A.Rm Uc b h) (PD.fmap c (A.Ro Uc) eta e))) (PE.fmap Uc b h eE)
      (kap-nat Uc b h (PD.fmap c (A.Ro Uc) eta e)))
   (ap (PD.F (A.Ro b)) (PE.F b) (kap b) (PD.fmap (A.Ro Uc) (A.Ro b) (A.Rm Uc b h) (PD.fmap c (A.Ro Uc) eta e)) (PD.fmap c (A.Ro b) (A.adj c b h) e)
      (trans (PD.F (A.Ro b)) (PD.fmap (A.Ro Uc) (A.Ro b) (A.Rm Uc b h) (PD.fmap c (A.Ro Uc) eta e))
         (PD.fmap c (A.Ro b) (D.comp c (A.Ro Uc) (A.Ro b) (A.Rm Uc b h) eta) e) (PD.fmap c (A.Ro b) (A.adj c b h) e)
        (sym (PD.F (A.Ro b)) (PD.fmap c (A.Ro b) (D.comp c (A.Ro Uc) (A.Ro b) (A.Rm Uc b h) eta) e) (PD.fmap (A.Ro Uc) (A.Ro b) (A.Rm Uc b h) (PD.fmap c (A.Ro Uc) eta e))
           (PD.fcomp c (A.Ro Uc) (A.Ro b) (A.Rm Uc b h) eta e))
        (ap (D.Hom c (A.Ro b)) (PD.F (A.Ro b)) (\ g -> PD.fmap c (A.Ro b) g e) (D.comp c (A.Ro Uc) (A.Ro b) (A.Rm Uc b h) eta) (A.adj c b h)
           (trans (D.Hom c (A.Ro b)) (D.comp c (A.Ro Uc) (A.Ro b) (A.Rm Uc b h) eta) (A.adj c b (E.comp Uc Uc b h (E.idm Uc))) (A.adj c b h)
              (sym (D.Hom c (A.Ro b)) (A.adj c b (E.comp Uc Uc b h (E.idm Uc))) (D.comp c (A.Ro Uc) (A.Ro b) (A.Rm Uc b h) eta) (A.adj-nat c Uc b h (E.idm Uc)))
              (ap (E.Hom Uc b) (D.Hom c (A.Ro b)) (A.adj c b) (E.comp Uc Uc b h (E.idm Uc)) h (E.idr Uc b h)))))) ;

 -- Lemma 52: U c represents Phi_E
 transfer : Repr E PE Uc eE = \ b ->
  Equivalences[k].homotopy (E.Hom Uc b) (PE.F b) (chain b, chain-eq b) (\ h -> PE.fmap Uc b h eE) (\ h -> hom b h) ;
} ;

-- Yoneda: two objects representing the same functor are isomorphic
module Yon (C : WCat) (Ph : CoFun[C]) (c c' : C.Ob) (e : Ph.F c) (e' : Ph.F c') (rc : Repr C Ph c e) (rc' : Repr C Ph c' e') {
 u : C.Hom c c' = (rc c').sec e' ;
 v : C.Hom c' c = (rc' c).sec e ;

 u-e : Id (Ph.F c') (Ph.fmap c c' u e) e' = (rc c').sec-eq e' ;
 v-e : Id (Ph.F c) (Ph.fmap c' c v e') e = (rc' c).sec-eq e ;

 -- an endomorphism fixing the universal element is the identity
 fixId (d : C.Ob) (ed : Ph.F d) (rd : Repr C Ph d ed) (w : C.Hom d d) (fw : Id (Ph.F d) (Ph.fmap d d w ed) ed) : Id (C.Hom d d) w (C.idm d) =
  Equivalences[k].injective (C.Hom d d) (Ph.F d) (\ h -> Ph.fmap d d h ed) (rd d) w (C.idm d)
   (trans (Ph.F d) (Ph.fmap d d w ed) ed (Ph.fmap d d (C.idm d) ed) fw (sym (Ph.F d) (Ph.fmap d d (C.idm d) ed) ed (Ph.fid d ed))) ;

 vu : Id (C.Hom c c) (C.comp c c' c v u) (C.idm c) =
  fixId c e rc (C.comp c c' c v u)
   (trans (Ph.F c) (Ph.fmap c c (C.comp c c' c v u) e) (Ph.fmap c' c v (Ph.fmap c c' u e)) e
      (Ph.fcomp c c' c v u e)
      (trans (Ph.F c) (Ph.fmap c' c v (Ph.fmap c c' u e)) (Ph.fmap c' c v e') e
         (ap (Ph.F c') (Ph.F c) (Ph.fmap c' c v) (Ph.fmap c c' u e) e' u-e) v-e)) ;

 uv : Id (C.Hom c' c') (C.comp c' c c' u v) (C.idm c') =
  fixId c' e' rc' (C.comp c' c c' u v)
   (trans (Ph.F c') (Ph.fmap c' c' (C.comp c' c c' u v) e') (Ph.fmap c c' u (Ph.fmap c' c v e')) e'
      (Ph.fcomp c' c c' u v e')
      (trans (Ph.F c') (Ph.fmap c c' u (Ph.fmap c' c v e')) (Ph.fmap c c' u e) e'
         (ap (Ph.F c) (Ph.F c') (Ph.fmap c c' u) (Ph.fmap c' c v e') e v-e) u-e)) ;
} ;

------------------------------------------------------------------------
-- coequalisers: the cocone functor of a parallel pair, and its transfer

module Coeq (C : WCat) (a b : C.Ob) (f0 f1 : C.Hom a b) {
 F (y : C.Ob) : U l = (g : C.Hom b y) * Id (C.Hom a y) (C.comp a b y g f0) (C.comp a b y g f1) ;

 fmap (y y' : C.Ob) (h : C.Hom y y') (w : F y) : F y' =
  (C.comp b y y' h w.1,
   trans (C.Hom a y') (C.comp a b y' (C.comp b y y' h w.1) f0) (C.comp a y y' h (C.comp a b y w.1 f0)) (C.comp a b y' (C.comp b y y' h w.1) f1)
    (C.assoc a b y y' h w.1 f0)
    (trans (C.Hom a y') (C.comp a y y' h (C.comp a b y w.1 f0)) (C.comp a y y' h (C.comp a b y w.1 f1)) (C.comp a b y' (C.comp b y y' h w.1) f1)
       (ap (C.Hom a y) (C.Hom a y') (C.comp a y y' h) (C.comp a b y w.1 f0) (C.comp a b y w.1 f1) w.2)
       (sym (C.Hom a y') (C.comp a b y' (C.comp b y y' h w.1) f1) (C.comp a y y' h (C.comp a b y w.1 f1)) (C.assoc a b y y' h w.1 f1)))) ;

 -- two cocones with the same map are equal (hom-sets)
 ceq (y : C.Ob) (w w' : F y) (p : Id (C.Hom b y) w.1 w'.1) : Id (F y) w w' =
  Sigma-eq (C.Hom b y) (\ g -> Id (C.Hom a y) (C.comp a b y g f0) (C.comp a b y g f1)) w.1 w'.1 w.2 w'.2 p
   (C.hset a y (C.comp a b y w'.1 f0) (C.comp a b y w'.1 f1)) ;

 cofun : CoFun[C] = new CoFun[C,
  F := F, fmap := fmap,
  fid := \ y w -> ceq y (fmap y y (C.idm y) w) w (C.idl b y w.1),
  fcomp := \ y y' y'' h' h w -> ceq y'' (fmap y y'' (C.comp y y' y'' h' h) w) (fmap y' y'' h' (fmap y y' h w)) (C.assoc b y y' y'' h' h w.1)] ;
} ;

-- the comparison Phi_D o R = Phi_E for the cocones of f0 , f1 and of
-- U f0 , U f1, built from the adjunction alone
module CoeqTr (D E : WCat) (A : Adj[D, E]) (a b : D.Ob) (f0 f1 : D.Hom a b) {
 module CD = Coeq[D, a, b, f0, f1] ;
 module CE = Coeq[E, A.Uo a, A.Uo b, A.Um a b f0, A.Um a b f1] ;

 adjI (y : E.Ob) (g : D.Hom b (A.Ro y)) : E.Hom (A.Uo b) y = (A.adj-eq b y).sec g ;

 -- the transposed equation, through adj-nat-src and injectivity of adj
 tEq (y : E.Ob) (h : E.Hom (A.Uo b) y) (k : D.Hom a b)
  : Id (D.Hom a (A.Ro y)) (A.adj a y (E.comp (A.Uo a) (A.Uo b) y h (A.Um a b k))) (D.comp a b (A.Ro y) (A.adj b y h) k) =
  A.adj-nat-src a b y k h ;

 kap (y : E.Ob) (w : CD.F (A.Ro y)) : CE.F y =
  (adjI y w.1,
   Equivalences[k].injective (E.Hom (A.Uo a) y) (D.Hom a (A.Ro y)) (A.adj a y) (A.adj-eq a y)
     (E.comp (A.Uo a) (A.Uo b) y (adjI y w.1) (A.Um a b f0)) (E.comp (A.Uo a) (A.Uo b) y (adjI y w.1) (A.Um a b f1))
     (trans (D.Hom a (A.Ro y)) (A.adj a y (E.comp (A.Uo a) (A.Uo b) y (adjI y w.1) (A.Um a b f0))) (D.comp a b (A.Ro y) w.1 f0)
         (A.adj a y (E.comp (A.Uo a) (A.Uo b) y (adjI y w.1) (A.Um a b f1)))
       (trans (D.Hom a (A.Ro y)) (A.adj a y (E.comp (A.Uo a) (A.Uo b) y (adjI y w.1) (A.Um a b f0))) (D.comp a b (A.Ro y) (A.adj b y (adjI y w.1)) f0) (D.comp a b (A.Ro y) w.1 f0)
          (tEq y (adjI y w.1) f0)
          (ap (D.Hom b (A.Ro y)) (D.Hom a (A.Ro y)) (\ g -> D.comp a b (A.Ro y) g f0) (A.adj b y (adjI y w.1)) w.1 ((A.adj-eq b y).sec-eq w.1)))
       (trans (D.Hom a (A.Ro y)) (D.comp a b (A.Ro y) w.1 f0) (D.comp a b (A.Ro y) w.1 f1) (A.adj a y (E.comp (A.Uo a) (A.Uo b) y (adjI y w.1) (A.Um a b f1)))
          w.2
          (sym (D.Hom a (A.Ro y)) (A.adj a y (E.comp (A.Uo a) (A.Uo b) y (adjI y w.1) (A.Um a b f1))) (D.comp a b (A.Ro y) w.1 f1)
             (trans (D.Hom a (A.Ro y)) (A.adj a y (E.comp (A.Uo a) (A.Uo b) y (adjI y w.1) (A.Um a b f1))) (D.comp a b (A.Ro y) (A.adj b y (adjI y w.1)) f1) (D.comp a b (A.Ro y) w.1 f1)
                (tEq y (adjI y w.1) f1)
                (ap (D.Hom b (A.Ro y)) (D.Hom a (A.Ro y)) (\ g -> D.comp a b (A.Ro y) g f1) (A.adj b y (adjI y w.1)) w.1 ((A.adj-eq b y).sec-eq w.1))))))) ;

 kapI (y : E.Ob) (z : CE.F y) : CD.F (A.Ro y) =
  (A.adj b y z.1,
   trans (D.Hom a (A.Ro y)) (D.comp a b (A.Ro y) (A.adj b y z.1) f0) (A.adj a y (E.comp (A.Uo a) (A.Uo b) y z.1 (A.Um a b f0))) (D.comp a b (A.Ro y) (A.adj b y z.1) f1)
    (sym (D.Hom a (A.Ro y)) (A.adj a y (E.comp (A.Uo a) (A.Uo b) y z.1 (A.Um a b f0))) (D.comp a b (A.Ro y) (A.adj b y z.1) f0) (tEq y z.1 f0))
    (trans (D.Hom a (A.Ro y)) (A.adj a y (E.comp (A.Uo a) (A.Uo b) y z.1 (A.Um a b f0))) (A.adj a y (E.comp (A.Uo a) (A.Uo b) y z.1 (A.Um a b f1))) (D.comp a b (A.Ro y) (A.adj b y z.1) f1)
       (ap (E.Hom (A.Uo a) y) (D.Hom a (A.Ro y)) (A.adj a y) (E.comp (A.Uo a) (A.Uo b) y z.1 (A.Um a b f0)) (E.comp (A.Uo a) (A.Uo b) y z.1 (A.Um a b f1)) z.2)
       (tEq y z.1 f1))) ;

 kap-eq (y : E.Ob) : isEquiv (CD.F (A.Ro y)) (CE.F y) (kap y) =
  qinv (CD.F (A.Ro y)) (CE.F y) (kap y) (kapI y)
   (\ z -> CE.ceq y (kap y (kapI y z)) z (sec-ret (E.Hom (A.Uo b) y) (D.Hom b (A.Ro y)) (A.adj b y) (A.adj-eq b y) z.1))
   (\ w -> CD.ceq (A.Ro y) (kapI y (kap y w)) w ((A.adj-eq b y).sec-eq w.1)) ;

 kap-nat (y y' : E.Ob) (h : E.Hom y y') (w : CD.F (A.Ro y))
  : Id (CE.F y') (kap y' (CD.fmap (A.Ro y) (A.Ro y') (A.Rm y y' h) w)) (CE.fmap y y' h (kap y w)) =
  CE.ceq y' (kap y' (CD.fmap (A.Ro y) (A.Ro y') (A.Rm y y' h) w)) (CE.fmap y y' h (kap y w))
   (Equivalences[k].injective (E.Hom (A.Uo b) y') (D.Hom b (A.Ro y')) (A.adj b y') (A.adj-eq b y')
      (adjI y' (D.comp b (A.Ro y) (A.Ro y') (A.Rm y y' h) w.1)) (E.comp (A.Uo b) y y' h (adjI y w.1))
      (trans (D.Hom b (A.Ro y')) (A.adj b y' (adjI y' (D.comp b (A.Ro y) (A.Ro y') (A.Rm y y' h) w.1))) (D.comp b (A.Ro y) (A.Ro y') (A.Rm y y' h) w.1)
          (A.adj b y' (E.comp (A.Uo b) y y' h (adjI y w.1)))
         ((A.adj-eq b y').sec-eq (D.comp b (A.Ro y) (A.Ro y') (A.Rm y y' h) w.1))
         (sym (D.Hom b (A.Ro y')) (A.adj b y' (E.comp (A.Uo b) y y' h (adjI y w.1))) (D.comp b (A.Ro y) (A.Ro y') (A.Rm y y' h) w.1)
            (trans (D.Hom b (A.Ro y')) (A.adj b y' (E.comp (A.Uo b) y y' h (adjI y w.1))) (D.comp b (A.Ro y) (A.Ro y') (A.Rm y y' h) (A.adj b y (adjI y w.1)))
                (D.comp b (A.Ro y) (A.Ro y') (A.Rm y y' h) w.1)
               (A.adj-nat b y y' h (adjI y w.1))
               (ap (D.Hom b (A.Ro y)) (D.Hom b (A.Ro y')) (D.comp b (A.Ro y) (A.Ro y') (A.Rm y y' h)) (A.adj b y (adjI y w.1)) w.1 ((A.adj-eq b y).sec-eq w.1)))))) ;

 -- Lemma 52 for coequalisers: U of a coequaliser of f0 , f1 is a
 -- coequaliser of U f0 , U f1
 module At (c : D.Ob) (e : CD.F c) (rc : Repr D CD.cofun c e) {
  module T = Tr[D, E, A, CD.cofun, CE.cofun, kap, kap-eq, kap-nat, c, e, rc] ;
  coeq : Repr E CE.cofun T.Uc T.eE = T.transfer ;
 } ;
} ;

-- U c is isomorphic to any object of E representing Phi_E
module TrIso (D E : WCat) (A : Adj[D, E]) (PD : CoFun[D]) (PE : CoFun[E])
 (kap : (b : E.Ob) -> PD.F (A.Ro b) -> PE.F b)
 (kap-eq : (b : E.Ob) -> isEquiv (PD.F (A.Ro b)) (PE.F b) (kap b))
 (kap-nat : (b b' : E.Ob) (h : E.Hom b b') (z : PD.F (A.Ro b))
    -> Id (PE.F b') (kap b' (PD.fmap (A.Ro b) (A.Ro b') (A.Rm b b' h) z)) (PE.fmap b b' h (kap b z)))
 (c : D.Ob) (e : PD.F c) (rc : Repr D PD c e)
 (X : E.Ob) (eX : PE.F X) (rX : Repr E PE X eX) {
 module T = Tr[D, E, A, PD, PE, kap, kap-eq, kap-nat, c, e, rc] ;
 module Y = Yon[E, PE, T.Uc, X, T.eE, eX, T.transfer, rX] ;
 to : E.Hom T.Uc X = Y.u ;
 from : E.Hom X T.Uc = Y.v ;
 from-to : Id (E.Hom T.Uc T.Uc) (E.comp T.Uc X T.Uc from to) (E.idm T.Uc) = Y.vu ;
 to-from : Id (E.Hom X X) (E.comp X T.Uc X to from) (E.idm X) = Y.uv ;
} ;

------------------------------------------------------------------------
-- the concrete category E: families over the points of G of Tier 1
-- algebras, with pointwise homs (the models of cSet_T over U G)

module Over (R : Ring[l].CRing) (setR : Prelude[l].isSet R.R) {
 module Alg = Algebras[l].Over[R,setR] ;
 module FE = Axioms[l].FunExtLemmas[fe @l] ;

 module Fam (C : T2[l,k].PCwF) (S : T2[l,k].Site[C]) (G : C.Ctx) {
  Ob : U k = (x : S.Ob) -> C.Sub (S.yo x) G -> Alg.Algebra ;
  -- algebra maps form a set
  algHomSet (A B : Alg.Algebra) : Prelude[l].isSet (Alg.Hom A B) =
   Prelude[l].isSet-Sigma (RingHom[l].Hom A.ring B.ring) (Alg.Commutes A B) (RingHom[l].Properties[A.ring, B.ring, B.set].set)
    (\ h -> Prelude[l].prop-to-set (Alg.Commutes A B h) (Alg.commutes-prop A B h)) ;
  Hm (F F' : Ob) : U l = (x : S.Ob) (g : C.Sub (S.yo x) G) -> Alg.Hom (F x g) (F' x g) ;
  idm (F : Ob) : Hm F F = \ x g -> Alg.identity (F x g) ;
  comp (F F' F'' : Ob) (b : Hm F' F'') (a : Hm F F') : Hm F F'' = \ x g -> Alg.compose (F x g) (F' x g) (F'' x g) (b x g) (a x g) ;

  -- two pointwise homs with the same values are equal
  hext (F F' : Ob) (a b : Hm F F') (p : (x : S.Ob) (g : C.Sub (S.yo x) G) (z : (F x g).ring.R) -> Id (F' x g).ring.R ((a x g).1.1 z) ((b x g).1.1 z))
   : Id (Hm F F') a b =
   FE.funext S.Ob (\ x -> (g : C.Sub (S.yo x) G) -> Alg.Hom (F x g) (F' x g)) a b (\ x ->
   FE.funext (C.Sub (S.yo x) G) (\ g -> Alg.Hom (F x g) (F' x g)) (a x) (b x) (\ g ->
   Alg.ext (F x g) (F' x g) (a x g) (b x g) (p x g))) ;

  cat : WCat = new WCat[
   Ob := Ob, Hom := Hm, idm := idm, comp := comp,
   idl := \ F F' a -> hext F F' (comp F F' F' (idm F') a) a (\ x g z -> refl ((a x g).1.1 z)),
   idr := \ F F' a -> hext F F' (comp F F F' a (idm F)) a (\ x g z -> refl ((a x g).1.1 z)),
   assoc := \ F1 F2 F3 F4 c b a -> hext F1 F4 (comp F1 F2 F4 (comp F2 F3 F4 c b) a) (comp F1 F3 F4 c (comp F1 F2 F3 b a))
     (\ x g z -> refl ((c x g).1.1 ((b x g).1.1 ((a x g).1.1 z)))),
   hset := \ F F' -> FE.isSet-Pi S.Ob (\ x -> (g : C.Sub (S.yo x) G) -> Alg.Hom (F x g) (F' x g)) (\ x ->
     FE.isSet-Pi (C.Sub (S.yo x) G) (\ g -> Alg.Hom (F x g) (F' x g)) (\ g -> algHomSet (F x g) (F' x g)))] ;

  -- an isomorphism of families is, at every point, an equivalence of the
  -- underlying sets of the algebras (the fibres)
  fibEq (F F' : Ob) (u : Hm F F') (v : Hm F' F)
   (vu : Id (Hm F F) (comp F F' F v u) (idm F)) (uv : Id (Hm F' F') (comp F' F F' u v) (idm F'))
   (x : S.Ob) (g : C.Sub (S.yo x) G) : Prelude[l].isEquiv (F x g).ring.R (F' x g).ring.R (u x g).1.1 =
   Prelude[l].qinv (F x g).ring.R (F' x g).ring.R (u x g).1.1 (v x g).1.1
    (\ z -> Prelude[l].happly (F' x g).ring.R (\ w -> (F' x g).ring.R) (\ w -> (u x g).1.1 ((v x g).1.1 w)) (\ w -> w)
       (ap (Hm F' F') ((F' x g).ring.R -> (F' x g).ring.R) (\ m -> (m x g).1.1) (comp F' F F' u v) (idm F') uv) z)
    (\ z -> Prelude[l].happly (F x g).ring.R (\ w -> (F x g).ring.R) (\ w -> (v x g).1.1 ((u x g).1.1 w)) (\ w -> w)
       (ap (Hm F F) ((F x g).ring.R -> (F x g).ring.R) (\ m -> (m x g).1.1) (comp F F' F v u) (idm F) vu) z) ;
 } ;
} ;

