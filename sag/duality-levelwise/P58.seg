-- P58.seg: Prop 58 (P3.6), proved: Sp is locally homotopy representable
-- with representation (obj u , objHom u , q_g), i.e. <p_O , q_g> is a
-- levelwise equivalence.  This discharges E1.P58 for E1, E2 and E3.
--
-- Informal proof, at a point g of G0 at x (u = prs g, A = alg x,
-- O = obj u) and an object y (B = alg y).  Points of yo O at y are maps
-- f' : y -> O (Yoneda), that is algebra maps <u> -> B (homAlg, objIso).
-- Points of yo x . Sp[g] at y are pairs (s , c) (extEquiv); with
-- f = s read as a map y -> x and h = homAlg f, c is a point of Sp at g f
-- (transport), a solution of prs (g f) (spE), a solution of u.h
-- (prs-nat).  So F3 : points -> (h : Hom(A , B)) * Sol(u.h) is an
-- equivalence (change of base along s |-> homAlg (s read in Hom)).
-- Tier 1 (Points.Spectrum) gives Hom(<u> , B) = (h : Hom(A , B)) * Sol(u.h),
-- r |-> (r p_u , r on the generators).  The square
--    f' |-> <p_O , q_g> . f'  then F3   =   f' |-> spectrum (homAlg f' . objIso)
-- commutes: on the first component both are homAlg f' . homAlg p_O
-- (o-assoc, p-pair, yoH-o, homAlg-o, objHom-p); on the solutions, the
-- element of Sp is q_g restricted along f' (q-pair, subt-o, TE), whose
-- solution is homAlg f' applied to sol0 (spE-nat, the section of spE,
-- move-sol), i.e. homAlg f' (objIso (generator v)) at v (value-subst),
-- which is Tier 1's `generators`.  Then <p_O , q_g> . - is an
-- equivalence at y by 2-out-of-3.
level l k ;
constraint l <= k ;
open Ring[l] ;
module Pr = Prelude[l] ;
module Pk = Prelude[k] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module Alg = Algebras[l].Over[R,setR] ;
 module Tm = T3[l,k].Over[R,setR] ;
 module Co = Core[l,k].Over[R,setR] ;
 module E1m = E1[l,k].Over[R,setR] ;
 module PL = P58Lemmas[l].Over[R,setR] ;
 module Pf (C : T2[l,k].PCwF) (S : T2[l,k].Site[C]) (T : Tm.T3[C,S]) (x : S.Ob) (g : C.Sub (S.yo x) T.G0) {
  module K0 = Co.At[C,S,T,x,g] ;
  module DR = T2[l,k].Der[C] ;
  module Pt = DR.Pts[S] ;
  module TM = TE[l,k].TEm[C] ;
  Lx : C.Ctx = S.yo x ;
  DO : C.Ctx = S.yo K0.O ;
  Spg : C.Ty Lx = C.subT Lx T.G0 T.Sp g ;
  Ex : C.Ctx = C.ext Lx Spg ;
  yp : C.Sub DO Lx = S.yoH K0.O x K0.pO ;
  a0 : C.El DO (C.subT DO Lx Spg yp) =
   DR.trE DO (C.subT DO T.G0 T.Sp (C.o DO Lx T.G0 g yp)) (C.subT DO Lx Spg yp) (C.subT-o DO Lx T.G0 T.Sp g yp) K0.qg ;
  pqT : C.Sub DO Ex = C.pair DO Lx Spg yp a0 ;
  mv' (w1 w2 : Tm.Pres K0.AO) (E : Id (Tm.Pres K0.AO) w1 w2) (z : Tm.Pd[K0.AO,w1].Sol) : Tm.Pd[K0.AO,w2].Sol =
   PL.Vals[K0.AO].move w1 w2 E z ;
  module Y (y : S.Ob) {
   B : Alg.Algebra = T.alg y ;
   Dy : C.Ctx = S.yo y ;
   module Spc = Points[l].Over[R,setR].Spectrum[K0.A,K0.u,K0.Pu.X,K0.Pu.px,B] ;
   module SP = PL.SolPath[K0.A,B,K0.u] ;
   -- Yoneda, read at level l
   yoE : Pr.Equiv (S.Hom y x) (C.Sub Dy Lx) = (S.yoH y x,E1m.toL (S.Hom y x) (C.Sub Dy Lx) (S.yoH y x) (S.yoH-eq y x)) ;
   yoEO : Pr.Equiv (S.Hom y K0.O) (C.Sub Dy DO) = (S.yoH y K0.O,E1m.toL (S.Hom y K0.O) (C.Sub Dy DO) (S.yoH y K0.O) (S.yoH-eq y K0.O)) ;
   rd (s : C.Sub Dy Lx) : S.Hom y x = yoE.2.sec s ;
   -- E2 : maps y -> O are algebra maps <u> -> B
   pre (r : Alg.Hom K0.AO B) : Alg.Hom Spc.Ch.P B = Alg.compose Spc.Ch.P K0.AO B r (T.objIso x K0.u) ;
   preEq : Pr.Equiv (Alg.Hom K0.AO B) (Alg.Hom Spc.Ch.P B) =
    (pre,Pr.qinv (Alg.Hom K0.AO B) (Alg.Hom Spc.Ch.P B) pre (\ r -> Alg.compose K0.AO Spc.Ch.P B r (T.objInv x K0.u))
      (\ r -> Alg.ext Spc.Ch.P B _ r (\ b -> ap r.1.1 (T.objInv-l x K0.u b)))
      (\ r -> Alg.ext K0.AO B _ r (\ c -> ap r.1.1 (T.objInv-r x K0.u c)))) ;
   E2 : Pr.Equiv (S.Hom y K0.O) (Alg.Hom Spc.Ch.P B) =
    Equivalences[l].compose (S.Hom y K0.O) (Alg.Hom K0.AO B) (Alg.Hom Spc.Ch.P B)
     (T.homAlg y K0.O,T.homAlg-eq y K0.O) preEq ;
   -- F3 : points of yo x . Sp[g] at y -> (h : Hom(A , B)) * Sol(u.h)
   beta : Pr.Equiv (C.Sub Dy Lx) (Alg.Hom K0.A B) =
    Equivalences[l].compose (C.Sub Dy Lx) (S.Hom y x) (Alg.Hom K0.A B)
     (Lemma66[l].invEquiv (S.Hom y x) (C.Sub Dy Lx) (S.yoH y x) yoE.2) (T.homAlg y x,T.homAlg-eq y x) ;
   gf (s : C.Sub Dy Lx) : C.Sub Dy T.G0 = Tm.Rf[C,S,T.G0,T.Sp].at y x (rd s) g ;
   tyP (s : C.Sub Dy Lx) : Id (C.Ty Dy) (C.subT Dy Lx Spg s) (C.subT Dy T.G0 T.Sp (gf s)) =
    Pk.trans (C.Ty Dy) (C.subT Dy Lx Spg s) (C.subT Dy T.G0 T.Sp (C.o Dy Lx T.G0 g s)) (C.subT Dy T.G0 T.Sp (gf s))
     (Pk.sym (C.Ty Dy) (C.subT Dy T.G0 T.Sp (C.o Dy Lx T.G0 g s)) (C.subT Dy Lx Spg s) (C.subT-o Dy Lx T.G0 T.Sp g s))
     (Pk.ap (C.Sub Dy Lx) (C.Ty Dy) (\ t -> C.subT Dy T.G0 T.Sp (C.o Dy Lx T.G0 g t)) s (S.yoH y x (rd s))
       (Pk.sym (C.Sub Dy Lx) (S.yoH y x (rd s)) s (yoE.2.sec-eq s))) ;
   fibE (s : C.Sub Dy Lx) : Pr.Equiv (C.El Dy (C.subT Dy Lx Spg s)) Tm.Pd[B,Tm.change K0.A B (beta.1 s) K0.u].Sol =
    Equivalences[l].compose (C.El Dy (C.subT Dy Lx Spg s)) Tm.Pd[B,T.prs y (gf s)].Sol Tm.Pd[B,Tm.change K0.A B (beta.1 s) K0.u].Sol
     (Equivalences[l].compose (C.El Dy (C.subT Dy Lx Spg s)) (C.El Dy (C.subT Dy T.G0 T.Sp (gf s))) Tm.Pd[B,T.prs y (gf s)].Sol
       (DR.trE Dy _ _ (tyP s),E1m.toL _ _ _ (TM.trE-eq Dy _ _ (tyP s)))
       (T.spE y (gf s)))
     (PL.Vals[B].moveEq (T.prs y (gf s)) (Tm.change K0.A B (beta.1 s) K0.u) (T.prs-nat y x (rd s) g)) ;
   Pts : U l = (s : C.Sub Dy Lx) * C.El Dy (C.subT Dy Lx Spg s) ;
   extE : Pr.Equiv (C.Sub Dy Ex) Pts =
    (DR.extFwd Dy Lx Spg,E1m.toL (C.Sub Dy Ex) Pts (DR.extFwd Dy Lx Spg) (DR.extEquiv Dy Lx Spg).2) ;
   F3 : Pr.Equiv (C.Sub Dy Ex) SP.Sols =
    Equivalences[l].compose (C.Sub Dy Ex) ((s : C.Sub Dy Lx) * Tm.Pd[B,Tm.change K0.A B (beta.1 s) K0.u].Sol) SP.Sols
     (Equivalences[l].compose (C.Sub Dy Ex) Pts ((s : C.Sub Dy Lx) * Tm.Pd[B,Tm.change K0.A B (beta.1 s) K0.u].Sol)
       extE
       (SigmaEq[l].fibrewise (C.Sub Dy Lx) (\ s -> C.El Dy (C.subT Dy Lx Spg s))
         (\ s -> Tm.Pd[B,Tm.change K0.A B (beta.1 s) K0.u].Sol) fibE))
     (SigmaEq[l].change-of-base (C.Sub Dy Lx) (Alg.Hom K0.A B) (\ h -> Tm.Pd[B,Tm.change K0.A B h K0.u].Sol) beta) ;
   -- the point of Sp at y along a point path, with TE-related elements
   spt (g1 g2 : C.Sub Dy T.G0) (z : Id (C.Sub Dy T.G0) g1 g2)
    (a1 : Pt.fib T.G0 T.Sp y g1) (a2 : Pt.fib T.G0 T.Sp y g2)
    (h : TM.TE Dy (C.subT Dy T.G0 T.Sp g1) (C.subT Dy T.G0 T.Sp g2) a1 a2) :
    Id Tm.Pd[B,T.prs y g2].Sol ((T.spE y g2).1 a2)
     (PL.Vals[B].move (T.prs y g1) (T.prs y g2) (Pr.ap (C.Sub Dy T.G0) (Tm.Pres B) (T.prs y) g1 g2 z) ((T.spE y g1).1 a1)) =
    idJ (C.Sub Dy T.G0) g1 (\ g3 z3 -> (a3 : Pt.fib T.G0 T.Sp y g3)
      -> TM.TE Dy (C.subT Dy T.G0 T.Sp g1) (C.subT Dy T.G0 T.Sp g3) a1 a3
      -> Id Tm.Pd[B,T.prs y g3].Sol ((T.spE y g3).1 a3)
          (PL.Vals[B].move (T.prs y g1) (T.prs y g3) (Pr.ap (C.Sub Dy T.G0) (Tm.Pres B) (T.prs y) g1 g3 z3) ((T.spE y g1).1 a1)))
     (\ a3 h3 -> Pr.ap (Pt.fib T.G0 T.Sp y g1) Tm.Pd[B,T.prs y g1].Sol (T.spE y g1).1 a3 a1
       (Pk.sym (Pt.fib T.G0 T.Sp y g1) a1 a3 (TM.teAny Dy _ _ a1 a3 h3 (refl (C.subT Dy T.G0 T.Sp g1)))))
     g2 z a2 h ;
   -- the square, at f' : y -> O
   module Sq (f' : S.Hom y K0.O) {
    phi : C.Sub Dy DO = S.yoH y K0.O f' ;
    sigma : C.Sub Dy Ex = C.o Dy DO Ex pqT phi ;
    s : C.Sub Dy Lx = (DR.extFwd Dy Lx Spg sigma).1 ;
    f0 : S.Hom y x = S.compH y K0.O x K0.pO f' ;
    hf : Alg.Hom K0.AO B = T.homAlg y K0.O f' ;
    s-path : Id (C.Sub Dy Lx) s (S.yoH y x f0) =
     Pk.trans (C.Sub Dy Lx) s (C.o Dy DO Lx (C.o DO Ex Lx (C.p Lx Spg) pqT) phi) (S.yoH y x f0)
      (Pk.sym (C.Sub Dy Lx) (C.o Dy DO Lx (C.o DO Ex Lx (C.p Lx Spg) pqT) phi) s (C.o-assoc Dy DO Ex Lx (C.p Lx Spg) pqT phi))
      (Pk.trans (C.Sub Dy Lx) (C.o Dy DO Lx (C.o DO Ex Lx (C.p Lx Spg) pqT) phi) (C.o Dy DO Lx yp phi) (S.yoH y x f0)
        (Pk.ap (C.Sub DO Lx) (C.Sub Dy Lx) (\ t -> C.o Dy DO Lx t phi) (C.o DO Ex Lx (C.p Lx Spg) pqT) yp (C.p-pair DO Lx Spg yp a0))
        (Pk.sym (C.Sub Dy Lx) (S.yoH y x f0) (C.o Dy DO Lx yp phi) (S.yoH-o y K0.O x K0.pO f'))) ;
    rd-s : Id (S.Hom y x) (rd s) f0 =
     Pr.trans (S.Hom y x) (rd s) (rd (S.yoH y x f0)) f0
      (Pr.ap (C.Sub Dy Lx) (S.Hom y x) rd s (S.yoH y x f0) s-path)
      (Pr.sec-ret (S.Hom y x) (C.Sub Dy Lx) (S.yoH y x) yoE.2 f0) ;
    -- first components
    base : Id (Alg.Hom K0.A B) (beta.1 s) (Alg.compose K0.A Spc.Ch.P B (E2.1 f') Spc.Ch.p) =
     Alg.ext K0.A B (beta.1 s) (Alg.compose K0.A Spc.Ch.P B (E2.1 f') Spc.Ch.p) (\ a ->
      trans (ap (\ k -> (T.homAlg y x k).1.1 a) rd-s)
       (trans (T.homAlg-o y K0.O x K0.pO f' a) (ap hf.1.1 (T.objHom-p x K0.u a)))) ;
    -- the element: c1 (the fibre of sigma, moved) is q_g restricted along f'
    g1 : C.Sub Dy T.G0 = Tm.Rf[C,S,T.G0,T.Sp].at y K0.O f' K0.gO ;
    rres : Pt.fib T.G0 T.Sp y g1 = Tm.Rf[C,S,T.G0,T.Sp].res y K0.O f' K0.gO K0.qg ;
    c : C.El Dy (C.subT Dy Lx Spg s) = (DR.extFwd Dy Lx Spg sigma).2 ;
    c1 : Pt.fib T.G0 T.Sp y (gf s) = DR.trE Dy _ _ (tyP s) c ;
    te : TM.TE Dy (C.subT Dy T.G0 T.Sp g1) (C.subT Dy T.G0 T.Sp (gf s)) rres c1 =
     TM.teS Dy (C.subT Dy T.G0 T.Sp (gf s)) (C.subT Dy T.G0 T.Sp g1) c1 rres
      (TM.teT Dy (C.subT Dy T.G0 T.Sp (gf s)) (C.subT Dy Lx Spg s) (C.subT Dy T.G0 T.Sp g1) c1 c rres
       (TM.teS Dy (C.subT Dy Lx Spg s) (C.subT Dy T.G0 T.Sp (gf s)) c c1 (TM.teTr Dy _ _ (tyP s) c))
       (TM.teT Dy (C.subT Dy Lx Spg s) (C.subT Dy DO (C.subT DO Lx Spg (C.o DO Ex Lx (C.p Lx Spg) pqT)) phi) (C.subT Dy T.G0 T.Sp g1)
         c (C.subt Dy DO (C.subT DO Lx Spg (C.o DO Ex Lx (C.p Lx Spg) pqT)) (TM.qv DO Lx Spg pqT) phi) rres
        (TM.qvO Dy DO Lx Spg pqT phi)
        (TM.teT Dy (C.subT Dy DO (C.subT DO Lx Spg (C.o DO Ex Lx (C.p Lx Spg) pqT)) phi) (C.subT Dy DO (C.subT DO Lx Spg yp) phi) (C.subT Dy T.G0 T.Sp g1)
          (C.subt Dy DO (C.subT DO Lx Spg (C.o DO Ex Lx (C.p Lx Spg) pqT)) (TM.qv DO Lx Spg pqT) phi) (C.subt Dy DO (C.subT DO Lx Spg yp) a0 phi) rres
         (TM.teSub Dy DO phi (C.subT DO Lx Spg (C.o DO Ex Lx (C.p Lx Spg) pqT)) (C.subT DO Lx Spg yp) (TM.qv DO Lx Spg pqT) a0
           (TM.qvPair DO Lx Spg yp a0))
         (TM.teT Dy (C.subT Dy DO (C.subT DO Lx Spg yp) phi) (C.subT Dy DO (C.subT DO T.G0 T.Sp K0.gO) phi) (C.subT Dy T.G0 T.Sp g1)
           (C.subt Dy DO (C.subT DO Lx Spg yp) a0 phi) (C.subt Dy DO (C.subT DO T.G0 T.Sp K0.gO) K0.qg phi) rres
          (TM.teSub Dy DO phi (C.subT DO Lx Spg yp) (C.subT DO T.G0 T.Sp K0.gO) a0 K0.qg
            (TM.teS DO (C.subT DO T.G0 T.Sp K0.gO) (C.subT DO Lx Spg yp) K0.qg a0 (TM.teTr DO _ _ (C.subT-o DO Lx T.G0 T.Sp g yp) K0.qg)))
          (TM.teTr Dy _ _ (Pk.sym (C.Ty Dy) (C.subT Dy T.G0 T.Sp g1) (C.subT Dy DO (C.subT DO T.G0 T.Sp K0.gO) phi)
              (C.subT-o Dy DO T.G0 T.Sp K0.gO phi))
            (C.subt Dy DO (C.subT DO T.G0 T.Sp K0.gO) K0.qg phi)))))) ;
    -- the point path g1 = g f (f = s read in Hom)
    zeta : Id (C.Sub Dy T.G0) g1 (gf s) =
     Pk.trans (C.Sub Dy T.G0) g1 (C.o Dy Lx T.G0 g (C.o Dy DO Lx yp phi)) (gf s)
      (C.o-assoc Dy DO Lx T.G0 g yp phi)
      (Pk.ap (C.Sub Dy Lx) (C.Sub Dy T.G0) (\ t -> C.o Dy Lx T.G0 g t) (C.o Dy DO Lx yp phi) (S.yoH y x (rd s))
        (Pk.trans (C.Sub Dy Lx) (C.o Dy DO Lx yp phi) (S.yoH y x f0) (S.yoH y x (rd s))
          (Pk.sym (C.Sub Dy Lx) (S.yoH y x f0) (C.o Dy DO Lx yp phi) (S.yoH-o y K0.O x K0.pO f'))
          (Pk.ap (S.Hom y x) (C.Sub Dy Lx) (S.yoH y x) f0 (rd s) (Pk.sym (S.Hom y x) (rd s) f0 rd-s)))) ;
    -- the solution of c1 is a move of homAlg f' applied to sol0
    w0 : Tm.Pres B = Tm.change K0.AO B hf K0.w0 ;
    m : Tm.Pd[B,w0].Sol = Tm.Moves[K0.AO,B,hf,K0.w0].sol K0.sol0 ;
    E1p : Id (Tm.Pres B) w0 (Tm.change K0.AO B hf (T.prs K0.O K0.gO)) =
     Pr.ap (Tm.Pres K0.AO) (Tm.Pres B) (Tm.change K0.AO B hf) K0.w0 (T.prs K0.O K0.gO) K0.e ;
    E2p : Id (Tm.Pres B) (Tm.change K0.AO B hf (T.prs K0.O K0.gO)) (T.prs y g1) =
     Pr.sym (Tm.Pres B) (T.prs y g1) (Tm.change K0.AO B hf (T.prs K0.O K0.gO)) (T.prs-nat y K0.O f' K0.gO) ;
    E3p : Id (Tm.Pres B) (T.prs y g1) (T.prs y (gf s)) = Pr.ap (C.Sub Dy T.G0) (Tm.Pres B) (T.prs y) g1 (gf s) zeta ;
    E4p : Id (Tm.Pres B) (T.prs y (gf s)) (Tm.change K0.A B (beta.1 s) K0.u) = T.prs-nat y x (rd s) g ;
    mv (w1 w2 : Tm.Pres B) (E : Id (Tm.Pres B) w1 w2) (z : Tm.Pd[B,w1].Sol) : Tm.Pd[B,w2].Sol = PL.Vals[B].move w1 w2 E z ;
    sol-c1 : Id Tm.Pd[B,T.prs y (gf s)].Sol ((T.spE y (gf s)).1 c1)
     (mv (T.prs y g1) (T.prs y (gf s)) E3p (mv (Tm.change K0.AO B hf (T.prs K0.O K0.gO)) (T.prs y g1) E2p
       (mv w0 (Tm.change K0.AO B hf (T.prs K0.O K0.gO)) E1p m))) =
     Pr.trans Tm.Pd[B,T.prs y (gf s)].Sol _ (mv (T.prs y g1) (T.prs y (gf s)) E3p ((T.spE y g1).1 rres)) _
      (spt g1 (gf s) zeta rres c1 te)
      (Pr.ap Tm.Pd[B,T.prs y g1].Sol Tm.Pd[B,T.prs y (gf s)].Sol (mv (T.prs y g1) (T.prs y (gf s)) E3p) _ _
       (Pr.trans Tm.Pd[B,T.prs y g1].Sol _
         (mv (Tm.change K0.AO B hf (T.prs K0.O K0.gO)) (T.prs y g1) E2p
           (Tm.Moves[K0.AO,B,hf,T.prs K0.O K0.gO].sol ((T.spE K0.O K0.gO).1 K0.qg))) _
        (T.spE-nat y K0.O f' K0.gO K0.qg)
        (Pr.ap Tm.Pd[B,Tm.change K0.AO B hf (T.prs K0.O K0.gO)].Sol Tm.Pd[B,T.prs y g1].Sol
          (mv (Tm.change K0.AO B hf (T.prs K0.O K0.gO)) (T.prs y g1) E2p) _ _
          (Pr.trans Tm.Pd[B,Tm.change K0.AO B hf (T.prs K0.O K0.gO)].Sol _
            (Tm.Moves[K0.AO,B,hf,T.prs K0.O K0.gO].sol (mv' K0.w0 (T.prs K0.O K0.gO) K0.e K0.sol0)) _
           (Pr.ap Tm.Pd[K0.AO,T.prs K0.O K0.gO].Sol Tm.Pd[B,Tm.change K0.AO B hf (T.prs K0.O K0.gO)].Sol
             Tm.Moves[K0.AO,B,hf,T.prs K0.O K0.gO].sol _ _
             ((T.spE K0.O K0.gO).2.sec-eq (mv' K0.w0 (T.prs K0.O K0.gO) K0.e K0.sol0)))
           (PL.move-sol K0.AO B hf K0.w0 (T.prs K0.O K0.gO) K0.e K0.sol0))))) ;
    -- the solution of sigma, as one move of m
    wT : Tm.Pres B = Tm.change K0.A B (beta.1 s) K0.u ;
    Eall : Id (Tm.Pres B) w0 wT =
     Pr.trans (Tm.Pres B) w0 (T.prs y (gf s)) wT
      (Pr.trans (Tm.Pres B) w0 (Tm.change K0.AO B hf (T.prs K0.O K0.gO)) (T.prs y (gf s)) E1p
        (Pr.trans (Tm.Pres B) (Tm.change K0.AO B hf (T.prs K0.O K0.gO)) (T.prs y g1) (T.prs y (gf s)) E2p E3p)) E4p ;
    Fs : SP.Sols = F3.1 sigma ;
    Rs : SP.Sols = Spc.spectrum.1 (E2.1 f') ;
    sol-sigma : Id Tm.Pd[B,wT].Sol Fs.2 (mv w0 wT Eall m) =
     Pr.trans Tm.Pd[B,wT].Sol _ (mv (T.prs y (gf s)) wT E4p (mv (T.prs y g1) (T.prs y (gf s)) E3p
        (mv (Tm.change K0.AO B hf (T.prs K0.O K0.gO)) (T.prs y g1) E2p (mv w0 (Tm.change K0.AO B hf (T.prs K0.O K0.gO)) E1p m)))) _
      (Pr.ap Tm.Pd[B,T.prs y (gf s)].Sol Tm.Pd[B,wT].Sol (mv (T.prs y (gf s)) wT E4p) _ _ sol-c1)
      (Pr.trans Tm.Pd[B,wT].Sol _
        (mv (T.prs y (gf s)) wT E4p (mv (Tm.change K0.AO B hf (T.prs K0.O K0.gO)) (T.prs y (gf s))
          (Pr.trans (Tm.Pres B) (Tm.change K0.AO B hf (T.prs K0.O K0.gO)) (T.prs y g1) (T.prs y (gf s)) E2p E3p)
          (mv w0 (Tm.change K0.AO B hf (T.prs K0.O K0.gO)) E1p m))) _
       (Pr.ap Tm.Pd[B,T.prs y (gf s)].Sol Tm.Pd[B,wT].Sol (mv (T.prs y (gf s)) wT E4p) _ _
         (PL.Vals[B].move-trans (Tm.change K0.AO B hf (T.prs K0.O K0.gO)) (T.prs y g1) (T.prs y (gf s)) E2p E3p
           (mv w0 (Tm.change K0.AO B hf (T.prs K0.O K0.gO)) E1p m)))
       (Pr.trans Tm.Pd[B,wT].Sol _
         (mv (T.prs y (gf s)) wT E4p (mv w0 (T.prs y (gf s))
           (Pr.trans (Tm.Pres B) w0 (Tm.change K0.AO B hf (T.prs K0.O K0.gO)) (T.prs y (gf s)) E1p
             (Pr.trans (Tm.Pres B) (Tm.change K0.AO B hf (T.prs K0.O K0.gO)) (T.prs y g1) (T.prs y (gf s)) E2p E3p)) m)) _
        (Pr.ap Tm.Pd[B,T.prs y (gf s)].Sol Tm.Pd[B,wT].Sol (mv (T.prs y (gf s)) wT E4p) _ _
          (PL.Vals[B].move-trans w0 (Tm.change K0.AO B hf (T.prs K0.O K0.gO)) (T.prs y (gf s)) E1p
            (Pr.trans (Tm.Pres B) (Tm.change K0.AO B hf (T.prs K0.O K0.gO)) (T.prs y g1) (T.prs y (gf s)) E2p E3p) m))
        (PL.Vals[B].move-trans w0 (T.prs y (gf s)) wT
          (Pr.trans (Tm.Pres B) w0 (Tm.change K0.AO B hf (T.prs K0.O K0.gO)) (T.prs y (gf s)) E1p
            (Pr.trans (Tm.Pres B) (Tm.change K0.AO B hf (T.prs K0.O K0.gO)) (T.prs y g1) (T.prs y (gf s)) E2p E3p)) E4p m))) ;
    -- values: the solution at v is homAlg f' (objIso (generator v))
    value (v : Presentations[l].Fin K0.u.1) :
     Id B.ring.R (PL.Vals[B].vals wT Fs.2 v) (hf.1.1 ((T.objIso x K0.u).1.1 (K0.Pu.px.1.1 v))) =
     Pr.trans B.ring.R _ (PL.Vals[B].vals wT (mv w0 wT Eall m) v) _
      (Pr.ap Tm.Pd[B,wT].Sol B.ring.R (\ z -> PL.Vals[B].vals wT z v) _ _ sol-sigma)
      (PL.Vals[B].value-subst K0.u.1 w0.2 wT.2 Eall m v) ;
    square : Id SP.Sols Fs Rs =
     SP.sol-path (beta.1 s) (Alg.compose K0.A Spc.Ch.P B (E2.1 f') Spc.Ch.p) base Fs.2 Rs.2
      (\ v -> Pr.trans B.ring.R _ _ _ (value v) (Pr.sym B.ring.R _ _ (Spc.generators (E2.1 f') v))) ;
   } ;
   onP (phi : C.Sub Dy DO) : C.Sub Dy Ex = C.o Dy DO Ex pqT phi ;
   -- 2-out-of-3
   Gm (f' : S.Hom y K0.O) : SP.Sols = F3.1 (onP (S.yoH y K0.O f')) ;
   Geq : Pr.isEquiv (S.Hom y K0.O) SP.Sols Gm =
    Equivalences[l].homotopy (S.Hom y K0.O) SP.Sols
     (Equivalences[l].compose (S.Hom y K0.O) (Alg.Hom Spc.Ch.P B) SP.Sols E2 Spc.spectrum) Gm (\ f' -> Sq[f'].square) ;
   oy : Pr.Equiv (S.Hom y K0.O) (C.Sub Dy Ex) =
    Equivalences[l].compose (S.Hom y K0.O) SP.Sols (C.Sub Dy Ex) (Gm,Geq)
     (Lemma66[l].invEquiv (C.Sub Dy Ex) SP.Sols F3.1 F3.2) ;
   oyEq : Pr.isEquiv (S.Hom y K0.O) (C.Sub Dy Ex) (\ f' -> onP (S.yoH y K0.O f')) =
    Equivalences[l].homotopy (S.Hom y K0.O) (C.Sub Dy Ex) oy (\ f' -> onP (S.yoH y K0.O f'))
     (\ f' -> Pr.sym (C.Sub Dy Ex) (F3.2.sec (F3.1 (onP (S.yoH y K0.O f')))) (onP (S.yoH y K0.O f'))
       (Pr.sec-ret (C.Sub Dy Ex) SP.Sols F3.1 F3.2 (onP (S.yoH y K0.O f')))) ;
   lw-y : Pk.isEquiv (C.Sub Dy DO) (C.Sub Dy Ex) onP =
    E1m.toK (C.Sub Dy DO) (C.Sub Dy Ex) onP
     (Equivalences[l].homotopy (C.Sub Dy DO) (C.Sub Dy Ex)
       (Equivalences[l].compose (C.Sub Dy DO) (S.Hom y K0.O) (C.Sub Dy Ex)
         (Lemma66[l].invEquiv (S.Hom y K0.O) (C.Sub Dy DO) (S.yoH y K0.O) yoEO.2)
         ((\ f' -> onP (S.yoH y K0.O f')),oyEq))
       onP
       (\ ph -> Pr.ap (C.Sub Dy DO) (C.Sub Dy Ex) onP ph (S.yoH y K0.O (yoEO.2.sec ph))
         (Pr.sym (C.Sub Dy DO) (S.yoH y K0.O (yoEO.2.sec ph)) ph (yoEO.2.sec-eq ph)))) ;
  } ;
  lw : Pt.LEqC DO Ex pqT = \ y -> Y[y].lw-y ;
 } ;
 -- Prop 58 discharges the P58 premise of E1, E2, E3
 prop58 (C : T2[l,k].PCwF) (S : T2[l,k].Site[C]) (T : Tm.T3[C,S]) : E1m.P58[C,S,T] =
  new E1m.P58[C,S,T, lw := \ x g -> Pf[C,S,T,x,g].lw] ;
} ;
