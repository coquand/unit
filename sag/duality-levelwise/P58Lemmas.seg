-- Generic lemmas for the proof of Prop 58 (P3.6).
--   nat-set : Nat is a set (Hedberg, with the usual code).
--   value-subst : transporting a solution along a path between two
--     presentations with the same number n of variables does not change
--     its values (the induced loop on n is refl, Nat being a set).
--   sol-path : two pairs (h , a), (h' , b) of an algebra map and a
--     solution of u.h are equal when h = h' and a, b have the same
--     values.
level l ;
open Ring[l] ;
module Pr = Prelude[l] ;
top-prop : Pr.isProp Top = split { tt -> split { tt -> refl tt } } ;
empty-prop : Pr.isProp Empty = \ e f -> efq e ;
-- (after sag/picard/PicardDegree.seg)
code : Nat -> Nat -> U l = split {
 zero -> split { zero -> Top ; suc n -> Empty } ;
 suc m | r -> split { zero -> Empty ; suc n -> r n } } ;
code-prop : (m n : Nat) -> Pr.isProp (code m n) = split {
 zero -> split { zero -> top-prop ; suc n -> empty-prop } ;
 suc m | r -> split { zero -> empty-prop ; suc n -> r n } } ;
code-refl : (m : Nat) -> code m m = split { zero -> tt ; suc m | r -> r } ;
code-eq : (m n : Nat) -> code m n -> Id Nat m n = split {
 zero -> split { zero -> \ h -> refl zero ; suc n -> \ h -> efq h } ;
 suc m | r -> split { zero -> \ h -> efq h ; suc n -> \ h -> ap (\ k -> suc k) (r n h) } } ;
nat-set : Pr.isSet Nat = \ m -> Pr.Hedberg[Nat,m,code m,code-prop m,code-refl m,code-eq m].hedberg ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module Alg = Algebras[l].Over[R,setR] ;
 module Tm = T3[l,l].Over[R,setR] ;
 module Vals (B : Alg.Algebra) {
  module PB = Presentations[l].Over[B.ring,B.set] ;
  Fun (n : Nat) : U l = Presentations[l].Fin n -> B.ring.R ;
  vals (w : Tm.Pres B) (s : Tm.Pd[B,w].Sol) : Fun w.1 = s.1 ;
  move (w w' : Tm.Pres B) (E : Id (Tm.Pres B) w w') (s : Tm.Pd[B,w].Sol) : Tm.Pd[B,w'].Sol =
   Pr.subst (Tm.Pres B) (\ z -> Tm.Pd[B,z].Sol) w w' E s ;
  move-trans (w1 w2 w3 : Tm.Pres B) (E1 : Id (Tm.Pres B) w1 w2) (E2 : Id (Tm.Pres B) w2 w3) (s : Tm.Pd[B,w1].Sol) :
   Id Tm.Pd[B,w3].Sol (move w2 w3 E2 (move w1 w2 E1 s)) (move w1 w3 (Pr.trans (Tm.Pres B) w1 w2 w3 E1 E2) s) =
   idJ (Tm.Pres B) w2 (\ w4 E4 -> Id Tm.Pd[B,w4].Sol (move w2 w4 E4 (move w1 w2 E1 s)) (move w1 w4 (Pr.trans (Tm.Pres B) w1 w2 w4 E1 E4) s))
    (refl (move w1 w2 E1 s)) w3 E2 ;
  move-back (w w' : Tm.Pres B) (E : Id (Tm.Pres B) w w') (s : Tm.Pd[B,w].Sol) :
   Id Tm.Pd[B,w].Sol (move w' w (Pr.sym (Tm.Pres B) w w' E) (move w w' E s)) s =
   idJ (Tm.Pres B) w (\ w2 E2 -> Id Tm.Pd[B,w].Sol (move w2 w (Pr.sym (Tm.Pres B) w w2 E2) (move w w2 E2 s)) s)
    (refl s) w' E ;
  move-fwd (w w' : Tm.Pres B) (E : Id (Tm.Pres B) w w') (s : Tm.Pd[B,w'].Sol) :
   Id Tm.Pd[B,w'].Sol (move w w' E (move w' w (Pr.sym (Tm.Pres B) w w' E) s)) s =
   idJ (Tm.Pres B) w (\ w2 E2 -> (s2 : Tm.Pd[B,w2].Sol) -> Id Tm.Pd[B,w2].Sol (move w w2 E2 (move w2 w (Pr.sym (Tm.Pres B) w w2 E2) s2)) s2)
    (\ s2 -> refl s2) w' E s ;
  moveEq (w w' : Tm.Pres B) (E : Id (Tm.Pres B) w w') : Pr.Equiv Tm.Pd[B,w].Sol Tm.Pd[B,w'].Sol =
   (move w w' E,Pr.qinv Tm.Pd[B,w].Sol Tm.Pd[B,w'].Sol (move w w' E) (move w' w (Pr.sym (Tm.Pres B) w w' E))
     (move-fwd w w' E) (move-back w w' E)) ;
  first (w w' : Tm.Pres B) (E : Id (Tm.Pres B) w w') (s : Tm.Pd[B,w].Sol) :
   Id (Fun w'.1) (vals w' (move w w' E s))
    (Pr.subst Nat Fun w.1 w'.1 (Pr.ap (Tm.Pres B) Nat (\ z -> z.1) w w' E) s.1) =
   idJ (Tm.Pres B) w (\ w2 E2 -> Id (Fun w2.1) (vals w2 (move w w2 E2 s))
     (Pr.subst Nat Fun w.1 w2.1 (Pr.ap (Tm.Pres B) Nat (\ z -> z.1) w w2 E2) s.1))
    (refl s.1) w' E ;
  loop (n : Nat) (L : Id Nat n n) (f : Fun n) : Id (Fun n) (Pr.subst Nat Fun n n L f) f =
   Pr.ap (Id Nat n n) (Fun n) (\ M -> Pr.subst Nat Fun n n M f) L (refl n) (nat-set n n L (refl n)) ;
  value-subst (n : Nat) (es1 es2 : PB.Equations (Presentations[l].Fin n))
   (E : Id (Tm.Pres B) (n,es1) (n,es2)) (s : Tm.Pd[B,(n,es1)].Sol) (v : Presentations[l].Fin n) :
   Id B.ring.R (vals (n,es2) (move (n,es1) (n,es2) E s) v) (s.1 v) =
   Pr.ap (Fun n) B.ring.R (\ f -> f v) _ _
    (Pr.trans (Fun n) _ _ s.1 (first (n,es1) (n,es2) E s)
     (loop n (Pr.ap (Tm.Pres B) Nat (\ z -> z.1) (n,es1) (n,es2) E) s.1)) ;
 } ;
 -- moving a solution along a path commutes with Moves.sol
 move-sol (A B : Alg.Algebra) (h : Alg.Hom A B) (w0 w : Tm.Pres A) (e : Id (Tm.Pres A) w0 w) (s : Tm.Pd[A,w0].Sol) :
  Id Tm.Pd[B,Tm.change A B h w].Sol (Tm.Moves[A,B,h,w].sol (Vals[A].move w0 w e s))
   (Vals[B].move (Tm.change A B h w0) (Tm.change A B h w) (Pr.ap (Tm.Pres A) (Tm.Pres B) (Tm.change A B h) w0 w e)
     (Tm.Moves[A,B,h,w0].sol s)) =
  idJ (Tm.Pres A) w0 (\ w2 e2 -> Id Tm.Pd[B,Tm.change A B h w2].Sol (Tm.Moves[A,B,h,w2].sol (Vals[A].move w0 w2 e2 s))
    (Vals[B].move (Tm.change A B h w0) (Tm.change A B h w2) (Pr.ap (Tm.Pres A) (Tm.Pres B) (Tm.change A B h) w0 w2 e2)
      (Tm.Moves[A,B,h,w0].sol s)))
   (refl (Tm.Moves[A,B,h,w0].sol s)) w e ;
 module SolPath (A B : Alg.Algebra) (u : Tm.Pres A) {
  Sols : U l = (h : Alg.Hom A B) * Tm.Pd[B,Tm.change A B h u].Sol ;
  sol-path (h h' : Alg.Hom A B) (e : Id (Alg.Hom A B) h h')
   (a : Tm.Pd[B,Tm.change A B h u].Sol) (b : Tm.Pd[B,Tm.change A B h' u].Sol)
   (pt : (v : Presentations[l].Fin u.1) -> Id B.ring.R (a.1 v) (b.1 v)) : Id Sols (h,a) (h',b) =
   idJ (Alg.Hom A B) h (\ h2 e2 -> (b2 : Tm.Pd[B,Tm.change A B h2 u].Sol)
     -> ((v : Presentations[l].Fin u.1) -> Id B.ring.R (a.1 v) (b2.1 v)) -> Id Sols (h,a) (h2,b2))
    (\ b2 pt2 -> Pr.ap (Tm.Pd[B,Tm.change A B h u].Sol) Sols (\ c -> (h,c)) a b2
      (Tm.Pd[B,Tm.change A B h u].Pt.PB.solutions-ext (Tm.change A B h u) Tm.Pd[B,Tm.change A B h u].Pt.self a b2 pt2))
    h' e b pt ;
 } ;
} ;
