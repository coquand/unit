-- Core.seg: the heart of Theorem 62 in the model (DUALITY.md Tier 4,
-- jonas.pdf proof of Theorem 62, bottom row q_u . p_u+ ~ id).
--
-- At a point g of G0 at x, with u = prs g, O = obj u (the object of
-- C for <u>) and p_O : O -> x:
--   q_g : the element of Sp at g p_O whose solution is sol0, the
--         generators of <u> read in alg O through objIso;
--   K   : fib Br x g -> alg O, b |-> G(ev(q_g , restriction of b to O)).
-- Theorem: K b = objIso (brE b), so K is an equivalence.
--
-- Informal proof.  By the clause ev-clause, K b is the universal map of
-- the solution spE q_g applied to brE (b restricted).  Both spE q_g and
-- brE (b restricted) are transports along the same path
-- prs g p_O = u.h_O (spE's section, brE-nat); evaluation is invariant
-- under transporting solution and element along one path (J).  So
-- K b = point sol0 (h_O+ (brE b)).  Finally, point sol0 . h_O+ and
-- objIso are maps of A-algebras X_u -> alg O agreeing on the
-- generators (up-gen; the defining property of the universal map), so
-- they are equal: this is q_u . p_u+ = id read through objIso.
level l k ;
constraint l <= k ;
open Ring[l] ;
module Pr = Prelude[l] ;
module E = Equivalences[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module Alg = Algebras[l].Over[R,setR] ;
 module Tm = T3[l,k].Over[R,setR] ;
 -- evaluation at a solution is invariant under transport along a path of
 -- presentations
 point-subst (B : Alg.Algebra) (w w' : Tm.Pres B) (e : Id (Tm.Pres B) w w')
  (s : Tm.Pd[B,w].Sol) (b : Tm.Pd[B,w].Car) :
  Id B.ring.R
   (Tm.Pd[B,w'].point (Pr.subst (Tm.Pres B) (\ z -> Tm.Pd[B,z].Sol) w w' e s)
     (Pr.subst (Tm.Pres B) (\ z -> Tm.Pd[B,z].Car) w w' e b))
   (Tm.Pd[B,w].point s b) =
  idJ (Tm.Pres B) w (\ w2 e2 -> Id B.ring.R
    (Tm.Pd[B,w2].point (Pr.subst (Tm.Pres B) (\ z -> Tm.Pd[B,z].Sol) w w2 e2 s)
      (Pr.subst (Tm.Pres B) (\ z -> Tm.Pd[B,z].Car) w w2 e2 b))
    (Tm.Pd[B,w].point s b))
   (refl (Tm.Pd[B,w].point s b)) w' e ;
 module At (C : T2[l,k].PCwF) (S : T2[l,k].Site[C]) (T : Tm.T3[C,S]) (x : S.Ob) (g : C.Sub (S.yo x) T.G0) {
  module DR = T2[l,k].Der[C] ;
  module Pt = DR.Pts[S] ;
  A : Alg.Algebra = T.alg x ;
  u : Tm.Pres A = T.prs x g ;
  O : S.Ob = T.obj x u ;
  pO : S.Hom O x = T.objHom x u ;
  AO : Alg.Algebra = T.alg O ;
  hO : Alg.Hom A AO = T.homAlg O x pO ;
  gO : C.Sub (S.yo O) T.G0 = Tm.Rf[C,S,T.G0,T.Sp].at O x pO g ;
  w0 : Tm.Pres AO = Tm.change A AO hO u ;
  -- the path prs (g p_O) = u.h_O, reversed
  e : Id (Tm.Pres AO) w0 (T.prs O gO) = Pr.sym (Tm.Pres AO) (T.prs O gO) w0 (T.prs-nat O x pO g) ;
  module Pu = Tm.Pd[A,u] ;
  module P0 = Tm.Pd[AO,w0] ;
  module Ch = Relative[l].Along[A.ring,A.set,AO.ring,AO.set,hO.1] ;
  -- objIso as a map of A-algebras X_u -> alg O (restricted along h_O)
  iso' : Algebras[l].Over[A.ring,A.set].Hom Pu.X (Ch.restrict P0.Pt.self) =
   ((T.objIso x u).1,\ a -> Pr.sym AO.ring.R _ _ (T.objHom-p x u a)) ;
  -- the generators of <u> in alg O: the solution behind q_u
  sol0 : P0.Sol =
   Ch.solutions-up u P0.Pt.self
    (Presentations[l].Over[A.ring,A.set].canonical u Pu.X Pu.px.1 (Ch.restrict P0.Pt.self) iso') ;
  qg : Pt.fib T.G0 T.Sp O gO =
   (T.spE O gO).2.sec (Pr.subst (Tm.Pres AO) (\ z -> Tm.Pd[AO,z].Sol) w0 (T.prs O gO) e sol0) ;
  -- the fibre composite of Theorem 62 at this point
  K (b : Pt.fib T.G0 T.Br x g) : AO.ring.R =
   (T.gE O gO).1 (DR.trE (S.yo O) _ _ (DR.wkp (S.yo O) T.G0 T.Sp T.Gt gO qg)
     (Pt.onFib (C.ext T.G0 T.Sp) (C.subT (C.ext T.G0 T.Sp) T.G0 T.Br (C.p T.G0 T.Sp))
       (C.subT (C.ext T.G0 T.Sp) T.G0 T.Gt (C.p T.G0 T.Sp))
       T.ev O (C.pair (S.yo O) T.G0 T.Sp gO qg)
       (DR.trE (S.yo O) _ _ (Prelude[k].sym (C.Ty (S.yo O)) _ _ (DR.wkp (S.yo O) T.G0 T.Sp T.Br gO qg))
         (Tm.Rf[C,S,T.G0,T.Br].res O x pO g b)))) ;
  -- step 1: the clause, then the two transports
  K-point (b : Pt.fib T.G0 T.Br x g) :
   Id AO.ring.R (K b) (P0.point sol0 (Tm.Moves[A,AO,hO,u].up ((T.brE x g).1 b))) =
   trans (T.ev-clause O gO qg (Tm.Rf[C,S,T.G0,T.Br].res O x pO g b))
    (trans (ap (\ s -> Tm.Pd[AO,T.prs O gO].point s ((T.brE O gO).1 (Tm.Rf[C,S,T.G0,T.Br].res O x pO g b)))
       ((T.spE O gO).2.sec-eq (Pr.subst (Tm.Pres AO) (\ z -> Tm.Pd[AO,z].Sol) w0 (T.prs O gO) e sol0)))
     (trans (ap (Tm.Pd[AO,T.prs O gO].point (Pr.subst (Tm.Pres AO) (\ z -> Tm.Pd[AO,z].Sol) w0 (T.prs O gO) e sol0))
        (T.brE-nat O x pO g b))
      (point-subst AO w0 (T.prs O gO) e sol0 (Tm.Moves[A,AO,hO,u].up ((T.brE x g).1 b))))) ;
  -- step 2: q_u . p_u+ = id, read through objIso
  module Sq = Tm.Moves[A,AO,hO,u].Sq ;
  -- the universal map of sol0, as a map of A0-algebras out of X_{u.h_O}
  qmap : Algebras[l].Over[AO.ring,AO.set].Hom P0.X P0.Pt.self = (P0.px.2 P0.Pt.self).sec sol0 ;
  K-iso (y : Pu.Car) : Id AO.ring.R (P0.point sol0 (Tm.Moves[A,AO,hO,u].up y)) ((T.objIso x u).1.1 y) =
   ap (\ m -> m.1.1 y)
    (Tensor[l].Over[A.ring,A.set].hom-eq u Pu.X Pu.px (Ch.restrict P0.Pt.self)
     (RingHom[l].compose Pu.X.ring P0.X.ring AO.ring qmap.1 Sq.up.1,
      \ a -> trans (ap qmap.1.1 (Sq.agree a)) (qmap.2 (hO.1.1 a)))
     iso'
     (\ v -> trans (ap qmap.1.1 (Sq.up-gen v))
       (ap (\ s -> s.1 v) ((P0.px.2 P0.Pt.self).sec-eq sol0)))) ;
  K-eq (b : Pt.fib T.G0 T.Br x g) : Id AO.ring.R (K b) ((T.objIso x u).1.1 ((T.brE x g).1 b)) =
   trans (K-point b) (K-iso ((T.brE x g).1 b)) ;
  -- objIso is an equivalence of carriers
  objIso-equiv : Pr.Equiv Pu.Car AO.ring.R =
   ((T.objIso x u).1.1,Pr.qinv Pu.Car AO.ring.R (T.objIso x u).1.1 (T.objInv x u).1.1 (T.objInv-r x u) (T.objInv-l x u)) ;
  -- Theorem 62 at this point: the fibre composite is an equivalence
  K-equiv : Pr.isEquiv (Pt.fib T.G0 T.Br x g) AO.ring.R K =
   E.homotopy (Pt.fib T.G0 T.Br x g) AO.ring.R
    (E.compose (Pt.fib T.G0 T.Br x g) Pu.Car AO.ring.R (T.brE x g) objIso-equiv) K K-eq ;
 } ;
} ;
