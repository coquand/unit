-- Equivalences of Sigma types (after sag/hcat/SigmaEquiv.seg, the two
-- lemmas used by Prop 58): change of base along an equivalence, by
-- induction on equivalences (univalence), and fibrewise equivalences.
level l ;
module Pl = Prelude[l] ;
module UL = Axioms[l].UnivalenceLemmas[univ @l] ;
change-of-base-map (A B : U l) (P : B -> U l) (f : A -> B) (w : (a : A) * P (f a)) : (b : B) * P b = (f w.1,w.2) ;
change-of-base (A B : U l) (P : B -> U l) (e : Pl.Equiv A B) :
 Pl.Equiv ((a : A) * P (e.1 a)) ((b : B) * P b) =
 (change-of-base-map A B P e.1,
  UL.eqind A (\ B1 e1 -> (P1 : B1 -> U l) -> Pl.isEquiv ((a : A) * P1 (e1.1 a)) ((b : B1) * P1 b) (change-of-base-map A B1 P1 e1.1))
   (\ P1 -> Pl.qinv ((a : A) * P1 a) ((b : A) * P1 b) (change-of-base-map A A P1 (\ a -> a)) (\ w -> w)
     (\ w -> refl w) (\ w -> refl w))
   B e P) ;
fibrewise (A : U l) (P Q : A -> U l) (e : (a : A) -> Pl.Equiv (P a) (Q a)) :
 Pl.Equiv ((a : A) * P a) ((a : A) * Q a) =
 (\ w -> (w.1,(e w.1).1 w.2),
  Pl.qinv ((a : A) * P a) ((a : A) * Q a) (\ w -> (w.1,(e w.1).1 w.2)) (\ w -> (w.1,(e w.1).2.sec w.2))
   (\ w -> Pl.ap (Q w.1) ((a : A) * Q a) (\ v -> (w.1,v)) _ _ ((e w.1).2.sec-eq w.2))
   (\ w -> Pl.ap (P w.1) ((a : A) * P a) (\ v -> (w.1,v)) _ _ (Pl.sec-ret (P w.1) (Q w.1) (e w.1).1 (e w.1).2 w.2))) ;
