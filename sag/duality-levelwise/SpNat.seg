-- SpNat.seg (canonicity-45): P3.5's spE-nat, the naturality of the fibre
-- of Sp as solutions (spE of SpFromModel.Derive), from SpF and PModF.
--
-- Informal proof (u = prs x g, g' = g.f, h = homAlg f, E = prs-nat).
-- (1) ev is natural: for c in Sp and b in Br at (x , g), ev at the
--     restricted pair is the restriction of ev at (c , b): postAt
--     commutes with restriction (OnFibNat.postNat), the point (g , c).f
--     is (g' , c.f) (pairO), and the arguments are transports of each
--     other (TE, teAny).
-- (2) Hence, through ev-link, resA-eq and gE-nat, for every beta in
--     brAlg x g: evH_y (res c) (resA beta) = h (evH_x c beta).
-- (3) Moved along E, spE_y (res c) has values evH_y (res c) at the moved
--     generators, which are resA of the generators (res-gen); by (2)
--     these are h of the values of spE_x c, i.e. Moves.sol.
-- Premises: SpF, PModF, S39; S2.1 (through TE / teAny).  No new ones.
level l k ;
constraint l+ <= k ;
open Base ;
open Prelude[k] ;

module Over (R : Ring[l].CRing) (setR : Prelude[l].isSet R.R) {
 module O = T3[l,k].Over[R,setR] ;
 module Alg = Algebras[l].Over[R,setR] ;
 module BM = BrFromModel[l,k].Over[R,setR] ;
 module SM = SpFromModel[l,k].Over[R,setR] ;

 module N (C : T2[l,k].PCwF) (S : T2[l,k].Site[C]) (alg : S.Ob -> Alg.Algebra)
  (homAlg : (y x : S.Ob) -> S.Hom y x -> Alg.Hom (alg x) (alg y)) (P : BM.S39[C,S,alg,homAlg])
  (PM : BM.PModF[C,S,alg,homAlg,P]) (F : SM.SpF[C,S,alg,homAlg,P,PM]) {
  module DR = T2[l,k].Der[C] ;
  module Pt = DR.Pts[S] ;
  module TX = TE[l,k].TEm[C] ;
  module PN = OnFibNat[l,k].PN[C] ;
  module Dv = SM.Derive[C,S,alg,homAlg,P,PM,F] ;

  GS : C.Ctx = C.ext P.G0 F.Sp ;
  Bt : C.Ty GS = C.subT GS P.G0 PM.Br (C.p P.G0 F.Sp) ;
  Gp : C.Ty GS = C.subT GS P.G0 F.Gt (C.p P.G0 F.Sp) ;

  -- b moved to the pair (g , c)
  bP (x : S.Ob) (g : C.Sub (S.yo x) P.G0) (c : Pt.fib P.G0 F.Sp x g) (b : Pt.fib P.G0 PM.Br x g)
   : C.El (S.yo x) (C.subT (S.yo x) GS Bt (C.pair (S.yo x) P.G0 F.Sp g c)) =
   DR.trE (S.yo x) (C.subT (S.yo x) P.G0 PM.Br g) (C.subT (S.yo x) GS Bt (C.pair (S.yo x) P.G0 F.Sp g c))
    (sym (C.Ty (S.yo x)) (C.subT (S.yo x) GS Bt (C.pair (S.yo x) P.G0 F.Sp g c)) (C.subT (S.yo x) P.G0 PM.Br g) (DR.wkp (S.yo x) P.G0 F.Sp PM.Br g c)) b ;

  -- ev at (c , b), in the fibre of G
  EV (x : S.Ob) (g : C.Sub (S.yo x) P.G0) (c : Pt.fib P.G0 F.Sp x g) (b : Pt.fib P.G0 PM.Br x g) : Pt.fib P.G0 F.Gt x g =
   DR.trE (S.yo x) (C.subT (S.yo x) GS Gp (C.pair (S.yo x) P.G0 F.Sp g c)) (C.subT (S.yo x) P.G0 F.Gt g) (DR.wkp (S.yo x) P.G0 F.Sp F.Gt g c)
    (DR.postAt (S.yo x) GS Bt Gp F.ev (C.pair (S.yo x) P.G0 F.Sp g c) (bP x g c b)) ;

  -- postAt along a path of points, at TE-related arguments
  postPath (D G : C.Ctx) (A B : C.Ty G) (m : DR.Map G A B) (s s' : C.Sub D G) (e : Id (C.Sub D G) s s')
   (a : C.El D (C.subT D G A s)) (a' : C.El D (C.subT D G A s')) (h : TX.TE D (C.subT D G A s) (C.subT D G A s') a a')
   : TX.TE D (C.subT D G B s) (C.subT D G B s') (DR.postAt D G A B m s a) (DR.postAt D G A B m s' a') =
   idJ (C.Sub D G) s (\ s2 e2 -> (a2 : C.El D (C.subT D G A s2)) -> TX.TE D (C.subT D G A s) (C.subT D G A s2) a a2
                           -> TX.TE D (C.subT D G B s) (C.subT D G B s2) (DR.postAt D G A B m s a) (DR.postAt D G A B m s2 a2))
    (\ a2 h2 -> TX.teR D (C.subT D G B s) (DR.postAt D G A B m s a) (DR.postAt D G A B m s a2)
       (ap (C.El D (C.subT D G A s)) (C.El D (C.subT D G B s)) (DR.postAt D G A B m s) a a2
          (TX.teAny D (C.subT D G A s) (C.subT D G A s) a a2 h2 (refl (C.subT D G A s)))))
    s' e a' h ;

  module Nt (y x : S.Ob) (f : S.Hom y x) (g : C.Sub (S.yo x) P.G0) {
   module RS = O.Rf[C,S,P.G0,F.Sp] ;
   module RB = O.Rf[C,S,P.G0,PM.Br] ;
   module RG = O.Rf[C,S,P.G0,F.Gt] ;
   t : C.Sub (S.yo y) (S.yo x) = S.yoH y x f ;
   g' : C.Sub (S.yo y) P.G0 = C.o (S.yo y) (S.yo x) P.G0 g t ;

   module E (c : Pt.fib P.G0 F.Sp x g) (b : Pt.fib P.G0 PM.Br x g) {
    sg : C.Sub (S.yo x) GS = C.pair (S.yo x) P.G0 F.Sp g c ;
    sg' : C.Sub (S.yo y) GS = C.pair (S.yo y) P.G0 F.Sp g' (RS.res y x f g c) ;
    b1 : C.El (S.yo x) (C.subT (S.yo x) GS Bt sg) = bP x g c b ;
    b2 : C.El (S.yo y) (C.subT (S.yo y) GS Bt sg') = bP y g' (RS.res y x f g c) (RB.res y x f g b) ;
    -- the arguments: b1 restricted ~ b2
    argTE : TX.TE (S.yo y) (C.subT (S.yo y) GS Bt (C.o (S.yo y) (S.yo x) GS sg t)) (C.subT (S.yo y) GS Bt sg')
      (PN.aT (S.yo y) (S.yo x) GS Bt sg t b1) b2 =
     TX.teT (S.yo y) (C.subT (S.yo y) GS Bt (C.o (S.yo y) (S.yo x) GS sg t)) (C.subT (S.yo y) (S.yo x) (C.subT (S.yo x) GS Bt sg) t) (C.subT (S.yo y) GS Bt sg')
      (PN.aT (S.yo y) (S.yo x) GS Bt sg t b1) (C.subt (S.yo y) (S.yo x) (C.subT (S.yo x) GS Bt sg) b1 t) b2
      (TX.teS (S.yo y) (C.subT (S.yo y) (S.yo x) (C.subT (S.yo x) GS Bt sg) t) (C.subT (S.yo y) GS Bt (C.o (S.yo y) (S.yo x) GS sg t))
         (C.subt (S.yo y) (S.yo x) (C.subT (S.yo x) GS Bt sg) b1 t) (PN.aT (S.yo y) (S.yo x) GS Bt sg t b1)
         (TX.teTr (S.yo y) (C.subT (S.yo y) (S.yo x) (C.subT (S.yo x) GS Bt sg) t) (C.subT (S.yo y) GS Bt (C.o (S.yo y) (S.yo x) GS sg t))
            (sym (C.Ty (S.yo y)) (C.subT (S.yo y) GS Bt (C.o (S.yo y) (S.yo x) GS sg t)) (C.subT (S.yo y) (S.yo x) (C.subT (S.yo x) GS Bt sg) t)
               (C.subT-o (S.yo y) (S.yo x) GS Bt sg t))
            (C.subt (S.yo y) (S.yo x) (C.subT (S.yo x) GS Bt sg) b1 t)))
      (TX.teT (S.yo y) (C.subT (S.yo y) (S.yo x) (C.subT (S.yo x) GS Bt sg) t) (C.subT (S.yo y) (S.yo x) (C.subT (S.yo x) P.G0 PM.Br g) t) (C.subT (S.yo y) GS Bt sg')
        (C.subt (S.yo y) (S.yo x) (C.subT (S.yo x) GS Bt sg) b1 t) (C.subt (S.yo y) (S.yo x) (C.subT (S.yo x) P.G0 PM.Br g) b t) b2
        (TX.teSub (S.yo y) (S.yo x) t (C.subT (S.yo x) GS Bt sg) (C.subT (S.yo x) P.G0 PM.Br g) b1 b
           (TX.teS (S.yo x) (C.subT (S.yo x) P.G0 PM.Br g) (C.subT (S.yo x) GS Bt sg) b b1
              (TX.teTr (S.yo x) (C.subT (S.yo x) P.G0 PM.Br g) (C.subT (S.yo x) GS Bt sg)
                 (sym (C.Ty (S.yo x)) (C.subT (S.yo x) GS Bt sg) (C.subT (S.yo x) P.G0 PM.Br g) (DR.wkp (S.yo x) P.G0 F.Sp PM.Br g c)) b)))
        (TX.teT (S.yo y) (C.subT (S.yo y) (S.yo x) (C.subT (S.yo x) P.G0 PM.Br g) t) (C.subT (S.yo y) P.G0 PM.Br g') (C.subT (S.yo y) GS Bt sg')
          (C.subt (S.yo y) (S.yo x) (C.subT (S.yo x) P.G0 PM.Br g) b t) (RB.res y x f g b) b2
          (TX.teTr (S.yo y) (C.subT (S.yo y) (S.yo x) (C.subT (S.yo x) P.G0 PM.Br g) t) (C.subT (S.yo y) P.G0 PM.Br g')
             (sym (C.Ty (S.yo y)) (C.subT (S.yo y) P.G0 PM.Br g') (C.subT (S.yo y) (S.yo x) (C.subT (S.yo x) P.G0 PM.Br g) t)
                (C.subT-o (S.yo y) (S.yo x) P.G0 PM.Br g t))
             (C.subt (S.yo y) (S.yo x) (C.subT (S.yo x) P.G0 PM.Br g) b t))
          (TX.teTr (S.yo y) (C.subT (S.yo y) P.G0 PM.Br g') (C.subT (S.yo y) GS Bt sg')
             (sym (C.Ty (S.yo y)) (C.subT (S.yo y) GS Bt sg') (C.subT (S.yo y) P.G0 PM.Br g') (DR.wkp (S.yo y) P.G0 F.Sp PM.Br g' (RS.res y x f g c)))
             (RB.res y x f g b)))) ;
    -- (1) ev is natural
    evTE : TX.TE (S.yo y) (C.subT (S.yo y) (S.yo x) (C.subT (S.yo x) P.G0 F.Gt g) t) (C.subT (S.yo y) P.G0 F.Gt g')
      (C.subt (S.yo y) (S.yo x) (C.subT (S.yo x) P.G0 F.Gt g) (EV x g c b) t) (EV y g' (RS.res y x f g c) (RB.res y x f g b)) =
     TX.teT (S.yo y) (C.subT (S.yo y) (S.yo x) (C.subT (S.yo x) P.G0 F.Gt g) t) (C.subT (S.yo y) (S.yo x) (C.subT (S.yo x) GS Gp sg) t) (C.subT (S.yo y) P.G0 F.Gt g')
      (C.subt (S.yo y) (S.yo x) (C.subT (S.yo x) P.G0 F.Gt g) (EV x g c b) t)
      (C.subt (S.yo y) (S.yo x) (C.subT (S.yo x) GS Gp sg) (DR.postAt (S.yo x) GS Bt Gp F.ev sg b1) t)
      (EV y g' (RS.res y x f g c) (RB.res y x f g b))
      (TX.teSub (S.yo y) (S.yo x) t (C.subT (S.yo x) P.G0 F.Gt g) (C.subT (S.yo x) GS Gp sg) (EV x g c b) (DR.postAt (S.yo x) GS Bt Gp F.ev sg b1)
         (TX.teS (S.yo x) (C.subT (S.yo x) GS Gp sg) (C.subT (S.yo x) P.G0 F.Gt g) (DR.postAt (S.yo x) GS Bt Gp F.ev sg b1) (EV x g c b)
            (TX.teTr (S.yo x) (C.subT (S.yo x) GS Gp sg) (C.subT (S.yo x) P.G0 F.Gt g) (DR.wkp (S.yo x) P.G0 F.Sp F.Gt g c) (DR.postAt (S.yo x) GS Bt Gp F.ev sg b1))))
      (TX.teT (S.yo y) (C.subT (S.yo y) (S.yo x) (C.subT (S.yo x) GS Gp sg) t) (C.subT (S.yo y) GS Gp (C.o (S.yo y) (S.yo x) GS sg t)) (C.subT (S.yo y) P.G0 F.Gt g')
        (C.subt (S.yo y) (S.yo x) (C.subT (S.yo x) GS Gp sg) (DR.postAt (S.yo x) GS Bt Gp F.ev sg b1) t)
        (DR.postAt (S.yo y) GS Bt Gp F.ev (C.o (S.yo y) (S.yo x) GS sg t) (PN.aT (S.yo y) (S.yo x) GS Bt sg t b1))
        (EV y g' (RS.res y x f g c) (RB.res y x f g b))
        (PN.postNat (S.yo y) (S.yo x) GS Bt Gp F.ev sg t b1)
        (TX.teT (S.yo y) (C.subT (S.yo y) GS Gp (C.o (S.yo y) (S.yo x) GS sg t)) (C.subT (S.yo y) GS Gp sg') (C.subT (S.yo y) P.G0 F.Gt g')
          (DR.postAt (S.yo y) GS Bt Gp F.ev (C.o (S.yo y) (S.yo x) GS sg t) (PN.aT (S.yo y) (S.yo x) GS Bt sg t b1))
          (DR.postAt (S.yo y) GS Bt Gp F.ev sg' b2)
          (EV y g' (RS.res y x f g c) (RB.res y x f g b))
          (postPath (S.yo y) GS Bt Gp F.ev (C.o (S.yo y) (S.yo x) GS sg t) sg' (PN.pairO (S.yo y) (S.yo x) P.G0 F.Sp g t c)
             (PN.aT (S.yo y) (S.yo x) GS Bt sg t b1) b2 argTE)
          (TX.teTr (S.yo y) (C.subT (S.yo y) GS Gp sg') (C.subT (S.yo y) P.G0 F.Gt g')
             (DR.wkp (S.yo y) P.G0 F.Sp F.Gt g' (RS.res y x f g c)) (DR.postAt (S.yo y) GS Bt Gp F.ev sg' b2)))) ;
    evNat : Id (Pt.fib P.G0 F.Gt y g') (RG.res y x f g (EV x g c b)) (EV y g' (RS.res y x f g c) (RB.res y x f g b)) =
     TX.teAny (S.yo y) (C.subT (S.yo y) (S.yo x) (C.subT (S.yo x) P.G0 F.Gt g) t) (C.subT (S.yo y) P.G0 F.Gt g')
      (C.subt (S.yo y) (S.yo x) (C.subT (S.yo x) P.G0 F.Gt g) (EV x g c b) t) (EV y g' (RS.res y x f g c) (RB.res y x f g b)) evTE
      (sym (C.Ty (S.yo y)) (C.subT (S.yo y) P.G0 F.Gt g') (C.subT (S.yo y) (S.yo x) (C.subT (S.yo x) P.G0 F.Gt g) t)
         (C.subT-o (S.yo y) (S.yo x) P.G0 F.Gt g t)) ;
   } ;


   -- (2) evaluation commutes with restriction, on brAlg
   module Ax = Dv.At[x,g] ;
   module Ay = Dv.At[y,g'] ;
   hh : Alg.Hom (alg x) (alg y) = homAlg y x f ;
   claim (c : Pt.fib P.G0 F.Sp x g) (b : Pt.fib P.G0 PM.Br x g)
    : Id (alg y).ring.R ((Ay.evH ((F.spH y g').1 (RS.res y x f g c))).1.1 ((PM.resA y x f g).1.1 ((PM.brC x g).1 b)))
       (hh.1.1 ((Ax.evH ((F.spH x g).1 c)).1.1 ((PM.brC x g).1 b))) =
    Prelude[l].trans (alg y).ring.R
     ((Ay.evH ((F.spH y g').1 (RS.res y x f g c))).1.1 ((PM.resA y x f g).1.1 ((PM.brC x g).1 b)))
     ((Ay.evH ((F.spH y g').1 (RS.res y x f g c))).1.1 ((PM.brC y g').1 (RB.res y x f g b)))
     (hh.1.1 ((Ax.evH ((F.spH x g).1 c)).1.1 ((PM.brC x g).1 b)))
     (Prelude[l].ap (PM.brAlg y g').ring.R (alg y).ring.R (Ay.evH ((F.spH y g').1 (RS.res y x f g c))).1.1 _ _ (PM.resA-eq y x f g b))
     (Prelude[l].trans (alg y).ring.R
        ((Ay.evH ((F.spH y g').1 (RS.res y x f g c))).1.1 ((PM.brC y g').1 (RB.res y x f g b)))
        ((F.gE y g').1 (EV y g' (RS.res y x f g c) (RB.res y x f g b)))
        (hh.1.1 ((Ax.evH ((F.spH x g).1 c)).1.1 ((PM.brC x g).1 b)))
        (Prelude[l].sym (alg y).ring.R ((F.gE y g').1 (EV y g' (RS.res y x f g c) (RB.res y x f g b))) _
           (F.ev-link y g' (RS.res y x f g c) (RB.res y x f g b)))
        (Prelude[l].trans (alg y).ring.R
           ((F.gE y g').1 (EV y g' (RS.res y x f g c) (RB.res y x f g b)))
           ((F.gE y g').1 (RG.res y x f g (EV x g c b)))
           (hh.1.1 ((Ax.evH ((F.spH x g).1 c)).1.1 ((PM.brC x g).1 b)))
           (Prelude[l].ap (Pt.fib P.G0 F.Gt y g') (alg y).ring.R (F.gE y g').1 _ _
              (Prelude[l].sym (Pt.fib P.G0 F.Gt y g') (RG.res y x f g (EV x g c b)) (EV y g' (RS.res y x f g c) (RB.res y x f g b)) E[c,b].evNat))
           (Prelude[l].trans (alg y).ring.R
              ((F.gE y g').1 (RG.res y x f g (EV x g c b)))
              (hh.1.1 ((F.gE x g).1 (EV x g c b)))
              (hh.1.1 ((Ax.evH ((F.spH x g).1 c)).1.1 ((PM.brC x g).1 b)))
              (F.gE-nat y x f g (EV x g c b))
              (Prelude[l].ap (alg x).ring.R (alg y).ring.R hh.1.1 _ _ (F.ev-link x g c b))))) ;
   claimG (c : Pt.fib P.G0 F.Sp x g) (z : (PM.brAlg x g).ring.R)
    : Id (alg y).ring.R ((Ay.evH ((F.spH y g').1 (RS.res y x f g c))).1.1 ((PM.resA y x f g).1.1 z))
       (hh.1.1 ((Ax.evH ((F.spH x g).1 c)).1.1 z)) =
    Prelude[l].trans (alg y).ring.R
     ((Ay.evH ((F.spH y g').1 (RS.res y x f g c))).1.1 ((PM.resA y x f g).1.1 z))
     ((Ay.evH ((F.spH y g').1 (RS.res y x f g c))).1.1 ((PM.resA y x f g).1.1 ((PM.brC x g).1 ((PM.brC x g).2.sec z))))
     (hh.1.1 ((Ax.evH ((F.spH x g).1 c)).1.1 z))
     (Prelude[l].ap (PM.brAlg x g).ring.R (alg y).ring.R (\ w -> (Ay.evH ((F.spH y g').1 (RS.res y x f g c))).1.1 ((PM.resA y x f g).1.1 w)) _ _
        (Prelude[l].sym (PM.brAlg x g).ring.R ((PM.brC x g).1 ((PM.brC x g).2.sec z)) z ((PM.brC x g).2.sec-eq z)))
     (Prelude[l].trans (alg y).ring.R
        ((Ay.evH ((F.spH y g').1 (RS.res y x f g c))).1.1 ((PM.resA y x f g).1.1 ((PM.brC x g).1 ((PM.brC x g).2.sec z))))
        (hh.1.1 ((Ax.evH ((F.spH x g).1 c)).1.1 ((PM.brC x g).1 ((PM.brC x g).2.sec z))))
        (hh.1.1 ((Ax.evH ((F.spH x g).1 c)).1.1 z))
        (claim c ((PM.brC x g).2.sec z))
        (Prelude[l].ap (PM.brAlg x g).ring.R (alg y).ring.R (\ w -> hh.1.1 ((Ax.evH ((F.spH x g).1 c)).1.1 w)) _ _ ((PM.brC x g).2.sec-eq z))) ;

   -- (3) spE-nat
   u : O.Pres (alg x) = P.prs x g ;
   u' : O.Pres (alg y) = P.prs y g' ;
   ch : O.Pres (alg y) = O.change (alg x) (alg y) hh u ;
   pi : Id (O.Pres (alg y)) u' ch = P.prs-nat y x f g ;
   module Mv = O.Moves[alg x,alg y,hh,u] ;
   module PKy = Presentations[l].Over[(alg y).ring,(alg y).set] ;
   lhs (c : Pt.fib P.G0 F.Sp x g) : O.Pd[alg y,u'].Sol = Ay.spE (RS.res y x f g c) ;
   moved (c : Pt.fib P.G0 F.Sp x g) : Id O.Pd[alg y,ch].Sol
     (Prelude[l].subst (O.Pres (alg y)) (\ w -> O.Pd[alg y,w].Sol) u' ch pi (lhs c)) (Mv.sol (Ax.spE c)) =
    PKy.solutions-ext ch Ay.self _ _ (\ v ->
     Prelude[l].trans (alg y).ring.R
      ((Prelude[l].subst (O.Pres (alg y)) (\ w -> O.Pd[alg y,w].Sol) u' ch pi (lhs c)).1 v)
      ((Ay.evH ((F.spH y g').1 (RS.res y x f g c))).1.1
         ((Prelude[l].subst (O.Pres (alg y)) (\ w -> PKy.Solutions w (PM.brAlg y g')) u' ch pi (PM.brGen y g')).1 v))
      ((Mv.sol (Ax.spE c)).1 v)
      (Prelude[l].ap (PKy.Solutions ch Ay.self) (alg y).ring.R (\ s2 -> s2.1 v) _ _
         (BM.PL[alg y].natSub (PM.brAlg y g') Ay.self (Ay.evH ((F.spH y g').1 (RS.res y x f g c))) u' ch pi (PM.brGen y g')))
      (Prelude[l].trans (alg y).ring.R
         ((Ay.evH ((F.spH y g').1 (RS.res y x f g c))).1.1
            ((Prelude[l].subst (O.Pres (alg y)) (\ w -> PKy.Solutions w (PM.brAlg y g')) u' ch pi (PM.brGen y g')).1 v))
         ((Ay.evH ((F.spH y g').1 (RS.res y x f g c))).1.1 ((PM.resA y x f g).1.1 ((PM.brGen x g).1 v)))
         ((Mv.sol (Ax.spE c)).1 v)
         (Prelude[l].ap (PM.brAlg y g').ring.R (alg y).ring.R (Ay.evH ((F.spH y g').1 (RS.res y x f g c))).1.1 _ _
            (Prelude[l].sym (PM.brAlg y g').ring.R _ _ (PM.res-gen y x f g v)))
         (claimG c ((PM.brGen x g).1 v)))) ;
   back (w w' : O.Pres (alg y)) (E2 : Id (O.Pres (alg y)) w w') (z : O.Pd[alg y,w].Sol)
    : Id O.Pd[alg y,w].Sol (Prelude[l].subst (O.Pres (alg y)) (\ w2 -> O.Pd[alg y,w2].Sol) w' w (Prelude[l].sym (O.Pres (alg y)) w w' E2)
        (Prelude[l].subst (O.Pres (alg y)) (\ w2 -> O.Pd[alg y,w2].Sol) w w' E2 z)) z =
    idJ (O.Pres (alg y)) w (\ w3 E3 -> Id O.Pd[alg y,w].Sol (Prelude[l].subst (O.Pres (alg y)) (\ w2 -> O.Pd[alg y,w2].Sol) w3 w (Prelude[l].sym (O.Pres (alg y)) w w3 E3)
        (Prelude[l].subst (O.Pres (alg y)) (\ w2 -> O.Pd[alg y,w2].Sol) w w3 E3 z)) z)
     (refl z) w' E2 ;
   spE-nat (c : Pt.fib P.G0 F.Sp x g)
    : Id O.Pd[alg y,u'].Sol (lhs c)
       (Prelude[l].subst (O.Pres (alg y)) (\ w -> O.Pd[alg y,w].Sol) ch u' (Prelude[l].sym (O.Pres (alg y)) u' ch pi) (Mv.sol (Ax.spE c))) =
    Prelude[l].trans O.Pd[alg y,u'].Sol (lhs c)
     (Prelude[l].subst (O.Pres (alg y)) (\ w -> O.Pd[alg y,w].Sol) ch u' (Prelude[l].sym (O.Pres (alg y)) u' ch pi)
        (Prelude[l].subst (O.Pres (alg y)) (\ w -> O.Pd[alg y,w].Sol) u' ch pi (lhs c)))
     (Prelude[l].subst (O.Pres (alg y)) (\ w -> O.Pd[alg y,w].Sol) ch u' (Prelude[l].sym (O.Pres (alg y)) u' ch pi) (Mv.sol (Ax.spE c)))
     (Prelude[l].sym O.Pd[alg y,u'].Sol _ (lhs c) (back u' ch pi (lhs c)))
     (Prelude[l].ap O.Pd[alg y,ch].Sol O.Pd[alg y,u'].Sol
        (Prelude[l].subst (O.Pres (alg y)) (\ w -> O.Pd[alg y,w].Sol) ch u' (Prelude[l].sym (O.Pres (alg y)) u' ch pi)) _ _ (moved c)) ;
  } ;

  -- T3's spE-nat (with spE := Dv.At[x,g].spE)
  spE-nat (y x : S.Ob) (f : S.Hom y x) (g : C.Sub (S.yo x) P.G0) (c : Pt.fib P.G0 F.Sp x g) :
   Id O.Pd[alg y,P.prs y (O.Rf[C,S,P.G0,F.Sp].at y x f g)].Sol
    (Dv.At[y,O.Rf[C,S,P.G0,F.Sp].at y x f g].spE (O.Rf[C,S,P.G0,F.Sp].res y x f g c))
    (Prelude[l].subst (O.Pres (alg y)) (\ w -> O.Pd[alg y,w].Sol)
      (O.change (alg x) (alg y) (homAlg y x f) (P.prs x g)) (P.prs y (O.Rf[C,S,P.G0,F.Sp].at y x f g))
      (Prelude[l].sym (O.Pres (alg y)) _ _ (P.prs-nat y x f g))
      (O.Moves[alg x,alg y,homAlg y x f,P.prs x g].sol (Dv.At[x,g].spE c))) = Nt[y,x,f,g].spE-nat c ;
 } ;
} ;
