-- OnFibNat.seg (canonicity-45): the action of a map of types on elements
-- commutes with restriction.  For m : A -> B over G, s : D -> G,
-- t : T -> D and a : A[s] over D,
--   postAt m s a, restricted along t  ~  postAt m (s t) (a restricted),
-- up to the transport along subT-o (a TE).  At points (T3's Rf):
--   onFib-nat : res (onFib m a) = onFib m (res a).
-- Informal proof: postAt m s a is m restricted along the pair (s , a);
-- restricting along t gives m along (s , a) . t (subt-o), and
-- (s , a) . t = (s t , a[t]) by subExt (both parts agree: pO, p-pair;
-- qvO, qvPair).  Only S2.1 (through TE and teAny).
level l k ;
constraint l <= k ;
open Base ;
open Prelude[k] ;

module PN (C : T2[l,k].PCwF) {
 module DR = T2[l,k].Der[C] ;
 module TX = TE[l,k].TEm[C] ;

 -- a restricted along t, read over s t
 aT (T D G : C.Ctx) (A : C.Ty G) (s : C.Sub D G) (t : C.Sub T D) (a : C.El D (C.subT D G A s))
  : C.El T (C.subT T G A (C.o T D G s t)) =
  DR.trE T (C.subT T D (C.subT D G A s) t) (C.subT T G A (C.o T D G s t))
   (sym (C.Ty T) (C.subT T G A (C.o T D G s t)) (C.subT T D (C.subT D G A s) t) (C.subT-o T D G A s t))
   (C.subt T D (C.subT D G A s) a t) ;

 -- (s , a) . t = (s t , a[t])
 pairO (T D G : C.Ctx) (A : C.Ty G) (s : C.Sub D G) (t : C.Sub T D) (a : C.El D (C.subT D G A s))
  : Id (C.Sub T (C.ext G A)) (C.o T D (C.ext G A) (C.pair D G A s a) t) (C.pair T G A (C.o T D G s t) (aT T D G A s t a)) =
  TX.subExt T G A (C.o T D (C.ext G A) (C.pair D G A s a) t) (C.pair T G A (C.o T D G s t) (aT T D G A s t a))
   (trans (C.Sub T G) (C.o T (C.ext G A) G (C.p G A) (C.o T D (C.ext G A) (C.pair D G A s a) t))
      (C.o T D G (C.o D (C.ext G A) G (C.p G A) (C.pair D G A s a)) t)
      (C.o T (C.ext G A) G (C.p G A) (C.pair T G A (C.o T D G s t) (aT T D G A s t a)))
      (TX.pO T D G A (C.pair D G A s a) t)
      (trans (C.Sub T G) (C.o T D G (C.o D (C.ext G A) G (C.p G A) (C.pair D G A s a)) t) (C.o T D G s t)
         (C.o T (C.ext G A) G (C.p G A) (C.pair T G A (C.o T D G s t) (aT T D G A s t a)))
         (ap (C.Sub D G) (C.Sub T G) (\ r -> C.o T D G r t) (C.o D (C.ext G A) G (C.p G A) (C.pair D G A s a)) s (C.p-pair D G A s a))
         (sym (C.Sub T G) (C.o T (C.ext G A) G (C.p G A) (C.pair T G A (C.o T D G s t) (aT T D G A s t a))) (C.o T D G s t)
            (C.p-pair T G A (C.o T D G s t) (aT T D G A s t a)))))
   (TX.teT T (C.subT T G A (C.o T (C.ext G A) G (C.p G A) (C.o T D (C.ext G A) (C.pair D G A s a) t)))
       (C.subT T D (C.subT D G A (C.o D (C.ext G A) G (C.p G A) (C.pair D G A s a))) t)
       (C.subT T G A (C.o T (C.ext G A) G (C.p G A) (C.pair T G A (C.o T D G s t) (aT T D G A s t a))))
       (TX.qv T G A (C.o T D (C.ext G A) (C.pair D G A s a) t))
       (C.subt T D (C.subT D G A (C.o D (C.ext G A) G (C.p G A) (C.pair D G A s a))) (TX.qv D G A (C.pair D G A s a)) t)
       (TX.qv T G A (C.pair T G A (C.o T D G s t) (aT T D G A s t a)))
     (TX.qvO T D G A (C.pair D G A s a) t)
     (TX.teT T (C.subT T D (C.subT D G A (C.o D (C.ext G A) G (C.p G A) (C.pair D G A s a))) t)
         (C.subT T D (C.subT D G A s) t)
         (C.subT T G A (C.o T (C.ext G A) G (C.p G A) (C.pair T G A (C.o T D G s t) (aT T D G A s t a))))
         (C.subt T D (C.subT D G A (C.o D (C.ext G A) G (C.p G A) (C.pair D G A s a))) (TX.qv D G A (C.pair D G A s a)) t)
         (C.subt T D (C.subT D G A s) a t)
         (TX.qv T G A (C.pair T G A (C.o T D G s t) (aT T D G A s t a)))
       (TX.teSub T D t (C.subT D G A (C.o D (C.ext G A) G (C.p G A) (C.pair D G A s a))) (C.subT D G A s)
          (TX.qv D G A (C.pair D G A s a)) a (TX.qvPair D G A s a))
       (TX.teT T (C.subT T D (C.subT D G A s) t) (C.subT T G A (C.o T D G s t))
           (C.subT T G A (C.o T (C.ext G A) G (C.p G A) (C.pair T G A (C.o T D G s t) (aT T D G A s t a))))
           (C.subt T D (C.subT D G A s) a t) (aT T D G A s t a)
           (TX.qv T G A (C.pair T G A (C.o T D G s t) (aT T D G A s t a)))
         (TX.teTr T (C.subT T D (C.subT D G A s) t) (C.subT T G A (C.o T D G s t))
            (sym (C.Ty T) (C.subT T G A (C.o T D G s t)) (C.subT T D (C.subT D G A s) t) (C.subT-o T D G A s t))
            (C.subt T D (C.subT D G A s) a t))
         (TX.teS T (C.subT T G A (C.o T (C.ext G A) G (C.p G A) (C.pair T G A (C.o T D G s t) (aT T D G A s t a))))
            (C.subT T G A (C.o T D G s t))
            (TX.qv T G A (C.pair T G A (C.o T D G s t) (aT T D G A s t a))) (aT T D G A s t a)
            (TX.qvPair T G A (C.o T D G s t) (aT T D G A s t a)))))) ;

 -- postAt commutes with restriction, up to transport
 postNat (T D G : C.Ctx) (A B : C.Ty G) (m : DR.Map G A B) (s : C.Sub D G) (t : C.Sub T D) (a : C.El D (C.subT D G A s))
  : TX.TE T (C.subT T D (C.subT D G B s) t) (C.subT T G B (C.o T D G s t))
     (C.subt T D (C.subT D G B s) (DR.postAt D G A B m s a) t) (DR.postAt T G A B m (C.o T D G s t) (aT T D G A s t a)) =
  TX.teT T (C.subT T D (C.subT D G B s) t) (C.subT T D (C.subT D (C.ext G A) Bp (C.pair D G A s a)) t) (C.subT T G B (C.o T D G s t))
    (C.subt T D (C.subT D G B s) (DR.postAt D G A B m s a) t) (C.subt T D (C.subT D (C.ext G A) Bp (C.pair D G A s a)) (C.subt D (C.ext G A) Bp m (C.pair D G A s a)) t)
    (DR.postAt T G A B m (C.o T D G s t) (aT T D G A s t a))
   (TX.teSub T D t (C.subT D G B s) (C.subT D (C.ext G A) Bp (C.pair D G A s a)) (DR.postAt D G A B m s a) (C.subt D (C.ext G A) Bp m (C.pair D G A s a))
      (TX.teS D (C.subT D (C.ext G A) Bp (C.pair D G A s a)) (C.subT D G B s) (C.subt D (C.ext G A) Bp m (C.pair D G A s a)) (DR.postAt D G A B m s a)
         (TX.teTr D (C.subT D (C.ext G A) Bp (C.pair D G A s a)) (C.subT D G B s) (DR.wkp D G A B s a) (C.subt D (C.ext G A) Bp m (C.pair D G A s a)))))
   (TX.teT T (C.subT T D (C.subT D (C.ext G A) Bp (C.pair D G A s a)) t) (C.subT T (C.ext G A) Bp (C.o T D (C.ext G A) (C.pair D G A s a) t)) (C.subT T G B (C.o T D G s t))
      (C.subt T D (C.subT D (C.ext G A) Bp (C.pair D G A s a)) (C.subt D (C.ext G A) Bp m (C.pair D G A s a)) t)
      (C.subt T (C.ext G A) Bp m (C.o T D (C.ext G A) (C.pair D G A s a) t))
      (DR.postAt T G A B m (C.o T D G s t) (aT T D G A s t a))
     (TX.teS T (C.subT T (C.ext G A) Bp (C.o T D (C.ext G A) (C.pair D G A s a) t)) (C.subT T D (C.subT D (C.ext G A) Bp (C.pair D G A s a)) t)
        (C.subt T (C.ext G A) Bp m (C.o T D (C.ext G A) (C.pair D G A s a) t))
        (C.subt T D (C.subT D (C.ext G A) Bp (C.pair D G A s a)) (C.subt D (C.ext G A) Bp m (C.pair D G A s a)) t)
        (C.subT-o T D (C.ext G A) Bp (C.pair D G A s a) t, C.subt-o T D (C.ext G A) Bp m (C.pair D G A s a) t))
     (TX.teT T (C.subT T (C.ext G A) Bp (C.o T D (C.ext G A) (C.pair D G A s a) t)) (C.subT T (C.ext G A) Bp (C.pair T G A (C.o T D G s t) (aT T D G A s t a)))
         (C.subT T G B (C.o T D G s t))
         (C.subt T (C.ext G A) Bp m (C.o T D (C.ext G A) (C.pair D G A s a) t))
         (C.subt T (C.ext G A) Bp m (C.pair T G A (C.o T D G s t) (aT T D G A s t a)))
         (DR.postAt T G A B m (C.o T D G s t) (aT T D G A s t a))
       (TX.teApS T (C.ext G A) Bp (C.o T D (C.ext G A) (C.pair D G A s a) t) (C.pair T G A (C.o T D G s t) (aT T D G A s t a)) (pairO T D G A s t a) m)
       (TX.teTr T (C.subT T (C.ext G A) Bp (C.pair T G A (C.o T D G s t) (aT T D G A s t a))) (C.subT T G B (C.o T D G s t))
          (DR.wkp T G A B (C.o T D G s t) (aT T D G A s t a)) (C.subt T (C.ext G A) Bp m (C.pair T G A (C.o T D G s t) (aT T D G A s t a))))))
  where { Bp : C.Ty (C.ext G A) = C.subT (C.ext G A) G B (C.p G A) ; } ;

 -- at points: onFib commutes with T3's restriction of fibres
 module At (S : T2[l,k].Site[C]) {
  module Pt = DR.Pts[S] ;
  onFib-nat (G : C.Ctx) (A B : C.Ty G) (m : DR.Map G A B) (y x : S.Ob) (f : S.Hom y x) (g : C.Sub (S.yo x) G)
   (a : Pt.fib G A x g)
   : Id (Pt.fib G B y (C.o (S.yo y) (S.yo x) G g (S.yoH y x f)))
      (DR.trE (S.yo y) (C.subT (S.yo y) (S.yo x) (C.subT (S.yo x) G B g) (S.yoH y x f)) (C.subT (S.yo y) G B (C.o (S.yo y) (S.yo x) G g (S.yoH y x f)))
         (sym (C.Ty (S.yo y)) (C.subT (S.yo y) G B (C.o (S.yo y) (S.yo x) G g (S.yoH y x f)))
            (C.subT (S.yo y) (S.yo x) (C.subT (S.yo x) G B g) (S.yoH y x f)) (C.subT-o (S.yo y) (S.yo x) G B g (S.yoH y x f)))
         (C.subt (S.yo y) (S.yo x) (C.subT (S.yo x) G B g) (Pt.onFib G A B m x g a) (S.yoH y x f)))
      (Pt.onFib G A B m y (C.o (S.yo y) (S.yo x) G g (S.yoH y x f)) (aT (S.yo y) (S.yo x) G A g (S.yoH y x f) a)) =
   TX.teAny (S.yo y) (C.subT (S.yo y) (S.yo x) (C.subT (S.yo x) G B g) (S.yoH y x f)) (C.subT (S.yo y) G B (C.o (S.yo y) (S.yo x) G g (S.yoH y x f)))
    (C.subt (S.yo y) (S.yo x) (C.subT (S.yo x) G B g) (Pt.onFib G A B m x g a) (S.yoH y x f))
    (Pt.onFib G A B m y (C.o (S.yo y) (S.yo x) G g (S.yoH y x f)) (aT (S.yo y) (S.yo x) G A g (S.yoH y x f) a))
    (postNat (S.yo y) (S.yo x) G A B m g (S.yoH y x f) a)
    (sym (C.Ty (S.yo y)) (C.subT (S.yo y) G B (C.o (S.yo y) (S.yo x) G g (S.yoH y x f)))
       (C.subT (S.yo y) (S.yo x) (C.subT (S.yo x) G B g) (S.yoH y x f)) (C.subT-o (S.yo y) (S.yo x) G B g (S.yoH y x f))) ;
 } ;
} ;

-- in T3's notation (Rf.res, Rf.at): restriction commutes with onFib
module Over (R : Ring[l].CRing) (setR : Prelude[l].isSet R.R) (C : T2[l,k].PCwF) (S : T2[l,k].Site[C]) {
 module O = T3[l,k].Over[R,setR] ;
 module Pt = T2[l,k].Der[C].Pts[S] ;
 onFib-nat (G : C.Ctx) (A B : C.Ty G) (m : T2[l,k].Der[C].Map G A B) (y x : S.Ob) (f : S.Hom y x) (g : C.Sub (S.yo x) G)
  (a : Pt.fib G A x g)
  : Id (Pt.fib G B y (O.Rf[C,S,G,B].at y x f g))
     (O.Rf[C,S,G,B].res y x f g (Pt.onFib G A B m x g a))
     (Pt.onFib G A B m y (O.Rf[C,S,G,A].at y x f g) (O.Rf[C,S,G,A].res y x f g a)) =
  PN[C].At[S].onFib-nat G A B m y x f g a ;
} ;
