-- Functors of points on the finitely presented algebras (DESIGN.md §7).
-- C = FPImage.SFI.pre: objects a (with algebra A_a = inclusion a), arrows
-- Hom_R (A_a, A_b).  For a covariant set-valued functor F,
--   Nat (h_a, F) ~ F a                (evaluation at 1, Yoneda)
-- with h_a b = Hom_R (A_a, A_b) (points, by definition), and
--   Nat (h_a, h_b) ~ Hom_R (A_b, A_a)  (affine representables),
-- the inverse being precomposition: the representable embedding is fully
-- faithful with source (Alg_R^fp)^op (Yoneda.yon-idn, yon-comp).  All
-- these types lie in U l, the object type being small.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module FI = FPImage[l].Over[R,setR] ;
 module Y = Yoneda[l].Over[FI.SFI.pre] ;
 -- the functor of points of a: h_a b = Hom_R (A_a, A_b), by definition
 points (a b : FI.SFI.image.carrier) :
  Id (U l) ((Y.rep a).obj b) (C.Hom (FI.SFI.image.inclusion a) (FI.SFI.image.inclusion b)) =
  refl (C.Hom (FI.SFI.image.inclusion a) (FI.SFI.image.inclusion b)) ;
 yoneda (a : FI.SFI.image.carrier) (F : Y.SetFunctor) : Pr.Equiv (Y.SetNat[Y.rep a, F].Nat) (F.obj a) =
  Y.Yoneda[a,F].yoneda ;
 affine (a b : FI.SFI.image.carrier) :
  Pr.Equiv (Y.SetNat[Y.rep a, Y.rep b].Nat) (C.Hom (FI.SFI.image.inclusion b) (FI.SFI.image.inclusion a)) =
  Y.Yoneda[a, Y.rep b].yoneda ;
 fully-faithful (a b : FI.SFI.image.carrier) :
  Pr.isEquiv (C.Hom (FI.SFI.image.inclusion b) (FI.SFI.image.inclusion a)) (Y.SetNat[Y.rep a, Y.rep b].Nat)
   (Y.Embedding[a,b].yon) = Y.Embedding[a,b].fully-faithful ;
} ;
