-- The precategory of R-algebras and algebra maps, and its isomorphisms
-- (DESIGN.md §1, §2).  Objects Algebras.Algebra (U l+), arrows
-- Algebras.Hom (U l), identity and composition from Algebras.
--  hom-set: ring maps into a set form a set, Commutes is a proposition.
--  compose-fun, identity-fun: the carrier maps, by definition.
--  unit-l, unit-r, assoc: pointwise refl, by ext.
--  Inverse (Lemma 2.1): f with f0 an equivalence, g0 its section:
--   g0 1 = g0 (f0 1) = 1; g0 (b + b') = g0 (f0 (g0 b) + f0 (g0 b'))
--   = g0 (f0 (g0 b + g0 b')) = g0 b + g0 b' (and for products);
--   g0 (iota_B r) = g0 (f0 (iota_A r)) = iota_A r.  g o f = 1 and
--   f o g = 1 pointwise (sec-ret, sec-eq), so (f, g) is an iso.
--  carrier-equiv (Lemma 2.2): the two identities of an iso, evaluated at
--   a point, make g0 an inverse of f0.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;
module CC = Category[l+,l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 -- the parts of an algebra map
 fun {A B : C.Algebra} (f : C.Hom A B) : A.ring.R -> B.ring.R = f.1.1 ;
 one-law {A B : C.Algebra} (f : C.Hom A B) : Id B.ring.R (fun f A.ring.o) B.ring.o = f.1.2.1 ;
 add-law {A B : C.Algebra} (f : C.Hom A B) (a a' : A.ring.R) :
  Id B.ring.R (fun f (A.ring.add a a')) (B.ring.add (fun f a) (fun f a')) = f.1.2.2.1 a a' ;
 mul-law {A B : C.Algebra} (f : C.Hom A B) (a a' : A.ring.R) :
  Id B.ring.R (fun f (A.ring.mul a a')) (B.ring.mul (fun f a) (fun f a')) = f.1.2.2.2 a a' ;
 commutes {A B : C.Algebra} (f : C.Hom A B) (r : R.R) : Id B.ring.R (fun f (A.iota.1 r)) (B.iota.1 r) = f.2 r ;

 hom-set (A B : C.Algebra) : Pr.isSet (C.Hom A B) =
  Pr.isSet-Sigma (H.Hom A.ring B.ring) (C.Commutes A B) (H.Properties[A.ring,B.ring,B.set].set)
   (\ h -> Pr.prop-to-set (C.Commutes A B h) (C.commutes-prop A B h)) ;
 -- by definition
 compose-fun (A B D : C.Algebra) (g : C.Hom B D) (f : C.Hom A B) (a : A.ring.R) :
  Id D.ring.R (fun (C.compose A B D g f) a) (fun g (fun f a)) = refl (fun g (fun f a)) ;
 identity-fun (A : C.Algebra) (a : A.ring.R) : Id A.ring.R (fun (C.identity A) a) a = refl a ;

 unit-l (A B : C.Algebra) (f : C.Hom A B) : Id (C.Hom A B) (C.compose A B B (C.identity B) f) f =
  C.ext A B (C.compose A B B (C.identity B) f) f (\ a -> refl (fun f a)) ;
 unit-r (A B : C.Algebra) (f : C.Hom A B) : Id (C.Hom A B) (C.compose A A B f (C.identity A)) f =
  C.ext A B (C.compose A A B f (C.identity A)) f (\ a -> refl (fun f a)) ;
 assoc (W A B D : C.Algebra) (f : C.Hom W A) (g : C.Hom A B) (h : C.Hom B D) :
  Id (C.Hom W D) (C.compose W B D h (C.compose W A B g f)) (C.compose W A D (C.compose A B D h g) f) =
  C.ext W D (C.compose W B D h (C.compose W A B g f)) (C.compose W A D (C.compose A B D h g) f)
   (\ a -> refl (fun h (fun g (fun f a)))) ;
 pre : CC.Precategory = new CC.Precategory[C.Algebra, C.Hom, hom-set, C.identity, C.compose,
  unit-l, unit-r, assoc] ;
 module AP = Arrows[l+,l].Arrows[pre] ;

 -- Lemma 2.1: an algebra map whose carrier map is an equivalence is an iso
 module Inverse (A B : C.Algebra) (f : C.Hom A B) (e : Pr.isEquiv A.ring.R B.ring.R (fun f)) {
  g0 (b : B.ring.R) : A.ring.R = e.sec b ;
  back (a : A.ring.R) : Id A.ring.R (g0 (fun f a)) a = Pr.sec-ret A.ring.R B.ring.R (fun f) e a ;
  forth (b : B.ring.R) : Id B.ring.R (fun f (g0 b)) b = e.sec-eq b ;
  one : Id A.ring.R (g0 B.ring.o) A.ring.o = trans (ap g0 (sym (one-law f))) (back A.ring.o) ;
  add (b b' : B.ring.R) : Id A.ring.R (g0 (B.ring.add b b')) (A.ring.add (g0 b) (g0 b')) =
   trans (ap g0 (Presentations[l].cong2 B.ring.R B.ring.add _ _ _ _ (sym (forth b)) (sym (forth b'))))
    (trans (ap g0 (sym (add-law f (g0 b) (g0 b')))) (back (A.ring.add (g0 b) (g0 b')))) ;
  mul (b b' : B.ring.R) : Id A.ring.R (g0 (B.ring.mul b b')) (A.ring.mul (g0 b) (g0 b')) =
   trans (ap g0 (Presentations[l].cong2 B.ring.R B.ring.mul _ _ _ _ (sym (forth b)) (sym (forth b'))))
    (trans (ap g0 (sym (mul-law f (g0 b) (g0 b')))) (back (A.ring.mul (g0 b) (g0 b')))) ;
  constants (r : R.R) : Id A.ring.R (g0 (B.iota.1 r)) (A.iota.1 r) =
   trans (ap g0 (sym (commutes f r))) (back (A.iota.1 r)) ;
  inverse : C.Hom B A = ((g0, one, add, mul), constants) ;
  left : Id (C.Hom A A) (C.compose A B A inverse f) (C.identity A) =
   C.ext A A (C.compose A B A inverse f) (C.identity A) back ;
  right : Id (C.Hom B B) (C.compose B A B f inverse) (C.identity B) =
   C.ext B B (C.compose B A B f inverse) (C.identity B) forth ;
  iso : pre.Iso A B = (f, inverse, left, right) ;
 } ;

 -- Lemma 2.2: the carrier map of an iso is an equivalence
 carrier-equiv {A B : C.Algebra} (i : pre.Iso A B) : Pr.isEquiv A.ring.R B.ring.R (fun {A} {B} (AP.arr i)) =
  Pr.qinv A.ring.R B.ring.R (fun {A} {B} (AP.arr i)) (fun {B} {A} (AP.inv i))
   (\ b -> trans (sym (compose-fun B A B (AP.arr i) (AP.inv i) b))
     (trans (ap (\ h -> fun {B} {B} h b) (AP.arr-inv i)) (identity-fun B b)))
   (\ a -> trans (sym (compose-fun A B A (AP.inv i) (AP.arr i) a))
     (trans (ap (\ h -> fun {A} {A} h a) (AP.inv-arr i)) (identity-fun A a))) ;
} ;
