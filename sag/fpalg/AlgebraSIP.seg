-- Univalence of the category of R-algebras (DESIGN.md §3, §4).
--
-- The notion of algebra structure on X (SipGeneric): data a point z, a
-- point o, binary + and ., a unary -, a map c : R -> X; axioms X a set,
-- the eight CRing laws, c preserves 1, + and . (propositions over a set).
-- Two pieces are local: unop (e (s x) = t (e x)) and map-from K
-- (e (s k) = t k); for both the structures with the identity a
-- homomorphism from s are the singleton of pointwise paths (hsing).
-- fields A reads an Algebra as a structure; mk builds one; mk (fields A)
-- is A by definition after splitting A and A.ring (record eta, in back).
--
-- Correspondence (§3).  For e : A0 ~ B0, the notion's Iota e says that e
-- preserves z, o, +, ., - and commutes with c; the Hom structure on e0
-- (Structure: RingHom.Preserves and Commutes) says that e0 preserves o, +,
-- . and commutes with iota.  iota-to-structure forgets z and -;
-- structure-to-iota recovers them by RingHom.zero (f 0 = f 0 + f 0, then
-- cancel) and RingHom.negation (inverses are unique).  Both sides are
-- propositions (B0 a set; structure-prop), so this is a logical
-- equivalence of propositions.
--
-- Univalence (§4).  Singl A = (B : Algebra) * Iso A B is a retract of the
-- total space (B : Str) * Iso_N (fields A) B, contractible by SipGeneric:
--  s (B, i) = (fields B, (f0, Lemma 2.2), structure-to-iota f), f = arr i;
--  r (B', (e, t)) = (mk B', Lemma 2.1 at the map (e0, iota-to-structure t));
--  r (s (B, i)) = (B, i): after record eta the first component is B, the
--  rebuilt arrow has carrier f0, so it is arr i by ext, and an iso is
--  determined by its arrow (iso-eq).
-- So every Singl A is a proposition, and FromTotal gives univalence.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module CH = FunExtUA[l+] ;
module H = RingHom[l] ;
module G = SipGeneric[l] ;
module CC = Category[l+,l] ;

-- a unary operation
unop : G.Notion = struct {
 S = \ X -> X -> X ;
 Iota = \ X Y s t e -> (x : X) -> Id Y (e.1 (s x)) (t (e.1 x)) ;
 rho = \ X s x -> refl (s x) ;
 unit = \ X s -> G.hsing X X s
} ;
-- a map from a fixed type K
map-from (K : U l) : G.Notion = struct {
 S = \ X -> K -> X ;
 Iota = \ X Y s t e -> (k : K) -> Id Y (e.1 (s k)) (t k) ;
 rho = \ X s k -> refl (s k) ;
 unit = \ X s -> G.hsing K X s
} ;

-- being a set is a proposition
set-prop (X : U l) : Pr.isProp (Pr.isSet X) =
 F.isProp-Pi X (\ x -> (y : X) -> Pr.isProp (Id X x y))
  (\ x -> F.isProp-Pi X (\ y -> Pr.isProp (Id X x y)) (\ y -> F.isProp-isProp (Id X x y))) ;
prod (X Y : U l) (pX : Pr.isProp X) (pY : Pr.isProp Y) : Pr.isProp (X * Y) =
 Pr.isProp-Sigma X (\ u -> Y) pX (\ u -> pY) ;
-- equations in a set, under one, two or three quantifiers
module Eqs (X : U l) (s : Pr.isSet X) {
 p1 (A : U l) (f g : A -> X) : Pr.isProp ((a : A) -> Id X (f a) (g a)) =
  F.isProp-Pi A (\ a -> Id X (f a) (g a)) (\ a -> s (f a) (g a)) ;
 p2 (A B : U l) (f g : A -> B -> X) : Pr.isProp ((a : A) (b : B) -> Id X (f a b) (g a b)) =
  F.isProp-Pi A (\ a -> (b : B) -> Id X (f a b) (g a b)) (\ a -> p1 B (f a) (g a)) ;
 p3 (A : U l) (f g : A -> A -> A -> X) : Pr.isProp ((a b w : A) -> Id X (f a b w) (g a b w)) =
  F.isProp-Pi A (\ a -> (b w : A) -> Id X (f a b w) (g a b w)) (\ a -> p2 A A (f a) (g a)) ;
} ;

module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module AC = AlgebraCategory[l].Over[R,setR] ;
 module AP = Arrows[l+,l].Arrows[AC.pre] ;

 -- the data
 Data : G.Notion = G.join G.point (G.join G.point (G.join G.binop (G.join G.binop (G.join unop (map-from R.R))))) ;
 module Ops (X : U l) (d : Data.S X) {
  z : X = d.1 ;
  o : X = d.2.1 ;
  ad : X -> X -> X = d.2.2.1 ;
  mu : X -> X -> X = d.2.2.2.1 ;
  ne : X -> X = d.2.2.2.2.1 ;
  co : R.R -> X = d.2.2.2.2.2 ;
  RingLaws : U l =
   ((x y w : X) -> Id X (ad x (ad y w)) (ad (ad x y) w)) *
   ((x y : X) -> Id X (ad x y) (ad y x)) *
   ((x : X) -> Id X (ad x z) x) *
   ((x : X) -> Id X (ad x (ne x)) z) *
   ((x y w : X) -> Id X (mu x (mu y w)) (mu (mu x y) w)) *
   ((x y : X) -> Id X (mu x y) (mu y x)) *
   ((x : X) -> Id X (mu x o) x) *
   ((x y w : X) -> Id X (mu x (ad y w)) (ad (mu x y) (mu x w))) ;
  ConstLaws : U l =
   Id X (co R.o) o *
   ((a b : R.R) -> Id X (co (R.add a b)) (ad (co a) (co b))) *
   ((a b : R.R) -> Id X (co (R.mul a b)) (mu (co a) (co b))) ;
  module P (s : Pr.isSet X) {
   module E = Eqs[X,s] ;
   ring-prop : Pr.isProp RingLaws =
    prod _ _ (E.p3 X (\ x y w -> ad x (ad y w)) (\ x y w -> ad (ad x y) w))
    (prod _ _ (E.p2 X X (\ x y -> ad x y) (\ x y -> ad y x))
    (prod _ _ (E.p1 X (\ x -> ad x z) (\ x -> x))
    (prod _ _ (E.p1 X (\ x -> ad x (ne x)) (\ x -> z))
    (prod _ _ (E.p3 X (\ x y w -> mu x (mu y w)) (\ x y w -> mu (mu x y) w))
    (prod _ _ (E.p2 X X (\ x y -> mu x y) (\ x y -> mu y x))
    (prod _ _ (E.p1 X (\ x -> mu x o) (\ x -> x))
     (E.p3 X (\ x y w -> mu x (ad y w)) (\ x y w -> ad (mu x y) (mu x w))))))))) ;
   const-prop : Pr.isProp ConstLaws =
    prod _ _ (s (co R.o) o)
    (prod _ _ (E.p2 R.R R.R (\ a b -> co (R.add a b)) (\ a b -> ad (co a) (co b)))
     (E.p2 R.R R.R (\ a b -> co (R.mul a b)) (\ a b -> mu (co a) (co b)))) ;
  } ;
 } ;
 -- the axioms, a proposition
 Ax (X : U l) (d : Data.S X) : U l = (s : Pr.isSet X) * Ops[X,d].RingLaws * Ops[X,d].ConstLaws ;
 ax-prop (X : U l) (d : Data.S X) : Pr.isProp (Ax X d) =
  Pr.isProp-Sigma (Pr.isSet X) (\ s -> Ops[X,d].RingLaws * Ops[X,d].ConstLaws) (set-prop X)
   (\ s -> prod _ _ Ops[X,d].P[s].ring-prop Ops[X,d].P[s].const-prop) ;
 N : G.Notion = G.axioms Data Ax ax-prop ;
 module S = G.Over[N] ;

 -- an Algebra is a structure
 fields (A : C.Algebra) : S.Str =
  (A.ring.R, ((A.ring.z, A.ring.o, A.ring.add, A.ring.mul, A.ring.neg, A.iota.1),
   (A.set, (A.ring.addA, A.ring.addC, A.ring.addZ, A.ring.addN, A.ring.mulA, A.ring.mulC, A.ring.mulO, A.ring.dist),
    A.iota.2))) ;
 module Pj (B : S.Str) {
  module O = Ops[B.1,B.2.1] ;
  set : Pr.isSet B.1 = B.2.2.1 ;
  rl : O.RingLaws = B.2.2.2.1 ;
  cl : O.ConstLaws = B.2.2.2.2 ;
  ring : CRing = mkCRing B.1 O.z O.o O.ad O.mu O.ne rl.1 rl.2.1 rl.2.2.1 rl.2.2.2.1
   rl.2.2.2.2.1 rl.2.2.2.2.2.1 rl.2.2.2.2.2.2.1 rl.2.2.2.2.2.2.2 ;
  algebra : C.Algebra = C.mkAlgebra ring set (O.co, cl) ;
 } ;
 mk (B : S.Str) : C.Algebra = Pj[B].algebra ;

 -- §3: the notion's homomorphism predicate and the Hom structure
 Iota (A B : C.Algebra) (e : Pr.Equiv A.ring.R B.ring.R) : U l = N.Iota A.ring.R B.ring.R (fields A).2 (fields B).2 e ;
 module Parts (A B : C.Algebra) (e : Pr.Equiv A.ring.R B.ring.R) (i : Iota A B e) {
  zero : Id B.ring.R (e.1 A.ring.z) B.ring.z = i.1 ;
  one : Id B.ring.R (e.1 A.ring.o) B.ring.o = i.2.1 ;
  add (a a' : A.ring.R) : Id B.ring.R (e.1 (A.ring.add a a')) (B.ring.add (e.1 a) (e.1 a')) = i.2.2.1 a a' ;
  mul (a a' : A.ring.R) : Id B.ring.R (e.1 (A.ring.mul a a')) (B.ring.mul (e.1 a) (e.1 a')) = i.2.2.2.1 a a' ;
  neg (a : A.ring.R) : Id B.ring.R (e.1 (A.ring.neg a)) (B.ring.neg (e.1 a)) = i.2.2.2.2.1 a ;
  consts (r : R.R) : Id B.ring.R (e.1 (A.iota.1 r)) (B.iota.1 r) = i.2.2.2.2.2 r ;
 } ;
 Structure (A B : C.Algebra) (f0 : A.ring.R -> B.ring.R) : U l =
  (p : H.Preserves A.ring B.ring f0) * C.Commutes A B (f0, p) ;
 structure-prop (A B : C.Algebra) (f0 : A.ring.R -> B.ring.R) : Pr.isProp (Structure A B f0) =
  Pr.isProp-Sigma (H.Preserves A.ring B.ring f0) (\ p -> C.Commutes A B (f0, p))
   (H.Properties[A.ring,B.ring,B.set].prop f0) (\ p -> C.commutes-prop A B (f0, p)) ;
 iota-to-structure (A B : C.Algebra) (e : Pr.Equiv A.ring.R B.ring.R) (i : Iota A B e) : Structure A B e.1 =
  ((Parts[A,B,e,i].one, Parts[A,B,e,i].add, Parts[A,B,e,i].mul), Parts[A,B,e,i].consts) ;
 structure-to-iota (A B : C.Algebra) (e : Pr.Equiv A.ring.R B.ring.R) (h : Structure A B e.1) : Iota A B e =
  (H.zero A.ring B.ring (e.1, h.1), h.1.1, h.1.2.1, h.1.2.2, H.negation A.ring B.ring (e.1, h.1), h.2) ;
 -- an algebra map is its carrier map with a Structure (by definition)
 hom-structure (A B : C.Algebra) (f : C.Hom A B) : Structure A B (AC.fun f) = (f.1.2, f.2) ;

 -- §4: Singl A is a retract of the contractible total space
 module SG = CC.Singletons[AC.pre] ;
 module At (A : C.Algebra) {
  s (w : SG.Singl A) : S.Total (fields A) =
   (fields w.1, (AC.fun {A} {w.1} (AP.arr w.2), AC.carrier-equiv w.2),
    structure-to-iota A w.1 (AC.fun {A} {w.1} (AP.arr w.2), AC.carrier-equiv w.2) (hom-structure A w.1 (AP.arr w.2))) ;
  -- the map of carrier e0 to mk B with the Structure from Iota
  to-hom (B : S.Str) (i : S.Iso (fields A) B) : C.Hom A (mk B) =
   ((i.1.1, (iota-to-structure A (mk B) i.1 i.2).1), (iota-to-structure A (mk B) i.1 i.2).2) ;
  r (c : S.Total (fields A)) : SG.Singl A =
   (mk c.1, AC.Inverse[A, mk c.1, to-hom c.1 c.2, c.2.1.2].iso) ;
  -- isos with the same carrier map are equal
  same-arrow (B : C.Algebra) (j i : AC.pre.Iso A B)
   (p : (a : A.ring.R) -> Id B.ring.R (AC.fun {A} {B} (AP.arr j) a) (AC.fun {A} {B} (AP.arr i) a)) :
   Id (SG.Singl A) (B, j) (B, i) =
   Hi.ap (AC.pre.Iso A B) (SG.Singl A) (\ k -> (B, k)) j i (AP.iso-eq j i (C.ext A B (AP.arr j) (AP.arr i) p)) ;
  back-ring : (ring : CRing) (set : Pr.isSet ring.R) (iota : H.Hom R ring)
   (i : AC.pre.Iso A (C.mkAlgebra ring set iota)) ->
   Id (SG.Singl A) (r (s (C.mkAlgebra ring set iota, i))) (C.mkAlgebra ring set iota, i) = split {
   mkCRing T z o ad mu ne aa ac az an ma mc mo di -> \ set iota i ->
    same-arrow (C.mkAlgebra (mkCRing T z o ad mu ne aa ac az an ma mc mo di) set iota)
     (r (s (C.mkAlgebra (mkCRing T z o ad mu ne aa ac az an ma mc mo di) set iota, i))).2 i
     (\ a -> refl (AC.fun {A} {C.mkAlgebra (mkCRing T z o ad mu ne aa ac az an ma mc mo di) set iota} (AP.arr i) a)) } ;
  back : (B : C.Algebra) (i : AC.pre.Iso A B) -> Id (SG.Singl A) (r (s (B, i))) (B, i) = split {
   mkAlgebra ring set iota -> back-ring ring set iota } ;
  singl-prop : Hi.isProp (SG.Singl A) =
   Hi.retract-prop (SG.Singl A) (S.Total (fields A)) s r (\ w -> back w.1 w.2)
    (\ u v -> CH.pathC (S.Total (fields A)) (S.total-contr (fields A)) u v) ;
 } ;

 -- checkpoint 1: the univalent category of R-algebras
 univalent : CC.Univalent AC.pre = CC.FromTotal[AC.pre, \ A -> At[A].singl-prop].univalent ;
 category : CC.Category = new CC.Category[AC.pre, univalent] ;
} ;
