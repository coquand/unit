-- sag/fpalg: finitely presented R-algebras as a small univalent category
-- (DESIGN.md).  The algebras and presentations of sag/presentations, the
-- categories of sag/categories, the SIP of sag/sip, all linked unchanged.
-- Theory: univalence and the two parts of replacement (as sag/categories
-- and sag/presentations); fe and propUA derived from univalence.
import Base ; import Prelude ; import Paths ; import Axioms ; import FunExtUA ;
import Replacement ; import Ring ; import Poly ; import Mul ;
module Theory
 (univ : [l] Axioms[l].Univalence)
 (images : [l] [k] Replacement[l,k].Images)
 (surjections : [l] [k] [j] (Replacement[l,k].Surjectivity (images @l @k)) @j) {
 fe : [l] Axioms[l].FunExt = <l> FunExtUA[l].FE[univ @l].fe ;
 propUA : [l] Axioms[l].PropUnivalence = <l> Axioms[l].UnivalenceLemmas[univ @l].prop-univ ;
 import Truncation ; import TruncationCombinators ;
 -- linked (read-only): rings, polynomials, presentations; before the
 -- categories, since PresentedAlgebra and PresentationExistence have local
 -- modules named Descent (no shadowing: the file Descent comes after them)
 import Quotient ; import RawLaws ; import RawMultiplication ; import RingHom ;
 import PolynomialRing ; import Evaluation ; import Universal ;
 import Algebras ; import Presentations ; import ExpressionCongruence ; import CongruenceSoundness ;
 import PresentedAlgebra ; import PresentationExistence ;
 -- linked (read-only): replacement, categories, sip
 import Equivalences ; import Category ; import Arrows ; import Functor ; import FunctorCat ;
 import PrecomposeFF ; import Descent ; import UniversalProperty ; import FunctorUnivalence ;
 import EquivObjects ; import SmallImage ; import CompletionUP ;
 import SipGeneric ;
 -- fpalg
 import AlgebraCategory ; import AlgebraSIP ; import FPImage ; import FPDescent ;
} ;
