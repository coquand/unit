-- The small full image of the presented algebras (DESIGN.md §5).
-- Codes: Presentations.Presentation (U l).  interpret p: the algebra
-- PresentedAlgebra[l].Over[R,setR,p].algebra (the quotient of expressions,
-- with the universal property PresentationExistence.presentation).
-- SmallImage at the univalent category of R-algebras (AlgebraSIP, objects
-- in U l+, arrows in U l) gives SFI.category : Category[l,l].Category,
-- objects SFI.image.carrier : U l, and the fully faithful SFI.inclusion.
--  characterisation: A is in the image (the fibre of the inclusion over A,
--   a proposition) iff || (p : Presentation) * Iso_R (interpret p, A) ||:
--   SmallImage's from-fibre and to-fibre.
--  automorphisms: (q p = q p) ~ Aut_R (interpret p).
-- Not done: the comparison of "in the image" with Presentations.FP
-- (DESIGN.md §5).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module AC = AlgebraCategory[l].Over[R,setR] ;
 module AS = AlgebraSIP[l].Over[R,setR] ;
 interpret (p : P.Presentation) : C.Algebra = PresentedAlgebra[l].Over[R,setR,p].algebra ;
 module SFI = SmallImage[l+,l].SmallFullImage[AS.category, P.Presentation, interpret] ;

 -- the generators of A: presentations with an R-algebra iso to A
 Generators (A : C.Algebra) : U l = (p : P.Presentation) * AC.pre.Iso (interpret p) A ;
 in-image-prop (A : C.Algebra) : Hi.isProp (SFI.Fibre A) = SFI.fibre-prop A ;
 characterisation (A : C.Algebra) :
  (SFI.Fibre A -> Truncation[l].Trunc[Generators A].carrier) *
  (Truncation[l].Trunc[Generators A].carrier -> SFI.Fibre A) =
  (SFI.from-fibre A, SFI.to-fibre A) ;
 automorphisms (p : P.Presentation) :
  Hi.Equiv (Id SFI.image.carrier (SFI.image.quotient p) (SFI.image.quotient p))
   (AC.pre.Iso (interpret p) (interpret p)) = SFI.automorphisms p ;
} ;
