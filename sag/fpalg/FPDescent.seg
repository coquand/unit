-- Descent of functors defined on presentations (DESIGN.md §6).
-- CompletionUP at the univalent category of R-algebras, the codes
-- Presentations.Presentation and interpret (FPImage): C_F has the codes as
-- objects and Hom_R (interpret a, interpret b) as arrows; q : C_F -> D_F,
-- D_F the small full image (the same SmallFullImage instance as
-- FPImage.SFI), is fully faithful and essentially surjective; for every
-- category E : Category[m,n] (with l, m, n <= j), precomposition with q,
-- G |-> G o q, is an equivalence Fun(D_F,E) ~ Fun(C_F,E) of types.
level l m n j ; constraint l <= j ; constraint m <= j ; constraint n <= j ;
open Ring[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module P = Presentations[l].Over[R,setR] ;
 module AS = AlgebraSIP[l].Over[R,setR] ;
 module FI = FPImage[l].Over[R,setR] ;
 module CU = CompletionUP[l+,l,m,n,j].Instance[AS.category, P.Presentation, FI.interpret] ;
 descent (E : Category[m,n].Category) :
  Prelude[j].isEquiv (Functor[l,l,m,n].Functor[CU.SFI.pre,E.pre]) (Functor[l,l,m,n].Functor[CU.pre,E.pre])
   CU.ForEvery[E].T.Q.functor = CU.ForEvery[E].equiv ;
} ;
