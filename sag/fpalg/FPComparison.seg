-- The objects of the small image are the finitely presented algebras
-- (DESIGN.md §5): for an R-algebra A,
--   A lies in the image  ~  FP A   (both propositions).
--  From a witness (p, pa : Presents p A): F p and A have the same
--   presentation, so PresentationComparison gives algebra maps
--   F p -> A -> F p inverse to each other, an iso F p ~ A; hence a
--   generator (p, iso), and A lies in the image (to-fibre).
--  From a generator (p, i : Iso (F p) A): by univalence of the category of
--   algebras, i gives a path F p = A, along which Presents p (F p)
--   (PresentationExistence) is transported to Presents p A.
--  Each direction eliminates a truncation into a proposition, and maps
--  both ways between propositions form an equivalence.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module AC = AlgebraCategory[l].Over[R,setR] ;
 module AS = AlgebraSIP[l].Over[R,setR] ;
 module FI = FPImage[l].Over[R,setR] ;

 -- a presentation of A gives a generator of A
 module FromWitness (A : C.Algebra) (w : P.Witness A) {
  module Cmp = PresentationComparison[l].Over[R,setR,w.1,FI.interpret w.1,A,
   PresentationExistence[l].Over[R,setR,w.1].presentation,w.2] ;
  iso : AC.pre.Iso (FI.interpret w.1) A = (Cmp.forward, Cmp.backward, Cmp.inverse-left, Cmp.inverse-right) ;
  generator : FI.Generators A = (w.1, iso) ;
 } ;
 -- a generator of A gives a presentation of A
 module FromGenerator (A : C.Algebra) (g : FI.Generators A) {
  path : Id C.Algebra (FI.interpret g.1) A = AS.category.isotoid (FI.interpret g.1) A g.2 ;
  presents : P.Presents g.1 A =
   Hi.subst C.Algebra (P.Presents g.1) (FI.interpret g.1) A path
    PresentationExistence[l].Over[R,setR,g.1].presentation ;
  witness : P.Witness A = (g.1, presents) ;
 } ;

 fp-to-image (A : C.Algebra) : P.FP A -> FI.SFI.Fibre A =
  Truncation[l+].Trunc[P.Witness A].induction @(l+) (\ t -> FI.SFI.Fibre A) (\ t -> FI.in-image-prop A)
   (\ w -> FI.SFI.to-fibre A (Truncation[l].Trunc[FI.Generators A].inc FromWitness[A,w].generator)) ;
 image-to-fp (A : C.Algebra) (x : FI.SFI.Fibre A) : P.FP A =
  Truncation[l].Trunc[FI.Generators A].induction @(l+) (\ t -> P.FP A)
   (\ t -> Truncation[l+].Trunc[P.Witness A].proposition)
   (\ g -> Truncation[l+].Trunc[P.Witness A].inc FromGenerator[A,g].witness)
   (FI.SFI.from-fibre A x) ;
 comparison (A : C.Algebra) : Hi.Equiv (FI.SFI.Fibre A) (P.FP A) =
  (image-to-fp A, Hi.qinv (FI.SFI.Fibre A) (P.FP A) (image-to-fp A) (fp-to-image A)
   (\ u -> Truncation[l+].Trunc[P.Witness A].proposition (image-to-fp A (fp-to-image A u)) u)
   (\ x -> FI.in-image-prop A (fp-to-image A (image-to-fp A x)) x)) ;
} ;
