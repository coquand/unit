-- Adapter for local theorems phrased using actual decidable prime
-- ideals. Only finite ideals are passed to that local theorem.
-- PrimeExistence contains just the record; its principle is NOT used.
level l ; open Ring[l] ;
module Big = Truncation[l+] ;
module Over (A : CRing) (Certificate : A.R -> U l+) {
 module PE = PrimeExistence[l].Over[A] ;
 module C = PrimalityCertifiedCover[l].Over[A,Certificate] ;
 Decision (q : PE.Prime) : U l =
  (x : A.R) -> Plus (q.ideal.In x) (Not (q.ideal.In x)) ;
 Hit (q : PE.Prime) : U l+ = (h : A.R) * Certificate h * Not (q.ideal.In h) ;
 Pointwise : U l+ = (q : PE.Prime) -> Decision q -> Big.Trunc[Hit q].carrier ;
 module Given (K0 : U l) (cfn : CFN[l].CFN[K0,A]) (test : C.P.Test) (local : Pointwise) {
  finite-pointwise : C.Pointwise = \ s p ->
   local (C.P.At[s].prime p) (C.P.At[s].decidable cfn.disc) ;
  theorem : Big.Trunc[C.Cover].carrier = C.Given[test,finite-pointwise].theorem K0 cfn ;
 } ;
} ;
