-- The existing coded noetherian tree eliminates into propositions one
-- universe higher. This is proved by recursion on that same tree;
-- no resizing or stronger noetherianity premise is assumed.
level l ; open Ring[l] ; open Bar[l] ;
module Pr = Prelude[l+] ; module IP = IdealPowers[l] ;
module CN = CodedNoeth[l] ; module TC = TruncationCombinators[l] ;
big-absurd (P : U l+) : Empty -> P = split { } ;
module Over (A : CRing) {
 module MS = ModSpan[l].Over[A,IP.regular A] ;
 FL : U (l++) = (Phi : List A.R -> U l+) ->
  ((s : List A.R) -> Pr.isProp (Phi s)) ->
  ((s : List A.R) -> MS.Free s ->
   ((x : A.R) -> Not (MS.In s x) -> Phi (cons x s)) -> Phi s) ->
  (s : List A.R) -> MS.Free s -> Phi s ;
 module Presented (P : Span[l].Pres[A]) {
  module C = CN.Over[A,P] ; module S = Span[l].Over[A,P] ;
  module Ind (surj : C.Surj) (nt : S.Noeth)
   (Phi : List A.R -> U l+) (prop : (s : List A.R) -> Pr.isProp (Phi s))
   (step : (s : List A.R) -> MS.Free s ->
    ((x : A.R) -> Not (MS.In s x) -> Phi (cons x s)) -> Phi s) {
   Psi (cs : List P.K) : U l+ = MS.Free (C.phiL cs) -> Phi (C.phiL cs) ;
   base (cs : List P.K) (g : S.Good cs) : Psi cs = \ f ->
    big-absurd (Phi (C.phiL cs)) (MS.good-free (C.phiL cs) (C.good-el cs g) f) ;
   extend (cs : List P.K) (f : MS.Free (C.phiL cs))
    (h : (c : P.K) -> Psi (cons c cs)) (x : A.R) (nx : Not (MS.In (C.phiL cs) x)) :
    Phi (cons x (C.phiL cs)) =
    TC.rec ((c : P.K) * Id A.R (P.phi c) x) @l+
     (Phi (cons x (C.phiL cs))) (prop (cons x (C.phiL cs)))
     (\ ce -> Pr.subst A.R (\ y -> Phi (cons y (C.phiL cs))) (P.phi ce.1) x ce.2
      (h ce.1 ((\ w -> nx (MS.in-tr (C.phiL cs) (P.phi ce.1) x ce.2 w)),f)))
     (surj x) ;
   ind (cs : List P.K) (h : (c : P.K) -> Psi (cons c cs)) : Psi cs =
    \ f -> step (C.phiL cs) f (extend cs f h) ;
   valid : (t : Tree P.K) (cs : List P.K) -> S.G.Valid t cs -> Psi cs = split {
    leaf -> base ;
    node ts | ih -> \ cs v -> ind cs (\ c -> ih c (cons c cs) (v c)) } ;
   codes (cs : List P.K) (f : MS.Free (C.phiL cs)) : Phi (C.phiL cs) =
    valid (C.at cs nt).1 cs (C.at cs nt).2 f ;
   result (s : List A.R) (f : MS.Free s) : Phi s =
    TC.rec (C.Lift s) @l+ (Phi s) (prop s)
     (\ w -> Pr.subst (List A.R) Phi (C.phiL w.1) s w.2
      (codes w.1 (subst MS.Free (sym w.2) f))) (C.lift surj s) ;
  } ;
 } ;
 from-coded (K0 : U l) (np : CN.NP K0 A) : FL = \ Phi prop step ->
  Presented[CN.pres A (CN.El K0 np.1) np.2.1].Ind[np.2.2.2,np.2.2.1,Phi,prop,step].result ;
 from-cfn (K0 : U l) (c : CFN[l].CFN[K0,A]) : FL = \ Phi prop step s f ->
  TC.rec (CN.NP K0 A) @l+ (Phi s) (prop s)
   (\ np -> from-coded K0 np Phi prop step s f) c.noeth ;
} ;
