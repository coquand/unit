-- The certified cover from a hit-or-split local theorem: no strong
-- primality test.
--
-- Informal proof.  The local theorem is asked only at a finite list s
-- whose ideal (s) is proper, together with a decision of membership
-- in (s) (CFN gives one, cfn.disc).  It answers merely either a hit
-- (a certified h outside (s)) or a split (a,b outside (s), ab in (s)).
-- The local proof is that of a prime q = (s), each use of
-- "a, c notin q => ac notin q" being a finite check whose failure is
-- the split.  Induction on free lists, as in PrimalityCertifiedCover:
-- at s, decide 1 in (s); if so the unit case; otherwise ask the local
-- theorem and use the prime branch on a hit, the split branch on a
-- split.  The strong primality test is the special case where the
-- local theorem is asked only at primes (from-strong).
level l ; open Ring[l] ;
module Big = Truncation[l+] ; module BTC = TruncationCombinators[l+] ;
module TC = TruncationCombinators[l] ;
module Over (A : CRing) (Certificate : A.R -> U l+) {
 open A ;
 module C = PrimalityCertifiedCover[l].Over[A,Certificate] ;
 Decision (s : List R) : U l = (x : R) -> Plus (C.P.Mem s x) (Not (C.P.Mem s x)) ;
 Outcome (s : List R) : U l+ = Ring[l+].Plus (C.Hit s) (C.P.Split s) ;
 Local : U l+ = (s : List R) -> Not (C.P.Mem s o) -> Decision s ->
  Big.Trunc[Outcome s].carrier ;
 -- At a proper list, a hit or a split covers.
 proper-case (s : List R)
  (next : (h : R) -> Not (C.SP.In s h) -> C.Covered (cons h s)) :
  Outcome s -> C.Covered s = split {
  inl hit -> C.prime-branch s next hit ; inr w -> C.split-branch s next w } ;
 module Given (K0 : U l) (cfn : CFN[l].CFN[K0,A]) (local : Local) {
  decision (s : List R) : Decision s = C.P.At[s].decidable cfn.disc ;
  cases (s : List R)
   (next : (h : R) -> Not (C.SP.In s h) -> C.Covered (cons h s)) :
   Plus (C.P.Mem s o) (Not (C.P.Mem s o)) -> C.Covered s = split {
   inl w -> C.unit s w ;
   inr np -> BTC.bind (Outcome s) (C.Witness s) (proper-case s next)
    (local s np (decision s)) } ;
  step (s : List R) (free : C.SP.Free s)
   (next : (h : R) -> Not (C.SP.In s h) -> C.Covered (cons h s)) : C.Covered s =
   cases s next (decision s o) ;
  theorem : Big.Trunc[C.Cover].carrier =
   TC.rec (CodedNoeth[l].NP K0 A) @l+ Big.Trunc[C.Cover].carrier
    Big.Trunc[C.Cover].proposition
    (\ np -> BTC.map (C.Witness nil) C.Cover C.extract
     ((C.FL.from-coded K0 np) C.Covered C.prop step nil tt)) cfn.noeth ;
 } ;
 -- A strong test and primewise hits give a hit-or-split local theorem.
 module FromStrong (test : C.P.Test) (pointwise : C.Pointwise) {
  at-proper (s : List R) : Plus (C.P.Prime s) (C.P.Split s) ->
   Big.Trunc[Outcome s].carrier = split {
   inl p -> BTC.map (C.Hit s) (Outcome s) (\ hit -> inl hit) (pointwise s p) ;
   inr w -> Big.Trunc[Outcome s].inc (inr w) } ;
  at-outcome (s : List R) (proper : Not (C.P.Mem s o)) :
   C.P.Outcome s -> Big.Trunc[Outcome s].carrier = split {
   inl w -> LargeFreeLists[l].big-absurd Big.Trunc[Outcome s].carrier (proper w) ;
   inr w -> at-proper s w } ;
  local : Local = \ s proper dec ->
   TC.rec (C.P.Outcome s) @l+ Big.Trunc[Outcome s].carrier
    Big.Trunc[Outcome s].proposition (at-outcome s proper) (test s) ;
 } ;
} ;
