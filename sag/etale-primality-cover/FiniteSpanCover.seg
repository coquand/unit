-- Explicit finite-ideal operations used by the three cover branches.
-- In is the existing untruncated list of coefficient witnesses.
level l ; open Ring[l] ; open Bar[l] ;
module Over (A : CRing) {
 open A ; open RL[A] ;
 module M = IdealPowers[l] ; module ML = M.ModL[A,M.regular A] ;
 module SP = ModSpan[l].Over[A,M.regular A] ;
 module LS = Comb[l].Lists[A,M.regular A] ;
 module SS = Spans[l].Over[A,M.regular A] ;
 Le (s t : List R) : U l = (y : R) -> SP.In s y -> SP.In t y ;
 cons-le (a : R) (s t : List R) (ha : SP.In t a) (h : Le s t) : Le (cons a s) t =
  \ y w -> SP.in-tr t _ y (LS.join-sub y a w.1)
   (SP.in-add t (mul w.1 a) (ML.msub y (mul w.1 a))
    (SP.in-scale t w.1 a ha) (h (ML.msub y (mul w.1 a)) w.2)) ;
 left : (s t : List R) -> Le s (app s t) = split {
  nil -> \ t y e -> SP.in-tr t z y (sym e) (SP.in-zero t) ;
  cons a s | ih -> \ t y w -> (w.1,ih t (ML.msub y (mul w.1 a)) w.2) } ;
 right : (s t : List R) -> Le t (app s t) = split {
  nil -> \ t y w -> w ;
  cons a s | ih -> \ t y w -> SP.in-weak a (app s t) y (ih t y w) } ;
 app-le : (s t u : List R) -> Le s u -> Le t u -> Le (app s t) u = split {
  nil -> \ t u h k -> k ;
  cons a s | ih -> \ t u h k -> cons-le a (app s t) u (h a (SP.in-gen a s))
   (ih t u (\ y w -> h y (SP.in-weak a s y w)) k) } ;
 extend (a : R) (s t : List R) (h : Le s t) : Le (cons a s) (cons a t) =
  \ y w -> (w.1,h (ML.msub y (mul w.1 a)) w.2) ;
 empty-right (s : List R) : Le s (app s nil) = left s nil ;
 keep (a : R) (s h : List R) : Le (app (cons a s) h) (app s (cons a h)) =
  cons-le a (app s h) (app s (cons a h))
   (right s (cons a h) a (SP.in-gen a h))
   (app-le s h (app s (cons a h)) (left s (cons a h))
    (\ y w -> right s (cons a h) y (SP.in-weak a h y w))) ;
 union-left (s h k : List R) : Le (app s h) (app s (app h k)) =
  app-le s h (app s (app h k)) (left s (app h k))
   (\ y w -> right s (app h k) y (left h k y w)) ;
 union-right (s h k : List R) : Le (app s k) (app s (app h k)) =
  app-le s k (app s (app h k)) (left s (app h k))
   (\ y w -> right s (app h k) y (right h k y w)) ;
 -- If 1-u*a is in J and a*b is in J, then b is in J.
 multiply-residual (s : List R) (a b u : R)
  (h : SP.In s (ML.msub o (mul u a))) (ab : SP.In s (mul a b)) : SP.In s b =
  SP.in-tr s (add (ML.msub b (mul u (mul a b))) (mul u (mul a b))) b
   (SS.sub-add b (mul u (mul a b)))
   (SP.in-add s (ML.msub b (mul u (mul a b))) (mul u (mul a b))
    (SP.in-tr s (mul b (ML.msub o (mul u a))) (ML.msub b (mul u (mul a b)))
     (trans (ML.sm-sub b o (mul u a))
      (ML.G.cong-add (mulO b)
       (ap neg (trans (mul-swap b u a) (ap (mul u) (mulC b a))))))
     (SP.in-scale s b (ML.msub o (mul u a)) h))
    (SP.in-scale s u (mul a b) ab)) ;
 join (s : List R) (a b : R) (ab : SP.In s (mul a b))
  (ha : SP.In (cons a s) o) (hb : SP.In (cons b s) o) : SP.In s o =
  SS.absorb b s (multiply-residual s a b ha.1 ha.2 ab) o hb ;
} ;
