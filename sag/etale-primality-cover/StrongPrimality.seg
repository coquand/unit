-- The extra effective ideal-theory assumption. CFN does not supply it.
-- Even the outcome may be merely given: no simultaneous choices needed.
level l ; open Ring[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (A : CRing) {
 module M = IdealPowers[l] ;
 module SP = ModSpan[l].Over[A,M.regular A] ;
 module S = Spans[l].Over[A,M.regular A] ;
 Mem (s : List A.R) (x : A.R) : U l = S.Mm s x ;
 Prime (s : List A.R) : U l = Not (Mem s A.o) *
  ((x y : A.R) -> Mem s (A.mul x y) -> Tr.Trunc[Plus (Mem s x) (Mem s y)].carrier) ;
 Split (s : List A.R) : U l = (a b : A.R) *
  Not (Mem s a) * Not (Mem s b) * Mem s (A.mul a b) ;
 Outcome (s : List A.R) : U l = Plus (Mem s A.o) (Plus (Prime s) (Split s)) ;
 Test : U l = (s : List A.R) -> Tr.Trunc[Outcome s].carrier ;
 module At (s : List A.R) {
  zero : Mem s A.z = S.mm s A.z (SP.in-zero s) ;
  add (x y : A.R) : Mem s x -> Mem s y -> Mem s (A.add x y) =
   TC.map2 (SP.In s x) (SP.In s y) (SP.In s (A.add x y)) (SP.in-add s x y) ;
  scale (a x : A.R) : Mem s x -> Mem s (A.mul a x) =
   TC.map (SP.In s x) (SP.In s (A.mul a x)) (SP.in-scale s a x) ;
  ideal : RegularIdeal[l].IdealPred[A] =
   new RegularIdeal[l].IdealPred[A,Mem s,zero,add,scale] ;
  prime (p : Prime s) : PrimeExistence[l].Over[A].Prime =
   new PrimeExistence[l].Over[A].Prime[ideal,S.mm-prop s,p.1,p.2] ;
  decidable (disc : Coherent[l].Over[A,M.regular A].Disc) (x : A.R) :
   Plus (Mem s x) (Not (Mem s x)) = S.dec-list disc s x ;
 } ;
} ;
