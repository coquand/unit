-- A constructed strong primality test for every discrete field.
-- This does not assert polynomial-extension stability of the test.
level l ; open Ring[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (A : CRing)
 (dec : (a : A.R) -> Plus (Id A.R a A.z) ((b : A.R) * Id A.R (A.mul a b) A.o))
 (nonzero : Not (Id A.R A.o A.z)) {
 open A ; open RL[A] ;
 module P = StrongPrimality[l].Over[A] ; module SP = P.SP ;
 module ML = IdealPowers[l].ModL[A,IdealPowers[l].regular A] ;
 Cases (s : List R) : U l = Plus (SP.In s o) ((x : R) -> SP.In s x -> Id R x z) ;
 drop (a c y : R) (az : Id R a z) : Id R (ML.msub y (mul c a)) y =
  trans (ap (\ t -> add y (neg (mul c t))) az)
   (trans (ap (add y) (trans (ap neg (mul-zero c)) neg-zero)) (addZ y)) ;
 from-unit (a : R) (s : List R) (b : R) (inv : Id R (mul a b) o) : SP.In (cons a s) o =
  SP.in-tr (cons a s) (mul b a) o (trans (mulC b a) inv)
   (SP.in-scale (cons a s) b a (SP.in-gen a s)) ;
 zero-step (a : R) (s : List R) (az : Id R a z) : Cases s -> Cases (cons a s) = split {
  inl w -> inl (SP.in-weak a s o w) ;
  inr h -> inr (\ y w -> trans (sym (drop a w.1 y az)) (h (ML.msub y (mul w.1 a)) w.2)) } ;
 step (a : R) (s : List R) (old : Cases s) :
  Plus (Id R a z) ((b : R) * Id R (mul a b) o) -> Cases (cons a s) = split {
  inl az -> zero-step a s az old ;
  inr u -> inl (from-unit a s u.1 u.2) } ;
 cases : (s : List R) -> Cases s = split {
  nil -> inr (\ y w -> w) ;
  cons a s | ih -> step a s ih (dec a) } ;
 cancel (x y u : R) (inv : Id R (mul x u) o) (h : Id R (mul x y) z) : Id R y z =
  calc R { y =< sym (one-left y) > mul o y
   =< ap (\ t -> mul t y) (sym (trans (mulC u x) inv)) > mul (mul u x) y
   =< sym (mulA u x y) > mul u (mul x y)
   =< ap (mul u) h > mul u z =< mul-zero u > z } ;
 factor-case (x y : R) (h : Id R (mul x y) z) :
  Plus (Id R x z) ((u : R) * Id R (mul x u) o) -> Plus (Id R x z) (Id R y z) = split {
  inl e -> inl e ; inr u -> inr (cancel x y u.1 u.2 h) } ;
 zero-member (s : List R) (x : R) (e : Id R x z) : P.Mem s x =
  P.S.mm s x (SP.in-tr s z x (sym e) (SP.in-zero s)) ;
 factor-member (s : List R) (x y : R) : Plus (Id R x z) (Id R y z) -> Plus (P.Mem s x) (P.Mem s y) = split {
  inl e -> inl (zero-member s x e) ; inr e -> inr (zero-member s y e) } ;
 prime (s : List R) (vanish : (x : R) -> SP.In s x -> Id R x z) : P.Prime s =
  ((\ h -> TC.rec (SP.In s o) @l Empty Coherent[l].empty-prop (\ w -> nonzero (vanish o w)) h),
   \ x y -> TC.map (SP.In s (mul x y)) (Plus (P.Mem s x) (P.Mem s y))
    (\ w -> factor-member s x y (factor-case x y (vanish (mul x y) w) (dec x)))) ;
 outcome (s : List R) : Cases s -> P.Outcome s = split {
  inl w -> inl (P.S.mm s o w) ; inr vanish -> inr (inl (prime s vanish)) } ;
 test : P.Test = \ s -> Tr.Trunc[P.Outcome s].inc (outcome s (cases s)) ;
 -- The same coded noetherian witness used by FieldCFN, without
 -- importing its unrelated coherence construction.
 module CN = CodedNoeth[l] ;
 surj : CN.Over[A,Field[l].self A].Surj =
  \ x -> Tr.Trunc[(c : R) * Id R c x].inc (x,refl x) ;
 noeth : CN.NP R A =
  (base,CN.ofPres A (Field[l].self A),Field[l].Over[A,dec].noeth,surj) ;
} ;
