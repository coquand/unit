-- End-to-end field and zero-ring instances; nonprime gluing retains
-- both certified opens. Large certificates really contain a type.
level l ; open Ring[l] ; open Presentations[l] ;
module Big = Truncation[l+] ; module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module OneChart (A : CRing) {
 Certificate (h : A.R) : U l+ = (X : U l) * X * Id A.R h A.o ;
 module C = PrimalityCertifiedCover[l].Over[A,Certificate] ;
 pointwise : C.Pointwise = \ s p -> Big.Trunc[C.Hit s].inc (A.o,(Top,tt,refl A.o),p.1) ;
 from-cfn (K0 : U l) (cfn : CFN[l].CFN[K0,A]) (test : C.P.Test) : Big.Trunc[C.Cover].carrier =
  C.Given[test,pointwise].theorem K0 cfn ;
 -- Hit-or-split: the same cover over every CFN ring, with no test.
 module H = HitOrSplitCover[l].Over[A,Certificate] ;
 local : H.Local = \ s proper dec ->
  Big.Trunc[H.Outcome s].inc (inl (A.o,(Top,tt,refl A.o),proper)) ;
 without-test (K0 : U l) (cfn : CFN[l].CFN[K0,A]) : Big.Trunc[C.Cover].carrier =
  H.Given[K0,cfn,local].theorem ;
 via-strong (K0 : U l) (cfn : CFN[l].CFN[K0,A]) (test : C.P.Test) : Big.Trunc[C.Cover].carrier =
  H.Given[K0,cfn,H.FromStrong[test,pointwise].local].theorem ;
 module AtField (dec : (a : A.R) -> Plus (Id A.R a A.z) ((b : A.R) * Id A.R (A.mul a b) A.o))
  (nonzero : Not (Id A.R A.o A.z)) {
  module P = FieldPrimality[l].Over[A,dec,nonzero] ;
  result : Big.Trunc[C.Cover].carrier =
   C.Given[P.test,pointwise].from-fl (C.FL.from-coded A.R P.noeth) ;
 } ;
} ;
module F2 {
 module B = BooleanRing[l] ;
 A : CRing = B.two-ring ;
 dec : (a : A.R) -> Plus (Id A.R a A.z) ((b : A.R) * Id A.R (A.mul a b) A.o) = split {
  false -> inl (refl false) ; true -> inr (true,refl true) } ;
 code : A.R -> U l = split { true -> Top ; false -> Empty } ;
 nonzero (e : Id A.R A.o A.z) : Empty = subst code e tt ;
 module O = OneChart[A] ; module Run = O.AtField[dec,nonzero] ;
 result : Big.Trunc[O.C.Cover].carrier = Run.result ;
 prime-empty : Run.P.P.Prime nil = Run.P.prime nil (\ y h -> h) ;
 unit-one : Run.P.P.Mem (cons true nil) true =
  Run.P.P.S.mm (cons true nil) true (Run.P.SP.in-gen true nil) ;
} ;
module ZeroRing (A : CRing) (one-zero : Id A.R A.o A.z) {
 open A ;
 -- There cannot be a certificate at any element in this instance.
 module C = PrimalityCertifiedCover[l].Over[A,\ h -> Empty] ;
 vanish (x : R) : Id R x z =
  trans (sym (mulO x)) (trans (ap (mul x) one-zero) (RL[A].mul-zero x)) ;
 dec (x : R) : Plus (Id R x z) ((y : R) * Id R (mul x y) o) = inl (vanish x) ;
 unit (s : List R) : C.P.Mem s o =
  C.P.S.mm s o (C.SP.in-tr s z o (sym one-zero) (C.SP.in-zero s)) ;
 test : C.P.Test = \ s -> Tr.Trunc[C.P.Outcome s].inc (inl (unit s)) ;
 pointwise : C.Pointwise = \ s p ->
  LargeFreeLists[l].big-absurd Big.Trunc[C.Hit s].carrier (p.1 (unit s)) ;
 module CN = CodedNoeth[l] ;
 surj : CN.Over[A,Field[l].self A].Surj = \ x -> Tr.Trunc[(c : R) * Id R c x].inc (x,refl x) ;
 noeth : CN.NP R A = (base,CN.ofPres A (Field[l].self A),Field[l].Over[A,dec].noeth,surj) ;
 result : Big.Trunc[C.Cover].carrier =
  C.Given[test,pointwise].from-fl (C.FL.from-coded R noeth) ;
 empty-cover : C.Cover = C.extract (C.unit-witness nil one-zero) ;
 empty-size : Id Nat empty-cover.1 zero = refl zero ;
} ;
module Orthogonal (A : CRing) (a b : A.R)
 (orthogonal : Id A.R (A.mul a b) A.z) (complementary : Id A.R (A.add a b) A.o) {
 open A ;
 Certificate (h : R) : U l+ = (X : U l) * X * Plus (Id R h a) (Id R h b) ;
 module C = PrimalityCertifiedCover[l].Over[A,Certificate] ;
 first : Certificate a = (Top,tt,inl (refl a)) ;
 second : Certificate b = (Top,tt,inr (refl b)) ;
 one-in-pair (x y : R) (h : Id R (add x y) o) : C.SP.In (cons x (cons y nil)) o =
  (o,C.SP.in-tr (cons y nil) y (add o (neg (mul o x)))
   (C.LS.split-sub o x y o (trans (ap (\ t -> add t y) (RL[A].one-left x)) h))
   (C.SP.in-gen y nil)) ;
 left : C.Witness (cons a nil) = (cons b nil,(second,tt),one-in-pair a b complementary) ;
 right : C.Witness (cons b nil) =
  (cons a nil,(first,tt),one-in-pair b a (trans (addC b a) complementary)) ;
 joined : C.Witness nil = C.split-witness nil a b orthogonal left right ;
 cover : C.Cover = C.extract joined ;
 two-charts : Id Nat cover.1 (suc (suc zero)) = refl (suc (suc zero)) ;
 first-value : Id R (cover.2.1 (inl (inr tt))) a = refl a ;
 second-value : Id R (cover.2.1 (inr tt)) b = refl b ;
 splitting (az : Not (Id R a z)) (bz : Not (Id R b z)) : C.P.Split nil =
  (a,b,(\ h -> TC.rec (C.SP.In nil a) @l Empty Coherent[l].empty-prop az h),
   (\ h -> TC.rec (C.SP.In nil b) @l Empty Coherent[l].empty-prop bz h),
   C.P.S.mm nil (mul a b) orthogonal) ;
 -- Prime-branch retention also keeps its newly found chart.
 retained : C.Witness nil = C.retain nil a first left ;
 retained-cover : C.Cover = C.extract retained ;
 retained-size : Id Nat retained-cover.1 (suc (suc zero)) = refl (suc (suc zero)) ;
} ;
module ProductRing (A : CRing) {
 open A ;
 Pair : U l = R * R ;
 pair-path (x y : Pair) (p : Id R x.1 y.1) (q : Id R x.2 y.2) : Id Pair x y =
  ExteriorAlgebra[l].pair-eq p q ;
 addP (x y : Pair) : Pair = (add x.1 y.1,add x.2 y.2) ;
 mulP (x y : Pair) : Pair = (mul x.1 y.1,mul x.2 y.2) ;
 negP (x : Pair) : Pair = (neg x.1,neg x.2) ;
 ring : CRing = mkCRing Pair (z,z) (o,o) addP mulP negP
  (\ x y w -> pair-path _ _ (addA x.1 y.1 w.1) (addA x.2 y.2 w.2))
  (\ x y -> pair-path _ _ (addC x.1 y.1) (addC x.2 y.2))
  (\ x -> pair-path _ _ (addZ x.1) (addZ x.2))
  (\ x -> pair-path _ _ (addN x.1) (addN x.2))
  (\ x y w -> pair-path _ _ (mulA x.1 y.1 w.1) (mulA x.2 y.2 w.2))
  (\ x y -> pair-path _ _ (mulC x.1 y.1) (mulC x.2 y.2))
  (\ x -> pair-path _ _ (mulO x.1) (mulO x.2))
  (\ x y w -> pair-path _ _ (dist x.1 y.1 w.1) (dist x.2 y.2 w.2)) ;
} ;
module ProductExample {
 module P = ProductRing[F2.A] ;
 Pair : U l = P.Pair ; ring : CRing = P.ring ;
 a : Pair = (true,false) ; b : Pair = (false,true) ;
 ab : Id Pair (ring.mul a b) ring.z = refl (false,false) ;
 sum-one : Id Pair (ring.add a b) ring.o = refl (true,true) ;
 a-nonzero (e : Id Pair a ring.z) : Empty = F2.nonzero (ap (\ x -> x.1) e) ;
 b-nonzero (e : Id Pair b ring.z) : Empty = F2.nonzero (ap (\ x -> x.2) e) ;
 module Run = Orthogonal[ring,a,b,ab,sum-one] ;
 nonprime : Run.C.P.Split nil = Run.splitting a-nonzero b-nonzero ;
 cover : Run.C.Cover = Run.cover ;
 partition : Id Pair (Run.C.S.lin cover.1 cover.2.1 cover.2.2.1) ring.o = cover.2.2.2.2 ;
 count : Id Nat cover.1 (suc (suc zero)) = Run.two-charts ;
} ;
module TrivialExample {
 ring : CRing = mkCRing Top tt tt (\ x y -> tt) (\ x y -> tt) (\ x -> tt)
  (\ x y w -> refl tt) (\ x y -> refl tt)
  (\ x -> AffineFinite[l].top-eq tt x) (\ x -> refl tt)
  (\ x y w -> refl tt) (\ x y -> refl tt)
  (\ x -> AffineFinite[l].top-eq tt x) (\ x y w -> refl tt) ;
 module Run = ZeroRing[ring,refl tt] ;
 result : Big.Trunc[Run.C.Cover].carrier = Run.result ;
 count : Id Nat Run.empty-cover.1 zero = Run.empty-size ;
} ;
